+    int64_t hash = hashKey(globalObject, key);
+    RETURN_IF_EXCEPTION(scope, false);
+    uint32_t slot;
+    int32_t index = find(globalObject, key, fold(hash), &slot);
+    RETURN_IF_EXCEPTION(scope, false);
