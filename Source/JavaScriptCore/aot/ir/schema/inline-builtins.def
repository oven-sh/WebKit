enum AtomicsOperation { | engine Load Store Add And CompareExchange Exchange Or Sub Xor }
enum AccessDirection { | engine Read Write }
enum NumberKind { | engine Signed Unsigned Float BigInt }
enum Endianness { | engine Little Big }
enum SearchValueKind { | engine String RegExp }
enum ByteLiteralKind { | engine BufferFrom Uint8ArrayFromBase64 Uint8ArrayFromHex }

