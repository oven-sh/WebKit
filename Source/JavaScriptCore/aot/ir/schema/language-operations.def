operation SuperConstructList (layout: Layout, parent: Any/calls, newTarget: Any/retains, list: Array/Listed, with CallStamp) -> declared(layout) ; unknownCode by Call ; accessClass = IndirectCall ; interpreted = List ; runtime = SuperConstructList ; flow = Copies ; flowRule = Call

family PrivateAccess AsRead..Placed
operation PrivateGet (object: Any/inspects, token: ClassToken/inspects, layout: Layout, field: Field, with AccessStamp) -> unknown => declared(field) ; reads(ObjectFields, NamedProperties, ShapeWords) throws by Access ; access = Read ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = PrivateGet ; flow = Copies ; flowRule = Heap
