record Section wire wireOnly { offsetInBytes: UInt32 count: UInt32 }
record Header wire wireOnly { magic: UInt32 schemaHash: UInt64 sizeInBytes: UInt32 sections: Section[lists] }

enum NameClass (words: Text) {
    Ordinary("") Index("") CanonicalNumericString("") Proto("__proto__") Constructor("constructor")
    ObjectPrototypeMember("hasOwnProperty isPrototypeOf propertyIsEnumerable toLocaleString toString valueOf __defineGetter__ __defineSetter__ __lookupGetter__ __lookupSetter__")
    Length("length") Prototype("prototype") CallOrApply("call apply") Bind("bind") LastIndex("lastIndex") Then("then") ToJSON("toJSON")
}
record String wire customEngine customText { offset: UInt32 length: UInt32 nameClass: NameClass builtinName: BuiltinName? }

enum PropertyKeyKind { Text EnginePrivateName PrivateName WellKnownSymbol CreatedSymbol | engine RegisteredSymbol }
enum WellKnownSymbol {
    AsyncDispose AsyncIterator Dispose HasInstance IsConcatSpreadable Iterator Match MatchAll Replace Search Species Split ToPrimitive ToStringTag
    Unscopables
}
record PropertyKey wire customText {
    kind: PropertyKeyKind text: String? owner: Layout? symbol: WellKnownSymbol? module: Module(Referrer)? position: UInt32?
    | engine site: AllocationSite?
}

flags Primitives abi { Undefined Null False True Number String Symbol BigInt Absent }
flags PrimitiveSet { | engine Undefined Null False True Integer WholeNumber FractionalNumber String Symbol BigInt Absent LiteralString LiteralSymbol }
flags TypeFlags { HasIntegers AnyObject AnyFunction }
enum ContentsSlot { Element Key Value }
enum ArrayStorage { Other Int32 Double Contiguous }
flags PristineAspects { | engine Storage Names AsCreated Dense }

record Type wire customEngine customText {
    primitives: Primitives flags: TypeFlags opaque: OpaqueKind? environment: Layout? minimum: Int64 maximum: Int64
    strings: Span<String> sorted layouts: Span<Layout> sorted classes: Span<ClassPart> sorted by builtinClass builtins: Span<Builtin> sorted
    functions: Span<Function(Dispatch)> sorted
}
record ClassPart wire customEngine {
    builtinClass: BuiltinClass contents: Span<Type>
    | engine contentsAreProven: Bool arrayStorage: ArrayStorage provenPristine: PristineAspects predictedContents: List<Type>
}

enum TypeSiteKind (logWord: Text) {
    Unknown("type-mismatch") Parameter("enter-function") This("enter-function") Capture("enter-function") Result("enter-return") Field("enter-field")
    StaticField("enter-field") Variable("enter-variable") Element("read-element") MapKey("read-element") MapValue("read-element")
    SetElement("read-element") PromiseValue("read-element") CallResult("call-result") PropertyRead("read-property") Assertion("as-convert")
}
record TypeSite wire { module: Module(Referrer) position: UInt32 kind: TypeSiteKind text: String? | engine function: Function(Dispatch)? }
flags PositionFlags { IsInt32Promise IsFromCompiler | engine AdmitsObjects }
record DeclaredType wire { type: Type written: Type? predicted: Type? site: TypeSite? flags: PositionFlags }

variant ClaimSource wire { None Field { key: PropertyKey } Contents { slot: ContentsSlot } }
enum CastResolution { | engine Unresolved Nothing Upcast Claim Prediction Assume }
record TailCast wire { declared: DeclaredType | engine resolution: CastResolution }

enum ValidatedPrimitive { String Number Boolean BigInt }
enum TemplatePlaceholder { String Number BigInt }
enum TextFormat { Email Uuid Ipv4 Ipv6 Date DateTime Url }
enum UndeclaredMembers { Allowed Rejected Validated }
record TemplatePart wire { placeholder: TemplatePlaceholder text: String }
variant ValidationRule wire {
    Integer Minimum { bound: Double } Maximum { bound: Double } ExclusiveMinimum { bound: Double } ExclusiveMaximum { bound: Double }
    MultipleOf { divisor: Double } MinimumLength { length: UInt32 } MaximumLength { length: UInt32 } Pattern { source: String }
    Format { format: TextFormat } Template { head: String parts: Span<TemplatePart> } Message { text: String } DefaultNull
    DefaultBoolean { value: Bool } DefaultNumber { value: Double } DefaultString { value: String }
}
record ValidationMember wire { key: PropertyKey node: UInt32 field: UInt32? isOptional: Bool }
variant ValidationShape wire {
    Unknown Never Undefined Null AnyObject Primitive { primitive: ValidatedPrimitive } BooleanLiteral { value: Bool } NumberLiteral { value: Double }
    StringLiteral { value: String } Array { element: UInt32 } Tuple { elements: Span<UInt32> } Dictionary { value: UInt32 }
    Object { layout: Layout? members: Span<ValidationMember> undeclared: UndeclaredMembers undeclaredValue: UInt32? } Union { arms: Span<UInt32> }
}
record ValidationNode wire { shape: ValidationShape type: Type rules: Span<ValidationRule> text: String? }
record ExpectedResult wire { type: Type layouts: Span<Layout> site: TypeSite? validation: Span<ValidationNode> }

list bytes : Byte
list words : Word
list strings : String
list propertyKeys : PropertyKey
list types : Type
list classParts : ClassPart
list typeSites : TypeSite as typesite prefix w
list declaredTypes : DeclaredType
list expectedResults : ExpectedResult as expectedresult prefix x
list templateParts : TemplatePart
list validationRules : ValidationRule
list validationMembers : ValidationMember
list validationNodes : ValidationNode
