flags FunctionCapabilities {
    | engine MayChangeSignature MayBeCloned MayBeInlined HasOrdinaryFrame IsNeverCalledByHost IsHiddenInStackTraces
    RecordsCallee
}
enum FunctionRole (hasSourceBody: Bool, canBeCalledByValue: Bool, record: Name, capabilities: FunctionCapabilities | engine showsSourceText: Bool) {
    Source(true, true, None, MayChangeSignature+MayBeCloned+MayBeInlined+HasOrdinaryFrame+IsNeverCalledByHost, true)
    Library(true, true, None, MayChangeSignature+MayBeCloned+MayBeInlined+HasOrdinaryFrame, false)
    Model(true, false, None, none, false)
    Signature(false, false, None, none, false)
    | engine
    CoroutineBody(false, false, Coroutine, none, false)
    OutlinedBody(false, false, None, HasOrdinaryFrame+IsNeverCalledByHost+IsHiddenInStackTraces, false)
    StubBody(false, false, StubBody, none, false)
}

enum CoroutineKind { | engine Generator AsyncFunction AsyncGenerator }
enum TypedResultForm { | engine None ParsedText ParsedBody Rows }

record InlineFrame engine {
    callee: Function(Dispatch)? callPosition: UInt32 parent: UInt32 isTailCall: Bool isConstruction: Bool callIsPartOfConstruction: Bool module: Module(Referrer)?
    calledBuiltin: Builtin?
}
record Origin engine { position: UInt32 inlineFrame: UInt32 isTailCall: Bool isPartOfConstruction: Bool }
