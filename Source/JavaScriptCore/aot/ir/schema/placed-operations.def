family Representation Placed..Placed
operation Box (value: Convertible/returns) -> natural(same(value)) ; none ; passThrough = Form ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = Number ; openIn = Loop ; closedIn = UnlikelyBlock, RareBlock
operation Unbox (value: Convertible/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation IntegerToNumber (value: Integer/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation NumberToInteger (value: Number/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation WidenInteger (value: Integer/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation NarrowInteger (value: Integer/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation Decode (value: Convertible/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
operation Compress (value: Convertible/returns) -> natural(same(value)) ; none ; passThrough = Form ; form = Open
