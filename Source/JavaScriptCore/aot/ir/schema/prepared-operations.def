# A builder that lies in the frame: StackStringBuilder of runtime/AOTStringBuilderStorage.h. `builder` is the address of the record, and the code of none of the operations above takes it:
# the handlers of Append, Length, ToString, Finish and Discard build these in their place, and nobody builds any other for such a builder.
# The cursor, where the next character goes, is a value: whatever appends takes it and gives the next one, and the last part of a row stores it in the record. No cursor but the newest is good, and none is good behind Finish or Discard.
# Start is the cursor of a builder that holds nothing yet, Cursor the one in the record.
# firstPart, endOfFirstPart: the string that was appended first, and the cursor behind it. Where that is still the cursor the string is the text.
# stringUse: StringBuilderStorage::StringUse.
engine operation StackStringBuilderBegin () -> natural(StringBuilder) ; writes(StringBuilderContents) ; form = Open
engine operation StackStringBuilderStart (builder: StringBuilder/inspects) -> natural(BuilderCursor) ; none ; base = builder ; form = Open
engine operation StackStringBuilderCursor (builder: StringBuilder/inspects) -> natural(BuilderCursor) ; reads(StringBuilderContents) ; base = builder ; form = Open
engine operation StackStringBuilderLength (builder: StringBuilder/inspects, cursor: BuilderCursor/inspects) -> natural(int[0, 2147483647]) ; reads(StringBuilderContents) ; base = builder ; form = Open
engine operation StackStringBuilderToString (builder: StringBuilder/inspects, cursor: BuilderCursor/inspects) -> natural(string) ; AppendsToBuilder ; runtime = StackStringBuilderToString ; base = builder ; form = Runtime
engine operation StackStringBuilderFinish (builder: StringBuilder/inspects, cursor: BuilderCursor/inspects, firstPart?: String/returns, endOfFirstPart?: BuilderCursor/inspects, stringUse: UInt32) -> natural(string) ; AppendsToBuilder ; runtime = StackStringBuilderFinish ; base = builder ; form = Runtime
engine operation StackStringBuilderDiscard (builder: StringBuilder/inspects) -> none ; reads(StringBuilderContents, RuntimeState) writes(StringBuilderContents, RuntimeState) ; runtime = StackStringBuilderDiscard ; form = Open

