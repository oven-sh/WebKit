enum BuiltinCallForm { | engine Whole Fields Prefix AnyReceiver List }
enum QuotientRounding { | engine Floor Ceil Truncate Round ToInt32 }
enum AsyncGeneratorStepStatus { | engine Yielded Completed Awaited }

parameters SlotStamp (key: PropertyKey, receivers: LayoutSet, level: KnowledgeLevel, accessSite?: AccessSite, from Placed fieldAccess?: FieldAccess)

family Guard Prepared..Placed ; branches = May ; interpreted = Test
operation ShapeTest (object: Any/inspects, layouts: LayoutSet) -> natural(boolean) ; reads(ShapeWords[layouts]) ; proves = Shape
operation IsSlotFilled (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> natural(boolean) ; reads(ObjectFields[key]) ; proves = SlotFilled ; relies = Shape ; guarded = object ; access = Has ; receiver = object ; accessClass = Slot ; replaces = PropHas, PropHasOwn, PrivateHas
operation HasNoExtraProperties (object: Object/inspects, guard?: Guard/inspects) -> natural(boolean) ; reads(NamedProperties) ; proves = NoExtraProperties ; relies = Shape ; guarded = object
operation IsNotFrozen (object: Object/inspects, guard?: Guard/inspects) -> natural(boolean) ; reads(ShapeWords, OrderWords) ; proves = NotFrozen ; relies = Shape ; guarded = object
operation HasLayoutPrototype (object: Object/inspects, guard?: Guard/inspects) -> natural(boolean) ; reads(PrototypeLinks) ; proves = PrototypeLinkUnchanged ; relies = Shape ; guarded = object
operation BelongsToInstance (object: Object/inspects) -> natural(boolean) ; reads(ShapeWords) ; proves = OwnInstance
operation IsPristine (value: Any/inspects, builtinClass: BuiltinClass, aspects: PristineAspects) -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; proves = Pristine ; replaces = IsPristineArray
operation HasArrayStorage (array: Array/inspects, arrayStorage: ArrayStorage) [isWritable] -> natural(boolean) ; reads(ArrayStorage) ; proves = ArrayStorage
operation IsInBounds (array: Array/inspects, position: Integer/inspects) -> natural(boolean) ; reads(ArrayStorage) ; proves = InBounds
operation IsNotThenable (value: Any/inspects) -> natural(boolean) ; reads(NamedProperties, ObjectFields, PrototypeLinks) ; proves = NotThenable ; replaces = ReturnAsyncResult, ResolvePromise
operation IsMemberUnchanged (layout: Layout, side: ClassSide, key: PropertyKey, from Placed guardBit?: GuardBit) -> natural(boolean) ; reads(MemberGuards[layout]) ; proves = MemberUnchanged
operation IsPrototypeLinkUnchanged (layout: Layout, side: ClassSide, from Placed guardBit?: GuardBit) -> natural(boolean) ; reads(MemberGuards[layout]) ; proves = PrototypeLinkUnchanged
operation IsClassEvaluatedOnce (layout: Layout, from Placed guardBit?: GuardBit) -> natural(boolean) ; reads(MemberGuards[layout]) ; proves = EvaluatedOnce
operation IsRequireEdgeReady (module: Module(Target), referrer: Module(Referrer), from Placed edge?: UInt32) -> natural(boolean) ; reads(ExternalState) ; proves = RequireEdgeReady
operation HasKeyOrder (object: Layout/inspects, guard?: Guard/inspects, layout: Layout, fields: List<Field>, from Placed orderWord?: OrderWord) -> natural(boolean) ; reads(OrderWords) ; proves = KeyOrder ; relies = Shape ; guarded = object
operation IsShapeEpochCurrent (epoch: Integer/inspects, guard: Guard/inspects) -> natural(boolean) ; reads(ShapeEpoch) ; proves = EpochCurrent ; relies = none
operation IsClosureOf (function: Function(Dispatch), value: Any/inspects) -> natural(boolean) ; none ; proves = ExactFunction
operation IsEnumeratorCurrent (enumerator: Enumerator/inspects, object: Any/inspects, position: Integer/inspects) -> natural(boolean) ; reads(ShapeWords, OrderWords, NamedProperties) ; proves = EnumeratorCurrent

family GuardValue Prepared..Placed
operation GetShapeEpoch () -> natural(integer) ; reads(ShapeEpoch)
operation AllGuards (guards...: Guard/inspects) -> natural(Guard) ; none ; relies = none ; interpreted = Guards

family SlotAccess Prepared..Placed ; receiver = object ; accessClass = Slot
operation GetSlot (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> declared(key) ; reads(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; interpreted = Read ; replaces = PropGet, PrivateGet
operation GetSlotOrUndefined (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> declared(key) ; reads(ObjectFields[key]) ; access = Read ; relies = Shape ; guarded = object ; interpreted = Read ; replaces = PropGet
operation GetDeferredClosureSlot (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> declared(key) ; Allocates reads(ObjectFields[key]) writes(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; replaces = PropGet ; runtime = MaterializeDeferredClosure
operation PutSlot (object: Object/inspects, guard?: Guard/inspects, value: Declared/retains(object), with SlotStamp) -> none ; writes(ObjectFields[key]) ; access = Store ; stored = value ; relies = Shape, NotFrozen ; guarded = object ; interpreted = Store ; replaces = PropSet, PropDefine, PrivateSet, PrivateDefine ; runsOwnerBarrier = true ; remembersOwner = true
operation PutSlotOrAdd (object: Object/inspects, guard?: Guard/inspects, value: Declared/retains(object), with SlotStamp) -> none ; Allocates reads(ObjectFields[key], OrderWords) writes(ObjectFields[key], OrderWords, RuntimeState) ; access = Store ; stored = value ; relies = Shape, NotFrozen ; guarded = object ; interpreted = Store ; replaces = PropSet, PropDefine, PrivateDefine ; runtime = DidCreateField ; runsOwnerBarrier = true

family OwnAccess Prepared..Placed
operation PropHasOwn (object: Any/inspects+runs(OwnKeys), key: PropertyKey, with AccessStamp) -> natural(boolean) ; Allocates UsesRuntime reads(ObjectFields, NamedProperties, Elements, ArrayStorage, ShapeWords, OrderWords) throws by Access ; access = Has ; receiver = object ; interpreted = Test ; accessClass = ByName ; branches = May ; replaces = CallBuiltin ; runtime = HasOwnProperty

family Access Prepared..Placed
operation CopyObject (source: Any/Copied, excludedKeys: List<PropertyKey>, excluded...: PropertyKey/inspects, from Placed request?: Request) -> natural(object) ; DefinesProperty ; replaces = NewObject, CopyDataProperties ; runtime = CopyObject
operation TryCopyFields (object: Object/inspects, source: Object/inspects+retainsContents, layout: Layout) -> natural(boolean) ; reads(ShapeWords, ObjectFields, OrderWords, NamedProperties) writes(ObjectFields, OrderWords) ; branches = May ; replaces = CopyDataProperties

family ElementAccess Prepared..Placed
operation GetArrayLength (array: Array/inspects, guard?: Guard/inspects) -> natural(uint32) ; reads(ArrayStorage) ; relies = Pristine, ArrayStorage ; guarded = array ; interpreted = Read
operation GetArrayElement (array: Array/inspects+readsContents, position: Number/inspects, guard?: Guard/inspects, arrayStorage: ArrayStorage, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInBounds] -> unknown => declared(array) ; CreatesString reads(ArrayStorage, Elements[Array], NamedProperties) ; relies = Pristine, ArrayStorage, InBounds ; guarded = array ; interpreted = Read ; replaces = ElemGet ; accessClass = Slot
operation PutArrayElement (array: Array/inspects+writesContents, position: Number/inspects, value: Any/retains(array), guard?: Guard/inspects, arrayStorage: ArrayStorage, mode: ECMAMode, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInBounds] -> none ; GrowsArray writes(NamedProperties) ; relies = Pristine, ArrayStorage, InBounds ; guarded = array ; interpreted = Store ; replaces = ElemSet, ElemDefine ; accessClass = Slot ; runtime = ArrayPutAtIndex ; runsOwnerBarrier = true
operation HasArrayElement (array: Array/inspects, position: Number/inspects, guard?: Guard/inspects, arrayStorage: ArrayStorage, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral] -> natural(boolean) ; CreatesString reads(ArrayStorage, Elements[Array], NamedProperties) ; relies = Pristine, ArrayStorage ; guarded = array ; interpreted = Test ; replaces = ElemHas ; accessClass = Slot ; branches = May
operation AppendElements (array: Array/inspects+writesContents, source: Array/Listed, guard?: Guard/inspects) -> none ; GrowsArray ; relies = Pristine, ArrayStorage ; guarded = source ; interpreted = List ; replaces = AppendSpread ; runtime = AppendElements
operation HasSpareArrayCapacity (array: Array/inspects) -> natural(boolean) ; reads(ArrayStorage) ; branches = May
operation ReserveArrayCapacity (array: Array/inspects+writesContents, additional: Integer/inspects) -> none ; reads(ArrayStorage, Elements[Array], AllocatorState) writes(ArrayStorage, Elements[Array], AllocatorState, RuntimeState) collects ; runtime = ReserveArrayCapacity
operation GetTypedArrayLength (view: Object/inspects, typedArrayType: TypedArrayType) -> natural(int[0, 17179869184]) ; reads(TypedArrayStorage)
operation GetTypedArrayElement (view: Object/inspects, position: Number/inspects, typedArrayType: TypedArrayType, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral] -> natural(number | bigint | undefined) ; Allocates reads(TypedArrayStorage, TypedArrayElements) ; replaces = ElemGet ; accessClass = Slot
operation PutTypedArrayElement (view: Object/inspects+writesContents, position: Number/inspects, value: Any/inspects, typedArrayType: TypedArrayType, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral] -> none ; reads(TypedArrayStorage) writes(TypedArrayElements) ; replaces = ElemSet ; accessClass = Slot
operation GetStringLength (string: String/inspects) -> natural(int[0, 2147483647]) ; none ; interpreted = Read
operation GetStringCodeUnit (string: String/inspects, position: Integer/inspects) -> natural(int[0, 65535]) ; ResolvesRopes

family Arguments Prepared..Placed ; boundTo = Frame
operation GetArgument (argumentIndex: UInt32) -> unknown ; none
operation GetRestLength (firstArgument: UInt32) -> natural(int[0, 2147483647]) ; none
operation ReturnsToResultTest () -> natural(boolean) ; none ; branches = May
operation CreateRest (firstArgument: UInt32, allocationSite?: AllocationSite) -> allocation(Array) ; Allocates ; interpreted = Allocation ; allocatesInline = true ; runtime = NewArray
operation GetMyArgumentByVal (property: Any/Converted, firstArgument: UInt32) [readsArgumentsObject] -> unknown ; CreatesString reads(NamedProperties) ; runtime = GetFromArguments
operation CallForwardVarargs (callee: Any/calls, thisValue: Any/retains, firstArgument: UInt32, with CallStamp) [isDemotedTailCall] -> unknown ; unknownCode by Call ; accessClass = IndirectCall
operation ConstructSuperForwardVarargs (layout: Layout, parent: Any/calls, newTarget: Any/retains, firstArgument: UInt32, with CallStamp) [keepsShape] -> declared(layout) ; unknownCode by Call ; accessClass = IndirectCall

family Environment Prepared..Placed
operation GetCapture (function: Function(Dispatch), index: UInt32, closure: Callable/inspects) -> declared(function) ; none ; interpreted = Read
operation MaterializeEnvironment (environment: Environment/inspects+returns, layout: Layout, from Placed allocation?: Allocation) -> natural(same(environment)) ; Allocates reads(EnvironmentFields) ; runtime = MaterializeEnvironment ; allocatesInline = true ; boundTo = Frame
operation MarkEnvironmentEscaped (environment: Environment/inspects) -> none ; writes(RuntimeState) ; boundTo = Frame
operation ReleaseEnvironment (environment: Environment/inspects) -> none ; reads(RuntimeState) writes(EnvironmentFields, AllocatorState, RuntimeState) ; boundTo = Frame

family BuiltinCall Prepared..Placed
operation CallBuiltin (overload: BuiltinOverload, builtinCallForm: BuiltinCallForm, prefixLength?: UInt32, receiver?: Any/retains+returns+calls, arguments...: Any/retains+returns+calls, expectedResult?: ExpectedResult, accessSite?: AccessSite, allocationSite?: AllocationSite, from Selected literalSeparator?: String) [needsPristineReceiver isDemotedTailCall] -> declared(overload) ; unknownCode by Builtin ; accessClass = DirectCall ; interpreted = Allocation ; replaces = Call, Construct, PropGet, PropSet, CallList, CallBuiltin, NewArray, AppendSpread
operation DivideIntegers (dividend: Integer/inspects, divisor: Integer/inspects, rounding: QuotientRounding) -> natural(integer) ; none
operation ToInt32 (value: Number/inspects) -> natural(int32) ; none ; runtime = ToInt32
operation ToUint32 (value: Number/inspects) -> natural(uint32) ; none ; runtime = ToInt32
operation ToIntegerOrInfinity (value: Number/inspects) -> natural(number) ; none
operation NewSetFromData (data: Data, allocationSite?: AllocationSite, from Placed request?: Request) -> allocation(Set) ; Allocates throws ; runtime = NewSetFromData ; replaces = CallBuiltin
operation NewMapFromData (data: Data, allocationSite?: AllocationSite, from Placed request?: Request) -> allocation(Map) ; Allocates throws ; runtime = NewMapFromData ; replaces = CallBuiltin
operation NewArgumentList (callee: Any/inspects, arrayLike: Any/retains) -> allocation(Array) ; unknownCode ; runtime = NewArgumentList
operation SharedRegExpLiteral (pattern: String, regExpFlags: RegExpFlags, from Placed regExpRecord?: RegExpRecord, from Placed staticsOffset?: StaticsOffset) -> natural(RegExp) ; CreatesConstant ; runtime = SharedRegExpLiteral ; boundTo = Site

family ExpandedIteration Prepared..Placed
operation DestructureIterable (iterable: Any/Iterated, count: UInt32) -> results(unknown, ..) ; Allocates throws ; interpreted = List ; runtime = DestructureIterable ; replaces = IteratorOpen, IteratorResume, IteratorClose
operation EnumeratorGetByVal (object: Any/inspects, property: Any/inspects, enumerator: Enumerator/inspects, position: Integer/inspects, guard: Guard/inspects) -> unknown ; Allocates UsesRuntime reads(NamedProperties, ObjectFields) ; receiver = object ; accessClass = Slot ; replaces = ElemGet ; runtime = EnumeratorGetByVal ; relies = EnumeratorCurrent ; guarded = enumerator
operation RequireAttachedTypedArray (view: Object/inspects) -> none ; reads(TypedArrayStorage) throws ; runtime = ThrowIfTypedArrayIsDetached
operation CreateAsyncFromSyncIterator (iterator: Object/retains(result), next: Any/retains(result)) -> natural(object) ; Allocates ; runtime = CreateAsyncFromSyncIterator
operation ThrowNotIterable (iterable: Any/inspects) [isSpread] -> natural(never) ; Allocates UsesRuntime throws ; runtime = ThrowNotIterable

family SavedFrame Prepared..Placed
operation NewGenerator (function: Function(Dispatch), callee: Callable/inspects, allocationSite?: AllocationSite) -> allocation(Generator) ; Allocates reads(NamedProperties) ; runtime = NewGenerator ; interpreted = Allocation
operation NewAsyncGenerator (function: Function(Dispatch), callee: Callable/inspects, allocationSite?: AllocationSite) -> allocation(AsyncGenerator) ; Allocates reads(NamedProperties) ; runtime = NewGenerator
operation IsUnmodifiedAsyncGenerator (value: Object/inspects) -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; proves = UnmodifiedGenerator ; branches = May
operation StepAsyncGenerator (generator: Object/inspects+calls, value: Any/retains) -> results(StepGeneratorResult: unknown, natural(AsyncGeneratorStepStatus)) ; unknownCode ; runtime = StepAsyncGenerator ; boundTo = Frame
operation AwaitBySavingFrame (awaited: Any/retains+runs(Thenable), promise: Any/inspects) -> unknown => declared(awaited) ; unknownCode suspends ; runtime = SaveFrameAndAwait ; boundTo = Frame ; replaces = Await
operation AwaitCallBySavingFrame (function: Function(Call), promise: Any/inspects, arguments...: Declared/retains, accessSite?: AccessSite) [isDemotedTailCall] -> unknown ; unknownCode suspends by Call ; accessClass = DirectCall ; runtime = SaveFrameAndAwaitCall ; boundTo = Frame ; replaces = AwaitBySavingFrame, CallDirect
operation YieldBySavingFrame (generator: Object/inspects, value: Any/retains) -> results(YieldResult: unknown, natural(ResumeMode)) ; unknownCode suspends ; runtime = SaveFrameAndYield ; boundTo = Frame ; replaces = Yield, InitialYield
operation AsyncGeneratorYield (generator: Object/inspects, value: Any/retains+runs(Thenable)) -> results(YieldResult: unknown, natural(ResumeMode)) ; unknownCode suspends ; runtime = SaveFrameAndYield ; boundTo = Frame ; replaces = Await, Yield
operation ReturnAsyncResult (promise: Any/inspects, value: Any/retains+runs(Thenable)) -> unknown ; Allocates UsesRuntime reads(PromiseState, NamedProperties, ObjectFields, PrototypeLinks) writes(PromiseState) ; runtime = ResolvePromiseOrReturnResult ; boundTo = Frame
operation PromiseAllOfElements (contents: Type, elements...: Any/retains+runs(Thenable)) -> allocation(Promise<contents>) ; Allocates UsesRuntime reads(PromiseState) writes(PromiseState) ; runtime = PromiseAll ; replaces = CallBuiltin

family Operator Prepared..Placed
operation HasInPrototypeChain (value: Any/inspects+runs(PrototypeChain), prototype: Object/inspects) -> natural(boolean) ; Allocates reads(PrototypeLinks) throws ; runtime = DefaultHasInstance ; branches = May ; replaces = InstanceOf

family Module Prepared..Placed
operation GetRequiredValue (guard: Guard/inspects, module: Module(Target)) -> unknown ; reads(ExternalState) ; relies = RequireEdgeReady ; replaces = RequireModule

