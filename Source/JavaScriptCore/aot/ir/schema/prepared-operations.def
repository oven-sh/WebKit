family Environment Prepared..Placed
operation GetCapture (function: Function(Dispatch), index: UInt32, closure: Callable/inspects) -> declared(function) ; none ; AsRead..Placed ; interpreted = Read ; flow = Copies ; flowsWithoutRule = true ; form = Open
operation MarkEnvironmentEscaped (environment: Environment/inspects) -> none ; writes(RuntimeState) ; boundTo = Frame ; form = Open
# It writes nothing that anybody can ask about: the sweep lets it hand the cell back only where nothing reads the cell any more, under any name.
operation ReleaseEnvironment (environment: Environment/inspects) -> none ; reads(RuntimeState) writes(AllocatorState, RuntimeState) ; boundTo = Frame ; form = Open
