operation AsyncGeneratorYield (generator: Object/inspects, value: Any/retains+runs(Thenable), held...: Convertible/retains) -> results(YieldResult: unknown, natural(ResumeMode)) ; unknownCode suspends ; runtime = SaveFrameAndYield ; boundTo = Frame ; replaces = Await, Yield ; form = Closed
operation ReturnAsyncResult (promise: Any/inspects+returns+writesContents, value: Any/retains+returns+runs(Thenable)) -> unknown ; Allocates UsesRuntime reads(PromiseState, NamedProperties, ObjectFields, PrototypeLinks) writes(PromiseState) ; runtime = ResolvePromiseOrReturnResult ; boundTo = Frame ; form = Closed
operation PromiseAllOfElements (contents: Type, directCalls: UInt32, elements...: Any/retains+runs(Thenable)) -> allocation(Promise<contents>) ; unknownCode ; runtime = PromiseAll ; replaces = CallBuiltin ; form = Runtime

family Operator Prepared..Placed
operation HasInPrototypeChain (value: Any/inspects+runs(PrototypeChain), prototype: Object/inspects) -> natural(boolean) ; Allocates reads(PrototypeLinks) throws ; runtime = DefaultHasInstance ; branches = May ; replaces = InstanceOf ; hasOwnFoldingRule = true ; form = Closed
engine operation TryFindInPrototypeChain (value: Any/inspects, prototype: Object/inspects) -> natural(int[0, 2]) ; reads(PrototypeLinks) ; form = Closed
engine operation HasDefaultHasInstance (constructor: Object/inspects) -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; form = Closed

family Module Prepared..Placed
operation BeginModuleEvaluation (module: Module(Target)) -> natural(boolean) ; unknownCode ; runtime = BeginModuleEvaluation ; branches = May ; form = Open
operation FinishModuleEvaluation (module: Module(Target)) -> none ; writes(ExternalState) ; form = Open
operation EnterBodyThatRunsOnce (functionNumber: UInt32) -> none ; reads(RuntimeState) writes(RuntimeState) ; runtime = EnterBodyThatRunsOnce ; form = Runtime
operation EvaluateRequiredModule (module: Module(Target), referrer: Module(Referrer), specifier: String, calledBuiltin?: Builtin) -> none ; unknownCode ; runtime = RequireModule ; form = Open

family Control Prepared..Placed
terminator SwitchOnShape (subject: Object/inspects, layoutSets: List<LayoutSet>) -> case...(proof), otherwise ; reads(ShapeWords) ; proves = Shape
