enum BuiltinCallForm { | engine Whole Fields Prefix AnyReceiver List }
enum QuotientRounding { | engine Floor Ceil Truncate Round ToInt32 }
enum AsyncGeneratorStepStatus { | engine Result Yielded Completed }

parameters SlotStamp (key: PropertyKey, receivers: LayoutSet, level: KnowledgeLevel, accessSite?: AccessSite, from Placed fieldAccess?: FieldAccess)

enum MemberConditionKind { | engine MemberUnchanged PrototypeLinkUnchanged ClassEvaluatedOnce InstancePrototypeUnchanged MemberNotHidden MemberPassedByStores }
record MemberConditionRecord engine { kind: MemberConditionKind layout: Layout side: ClassSide key: PropertyKey? }

family Guard Prepared..Placed ; branches = May ; interpreted = Test
# expectsCell: no number and no boolean is expected of the object, by what is written or by what Link has seen arrive. Whoever leaves the question whether it is a cell to the read of the word goes by it: readsOffNoCellFault.
operation ShapeTest (object: Any/inspects, layouts: LayoutSet) [| engine expectsCell refusesMarkedObjects] -> natural(boolean) ; reads(ShapeWords[layouts]) ; proves = Shape ; form = Open
# It asks for the loop where the slot lies out of line, as GetSlot does: what justifies the question stands above that row.
operation IsSlotFilled (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) [holdsDeclaredType countsFieldsWithoutStorage] -> natural(boolean) ; reads(ObjectFields[key]) ; proves = SlotFilled ; relies = Shape ; guarded = object ; access = Has ; receiver = object ; accessClass = Slot ; replaces = PropHas, PropHasOwn, PrivateHas ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop
# hasNoExtraProperties, hasNoFieldOutsideSlot: the test also asks what the test of that name asks, of any cell, finished or not. The bits of the three lie in one byte of the order word.
operation HasNoExtraProperties (object: Object/inspects, guard?: Guard/inspects) [| engine hasNoFieldOutsideSlot] -> natural(boolean) ; reads(NamedProperties) ; proves = NoExtraProperties ; relies = Shape ; guarded = object ; form = Open
operation HasNoFieldOutsideSlot (object: Object/inspects, guard?: Guard/inspects) [mayMeetUnfinishedObject] -> natural(boolean) ; reads(NamedProperties) ; proves = NoFieldOutsideSlot ; relies = Shape ; guarded = object ; form = Open
# hasLayoutPrototype: the test also asks what HasLayoutPrototype asks. The two bits lie in one byte of the cell.
operation HasBirthFieldsFilled (object: Object/inspects, guard?: Guard/inspects) [| engine hasLayoutPrototype] -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; proves = BirthFieldsFilled ; relies = Shape ; guarded = object ; form = Open
# Only a flag reads NamedProperties: declaredEffectsOfOperation().
operation IsNotFrozen (object: Object/inspects, guard?: Guard/inspects) [| engine hasNoExtraProperties hasNoFieldOutsideSlot] -> natural(boolean) ; reads(ShapeWords, OrderWords, NamedProperties) ; proves = NotFrozen ; relies = Shape ; guarded = object ; form = Open
operation HasLayoutPrototype (object: Object/inspects, guard?: Guard/inspects) -> natural(boolean) ; reads(PrototypeLinks) ; proves = PrototypeLinkUnchanged ; relies = Shape ; guarded = object ; form = Open
operation BelongsToInstance (object: Object/inspects) -> natural(boolean) ; reads(ShapeWords) ; proves = OwnInstance ; form = Open
operation IsPristine (value: Any/inspects, builtinClass: BuiltinClass, aspects: PristineAspects) -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; hasKnownValueRule = true ; proves = Pristine ; replaces = IsPristineArray, CallBuiltin ; form = Open
# admitsInt32Storage: arrayStorage is Double, and the array may have Int32 storage in its place. A list of numbers is read as numbers out of either.
# HasArrayStorage passes for both kinds, and what reads the array behind it has an arm for each.
operation HasArrayStorage (array: Array/inspects, arrayStorage: ArrayStorage) [isWritable | engine admitsInt32Storage] -> natural(boolean) ; reads(ArrayStorage) ; proves = ArrayStorage ; form = Open
# storage: GetArrayStorage of the array, only where no length is named.
operation IsInBounds (array: Array/inspects, position: Integer/inspects, storage?: ArrayStoragePointer/inspects, length...: Integer/inspects) [| engine isFromProgram] -> natural(boolean) ; reads(ArrayStorage) ; proves = InBounds ; form = Open
# isInBounds: the position is an index below the length that the array has where the test stands. The test looks for a hole and at no length, and names none.
operation IsElementPresent (array: Array/inspects, position: Number/inspects, guard?: Guard/inspects, storage?: ArrayStoragePointer/inspects, length...: Integer/inspects, arrayStorage: ArrayStorage) [keyIsIntegral | engine isFromProgram admitsInt32Storage isInBounds] -> natural(boolean) ; reads(ArrayStorage, Elements[Array]) ; proves = InBounds ; relies = ArrayStorage ; guarded = array ; form = Open
# mayEqualLength: the position is the end of a stretch of positions, which lies inside the view where it is no greater than the length. A stretch that holds nothing ends where it begins.
operation IsInsideView (view: Object/inspects, position: Number/inspects, typedArrayType: TypedArrayType) [keyIsIntegral | engine mayEqualLength] -> natural(boolean) ; reads(TypedArrayStorage) ; proves = InBounds ; form = Open
operation IsPrototypeOfClass (prototype: Object/inspects, layout: Layout) -> natural(boolean) ; reads(MemberGuards) ; proves = PrototypeLinkUnchanged ; form = Open
operation IsNotThenable (value: Any/inspects) -> natural(boolean) ; reads(NamedProperties, ObjectFields, PrototypeLinks, RuntimeState) ; proves = NotThenable ; replaces = ReturnAsyncResult, ResolvePromise ; form = Open
operation AreMembersUnchanged (conditions: List<MemberConditionRecord>, from Placed guardBit?: GuardBit) -> natural(boolean) ; reads(MemberGuards[conditions]) ; proves = MemberUnchanged ; form = Open
operation HasKeyOrder (object: Layout/inspects, guard?: Guard/inspects, layout: Layout, fields: List<Field>, from Placed orderWord?: OrderWord) [| engine hasNoFlags] -> natural(boolean) ; reads(OrderWords) ; proves = KeyOrder ; relies = Shape ; guarded = object ; form = Open
operation IsClosureOf (function: Function(Dispatch), value: Any/inspects) -> natural(boolean) ; none ; AsRead..Placed ; proves = ExactFunction ; flow = TableProves ; hasOwnFoldingRule = true ; form = Open
operation IsEnumeratorCurrent (enumerator: Enumerator/inspects, object: Any/inspects, position: Integer/inspects) -> natural(boolean) ; reads(ShapeWords, OrderWords, NamedProperties) ; proves = EnumeratorCurrent ; form = Open

family GuardValue Prepared..Placed
operation AllGuards (guards...: Guard/inspects) -> natural(Guard) ; none ; relies = none ; interpreted = Guards ; form = Open
operation Entered (function: Function(Dispatch)) -> natural(Fact) ; none ; form = Open
operation Specified () -> natural(Fact) ; none ; form = Open

family SlotAccess Prepared..Placed ; receiver = object ; accessClass = Slot
# A slot lies out of line because few makers of its layout fill it. The way to it in line is the word of the Extension, the bits of its granules, a count of bits, the load and an arm for "no storage":
# about 58 bytes a read, 14,863 reads, 0.67 MB = 1.4% of the bodies of the compiler benchmark. Outside the loops of the unit the stub ReadFieldInExtension goes that way, in one call, and a test of the slot and the read behind it are one call.
# In a loop the way stays in line. The stub in every turn, and the call outside loops against the code in line: NOT MEASURED YET.
# The rows below that set the column, IsSlotFilled and PutSlotOrAdd ask the same question of the same slots.
operation GetSlot (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) [holdsDeclaredType | engine expectsCell isFilledWhereShapeFits receiverMayBeInBirth] -> declared(key) ; reads(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; interpreted = Read ; replaces = PropGet, PrivateGet ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop
operation GetSlotOrUndefined (object: Object/inspects, guard?: Guard/inspects, conditions: List<MemberConditionRecord>, with SlotStamp) [| engine expectsCell receiverMayBeInBirth] -> declared(key) ; reads(ObjectFields[key], MemberGuards[conditions]) ; access = Read ; relies = Shape ; guarded = object ; interpreted = Read ; replaces = PropGet ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop
operation GetSlotGetter (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> declared(key) ; reads(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; replaces = PropGet ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop
operation GetSlotSetter (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) [isInStrictCode] -> declared(key) ; reads(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; replaces = PropSet ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop
# writesOnlyItsAnswer: what the operation writes is the cell that it answers with, laid where the next read finds it. Where nobody takes the answer, whether the cell is made now, later or never cannot be seen.
operation GetDeferredClosureSlot (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) [holdsDeclaredType] -> declared(key) ; Allocates reads(ObjectFields[key]) writes(ObjectFields[key]) ; access = Read ; relies = Shape, SlotFilled ; guarded = object ; replaces = PropGet ; runtime = MaterializeDeferredClosure ; writesOnlyItsAnswer = true ; form = Open
operation GetDeferredClosureSlotOrUndefined (object: Object/inspects, guard?: Guard/inspects, with SlotStamp) -> declared(key) ; Allocates reads(ObjectFields[key], NamedProperties, OrderWords) writes(ObjectFields[key]) ; access = Read ; relies = Shape ; guarded = object ; replaces = PropGet ; runtime = MaterializeDeferredClosure ; writesOnlyItsAnswer = true ; form = Open
# isDefinition: the store replaces a definition, so a receiver without a slot takes a PropDefine, which calls no setter.
operation PutSlot (object: Object/inspects, guard?: Guard/inspects, value: Declared/retains(object), with SlotStamp, mode: ECMAMode) [isDefinition | engine expectsCell] -> none ; writes(ObjectFields[key]) ; access = Store ; stored = value ; relies = Shape, NotFrozen ; guarded = object ; interpreted = Store ; replaces = PropSet, PropDefine, PrivateSet, PrivateDefine ; runsOwnerBarrier = true ; remembersOwner = true ; form = Open
# isExpectedToCreate: the object is still being filled, so the emitter asks first whether the field comes next in the order of its keys.
# orderWordAfter: the walk knows the order word of the cell, so the cell lacks the field, and this is its word behind the store. hasNoExtension: in front of the store the cell has none.
operation PutSlotOrAdd (object: Object/inspects, guard?: Guard/inspects, value: Declared/retains(object), conditions: List<MemberConditionRecord>, with SlotStamp, mode: ECMAMode, orderWordAfter?: OrderWord) [isDefinition | engine isExpectedToCreate hasNoExtension expectsCell] -> none ; AllocatesWithoutCollecting reads(ObjectFields[key], OrderWords, RuntimeState, MemberGuards[conditions]) writes(ObjectFields[key], OrderWords, RuntimeState) ; access = Store ; stored = value ; relies = Shape, NotFrozen ; guarded = object ; interpreted = Store ; replaces = PropSet, PropDefine, PrivateDefine ; runtime = DidCreateField ; runsOwnerBarrier = true ; remembersOwner = true ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = FieldInExtension ; openIn = Loop ; closedIn = UnlikelyBlock, RareBlock

family Allocation Prepared..Placed
operation FinishBirth (object: Object/inspects) -> none ; reads(ObjectFields) writes(RuntimeState) ; form = Open
# The fields of the birth are looked at in line where all of them lie in the cell, and by the run time otherwise. runtimeIn: in a block that is seldom reached the run time looks in either case: AllocationEmitter::generateTryFinishBirth(). Not measured.
operation TryFinishBirth (object: Object/inspects) -> none ; reads(ObjectFields, OrderWords) writes(RuntimeState) ; runtime = TryFinishBirth ; runtimeUnder = Always ; openUnder = BirthFieldsInCell ; runtimeIn = UnlikelyBlock, RareBlock
# An empty literal and the first list that is spread into it. A hole of the source is read as undefined. capacity: room for the elements of the source and for what is appended later, a hint.
operation NewArrayOfElements (contents: Type, source: Array/Listed, capacity?: Integer/inspects, arrayStorage: ArrayStorage) -> allocation(Array<contents>) ; Allocates reads(ArrayStorage, Elements[Array]) throws ; runtime = NewArrayOfElements ; interpreted = Allocation ; replaces = NewArray, AppendSpread ; flow = Allocates ; form = Closed

family OwnAccess Prepared..Placed
operation PropHasOwn (object: Any/inspects+runs(OwnKeys), key: PropertyKey, calledBuiltin?: Builtin, with AccessStamp) -> natural(boolean) ; Allocates UsesRuntime reads(ObjectFields, NamedProperties, Elements, ArrayStorage, ShapeWords, OrderWords) throws by Access ; access = Has ; receiver = object ; interpreted = Test ; accessClass = ByName ; branches = May ; replaces = CallBuiltin ; runtime = HasOwnByIdAndCache ; form = Closed
# What Object.getOwnPropertyDescriptor(object, property) describes, without the descriptor: whether there is such a property, then value, writable, get, set, enumerable and configurable. A part that the descriptor would lack is undefined.
operation GetOwnPropertyFields (object: Any/retains, property: Any/retains, calledBuiltin?: Builtin) -> results(natural(boolean), unknown, unknown, unknown, unknown, natural(boolean), natural(boolean)) ; unknownCode ; replaces = CallBuiltin, PropGet ; runtime = GetOwnPropertyFields ; form = Runtime

family Access Prepared..Placed
operation ReadAboveFreshObject (key: PropertyKey, accessSite?: AccessSite) -> unknown ; ReadsObjectGraph reads(PrototypeLinks) ; replaces = SuperGet ; form = Open
operation DidReadAbove (value: Any/inspects) -> natural(boolean) ; none ; form = Open
# targetIsBornFree: the target has one of a closed set of layouts, and Facts knows of no field of theirs that is born not configurable. A compiled object is then asked for its order word alone.
operation MayBindAnswersOfGetAndSetTraps (target: Object/inspects) [| engine targetIsBornFree] -> natural(boolean) ; reads(ShapeWords, OrderWords, NamedProperties) ; branches = May ; form = Open
operation MayBindAnswersOfHasTraps (target: Object/inspects) [| engine targetIsBornFree] -> natural(boolean) ; reads(ShapeWords, OrderWords, NamedProperties) ; branches = May ; form = Open
operation ValidateAnswerOfGetTrap (target: Object/retains, property: Any/retains, answer: Any/retains) -> none ; unknownCode ; runtime = ValidateAnswerOfGetTrap ; form = Runtime
operation ValidateDenialOfHasTrap (target: Object/retains, property: Any/retains) -> none ; unknownCode ; runtime = ValidateDenialOfHasTrap ; form = Runtime
operation ValidateConsentOfDeleteTrap (target: Object/retains, property: Any/retains) -> none ; unknownCode ; runtime = ValidateConsentOfDeleteTrap ; form = Runtime
operation HasOwnByAnswerOfDescriptorTrap (target: Object/retains, property: Any/retains, answer: Any/retains) -> natural(boolean) ; unknownCode ; runtime = HasOwnByAnswerOfDescriptorTrap ; form = Runtime
operation FinishStoreByTrap (mode: ECMAMode, target: Object/retains, property: Any/retains, value: Any/retains, answer: Any/retains) -> none ; unknownCode ; runtime = FinishStoreByTrap ; form = Runtime
operation TryCopyFields (object: Object/inspects, source: Object/inspects+retainsContents, layout: Layout) -> natural(boolean) ; reads(ShapeWords, ObjectFields, OrderWords, NamedProperties) writes(ObjectFields, OrderWords) ; branches = May ; replaces = CopyDataProperties ; form = Open
# cannotBeShadowed: no script that the build has not seen can declare the name in front of the property.
# findsOwnProperty: whatever the read answers with is the value of a property of the global object's own under the name. Where the object has none, the read does not run or throws.
# Outside of loops one stub looks at the constant of the record and then at the location that the record holds (a `let` or `var` of a script, a property that text or native code keeps replacing).
# In a loop the read does both in line, in 70 bytes: `s += ticks` ten million times, ticks a `let` of a script: 502.1 M instructions in line, 592.2 M by the stub (one binary; an earlier compiler took 288.0 M).
operation GetGlobalBinding (key: PropertyKey, level: KnowledgeLevel, accessSite?: AccessSite, from Placed binding?: GlobalBinding) [seesScriptBindings isForTypeOf | engine cannotBeShadowed findsOwnProperty] -> unknown => declared(key) ; unknownCode ; accessClass = Slot ; replaces = PropGet ; runtime = GetGlobalBinding ; formDependsOnLoop = true ; form = Closed ; openIn = Loop
# runtimeIn = CodeThatRunsOnce: the first store through a record files it, so a store that never comes again has nothing to find there and calls the run time at once: AccessEmitter::comesAgain(). Not measured.
operation SetGlobalBinding (key: PropertyKey, mode: ECMAMode, value: Any/retains, level: KnowledgeLevel, accessSite?: AccessSite, from Placed binding?: GlobalBinding) [seesScriptBindings] -> none ; unknownCode ; accessClass = Slot ; replaces = PropSet ; runtime = SetGlobalBinding ; formDependsOnLoop = true ; form = Closed ; openIn = Loop ; runtimeIn = CodeThatRunsOnce
operation GetCachedGetter (object: Object/inspects, key: PropertyKey, from Placed siteCache?: SiteCache) -> unknown ; reads(ShapeWords, NamedProperties, ObjectFields, PrototypeLinks, ArrayStorage, RuntimeState) ; replaces = PropGet ; form = Closed
operation GetAccessorOfMember (object: Object/inspects, key: PropertyKey, valueType: Type, from Placed siteCache?: SiteCache) [isSetter] -> declared(valueType) ; reads(ShapeWords, NamedProperties, ObjectFields, PrototypeLinks, ArrayStorage, RuntimeState) writes(RuntimeState) ; runtime = FindAccessorOfMember ; siteCaches = 1 ; form = Open
operation GetCachedValue (object: Any/inspects, key: PropertyKey, valueType: Type, from Placed siteCache?: SiteCache) -> declared(valueType) ; reads(ShapeWords, NamedProperties, ObjectFields, PrototypeLinks, RuntimeState) writes(RuntimeState) ; replaces = PropGet ; runtime = ReadValueWithoutCode ; siteCaches = 1 ; form = Open
# object[firstPart + secondPart]. Each part is a primitive and no symbol, and nobody else takes the text that the two join to: it is made only where the run time has not joined the same two before.
operation ElemGetByKeyParts (object: Any/retains, firstPart: Any/inspects, secondPart: Any/inspects, accessSite?: AccessSite) -> unknown ; unknownCode ; accessClass = ByName ; replaces = ElemGet, Strcat ; runtime = GetByValAndCache ; form = Closed

family ElementAccess Prepared..Placed
operation GetArrayLength (array: Array/inspects, guard?: Guard/inspects) -> natural(uint32) ; reads(ArrayStorage) ; relies = Pristine, ArrayStorage ; guarded = array ; interpreted = Read ; form = Open
# How many elements the storage of the array has room for. No program sees it. A list that is only appended to never gets less.
engine operation GetArrayCapacity (array: Array/inspects) -> natural(uint32) ; reads(ArrayStorage) ; form = Open
# Where the elements of the array lie. It moves where the storage is made anew: the array outgrows its room, takes storage without a form, or stops sharing its storage with a literal.
engine operation GetArrayStorage (array: Array/inspects) -> natural(ArrayStoragePointer) ; reads(ArrayStorage) ; base = array ; form = Open
# storage: GetArrayStorage of the array, only where arrayStorage has a form.
# Outside a loop of the function, after inlining, a read that may find nothing has one arm in line: an element of the array's own, inside the length, in the storage that arrayStorage names or else in storage that holds boxed values.
# Every other way (storage of doubles or without a form, a hole, a position behind the end or that is no index) leads to one rare block, where the stub answers, with undefined too.
# Named storage read at a position that is always an index has no stub anywhere: what is not found there is undefined.
# With every arm in line everywhere, the row GetArrayElement Open of the application's listing, every level and every kind of storage together: 117 bytes a site, 94,502 sites and 11.1 MB of its bodies.
# All arms once stood in line in a loop, so that a list of doubles would not pay the call on every turn: 117 bytes a site. Measured (one binary, a byte at the door): with one arm in a loop too a large application's code is 0.33 MB smaller
# and its build 0.5 G cheaper, the TypeScript compiler checking a project runs the same, and of 335 rows none is slower and a dozen are 2 to 9% faster: the arms cost the turns that never take them more than the call costs the others.
operation GetArrayElement (array: Array/inspects+readsContents, position: Number/inspects, guard?: Guard/inspects, storage?: ArrayStoragePointer/inspects, length...: Integer/inspects, arrayStorage: ArrayStorage, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInBounds isPresent readsHoleAsNaN | engine storageIsUndecided admitsInt32Storage] -> unknown => declared(array) ; CreatesString reads(ArrayStorage, Elements[Array], NamedProperties) ; relies = Pristine, ArrayStorage, InBounds ; guarded = array ; interpreted = Read ; replaces = ElemGet ; accessClass = Slot ; formDependsOnLoop = true ; openIn = Loop ; form = Open
# isExpectedToAppend: the store fills a list, so the arm that puts the element behind the last one is the one that it exists for. It changes no answer.
# storageIsWritable: a HasArrayStorage[isWritable] test of the array for arrayStorage has passed and still holds where the store stands.
# In a loop the store also puts an element behind the last one in line, and one that tests its own guess and names no kind has an arm for each kind that may take the value.
# Elsewhere it replaces an element inside the length, in one kind of storage, and the stub does the rest. A store that isExpectedToAppend keeps the arm behind the last element everywhere.
# With every arm everywhere, the bodies of the application: 39,454 stores of 118 bytes. Nothing shows yet that the question pays.
operation PutArrayElement(array: Array/inspects+writesContents, position: Number/inspects, value: Any/retains(array), guard?: Guard/inspects, storage?: ArrayStoragePointer/inspects, arrayStorage: ArrayStorage, mode: ECMAMode, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInBounds | engine isExpectedToAppend storageIsWritable] -> none ; GrowsArray writes(NamedProperties) ; relies = Pristine, ArrayStorage, InBounds ; guarded = array ; interpreted = Store ; replaces = ElemSet, ElemDefine ; accessClass = Slot ; runtime = ArrayPutAtIndex ; runsOwnerBarrier = true ; formDependsOnLoop = true ; openUnder = Always ; closedUnder = ValueNeverFitsStorage ; openIn = Loop
operation HasArrayElement (array: Array/inspects, position: Number/inspects, guard?: Guard/inspects, length...: Integer/inspects, arrayStorage: ArrayStorage, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral] -> natural(boolean) ; CreatesString reads(ArrayStorage, Elements[Array], NamedProperties) ; relies = Pristine, ArrayStorage ; guarded = array ; interpreted = Test ; replaces = ElemHas ; accessClass = Slot ; branches = May ; form = Open
operation AppendElements (array: Array/inspects+writesContents, source: Array/Listed, guard?: Guard/inspects) -> none ; GrowsArray ; relies = Pristine, ArrayStorage ; guarded = source ; interpreted = List ; replaces = AppendSpread ; runtime = AppendElements ; form = Closed
operation AppendMembers (array: Array/inspects+writesContents, source: Object/inspects+readsContents+retainsContents+writesContents, guard?: Guard/inspects) -> none ; GrowsArray reads(CollectionStorage, CollectionEntries) writes(CollectionStorage) ; relies = Pristine ; guarded = source ; replaces = AppendSpread ; runtime = AppendMembers ; form = Closed
# An empty literal and the Set that is spread into it. arrayStorage: the kind that the list is made with where every member fits.
operation NewArrayOfMembers (contents: Type, source: Object/inspects+readsContents+retainsContents+writesContents, arrayStorage: ArrayStorage) -> allocation(Array<contents>) ; Allocates reads(CollectionStorage, CollectionEntries) writes(CollectionStorage) throws ; runtime = NewArrayOfMembers ; interpreted = Allocation ; replaces = NewArray, AppendSpread ; flow = Allocates ; form = Closed
operation HasSpareArrayCapacity (array: Array/inspects) -> natural(boolean) ; reads(ArrayStorage) ; branches = May ; form = Open
# isSureToBeFilled: nothing but the end of its count ends the loop that the room is made for, so the room is made however much it is.
operation ReserveArrayCapacity (array: Array/inspects+writesContents, additional: Integer/inspects) [| engine isSureToBeFilled] -> none ; reads(ArrayStorage, Elements[Array], AllocatorState) writes(ArrayStorage, Elements[Array], AllocatorState, RuntimeState) collects ; runtime = ReserveArrayCapacity ; form = Runtime
# copiedFrom: the list that the array is a copy of. It is converted where the array was, so that the copies to come are born with Double storage.
# isExpectedToHoldNumbers: storage for any value is looked through as well, and converted where it holds numbers alone.
operation ConvertToDoubleStorage (array: Array/inspects+writesContents, copiedFrom?: Array/inspects+writesContents) [| engine isExpectedToHoldNumbers] -> none ; reads(ArrayStorage, Elements[Array], AllocatorState) writes(ArrayStorage, Elements[Array], AllocatorState, RuntimeState) collects ; runtime = ConvertToDoubleStorage ; form = Runtime
operation GetTypedArrayLength (view: Object/inspects, typedArrayType: TypedArrayType) -> natural(int[0, 17179869184]) ; reads(TypedArrayStorage) ; form = Open
# The bytes of a small view belong to the view alone, so the result is used only while the view is held. Whatever gives a view other bytes writes TypedArrayStorage.
operation GetTypedArrayVector (view: Object/inspects) -> natural(ViewVector) ; reads(TypedArrayStorage) ; base = view ; form = Open
# vector: GetTypedArrayVector of the view, only with isInsideView.
operation GetTypedArrayElement (view: Object/inspects, position: Number/inspects, guard?: Guard/inspects, vector?: ViewVector/inspects, typedArrayType: TypedArrayType, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInsideView] -> natural(number | bigint | undefined) ; Allocates reads(TypedArrayStorage, TypedArrayElements) ; relies = InBounds ; guarded = view ; replaces = ElemGet ; accessClass = Slot ; form = Open
operation PutTypedArrayElement (view: Object/inspects+writesContents, position: Number/inspects, value: Any/inspects, guard?: Guard/inspects, vector?: ViewVector/inspects, typedArrayType: TypedArrayType, mode: ECMAMode, level: KnowledgeLevel, accessSite?: AccessSite) [keyIsIntegral isInsideView] -> none ; reads(TypedArrayStorage) writes(TypedArrayElements) ; relies = InBounds ; guarded = view ; replaces = ElemSet ; accessClass = Slot ; form = Open
operation HasFixedBytes (view: Object/inspects) -> natural(boolean) ; reads(TypedArrayStorage) ; form = Open
operation GetEnumeratorIndexedLength (enumerator: Enumerator/inspects) -> natural(uint32) ; none ; form = Open
operation IsElementInStorage (object: Any/inspects, position: Number/inspects) -> natural(boolean) ; reads(ArrayStorage, Elements[Array]) ; branches = May ; form = Open
operation ToEnumeratorPosition (position: Number/inspects) -> natural(uint32) ; none ; form = Open
operation TypedArrayRange (view: Object/retains(result), start: Integer/inspects, end: Integer/inspects, valueType: Type, allocationSite?: AllocationSite) -> declared(valueType) ; Allocates reads(TypedArrayStorage) writes(TypedArrayStorage) throws ; interpreted = Allocation ; runtime = TypedArrayRange ; form = Runtime
operation GetStringLength (string: String/inspects) -> natural(int[0, 2147483647]) ; none ; interpreted = Read ; hasKnownValueRule = true ; form = Open
operation GetStringCodeUnit (string: String/inspects, position: Integer/inspects) -> natural(int[0, 65535]) ; ResolvesRopes ; interpreted = Read ; hasOwnFoldingRule = true ; form = Closed

family Arguments Prepared..Placed ; boundTo = Frame
operation GetArgument (argumentIndex: UInt32) -> unknown ; none ; form = Open
operation GetRestLength (firstArgument: UInt32) -> natural(int[0, 2147483647]) ; none ; form = Open
operation CreateRest (firstArgument: UInt32, allocationSite?: AllocationSite, storage: AllocationStorage) -> allocation(Array) ; Allocates ; interpreted = Allocation ; allocatesInline = true ; runtime = NewArray ; form = Closed
operation GetMyArgumentByVal (property: Any/Converted, firstArgument: UInt32) [readsArgumentsObject] -> unknown ; CreatesString reads(NamedProperties) ; runtime = GetFromArguments ; form = Open
operation CallForwardVarargs (callee: Any/calls, thisValue: Any/retains, firstArgument: UInt32, calleeKey?: PropertyKey, calleeName?: String, with CallStamp) -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; runsBeforeCallee = true ; form = Closed
