extend StatisticID with LimitID suffix Hits as hits
extend StatisticID with PassID suffix Changes as changes
extend StatisticID with SelectionRuleID suffix Groups as groups
extend StatisticID with Stage suffix Nanoseconds as time

enum RuntimeCounterID {
    None
    ObjectsBecameOrdinaryByIndexedAccessor ObjectsBecameOrdinaryByNativeDefinition ObjectsBecameOrdinaryByRepresentationLimit
    FieldsLeftSlotByDelete FieldsLeftSlotByRedefinition FieldsLeftSlotByStoreOfOtherType MemberGuardsCleared PrototypeLinkGuardsCleared
    KeyOrdersStoredOutOfLine ShapeEpochBumps ClassesEvaluatedAgain
    FieldMovePlansMade AssignmentPlansMade CopiesCollectedByName CopiesByOrdinaryLookups
    SiteCacheRefills HashedTableEvictions ChainDependentsDropped
    StubCannotReadField StubCannotStoreField StubCannotCreateField StubCannotCallGetter StubCannotCallSetter StubCannotGrowStorage
    TypedParsesFellBackPerValue ValidationsFellBackPerValue JSONStringifySlowPaths RegExpsCreatedWithoutRecord ThrownErrorsNotCreated
    InterpretedGlobalCode InterpretedEvalCode InterpretedFunctionCode InterpretedModuleCode
    InterpreterReadSlowPaths InterpreterStoreSlowPaths InterpreterPresenceSlowPaths InterpreterCallSlowPaths InterpreterAllocationSlowPaths
    InterpreterBranchSlowPaths
}
