enum StatisticStage { None Load Lower Link Read Scan Solve Passes Plan Compile Walk Emit Image Padding }
enum StatisticID (stage: StatisticStage) {
    [None]
    None
    [Load]
    SourceFilesChecked SourceFilesInferred SourceFilesTypesOnly SourceFilesData SourceFilesRuntime SourceFilesDemoted SourceBytes SourceLines
    SourceBytesOfPackages SourceLinesOfPackages SourceBytesOfDeclarations SourceLinesOfDeclarations SourceBytesOfBun SourceLinesOfBun
    [Lower]
    FunctionsLowered ValuesLowered
    KnownHelperFunctions KnownHelperCalls
    [Link]
    ProgramBytes
    ModulesWithNames ModulesWithValue Faces
    [Read]
    TypesInterned
    FunctionsRead ValuesRead
    [Scan]
    ValuesScanned
    [Solve]
    FlowAppendedFields
    FactNodes FactEdges FactsCarriedOverEdges FactRounds FactRuleCalls
    FactNodesGivenMore CellsOfInheritedFieldsWrittenOneByOne
    [Passes]
    FieldsHeldToWhatIsSeen
    [Plan]
    ModulesWithoutState RequireSitesBound RequiresRecorded AsyncWorkersMade FieldsOutOfLine NumbersOrUndefinedReturnedRaw EnvironmentsPromotedToVariables
    [Compile]
    UnitsCompiled UnitsWrittenStraight EntriesWrittenByHand
    [Walk]
    URLsLeftUnbuilt IteratorsSteppedWithoutCall IterationsOpenedByMethodsInSight NextMethodsTestedForFunctionExpected OwnKeyWalksExpanded
    FieldsAskedWhereMakersEnd ObjectsAskedWhereMakersEnd MakersWithoutFieldsHeldFilled ReadsOfOtherFilesVariablesHeld
    LibraryFunctionsEnteredBehindRows SortsThatCallNoComparator NewListsInPlaceOfSpecies
    AccessesProven AccessesGuarded AccessesUnknown ValuesInDouble
    LiteralArgumentsTakenApart
    ValuesWalked ValuesWalkedAndKept LoopsWalkedAgain CallsInlined OperationsBuilt OperationsSwept
    DirectCalls IndirectCalls TestsThatRejoin LoopsBuiltTwice TurnsThatBeginAgain EmptySlotsTakenAsCases WalksOfLoops WalksOfLoopsUndone
    AssignmentsWrittenOutFieldByField JoinsWalkedOnceForEachWay ObjectsOfSeveralWaysMetAsOne
    ProofsCheckedOfEntryParameters ProofsCheckedOfResultsOfCalls ProofsCheckedOfFields ProofsCheckedOfVariables ProofsCheckedOfCaptures ProofsCheckedOfSlotsOfScopes ProofsCheckedOfContents ProofsCheckedOfCallees ProofsCheckedOfOtherOperations ProofsCheckedOfTests ProofsCheckedOfWhatIsRemembered ProofsCheckedOfLifetimes
    ProofsThatNoTestTells ProofsThatFormTells DoorsThatCanNeverPass
    FreshCellsLeftAloneAtReturns
    AllocateInFramesChanges ClosuresInFrames KnownInductionsUsed NumbersBesideCountersAskedInFrontOfLoops MembersOfBuiltinsAskedByTheirBytes CountersHeldBelowRoomOfViews
    WordsClearedAtHeadsOfHandlers WordsClearedBehindCalls
    SlicesMadeOfElementsInSight
    MethodCallsToldApartByShape
    MethodCallsThroughTable
    PlacesWhereGuessesFailUnasked ExpectedTypesTakenOtherwise ChoicesOfCostDrawn BlocksPlacedOtherwise
    [Emit]
    NativeFunctionsCalledDirectly NativeFunctionTestsEmitted ExactIntegersBehindNumbers StepsThatKnowTheDeletedPrefix LoopsRotated
    InnerPointersAcrossSafepoints NullChecksFoldedIntoAccesses
    OperationsEmitted
    MachineOperationsAppended MachineOperationsScanned MachineOperationsAllocated MachineOperationsEncoded ValuesSpilled
    FormsThatDifferFromSchema FormsPickedByPlaceOtherThanLoop
    CallsHeldToRunNoOtherCode CallsHeldToThrowNothing CallsHeldNotToCollect OperandsHashedRoundCalls
    OffsetsFoundByComparisons OffsetsFoundInFlatTables OffsetsFoundInHashedTables OffsetsFoundInPagedTables BytesOfFlatOffsetTables BytesOfHashedOffsetTables BytesOfPagedOffsetTables
    RangeChecksRemoved
    VectorsOfViewsRead
    AccessesInsideViews
    [Image]
    InlineFramesEmitted FrameMapBytesEmitted RegExpCandidatesCompiled
    ThingsMentioned ThingsNumbered IdentifiersNumbered StringConstantsNumbered NamesWithoutColumn MethodTableSelectors MethodTableBytes
    ClassGuardCounts GuardsOfClassGuardCounts
    ImageFunctionsEmitted CodeBytesEmitted StubBytes ConstantBytesEmitted TableBytesEmitted TextBytesEmitted Veneers StubCopiesEmitted
    RegExpsCompiled RegExpsInterpreted
    WasmFunctionsCompiled WasmFunctionsWithTwoCopies WasmCodeBytesEmitted WasmCodeBytesOfSecondCopies
    FunctionBytesEmitted FarInstanceWordBytesEmitted VeneerBytesEmitted SharedCodeBytesEmitted ArgumentThunkBytes
    FinalJumpBytesRemoved
    FFICodeBytesEmitted FFIDirectoryBytesEmitted RegExpCodeBytesEmitted RegExp16BitCodeBytes RegExpTableBytesEmitted
    ConstantBytesOfSharedConstants ConstantBytesOfShapeSets ConstantBytesOfBitSetsOverKnownShapes ConstantBytesOfOffsetTables ConstantBytesOfCellTemplates ConstantBytesOfNumbers
    UnlabeledConstantBytes ConstantBytesOfJumpTables PaddingBytesBetweenConstants
    ParsersCreated
    [Padding]
    PaddingBytesBetweenFunctions
    PaddingBytesBetweenCodeParts
}
extend StatisticID with Stage suffix Nanoseconds as time

enum RuntimeCounterID {
    None
    FieldsLeftSlotByDelete FieldsLeftSlotByRedefinition FieldsLeftSlotByStoreOfOtherType KeyOrdersStoredOutOfLine
    ObjectsGivenIntegrityLevel ObjectsLaidBelowOtherPrototype ClassGuardBitsEnded MethodTableMadeWritable
    FieldMovePlansMade AssignmentPlansMade CopiesCollectedByName CopiesByOrdinaryLookups
    CompiledStructuresMade InstancesRememberedBelowPrototypes
    StarsRecorded StarsCarriedOutLate
    CompiledModulesWalkedByLoader FilesComparedWithDisk
    SiteCacheRefills StructuresKeptBelowBuiltinClasses
    JSONStringifySlowPaths StringBuilderGrowths RegExpsCreatedWithoutRecord
    TextsParsedByOwnParser ObjectsParsedIntoRecords ObjectsParsedIntoOrdinaryObjects
    RegExpPatternsParsed RegExpsCompiledToBytecode RegExpMatchesInterpreted
    RegExpsPreparedForLongSearches RegExpLongSearchesHandedOver RegExpWideSubjectsRefused RegExpSubjectsNarrowed
    RegExpLiteralsCompiledToBytecode RegExpPredictedTextsCompiledToBytecode RegExpImageCodeGaveUp
    RegExpPredictedTextsCreated RegExpPredictedTextsGivenCode RegExpLiteralsGivenCode
    InterpretedGlobalCode InterpretedEvalCode InterpretedFunctionCode InterpretedModuleCode
    DirectEvalsParsed
    StackListingsAfterGivenUpCaptures
    ModulesForRequireCache ModulesForWhatHasRun ModulesForCyclesThatWait RecordsForStatesOfLoads LinksBelowRoots StacksOfThrows RunsBelowListedFrames
    GraphsHeldBehindEarlierCalls GraphsLetGoBehindEarlierCalls
    CellsPoisoned CellsOfClassesThatAreNotPoisoned CellsHandedToUnseenCode
}
