enum DiagnosticSeverity { Error Warning Note }
enum Int32ProofFailure { Unknown OutOfRange AnyNumber Untyped Product Quotient NegatedZero Remainder Power NotANumber NegativeZero Fraction WorkLimit }

enum UserDiagnosticKind (severity: DiagnosticSeverity, stage: Stage, code: UInt32, message: Text) {
    Unknown(Error, Any, 100057, "a diagnostic without a kind was reported")
    LimitExceeded(Error, Any, 100057, "the program exceeds a compiler limit: {limit}, needed {count}")
    InvalidRegExpLiteral(Error, BuildImage, 100057, "invalid regular expression literal: /{text}/")
    UnprovenInt32(Error, ReadAndVerify, 100031, "the value is declared 'int32', but it might not be an int32 (reason {count})")
    ConstantNotInt32(Error, ReadAndVerify, 100032, "the value is declared 'int32', but the constant is not an int32")
    UnprovenDependencyInt32(Warning, ReadAndVerify, 100066, "the compiler can't prove every 'int32' that a dependency declares, so it tests them when the program runs")
    LockedBuiltinWriteAlwaysRuns(Error, AnalyzeFlow, 100014, "this assignment always throws: built-in objects are read-only in a compiled executable")
    LockedBuiltinWriteMayRun(Warning, AnalyzeFlow, 100014, "this assignment throws if it runs: built-in objects are read-only in a compiled executable")
    LockedBuiltinWriteIsIgnored(Warning, AnalyzeFlow, 100014, "this assignment has no effect: built-in objects are read-only in a compiled executable")
    LockedBuiltinWriteWithUnknownKey(Warning, AnalyzeFlow, 100014, "the compiler can't read the property name here. This assignment throws if the name is an existing member, or one that compiled code relies on being absent: a compiled executable keeps both as they are on built-in objects")
    NonConstantImportPath(Warning, AnalyzeFlow, 100064, "this import path isn't a constant, so it throws at run time if the file isn't in the executable. Add the file as an entry point, or build with --aot-allow-code-from-disk")
    NonConstantModuleName(Warning, AnalyzeFlow, 100064, "this call loads a module whose name isn't a constant, so it throws at run time if the module isn't in the executable. Import the module by name, or build with --aot-allow-code-from-disk")
    RequirePassedToUnseenCode(Warning, AnalyzeFlow, 100064, "the program passes require() to code that the compiler can't read, like the text given to vm.runInNewContext(). There it throws for a file that isn't in the executable. Add the file as an entry point, or build with --aot-allow-code-from-disk")
    UndetectedExportSpy(Warning, AnalyzeFlow, 100083, "a spy may replace the export '{text}', and the compiler didn't find that spy when it loaded the program. Code that imports '{text}' may keep calling the original, or the spy may be refused")
    UndetectedBuiltinAddition(Warning, AnalyzeFlow, 100083, "a test may add '{text}' to a built-in object, and the compiler didn't find that when it loaded the program. The object takes no new property, so adding it throws")
    FrameTooLarge(Error, GenerateCode, 100057, "{function} needs a stack frame of {count} bytes, over the limit: {limit}")
    TooManyIdentifiers(Error, NumberAndEncode, 100057, "the program has too many property names: {limit}, needed {count}")
    TooManyFunctions(Error, BuildImage, 100057, "the program has too many functions: {limit}, needed {count}")
    RegExpWithoutCode(Warning, BuildImage, 100058, "the regular expression /{text}/ runs in the interpreter")
    RegExpPatternNotConstant(Warning, AnalyzeFlow, 100058, "the pattern of this regular expression isn't a constant, so it may be compiled when the program runs")
    WasmUnsupportedCPU(Warning, BuildImage, 100058, "the WebAssembly module runs in the interpreter, as it does under 'bun run': Bun has no WebAssembly compiler for the target CPU")
    WasmInvalidModule(Warning, BuildImage, 100058, "the WebAssembly module is not valid, so there is nothing to compile. Making a WebAssembly.Module of it throws a CompileError at run time")
    WasmCodeTooLarge(Error, BuildImage, 100058, "the compiled code of the WebAssembly module is too large ({limit})")
    WasmFunctionNotCompiled(Error, BuildImage, 100058, "the compiler can't compile function {count} of the WebAssembly module")
    WasmDisabledInBuild(Warning, BuildImage, 100058, "the WebAssembly module can't run: this build of Bun has no WebAssembly")
}

enum InternalErrorKind (stage: Stage, message: Text) {
    Unknown(Any, "an internal error without a kind was reported")
    InvalidCompileOptions(Any, "the compile options are not valid (reason {count})")

    ProgramTooShort(ReadAndVerify, "the program has fewer bytes than its header says")
    NotAProgram(ReadAndVerify, "the bytes are not a valid program header")
    SchemaMismatch(ReadAndVerify, "the two halves of the compiler were built from different schemas")
    SectionOutOfBounds(ReadAndVerify, "section {count} is outside the program")
    ListOutOfBounds(ReadAndVerify, "a list is outside its section, in record {count}")
    UnknownEnumerator(ReadAndVerify, "an enumerator is out of range, in record {count}")
    UnknownFlag(ReadAndVerify, "a flag word has an undeclared bit, in record {count}")
    EngineOnlyOnWire(ReadAndVerify, "something only the engine may create was sent, in record {count}")
    IdOutOfRange(ReadAndVerify, "an id is out of range, in record {count}")
    DuplicateString(ReadAndVerify, "string {count} repeats an earlier string")
    StringNotCanonical(ReadAndVerify, "string {count} is not canonical WTF-8")
    NameClassMismatch(ReadAndVerify, "string {count} has the wrong name class")
    UnsortedList(ReadAndVerify, "a sorted list does not ascend, in record {count}")
    DuplicateListEntry(ReadAndVerify, "a list holds an entry twice, in record {count}")
    IRTextError(ReadAndVerify, "the IR text does not parse")

    InvalidPropertyKey(ReadAndVerify, "property key {count} is not a valid record")
    InvalidClass(ReadAndVerify, "{layout} breaks a rule of classes")
    BaseChainCycle(ReadAndVerify, "the chain of base layouts of {layout} is a cycle")
    InvalidLayout(ReadAndVerify, "{layout} is not a valid layout")
    InvalidType(ReadAndVerify, "type {count} is not canonical, or its set of layouts is empty or open")
    InvalidDeclaredType(ReadAndVerify, "a position is both expected and an int32 promise, in record {count}")
    FamilyNotClosed(ReadAndVerify, "{layout} is converted to a type that does not list it")
    InvalidVariable(ReadAndVerify, "variable {count} is not a valid record")
    InvalidModule(ReadAndVerify, "module {count} is not a valid module record")
    InvalidModuleFailure(ReadAndVerify, "module failure {count} is not a valid record")
    InvalidModuleEvaluation(ReadAndVerify, "the evaluation of a module breaks rule {count} of its sites")
    InvalidData(ReadAndVerify, "data record {count} is not a valid tree")
    InvalidEntry(ReadAndVerify, "entry {count} is not a valid record")
    NoEntryPoint(ReadAndVerify, "the program has no entry point")

    OpcodeNotInForm(ReadAndVerify, "the operation is not legal in this form of the IR")
    RequiredPassLeftOperation(Optimize, "an operation that a required pass removes is left")
    OperandMissing(ReadAndVerify, "a required operand is absent")
    UnexpectedOperand(ReadAndVerify, "the operation takes no such operand")
    NotExactlyOneParameter(ReadAndVerify, "the operation takes exactly one of two parameters")
    FunctionFlagMissing(ReadAndVerify, "the operation needs a flag that its function does not have")
    ArgumentCountMismatch(ReadAndVerify, "the number of arguments does not fit the callee")
    PayloadOutOfRange(ReadAndVerify, "a payload field is out of range")
    PlacedPayloadMissing(NumberAndEncode, "a payload field that placement fills is not set")
    FlagNotDeclared(ReadAndVerify, "a flag is set that the operation does not declare")
    EdgeToEntryBlock(ReadAndVerify, "an edge targets the entry block")
    TargetCountMismatch(ReadAndVerify, "the terminator has the wrong number of targets")
    EdgeArgumentCountMismatch(ReadAndVerify, "the arguments and edge results of an edge do not fill the parameters of its target")
    InvalidProof(ReadAndVerify, "an edge passes a proof that its terminator does not give")
    InvalidHandler(ReadAndVerify, "the handler of the block is not a handler block")
    HandlerArgumentNotAvailable(ReadAndVerify, "an argument of the handler is not available at the start of the block")
    InvalidBlockRole(ReadAndVerify, "the role of the block does not fit its subject")
    BlockOrderInvalid(ReadAndVerify, "the blocks are not in reverse postorder, or a block is unreachable")
    BodyIndexMismatch(ReadAndVerify, "the index of the body differs from what a plain computation gives")
    TypeOutOfDate(ReadAndVerify, "the type is not what the result rule gives")
    EffectsNotCounted(ReadAndVerify, "an operation has an effect that the effects of its function do not include")
    WrongRepresentation(ChooseRepresentations, "a value has a representation that its type does not allow, or one operation takes it in two")
    OperandTypeMismatch(ReadAndVerify, "the operand has the wrong type")
    StoredTypeMismatch(ReadAndVerify, "the stored value is outside the declared type")
    EntryParametersMismatch(ReadAndVerify, "the entry parameters do not match the signature")
    ReturnTypeMismatch(ReadAndVerify, "the returned value is outside the declared result")
    ResultIndexOutOfRange(ReadAndVerify, "the producer has no result {count}")
    InvalidEnvironmentUse(ReadAndVerify, "an environment is used where none is allowed")
    UseNotDominated(ReadAndVerify, "the definition of an operand does not dominate the use")
    InvalidGuard(Optimize, "the guard does not prove what the operation relies on")
    AccessorSlotMismatch(Optimize, "the operation treats a slot of {layout} that holds the functions of an accessor as one that holds a value, or the reverse")
    UnspecifiedValueInspected(Optimize, "the operation looks at value {count}, which is unspecified on a path that reaches it")
    OperandMustBeDefinition(ReadAndVerify, "the operand must be the defining value, not a block parameter")
    CycleWithoutLoopMark(ReadAndVerify, "a cycle has no loop mark")
    InvalidCatch(ReadAndVerify, "a caught value is read outside a handler block")
    InvalidReturnCall(ReadAndVerify, "the tail call breaks a rule of tail calls")
    InvalidBuiltinCall(Optimize, "the overload does not take these operands")
    InvalidSuspension(Optimize, "the suspension breaks a rule of coroutines")
    RecursiveSpeculation(Optimize, "the region of a speculation opens the same speculation at the same operation again")
    StaleHoistedLoopBound(Optimize, "a loop header uses a hoisted bound, and the iterations of the loop may write what the bound was read from")
    HandlerEdgePassesPlaceholder(Optimize, "an edge to a handler passes another value than the one that the header of its block bound for the handler")
    LoopSummaryMismatch(Optimize, "a visit of a loop does not fit the loop summary that its retained visit was made under")
    HoistedOperandNotInvariant(Optimize, "an operation that is built in the preheader of a loop takes a value that is defined in the iterations of that loop")
    EnumeratorCurrentForFreshObject(Optimize, "an enumerator is marked current for an object that is still fresh")
    DuplicateCellAllocation(Optimize, "one operation of the body allocates two cells on one path in one visit of its block, and both are used")
    IntrinsicOutsideLibraryCode(ReadAndVerify, "an intrinsic is used outside library code")
    InvalidCreatorRecord(Optimize, "role, creator record and derivation do not agree")

    FlowEndedTooEarly(AnalyzeFlow, "the flow analysis stopped, and {count} of its rules still add something when they run once more over the solved sets")
    StaleFlowAssumption(AnalyzeFlow, "the flow analysis reached its fixpoint, and {count} things that it assumed to be absent or constant are not, and the rules that assumed them were not run again")
    FlowNotMonotonic(AnalyzeFlow, "the flow analysis was given more inputs, and {count} of its results are more precise than they are for the unchanged program")
    FlowMissesDefinedProperty(AnalyzeFlow, "{count} accesses define a property where the tables of the flow analysis say that no such property can exist")

    UnitCompiledAloneDiffers(GenerateCode, "the code of a unit depends on more than the unit, what it mentions or inlines, the facts and the plan, or on whether its Code is verified")
    StoreOutsideDeclaredEffects(GenerateCode, "{function}: the code of {value} reads or writes a heap outside the effects of the operation")
    FramePointerAcrossSuspension(Optimize, "{function}: a value that may point into the frame is live at {value}, which may suspend")

    SlotAccessNotPlaced(PlanSlots, "a slot access names a field that has no slot")
    PlacementCheckFailed(NumberAndEncode, "placement broke its rule {count}")
    ProgramTableCheckFailed(NumberAndEncode, "the program tables broke a rule")
    RuntimeTypeStricterThanPlan(NumberAndEncode, "the run-time record of a type rejects a value its test plan passes")

    UnsupportedConversion(ChooseRepresentations, "no conversion between the two representations")
    OpcodeWithoutCode(GenerateCode, "the operation has no code generator in this form")
    FrameMapNotEncodable(GenerateCode, "the frame map of the suspension cannot be encoded")
    RelocationNotLowered(GenerateCode, "{function}: no lowering for the address at {value}")
    VariableReadBeforeSet(GenerateCode, "{function}: a B3 variable is read before it is set at {value}")
    WrongValueInSpillSlot(GenerateCode, "{function}: a spill slot is read at {value} where it does not hold its value")
    WrongValueInRegister(GenerateCode, "{function}: a register is read at {value} where it does not hold its value")
    FrameAddressAcrossSuspension(GenerateCode, "{function}: the frame address {value} is live across a suspension")
    NarrowReferenceWithoutPointer(GenerateCode, "{function}: only the 32-bit reference {value} names its cell where an operation can run the collector")
    InnerPointerWithoutOwner(GenerateCode, "{function}: {value} points into memory that a cell owns and is read after an operation that can run the collector, and the cell is not")
    MalformedMachineProcedure(GenerateCode, "{function}: the machine operations that the emitters appended are malformed")
    OutOfRegisters(GenerateCode, "{function}: one patch operation needs more registers than there are")
    MissingFrameSetup(GenerateCode, "{function}: the code needs the frame at a point where no frame is set up")
    UpperHalfNotClear(GenerateCode, "{function}: a zero extension emits no code in a register whose upper half is not clear")
    TrapWithoutSite(GenerateCode, "{function}: a load of {value} traps, and the emitters recorded no trap site for the operation")
    Int32StoredWithoutReboxing(GenerateCode, "a value of type int32 is stored in an array, whose readers look at the tag, in the box that it arrived in, and nothing has checked the tag of that box")
    MissingFenceAfterLateStores(GenerateCode, "{function}: the code of {value} fills a new object and has neither a fence nor a barrier after the stores")

    UncheckedStackCycle(BuildImage, "functions entered without a stack check call each other in a cycle")
    UncheckedStackTooDeep(BuildImage, "{function} and the functions it enters without a stack check use {count} bytes of stack")
    CallToFunctionWithoutCode(BuildImage, "a call names a function that has no code")
    CallToStubNotGenerated(BuildImage, "a call names a stub that was not generated")
    ProcessAddressInImageCode(BuildImage, "an address of the compiling process is left in image code")
    RelocationNotApplied(BuildImage, "a relocation was recorded and not applied")
    WebAssemblyCodeNotForImage(BuildImage, "the code of a WebAssembly module can't be placed in the image")
    WritableSectionInImage(BuildImage, "the image has a writable section or a data relocation")
    FunctionWithoutCode(BuildImage, "{function} is reachable and has no code")
    FrameSavesUnknownRegister(BuildImage, "the frame of {function} saves a register the unwinder does not know")
}
