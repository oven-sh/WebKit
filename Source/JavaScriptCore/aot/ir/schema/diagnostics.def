enum DiagnosticSeverity { Error Warning Note }
enum Int32ProofFailure { Unknown OutOfRange AnyNumber Untyped Product Quotient NegatedZero Remainder Power NotANumber NegativeZero Fraction WorkLimit }

enum UserDiagnosticKind (severity: DiagnosticSeverity, stage: Stage, code: UInt32, message: Text) {
    Unknown(Error, Any, 100057, "a diagnostic without a kind was reported")
    LimitExceeded(Error, Any, 100057, "the program exceeds a compiler limit: {limit}, needed {count}")
    InvalidRegExpLiteral(Error, ReadAndVerify, 100057, "invalid regular expression literal")
    UnprovenInt32(Error, ReadAndVerify, 100031, "the value is declared 'int32', but it might not be an int32 (reason {count})")
    ConstantNotInt32(Error, ReadAndVerify, 100032, "the value is declared 'int32', but the constant is not an int32")
    Int32OfDependencyNotProven(Warning, ReadAndVerify, 100066, "the compiler can't prove every 'int32' that a dependency declares, so it tests them when the program runs")
    LockedBuiltinWriteAlwaysRuns(Error, AnalyzeFlow, 100014, "this assignment always throws: built-in objects are read-only in a compiled executable")
    LockedBuiltinWriteMayRun(Warning, AnalyzeFlow, 100014, "this assignment throws if it runs: built-in objects are read-only in a compiled executable")
    LockedBuiltinWriteIsIgnored(Warning, AnalyzeFlow, 100014, "this assignment has no effect: built-in objects are read-only in a compiled executable")
    CodeOutsideImageIsRefused(Warning, AnalyzeFlow, 100064, "this import path isn't a constant. If it resolves to code that isn't in the executable, the import throws at run time (data files still load). Add the file as an entry point, or build with --aot-allow-code-from-disk")
    ModuleNamedAtRunTimeIsRefused(Warning, AnalyzeFlow, 100064, "this call loads a module, and its name isn't a constant. If it names code or a built-in module that isn't in the executable, the call throws at run time. Import the module by its name to keep it, or build with --aot-allow-code-from-disk")
    FrameTooLarge(Error, GenerateCode, 100057, "{function} needs a stack frame of {count} bytes, over the limit: {limit}")
    TooManyShapes(Error, NumberAndEncode, 100057, "the program has too many object shapes: {limit}, needed {count}")
    TooManyIdentifiers(Error, NumberAndEncode, 100057, "the program has too many property names: {limit}, needed {count}")
    TooManyFunctions(Error, BuildImage, 100057, "the program has too many functions: {limit}, needed {count}")
    RegExpWithoutCode(Warning, BuildImage, 100058, "this regular expression runs in the interpreter (reason {count})")
    WasmUnsupportedCPU(Warning, BuildImage, 100058, "the WebAssembly module runs in the interpreter: the target CPU is not supported")
    WasmInvalidModule(Warning, BuildImage, 100058, "the WebAssembly module runs in the interpreter: it is not valid")
    WasmNoFunctions(Warning, BuildImage, 100058, "the WebAssembly module has no functions to compile")
    WasmHasGCTypes(Warning, BuildImage, 100058, "the WebAssembly module runs in the interpreter: it uses GC types")
    WasmCodeTooLarge(Warning, BuildImage, 100058, "the WebAssembly module runs in the interpreter: its code is too large ({limit})")
    WasmUsesExceptions(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it uses exceptions")
    WasmUsesTailCalls(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it uses tail calls")
    WasmTestsReferenceTypes(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it tests reference types")
    WasmCallsUnlistedOperation(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it calls a runtime function the compiler doesn't support")
    WasmNamesTypeOfOtherModule(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it uses a type from another module")
    WasmSavesVectorRegister(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: it saves a vector register")
    WasmSavedRegisterOrder(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: its saved registers are not in order")
    WasmProcessAddressInCode(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: its code contains an absolute address")
    WasmCodeGeneratorFailed(Warning, BuildImage, 100058, "a WebAssembly function runs in the interpreter: the code generator failed")
    WasmLeftOutOfThisBuild(Warning, BuildImage, 100058, "the WebAssembly module can't run: this build of Bun has no WebAssembly")
}

enum InternalErrorKind (stage: Stage, message: Text) {
    Unknown(Any, "an internal error without a kind was reported")
    InvalidCompileOptions(Any, "the compile options are not valid (reason {count})")
    VerificationFailedAfterPass(Any, "verification failed after {pass}")
    VerificationFailedAtTheEnd(Any, "the program that goes to the back end is not valid: build again with --aot-verify-each-pass to find the pass")
    SkippedPassChangesFunction(Any, "{pass} was left out because nothing that changed since its last run can give it work, but it changes the function")

    ProgramTooShort(ReadAndVerify, "the program has fewer bytes than its header says")
    NotAProgram(ReadAndVerify, "the bytes are not a valid program header")
    SchemaMismatch(ReadAndVerify, "the two halves of the compiler were built from different schemas")
    SectionOutOfBounds(ReadAndVerify, "section {count} is outside the program")
    ListOutOfBounds(ReadAndVerify, "a list is outside its section, in record {count}")
    UnknownEnumerator(ReadAndVerify, "an enumerator is out of range, in record {count}")
    UnknownFlag(ReadAndVerify, "a flag word has an undeclared bit, in record {count}")
    UnknownVariantCase(ReadAndVerify, "a variant has an undeclared case, in record {count}")
    EngineOnlyOnWire(ReadAndVerify, "something only the engine may create was sent, in record {count}")
    IdOutOfRange(ReadAndVerify, "an id is out of range, in record {count}")
    DuplicateString(ReadAndVerify, "string {count} repeats an earlier string")
    DuplicatePropertyKey(ReadAndVerify, "property key {count} repeats an earlier key")
    StringNotCanonical(ReadAndVerify, "string {count} is not canonical WTF-8")
    NameClassMismatch(ReadAndVerify, "string {count} has the wrong name class")
    UnsortedList(ReadAndVerify, "a sorted list does not ascend, in record {count}")
    DuplicateListEntry(ReadAndVerify, "a list holds an entry twice, in record {count}")
    TypeRefersForward(ReadAndVerify, "type {count} names a later type")
    IRTextError(ReadAndVerify, "the IR text does not parse")

    InvalidPropertyKey(ReadAndVerify, "property key {count} is not a valid record")
    InvalidClass(ReadAndVerify, "{layout} breaks a rule of classes")
    InvalidLayout(ReadAndVerify, "{layout} is not a valid layout")
    InvalidDeclaredType(ReadAndVerify, "a position is both expected and an int32 promise, in record {count}")
    FamilyNotClosed(ReadAndVerify, "{layout} is converted to a type that does not list it")
    InvalidVariable(ReadAndVerify, "variable {count} is not a valid record")
    InvalidModule(ReadAndVerify, "module {count} is not a valid module record")
    InvalidModuleFailure(ReadAndVerify, "module failure {count} is not a valid record")
    InvalidModuleEvaluation(ReadAndVerify, "the evaluation of a module breaks rule {count} of its sites")
    InvalidData(ReadAndVerify, "data record {count} is not a valid tree")
    DataOutsideFieldType(ReadAndVerify, "data record {count} fills a field of {layout} with a value outside the field's type")
    InvalidEntry(ReadAndVerify, "entry {count} is not a valid record")
    NoEntryPoint(ReadAndVerify, "the program has no entry point")

    OpcodeNotInForm(ReadAndVerify, "the operation is not legal in this form of the IR")
    RequiredPassLeftOperation(Optimize, "an operation that a required pass removes is left")
    RequestAfterTyping(ReadAndVerify, "a request is left after typing")
    OperandMissing(ReadAndVerify, "a required operand is absent")
    UnexpectedOperand(ReadAndVerify, "the operation takes no such operand")
    NotExactlyOneParameter(ReadAndVerify, "the operation takes exactly one of two parameters")
    FunctionFlagMissing(ReadAndVerify, "the operation needs a flag that its function does not have")
    ArgumentCountMismatch(ReadAndVerify, "the number of arguments does not fit the callee")
    PayloadOutOfRange(ReadAndVerify, "a payload field is out of range")
    PlacedPayloadMissing(NumberAndEncode, "a payload field that placement fills is not set")
    FlagNotDeclared(ReadAndVerify, "a flag is set that the operation does not declare")
    ValueListedTwice(ReadAndVerify, "the value is listed by two blocks or twice by one")
    ValueNotListed(ReadAndVerify, "the value is used but no block lists it")
    ParameterNotInList(ReadAndVerify, "the parameter is not in the parameter list of any block")
    EdgeToEntryBlock(ReadAndVerify, "an edge targets the entry block")
    TargetCountMismatch(ReadAndVerify, "the terminator has the wrong number of targets")
    EdgeArgumentCountMismatch(ReadAndVerify, "the arguments and edge results of an edge do not fill the parameters of its target")
    InvalidProof(ReadAndVerify, "an edge passes a proof that its terminator does not give")
    InvalidHandler(ReadAndVerify, "the handler of the block is not a handler block")
    HandlerArgumentNotAvailable(ReadAndVerify, "an argument of the handler is not available at the head of the block")
    InvalidBlockRole(ReadAndVerify, "the role of the block does not fit its subject")
    BlockOrderInvalid(ReadAndVerify, "the blocks are not in reverse postorder, or a block is unreachable")
    TypeOutOfDate(ReadAndVerify, "the type is not what the result rule gives")
    BrokenResultRule(ReadAndVerify, "a result rule answers with more for an operand of a narrower type, or its two paths disagree")
    WrongRepresentation(ChooseRepresentations, "a value has a representation that its type does not allow, or one operation takes it in two")
    OperandTypeMismatch(ReadAndVerify, "the operand has the wrong type")
    StoredTypeMismatch(ReadAndVerify, "the stored value is outside the declared type")
    EdgeArgumentMismatch(ReadAndVerify, "an edge argument is outside the type of its parameter")
    EntryParametersMismatch(ReadAndVerify, "the entry parameters do not match the signature")
    ReturnTypeMismatch(ReadAndVerify, "the returned value is outside the declared result")
    UpcastNotSubset(ReadAndVerify, "the source of the upcast is not inside its type")
    OperandKindOwedToCheck(Optimize, "an operation that takes one kind of value takes v{count}, which is of that kind only behind a check")
    ProofWithoutCheck(Optimize, "a type is assumed to hold behind checks, and no check stands in front of the value")
    StoredTypeOwedToCheck(Optimize, "a position that every store is held to takes v{count}, which has the type of the position only behind a check")
    ResultIndexOutOfRange(ReadAndVerify, "the producer has no result {count}")
    ValueAfterNever(ReadAndVerify, "code follows a value that never completes")
    InvalidEnvironmentUse(ReadAndVerify, "an environment is used where none is allowed")
    UseNotDominated(ReadAndVerify, "the definition of an operand does not dominate the use")
    FunctionEndsInFirstBlock(Optimize, "a function that is reached cannot get past its first block, and by no throw of its own: nothing is left of what a value there may be")
    GuardNotAvailable(Optimize, "something between the guard and the use may write what the guard depends on")
    InvalidGuard(Optimize, "the guard does not prove what the operation relies on")
    UnspecifiedValueInspected(Optimize, "the operation looks at value {count}, which is unspecified on a path that reaches it")
    OperandMustBeDefinition(ReadAndVerify, "the operand must be the defining value, not a block parameter")
    CycleWithoutLoopMark(ReadAndVerify, "a cycle has no loop mark")
    InvalidCatch(ReadAndVerify, "a caught value is read outside a handler block")
    InvalidReturnCall(ReadAndVerify, "the tail call breaks a rule of tail calls")
    InvalidTestAndBranch(Select, "the fused test and branch is malformed")
    InvalidBuiltinCall(Optimize, "the overload does not take these operands")
    CallsTrimmedBuiltin(Optimize, "a built-in is called directly, but the executable may not have its code")
    InvalidSuspension(Optimize, "the suspension breaks a rule of coroutines")
    IntrinsicOutsideLibraryCode(ReadAndVerify, "an intrinsic is used outside library code")
    ExpectedTypeAfterSelection(Select, "an expected type is left after selection")
    InvalidInlineFrame(Optimize, "inline frame {count} is malformed")
    InvalidCreatorRecord(Optimize, "role, creator record and derivation do not agree")
    ClosureOnDemandWithoutField(Optimize, "a closure that is made on demand is not the initial value of a field that defers it")

    FlowMembersInvalid(AnalyzeFlow, "members of {layout} do not ascend or are not allocated")
    MaskCutKnownValue(AnalyzeFlow, "{function}: the type of {value} removed a value flow knows arrives")
    FlowEndedTooEarly(AnalyzeFlow, "the flow analysis was at rest, and {count} of its rules still add something when they run once more over the solved sets")
    FlowRuleWasNotDue(AnalyzeFlow, "{value} in {function}: the rule was not due, and run once more over the solved sets it adds something")

    EffectsExceedReplacedGroup(Select, "a selected operation has effects beyond those of the group it replaced")
    EffectsOfPreparedTooNarrow(Select, "an operation was selected into a form with effects it does not declare")
    EffectsExceedSummary(GenerateCode, "the generated code has effects beyond the summary of {function}")
    StoreOutsideDeclaredEffects(GenerateCode, "{function}: the code of {value} stores to a heap the operation does not write")
    RequiredTailCallNotConverted(Optimize, "a tail call in a cycle was demoted in {function} at {value}")
    FramePointerReturned(Optimize, "{function}: {value} may point into the frame and is returned")
    FramePointerThrown(Optimize, "{function}: {value} may point into the frame and is thrown")
    FramePointerRetained(Optimize, "{function}: {value} retains a value that may point into the frame")
    CalleeRetainsFramePointer(Optimize, "{function}: the callee of {value} may retain an argument that may point into the frame")
    FramePointerInTailCall(Optimize, "{function}: {value} leaves the activation with an argument that may point into its frame")
    FramePointerAcrossSuspension(Optimize, "{function}: a value that may point into the frame is live at {value}, which may suspend")
    FrameCellAcrossIterations(Optimize, "{function}: the frame cell {value} is live when its allocation runs again")

    ResolvedTargetMismatch(Select, "a resolved call does not use the target that was resolved for it")
    CursorInFunctionValue(Optimize, "a cursor reaches a function that can be called by value")
    CursorGuardMismatch(Optimize, "a cursor is used under the guard of another source")
    CursorUsedAfterClose(Optimize, "a cursor is used after its source was closed")
    KeyOrderOfOtherObject(Optimize, "a key order is applied to an object it was not recorded for")
    BuilderCapacityExceeded(Optimize, "a write exceeds the capacity that was reserved in the builder")
    BuilderCursorUsedAfterMove(Optimize, "a builder cursor is used after an operation that can move the buffer")

    SlotAccessNotPlaced(PlanSlots, "a slot access names a field that has no slot")
    PlacementCheckFailed(NumberAndEncode, "placement broke its rule {count}")
    ProgramTableCheckFailed(NumberAndEncode, "the program tables broke rule {count}")
    RuntimeTypeStricterThanPlan(NumberAndEncode, "the run-time record of a type rejects a value its test plan passes")

    UnsupportedConversion(ChooseRepresentations, "no conversion between the two representations")
    OpcodeWithoutCode(GenerateCode, "the operation has no code generator in this form")
    FrameMapNotEncodable(GenerateCode, "the frame map of the suspension cannot be encoded")
    AbsoluteAddressInProcedure(GenerateCode, "{function}: a process address reached B3 at {value}")
    RelocationNotLowered(GenerateCode, "{function}: no lowering for the address at {value}")
    VariableReadBeforeSet(GenerateCode, "{function}: a B3 variable is read before it is set at {value}")
    FrameAddressAcrossSuspension(GenerateCode, "{function}: the frame address {value} is live across a suspension")
    NarrowReferenceWithoutPointer(GenerateCode, "{function}: only the 32-bit reference {value} names its cell where operation {count} can run the collector")
    InnerPointerWithoutOwner(GenerateCode, "{function}: {value} points into what a cell owns and is read behind operation {count}, which can run the collector, and the cell is not")
    DisplacedNarrowReference(GenerateCode, "{function}: the 32-bit reference {value} is live, moved by a constant, where operation {count} can run the collector")

    InvalidCodeUnits(BuildImage, "the recorded code units do not cover the code (reason {count})")
    UncheckedStackCycle(BuildImage, "functions entered without a stack check call each other in a cycle")
    UncheckedStackTooDeep(BuildImage, "{function} and the functions it enters without a stack check use {count} bytes of stack")
    CallToFunctionWithoutCode(BuildImage, "a call names a function that has no code")
    CallToStubNotGenerated(BuildImage, "a call names a stub that was not generated")
    ProcessAddressInImageCode(BuildImage, "an address of the compiling process is left in image code")
    RelocationNotApplied(BuildImage, "a relocation was recorded and not applied")
    WritableSectionInImage(BuildImage, "the image has a writable section or a data relocation")
    FunctionWithoutCode(BuildImage, "{function} is reachable and has no code")
    FrameSavesUnknownRegister(BuildImage, "the frame of {function} saves a register the unwinder does not know")
}
