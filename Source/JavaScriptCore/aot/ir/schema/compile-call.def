enum KnowledgeLevel { Unknown Expected Proven }
enum AccessCost { ByName TestsReceiver TestsSlot Free }
enum AccessKind { Unknown Read Store Define Has Delete Call Construct Truthiness Equality Arithmetic Comparison Conversion TypeOf InstanceOf Iteration Spread }
enum UnprovenCause { Unknown UnknownObject UnknownCallee Untracked }
enum TypeOriginReason { Unknown Untracked BuiltinResult CallResult PropertyRead OutsideCaller ExposedObject ExposedVariable CaughtException OtherValue ArrayArgument OtherBuiltin OtherFunction ManyShapes ManyFunctions ChangedShape MissingField CheckedElement CheckedResult CheckedKeys StaticField BuiltinProperty ComputedName }
enum UnseenCodeCause { Unknown EvaluatesText ImportsUncompiledModule LoadsModuleByName RunsUnseenCode OptionAdmitsCode FlowResultDisabled RunsMachineCode LoadsCodeByName }
flags BuiltinUse { Tested Read Called Constructed Written Escaped StoredByName NamedAtRunTime }
enum FeatureUseKind { Named Unnamed NamedAtRunTime FoundByName }
enum LocaleUseKind { Unknown HostDefault Constant }
enum TypeTestFailure { TakesGenericPath Throws ExitsToSlowVersion }
enum CodeForm { Open Closed Generic }

enum ImageVerdict {
    Unsupported Accepted CompiledCodeDisabled NotAnImage Truncated Misaligned LowPagesAccessible NoCode CannotMapCode NeedsCellCage OptionsConflict
    MalformedTables StampMismatch IdentityMismatch CodeAtFixedAddress OutsideItsSegments CannotReadExecutable
}
flags AllocationEscapeReason { Returned Thrown }
enum AllocationHeapCause { None NotTracked Escapes LiveAcrossSuspension RetainedAcrossIterations }
enum AllocationOutcome { Unknown Removed Heap }
enum AllocationKind { Other Object Closure Environment Generator }
enum ResultSection {
    Image Text UserDiagnostics InternalErrors EntryModuleIds UnseenCode BuiltinsUsed FeaturesUsed LocalesUsed WorkerEntries Accesses AccessCounts TypeTests
    AllocationRemarks Statistics Symbols ObfuscatedSites
    MissingLibraryFunctions WorkerStartsWithoutName
    BytesByForm BytesByModule
    FunctionNames LayoutNames
    WorkerStartsFromURLs
    MissingLibraryModules
    InlinedStrings
    TypeOrigins
}

record TextRange abi { offset: UInt32 length: UInt32 }
record SourceLocation abi { module: Module? position: UInt32 }
record Witness abi { function: Function? value: Value? location: SourceLocation }
record UserDiagnosticRecord abi {
    kind: UserDiagnosticKind function: Function? block: Block? value: Value? layout: Layout? limit: LimitID count: UInt32 location: SourceLocation
    message: TextRange origin: SourceLocation siteKind: TypeSiteKind minimum: Double maximum: Double
}
record InternalErrorRecord abi {
    kind: InternalErrorKind function: Function? block: Block? value: Value? layout: Layout? limit: LimitID count: UInt32
    location: SourceLocation message: TextRange
}
record UnseenCodeRecord abi { cause: UnseenCodeCause builtin: Builtin? witness: Witness }
record BuiltinUseRecord abi { builtin: Builtin uses: BuiltinUse witness: Witness }
record MissingFunctionRecord abi { function: UInt32 }
record MissingModuleRecord abi { module: Module }
record FeatureUseRecord abi { feature: Feature builtin: Builtin? witness: Witness kind: FeatureUseKind }
record LocaleUseRecord abi { kind: LocaleUseKind tag: TextRange builtin: Builtin? witness: Witness }
record WorkerEntryRecord abi { path: TextRange witness: Witness }
record WorkerStartRecord abi { witness: Witness }
record WorkerURLStartRecord abi { witness: Witness }
record AccessRecord abi {
    location: SourceLocation kind: AccessKind level: KnowledgeLevel cause: UnprovenCause layout: Layout? copies: UInt32
    function: Function? cost: AccessCost loopDepth: UInt32 origin: UInt32 hasOtherOrigins: UInt32
}
record TypeOriginRecord abi { reason: TypeOriginReason location: SourceLocation entry: SourceLocation name: TextRange builtin: Builtin? }
record AccessCountRecord abi { module: Module accesses: UInt32[3] calls: UInt32[3] typeTests: UInt32 accessCosts: UInt32[4] }
record TypeTestRecord abi { location: SourceLocation function: Function? failure: TypeTestFailure copies: UInt32 layout: Layout? }
record AllocationRemarkRecord abi {
    location: SourceLocation forcedBy: SourceLocation outcome: AllocationOutcome copies: UInt32 forcingOperation: TextRange reasons: AllocationEscapeReason
    function: Function? kind: AllocationKind cause: AllocationHeapCause
}
record FormBytesRecord abi { operation: TextRange form: CodeForm count: UInt32 bytes: UInt64 }
record ModuleBytesRecord abi { module: Module functions: UInt32 codeBytes: UInt64 tableBytes: UInt64 }
record FunctionNameRecord abi { function: Function module: Module? name: TextRange }
record LayoutNameRecord abi { layout: Layout name: TextRange }
record InlinedStringRecord abi { text: TextRange }
record ObfuscatedSiteRecord abi { function: UInt32 site: UInt32 location: SourceLocation name: TextRange }

enum CompileAction { Compile VerifyOnly CheckOnly }
enum Architecture { ARM64 X86_64 }
enum ReferenceWidth { Wide Narrow }
enum ImageForm { Absolute PositionIndependent }
flags CheckSet { VerifyEachPass Validate ValidateBackEnd ValidateReferences VerifyEachStage ValidateReferenceGuards FlowFixpoint UsedValuesAreListed ClaimsToBackEnd MovedLoads DecidedComparisons SpillSlots AllocatedRegisters ClaimsOfFlow KeepGoing ReplayFinalLoopVisits RepeatFittingLoopVisits FlowMonotonicity }
flags ReportSet { Flow Symbols Allocations AccessCounts Uses InlinedStrings }
flags TestingSwitch { IgnoreBranchHints IgnoreExpectedTypes DelayFlowRules DelayOtherFlowRules ShuffleExpectedTypes AssumeNullishHostResults CheckProofsAtRunTime AssumeUnknownCallsReturnUndefined ForceStraightCompilation CheckProofsAtEntries CheckProofsAtEntriesAndFields DisableFrameCells CheckBoundsAtRunTime AssumeIndexesInBounds CheckEffectsAtRunTime UnderstateEffects AssumeCalleesRetainNothing AssumeArgumentsNeverEscape ShuffleBlockFrequencies FailSpeculations WidenFlowNodes ShuffleChoices DisableLaterUnitSpeculation CheckWalkAtRunTime ForceFallbackBlockOrder ForceWalkMode AbortLoopVisits DropLengthCheckedReads AssumeInvariantLoopBounds AssumeGuardsAndFacts SkipFencesAfterLateStores AssumeUInt32Dividends IgnoreAlternativeOverloads IgnoreFreshArrayEscapes MisroundLoopBounds SkipInt32Reboxing MisfoldBranchInSweep DropEdgeInSweep CheckBoundsInEmittersOnly SkipUnrollEntryChecks SkipUnrollTripCountCheck CheckHoistedCallsAtRunTime AssumeInlineBuiltinsPure AssumeNoNaNStores UseGenericOwnKeyReads MisidentifyHoistedReadOperands SkipUnrolledShapeChecks TreatEqualIntegersAsLess AssumeInvariantArrayStorage IgnoreMarksInShapeChecks IgnoreDormantMemberUpdates TreatMemberCalleesAsUnknown MisplaceUncheckedAccesses DisableFamilyReadShortcut CheckDictionaryReadProofs DropPatchOnlySaves MisplaceUncheckedReads AssumeSpillSlotsDead IgnoreEscapeAfterUnknownCall TreatLiteralFieldsAsDefined OverstateTypedArrayLength CheckResultFreshnessAtRunTime }
flags FaultInjection { IgnoreCollectorSpillReads MisplaceHoistedArrayStorage AssumeLaterValuesUnaliased AssumeLocalArrayReceivers IgnoreLoopArrayStores OverstateBoundArgumentCount AssumeNumericAddends AssumePermanentlyPristineIterables SkipSuperMethodGuard SkipSuperPrototypeGuard SkipBoundsProof SkipHierarchyGuards IgnoreSiblingPrototypes SkipPrototypeChecks AssumeLayoutPrototype SkipSuperclassCheck SkipClassGuards AssumePristineDestructuring AssumeIterationsRestartable AssumeInBoundsElementsPresent IgnoreLoopEscapes IgnoreLoopWrites IgnoreLoopUses DropLastCase SkipPairGuard AllowMarkedObjects SkipCapacityChecks DropLargeCountEntries MisnumberFunctionRecords OverstateClosureNumberRuns SwapClosureNumbers SwapBuiltinCellNumbers ReverseFusedCallEntries ReverseFunctionSourceEntries AssumeInvariantOperands AssumeEnumeratorCurrent AssumePristineReceivers SkipStorageChecks AssumeVariablesInitialized IgnoreVariableChecks SkipLengthChecks IgnoreLengthStores IgnorePrototypeReads AssumeSlotsInitialized AssumeArithmeticElementUsers AssumeClearUpperHalves MisstateFact }
flags AdmittedCode { Inspector ReplacedBuiltins }
flags ExcludedCode { EvaluatedText FunctionSource CodeOutsideImage HostEvaluatedText ForeignCalls ForeignCallsOfUnseenCode LibraryText FeaturesNamedAtRunTime }
flags OutputOptions { Obfuscate RunsInSeveralRealms KeepsFunctionNames }
record TargetOptions abi { features: UInt64 featuresRetainedByName: UInt64[8] architecture: Architecture referenceWidth: ReferenceWidth imageForm: ImageForm reserved: UInt32 }
record CompileOptions abi {
    target: TargetOptions sizeClassProgression: Double removedFeatures: UInt64[8] executableIdentity: UInt8[16] size: UInt32
    action: CompileAction checks: CheckSet reports: ReportSet testing: TestingSwitch injectedFaults: FaultInjection
    threadCount: UInt32 admittedCode: AdmittedCode output: OutputOptions
    excludedCode: ExcludedCode understatedEffects: UInt32
    shuffleSeed: UInt32 speculationFailurePeriod: UInt32
    forcedWalkMode: UInt32 forcedWalkModePeriod: UInt32
    loopVisitAbortPeriod: UInt32 loopVisitAbortPhase: UInt32 misstatedFact: UInt32
}

word "check" "<name>,.." "check" custom applyCheck listChecks
word "verify-only" sets action VerifyOnly
word "check-only" sets action CheckOnly
word "testing" "<name>,.." "testing switch" custom applyTesting listTestingSwitches
word "references" "narrow|wide" "reference width" names target::referenceWidth Narrow Wide
word "image-form" "absolute|position-independent" "image form" names target::imageForm Absolute PositionIndependent
word "cpu" "<name>" "CPU" custom applyCPU listCPUs
word "threads" "<n>" number threadCount "the number of threads is at least 1"
word "report" "<name>,.." "report" names reports
word "admit" "<name>,.." "admitted code" names admittedCode
word "exclude" "<name>,.." "excluded code" names excludedCode
word "obfuscate" sets output Obfuscate
word "several-realms" sets output RunsInSeveralRealms
word "erase-types" frontEnd
word "out" "<file>" frontEnd
