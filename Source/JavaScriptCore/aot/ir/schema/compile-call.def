enum KnowledgeLevel { Unknown Expected Proven }
enum AccessCost { ByName TestsReceiver TestsSlot Free }
enum AccessKind { Unknown Read Store Define Has Delete Call Construct Truthiness Equality Arithmetic Comparison Conversion TypeOf InstanceOf Iteration Spread }
enum UnprovenCauseFamily { UnprovenType UnknownCode }
enum UnprovenCause (family: UnprovenCauseFamily) {
    Unknown(UnprovenType) ResultDisabled(UnprovenType) UnknownObject(UnknownCode) NonLayoutObject(UnprovenType) BuiltinBase(UnprovenType)
    UnknownBase(UnknownCode) ClassEvaluatedAgain(UnknownCode) ReachesNativeCode(UnknownCode) ReachesUnknownJavaScript(UnknownCode) UnknownWriter(UnknownCode) UnknownCallee(UnknownCode)
    UnprovenContents(UnprovenType)
    OtherNewTarget(UnknownCode)
    UndescribedNativeResult(UnknownCode) UnseenCode(UnknownCode) UncheckedConversionOfUntracked(UnprovenType) DataFromOutside(UnknownCode) ThrownByRunTime(UnknownCode)
    ParameterOfEscapedFunction(UnknownCode) ContentsOfEscapedObject(UnknownCode) ResultOfUnknownCallee(UnknownCode) ObjectWithoutLayout(UnprovenType)
    Untracked(UnprovenType) LayoutOutsideFamily(UnprovenType)
}
enum UnseenCodeCause { Unknown EvaluatesText ImportsUncompiledModule LoadsModuleByName RunsUnseenCode OptionAdmitsCode FlowResultDisabled RunsMachineCode LoadsCodeByName }
flags BuiltinUse { Tested Read Called Constructed Written Escaped StoredByName NamedAtRunTime }
enum FeatureUseKind { Named Unnamed NamedAtRunTime FoundByName }
enum LocaleUseKind { Unknown HostDefault Constant }
enum TypeTestFailure { TakesGenericPath Throws Leaves }
enum CodeForm { Open Closed Generic }

enum ImageVerdict {
    Unsupported Accepted CompiledCodeDisabled NotAnImage Truncated Misaligned AlreadyInUse LowPagesAccessible NoCode CannotMapCode NeedsCellCage OptionsConflict
    MalformedTables StampMismatch IdentityMismatch CodeAtFixedAddress OutsideItsSegments CannotReadExecutable
}
flags AllocationEscapeReason {
    Returned Thrown StoredInUnknownMemory PassedToUnknownCode RetainedByCallee StoredInEscapingObject LeakedByContainer LimitReached
}
enum AllocationHeapCause {
    None NotTracked HasNoFrameForm Escapes SeveralLiveInstances HasUntrackedAlias LiveAcrossSuspension LiveAtReturnCall HeldByHeapCell HeldAcrossIterations ChangedByUse
    SeenByNativeCode ClosureIsNotOnlyCalled LayoutDefersClosures FieldsCreatedLater ExceedsLimit MaterializationDoesNotPay
}
enum AllocationOutcome (| engine rank: UInt32, refinesHeap: Bool) {
    Unknown(0, false) Removed(1, false) Heap(6, false) Frame(2, false) FrameUntilMaterialized(3, false) Slim(5, true) Deferred(4, true)
}
enum AllocationKind {
    Other Object Array Closure Environment Arguments Rest IteratorResult Generator Promise BoundFunction StringRange Collection
}
enum ResultSection {
    Image Text UserDiagnostics InternalErrors EntryModuleIds UnseenCode BuiltinsUsed FeaturesUsed LocalesUsed WorkerEntries Accesses AccessCounts TypeTests
    AllocationRemarks Statistics Symbols ObfuscatedSites
    LibraryFunctionsLacked WorkerStartsWithoutName
    BytesByForm BytesByModule
    FunctionNames LayoutNames
    URLsThatStartWorkers
    LibraryModulesLacked LibraryModulesWithoutRecord
}

record TextRange abi { offset: UInt32 length: UInt32 }
record SourceLocation abi { module: Module? position: UInt32 }
record Witness abi { function: Function? value: Value? location: SourceLocation }
record UserDiagnosticRecord abi {
    kind: UserDiagnosticKind function: Function? block: Block? value: Value? layout: Layout? limit: LimitID count: UInt32 location: SourceLocation
    message: TextRange origin: SourceLocation siteKind: TypeSiteKind minimum: Double maximum: Double
}
record InternalErrorRecord abi {
    kind: InternalErrorKind function: Function? block: Block? value: Value? layout: Layout? limit: LimitID count: UInt32
    location: SourceLocation message: TextRange
}
record UnseenCodeRecord abi { cause: UnseenCodeCause builtin: Builtin? witness: Witness }
record BuiltinUseRecord abi { builtin: Builtin uses: BuiltinUse witness: Witness }
record LackedFunctionRecord abi { function: UInt32 }
record LackedModuleRecord abi { module: Module }
record LackedRuntimeModuleRecord abi { module: RuntimeModule }
record FeatureUseRecord abi { feature: Feature builtin: Builtin? witness: Witness kind: FeatureUseKind }
record LocaleUseRecord abi { kind: LocaleUseKind tag: TextRange builtin: Builtin? witness: Witness }
record WorkerEntryRecord abi { path: TextRange isGuess: UInt32 hasOptions: UInt32 witness: Witness }
record WorkerStartRecord abi { witness: Witness }
record WorkerURLRecord abi { witness: Witness }
record AccessRecord abi {
    location: SourceLocation kind: AccessKind level: KnowledgeLevel cause: UnprovenCause layout: Layout? copies: UInt32 witness: Witness
    function: Function? illTypedCause: IllTypedCause cost: AccessCost loopDepth: UInt32
}
record AccessCountRecord abi { module: Module accesses: UInt32[3] calls: UInt32[3] typeTests: UInt32 accessCosts: UInt32[4] }
record TypeTestRecord abi {
    location: SourceLocation function: Function? failure: TypeTestFailure copies: UInt32 cause: UnprovenCause illTypedCause: IllTypedCause layout: Layout?
    witness: Witness
}
record AllocationRemarkRecord abi {
    location: SourceLocation forcedBy: SourceLocation outcome: AllocationOutcome copies: UInt32 forcingOperation: TextRange reasons: AllocationEscapeReason
    function: Function? kind: AllocationKind cause: AllocationHeapCause
}
record FormBytesRecord abi { operation: TextRange form: CodeForm count: UInt32 bytes: UInt64 }
record ModuleBytesRecord abi { module: Module functions: UInt32 codeBytes: UInt64 tableBytes: UInt64 }
record FunctionNameRecord abi { function: Function module: Module? name: TextRange }
record LayoutNameRecord abi { layout: Layout name: TextRange }
record ObfuscatedSiteRecord abi { function: UInt32 site: UInt32 location: SourceLocation name: TextRange }

enum CompileAction { Compile VerifyOnly CheckOnly }
enum Architecture { ARM64 X86_64 }
enum ReferenceWidth { Wide Narrow }
enum ImageForm { Absolute PositionIndependent }
flags CheckSet { VerifyEachPass Validate ValidateBackEnd ValidateReferences VerifyEachStage ValidateReferenceGuards FlowFixpoint UsedValuesAreListed ClaimsToBackEnd MovedLoads DecidedComparisons SpillSlots AllocatedRegisters ClaimsOfFlow KeepGoing LastWalksOfLoopsAlone WalksOfLoopsThatFitAgain FlowFindsNoLessFromMore }
flags ReportSet { Flow Symbols Allocations AccessCounts Uses }
flags TestingSwitch { IgnoreBranchHints IgnoreExpectedTypes DelayFlowRules DelayOtherFlowRules ShuffleExpectedTypes NativeCodeAnswersNullish CheckProofsAtRunTime UnseenCodeAnswersUndefined WritesBodiesStraight CheckProofsAtEntries CheckProofsAtEntriesAndFields KeepsCellsOutOfFrames TestsEveryPosition PositionsAreTakenToLieInside CheckEffectsAtRunTime RowSaysLess NoCalleeKeepsWhatItIsHanded ArgumentsOfUnseenCodeDoNotLeave UndoLeavesExpectations ShuffleBlockFrequencies FailGuesses GiveLinkMore ShuffleChoices LaterUnitsOpenNoGuesses CheckWalkAtRunTime OrderBlocksAgain WalksUnitsBy CutWalksOfLoopsShort ReadsBehindTestsOfLengthsAreLeftOut VariablesThatBoundAreTakenToBeAsInFront GuardsAndFactsAreTakenToHold FencesBehindLateStoresAreLeftOut DividendsOfReciprocalsAreTakenToFit32Bits OneRowSpeaksForAllThatCallMayTake NothingIsDoneToFreshLists BoundsOfCountersAreRoundedTheOtherWay Int32sGoIntoListsInTheBoxesTheyCameIn SweepTurnsBranchThatDecidesIntoJump SweepLetsGoEdgeThatIsTaken EmittersAloneTestEveryPosition QuestionsInFrontOfTurnsLaidOutAreTakenToHold EnoughTurnsAreTakenToBeLeftForTurnsLaidOut CallsMadeInFrontOfTurnsAreMadeAgainInThem EveryBuiltinInLineIsTakenToAnswerOutOfItsOperands NumbersStoredIntoListsOfDoublesAreTakenToBeNoNaN ReadsUnderKeysInFrontOfTurnsGoTheGenericRoad OperandsOfRowsUnderKeysAreNamedByWhatTheirVariablesHoldNow ShapeTestsInTurnsLaidOutAreTakenToPass EqualIntegersAreTakenToBeLess StorageAndLengthsAreTakenToBeAsInFront MarkedObjectsAreTakenToBearNoMark NobodyWakesSleepersOfSharedCalls PortersTakeWhatIsOfTheMemberForTheUnknown VouchedPositionsAreTakenOneFurther }
flags AdmittedCode { Inspector ReplacedBuiltins }
flags ExcludedCode { EvaluatedText FunctionSource CodeOutsideImage HostEvaluatedText ForeignCalls ForeignCallsOfUnseenCode LibraryText FilesOfImageForCodeOutside FeaturesNamedAtRunTime }
flags OutputOptions { Obfuscate SharesRealms RunsInSeveralRealms RunsInPlaceOfFiles KeepsFunctionNames }
record ImagesBelowWords abi { address: UInt64 size: UInt64 }
record TargetOptions abi { features: UInt64 featuresKeptOnlyWhenNamed: UInt64[8] imagesBelow: ImagesBelowWords architecture: Architecture referenceWidth: ReferenceWidth imageForm: ImageForm reserved: UInt32 }
record CompileOptions abi {
    target: TargetOptions sizeClassProgression: Double removedFeatures: UInt64[8] executableIdentity: UInt8[16] size: UInt32
    action: CompileAction checks: CheckSet reports: ReportSet testing: TestingSwitch 
    threadCount: UInt32 admittedCode: AdmittedCode output: OutputOptions
    excludedCode: ExcludedCode rowThatSaysLess: UInt32
    seedOfShuffles: UInt32 periodOfGuessesThatFail: UInt32
    wayForcedOnUnits: UInt32 periodOfUnitsWalkedThatWay: UInt32
    periodOfHearingsThatCutWalks: UInt32 phaseOfHearingsThatCutWalks: UInt32 reserved: UInt32
}

word "check" "<name>,.." "check" custom applyCheck listChecks
word "verify-only" sets action VerifyOnly
word "check-only" sets action CheckOnly
word "testing" "<name>,.." "testing switch" custom applyTesting listTestingSwitches
word "references" "narrow|wide" "reference width" names target::referenceWidth Narrow Wide
word "image-form" "absolute|position-independent" "image form" names target::imageForm Absolute PositionIndependent
word "cpu" "<name>" "CPU" custom applyCPU listCPUs
word "threads" "<n>" number threadCount "the number of threads is at least 1"
word "report" "<name>,.." "report" names reports
word "admit" "<name>,.." "admitted code" names admittedCode
word "exclude" "<name>,.." "excluded code" names excludedCode
word "obfuscate" sets output Obfuscate
word "several-realms" sets output RunsInSeveralRealms
word "erase-types" frontEnd
word "out" "<file>" frontEnd
