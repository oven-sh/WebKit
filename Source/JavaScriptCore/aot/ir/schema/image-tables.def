enum CallSiteKind (isFirstRead: Bool, isConstruct: Bool, isTailCall: Bool, isInsideCallee: Bool, namesBuiltin: Bool, isAwaited: Bool) {
    | engine
    Plain(false, false, false, false, false, false)
    Construct(false, true, false, false, false, false)
    TailCall(false, false, true, false, false, false)
    TailConstruct(false, true, true, false, false, false)
    FirstRead(true, false, false, false, false, false)
    InsideBuiltin(false, false, false, false, true, false)
    InsideCallee(false, false, true, true, false, false)
    InsideBuiltinCallee(false, false, true, true, true, false)
    ConstructInsideBuiltin(false, true, false, false, true, false)
    ConstructInsideBuiltinCallee(false, true, true, true, true, false)
    AwaitedCall(false, false, false, false, false, true)
}

packed InlineFrameRow { isTailCall: Bool isConstruct: Bool parent: UInt32 ; function: Function }
packed CallSiteDetails { kind: CallSiteKind frame: UInt32 ; calledBuiltin: Builtin if namesBuiltin(kind) }

packed HandlerRow { sitesSkipped: UInt32 ; furtherSites: UInt32 ; type: HandlerType[2] targetChange: Signed }

packed PositionsHead {
    followsInlineFrames: Bool hasCheckpoints: Bool size: UInt64
    ; isInOtherSource: Bool lineChange: Signed
    ; sourceChange: Signed if isInOtherSource
    ; column: UInt32
    ; count: UInt64 if hasCheckpoints
}

packed PositionRow {
    isOnSameLine: Bool if isOnSameLine { columnChange: Signed } else { isInOtherSource: Bool lineChange: Signed }
    ; source: UInt32 if isInOtherSource
    ; column: UInt32 unless isOnSameLine
}
packed ConstructionStartRow { isOnSameLine: Bool if isOnSameLine { columnsBack: UInt32 } else { linesBack: UInt32 } ; column: UInt32 unless isOnSameLine }

packed QuotedSourceRow {
    isOnSameLine: Bool if isOnSameLine { columnChange: UInt32 } else { lineChange: UInt32 }
    ; column: UInt32 unless isOnSameLine
    ; startChange: Signed
    ; length: UInt32
}

packed FaultStep { isFrameless: Bool isLoopPoll: Bool distance: UInt32 }
