operation Negate (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = ValueNegate ; flow = TableProves
operation ToNumeric (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; ResolvesRopes by Operator ; runtime = ToNumeric ; flow = TableProves
operation Increment (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = Increment ; flow = TableProves
operation Decrement (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = Decrement ; flow = TableProves
operation BitNot (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(BitwiseNot) ; Allocates throws by Operator ; runtime = ValueBitNot ; flow = TableProves
