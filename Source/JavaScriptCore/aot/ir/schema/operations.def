operation TryReExportFields (target: Any/inspects+definesName, source: Any/retains(target), function: Function(Closure)) [reusesDescriptors keyIsFirstCapture] -> natural(boolean) ; DefinesProperty ; branches = May ; runtime = TryReExportFields ; flow = TableProves
operation SetFunctionName (function: Callable/inspects+definesName, computedKey: PropertyKey/inspects, methodKind: MethodKind) -> none ; reads(NamedProperties, StringStorage) writes(NamedProperties, StringStorage, RuntimeState) throws collects ; runtime = SetFunctionName ; flow = Copies
operation SetLiteralPrototype (object: Object/inspects+changesPrototype, prototype: Any/retains(object)+becomesPrototype, engine replacedCallee?: Any/inspects, engine replacedThis?: Any/inspects) [| engine refusesOtherValues] -> none ; reads(PrototypeLinks, ShapeWords) writes(PrototypeLinks, ShapeWords, MemberGuards, RuntimeState) throws collects ; runtime = SetLiteralPrototype ; flow = Copies
operation CopyDataProperties (target: Object/inspects+assignsFrom(source), source: Any/Copied, excludedKeys: List<PropertyKey>, excluded...: PropertyKey/inspects, engine from Placed request?: Request) -> none ; DefinesProperty ; interpreted = List ; runtime = CopyDataProperties ; flow = Copies
operation CopyObject (source: Any/Copied, excludedKeys: List<PropertyKey>, excluded...: PropertyKey/inspects, engine from Placed request?: Request) -> natural(object) ; DefinesProperty ; runtime = CopyObject ; flow = Allocates
operation GetSuperBase (homeKind: HomeObjectKind, home: Object/inspects) -> natural(object | null) ; reads(PrototypeLinks) ; runtime = GetSuperBase ; flow = TableProves
operation SuperGet (base: Any/inspects, receiver: Any/retains, computedKey?: Any/Converted, key?: PropertyKey, with AccessStamp) -> unknown ; unknownCode ; exactlyOneOf = key, computedKey ; accessClass = ByName ; runtime = SuperGet ; flow = Copies
