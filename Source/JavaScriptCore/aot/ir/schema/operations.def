engine operation CallTable (receiver: Object/retains, arguments...: Declared/retains, key: PropertyKey, selector: UInt32, with CallStamp) -> unknown ; unknownCode ; Prepared..Placed ; accessClass = IndirectCall ; form = Open
operation Results (values...: Declared/returns) -> results(..) ; none ; flow = Copies ; form = Open
operation ResultAt (results: Results/inspects, index: UInt32) -> declared(results) ; none ; interpreted = List ; flow = Copies ; form = Open

family Exception AsRead..Placed
operation CatchValue () -> unknown ; UsesRuntime collects ; runtime = Catch ; boundTo = Frame ; flow = Copies ; form = Runtime
operation CatchException () -> natural(Exception) ; UsesRuntime collects ; runtime = CatchException ; boundTo = Frame ; flow = Copies ; form = Runtime

family Hint AsRead..Placed
operation LoopHint () [| engine throwsOwedError] -> none ; UsesRuntime throws terminates collects ; runtime = PollSlow ; flow = TableProves ; form = Open

family Control AsRead..Placed
terminator Jump () -> next ; none
terminator Branch (condition: Boolean/inspects) -> taken(proof), notTaken(proof) ; none
terminator Switch (subject: Any/inspects, cases: List<Int64>) -> case...(proof), otherwise ; none ; proves = CaseValue
terminator SwitchString (subject: Any/inspects, strings: List<String>) -> case...(proof), otherwise ; ResolvesRopes ; proves = CaseValue ; formDependsOnLoop = true
