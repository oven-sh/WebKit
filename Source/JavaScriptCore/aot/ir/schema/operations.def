operation TypeOf (value: Any/inspects) -> natural(string) ; none ; runtime = TypeOf ; flow = TableProves
operation ToString (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(string) ; CreatesString by Operator ; runtime = ToString ; flow = TableProves
