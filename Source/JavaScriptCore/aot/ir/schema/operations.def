operation Upcast (value: Any/returns, castType: Type) -> cast(castType) ; none ; interpreted = Cast ; flow = Copies ; hasKnownValueRule = true ; passThrough = UnclaimedType ; form = Open
operation NarrowByField (value: Any/returns, read: Any/inspects, key: PropertyKey) -> cast ; none ; interpreted = Cast ; flow = Checks ; hasKnownValueRule = true ; passThrough = TestedField ; form = Open
operation NarrowByTest (value: Any/returns, left: Any/inspects) -> cast ; none ; interpreted = Cast ; flow = Checks ; hasKnownValueRule = true ; passThrough = TestedField ; form = Open
operation Check (value: Any/returns, expectedType: Type as ExpectedType, site?: TypeSite) -> cast(expectedType) ; none ; AsRead..Prepared ; interpreted = Cast ; flow = Checks ; hasKnownValueRule = true ; passThrough = ClaimedType
operation Convert (value: Any/returns, declared: DeclaredType, illTypedCause: IllTypedCause) -> natural(same(value)) ; none ; AsRead..AsRead ; flow = Unsound ; flowRule = Convert ; passThrough = UnclaimedType
engine operation Expect (value: Any/returns, expectedType: Type as ExpectedType) -> cast(expectedType) ; none ; Prepared..Placed ; interpreted = Cast ; hasKnownValueRule = true ; passThrough = UnclaimedType ; form = Open
operation CheckInitialized (value: Any/returns, name: String) -> cast ; throws ; interpreted = Cast ; flow = Checks ; hasKnownValueRule = true ; passThrough = PassedCheck ; form = Open
operation RequireObjectCoercible (value: Any/returns, nullishAccess: NullishAccess, name?: String) -> cast ; throws ; interpreted = Cast ; flow = Checks ; runsBeforeCallee = true ; hasKnownValueRule = true ; passThrough = PassedCheck ; form = Open
operation RequireObject (value: Any/returns, runtimeError: RuntimeErrorKind) -> cast ; throws ; interpreted = Cast ; flow = Checks ; hasKnownValueRule = true ; passThrough = PassedCheck ; openUnder = PassesTest, NeedsTest ; runtimeUnder = FailsTest
operation TypeTest (value: Any/inspects, testedType: Type) [| engine asksInFull] -> natural(boolean) ; none ; proves = TestedType ; branches = May ; interpreted = Test ; flow = Checks ; hasKnownValueRule = true ; hasOwnFoldingRule = true ; form = Open
operation IsUnlockedInstance (value: Any/inspects, testedType: Type) -> natural(boolean) ; none ; branches = May ; interpreted = Test ; flow = Checks ; hasOwnFoldingRule = true ; form = Open

family Call AsRead..Placed
operation Call (callee: Any/calls, thisValue?: Any/retains, arguments...: Any/retains, calleeKey?: PropertyKey, calleeName?: String, expectedResult?: ExpectedResult, calledBuiltin?: Builtin, callNumber?: UInt32, engine methodOfReceiverAsMade?: Builtin, with CallStamp) [isNeverInlined isDoneInPlace | engine methodIsNamedByKeyAlone] -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; flow = Copies ; runsBeforeCallee = true ; flowRule = Call ; entersByValue = Call ; form = Closed
operation Construct (callee: Any/calls, newTarget?: Any/retains, arguments...: Any/retains, calleeName?: String, with CallStamp) -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; runtime = Construct ; flow = TableProves ; flowRule = Call ; entersByValue = Construction ; form = Closed
operation CallList (callee: Any/calls, thisValue?: Any/retains, list: Array/Listed, calleeKey?: PropertyKey, calleeName?: String, expectedResult?: ExpectedResult, engine calledBuiltin?: Builtin, with CallStamp) -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; interpreted = List ; runtime = Apply ; flow = Copies ; runsBeforeCallee = true ; flowRule = Call ; entersByValue = Call ; form = Closed
operation ConstructList (callee: Any/calls, newTarget?: Any/retains, list: Array/Listed, calleeName?: String, with CallStamp) -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; interpreted = List ; runtime = ConstructWithArray ; flow = TableProves ; flowRule = Call ; entersByValue = Construction ; form = Runtime
