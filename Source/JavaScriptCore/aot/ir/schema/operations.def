enum AllocationStorage { | engine Heap Frame }
enum ClosureForm { | engine Full Slim Deferred Singleton }
enum ArrayLiteralStorage { | engine Fresh Profiled ProfiledForRoom }
enum TailCallRequirement { | engine Required Allowed }
enum CodeRole { | engine Body GenericCallEntry GenericConstructEntry AllocatingConstructEntry CoroutineBody ModuleStart SlowBody ParameterGuard BoundFunction GenericEntryOfBoundFunction TableEntry TableLookup Serializer }
enum DataEncoding { | engine Unselected Expanded ReadOnlyTree CopyOnWriteArray MadeOnce }
enum ExpectedElements { | engine Anything Int32Array Uint8Array }
# state: what an emitter says that knows no more than the member. An operation that is Unselected has no code.
enum OperatorForm (state: StateOfKnowledge) {
    | engine Unselected(Always) Generic(Generic) Integers(Integers) CheckedIntegers(CheckedIntegers) Numbers(Numbers) NumberAndValue(NumberAndValue)
    Bits(Bits) Booleans(Booleans) BigInts(BigInts) Strings(Strings) StringAndValue(StringAndValue) Int32AndValue(Int32AndValue)
    StringAndPrimitive(StringAndPrimitive) NullableStrings(NullableStrings) NullableStringAndPrimitive(NullableStringAndPrimitive) String(String)
    Number(Number) NumberByOperation(NumberByOperation) NullableString(NullableString) NullableNumber(NullableNumber) MayBeString(MayBeString)
    MayBeStringOrNumber(MayBeStringOrNumber)
}

parameters AccessStamp (engine accessSite?: AccessSite, engine receivers?: LayoutSet, engine from Placed siteCache?: SiteCache)
parameters CallStamp (engine accessSite?: AccessSite, engine callees?: CalleeSet)
# numberAmongLoans: of a cell in the frame that dies with the call that it is lent to, one more than the number of cells that are lent where it is made (Walker::lend()).
# No two cells with one number are alive at one time, so those of one size share their words of the frame. Zero: the cell has words of its own.
parameters CellStamp (engine allocationSite?: AllocationSite, engine storage: AllocationStorage, engine numberAmongLoans: UInt32, engine from Placed allocation?: Allocation)

effects DefinesProperty = Allocates reads(ShapeWords, OrderWords, NamedProperties, ObjectFields) writes(ShapeWords, MemberGuards, OrderWords, NamedProperties, ObjectFields, RuntimeState) throws
effects DefinesMemberOfClass = Allocates reads(ShapeWords, OrderWords, NamedProperties, ObjectFields) writes(ShapeWords, OrderWords, NamedProperties, ObjectFields, RuntimeState) throws

family Constant AsRead..Placed
operation Undefined () -> constant ; none ; flow = TableProves ; hasKnownValueRule = true ; flowsWithoutRule = true ; form = Open
operation Null () -> constant ; none ; flow = TableProves ; hasKnownValueRule = true ; flowsWithoutRule = true ; form = Open
