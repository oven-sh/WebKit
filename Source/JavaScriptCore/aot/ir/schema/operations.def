operation ElemHas (object: Any/inspects, property: Any/Converted, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByValAndCache ; branches = May ; flow = TableProves
operation ElemDelete (object: Any/inspects+deletesByKey, property: Any/Converted, mode: ECMAMode, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; accessClass = ByName ; runtime = DeleteByVal ; flow = TableProves
operation ElemDefine (object: Object/inspects+storesByKey, property: Any/Converted, value: Any/retains(object), with AccessStamp) -> none ; unknownCode by Access ; receiver = object ; interpreted = Store ; accessClass = ByName ; runtime = DefineField ; flow = Copies
operation DefineGetter (object: Object/inspects+definesName, function: Callable/retains(object), computedKey?: PropertyKey/inspects, key?: PropertyKey) -> none ; DefinesProperty ; exactlyOneOf = key, computedKey ; runtime = DefineAccessor ; flow = Copies
operation DefineSetter (object: Object/inspects+definesName, function: Callable/retains(object), computedKey?: PropertyKey/inspects, key?: PropertyKey) -> none ; DefinesProperty ; exactlyOneOf = key, computedKey ; runtime = DefineAccessor ; flow = Copies
