operation Double (number: Double) -> constant ; none ; flow = TableProves ; hasKnownValueRule = true ; flowsWithoutRule = true ; form = Open
# isAtom: the copy of the constant that an operation takes as a key or compares.
# String, KeyConstant and Builtin: the stub reads the word of the cell before it makes anything, so it is called each time wherever no loop of the unit stands around, and in a block of a loop that is rare or unlikely.
# One binary, 139 rows (build 376): 123 rows the same, none moves by 0.5%, the compiler benchmark 9,988,356 | 9,767,284 B (-2.2%) and 1,873.2 | 1,876.4 M (+0.17%). Servers (build 440): strings -3.0% of code, ten routes 0.1 to 0.6% slower.
operation String (string: String) [| engine isAtom] -> constant ; CreatesConstant ; runtime = StringConstant ; flow = TableProves ; hasKnownValueRule = true ; flowsWithoutRule = true ; formDependsOnLoop = true ; form = Closed ; openIn = Loop ; closedIn = UnlikelyBlock, RareBlock, CodeThatRunsOnce
operation BigInt (digits: String) -> constant ; CreatesConstant ; runtime = BigIntConstant ; flow = TableProves ; flowsWithoutRule = true ; form = Open
operation Builtin (builtin: Builtin) [isNotReadFromHolder] -> constant ; CreatesConstant ; runtime = BuiltinCell ; flow = TableProves ; flowRule = Module ; formDependsOnLoop = true ; form = Closed ; openIn = Loop ; closedIn = UnlikelyBlock, RareBlock, CodeThatRunsOnce
operation ModuleBuiltin (builtin: Builtin, module: Module(Referrer)) -> constant ; Allocates UsesRuntime throws ; runtime = ModuleBuiltinCell ; flow = TableProves ; form = Open
operation Data (data: Data, engine allocationSite?: AllocationSite, engine arrayStorage: ArrayStorage, engine from Selected encoding: DataEncoding, engine from Placed request?: Request) [| engine isNeverToldApart] -> constant ; Allocates throws ; runtime = NewFromData ; interpreted = Allocation ; flow = Allocates ; flowRule = Heap ; formDependsOnLoop = true ; openUnder = MadeOnce ; closedUnder = CopyOnWriteArray ; runtimeUnder = ReadOnlyTree ; openIn = Loop
operation NewClosure (function: Function(Closure), captures...: Declared/retains(result), with CellStamp, engine from Selected closureForm: ClosureForm) [| engine isMadeOnDemand isHeldByClosureTable isLent isMadeForOneUse] -> constant ; Allocates ; runtime = NewClosureSlow ; interpreted = Allocation ; allocatesInline = true ; flow = Allocates ; flowsWithoutRule = true ; openUnder = SlimInFrame, FullInFrame, FullWithOwnStructure, Singleton ; closedUnder = SlimOnHeap, FullOnHeap
engine operation KeyConstant (key: PropertyKey) -> constant ; CreatesConstant ; runtime = KeyConstant ; flow = TableProves ; flowsWithoutRule = true ; formDependsOnLoop = true ; form = Closed ; openIn = Loop ; closedIn = UnlikelyBlock, RareBlock, CodeThatRunsOnce
operation Unspecified (valueType: Type) -> declared(valueType) ; none ; Prepared..Placed ; form = Open
operation EmptyArgumentList (valueType: Type) -> declared(valueType) ; none ; Prepared..Placed ; replaces = NewArray ; form = Open

family Binding AsRead..Placed
engine operation Parameter () -> declared ; none ; boundTo = Function ; flow = Copies ; flowsWithoutRule = true ; form = Open
operation GetModuleVariable (engine fact?: Fact/inspects, variable: Variable) [| engine mayPrecedeItsStore followsItsStore] -> declared(variable) ; reads(ModuleVariables[variable]) collects ; flow = Copies ; flowsWithoutRule = true ; form = Open
engine operation GetEncodedModuleVariable (variable: Variable) -> declared(variable) ; reads(ModuleVariables[variable]) ; Selected..Placed ; replaces = GetModuleVariable, TypeTest ; form = Open
operation PutModuleVariable (variable: Variable, value: Declared/retains) -> none ; writes(ModuleVariables[variable]) ; flow = Copies ; flowsWithoutRule = true ; form = Open
# `class Meter { static raw = 0 }   Meter.raw`. While the class object is not made, a static field that has been defined lies in the variable that the record of the class names for it, as a plain property would: object/AOTStaticFields.h.
# The read asks what the run time asks: nothing has been put on the cell, and the variable is not empty; else it gives absent, and the access goes as it is written. The store comes behind a read that gave a value.
# THE WORD IS A PROPERTY OF AN OBJECT, NOT A VARIABLE OF THE PROGRAM: whoever stores under a name, closed, in a callee or in the run time, may write it, and none of them names ModuleVariables.
engine operation GetStaticFieldOrAbsent (variable: Variable, valueType: Type, classObject: Object/inspects) -> declared(valueType) ; reads(NamedProperties) ; Prepared..Placed ; replaces = PropGet ; form = Open
engine operation PutStaticField (variable: Variable, classObject: Object/inspects, value: Any/retains(classObject)) -> none ; writes(NamedProperties) ; Prepared..Placed ; replaces = PropSet ; form = Open
operation GetEnvironmentField (environment: Layout/inspects, layout: Layout, field: Field) [| engine mayPrecedeItsStore leansOnEntryOfBody followsItsStore] -> declared(field) ; reads(EnvironmentFields[layout, field]) ; interpreted = Read ; flow = Copies ; flowsWithoutRule = true ; form = Open
operation PutEnvironmentField (environment: Layout/inspects, layout: Layout, field: Field, value: Declared/retains(environment)) -> none ; writes(EnvironmentFields[layout, field]) ; interpreted = Store ; runsOwnerBarrier = true ; remembersOwner = true ; flow = Copies ; flowsWithoutRule = true ; form = Open
operation ScopeHasBinding (scope: Object/inspects, key: PropertyKey) -> natural(boolean) ; unknownCode ; runtime = ScopeHasBinding ; flow = TableProves ; flowRule = Heap ; form = Runtime

family Allocation AsRead..Placed
# An object in the frame that may get fields after its construction has its header, its order word and its shape word filled by the stub InitializeObjectInFrame, and in a loop in line: 75 bytes a site in line, 18 bytes and 3.5 instructions more by the stub (read off the code, AllocationEmitter::initializesFrameObjectInStub()). NOT MEASURED on any program.
operation NewObject (layout: Layout, fields: List<Field>, prototype?: Object/retains(result), values...: Declared/retains(result), with CellStamp, engine allocationClass?: AllocationClass) [| engine listsOnlyStoredValues isMadeForOneUse] -> allocation(layout) ; Allocates writes(MemberGuards) ; runtime = AllocateSlow ; interpreted = Allocation ; allocatesInline = true ; allocatesAfterLastSafepoint = true ; replaces = CreateIteratorResult ; flow = Allocates ; flowRule = Heap ; closedUnder = Always, ObjectInFrame ; openUnder = CellInFrameFilledOnce ; formDependsOnLoop = true ; openIn = Loop
# roomForNames: how many names the runs of definitions behind it give it. The cell has room for them, where a run that asks its site stores. A hint.
operation NewDictionary (engine roomForNames?: UInt32) -> natural(object) ; Allocates ; runtime = NewDictionary ; allocatesInline = true ; flow = Allocates ; flowRule = NewDictionary ; form = Closed
operation FinishObject (object: Object/returns) -> natural(same(object)) ; none ; interpreted = Cast ; flow = Copies ; handsOn = Mark ; form = Open
# literalStorage. Profiled: an empty list without a capacity takes its room and the kind of its storage from what the lists of its site came to be. ProfiledForRoom: its room alone, because the kind is decided for the program.
# Fresh: every other literal. An empty list outside every loop of a unit that runs at most once is one too: it is the only list of its site, so the site has nobody to teach.
# The loop not asked, build 378, 139 rows: 194 bytes fewer of 181 M, f17-array-push-sort +0.7% as written and -1.3% erased, no other row moves. Nothing shows yet that the question pays.
operation NewArray (contents: Type, holes: List<UInt32>, engine capacity?: Integer/inspects, elements...: Declared/retains(result), engine allocationSite?: AllocationSite, engine storage: AllocationStorage, engine literalStorage: ArrayLiteralStorage, engine arrayStorage: ArrayStorage) [| engine contentsAreProven keepsLength isFilledToCapacity isMadeForOneUse] -> allocation(Array<contents>) ; Allocates ; runtime = NewArray ; interpreted = Allocation ; allocatesInline = true ; flow = Allocates ; flowRule = Heap ; formDependsOnLoop = true ; form = Closed
# length: the length that the list has in front of the append, which is then not read. Behind it, GetArrayCapacity of the list from in front of a loop in which nothing else writes to the list: below that the list has room.
# In a loop each kind of storage that may take the value has an arm in line. Elsewhere the declared or expected kind alone has one, and ArrayPush takes a list of any other kind.
# With every arm everywhere, the bodies of the application, build 405: 25,836 appends of 121 bytes. Nothing shows yet that the question pays.
operation AppendElement (array: Array/inspects+writesContents, value: Any/retains(array), engine length...: Integer/inspects) -> none ; GrowsArray ; runtime = ArrayPush ; interpreted = Store ; runsOwnerBarrier = true ; flow = Copies ; flowRule = Heap ; formDependsOnLoop = true ; openIn = Loop ; form = Closed
operation AppendSpread (array: Array/inspects+writesContents, iterable: Any/Iterated) -> none ; GrowsArray ; AsRead..AsRead ; interpreted = List ; removedBy = ExpandIteration ; flow = Copies ; flowRule = Iteration
operation AppendHole (array: Array/inspects+writesContents) -> none ; GrowsArray ; runtime = AppendHole ; interpreted = Store ; flow = Copies ; flowRule = Heap ; form = Runtime
# isNeverToldApart: every evaluation hands out the one object in the cell of the literal, as SharedRegExpLiteral does. The result is still typed as the object that Facts has for the place.
operation NewRegExp (pattern: String, regExpFlags: RegExpFlags, engine allocationSite?: AllocationSite, engine from Placed regExpRecord?: RegExpRecord, engine from Placed staticsOffset?: StaticsOffset) [| engine isNeverToldApart] -> allocation(RegExp) ; Allocates ; runtime = NewRegExpLiteral ; interpreted = Allocation ; allocatesInline = true ; flow = Allocates ; form = Closed
operation NewTemplateObject (templateStrings: List<TemplateString>, engine from Placed request?: Request, engine from Placed staticsOffset?: StaticsOffset) -> allocation(Array) ; Allocates ; runtime = NewTemplateObject ; boundTo = Site ; flow = Allocates ; flowRule = Heap ; form = Open
operation NewRuntimeError (runtimeError: RuntimeErrorKind, name?: String) -> natural(object) ; Allocates UsesRuntime ; runtime = NewRuntimeError ; flow = Allocates ; form = Runtime
operation NewSuppressedError (error: Any/retains(result), suppressed: Any/retains(result)) -> natural(object) ; Allocates UsesRuntime ; runtime = NewSuppressedError ; flow = Allocates ; form = Runtime
operation CreateUnmappedArguments (count: Integer/inspects, rest: Array/Listed, parameters...: Any/retains(result), engine allocationSite?: AllocationSite) -> allocation(Arguments) ; Allocates ; runtime = CreateUnmappedArguments ; interpreted = Allocation ; flow = Allocates ; flowRule = Heap ; form = Runtime
operation CreateMappedArguments (callee: Callable/retains(result), count: Integer/inspects, rest: Array/Listed, parameters...: Any/retains(result), engine allocationSite?: AllocationSite) -> allocation(Arguments) ; Allocates ; runtime = CreateMappedArguments ; interpreted = Allocation ; flow = Allocates ; flowRule = Heap ; form = Runtime
operation GetMappedArgument (arguments: Object/inspects, index: UInt32) -> unknown ; reads(Elements[Arguments]) ; runtime = GetMappedArgument ; interpreted = Read ; holder = arguments ; slotOfHolder = Element ; flow = Copies ; flowRule = Heap ; form = Open
operation SetMappedArgument (arguments: Object/inspects+writesContents, index: UInt32, value: Any/retains(arguments)) -> none ; writes(Elements[Arguments]) ; runtime = SetMappedArgument ; interpreted = Store ; holder = arguments ; slotOfHolder = Element ; runsOwnerBarrier = true ; remembersOwner = true ; flow = Copies ; flowRule = Heap ; form = Open

family Access AsRead..Placed
# siteCaches: PropGet and PropSet take their site in a loop of the function, after inlining, where one kind of receiver comes again and again. Elsewhere the front tables answer for every Structure alike,
# in about what a hit at a site and the operand that names the site cost together, and the operand is eight bytes of code at each access. Under a name without a column in the front tables the site is taken wherever the code may come again.
# In such a loop a PropGet whose receiver is proven to be an object of listed layouts asks its site in line: by the stub there, `node.left?.leaf` in a loop takes 1.3% more instructions, and the code of the compiler benchmark is 0.33% smaller (build 378, 139 rows).
# isPlainStoreToClosure: the receiver is a closure that this code has made. The store makes or overwrites an own data property of it, runs no code and fails only for lack of memory, and no stack frame shows a property of the function object.
# Whoever sees the store has the closure in hand, so the sweep drops a closure that nothing but such stores needs, and the stores with it.
operation PropGet (object: Any/inspects, key: PropertyKey, with AccessStamp) [isFreeName isForTypeOf | engine asksOnlyTables] -> unknown => declared(key) ; unknownCode by Access ; access = Read ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = GetByIdAndCache ; siteCaches = 1 ; flow = Copies ; runsBeforeCallee = true ; flowRule = Heap ; formDependsOnLoop = true ; closedUnder = Always ; runtimeUnder = FreeName ; openIn = Loop
# runtimeIn = CodeThatRunsOnce of PropSet and PropDefine: AccessEmitter::putById() behind comesAgain(). Under a name without a column of the front tables, a store outside every loop of a unit that runs once calls the run time, which files nothing, where any other store calls the stub that looks by the hash. NOT MEASURED: no page has a number for it, and the design allows the question for a loop alone.
operation PropSet (object: Any/inspects, key: PropertyKey, mode: ECMAMode, value: Any/retains(object), with AccessStamp) [isFreeName | engine isPlainStoreToClosure] -> none ; unknownCode by Access ; access = Store ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = PutByIdAndCache ; siteCaches = 1 ; flow = Copies ; flowRule = Heap ; formDependsOnLoop = true ; form = Closed ; runtimeIn = CodeThatRunsOnce
operation PropDefine (object: Object/inspects, key: PropertyKey, value: Any/retains(object), with AccessStamp) -> none ; unknownCode by Access ; access = Define ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = DefineById ; flow = Copies ; flowRule = Heap ; formDependsOnLoop = true ; form = Closed ; runtimeIn = CodeThatRunsOnce
operation PropHas (object: Any/inspects, key: PropertyKey, with AccessStamp) -> natural(boolean) ; unknownCode by Access ; access = Has ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByIdAndCache ; branches = May ; flow = TableProves ; flowRule = Heap ; form = Closed
operation PropDelete (object: Any/inspects+deletesByKey, key: PropertyKey, mode: ECMAMode, with AccessStamp) [isFreeName] -> natural(boolean) ; unknownCode by Access ; interpreted = Store ; accessClass = ByName ; runtime = DeleteById ; flow = TableProves ; flowRule = Heap ; form = Closed
