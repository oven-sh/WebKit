enum AllocationStorage { | engine Heap Frame }
enum ClosureForm { | engine Full Slim Deferred Singleton }
enum LoanOfClosure { | engine None ToFunctionEntered LeftToStubOfCall }
enum ArrayLiteralStorage { | engine Fresh Profiled ByElements }
enum TailCallRequirement { | engine Required Allowed }
enum CodeRole { | engine Body GenericCallEntry GenericConstructEntry AllocatingConstructEntry CoroutineBody ModuleStart SlowBody ParameterGuard TableEntry TableLookup }
enum DataEncoding { | engine Unselected ReadOnlyTree CopyOnWriteArray TreeWithOwnStorage }
enum ExpectedElements { | engine Anything Int32Array Uint8Array Float64Array }
enum OperatorForm (state: StateOfKnowledge) {
    | engine Unselected(Always) Generic(Generic) Integers(Integers) CheckedIntegers(CheckedIntegers) Numbers(Numbers) NumberAndValue(NumberAndValue)
    Bits(Bits) Booleans(Booleans) BigInts(BigInts) Strings(Strings) StringAndValue(StringAndValue) Int32AndValue(Int32AndValue)
    StringAndPrimitive(StringAndPrimitive) NullableStrings(NullableStrings) NullableStringAndPrimitive(NullableStringAndPrimitive) String(String)
    Number(Number) NumberByOperation(NumberByOperation) NullableString(NullableString) NullableNumber(NullableNumber) MayBeString(MayBeString)
    MayBeStringOrNumber(MayBeStringOrNumber)
}

parameters AccessStamp (engine receivers?: LayoutSet)
parameters CallStamp (engine callees?: CalleeSet)
parameters CellStamp (engine storage: AllocationStorage)

