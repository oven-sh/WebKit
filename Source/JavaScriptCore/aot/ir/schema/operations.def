operation NewRuntimeError (runtimeError: RuntimeErrorKind, name?: String) -> natural(object) ; Allocates UsesRuntime ; runtime = NewRuntimeError ; flow = Allocates
operation NewSuppressedError (error: Any/retains(result), suppressed: Any/retains(result)) -> natural(object) ; Allocates UsesRuntime ; runtime = NewSuppressedError ; flow = Allocates
