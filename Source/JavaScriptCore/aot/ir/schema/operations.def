enum AllocationStorage { | engine Heap Frame FrameUntilMaterialized }
enum ClosureForm { | engine Full Slim Deferred Singleton }
enum ArrayLiteralStorage { | engine Fresh Profiled }
enum TailCallRequirement { | engine Required Allowed }
enum DataEncoding { | engine Unselected Expanded ReadOnlyTree CopyOnWriteArray }
enum ExpectedElements { | engine Anything Int32Array Uint8Array }
enum OperatorForm {
    | engine Unselected Generic Integers CheckedIntegers Numbers NumberAndValue Bits Booleans BigInts Strings StringAndValue Int32AndValue
    StringAndPrimitive NullableStrings NullableStringAndPrimitive String Number NumberByOperation NullableString NullableNumber MayBeString
    MayBeStringOrNumber
}

parameters AccessStamp (engine accessSite?: AccessSite, engine receivers?: LayoutSet, engine from Placed siteCache?: SiteCache)
parameters CallStamp (engine accessSite?: AccessSite, engine callees?: CalleeSet)
parameters CellStamp (engine allocationSite?: AllocationSite, engine storage: AllocationStorage, engine from Placed allocation?: Allocation)

effects DefinesProperty = Allocates reads(ShapeWords, OrderWords, NamedProperties, ObjectFields) writes(ShapeWords, MemberGuards, OrderWords, NamedProperties, ObjectFields, RuntimeState) throws
effects DefinesMemberOfClass = Allocates reads(ShapeWords, OrderWords, NamedProperties, ObjectFields) writes(ShapeWords, OrderWords, NamedProperties, ObjectFields, RuntimeState) throws

