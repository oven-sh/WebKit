enum AllocationStorage { | engine Heap Frame FrameUntilMaterialized }
enum ClosureForm { | engine Full Slim Deferred Singleton }
enum ArrayLiteralStorage { | engine Fresh Profiled }
enum TailCallRequirement { | engine Required Allowed }
enum DataEncoding { | engine Unselected Expanded ReadOnlyTree CopyOnWriteArray }
enum OperatorForm {
    | engine Unselected Generic Integers CheckedIntegers Numbers NumberAndValue Bits Booleans BigInts Strings StringAndValue Int32AndValue
    StringAndPrimitive NullableStrings NullableStringAndPrimitive String Number NumberByOperation NullableString NullableNumber MayBeString
    MayBeStringOrNumber
}

parameters AccessStamp (engine accessSite?: AccessSite, engine receivers?: LayoutSet, engine from Placed siteCache?: SiteCache)
parameters CallStamp (engine accessSite?: AccessSite, engine callees?: CalleeSet)
parameters CellStamp (engine allocationSite?: AllocationSite, engine storage: AllocationStorage, engine from Placed allocation?: Allocation)

effects DefinesProperty = Allocates reads(ShapeWords, OrderWords, NamedProperties, ObjectFields) writes(ShapeWords, ShapeEpoch, OrderWords, NamedProperties, ObjectFields, RuntimeState) throws

family Constant AsRead..Placed
operation Undefined () -> constant ; none
operation Null () -> constant ; none
operation Absent () -> constant ; none
operation Boolean (boolean: Bool) -> constant ; none
operation Integer (integer: Int64) -> constant ; none
operation Double (number: Double) -> constant ; none
operation String (string: String) -> constant ; CreatesConstant ; runtime = StringConstant
operation BigInt (digits: String) -> constant ; CreatesConstant ; runtime = BigIntConstant
operation Builtin (builtin: Builtin) -> constant ; CreatesConstant ; runtime = BuiltinCell
operation ModuleBuiltin (builtin: Builtin, module: Module(Referrer)) -> constant ; Allocates UsesRuntime throws ; runtime = ModuleBuiltinCell
operation Data (data: Data, engine allocationSite?: AllocationSite, engine from Selected encoding: DataEncoding, engine from Placed request?: Request) -> constant ; Allocates throws ; runtime = NewFromData ; interpreted = Allocation
operation NewClosure (function: Function(Closure), captures...: Declared/retains(result), with CellStamp, engine from Selected closureForm: ClosureForm) [| engine isMadeOnDemand] -> constant ; Allocates ; runtime = NewClosureSlow ; interpreted = Allocation ; allocatesInline = true
engine operation KeyConstant (key: PropertyKey) -> constant ; CreatesConstant ; runtime = KeyConstant
operation Unspecified (valueType: Type) -> declared(valueType) ; none ; Prepared..Placed

family Binding AsRead..Placed
engine operation Parameter () -> declared ; none ; boundTo = Function
operation GetModuleVariable (variable: Variable) -> declared(variable) ; reads(ModuleVariables[variable])
engine operation GetEncodedModuleVariable (variable: Variable) -> declared(variable) ; reads(ModuleVariables[variable]) ; Selected..Placed ; replaces = GetModuleVariable, TypeTest
operation PutModuleVariable (variable: Variable, value: Declared/retains) -> none ; writes(ModuleVariables[variable])
operation GetEnvironmentField (environment: Layout/inspects, layout: Layout, field: Field) -> declared(field) ; reads(EnvironmentFields[layout, field]) ; interpreted = Read
operation PutEnvironmentField (environment: Layout/inspects, layout: Layout, field: Field, value: Declared/retains(environment)) -> none ; writes(EnvironmentFields[layout, field]) ; interpreted = Store ; runsOwnerBarrier = true ; remembersOwner = true
operation ScopeHasBinding (scope: Object/inspects, key: PropertyKey) -> natural(boolean) ; unknownCode ; runtime = ScopeHasBinding

family Allocation AsRead..Placed
operation NewObject (layout: Layout, fields: List<Field>, prototype?: Object/retains(result), values...: Declared/retains(result), with CellStamp, engine allocationClass?: AllocationClass) [| engine keepsShape] -> allocation(layout) ; Allocates ; runtime = AllocateSlow ; interpreted = Allocation ; allocatesInline = true ; allocatesAfterLastSafepoint = true ; replaces = CreateIteratorResult
operation FinishObject (object: Object/returns) -> natural(same(object)) ; none ; interpreted = Cast
operation NewArray (contents: Type, holes: List<UInt32>, engine capacity?: Integer/inspects, elements...: Any/retains(result), engine allocationSite?: AllocationSite, engine literalStorage: ArrayLiteralStorage, engine from Placed staticsOffset?: StaticsOffset) -> allocation(Array<contents>) ; Allocates ; runtime = NewArray ; interpreted = Allocation ; allocatesInline = true
operation AppendElement (array: Array/inspects+writesContents, value: Any/retains(array)) -> none ; GrowsArray ; runtime = ArrayPush ; interpreted = Store ; runsOwnerBarrier = true
operation AppendSpread (array: Array/inspects+writesContents, iterable: Any/Iterated) -> none ; GrowsArray ; AsRead..AsRead ; interpreted = List ; removedBy = ExpandIteration
operation AppendHole (array: Array/inspects+writesContents) -> none ; GrowsArray ; runtime = AppendHole ; interpreted = Store
operation NewRegExp (pattern: String, regExpFlags: RegExpFlags, engine allocationSite?: AllocationSite, engine from Placed regExpRecord?: RegExpRecord, engine from Placed staticsOffset?: StaticsOffset) -> allocation(RegExp) ; Allocates ; runtime = NewRegExpLiteral ; interpreted = Allocation ; allocatesInline = true
operation NewTemplateObject (templateStrings: List<TemplateString>, engine from Placed request?: Request, engine from Placed staticsOffset?: StaticsOffset) -> allocation(Array) ; Allocates ; runtime = NewTemplateObject ; boundTo = Site
operation NewRuntimeError (runtimeError: RuntimeErrorKind, name?: String) -> natural(object) ; Allocates UsesRuntime ; runtime = NewRuntimeError
operation NewSuppressedError (error: Any/retains(result), suppressed: Any/retains(result)) -> natural(object) ; Allocates UsesRuntime ; runtime = NewSuppressedError
operation CreateUnmappedArguments (count: Integer/inspects, rest: Array/Listed, parameters...: Any/retains(result), engine allocationSite?: AllocationSite) -> allocation(Arguments) ; Allocates ; runtime = CreateUnmappedArguments ; interpreted = Allocation
operation CreateMappedArguments (callee: Callable/retains(result), count: Integer/inspects, rest: Array/Listed, parameters...: Any/retains(result), engine allocationSite?: AllocationSite) -> allocation(Arguments) ; Allocates ; runtime = CreateMappedArguments ; interpreted = Allocation
operation GetMappedArgument (arguments: Object/inspects, index: UInt32) -> unknown ; reads(Elements[Arguments]) ; runtime = GetMappedArgument ; interpreted = Read
operation SetMappedArgument (arguments: Object/inspects+writesContents, index: UInt32, value: Any/retains(arguments)) -> none ; writes(Elements[Arguments]) ; runtime = SetMappedArgument ; interpreted = Store ; runsOwnerBarrier = true ; remembersOwner = true

family Access AsRead..Placed
operation PropGet (object: Any/inspects, key: PropertyKey, with AccessStamp) [isFreeName isForTypeOf] -> unknown => declared(key) ; unknownCode by Access ; access = Read ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = GetByIdAndCache ; siteCaches = 1
operation PropSet (object: Any/inspects, key: PropertyKey, mode: ECMAMode, value: Any/retains(object), with AccessStamp) [isFreeName] -> none ; unknownCode by Access ; access = Store ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = PutByIdAndCache ; siteCaches = 1
operation PropDefine (object: Object/inspects, key: PropertyKey, value: Any/retains(object), with AccessStamp) -> none ; unknownCode by Access ; access = Define ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = DefineById
operation PropHas (object: Any/inspects, key: PropertyKey, with AccessStamp) -> natural(boolean) ; unknownCode by Access ; access = Has ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByIdAndCache ; branches = May
operation PropDelete (object: Any/inspects+deletesByKey, key: PropertyKey, mode: ECMAMode, with AccessStamp) [isFreeName] -> natural(boolean) ; unknownCode by Access ; accessClass = ByName ; runtime = DeleteById
operation ElemGet (object: Any/inspects, property: Any/Converted, with AccessStamp) [| engine keyIsIntegral] -> unknown => declared(object) ; unknownCode by Access ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = GetByValAndCache
operation ElemSet (object: Any/inspects+storesByKey, property: Any/Converted, mode: ECMAMode, value: Any/retains(object), with AccessStamp) [| engine keyIsIntegral] -> none ; unknownCode by Access ; receiver = object ; interpreted = Store ; accessClass = ByName ; runtime = PutByValAndCache
operation ElemHas (object: Any/inspects, property: Any/Converted, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByValAndCache ; branches = May
operation ElemDelete (object: Any/inspects+deletesByKey, property: Any/Converted, mode: ECMAMode, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; accessClass = ByName ; runtime = DeleteByVal
operation ElemDefine (object: Object/inspects+storesByKey, property: Any/Converted, value: Any/retains(object), with AccessStamp) -> none ; unknownCode by Access ; receiver = object ; interpreted = Store ; accessClass = ByName ; runtime = DefineField
operation DefineGetter (object: Object/inspects+definesName, function: Callable/retains(object), computedKey?: PropertyKey/inspects, key?: PropertyKey) -> none ; DefinesProperty ; exactlyOneOf = key, computedKey ; runtime = DefineAccessor
operation DefineSetter (object: Object/inspects+definesName, function: Callable/retains(object), computedKey?: PropertyKey/inspects, key?: PropertyKey) -> none ; DefinesProperty ; exactlyOneOf = key, computedKey ; runtime = DefineAccessor
operation SetFunctionName (function: Callable/inspects+definesName, computedKey: PropertyKey/inspects, methodKind: MethodKind) -> none ; reads(NamedProperties, StringStorage) writes(NamedProperties, StringStorage, RuntimeState) throws collects ; runtime = SetFunctionName
operation SetLiteralPrototype (object: Object/inspects+changesPrototype, prototype: Any/retains(object)+becomesPrototype) -> none ; reads(PrototypeLinks, ShapeWords) writes(PrototypeLinks, ShapeWords, ShapeEpoch, RuntimeState) collects ; runtime = SetLiteralPrototype
operation CopyDataProperties (target: Object/inspects+assignsFrom(source), source: Any/Copied, excludedKeys: List<PropertyKey>, excluded...: PropertyKey/inspects, engine from Placed request?: Request) -> none ; DefinesProperty ; interpreted = List ; runtime = CopyDataProperties
operation GetSuperBase (homeKind: HomeObjectKind, home: Object/inspects) -> natural(object | null) ; reads(PrototypeLinks) ; runtime = GetSuperBase
operation SuperGet (base: Any/inspects, receiver: Any/retains, computedKey?: Any/Converted, key?: PropertyKey, with AccessStamp) -> unknown ; unknownCode ; exactlyOneOf = key, computedKey ; accessClass = ByName ; runtime = SuperGet
operation SuperSet (mode: ECMAMode, base: Any/inspects, receiver: Any/retains+storesByKey, value: Any/retains, computedKey?: Any/Converted, key?: PropertyKey, with AccessStamp) -> none ; unknownCode ; exactlyOneOf = key, computedKey ; accessClass = ByName ; runtime = SuperSet

family Operator AsRead..Placed
operation Add (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Addition) ; CreatesString by Operator ; runtime = ValueAdd
operation Sub (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValueSub
operation Mul (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValueMul
operation Div (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValueDiv
operation Mod (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValueMod
operation Pow (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValuePow
operation BitAnd (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Bitwise) ; Allocates throws by Operator ; runtime = ValueBitAnd
operation BitOr (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Bitwise) ; Allocates throws by Operator ; runtime = ValueBitOr
operation BitXor (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Bitwise) ; Allocates throws by Operator ; runtime = ValueBitXor
operation LShift (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Bitwise) ; Allocates throws by Operator ; runtime = ValueLShift
operation RShift (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Bitwise) ; Allocates throws by Operator ; runtime = ValueRShift
operation URShift (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(uint32) ; ResolvesRopes by Operator ; runtime = ValueURShift
operation Negate (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = ValueNegate
operation ToNumeric (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; ResolvesRopes by Operator ; runtime = ToNumeric
operation Increment (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = Increment
operation Decrement (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(Numeric) ; Allocates throws by Operator ; runtime = Decrement
operation BitNot (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(BitwiseNot) ; Allocates throws by Operator ; runtime = ValueBitNot
operation ToNumber (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(number) ; ResolvesRopes by Operator ; runtime = ToNumber
operation Less (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareLess ; proves = IntegerBound ; branches = May
operation LessEq (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareLessEq ; proves = IntegerBound ; branches = May
operation Greater (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareGreater ; proves = IntegerBound ; branches = May
operation GreaterEq (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareGreaterEq ; proves = IntegerBound ; branches = May
operation Eq (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareEq ; proves = Equality ; branches = May
operation StrictEq (left: Any/inspects, right: Any/inspects, engine from Selected form: OperatorForm) -> natural(boolean) ; ResolvesRopes by Operator ; runtime = CompareStrictEq ; proves = Equality ; branches = May ; interpreted = Test
operation InstanceOf (value: Any/inspects+runs(PrototypeChain), constructor: Any/inspects+runs(HasInstance+Named(prototype))) -> natural(boolean) ; Allocates reads(PrototypeLinks) throws ; runtime = InstanceOfAndCache ; branches = May
operation ToBoolean (value: Any/inspects, engine from Selected form: OperatorForm) -> natural(boolean) ; none ; runtime = ToBoolean ; proves = Truthiness ; branches = May ; interpreted = Test
operation LogicalNot (value: Boolean/inspects) -> natural(boolean) ; none
operation TypeOf (value: Any/inspects) -> natural(string) ; none ; runtime = TypeOf
operation ToString (value: Any/Converted, engine from Selected form: OperatorForm) -> natural(string) ; CreatesString by Operator ; runtime = ToString
operation Strcat (parts...: Any/Converted) [| engine isLikelyKey] -> natural(string) ; CreatesString ; runtime = Concatenate
operation ToPropertyKey (value: Any/Converted) -> natural(string | symbol) ; CreatesString ; runtime = ToKey
operation ToObject (value: Any/returns, message?: String) -> natural(object) ; Allocates throws ; runtime = ToObject
operation ToThis (value: Any/returns) -> natural(object) ; Allocates ; runtime = ToThis

family Cast AsRead..Placed
operation Upcast (value: Any/returns, castType: Type) -> cast(castType) ; none ; interpreted = Cast
operation Claim (value: Any/returns, castType: Type, site?: TypeSite, engine cause: CheckCause) -> cast(castType) ; throws ; runtime = EnforceType ; interpreted = Cast
operation ClaimDeclared (value: Any/returns, declared: DeclaredType) -> natural(same(value)) ; throws ; AsRead..AsRead ; removedBy = TypeValues
operation ClaimRead (value: Any/returns, receiver: Any/inspects, source: ClaimSource, site?: TypeSite) -> natural(same(value)) ; throws ; AsRead..AsRead ; removedBy = TypeValues
operation Predict (value: Any/returns, predicted: Type) -> natural(same(value)) ; none ; AsRead..Prepared ; interpreted = Cast
engine operation AssumeType (value: Any/returns, castType: Type) -> cast(castType) ; none ; Prepared..Placed ; interpreted = Cast
engine operation ReportMismatch (value: Any/inspects, expectedType: Type, site?: TypeSite) -> none ; writes(ExternalState) throws ; runtime = ReportMismatch
operation CheckInitialized (value: Any/returns, name: String) -> cast ; throws ; interpreted = Cast
operation RequireObjectCoercible (value: Any/returns, nullishAccess: NullishAccess, name?: String) -> cast ; throws ; interpreted = Cast
operation RequireObject (value: Any/returns, runtimeError: RuntimeErrorKind) -> cast ; throws ; interpreted = Cast
operation TypeTest (value: Any/inspects, testedType: Type) -> natural(boolean) ; none ; proves = TestedType ; branches = May ; interpreted = Test

family Call AsRead..Placed
operation Call (callee: Any/calls, thisValue?: Any/retains, arguments...: Any/retains, calleeKey?: PropertyKey, calleeName?: String, expectedResult?: ExpectedResult, with CallStamp) [isAnnotatedPure isNeverInlined | engine isDemotedTailCall] -> unknown ; unknownCode by Call ; accessClass = IndirectCall
operation Construct (callee: Any/calls, newTarget?: Any/retains, arguments...: Any/retains, calleeName?: String, with CallStamp, engine allocatedLayout?: Layout) [isAnnotatedPure] -> natural(object) ; unknownCode by Call ; accessClass = IndirectCall ; runtime = Construct
operation CallList (callee: Any/calls, thisValue?: Any/retains, list: Array/Listed, calleeKey?: PropertyKey, calleeName?: String, expectedResult?: ExpectedResult, with CallStamp) [| engine isDemotedTailCall] -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; interpreted = List ; runtime = Apply
operation ConstructList (callee: Any/calls, newTarget?: Any/retains, list: Array/Listed, calleeName?: String, with CallStamp) -> natural(object) ; unknownCode by Call ; accessClass = IndirectCall ; interpreted = List ; runtime = ConstructWithArray
operation CallDirect (function: Function(Call), arguments...: Declared/retains, engine accessSite?: AccessSite, engine resultCheck: ResultCheck) [| engine isNeverInlined isAlwaysInlined isAfterInlinedHead isConstruction isDemotedTailCall] -> declared(function) ; unknownCode by Call ; accessClass = DirectCall
engine operation CallGroup (function: Function(Dispatch), closure: Callable/calls, arguments...: Declared/retains, with CallStamp) [isDemotedTailCall] -> declared(function) ; unknownCode by Call ; Prepared..Placed ; accessClass = IndirectCall
operation Results (values...: Declared/returns) -> results(..) ; none
operation ResultAt (results: Results/inspects, index: UInt32) -> declared(results) ; none ; interpreted = List

family Exception AsRead..Placed
operation CatchValue () -> unknown ; UsesRuntime ; runtime = Catch ; boundTo = Frame
operation CatchException () -> natural(Exception) ; UsesRuntime ; runtime = CatchException ; boundTo = Frame

family Hint AsRead..Placed
operation LoopHint () [| engine isVersioned] -> none ; UsesRuntime terminates collects ; runtime = PollSlow

family Control AsRead..Placed
terminator Jump () -> next ; none
terminator Branch (condition: Boolean/inspects) -> taken(proof), notTaken(proof) ; none
terminator Switch (subject: Any/inspects, cases: List<Int64>) -> case...(proof), otherwise ; none ; proves = CaseValue
terminator SwitchString (subject: Any/inspects, strings: List<String>) -> case...(proof), otherwise ; ResolvesRopes ; proves = CaseValue
terminator Return (value?: Declared/returns) -> none ; none
terminator ReturnCall (call: Any/returns, casts: List<TailCast>, engine requirement: TailCallRequirement) -> none ; none
terminator Throw (value: Any/retains) -> none ; throws
terminator Rethrow (exception: Exception/retains) -> none ; throws
terminator Unreachable () -> none ; none
