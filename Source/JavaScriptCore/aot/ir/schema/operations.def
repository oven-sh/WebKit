operation GetMappedArgument (arguments: Object/inspects, index: UInt32) -> unknown ; reads(Elements[Arguments]) ; runtime = GetMappedArgument ; interpreted = Read ; flow = Copies
operation SetMappedArgument (arguments: Object/inspects+writesContents, index: UInt32, value: Any/retains(arguments)) -> none ; writes(Elements[Arguments]) ; runtime = SetMappedArgument ; interpreted = Store ; runsOwnerBarrier = true ; remembersOwner = true ; flow = Copies

family Access AsRead..Placed
operation PropGet (object: Any/inspects, key: PropertyKey, with AccessStamp) [isFreeName isForTypeOf] -> unknown => declared(key) ; unknownCode by Access ; access = Read ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = GetByIdAndCache ; siteCaches = 1 ; flow = Copies
operation PropSet (object: Any/inspects, key: PropertyKey, mode: ECMAMode, value: Any/retains(object), with AccessStamp) [isFreeName] -> none ; unknownCode by Access ; access = Store ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = PutByIdAndCache ; siteCaches = 1 ; flow = Copies
operation PropDefine (object: Object/inspects, key: PropertyKey, value: Any/retains(object), with AccessStamp) -> none ; unknownCode by Access ; access = Define ; receiver = object ; stored = value ; interpreted = Store ; accessClass = ByName ; runtime = DefineById ; flow = Copies
operation PropHas (object: Any/inspects, key: PropertyKey, with AccessStamp) -> natural(boolean) ; unknownCode by Access ; access = Has ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByIdAndCache ; branches = May ; flow = TableProves
