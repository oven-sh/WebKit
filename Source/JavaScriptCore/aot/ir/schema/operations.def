operation ElemHas (object: Any/inspects, property: Any/Converted, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; interpreted = Test ; accessClass = ByName ; runtime = InByValAndCache ; branches = May ; flow = TableProves ; flowRule = Heap ; hasOwnFoldingRule = true ; form = Closed
operation ElemDelete (object: Any/inspects+deletesByKey, property: Any/Converted, mode: ECMAMode, with AccessStamp) [| engine keyIsIntegral] -> natural(boolean) ; unknownCode by Access ; receiver = object ; accessClass = ByName ; runtime = DeleteByVal ; flow = TableProves ; flowRule = Heap ; hasOwnFoldingRule = true ; form = Closed
