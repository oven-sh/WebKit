family Operator AsRead..Placed
operation Add (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Addition) ; CreatesString by Operator ; runtime = ValueAdd ; flow = TableProves
operation Sub (left: Any/Converted, right: Any/Converted, engine from Selected form: OperatorForm) -> natural(Arithmetic) ; Allocates throws by Operator ; runtime = ValueSub ; flow = TableProves
