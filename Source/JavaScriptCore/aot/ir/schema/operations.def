operation ElemGet (object: Any/inspects, property: Any/Converted, with AccessStamp, engine from Selected expectedElements: ExpectedElements) [| engine keyIsIntegral] -> unknown => declared(object) ; unknownCode by Access ; receiver = object ; interpreted = Read ; accessClass = ByName ; runtime = GetByValAndCache ; flow = Copies
