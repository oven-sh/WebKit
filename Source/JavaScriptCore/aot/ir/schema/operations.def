operation BigInt (digits: String) -> constant ; CreatesConstant ; runtime = BigIntConstant ; flow = TableProves
operation Builtin (builtin: Builtin) -> constant ; CreatesConstant ; runtime = BuiltinCell ; flow = TableProves
operation ModuleBuiltin (builtin: Builtin, module: Module(Referrer)) -> constant ; Allocates UsesRuntime throws ; runtime = ModuleBuiltinCell ; flow = TableProves
operation Data (data: Data, engine allocationSite?: AllocationSite, engine from Selected encoding: DataEncoding, engine from Placed request?: Request) -> constant ; Allocates throws ; runtime = NewFromData ; interpreted = Allocation ; flow = Allocates
operation NewClosure (function: Function(Closure), captures...: Declared/retains(result), with CellStamp, engine from Selected closureForm: ClosureForm) [| engine isMadeOnDemand isHeldByClosureTable isLent] -> constant ; Allocates ; runtime = NewClosureSlow ; interpreted = Allocation ; allocatesInline = true ; flow = Allocates
engine operation KeyConstant (key: PropertyKey) -> constant ; CreatesConstant ; runtime = KeyConstant ; flow = TableProves
operation Unspecified (valueType: Type) -> declared(valueType) ; none ; Prepared..Placed
operation EmptyArgumentList (valueType: Type) -> declared(valueType) ; none ; Prepared..Placed ; replaces = NewArray

family Binding AsRead..Placed
engine operation Parameter () -> declared ; none ; boundTo = Function ; flow = Copies
operation GetModuleVariable (variable: Variable) -> declared(variable) ; reads(ModuleVariables[variable]) ; flow = Copies
