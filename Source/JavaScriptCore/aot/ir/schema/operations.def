family Hint AsRead..Placed
operation LoopHint () [| engine isVersioned] -> none ; UsesRuntime terminates collects ; runtime = PollSlow ; flow = TableProves

family Control AsRead..Placed
terminator Jump () -> next ; none
terminator Branch (condition: Boolean/inspects) -> taken(proof), notTaken(proof) ; none
terminator Switch (subject: Any/inspects, cases: List<Int64>) -> case...(proof), otherwise ; none ; proves = CaseValue
terminator SwitchString (subject: Any/inspects, strings: List<String>) -> case...(proof), otherwise ; ResolvesRopes ; proves = CaseValue
terminator Return (value?: Declared/returns) -> none ; none
terminator ReturnCall (call: Any/returns, casts: List<TailCast>, engine requirement: TailCallRequirement) -> none ; none
terminator Throw (value: Any/retains) -> none ; throws
terminator Rethrow (exception: Exception/retains) -> none ; throws
terminator Unreachable () -> none ; none
