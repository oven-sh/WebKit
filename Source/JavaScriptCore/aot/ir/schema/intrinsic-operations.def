operation HasJSType (value: Any/inspects, first: CheckedJSType, last: CheckedJSType) -> natural(boolean) ; none ; branches = May ; flow = Checks ; hasOwnFoldingRule = true
operation FindsDeclaredMember (object: Any/inspects, key: PropertyKey, with AccessStamp) -> natural(boolean) ; reads(MemberGuards) ; access = Has ; receiver = object ; branches = May ; flow = TableProves
operation GetInternalField (object: Object/inspects, index: UInt32) -> unknown ; reads(InternalFields, PromiseState, CollectionStorage) ; flow = Copies ; flowRule = Heap ; hasOwnFoldingRule = true ; interpreted = Read
operation PutInternalField (object: Object/inspects+writesContents, index: UInt32, value: Any/retains(object)+returns) -> natural(same(value)) ; writes(InternalFields, PromiseState, CollectionStorage) ; runsOwnerBarrier = true ; remembersOwner = true ; flow = Copies ; flowRule = Heap ; interpreted = Store

family PromiseIntrinsic AsRead..Placed ; isIntrinsic = true
operation NewPromise (engine allocationSite?: AllocationSite) -> allocation(Promise) ; Allocates ; runtime = NewPromise ; interpreted = Allocation ; allocatesInline = true ; allocatesAfterLastSafepoint = true ; replaces = CallBuiltin ; flow = Allocates
