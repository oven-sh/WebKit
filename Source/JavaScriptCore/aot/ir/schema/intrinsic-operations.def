operation ToLength (value: Any/Converted) -> natural(number) ; ResolvesRopes by Operator ; runtime = ToLength ; flow = TableProves
operation ThrowNewError (errorKind: ErrorKind, message: String, engine throwPosition?: UInt32) -> natural(never) ; Allocates UsesRuntime throws ; runtime = ThrowAtSite ; replaces = CallBuiltin, Throw ; flow = TableProves
operation ResumeGenerator (generator: Any/inspects+calls, resumeMode: ResumeMode, value: Any/retains) -> unknown ; unknownCode ; runtime = ResumeGenerator ; flow = Copies ; flowRule = Generator
operation StepGenerator (generator: Any/inspects+calls, resumeMode: ResumeMode, value: Any/retains, check: GeneratorStepCheck) -> results(StepGeneratorResult: unknown, natural(GeneratorStepStatus)) ; unknownCode ; flow = Copies ; flowRule = Generator
operation IsGeneratorSuspendedAtStart (generator: Any/inspects) -> natural(boolean) ; reads(InternalFields) ; runtime = IsGeneratorSuspendedAtStart ; flow = TableProves
operation IsUnmodifiedGenerator (value: Any/inspects) -> natural(boolean) ; reads(NamedProperties, PrototypeLinks) ; proves = UnmodifiedGenerator ; branches = May ; flow = TableProves
operation CreateIteratorResult (value: Any/retains(result), done: Boolean/inspects, engine allocationSite?: AllocationSite) -> allocation(IteratorResult) ; Allocates ; AsRead..AsRead ; removedBy = ResolveBuiltins ; flow = Allocates ; flowRule = Heap
operation StepArrayIterator (iterator: Object/inspects+readsContents+writesContents) -> results(StepArrayIteratorResult: natural(boolean), unknown) ; unknownCode ; AsRead..AsRead ; removedBy = ExpandIteration ; flow = Copies ; flowRule = StepOfLibrary

family RuntimeIntrinsic AsRead..Placed ; isIntrinsic = true
operation RequireBuiltinModule (runtimeModule: RuntimeModule) -> unknown ; unknownCode ; runtime = RequireBuiltinModule ; flow = Copies ; flowRule = Module
operation NativeBinding (builtin: Builtin) -> unknown ; Allocates UsesRuntime throws ; runtime = NativeBinding ; flow = Unsound ; flowRule = Module
