enum GeneratorStepCheck { IsUnmodifiedGenerator IsGenerator | engine IsUnmodified None }
enum GeneratorStepStatus { Yielded Completed NotStepped }
enum StepGeneratorResult { | engine Value Status }
enum StepArrayIteratorResult { | engine Done Value }
enum MapNextResult { | engine HasEntry Entry Key Value }
enum SetNextResult { | engine HasEntry Entry Element }

family EngineIntrinsic AsRead..Placed ; isIntrinsic = true
operation IsConstructor (value: Any/inspects) -> natural(boolean) ; none ; runtime = IsConstructor ; flow = TableProves
operation ArraySpeciesCreate (length: Number/inspects, array: Any/inspects+runs(Species)) -> unknown ; Allocates throws ; runtime = ArraySpeciesCreate ; flow = Copies
operation GetByValWithThis (object: Any/retains, thisValue: Any/retains, property: Any/Converted) -> unknown ; unknownCode ; runtime = GetByValWithThis ; flow = Copies ; flowRule = Heap
