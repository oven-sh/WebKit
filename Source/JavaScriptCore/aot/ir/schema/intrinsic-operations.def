operation NewArrayWithCapacity (length: Integer/inspects, source?: Any/inspects, engine allocationSite?: AllocationSite, engine arrayStorage: ArrayStorage) -> allocation(Array) ; Allocates reads(ArrayStorage) throws ; runtime = NewArrayWithHoles ; allocatesInline = true ; flow = Allocates
operation TryPutByValDirect (array: Array/inspects+writesContents, position: Integer/inspects, value: Any/retains(array), engine arrayStorage: ArrayStorage) -> natural(boolean) ; reads(ArrayStorage) writes(Elements[Array]) ; runsOwnerBarrier = true ; flow = TableProves ; flowRule = Heap
operation TryPutIndex (array: Array/inspects+writesContents, position: Integer/inspects, value: Any/retains(array)) -> natural(boolean) ; reads(ArrayStorage) writes(ArrayStorage, Elements[Array]) ; runsOwnerBarrier = true ; flow = TableProves ; flowRule = Heap
operation TryPutDoubleIndex (array: Array/inspects+writesContents, position: Integer/inspects, value: Number/inspects) -> natural(boolean) ; reads(ArrayStorage) writes(Elements[Array]) ; flow = TableProves ; flowRule = Heap
operation GrowNewArray (array: Array/inspects+writesContents, length: Integer/inspects) -> none ; GrowsArray ; runtime = GrowNewArray ; flow = Copies ; flowRule = Heap
operation TruncateNewArray (array: Array/inspects+returns+writesContents, length: Integer/inspects) -> allocation(Array) ; GrowsArray ; runtime = TruncateNewArray ; flow = Copies ; flowRule = Heap

family CollectionIntrinsic AsRead..Placed ; isIntrinsic = true
operation CollectionTable (collection: Object/inspects) -> unknown ; reads(CollectionStorage) ; flow = Copies
operation MapNext (map: Object/inspects+readsContents, table: Any/inspects, entry: Integer/inspects) -> results(MapNextResult: natural(boolean), natural(int[0, 2147483647]), unknown => declared(map), unknown => declared(map)) ; CreatesConstant reads(CollectionStorage, CollectionEntries) writes(CollectionStorage) ; runtime = MapNext ; flow = Copies ; flowRule = StepOfLibrary
operation SetNext (set: Object/inspects+readsContents, table: Any/inspects, entry: Integer/inspects) -> results(SetNextResult: natural(boolean), natural(int[0, 2147483647]), unknown => declared(set)) ; CreatesConstant reads(CollectionStorage, CollectionEntries) writes(CollectionStorage) ; runtime = SetNext ; flow = Copies ; flowRule = StepOfLibrary
