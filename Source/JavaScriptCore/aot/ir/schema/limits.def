    ClosureAllocationSites(BuildImage, BitWidth, BuildError, 16777216, 16777216, "allocation field of a closure request")
    ImageFunctions(BuildImage, BitWidth, BuildError, 2097136, 2097136, "function bits of a closure word")
    CodeBytes(BuildImage, BitWidth, BuildError, 4294967296, 2147483648, "code offsets in image tables, and rel32 on x86-64")
