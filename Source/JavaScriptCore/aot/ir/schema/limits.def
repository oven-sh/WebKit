    ClosureAllocationSites(BuildImage, BitWidth, BuildError, 16777216, 16777216, "places that create closures")
    ImageFunctions(BuildImage, BitWidth, BuildError, 2097136, 2097136, "functions in a program")
    CodeBytes(BuildImage, BitWidth, BuildError, 4294967296, 2147483648, "machine code size")
