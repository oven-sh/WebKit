    MaxEvalBindingDepth(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, 0, "scope depth visible to a direct eval")
    MaxEvalBindingOffset(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, 0, "variables visible to a direct eval")
    MaxListedStrings(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, 0, "string constants in a program")
