    MaxValuesScannedForExecutedLoad(GenerateCode, CompileTime, NotOptimized, 512, 512, "compile time of loop versioning")
    MaxSourcesOfLoopTest(GenerateCode, CompileTime, NotOptimized, 16, 16, "compile time of loop versioning")
    MaxRangeCheckBoundsPerLoop(GenerateCode, CodeSize, NotOptimized, 4, 4, "entry guards per loop")
    MaxCopiedValuesPerRotatedLoop(GenerateCode, CodeSize, NotOptimized, 12, 12, "code size of a rotated loop")
    MaxRareBlocksPerRotatedLoop(GenerateCode, CodeSize, NotOptimized, 8, 8, "code size of a rotated loop")
    MaxThreadedTestCopyCost(GenerateCode, CodeSize, NotOptimized, 8, 8, "code size of jump threading")
    MaxThreadedPathCost(GenerateCode, CodeSize, NotOptimized, 16, 16, "code size of jump threading")
    MaxBlocksOnThreadedPath(GenerateCode, CodeSize, NotOptimized, 8, 8, "code size of jump threading")
    MaxThreadedTestDepth(GenerateCode, CodeSize, NotOptimized, 8, 8, "code size of jump threading")
    MaxPredecessorsForConditionQueries(GenerateCode, CompileTime, NotOptimized, 8, 8, "compile time of dominating conditions")
    MaxConditionQueriesPerBlock(GenerateCode, CompileTime, NotOptimized, 32, 32, "compile time of dominating conditions")
    MaxSelectNestingDepth(GenerateCode, CodeSize, NotOptimized, 1, 1, "work done on the path not taken")
    MaxSpeculatedValuesPerSelect(GenerateCode, CodeSize, NotOptimized, 4, 4, "work done on the path not taken")
