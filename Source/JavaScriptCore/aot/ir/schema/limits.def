enum Stage {
    Any Load BindModules Check Lower LinkAndEmit ReadAndVerify AnalyzeFlow Optimize PlanSlots Select NumberAndEncode ChooseRepresentations GenerateCode
    BuildImage RunTime
}
enum Protects { CompileTime CodeSize BitWidth Memory }
enum DegradesTo {
    BuildError NotOptimized WiderType DeclaredType GenericPath SharedInstance LayoutObject HeapAllocation OutOfLineStorage OrdinaryObject HashedTable
    CallByOperation Interpreter FewerThreads RuntimeError
}

enum LimitID (stage: Stage, protects: Protects, degradesTo: DegradesTo, valueOnARM64: UInt64, valueOnX86_64: UInt64, smallest: UInt64, purpose: Text) {
    None(Any, CompileTime, NotOptimized, 0, 0, 0, "")
    All(Any, CompileTime, NotOptimized, 4294967295, 4294967295, 0, "every limit that can be lowered, each to no less than its smallest value")

    MaxFoldedStringBytes(Load, Memory, NotOptimized, 65536, 65536, 0, "the length of a constant-folded string")
    MaxComputedSpecifierCandidates(Load, CompileTime, GenericPath, 1024, 1024, 0, "modules a dynamic import path can match")
    MaxVariablesFollowedToLoader(Load, CompileTime, NotOptimized, 4, 4, 0, "variables that hand the name of a built-in module on to one another")
    MaxParametersFollowedToLoader(Load, CompileTime, NotOptimized, 4, 4, 0, "parameters that hand the name of a built-in module on to one another")
    MaxProgramsPerBuild(Load, CompileTime, NotOptimized, 128, 128, 0, "entry points that are each compiled as a program of their own")
    MaxRepeatedSourceBytes(Load, CodeSize, NotOptimized, 262144, 262144, 0, "bytes of source text that entry points compiled on their own have in common")
    MaxRepeatedSourcePercent(Load, CodeSize, NotOptimized, 5, 5, 0, "percent of the source text that entry points compiled on their own have in common")
    MaxDataNodes(Load, Memory, BuildError, 16777216, 16777216, 0, "values in a data module or macro result")
    MaxDataNestingDepth(Lower, Memory, BuildError, 2000, 2000, 0, "how deeply the values of a data module or macro result can be nested")
    MaxTypeNodes(Lower, CompileTime, WiderType, 65536, 65536, 0, "the size of one TypeScript type")
    MaxExpectedResultLayouts(Lower, CompileTime, WiderType, 256, 256, 0, "object types reachable from one call's declared result type")
    MaxSupertypePairs(Lower, CompileTime, GenericPath, 4096, 4096, 0, "type pairs compared for one conversion")
    MaxInferenceNodes(Lower, CompileTime, WiderType, 4096, 4096, 0, "expressions visited to infer a type from how a value is used")
    MaxStepsToPrintedInitializer(Lower, CompileTime, NotOptimized, 256, 256, 1, "expressions and declarations looked at to find where a stack trace places the call of a variable that is used once")
    MaxCaptures(Lower, BitWidth, HeapAllocation, 255, 255, 255, "variables a closure captures")
    MaxHandlerArguments(Lower, CompileTime, HeapAllocation, 16384, 16384, 0, "variables that one try stores, times its stores")
    MaxHandlerArgumentsPerBlock(Lower, CompileTime, HeapAllocation, 16, 16, 0, "variables that a try with any number of stores may store")
    MaxProgramIds(LinkAndEmit, BitWidth, BuildError, 4294967294, 4294967294, 0, "ids in a program")

    MaxLayoutsInType(Any, CompileTime, WiderType, 1024, 1024, 3, "object shapes in one inferred type")
    MaxLiteralsInType(Any, CompileTime, WiderType, 1024, 1024, 3, "string literals in one inferred type")
    MaxSymbolLiteralsInType(Any, CompileTime, WiderType, 256, 256, 0, "symbols in one inferred type")
    MaxClassesInType(Any, CompileTime, WiderType, 64, 64, 3, "built-in classes in one inferred type")
    MaxFunctionsInType(Any, CompileTime, WiderType, 1024, 1024, 3, "functions in one inferred type")
    MaxBuiltinsInType(Any, CompileTime, WiderType, 256, 256, 0, "built-in objects in one inferred type")
    MaxRegExpLiteralsInType(Any, CompileTime, WiderType, 64, 64, 0, "regular expression literals in one inferred type")
    MaxWorkers(Any, BitWidth, FewerThreads, 2047, 2047, 0, "compiler threads")
    MaxInt32ProofWork(ReadAndVerify, CompileTime, NotOptimized, 10000, 10000, 0, "values visited to explain an unproven int32")
    MaxTypeValuesRounds(ReadAndVerify, CompileTime, WiderType, 64, 64, 64, "type inference passes over one function")

    MaxEscapeAnalysisWork(Optimize, CompileTime, HeapAllocation, 4194304, 4194304, 0, "escape analysis work per function")
    MaxUseEffectHistoryBits(Optimize, Memory, HeapAllocation, 67108864, 67108864, 0, "escape analysis memory per function")
    MaxGuardAvailabilityWork(Optimize, CompileTime, GenericPath, 1048576, 1048576, 0, "guard elimination work per function")
    MaxBlocksForDominatorSelfCheck(Any, CompileTime, NotOptimized, 2048, 2048, 0, "the size of a function whose dominators are double-checked")

    MaxValueFlowSetMembers(AnalyzeFlow, CompileTime, DeclaredType, 16777216, 16777216, 16777216, "shapes and callees tracked per value")
    MaxValueFlowMembersToldApart(AnalyzeFlow, CompileTime, NotOptimized, 64, 64, 0, "receivers of a method call or names of a computed key looked at one by one")
    MaxValueFlowObjectsListedByMember(AnalyzeFlow, CompileTime, NotOptimized, 1024, 1024, 1024, "objects of one receiver that whole-program analysis links one by one")
    MaxObjectsOfTypedResult(AnalyzeFlow, CompileTime, GenericPath, 256, 256, 0, "object and array types reachable from the type that one call parses by")
    MaxAppendedFieldsPerLayout(AnalyzeFlow, Memory, OutOfLineStorage, 96, 96, 0, "properties added to an object type after creation")

    MaxOptimizationRounds(Optimize, CompileTime, NotOptimized, 8, 8, 0, "optimization passes over a function")
    MaxOptimizationWork(Optimize, CompileTime, NotOptimized, 50000000, 50000000, 0, "values walked by the optimization passes over a function")
    MaxSinkingRounds(Optimize, CompileTime, HeapAllocation, 8, 8, 0, "allocation removal passes")
    MaxSinkingWork(Optimize, CompileTime, HeapAllocation, 131072, 131072, 0, "allocation removal work per function")
    MaxAccessPlanMembers(Optimize, CompileTime, GenericPath, 1024, 1024, 0, "possible receiver shapes at one property access")
    MaxDispatchCases(Optimize, CodeSize, GenericPath, 4, 4, 0, "shapes or callees tested inline at one site")
    MaxDeclarationsPredictedFromNames(Optimize, CodeSize, GenericPath, 4, 4, 0, "object types guessed from the property names used on a value")
    MaxExpandedDataNodes(Optimize, CodeSize, CallByOperation, 16, 16, 0, "values in a constant that is built inline")
    MaxArrayLiteralBatch(Optimize, CompileTime, NotOptimized, 32, 32, 16, "elements stored per step of a long array literal")
    MaxBlocksSearchedForLiteralStores(Optimize, CompileTime, NotOptimized, 256, 256, 0, "blocks searched to move an array allocation earlier")
    MaxOutlinedOperands(Optimize, CodeSize, NotOptimized, 6, 6, 0, "register arguments of outlined cold code")
    MaxOutlinedRegionValues(Optimize, CompileTime, NotOptimized, 16, 16, 0, "the size of cold code compared for outlining")
    MaxForwardingDepth(Optimize, CompileTime, NotOptimized, 4, 4, 0, "calls in a row that only forward another call's result")
    MaxPromotedParameters(Optimize, CodeSize, HeapAllocation, 6, 6, 0, "fields of an object parameter passed in registers")
    MaxParameterWrapperValues(Optimize, CodeSize, NotOptimized, 24, 24, 0, "the size of a wrapper that unpacks an object parameter")
    MaxValuesInCalleeVersion(Optimize, CodeSize, NotOptimized, 250, 250, 0, "the size of a function that is copied for a callback passed to it")
    MaxBytesOfCalleeVersions(Optimize, CodeSize, NotOptimized, 48000, 48000, 0, "what the copies of one function for the callbacks passed to it take in all")

    MaxTestedTypesPerFunction(Optimize, CompileTime, GenericPath, 256, 256, 0, "guard placement work per function")
    MaxGuardEliminationRounds(Optimize, CompileTime, NotOptimized, 8, 8, 0, "guard elimination passes")
    MaxClonedBytesPerStretch(Optimize, CodeSize, GenericPath, 512, 512, 0, "code size of one fast path")
    MaxBlocksInGenericVersion(Optimize, CodeSize, GenericPath, 16384, 16384, 0, "blocks in a function's slow-path copy")
    MaxBlocksCopiedBehindStretches(Optimize, CodeSize, GenericPath, 128, 128, 0, "blocks copied for slow paths per guard placement pass")
    MaxBytesOfSeparatedLoop(Optimize, CodeSize, GenericPath, 4096, 4096, 0, "code size of a loop that gets a separate slow-path copy")
    MaxSeparatedLoopsPerFunction(Optimize, CodeSize, GenericPath, 8, 8, 0, "loops per function that get a separate slow-path copy")
    MaxTurnsOfUnrolledLoop(Optimize, CodeSize, NotOptimized, 8, 8, 0, "turns of a loop whose turns are written out one behind the other")
    MaxBytesOfUnrolledLoop(Optimize, CodeSize, NotOptimized, 2048, 2048, 0, "code size of all the turns of a loop that are written out")
    MaxUnrolledLoopsPerFunction(Optimize, CodeSize, NotOptimized, 8, 8, 0, "loops per function whose turns are written out")
    MaxFusedConcatenationParts(Optimize, CodeSize, NotOptimized, 256, 256, 0, "operands in a fused string concatenation")
    MaxBlocksBetweenFusedConcatenations(Optimize, CompileTime, NotOptimized, 16, 16, 0, "blocks between the parts of a fused string concatenation")
    MaxReservedStackArguments(Optimize, BitWidth, BuildError, 65535, 65535, 0, "stack arguments of a call")
    MaxArgumentRegisters(Optimize, BitWidth, NotOptimized, 8, 8, 8, "arguments passed in registers")

    MaxThreadedBlockValues(Optimize, CodeSize, NotOptimized, 8, 8, 0, "code duplicated per threaded jump")
    MaxThreadingReachabilitySteps(Optimize, CompileTime, NotOptimized, 128, 128, 0, "blocks walked to keep loops intact while threading jumps")
    MaxValuesMergedAgainBelowThreadedJumps(Optimize, CodeSize, NotOptimized, 32, 32, 0, "values that every join below a row of threaded jumps merges again")
    MaxReadsPerSolve(Optimize, Memory, NotOptimized, 4096, 4096, 0, "redundant read elimination memory per function")
    MaxMergedReadPredecessors(Optimize, CodeSize, NotOptimized, 4, 4, 0, "predecessors merged to remove a repeated read")
    MaxVirtualObjectFields(Optimize, Memory, HeapAllocation, 64, 64, 0, "fields of an object that can be removed or stack-allocated")
    MaxVirtualObjectVariants(Optimize, CodeSize, HeapAllocation, 8, 8, 0, "shapes of a removed or stack-allocated object at a merge")
    MaxVirtualArrayLength(Optimize, Memory, HeapAllocation, 16, 16, 0, "elements of an array that can be removed")
    MaxMaterializations(Optimize, CodeSize, HeapAllocation, 2, 2, 0, "places one removed allocation may be re-created")
    MaxDuplicatedTailValues(Optimize, CodeSize, HeapAllocation, 200, 200, 0, "code duplicated to remove an allocation")
    MaxCounterStep(Optimize, CompileTime, NotOptimized, 1024, 1024, 0, "the step of a loop counter kept as an integer")
    MaxIntegerRelationSteps(Optimize, CompileTime, NotOptimized, 64, 64, 0, "work per integer range query")
    MaxFrameEnvironmentFields(Optimize, Memory, HeapAllocation, 32, 32, 0, "variables of a stack-allocated closure environment")
    MaxFrameArrayLength(Optimize, Memory, HeapAllocation, 8, 8, 0, "elements of a stack-allocated array")
    MaxSuspensionsCrossedOnStack(Optimize, CompileTime, HeapAllocation, 16, 16, 0, "awaits and yields that a value lives across in the stack frame")
    MaxValuesOnStackAcrossSuspension(Optimize, Memory, HeapAllocation, 256, 256, 0, "values that live across one await or yield in the stack frame")

    MaxInlineDepth(Optimize, CodeSize, NotOptimized, 4, 4, 0, "nesting of inlined calls")
    MaxInlinedCallerBytes(Optimize, CodeSize, NotOptimized, 4096, 4096, 0, "the size of a function after inlining")
    MaxInlineHeadBytes(Optimize, CodeSize, NotOptimized, 48, 48, 0, "the size of an inlined fast-path prefix")
    MaxSelectedHeadOperations(Select, CodeSize, NotOptimized, 24, 24, 0, "operations of a function copied in front of a hot call of it")
    MaxSelectedHeadBlocks(Select, CodeSize, NotOptimized, 8, 8, 0, "blocks of a function copied in front of a hot call of it")
    MaxFusedGeneratorBytes(Optimize, CodeSize, NotOptimized, 1600, 1600, 0, "the size of a generator whose body is merged into the loop that iterates it")
    InlineBudgetColdBytes(Optimize, CodeSize, NotOptimized, 0, 0, 0, "inlining budget at a cold call site")
    InlineBudgetWarmBytes(Optimize, CodeSize, NotOptimized, 80, 80, 0, "inlining budget at a warm call site")
    InlineBudgetHotBytes(Optimize, CodeSize, NotOptimized, 320, 320, 0, "inlining budget at a hot call site")
    InlineBudgetOnlyCallBytes(Optimize, CodeSize, NotOptimized, 448, 448, 0, "inlining budget at the only call site of a function, in a loop of its caller")
    MaxHotCodeValues(Optimize, CodeSize, NotOptimized, 1048576, 1048576, 0, "operations treated as hot, program-wide")
    MaxWarmCodeValues(Optimize, CodeSize, NotOptimized, 1048576, 1048576, 0, "operations treated as warm or hot, program-wide")
    InlineSunkAllocationBytes(Optimize, CodeSize, NotOptimized, 160, 160, 0, "inlining credit for an allocation it removes")
    InlineCycleWeight(Optimize, CodeSize, NotOptimized, 4, 4, 0, "inlining weight of a call site in a loop")
    MaxConditionChainLength(Optimize, CompileTime, NotOptimized, 8, 8, 0, "conditions followed to estimate what inlining folds")
    MaxInlineNesting(Optimize, CompileTime, NotOptimized, 32, 32, 0, "nesting of inlined calls, also of those that add no code")
    MaxFusedArrayCapacity(Optimize, Memory, NotOptimized, 268435456, 268435456, 0, "capacity of the array built by a fused map or filter chain")
    MinAppendsForStringBuilder(Optimize, CodeSize, NotOptimized, 4, 4, 0, "appends needed before a string builder pays off")
    MaxStringWebsPerFunction(Optimize, CompileTime, NotOptimized, 64, 64, 0, "strings built by appending, analyzed per function")
    MaxParserPlanNodes(Optimize, CompileTime, GenericPath, 65536, 65536, 0, "the size of a type compiled into a JSON parser")
    MaxParsedObjectMembers(Optimize, CodeSize, GenericPath, 64, 64, 0, "properties per object in a compiled parser")
    MaxExpandedKeyOrders(Optimize, CodeSize, CallByOperation, 4, 4, 0, "property orders tested inline by one Object.keys or for...in loop")
    MaxExpandedKeyFields(Optimize, CodeSize, CallByOperation, 48, 48, 0, "properties per order tested inline by one Object.keys or for...in loop")
    MaxVersionedIterationBytes(Optimize, CodeSize, NotOptimized, 1024, 1024, 0, "code duplicated to specialize a loop per kind of iterable")
    MaxDestructuredElements(Optimize, CodeSize, GenericPath, 8, 8, 0, "elements read by one array destructuring")
    MinRequestedJSONCapacity(Optimize, CodeSize, NotOptimized, 128, 128, 0, "bytes under which JSON buffer reservations are merged")
    MaxJSONLayoutSetMembers(Optimize, CodeSize, CallByOperation, 8, 8, 0, "object shapes a compiled JSON.stringify tests per value")
    MaxBuiltinCallArguments(Optimize, BitWidth, GenericPath, 254, 254, 254, "arguments of a built-in call")
    MaxPlannedArrayCapacity(Optimize, Memory, NotOptimized, 100000, 100000, 0, "capacity reserved when an array is created")

    MaxSelectionGroupSpan(Select, CompileTime, NotOptimized, 32, 32, 0, "distance between operations fused into a group")
    MaxSelectionGroupMembers(Select, CodeSize, NotOptimized, 16, 16, 1, "operations fused into a group")
    MaxNumberPathValues(Select, CodeSize, NotOptimized, 12, 12, 0, "code duplicated to keep an integer fast path")
    MinByIdsPerRun(Select, CodeSize, NotOptimized, 3, 3, 0, "property accesses needed before they are batched")
    MinSwitchCases(Select, CodeSize, NotOptimized, 3, 3, 0, "cases needed before a switch gets a jump table")
    MaxSwitchStringCases(Select, CodeSize, NotOptimized, 128, 128, 0, "cases in a switch over strings")
    MaxSwitchCases(Select, CodeSize, NotOptimized, 1024, 1024, 0, "cases in a switch over integers")
    MaxInlineArrayLiteralLength(Select, CodeSize, CallByOperation, 16, 16, 0, "elements of an array literal stored inline")
    MaxInlineSpliceInsertions(Select, CodeSize, CallByOperation, 2, 2, 0, "elements inserted by an inline splice")
    MaxInlineConcatOperands(Select, CodeSize, CallByOperation, 3, 3, 0, "operands of an inline concat")
    MaxInlinePushOperands(Select, CodeSize, CallByOperation, 8, 8, 0, "operands of an inline push")
    MaxKeyParts(Select, CodeSize, NotOptimized, 8, 8, 0, "parts of a concatenated key that is looked up without creating the string")
    MaxInlineTypedArrayCopyLength(Select, CodeSize, CallByOperation, 512, 512, 0, "typed array elements copied inline")
    MaxInlineClearedElements(Select, CodeSize, CallByOperation, 64, 64, 0, "elements cleared inline")
    MaxInlineSearchedElements(Select, CodeSize, CallByOperation, 16, 16, 0, "elements compared inline by includes or indexOf")
    MaxInlineStringCompareLength(Select, CodeSize, CallByOperation, 32, 32, 0, "characters compared inline")
    MaxRegisterStringLength(Select, BitWidth, CallByOperation, 8, 8, 0, "characters of a string constant held in a register")
    MaxLengthCopiedInline(Select, CodeSize, CallByOperation, 16, 16, 0, "characters copied inline")

    FieldsInKeyOrder(PlanSlots, BitWidth, OutOfLineStorage, 4095, 4095, 4095, "properties per object type")
    KeyOrdersPerLayout(NumberAndEncode, BitWidth, OutOfLineStorage, 4096, 4096, 4096, "property orders per object type")
    MaxShapes(NumberAndEncode, BitWidth, BuildError, 2147483647, 2147483647, 0, "object shapes in a program")
    MaxShapeSetBits(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, 0, "the size of the shape test tables")
    MaxIdentifiers(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, 0, "property names in a program")
    MaxFieldOffset(PlanSlots, BitWidth, BuildError, 16777216, 16777216, 0, "object size")
    MaxExtensionGranules(PlanSlots, BitWidth, NotOptimized, 64, 64, 0, "out-of-line storage per object")
    MaxStaticsSize(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, 0, "the size of a program's static data")
    MaxSiteCaches(NumberAndEncode, Memory, HashedTable, 1048576, 1048576, 0, "inline caches in a program (hottest sites first)")
    MaxGlobalBindings(NumberAndEncode, Memory, GenericPath, 4096, 4096, 0, "global names with a binding record")
    MaxGuardBitsPerClassSide(NumberAndEncode, Memory, GenericPath, 4096, 4096, 0, "guarded members per class")
