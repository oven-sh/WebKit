    MaxValuesSearchedForDominatingLoad(GenerateCode, CompileTime, NotOptimized, 16, 16, "compile time of branch to select conversion")
    MaxLoopsLeftBySinking(GenerateCode, CompileTime, NotOptimized, 8, 8, "compile time of sinking")
    MaxHoistedLoadsPerLoop(GenerateCode, CodeSize, NotOptimized, 8, 8, "register pressure in a loop")
