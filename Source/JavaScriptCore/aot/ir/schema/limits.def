    MaxClonedValuesPerExcursion(GenerateCode, CodeSize, NotOptimized, 128, 128, "code size of rare blocks copied with a loop")
    MaxValuesScannedForExecutedLoad(GenerateCode, CompileTime, NotOptimized, 512, 512, "loop specialization work")
    MaxSourcesOfLoopTest(GenerateCode, CompileTime, NotOptimized, 16, 16, "loop specialization work")
    MaxRangeCheckBoundsPerLoop(GenerateCode, CodeSize, NotOptimized, 4, 4, "entry guards per loop")
    MaxCopiedValuesPerRotatedLoop(GenerateCode, CodeSize, NotOptimized, 12, 12, "code size of a rotated loop")
    MaxRareBlocksPerRotatedLoop(GenerateCode, CodeSize, NotOptimized, 8, 8, "code size of a rotated loop")
    MaxThreadedTestCopyCost(GenerateCode, CodeSize, NotOptimized, 8, 8, "code duplicated by jump threading")
    MaxThreadedPathCost(GenerateCode, CodeSize, NotOptimized, 16, 16, "code duplicated by jump threading")
    MaxBlocksOnThreadedPath(GenerateCode, CodeSize, NotOptimized, 8, 8, "code duplicated by jump threading")
    MaxThreadedTestDepth(GenerateCode, CodeSize, NotOptimized, 8, 8, "code duplicated by jump threading")
    MaxPredecessorsForConditionQueries(GenerateCode, CompileTime, NotOptimized, 8, 8, "branch condition analysis work")
    MaxConditionQueriesPerBlock(GenerateCode, CompileTime, NotOptimized, 32, 32, "branch condition analysis work")
    MaxSelectNestingDepth(GenerateCode, CodeSize, NotOptimized, 1, 1, "work speculated on the untaken path")
    MaxSpeculatedValuesPerSelect(GenerateCode, CodeSize, NotOptimized, 4, 4, "work speculated on the untaken path")
