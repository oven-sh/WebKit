enum Stage {
    Any Load BindModules Check Lower LinkAndEmit ReadAndVerify AnalyzeFlow Optimize PlanSlots Select NumberAndEncode ChooseRepresentations GenerateCode
    BuildImage RunTime
}
enum Protects { CompileTime CodeSize BitWidth Memory }
enum DegradesTo {
    BuildError NotOptimized WiderType DeclaredType GenericPath SharedInstance LayoutObject HeapAllocation OutOfLineStorage OrdinaryObject HashedTable
    CallByOperation Interpreter FewerThreads RuntimeError
}

enum LimitID (stage: Stage, protects: Protects, degradesTo: DegradesTo, valueOnARM64: UInt64, valueOnX86_64: UInt64, smallest: UInt64, purpose: Text) {
    None(Any, CompileTime, NotOptimized, 0, 0, 0, "")
    All(Any, CompileTime, NotOptimized, 4294967295, 4294967295, 0, "every limit that can be lowered, each to no less than its smallest value")

    MaxFoldedStringBytes(Load, Memory, NotOptimized, 65536, 65536, 0, "the length of a constant-folded string")
    MaxDataNodes(Load, Memory, BuildError, 16777216, 16777216, 0, "values in a data module or macro result")
    MaxDataNestingDepth(Lower, Memory, BuildError, 2000, 2000, 0, "how deeply the values of a data module or macro result can be nested")
    MaxTypeNodes(Lower, CompileTime, WiderType, 65536, 65536, 0, "the size of one TypeScript type")
    MaxExpectedResultLayouts(Lower, CompileTime, WiderType, 256, 256, 0, "object types reachable from one call's declared result type")
    MaxInferenceNodes(Lower, CompileTime, WiderType, 4096, 4096, 0, "parts taken over from how other values are used to infer a type from how a value is used")
    MaxTermsReadForProduct(Lower, CompileTime, WiderType, 16, 16, 0, "terms of one sum, read for a product among them, which may leave the range of a small integer")
    MaxDeclaredSignatureDepth(Lower, CompileTime, WiderType, 3, 3, 0, "how deep the members that a file's own declaration file declares are paired with what the file writes")
    MaxConstructorParentsFollowed(Lower, CompileTime, GenericPath, 64, 64, 0, "constructor functions that stand above one another by their prototypes, followed to see that the chain ends")
    MaxFunctionsGivenThis(Lower, CompileTime, GenericPath, 32, 32, 0, "functions that a constructor function hands its object to, read for the fields that they store")
    MaxCaptures(Lower, BitWidth, HeapAllocation, 255, 255, 255, "variables a closure captures")
    MaxProgramIds(LinkAndEmit, BitWidth, BuildError, 4294967294, 4294967294, 0, "ids in a program")
    MaxWorkers(Any, BitWidth, FewerThreads, 2047, 2047, 0, "compiler threads")
    MaxReservedStackArguments(Optimize, BitWidth, BuildError, 65535, 65535, 0, "stack arguments of a call")
    MaxBuiltinCallArguments(Optimize, BitWidth, GenericPath, 254, 254, 254, "arguments of a built-in call")
    MaxNumberPathValues(Select, CodeSize, NotOptimized, 12, 12, 0, "code duplicated to keep an integer fast path")
    MaxRegisterStringLength(Select, BitWidth, CallByOperation, 8, 8, 0, "characters of a string constant held in a register")

    FieldsInKeyOrder(PlanSlots, BitWidth, OutOfLineStorage, 4095, 4095, 4095, "properties per object type")
    KeyOrdersPerLayout(NumberAndEncode, BitWidth, OutOfLineStorage, 4096, 4096, 4096, "property orders per object type")
    MaxShapeSetBits(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, 0, "the size of the shape test tables")
    MaxIdentifiers(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, 0, "property names in a program")
    MaxFieldOffset(PlanSlots, BitWidth, BuildError, 16777216, 16777216, 0, "object size")
    MaxStaticsSize(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, 0, "the size of a program's static data")
    MaxPropertyListNames(NumberAndEncode, BitWidth, CallByOperation, 65535, 65535, 0, "properties set by a batched store")
    MaxEvalBindingDepth(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, 0, "scope depth visible to a direct eval")
    MaxEvalBindingOffset(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, 0, "variables visible to a direct eval")
    MaxListedStrings(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, 0, "string constants in a program")

    MaxFrameSizeInBytes(GenerateCode, BitWidth, BuildError, 1048560, 1048560, 0, "stack frame size")
    MaxFrameMapRoots(GenerateCode, BitWidth, BuildError, 65535, 65535, 0, "live references across an await or yield")
    MaxFrameMapWords(GenerateCode, BitWidth, BuildError, 262144, 262144, 0, "what one function keeps across all its awaits and yields together")

    ClosureAllocationSites(BuildImage, BitWidth, BuildError, 16777216, 16777216, 0, "places that create closures")
    ImageFunctions(BuildImage, BitWidth, BuildError, 16777215, 16777215, 0, "functions in a program, with the copies and entry points that the compiler makes")
    ImageClosureFunctions(BuildImage, BitWidth, BuildError, 4128752, 4128752, 0, "functions in a program that are used as values")
    CodeBytes(BuildImage, BitWidth, BuildError, 4294967296, 2147483648, 0, "machine code size")
    SitesPerFunction(BuildImage, BitWidth, BuildError, 8388607, 8388607, 0, "call and throw sites per function")
    InlineFramesPerFunction(BuildImage, BitWidth, NotOptimized, 16777215, 16777215, 16777215, "inlined calls per function")
    TableBytes(BuildImage, BitWidth, BuildError, 4294967296, 4294967296, 0, "data table size")
    VectorBytes(Any, BitWidth, BuildError, 2147483647, 2147483647, 0, "the size of a compiler table")
    RegExpSectionSize(BuildImage, BitWidth, Interpreter, 4294967295, 4294967295, 4294967295, "total compiled regular expression size")
    RegExpClassTableClusterSize(BuildImage, BitWidth, NotOptimized, 98304, 98304, 0, "distance from regular expression code to its character class tables")
    WasmImageCodeSize(BuildImage, BitWidth, Interpreter, 2147483647, 2147483647, 0, "compiled code per WebAssembly module")

    LookupTableNames(RunTime, BitWidth, HashedTable, 65534, 65534, 0, "property names in the fast lookup table")
}
