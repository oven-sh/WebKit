enum Stage {
    Any Load BindModules Check Lower LinkAndEmit ReadAndVerify AnalyzeFlow Optimize PlanSlots Select NumberAndEncode ChooseRepresentations GenerateCode
    BuildImage RunTime
}
enum Protects { CompileTime CodeSize BitWidth Memory }
enum DegradesTo {
    BuildError NotOptimized WiderType DeclaredType GenericPath SharedInstance LayoutObject HeapAllocation OutOfLineStorage OrdinaryObject HashedTable
    CallByOperation Interpreter FewerThreads RuntimeError
}

enum LimitID (stage: Stage, protects: Protects, degradesTo: DegradesTo, valueOnARM64: UInt64, valueOnX86_64: UInt64, purpose: Text) {
    None(Any, CompileTime, NotOptimized, 0, 0, "")

    MaxFoldedStringBytes(Load, Memory, NotOptimized, 65536, 65536, "the length of a constant-folded string")
    MaxComputedSpecifierCandidates(Load, CompileTime, GenericPath, 1024, 1024, "modules a dynamic import path can match")
    MaxDataNodes(Load, Memory, BuildError, 16777216, 16777216, "values in a data module or macro result")
    MaxNestingDepth(Lower, Memory, BuildError, 2000, 2000, "how deeply code can be nested")
    MaxTypeNodes(Lower, CompileTime, WiderType, 65536, 65536, "the size of one TypeScript type")
    MaxValidationNodes(Lower, CompileTime, BuildError, 65536, 65536, "the size of a type passed to validate<T> or JSON.parse<T>")
    MaxExpectedResultLayouts(Lower, CompileTime, WiderType, 256, 256, "object types reachable from one call's declared result type")
    MaxSupertypePairs(Lower, CompileTime, GenericPath, 4096, 4096, "type pairs compared for one conversion")
    MaxInferenceNodes(Lower, CompileTime, WiderType, 4096, 4096, "expressions visited to infer a type from how a value is used")
    MaxCaptures(Lower, BitWidth, HeapAllocation, 255, 255, "variables a closure captures")
    MaxProgramIds(LinkAndEmit, BitWidth, BuildError, 4294967294, 4294967294, "ids in a program")

    MaxLayoutsInType(Any, CompileTime, WiderType, 1024, 1024, "object shapes in one inferred type")
    MaxLiteralsInType(Any, CompileTime, WiderType, 1024, 1024, "string literals in one inferred type")
    MaxSymbolLiteralsInType(Any, CompileTime, WiderType, 256, 256, "symbols in one inferred type")
    MaxClassesInType(Any, CompileTime, WiderType, 64, 64, "built-in classes in one inferred type")
    MaxFunctionsInType(Any, CompileTime, WiderType, 1024, 1024, "functions in one inferred type")
    MaxBuiltinsInType(Any, CompileTime, WiderType, 256, 256, "built-in objects in one inferred type")
    MaxRegExpLiteralsInType(Any, CompileTime, WiderType, 64, 64, "regular expression literals in one inferred type")
    MaxWorkers(Any, BitWidth, FewerThreads, 2047, 2047, "compiler threads")
    MaxInt32ProofWork(ReadAndVerify, CompileTime, NotOptimized, 10000, 10000, "values visited to explain an unproven int32")
    MaxTypeValuesRounds(ReadAndVerify, CompileTime, WiderType, 64, 64, "type inference passes over one function")

    MaxEscapeAnalysisWork(Optimize, CompileTime, HeapAllocation, 4194304, 4194304, "escape analysis work per function")
    MaxUseEffectHistoryBits(Optimize, Memory, HeapAllocation, 67108864, 67108864, "escape analysis memory per function")
    MaxGuardAvailabilityWork(Optimize, CompileTime, GenericPath, 1048576, 1048576, "guard elimination work per function")
    MaxBlocksForDominatorSelfCheck(Any, CompileTime, NotOptimized, 2048, 2048, "the size of a function whose dominators are double-checked")

    MaxValueFlowEdgesLogged(AnalyzeFlow, Memory, NotOptimized, 268435456, 268435456, "edges the analysis logs before it stops tracking sets that still change")
    MaxValueFlowSetMembers(AnalyzeFlow, CompileTime, DeclaredType, 16777216, 16777216, "shapes and callees tracked per value")
    MaxValueFlowMembersToldApart(AnalyzeFlow, CompileTime, NotOptimized, 64, 64, "receivers of a method call or names of a computed key looked at one by one")
    MaxAppendedFieldsPerLayout(AnalyzeFlow, Memory, OutOfLineStorage, 96, 96, "properties added to an object type after creation")

    MaxOptimizationRounds(Optimize, CompileTime, NotOptimized, 8, 8, "optimization passes over a function")
    MaxOptimizationWork(Optimize, CompileTime, NotOptimized, 50000000, 50000000, "values walked by the optimization passes over a function")
    MaxSinkingRounds(Optimize, CompileTime, HeapAllocation, 8, 8, "allocation removal passes")
    MaxSinkingWork(Optimize, CompileTime, HeapAllocation, 131072, 131072, "allocation removal work per function")
    MaxAccessPlanMembers(Optimize, CompileTime, GenericPath, 1024, 1024, "possible receiver shapes at one property access")
    MaxDispatchCases(Optimize, CodeSize, GenericPath, 4, 4, "shapes or callees tested inline at one site")
    MaxDeclarationsPredictedFromNames(Optimize, CodeSize, GenericPath, 4, 4, "object types guessed from the property names used on a value")
    MaxExpandedDataNodes(Optimize, CodeSize, CallByOperation, 16, 16, "values in a constant that is built inline")
    MaxArrayLiteralBatch(Optimize, CompileTime, NotOptimized, 32, 32, "elements stored per step of a long array literal")
    MaxBlocksSearchedForLiteralStores(Optimize, CompileTime, NotOptimized, 256, 256, "blocks searched to move an array allocation earlier")
    MaxOutlinedOperands(Optimize, CodeSize, NotOptimized, 6, 6, "register arguments of outlined cold code")
    MaxOutlinedRegionValues(Optimize, CompileTime, NotOptimized, 16, 16, "the size of cold code compared for outlining")
    MaxResultClones(Optimize, CodeSize, NotOptimized, 4, 4, "copies of a function, by how callers use its result")
    MaxForwardingDepth(Optimize, CompileTime, NotOptimized, 4, 4, "calls in a row that only forward another call's result")
    MaxPromotedParameters(Optimize, CodeSize, HeapAllocation, 6, 6, "fields of an object parameter passed in registers")
    MaxParameterWrapperValues(Optimize, CodeSize, NotOptimized, 24, 24, "the size of a wrapper that unpacks an object parameter")
    MaxValuesInCalleeVersion(Optimize, CodeSize, NotOptimized, 250, 250, "the size of a function that is copied for a callback passed to it")
    MaxBytesOfCalleeVersions(Optimize, CodeSize, NotOptimized, 48000, 48000, "what the copies of one function for the callbacks passed to it take in all")

    MaxTestedTypesPerFunction(Optimize, CompileTime, GenericPath, 256, 256, "guard placement work per function")
    MaxGuardEliminationRounds(Optimize, CompileTime, NotOptimized, 8, 8, "guard elimination passes")
    MaxClonedBytesPerStretch(Optimize, CodeSize, GenericPath, 512, 512, "code size of one fast path")
    MaxBlocksInGenericVersion(Optimize, CodeSize, GenericPath, 16384, 16384, "blocks in a function's slow-path copy")
    MaxGenericVersionJoinWork(Optimize, CompileTime, GenericPath, 67108864, 67108864, "work to join a function's slow-path copy with its fast path")
    MaxBlocksCopiedBehindStretches(Optimize, CodeSize, GenericPath, 128, 128, "blocks copied for slow paths per guard placement pass")
    MaxBytesOfSeparatedLoop(Optimize, CodeSize, GenericPath, 4096, 4096, "code size of a loop that gets a separate slow-path copy")
    MaxSeparatedLoopsPerFunction(Optimize, CodeSize, GenericPath, 8, 8, "loops per function that get a separate slow-path copy")
    MaxFusedConcatenationParts(Optimize, CodeSize, NotOptimized, 256, 256, "operands in a fused string concatenation")
    MaxBlocksBetweenFusedConcatenations(Optimize, CompileTime, NotOptimized, 16, 16, "blocks between the parts of a fused string concatenation")
    MaxReservedStackArguments(Optimize, BitWidth, BuildError, 65535, 65535, "stack arguments of a call")
    MaxArgumentRegisters(Optimize, BitWidth, NotOptimized, 8, 8, "arguments passed in registers")

    MaxThreadedBlockValues(Optimize, CodeSize, NotOptimized, 8, 8, "code duplicated per threaded jump")
    MaxThreadingReachabilitySteps(Optimize, CompileTime, NotOptimized, 128, 128, "blocks walked to keep loops intact while threading jumps")
    MaxReadsPerSolve(Optimize, Memory, NotOptimized, 4096, 4096, "redundant read elimination memory per function")
    MaxMergedReadPredecessors(Optimize, CodeSize, NotOptimized, 4, 4, "predecessors merged to remove a repeated read")
    MaxVirtualObjectFields(Optimize, Memory, HeapAllocation, 64, 64, "fields of an object that can be removed or stack-allocated")
    MaxVirtualObjectVariants(Optimize, CodeSize, HeapAllocation, 8, 8, "shapes of a removed or stack-allocated object at a merge")
    MaxVirtualArrayLength(Optimize, Memory, HeapAllocation, 16, 16, "elements of an array that can be removed")
    MaxMaterializations(Optimize, CodeSize, HeapAllocation, 2, 2, "places one removed allocation may be re-created")
    MaxDuplicatedTailValues(Optimize, CodeSize, HeapAllocation, 200, 200, "code duplicated to remove an allocation")
    MaxCounterStep(Optimize, CompileTime, NotOptimized, 1024, 1024, "the step of a loop counter kept as an integer")
    MaxIntegerRelationSteps(Optimize, CompileTime, NotOptimized, 64, 64, "work per integer range query")
    MaxFrameEnvironmentFields(Optimize, Memory, HeapAllocation, 32, 32, "variables of a stack-allocated closure environment")
    MaxFrameArrayLength(Optimize, Memory, HeapAllocation, 8, 8, "elements of a stack-allocated array")

    MaxInlineDepth(Optimize, CodeSize, NotOptimized, 4, 4, "nesting of inlined calls")
    MaxInlinedCallerBytes(Optimize, CodeSize, NotOptimized, 4096, 4096, "the size of a function after inlining")
    MaxInlineHeadBytes(Optimize, CodeSize, NotOptimized, 48, 48, "the size of an inlined fast-path prefix")
    MaxSelectedHeadOperations(Select, CodeSize, NotOptimized, 24, 24, "operations of a function copied in front of a hot call of it")
    MaxSelectedHeadBlocks(Select, CodeSize, NotOptimized, 8, 8, "blocks of a function copied in front of a hot call of it")
    MaxOnlyCallSiteBytes(Optimize, CodeSize, NotOptimized, 1600, 1600, "the size of a function inlined into its only call site")
    InlineBudgetColdBytes(Optimize, CodeSize, NotOptimized, 0, 0, "inlining budget at a cold call site")
    InlineBudgetWarmBytes(Optimize, CodeSize, NotOptimized, 80, 80, "inlining budget at a warm call site")
    InlineBudgetHotBytes(Optimize, CodeSize, NotOptimized, 320, 320, "inlining budget at a hot call site")
    MaxHotCodeValues(Optimize, CodeSize, NotOptimized, 1048576, 1048576, "operations treated as hot, program-wide")
    MaxWarmCodeValues(Optimize, CodeSize, NotOptimized, 1048576, 1048576, "operations treated as warm or hot, program-wide")
    InlineSunkAllocationBytes(Optimize, CodeSize, NotOptimized, 160, 160, "inlining credit for an allocation it removes")
    InlineCycleWeight(Optimize, CodeSize, NotOptimized, 4, 4, "inlining weight of a call site in a loop")
    MaxConditionChainLength(Optimize, CompileTime, NotOptimized, 8, 8, "conditions followed to estimate what inlining folds")
    MaxFusedArrayCapacity(Optimize, Memory, NotOptimized, 268435456, 268435456, "capacity of the array built by a fused map or filter chain")
    MinAppendsForStringBuilder(Optimize, CodeSize, NotOptimized, 4, 4, "appends needed before a string builder pays off")
    MaxStringWebsPerFunction(Optimize, CompileTime, NotOptimized, 64, 64, "strings built by appending, analyzed per function")
    MaxParserPlanNodes(Optimize, CompileTime, GenericPath, 65536, 65536, "the size of a type compiled into a JSON.parse<T> parser")
    MaxParsedObjectMembers(Optimize, CodeSize, GenericPath, 64, 64, "properties per object in a compiled parser")
    MaxExpandedKeyOrders(Optimize, CodeSize, CallByOperation, 4, 4, "property orders tested inline by one Object.keys or for...in loop")
    MaxExpandedKeyFields(Optimize, CodeSize, CallByOperation, 48, 48, "properties per order tested inline by one Object.keys or for...in loop")
    MaxVersionedIterationBytes(Optimize, CodeSize, NotOptimized, 1024, 1024, "code duplicated to specialize a loop per kind of iterable")
    MaxDestructuredElements(Optimize, CodeSize, GenericPath, 8, 8, "elements read by one array destructuring")
    MinRequestedJSONCapacity(Optimize, CodeSize, NotOptimized, 128, 128, "bytes under which JSON buffer reservations are merged")
    MaxJSONLayoutSetMembers(Optimize, CodeSize, CallByOperation, 8, 8, "object shapes a compiled JSON.stringify tests per value")
    MaxBuiltinCallArguments(Optimize, BitWidth, GenericPath, 254, 254, "arguments of a built-in call")
    MaxPlannedArrayCapacity(Optimize, Memory, NotOptimized, 100000, 100000, "capacity reserved when an array is created")

    MaxSelectionGroupSpan(Select, CompileTime, NotOptimized, 32, 32, "distance between operations fused into a group")
    MaxSelectionGroupMembers(Select, CodeSize, NotOptimized, 16, 16, "operations fused into a group")
    MaxNumberPathValues(Select, CodeSize, NotOptimized, 12, 12, "code duplicated to keep an integer fast path")
    MinByIdsPerRun(Select, CodeSize, NotOptimized, 3, 3, "property accesses needed before they are batched")
    MinSwitchCases(Select, CodeSize, NotOptimized, 3, 3, "cases needed before a switch gets a jump table")
    MaxSwitchStringCases(Select, CodeSize, NotOptimized, 128, 128, "cases in a switch over strings")
    MaxSwitchCases(Select, CodeSize, NotOptimized, 1024, 1024, "cases in a switch over integers")
    MaxInlineArrayLiteralLength(Select, CodeSize, CallByOperation, 16, 16, "elements of an array literal stored inline")
    MaxInlineSpliceInsertions(Select, CodeSize, CallByOperation, 2, 2, "elements inserted by an inline splice")
    MaxInlineConcatOperands(Select, CodeSize, CallByOperation, 3, 3, "operands of an inline concat")
    MaxInlinePushOperands(Select, CodeSize, CallByOperation, 8, 8, "operands of an inline push")
    MaxKeyParts(Select, CodeSize, NotOptimized, 8, 8, "parts of a concatenated key that is looked up without creating the string")
    MaxInlineTypedArrayCopyLength(Select, CodeSize, CallByOperation, 512, 512, "typed array elements copied inline")
    MaxInlineClearedElements(Select, CodeSize, CallByOperation, 64, 64, "elements cleared inline")
    MaxInlineSearchedElements(Select, CodeSize, CallByOperation, 16, 16, "elements compared inline by includes or indexOf")
    MaxInlineStringCompareLength(Select, CodeSize, CallByOperation, 32, 32, "characters compared inline")
    MaxRegisterStringLength(Select, BitWidth, CallByOperation, 8, 8, "characters of a string constant held in a register")
    MaxLengthCopiedInline(Select, CodeSize, CallByOperation, 16, 16, "characters copied inline")

    FieldsInKeyOrder(PlanSlots, BitWidth, OutOfLineStorage, 4095, 4095, "properties per object type")
    KeyOrdersPerLayout(NumberAndEncode, BitWidth, OutOfLineStorage, 32767, 32767, "property orders per object type")
    MaxShapes(NumberAndEncode, BitWidth, BuildError, 2147483647, 2147483647, "object shapes in a program")
    MaxShapeSetBits(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, "the size of the shape test tables")
    MaxIdentifiers(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, "property names in a program")
    MaxFieldOffset(PlanSlots, BitWidth, BuildError, 16777216, 16777216, "object size")
    MaxExtensionGranules(PlanSlots, BitWidth, NotOptimized, 64, 64, "out-of-line storage per object")
    MaxStaticsSize(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, "the size of a program's static data")
    MaxSiteCaches(NumberAndEncode, Memory, HashedTable, 1048576, 1048576, "inline caches in a program (hottest sites first)")
    MaxGlobalBindings(NumberAndEncode, Memory, GenericPath, 4096, 4096, "global names with a binding record")
    MaxGuardBitsPerClassSide(NumberAndEncode, Memory, GenericPath, 4096, 4096, "guarded members per class")
    MaxPropertyListNames(NumberAndEncode, BitWidth, CallByOperation, 65535, 65535, "properties set by a batched store")
    MaxEvalBindingDepth(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, "scope depth visible to a direct eval")
    MaxEvalBindingOffset(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, "variables visible to a direct eval")
    MaxListedStrings(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, "string constants in a program")
    MaxLiteralStrings(NumberAndEncode, BitWidth, WiderType, 262144, 262144, "string literal types in a program")
    MaxComparedCharactersPerCharacter(NumberAndEncode, CompileTime, NotOptimized, 1024, 1024, "work to find strings inside other strings")
    MaxContractedModuleRequests(NumberAndEncode, Memory, NotOptimized, 8, 8, "modules listed in place of a module with nothing of its own to link or run")

    MaxFrameSizeInBytes(GenerateCode, BitWidth, BuildError, 1048560, 1048560, "stack frame size")
    MaxBarrierBlocks(GenerateCode, CompileTime, NotOptimized, 4096, 4096, "the size of a function whose write barriers are optimized")
    MaxFrameMapRoots(GenerateCode, BitWidth, BuildError, 65535, 65535, "live references across an await or yield")
    MaxLandingPadsSearched(GenerateCode, CompileTime, NotOptimized, 4, 4, "exception landing pads compared for sharing")

    MaxClonedValuesPerLoopVersion(GenerateCode, CodeSize, NotOptimized, 48, 48, "code size of a specialized loop copy")
    MaxValuesPerHotRegion(GenerateCode, CompileTime, NotOptimized, 96, 96, "loop specialization work")
    MaxBlocksScannedBeforeLoop(GenerateCode, CompileTime, NotOptimized, 4, 4, "loop specialization work")
