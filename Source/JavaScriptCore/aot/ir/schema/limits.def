    MaxComparedCharactersPerCharacter(NumberAndEncode, CompileTime, NotOptimized, 1024, 1024, 0, "work to find strings inside other strings")
    MaxContractedModuleRequests(NumberAndEncode, Memory, NotOptimized, 8, 8, 0, "modules listed in place of a module with nothing of its own to link or run")

    MaxFrameSizeInBytes(GenerateCode, BitWidth, BuildError, 1048560, 1048560, 0, "stack frame size")
