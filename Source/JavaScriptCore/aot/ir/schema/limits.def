enum Stage {
    Any Load BindModules Check Lower LinkAndEmit ReadAndVerify AnalyzeFlow Optimize PlanSlots Select NumberAndEncode ChooseRepresentations GenerateCode
    BuildImage RunTime
}
enum Protects { CompileTime CodeSize BitWidth Memory }
enum DegradesTo {
    BuildError NotOptimized WiderType DeclaredType GenericPath SharedInstance LayoutObject HeapAllocation OutOfLineStorage OrdinaryObject HashedTable
    CallByOperation Interpreter FewerThreads RuntimeError
}

enum LimitID (stage: Stage, protects: Protects, degradesTo: DegradesTo, valueOnARM64: UInt64, valueOnX86_64: UInt64, purpose: Text) {
    None(Any, CompileTime, NotOptimized, 0, 0, "")

    MaxFoldedStringBytes(Load, Memory, NotOptimized, 65536, 65536, "length of a string that constant folding computes")
    MaxComputedSpecifierCandidates(Load, CompileTime, GenericPath, 1024, 1024, "modules one computed specifier can name")
    MaxDataNodes(Load, Memory, BuildError, 16777216, 16777216, "values of one data module or macro result")
    MaxNestingDepth(Lower, Memory, BuildError, 2000, 2000, "stack of a lowering task")
    MaxTypeNodes(Lower, CompileTime, WiderType, 65536, 65536, "time to map one checker type")
    MaxValidationNodes(Lower, CompileTime, BuildError, 65536, 65536, "nodes of the type one call validates against")
    MaxExpectedResultLayouts(Lower, CompileTime, WiderType, 256, 256, "layouts that the written result type of one call reaches")
    MaxSupertypePairs(Lower, CompileTime, GenericPath, 4096, 4096, "pairs of types one flow into a declared position compares")
    MaxCaptures(Lower, BitWidth, HeapAllocation, 255, 255, "captures of a closure")
    MaxProgramIds(LinkAndEmit, BitWidth, BuildError, 4294967294, 4294967294, "32-bit ids of a program")

    MaxLayoutsInType(Any, CompileTime, WiderType, 1024, 1024, "layouts a join inside a fixpoint keeps in one type")
    MaxLiteralsInType(Any, CompileTime, WiderType, 1024, 1024, "string literals a join inside a fixpoint keeps in one type")
    MaxSymbolLiteralsInType(Any, CompileTime, WiderType, 256, 256, "symbols a join inside a fixpoint keeps in one type")
    MaxClassesInType(Any, CompileTime, WiderType, 64, 64, "built-in classes a join inside a fixpoint keeps in one type")
    MaxFunctionsInType(Any, CompileTime, WiderType, 1024, 1024, "functions a join inside a fixpoint keeps in one type")
    MaxBuiltinsInType(Any, CompileTime, WiderType, 256, 256, "built-in objects a join inside a fixpoint keeps in one type")
    MaxRegExpLiteralsInType(Any, CompileTime, WiderType, 64, 64, "regular expression literals a join inside a fixpoint keeps in one type")
    MaxWorkers(Any, BitWidth, FewerThreads, 2047, 2047, "threads of one build, storages of one interning phase")
    MaxInt32ProofWork(ReadAndVerify, CompileTime, NotOptimized, 10000, 10000, "values visited to name the reason of one unproven int32")
    MaxTypeValuesRounds(ReadAndVerify, CompileTime, WiderType, 64, 64, "rounds of typing one function")

    MaxEscapeAnalysisWork(Optimize, CompileTime, HeapAllocation, 4194304, 4194304, "value and object pairs of one points-to solve")
    MaxUseEffectHistoryBits(Optimize, Memory, HeapAllocation, 67108864, 67108864, "memory of blocks times objects")
    MaxGuardAvailabilityWork(Optimize, CompileTime, GenericPath, 1048576, 1048576, "blocks times guards of one availability solve")
    MaxBlocksForDominatorSelfCheck(Any, CompileTime, NotOptimized, 2048, 2048, "the quadratic self check of dominators")

    MaxFlowWorkPerFunction(AnalyzeFlow, CompileTime, DeclaredType, 1048576, 1048576, "worklist steps one function may cause")
    MaxFlowInstances(AnalyzeFlow, Memory, SharedInstance, 262144, 262144, "call-site instances of the program")
    MaxValueFlowEdgesLogged(AnalyzeFlow, Memory, NotOptimized, 268435456, 268435456, "edges that the rules of one solve of the value flow log")
    MaxValueFlowCopiedNodesPercent(AnalyzeFlow, CompileTime, SharedInstance, 0, 0, "nodes of bodies copied into call sites, in percent of the nodes of all bodies")
    MaxFlowInstanceValues(AnalyzeFlow, CompileTime, SharedInstance, 64, 64, "values of a function that gets an instance per call site")
    MaxNestedCallSiteInstances(AnalyzeFlow, CompileTime, SharedInstance, 2, 2, "call-site instances under one another")
    MaxNestedInstancesOfNewObjects(AnalyzeFlow, CompileTime, SharedInstance, 8, 8, "call-site instances under one another where each function hands up an object that was just allocated")
    MaxSitesPerLayout(AnalyzeFlow, Memory, LayoutObject, 1024, 1024, "allocation sites of one layout")
    MaxAppendedFieldsPerLayout(AnalyzeFlow, Memory, OutOfLineStorage, 64, 64, "names flow appends to one layout as optional fields")
    MaxDerivedLayoutsPerFamily(AnalyzeFlow, Memory, OutOfLineStorage, 1024, 1024, "layouts derived from one declared layout")
    MaxCallSiteVersionValues(AnalyzeFlow, CodeSize, SharedInstance, 262144, 262144, "values of all the versions of functions that allocate for several callers")
    MaxPositionalParts(AnalyzeFlow, Memory, WiderType, 8, 8, "positions of a short list that have a part of their own")
    MaxFlowRangeGrowth(AnalyzeFlow, CompileTime, WiderType, 8, 8, "times one arithmetic result may grow its range")
    MaxEscapedObjectsBesideUnknown(AnalyzeFlow, CompileTime, GenericPath, 8, 8, "escaped objects that a set lists beside the unknown object, which stands for all of them")
    MaxGenericVersionGrowthPercent(AnalyzeFlow, CodeSize, GenericPath, 10, 10, "code size added by generic versions")
    MinNarrowedUsesForGenericVersion(AnalyzeFlow, CodeSize, GenericPath, 2, 2, "uses that must gain before a function gets a generic version")

    MaxOptimizationRounds(Optimize, CompileTime, NotOptimized, 8, 8, "rounds of a fixpoint of a schedule")
    MaxSinkingRounds(Optimize, CompileTime, HeapAllocation, 8, 8, "rounds of allocation sinking")
    MaxAccessPlanMembers(Optimize, CompileTime, GenericPath, 1024, 1024, "members of the receiver set of one property access plan")
    MaxDispatchCases(Optimize, CodeSize, GenericPath, 4, 4, "arms of one dispatch over a receiver set")
    MaxDeclarationsPredictedFromNames(Optimize, CodeSize, GenericPath, 1, 1, "declarations of one name among the layouts that the names asked of a value predict")
    MaxExpandedDataNodes(Optimize, CodeSize, CallByOperation, 16, 16, "nodes of a constant that expands to allocations")
    MaxArrayLiteralBatch(Optimize, CompileTime, NotOptimized, 32, 32, "values live at one array allocation")
    MaxBlocksSearchedForLiteralStores(Optimize, CompileTime, NotOptimized, 256, 256, "blocks searched for the place of an early array allocation")
    MaxOutlinedOperands(Optimize, CodeSize, NotOptimized, 6, 6, "arguments of an outlined body in registers")
    MaxOutlinedRegionValues(Optimize, CompileTime, NotOptimized, 16, 16, "time of comparing outlining sites")
    MaxResultClones(Optimize, CodeSize, NotOptimized, 4, 4, "clones of a function by how its result is used")
    MaxForwardingDepth(Optimize, CompileTime, NotOptimized, 4, 4, "chains of result forwarders")
    MaxPromotedParameters(Optimize, CodeSize, HeapAllocation, 6, 6, "fields of an aggregate parameter passed in registers")
    MaxParameterWrapperValues(Optimize, CodeSize, NotOptimized, 24, 24, "values of a parameter wrapper")

    MaxTestedTypesPerFunction(Optimize, CompileTime, GenericPath, 256, 256, "blocks times tested types of the test placement dataflow")
    MaxGuardEliminationRounds(Optimize, CompileTime, NotOptimized, 8, 8, "rounds of assuming that redundant tests pass")
    MaxClonedBytesPerStretch(Optimize, CodeSize, GenericPath, 512, 512, "code size of one guarded stretch")
    MaxBytesOfSeparatedLoop(Optimize, CodeSize, GenericPath, 4096, 4096, "code size of a loop that gets a copy for its unlikely paths")
    MaxSeparatedLoopsPerFunction(Optimize, CodeSize, GenericPath, 8, 8, "loops of one function that get a copy for their unlikely paths")
    MaxLoopVersions(Optimize, CodeSize, GenericPath, 3, 3, "versions of one loop for the parts of a union")
    MaxContinuationsPerFunction(Optimize, CodeSize, NotOptimized, 16, 16, "code size of a split function")
    MaxContinuationSizePercent(Optimize, CodeSize, NotOptimized, 150, 150, "size of all continuations against the function they split")
    MaxFusedConcatenationParts(Optimize, CodeSize, NotOptimized, 256, 256, "operands of one concatenation")
    MaxReservedStackArguments(Optimize, BitWidth, BuildError, 65535, 65535, "stack argument field of a calling convention")
    MaxArgumentRegisters(Optimize, BitWidth, NotOptimized, 8, 8, "integer registers of the direct convention")

    MaxThreadedBlockValues(Optimize, CodeSize, NotOptimized, 8, 8, "values evaluated again per threaded edge")
    MaxThreadingReachabilitySteps(Optimize, CompileTime, NotOptimized, 128, 128, "walk that keeps loop headers when threading")
    MaxReadsPerSolve(Optimize, Memory, NotOptimized, 4096, 4096, "memory of blocks times reads")
    MaxMergedReadPredecessors(Optimize, CodeSize, NotOptimized, 4, 4, "block parameters added for one read")
    MaxVirtualObjectFields(Optimize, Memory, HeapAllocation, 64, 64, "fields in use of one sinking candidate")
    MaxVirtualObjectVariants(Optimize, CodeSize, HeapAllocation, 8, 8, "shapes of one virtual object at a merge")
    MaxVirtualArrayLength(Optimize, Memory, HeapAllocation, 16, 16, "elements of a virtual array")
    MaxMaterializations(Optimize, CodeSize, HeapAllocation, 2, 2, "copies of one sunk allocation")
    MaxDuplicatedTailValues(Optimize, CodeSize, HeapAllocation, 200, 200, "code size of a tail duplicated for sinking")
    MaxCounterStep(Optimize, CompileTime, NotOptimized, 1024, 1024, "range arithmetic of a counter")
    MaxIntegerRelationSteps(Optimize, CompileTime, NotOptimized, 64, 64, "time of one integer relation query")
    MaxFrameEnvironmentFields(Optimize, Memory, HeapAllocation, 32, 32, "frame size of an environment in the frame")

    MaxInlineDepth(Optimize, CodeSize, NotOptimized, 4, 4, "nesting of inlined calls")
    MaxInlinedCallerBytes(Optimize, CodeSize, NotOptimized, 32768, 32768, "size of a caller after inlining")
    MaxInlineHeadBytes(Optimize, CodeSize, NotOptimized, 48, 48, "size of an inlined head")
    MaxOnlyCallSiteBytes(Optimize, CodeSize, NotOptimized, 1600, 1600, "size of a callee inlined into its only call site")
    InlineBudgetColdBytes(Optimize, CodeSize, NotOptimized, 56, 56, "inlining budget of a cold site")
    InlineBudgetWarmBytes(Optimize, CodeSize, NotOptimized, 104, 104, "inlining budget of a warm site")
    InlineBudgetHotBytes(Optimize, CodeSize, NotOptimized, 320, 320, "inlining budget of a hot site")
    MaxHotCodeValues(Optimize, CodeSize, NotOptimized, 1048576, 1048576, "operations of a program that count as hot")
    InlineSunkAllocationBytes(Optimize, CodeSize, NotOptimized, 160, 160, "benefit of an allocation that inlining lets sink")
    InlineCycleWeight(Optimize, CodeSize, NotOptimized, 4, 4, "weight of a site in a cycle")
    MaxConditionChainLength(Optimize, CompileTime, NotOptimized, 8, 8, "conditions followed for one inlining benefit")
    MaxFusedArrayCapacity(Optimize, Memory, NotOptimized, 268435456, 268435456, "capacity of the array a fused chain allocates")
    MinAppendsForStringBuilder(Optimize, CodeSize, NotOptimized, 4, 4, "appends that pay for a string builder")
    MaxStringWebsPerFunction(Optimize, CompileTime, NotOptimized, 64, 64, "string webs analyzed per function")
    MaxParserPlanNodes(Optimize, CompileTime, GenericPath, 65536, 65536, "nodes of the plan of one typed result")
    MaxParsedObjectMembers(Optimize, CodeSize, GenericPath, 64, 64, "members of an object that a typed parser reads into a layout")
    MaxExpandedKeyOrders(Optimize, CodeSize, CallByOperation, 4, 4, "key orders one expanded walk over own keys tests")
    MaxExpandedKeyFields(Optimize, CodeSize, CallByOperation, 48, 48, "fields of one arm of an expanded walk over own keys")
    MaxVersionedIterationBytes(Optimize, CodeSize, NotOptimized, 1024, 1024, "code duplicated to give each form of an iterable its own copy")
    MaxDestructuredElements(Optimize, CodeSize, GenericPath, 8, 8, "results of one destructuring read")
    MinRequestedJSONCapacity(Optimize, CodeSize, NotOptimized, 128, 128, "bytes below which capacity requests are merged")
    MaxJSONLayoutSetMembers(Optimize, CodeSize, CallByOperation, 4, 4, "layouts a serializer tests for one value")
    MaxBuiltinCallArguments(Optimize, BitWidth, GenericPath, 254, 254, "operand positions of a built-in call")
    MaxPlannedArrayCapacity(Optimize, Memory, NotOptimized, 100000, 100000, "capacity planned for an array at its allocation")

    MaxSelectionGroupSpan(Select, CompileTime, NotOptimized, 32, 32, "values between the first member and the root of a group")
    MaxSelectionGroupMembers(Select, CodeSize, NotOptimized, 16, 16, "operands of one grouped operation")
    MaxNumberPathValues(Select, CodeSize, NotOptimized, 12, 12, "values copied to keep the integer path of a number apart")
    MinByIdsPerRun(Select, CodeSize, NotOptimized, 3, 3, "accesses that pay for a property run")
    MinSwitchCases(Select, CodeSize, NotOptimized, 3, 3, "cases that pay for a jump table")
    MaxSwitchStringCases(Select, CodeSize, NotOptimized, 128, 128, "cases of one switch over strings")
    MaxSwitchCases(Select, CodeSize, NotOptimized, 1024, 1024, "cases of one switch over integers")
    MaxInlineArrayLiteralLength(Select, CodeSize, CallByOperation, 16, 16, "elements of an array literal stored inline")
    MaxInlineSpliceInsertions(Select, CodeSize, CallByOperation, 2, 2, "elements an inline splice inserts")
    MaxInlineConcatOperands(Select, CodeSize, CallByOperation, 3, 3, "operands of an inline concat")
    MaxInlinePushOperands(Select, CodeSize, CallByOperation, 8, 8, "operands of an inline push")
    MaxInlineTypedArrayCopyLength(Select, CodeSize, CallByOperation, 512, 512, "elements copied without a call")
    MaxInlineClearedElements(Select, CodeSize, CallByOperation, 64, 64, "elements cleared without a call")
    MaxInlineStringCompareLength(Select, CodeSize, CallByOperation, 32, 32, "characters compared without a call")
    MaxRegisterStringLength(Select, BitWidth, CallByOperation, 8, 8, "characters of a string constant held in a register")
    MaxLengthCopiedInline(Select, CodeSize, CallByOperation, 16, 16, "characters copied without a call")

    FieldsInKeyOrder(PlanSlots, BitWidth, OutOfLineStorage, 4095, 4095, "count field of the order word")
    KeyOrdersPerLayout(NumberAndEncode, BitWidth, OutOfLineStorage, 65535, 65535, "order field of the order word")
    MaxShapes(NumberAndEncode, BitWidth, BuildError, 2147483647, 2147483647, "shape numbers in a shape word")
    MaxShapeSetBits(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, "bit set offset of a shape test")
    MaxIdentifiers(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, "identifier numbers in program tables")
    MaxFieldOffset(PlanSlots, BitWidth, BuildError, 16777216, 16777216, "offset field of a placed field")
    MaxExtensionGranules(PlanSlots, BitWidth, NotOptimized, 64, 64, "bits in the first word of an Extension")
    MaxStaticsSize(NumberAndEncode, BitWidth, BuildError, 4294967295, 4294967295, "32-bit offsets into the statics of an instance")
    MaxSiteCaches(NumberAndEncode, Memory, HashedTable, 1048576, 1048576, "site caches of an instance, given hottest first")
    MaxGuardBitsPerClassSide(NumberAndEncode, BitWidth, GenericPath, 64, 64, "member guards in the word of one class side")
    MaxPropertyListNames(NumberAndEncode, BitWidth, CallByOperation, 65535, 65535, "count field of a property list request")
    MaxEvalBindingDepth(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, "depth field of an eval binding")
    MaxEvalBindingOffset(NumberAndEncode, BitWidth, BuildError, 16777215, 16777215, "offset field of an eval binding")
    MaxListedStrings(NumberAndEncode, BitWidth, BuildError, 16777216, 16777216, "pair numbers in a string word")
    MaxLiteralStrings(NumberAndEncode, BitWidth, WiderType, 262144, 262144, "literal string numbers in a slot word")
    MaxComparedCharactersPerCharacter(NumberAndEncode, CompileTime, NotOptimized, 1024, 1024, "time of searching one string for the strings it contains")

    MaxFrameSizeInBytes(GenerateCode, BitWidth, BuildError, 1048560, 1048560, "frame size field of a frame record")
    MaxBarrierBlocks(GenerateCode, CompileTime, NotOptimized, 4096, 4096, "blocks of a function whose barriers are analyzed")
    MaxFrameMapRoots(GenerateCode, BitWidth, BuildError, 1024, 1024, "roots of one suspended frame")
    MaxLandingPadsSearched(GenerateCode, CompileTime, NotOptimized, 4, 4, "landing pads of one handler compared with a new argument list")

    MaxClonedValuesPerLoopVersion(GenerateCode, CodeSize, NotOptimized, 48, 48, "code size of a versioned loop")
