operation StringBuilderAppendValue (builder: StringBuilder/inspects, value: Any/inspects) -> none ; AppendsToBuilder ; runtime = StringBuilderAppend

family ResolvedCall Selected..Placed
operation ResolveCallTarget (callee: Any/inspects, argumentCount: UInt32) -> natural(CodeAddress) ; none
operation CallResolved (callee: Any/calls, target: CodeAddress/inspects, thisValue?: Any/retains, arguments...: Any/retains, calleeName?: String, with CallStamp) [isDemotedTailCall] -> unknown ; unknownCode by Call ; accessClass = IndirectCall ; replaces = Call
operation RegExpMatchLiteral (overload: BuiltinOverload, string: String/inspects, regExp?: Object/inspects, guard?: Guard/inspects, pattern: String, regExpFlags: RegExpFlags, matchForm: RegExpMatchForm, from Placed regExpRecord?: RegExpRecord) -> declared(overload) ; CreatesString reads(RegExpState) writes(RegExpState) ; relies = Pristine ; guarded = regExp ; replaces = CallBuiltin

family InlineBuiltin Selected..Placed ; replaces = CallBuiltin
operation CallInline (inlineBuiltin: InlineBuiltin, inlineParameters: List<UInt32>, overload: BuiltinOverload, receiver?: Any/retains+returns+calls, arguments...: Any/retains+returns+calls, accessSite?: AccessSite, allocationSite?: AllocationSite) [isDemotedTailCall] -> declared(overload) ; unknownCode by Inline ; accessClass = DirectCall
terminator TryCallInline (inlineBuiltin: InlineBuiltin, inlineParameters: List<UInt32>, overload: BuiltinOverload, receiver?: Any/retains+returns+calls, arguments...: Any/retains+returns+calls, accessSite?: AccessSite, allocationSite?: AllocationSite) -> done(declared(overload)), miss ; unknownCode by Inline ; accessClass = DirectCall

family Control Selected..Placed
terminator TestAndBranch (condition: Boolean/inspects) -> taken(proof), notTaken(proof) ; none ; replaces = Branch
