operation StringOrderToCharacter (string: String/inspects, codeUnit: UInt32) -> natural(int[-1, 1]) ; ResolvesRopes ; replaces = Less, LessEq, Greater, GreaterEq ; form = Open
# `length`: how long the subject is, and -1 for a subject that is no string. A comparison that is handed it asks it first, and looks into the subject only where that is as long as the text.
# `flat`: the flat string that was made of the subject. A comparison that is handed it reads the characters through it. The subject stays the operand that the outcome narrows.
# Handed neither (Always), a comparison asks in line for the atom of the text, and the stub answers for a subject that holds none: a rope, a piece of a longer string, a 16-bit string, a text that the program only stores. The listing has that form as longer than a call.
# A text that is compared anywhere is an atom wherever the image makes a cell of it (NumberSpace::AtomOfString), so another tag of the program is told apart by its address.
# In a loop the characters of a subject without an atom are read in line. The characters in line at every site: 121 bytes a site, 7.7 MB of the application's bodies and 17.2 MB over all roles (build 412).
# NOT MEASURED YET.
# Eq, StrictEq and SwitchString take the same code where an operand is a written text, and the loop is asked by the row of ValueEqualsLiteral.
operation StringEqualsLiteral (string: String/inspects, length?: Integer/inspects, flat?: String/inspects, literal: String) -> natural(boolean) ; reads(StringStorage) ; proves = Equality ; branches = May ; replaces = StrictEq, Eq ; runtime = StringEqualsLiteral ; formDependsOnLoop = true ; openUnder = EmptyLiteral, LengthOfSubject, FlatSubject ; closedUnder = Always, LiteralComparedByStub ; openIn = Loop
operation ValueEqualsLiteral (value: Any/inspects, length?: Integer/inspects, literal: String) -> natural(boolean) ; reads(StringStorage) ; proves = Equality ; branches = May ; replaces = StrictEq ; runtime = StringEqualsLiteral ; formDependsOnLoop = true ; openUnder = EmptyLiteral, LengthOfSubject ; closedUnder = Always, LiteralComparedByStub ; openIn = Loop
operation ValueLooselyEqualsLiteral (value: Any/Converted, literal: String) -> natural(boolean) ; ResolvesRopes by Operator ; branches = May ; replaces = Eq ; runtime = CompareEqToString ; form = Runtime
operation StringStartsWithLiteral (string: String/inspects, literal: String) -> natural(boolean) ; ResolvesRopes ; branches = May ; replaces = CallBuiltin ; form = Open
operation StringEndsWithLiteral (string: String/inspects, literal: String) -> natural(boolean) ; ResolvesRopes ; branches = May ; replaces = CallBuiltin ; form = Open
operation StringIndexOfLiteral (string: String/inspects, position: Integer/inspects, literal: String) -> natural(int[-1, 2147483647]) ; ResolvesRopes ; replaces = CallBuiltin ; runtime = StringIndexOfLiteral ; form = Runtime
operation StringIndexOfCharacter (string: String/inspects, position: Integer/inspects, codeUnit: UInt32) -> natural(int[-1, 2147483647]) ; ResolvesRopes ; replaces = CallBuiltin ; runtime = StringIndexOfCharacter ; form = Runtime
operation StringLastIndexOfLiteral (string: String/inspects, position: Integer/inspects, literal: String) -> natural(int[-1, 2147483647]) ; ResolvesRopes ; Prepared..Placed ; replaces = CallBuiltin ; runtime = StringLastIndexOfLiteral ; form = Runtime
