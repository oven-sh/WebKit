operation StringRangeCodeUnitOrMinusOne (string: String/inspects, start?: Integer/inspects, end?: Integer/inspects, position: Number/inspects) -> natural(int[-1, 65535]) ; ResolvesRopes ; replaces = CallBuiltin, Substring, StrictEq, Eq, ElemGet, Less, LessEq, Greater, GreaterEq
operation StringRangeCodePointOrUndefined (string: String/inspects, start?: Integer/inspects, end?: Integer/inspects, position: Number/inspects) -> natural(int[0, 1114111] | undefined) ; ResolvesRopes
operation StringRangeCharacterOrEmpty (string: String/inspects, start?: Integer/inspects, end?: Integer/inspects, position: Number/inspects) -> natural(string) ; CreatesString
operation StringRangeCharacterOrUndefined (string: String/inspects, start?: Integer/inspects, end?: Integer/inspects, position: Number/inspects) -> natural(string | undefined) ; CreatesString
operation StringRangeEqualsLiteral (string: String/inspects, start: Integer/inspects, end: Integer/inspects, literal: String) -> natural(boolean) ; ResolvesRopes ; branches = May
