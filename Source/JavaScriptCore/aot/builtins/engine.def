# The grammar is in the header of Source/JavaScriptCore/Scripts/generate-aot-builtins.py. After a change: run it, it rewrites the generated files of both trees.

# The engine's builtins that are written in JavaScript: builtins/*.js. Each is compiled with every program, from <bun>/src/aot/prelude/engine/, but these.

# Called by the inline caches of the JIT.
omitted ProxyHelpers.performProxyObjectGet
omitted ProxyHelpers.performProxyObjectGetByVal
omitted ProxyHelpers.performProxyObjectHas
omitted ProxyHelpers.performProxyObjectHasByVal
omitted ProxyHelpers.performProxyObjectSetByValSloppy
omitted ProxyHelpers.performProxyObjectSetByValStrict
omitted ProxyHelpers.performProxyObjectSetSloppy
omitted ProxyHelpers.performProxyObjectSetStrict

# For a debugger.
omitted InjectedScriptSource.createArrayWithoutPrototype
omitted InjectedScriptSource.createInspectorInjectedScript
omitted InjectedScriptSource.createObjectWithoutPrototype

# It is a host function there: JSPromiseConstructor::create().
omitted PromiseConstructor.Promise

# They resume a generator of bytecode. A generator of a program is another object.
written GeneratorPrototype
written JSIteratorHelperPrototype
written MapPrototype
written SetPrototype
omitted GeneratorPrototype.generatorResume

inline IsConstructor
inline ArraySpeciesCreate
inline DeleteByValSloppy
inline GetByValWithThis
inline ToObject
inline SloppyThis
inline ToPropertyKey
inline ResumeGenerator
inline IsGeneratorSuspendedAtStart
inline StepGenerator
inline GeneratorStepStatus
inline MakeIteratorResult
inline IsUnmodifiedGenerator
inline DrivenIteratorMarker
inline DeclaredGenerator

runtime IsConstructor : Nothing size_t (EncodedJSValue value) noexcept
runtime ArraySpeciesCreate : Heap EncodedJSValue (EncodedJSValue length, JSCell* array)
runtime DeleteByValSloppy : Heap size_t (EncodedJSValue base, EncodedJSValue key)
runtime GetByValWithThis : Heap EncodedJSValue (EncodedJSValue base, EncodedJSValue thisValue, EncodedJSValue key)
runtime ToObject : Heap JSCell* (EncodedJSValue value, uint32_t message)
runtime SloppyThis : RuntimeState EncodedJSValue (EncodedJSValue value)
runtime ToPropertyKey : Heap EncodedJSValue (EncodedJSValue value)
runtime ResumeGenerator : Heap EncodedJSValue (EncodedJSValue generator, int32_t mode, EncodedJSValue value)
runtime IsGeneratorSuspendedAtStart : Nothing size_t (JSCell* generator) noexcept
runtime CreateIteratorResult : RuntimeState JSCell* (EncodedJSValue value, uint32_t isDone) noexcept

# The message of ToObject is a string constant, the mode of ResumeGenerator a JSGenerator::ResumeMode.
operation IsConstructor (any/-) -> boolean ; ReadsRuntimeState ; Inline(IsConstructor)
operation ArraySpeciesCreate (any/-, any/G) -> anything ; CallsUserCode ; Inline(ArraySpeciesCreate)
operation DeleteByValSloppy (any/WG, any/G) -> boolean ; CallsUserCode ; Inline(DeleteByValSloppy)
operation GetByValWithThis (any/GP, any/A, any/G) -> anything ; CallsUserCode ; Inline(GetByValWithThis)
operation ToObject (any/R, any/-) -> anything ; MayThrow Allocates ReadsRuntimeState ; Inline(ToObject)
operation SloppyThis (any/R) -> anything ; Allocates ReadsRuntimeState ; Inline(SloppyThis)
operation ToPropertyKey (any/GR) -> string | symbol ; CallsUserCode ; Inline(ToPropertyKey)
operation ResumeGenerator (any, any/-, any) -> anything ; CallsUserCode ; Inline(ResumeGenerator)
operation IsGeneratorSuspendedAtStart (any/-) -> boolean ; ReadsRuntimeState ; Inline(IsGeneratorSuspendedAtStart)
operation StepGenerator (any, any/-, any, any/-) -> anything ; CallsUserCode ; Inline(StepGenerator)
operation GeneratorStepStatus (any/-) -> int[0,2] ; ReadsRuntimeState ; Inline(GeneratorStepStatus)
operation MakeIteratorResult (any/K, any/-) -> new Object/N ; Allocates ; Inline(MakeIteratorResult)
operation IsUnmodifiedGenerator (any/-, any/-?) -> boolean ; ReadsRuntimeState ; Inline(IsUnmodifiedGenerator)
operation DrivenIteratorMarker () -> anything ; Pure ; Inline(DrivenIteratorMarker)
operation DeclaredGenerator (any/R) -> arg0 ; Pure ; Inline(DeclaredGenerator)

# JavaScriptCore's bytecode intrinsics: bytecompiler/NodesCodegen.cpp, emit_intrinsic_*. All read there, and the slow path of the opcode in runtime/CommonSlowPaths.cpp.
$deleteByValSloppy Call = Operation(DeleteByValSloppy)
$getArrayIteratorInternalField Call = Operation(GetInternalField)
$getAsyncDisposableStackInternalField Call = Operation(GetInternalField)
$getByValWithThis Call = Operation(GetByValWithThis)
$getDisposableStackInternalField Call = Operation(GetInternalField)
$getIteratorHelperInternalField Call = Operation(GetInternalField)
$getWrapForValidIteratorInternalField Call = Operation(GetInternalField)
$isArrayIterator Call = HasJSType(JSArrayIteratorType, JSArrayIteratorType)
$isAsyncDisposableStack Call = HasJSType(AsyncDisposableStackType, AsyncDisposableStackType)
$isConstructor Call = Operation(IsConstructor)
$isDisposableStack Call = HasJSType(DisposableStackType, DisposableStackType)
$isIteratorHelper Call = HasJSType(JSIteratorHelperType, JSIteratorHelperType)
$isShadowRealm Call = HasJSType(ShadowRealmType, ShadowRealmType)
$isWrapForValidIterator Call = HasJSType(JSWrapForValidIteratorType, JSWrapForValidIteratorType)
$newArrayWithSpecies Call = Operation(ArraySpeciesCreate)
$putArrayIteratorInternalField Call = Operation(PutInternalField)
$putAsyncDisposableStackInternalField Call = Operation(PutInternalField)
$putDisposableStackInternalField Call = Operation(PutInternalField)
$toObject Call = Operation(ToObject)
$toPropertyKey Call = Operation(ToPropertyKey)

# The constants of bytecode/BytecodeIntrinsicRegistry.cpp.
$arrayIteratorFieldIndex Value = Int(0, JSArrayIterator::Field::Index)
$arrayIteratorFieldIteratedObject Value = Int(1, JSArrayIterator::Field::IteratedObject)
$arrayIteratorFieldKind Value = Int(2, JSArrayIterator::Field::Kind)
$asyncDisposableStackFieldCapability Value = Int(1, JSAsyncDisposableStack::Field::Capability)
$asyncDisposableStackFieldState Value = Int(0, JSAsyncDisposableStack::Field::State)
$AsyncDisposableStackStateDisposed Value = Int(1, JSAsyncDisposableStack::State::Disposed)
$disposableStackFieldCapability Value = Int(1, JSDisposableStack::Field::Capability)
$disposableStackFieldState Value = Int(0, JSDisposableStack::Field::State)
$DisposableStackStateDisposed Value = Int(1, JSDisposableStack::State::Disposed)
$GeneratorResumeModeNormal Value = Int(0, JSGenerator::ResumeMode::NormalMode)
$GeneratorResumeModeReturn Value = Int(1, JSGenerator::ResumeMode::ReturnMode)
$GeneratorResumeModeThrow Value = Int(2, JSGenerator::ResumeMode::ThrowMode)
$iterationKindEntries Value = Int(2, IterationKind::Entries)
$iterationKindKey Value = Int(0, IterationKind::Keys)
$iteratorHelperFieldGenerator Value = Int(0, JSIteratorHelper::Field::Generator)
$iteratorHelperFieldUnderlyingIterator Value = Int(1, JSIteratorHelper::Field::UnderlyingIterator)
$wrapForValidIteratorFieldIteratedIterator Value = Int(0, JSWrapForValidIterator::Field::IteratedIterator)
$wrapForValidIteratorFieldIteratedNextMethod Value = Int(1, JSWrapForValidIterator::Field::IteratedNextMethod)

# Link-time constants: the cell the bytecode would have in its constant pool, called as the bytecode would call it. So each is exact whatever the function does.
$arrayFromFastWithoutMapFn Call = LinkTimeConstant
$AsyncDisposableStack Value = LinkTimeConstant
$asyncFromSyncIteratorCreate Call = LinkTimeConstant
$createRemoteFunction Call = LinkTimeConstant
$DisposableStack Value = LinkTimeConstant
$evalInRealm Call = LinkTimeConstant
$importInRealm Call = LinkTimeConstant
$instanceOf Call = LinkTimeConstant
$isDetached Call = LinkTimeConstant
$isTypedArrayOutOfBounds Call = LinkTimeConstant
$Iterator Value = LinkTimeConstant
$iteratorHelperCreate Call = LinkTimeConstant
$makeTypeError Call = LinkTimeConstant
$Map Value = LinkTimeConstant
$newRejectedPromise Call = LinkTimeConstant
$newResolvedPromise Call = LinkTimeConstant
$Object Value = LinkTimeConstant
$ownKeys Call = LinkTimeConstant
$performPromiseThen Call = LinkTimeConstant
$promiseReject Call = LinkTimeConstant
$promiseResolve Call = LinkTimeConstant
$promiseReturnUndefinedOnFulfilled Value = LinkTimeConstant
$ReferenceError Value = LinkTimeConstant
$SuppressedError Value = LinkTimeConstant
$toIntegerOrInfinity Call = LinkTimeConstant
$typedArrayFromFast Call = LinkTimeConstant
$typedArrayLength Call = LinkTimeConstant
$wrapForValidIteratorCreate Call = LinkTimeConstant

# Properties under a private name: ObjectConstructor.cpp:106, :111; MapPrototype.cpp:67; SetPrototype.cpp:97.
$create Member = PrivateName
$entries Member = PrivateName
$getOwnPropertyDescriptor Member = PrivateName
$values Member = PrivateName

$alwaysInline Value = Directive

# For the files written by hand.
$isGeneratorSuspendedAtStart Call = Operation(IsGeneratorSuspendedAtStart)
$stepGenerator Call = Operation(StepGenerator)
$generatorStepStatus Call = Operation(GeneratorStepStatus)
$makeIteratorResult Call = Operation(MakeIteratorResult)
$resumeGenerator Call = Operation(ResumeGenerator)
$collectionTable Call = Operation(CollectionTable)
$mapNext Call = Operation(MapNext)
$mapKeyAt Call = Operation(MapKeyAt)
$mapValueAt Call = Operation(MapValueAt)
$setNext Call = Operation(SetNext)
$setKeyAt Call = Operation(SetKeyAt)

# Builtins written in JavaScript that other builtins call: `$linkTimeConstant;`.
$addDisposableResource Call = LinkedFunction
$arrayIteratorNextHelper Value = LinkedFunction
$closeAllIterators Call = LinkedFunction
$createDisposableResource Call = LinkedFunction
$crossRealmThrow Value = LinkedFunction
$defaultAsyncFromAsyncArrayLike Value = LinkedFunction
$defaultAsyncFromAsyncIterator Value = LinkedFunction
$defaultAsyncFromAsyncIteratorWithNext Value = LinkedFunction
$flatIntoArray Call = LinkedFunction
$flatIntoArrayWithCallback Call = LinkedFunction
$getAsyncDisposeMethod Call = LinkedFunction
$getDisposeMethod Call = LinkedFunction
$getIteratorFlattenable Call = LinkedFunction
$getIteratorSync Call = LinkedFunction
$getOptionsObject Call = LinkedFunction
$iteratorCloseAllNormal Call = LinkedFunction
$iteratorGenericClose Call = LinkedFunction
$iteratorGenericNext Call = LinkedFunction
$iteratorZip Call = LinkedFunction
$removeFirstFromList Call = LinkedFunction
$wrappedIterator Call = LinkedFunction
$wrapRemoteValue Call = LinkedFunction
