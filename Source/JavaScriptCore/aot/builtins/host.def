inline NewResponseFromResponse
inline GetRequestHeader

runtime NewResponse : Heap EncodedJSValue (EncodedJSValue body, EncodedJSValue status, EncodedJSValue statusText, EncodedJSValue headers, uint32_t headerCount, const EncodedJSValue* headerNamesAndValues)

