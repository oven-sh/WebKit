runtime GetRequestHeader : Heap EncodedJSValue (EncodedJSValue request, EncodedJSValue name)

intrinsic NewResponse (any/KG, any/G, any/G, any/GP, any/G...) -> anything/N ; CallsUserCode ; Inline(NewResponse, None)
