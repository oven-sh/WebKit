# Bun's internal modules and builtin functions (src/js): the operations the front end emits for them, and every `$name` they spell.

inline IsObject
inline IsCallable
inline HasJSType
inline GetInternalField
inline PutInternalField
inline ToLength
inline PutByValDirect
inline GetOwnProperty
inline LinkTimeConstant
inline RequireBuiltinModule
inline NativeBinding
inline HasHostClassStructure
inline IsGlobalCachedAsBuiltin
inline ScanPlainURL
inline FindPlainQueryValue
inline HasHostObjectCachedValue
inline HostObjectCachedValue

runtime RequireBuiltinModule : Heap EncodedJSValue (uint32_t id)
runtime NativeBinding : Heap EncodedJSValue (uint32_t index)
runtime LinkTimeConstant : RuntimeState JSCell* (uint32_t constant) noexcept
runtime ToLength : Heap EncodedJSValue (EncodedJSValue value)
runtime ScanPlainURL : Pure EncodedJSValue (EncodedJSValue text) noexcept
runtime FindPlainQueryValue : Pure EncodedJSValue (EncodedJSValue text, EncodedJSValue offsets, EncodedJSValue name) noexcept
runtime GetOwnProperty : Heap EncodedJSValue (EncodedJSValue object, uint32_t name)
runtime PutByValDirect : Heap void (JSCell* object, EncodedJSValue key, EncodedJSValue value)
runtime PutByIdDirect : Heap void (JSCell* object, uint32_t name, EncodedJSValue value)

# An id, an index, the number of a field, of a JSType or of a link-time constant is an integer constant. The key of GetOwnProperty is a string constant.
operation RequireBuiltinModule (any/-) -> anything ; CallsUserCode ; Inline(RequireBuiltinModule)
operation NativeBinding (any/-) -> anything ; MayThrow Allocates ReadsRuntimeState WritesRuntimeState ; Inline(NativeBinding)
operation LinkTimeConstant (any/-) -> anything ; Allocates ReadsRuntimeState WritesRuntimeState ; Inline(LinkTimeConstant)
operation IsObject (any/-) -> boolean ; Pure ; Inline(IsObject)
operation IsCallable (any/-) -> boolean ; ReadsRuntimeState ; Inline(IsCallable)
operation HasJSType (any/-, any/-, any/-) -> boolean ; Pure ; Inline(HasJSType)
operation GetInternalField (any/P, any/-) -> anything ; ReadsArguments ; Inline(GetInternalField)
operation PutInternalField (any/w, any/-, any/KR) -> arg2 ; WritesArguments ; Inline(PutInternalField)
operation ToLength (any/G) -> number ; CallsUserCode ; Inline(ToLength)
operation GetOwnProperty (any/GP, any/-) -> anything ; CallsUserCode ; Inline(GetOwnProperty)
operation PutByValDirect (any/Ww, any/G, any/KR) -> arg2 ; CallsUserCode ; Inline(PutByValDirect)
operation HasHostClassStructure (any/-, any/-) -> boolean ; ReadsArguments ReadsRuntimeState ; Inline(HasHostClassStructure)
operation IsGlobalCachedAsBuiltin (any/-) -> boolean ; ReadsRuntimeState ; Inline(IsGlobalCachedAsBuiltin)
operation ScanPlainURL (any/-) -> anything ; Pure ; Inline(ScanPlainURL)
operation FindPlainQueryValue (any/-, any/-, any/-) -> number ; Pure ; Inline(FindPlainQueryValue)
operation HasHostObjectCachedValue (any/-, any/-, any/-) -> boolean ; ReadsArguments ReadsRuntimeState ; Inline(HasHostObjectCachedValue)
operation HostObjectCachedValue (any/P, any/-) -> anything ; ReadsArguments ; Inline(HostObjectCachedValue)

# JavaScriptCore's bytecode intrinsics: bytecompiler/NodesCodegen.cpp, emit_intrinsic_*.
$argument Call = Argument
$argumentCount Call = ArgumentCount
$arrayPush Call = ArrayPush
$getByIdDirect Call = GetOwnProperty
$getByIdDirectPrivate Call = GetOwnProperty(private)
$getInternalField Call = Operation(GetInternalField)
$getProxyInternalField Call = Operation(GetInternalField)
$isCallable Call = Operation(IsCallable)
$isJSArray Call = HasJSType(ArrayType, DerivedArrayType)
$isMap Call = HasJSType(JSMapType, JSMapType)
$isObject Call = Operation(IsObject)
$isPromise Call = HasJSType(JSPromiseType, JSPromiseType)
$isProxyObject Call = HasJSType(ProxyObjectType, ProxyObjectType)
$isRegExpObject Call = HasJSType(RegExpObjectType, RegExpObjectType)
$isSet Call = HasJSType(JSSetType, JSSetType)
$isUndefinedOrNull Call = IsNullish
$newArrayWithSize Call = Construct(Array)
$newPromise Call = Operation(NewPromise)
$proxyFieldHandler Value = Int(1, ProxyObject::Field::Handler)
$proxyFieldTarget Value = Int(0, ProxyObject::Field::Target)
$putByIdDirectPrivate Call = PutByValDirect(private)
$putByValDirect Call = PutByValDirect
$putInternalField Call = Operation(PutInternalField)

# Link-time constants: bytecode/LinkTimeConstant.h. They are in the constant pool of a code block, not on the global object.
$Array Value = PublicGlobal
$isArray Call = Builtin(Array.isArray)
$isArray Value = LinkTimeConstant
$isFinite Call = Builtin(isFinite)
$isTypedArrayView Call = HasJSType(Int8ArrayType, BigUint64ArrayType)
$min Call = Builtin(Math.min)
$Promise Value = PublicGlobal
$rejectPromise Call = LinkTimeConstant
$rejectPromiseWithFirstResolvingFunctionCallCheck Call = Operation(RejectPromise)
$resolvePromise Call = LinkTimeConstant
$resolvePromiseWithFirstResolvingFunctionCallCheck Call = Operation(ResolvePromise)
$toLength Call = Operation(ToLength)

# `f.$call(..)`, `f.$apply(..)`: the parser knows them. No property is read.
$apply Member = Apply
$call Member = Call

# Properties of the global object under a private name.
$asyncContext Value = PrivateGlobal
$Buffer Value = PrivateGlobal
$createCommonJSModule Call = PrivateGlobal
$createFIFO Call = PrivateGlobal
$esmLoadSync Call = PrivateGlobal
$esmNamespaceForCjs Call = PrivateGlobal
$esmRegistryDelete Call = PrivateGlobal
$esmRegistryEvaluatedKeys Call = PrivateGlobal
$esmRegistryHasEvaluated Call = PrivateGlobal
$evaluateCommonJSModule Call = PrivateGlobal
$evictIsolationSourceProviderCache Call = PrivateGlobal
$internalRequire Call = PrivateGlobal
$loadEsmIntoCjs Call = PrivateGlobal
$makeAbortError Call = PrivateGlobal
$overridableRequire Value = ReplaceablePrivateGlobal
$peekPromiseSettledValue Call = PrivateGlobal
$peekPromiseStatus Call = PrivateGlobal
$pokePromiseAsHandled Call = PrivateGlobal
$processBindingConstants Value = PrivateGlobal
$requireESM Call = PrivateGlobal
$requireMap Value = PrivateGlobal
$resolveSync Call = PrivateGlobal
$toClass Call = PrivateGlobal
$webStreamClosedPromise Call = PrivateGlobal
$webStreamControllerError Call = PrivateGlobal

# Properties under a private name.
$add Member = PrivateName
$bunNativePtr Member = PrivateName
$charCodeAt Member = PrivateName
$clear Member = PrivateName
$data Member = PrivateName
$defineProperty Member = PrivateName
$delete Member = PrivateName
$detail Member = PrivateName
$fastPath Member = PrivateName
$forEach Member = PrivateName
$get Member = PrivateName
$has Member = PrivateName
$keys Member = PrivateName
$kResistStopPropagation Member = PrivateName
$napiDlopenHandle Member = PrivateName
$onEndCallbacks Member = PrivateName
$pull Member = PrivateName
$reject Member = PrivateName
$require Member = PrivateName
$requireMap Member = PrivateName
$requireNativeModule Member = PrivateName
$resolve Member = PrivateName
$resolveSync Member = PrivateName
$runTail Member = PrivateName
$set Member = PrivateName
$setColumnNameTransform Member = PrivateName
$size Member = PrivateName
$start Member = PrivateName
$then Member = PrivateName
$write Member = PrivateName

# What Manifest::macro_for_call() expands, the manifest's defines, the directives of a builtin function.
$assert Call = Macro
$bindgen Call = Macro
$bundleError Call = Macro
$constructor Value = Directive
$cpp Call = Macro
$debug Call = Macro
$debug Value = Bool(false)
$getter Value = Directive
$ImportKindIdToLabel Value = Define
$isPromisePending Call = Macro
$linkTimeConstant Value = Directive
$LoaderIdToLabel Value = Define
$LoaderLabelToId Value = Define
$newCppFunction Call = Macro
$newRustFunction Call = Macro
$overriddenName Value = Directive
$rust Call = Macro
$visibility Value = Directive
$ERR_* Call = Macro
$HPE_* Call = Macro
$inherits* Call = Macro

# What JavaScriptCore also has under the private name: MapPrototype.cpp, SetPrototype.cpp, ArrayPrototype.cpp, JSPromisePrototype.cpp,
# JSPromiseConstructor.cpp, StringPrototype.cpp, ObjectConstructor.cpp. (WeakMap.prototype has a `get` and no `@get`.)
twin Map.prototype.clear
twin Map.prototype.delete
twin Map.prototype.entries
twin Map.prototype.forEach
twin Map.prototype.get
twin Map.prototype.has
twin Map.prototype.keys
twin Map.prototype.set
twin Map.prototype.size
twin Map.prototype.values
twin Set.prototype.add
twin Set.prototype.clear
twin Set.prototype.delete
twin Set.prototype.entries
twin Set.prototype.forEach
twin Set.prototype.has
twin Set.prototype.keys
twin Set.prototype.size
twin Set.prototype.values
twin Array.prototype.shift
twin Array.prototype.entries
twin Array.prototype.forEach
twin Array.prototype.includes
twin Array.prototype.indexOf
twin Array.prototype.keys
twin Array.prototype.map
twin Array.prototype.pop
twin Array.prototype.values
twin Promise.prototype.then
twin Promise.resolve
twin Promise.reject
twin String.prototype.charCodeAt
twin String.prototype.substr
twin String.prototype.endsWith
twin Object.getPrototypeOf
twin Object.getOwnPropertyDescriptor
twin Object.getOwnPropertyNames
twin Object.getOwnPropertySymbols
twin Object.keys
twin Object.defineProperty
twin Object.create
twin Object.values
twin Object.hasOwn

# A free identifier of a file of src/js that Manifest::is_hardened_global() holds for: `@name` to JavaScriptCore. A global of this table cannot be
# replaced by a program, so the public one is it. Any other is read under its private name.
hardened Array = PublicGlobal
hardened ArrayBuffer = PublicGlobal
hardened Promise = PublicGlobal
hardened RegExp = PublicGlobal
hardened String = PublicGlobal
hardened Uint8Array = PublicGlobal
hardened isFinite = PublicGlobal
hardened undefined = Undefined
hardened Infinity = Double(Infinity)
hardened AbortSignal = PrivateGlobal
hardened Buffer = PrivateGlobal
hardened ReadableByteStreamController = PrivateGlobal
hardened ReadableStream = PrivateGlobal
hardened ReadableStreamBYOBReader = PrivateGlobal
hardened ReadableStreamBYOBRequest = PrivateGlobal
hardened ReadableStreamDefaultController = PrivateGlobal
hardened ReadableStreamDefaultReader = PrivateGlobal
hardened TransformStream = PrivateGlobal
hardened TransformStreamDefaultController = PrivateGlobal
hardened WritableStream = PrivateGlobal
hardened WritableStreamDefaultController = PrivateGlobal
hardened WritableStreamDefaultWriter = PrivateGlobal
