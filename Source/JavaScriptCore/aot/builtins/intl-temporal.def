# The grammar is in the header of Source/JavaScriptCore/Scripts/generate-aot-builtins.py. After a change: run it, it rewrites the generated files of both trees.

inline NewConstantFormatter
inline FormatDateTime
inline FormatNumber
inline DateToLocaleString
inline NumberToLocaleString

runtime NewConstantFormatter : RuntimeState JSCell* (uint32_t pattern)
runtime FormatDateTime : RuntimeState JSCell* (EncodedJSValue formatter, double timeValue) noexcept
runtime FormatNumber : RuntimeState JSCell* (EncodedJSValue formatter, double number) noexcept
runtime FormatTimeValueWithPattern : RuntimeState JSCell* (uint32_t pattern, double timeValue) noexcept
runtime FormatNumberWithPattern : RuntimeState JSCell* (uint32_t pattern, double number) noexcept

intrinsic NewConstantFormatter (any/-) -> anything/N ; MayThrow Allocates ReadsRuntimeState ; Inline(NewConstantFormatter, None)
intrinsic FormatDateTime (any, any) -> anything ; CallsUserCode ; Inline(FormatDateTime, None)
intrinsic FormatNumber (any, any) -> anything ; CallsUserCode ; Inline(FormatNumber, None)
