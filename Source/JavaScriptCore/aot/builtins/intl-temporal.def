# The grammar is in the header of Source/JavaScriptCore/Scripts/generate-aot-builtins.py. After a change: run it, it rewrites the generated files of both trees.

inline FormatDateTime
inline FormatNumber

runtime FormatDateTime : RuntimeState JSCell* (EncodedJSValue formatter, uint32_t pattern, double timeValue) noexcept
runtime FormatNumber : RuntimeState JSCell* (EncodedJSValue formatter, uint32_t pattern, double number) noexcept

intrinsic FormatDateTime (any, any, any/-) -> anything ; CallsUserCode ; Inline(FormatDateTime, None)
intrinsic FormatNumber (any, any, any/-) -> anything ; CallsUserCode ; Inline(FormatNumber, None)
