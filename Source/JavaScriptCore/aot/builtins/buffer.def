# The grammar is in the header of Source/JavaScriptCore/Scripts/generate-aot-builtins.py. After a change: run it, it rewrites the generated files of both trees.

class ArrayBuffer : ArrayBufferType = arrayBufferStructure(ArrayBufferSharingMode::Default)
class SharedArrayBuffer : ArrayBufferType = arrayBufferStructure(ArrayBufferSharingMode::Shared)
class DataView : DataViewType = typedArrayStructure(TypeDataView, false), typedArrayStructure(TypeDataView, true)

