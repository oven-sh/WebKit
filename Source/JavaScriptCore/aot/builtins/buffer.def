inline DataViewSetUint16
inline DataViewSetInt32
inline DataViewSetUint32
inline DataViewSetFloat32
inline DataViewSetFloat64
inline DataViewSetBigInt64
inline DataViewSetBigUint64

runtime FindBufferAccessor : Heap void (JSCell* receiver, uint32_t row) noexcept
runtime NewBigInt64 : RuntimeState JSCell* (uint64_t bits, uint32_t isSigned)

# Of Bun's Buffer.prototype: src/jsc/bindings/JSBuffer.cpp, registerBufferAccessorsWithJSC().
accessor readInt8 : read 1 signed little
accessor readUInt8 : read 1 unsigned little
