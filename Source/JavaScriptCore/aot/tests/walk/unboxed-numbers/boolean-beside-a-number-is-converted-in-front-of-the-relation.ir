# undefined, null and booleans become numbers without running code, so a relation on them and on numbers is typed, with the conversion of a boolean in front of it
# function more(x) { const isNumber = typeof x === "number"; return 0 < isNumber; }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = ToNumber
# CHECK: = Less {{*}}form=Integers
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = Less {{*}}form=Integers
# function ofAnything(x) { return 0 < x; } a text is compared as a text, and an object runs code: the relation takes the number raw and asks the value itself, as it does without this rule
# RUN(ANYTHING): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers
# ANYTHING-LABEL: code f2:Body
# ANYTHING-NOT: = ToNumber
# ANYTHING: = Less {{*}}form=NumberAndValue
# function narrowed(x) { const isNumber = typeof x === "number"; if (isNumber < 1) return isNumber; return 2; } what an edge behind a test narrows is an operand of the test, so an operand that an edge hands on is not converted
# RUN(NARROWED): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers
# NARROWED-NOT: = ToNumber

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
