# beside a proven integer a constant that is no integer is rounded towards the side that the relation asks for, and two integers are compared. The relation keeps its opcode and its sides
# function below(v) { if (!isInt32(v)) return v; return v < 2.5; }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = Less {{*}}form=Integers
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = Less {{*}}form=Integers
# function above(v) { if (!isInt32(v)) return v; return 2.5 <= v; }
# RUN(ABOVE): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers
# ABOVE-LABEL: code f2:Body
# ABOVE: = LessEq {{*}}form=Integers
# function ofNumber(x) { if (typeof x !== "number") return x; return x < 2.5; } 2.2 lies below 2.5 and not below 2
# RUN(NUMBER): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers
# NUMBER-LABEL: code f3:Body
# NUMBER: = Less {{*}}form=Numbers

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
