# a double that is made in front of an await and read behind it is held by the saved frame as it is: it is neither boxed for the suspension nor tested behind it
# async function wait(n, p) { if (typeof n !== "number") return n; const a = n * n; await p; return a * n; }
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: [[a]]: number @Double = Mul {{*}}form=Numbers
# CHECK: = AwaitBySavingFrame
# CHECK-NOT: TypeTest
# CHECK: @Double = Mul [[a]], {{*}}form=Numbers

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="wait" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    v4 = Mul v3, v3
    v5 = Await v1
    v6 = Mul v4, v3
    Return v6
  b2(v7):
    Return v7
}
