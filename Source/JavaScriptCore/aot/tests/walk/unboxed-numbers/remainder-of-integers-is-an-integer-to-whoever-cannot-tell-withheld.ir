# WHOLE-LABEL: code f9:Body
# WHOLE: = Div
# RUN(NEVER): walk f1 f2 f3 f4 f6 f7 f9 mechanisms=none+TypedOperations
# NEVER-NOT: RemainderOfIntegers
# NEVER-NOT: DivideIntegers
