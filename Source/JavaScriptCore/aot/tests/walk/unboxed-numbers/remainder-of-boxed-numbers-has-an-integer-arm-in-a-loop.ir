# both operands are proven numbers that lie boxed, and int32 is written of both. In the form of numbers a remainder unboxes both ways and calls the run time, on integers it does neither:
# so in a loop each tag is asked once, the remainder is walked on integers and on doubles, and the two meet
# function wrap(x: int32, y: int32) { if (typeof x === "number" && typeof y === "number") { let s = 0; for (let i = 0; i < 8; i++) s += x % y; return s; } }
# a product is open in both forms, and where the arms meet an integer becomes a double again, so a product by itself has no arms: function area(x: int32, y: int32) { .. s += x * y + 0.5; .. }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# CHECK: mechanisms TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-2: = TypeTest {{*}}testedType=i32
# RUN(INTEGERS): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# INTEGERS-LABEL: code f1:Body
# INTEGERS: = Mod {{*}}form=CheckedIntegers
# RUN(DOUBLES): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# DOUBLES-LABEL: code f1:Body
# DOUBLES: = Mod {{*}}form=Numbers
# RUN(PRODUCT): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# PRODUCT-NOT: testedType=i32
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# WITHHELD-NOT: testedType=i32

module m0 path="wrap.ts" displayPath="wrap.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="wrap" module=m0 length=2 thisType={type=anything} parameters=[{type=i32}, {type=i32}] results=[{type=anything}] {
  b0(v0: i32, v1: i32):
    v2 = Convert v0 declared={type=i32}
    v3 = Convert v1 declared={type=i32}
    v4 = TypeTest v2 testedType=number
    Branch v4 -> taken b1(| 0), notTaken b6()
  b1(v5):
    v6 = TypeTest v3 testedType=number
    Branch v6 -> taken b2(| 0), notTaken b6()
  b2(v7):
    v8 = Integer
    v9 = Integer
    Jump -> next b3(v8, v9)
  b3(v10, v11):
    LoopHint
    v13 = Integer integer=8
    v14 = Less v11, v13
    Branch v14 -> taken b4(), notTaken b5()
  b4():
    v15 = Mod v5, v7
    v16 = Add v10, v15
    v17 = Increment v11
    Jump -> next b3(v16, v17)
  b5():
    Return v10
  b6():
    v18 = Undefined
    Return v18
}
function f2 name="area" module=m0 length=2 thisType={type=anything} parameters=[{type=i32}, {type=i32}] results=[{type=anything}] {
  b0(v0: i32, v1: i32):
    v2 = Convert v0 declared={type=i32}
    v3 = Convert v1 declared={type=i32}
    v4 = TypeTest v2 testedType=number
    Branch v4 -> taken b1(| 0), notTaken b6()
  b1(v5):
    v6 = TypeTest v3 testedType=number
    Branch v6 -> taken b2(| 0), notTaken b6()
  b2(v7):
    v8 = Integer
    v9 = Integer
    Jump -> next b3(v8, v9)
  b3(v10, v11):
    LoopHint
    v13 = Integer integer=8
    v14 = Less v11, v13
    Branch v14 -> taken b4(), notTaken b5()
  b4():
    v15 = Mul v5, v7
    v16 = Double number=0.5
    v17 = Add v15, v16
    v18 = Add v10, v17
    v19 = Increment v11
    Jump -> next b3(v18, v19)
  b5():
    Return v10
  b6():
    v20 = Undefined
    Return v20
}
