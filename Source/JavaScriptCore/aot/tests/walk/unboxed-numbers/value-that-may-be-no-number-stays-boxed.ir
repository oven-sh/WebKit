# what comes round the loop is a sum in its closed form, a number or a text or a bigint: nothing proves a number, so the parameter of the head stays boxed
# function sum(n) { let s = n; while (s < 1000.5) s = s + n; return s; }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: @JSValue){{*}}isLoopHead=true
# CHECK: @JSValue = Add {{*}}form=Generic
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# NEVER-NOT: @Double = Add
# NEVER-NOT: @Double)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1000.5
    Jump -> next b1(v0)
  b1(v2):
    LoopHint
    v4 = Less v2, v1
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Add v2, v0
    Jump -> next b1(v5)
  b3():
    Return v2
}
