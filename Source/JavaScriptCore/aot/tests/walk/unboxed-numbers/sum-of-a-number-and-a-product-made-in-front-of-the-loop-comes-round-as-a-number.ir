# function sum(a, b, n) { if (typeof n !== "number" || (n | 0) !== n) return n; const product = a * b; let total = 0; for (let i = 0; i < n; i++) total += product; return total; }
# Of what nobody knows the product is a number or a big integer; it is made in front of the loop, where nothing asks what it reckons with. A number and a big integer do not mix: the sum throws. So the
# sum is a number wherever it answers, and comes round raw. Beside the number the product is expected to be one: it is tested, and what fails the test is a big integer, for which the sum throws:
# nothing rejoins.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[product]]: number|bigint @JSValue = Mul
# CHECK: ([[sum]]: number @Double, {{*}}) isInLoop=true isLoopHead=true:
# CHECK: = TypeTest [[product]] testedType=number
# CHECK: = Add [[sum]], {{*}}form=Numbers
# CHECK: never @JSValue = Add
# CHECK-NEXT: Unreachable
# RUN(SHELL): run-in-shell globalThis.sink = sum => { print(sum(2, 3, 3)); print(sum("2", { valueOf() { return 4; } }, 3)); try { sum(2n, 3n, 3); } catch (error) { print(error.name); } print(sum(2n, 3n, 0)); };
# SHELL: 18
# SHELL-NEXT: 24
# SHELL-NEXT: TypeError
# SHELL-NEXT: 0
# SHELL-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
