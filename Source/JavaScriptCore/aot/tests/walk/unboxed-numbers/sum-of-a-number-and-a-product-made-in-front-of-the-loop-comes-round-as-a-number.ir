    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="sum" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = TypeTest v2 testedType=i32
    Branch v3 -> taken b1(| 0), notTaken b5()
  b1(v4):
    v5 = Mul v0, v1
    v6 = Integer
    v7 = Integer
    Jump -> next b2(v6, v7)
  b2(v8, v9):
    LoopHint
    v11 = Less v9, v4
    Branch v11 -> taken b3(), notTaken b4()
  b3():
    v12 = Add v8, v5
    v13 = Increment v9
    Jump -> next b2(v12, v13)
  b4():
