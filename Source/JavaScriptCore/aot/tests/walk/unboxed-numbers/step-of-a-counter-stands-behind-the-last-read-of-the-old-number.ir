# in a loop a step whose old number is read once more, by the next operation, is built behind that read: the old number dies at the step, which then adds in place
# the edges behind `i < 100` hand on no proof, and the turn names the counter itself, as the front end writes it: the look at the loop cuts that name by the relation, so the head holds the counter as an Int32, as its step does. The parameter that takes a proof is the whole counter to a look: stepped, it leaves the head an Int64 up to 2 ** 53, and a step that changes the form adds nothing in place and is refused
# function sum(v) { let s = 0; for (let i = 0; i < 100; ) s = (s + i++) | 0; return s; }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = Add
# CHECK: = Increment {{*}}form=Integers
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: isLoopHead=true
# ALL: = Add
# ALL: = Increment
# function readTwice(v) { let s = 0; for (let i = 0; i < 100; ) { const old = i++; s = (s + old + old) | 0; } return s; } the old number lives on behind the next operation
# RUN(TWICE): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers
# TWICE-LABEL: code f2:Body
# TWICE: isLoopHead=true
# TWICE: = Increment
# TWICE: = Add
# function once(v) { if (!isInt32(v)) return v; const i = v & 255; const next = i + 1; return [i & 15, next]; } outside a loop nothing moves the new number back
# RUN(ONCE): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers
# ONCE-LABEL: code f3:Body
# ONCE: = Add
# ONCE: = BitAnd

module m0 path="main.js" displayPath="main.js" body=f0
