# the remainder of two proven integers is a number only because it may be -0 or NaN. A comparison, a test of its truth and a key cannot tell -0 from 0, so they take the remainder as an integer
# function third(v) { if (!isInt32(v)) return v; return v % 3 === 0; }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = RemainderOfIntegers
# CHECK: = StrictEq {{*}}form=Integers
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = RemainderOfIntegers
# function fourth(v) { if (!isInt32(v)) return v; return v % 4 === 0; } a power of two divides what has no low bits
# RUN(FOURTH): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers
# FOURTH-LABEL: code f2:Body
# FOURTH: = BitAnd {{*}}form=Integers
# FOURTH: = StrictEq {{*}}form=Integers
# RUN(NODIVISION): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers
# NODIVISION-NOT: RemainderOfIntegers
# function odd(v) { if (!isInt32(v)) return v; return v % 2 ? 1 : 2; }
# RUN(ODD): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers
# ODD-LABEL: code f3:Body
# ODD: = BitAnd {{*}}form=Integers
# ODD: = ToBoolean {{*}}form=Integers
# function byAny(v) { if (!isInt32(v)) return v; return v % (v & 7) === 0; } a divisor of 0 leaves NaN, which equals nothing: a rare block answers false
# RUN(ANY): walk f4 mechanisms=none+TypedOperations+UnboxedNumbers
# ANY-LABEL: code f4:Body
# ANY: = RemainderOfIntegers
# ANY: = ToBoolean {{*}}form=Integers
# RUN(COMPARED): walk f4 mechanisms=none+TypedOperations+UnboxedNumbers
# COMPARED: = StrictEq {{*}}form=Integers
# RUN(RARE): walk f4 mechanisms=none+TypedOperations+UnboxedNumbers
# RARE: frequency=Rare
# function left(v) { if (!isInt32(v)) return v; return v % 3; } whoever gets the value can tell -0 from 0
# RUN(LEFT): walk f5 mechanisms=none+TypedOperations+UnboxedNumbers
# LEFT-NOT: RemainderOfIntegers

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = NewClosure function=f5
    v7 = Call v1, -, v2, v3, v4, v5, v6
    Return v7
}
function f1 name="third" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Integer integer=3
    v4 = Mod v2, v3
    v5 = Integer
    v6 = StrictEq v4, v5
    Return v6
  b2(v7):
    Return v7
}
function f2 name="fourth" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Integer integer=4
    v4 = Mod v2, v3
    v5 = Integer
    v6 = StrictEq v4, v5
    Return v6
  b2(v7):
    Return v7
}
function f3 name="odd" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Integer integer=2
    v4 = Mod v2, v3
    v5 = ToBoolean v4
    Branch v5 -> taken b3(), notTaken b4()
  b2(v6):
    Return v6
  b3():
    v7 = Integer integer=1
    Return v7
  b4():
    v8 = Integer integer=2
    Return v8
}
function f4 name="byAny" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Integer integer=7
    v4 = BitAnd v2, v3
    v5 = Mod v2, v4
    v6 = Integer
    v7 = StrictEq v5, v6
    Return v7
  b2(v8):
    Return v8
}
function f5 name="left" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Integer integer=3
    v4 = Mod v2, v3
    Return v4
  b2(v5):
    Return v5
}
