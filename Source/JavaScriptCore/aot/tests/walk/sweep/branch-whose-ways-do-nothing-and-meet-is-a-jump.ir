# if (a === undefined) { } else { } return b;
# Neither way does anything and both come to b3: the branch decides nothing. It is a jump to where they meet, the test that only it read goes, and neither way is reached any more.
# RUN: sweep-code
# CHECK: b0({{*}}dropped v0, v2
# CHECK-NOT: TypeTest
# CHECK-NOT: Branch
# CHECK: Jump -> next b3()
# CHECK: dropped b1
# CHECK: dropped b2
# CHECK: Return v1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: boolean @Boolean = TypeTest v0 testedType=undefined
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     Jump -> next b3()
#   b2():
#     Jump -> next b3()
#   b3():
#     Return v1
# }
# -- end of code
