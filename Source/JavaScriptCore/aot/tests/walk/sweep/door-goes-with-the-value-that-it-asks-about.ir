# const e = new SuppressedError(a, b); define(e, "name", !t);   with a door in front of the store, and nobody reading e
# The store goes with its object. v3 then reaches nothing that stays, so nobody can lean on what the door v4 has asked of it: the door goes with it. v5, a check that stands in front of no store, stays and keeps v2.
# RUN: sweep-code
# CHECK: dropped v3, v4, v6, v7
# CHECK: v2: boolean @Boolean = TypeTest v0
# CHECK-NEXT: v5 @Void = CheckProof v2
# CHECK-NEXT: Return v1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: boolean @Boolean = TypeTest v0 testedType=undefined
#     v3: boolean @Boolean = LogicalNot v2
#     v4 @Void = CheckProof v3 checkedType=true typeWithoutProof=boolean source=Field [goesWithItsValue]
#     v5 @Void = CheckProof v2 checkedType=true typeWithoutProof=boolean source=Field
#     v6: anything @Cell = NewSuppressedError v0, v1 traits=[mayCollect, mayTouchMemory]
#     v7 @Void = PropDefine v6, v3 key="name" traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     Return v1
# }
# -- end of code
