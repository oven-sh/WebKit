# try { for (..) { make a text that nobody reads } } catch { .. }   the walk has listed the text beside the poll of the head: the poll leaves its handler unless the text is kept
# v6 may collect, so a likely turn might come to owe an error; nobody reads it, so it goes, nothing comes to be owed in a turn, and the poll of the head leaves the error owed: the head has no handler edge
# RUN: sweep-code
# CHECK: b2(
# CHECK: dropped handler
# CHECK: = LoopHint {{*}}LeavesOwedError
# CHECK: b3()
# CHECK: dropped handler, v6

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    Return
}

