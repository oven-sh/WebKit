# let x = t; do { x = !x; } while (make() === undefined); return f;   with nothing reading x
# v3 goes round to v2, and v3 alone reads v2. The way comes by v3 before anything has marked it, and nothing marks it later: the circle goes, and v1 with it, which only fed it.
# Each of the four operations is visited once, the three that go among them.
# RUN: sweep-code
# CHECK: b0(
# CHECK: dropped v1
# CHECK: b1(
# CHECK: dropped v2, v3
# CHECK-NOT: LogicalNot
# CHECK: Branch v5 -> taken b1(v3), notTaken b2()
# CHECK: visits of operations: 4

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1: boolean @Boolean = TypeTest v0 testedType=undefined
#     Jump -> next b1(v1)
#   b1(v2: boolean @Boolean) isInLoop=true isLoopHead=true:
#     v3: boolean @Boolean = LogicalNot v2
#     v4: anything @JSValue = Call v0, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v5: boolean @Boolean = TypeTest v4 testedType=undefined
#     Branch v5 -> taken b1(v3), notTaken b2()
#   b2():
#     Return v0
# }
# -- end of code
