# const self = toThis(x); try { f(); } catch (e) { return f(self, e); } return x;
# b2 is reached only once the way has found that v3 stays and may throw. By then b2 stands behind b0 in the list of the blocks, so the way has passed v2, which b2 alone reads, without a mark.
# v2 goes through the worklist and is visited once more. v5 is looked at once more too, where b1 asks whether its handler only throws on: 4 + 1 + 1.
# RUN: sweep-code
# CHECK: v2: anything @Cell = ToThis v0{{*}}uses=1 onlyUser=v5
# CHECK: b1() handler=b2()
# CHECK: b2()
# CHECK: v5: anything @JSValue = Call v1, -, v2, v4
# CHECK-NOT: dropped
# CHECK: visits of operations: 6

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: anything @Cell = ToThis v0 traits=[mayCollect, mayTouchMemory]
#     Jump -> next b1()
#   b1() handler=b2():
#     v3: anything @JSValue = Call v1, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b3()
#   b2() role=CatchHandler:
#     v4: anything @JSValue = CatchValue traits=[mayCollect, mayTouchMemory]
#     v5: anything @JSValue = Call v1, -, v2, v4 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Return v5
#   b3():
#     Return v0
# }
# -- end of code
