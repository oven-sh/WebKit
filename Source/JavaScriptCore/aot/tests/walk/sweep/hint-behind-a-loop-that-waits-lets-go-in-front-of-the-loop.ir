# let a = make(); while ((await x) === undefined) { } a = null; return f;
# The hint lies ahead of the await in every turn, and v2 is made in front of the loop: that the hint lies ahead lives through the loop like a value.
# Nothing behind the await reads v2, so the hint alone would carry it through the saved frame. It clears nothing, the await does not hold v2, and v2 is let go of where it was last named, in b0.
# RUN: sweep-code
# CHECK: v2: anything @JSValue = Call v0
# CHECK-NEXT: # releases v2
# CHECK: v5 @Void = ReleaseHint v2
# CHECK-NOT: ReleasesOperand
# CHECK: # live at v3 [v0, v1]

module m0 path="main.js" displayPath="main.js"
function f0 name="waits" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v1
}
entry module=m0

# -- code
# code f0:CoroutineBody {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: anything @JSValue = Call v0, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b1()
#   b1() isInLoop=true isLoopHead=true:
#     v3: anything @JSValue = AwaitBySavingFrame v0, v1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, maySuspend, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     v4: boolean @Boolean = TypeTest v3 testedType=undefined
#     Branch v4 -> taken b1(), notTaken b2()
#   b2():
#     v5 @Void = ReleaseHint v2
#     Return v0
# }
# -- end of code
