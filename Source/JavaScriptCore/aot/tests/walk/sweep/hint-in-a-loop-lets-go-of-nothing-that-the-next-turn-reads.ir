# const a = make(); do { t = use(a); /* a is let go of */ } while (t === undefined); /* a is let go of */ return x;
# Nothing in b1 behind v3 reads v1, and the next turn does: v1 is live at the head of the loop, so v3 stands behind no last use. v5 does.
# RUN: sweep-code
# CHECK: v3 @Void = ReleaseHint v1
# CHECK-NOT: ReleasesOperand
# CHECK: v5 @Void = ReleaseHint v1{{*}}ReleasesOperand

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1: anything @JSValue = Call v0, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b1()
#   b1() isInLoop=true isLoopHead=true:
#     v2: anything @JSValue = Call v0, -, v1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     v3 @Void = ReleaseHint v1
#     v4: boolean @Boolean = TypeTest v2 testedType=undefined
#     Branch v4 -> taken b1(), notTaken b2()
#   b2():
#     v5 @Void = ReleaseHint v1
#     Return v0
# }
# -- end of code
