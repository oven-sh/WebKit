# x = a === undefined ? (b === undefined ? b : b) : a; return x;
# The ways of the inner branch bring the meeting one value, so it is a jump; the outer ways bring different ones.
# RUN: sweep-code
# CHECK: v2: boolean @Boolean = TypeTest v0
# CHECK-NEXT: Branch v2 -> taken b1(), notTaken b3(v0)
# CHECK: b1(){{*}}dropped v3
# CHECK-NEXT: Jump -> next b3(v1)
# CHECK: Return v4

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: boolean @Boolean = TypeTest v0 testedType=undefined
#     Branch v2 -> taken b1(), notTaken b3(v0)
#   b1():
#     v3: boolean @Boolean = TypeTest v1 testedType=undefined
#     Branch v3 -> taken b2(), notTaken b3(v1)
#   b2():
#     Jump -> next b3(v1)
#   b3(v4: anything @JSValue):
#     Return v4
# }
# -- end of code
