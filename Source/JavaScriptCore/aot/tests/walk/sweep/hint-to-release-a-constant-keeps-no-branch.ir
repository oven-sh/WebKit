# if (a === undefined) { /* the last use of a value that has folded to undefined */ } return b;
# A hint to release a constant lets go of nothing and is dropped where the way comes by: its block does nothing, and the branch in front of it decides nothing.
# RUN: sweep-code
# CHECK: b0({{*}}dropped v0, v3
# CHECK-NOT: TypeTest
# CHECK-NOT: Branch
# CHECK: Jump -> next b2()
# CHECK: dropped b1
# CHECK: Return v1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

# -- code
# code f0:Body {
#   constants:
#     v2: undefined @JSValue = Undefined
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v3: boolean @Boolean = TypeTest v0 testedType=undefined
#     Branch v3 -> taken b1(), notTaken b2()
#   b1():
#     v4 @Void = ReleaseHint v2
#     Jump -> next b2()
#   b2():
#     Return v1
# }
# -- end of code
