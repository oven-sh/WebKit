# const t = b === null; if (t) { if (a === undefined) { } return t; } return b;
# The inner branch decides nothing. Its jump takes over the edge of the last block that it passes, with what that edge hands on: v2, which the outer branch reads too. Both reads are counted:
# counted once, the test would be taken for one that its branch alone reads, and nobody would make its value.
# RUN: sweep-code
# CHECK: v2: boolean @Boolean = TypeTest v1 testedType=null # uses=2
# CHECK: b1()
# CHECK-NOT: Branch
# CHECK: Jump -> next b6(v2)
# CHECK: Return v4

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: boolean @Boolean = TypeTest v1 testedType=null
#     Branch v2 -> taken b1(), notTaken b7()
#   b1():
#     v3: boolean @Boolean = TypeTest v0 testedType=undefined
#     Branch v3 -> taken b2(), notTaken b3()
#   b2():
#     Jump -> next b4()
#   b3():
#     Jump -> next b4()
#   b4():
#     Jump -> next b5()
#   b5():
#     Jump -> next b6(v2)
#   b6(v4: boolean @Boolean):
#     Return v4
#   b7():
#     Return v1
# }
