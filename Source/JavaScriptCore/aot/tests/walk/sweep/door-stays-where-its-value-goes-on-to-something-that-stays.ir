#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: boolean @Boolean = TypeTest v0 testedType=undefined
#     v3: boolean @Boolean = LogicalNot v2
#     v4 @Void = CheckProof v3 checkedType=true typeWithoutProof=boolean source=Field [goesWithItsValue]
#     v5: anything @Cell = NewSuppressedError v0, v1 traits=[mayCollect, mayTouchMemory]
#     v6 @Void = PropDefine v5, v3 key="name" traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     v7: anything @JSValue = Call v1, -, v3 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
