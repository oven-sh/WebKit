# t = a === undefined; n = !t; if (t) door(n); return b;
# The one way holds a door alone, and nothing that stays reads the value that it asks about: the door goes, the way does nothing, the branch decides nothing.
# RUN: sweep-code
# CHECK-NOT: CheckProof
# CHECK-NOT: Branch
# CHECK: Jump -> next b2()
# CHECK: Return v1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

