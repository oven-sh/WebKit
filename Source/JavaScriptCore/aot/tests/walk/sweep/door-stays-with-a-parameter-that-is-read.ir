# function f(a, b) { const e = new SuppressedError(b, b); define(e, "name", a); return a; }   with a door in front of the store
# The store goes with its object, and the parameter that the door asks is handed back: the door stays.
# RUN: sweep-code
# CHECK: dropped v1, v3, v4
# CHECK: v2 @Void = CheckProof v0
# CHECK-NEXT: Return v0

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="name"
    Return v2
}

