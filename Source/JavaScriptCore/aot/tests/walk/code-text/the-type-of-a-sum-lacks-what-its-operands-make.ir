# each operand holds up to 3, and the record says that their sum holds up to 3
# a build that verifies works the operator out on numbers that its operands may hold, and asks no result rule for it
# RUN: verify-code
# CHECK: the record says int[0, 3], and its operands may hold 3 and 3, of which the operator makes 6
# -- code
# code f0:Body {
#   constants:
#     v2: 3 @JSValue = Integer integer=3
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v3: int[0, 3] @Int32 = BitAnd v0, v2 form=Generic traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v4: int[0, 3] @Int32 = BitAnd v1, v2 form=Generic traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v5: int[0, 3] @Int32 = Add v3, v4 form=Integers
#     v6: int[0, 3] @JSValue = Box v5
#     Return v6
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="made" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
entry module=m0
