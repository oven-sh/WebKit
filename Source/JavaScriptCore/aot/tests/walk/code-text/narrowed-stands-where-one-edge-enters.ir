# a Narrowed says what a test has left of a value, so it stands where the test has had that outcome on every way: in a block that the one edge behind the branch enters. Here the failing side comes to the block too
# whoever narrows builds in the block on the edge, never at a later operation
# RUN: verify-code
# CHECK: a Narrowed stands in a block that has not exactly one incoming edge
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1: boolean @Boolean = TypeTest v0 testedType=number
#     Branch v1 -> taken b2(), notTaken b1()
#   b1():
#     Jump -> next b2()
#   b2():
#     v2: number @JSValue = Narrowed v0, v1 [isOnTakenEdge]
#     Return v2
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="picks" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
entry module=m0
