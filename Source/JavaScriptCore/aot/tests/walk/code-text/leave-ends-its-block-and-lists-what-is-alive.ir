# a fast body leaves for good where a test fails: Leave names the frames, the innermost first (function, number of the point, entry of the slow unit, number of values, the input values ascending), and takes what stands for the values, each in the form that it has. Unreachable ends its block.
# RUN: verify-code
# CHECK-NOT: Leave
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: i32 @Int32) entry=0:
#     v2: boolean @Boolean = TypeTest v0 testedType=object
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     Return v0
#   b2() frequency=Rare:
#     v3 @Void = Leave v0, v1 frames=[0, 4, 1, 2, 0, 1] traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Unreachable
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = Add v2, v1
    Return v3
}
entry module=m0
