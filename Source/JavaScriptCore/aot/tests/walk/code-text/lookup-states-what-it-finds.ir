# GetCachedValue has its type from its payload. The run time answers with whatever lies under the name, or with nothing, so a payload that says more states a type
# RUN: verify-code
# CHECK: f0 Body b0 v1 GetCachedValue: the payload says more of what a lookup finds than that it is a value or absent
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1: number @JSValue = GetCachedValue v0 key="size" valueType=number traits=[mayTouchMemory]
#     Return v1
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="sizeOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
entry module=m0
