# test/aot/shell/expectations.py asks for the Body and the CoroutineBody of every function in one call. A unit that the compiler does not make has the bare line and a sentence, and the next unit follows.
# function sum(a, b) { return a + b; }
# function difference(a, b) { return a - b; }
# sink(sum, difference);
# RUN: walk f1:Body f1:CoroutineBody f2:Body
# CHECK: code f1:Body {
# CHECK: code f1:CoroutineBody
# CHECK-NEXT: the plan has no such unit
# CHECK: code f2:Body {

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="sum" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    Return v2
}
function f2 name="difference" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Sub v0, v1
    Return v2
}
