# what is awaited is kept by whoever settles it: a cell of the frame is not awaited
# RUN: verify-code
# CHECK: {{*}}a cell of the frame is stored into what is no cell of the frame
# -- code
# code f0:CoroutineBody {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: Array @Cell = CreateRest firstArgument=0 storage=Frame
#     v3: Array @JSValue = Box v2
#     v4: anything @JSValue = AwaitBySavingFrame v3, v1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, maySuspend, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Return v4
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="waits" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v1
}
entry module=m0
