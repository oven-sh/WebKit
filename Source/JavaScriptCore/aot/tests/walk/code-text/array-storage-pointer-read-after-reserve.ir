#     v5: opaque(ArrayStoragePointer) @RawWord = GetArrayStorage v0 traits=[mayTouchMemory]
#     v6 @Void = ReserveArrayCapacity v3, v2 traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     v7: int[0, 4294967295] @Int64 = GetArrayLength v0 traits=[mayTouchMemory]
#     v8: boolean @Boolean = IsElementPresent v0, v1, v5, -, v7 arrayStorage=Double [keyIsIntegral] traits=[mayTouchMemory]
#     Return v3
# }
# -- end of code

