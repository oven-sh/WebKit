# the sweep: a Leave is never dropped, and whatever it lists is needed, though nothing else reads it: the slow body goes on with it.
# RUN: sweep-code
# CHECK: [[integer]]: i32 @Int32 = ToInt32
# CHECK: = Leave v0, [[integer]] frames=[0, 4, 1, 2, 0, 1]
# CHECK: Unreachable
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: i32 @Int32 = ToInt32 v1 [givesOnlyLowestBits]
#     v3: boolean @Boolean = TypeTest v0 testedType=object
#     Branch v3 -> taken b1(), notTaken b2()
#   b1():
#     Return v0
#   b2() frequency=Rare:
#     v4 @Void = Leave v0, v2 frames=[0, 4, 1, 2, 0, 1] traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Unreachable
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = Add v2, v1
    Return v3
}
entry module=m0
