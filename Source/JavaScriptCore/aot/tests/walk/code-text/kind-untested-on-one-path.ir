# two tests of the kind that the read names stand in the code, and the failed side of one of them reaches the read
# RUN: verify-code
# CHECK: InvalidGuard: {{*}}an access names a kind of storage that a maker of its list is not surely born with
# -- code
# code f0:Body {
#   constants:
#     v2: 1 @JSValue = Integer integer=1
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v3: int[0, 1] @Int32 = BitAnd v1, v2 form=Generic traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v4: Array @Cell = NewArray v0, v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     v5: boolean @Boolean = TypeTest v0 testedType=undefined
#     Branch v5 -> taken b1(), notTaken b2()
#   b1():
#     v6: boolean @Boolean = HasArrayStorage v4 arrayStorage=Double traits=[mayTouchMemory]
#     Branch v6 -> taken b3(), notTaken b5()
#   b2():
#     v7: boolean @Boolean = HasArrayStorage v4 arrayStorage=Double traits=[mayTouchMemory]
#     Branch v7 -> taken b4(), notTaken b6()
#   b3():
#     Jump -> next b7()
#   b4():
#     Jump -> next b7()
#   b5():
#     Return v0
#   b6():
#     Jump -> next b7()
#   b7():
#     v8: undefined|number @JSValue = GetArrayElement v4, v3 arrayStorage=Double level=Proven [keyIsIntegral] traits=[mayThrow, mayThrowByRule, mayCollect, mayTouchMemory]
#     Return v8
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="reads" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
entry module=m0
