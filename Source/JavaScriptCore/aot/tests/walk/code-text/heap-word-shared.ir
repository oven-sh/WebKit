# a heap word goes on from one value to the next, in every turn of a loop, and each read names the type of the value that has the word where the read stands
# RUN: verify-code
# CHECK: verified
# -- code
# code f0:CoroutineBody {
#   v0: undefined @JSValue = Undefined
#   v1: true @JSValue = Boolean boolean=true
#   v2: absent @JSValue = Absent
#   b0(v3: anything @JSValue, v4: anything @JSValue) entry=0:
#     v5: anything?UndescribedNativeResult @JSValue = NewHeapWords numberOfWords=2 traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     v6 @Void = PutHeapFrameWord v5, v0 traits=[mayWriteObservableState, mayTouchMemory]
#     Jump -> next b1()
#   b1() isInLoop=true isLoopHead=true:
#     v7: undefined @JSValue = GetHeapFrameWord v5 valueType=undefined traits=[mayTouchMemory]
#     v8 @Void = PutHeapFrameWord v5, v1 index=1 traits=[mayWriteObservableState, mayTouchMemory]
#     v9: boolean @Boolean = TypeTest v3 testedType=undefined
#     Branch v9 -> taken b2(), notTaken b3()
#   b2() isInLoop=true:
#     v10: true @JSValue = GetHeapFrameWord v5 index=1 valueType=true traits=[mayTouchMemory]
#     v11 @Void = PutHeapFrameWord v5, v0 index=1 traits=[mayWriteObservableState, mayTouchMemory]
#     v12: undefined @JSValue = GetHeapFrameWord v5 index=1 valueType=undefined traits=[mayTouchMemory]
#     v13 @Void = PutHeapFrameWord v5, v2 index=1 traits=[mayWriteObservableState, mayTouchMemory]
#     Jump -> next b1()
#   b3():
#     v14: true @JSValue = GetHeapFrameWord v5 index=1 valueType=true traits=[mayTouchMemory]
#     Return v14
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="waits" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v1
}
entry module=m0
