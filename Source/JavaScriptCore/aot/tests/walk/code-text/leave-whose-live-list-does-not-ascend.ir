# both sides compute the live list from the body, ascending
# RUN: verify-code
# CHECK: the live list of a frame of a Leave does not ascend through values of the body
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: i32 @Int32) entry=0:
#     v2 @Void = Leave v0, v1 frames=[0, 4, 1, 2, 1, 0] traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Unreachable
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = Add v2, v1
    Return v3
}
entry module=m0
