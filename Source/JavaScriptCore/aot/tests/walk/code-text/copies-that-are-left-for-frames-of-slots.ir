# a fast body comes back only from slow bodies that are entered at their heads
# RUN: verify-code
# CHECK: copies are left for frames that are not entered at their heads
# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: anything @JSValue = LeaveCopies v0 function=f0 role=SlowBody frames=[0, 4, 1, 1, 0] traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Return v2
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = Add v2, v1
    Return v3
}
entry module=m0
