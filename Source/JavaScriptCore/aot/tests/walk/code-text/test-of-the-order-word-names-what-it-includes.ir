# one test asks for several bits of the byte of the order word that says whether an object is frozen, has extra properties or has a field outside its slot
# the first of the three tests bears a flag for each of the others that it includes. The flags are the engine's: they are read and printed with Code, and no wire has them
# RUN: code-round-trip
# CHECK: = IsNotFrozen v0 [hasNoExtraProperties, hasNoFieldOutsideSlot]
# CHECK: = IsNotFrozen v0 [hasNoExtraProperties]
# CHECK: = HasNoExtraProperties v0 [hasNoFieldOutsideSlot]
# CHECK: round trip: same
# -- code
# code f0:Body {
#   frame 0 callee=f0
#   b0(v0: L0 @Cell) entry=0:
#     v1: boolean @Boolean = IsNotFrozen v0 [hasNoExtraProperties, hasNoFieldOutsideSlot] traits=[mayTouchMemory]
#     Branch v1 -> taken b1(), notTaken b4()
#   b1():
#     v2: boolean @Boolean = IsNotFrozen v0 [hasNoExtraProperties] traits=[mayTouchMemory]
#     Branch v2 -> taken b2(), notTaken b4()
#   b2():
#     v3: boolean @Boolean = HasNoExtraProperties v0 [hasNoFieldOutsideSlot] traits=[mayTouchMemory]
#     Branch v3 -> taken b3(), notTaken b4()
#   b3():
#     Jump -> next b5()
#   b4() frequency=Unlikely:
#     Jump -> next b5()
#   b5():
#     Return v0
# }
# -- end of code

module m0 path="main.js" displayPath="main.js"
layout L0 name="Box" fields=[{key="w" declared={type=anything}}]
function f0 name="width" parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="w"
    Return v1
}
entry module=m0
