# the keys come out in the order in which the object got them, so each order that an allocation lists has its members written out in that order
# type P = { a: number; b: number };  JSON.stringify({ a: 1, b: 2 });  JSON.stringify({ b: 3, a: 4 });
# RUN: json-plan mechanisms=all
# CHECK: object L0
# CHECK-NEXT: order "a" "b"
# CHECK-NEXT: "a":
# CHECK-NEXT: "b":
# CHECK-NEXT: order "b" "a"
# CHECK-NEXT: "b":
# CHECK-NEXT: "a":

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = Builtin builtin=JSON [isNotReadFromHolder]
    v5 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v6 = Call v5, v4, v3 calleeName="JSON.stringify"
    v7 = Integer integer=3
    v8 = Integer integer=4
    v9 = NewObject -, v7, v8 layout=L0 fields=[1, 0]
    v10 = FinishObject v9
    v11 = Call v5, v4, v10 calleeName="JSON.stringify"
    Return v11
}
