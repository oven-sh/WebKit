# what arrives at the field comes out of code that nobody has read: it may be an object with a toJSON, a proxy, a BigInt. Nothing is proven of the call. A text whose length nobody knows may be too long for a string: no code runs, and the call may throw
# JSON.stringify({ x: sink() });  JSON.stringify({ t: String(sink()) });
# RUN: json-plan mechanisms=all
# CHECK: "x": Generic
# CHECK: code L0 may-run-code
# CHECK: "t": Scalar JSONAppendString
# CHECK: code L1 runs-no-code may-throw

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="t" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Call v1, - calleeName="sink"
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Builtin builtin=JSON [isNotReadFromHolder]
    v6 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v7 = Call v6, v5, v4 calleeName="JSON.stringify"
    v8 = ToString v2
    v9 = NewObject -, v8 layout=L1 fields=[0]
    v10 = FinishObject v9
    v11 = Call v6, v5, v10 calleeName="JSON.stringify"
    Return v11
}
