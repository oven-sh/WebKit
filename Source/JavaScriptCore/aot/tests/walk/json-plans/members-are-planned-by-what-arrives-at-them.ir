# a record that nothing changes and that only JSON.stringify looks at: Link proves that it finds no toJSON and has no property but its fields, so nothing has to be seen of the cell. Each member has the row of what arrives at it
# JSON.stringify({ id: 7, name: "a", ok: true, ratio: 0.5, none: null });
# RUN: json-plan mechanisms=all
# CHECK: object L0 looks=[] guards=[] members-written-out=5 whole
# CHECK-NEXT: order "id" "name" "ok" "ratio" "none"
# CHECK-NEXT: "id": Scalar JSONAppendInteger
# CHECK-NEXT: "name": Scalar JSONAppendString
# CHECK-NEXT: "ok": Scalar JSONAppendBoolean
# CHECK-NEXT: "ratio": Scalar JSONAppendNumber
# CHECK-NEXT: "none": Nullish nullish
# CHECK-NEXT: code L0 runs-no-code may-throw

layout L0 module=m0 fields=[{key="id" declared={type=anything} flags=[IsRequired]}, {key="name" declared={type=anything} flags=[IsRequired]}, {key="ok" declared={type=anything} flags=[IsRequired]}, {key="ratio" declared={type=anything} flags=[IsRequired]}, {key="none" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    v1 = String string="a"
    v2 = Boolean boolean=true
    v3 = Double number=0.5
    v4 = Null
    v5 = NewObject -, v0, v1, v2, v3, v4 layout=L0 fields=[0, 1, 2, 3, 4]
    v6 = FinishObject v5
    v7 = Builtin builtin=JSON [isNotReadFromHolder]
    v8 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v9 = Call v8, v7, v6 calleeName="JSON.stringify"
    Return v9
}
