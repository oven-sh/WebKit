# the record is handed to code that nobody has read: it may have got a property, an accessor, another prototype. Each of the three shows in the cell, so the plan stands behind three looks, and nothing is proven of what the call runs
# const o = { id: 7 };  sink(o);  JSON.stringify(o);
# RUN: json-plan mechanisms=all
# CHECK: object L0 looks=[NoFieldOutsideSlot, HasLayoutPrototype, OrderWordIsKnown] guards=[]
# CHECK-NEXT: order "id"
# CHECK: code L0 may-run-code
# A frozen object is written like any other.
# RUN(FROZEN): json-plan mechanisms=all
# FROZEN-NOT: NotFrozen

layout L0 module=m0 fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v2 calleeName="sink"
    v6 = Builtin builtin=JSON [isNotReadFromHolder]
    v7 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v8 = Call v7, v6, v2 calleeName="JSON.stringify"
    Return v8
}
