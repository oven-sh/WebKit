# each order has the text of its members written out behind a test of its own. An order that objects come in and that has no arm would turn them away at every call, so a layout that is made in five orders has no plan
# JSON.stringify of { a, b, c }, { a, c, b }, { b, a, c }, { b, c, a }, { c, a, b }
# RUN: json-plan mechanisms=all
# CHECK: object L0 has no plan
# What native code does with such an object is another question.
# CHECK-NEXT: code L0 runs-no-code cannot-throw

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}, {key="c" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=JSON [isNotReadFromHolder]
    v2 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v3 = NewObject -, v0, v0, v0 layout=L0 fields=[0, 1, 2]
    v4 = FinishObject v3
    v5 = Call v2, v1, v4 calleeName="JSON.stringify"
    v6 = NewObject -, v0, v0, v0 layout=L0 fields=[0, 2, 1]
    v7 = FinishObject v6
    v8 = Call v2, v1, v7 calleeName="JSON.stringify"
    v9 = NewObject -, v0, v0, v0 layout=L0 fields=[1, 0, 2]
    v10 = FinishObject v9
    v11 = Call v2, v1, v10 calleeName="JSON.stringify"
    v12 = NewObject -, v0, v0, v0 layout=L0 fields=[1, 2, 0]
    v13 = FinishObject v12
    v14 = Call v2, v1, v13 calleeName="JSON.stringify"
    v15 = NewObject -, v0, v0, v0 layout=L0 fields=[2, 0, 1]
    v16 = FinishObject v15
    v17 = Call v2, v1, v16 calleeName="JSON.stringify"
    Return v17
}
