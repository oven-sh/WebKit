    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="toJSON"
    v4 = FinishClass v1 layout=L0
    v5 = String string="a"
    v6 = Construct v4, -, v5
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = FinishObject v7
    v9 = Builtin builtin=JSON [isNotReadFromHolder]
    v10 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v11 = Call v10, v9, v8 calleeName="JSON.stringify"
    Return v11
}
