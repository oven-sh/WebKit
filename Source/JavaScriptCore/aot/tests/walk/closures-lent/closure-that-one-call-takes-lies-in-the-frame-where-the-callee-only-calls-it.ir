# `twice` only calls what arrives: the arrow of `scaled` is written into the frame, no stub makes it. `keep` lays it in a variable, and `last` returns at once what `twice` gives: both arrows are made in the heap.
# f1 = twice, f2 = keep, f3 = scaled, f4 = kept, f5 = last
# -- source: closure-that-one-call-takes-lies-in-the-frame-where-the-callee-only-calls-it.ts
# declare function sink(...values: unknown[]): void;
# let held: ((x: number) => number) | undefined;
# function twice(a: number, f: (x: number) => number): number { let t = a; for (let i = 0; i < 2; i++) t = f(t); return t; }
# function keep(a: number, f: (x: number) => number): number { let t = a; for (let i = 0; i < 2; i++) t = f(t); held = f; return t; }
# function scaled(a: number, k: number) { const t = twice(a, x => x * k); return t + 1; }
# function kept(a: number, k: number) { const t = keep(a, x => x * k); return t + 1; }
# function last(a: number, k: number) { return twice(a, x => x - k); }
# sink(scaled(1, 2), scaled(2, 3), kept(1, 2), kept(2, 3), last(1, 2), last(2, 3), () => held);
# -- end of source
