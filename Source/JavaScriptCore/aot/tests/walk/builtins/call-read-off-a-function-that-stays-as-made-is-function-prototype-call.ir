# CHECK-LABEL: code f2:Body
# CHECK-NOT: key="call"
# RUN(TEST): walk f2 mechanisms=all
# TEST-NOT: = TypeTest
# Tagged has one of its own.
# RUN(OWN): walk f4 mechanisms=all
# OWN-LABEL: code f4:Body
# OWN: key="call"

