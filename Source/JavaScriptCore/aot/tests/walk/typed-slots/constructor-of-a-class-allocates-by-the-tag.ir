# the constructor of a class makes the objects of two interfaces that a literal `kind` tells apart, and allocates its own object: the tag picks the layout where new.target is the class itself, and the allocation as written stands on the other side
# interface Base { kind: number; pos: number }  interface Num extends Base { kind: 1; value: number }  interface Str extends Base { kind: 2; text: string }
# class NodeObject implements Base { kind; pos; constructor(kind: number) { this.kind = kind; this.pos = 0; } }  report(new NodeObject(input)); report(new NodeObject(1));
# RUN: walk f1 mechanisms=all-Inlining
# CHECK-LABEL: code f1:Body
# CHECK: = IsClosureOf {{*}}function=f1
# CHECK: Switch {{*}}cases=[1, 2]
# the allocation as written keeps its prototype operand and the maker's layout
# RUN(WRITTEN): walk f1 mechanisms=all-Inlining
# WRITTEN: [[above]]: {{*}} = GetConstructPrototype
# WRITTEN: = NewObject [[above]] layout=L0
# behind L3 only a member lists `kind`
# RUN(PLAN): plan layouts mechanisms=all
# PLAN: layout L3 None never-allocated
# PLAN: slot 0 "kind"
# RUN(WITHHELD): walk f1 mechanisms=all-TypedSlots
# WITHHELD-LABEL: code f1:Body
# WITHHELD-NOT: Switch
# WITHHELD: = NewObject {{*}}layout=L0
# WITHHELD-NOT: = NewObject

layout L0 kind=Instance name="NodeObject" module=m0 constructor=f1 fields=[{key="kind" declared={type=number} flags=[IsRequired] originLayout=L1 originField=0}, {key="pos" declared={type=number} flags=[IsRequired] originLayout=L1 originField=1}] supertypes=[L1] ownFieldCount=2
layout L1 name="Base" module=m0 fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}] supertypes=[L2, L3] flags=[IsNeverAllocated] ownFieldCount=2 flow={allocation=NeverAllocated}
layout L2 name="Num" module=m0 fields=[{key="kind" declared={type=1} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] supertypes=[L1] flags=[IsNeverAllocated] declaredOrder=[0, 2, 1] ownFieldCount=3 flow={allocation=NeverAllocated}
layout L3 name="Str" module=m0 fields=[{key="kind" declared={type=2} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="text" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}] supertypes=[L1] flags=[IsNeverAllocated] declaredOrder=[0, 2, 1] ownFieldCount=3 flow={allocation=NeverAllocated}
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="report" [isFreeName]
    v5 = PropGet v3 key="input" [isFreeName]
    v6 = Construct v2, -, v5 calleeName="NodeObject"
    v7 = Call v4, -, v6 calleeName="report"
    v8 = Integer integer=1
    v9 = Construct v2, -, v8 calleeName="NodeObject"
    v10 = Call v4, -, v9 calleeName="report"
    Return v10
}
function f1 name="NodeObject" module=m0 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="kind"
    v5 = Integer
    PropSet v3, v5 key="pos"
    Return v3
}
