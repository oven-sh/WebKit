# one constructor function makes the objects of four interfaces that a literal `kind` tells apart, and stores its first parameter under `kind`: where the tag is known at `new`, the allocation names the layout of that member
# interface Base { kind: number; pos: number }  interface Num extends Base { kind: 1; value: number }  interface Str extends Base { kind: 2; text: string }
# interface Low extends Base { kind: 3; level: number }  interface High extends Base { kind: 4; level: number }
# function NodeMaker(this: Base, kind: number) { this.kind = kind; this.pos = 0; }  const Node = NodeMaker as unknown as new (kind: number) => Base;
# function ofAnyKind(kind: number): Base { return new Node(kind); }  function ofOneKind(): Base { return new Node(1); }  function ofEitherLevel(kind: 3 | 4): Base { return new Node(kind); }
# report(ofAnyKind(input)); report(ofOneKind()); report(ofEitherLevel(3)); report(ofEitherLevel(4));
# RUN: walk f3 mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots+DirectCalls+Arrivals
# CHECK-LABEL: code f3:Body
# CHECK: = NewObject {{*}}layout=
# RUN(NEVER): walk f3 f4 mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots+DirectCalls+Arrivals
# NEVER-NOT: = NewObject {{*}}layout=L0
# NEVER-NOT: = Construct
# the prototype object is read off the maker by the maker's own layout, so only the allocation may not name it. A line that excludes ends where the next match begins: it has a run of its own
# RUN(ALL): walk f3 mechanisms=all
# ALL-LABEL: code f3:Body
# ALL: = NewObject {{*}}layout=
# RUN(ALLNEVER): walk f3 mechanisms=all
# ALLNEVER-NOT: = NewObject {{*}}layout=L0
# Low and High list the same names, so they share one layout, and the two tags cover what the parameter is proven to be: no test
# RUN(EITHER): walk f4 mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots+DirectCalls+Arrivals
# EITHER-LABEL: code f4:Body
# EITHER-NOT: Switch
# EITHER: = NewObject {{*}}layout=
# nobody knows the tag: the switch over the tags is as long as the family, so the construction stays a call of the entry that holds it
# RUN(ANY): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots+DirectCalls+Arrivals
# ANY-LABEL: code f2:Body
# ANY-NOT: NewObject
# ANY: = Construct

