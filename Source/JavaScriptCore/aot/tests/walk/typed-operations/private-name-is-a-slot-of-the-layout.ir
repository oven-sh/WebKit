# class P { #x = 1; sum() { return this.#x + 2; } bump() { this.#x = this.#x + 1; } has() { return #x in this; } }
# const p = new P();
# p.bump();
# report(p.sum());
# report(p.has());
# The class declares the name, so it is a field of the layout. On a receiver whose layout is proven, of a class that is evaluated once, the read is a load, the store a store and `in` is answered:
# every construction fills the slot, and nothing empties it. The definitions in the initializer of a class without a parent run on the object just allocated and ask nothing.
# RUN: walk f2 f3 f4 f5 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK-NOT: PrivateGet
# CHECK-NOT: IsSlotFilled
# CHECK: = GetSlot {{*}}key=#"#x"@L0 receivers=[L0] level=Proven
# CHECK-LABEL: code f3:Body
# CHECK-NOT: PrivateSet
# CHECK: = GetSlot {{*}}key=#"#x"@L0 receivers=[L0] level=Proven
# CHECK: = PutSlot {{*}}key=#"#x"@L0 receivers=[L0] level=Proven
# CHECK-LABEL: code f4:Body
# CHECK-NOT: PrivateHas
# CHECK: true {{*}} = Boolean boolean=true
# CHECK-LABEL: code f5:Body
# CHECK-NOT: PrivateDefine
# CHECK: = PutSlotOrAdd {{*}}key=#"#"@L0 receivers=[L0] level=Proven [isDefinition, isExpectedToCreate]
# CHECK: = PutSlotOrAdd {{*}}key=#"#x"@L0 receivers=[L0] level=Proven [isDefinition, isExpectedToCreate]
# Withheld, every one of them stays as it is written.
# RUN(WITHHELD): walk f2 f3 f4 f5 mechanisms=-TypedOperations
# WITHHELD-NOT: GetSlot
# WITHHELD-NOT: PutSlot
# WITHHELD: = PrivateGet
# WITHHELD: = PrivateSet
# WITHHELD: = PrivateHas
# WITHHELD: = PrivateDefine
# WITHHELD: = PrivateDefine

