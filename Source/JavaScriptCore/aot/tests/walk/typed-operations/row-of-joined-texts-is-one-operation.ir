# function line(name, id) { if (typeof name === "string" && typeof id === "number") return "<" + name + ":" + id + ">"; }
# Each `+` alone takes what the one in front of it gives, each part has text by itself, and nothing stands between them but the written texts: one Strcat of the five parts. As four joins they made four ropes, of which three were read by nobody.
# RUN: walk f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = Add
# CHECK: string @Cell = Strcat [[lt]], [[name]], [[colon]], [[id]], [[gt]]
# CHECK-NOT: = Add
# function added(text, name, id) { if (typeof text === "string" && typeof name === "string" && typeof id === "number") return text + (name + id + ","); }   The row may end as the right operand.
# RUN(RIGHT): walk f2:Body mechanisms=none+TypedOperations
# RIGHT-LABEL: code f2:Body
# RIGHT-NOT: = Add
# RIGHT: string @Cell = Strcat [[text]], [[name]], [[id]], [[comma]]
# function seen(a, b, f) { if (typeof a === "string" && typeof b === "string") return a + b + f() + b; }   A text that is too long is refused in front of the call: the first join stays where it is written.
# RUN(CALL): walk f3:Body mechanisms=none+TypedOperations
# CALL-LABEL: code f3:Body
# CALL: string @Cell = Add {{*}}form=Strings
# CALL: = Call
# CALL-NOT: = Strcat
# function anything(a, x) { if (typeof a === "string") return a + x + a; }   `x` may run code where the first join stands.
# RUN(CODE): walk f4:Body mechanisms=none+TypedOperations
# CODE-LABEL: code f4:Body
# CODE-NOT: = Strcat
# function twice(a, b) { if (typeof a === "string" && typeof b === "string") { const both = a + b; return [both + a, both]; } }   The text has a second reader, so it is made.
# RUN(TWICE): walk f5:Body mechanisms=none+TypedOperations
# TWICE-LABEL: code f5:Body
# TWICE-NOT: = Strcat
# function numbers(n, m, a) { if (typeof n === "number" && typeof m === "number" && typeof a === "string") return n + m + a; }   The first `+` adds.
# RUN(SUM): walk f6:Body mechanisms=none+TypedOperations
# SUM-LABEL: code f6:Body
# SUM-NOT: = Strcat
# RUN(WITHHELD): walk f1:Body mechanisms=none
# WITHHELD-LABEL: code f1:Body
# WITHHELD-NOT: = Strcat
# WITHHELD-COUNT-4: = Add

