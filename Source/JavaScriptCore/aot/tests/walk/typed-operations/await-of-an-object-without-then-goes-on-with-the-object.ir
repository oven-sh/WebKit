# no lookup of `then` finds anything on an object of a layout that Link proves closed: the frame is saved as ever, and the function goes on with the object itself, under its own type, so the read behind the await goes by slot
# async function wait(a) { const o = await { x: a }; return o.x; }
# the objects are made in the function and leave it nowhere, so nobody can give one of them a `then`
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: = AwaitBySavingFrame
# CHECK: = GetSlot
# RUN(NEVER): walk f1:CoroutineBody mechanisms=none+TypedOperations
# NEVER-NOT: = PropGet
# RUN(ALL): walk f1:CoroutineBody mechanisms=all
# ALL-LABEL: code f1:CoroutineBody
# ALL: = AwaitBySavingFrame
# RUN(TYPED): walk f1:CoroutineBody mechanisms=all
# TYPED-NOT: = PropGet
# RUN(LINK): link layouts mechanisms=all
# LINK: layout L0 {{*}}changes=[]
# a field under the name answers the lookup
# async function waitForThenable(a) { const o = await { x: a, then: a }; return o.x; }
# RUN(FIELD): walk f2:CoroutineBody mechanisms=none+TypedOperations
# FIELD-LABEL: code f2:CoroutineBody
# FIELD: = AwaitBySavingFrame
# FIELD: = PropGet {{*}}key="x"
# whoever has got hold of the object may have given it the name
# async function waitForSeen(a) { const made = { x: a }; sink(made); const o = await made; return o.x; }
# RUN(SEEN): walk f3:CoroutineBody mechanisms=none+TypedOperations
# SEEN-LABEL: code f3:CoroutineBody
# SEEN: = AwaitBySavingFrame
# SEEN: = PropGet {{*}}key="x"
# a method of the class answers the lookup
# class Later { then(f) { } }  async function waitForInstance() { const o = await new Later(); return o.x; }
# RUN(METHOD): walk f4:CoroutineBody mechanisms=none+TypedOperations
# METHOD-LABEL: code f4:CoroutineBody
# METHOD: = AwaitBySavingFrame
# METHOD: = PropGet {{*}}key="x"

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="then" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L2 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L3 kind=Instance name="Later" module=m0 constructor=f5 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = NewClass v0 layout=L3
    v2 = NewClosure function=f6
    DefineMethod v1, v2 layout=L3 key="then"
    v4 = FinishClass v1 layout=L3
    PutModuleVariable v4 variable=g0
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="sink" [isFreeName]
    v8 = NewClosure function=f1
    v9 = NewClosure function=f2
    v10 = NewClosure function=f3
    v11 = NewClosure function=f4
    v12 = Call v7, -, v8, v9, v10, v11
    Return v12
}
function f1 name="wait" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Await v2
    v4 = PropGet v3 key="x"
    Return v4
}
function f2 name="waitForThenable" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v2 = FinishObject v1
    v3 = Await v2
    v4 = PropGet v3 key="x"
    Return v4
}
function f3 name="waitForSeen" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v2
    v6 = Await v2
    v7 = PropGet v6 key="x"
    Return v7
}
function f4 name="waitForInstance" module=m0 flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Construct v0
    v2 = Await v1
    v3 = PropGet v2 key="x"
    Return v3
}
function f5 name="Later" module=m0 kind=BaseConstructor flags=[HasNewTarget] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L3 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    v3 = Integer integer=1
    PropSet v2, v3 key="x"
    Return v2
}
function f6 name="then" module=m0 kind=Method flags=[HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Undefined
    Return v2
}
