# Every caller of `sum` is known, and all that they pass is a list: no guard stands in front of the body, for its test would tell nothing. What is written of the elements used to come in by the guard alone, so the more Link knew of who arrives, the less the body expected of what the list holds, and a read went by no kind of storage.
# What is proven to lie inside the written type takes what is written of its contents. That is an expectation as before: the read tests what it finds.
# function make() { return [4]; }  function sum(list: number[]) { let s = 0; for (let i = 0; i < list.length; i++) s += list[i]; return s; }  sum(make());
# RUN(LINK): link functions mechanisms=all
# LINK: function f2 callers-known
# LINK-NEXT: parameter 0 {{*}}proven=Array
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: b0(v0: Array<number>
# A text may arrive too: the type that arrives does not lie inside the written one, and nothing of it is cut.
# RUN(BOTH): walk f4 mechanisms=all-ParameterGuards
# BOTH-LABEL: code f4:Body
# BOTH: b0(v0: string|Array

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0, - calleeName="make" [isNeverInlined]
    v2 = NewClosure function=f2
    v3 = Call v2, -, v1 calleeName="sum" [isNeverInlined]
    v4 = NewClosure function=f3
    v5 = Call v4, - calleeName="either" [isNeverInlined]
    v6 = NewClosure function=f4
    v7 = Call v6, -, v5 calleeName="first" [isNeverInlined]
    Return v3
}
function f1 name="make" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    v1 = NewArray v0 contents=anything
    Return v1
}
function f2 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=Array<number>}] results=[{type=anything}] {
  b0(v0: Array<number>):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Add v3, v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
function f3 name="either" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="count" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=4
    v4 = NewArray v3 contents=anything
    Return v4
  b2():
    v5 = String string="text"
    Return v5
}
function f4 name="first" module=m0 length=1 thisType={type=anything} parameters=[{type=Array<number>}] results=[{type=anything}] {
  b0(v0: Array<number>):
    v1 = Integer
    v2 = ElemGet v0, v1
    Return v2
}
