# one layout of the family lists the field, which lies in its cell, and the other is stored it and two more later, so there it lies out of line: the read stays closed. Its receiver is proven all the same, so it gives what Link has proven of the field in either layout and not `anything`
# interface Shape { }  type Circle = { inner: Point }  type Square = { side: string }  function get(s: Shape) { return s.inner.x; }  square.inner = point; square.next = square.last = "a";  get(circle); get(square);
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f1:Body
# CHECK: [[inner]]: undefined|L3 {{*}} = PropGet {{*}}key="inner"
# The read behind it has one layout to go by, once the check that throws for undefined has passed.
# CHECK: [[checked]]: L3 {{*}} = RequireObjectCoercible [[inner]] name="x"
# CHECK: : string {{*}} = GetSlot {{*}}key="x"

layout L0 name="Shape" module=m0 flags=[IsNeverAllocated]
layout L1 name="Circle" module=m0 fields=[{key="inner" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Square" module=m0 fields=[{key="side" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L3 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = FinishObject v3
    PropSet v4, v1 key="inner"
    PropSet v4, v0 key="next"
    PropSet v4, v0 key="last"
    v8 = NewClosure function=f1
    v9 = Call v8, -, v2 calleeName="get"
    v10 = Call v8, -, v4 calleeName="get"
    Return v0
}
function f1 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="inner"
    v2 = PropGet v1 key="x"
    Return v2
}
