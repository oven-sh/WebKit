# in a loop two properties that the objects of a class leave out are read off an object that unseen code has in hand, so both reads stand behind looks at the cell and behind a guard of the class and the name.
# Between the two reads an object of a layout that has nothing to do with the class is allocated. The allocation declares a write of the guards of all classes, and ends none of this one: the guard is asked once a turn
# the two reads and the allocation are one stretch behind one row of tests. A call between them would end the looks, and a rejoin with a closed arm all that the typed run knows: there the guard is asked again whatever is allocated
# f1 = apart, f2 = Meter
# class Meter { limit?; label? }  function apart(o: Meter, n) { let x; while (n()) { const low = o.limit; const held = { low }; x = [held, o.label]; } return x; }  sink(apart, new Meter());
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = AreMembersUnchanged
# CHECK: = GetSlotOrUndefined {{*}}key="limit"
# CHECK: = NewObject
# CHECK-NOT: = AreMembersUnchanged
# CHECK: = GetSlotOrUndefined {{*}}key="label"

layout L0 kind=Instance name="Meter" module=m0 constructor=f2 fields=[{key="limit" declared={type=anything}}, {key="label" declared={type=anything}}] ownFieldCount=2
layout L1 module=m0 fields=[{key="low" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = NewClosure function=f1
    v6 = Construct v2
    v7 = Call v4, -, v5, v6
    Return v7
}
function f1 name="apart" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v2 key="limit"
    v9 = NewObject -, v8 layout=L1 fields=[0]
    v10 = FinishObject v9
    v11 = PropGet v2 key="label"
    v12 = NewArray v10, v11
    Jump -> next b1(v12)
  b3():
    Return v4
}
function f2 name="Meter" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
