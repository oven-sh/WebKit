# -- source: list-is-made-with-room-for-the-members-of-the-sets-spread-into-it.js
# const numbers = new Set([1, 2, 3]);
# function behind(i) { return [i, ...numbers]; }
# function twice() { return [...numbers, ...numbers]; }
# sink(behind, twice);
