# an operator whose operands are proven numbers may stand between two links of a row of joins: nobody can tell whether it has run, so the row is one Strcat of all its parts
# function cell(name, i) { if (typeof name === "string" && typeof i === "number") return name + "[" + (i + 1) + "]"; }
# function code(name, x) { if (typeof name === "string") return name + "[" + (x + 1) + "]"; }   the sum may run code of `x`, which sees whether a text that is too long was refused in front of it: the first join stays where it is written
# each function is handed to code that nobody has seen
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = Strcat [[name]], [[open]], [[next]], [[close]] traits
# RUN(ONLY): walk f1 mechanisms=none+TypedOperations
# ONLY-NOT: form=Strings
# RUN(SUM): walk f1 mechanisms=none+TypedOperations
# SUM-COUNT-1: = Add
# SUM-NOT: = Add
# RUN(CODE): walk f2 mechanisms=none+TypedOperations
# CODE-LABEL: code f2:Body
# CODE: = Add {{*}}form=Strings
# RUN(CUT): walk f2 mechanisms=none+TypedOperations
# CUT-NOT: = Strcat [[name]], [[open]], [[next]], [[close]] traits
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = Strcat
# RUN(ALLONLY): walk f1 mechanisms=all
# ALLONLY-NOT: form=Strings

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="cell" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = TypeTest v1 testedType=number
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = String string="["
    v7 = Add v3, v6
    v8 = Integer integer=1
    v9 = Add v5, v8
    v10 = Add v7, v9
    v11 = String string="]"
    v12 = Add v10, v11
    Return v12
  b3():
    v13 = Undefined
    Return v13
}
function f2 name="code" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = String string="["
    v5 = Add v3, v4
    v6 = Integer integer=1
    v7 = Add v1, v6
    v8 = Add v5, v7
    v9 = String string="]"
    v10 = Add v8, v9
    Return v10
  b2():
    v11 = Undefined
    Return v11
}
