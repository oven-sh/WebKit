    InitialYield
    v3 = Await v1
    v4 = Yield v3
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Switch v6 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    v7 = Undefined
    Throw v5
  b2():
    Return v5
  b3():
    v8 = Undefined
    Return v8
}
