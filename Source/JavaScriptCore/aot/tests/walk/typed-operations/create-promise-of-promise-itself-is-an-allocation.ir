# CHECK-LABEL: code f1:Body
# CHECK: = NewPromise
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = CreatePromise
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = NewPromise
# any other constructor has to be asked for its `prototype`
# RUN(OTHER): walk f2 mechanisms=all
# OTHER-LABEL: code f2:Body
# OTHER: = CreatePromise
# RUN(ASKED): walk f2 mechanisms=all
# ASKED-NOT: = NewPromise
# function makeOfArray() { return $createPromise(Array); }
# RUN(BUILTIN): walk f3 mechanisms=all
# BUILTIN-LABEL: code f3:Body
# BUILTIN: = CreatePromise

