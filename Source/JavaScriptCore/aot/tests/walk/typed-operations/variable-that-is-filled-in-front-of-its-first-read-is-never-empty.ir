# the cell of the variable starts empty, and the front end knows that no read comes in front of the first store: it writes no `absent` into the type and no check in front of a read. So a read gives a value
# function make() { return { kept: WORD }; }  <WORD is filled first>  make().kept
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: [[word]]: string @{{*}} = GetModuleVariable
# CHECK: = NewObject {{*}}[[word]]{{*}}layout=L0

layout L0 module=m0 fields=[{key="kept" declared={type=string} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="make" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="WORD" module=m0 declared={type=string} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="one"
    PutModuleVariable v0 variable=g1
    v2 = GetModuleVariable variable=g0
    v3 = Call v2 calleeName="make"
    v4 = PropGet v3 key="kept"
    Return v4
}
function f1 name="make" module=m0 thisType={type=anything} results=[{type=L0}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = Convert v0 declared={type=string}
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    Return v3
}
