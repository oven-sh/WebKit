# function inside(view: Uint8Array, i) { const k = i >>> 0; if (k < view.length) return view[k]; }
# function behindOtherCode(view: Uint8Array, i) { const k = i >>> 0; if (k < view.length) { keep(); return view[k]; } }
# function next(view: Uint8Array, i) { const k = i >>> 0; if (k < view.length) return view[k + 1]; }
# function stored(view: Uint8Array, i) { const k = i >>> 0; if (k < view.length) { view[k] = 7; return view[k]; } }
# The length that was read is noted of the view until something may write the storage of views. A position that is an index below it lies inside the view: the access asks no bound, and a read gives no undefined.
# Code that nobody has seen may resize a buffer or hand it away, so behind it the read asks again. The position behind one that lies inside may be the length itself.
# GetTypedArrayElement and PutTypedArrayElement once had the mark, its result rule and its code, and nobody set it.
# RUN: walk f1 f2 f3 f4 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[length]]: {{*}} = GetTypedArrayLength
# CHECK: = Less {{*}}, [[length]] form=Integers
# CHECK: : int[0, 255] {{*}} = GetTypedArrayElement {{*}}isInsideView]
# CHECK-LABEL: code f2:Body
# CHECK: = GetTypedArrayLength
# CHECK: = Call
# CHECK: : undefined|int[0, 255] {{*}} = GetTypedArrayElement {{*}}[keyIsIntegral]
# CHECK-LABEL: code f3:Body
# CHECK: : undefined|int[0, 255] {{*}} = GetTypedArrayElement {{*}}[keyIsIntegral]
# CHECK-LABEL: code f4:Body
# CHECK: = PutTypedArrayElement {{*}}isInsideView]
# RUN(SHELL): run-in-shell globalThis.keep = () => { }; globalThis.pick = () => 3; globalThis.sink = (...all) => { print(all.map(String).join(" ")); };
