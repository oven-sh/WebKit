# -- source: static-field-is-read-and-stored-in-its-variable.ts
# declare function print(...values: unknown[]): void;
# class Meter { static raw = 1; }
# function both(times: number) { let total = 0; for (let i = 0; i < times; i++) { Meter.raw = i & 7; total += Meter.raw; } return total; }
# print(both(5), Meter.raw);
# Object.defineProperty(Meter, "raw", { get() { return 100; }, set(v) {}, configurable: true });
# print(both(5), Meter.raw);
# -- end of source
# records of c876f3a87607bff9
# While the class object is not made, the field lies in the variable that the record of the class names for it. The read gives the word, or absent where the field does not lie there or something has been put on the cell;
# absent: the access goes as it is written. The store comes behind such a read. The second read stands behind the store, which writes what the read reads: it is asked again.
# The accessor that is laid between the two calls makes the class object, which empties the variable for good: the same code then runs the accessor.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetStaticFieldOrAbsent {{*}}valueType=absent|anything
# CHECK: = TypeTest {{*}}testedType=absent
# CHECK: = PropSet {{*}}key="raw"
# CHECK: = PutStaticField
# CHECK: = GetStaticFieldOrAbsent {{*}}valueType=absent|anything
# CHECK: = TypeTest {{*}}testedType=absent
# CHECK: = PropGet {{*}}key="raw"
# RUN(ANSWERS): run-in-shell
# ANSWERS: 10 4
# ANSWERS: 500 100

