# between a generator and %GeneratorPrototype% stands the object under `prototype` of its function. Where every call of the function goes into one iteration and nobody asks a closure of it for a name, nobody can look there: the ramp makes the generator without the function
# f1 = count, f2 = kept, f3 = asked
# -- source: generator-that-iterations-alone-take-has-no-prototype-object.ts
# declare function sink(...values: unknown[]): number;
# function* count(n: number) { for (let i = 0; i < n; i++) yield i; }
