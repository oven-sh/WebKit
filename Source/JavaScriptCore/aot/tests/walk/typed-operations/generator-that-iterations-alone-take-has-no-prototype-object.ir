# function* asked(n: number) { for (let i = 0; i < n; i++) yield i; }
# for (const x of count(3)) sink(x);
# sink(...count(2));
# const held = kept(3);
# for (const x of held) sink(x, held);
# for (const x of asked(3)) sink(x);
# sink(asked.prototype);
