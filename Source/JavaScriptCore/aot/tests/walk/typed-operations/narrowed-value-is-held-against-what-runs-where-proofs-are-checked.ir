# testing=CheckProofsAtRunTime: a Narrowed is a new proof about an old value, and that it stands on the edge on which its test says so is the word of whoever built it.
# Behind each stands a CheckProof that takes the value for what it was in front of the test. An edge may hand over several: the checks stand among them, at the head of the block.
# function use(f, flag) { const first = f === undefined ? 0 : f(); return flag ? f : first; }
# OPTIONS: testing=CheckProofsAtRunTime check=Validate
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: b0([[f]]: undefined|null|f1
# CHECK: [[isUndefined]]: boolean @Boolean = TypeTest [[f]] testedType=undefined
# CHECK: [[nothing]]: undefined @JSValue = Narrowed [[f]], [[isUndefined]] [isOnTakenEdge]
# CHECK: CheckProof [[nothing]] checkedType=undefined typeWithoutProof=undefined|null|absent|f1 source=Test
# CHECK: [[rest]]: null|f1 @JSValue = Narrowed [[f]], [[isUndefined]]
# CHECK: CheckProof [[rest]] checkedType=null|f1 typeWithoutProof=undefined|null|absent|f1 source=Test
# The test that the walk itself builds in front of the call.
# CHECK: [[closure]]: f1 @JSValue = Narrowed
# CHECK: CheckProof [[closure]] checkedType=f1 typeWithoutProof={{*}}absent|f1 source=Test

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Boolean boolean=true
    v4 = Boolean
    v5 = Undefined
    v6 = Null
    v7 = Call v1, -, v0, v3
    v8 = Call v1, -, v5, v4
    v9 = Call v1, -, v6, v4
    v10 = Call v2, -, v0, v3
    v11 = Call v2, -, v5, v4
    v12 = Call v2, -, v6, v4
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="sink" [isFreeName]
    v15 = Call v14, -, v7, v8, v9, v10, v11, v12
    Return v15
}
function f1 name="work" module=m0 position=1 sourceRange={start=1 end=29} thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1 @25
    Return v0 @25
}
