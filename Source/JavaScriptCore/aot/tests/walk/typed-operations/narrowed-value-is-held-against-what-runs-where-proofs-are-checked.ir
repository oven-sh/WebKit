  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=undefined @70
    Branch v2 -> taken b1(| 0), notTaken b2(| 0) @70
  b1(v3):
    v4 = Integer @88
    Jump -> next b3(v4) @88
  b2(v5):
    v6 = Call v0 calleeName="f" @92
    Jump -> next b3(v6) @92
  b3(v7):
    v8 = ToBoolean v1 @106
    Branch v8 -> taken b4(), notTaken b5() @106
  b4():
    Return v0 @113
  b5():
    Return v7 @117
}
