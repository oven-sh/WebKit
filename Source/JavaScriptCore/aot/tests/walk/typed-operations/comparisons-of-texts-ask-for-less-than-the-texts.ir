# a length that is only asked for zero is asked of the cell, two relations on two texts share one order, a relation with one written character reads one code unit,
# and a row of comparisons of one subject with written texts shares its length
# function isEmpty(s) { if (typeof s === "string") return [s.length === 0]; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = ToBoolean
# CHECK: = LogicalNot
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = GetStringLength
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: = GetStringLength
# function hasText(s) { if (typeof s === "string" && s.length) return 1; }
# RUN(TRUTHY): walk f2 mechanisms=none+TypedOperations
# TRUTHY-NOT: = GetStringLength
# function isFilled(s) { if (typeof s === "string") return [s.length > 0]; }
# RUN(FILLED): walk f3 mechanisms=none+TypedOperations
# FILLED-NOT: = GetStringLength
# the cell does not say whether the length is one: function isOne(s) { if (typeof s === "string") return [s.length === 1]; }
# RUN(ONE): walk f4 mechanisms=none+TypedOperations
# ONE-LABEL: code f4:Body
# ONE: = GetStringLength
# function order(a, b) { if (typeof a === "string" && typeof b === "string") return a < b ? -1 : a > b ? 1 : 0; }
# RUN(ORDER): walk f5 mechanisms=none+TypedOperations
# ORDER-LABEL: code f5:Body
# ORDER: [[order]]: {{*}} = StringOrder
# ORDER: = Less [[order]]
# ORDER-NOT: = StringOrder
# ORDER: = Greater [[order]]
# one relation alone is asked as it is written: function isBelow(a, b) { if (typeof a === "string" && typeof b === "string") return [a < b]; }
# RUN(ALONE): walk f6 mechanisms=none+TypedOperations
# ALONE-LABEL: code f6:Body
# ALONE-NOT: = StringOrder
# ALONE: = Less
# function below(s, n) { if (typeof s !== "string") return; let c = 0; for (let i = 0; i < n; i++) if (s < "a") c++; return c; }
# RUN(LETTER): walk f7 mechanisms=none+TypedOperations
# LETTER-LABEL: code f7:Body
# LETTER: = StringOrderToCharacter {{*}}codeUnit=97
# function verbs(s, n) { if (typeof s !== "string") return; let c = 0; for (let i = 0; i < n; i++) if (s === "get" || s === "put" || s === "post") c++; return c; }
# RUN(VERBS): walk f8 mechanisms=none+TypedOperations
# VERBS-LABEL: code f8:Body
# behind "get" the length tells "put" apart from nothing: `e.kind === "num" .. e.kind === "add"` stays the comparison of two strings
# VERBS-NOT: = GetStringLength
# VERBS: = StrictEq {{*}}form=Strings
# VERBS-NOT: = GetStringLength
# VERBS: = StrictEq {{*}}form=Strings
# VERBS: [[length]]: {{*}} = GetStringLength
# VERBS: = StringEqualsLiteral {{*}}, [[length]] literal="post"
# outside a loop the characters in line do not pay: function verb(s) { if (typeof s === "string") { if (s === "get") return 1; if (s === "put") return 2; if (s < "a") return 3; } }
# RUN(ONCE): walk f9 mechanisms=none+TypedOperations
# ONCE-LABEL: code f9:Body
# ONCE-NOT: = StringEqualsLiteral
# ONCE-NOT: = StringOrderToCharacter
# ONCE: Return

