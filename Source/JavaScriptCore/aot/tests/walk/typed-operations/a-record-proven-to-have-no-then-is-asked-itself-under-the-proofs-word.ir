# function make() { return { n: 1 }; }
# async function take() { const box = await make(); return box.n; }
# That a record has no `then` is a proof of Link's, and no test stands behind it. Under the proofs' word the record itself is asked wherever the walk leans on the proof: by an inquiry that makes nothing and that stops by name.
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls testing=CheckProofsAtRunTime
# CHECK: [[box]]: L0 @JSValue = CallDirect
# CHECK: [[asked]]: boolean @Boolean = FindsNoMember [[box]] key="then" {{*}}asksObjectByInquiry
# CHECK-NEXT: CheckProof [[asked]] checkedType=true
# CHECK: = AwaitBySavingFrame [[box]]
# RUN(EMIT): emit f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls testing=CheckProofsAtRunTime
# EMIT: = Const32(2305)
# without the word nothing is asked
# RUN(PLAIN): walk f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls
# PLAIN: = AwaitBySavingFrame
# RUN(NEVER): walk f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls
# NEVER-NOT: FindsNoMember
# a number is no object: nothing is asked of it
# async function takeNumber() { return await 1; }
# RUN(NUMBER): walk f3:CoroutineBody mechanisms=none+TypedOperations+DirectCalls testing=CheckProofsAtRunTime
# NUMBER: = AwaitBySavingFrame
# RUN(NOTHING): walk f3:CoroutineBody mechanisms=none+TypedOperations+DirectCalls testing=CheckProofsAtRunTime
# NOTHING-NOT: FindsNoMember

