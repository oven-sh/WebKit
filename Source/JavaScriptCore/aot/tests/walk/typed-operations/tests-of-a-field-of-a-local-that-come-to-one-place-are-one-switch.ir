# each alternative reads `node.kind` anew and hands a proof and a narrowed holder on along both of its edges. The first block has read the field out of its slot and nothing that is seen happens between the reads: one read, one Switch with two ways, and no block between the comparisons is built
# function pick(node) { if (node.kind === 1 || node.kind === 4) return node.kind + 100; return node.kind; }   as lower/condition.rs split_on_comparison() writes it
# f2 is the same function handed to code that nobody has seen, so its read is no read of a slot and may run a getter each time: every read stays . in f3 the second alternative reads the field off another object, so nothing goes on behind the first
# f1 and f3 are called from f0 alone, with literals, so Link proves their parameters. The walk takes that proof with Arrivals
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f1:Body
# CHECK: = GetSlot {{*}}key="kind"
# CHECK: Switch {{*}}cases=[1, 4] -> case [[listed]](), case [[listed]](), otherwise [[rest]]()
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# NEVER-NOT: Branch
# RUN(ALL): walk f1 mechanisms=all
# ALL: Switch {{*}}cases=[1, 4]
# RUN(OTHERS): walk f2 f3 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# OTHERS-NOT: Switch
# RUN(GETTER): walk f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# GETTER: key="kind"
# GETTER: Branch
# GETTER: key="kind"
# GETTER: Branch
# RUN(SHELL): run-in-shell let next = 0; const kinds = [1, 4, 5, "4", -0]; globalThis.source = () => kinds[next++ % kinds.length]; let ran = 0; globalThis.sink = (a, b, c, d, e, either, pick) => { print([a, b, c, d, e, either].join()); print(String(pick({ get kind() { ran++; return 9; } })), String(ran)); ran = 0; print(String(pick({ get kind() { return ++ran === 2 ? 4 : 0; } })), String(ran)); };
# SHELL: 101,104,5,4,0,10
# SHELL-NEXT: 9 3
# SHELL-NEXT: 100 3
# SHELL-NEXT: exited with 0

layout L0 name="Node" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="source" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f3
# REPEAT: i = 0..4
    v%(i*4+4) = Call v1, -
    v%(i*4+5) = NewObject -, v%(i*4+4) layout=L0 fields=[0]
    v%(i*4+6) = FinishObject v%(i*4+5)
    v%(i*4+7) = Call v2, -, v%(i*4+6)
# END REPEAT
    v24 = Call v3, -, v6, v10
    v25 = NewClosure function=f2
    v26 = PropGet v0 key="sink" [isFreeName]
    v27 = Call v26, -, v7, v11, v15, v19, v23, v24, v25
    Return v27
}
# REPEAT: f = 1 2; type = L0 anything
function f%(f) name="pick%(f)" module=m0 length=1 thisType={type=anything} parameters=[{type=%(type) flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: %(type)):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b6(v5)
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Jump -> next b3()
  b3():
    v8 = PropGet v7 key="kind"
    v9 = Integer integer=4
    v10 = StrictEq v8, v9
    Branch v10 -> taken b4(| 0), notTaken b5(| 0)
  b4(v11):
    v12 = NarrowByField v7, v11 key="kind"
    Jump -> next b6(v12)
  b5(v13):
    v14 = NarrowByField v7, v13 key="kind"
    Jump -> next b7()
  b6(v15):
    v16 = PropGet v15 key="kind"
    v17 = Integer integer=100
    v18 = Add v16, v17
    Return v18
  b7():
    v19 = PropGet v14 key="kind"
    Return v19
}
# END REPEAT
function f3 name="pickOfEither" module=m0 length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0, v1: L0):
    v2 = PropGet v0 key="kind"
    v3 = Integer integer=1
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    v6 = NarrowByField v0, v5 key="kind"
    Jump -> next b6()
  b2(v7):
    v8 = NarrowByField v0, v7 key="kind"
    Jump -> next b3()
  b3():
    v9 = PropGet v1 key="kind"
    v10 = Integer integer=4
    v11 = StrictEq v9, v10
    Branch v11 -> taken b4(| 0), notTaken b5(| 0)
  b4(v12):
    v13 = NarrowByField v1, v12 key="kind"
    Jump -> next b6()
  b5(v14):
    v15 = NarrowByField v1, v14 key="kind"
    Jump -> next b7()
  b6():
    v16 = Integer integer=10
    Return v16
  b7():
    v17 = Integer integer=20
    Return v17
}
