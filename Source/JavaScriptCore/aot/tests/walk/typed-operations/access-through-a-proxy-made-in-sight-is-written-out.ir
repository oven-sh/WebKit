    v3 = NewClosure function=f5
    v4 = NewClosure function=f6
    v5 = NewClosure function=f8
    v6 = NewClosure function=f9
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="sink" [isFreeName]
    v9 = Call v8, -, v0, v1, v2, v3, v4, v5, v6
    Return v9
}
