# the receiver is the record that this unit built for `new Proxy(target, handler)`, and such a proxy is never revoked: the trap is read off the handler and called, and its answer is held against the target only where the target may bind it
# function reads(v) { const p = new Proxy({ x: v }, { get(t, k) { return 1; } }); return p.x; }   and the same for `p.x = v`, `"x" in p`, `delete p.x`, `Object.hasOwn(p, "x")`, `p[k]`
# in `handed` the proxy comes from outside, and the access stays as written
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls
# CHECK-LABEL: code f1:Body
# CHECK: = PropGet {{*}}key="get"
# CHECK: = MayBindAnswersOfGetAndSetTraps
# CHECK: ValidateAnswerOfGetTrap
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls
# NEVER-NOT: = PropGet {{*}}key="x"
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = MayBindAnswersOfGetAndSetTraps
# RUN(STORE): walk f3 mechanisms=all
# STORE-LABEL: code f3:Body
# STORE: FinishStoreByTrap
# RUN(HAS): walk f4 mechanisms=all
# HAS-LABEL: code f4:Body
# HAS: = MayBindAnswersOfHasTraps
# HAS: ValidateDenialOfHasTrap
# RUN(DELETE): walk f5 mechanisms=all
# DELETE-LABEL: code f5:Body
# DELETE: ValidateConsentOfDeleteTrap
# RUN(OWN): walk f6 mechanisms=all
# OWN-LABEL: code f6:Body
# OWN: = HasOwnByAnswerOfDescriptorTrap
# RUN(KEYED): walk f8 mechanisms=all
# KEYED-LABEL: code f8:Body
# KEYED: = ElemGet
# KEYED: = MayBindAnswersOfGetAndSetTraps
# RUN(HANDED): walk f9 mechanisms=all
# HANDED-LABEL: code f9:Body
# HANDED-NOT: MayBindAnswers
# HANDED: = PropGet {{*}}key="x"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L2 module=m0 fields=[{key="get" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L3 module=m0 fields=[{key="set" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L4 module=m0 fields=[{key="has" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L5 module=m0 fields=[{key="deleteProperty" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L6 module=m0 fields=[{key="getOwnPropertyDescriptor" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
