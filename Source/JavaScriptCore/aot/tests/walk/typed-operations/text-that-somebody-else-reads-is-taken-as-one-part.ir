# the text that was joined in the earlier block is read twice: it is returned on one way and joined with more on the other. It is made for whoever returns it, so the later join takes it as one part and spells no number again
# function label(x, c) { const s = "a" + (x | 0); if (c) return s + "!"; return s; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK: mechanisms TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-2: = Add
# CHECK-NOT: = Add
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-LABEL: code f1:Body
# NEVER-NOT: = Strcat

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="label" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    v3 = BitOr v0, v2
    v4 = String string="a"
    v5 = Add v4, v3
    v6 = ToBoolean v1
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    v7 = String string="!"
    v8 = Add v5, v7
    Return v8
  b2():
    Return v5
}
