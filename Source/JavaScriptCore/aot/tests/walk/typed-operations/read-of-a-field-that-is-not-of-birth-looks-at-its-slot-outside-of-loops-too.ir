# function make() {
#   function Box(value, fills) { this.tag = 1; if (fills) this.held = value; }
#   Box.prototype.peek = function peek() { return this.held; };
#   Box.prototype.both = function both() { return [this.tag, this.held]; };
#   return Box;
# }
# globalThis.First = make();        globalThis.Second = make();
# `held` is not of birth, and Box may be evaluated again: nobody answers for what stands above its objects, so no looks at the cell make an empty slot read undefined. In a loop such a read looks at its slot as
# the last resort: filled, the slot holds the object's own value, whatever stands above; empty, the read goes as it is written. Outside of loops it had no typed form at all, so a guess at the receiver opened
# nothing: `target._events` in node:events. The last resort is the same in both places. The two methods are marked as of a file that the checker has checked, where looks at the cell pay, and their receivers are
# expected by what is written in the records (both by hand), not by what was seen to arrive. Where looks do not pay the reads stay closed: ../guesses/property-that-objects-leave-out-opens-nothing.ir
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: GetSlot v0 key="held" receivers=[L0] level=Expected
# CHECK-NOT: PropGet
# Beside one field of birth each read is one operation of its own: look-of-the-last-resort-stands-at-its-own-read.ir says why the look does not stand in front of a stretch that opens without it.
# RUN(BOTH): walk f4 mechanisms=all
# BOTH-LABEL: code f4:Body
# BOTH: GetSlot v0 key="tag" receivers=[L0] level=Expected
# BOTH: GetSlot v0 key="held" receivers=[L0] level=Expected

