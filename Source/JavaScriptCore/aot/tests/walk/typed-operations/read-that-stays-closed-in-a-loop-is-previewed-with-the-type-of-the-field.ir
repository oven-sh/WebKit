# the look at a loop types the closed read by the same rule as the walk. If the look said `anything`, what comes round would be lost and the read behind the loop would stay closed. If the look said more than the walk, the walk would stop: what comes round lies outside the previewed type
# function last(s: Shape, n) { let p = s.inner; for (let i = 0; i < n; i++) p = s.inner; return p.x; }  square.inner = point;  last(circle, 3); last(square, 3);
# The circle lists the field, which lies in its cell. The square is stored it later, so there it lies out of line and may be missing: the read through the family stays closed.
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f1:Body
# CHECK: : undefined|L3 {{*}} = PropGet {{*}}key="inner"
# CHECK: ([[p]]: undefined|L3 {{*}}
# CHECK: : undefined|L3 {{*}} = PropGet {{*}}key="inner"
# CHECK: : L3 {{*}} = RequireObjectCoercible [[p]] name="x"
# CHECK: : string {{*}} = GetSlot {{*}}key="x"
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: failed
# ALL: : string {{*}}key="x"

layout L0 name="Shape" module=m0 flags=[IsNeverAllocated]
layout L1 name="Circle" module=m0 fields=[{key="inner" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Square" module=m0 fields=[{key="side" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L3 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = FinishObject v3
    PropSet v4, v1 key="inner"
    v6 = NewClosure function=f1
    v7 = Integer integer=3
    v8 = Call v6, -, v2, v7 calleeName="last"
    v9 = Call v6, -, v4, v7 calleeName="last"
    Return v0
}
function f1 name="last" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="inner"
    v3 = Integer
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v0 key="inner"
    v9 = Increment v5
    Jump -> next b1(v8, v9)
  b3():
    v10 = PropGet v4 key="x"
    Return v10
}
