function f5 name="untyped" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = Double number=0.5
