# no type says which names the object will have. The copy and the definitions that are written behind it are one operation, and so are the copies of two sources: nobody has the object until it is built
# function named(o, v) { return { ...o, name: v, size: 1 }; }   function both(a, b) { return { ...a, ...b }; }   in `between` a call stands between the copy and the definition . in `twice` one name is defined twice
# all are handed to sink, so they may come again and nothing is known of their sources
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = CopyObjectAndDefine
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: PropDefine
# NEVER-NOT: = CopyObject v
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = CopyObjectAndDefine
# RUN(BOTH): walk f2 mechanisms=all
# BOTH-LABEL: code f2:Body
# BOTH-NOT: CopyDataProperties
# BOTH: = CopyTwoObjects
# BOTH-NOT: CopyDataProperties
# RUN(BETWEEN): walk f3 mechanisms=all
# BETWEEN-LABEL: code f3:Body
# BETWEEN-NOT: CopyObjectAndDefine
# BETWEEN: PropDefine {{*}}key="name"
# RUN(TWICE): walk f4 mechanisms=all
# TWICE-LABEL: code f4:Body
# TWICE: = CopyObjectAndDefine
# TWICE: PropDefine {{*}}key="name"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Call v5, -, v0, v1, v2, v3
    Return v6
}
function f1 name="named" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CopyObject v0
    PropDefine v2, v1 key="name"
    v4 = Integer integer=1
    PropDefine v2, v4 key="size"
    Return v2
}
function f2 name="both" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CopyObject v0
    CopyDataProperties v2, v1
    Return v2
}
function f3 name="between" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CopyObject v0
    v3 = Call v1, -
    PropDefine v2, v3 key="name"
    Return v2
}
function f4 name="twice" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CopyObject v0
    PropDefine v2, v1 key="name"
    PropDefine v2, v0 key="name"
    Return v2
}
