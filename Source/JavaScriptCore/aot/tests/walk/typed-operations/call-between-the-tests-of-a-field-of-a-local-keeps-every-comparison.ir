# a call may store into the field, so a read behind it need not find what the read in front of it has found. In f1 the call stands in the first block, behind the read. In f2 it stands in the block of the second comparison. Each comparison keeps its own read
# function pick(node, deed) { if (node.kind === (deed(node), 1) || node.kind === 4) return 10; return 20; }   function pick(node, deed) { if (node.kind === 1 || node.kind === (deed(node), 4)) return 10; return 20; }
# f3 is f2 without the call, so that the one property differs: it is one Switch
# all three are called from f0 alone, with literals whose kind is 5. f4 is the deed: it stores 4 into the field, in sight of Link, so every read is still a read of a slot: the run named SLOTS holds that. One read for both comparisons would answer 20 where the program answers 10
# RUN: walk f1 f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-NOT: Switch
# RUN(PROVEN): walk f3 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# PROVEN: = GetSlot {{*}}key="kind"
# PROVEN: Switch {{*}}cases=[1, 4]
# RUN(SLOTS): walk f1 f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# SLOTS-LABEL: code f1:Body
# SLOTS: = GetSlot {{*}}key="kind"
# SLOTS-LABEL: code f2:Body
# SLOTS: = GetSlot {{*}}key="kind"
# RUN(SHELL): run-in-shell globalThis.sink = (...told) => { print(told.join()); };
# SHELL: 10,10,20
# SHELL-NEXT: exited with 0

layout L0 name="Node" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = NewClosure function=f1
    v2 = NewClosure function=f2
    v3 = NewClosure function=f3
    v4 = NewClosure function=f4
    v5 = Integer integer=5
# REPEAT: i = 0..2
    v%(i*2+6) = NewObject -, v5 layout=L0 fields=[0]
    v%(i*2+7) = FinishObject v%(i*2+6)
# END REPEAT
    v12 = Call v1, -, v7, v4
    v13 = Call v2, -, v9, v4
    v14 = Call v3, -, v11
    v15 = PropGet v0 key="sink" [isFreeName]
    v16 = Call v15, -, v12, v13, v14
    Return v16
}
function f1 name="pickBehindDeedInFront" module=m0 length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = PropGet v0 key="kind"
    v3 = Call v1, -, v0
    v4 = Integer integer=1
    v5 = StrictEq v2, v4
    Branch v5 -> taken b1(| 0), notTaken b2(| 0)
  b1(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Jump -> next b6()
  b2(v8):
    v9 = NarrowByField v0, v8 key="kind"
    Jump -> next b3()
  b3():
    v10 = PropGet v9 key="kind"
    v11 = Integer integer=4
    v12 = StrictEq v10, v11
    Branch v12 -> taken b4(| 0), notTaken b5(| 0)
  b4(v13):
    v14 = NarrowByField v9, v13 key="kind"
    Jump -> next b6()
  b5(v15):
    v16 = NarrowByField v9, v15 key="kind"
    Jump -> next b7()
  b6():
    v17 = Integer integer=10
    Return v17
  b7():
    v18 = Integer integer=20
    Return v18
}
function f2 name="pickBehindDeedBetween" module=m0 length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = PropGet v0 key="kind"
    v3 = Integer integer=1
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    v6 = NarrowByField v0, v5 key="kind"
    Jump -> next b6()
  b2(v7):
    v8 = NarrowByField v0, v7 key="kind"
    Jump -> next b3()
  b3():
    v9 = Call v1, -, v8
    v10 = PropGet v8 key="kind"
    v11 = Integer integer=4
    v12 = StrictEq v10, v11
    Branch v12 -> taken b4(| 0), notTaken b5(| 0)
  b4(v13):
    v14 = NarrowByField v8, v13 key="kind"
    Jump -> next b6()
  b5(v15):
    v16 = NarrowByField v8, v15 key="kind"
    Jump -> next b7()
  b6():
    v17 = Integer integer=10
    Return v17
  b7():
    v18 = Integer integer=20
    Return v18
}
function f3 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b6()
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Jump -> next b3()
  b3():
    v8 = PropGet v7 key="kind"
    v9 = Integer integer=4
    v10 = StrictEq v8, v9
    Branch v10 -> taken b4(| 0), notTaken b5(| 0)
  b4(v11):
    v12 = NarrowByField v7, v11 key="kind"
    Jump -> next b6()
  b5(v13):
    v14 = NarrowByField v7, v13 key="kind"
    Jump -> next b7()
  b6():
    v15 = Integer integer=10
    Return v15
  b7():
    v16 = Integer integer=20
    Return v16
}
function f4 name="deed" module=m0 length=1 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Integer integer=4
    PropSet v0, v1 key="kind"
    v3 = Undefined
    Return v3
}
