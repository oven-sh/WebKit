# Link has followed all that arrives at the parameter: lists, or Sets, that nobody else gets hold of and that keep the names, the prototype and the storage of their making in every run.
# So where the iteration opens the word is held against the object, one bit of its cell and a stop by name, and nothing else is asked: no step and no close has an arm of the protocol, the cleanup is gone, a pattern reads under its written places without asking the length (past the end a read finds nothing and gives undefined, as the protocol does), and a spread copies the elements in one piece.
# function total(list) { let sum = 0; for (const item of list) sum = keep(item); return sum; }    function firstTwo(list) { const [a, b] = list; return a; }
# function copy(list) { return [0, ...list]; }    function members(set) { for (const member of set) keep(member); }    function listed(set) { return [...set]; }
# RUN: walk f1 f2 f3 f4 f5 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = GetArrayLength
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK-LABEL: code f2:Body
# CHECK-NOT: = GetArrayLength
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK-LABEL: code f3:Body
# CHECK: = AppendElements
# CHECK-LABEL: code f4:Body
# CHECK: = CollectionTable
# CHECK: = SetNext
# CHECK-LABEL: code f5:Body
# CHECK: = AppendMembers
# RUN(NEVER): walk f1 f2 f3 f4 f5 mechanisms=all
# NEVER-NOT: @@iterator
# NEVER-NOT: key="next"
# NEVER-NOT: IterationCleanup
# NEVER-NOT: DestructureIterable
# NEVER-NOT: AppendIterable
# RUN(HELD): walk f1 f2 f3 f4 f5 mechanisms=all
# HELD-COUNT-3: = IsPristine {{*}}builtinClass=Array aspects=[Storage, Names, CellAlone]
# HELD-COUNT-2: = IsPristine {{*}}builtinClass=Set aspects=[Names, CellAlone]
# HELD-NOT: = IsPristine
# RUN(STOPS): walk f1 f2 f3 f4 f5 mechanisms=all
# STOPS-COUNT-5: CheckProof {{*}}checkedType=true
# unseen code has had the list and the Set in hand: each is asked, and the protocol stands by
# RUN(HANDED): walk f6 f7 mechanisms=all
# HANDED-LABEL: code f6:Body
# HANDED: = IsPristine {{*}}builtinClass=Array
# HANDED-LABEL: code f7:Body
# HANDED: = IsPristine {{*}}builtinClass=Set

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0, v0 contents=anything
    v2 = Builtin builtin=Set
    v3 = Construct v2, v2
    v4 = NewClosure function=f1
    v5 = Call v4, -, v1 calleeName="total"
    v6 = NewClosure function=f2
    v7 = Call v6, -, v1 calleeName="firstTwo"
    v8 = NewClosure function=f3
    v9 = Call v8, -, v1 calleeName="copy"
    v10 = NewClosure function=f4
    v11 = Call v10, -, v3 calleeName="members"
    v12 = NewClosure function=f5
    v13 = Call v12, -, v3 calleeName="listed"
    v14 = NewArray v0, v0 contents=anything
    v15 = Construct v2, v2
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="keep" [isFreeName]
    v18 = Call v17, -, v14, v15 calleeName="keep"
    v19 = NewClosure function=f6
    v20 = Call v19, -, v14 calleeName="totalOfHanded"
    v21 = NewClosure function=f7
    v22 = Call v21, -, v15 calleeName="membersOfHanded"
    v23 = Undefined
    Return v23
}
