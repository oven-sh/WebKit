# function inPlace(table, a, b) { const k = `${a},${b}`; return table[k] ??= a; }  function helped(table, a, b) { return table[key(a, b)] ??= a; }
# A key that is asked once and stored under is first tested for an object, whose conversion runs code. A text is none, so it is read under as it is: it is made as a name.
# f1 = inPlace, f2 = helped, f3 = key
# RUN: walk f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = Strcat {{*}}[isLikelyKey, isLikelyName]
# RUN(HELPED): walk f2:Body mechanisms=all
# HELPED-LABEL: code f2:Body
# HELPED: = Strcat {{*}}[isLikelyKey, isLikelyName]

variable g0 name="key" module=m0 declared={type=f3 flags=[IsFromCompiler]} initialization=Function function=f3 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="inPlace" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = String string=","
    v4 = Strcat v1, v3, v2
    v5 = TypeTest v4 testedType=object
    Branch v5 -> taken b1(| 0), notTaken b2(| 0)
  b1(v6):
    v7 = ToPropertyKey v6
    Jump -> next b3(v7)
  b2(v8):
    Jump -> next b3(v8)
  b3(v9):
    v10 = ElemGet v0, v9
    v11 = TypeTest v10 testedType=undefined|null
    Branch v11 -> taken b4(), notTaken b5()
  b4():
    ElemSet v0, v9, v1 mode=Strict
    Jump -> next b5()
  b5():
    Return v10
}
function f2 name="helped" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = GetModuleVariable variable=g0
    v4 = Call v3, -, v1, v2 calleeName="key"
    v5 = TypeTest v4 testedType=object
    Branch v5 -> taken b1(| 0), notTaken b2(| 0)
  b1(v6):
    v7 = ToPropertyKey v6
    Jump -> next b3(v7)
  b2(v8):
    Jump -> next b3(v8)
  b3(v9):
    v10 = ElemGet v0, v9
    v11 = TypeTest v10 testedType=undefined|null
    Branch v11 -> taken b4(), notTaken b5()
  b4():
    ElemSet v0, v9, v1 mode=Strict
    Jump -> next b5()
  b5():
    Return v10
}
function f3 name="key" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
