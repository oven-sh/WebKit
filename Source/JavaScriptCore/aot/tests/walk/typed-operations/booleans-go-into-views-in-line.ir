# function marks(view: Uint8Array, n: number) { for (let i = 0; i < n; i++) view[i] = true; return view[2]; }
# function compares(view: Uint8Array, n: number) { for (let i = 0; i < n; i++) view[i] = i > 1; return view[2]; }
