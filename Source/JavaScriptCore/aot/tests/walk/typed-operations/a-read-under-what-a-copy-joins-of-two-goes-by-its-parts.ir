# function named(i) { return "n" + i; }  function look(table, i) { return table[named(i | 0)]; }  function three(i) { return "n" + i + "!"; }  function long(table, i) { return table[three(i | 0)]; }
# A helper that joins a text of two parts is copied into the function that reads under what it gives. The read goes by the two parts: the key is not made, not hashed and not looked for among the names.
