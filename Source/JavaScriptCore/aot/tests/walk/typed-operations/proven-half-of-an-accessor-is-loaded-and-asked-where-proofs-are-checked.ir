# testing=CheckProofsAtRunTime: every birth of the layout lays one getter and one setter under `value`, and Link has proven both halves: the access IS the call, with no look at the slot, no load and no record that has the type
# (walk/direct-calls/accessor-that-every-birth-lays-is-called-with-no-look-at-the-object.ir). Whoever decides by Link's word without such a record asks for himself: under the switch the half is loaded for its check alone,
# and the process ends with "what a field holds" where unseen code has defined another accessor over the field.
# const meter = { raw: 0, get value() { return this.raw; }, set value(next) { this.raw = next; } };  function read(m) { return m.value; }  function store(m) { m.value = 6; }
# OPTIONS: testing=CheckProofsAtRunTime
# RUN(GETTER): walk f3 mechanisms=all
# GETTER-LABEL: code f3:Body
# GETTER-NOT: = PropGet
# GETTER: [[half]]: f1 @Cell = GetSlotGetter {{*}}key="value"
# GETTER-NEXT: CheckProof [[half]] checkedType=f1 {{*}}source=Field
# RUN(SETTER): walk f4 mechanisms=all
# SETTER-LABEL: code f4:Body
# SETTER-NOT: = PropSet
# SETTER: [[half]]: f2 @Cell = GetSlotSetter {{*}}key="value"
# SETTER-NEXT: CheckProof [[half]] checkedType=f2 {{*}}source=Field

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="raw" declared={type=anything} flags=[IsRequired]}, {key="value" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    DefineGetter v1, v2 key="value"
    v4 = NewClosure function=f2
    DefineSetter v1, v4 key="value"
    v6 = FinishObject v1
    v7 = NewClosure function=f4
    v8 = Call v7, -, v6 calleeName="store"
    v9 = NewClosure function=f3
    v10 = Call v9, -, v6 calleeName="read"
    Return v10
}
function f1 name="value" module=m0 kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="raw"
    Return v1
}
function f2 name="value" module=m0 kind=Setter flags=[HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="raw"
    v3 = Undefined
    Return v3
}
function f3 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="value"
    Return v1
}
function f4 name="store" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=6
    PropSet v0, v1 key="value"
    v3 = Undefined
    Return v3
}
