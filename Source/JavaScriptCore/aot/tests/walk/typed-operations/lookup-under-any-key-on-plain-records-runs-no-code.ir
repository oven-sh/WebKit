# a record without accessors that stays in sight, below the locked Object.prototype, answers a lookup under any text with a value or not at all: the read stays closed, runs no code, and what the state knows outlives it
# function pick(name) { if (typeof name === "string") { const table = { a: 1, b: 2 }; last = name; const found = table[name]; return [found, last]; } }
# RUN: walk f1 mechanisms=none+TypedOperations+Folding
# CHECK-LABEL: code f1:Body
# CHECK: = ElemGet
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+Folding
# NEVER-NOT: GetModuleVariable
# a key that may be an object is converted, which runs code: function pickAny(name) { const table = { a: 1, b: 2 }; last = name; const found = table[name]; return [found, last]; }
# RUN(ANY): walk f2 mechanisms=none+TypedOperations+Folding
# ANY-LABEL: code f2:Body
# ANY: = ElemGet
# ANY: GetModuleVariable

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="last" module=m0 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = NewObject -, v3, v4 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    PutModuleVariable v2 variable=g0
    v8 = ElemGet v6, v2
    v9 = GetModuleVariable variable=g0
    v10 = NewArray v8, v9 contents=anything
    Return v10
  b2():
    v11 = Undefined
    Return v11
}
function f2 name="pickAny" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = NewObject -, v1, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    PutModuleVariable v0 variable=g0
    v6 = ElemGet v4, v0
    v7 = GetModuleVariable variable=g0
    v8 = NewArray v6, v7 contents=anything
    Return v8
}
