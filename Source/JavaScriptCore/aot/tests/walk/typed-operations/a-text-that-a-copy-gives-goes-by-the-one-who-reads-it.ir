# function key(a, b) { return `${a},${b}`; }  function same(a, b) { return key(a, b); }
# function look(table, a, b) { return table[key(a, b)]; }  function keep(table, a, b) { table[key(a, b)] = a; return a; }  function show(a, b) { return key(a, b) + "!"; }  function twice(table, a, b) { return table[same(a, b)]; }
# A copy of a function knows the call that it stands for. A text that it gives for a key is made as a name; what is joined on is not. Else each read would flatten a rope, hash it and look for its atom.
# f1 = look, f2 = keep, f3 = show, f4 = twice, f5 = key, f6 = same, f7 = ask, f8 = shout, f9 = mark
# function mark(a, b) { return `${a};${b}`; }  function ask(cache, a, b) { return cache.get(mark(a, b)); }  function shout(a, b) { return mark(a, b) + "!"; }
# Where the call hands the text to a call of which nothing is known, what is known of all callers speaks; where it is joined on, it does not.
