# an access under a key that the walk knows as one text, which is a name of the program and no key of elements, is the access by that name: every link of the chain takes it so
# function kindOf(node) { const k = "kind"; return [node[k]]; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = PropGet {{*}}key="kind"
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = ElemGet
# function hasKind(node) { const k = "kind"; return [k in node]; }
# RUN(HAS): walk f2 mechanisms=none+TypedOperations
# HAS-LABEL: code f2:Body
# HAS: = PropHas {{*}}key="kind"
# function setKind(node, v) { const k = "kind"; node[k] = v; }
# RUN(SET): walk f3 mechanisms=none+TypedOperations
# SET-LABEL: code f3:Body
# SET: PropSet {{*}}key="kind"
# the text of an index is a key of elements: function first(list) { return [list["1"]]; }
# RUN(INDEX): walk f4 mechanisms=none+TypedOperations
# INDEX-LABEL: code f4:Body
# INDEX: = ElemGet
# nobody knows the key: function any(node, k) { return [node[k]]; }
# RUN(ANY): walk f5 mechanisms=none+TypedOperations
# ANY-LABEL: code f5:Body
# ANY: = ElemGet
# f6 spells the name, so that the table of the program has its key: function named(node) { return node.kind; }

