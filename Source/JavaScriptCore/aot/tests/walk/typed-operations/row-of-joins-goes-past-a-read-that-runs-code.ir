# a link of a row of joins waits for the next past an operation that may run code, where its parts are primitives that together cannot pass the longest string: nobody can tell when they are joined
# function edge(n, to) { if (typeof n === "number") return [n + "," + +to]; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: [[converted]]: {{*}} = ToNumber
# CHECK: = Strcat {{*}}, {{*}}, [[converted]]
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = Add
# a string of any length may be too long to be joined, and that error comes in front of the code: function tail(s, to) { if (typeof s === "string") return [s + "," + +to]; }
# RUN(LONG): walk f2 mechanisms=none+TypedOperations
# LONG-LABEL: code f2:Body
# LONG: = Add
# LONG: = ToNumber
# the join behind the code does not take the link after all, because its other part may run code: what stands between is walked once
# function mixed(n, to, o) { if (typeof n === "number") { const head = n + ","; const c = +to; return [head + o, c]; } }
# RUN(ONCE): walk f3 mechanisms=none+TypedOperations
# ONCE-LABEL: code f3:Body
# ONCE: = ToNumber
# ONCE-NOT: = ToNumber
# ONCE: = NewArray

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="edge" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = String string=","
    v5 = Add v3, v4
    v6 = ToNumber v1
    v7 = Add v5, v6
    v8 = NewArray v7 contents=anything
    Return v8
  b2():
    v9 = Undefined
    Return v9
}
function f2 name="tail" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = String string=","
    v5 = Add v3, v4
    v6 = ToNumber v1
    v7 = Add v5, v6
    v8 = NewArray v7 contents=anything
    Return v8
  b2():
    v9 = Undefined
    Return v9
}
function f3 name="mixed" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = String string=","
    v6 = Add v4, v5
    v7 = ToNumber v1
    v8 = Add v6, v2
    v9 = NewArray v8, v7 contents=anything
    Return v9
  b2():
    v10 = Undefined
    Return v10
}
