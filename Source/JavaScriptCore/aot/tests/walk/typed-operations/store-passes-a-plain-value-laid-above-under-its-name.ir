# function Reply(n) { this.code = n; this.sent = false; }   Reply.prototype.sent = true: a default lies above the objects under a name that the constructor stores.
# A store passes a plain value that may be written and gives the object a property of its own. Whether it still is one the guard that stores ask says (object/AOTClassGuards.cpp: GuardsOfNameToEnd::StoresStillPass).
# The objects stay where their layout says, so no look at the cell was asked, and with that no guard either: the store was closed, and the stores behind it no longer knew the order of the keys.
# function run(n) { var t; for (var i = 0; i < n; i++) t = new Reply(i); return t; }
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# The guard is asked in front of the loop, and where it holds no turn asks. The other copy of the loop asks in each turn.
# CHECK-NOT: = NewObject
# CHECK: [[before]]: {{*}} = AreMembersUnchanged conditions=[{kind=MemberPassedByStores layout=L0 key="sent"}]
# CHECK-NEXT: Branch [[before]] -> taken [[unchanged]](), notTaken
# CHECK-NOT: = NewObject
# CHECK: [[test]]: {{*}} = AreMembersUnchanged conditions=[{kind=MemberPassedByStores layout=L0 key="sent"}]
# CHECK-NEXT: Branch [[test]] -> taken [[typed]](), notTaken [[closed]]()
# CHECK: [[typed]]() isInLoop=true:
# What a sloppy constructor function stores fills its object: behind the guard the object is born with both fields; where the guard fails the construction goes by the call.
# CHECK-NOT: PutSlot
# CHECK: = NewObject {{*}}layout=L0 fields=[0, 1]
# CHECK: [[closed]]() frequency=Rare isInLoop=true:
# CHECK: = Construct
# CHECK: [[unchanged]]():
# CHECK-NOT: AreMembersUnchanged
# CHECK: = NewObject {{*}}layout=L0 fields=[0, 1]
# CHECK-NOT: AreMembersUnchanged
# Nothing lies above under `code`: nobody asks a guard about it.
# RUN(CODE): walk f2 mechanisms=all
# CODE-NOT: key="code"}]
# A read finds what lies above: an empty slot is no answer, so the read looks above it, and no guard of reads is asked, which the default has ended.
# function read(r) { return r.sent; }
# RUN(READ): walk f3 mechanisms=all
# READ-NOT: AreMembersUnchanged conditions=[{layout=L0 key="sent"}]
# READ: = GetSlotOrUndefined {{*}}key="sent" receivers=[L0] level=Expected [looksAboveEmptySlot]
# READ-NOT: AreMembersUnchanged conditions=[{layout=L0 key="sent"}]
# READ: Return

layout L0 kind=Instance name="Reply" module=m0 constructor=f1 fields=[{key="code" declared={type=anything} flags=[IsRequired]}, {key="sent" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=2
variable g0 name="Reply" module=m0 declared={type=anything} initialization=Undefined flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = PropGet v0 key="prototype"
    v3 = Boolean boolean=true
    PropSet v2, v3 key="sent" mode=Sloppy
    v5 = NewClosure function=f2
    v6 = NewClosure function=f3
    v7 = Integer integer=3
    v8 = Call v5, -, v7
    v9 = Call v6, -, v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="sink" [isFreeName]
    v12 = Call v11, -, v9
    Return v12
}
function f1 name="Reply" module=m0 flags=[IsSloppy, HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = ToThis v0
    v3 = Convert v2 declared={type=L0 flags=[IsExpected]}
    PropSet v3, v1 key="code" mode=Sloppy
    v5 = Boolean
    PropSet v3, v5 key="sent" mode=Sloppy
    v7 = Undefined
    Return v7
}
function f2 name="run" module=m0 flags=[IsSloppy, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = GetModuleVariable variable=g0
    v8 = Construct v7, -, v4
    v9 = Increment v4
    Jump -> next b1(v8, v9)
  b3():
    Return v3
}
function f3 name="read" module=m0 flags=[IsSloppy, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="sent"
