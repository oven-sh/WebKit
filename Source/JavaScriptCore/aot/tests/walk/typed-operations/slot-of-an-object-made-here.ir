# the shape of an object is proven by its origin: it was made here, so its field is stored and read by slot
# function box(v) { const o = { x: v }; keep = o; return o.x; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: [[o]]: {{*}} = NewObject {{*}}layout=L0
# CHECK: PutSlot
# CHECK: = GetSlot
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = PropGet
# RUN(CLOSED): walk f1 mechanisms=none
# CLOSED: PropDefine
# CLOSED: = PropGet
# RUN(NOSLOT): walk f1 mechanisms=none
# NOSLOT-NOT: GetSlot

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="keep" module=m0 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="box" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="x"
    v3 = FinishObject v1
    PutModuleVariable v3 variable=g0
    v5 = PropGet v3 key="x"
    Return v5
}
