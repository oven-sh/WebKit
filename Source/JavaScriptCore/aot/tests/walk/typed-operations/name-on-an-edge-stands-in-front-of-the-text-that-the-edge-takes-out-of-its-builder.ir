# `while (i < text.length && text[i] !== close) s += text[i++]; return s + close`: the edge that leaves the loop takes the text out of its builder, and its test says that `close` is a string, which is read again.
# A Narrowed stands at the head of its block: the names of an edge are built in front of whatever else the edge builds. Behind the StackStringBuilderFinish the verifier refuses it.
# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = StackStringBuilderBegin
# CHECK: = StrictEq
# CHECK: = StackStringBuilderFinish
# CHECK: Return

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
function f1 name="until" module=m0 position=1 sourceRange={start=1 end=135} length=2 thisType={type=anything} parameters=[{type=string}, {type=undefined|null|string}] results=[{type=anything}] {
  b0(v0: string, v1: undefined|null|string):
    v2 = String string="" @40
    v3 = Integer @48
    Jump -> next b1(v2, v3) @53
  b1(v4, v5):
    LoopHint @53
    v7 = PropGet v0 key="length" @64
    v8 = Less v5, v7 @64
    Branch v8 -> taken b2(), notTaken b4() @64
  b2():
    v9 = ElemGet v0, v5 @79
    v10 = StrictEq v9, v1 @91
    Branch v10 -> taken b4(), notTaken b3() @91
  b3():
    v11 = ToNumeric v5 @108
    v12 = Increment v11 @108
    v13 = ElemGet v0, v11 @103
    v14 = Add v4, v13 @103
    Jump -> next b1(v14, v12) @98
  b4():
    v15 = Add v4, v1 @127
    Return v15 @127
}
