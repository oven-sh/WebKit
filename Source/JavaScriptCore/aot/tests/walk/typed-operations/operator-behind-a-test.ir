# behind a test that the program wrote both operands are proven numbers, so the operator has its typed form
# function double(v) { return typeof v === "number" ? v + v : v; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK: mechanisms TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = Add {{*}}form=Numbers
# RUN(ONLY): walk f1 mechanisms=none+TypedOperations
# ONLY-NOT: form=Generic

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="double" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Add v2, v2
    Return v3
  b2(v4):
    Return v4
}
