# function whole(count) { count = count | 0; let sum = 0; for (let i = 0; i < count; i++) sum += parseInt(i * 7) + parseFloat(i) + Number.parseInt(i, 10); return sum; }
# What parseInt() and parseFloat() make of an integer is the integer: it is not written out as a text and read back.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = ToString
# CHECK-NOT: inlineBuiltin=ParseInt
# CHECK-NOT: = CallBuiltin
# CHECK: Return
# function fraction(x, count) { x = +x; count = count | 0; let sum = 0; for (let i = 0; i < count; i++) sum += parseInt(x / i); return sum; }: from 0.000001 to 2^53 - 1, from -1 down to -(2^53 - 1) and at zero parseInt() cuts the fraction off; elsewhere the text says otherwise
# (1e21 is "1e+21", -0.5 is "-0.5") and is made and read in a rare arm. The arms stand in loops alone.
# RUN(FRACTION): walk f2:Body mechanisms=all
# FRACTION-LABEL: code f2:Body
# FRACTION-NOT: = ToString
# FRACTION: = ToIntegerOrInfinity
# FRACTION: frequency=Rare
# FRACTION: inlineBuiltin=ParseInt
# function float(x, count) { x = +x; count = count | 0; let sum = 0; for (let i = 0; i < count; i++) sum += parseFloat(x + i); return sum; }: parseFloat() gives the number back, -0 as 0
# RUN(FLOAT): walk f3:Body mechanisms=all
# FLOAT-LABEL: code f3:Body
# FLOAT-NOT: = ToString
# FLOAT-NOT: overload=ParseFloat
# FLOAT: testedType=builtin(ParseFloat)
# FLOAT-NOT: = ToString
# FLOAT-NOT: overload=ParseFloat
# FLOAT: = Add
# FLOAT-NOT: = ToString
# FLOAT-NOT: overload=ParseFloat
# FLOAT: calleeName="parseFloat"
# function sixteen(x) { x = x | 0; return [parseInt(x, 16)]; }: under another radix the digits mean something else
# RUN(SIXTEEN): walk f5:Body mechanisms=all
# SIXTEEN-LABEL: code f5:Body
# SIXTEEN: = ToString
# SIXTEEN: inlineBuiltin=ParseInt
# function once(x) { x = +x; return [parseInt(x)]; }: outside every loop the call stays as small as it was
# RUN(ONCE): walk f4:Body mechanisms=all
# ONCE-LABEL: code f4:Body
# ONCE-NOT: = ToIntegerOrInfinity
# ONCE: inlineBuiltin=ParseInt
# layout L908 kind=Closure
