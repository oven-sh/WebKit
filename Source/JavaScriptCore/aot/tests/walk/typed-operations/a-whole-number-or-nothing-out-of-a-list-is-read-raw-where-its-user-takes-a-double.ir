# function gap(t) { const l = new Array(4); l[0] = Infinity; l[1] = t & 7; return l[t & 3] - 1; }
# Link says of what the list holds: integers and whole numbers that are no integers (an infinity). Such a number lies in a double, as a number with a fraction does: where its user takes a double it is read raw, and asked raw for its fraction.
# Read boxed it was boxed, asked, and unboxed again. Lists of integers alone stay as they were: they are better integers.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: : undefined|int|whole @OptionalDouble = GetArrayElement
# RUN(BOXED): walk f1 mechanisms=all
# BOXED-NOT: : undefined|int|whole @JSValue = GetArrayElement
# RUN(ANSWER): run-in-shell globalThis.sink = gap => { print([0, 1, 2, 5].map(t => gap(t)).join(" ")); };
# ANSWER: Infinity 0 NaN 4
# ANSWER-NEXT: exited with 0
# LIBRARY: own

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="gap" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Array
    v2 = Integer integer=4
    v3 = Construct v1, -, v2 calleeName="Array"
    v4 = Integer
    v5 = Double number=Infinity
    ElemSet v3, v4, v5
    v7 = Integer integer=1
    v8 = Integer integer=7
    v9 = BitAnd v0, v8
    ElemSet v3, v7, v9
    v11 = Integer integer=3
    v12 = BitAnd v0, v11
    v13 = ElemGet v3, v12
    v14 = Sub v13, v7
    Return v14
}
