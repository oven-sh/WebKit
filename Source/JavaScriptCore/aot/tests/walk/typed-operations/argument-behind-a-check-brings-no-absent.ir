# the argument has passed CheckInitialized, whether or not an edge of the summary shows that. The parameter is written without `absent`, so none is there, and none in what `same` hands back
# function same(value) { return value; }  function make() { return { kept: same(WORD) }; }  const WORD = "one";  make().kept
# RUN: walk f2 mechanisms=none+TypedOperations
# CHECK-LABEL: code f2:Body
# CHECK: [[word]]: string @{{*}} = Call
# CHECK: = NewObject {{*}}[[word]]{{*}}layout=L0

layout L0 module=m0 fields=[{key="kept" declared={type=string} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="same" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="make" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="WORD" module=m0 declared={type=string|absent} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="one"
    PutModuleVariable v0 variable=g2
    v2 = GetModuleVariable variable=g1
    v3 = Call v2 calleeName="make"
    v4 = PropGet v3 key="kept"
    Return v4
}
function f1 name="same" module=m0 length=1 thisType={type=anything} parameters=[{type=string}] results=[{type=string}] {
  b0(v0: string):
    Return v0
}
function f2 name="make" module=m0 thisType={type=anything} results=[{type=L0}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g2
    v2 = CheckInitialized v1 name="WORD"
    v3 = Call v0, -, v2 calleeName="same"
    v4 = Convert v3 declared={type=string}
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    Return v6
}
