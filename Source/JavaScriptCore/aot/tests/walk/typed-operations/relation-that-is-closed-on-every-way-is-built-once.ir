# both ways bring whatever was read, so the relation at the head of the join asks a stub on either of them as it does behind the meeting: it is built once
# function below(c, o, n) { const v = c ? o.count : o.size; return v < n; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK: mechanisms TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = Less
# CHECK-NOT: = Less

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="below" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = ToBoolean v0
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = PropGet v1 key="count"
    Jump -> next b3(v4)
  b2():
    v5 = PropGet v1 key="size"
    Jump -> next b3(v5)
  b3(v6):
    v7 = Less v6, v2
    Return v7
}
