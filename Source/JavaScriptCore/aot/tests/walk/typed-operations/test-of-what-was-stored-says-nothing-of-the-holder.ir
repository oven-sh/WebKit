# type Amber = { kind: string; v: number }   type Birch = { kind: string; v: string }   type Source = { pad: string; v: string }
# function probe(o: Amber | Birch, src: Source) { o.kind = src.v; if (o.kind === "x") return typeof o.v; return typeof o.v; }
# The state answers the read of `o.kind` with what was stored, and that is a read of `v` off `src`. A Narrowed that narrows the holder is typed by the key and the object of the read behind its test: it asked which
# layouts of `o` can hold "x" under `v`, struck Amber, whose `v` is a number, on both edges, and `typeof o.v` was "string" for every object. A silent wrong answer, found by a reader.
# The holder is narrowed only where the read behind the test is a read of the tested name off the holder.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = StrictEq
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: narrowsHolderOfOperand
# RUN(SHELL): run-in-shell globalThis.sink = (...told) => { print(told.join()); };
# SHELL: number,string,number,string
# SHELL-NEXT: exited with 0

layout L0 name="Amber" module=m0 fields=[{key="kind" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="v" declared={type=number} flags=[IsRequired]}]
layout L1 name="Birch" module=m0 fields=[{key="kind" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="v" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}]
layout L2 name="Source" module=m0 fields=[{key="pad" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="v" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="k"
    v2 = String string="s"
    v3 = String string="x"
    v4 = String string="y"
    v5 = String string=""
    v6 = Integer integer=7
    v7 = NewObject -, v5, v3 layout=L2 fields=[0, 1]
    v8 = FinishObject v7
    v9 = NewObject -, v5, v4 layout=L2 fields=[0, 1]
    v10 = FinishObject v9
    v11 = NewObject -, v1, v6 layout=L0 fields=[0, 1]
    v12 = FinishObject v11
    v13 = NewObject -, v1, v2 layout=L1 fields=[0, 1]
    v14 = FinishObject v13
    v15 = Call v0, -, v12, v8
    v16 = Call v0, -, v14, v8
    v17 = Call v0, -, v12, v10
    v18 = Call v0, -, v14, v10
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="sink" [isFreeName]
    v21 = Call v20, -, v15, v16, v17, v18
    Return v21
}
function f1 name="probe" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|L0|L1, v1: undefined|null|L2):
    v2 = PropGet v1 key="v"
    PropSet v0, v2 key="kind"
    v4 = PropGet v0 key="kind"
    v5 = String string="x"
    v6 = StrictEq v4, v5
    Branch v6 -> taken b1(| 0), notTaken b2(| 0)
  b1(v7):
    v8 = NarrowByField v0, v7 key="kind"
    v9 = PropGet v8 key="v"
    v10 = TypeOf v9
    Return v10
  b2(v11):
    v12 = NarrowByField v0, v11 key="kind"
    v13 = PropGet v12 key="v"
    v14 = TypeOf v13
    Return v14
}
