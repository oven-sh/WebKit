# the right side of `x instanceof Leaf` is one class of the program that stays as it is written: both lookups on the class object are answered, and the left side is asked for its shape
# interface Thing { }  class Leaf implements Thing { }  class Twig extends Leaf { }  class Stone implements Thing { }  function isLeaf(x, C) { return x instanceof C; }
# each function is called from the body of the module, so Link proves what arrives: the class object, and anything, a Twig, a Stone, or any Thing
# every layout that the value can have is decided, so a miss means false and the test stands for the operation
# RUN: walk f7 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f7:Body
# CHECK: = ShapeTest {{*}}layouts=[L0, L1]
# RUN(NEVER): walk f4 f5 f6 f7 f8 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# NEVER-NOT: = InstanceOf
# RUN(ALONE): walk f7 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# ALONE-NOT: HasInPrototypeChain
# ALONE-NOT: GetClassPrototype
# of anything, without arms: what is left of the operation is the walk up the chain
# RUN(CHAIN): walk f4 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHAIN-LABEL: code f4:Body
# CHAIN-NOT: ShapeTest
# CHAIN: [[above]]: {{*}} = GetClassPrototype {{*}}layout=L0
# CHAIN: = HasInPrototypeChain {{*}}[[above]]
# of anything, with arms: the shapes of the class and of what is written below it, and the walk on the miss
# RUN(ARMS): walk f4 mechanisms=none+TypedOperations+Guesses+DirectCalls+Arrivals
# ARMS-LABEL: code f4:Body
# ARMS: = ShapeTest {{*}}layouts=[L0, L1]
# ARMS: = HasInPrototypeChain
# a Twig is a Leaf, a Stone and a number are none
# RUN(TRUE): walk f5 mechanisms=none+TypedOperations+Folding+DirectCalls+Arrivals
# TRUE-LABEL: code f5:Body
# TRUE-NOT: ShapeTest
# TRUE-NOT: HasInPrototypeChain
# TRUE: Boolean boolean=true
# RUN(FALSE): walk f6 f8 mechanisms=none+TypedOperations+Folding+DirectCalls+Arrivals
# FALSE-NOT: ShapeTest
# FALSE-NOT: HasInPrototypeChain
# FALSE-NOT: boolean=true
# RUN(ALL): walk f7 mechanisms=all
# ALL-LABEL: code f7:Body
# ALL-NOT: = InstanceOf
# ALL: = ShapeTest {{*}}layouts=[L0, L1]

layout L0 kind=Instance name="Leaf" module=m0 constructor=f1 supertypes=[L3]
layout L1 kind=Instance name="Twig" module=m0 base=L0 constructor=f2 supertypes=[L0, L3] flags=[HasHeritage]
layout L2 kind=Instance name="Stone" module=m0 constructor=f3 supertypes=[L3]
layout L3 name="Thing" module=m0 flags=[IsNeverAllocated]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = NewClosure function=f3
    v8 = NewClass v7 layout=L2
    v9 = FinishClass v8 layout=L2
    v10 = Construct v2
    v11 = Construct v6
    v12 = Construct v9
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = NewClosure function=f4
    v16 = Call v15, -, v14, v2 calleeName="isLeaf"
    v17 = Call v15, -, v14, v2 calleeName="isLeaf"
    v18 = NewClosure function=f5
    v19 = Call v18, -, v11, v2 calleeName="twigIsLeaf"
    v20 = Call v18, -, v11, v2 calleeName="twigIsLeaf"
    v21 = NewClosure function=f6
    v22 = Call v21, -, v12, v2 calleeName="stoneIsLeaf"
    v23 = Call v21, -, v12, v2 calleeName="stoneIsLeaf"
    v24 = NewClosure function=f7
    v25 = Call v24, -, v10, v2 calleeName="thingIsLeaf"
    v26 = Call v24, -, v11, v2 calleeName="thingIsLeaf"
    v27 = Call v24, -, v12, v2 calleeName="thingIsLeaf"
    v28 = NewClosure function=f8
    v29 = Integer integer=5
    v30 = Call v28, -, v29, v2 calleeName="numberIsLeaf"
    v31 = Call v28, -, v29, v2 calleeName="numberIsLeaf"
    v32 = NewArray v16, v17, v19, v20, v22, v23, v25, v26, v27, v30, v31 contents=anything
    Return v32
}
function f1 name="Leaf" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Twig" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Stone" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f4 name="isLeaf" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
function f5 name="twigIsLeaf" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
function f6 name="stoneIsLeaf" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
function f7 name="thingIsLeaf" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
function f8 name="numberIsLeaf" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
