# ONENOT-NOT: RememberOwner
# one arm calls behind its store: the barrier of that store cannot wait
# function calls(v, f) { const o = { x: v, y: v }; f(); if (v) { o.x = v; f(); } else o.x = f; return o; }
# RUN(CALLNOT): walk f3 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CALLNOT-NOT: RememberOwner
# a store into the object follows the join: its own barrier does for the arms
# function follows(v, f) { const o = { x: v, y: v }; f(); if (v) o.x = v; else o.x = f; o.y = f; return o; }
# RUN(NEXT): walk f4 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
