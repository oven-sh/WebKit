# function look(table, kind, id) { if (typeof kind === "string" && typeof id === "number") { const key = kind + ":" + id; let found = table[key]; if (found === undefined) table[key] = found = id; return found; } }
# The first reader of the text takes it as the key of a property. So it is made as a name: the run time finds the name that it made of the same parts the last time, and makes no rope, no characters and no atom.
# RUN: walk f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = Add
# CHECK: = Strcat {{*}}[isLikelyKey, isLikelyName]
# function has(set, kind, id) { if (set instanceof Set ..) return set.has(kind + id); }   Of a Map or a Set it is a key and no name.
# RUN(SET): walk f2:Body mechanisms=none+TypedOperations
# SET-LABEL: code f2:Body
# SET: = Strcat {{*}}[isLikelyKey]
# function template(table, a, b) { return table[`${a}/${b}`]; }   A template is one join as it is written, whatever its parts are: those that may run code are converted where the join stands, in their order.
# RUN(TEMPLATE): walk f3:Body mechanisms=none+TypedOperations
# TEMPLATE-LABEL: code f3:Body
# TEMPLATE: = Strcat {{*}}[isLikelyKey, isLikelyName]
# function printed(kind, id) { if (typeof kind === "string" && typeof id === "number") return kind + id; }   Nobody takes it as a key.
# RUN(TEXT): walk f4:Body mechanisms=none+TypedOperations
# TEXT-LABEL: code f4:Body
# TEXT-NOT: isLikelyKey
# RUN(WITHHELD): walk f3:Body mechanisms=none
# WITHHELD-LABEL: code f3:Body
# WITHHELD-NOT: isLikelyKey

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
