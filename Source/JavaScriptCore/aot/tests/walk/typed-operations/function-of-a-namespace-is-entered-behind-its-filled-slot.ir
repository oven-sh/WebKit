# -- source: main.js
# var Debug; (function (Debug) { function assert(x) { if (!x) throw new Error("no"); return 1; } Debug.assert = assert; function other() { return 2; } Debug.other = other; })(Debug || (Debug = {}));
# function noop() { return 0; }
# function off(name) { Debug[name] = noop; }
# function use(n) { return Debug.assert(n) + Debug.other(); }
# globalThis.off = off; globalThis.use = use;
# print(use(1), use(2)); off("other"); print(use(3)); off("assert"); print(use(0));
# -- end of source
# namespace Debug { export function assert(x: unknown) { .. } export function other() { .. } }  (Debug as any)[name] = noop;  Debug.assert(n)
# A store under a key that nobody knows may replace each function, and may lay another object above this one, so nothing is proven of what the object holds. The slot is held to the closures of the function that is declared:
# a store of anything else takes the field out of its slot. So behind a look at the shape and at the slot the call enters the function, and where either fails it is the call that is written.
# RUN: walk f4 mechanisms=all-Inlining
# CHECK-LABEL: code f4:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = IsSlotFilled {{*}}key="assert" receivers=[L0]
# CHECK: = CallDirect {{*}}function=f1
# RUN(PLAN): plan layouts mechanisms=all
# PLAN: layout L0 CompiledObject
# PLAN: slot 0 "assert" JSValue {{*}}type=f1
# PLAN: slot 1 "other" JSValue {{*}}type=f2
# the store of another function is no store into the slot
# RUN(STORE): walk f3 mechanisms=all
# STORE-LABEL: code f3:Body
# STORE-NOT: = PutSlot
# RUN(ANSWERS): run-in-shell
# ANSWERS: the source prints the same

layout L0 kind=Container name="Debug" module=m0 fields=[{key="assert" declared={type=f1 flags=[IsFromCompiler, IsExpected]}}, {key="other" declared={type=f2 flags=[IsFromCompiler, IsExpected]}}] ownFieldCount=2
variable g0 name="Debug" module=m0 declared={type=anything} initialization=Undefined flags=[IsImmutable]
variable g1 name="noop" module=m0 declared={type=anything} initialization=Undefined flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    PropSet v1, v3 key="assert"
    v5 = NewClosure function=f2
    PropSet v1, v5 key="other"
    v7 = NewClosure function=f5
    PutModuleVariable v7 variable=g1
    v9 = NewClosure function=f3
    v10 = NewClosure function=f4
    v11 = Builtin builtin=GlobalThis
    PropSet v11, v9 key="off"
    PropSet v11, v10 key="use"
    v14 = PropGet v11 key="print" [isFreeName]
    v15 = Integer integer=1
    v16 = Call v10, -, v15 calleeName="use"
    v17 = Integer integer=2
    v18 = Call v10, -, v17 calleeName="use"
    v19 = Call v14, -, v16, v18 calleeName="print"
    v20 = String string="other"
    v21 = Call v9, -, v20 calleeName="off"
    v22 = Integer integer=3
    v23 = Call v10, -, v22 calleeName="use"
    v24 = Call v14, -, v23 calleeName="print"
    v25 = String string="assert"
    v26 = Call v9, -, v25 calleeName="off"
    v27 = Integer integer=0
    v28 = Call v10, -, v27 calleeName="use"
    v29 = Call v14, -, v28 calleeName="print"
    v30 = Undefined
    Return v30
}
function f1 name="assert" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="Error" [isFreeName]
    v5 = String string="no"
    v6 = Construct v4, -, v5 calleeName="Error"
    Throw v6
}
function f2 name="other" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
function f3 name="off" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    ElemSet v1, v0, v2
    v4 = Undefined
    Return v4
}
function f4 name="use" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Convert v1 declared={type=undefined|L0 flags=[IsExpected]}
    v3 = PropGet v2 key="assert"
    v4 = Call v3, v2, v0 calleeKey="assert" calleeName="Debug.assert"
    v5 = GetModuleVariable variable=g0
    v6 = Convert v5 declared={type=undefined|L0 flags=[IsExpected]}
    v7 = PropGet v6 key="other"
    v8 = Call v7, v6 calleeKey="other" calleeName="Debug.other"
    v9 = Add v4, v8
    Return v9
}
function f5 name="noop" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    Return v0
}
