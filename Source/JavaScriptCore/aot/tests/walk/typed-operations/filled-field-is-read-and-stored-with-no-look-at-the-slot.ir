# every construction of the layout defines the field before the object can be seen, so whoever gets such an object reads and stores the slot as it lies: no test, no undefined, in straight code too
# class P { constructor(v) { this.x = v; } }  function get(p) { return p.x; }  function set(p, v) { p.x = v; }  function has(p) { return "x" in p; }  const p = new P("a"); get(p); set(p, "b"); has(p);
# RUN: walk f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f2:Body
# CHECK: : string {{*}} = GetSlot {{*}}key="x"
# RUN(NEVER): walk f2 f3 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# NEVER-NOT: = PropGet
# NEVER-NOT: PropSet
# NEVER-NOT: IsSlotFilled
# NEVER-NOT: GetSlotOrUndefined
# NEVER-NOT: PutSlotOrAdd
# RUN(STORE): walk f3 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# STORE-LABEL: code f3:Body
# STORE: PutSlot {{*}}key="x"
# RUN(HAS): walk f4 mechanisms=none+TypedOperations+DirectCalls+Arrivals+Folding
# HAS-LABEL: code f4:Body
# HAS-NOT: IsSlotFilled
# HAS: Boolean boolean=true
# RUN(CLOSED): walk f2 mechanisms=none
# CLOSED: = PropGet

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, -, v3
    v5 = NewClosure function=f2
    v6 = Call v5, -, v4 calleeName="get"
    v7 = NewClosure function=f3
    v8 = String string="b"
    v9 = Call v7, -, v4, v8 calleeName="set"
    v10 = NewClosure function=f4
    v11 = Call v10, -, v4 calleeName="has"
    v12 = Undefined
    Return v12
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f3 name="set" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x"
    v3 = Undefined
    Return v3
}
function f4 name="has" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropHas v0 key="x"
    Return v1
}
