# testing=CheckProofsAtRunTime: every construction in sight fills `count` with an integer and `ratio` with a number, and every writer is known: the slots are raw, and the reads give raw words.
# Such a slot has a mark for undefined and one for null, which pass every door of the run time. Of a raw word no test tells anything: a read that leaves no room for the marks takes one for a number.
# Under the switch the SLOT is asked in front of the read whether what lies there is a value, and the process ends with "what a field holds" where unseen code has stored undefined or null.
# const box = { count: 1, ratio: 1.5 };  function count(b) { return b.count + 1; }  function ratio(b) { return b.ratio * 2; }  count(box) + ratio(box)
# OPTIONS: testing=CheckProofsAtRunTime
# RUN(INTEGER): walk f1 mechanisms=all-Inlining
# INTEGER-LABEL: code f1:Body
# INTEGER: [[holds]]: boolean @Boolean = IsSlotFilled {{*}}key="count" {{*}}[holdsDeclaredType]
# INTEGER-NEXT: CheckProof [[holds]] checkedType=true {{*}}source=Field
# INTEGER-NEXT: : int[0, 2147483647] @Int64 = GetSlot {{*}}key="count"
# RUN(DOUBLE): walk f2 mechanisms=all-Inlining
# DOUBLE-LABEL: code f2:Body
# DOUBLE: [[holds]]: boolean @Boolean = IsSlotFilled {{*}}key="ratio" {{*}}[holdsDeclaredType]
# DOUBLE-NEXT: CheckProof [[holds]] checkedType=true {{*}}source=Field
# DOUBLE-NEXT: @Double = GetSlot {{*}}key="ratio"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="count" declared={type=anything} flags=[IsRequired]}, {key="ratio" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Double number=1.5
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = NewClosure function=f1
    v5 = Call v4, -, v3 calleeName="count"
    v6 = NewClosure function=f2
    v7 = Call v6, -, v3 calleeName="ratio"
    v8 = Add v5, v7
    Return v8
}
function f1 name="count" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="count"
    v2 = Integer integer=1
    v3 = Add v1, v2
    Return v3
}
function f2 name="ratio" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="ratio"
    v2 = Integer integer=2
    v3 = Mul v1, v2
    Return v3
}
