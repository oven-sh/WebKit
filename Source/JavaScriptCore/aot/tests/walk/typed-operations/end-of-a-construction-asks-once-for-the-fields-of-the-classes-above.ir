# WHERE A CONSTRUCTION ENDS, THE FIELDS OF THE CLASSES ABOVE ARE ASKED FOR WITH ONE QUESTION. Link's word that a field is filled proves nothing: the constructor shows it at its end for an object of its own class.
# class A { constructor(n) { if (n) this.early = n; this.a = n; } }
# class B extends A { constructor(n) { super(n); this.b = n; } }
# class C extends B { constructor(n) { super(n); this.c = n; } }
# function read(o) { return o.a + o.b + o.c; }
# function make(K, n) { return new K(n); }
# print(read(make(C, 1)), read(make(C, 0)), make(A, 2).a, make(B, 3).b, make(B, 0).b);
# B is constructed for itself and for C, so its stores stand in arms that meet closed ones, and the walk has kept none of them. One look at a slot for each field of the whole row, in each constructor of the row,
# was a square of the length of the row in operations and in bytes. The question compares the order word with the beginnings of the planned orders that list all those fields; make(B, 0) lists its keys in an order
# that nobody planned, and there the run time looks at the slots. C is constructed for itself alone: every store is in sight and nothing is asked. A has no class above it: its one field is a look at the slot.
# RUN(LINK): link fields mechanisms=all
# LINK: field L1.0 "b" {{*}}filled
# LINK: field L1.2 "a" {{*}}filled
# RUN(ORDERS): plan orders mechanisms=all
# ORDERS: orders L1
# ORDERS-NEXT: order 0: "early" "a" "b"
# ORDERS-NEXT: orders L2
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: [[own]]: L1?{{*}} = Narrowed
# CHECK-NEXT: [[asked]]: boolean {{*}} = AreHeldFieldsFilled [[own]] layout=L1
# CHECK-NEXT: CheckProof [[asked]] {{*}}source=Field
# RUN(ONCE): walk f2 mechanisms=all
# ONCE-NOT: IsSlotFilled {{*}}receivers=[L1]
# RUN(SHOWN): walk f3 mechanisms=all
# SHOWN-LABEL: code f3:Body
# SHOWN-NOT: AreHeldFieldsFilled
# SHOWN-NOT: IsSlotFilled
# RUN(ALONE): walk f1 mechanisms=all
# ALONE-LABEL: code f1:Body
# ALONE-NOT: AreHeldFieldsFilled
# ALONE: [[asked]]: boolean {{*}} = IsSlotFilled {{*}}key="a" receivers=[L0]
# ALONE-NEXT: CheckProof [[asked]] {{*}}source=Field
# RUN(ANSWER): run-in-shell
# ANSWER: 3 0 2 3 0
# ANSWER-NEXT: exited with 0

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="early" declared={type=anything}}, {key="a" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 kind=Instance name="B" module=m0 base=L0 constructor=f2 fields=[{key="b" declared={type=anything} flags=[IsRequired]}] supertypes=[L0] flags=[HasHeritage] ownFieldCount=1
layout L2 kind=Instance name="C" module=m0 base=L1 constructor=f3 fields=[{key="c" declared={type=anything} flags=[IsRequired]}] supertypes=[L0, L1] flags=[HasHeritage] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Convert v2 declared={type=f1 flags=[IsFromCompiler]}
    v4 = ResolveHeritage v3
    v5 = NewClosure function=f2
    v6 = NewClass v5, v3, v4 layout=L1
    v7 = FinishClass v6 layout=L1
    v8 = Convert v7 declared={type=f2 flags=[IsFromCompiler]}
    v9 = ResolveHeritage v8
    v10 = NewClosure function=f3
    v11 = NewClass v10, v8, v9 layout=L2
    v12 = FinishClass v11 layout=L2
    v13 = Convert v12 declared={type=f3 flags=[IsFromCompiler]}
    v14 = NewClosure function=f4
    v15 = NewClosure function=f5
    v16 = Integer integer=1
    v17 = Call v15, -, v13, v16 calleeName="make"
    v18 = Call v14, -, v17 calleeName="read"
    v19 = Integer integer=0
    v20 = Call v15, -, v13, v19 calleeName="make"
    v21 = Call v14, -, v20 calleeName="read"
    v22 = Integer integer=2
    v23 = Call v15, -, v3, v22 calleeName="make"
    v24 = PropGet v23 key="a"
    v25 = Integer integer=3
    v26 = Call v15, -, v8, v25 calleeName="make"
    v27 = PropGet v26 key="b"
    v28 = Call v15, -, v8, v19 calleeName="make"
    v29 = PropGet v28 key="b"
    v30 = Builtin builtin=GlobalThis
    v31 = PropGet v30 key="print" [isFreeName]
    v32 = Call v31, -, v18, v21, v24, v27, v29 calleeName="print"
    Return v32
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0}
    v5 = ToBoolean v1
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    PropSet v4, v1 key="early"
    Jump -> next b2()
  b2():
    PropSet v4, v1 key="a"
    Return v4
}
function f2 name="B" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1
    v5 = Convert v4 declared={type=L1}
    PropSet v5, v2 key="b"
    Return v5
}
function f3 name="C" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L2
    v5 = Convert v4 declared={type=L2}
    PropSet v5, v2 key="c"
    Return v5
}
function f4 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    v2 = PropGet v0 key="b"
    v3 = Add v1, v2
    v4 = PropGet v0 key="c"
    v5 = Add v3, v4
    Return v5
}
function f5 name="make" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Construct v0, -, v1 calleeName="K"
    Return v2
}
