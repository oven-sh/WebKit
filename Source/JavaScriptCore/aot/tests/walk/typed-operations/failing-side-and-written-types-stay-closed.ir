# typed operations go by proof alone. On the side where the test failed nothing is proven, and a written type proves nothing: both operators stay closed, and no test is put in
# function add(v, n: number) { if (typeof v === "number") return v; return v + n * n; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = Mul {{*}}form=Generic
# CHECK: = Add {{*}}form=Generic
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: form=Numbers
# RUN(ONE): walk f1 mechanisms=none+TypedOperations
# ONE-COUNT-1: = TypeTest
# ONE-NOT: = TypeTest

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="add" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return v3
  b2(v4):
    v5 = Convert v1 declared={type=number}
    v6 = Mul v5, v5
    v7 = Add v4, v6
    Return v7
}
