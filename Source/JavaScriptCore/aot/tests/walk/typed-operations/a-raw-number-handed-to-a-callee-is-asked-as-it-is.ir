# function give(at) { for (let turn = 0; turn < 1; turn++) if (at === -1) throw at; return at * 7 + 1; } function mix(sum, value) { for (let turn = 0; turn < 1; turn++) sum = (sum * 33 + value) % 1000003; return sum; } function work() { return mix(give(1), give(2)); }
# What give() hands back lies in a raw Double, and mix() believes of its parameters that they have no fraction. The form says "a number" and no more, so the door in front of the call asks: of the raw value as it is. No box is made for the question.
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: [[given]]: {{*}} @Double = CallDirect {{*}} function=f1
# CHECK-NOT: = Box
# CHECK: CheckProof [[given]] checkedType=int|whole typeWithoutProof=number
# CHECK-NOT: = Box
# CHECK: = CallDirect [[given]], {{*}} function=f2

variable g0 name="give" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="mix" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0 calleeName="work"
    Return v1
}
function f1 name="give" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer
    v2 = Convert v1 declared={type=number}
    Jump -> next b1(v2)
  b1(v3: number):
    LoopHint
    v5 = Integer integer=1
    v6 = Less v3, v5
    Branch v6 -> taken b2(), notTaken b5()
  b2():
    v7 = Integer integer=-1
    v8 = StrictEq v0, v7
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    Throw v0
  b4():
    v9 = Increment v3
    v10 = Convert v9 declared={type=number}
    Jump -> next b1(v10)
  b5():
    v11 = Integer integer=7
    v12 = Mul v0, v11
    v13 = Integer integer=1
    v14 = Add v12, v13
    v15 = Convert v14 declared={type=number}
    Return v15
}
function f2 name="mix" module=m0 length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = Integer
    v3 = Convert v2 declared={type=number}
    Jump -> next b1(v0, v3)
  b1(v4: number, v5: number):
    LoopHint
    v7 = Integer integer=1
    v8 = Less v5, v7
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Integer integer=33
    v10 = Mul v4, v9
    v11 = Add v10, v1
    v12 = Integer integer=1000003
    v13 = Mod v11, v12
    v14 = Convert v13 declared={type=number}
    v15 = Increment v5
    v16 = Convert v15 declared={type=number}
    Jump -> next b1(v14, v16)
  b3():
    v17 = Convert v4 declared={type=number}
    Return v17
}
function f3 name="work" module=m0 thisType={type=anything} results=[{type=number}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = GetModuleVariable variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="seed"
    v4 = Integer
    v5 = BitOr v3, v4
    v6 = Call v1, -, v5 calleeName="give"
    v7 = GetModuleVariable variable=g0
    v8 = Integer integer=2
    v9 = Call v7, -, v8 calleeName="give"
    v10 = Call v0, -, v6, v9 calleeName="mix"
    ReturnCall v10 casts=[{declared={type=number}}]
}
