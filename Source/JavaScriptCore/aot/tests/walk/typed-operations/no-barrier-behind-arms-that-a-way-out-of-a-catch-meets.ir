# try { const made = { x: give(a), y: a }; give(); if (a) { made.x = a; kept = made; } else { made.x = give; kept = made; } } catch {}
# Both arms store into one cell, so one barrier behind their join would do for both stores.
# But the cell is made in the block that throws to the `catch`, behind a call that may throw, and the way out of the `catch` meets the arms: it has not come by the cell. No barrier names the cell there
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+Handlers
# CHECK-LABEL: code f1:Body
# CHECK: = PutSlot {{*}}key="x"
# CHECK: = PutSlot {{*}}key="x"
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+Handlers
# NEVER-NOT: RememberOwner
# NEVER-NOT: the walk failed

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="kept" module=m0 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="underCatch" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Jump -> next b1()
  b1() handler=b4():
    v2 = Call v1, -, v0
    v3 = NewObject -, v2, v0 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    v5 = Call v1, -
    v6 = ToBoolean v0
    Branch v6 -> taken b2(), notTaken b3()
  b2() handler=b4():
    PropSet v4, v0 key="x" mode=Strict
    PutModuleVariable v4 variable=g0
    Jump -> next b5()
  b3() handler=b4():
    PropSet v4, v1 key="x" mode=Strict
    PutModuleVariable v4 variable=g0
    Jump -> next b5()
  b4() role=CatchHandler:
    v11 = CatchValue
    Jump -> next b5()
  b5():
    Return v0
}
