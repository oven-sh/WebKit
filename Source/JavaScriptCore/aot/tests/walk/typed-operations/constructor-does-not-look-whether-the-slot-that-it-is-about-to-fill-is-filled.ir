# function make() {
#   function Box(value) { if (this.held === undefined) this.held = value; }
#   Box.prototype.fill = function fill(value) { this.held = value; };
#   return Box;
# }
# globalThis.First = make();        globalThis.Second = make();
# The constructor reads a field of the object that it is itself making, in front of its own store: at every birth the slot is empty. The look at the slot as the last resort would fail each time and pay for the
# read by name on top of it (IncomingMessage in node:_http_incoming: +155 instructions a request). So outside of loops the last resort is not taken off an object that the body being read is making.
# Box may be evaluated again, so the looks at the cell are refused; the constructor is marked as of a checked file (by hand), so they would pay: the last resort is what is left.
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: PropGet v0 key="held"
# RUN(LOOK): walk f2 mechanisms=all
# LOOK-LABEL: code f2:Body
# LOOK-NOT: IsSlotFilled
# LOOK-NOT: = GetSlot

