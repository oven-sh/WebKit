# function beside(view: Int32Array, n: number) { let total = 0; for (let i = 0; i < n; i++) total = (total + view[i] + view[i + 1]) | 0; return total; }
# function behindOtherCode(view: Int32Array, n: number) { let total = 0; for (let i = 0; i < n; i++) { total = (total + view[i]) | 0; keep(); total = (total + view[i + 1]) | 0; } return total; }
# function stored(view: Int32Array, n: number) { for (let i = 0; i < n; i++) view[i + 1] = view[i] + 1; return view[2]; }
# An access that is not known to lie inside the view compares its position with the length that is at hand and goes by the vector that is at hand. It asks the view for neither, nor for its kind.
# Where the turns leave the storage of views alone both are read in front of the loop. Code that nobody has seen may resize a buffer or hand it away, so behind it both are read again.
# A store into a view writes its elements, not its storage. Each access once asked for the kind, the length and the vector: 6 instructions for 3.
# RUN: walk f1 f2 f3 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[length]]: {{*}} = GetTypedArrayLength
# CHECK: [[vector]]: {{*}} = GetTypedArrayVector
# CHECK: isLoopHead=true
# CHECK-NOT: = GetTypedArrayLength
# CHECK-NOT: = GetTypedArrayVector
# CHECK: = GetTypedArrayElement {{*}}, [[vector]], [[length]] typedArrayType
# CHECK: = GetTypedArrayElement {{*}}, [[vector]], [[length]] typedArrayType
# CHECK-LABEL: code f2:Body
# CHECK: isLoopHead=true
# CHECK: [[lengthInFront]]: {{*}} = GetTypedArrayLength
# CHECK: = GetTypedArrayElement {{*}}, [[lengthInFront]] typedArrayType
# CHECK: = Call
# CHECK: [[lengthBehind]]: {{*}} = GetTypedArrayLength
# CHECK: = GetTypedArrayElement {{*}}, [[lengthBehind]] typedArrayType
# CHECK-LABEL: code f3:Body
# CHECK: [[lengthOfStored]]: {{*}} = GetTypedArrayLength
# CHECK: [[vectorOfStored]]: {{*}} = GetTypedArrayVector
# CHECK: isLoopHead=true
# CHECK: = GetTypedArrayElement {{*}}, [[vectorOfStored]], [[lengthOfStored]] typedArrayType
# CHECK: = PutTypedArrayElement {{*}}, [[vectorOfStored]], [[lengthOfStored]] typedArrayType
# RUN(SHELL): run-in-shell globalThis.keep = () => { }; globalThis.sink = (first, second, third) => { print(String(first) + " " + String(second) + " " + String(third)); };
