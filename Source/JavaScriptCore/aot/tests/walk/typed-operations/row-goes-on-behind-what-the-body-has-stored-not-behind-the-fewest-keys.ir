# CHECK: HasKeyOrder {{*}} layout=L0 fields=[0, 1]
# CHECK: PutSlotOrAdd {{*}}key="events" receivers=[L0] {{*}}orderWordAfter=98304
# CHECK: PutSlotOrAdd {{*}}key="count" receivers=[L0] {{*}}orderWordAfter=131072

