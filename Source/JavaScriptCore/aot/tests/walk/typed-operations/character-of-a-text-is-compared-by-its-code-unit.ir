# `s[i]` of a proven text under a proven integer is written out: the bounds, the character inside, undefined outside. Beside the character meets its code unit, -1 outside,
# and a comparison with a written text or with another character asks the integer. The character that nobody else reads is never made
# function letter(s, i) { if (typeof s === "string" && (i | 0) === i) return [s[i]]; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = GetStringLength
# CHECK: = Less
# CHECK: = Substring
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = ElemGet
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = Substring
# function isComma(s, i) { if (typeof s === "string" && (i | 0) === i) return [s[i] === ","]; }
# RUN(COMMA): walk f2 mechanisms=none+TypedOperations
# COMMA-LABEL: code f2:Body
# COMMA: = GetStringCodeUnit
# COMMA: = StrictEq {{*}}form=Integers
# RUN(UNMADE): walk f2 mechanisms=none+TypedOperations
# UNMADE-NOT: = Substring
# -0 names the first character and 1.5 none, and neither is an integer: function underNumber(s, i) { if (typeof s === "string" && typeof i === "number") return [s[i]]; }
# RUN(FRACTION): walk f4 mechanisms=none+TypedOperations
# FRACTION-LABEL: code f4:Body
# FRACTION-NOT: = Substring
# FRACTION: = ElemGet
# the edge behind the test hands the character on, narrowed to the text, so the test keeps its operands: function commaItself(s, i) { if (typeof s === "string" && (i | 0) === i) { const c = s[i]; if (c === ",") return c; } }
# RUN(NARROWED): walk f5 mechanisms=none+TypedOperations
# NARROWED-LABEL: code f5:Body
# NARROWED: = Substring
# NARROWED-NOT: form=Integers
# NARROWED: Return
# function sameLetter(s, t, i) { if (typeof s === "string" && typeof t === "string" && (i | 0) === i) return [s[i] === t[i]]; }
# RUN(BOTH): walk f6 mechanisms=none+TypedOperations
# BOTH-LABEL: code f6:Body
# BOTH: = GetStringCodeUnit
# BOTH: = GetStringCodeUnit
# BOTH: = StrictEq {{*}}form=Integers
# NaN equals nothing, and neither does -1 equal 32: function isBlank(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.charCodeAt(i) === 32]; }
# RUN(CODE): walk f7 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CODE-LABEL: code f7:Body
# CODE: = GetStringCodeUnit
# CODE: = StrictEq {{*}}form=Integers
# -1 would equal -1 where NaN does not: function isMinusOne(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.charCodeAt(i) === -1]; }
# RUN(MINUS): walk f8 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# MINUS-LABEL: code f8:Body
# MINUS-NOT: = StrictEq {{*}}form=Integers
# MINUS: = NewArray

