  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Integer
    Jump -> next b1(v1, v2, v3)
  b1(v4, v5, v6):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b2(), notTaken b8()
  b2():
    v9 = NewArray v5, v4 contents=anything
    v10 = IteratorOpen v9 elementCount=2 [isDestructuring]
    Jump -> next b3()
  b3() handler=b7():
    v11 = IteratorResume v10 stepIndex=0
    v12 = ResultAt v11
    v13 = ResultAt v11 index=1
    Jump -> next b4()
  b4() handler=b7():
    v14 = IteratorResume v10 stepIndex=1
    v15 = ResultAt v14
    v16 = ResultAt v14 index=1
    Jump -> next b5()
  b5():
    IteratorClose v10
    Jump -> next b6()
  b6():
    v18 = Increment v6
