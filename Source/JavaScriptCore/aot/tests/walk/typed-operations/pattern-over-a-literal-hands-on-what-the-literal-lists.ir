# `[a, b] = [b, a]`: nothing but the pattern names the literal, so the step that is written as number k hands on what the literal lists at k.
# What comes round is what the other parameter of the head held, so both heads hold 1 or 2 and nothing wider. Nothing needs the list, and the sweep drops it.
# function swap(n) { let a = 1, b = 2; for (let i = 0; i < n; i++) [a, b] = [b, a]; return a * 10 + b; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: ([[a]]: int[1, 2] {{*}}, [[b]]: int[1, 2] {{*}}isLoopHead=true
# CHECK: Jump -> next {{*}}([[b]], [[a]],
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations
# NEVER-NOT: = NewArray
# NEVER-NOT: @@iterator
# NEVER-NOT: NewHeapWords
# NEVER-NOT: = Call
# RUN(CLOSED): walk f1 mechanisms=none
# CLOSED: = NewArray
# CLOSED: = PropGet {{*}}key=@@iterator
# CLOSED: = NewHeapWords

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
