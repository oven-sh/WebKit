# the block of the second comparison is entered by a second edge, so it is walked whatever the first comparison does, and leads its own edges. Whoever led them at the first comparison too would enter their targets twice. Both comparisons stay
# function pickLate(node, flag) { if ((flag && node.kind === 1) || node.kind === 4) return 10; return 20; }   by hand: the second comparison reads the holder under the name that it has in front of both
# f2 is the same without the second edge, so that the one property differs: it is one Switch
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# CHECK-LABEL: code f1:Body
# CHECK: = GetSlot {{*}}key="kind"
# CHECK: Branch
# CHECK: = GetSlot {{*}}key="kind"
# CHECK: Branch
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# NEVER-NOT: Switch
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: Switch
# RUN(ALONE): walk f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# ALONE: Switch {{*}}cases=[1, 4]
# RUN(SHELL): run-in-shell let next = 0; const kinds = [1, 4, 5]; globalThis.source = () => kinds[next++ % kinds.length]; globalThis.sink = (...told) => { print(told.join()); };
# SHELL: 10,20,10,10,20,20,10,10,20
# SHELL-NEXT: exited with 0

layout L0 name="Node" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="source" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Boolean boolean=true
    v5 = Boolean
# REPEAT: i = 0..2
    v%(i*6+6) = Call v1, -
    v%(i*6+7) = NewObject -, v%(i*6+6) layout=L0 fields=[0]
    v%(i*6+8) = FinishObject v%(i*6+7)
    v%(i*6+9) = Call v2, -, v%(i*6+8), v4
    v%(i*6+10) = Call v2, -, v%(i*6+8), v5
    v%(i*6+11) = Call v3, -, v%(i*6+8)
# END REPEAT
    v24 = PropGet v0 key="sink" [isFreeName]
    v25 = Call v24, -, v9, v10, v15, v16, v21, v22, v11, v17, v23
    Return v25
}
function f1 name="pickLate" module=m0 length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b4()
  b1():
    v3 = PropGet v0 key="kind"
    v4 = Integer integer=1
    v5 = StrictEq v3, v4
    Branch v5 -> taken b2(| 0), notTaken b3(| 0)
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Jump -> next b7()
  b3(v8):
    v9 = NarrowByField v0, v8 key="kind"
    Jump -> next b4()
  b4():
    v10 = PropGet v0 key="kind"
    v11 = Integer integer=4
    v12 = StrictEq v10, v11
    Branch v12 -> taken b5(| 0), notTaken b6(| 0)
  b5(v13):
    v14 = NarrowByField v0, v13 key="kind"
    Jump -> next b7()
  b6(v15):
    v16 = NarrowByField v0, v15 key="kind"
    Jump -> next b8()
  b7():
    v17 = Integer integer=10
    Return v17
  b8():
    v18 = Integer integer=20
    Return v18
}
function f2 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b6()
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Jump -> next b3()
  b3():
    v8 = PropGet v0 key="kind"
    v9 = Integer integer=4
    v10 = StrictEq v8, v9
    Branch v10 -> taken b4(| 0), notTaken b5(| 0)
  b4(v11):
    v12 = NarrowByField v0, v11 key="kind"
    Jump -> next b6()
  b5(v13):
    v14 = NarrowByField v0, v13 key="kind"
    Jump -> next b7()
  b6():
    v15 = Integer integer=10
    Return v15
  b7():
    v16 = Integer integer=20
    Return v16
}
