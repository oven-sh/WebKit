# the variable, the parameter and the result hand their values round in a ring, and only the variable starts empty. What `next` hands back is a value all the same
# let state;  function next(before) { return before; }  function turn() { state = next(state); return { kept: next(state) }; }  state = "one";  turn().kept
# RUN: walk f2 mechanisms=none+TypedOperations
# CHECK-LABEL: code f2:Body
# CHECK: [[word]]: string @{{*}} = Call
# CHECK: [[again]]: string @{{*}} = Call
# CHECK: = NewObject {{*}}[[again]]{{*}}layout=L0

layout L0 module=m0 fields=[{key="kept" declared={type=string} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="next" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="turn" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="state" module=m0 declared={type=string|absent}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="one"
    PutModuleVariable v0 variable=g2
    v2 = GetModuleVariable variable=g1
    v3 = Call v2 calleeName="turn"
    v4 = PropGet v3 key="kept"
    Return v4
}
function f1 name="next" module=m0 length=1 thisType={type=anything} parameters=[{type=string}] results=[{type=string}] {
  b0(v0: string):
    Return v0
}
function f2 name="turn" module=m0 thisType={type=anything} results=[{type=L0}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g2
    v2 = CheckInitialized v1 name="state"
    v3 = Call v0, -, v2 calleeName="next"
    PutModuleVariable v3 variable=g2
    v5 = GetModuleVariable variable=g2
    v6 = CheckInitialized v5 name="state"
    v7 = Call v0, -, v6 calleeName="next"
    v8 = Convert v7 declared={type=string}
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    Return v10
}
