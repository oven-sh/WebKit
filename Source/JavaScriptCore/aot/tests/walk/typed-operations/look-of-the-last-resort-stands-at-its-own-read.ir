# function make() {
#   function Box(value, fills) { this.tag = 1; this.kind = 1; if (fills) this.held = value; }
#   Box.prototype.peek = function peek() { return this.held; };
#   Box.prototype.three = function three() { return [this.tag, this.kind, this.held]; };
#   return Box;
# }
# globalThis.First = make();        globalThis.Second = make();
# Two fields of birth and `held`, which may be absent, read one behind the other (as read-of-a-field-that-is-not-of-birth-looks-at-its-slot-outside-of-loops-too.ir: Box may be evaluated again, `three` is marked
# as checked and its receiver as written, by hand). The looks of a stretch are all asked in front of it, and one that fails sends the whole stretch to the closed block. A field of birth is there; a look of the
# LAST RESORT says nothing of the kind: with `held` absent all three reads went by name (sixteen fields of birth beside it: +67%). Outside of loops such a look counts in a stretch only as the operation that
# opens it: here the stretch is `tag` and `kind`, and `held` looks at its slot at its own read: empty, that one read goes as it is written.
# RUN: walk f4 mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: IsSlotFilled {{*}}key="tag"
# CHECK: IsSlotFilled {{*}}key="kind"
# CHECK: GetSlot v0 key="held" receivers=[L0] level=Expected
# RUN(ALONE): walk f4 mechanisms=all
# ALONE-LABEL: code f4:Body
# ALONE-NOT: IsSlotFilled {{*}}key="held"
# ALONE-NOT: PropGet {{*}}key="held"

module m0 path="w7.js" displayPath="w7.js" body=f0 namespaceLayout=L(m0)
