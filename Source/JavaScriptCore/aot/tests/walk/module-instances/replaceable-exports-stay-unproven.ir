# A mock may store a value of any type into a replaceable export, also after it is initialized. A loop reads it in every iteration and checks it there.
# RUN: walk f5:Body
# CHECK: isLoopHead=true
# CHECK: anything{{*}} = GetEnvironmentField {{*}} layout=L1
# CHECK: CheckInitialized

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="user.js" displayPath="user.js" flags=[MayBeReevaluated] body=f1 requests=[{target=m2 completes=true}]
module m2 path="dependency.js" displayPath="dependency.js" flags=[MayBeMocked, MayBeReevaluated] body=f2 exports=[{name="step" kind=Field layout=L1 field=0}]
entry module=m0
layout L0 kind=Environment module=m1 fields=[{key=@"0" declared={type=env L1 flags=[IsFromCompiler]} flags=[IsImmutable]}, {key=@"1" declared={type=anything|absent flags=[IsFromCompiler]}}, {key=@"2" declared={type=anything|absent flags=[IsFromCompiler]}}]
layout L1 kind=Environment module=m2 fields=[{key=@"0" declared={type=anything|absent flags=[IsVariableOfModule]} flags=[IsReplaceable] variableName="step"}, {key=@"1" declared={type=anything|absent flags=[IsFromCompiler]}}, {key=@"2" declared={type=anything|absent flags=[IsFromCompiler]}}]
variable g0 module=m1 declared={type=env L0 flags=[IsFromCompiler]} flags=[HoldsInstance]
variable g1 module=m1 declared={type=anything} initialization=Undefined flags=[IsReplaceable, GuardsInstance]
variable g2 module=m1 declared={type=anything} initialization=Function function=f3 flags=[IsReplaceable, AllocatesInstance]
variable g3 module=m2 declared={type=env L1 flags=[IsFromCompiler]} flags=[HoldsInstance]
variable g4 module=m2 declared={type=anything} initialization=Undefined flags=[IsReplaceable, GuardsInstance]
variable g5 module=m2 declared={type=anything} initialization=Function function=f4 flags=[IsReplaceable, AllocatesInstance]
variable g6 module=m1 declared={type=anything} initialization=Undefined flags=[IsReplaceable, HasSeveralInstances]
variable g7 module=m2 declared={type=anything} initialization=Undefined flags=[IsReplaceable, HasSeveralInstances]
moduleinstance module=m1 layout=L0 namespaceField=1 deferredNamespaceField=2
moduleinstance module=m2 layout=L1 namespaceField=1 deferredNamespaceField=2
modulelink module=m1 target=m2 link=0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="user" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure v0 function=f5
    v2 = Integer integer=100
    v3 = Call v1, -, v2
    Return v3
}
function f2 name="dependency" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g3
    v1 = Integer integer=3
    PutEnvironmentField v0, v1 layout=L1
    Return
}
function f3 name="allocateUser" module=m1 results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    PutModuleVariable v0 variable=g0
    Return
}
function f4 name="allocateDependency" module=m2 results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1
    PutModuleVariable v0 variable=g3
    Return
}
function f5 name="sum" module=m1 captures=[{type=env L0 flags=[IsFromCompiler]}] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: env L0, v1: number):
    v2 = Integer
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = GetEnvironmentField v0 layout=L0
    v8 = GetEnvironmentField v7 layout=L1
    v9 = CheckInitialized v8 name="step"
    v10 = Add v3, v9
    v11 = Increment v4
    Jump -> next b1(v10, v11)
  b3():
    Return v3
}
