# A callee with a loop is copied where the call says how many turns the loop takes, and the turns are written out. Each turn walks the calls of the turn: where such a call was copied for its own turns again,
# eight times as much was walked for each function of a chain, and the build of seven such functions ended in an abort. So only a call that the unit's own body writes is copied for its turns.
# f4 third > f3 second: copied, three turns > f2 first: called three times.
# RUN: walk f4 mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: frame 1 callee=f3
# CHECK-NOT: callee=f2
# CHECK-COUNT-3: = CallDirect {{*}}function=f2
# CHECK-NOT: = CallDirect {{*}}function=f2
# -- source: a-copy-for-its-turns-stands-in-the-units-own-body-from-source.js
# function leaf(n) { let s = 0; for (let i = 0; i < n; i++) s += i; return s; }
# function first(n) { let s = 0; for (let i = 0; i < n; i++) s += leaf(3); return s; }
# function second(n) { let s = 0; for (let i = 0; i < n; i++) s += first(3); return s; }
# function third(n) { let s = 0; for (let i = 0; i < n; i++) s += second(3); return s; }
# sink(third);
# -- end of source
# records of 6057b57208c25b08

