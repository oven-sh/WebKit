# where i is -4 the key is -0: the element is element 0 and what is stored there is -0. The whole remainder stands in for the key of the access alone, so a store of the key itself is not built under it
# function fill(list: number[], i: number) { const key = (i | 0) % 4; list[key] = key; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = RemainderOfIntegers
# CHECK: [[key]]: {{*}} = Mod
# CHECK: = PutArrayElement

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="fill" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number>, v1: number):
    v2 = Integer integer=0
    v3 = BitOr v1, v2
    v4 = Integer integer=4
    v5 = Mod v3, v4
    ElemSet v0, v5, v5
    v7 = Undefined
    Return v7
}
