# var buffer = new ArrayBuffer(1024), words = new Int32Array(buffer), numbers = new Float32Array(buffer), halves = new Uint16Array(buffer); function run(p) { numbers[p + 1] = words[p]; halves[p + 2] = words[p + 3]; return numbers[p]; }
# The variables mirror one vector and one size, so one check of p covers the words and the numbers, and every access goes by one vector.
# LIBRARY: own
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = GetMirroredLength {{*}} variable=g1
# CHECK: = IsBelowLength
# CHECK-NOT: frequency=Rare
# CHECK: = GetMirroredVector {{*}} variable=g1
# CHECK: = GetTypedArrayElement
# CHECK: = GetMirroredLength {{*}} variable=g3
# CHECK: = IsBelowLength

module m0 path="main.js" displayPath="main.js" body=f0
variable g0 name="buffer" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="words" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="numbers" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="halves" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="run" module=m0 declared={type=anything} initialization=Function function=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ArrayBuffer
    v1 = Integer integer=1024
    v2 = Construct v0, -, v1
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=Int32Array
    v5 = GetModuleVariable variable=g0
    v6 = Construct v4, -, v5
    PutModuleVariable v6 variable=g1
    v8 = Builtin builtin=Float32Array
    v9 = GetModuleVariable variable=g0
    v10 = Construct v8, -, v9
    PutModuleVariable v10 variable=g2
    v12 = Builtin builtin=Uint16Array
    v13 = GetModuleVariable variable=g0
    v14 = Construct v12, -, v13
    PutModuleVariable v14 variable=g3
    v16 = GetModuleVariable variable=g4
    v17 = Integer integer=3
    v18 = Call v16, -, v17
    v19 = Integer integer=-3
    v20 = Call v16, -, v19
    Return v20
}
function f1 name="run" module=m0 length=1 thisType={type=anything} parameters=[{type=i32}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = GetModuleVariable variable=g2
    v2 = Integer integer=1
    v3 = Add v0, v2
    v4 = GetModuleVariable variable=g1
    v5 = ElemGet v4, v0
    ElemSet v1, v3, v5
    v7 = GetModuleVariable variable=g3
    v8 = Integer integer=2
    v9 = Add v0, v8
    v10 = GetModuleVariable variable=g1
    v11 = Integer integer=3
    v12 = Add v0, v11
    v13 = ElemGet v10, v12
    ElemSet v7, v9, v13
    v15 = GetModuleVariable variable=g2
    v16 = ElemGet v15, v0
    Return v16
}
