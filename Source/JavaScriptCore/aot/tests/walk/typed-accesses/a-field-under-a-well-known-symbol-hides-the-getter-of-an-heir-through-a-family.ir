# A FIELD UNDER A WELL-KNOWN SYMBOL HIDES AN ACCESSOR OF THE CLASS, AND NO LAYOUT LISTS SUCH A FIELD.
# class Base { [Symbol.toStringTag] = "own"; }
# class Loud extends Base { get [Symbol.toStringTag]() { return "getter"; } }
# class First extends Base { }   class Second extends Base { }   class Third extends Base { }   class Fourth extends Base { }
# function tagOf(loud) { return loud[Symbol.toStringTag]; }
# export const others = [new First(), new Second(), new Third(), new Fourth()];
# export const answer = tagOf(new Loud());
# The answer is "own". The walk found the getter above objects of Loud and took its answer without a look at the object: "getter".
# One layout at a time Link lets a layout go where a definition finds an accessor and no listed field. FIVE LAYOUTS AND MORE ARE A FAMILY: the definition in Base's initializer is tied to each of them as a store is,
# and the tie knew nothing of definitions. Now a store or a definition through a family or through lost objects, under a well-known symbol that the layout does not list, lets the layout go where its class has an accessor under the key.
# Nothing unknown is called here: a call of `print` would let every class go, and the faulty build would answer rightly.
# OPTIONS: mechanisms=all exclude=CodeOutsideImage
# RUN: walk f0
# CHECK-NOT: String string="getter"
# CHECK: = PropGet {{*}}key=@@toStringTag
# CHECK-NOT: String string="getter"
