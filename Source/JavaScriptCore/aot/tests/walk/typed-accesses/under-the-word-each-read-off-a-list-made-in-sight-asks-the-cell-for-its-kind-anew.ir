# function pick(i: number) { const table = [10, 20, 30, 40]; return table[i & 3] * 1000 + table[(i >> 2) & 3]; }      sink(pick);
# Two reads off one list that is made in sight. Each names the kind of storage that the list was born with, by what the walk remembers. Under the word that checks proofs when the code runs,
# each read asks THE CELL for that kind in front of itself. An equal question that has been answered on the way is found again elsewhere; the test of a check is built where it stands:
# it was the first read's boolean that the second read checked, so the net looked at the cell once for two reads.
# RUN: walk f1 mechanisms=all testing=CheckProofsAtRunTime
# CHECK-LABEL: code f1:Body
# CHECK: [[first]]: {{*}} = HasArrayStorage {{*}}arrayStorage=Int32
# CHECK: CheckProof [[first]]
# CHECK: = GetArrayElement {{*}}arrayStorage=Int32 level=Proven
# CHECK: [[second]]: {{*}} = HasArrayStorage {{*}}arrayStorage=Int32
# CHECK: CheckProof [[second]]
# CHECK: = GetArrayElement {{*}}arrayStorage=Int32 level=Proven
# RUN(ANSWER): run-in-shell testing=CheckProofsAtRunTime globalThis.sink = pick => { print(pick(0), pick(1), pick(6), pick(15)); };
# ANSWER: 10010 20010 30020 40040
# ANSWER-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
data d0 root=Array{contents=anything elements=[Number{value=10}, Number{value=20}, Number{value=30}, Number{value=40}]} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="pick" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Data data=d0
    v2 = Integer integer=3
    v3 = BitAnd v0, v2
    v4 = ElemGet v1, v3
    v5 = Integer integer=1000
    v6 = Mul v4, v5
    v7 = Integer integer=2
    v8 = RShift v0, v7
    v9 = Integer integer=3
    v10 = BitAnd v8, v9
    v11 = ElemGet v1, v10
    v12 = Add v6, v11
    Return v12
}
