# var words = new Int32Array(64); function run(p) { var n = 0; while (true) { n = (n + words[p]) | 0; if (words[p] === 0) { sink(n); ++p; continue; } p = (p + words[p + 1]) | 0; if (n > 1000) return n; } }
# The call may store another view into the variable. The vector and the length that the variable mirrors are read in front of the iterations without the call.
