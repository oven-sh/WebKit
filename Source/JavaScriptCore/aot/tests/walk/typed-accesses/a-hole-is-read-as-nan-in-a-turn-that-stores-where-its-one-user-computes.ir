# function scale(list: number[], by: number) { for (let i = 0; i < list.length; i++) list[i] = list[i] * by; }
# Over double storage a hole is a NaN in memory. Where the one user of the read is + - * / with a number, undefined and NaN give the same, so the read takes the NaN as it lies: no test of the hole, no test of the type.
# That held in turns that only read. In a turn that stores, a hole left the turn instead, asked first: five instructions of fourteen. Now the one user decides there too.
# The product of a hole is NaN, and the store's own test of what fits double storage begins the turn again in the other copy, as for every NaN.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[element]]: number @Double = GetArrayElement {{*}}arrayStorage=Double level=Proven [keyIsIntegral, isInBounds, readsHoleAsNaN]
# CHECK-NEXT: [[product]]: number @Double = Mul [[element]], v1 form=Numbers
# CHECK-NEXT: = StrictEq [[product]], [[product]] form=Numbers
# CHECK: PutDoubleIndex {{*}}[[product]]
# RUN(COUNTED): compile StoringLoopHoleChecksRemoved mechanisms=all
# COUNTED: statistic StoringLoopHoleChecksRemoved 1
# Another user sees undefined: function count(list: number[]) { let holes = 0; for (let i = 0; i < list.length; i++) { if (list[i] === undefined) holes++; list[i] = 0.25; } return holes; }
# There a hole leaves the turn as ever.
# RUN(OTHER): walk f2 mechanisms=all
# OTHER-LABEL: code f2:Body
# OTHER-NOT: readsHoleAsNaN
# RUN(SHELL): run-in-shell globalThis.sink = (...all) => { print(all.join(" ")); };
# SHELL: 0.75 NaN 1.75 true 1 0.25 0.25 0.25
# SHELL: exited with 0

