# function pick(i: number) { const table = [10, 20, 30, 40]; return table[i & 3]; }   function anywhere(i: number) { const table = [10, 20, 30, 40]; return table[i | 0]; }
# function named(i: number) { const table = ["a", "b", "c", "d"]; return table[i & 3]; }   function made(a, b, i: number) { const pair = [a, b]; return pair[i & 1]; }
# A list that is made here and that nothing has changed since has the storage that it was born with: the walk has seen the making, and every operation between it and the read.
# A list of constants is born with the kind that arrayStorageOfData() gives, which the image and the emitter ask too. So the read names the kind: no look at the cell, and what comes out of storage for whole numbers is a whole number or nothing.
# Its length is known as well, and it has no hole: an index that lies inside finds an element: one load.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetArrayElement {{*}}arrayStorage=Int32 level=Proven [keyIsIntegral, isInBounds, isPresent]
# An index that may lie anywhere is still held against the length, and the kind is named.
# RUN(ANYWHERE): walk f2 mechanisms=all
# ANYWHERE-LABEL: code f2:Body
# ANYWHERE: = GetArrayElement {{*}}arrayStorage=Int32 level=Proven [keyIsIntegral
# RUN(NAMED): walk f3 mechanisms=all
# NAMED-LABEL: code f3:Body
# NAMED: = GetArrayElement {{*}}arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds, isPresent]
# RUN(MADE): walk f4 mechanisms=all
# MADE-LABEL: code f4:Body
# MADE: = GetArrayElement {{*}}arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds
# THE RED CONTROLS. Code that nobody has seen gets the list: function seen(look, i: number) { const table = [10, 20, 30, 40]; look(table); return table[i & 3]; }
# RUN(SEEN): walk f5 mechanisms=all
# SEEN-NOT: arrayStorage=Int32 level=Proven
# RUN(LEFT): walk f5 mechanisms=all
# LEFT-NOT: isPresent
# A literal with a hole says nothing of its storage here: function holed(i: number) { const table = [10, , 30, 40]; return table[i & 3]; }
# RUN(HOLED): walk f6 mechanisms=all
# HOLED-NOT: isPresent
# A native that may give the list other storage ends what is known: function filled(i: number, x) { const table = [10, 20, 30, 40]; table.fill(x); return table[i & 3]; }
# RUN(FILLED): walk f7 mechanisms=all
# FILLED-NOT: arrayStorage=Int32 level=Proven
# Under the word each kind that is named is asked of the cell in front of the read, and each element that is said to be there is looked for.
# RUN(ASKED): walk f1 mechanisms=all testing=CheckProofsAtRunTime
# ASKED-LABEL: code f1:Body
# ASKED: [[kind]]: {{*}} = HasArrayStorage {{*}}arrayStorage=Int32
# ASKED: CheckProof [[kind]]
# ASKED: [[there]]: {{*}} = IsElementPresent {{*}}arrayStorage=Int32
# ASKED: CheckProof [[there]]
# ASKED: = GetArrayElement {{*}}arrayStorage=Int32 level=Proven
# RUN(ANSWER): run-in-shell globalThis.sink = (pick, anywhere, named, made, seen, holed, filled) => { print(pick(0), pick(1), pick(6), pick(7)); print(anywhere(3), anywhere(4), anywhere(-1)); print(named(1), named(7)); print(made("x", "y", 1), made(1.5, null, 0)); print(seen(list => { list[1] = "changed"; list.length = 2; }, 1), seen(list => { list.length = 2; }, 3)); print(holed(1), holed(2)); print(filled(1, "z"), filled(2, 0.5)); };
# ANSWER: 10 20 30 40
# ANSWER-NEXT: 40 undefined undefined
# ANSWER-NEXT: b d
# ANSWER-NEXT: y 1.5
# ANSWER-NEXT: changed undefined
# ANSWER-NEXT: undefined 30
# ANSWER-NEXT: z 0.5
# ANSWER-NEXT: exited with 0
# RUN(CHECKED): run-in-shell testing=CheckProofsAtRunTime,CheckBoundsAtRunTime globalThis.sink = (pick, anywhere, named, made, seen, holed, filled) => { print(pick(0), pick(1), pick(6), pick(7)); print(anywhere(3), anywhere(4), anywhere(-1)); print(named(1), named(7)); print(made("x", "y", 1), made(1.5, null, 0)); print(seen(list => { list[1] = "changed"; list.length = 2; }, 1), seen(list => { list.length = 2; }, 3)); print(holed(1), holed(2)); print(filled(1, "z"), filled(2, 0.5)); };
