# class Point { #x = 1; #y = 2; z = 3; w = 4; }
# The definitions of the private names stand in the stretch, in front of the first store that looks at the cell. The order word counts from the front of the stretch, where the cell has just been made and lists nothing: that is known without a test.
# If it counted from the word in front of `z`, which lists the brand, #x and #y, all five fields would be added by a stub.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:
# CHECK-NOT: HasKeyOrder
# CHECK: PutSlotOrAdd {{*}} key=#"#"@L0 {{*}} orderWordAfter=
# CHECK: PutSlotOrAdd {{*}} key=#"#x"@L0 {{*}} orderWordAfter=
# CHECK: PutSlotOrAdd {{*}} key=#"#y"@L0 {{*}} orderWordAfter=
# CHECK: PutSlotOrAdd {{*}} key="z" {{*}} orderWordAfter=
# CHECK: PutSlotOrAdd {{*}} key="w" {{*}} orderWordAfter=

layout L0 kind=Instance name="Point" module=m0 constructor=f1 fields=[{key=#"#"@L0 declared={type=classtoken flags=[IsFromCompiler]} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}, {key=#"#x"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}, {key=#"#y"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}, {key="z" declared={type=anything} flags=[IsRequired]}, {key="w" declared={type=anything} flags=[IsRequired]}] ownFieldCount=5
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=classtoken flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClassToken layout=L0
    PutModuleVariable v0 variable=g1
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g0
    v5 = FinishClass v3 layout=L0
    v6 = Builtin builtin=GlobalThis
    PropSet v6, v5 key="Point"
    v8 = Undefined
    Return v8
}
function f1 name="Point" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0}
    v4 = CallDirect v3 function=f2
    Return v3
}
function f2 module=m0 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=L0} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v2 = GetModuleVariable variable=g1
    PrivateDefine v1, v2, v2 layout=L0
    v4 = Integer integer=1
    v5 = GetModuleVariable variable=g1
    PrivateDefine v1, v5, v4 layout=L0 field=1
    v7 = Integer integer=2
    v8 = GetModuleVariable variable=g1
    PrivateDefine v1, v8, v7 layout=L0 field=2
    v10 = Integer integer=3
    PropDefine v1, v10 key="z"
    v12 = Integer integer=4
    PropDefine v1, v12 key="w"
    v14 = Undefined
    Return v14
}
