# function storedBetween(a: number, k: number, other: any) { const t: any[] = ["n" + a, "m" + a, "k" + a, "j" + a]; t[1] = other; return t[k & 3].length; }   function oneOfTwoKinds(a: number, k: number) { const t = ["n" + a, a, "k" + a, a + 1]; return t[k & 3]; }
# A list is made in sight, nothing has written it since, and the position lies inside it: the element read is one of the values that the list was made with. So it has their type: the union of the types of the operands of the making, or of the kinds of the constants.
# No test of its type stands behind the read, and no check of what Link says of the contents: nothing of Link's is leaned on. No more is SHOWN of the element than is shown of the values that the list was made with.
# RUN: walk f1 mechanisms=all
# CHECK: : string @JSValue = GetArrayElement {{*}} arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds, isPresent]
# CHECK: = GetStringLength
# RUN(TESTS): walk f1 mechanisms=all
# TESTS-NOT: = TypeTest
# Under the word that checks proofs at run time the type is asked all the same: that is the oracle of the red controls.
