# RUN(UNTESTED): walk f2 mechanisms=all
# UNTESTED-NOT: = TypeTest
# A store between the making and the read ends what is remembered.
# RUN(STORED): walk f3 mechanisms=all
# STORED-NOT: isPresent
# Two kinds give both.
# RUN(BOTH): walk f4 mechanisms=all
# BOTH: : number|string @JSValue = GetArrayElement {{*}} arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds, isPresent]
# RUN(ANSWER): run-in-shell globalThis.sink = (lengthOfOne, oneOfConstants, storedBetween, oneOfTwoKinds) => { const all = []; for (let k = 0; k < 5; k++) all.push(lengthOfOne(10 ** k, k), oneOfConstants(k), storedBetween(1, k, k === 1 ? 7 : [1, 2, 3]), oneOfTwoKinds(k, k)); print(all.join(" ")); };
