# function floors(count: number) { const n = count | 0; let sum = 0; for (let at = 0; at < n; at++) sum += Math.floor(at / 3); return sum; }
# if (hidden()) { Math.floor = hidden; globalThis.Math = hidden; } print(floors(10)); replace(); print(floors(10)); restore(); print(floors(10)); replaceHolder(); print(floors(10)); restoreHolder(); print(floors(10));
# records of 3792ad5ddc980b00
# In a test run a test may replace Math.floor, and Math itself: neither is a constant of the build. The run time keeps a byte a member, set by whoever is about to write it.
# The turns run nothing else, so both bytes are asked once, in front of the loop, and the turns divide integers; where a byte is set the loop is taken as the plain walk left it (it asks in every turn), and finds what the test has laid.
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell const holder = Math, original = Math.floor; globalThis.hidden = () => false; globalThis.replace = () => { holder.floor = () => 100; }; globalThis.restore = () => { holder.floor = original; }; globalThis.replaceHolder = () => { globalThis.Math = { floor: () => 7 }; }; globalThis.restoreHolder = () => { globalThis.Math = holder; };
# CHECK: 12
# CHECK-NEXT: 1000
# CHECK-NEXT: 12
# CHECK-NEXT: 70
# CHECK-NEXT: 12
# CHECK-NEXT: exited with 0
# RUN(LOCKS): locks open
# LOCKS: open MathFloor
# RUN(WALK): walk f1 mechanisms=all
# WALK-LABEL: code f1:Body
# WALK: isInLoop=true isLoopHead=true
# WALK: = PropGet {{*}}key="floor"
# WALK: isInLoop=true isLoopHead=true
# WALK-NOT: = PropGet
# WALK: = DivideIntegers
# WALK-NOT: = PropGet
# RUN(TWICE): walk f1 mechanisms=all
# TWICE: = IsMemberAsBuilt builtin=Math {{*}}@
# TWICE: = IsMemberAsBuilt builtin=MathFloor {{*}}@
# TWICE: = IsMemberAsBuilt builtin=Math {{*}}@
# TWICE: = IsMemberAsBuilt builtin=MathFloor {{*}}@
# TWICE-NOT: = IsMemberAsBuilt
# RUN(ONCE): walk f1 mechanisms=all
# ONCE: = PropGet {{*}}key="floor"
# ONCE: = IsMemberAsBuilt builtin=Math {{*}}@
# ONCE: isInLoop=true isLoopHead=true
# ONCE-NOT: = IsMemberAsBuilt builtin=Math {{*}}@
# RUN(COUNT): compile BuiltinMembersCheckedForReplacement
# COUNT: BuiltinMembersCheckedForReplacement

