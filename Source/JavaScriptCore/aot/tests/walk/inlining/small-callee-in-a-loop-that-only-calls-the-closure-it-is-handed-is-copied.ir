# function inner(key, cb) { if (key < 0) return cb(-1, 0); var a = key * 2, b = a + 1, c = b * 3; cb(0, c - a); }
# function middle(key, cb) { inner(key, function (err, v) { if (err) return cb(err, 0); cb(0, v + key); }); }   function once(key, cb) { inner(key, function (err, v) { cb(err, v - key); }); }
# function run(n) { var total = 0; function done(err, v) { total += v; } for (var i = 0; i < n; i++) middle(i, done); once(n, done); return total; }
# Callbacks in series. `middle` is copied into the loop of `run`. The call of `inner` stands in that copy, where only the smallest callees were copied: a closure was made in each turn, and `inner` called it by value.
# `inner` has no loop of its own and does nothing with the function but call it: IN A LOOP it is copied, and what it calls of its parameters too: no closure of f5 is made.
# OUTSIDE OF LOOPS (`once`) THE CALL STAYS AS WRITTEN: the closure of f6 is made.
# RUN: walk f4 mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: = NewClosure {{*}}function=f6
# RUN(NEVER): walk f4 mechanisms=all
# NEVER-NOT: = NewClosure {{*}}function=f5

