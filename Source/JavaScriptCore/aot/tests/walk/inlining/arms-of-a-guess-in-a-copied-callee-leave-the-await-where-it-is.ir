# async function real(x) { await x; return x; } let current = real; function install(next) { current = next; } function ask(x) { return current(x); }
# async function byCopy(x) { return await ask(x); }   install(real); sink(byCopy, install);
# ask() is copied, and in the copy a guess at the function in the variable walks the call twice. The typed arm may not take the await of the caller into its call: that the await is taken is a note of the unit,
# and the closed arm, whose callee is anybody's, gives a promise: the copy would return the awaited value on one way and the promise on the other, and the await behind it would wait for neither.
# RUN: walk f4:CoroutineBody mechanisms=all
# CHECK-LABEL: code f4:CoroutineBody
# CHECK: = Call {{*}}calleeName="current"
# CHECK: = AwaitBySavingFrame
# RUN(NEVER): walk f4:CoroutineBody mechanisms=all
# NEVER-NOT: = AwaitCallBySavingFrame

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 module=m0 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    v3 = Call v2, -, v0 calleeName="install"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = NewClosure function=f4
    v7 = Call v5, -, v6, v2
    Return v7
}
function f1 name="real" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v0
}
function f2 name="install" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f3 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="current"
    ReturnCall v2
}
function f4 name="byCopy" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = Call v1, -, v0 calleeName="ask"
    v3 = Await v2
    Return v3
}
