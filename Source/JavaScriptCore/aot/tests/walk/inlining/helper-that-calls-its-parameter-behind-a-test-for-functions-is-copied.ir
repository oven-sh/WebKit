# `each(n, x => ..)`: a helper whose loop calls what it is handed is copied where a closure is handed over. The helper asks first whether it was handed a function, and calls the parameter under the name that it has behind the test:
# the scan finds the parameter behind that name
# function each(count, mapper) { let total = 0; if (typeof mapper === "function") for (let i = 0; i < count; i++) total += mapper(i); return total; }   function run(n) { let t = 0; for (let j = 0; j < n; j++) t += each(3, k => k + j); return t; }
