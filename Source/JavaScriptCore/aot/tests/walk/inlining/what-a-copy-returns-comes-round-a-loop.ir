# CHECK: callee=f1
# CHECK: ([[last]]: anything{{*}}isLoopHead=true
# RUN(CALLED): walk f2 mechanisms=none+TypedOperations+DirectCalls
# CALLED-LABEL: code f2:Body
# CALLED: ([[last]]: i32 {{*}}isLoopHead=true
# CALLED: [[read]]: i32 {{*}} = CallDirect {{*}}function=f1
# CALLED: Jump -> next {{*}}([[read]],

