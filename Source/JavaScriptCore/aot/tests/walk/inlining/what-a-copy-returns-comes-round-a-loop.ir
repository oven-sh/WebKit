# the row of a call of one known function answers with what Link has proven of the result: Link follows the read into the getter, which answers an integer.
# In a loop the callee is copied, and what the copy returns is typed by the rows of the callee's operations: a read by name off a parameter of which nothing is known here gives anything. The looks at the loop read the callee as the walk will, so the parameter of the head holds both
# class Meter { get value() { return 1; } }  function read(meter) { return meter.value; }  function run(n, meter) { let last = 0; for (let i = 0; i < n; i++) last = read(meter); return last; }  run(3, new Meter());
