# outside a loop a callee that is larger than its call is called. A coroutine is called however small it is: what a direct call enters is its ramp, and its body has a frame that is saved
# function large(v) { .. 24 operations .. }  async function small(p) { return await p; }  function caller(v) { return [large(v), small(v)]; }
# RUN: walk f3 mechanisms=none+DirectCalls+Inlining
# CHECK-LABEL: code f3:Body
# CHECK: = CallDirect {{*}}function=f1
# CHECK: = CallDirect {{*}}function=f2
# RUN(NEVER): walk f3 mechanisms=none+DirectCalls+Inlining
# NEVER-NOT: callee=f1
# NEVER-NOT: callee=f2
# NEVER-NOT: BySavingFrame

variable g0 name="large" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="small" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f3
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="large" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
# REPEAT: i = 1..24
    v%(i) = Add v%(i-1), v0
# END REPEAT
    Return v24
}
function f2 name="small" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, IsNeverCalledByHost] {
  b0(v0: anything):
    v1 = Await v0
    Return v1
}
function f3 name="caller" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="large"
    v3 = GetModuleVariable variable=g1
    v4 = Call v3, -, v0 calleeName="small"
    v5 = NewArray v2, v4 contents=anything
    Return v5
}
