# -- source: small-callee-is-copied-into-a-function-that-recursion-enters-again.js
# function log(o) { sink(o); return 1; }
# function weigh(o) { if (o.heavy) return log(o) + o.weight; return o.weight + o.bonus; }
# function visit(node) { let sum = weigh(node); if (node.left) sum += visit(node.left); if (node.right) sum += visit(node.right); return sum; }
# function once(node) { return weigh(node) + 1; }
# const tree = { heavy: false, weight: 1, bonus: 2, left: { heavy: false, weight: 3, bonus: 4, left: null, right: null }, right: null };
# print(visit(tree), once(tree), once(tree.left));
# -- end of source
# records of aee11e50e06c0fc2
# If only a loop counted as repetition, a program that recurses and hardly loops would call every small function that is no leaf
# `visit` may be entered again from below itself: what it writes is repeated as in a loop, and `weigh`, nine operations of which one calls `log`, so that it is no leaf, is copied. `once` calls it
# RUN: walk f3 mechanisms=all
# CHECK: frame 1 callee=f2
# RUN(ONCE): walk f4 mechanisms=all
# ONCE-NOT: frame 1
# ONCE: CallDirect {{*}} function=f2
# RUN(ANSWERS): run-in-shell
# ANSWERS: the source prints the same

