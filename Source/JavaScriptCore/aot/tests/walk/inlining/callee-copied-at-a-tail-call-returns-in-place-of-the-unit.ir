# a callee that is walked in line where its call is returned at once returns in place of the unit: each of its returns ends the unit, nothing meets behind the call, and its own tail call stays one
# function even(n) { if (n === 0) return true; return odd(n - 1); }  function odd(n) { if (n === 0) return false; return even(n - 1); }
# RUN: walk f1 mechanisms=none+DirectCalls+Inlining
# CHECK-LABEL: code f1:Body
# CHECK: frame 1 callee=f2 {{*}}isTailCall=true
# CHECK: [[bottom]]: false
# CHECK: Return [[bottom]]
# CHECK: [[call]]: {{*}} = CallDirect {{*}}function=f1
# CHECK-NEXT: ReturnCall [[call]]
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: frame 1 callee=f2 {{*}}isTailCall=true
# ALL: [[call]]: {{*}} = CallDirect {{*}}function=f1
# ALL-NEXT: ReturnCall [[call]]
# through two copies: first > second > third > first
# RUN(TWO): walk f4 mechanisms=none+DirectCalls+Inlining
# TWO-LABEL: code f4:Body
# TWO: frame 1 callee=f5 {{*}}isTailCall=true
# TWO: frame 2 callee=f6 {{*}}parent=1 isTailCall=true
# TWO: [[call]]: {{*}} = CallDirect {{*}}function=f4
# TWO-NEXT: ReturnCall [[call]]
# function adds(n) { const r = odd(n); return r + 1; }
# The control: the unit goes on behind this call, so the returns of the copy meet there. So do those of the copy in the copy, whose call the unit does not return, and the call in it comes back
# RUN(ELSEWHERE): walk f3 mechanisms=none+DirectCalls+Inlining
# ELSEWHERE-LABEL: code f3:Body
# ELSEWHERE: frame 1 callee=f2
# ELSEWHERE: frame 2 callee=f1 {{*}}parent=1 isTailCall=true
# ELSEWHERE: [[call]]: {{*}} = CallDirect {{*}}function=f2
# ELSEWHERE-NEXT: Jump -> next [[behind]]([[call]])
# ELSEWHERE: = Add
# RUN(NEVER): walk f3 mechanisms=none+DirectCalls+Inlining
# NEVER-NOT: ReturnCall
# with inlining withheld it is a direct call that leaves by a jump
# RUN(WITHHELD): walk f1 mechanisms=none+DirectCalls
# WITHHELD-LABEL: code f1:Body
# WITHHELD: [[call]]: {{*}} = CallDirect {{*}}function=f2
# WITHHELD-NEXT: ReturnCall [[call]]

