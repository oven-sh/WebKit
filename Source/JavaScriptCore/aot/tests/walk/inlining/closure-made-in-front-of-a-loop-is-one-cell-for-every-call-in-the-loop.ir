# function each(list: number[], visit: (x: number) => void): void { seen.add(visit); for (let i = 0; i < list.length; i++) visit(list[i]); }
# function sum(lists: number[][]): number { let total = 0; const add = (x: number) => { total += x; }; for (let i = 0; i < lists.length; i++) each(lists[i], add); return total; }
