# what one call hands back goes to another call and to nobody else, and the callee of that call is walked in its place. Behind the copy stands a hint: the caller's frame keeps no place for the object while the rest of the caller runs
# function consume(x) { return x.n; }  function run(o) { const n = consume(o.load()); o.wait(); return n; }
# RUN: walk f2 mechanisms=none+DirectCalls+Inlining
# CHECK-LABEL: code f2:Body
# CHECK: [[loaded]]: {{*}} = Call
# CHECK: = PropGet [[loaded]] key="n"
# CHECK: = ReleaseHint [[loaded]]
# RUN(ALL): walk f2 mechanisms=all
# ALL-LABEL: code f2:Body
# ALL: = ReleaseHint

