# the caller's block stands under a handler, which is entered with what holds at the head of the block and with the values as they are named there. So the block is walked once: the returns of the copy meet behind the call
# function isLeaf(n) { if (n.kids) return n.empty; return true; }  function count(n) { try { if (isLeaf(n)) return 1; return 2; } catch (e) { return 3; } }
# RUN: walk f2 mechanisms=none+Folding+DirectCalls+Inlining+Handlers
# CHECK-LABEL: code f2:Body
# CHECK: [[read]]: {{*}} = PropGet {{*}}key="empty"
# CHECK-NOT: = ToBoolean [[read]]

variable g0 name="isLeaf" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="isLeaf" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    v1 = PropGet v0 key="kids"
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PropGet v0 key="empty"
    Return v3
  b2():
    v4 = Boolean boolean=true
    Return v4
}
function f2 name="count" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b4():
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="isLeaf"
    v3 = ToBoolean v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    v4 = Integer integer=1
    Return v4
  b3():
    v5 = Integer integer=2
    Return v5
  b4() role=CatchHandler:
    v6 = CatchValue
    v7 = Integer integer=3
    Return v7
}
