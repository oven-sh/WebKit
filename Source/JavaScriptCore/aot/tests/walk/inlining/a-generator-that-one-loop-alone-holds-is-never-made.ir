# A generator that one for-of alone holds is never made: its body is walked in place of the loop, and the blocks of the loop where it yields
# function* range(n) { for (let i = 0; i < n; i++) yield i; }  function sum(n) { let total = 0; for (const value of range(n)) total += value; return total; }  sink(sum);
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: frame 1 callee=f2
# CHECK: isLoopHead=true
# CHECK: = Less
# CHECK: = Add
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: function=f2
# NEVER-NOT: StepGenerator
# NEVER-NOT: IteratorResume
# With copies withheld the generator is made and stepped.
# RUN(WITHHELD): walk f1 mechanisms=all-Inlining
# WITHHELD-LABEL: code f1:Body
# WITHHELD: = CallDirect {{*}}function=f2

variable g0 name="range" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
