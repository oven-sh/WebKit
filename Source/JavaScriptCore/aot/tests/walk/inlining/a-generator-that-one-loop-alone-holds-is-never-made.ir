    v1 = Integer
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    v4 = IteratorOpen v3
    Jump -> next b1(v1)
  b1(v5):
    LoopHint
    v7 = IteratorResume v4
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    Return v5
  b3():
    Jump -> next b4()
  b4() handler=b5():
    v10 = Add v5, v9
    Jump -> next b1(v10)
  b5() role=IterationCleanup subject=v4:
    v11 = CatchException
    IteratorClose v4 completion=Throw
    Rethrow v11
}
function f2 name="range" module=m0 flags=[IsGenerator, HasThis, TakesCallee, IsChecked] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: anything):
    InitialYield v2, v0
