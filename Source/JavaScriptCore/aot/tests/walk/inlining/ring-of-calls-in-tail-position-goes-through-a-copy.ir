# -- source: ring-of-calls-in-tail-position-goes-through-a-copy.js
# function hop(operation, value) { return operation(value); }
# const hops = [];
# for (let index = 0; index < 10; index++) hops.push(value => (value > 0 ? hop(hops[(value + index) % 10], value - 1) : value + index + 0.5));
# console.log(hop(hops[3], 1000000));
# -- end of source
# A million hops, each of which ends in a call of the next: no frame may stay behind. Link lists the call in `hop` with its one callee, so the ring may return raw numbers (LinkedFunction::ringsOfTailCallsAreListed).
# `hop` is copied into the arrow function. There the operand has come out of a closed read, and nothing but Link's word about the parameter says that it is a closure of the one function.
# If the copy did not take that word, it would call the value, come back to unbox what it got, and leave a frame at each turn: "Maximum call stack size exceeded".
# RUN: walk f2 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: [[result]]: number @Double = CallDirect {{*}} function=f2 {{*}} tail
# CHECK-NEXT: ReturnCall [[result]]

module m0 path="ring-of-calls-in-tail-position-goes-through-a-copy.js" displayPath="ring-of-calls-in-tail-position-goes-through-a-copy.js" body=f0 namespaceLayout=L(m0)
