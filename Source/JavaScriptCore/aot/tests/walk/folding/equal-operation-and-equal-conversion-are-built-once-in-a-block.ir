# an operation that changes nothing answers a second time as it did the first, so in one block of code it is built once, and so is the conversion of one value into one form
# function unboxedOnce(x) { if (typeof x !== "number") return x; return x * 2 + x * 3; }
# RUN: walk f1 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = Unbox
# CHECK-NOT: = Unbox
# CHECK: = Add
# function multipliedOnce(x) { if (typeof x !== "number") return x; return (x * 2) + (x * 2); }
# RUN(ONCE): walk f2 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# ONCE-LABEL: code f2:Body
# ONCE: = Mul
# ONCE-NOT: = Mul
# ONCE: = Add
# RUN(ALL): walk f2 mechanisms=all
# ALL-LABEL: code f2:Body
# ALL: = Mul
# ALL-NOT: = Mul
# ALL: = Add
# function inTwoBlocks(x, y) { if (typeof x !== "number") return x; return y ? x * 2 : (x * 2) + 1; } neither block dominates the other
# RUN(TWO): walk f3 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# TWO-LABEL: code f3:Body
# TWO-COUNT-2: = Mul
# function otherOperand(x) { if (typeof x !== "number") return x; return (x * 2) + (x * 4); }
# RUN(OTHER): walk f4 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# OTHER-LABEL: code f4:Body
# OTHER-COUNT-2: = Mul

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
