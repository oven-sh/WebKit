# an operator on a proven number that gives its other operand back for every number, -0 and NaN among them, is that operand. Two negations of a boolean are the boolean
# function same(x) { if (typeof x !== "number") return x; return [x * 1, x / 1, x - 0, x ** 1]; }
# RUN: walk f1 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = NewArray [[x]], [[x]], [[x]], [[x]]
# RUN(NEVER): walk f1 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# NEVER-NOT: = Mul
# NEVER-NOT: = Div
# NEVER-NOT: = Sub
# NEVER-NOT: = Pow
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: = Mul
# ALL-NOT: = Pow
# function plusZero(x) { if (typeof x !== "number") return x; return x + 0; } -0 + 0 is 0, so the sum stays
# RUN(PLUS): walk f2 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# PLUS-LABEL: code f2:Body
# PLUS: = Add
# function integerPlusZero(v) { if (!isInt32(v)) return v; return v + 0; } an integer type holds no -0
# RUN(INTEGER): walk f3 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# INTEGER-NOT: = Add
# function distance(v) { if (!isInt32(v)) return v; return (v + 8) - v; }
# RUN(DISTANCE): walk f4 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# DISTANCE-NOT: = Sub
# function distanceOfNumber(x) { if (typeof x !== "number") return x; return (x + 8) - x; } beyond 2 ** 53 the sum is rounded, and of NaN nothing is left
# RUN(ROUNDED): walk f5 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# ROUNDED-LABEL: code f5:Body
# ROUNDED: = Sub
# function square(x) { if (typeof x !== "number") return x; return x ** 2; }
# RUN(SQUARE): walk f6 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# SQUARE-LABEL: code f6:Body
# SQUARE: = Mul
# SQUARE-NOT: = Pow
# function twice(x) { return !!(typeof x === "number"); }
# RUN(TWICE): walk f7 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# TWICE-NOT: = LogicalNot
# function once(x) { return !(typeof x === "number"); }
# RUN(ONCE): walk f8 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# ONCE-LABEL: code f8:Body
# ONCE: = LogicalNot

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = NewClosure function=f5
    v7 = NewClosure function=f6
    v8 = NewClosure function=f7
    v9 = NewClosure function=f8
    v10 = Call v1, -, v2, v3, v4, v5, v6, v7, v8, v9
    Return v10
}
