# In a test run one helper that names Bun.plugin marks every file of the program MayBeEvicted: a text that nobody has read may answer in its place, or a copy of it may load beside it.
# Such a file is left to the host's loader. The body that was compiled is not entered a second time, so a `const` of an ES module leaves its dead zone once, as in an executable.
# export const LIMIT = make();  export function twice() { const first = LIMIT; sink(); return first + LIMIT; }
# RUN: walk f1 mechanisms=none+Folding
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = CheckInitialized
# CHECK: = Call
# CHECK-NOT: = GetModuleVariable
# CHECK-NOT: = CheckInitialized

# A file that runs again as well empties its variables: they are checked at each read.
# RUN(AGAIN): walk f2 mechanisms=none+Folding
# AGAIN-LABEL: code f2:Body
# AGAIN-COUNT-2: = CheckInitialized

# So does a file that a mock may stand for: its body is owed again when the mock ends.
# RUN(MOCKED): walk f3 mechanisms=none+Folding
# MOCKED-LABEL: code f3:Body
# MOCKED-COUNT-2: = CheckInitialized

# A CommonJS file that was evicted is loaded again, and what it exports is captured again.
# RUN(COMMONJS): walk f4 mechanisms=none+Folding
# COMMONJS-LABEL: code f4:Body
# COMMONJS-COUNT-2: = CheckInitialized

# So the variables of that file's facade are filled again as well.
# RUN(FACADE): walk f8 mechanisms=none+Folding
# FACADE-LABEL: code f8:Body
# FACADE-COUNT-2: = CheckInitialized

variable g0 name="LIMIT" module=m0 declared={type=anything|absent} flags=[IsImmutable]
variable g1 name="AGAIN" module=m1 declared={type=anything|absent} flags=[IsImmutable]
variable g2 name="MOCKED" module=m2 declared={type=anything|absent} flags=[IsImmutable]
variable g3 name="REQUIRED" module=m3 declared={type=anything|absent} flags=[IsImmutable]
variable g4 name="exports" module=m3 declared={type=anything} initialization=Undefined
variable g5 name="default" module=m4 declared={type=anything|absent}
module m0 path="main.js" displayPath="main.js" flags=[MayBeEvicted] body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}, {target=m4 completes=true}] exports=[{name="LIMIT" variable=g0}]
module m1 path="again.js" displayPath="again.js" flags=[MayBeEvicted, MayBeReevaluated] body=f5 exports=[{name="AGAIN" variable=g1}]
module m2 path="mocked.js" displayPath="mocked.js" flags=[MayBeMocked, MayBeEvicted] body=f6 exports=[{name="MOCKED" variable=g2}]
module m3 path="/required.cjs" displayPath="required.cjs" kind=CommonJs flags=[CachesEvaluationError, MayBeEvicted] exportRule=CommonJs requireResult=ModuleExports body=f7 exportsVariable=g4
module m4 path="#4" displayPath="required.cjs" flags=[CachesEvaluationError, MayBeEvicted] exportRule=CommonJs body=f9 requests=[{target=m3 kind=Require completes=true}] syntheticExports=[{name="default" variable=g5}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1 calleeName="make"
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = NewClosure function=f3
    v7 = NewClosure function=f4
    v8 = NewClosure function=f8
    v9 = PropGet v0 key="sink" [isFreeName]
    v10 = Call v9, -, v4, v5, v6, v7, v8 calleeName="sink"
    Return v10
}
function f1 name="twice" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="LIMIT"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Call v3 calleeName="sink"
    v5 = GetModuleVariable variable=g0
    v6 = CheckInitialized v5 name="LIMIT"
    v7 = Add v1, v6
    Return v7
}
function f2 name="twiceOfFileThatRunsAgain" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="AGAIN"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Call v3 calleeName="sink"
    v5 = GetModuleVariable variable=g1
    v6 = CheckInitialized v5 name="AGAIN"
    v7 = Add v1, v6
    Return v7
}
function f3 name="twiceOfFileThatMayBeMocked" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    v1 = CheckInitialized v0 name="MOCKED"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Call v3 calleeName="sink"
    v5 = GetModuleVariable variable=g2
    v6 = CheckInitialized v5 name="MOCKED"
    v7 = Add v1, v6
    Return v7
}
function f4 name="twiceOfCommonJSFile" module=m3 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="REQUIRED"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Call v3 calleeName="sink"
    v5 = GetModuleVariable variable=g3
    v6 = CheckInitialized v5 name="REQUIRED"
    v7 = Add v1, v6
    Return v7
}
function f5 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1 calleeName="make"
    PutModuleVariable v2 variable=g1
    v4 = Undefined
    Return v4
}
function f6 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1 calleeName="make"
    PutModuleVariable v2 variable=g2
    v4 = Undefined
    Return v4
}
function f7 name="required" module=m3 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1 calleeName="make"
    PutModuleVariable v2 variable=g3
    Return
}
function f8 name="twiceOfFacade" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g5
    v1 = CheckInitialized v0 name="default"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Call v3 calleeName="sink"
    v5 = GetModuleVariable variable=g5
    v6 = CheckInitialized v5 name="default"
    v7 = Add v1, v6
    Return v7
}
function f9 name="facadeOfRequired" module=m4 kind=Module results=[{type=anything}] {
    EvaluateModule module=m3 referrer=m4 [isBare]
    Return
}
