# a comparison of two proven numbers is branched on, and on the side where it held it is written again: it is the record of the first, its outcome is known, and the side that cannot be taken is not walked
# no type says which of two numbers is the smaller, so nothing but the branch knows
# a comparison that has failed says nothing of the one the other way round, which fails for NaN too: that one is asked
# each function is handed to sink, so nothing is known of its parameters but what its own tests show
# f1 = again, f2 = reversed
# function again(a, b) { if (typeof a !== "number" || typeof b !== "number") return 0; if (a < b) { if (a < b) return 1; sink(a); return 2; } return 3; }
# function reversed(a, b) { if (typeof a !== "number" || typeof b !== "number") return 0; if (a < b) return 1; if (a >= b) return 2; sink(a); return 3; }
# sink(again, reversed);
# the records are by hand, and behind each test they read the value that the edge hands on. The front end writes the parameter itself there, of which the walk proves nothing
# an edge narrows with typed operations alone, so they stand in every RUN
# RUN: walk f1 mechanisms=none+Folding+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = Less {{*}}form=Numbers
# CHECK-NOT: = Less
# RUN(NEVER): walk f1 mechanisms=none+Folding+TypedOperations
# NEVER-NOT: = Call
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: = Call
# RUN(OTHER): walk f2 mechanisms=none+Folding+TypedOperations
# OTHER-LABEL: code f2:Body
# OTHER: = Less
# OTHER: = GreaterEq
# OTHER: = Call

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="again" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b7()
  b1(v3):
    v4 = TypeTest v1 testedType=number
    Branch v4 -> taken b2(| 0), notTaken b7()
  b2(v5):
    v6 = Less v3, v5
    Branch v6 -> taken b3(), notTaken b6()
  b3():
    v7 = Less v3, v5
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    v8 = Integer integer=1
    Return v8
  b5():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="sink" [isFreeName]
    v11 = Call v10, -, v3
    v12 = Integer integer=2
    Return v12
  b6():
    v13 = Integer integer=3
    Return v13
  b7():
    v14 = Integer
    Return v14
}
function f2 name="reversed" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b7()
  b1(v3):
    v4 = TypeTest v1 testedType=number
    Branch v4 -> taken b2(| 0), notTaken b7()
  b2(v5):
    v6 = Less v3, v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Integer integer=1
    Return v7
  b4():
    v8 = GreaterEq v3, v5
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    v9 = Integer integer=2
    Return v9
  b6():
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="sink" [isFreeName]
    v12 = Call v11, -, v3
    v13 = Integer integer=3
    Return v13
  b7():
    v14 = Integer
    Return v14
}
