# class C { static MAX = 1000; static MIN = 0; }  function over(x) { return (x | 0) > C.MAX; }  function under(x) { return (x | 0) < C.MIN; }  C.MIN = 2;
# A static field that one written value alone fills, in an initializer that runs no other code, is that value. A field that is stored into again is read.
# RUN: walk f1:Body mechanisms=all
# CHECK-NOT: GetStaticFieldOrAbsent
# CHECK: Integer integer=1000
# CHECK-NOT: GetStaticFieldOrAbsent
# CHECK: Greater
# RUN(STORED): walk f4:Body mechanisms=all
# STORED: GetStaticFieldOrAbsent
# STORED: Less

layout L0 kind=Instance name="C" module=m0 constructor=f2 staticFields=[{key="MAX" variable=g2}, {key="MIN" variable=g3}]
variable g0 name="C" module=m0 declared={type=absent|f2 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=f2 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g2 module=m0 declared={type=anything} owner=L0
variable g3 module=m0 declared={type=anything} owner=L0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    PutModuleVariable v1 variable=g1
    v3 = FinishClass v1 layout=L0
    v4 = Convert v3 declared={type=function flags=[IsFromCompiler]}
    v5 = CallDirect v4 function=f3
    v6 = Convert v3 declared={type=f2 flags=[IsFromCompiler]}
    PutModuleVariable v6 variable=g0
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = NewClosure function=f1
    v11 = Call v9, -, v10
    v12 = NewClosure function=f4
    v13 = Call v9, -, v12
    v14 = Integer integer=2
    PropSet v6, v14 key="MIN"
    Return v13
}
function f1 name="over" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="C"
    v5 = PropGet v4 key="MAX"
    v6 = Greater v2, v5
    Return v6
}
function f2 name="C" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0}
    Return v3
}
function f3 module=m0 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=function flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: function):
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v2 = Integer integer=1000
    PropDefine v1, v2 key="MAX"
    v4 = Integer
    PropDefine v1, v4 key="MIN"
    v6 = Undefined
    Return v6
}
function f4 name="under" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="C"
    v5 = PropGet v4 key="MIN"
    v6 = Less v2, v5
    Return v6
}
