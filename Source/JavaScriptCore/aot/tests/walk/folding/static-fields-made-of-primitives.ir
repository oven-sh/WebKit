# class C { static table = new Uint8Array(256); static half = 1 / 2; static other = new Function(); static late = new Uint8Array(4); static sub(x) { return C.table[x]; } static first() { return C.late; } }
# The engine alone makes what built-in classes and operators make of primitives: a field behind them is there before any other code runs. A field behind a call that may run code may be absent.
# RUN: walk f3:Body mechanisms=all
# CHECK-NOT: PropGet
# CHECK: Uint8Array @JSValue = GetStaticFieldOrAbsent
# CHECK: [findsProperty]
# RUN(LATE): walk f4:Body mechanisms=all
# LATE-NOT: findsProperty
# LATE: absent|anything @JSValue = GetStaticFieldOrAbsent

layout L0 kind=Instance name="C" module=m0 constructor=f1 staticFields=[{key="table" variable=g2}, {key="late" variable=g3}]
variable g0 name="C" module=m0 declared={type=absent|f1 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 name="C" module=m0 declared={type=absent|f1 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g2 module=m0 declared={type=anything} owner=L0
variable g3 module=m0 declared={type=anything} owner=L0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Convert v2 declared={type=f1 flags=[IsFromCompiler]}
    PutModuleVariable v3 variable=g1
    v5 = Convert v2 declared={type=function flags=[IsFromCompiler]}
    v6 = CallDirect v5 function=f2
    v7 = Convert v2 declared={type=f1 flags=[IsFromCompiler]}
    PutModuleVariable v7 variable=g0
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="sink" [isFreeName]
    v11 = NewClosure function=f3
    v12 = Call v10, -, v11
    v13 = NewClosure function=f4
    v14 = Call v10, -, v13
    v15 = Undefined
    Return v15
}
function f1 name="C" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0}
    Return v3
}
function f2 module=m0 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=function flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: function):
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v2 = Builtin builtin=Uint8Array
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = Div v3, v4
    v6 = Integer integer=256
    v7 = Construct v2, -, v6
    PropDefine v1, v7 key="table"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="made" [isFreeName]
    v11 = Construct v2, -, v3
    PropDefine v1, v11 key="late"
    v13 = Undefined
    Return v13
}
function f3 name="sub" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = CheckInitialized v1 name="C"
    v3 = PropGet v2 key="table"
    v4 = ElemGet v3, v0
    Return v4
}
function f4 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="C"
    v2 = PropGet v1 key="late"
    Return v2
}
