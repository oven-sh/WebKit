# a direct eval evaluates a text and hands every other primitive back, so of a proven number it is the number, and nothing of the scope is handed to the run time
# function handBack(n) { if (typeof n !== "number") return 0; return eval(n); }
# RUN: walk f1 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK-NOT: DirectEval
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: DirectEval
# function evaluate(n) { return eval(n); } what may be a text is evaluated
# RUN(OTHER): walk f2 mechanisms=none+Folding+TypedOperations+UnboxedNumbers
# OTHER-LABEL: code f2:Body
# OTHER: = DirectEval
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers
# WITHHELD-LABEL: code f1:Body
# WITHHELD: = DirectEval

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
evalscope e0 flags=[IsInFunction]
evalscope e1 flags=[IsInFunction]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="handBack" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Undefined
    v4 = DirectEval v2, v3, v3 evalScope=e0
    Return v4
  b2():
    v5 = Integer
    Return v5
}
function f2 name="evaluate" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1, v1 evalScope=e1
    Return v2
}
