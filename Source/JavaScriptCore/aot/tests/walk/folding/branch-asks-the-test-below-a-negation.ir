# a branch on a negation asks the test below it, with its two sides changed round, and nothing is left of the negation. Two negations leave the sides as they are. A negation that is returned stays
# function pick(v) { const no = !(typeof v === "string"); if (no) return v.other; return v.text; }
# function twice(v) { const yes = !!(typeof v === "string"); if (yes) return v.text; return v.other; }
# function told(v) { return !(typeof v === "string"); }
# all three are handed to sink, so nothing is known of v
# RUN: walk f1 mechanisms=none+Folding
# CHECK: mechanisms Folding
# CHECK-LABEL: code f1:Body
# CHECK: [[test]]: {{*}} = TypeTest
# CHECK: Branch [[test]] -> taken [[text]](), notTaken [[other]]()
# RUN(TEXT): walk f1 mechanisms=none+Folding
# TEXT: Branch {{*}} -> taken [[text]](),
# TEXT: [[text]]():
# TEXT-NOT: ():
# TEXT: key="text"
# RUN(OTHER): walk f1 mechanisms=none+Folding
# OTHER: Branch {{*}} notTaken [[other]]()
# OTHER: [[other]]():
# OTHER-NOT: ():
# OTHER: key="other"
# RUN(NEVER): walk f1 f2 mechanisms=none+Folding
# NEVER-NOT: LogicalNot
# RUN(TWICE): walk f2 mechanisms=none+Folding
# TWICE-LABEL: code f2:Body
# TWICE: [[test]]: {{*}} = TypeTest
# TWICE: Branch [[test]] -> taken [[text]](),
# TWICE: [[text]]():
# TWICE-NOT: ():
# TWICE: key="text"
# RUN(KEPT): walk f3 mechanisms=none+Folding
# KEPT-LABEL: code f3:Body
# KEPT: = LogicalNot
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL-NOT: LogicalNot

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    v2 = LogicalNot v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PropGet v0 key="other"
    Return v3
  b2():
    v4 = PropGet v0 key="text"
    Return v4
}
function f2 name="twice" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    v2 = LogicalNot v1
    v3 = LogicalNot v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = PropGet v0 key="text"
    Return v4
  b2():
    v5 = PropGet v0 key="other"
    Return v5
}
function f3 name="told" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    v2 = LogicalNot v1
    Return v2
}
