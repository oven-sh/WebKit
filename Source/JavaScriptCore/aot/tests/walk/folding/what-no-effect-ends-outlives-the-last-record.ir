# At a join the state keeps what both ways know. Where each knows another object nothing of that is left, the records are dropped, and what no effect ends stays:
# that a `const` has left its dead zone on both ways, and what it holds.
# export const LIMIT = make();
# const twice = often => { const first = LIMIT; if (often) { run(); here; } else { run(); there; } return first + LIMIT; }       `here` and `there` lie in two environments
# RUN: walk f1 mechanisms=none+Folding
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = CheckInitialized
# CHECK-NOT: = GetModuleVariable
# CHECK-NOT: = CheckInitialized

layout L0 kind=Environment module=m0 fields=[{key=@"0" declared={type=anything} variableName="held"}] ownFieldCount=1
variable g0 name="LIMIT" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="LIMIT" variable=g0}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1 calleeName="make"
    PutModuleVariable v2 variable=g0
    v4 = NewObject layout=L0
    v5 = NewObject layout=L0
    v6 = NewClosure v4, v5 function=f1
    v7 = PropGet v0 key="sink" [isFreeName]
    v8 = Call v7, -, v6 calleeName="sink"
    Return v8
}
function f1 name="twice" module=m0 kind=Arrow length=2 captures=[{type=env L0 flags=[IsFromCompiler]}, {type=env L0 flags=[IsFromCompiler]}] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: env L0, v2: anything, v3: anything):
    v4 = GetModuleVariable variable=g0
    v5 = CheckInitialized v4 name="LIMIT"
    v6 = ToBoolean v2
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    v7 = Call v3 calleeName="run"
    v8 = GetEnvironmentField v0 layout=L0
    Jump -> next b3()
  b2():
    v9 = Call v3 calleeName="run"
    v10 = GetEnvironmentField v1 layout=L0
    Jump -> next b3()
  b3():
    v11 = GetModuleVariable variable=g0
    v12 = CheckInitialized v11 name="LIMIT"
    v13 = Add v5, v12
    Return v13
}
