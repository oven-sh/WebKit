# neither way knows what the test of the join will answer, so nothing is gained by walking it twice: the ways meet, and one test asks what they bring together
# function pick(a, b) { const ok = a ? b.ok : b.no; if (ok) return 1; return 2; }
# RUN: walk f1 mechanisms=none+Folding
# CHECK: mechanisms Folding
# CHECK-LABEL: code f1:Body
# CHECK: [[read]]: {{*}} = PropGet {{*}}key="ok"
# CHECK-NOT: = ToBoolean [[read]]
# RUN(COUNT): walk f1 mechanisms=none+Folding
# COUNT-LABEL: code f1:Body
# COUNT-COUNT-2: = ToBoolean
# COUNT-NOT: = ToBoolean

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="pick" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PropGet v1 key="ok"
    Jump -> next b3(v3)
  b2():
    v4 = PropGet v1 key="no"
    Jump -> next b3(v4)
  b3(v5):
    v6 = ToBoolean v5
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    v7 = Integer integer=1
    Return v7
  b5():
    v8 = Integer integer=2
    Return v8
}
