# both sides of a branch come to one block with the same values, and nothing is seen on the way: the branch is a jump, and nobody asks the test
# function quiet(v, verbose) { if (verbose) { } return v; }
# function same(v, c) { const x = c ? v : v; return x; }
# function differs(v, c) { const x = c ? v : c; return x; }      the sides bring two values
# function seen(v, c) { if (c) { v.touched; } return v; }         a read by name may run a getter
# all four are handed to sink
# RUN: walk f1 f2 mechanisms=none+Folding
# CHECK: mechanisms Folding
# CHECK-LABEL: code f1:Body
# CHECK: Jump
# CHECK: Return
# CHECK-LABEL: code f2:Body
# CHECK: Jump
# CHECK: Return
# RUN(NEVER): walk f1 f2 mechanisms=none+Folding
# NEVER-NOT: Branch
# NEVER-NOT: ToBoolean
# RUN(KEPT): walk f3 f4 mechanisms=none+Folding
# KEPT-LABEL: code f3:Body
# KEPT: = ToBoolean
# KEPT: Branch
# KEPT-LABEL: code f4:Body
# KEPT: = ToBoolean
# KEPT: Branch
# KEPT: key="touched"
# RUN(ALL): walk f1 f2 mechanisms=all
# ALL-NOT: Branch

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = Call v1, -, v2, v3, v4, v5
    Return v6
}
function f1 name="quiet" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2():
    Return v0
}
function f2 name="same" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    Return v3
}
function f3 name="differs" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    Return v3
}
function f4 name="seen" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PropGet v0 key="touched"
    Jump -> next b2()
  b2():
    Return v0
}
