# print($isWithoutAddedNames(Object.prototype)); print($isWithoutAddedNames(Array.prototype))   as the library's own text may write it
# An executable keeps no byte for the names that are added to a built-in. The walk answers at the build, under every set of mechanisms: the object above all objects is locked as a whole and this program opens no name on it:
# true. A made-up name can be laid above lists while an executable runs, and nobody hears of it: false. The operation itself never comes into the code.
# RUN: run-in-shell
# CHECK: true
# CHECK-NEXT: false
# CHECK-NEXT: exited with 0
# RUN(NONE): walk f0 mechanisms=none
# NONE-LABEL: code f0:Body
# NONE-NOT: IsHolderWithoutAddedNames
# RUN(ALL): walk f0 mechanisms=all
# ALL-LABEL: code f0:Body
# ALL-NOT: IsHolderWithoutAddedNames

module m0 path="/a.ts" displayPath="a.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = IsHolderWithoutAddedNames builtin=ObjectPrototype
    v3 = Call v1, -, v2
    v4 = IsHolderWithoutAddedNames builtin=ArrayPrototype
    v5 = Call v1, -, v4
    Return v5
}
