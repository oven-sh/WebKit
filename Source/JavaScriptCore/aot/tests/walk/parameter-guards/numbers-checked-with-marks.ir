    v25 = GetModuleVariable variable=g0
    v26 = Mul v24, v25
    v27 = GetModuleVariable variable=g0
    v28 = Mul v26, v27
    v29 = GetModuleVariable variable=g0
    v30 = Mul v28, v29
    v31 = GetModuleVariable variable=g0
    v32 = Mul v30, v31
