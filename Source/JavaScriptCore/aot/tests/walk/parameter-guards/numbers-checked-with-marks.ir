# var total = 3, view = new Int32Array(64); function step(p) { var a = p >> 2, b = view[a]; b = b * total + 1 .. ; return b; } function evaluate(text) { return eval(text); } step(8); evaluate("1");
# A function that leads to no direct eval has a slow body and a guard that asks the mark of evals anyway. The guard asks the numbers among the parameters too, though the body reads them seldom.
# LIBRARY: own
# RUN: plan units mechanisms=all
# CHECK: unit f2:Body (Int32)
# CHECK: unit f2:ParameterGuard (JSValue) -> (JSValue) tests (i32)

module m0 path="main.js" displayPath="main.js" body=f0
variable g0 name="total" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="view" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="step" module=m0 declared={type=anything} initialization=Function function=f2
variable g3 module=m0 declared={type=anything} initialization=Undefined flags=[MarksEvaluation]
evalscope e0 flags=[IsInFunction, AllowsNewTarget] bindings=[{name="total" depth=1 variable=g0}, {name="view" depth=1 variable=g1}, {name="step" depth=1 variable=g2}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=Int32Array
    v3 = Integer integer=64
    v4 = Construct v2, -, v3
    PutModuleVariable v4 variable=g1
    v6 = GetModuleVariable variable=g2
    v7 = Integer integer=8
    v8 = Call v6, -, v7
    v9 = NewClosure function=f1
    v10 = String string="1"
    v11 = Call v9, -, v10
    Return v11
}
function f1 name="evaluate" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Boolean boolean=true
    PutModuleVariable v3 variable=g3
    v5 = DirectEval v2, v0, v1 evalScope=e0
    Return v5
}
function f2 name="step" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    v2 = RShift v0, v1
    v3 = GetModuleVariable variable=g1
    v4 = ElemGet v3, v2
    v5 = GetModuleVariable variable=g0
    v6 = Mul v4, v5
    v7 = GetModuleVariable variable=g0
    v8 = Mul v6, v7
