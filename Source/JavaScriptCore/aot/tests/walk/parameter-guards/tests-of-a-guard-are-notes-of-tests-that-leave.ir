# each test of the guard in front of `area` is a note for the reports: a test that leaves: where it fails, the rest of the call runs in the slow version. It stands at the head of the function, with the layout that is tested for where there is one
# RUN: notes f1:ParameterGuard mechanisms=all
# CHECK: notes of f1:ParameterGuard
# CHECK-NEXT: TestThatLeaves @34 in f1 layout=L0
# CHECK-NEXT: TestThatLeaves @34 in f1
# CHECK-NOT: TestThat
# where `area` is copied into a caller that hands it values nobody knows, the tests stand in front of the copy. They are notes of the same place: the head of `area`
# RUN(COPIED): notes f3 mechanisms=all
# COPIED: notes of f3:Body
# COPIED: TestThatLeaves @34 in f1 layout=L0
# COPIED-NEXT: TestThatLeaves @34 in f1
# the fast version tests nothing, and of the slow version no note is taken
# RUN(FAST): notes f1 f1:SlowBody mechanisms=all
# FAST: notes of f1:Body
# FAST-NOT: TestThat
# FAST: notes of f1:SlowBody
# FAST-NOT: @
# class Point { x = 1; y = 2; }
# function area(point: Point, scale: number): number { const across = point.x * scale; const down = point.y * scale; return across * down + point.x; }
# function handsOn(point: Point, scale: number): number { return area(point, scale); }
# function unknownCaller(value: any): number { return area(value, value); }
# function provenCaller(): number { return area(new Point(), 2); }
# globalThis.keep = [area, handsOn, unknownCaller, provenCaller];

