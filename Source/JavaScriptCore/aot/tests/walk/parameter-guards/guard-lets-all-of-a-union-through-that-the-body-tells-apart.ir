  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="count" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string|Array<number> flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=number}] {
  b0(v0: undefined|null|string|Array<number>, v1: number):
    v2 = Integer
    Jump -> next b1(v2, v2)
  b1(v3: number, v4: number):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b6()
  b2():
    v7 = TypeTest v0 testedType=string
    Branch v7 -> taken b3(| 0), notTaken b4(| 0)
  b3(v8):
    v9 = NarrowByTest v0, v8
    v10 = PropGet v9 key="length"
    v11 = Add v3, v10
    Jump -> next b5(v11)
  b4(v12):
    v13 = NarrowByTest v0, v12
    v14 = PropGet v13 key="length"
    v15 = Add v3, v14
    Jump -> next b5(v15)
  b5(v16: number):
    v17 = Increment v4
    Jump -> next b1(v16, v17)
  b6():
    Return v3
}
function f2 name="isText" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string|Array<number> flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean}] {
  b0(v0: undefined|null|string|Array<number>):
