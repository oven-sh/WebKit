# what is expected of `string | number[]` is the list, because no one test tells a text or a list, so a guard for it sent every text into the slow version: 1,500 instructions a turn in the place of 30.
# Where the body asks which member it has, the guard lets all that is written through: each arm has its proof, no member runs in the slow version, and the tally goes round as a number.
# A body that only asks (isText) leans on nothing and has no guard. A body that never asks (size) keeps the guard for the list
# function count(value: string | number[], rounds: number) { let total = 0; for (let i = 0; i < rounds; i++) total += typeof value === "string" ? value.length : value.length; return total; }
# function isText(value: string | number[]) { return typeof value === "string"; }   function size(value: string | number[], rounds: number) { .. total += value.length .. }
# RUN: plan units mechanisms=all
# CHECK: unit f1:ParameterGuard {{*}} tests (undefined|null|string|Array<number>, number)
# CHECK: unit f3:ParameterGuard {{*}} tests (Array<number>, number)
# RUN(NEVER): plan units mechanisms=all
# NEVER-NOT: unit f2:ParameterGuard
# RUN(WALK): walk f1:Body mechanisms=all
# WALK-LABEL: code f1:Body
# WALK: ([[value]]: undefined|null|string|Array<number>{{*}}entry=0
# The walk of the loop starts at what its rows say comes round: a sum of numbers.
# WALK: ([[total]]: number @Double, {{*}}isInLoop=true isLoopHead=true
# RUN(LENGTHS): walk f1:Body mechanisms=all
# LENGTHS: = GetStringLength
# LENGTHS: = GetArrayLength
# RUN(CLOSED): walk f1:Body mechanisms=all
# CLOSED-NOT: PropGet

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
