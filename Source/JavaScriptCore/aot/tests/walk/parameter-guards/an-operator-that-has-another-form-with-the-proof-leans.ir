# CHECK: unit f1:ParameterGuard (JSValue) -> (JSValue) tests (number)
# RUN(FAST): walk f1 mechanisms=all
# FAST-LABEL: code f1:Body
# FAST: b0([[ch]]: number @Double
# FAST: = GreaterEq [[ch]], {{*}} form=Numbers
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: NumberAndValue
# RUN(WITHHELD): walk f1 mechanisms=all-ParameterGuards
# WITHHELD-LABEL: code f1:Body
# WITHHELD: = GreaterEq {{*}} form=NumberAndValue

