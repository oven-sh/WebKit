# a comparison with a constant has a form for any value on its other side, which asks that value in line, each time. With the value proven a number it has the form of numbers, which asks nothing.
# So the comparison leans on `ch`, though it would not be closed without the guard, and may run no code behind it
# function isBig(ch: number): boolean { return ch >= 65; }
