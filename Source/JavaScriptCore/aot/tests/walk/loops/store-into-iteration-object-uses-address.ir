# The iteration finds the object into which it stores by name. The version of the loop searches the address of the property, reads and stores there, and undoes the store where a later check fails.
# function step(t) { for (let i = 0; i < t.length; i++) { const u = t[i]; u.x += u.y * 2; u.z -= u.w * 2; } }  sink(step);
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetKeyedPropertyAddress {{*}}key="x"
# CHECK: = GetKeyedProperty
# CHECK: = PutKeyedProperty
# CHECK: undoesIterationStore
# An object of another shape than the site's asks the tables of stores in a stub.
# RUN(STUB): bytes f1:Body mechanisms=all
# STUB-LABEL: unit f1:Body
# STUB: FindReplaceableValue
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="step" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = Convert v1 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = PropGet v0 key="length" @10
    v6 = Less v3, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = ElemGet v0, v3 @20
    v8 = PropGet v7 key="x" @30
    v9 = PropGet v7 key="y" @40
    v10 = Integer integer=2
    v11 = Mul v9, v10 @50
    v12 = Add v8, v11 @60
    PropSet v7, v12 key="x" @70
    v14 = PropGet v7 key="z" @80
    v15 = PropGet v7 key="w" @90
    v16 = Mul v15, v10 @100
    v17 = Sub v14, v16 @110
    PropSet v7, v17 key="z" @120
    v19 = Increment v3 @130
    v20 = Convert v19 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v20)
  b3():
    v21 = Undefined
    Return v21
}
