# COUNTED: statistic NumberOperandsGuardedInIterations 1
# RUN(SHELL): run-in-shell mechanisms=all globalThis.after = () => { const list = [crate(3), crate(3), crate(-3), crate(-3)]; print(JSON.stringify(tellAll.call(list))); list[1].stock = { valueOf() { list.length = 2; return 4; } }; print(JSON.stringify(tellAll.call(list)), list.length); };
