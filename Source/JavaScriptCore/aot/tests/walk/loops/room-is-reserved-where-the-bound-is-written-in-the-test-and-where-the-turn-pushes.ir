# function pushes() { const list: number[] = []; for (let i = 0; i < 1000; i++) list.push(i); return list; }   function stores(list: number[]) { for (let i = 0; i < 1000; i++) list[i] = i; }
# function pushesSome(list: number[], n: number) { for (let i = 0; i < n; i++) if (i & 1) list.push(i); }   function pushesWhatACallGives(list: number[], n: number, make: (i: number) => number) { for (let i = 0; i < n; i++) list.push(make(i)); }   function pushesOnto(list: number[]) { for (let i = 0; i < 1000; i++) list.push(i); }
# A loop that counts from zero up to a bound and lays one value into a list in every turn says how much room the list will need, so the room is asked for once in front of the loop and the storage is not moved again and again while the loop runs.
# The bound may be a whole number written in the loop's own test, which stands in the head of the loop and not in front of it. The turn may push in place of storing under the counter, where the walk itself finds that the member read off the list is the push of lists: the list is as it was made, and the member is constant.
# It is a hint and changes no answer; but room that is asked for and never filled is memory, so nothing in the turn may run other code.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: ReserveArrayCapacity
# CHECK: isLoopHead=true
# RUN(STORES): walk f2 mechanisms=all
# STORES-LABEL: code f2:Body
# STORES: ReserveArrayCapacity
# STORES: isLoopHead=true
# A push that stands in some turns only, a turn that runs other code, and a list that arrives and may have a push of its own ask for nothing.
# RUN(SOME): walk f3 mechanisms=all
# SOME-NOT: ReserveArrayCapacity
# RUN(CALLS): walk f4 mechanisms=all
# CALLS-NOT: ReserveArrayCapacity
# RUN(ARRIVES): walk f5 mechanisms=all
# ARRIVES-NOT: ReserveArrayCapacity
# RUN(ANSWER): run-in-shell globalThis.sink = (pushes, stores, pushesSome, pushesWhatACallGives, pushesOnto) => { const sum = list => { let all = 0; for (let k = 0; k < list.length; k++) all += list[k]; return list.length + ":" + all; }; print(sum(pushes())); const a = []; pushesOnto(a); pushesOnto(a); print(sum(a)); const b = [0.5]; stores(b); print(sum(b)); const c = []; pushesSome(c, 9); print(sum(c)); const d = []; pushesWhatACallGives(d, 4, i => i * 2); print(sum(d)); const own = []; own.push = function (value) { this[0] = value; }; pushesOnto(own); print(sum(own)); const closed = Object.preventExtensions([]); try { pushesOnto(closed); } catch (error) { print(error.constructor.name); } print(sum(closed)); const shared = [1, 2, 3]; pushesOnto(shared); print(sum(shared)); };
