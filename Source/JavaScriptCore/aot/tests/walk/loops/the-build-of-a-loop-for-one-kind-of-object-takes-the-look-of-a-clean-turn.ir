# function areas(shape: Shape, turns: number) { let total = 0; for (let i = 0; i < turns; i++) total += shape.area(); return total; }     class Square extends Shape, class Rect extends Shape
# The loop is built once for a Square and once for a Rect, behind a test of the shape. In such a build every test of a turn that fails begins the turn again in the closed build, so the turn runs no other code.
# The look that knows this was refused: a second copy of a loop pays only where something leaves the turns. But here the closed build stands already and a typed one costs nothing more.
# So the fields were read and the area was worked out in every turn, with up to four tests and a box: 19 instructions a turn for one.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest
# CHECK: = ShapeTest
# CHECK: frequency=Rare isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = NarrowInteger
# CHECK-NEXT: = Unbox
# CHECK-NEXT: = GetSlot {{*}}key="side"
# CHECK: () isInLoop=true
# CHECK-NOT: = GetSlot
# CHECK: = Add {{*}}form=Numbers
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = NarrowInteger
# CHECK-NEXT: = Unbox
# CHECK-NEXT: = GetSlot {{*}}key="w"
# CHECK: () isInLoop=true
# CHECK-NOT: = GetSlot
# CHECK: = Add {{*}}form=Numbers
# RUN(SHELL): run-in-shell globalThis.hidden = () => 3; globalThis.sink = sum => { print(String(sum)); };
# SHELL: 60
# SHELL: exited with 0

