# function turnLeft(word: number, by: number) { return (word << by) | (word >>> (32 - by)); }
# function mix(sums: Int32Array, words: Int32Array, to: number) { let a = sums[0], b = sums[1], c = sums[2];
#   for (let t = 0; t < to; t++) { const next = (turnLeft(a, 5) + (b ^ c) + words[t]) | 0; c = turnLeft(b, 30); b = a; a = next; } return a ^ b ^ c; }
# function changePlaces(from: Int32Array, to: number) { let a = from[0], b = from[1]; for (let t = 0; t < to; t++) { const kept = a; a = b; b = kept; } return a; }
# What a read out of a view gives may be undefined, so the words entered the loop as `undefined|i32` and went round it in boxes, though every turn hands on an int32: out of a bit operator,
# out of a small function that ends in one, or out of another word of the head. Each turn took them out of their boxes, worked on them as numbers that may be absent, and boxed two again: 67 instructions a step for 49.
# What may be an int32 where it enters, and comes round as an int32 by the look at the loop, is asked for an int32 once, in the row in front of the loop, as a counter is.
# Words that only change places bring no int32 round: nothing is asked of them.
# RUN: walk f2 f3 mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK-COUNT-3: = TypeTest {{*}}testedType=i32
# CHECK: frequency=Rare isLoopHead=true
# CHECK: ([[a]]: i32 @Int32, [[b]]: i32 @Int32, [[c]]: i32 @Int32, {{*}}isInLoop=true isLoopHead=true
# CHECK-NOT: = Unbox
# CHECK: = BitXor [[b]], [[c]] form=Integers
# CHECK-LABEL: code f3:Body
# CHECK-NOT: = TypeTest
# CHECK-COUNT-1: isLoopHead=true
# CHECK-NOT: isLoopHead=true
