# a loop that stores under its counter in every turn, from zero up to a bound that stands in front of it, and that leaves only by its test, fills its list up to the bound: the room is asked for once, in front of the loop
# function fill(n) { const list = []; for (let i = 0; i < n; i++) list[i] = i; return list; }
# function fillSome(n) { const list = []; for (let i = 0; i < n; i++) { if (i & 1) list[i] = i; } return list; }
# function fillUntil(n, end) { const list = []; for (let i = 0; i < n; i++) { if (i === end) break; list[i] = i; } return list; }
# function fillFromOne(n) { const list = []; for (let i = 1; i < n; i++) list[i] = i; return list; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = NewArray
# CHECK: ReserveArrayCapacity
# CHECK: LoopHint
# CHECK-NOT: ReserveArrayCapacity
# RUN(SOME): walk f2 mechanisms=all
# SOME-LABEL: code f2:Body
# SOME-NOT: ReserveArrayCapacity
# SOME: isLoopHead=true
# RUN(UNTIL): walk f3 mechanisms=all
# UNTIL-LABEL: code f3:Body
# UNTIL-NOT: ReserveArrayCapacity
# UNTIL: isLoopHead=true
# RUN(ONE): walk f4 mechanisms=all
# ONE-LABEL: code f4:Body
# ONE-NOT: ReserveArrayCapacity
# ONE: isLoopHead=true
# RUN(NONE): walk f1 mechanisms=none
# NONE-LABEL: code f1:Body
# NONE-NOT: ReserveArrayCapacity

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    v6 = NewClosure function=f3
    v7 = Call v1, -, v6
    v8 = NewClosure function=f4
    v9 = Call v1, -, v8
    Return v9
}
function f1 name="fill" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewArray contents=number
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    ElemSet v1, v3, v3
    v7 = Increment v3
    Jump -> next b1(v7)
  b3():
    Return v1
}
function f2 name="fillSome" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewArray contents=number
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b5()
  b2():
    v6 = Integer integer=1
    v7 = BitAnd v3, v6
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    ElemSet v1, v3, v3
    Jump -> next b4()
  b4():
    v9 = Increment v3
    Jump -> next b1(v9)
  b5():
    Return v1
}
function f3 name="fillUntil" module=m0 length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = NewArray contents=number
    v3 = Integer
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    v7 = StrictEq v4, v1
    Branch v7 -> taken b4(), notTaken b3()
  b3():
    ElemSet v2, v4, v4
    v9 = Increment v4
    Jump -> next b1(v9)
  b4():
