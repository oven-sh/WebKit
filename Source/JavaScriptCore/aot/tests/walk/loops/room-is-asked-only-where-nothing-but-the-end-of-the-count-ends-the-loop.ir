}
function f3 name="fillAndCut" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewArray contents=number
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
