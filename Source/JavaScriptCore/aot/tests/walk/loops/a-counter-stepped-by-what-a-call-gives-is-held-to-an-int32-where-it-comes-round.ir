# function width(text: string, at: number) { return text.charCodeAt(at) === 13 ? 2 : 1; }
# function count(text: string, from: number) { let found = 0; for (let at = from; at < text.length; at += width(text, at)) found++; return found; }
# function stride(at: number) { return (at & 1) + 1073741823; }
# function hops(from: number) { let last = -1; for (let at = from; at < 5000000000; at += stride(at)) last = at; return last; }
# The counter is stepped by what a call gives. An int32 and an int32 make more than an int32, so no look closes the loop on int32s, and the counter ran on doubles.
# It is asked for the int32 in front of the loop and again on the way round; what is none there goes on in the loop as it is written, with what has come round: hops(0) leaves its fast loop at 3221225471.
# RUN: walk f3 f4 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK: frequency=Rare isLoopHead=true
# CHECK: i32 @Int32) isInLoop=true isLoopHead=true
# CHECK: @Int64 = Add {{*}}form=Integers
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK-LABEL: code f4:Body
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK: frequency=Rare isLoopHead=true
# CHECK: i32 @Int32) isInLoop=true isLoopHead=true
# CHECK: @Int64 = Add {{*}}form=Integers
# CHECK: = TypeTest {{*}}testedType=i32
# RUN(SHELL): run-in-shell let asked = 0; const all = ["a\rb\rc", 0, "a\rb\rc", 1.5, "a\rb\rc", -0, 0, 0.5, 2147483647]; globalThis.hidden = () => all[asked++]; globalThis.sink = (...found) => { print(found.join(" ")); };
