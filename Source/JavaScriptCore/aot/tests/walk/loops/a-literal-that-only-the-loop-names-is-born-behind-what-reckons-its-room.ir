# function bornBehind(first, n) { const k = n | 0; const list = [first]; for (let i = 0; i < k; i++) list.push(i); return list; }
# function namedInFront(first, n) { const k = n | 0; const list = [first]; const holder = [list]; for (let i = 0; i < k; i++) list.push(i); return holder; }
# function broughtRound(first, n) { const k = n | 0; let list = [first]; for (let i = 0; i < k; i++) { list.push(i); list = first; } return list; }
# function filledTwice(first, n) { const k = n | 0; const list = [first]; for (let i = 0; i < k; i++) { list.push(i); list.push(i); } return list; }
# function inATurn(first, n) { const k = n | 0; let last; for (let j = 0; j < 4; j++) { const list = [first]; for (let i = 0; i < k; i++) list.push(i); last = list; } return last; }
# A literal is born with a vector as long as it is written; the reservation in front of a loop that fills it took a second vector, copied and filled it, and the first lay dead in the cell.
# bornBehind: nothing but the loop names the literal: it is built once more behind what reckons its room, right in front of the reservation, and the emitter bears it with that room; the first birth has no user and goes.
# namedInFront: another literal holds it: it is ONE list: it stays where it is written. broughtRound: the loop takes it as a parameter of its head: the edge has read the name: it stays.
# filledTwice: a turn pushes twice, so the count of turns does not say how long the list becomes: places in its own cell would lie dead beside a longer vector: it stays.
# inATurn: it is born in each turn of an outer loop, in walks of that loop that may be given up: what stays has one birth, behind the room.
