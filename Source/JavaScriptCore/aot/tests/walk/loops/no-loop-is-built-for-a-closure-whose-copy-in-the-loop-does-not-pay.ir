# function run(step, count) { let total = 0; for (let i = 0; i < count; i++) total += step(i); return total; }  function up(n) { let t = 0; for (let k = 0; k < n; k++) t = ((t + k) * k + k) * k ..; return t; }  function down(n) { .. t -= k .. }  sink(run(up, 10), run(down, 10));
# A build of the loop for each closure pays by what the copy of the closure's body in the loop spares. A callee that is not copied in, here because it has a loop of its own, would be called directly in the place of by value, and the whole loop would stand in the code once more for each:
