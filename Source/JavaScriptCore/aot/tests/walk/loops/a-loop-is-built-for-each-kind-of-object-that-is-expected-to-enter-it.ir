# function sum(xs: Float64Array | number[]) { let s = 0; for (let i = 0; i < xs.length; i++) s += xs[i]; return s; }
# function areas(shape: Shape, turns: number) { let total = 0; for (let i = 0; i < turns; i++) total += shape.area(); return total; }     class Square extends Shape, class Rect extends Shape
# The loop does not change the value, and a few kinds of objects are expected of it. No typed form serves a list and a view at once, or finds `area` above a Square and a Rect at once, and one serves each of them.
# So the kinds are told apart once, in a row in front of the loop, and the loop is built for each under the proof. What is none of them runs in the one closed build, and so does a turn that begins again.
# Each turn once read the length and the element by name: 110 instructions for 9.
# RUN: walk f1 f2 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = TypeTest [[xs]] testedType=Array<number>
# CHECK: = TypeTest [[xs]] testedType=Float64Array
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = ElemGet [[xs]],
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetArrayElement
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetTypedArrayElement
# CHECK-LABEL: code f2:Body
# CHECK: = ShapeTest [[shape]] layouts=
# CHECK: = ShapeTest [[shape]] layouts=
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = Call {{*}}calleeKey="area"
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetSlot {{*}}key="side"
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetSlot {{*}}key="w"
# RUN(ONCE): walk f1 f2 mechanisms=all
# ONCE-COUNT-1: = ElemGet
# ONCE-NOT: = ElemGet
# ONCE-COUNT-1: = Call {{*}}calleeKey="area"
# ONCE-NOT: = Call {{*}}calleeKey="area"
# RUN(WITHHELD): walk f1 mechanisms=-Guesses
# WITHHELD-COUNT-1: isLoopHead=true
# WITHHELD-NOT: isLoopHead=true
# RUN(SHELL): run-in-shell let asked = 0; globalThis.hidden = () => asked++ ? { area: () => 2 } : new Float64Array([1.5, 2]); globalThis.sink = (sum, areas) => { print(String(sum) + " " + String(areas)); };
# SHELL: 3.5 6
# SHELL: exited with 0

