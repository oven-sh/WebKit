# The loop stores sums of 32-bit words under a name and reads the name off other elements of the list. They are integers of any size: the version asks for that and stores by the address of the property.
# function step(w, m) { for (let i = 1; i < w.length; i++) { const u = w[i], o = w[i - 1]; const g = m[i] ^ 5; u.high = g + o.high; } }  sink(step);
