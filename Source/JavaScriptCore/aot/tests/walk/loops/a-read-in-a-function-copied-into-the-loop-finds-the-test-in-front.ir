# a small function that reads one element of the list that it is handed is copied into the loop that calls it: the list is tested once in front of the loop as for a read of the loop's own, and the read in the copy, and in the copy inside the copy, goes by the kind that was tested
# function at(list, i) { return list[i]; }  function step(list, i) { return at(list, i) + 1; }
# function sum(list: number[], n: number) { let s = 0; for (let i = 0; i < n; i++) s += step(list, i); return s; }
# sum([4, 5], +count);
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: = HasArrayStorage
# CHECK: LoopHint
# CHECK: = GetArrayElement {{*}}arrayStorage={{*}}level=Proven
# RUN(NONE): walk f3 mechanisms=none
# NONE-LABEL: code f3:Body
# NONE-NOT: = HasArrayStorage

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
