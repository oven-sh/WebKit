# function scan(text: string, from: number) { let at = from; while (at < text.length) { const was = at++; if (text.charCodeAt(was) === 10) return was; } return -1; }
# A step whose value is used (`at++` as an operand, `list[at++] = ..`) is written as ToNumeric and an Increment of what that gives. The look at the loop did not take what ToNumeric gives for a name
# of the counter, so the counter did not count as stepped on every way round: it went round as a double, or in a box, and every access under it converted it anew.
# What ToNumeric gives of a counter is the counter: it is asked for the int32 once, in front of the loop, as any other counter that enters as a number.
# RUN: walk f1 mechanisms=all
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK: number @Double) frequency=Rare isLoopHead=true
# CHECK: i32 @Int32) isInLoop=true isLoopHead=true
# CHECK: = Less {{*}}form=Integers
# CHECK: = Increment {{*}}form=Integers
# CHECK: = GetStringCodeUnit
# RUN(SHELL): run-in-shell let asked = 0; const all = ["ab\ncd", 0, "ab\ncd", 1.5, "\n", -0, "ab\n", 2147483648, "ab\n", NaN]; globalThis.hidden = () => all[asked++]; globalThis.sink = (...found) => { print(found.map(one => Object.is(one, -0) ? "-0" : String(one)).join(" ")); };
# SHELL: 2 2.5 -0 -1 -1
# SHELL: exited with 0

