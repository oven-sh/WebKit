# function sum(view: Float64Array) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i]; return s; }
# function above(view: Int32Array, from: number, to: number) { let n = 0; for (let i = from; i < to; i++) if (view[i] > 3) n++; return n; }
# function told(view: Int32Array, to: number, tell: (x: number) => void) { for (let i = 0; i < to; i++) tell(view[i]); }
# function spin(view: Uint8Array) { let turns = 0; while (view.length === 4) turns++; return turns > 0; }
# function wait(view: Uint8Array) { let turns = 0; while (view[4] === undefined) turns++; return turns > 0; }
# sink(sum, above, told, spin, wait); new SharedArrayBuffer(4).grow;
# Another thread may lengthen the memory that a view follows, and no effect of this thread says when: the length of such a view stays in its turn, or `while (view.length === 4) { }` would spin for ever.
# Where some thread may grow shared memory, the test in front of the loop asks besides the mark of being as made that the view lies over no shared memory that grows. So behind it no other thread moves the length, and it stands in front of the typed build.
# A view that the turns only read by index stands in the same row: `above` has no name to ask for, and its bound would else be read in every turn: 13.5 instructions a turn became 18.0.
# Having no name to ask for, it is asked for its storage alone: an heir of Int32Array, which never bears the mark of its names, takes the typed turns too.
# The length of `above` is read further in front, for the room of the view under the counter (the head asks the lesser of the bound and the room): a length that another thread makes greater behind that read leaves the
# room too small, never too great, and where the room is reached the turn goes to the other build, which asks the view as it then is.
# The failing side is the closed copy, which asks the view in every turn. Where a turn runs other code nothing can stand in front, and nothing is asked: `told`.
# `spin` and `wait` end only if they see what another thread does: with the length of the view that follows the memory in front of the turns they run for ever, and the test is stopped by its clock.
# OPTIONS: check=Validate
# RUN: walk f1 f2 f3 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = IsPristine {{*}}builtinClass=Float64Array aspects=[Storage, Names]
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = PropGet {{*}}key="length"
# CHECK: = GetTypedArrayLength
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = GetTypedArrayLength
# CHECK-LABEL: code f2:Body
# CHECK: = GetTypedArrayLength
# CHECK: = IsPristine {{*}}builtinClass=Int32Array aspects=[Storage]
# CHECK: frequency=Rare isLoopHead=true
# CHECK: = ElemGet
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = GetTypedArrayLength
# CHECK-LABEL: code f3:Body
# CHECK-NOT: = IsPristine
# RUN(MACHINE): emit f1:Body f2:Body mechanisms=all
# MACHINE-LABEL: unit f1:Body
# MACHINE: = Load8Z({{*}}JSCell_typeInfoFlags
# MACHINE: = Load8Z({{*}}JSArrayBufferView_sharingOfMemory
# MACHINE-LABEL: unit f2:Body
# MACHINE: JSArrayBufferView_length
# RUN(SHELL): run-in-shell globalThis.sink = (sum, above, told) => { const shared = new SharedArrayBuffer(16, { maxByteLength: 64 }); const own = new ArrayBuffer(16, { maxByteLength: 64 }); const gone = new Float64Array([7, 8]); const views = [new Float64Array([1.5, 2, 3]), new Float64Array(shared), new Float64Array(shared, 8, 1), new Float64Array(own), gone]; views[1].set([1, 2]); views[3].set([4, 5]); const whole = [new Int32Array([1, 5, 9, 2]), new Int32Array(shared), new Int32Array(shared, 8, 2), new Int32Array(own), new Int32Array(gone.buffer)]; let said = ""; for (let round = 0; round < 3; round++) { for (const view of views) said += sum(view) + " "; for (const view of whole) said += above(view, 0, 12) + " "; said += "| "; if (round === 0) { shared.grow(32); views[1][3] = 10; own.resize(8); } if (round === 1) gone.buffer.transfer(); } print(said); };
# SHELL: 6.5 3 2 9 15 2 2 1 2 2 | 6.5 13 2 4 15 2 3 1 1 2 | 6.5 13 2 4 0 2 3 1 1 0 |
# SHELL: exited with 0
# RUN(THREADS): run-in-shell globalThis.sink = (sum, above, told, spin, wait) => { const grownByAnotherThread = () => { const shared = new SharedArrayBuffer(4, { maxByteLength: 64 }); $.agent.start("$.agent.receiveBroadcast((shared) => { $.agent.sleep(30); shared.grow(8); $.agent.leaving(); });"); $.agent.broadcast(shared); return new Uint8Array(shared); }; print(spin(grownByAnotherThread()), wait(grownByAnotherThread())); };
# THREADS: true true
# THREADS: exited with 0

