# function swap(bytes: Uint8Array, table: Uint8Array, start: number, end: number) { let i = start, j = end - 1;
#   while (i < j) { const a = bytes[i], b = bytes[j]; bytes[i++] = table[b]; bytes[j--] = table[a]; } }
# What a view gives is undefined behind its end. So what `table[b]` gave was `undefined|int`, a store of it into a view was no store of a number, and both stores called a stub with everything in boxes;
# `table[a]` stands behind the first store of its turn, where a turn can no longer begin again, so nothing could be asked of it there.
# A read out of a view whose value the turn takes for a key, or stores into a view, is held inside its view or the turn begins again. A key out of a small range (a byte) is not asked by itself:
# the view is asked ONCE whether it holds the whole range (`255 < length`), and the length so narrowed is the view's length from there on: the read behind the store lies inside by the types alone.
# A table that is too short takes the loop as it is written.
# RUN: walk f1 mechanisms=all
# CHECK: i32 @Int32) isInLoop=true isLoopHead=true
# CHECK: = GetTypedArrayElement {{*}}isInsideView
# CHECK: = GetTypedArrayElement {{*}}isInsideView
# CHECK: = PutTypedArrayElement {{*}}level=Proven
# CHECK-NOT: = Less
# CHECK: = GetTypedArrayElement {{*}}isInsideView
# CHECK: = PutTypedArrayElement {{*}}level=Proven
# CHECK: = GetTypedArrayElement {{*}}isInsideView
# RUN(SHELL): run-in-shell let asked = 0; const table = new Uint8Array(256); for (let at = 0; at < 256; at++) table[at] = 255 - at; const all = [new Uint8Array([1, 2, 3, 4, 5]), table, 0, 5, new Uint8Array([7, 2, 1]), new Uint8Array([9, 8, 7, 6]), 0, 3]; globalThis.hidden = () => all[asked++]; globalThis.sink = (one, other) => { let text = ""; for (let at = 0; at < one.length; at++) text += (at ? "," : "") + one[at]; text += " "; for (let at = 0; at < other.length; at++) text += (at ? "," : "") + other[at]; print(text); };
