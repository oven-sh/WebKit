# class Counter { step: number; total = 0; constructor(step: number) { this.step = step; } add(value: number) { this.total = (this.total + value * this.step) | 0; return this.total; } }
# function each(list: number[], visit: (x: number) => void) { for (let i = 0; i < list.length; i++) visit(list[i]); }
# function drive(counter: Counter, times: number) { let last = 0; for (let i = 0; i < times; i++) last = counter.add(i); return last; }
# function outsideLoops(list: number[], box: Counter) { each(list, x => { box.add(x); }); return box.total; }
# function insideLoop(lists: number[][], box: Counter) { for (let k = 0; k < lists.length; k++) each(lists[k], x => { box.add(x); }); return box.total; }
# function withoutFunction(box: Counter, times: number) { return drive(box, times); }
# declare function sink(...values: unknown[]): void;
# sink(outsideLoops, insideLoop, withoutFunction, Counter);
# A loop is built twice: a typed build behind tests in front of it, and the build as it is written for what fails them.
# A helper that takes a function only to call it (each) is copied to its call with the function's body in every build of its loop. Where that call stands outside every loop of its callers
# the loop is built once, as it is written: outsideLoops has one head. Inside a loop of the caller (insideLoop) both builds stay, and so they do in the copy of a callee
# that takes no function (drive in withoutFunction): the loop that a program's main function calls for is as hot as any.
# RUN: walk f3 f4 f5 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: callee=f1
# CHECK: isLoopHead=true
# CHECK-NOT: isLoopHead=true
# CHECK-LABEL: code f4:Body
# CHECK: callee=f1
# CHECK: isLoopHead=true
# CHECK: isLoopHead=true
# CHECK: isLoopHead=true
# CHECK-LABEL: code f5:Body
# CHECK: callee=f2
# CHECK: isLoopHead=true
# CHECK: isLoopHead=true
# RUN(ANSWER): run-in-shell mechanisms=all globalThis.sink = (outsideLoops, insideLoop, withoutFunction, Counter) => { const made = step => new Counter(step); const holed = [1, 2, 3]; delete holed[1]; print(outsideLoops([1, 2, 3], made(2)), outsideLoops([1.5, 2.5], made(2)), outsideLoops(holed, made(2)), outsideLoops([], made(2)), insideLoop([[1], [2, 3], []], made(1)), withoutFunction(made(3), 4)); const grows = [1, 2]; const box = made(1); const add = box.add; let turns = 0; box.add = function (value) { if (turns++ < 2) grows.push(10); return add.call(this, value); }; print(outsideLoops(grows, box), grows.length); };
# ANSWER: 12 8 6 0 6 18
# ANSWER: 23 4
# ANSWER: exited with 0

