# var to = new Int32Array(16), from = new Int32Array(16); function copy(text) { for (var i = 0; i < 16; ++i) to[i] = from[i]; return eval(text); } copy("1");
# An earlier eval may have stored anything into the variables. The turns of the loop call nothing and store into neither, so both are asked in front of it for the views that the program stores, and the turns find them.
# LIBRARY: own
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = TypeTest {{*}} testedType=Int32Array
# CHECK: = TypeTest {{*}} testedType=Int32Array
# CHECK: = GetTypedArrayElement {{*}} isInsideView
# CHECK: PutTypedArrayElement

module m0 path="main.js" displayPath="main.js" body=f0
variable g0 name="to" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="from" module=m0 declared={type=anything} initialization=Undefined
variable g2 module=m0 declared={type=anything} initialization=Undefined flags=[MarksEvaluation]
evalscope e0 flags=[IsInFunction, AllowsNewTarget] bindings=[{name="to" depth=1 variable=g0}, {name="from" depth=1 variable=g1}]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Int32Array
    v1 = Integer integer=16
    v2 = Construct v0, -, v1
    PutModuleVariable v2 variable=g0
    v4 = Construct v0, -, v1
    PutModuleVariable v4 variable=g1
    v6 = NewClosure function=f1
    v7 = String string="1"
    v8 = Call v6, -, v7
    Return v8
}
function f1 name="copy" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Integer
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Integer integer=16
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = GetModuleVariable variable=g0
    v9 = GetModuleVariable variable=g1
    v10 = ElemGet v9, v4
    ElemSet v8, v4, v10 mode=Sloppy
    v12 = Increment v4
    Jump -> next b1(v12)
  b3():
    v13 = Boolean boolean=true
    PutModuleVariable v13 variable=g2
    v15 = DirectEval v2, v0, v1 evalScope=e0
    Return v15
}
