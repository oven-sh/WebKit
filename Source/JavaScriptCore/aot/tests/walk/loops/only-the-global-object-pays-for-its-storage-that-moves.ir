# CHECK-LABEL: code f1:Body
# CHECK: = GetKeyedPropertyAddress {{*}}findsPlaceInGlobalObject
# CHECK: = GetKeyedPropertyAddress
# CHECK-NOT: findsPlaceInGlobalObject
# CHECK: = PutKeyedProperty
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
