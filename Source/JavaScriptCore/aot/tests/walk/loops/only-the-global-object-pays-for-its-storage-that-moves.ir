# The storage of the global object moves, so a lookup that expects it finds a place. The lookup in any other object finds an address, which the loop uses as it is.
# function count(n, key: string, o) { for (let i = 0; i < n; i++) { globalThis[key] = globalThis[key] + 1; o[key] = o[key] + 1; } }  sink(count);
