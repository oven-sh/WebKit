# function count(text) { text = String(text); let n = 0; for (const c of text) if (c === "x") n++; return n; }
# A step over a text walks its two ways apart, as a step over a list does: nothing of done, the character and the position meets at the head. Beside the character stands its code point,
# and the comparison with a written text asks that number: no text is made.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = FlattenString
# CHECK: isLoopHead=true
# CHECK: = GetStringCodeUnit
# CHECK: = StrictEq {{*}}form=Integers
# RUN(UNMADE): walk f1:Body mechanisms=all
# UNMADE-NOT: form=NullableStrings
# function points(text) { .. n += c.codePointAt(0) + c.charCodeAt(0) .. }: both are read off the number that the step has
# RUN(POINTS): walk f2:Body mechanisms=all
# POINTS-NOT: = GetStringLength {{*}}@Cell = CallInline
# POINTS-NOT: = Substring
# layout L909 kind=Closure
