# CHECK-LABEL: code f1:Body
# CHECK: = Call {{*}}calleeKey="some" {{*}}methodOfReceiverAsMade=ArrayPrototypeSome
# RUN(BYTES): bytes f1 mechanisms=all
# BYTES: Call Stub CallCompiledMethodOfArray.Some count 1
# RUN(OTHER): walk f2 mechanisms=all
# OTHER-LABEL: code f2:Body
# OTHER-NOT: methodOfReceiverAsMade
# RUN(ANSWERS): run-in-shell
