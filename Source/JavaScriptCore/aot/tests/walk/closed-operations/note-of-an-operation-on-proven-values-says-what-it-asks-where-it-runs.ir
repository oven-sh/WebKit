# where the types of the values that an operation uses are proven, its note says what the operation asks where it runs. `counts[ids[i]]` runs by name where the test of the type of its index fails, and the index is `undefined` there: a read of `ids` gives that where the list has a hole. The increment hangs on what that access reads, so it says the same
# OPTIONS: report=Flow
# RUN: notes f1 mechanisms=all
# CHECK: notes of f1:Body
# CHECK-NEXT: GenericOperation @127 in f1 from=NotSaid asks=IndexThatMayBeUndefined cause=IndexMayBeUndefined
# CHECK-NEXT: GenericOperation @127 in f1 from=NotSaid asks=IndexThatMayBeUndefined cause=IndexMayBeUndefined
# CHECK-NEXT: GenericOperation @127 in f1 from=NotSaid asks=IndexThatMayBeUndefined cause=IndexMayBeUndefined
# `rows[order[i]]` tests its own place, and its element may be absent. What it gives is no more proven than that, so the read of `length` off it and the sum say the same, and no note says that the list holds values of other types
# RUN(ELEMENT): notes f2 mechanisms=all
# ELEMENT: notes of f2:Body
# ELEMENT-NEXT: TestThatRejoins @290 in f2 from=NotSaid made=@167 in f2 asks=ElementThatMayBeAbsent cause=PlaceOfElement why=ElementMayBeAbsent
# ELEMENT-NEXT: GenericOperation @301 in f2 from=NotSaid asks=ElementThatMayBeAbsent cause=PlaceOfElement why=ElementMayBeAbsent
# ELEMENT-NEXT: GenericOperation @290 in f2 from=NotSaid asks=ElementThatMayBeAbsent cause=PlaceOfElement why=ElementMayBeAbsent
# ELEMENT-NEXT: GenericOperation @290 in f2 from=NotSaid asks=ElementThatMayBeAbsent cause=PlaceOfElement why=ElementMayBeAbsent
# ELEMENT-NOT: cause=UnprovenContents
# behind the call of `make`, which nobody knows, the list is tested for being as it was built. That is no question of a type: the list is made in the function and its type is proven
# RUN(STATE): notes f3 mechanisms=all
# STATE: notes of f3:Body
# STATE: TestThatRejoins @461 in f3 from=NotSaid made=@410 in f3 asks=StateOfObject cause=UnprovenState
# STATE: GenericOperation @474 in f3 from=NotSaid cause=UnknownCallee
# STATE: TestThatRejoins @469 in f3 from=NotSaid made=@410 in f3 asks=StateOfObject cause=UnprovenState
# function count(n: number, ids: number[]): number {
#   const counts = new Uint32Array(n);
#   for (let i = 0; i < ids.length; i++) counts[ids[i]]++;
#   return counts[0];
# }
# function total(rows: number[][], order: number[]): number {
#   let sum = 0;
#   for (let i = 0; i < order.length; i++) sum += rows[order[i]].length;
#   return sum;
# }
# function collect(make: any, limit: number): number {
#   const results: number[] = [];
#   for (let i = 0; results.length < limit; i++) results.push(make(i));
#   return results.length;
# }
# (globalThis as any).keep = [count(4, [0, 1, 1, 3]), total([[1], [2, 3]], [0, 1, 1]), collect((globalThis as any).make, 3)];

