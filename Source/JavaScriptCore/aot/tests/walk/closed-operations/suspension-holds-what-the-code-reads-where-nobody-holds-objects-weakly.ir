# nothing of this program makes a weak reference and no code runs that the build has not seen, so nobody can tell when an object is let go: a suspension holds what the code reads behind it and no more
# async function wayNeverTaken(x, p) { await p; if (false) return x.n; return 1; }
# RUN: walk f1:CoroutineBody mechanisms=all
# RUN(FEWEST): walk f1:CoroutineBody mechanisms=none+Folding
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: = AwaitBySavingFrame [[awaited]], [[promise]] traits=
# FEWEST-LABEL: code f1:CoroutineBody
# FEWEST: = AwaitBySavingFrame [[fewawaited]], [[fewpromise]] traits=

layout L0 module=m0 fields=[{key="n" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = Integer integer=1
    PropDefine v0, v1 key="n"
    v3 = FinishObject v0
    v4 = NewClosure function=f1
    v5 = Call v4, -, v3, v1
    Return v5
}
function f1 name="wayNeverTaken" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Await v1
    v3 = Boolean
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = PropGet v0 key="n"
    Return v4
  b2():
    v5 = Integer integer=1
    Return v5
}
