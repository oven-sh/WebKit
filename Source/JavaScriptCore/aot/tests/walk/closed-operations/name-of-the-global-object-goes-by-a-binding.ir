# a free name, and a name that is read off or stored on the global object, goes by a record of the instance. The first access files there what it has found, and whoever stores, defines, deletes or declares the name empties it.
# So nothing has to be known of the name: no lock is leaned on, and no mechanism is asked
# function read() { return shared; }
# RUN: walk f1 mechanisms=none
# CHECK-LABEL: code f1:Body
# CHECK: : anything{{*}} @JSValue = GetGlobalBinding key="shared" level=Expected [seesScriptBindings]
# RUN(NEVER): walk f1 mechanisms=none
# NEVER-NOT: PropGet
# function kind() { return typeof shared; }
# RUN(TYPEOF): walk f2 mechanisms=none
# TYPEOF-LABEL: code f2:Body
# TYPEOF: = GetGlobalBinding key="shared" level=Expected [seesScriptBindings, isForTypeOf]
# No binding of a script stands in front of a property that is read off the object: function readOffObject() { return globalThis.shared; }
# RUN(OBJECT): walk f3 mechanisms=none
# OBJECT-LABEL: code f3:Body
# OBJECT: = GetGlobalBinding key="shared" level=Expected
# OBJECT-NOT: seesScriptBindings
# function store(value) { shared = value; }
# RUN(STORE): walk f4 mechanisms=none
# STORE-LABEL: code f4:Body
# STORE: SetGlobalBinding v0 key="shared" level=Expected [seesScriptBindings]
# function storeOnObject(value) { globalThis.shared = value; }
# RUN(STOREOBJECT): walk f5 mechanisms=none
# STOREOBJECT-LABEL: code f5:Body
# STOREOBJECT: SetGlobalBinding v0 key="shared" mode=Sloppy level=Expected
# A store on what is not written as the global object stays by name, which reports to the run time: function storeOn(holder, value) { holder.other = value; }
# RUN(HOLDER): walk f6 mechanisms=all
# HOLDER-LABEL: code f6:Body
# HOLDER-NOT: GlobalBinding
# HOLDER: PropSet {{*}}key="other"
# An index may be an element: function first() { return globalThis[0]; }
# RUN(INDEX): walk f7 mechanisms=none
# INDEX-LABEL: code f7:Body
# INDEX-NOT: GlobalBinding
# INDEX: = PropGet {{*}}key="0"
# A member that never changes is the built-in itself where typed operations are at work, and goes by its record where they are withheld: function waiting() { return Promise; }
# RUN(CONSTANT): walk f8 mechanisms=none+TypedOperations
# CONSTANT-LABEL: code f8:Body
# CONSTANT-NOT: GlobalBinding
# CONSTANT: = Builtin builtin=Promise
# RUN(WITHHELD): walk f8 mechanisms=none
# WITHHELD-LABEL: code f8:Body
# WITHHELD: = GetGlobalBinding key="Promise" level=Expected [seesScriptBindings]
# The library's `$name`, written as a free name, keeps for good what it has found, and so does its record. Read off the object it is asked for each time.
# RUN(PRIVATE): walk f9 mechanisms=none
# PRIVATE-LABEL: code f9:Body
# PRIVATE: = GetGlobalBinding key=@"makeErrorWithCode" level=Expected [seesScriptBindings]
# PRIVATE: = PropGet {{*}}key=@"asyncContext"
# With every mechanism the forms are the same.
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = GetGlobalBinding key="shared" level=Expected [seesScriptBindings]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
