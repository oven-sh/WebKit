layout L1 module=m0 fields=[{key=symbol("turn")@m0:1 declared={type=number} flags=[IsRequired]}] ownFieldCount=1
layout L2 module=m1 fields=[{key=symbol("again")@m1:0 declared={type=number} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0 namespaceLayout=L(m0)
module m1 path="again.ts" displayPath="again.ts" flags=[MayBeReevaluated] body=f2 namespaceLayout=L(m1)
