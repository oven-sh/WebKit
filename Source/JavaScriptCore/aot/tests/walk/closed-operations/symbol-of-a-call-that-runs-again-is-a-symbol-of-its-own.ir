    PropSet v3, v1 key="first" mode=Strict
    PropSet v3, v2 key="second" mode=Strict
    Jump -> next b1()
  b1():
    LoopHint
    v7 = Builtin builtin=Symbol
    v8 = String string="turn"
    v9 = Call v7, -, v8 calleeName="Symbol" callNumber=1
    v10 = NewObject layout=L1
    v11 = Integer integer=1
    ElemDefine v10, v9, v11
    v13 = FinishObject v10
    v14 = PropGet v3 key="stop" [isFreeName]
    v15 = Call v14, -, v13 calleeName="stop"
    v16 = ToBoolean v15
    Branch v16 -> taken b2(), notTaken b1()
  b2():
    v17 = Undefined
    Return v17
}
function f1 name="make" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
