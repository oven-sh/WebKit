# main.ts: function make() { const tag = Symbol("tag"); return { [tag]: 1 } } make(); make(); for (;;) { const turn = Symbol("turn"); if (stop({ [turn]: 1 })) break }
# again.ts, which the host may start once more: const again = Symbol("again"); keep({ [again]: 1 })
# Each run makes a symbol, and the key of the field stands for them all. One symbol of the image in their place would make two names one: the calls stay.
