# a string that is read out of a text while the text grows in its loop is a cell of its own: it points into no builder. So where it is read behind an await, the builder, a record in the frame, is not live at the await
# function same(value: string) { return value; }   async function gather(limit: number) { const turns = limit | 0; let text = "", kept = "", at = 0; do { text += at + ","; kept = same(text); at = (at + 1) | 0; } while (at < turns); await null; return kept.length + ":" + text.length; }
