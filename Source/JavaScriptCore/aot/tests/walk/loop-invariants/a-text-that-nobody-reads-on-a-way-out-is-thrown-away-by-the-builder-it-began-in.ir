# function render(nodes, limit) { let width = 0, html = ""; for (const node of nodes) { switch (node.kind) { case "text": try { width += node.value.length; } catch (e) { width += 1; } html += node.value; break; } if (width > limit) return "too wide"; } return html; }
# On the early way out nobody reads the text, so its builder is thrown away. No name of the text is alive there; the name that was bound last is a parameter of the block behind the `try`, which the way past the `case` does not come through. The builder that the text began in stands in front of the loop.
