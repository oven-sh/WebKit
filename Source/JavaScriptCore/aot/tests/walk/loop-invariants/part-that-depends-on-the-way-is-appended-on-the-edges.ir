# a part of a text in a builder that depends on the way is appended on each edge into the block of the join, in the form of what that edge brings: written texts as bytes, and no parameter is made for the part
# function marks(n) { let s = ""; for (let i = 0; i < n; i++) s += i % 2 ? "a" : "bb"; return s; }
# function tailed(n) { let s = ""; for (let i = 0; i < n; i++) s += (i % 2 ? "a" : i) + "!"; return s; }   the parameter comes first in what is appended, and what stands behind it is joined where it is written
# function headed(n) { let s = ""; for (let i = 0; i < n; i++) s += "<" + (i % 2 ? "a" : "bb"); return s; }   a part stands in front of the parameter, which an append on the edges would put behind it: the parameter is made
# function kept(n, log) { let s = ""; for (let i = 0; i < n; i++) { const p = i % 2 ? "a" : "bb"; log(s); s += p; } return s; }   somebody reads the text between the head of the block and the join
