# const Add = class { constructor(v) { this.v = v; } };  sink(Add);  sink(total(Add, 0), total(Add, 1));  sink(total(Add, 0));  function total(Add, t) { let s = t & 1; for (let i = 0; i < 64; i++) s = (s + new Add(i).v) | 0; return s; }
# Unseen code has the class in hand: it may lay a setter under "v" above the objects. So the constructor's store stands behind a guard of the class and the name.
# Asked in the turn, the guard has a rare arm that stores by name and meets the typed arm again: behind the meeting nothing is known of the object: it is built, read by a guess, and what is read is tested.
# The guards of stores that a try of the loop saw asked are asked in front of the loop, as the guards of a method read off such an object are: in the typed copy the store is proven,
# the read is what was stored, and the object is not built. f1 = total, f2 = Add.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[holds]]: boolean @Boolean = AreMembersUnchanged conditions=[{kind=MemberPassedByStores layout=L0 key="v"}]
# CHECK-NEXT: Branch [[holds]] -> taken [[typed]](), notTaken
# The other copy is the walk of the loop as it was tried first, kept: it stands in front of the typed copy and makes its objects.
# CHECK: [[typed]]()
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = NewObject
# CHECK-NOT: = AreMembersUnchanged
# CHECK: = Add {{*}}form=Integers
# RUN(TWICE): compile WalkLoopsVersioned mechanisms=all
# TWICE: statistic WalkLoopsVersioned 1
# RUN(ANSWER): run-in-shell let calls = 0, Add; globalThis.sink = (...all) => { if (!calls++) { Add = all[0]; return; } print(all.join(" "), globalThis.seen); Object.defineProperty(Add.prototype, "v", { set(x) { globalThis.seen = x; }, get() { return 1; }, configurable: true }); };
# ANSWER: 2016 2017 undefined
# ANSWER-NEXT: 64 63
# ANSWER-NEXT: exited with 0
# Where proofs are checked at run time the object is built for the checks.
# REQUIRES: as-written
# LIBRARY: own

layout L0 kind=Instance module=m0 constructor=f2 fields=[{key="v" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = NewClosure function=f1
    v6 = Call v4, -, v2
    v7 = Integer
    v8 = Integer integer=1
    v9 = Call v5, -, v2, v7 calleeName="total"
    v10 = Call v5, -, v2, v8 calleeName="total"
    v11 = Call v4, -, v9, v10
    v12 = Call v5, -, v2, v7 calleeName="total"
    v13 = Call v4, -, v12
    Return v13
}
function f1 name="total" module=m0 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=i32 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything, v1: i32):
    v2 = Integer integer=1
    v3 = BitAnd v1, v2
    v4 = Convert v3 declared={type=i32 flags=[IsExpected]}
    v5 = Integer
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Integer integer=64
    v11 = Less v8, v10
    Branch v11 -> taken b2(), notTaken b3()
  b2():
    v12 = Construct v0, -, v8 calleeName="Add"
    v13 = PropGet v12 key="v"
    v14 = Add v7, v13
    v15 = Integer
    v16 = BitOr v14, v15
    v17 = Convert v16 declared={type=i32 flags=[IsExpected]}
    v18 = Increment v8
    v19 = Convert v18 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v17, v19)
  b3():
    Return v7
}
function f2 name="Add" module=m0 kind=BaseConstructor flags=[HasNewTarget] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0}
    PropSet v4, v1 key="v"
    Return v4
}
