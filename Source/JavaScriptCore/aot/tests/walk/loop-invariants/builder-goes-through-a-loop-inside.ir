# a text that grows in a loop and in a loop inside it goes through the head of the inner loop in the builder of the outer one: one builder is begun, both loops append to it, and no turn of either joins strings
# function table() { let s = ""; for (let i = 0; i < 16; i++) { for (let j = 0; j < 16; j++) s += "x"; s += ";"; } return s; }
# function reset() { let s = ""; for (let i = 0; i < 16; i++) { for (let j = 0; j < 16; j++) s += "x"; sink(s); s = ""; } return s; }
# the one property that is changed: the outer loop does not only let the text grow, so there it goes round as a string. A builder for the inner loop would be begun with the whole of it at every outer turn
# function nested() { let s = ""; for (let i = 0; i < 16; i++) { s += "x"; let t = ""; for (let j = 0; j < 4; j++) t += s; sink(t); } return s; }
# the inner loop has a text of its own and reads the outer one, which is a string to the looks at the inner loop
