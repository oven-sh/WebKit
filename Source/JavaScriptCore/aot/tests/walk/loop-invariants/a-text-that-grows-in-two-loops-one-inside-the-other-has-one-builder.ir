# a text grows in both of two loops, one inside the other, and the inner one has few turns: in the first walk no builder stands yet, so the inner turns are written out, and behind them their names are empty.
# What the turns bound is kept with the try around them, joined over the turns: so the row of the outer loop knows that the inner join makes a text, the outer loop buys one builder, and in the next walk the inner loop goes round with it
# function both(n: number) { let s = ""; for (let i = 0; i < n / 4; i++) { s += "["; for (let j = 0; j < 3; j++) s += words[j]; } return s; }
