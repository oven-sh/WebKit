# each turn stores the variable. The look at the loop shows that, so the read stays at the head of the loop and is made in every turn
# let step; function list(n) { let s = 0; for (let i = 0; step, i < n; i++) { s = [s, step]; step = i; } return s; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK-NOT: GetModuleVariable
# CHECK: isLoopHead=true
# CHECK: = GetModuleVariable {{*}}variable=g0
# CHECK: PutModuleVariable

variable g0 name="step" module=m0 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    PutModuleVariable v3 variable=g0
    Return v3
}
function f1 name="list" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b5()
  b1(v2):
    v3 = Integer
    Jump -> next b2(v3, v3)
  b2(v4, v5):
    LoopHint
    v7 = GetModuleVariable variable=g0
    v8 = Less v5, v2
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    v9 = NewArray v4, v7 contents=anything
    PutModuleVariable v5 variable=g0
    v11 = Increment v5
    Jump -> next b2(v9, v11)
  b4():
    Return v4
  b5():
    Return v0
}
