# class Square { side: number; constructor(side: number) { this.side = side; } area() { return this.side * this.side; } }
# function sum(shape: Square, turns: number) { let total = 0; for (let i = 0; i < turns; i++) total += shape.area(); return total; }
# globalThis.kept = sum; sink(sum([new Square(2), new Square(3)][give()], give()));
# `shape` comes in as undefined, null or a Square. The loop is built twice, and a turn of the typed copy may begin again in the other copy. What such a turn asks of a receiver that stands in front of the loop
# is asked once, in front, and the failing way is the other copy from its start: there a loop of no turn throws nothing, and the first turn throws where it is written. The test for undefined and null used to be
# a check that throws, so it stayed in the turn and held all that hangs on it: the look at the prototype, the look at the slot, the read, the product. The look at the members of the class stayed too: a read
# by name counted as a write of the guards of members, which only a read off a constructor function begins.
# Since a loop is walked under a row the test in front is the test of the shape, which keeps undefined and null out with every other stranger.
# f1 = sum
# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[shape]]: boolean @Boolean = ShapeTest {{*}}layouts=[L0]
# CHECK-NEXT: Branch [[shape]] -> taken {{*}}, notTaken [[closed]]()
# CHECK: number @Double{{*}}isInLoop=true isLoopHead=true
# CHECK-NOT: RequireObjectCoercible
# CHECK: [[prototype]]: boolean @Boolean = HasLayoutPrototype
# CHECK-NEXT: Branch [[prototype]] -> taken {{*}}, notTaken [[closed]]()
# CHECK: [[members]]: boolean @Boolean = AreMembersUnchanged
# CHECK-NEXT: Branch [[members]] -> taken {{*}}, notTaken [[closed]]()
# CHECK: [[filled]]: boolean @Boolean = IsSlotFilled
# CHECK-NEXT: Branch [[filled]] -> taken {{*}}, notTaken [[closed]]()
# CHECK: ():
# CHECK-NEXT: GetSlot {{*}}key="side"
# CHECK-NEXT: Mul

layout L0 kind=Instance name="Square" module=m0 constructor=f2 fields=[{key="side" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f3
    DefineMethod v3, v5 layout=L0 key="area"
    v7 = FinishClass v3 layout=L0
    v8 = Convert v7 declared={type=f2 flags=[IsFromCompiler]}
    v9 = Convert v7 declared={type=f2 flags=[IsFromCompiler]}
    v10 = Integer integer=2
    v11 = Construct v9, -, v10 calleeName="Square"
    v12 = Integer integer=3
    v13 = Construct v9, -, v12 calleeName="Square"
    v14 = NewArray v11, v13 contents=anything
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="globalThis" [isFreeName]
    v17 = Convert v16 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    PropSet v17, v1 key="kept"
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="sink" [isFreeName]
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="give" [isFreeName]
    v23 = Call v22 calleeName="give"
    v24 = Convert v23 declared={type=number}
    v25 = ElemGet v14, v24
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="give" [isFreeName]
    v28 = Call v27 calleeName="give"
    v29 = Convert v28 declared={type=number}
    v30 = Call v1, -, v25, v29 calleeName="sum"
    v31 = Call v20, -, v30 calleeName="sink"
    v32 = Undefined
    Return v32
}
function f1 name="sum" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=number}] {
  b0(v0: undefined|null|L0, v1: number):
    v2 = Integer
    v3 = Convert v2 declared={type=number}
    v4 = Integer
    v5 = Convert v4 declared={type=number}
    Jump -> next b1(v3, v5)
  b1(v6: number, v7: number):
    LoopHint
    v9 = Less v7, v1
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = PropGet v0 key="area"
    v11 = Call v10, v0 calleeKey="area" calleeName="shape.area"
    v12 = Add v6, v11
    v13 = Convert v12 declared={type=number}
    v14 = Increment v7
    v15 = Convert v14 declared={type=number}
    Jump -> next b1(v13, v15)
  b3():
    v16 = Convert v6 declared={type=number}
    Return v16
}
function f2 name="Square" module=m0 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0}
    v5 = CallDirect v4 function=f4
    PropSet v4, v1 key="side"
    v7 = Undefined
    v8 = TypeTest v7 testedType=object
    Branch v8 -> taken b1(| 0), notTaken b2(v4)
  b1(v9):
    Jump -> next b2(v9)
  b2(v10):
    Return v10
}
