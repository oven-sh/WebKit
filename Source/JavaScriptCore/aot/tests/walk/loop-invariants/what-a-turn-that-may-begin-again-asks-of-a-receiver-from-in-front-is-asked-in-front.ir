  b0(v0: L0):
    v1 = PropGet v0 key="side"
    v2 = PropGet v0 key="side"
    v3 = Mul v1, v2
    v4 = Convert v3 declared={type=number}
    Return v4
}
function f4 module=m0 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=L0} results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v2 = Undefined
    PropDefine v1, v2 key="side"
    v4 = Undefined
    Return v4
