  b0(v0: anything):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b8()
  b1(v2):
    v3 = Integer
    Jump -> next b2(v3, v3)
  b2(v4, v5):
    LoopHint
    v7 = Less v5, v2
    Branch v7 -> taken b3(), notTaken b7()
  b3():
    v8 = Integer
    Jump -> next b4(v4, v8)
  b4(v9, v10):
    LoopHint
    v12 = Less v10, v5
    Branch v12 -> taken b5(), notTaken b6()
  b5():
    v13 = Add v9, v10
    v14 = Increment v10
    Jump -> next b4(v13, v14)
  b6():
    v15 = Increment v5
    Jump -> next b2(v9, v15)
  b7():
