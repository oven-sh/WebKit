}
function f3 name="summed" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Add v3, v0
    v7 = Increment v4
    v8 = Integer integer=16
