  b1(v4, v5):
    LoopHint
    v7 = Call v1, -, v4
    v8 = String string="k"
    v9 = Add v4, v8
    v10 = Increment v5
    v11 = Integer integer=16
    v12 = Less v10, v11
    Branch v12 -> taken b1(v9, v10), notTaken b2()
  b2():
