# function tally(items: Item[]) { let total = 0; for (let i = 0; i < items.length; i++) { const item = items[i]; item.seen = item.seen + 1; total += item.price * items[0].count; } return total; }
# The store into the slot is all that the turn has done where the tests of `price` and `count` stand. What the slot held was read in front of the store, so a test that fails there stores it back and the turn starts over in the other copy, which makes the store again: once for whoever looks. No closed side rejoins.
# The numbers are only expected: written ones would have raw slots, whose checks run before the iteration does anything.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: isInLoop=true isLoopHead=true:
# CHECK: PutSlot{{*}}key="seen"
# CHECK: frequency=Rare
# CHECK: PutSlot{{*}}key="seen"{{*}}[undoesIterationStore]
# RUN(COUNT): compile WalkLoopsVersioned StoresUndoneAtIterationRestarts mechanisms=all
# COUNT: statistic WalkLoopsVersioned 1
# COUNT: statistic StoresUndoneAtIterationRestarts 1
# RUN(SHELL): run-in-shell globalThis.sink = (tally, item) => { const list = [item, item]; print(tally(list), item.seen); const text = { price: 7, count: "2", seen: 10 }; list[1] = text; print(tally(list), item.seen, text.seen); const looks = { price: 1, get count() { print("seen is", this.seen); return 1; }, seen: 20 }; list[0] = looks; print(tally(list), looks.seen, text.seen); list[0] = text; print(tally(list), text.seen); };
# SHELL: 12 2
# SHELL-NEXT: 27 3 11
# SHELL-NEXT: seen is 21
# SHELL-NEXT: seen is 21
# SHELL-NEXT: 8 21 12
# SHELL-NEXT: 28 14
# SHELL-NEXT: exited with 0
# RUN(NET): run-in-shell testing=CheckEffectsAtRunTime globalThis.sink = (tally, item) => { const list = [item, item]; print(tally(list), item.seen); const text = { price: 7, count: "2", seen: 10 }; list[0] = text; print(tally(list), item.seen, text.seen); };
# NET: 12 2
# NET-NEXT: 18 3 11
# NET-NEXT: exited with 0

layout L0 name="Item" module=m0 fields=[{key="price" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="count" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="seen" declared={type=number} flags=[IsRequired]}] ownFieldCount=3
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewObject layout=L0
    v4 = Integer integer=2
    PropDefine v3, v4 key="price"
    v6 = Integer integer=3
    PropDefine v3, v6 key="count"
    v8 = Integer
    PropDefine v3, v8 key="seen"
    v10 = FinishObject v3
    v11 = Call v1, -, v2, v10
    Return v11
}
function f1 name="tally" module=m0 length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|L0> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Array<undefined|null|L0>):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: number, v4: number):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = PropGet v8 key="seen"
    v10 = Increment v9
    PropSet v8, v10 key="seen"
    v12 = PropGet v8 key="price"
    v13 = Integer
    v14 = ElemGet v0, v13
    v15 = PropGet v14 key="count"
    v16 = Mul v12, v15
    v17 = Add v3, v16
    v18 = Convert v17 declared={type=number}
    v19 = Increment v4
    v20 = Convert v19 declared={type=number}
    Jump -> next b1(v18, v20)
  b3():
    Return v3
}
