# const numbers: number[] = []; numbers.push(give(1));   function last() { let kept = 0; for (const x of numbers) kept = x; return kept; }
# The list stays as it was made and holds what code out of sight has given. The row in front of the loop asks it for its kind, the look at the loop types the step by that, and so `kept` goes round as a number or undefined.
# The step used to read as of a list of any kind where its reads run no code: anything came round to a head that was laid down for numbers: the unit was walked again, and the verifier stopped the build.
# f1 = last
# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = HasArrayStorage {{*}}arrayStorage=Double
# CHECK: (v{{*}}: undefined|number @{{*}}isInLoop=true isLoopHead=true
# CHECK: undefined|number {{*}} = GetArrayElement {{*}}arrayStorage=Double level=Proven [keyIsIntegral, isInBounds

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="numbers" module=m0 declared={type=undefined|null|absent|Array<number> flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = PropGet v3 key="push"
    v6 = PropGet v1 key="give" [isFreeName]
    v7 = Integer integer=1
    v8 = Call v6, -, v7
    v9 = Call v5, v3, v8 calleeKey="push"
    v10 = PropGet v1 key="sink" [isFreeName]
    v11 = Call v0, -
    v12 = Call v10, -, v11
    Return v12
}
function f1 name="last" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=number}] {
  b0():
    v0 = Integer
    v1 = Convert v0 declared={type=number}
    v2 = GetModuleVariable variable=g0
    v3 = CheckInitialized v2 name="numbers"
    v4 = IteratorOpen v3
    Jump -> next b1(v1)
  b1(v5: number):
    LoopHint
    v7 = IteratorResume v4
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v10 = Convert v5 declared={type=number}
    Return v10
  b3() handler=b4():
    v11 = Convert v9 declared={type=number}
    Jump -> next b1(v11)
  b4() role=IterationCleanup subject=v4:
    v12 = CatchException
    IteratorClose v4 completion=Throw
    Rethrow v12
}
