    v2 = Integer
    v3 = Integer
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = PropGet v1 key="length"
    v8 = Less v5, v7
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Integer
    v10 = ElemGet v0, v9
    v11 = ElemGet v1, v5
    v12 = Mul v10, v11
    v13 = Integer integer=1
    v14 = ElemGet v0, v13
    v15 = Add v12, v14
    v16 = Add v4, v15
    v17 = Increment v5
    Jump -> next b1(v16, v17)
  b3():
    Return v4
}
function f2 name="stores" module=m0 flags=[HasExplicitName] length=3 thisType={type=anything} parameters=[{type=undefined|null|Array<number> flags=[IsExpected]}, {type=undefined|null|Array<number> flags=[IsExpected]}, {type=undefined|null|Array<number> flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: undefined|null|Array<number>, v1: undefined|null|Array<number>, v2: undefined|null|Array<number>):
    v3 = Integer
