# function weigh(m, xs) { let s = 0; for (let i = 0; i < xs.length; i++) s += m[0] * xs[i] + m[1]; return s; }
# m[0] and m[1] are asked for and read in front of the typed copy. An element that is shown to be there is no hole: the read bears no word that a hole is read as NaN. With that word left on it the checks that hold the number against memory
# (a StrictEq, which tells NaN from undefined) were refused by the verifier: no build under those checks and the verifier together.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetArrayElement {{*}} arrayStorage=Double level=Proven [keyIsIntegral, isPresent, admitsInt32Storage]
# CHECK-NOT: isPresent, readsHoleAsNaN

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
