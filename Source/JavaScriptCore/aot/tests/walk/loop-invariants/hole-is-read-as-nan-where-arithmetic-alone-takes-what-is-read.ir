# function sum(list: number[]) { let total = 0; for (let i = 0; i < list.length; i++) total += list[i]; return total; }
# function holes(list: number[]) { let count = 0; for (let i = 0; i < list.length; i++) if (list[i] === undefined) count++; return count; }   sink(sum([1, 2, 3]), holes([1, 2, 3]));
# Behind the row in front of the loop the read is inside the length and out of storage for numbers. In `sum` the sum alone takes what is read, and beside a number it makes NaN of undefined:
# so a hole is read as NaN: no test for it, no number that may be missing. In `holes` the reader tells undefined from NaN: nothing changes there.
# [readsHoleAsNaN] once had an emitter and a rule, and nobody set it.
