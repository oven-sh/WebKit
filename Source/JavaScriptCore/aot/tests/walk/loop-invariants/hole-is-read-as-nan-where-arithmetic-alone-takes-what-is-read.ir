# CHECK-LABEL: code f1:Body
# CHECK: @Double = GetArrayElement {{*}}level=Proven {{*}}readsHoleAsNaN
# CHECK-LABEL: code f2:Body
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK-NOT: readsHoleAsNaN
# RUN(SHELL): run-in-shell globalThis.sink = (total, count) => { print(total + " " + count); };
