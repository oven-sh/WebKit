# function countsEmptyCells(rows: string[]): number { const cells: string[] = rows[0].split(","); let n = 0; for (let j = 0; j < cells.length; j++) { if (cells[j] === "") n++; } return n; }
# function countsCellsThatAgree(rows: string[]): number { const first: string[] = rows[0].split(","); let most = first.length; for (let i = 1; i < rows.length; i++) { const cells: string[] = rows[i].split(","); let j = 0; while (j < most && j < cells.length && first[j] === cells[j]) j++; most = j; } return most; }
