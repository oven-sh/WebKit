# function sum(items: Item[] | null | undefined) { let total = 0; for (let i = 0; i < items.length; i++) total += items[i].price * items[i].count; return total; }
# The function gets out, so nothing is proven of what the list holds: what an element is and that its slots hold numbers are guesses; that they are filled the mark of the cell answers, which the test of the shape asks.
# Where one of their tests fails nobody has seen anything of the turn, so the other copy of the loop does the whole turn, from what the head held. No closed arm rejoins the typed copy:
# the sum comes round as a raw number, the element is read and tested once, and the length and the storage of the list stand in front of the loop.
# The numbers are only expected: written ones would have raw slots, whose checks run before the iteration does anything.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# The other copy opens guesses of its own and is no rare code: one element of another shape sends all the turns that are left there. It is printed first; its entry stands behind it.
# CHECK: isInLoop=true isLoopHead=true:
# CHECK: = GetSlot {{*}}key="price" {{*}}level=Expected
# CHECK: [[entry]]({{*}}: number @Double, {{*}}):
# CHECK: = GetArrayLength
# CHECK: = GetArrayStorage
# CHECK: ([[sum]]: number @Double, {{*}}) isInLoop=true isLoopHead=true:
# CHECK-NOT: = PropGet
# CHECK-NOT: = GetArrayLength
# CHECK: [[element]]: {{*}} = GetArrayElement {{*}}level=Proven
# CHECK-NEXT: = ShapeTest [[element]]
# CHECK: Jump -> next [[entry]]([[sum]],
# CHECK-NOT: = GetArrayElement
# CHECK-NOT: = ShapeTest
# CHECK-NOT: = PropGet
# CHECK: = Mul {{*}}form=Numbers
# CHECK: = Add [[sum]], {{*}}form=Numbers
# RUN(COUNT): compile WalkLoopsVersioned IterationRestartsEmitted mechanisms=all
# COUNT: statistic WalkLoopsVersioned 1
# COUNT: statistic IterationRestartsEmitted 3
# RUN(ONCE): walk f1 mechanisms=all-LoopInvariants
# ONCE: isLoopHead=true:
# ONCE-NOT: isLoopHead=true:
# RUN(SHELL): run-in-shell globalThis.sink = (sum, item) => { const list = [item, item]; print(sum(list)); list[1] = { count: "2", price: 7 }; print(sum(list)); list[0] = { get price() { print("read"); return 1; }, count: 1 }; print(sum(list)); list[1] = item; print(sum(list)); };
# SHELL: 12
# SHELL-NEXT: 20
# SHELL-NEXT: read
# SHELL-NEXT: 15
# SHELL-NEXT: read
# SHELL-NEXT: 7
# SHELL-NEXT: exited with 0

layout L0 name="Item" module=m0 fields=[{key="price" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="count" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewObject layout=L0
    v4 = Integer integer=2
    PropDefine v3, v4 key="price"
    v6 = Integer integer=3
    PropDefine v3, v6 key="count"
    v8 = FinishObject v3
    v9 = Call v1, -, v2, v8
    Return v9
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|L0>}] results=[{type=anything}] {
  b0(v0: undefined|null|Array<undefined|null|L0>):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: number, v4: number):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = PropGet v8 key="price"
    v10 = ElemGet v0, v4
    v11 = PropGet v10 key="count"
    v12 = Mul v9, v11
    v13 = Add v3, v12
    v14 = Convert v13 declared={type=number}
    v15 = Increment v4
    v16 = Convert v15 declared={type=number}
    Jump -> next b1(v14, v16)
  b3():
    Return v3
}
