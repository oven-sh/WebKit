# function spelled(limit) { let seen = "", sum = 0; outer: for (let i = 0; i < 16; i++) { seen += "k"; for (let j = 0; j < 3; j++) { if (i + j === limit) break outer; sum += j * i; } } return seen + sum; }
# a text grows in a loop, a second loop inside it writes nothing, and a break leaves both from the inner one: the string is made on that edge.
# What is built on an edge stands in no loop that the edge leaves: the look at the inner loop need not have counted on the string. The walk is not given up for it: the verifier refuses a second walk.
