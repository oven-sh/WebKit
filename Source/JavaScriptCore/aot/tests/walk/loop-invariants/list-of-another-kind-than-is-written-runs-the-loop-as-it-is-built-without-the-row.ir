# function sum(list: number[]) { let total = 0; for (let i = 0; i < list.length; i++) total += list[i] | 0; return total; }   sink(sum([1, 2, 3]), sum([1, "2", 3] as number[]));
# Link knows every caller, so the list is proven to be a list, and nothing is asked in front of the loop but whether it is as made and holds numbers. The kind is a guess by what is written of the elements:
# one text among the numbers fails it, for every turn. So the other copy is the loop as it is built without the row: its turns open their own guesses (the element is tested for a number),
# and the way there is not rare, or the allocator would spill in it.
# Link has followed both lists, so that copy asks the list nothing either (LinkTables::receiversThatStayAsMade): it names no kind and goes by the one that it finds, and what it reads is a number, a text or undefined (resultsOfReadsByKey).
# The other copy was once closed and rare: x1.126 on one benchmark.
# The other copy is the walk that found the row, kept: it is printed in front of the second test.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: frequency=Rare isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK: = TypeTest {{*}}testedType=number
# CHECK: = HasArrayStorage {{*}}arrayStorage=Double
# CHECK-NOT: frequency=Rare isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: = GetArrayElement {{*}}arrayStorage=Double level=Proven
# RUN(SHELL): run-in-shell globalThis.sink = (first, second) => { print(first + " " + second); };
# SHELL: 6 6
# SHELL: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
data d0 root=Array{contents=anything elements=[Number{value=1}, Number{value=2}, Number{value=3}]} module=m0
data d1 root=Array{contents=anything elements=[Number{value=1}, String{value="2"}, Number{value=3}]} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Data data=d0
    v2 = Data data=d1
    v3 = Call v0, -, v1
    v4 = Call v0, -, v2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v3, v4
    Return v7
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Array<number>):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: number, v4: number):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Add v3, v10
    v12 = Increment v4
    Jump -> next b1(v11, v12)
  b3():
    Return v3
}
