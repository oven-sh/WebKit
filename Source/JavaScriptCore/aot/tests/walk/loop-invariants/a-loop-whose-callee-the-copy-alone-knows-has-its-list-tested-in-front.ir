# function each(list: number[], visit: (value: number) => void) { for (let i = 0; i < list.length; i++) visit(list[i]); }
# function main() { const list = fill(9), a = make(8), b = make(4); for (let turn = 0, turns = hidden(); turn < turns; turn++) { each(list, value => { if (value < a.limit) a.total += value; }); each(list, value => { if (value > b.limit) b.total += 1; }); } sink(a.total + b.total); }
# Two closures reach the call in `each`; each copy of `each` knows its own. The look takes the effects of that one function: it runs no code that nobody has seen, but all that is told of its stores is
# that they may reach whatever is in sight, the list among it. A copy of the loop whose turns begin again in the other copy is still tried for such a loop, and in it the stores are those of the closure's own
# operations: the list is tested once in front of the loop and read by the kind of its storage.
# The calls stand in a loop of main: outside every loop of its callers the loop of a helper that only calls what it is handed is built once, as it is written.
# f4 = main
# OPTIONS: check=Validate
# RUN: walk f4 mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: HasArrayStorage {{*}}arrayStorage=Double
# CHECK: isInLoop=true isLoopHead=true
# CHECK: isInLoop=true isLoopHead=true
# CHECK: GetArrayElement {{*}}arrayStorage=Double
# CHECK: PutSlot {{*}}key="total"

