# a text that grows in one loop and goes on growing in the next stays in its builder between the two: one begin in front of the first, one finish behind the second
# function two(n) { let s = ""; for (let i = 0; i < n; i++) s += i; for (let j = 0; j < n; j++) s += j; return s; }
# function read(n, log) { let s = ""; for (let i = 0; i < n; i++) s += i; log(s); for (let j = 0; j < n; j++) s += j; return s; }   somebody reads the text between the loops, so it is finished on the edge and begun anew
# function skip(n, first) { let s = ""; if (first) for (let i = 0; i < n; i++) s += i; for (let j = 0; j < n; j++) s += j; return s; }   written so that two edges enter the second loop, and one of them brings a string
