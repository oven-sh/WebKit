# If the look at a loop did not count the store of the position that the walk builds in the place of a ForInStep, the read of the position would leave the loop wherever nothing else in it writes or runs:
# over a text the step lets no other code run. Every turn would then look for a key from the first place on, find the first key again, and the loop would never end.
# function count(text) { let n = 0; for (const k in text) n++; return n; }   count("abc")
# With TypedOperations the position of such a loop comes round in a register and lies in no word of the heap: the form that the test is about is the closed one.
# RUN: walk f1 mechanisms=-TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: = NewHeapWords
# CHECK: isLoopHead=true
# CHECK: [[position]]: {{*}} = GetHeapFrameWord
# CHECK: = ForInStep
# CHECK: PutHeapFrameWord
# RUN(FRONT): walk f1 mechanisms=-TypedOperations
# FRONT-LABEL: code f1:Body
# FRONT-NOT: GetHeapFrameWord
# FRONT: isLoopHead=true

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="abc"
    v2 = Call v0, -, v1 calleeName="count"
    Return v2
}
function f1 name="count" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = ForInOpen v0
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = ForInStep v2, v0
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    Return v3
  b3():
    v8 = Increment v3
    Jump -> next b1(v8)
}
