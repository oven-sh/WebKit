# what still grows in look 2 goes to the tops of its kinds: a sum with a value of which nothing is known is a number or a text, and with that on its left it may be a BigInt too. Look 3 finds that it holds.
# Each turn hands a text on by one parameter, so `c` grows for the first time in look 3: it is lost, and with it `d`, which is made of it. The counter, the sum, `a` and `b` are made of neither, and keep what look 3 has checked
# function run(n, x) { let s = 0, a = 0, b = 0, c = 0, d = 0; for (let i = 0; i < n; i++) { s = s + x; d = c; c = b; b = a; a = "t"; } return [s, a, b, c, d]; }
# RUN: walk f1 mechanisms=none+TypedOperations
# CHECK-LABEL: code f1:Body
# CHECK: ([[s]]: number|string|bigint {{*}}, [[a]]: 0|"t" {{*}}, [[b]]: 0|string {{*}}, [[c]]: anything?LostByWalk {{*}}, [[d]]: anything?LostByWalk {{*}}, [[i]]: int[0, 2147483647] {{*}}isLoopHead=true

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="run" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3):
    v4 = Integer
    Jump -> next b2(v4, v4, v4, v4, v4, v4)
  b2(v5, v6, v7, v8, v9, v10):
    LoopHint
    v12 = Less v10, v3
    Branch v12 -> taken b3(), notTaken b4()
  b3():
    v13 = Add v5, v1
    v14 = String string="t"
    v15 = Increment v10
    Jump -> next b2(v13, v14, v6, v7, v8, v15)
  b4():
    v16 = NewArray v5, v6, v7, v8, v9 contents=anything
    Return v16
  b5():
    Return v0
}
