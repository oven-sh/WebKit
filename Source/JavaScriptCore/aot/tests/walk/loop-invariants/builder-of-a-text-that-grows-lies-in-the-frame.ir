# the builder of a text that grows lies in the frame of the unit: each part takes the newest cursor and gives the next, and a block that has none in sight reads it out of the record
# function digits(n) { if (typeof n === "number") { let s = ""; for (let i = 0; i < n; i++) s += i; return s; } }
# function keys(n) { if (typeof n === "number") { let s = ""; for (let i = 0; i < n; i++) s += "k" + i + ","; return s; } }   the three parts of one row hand the cursor on, so it is read once in the turn and once on the way out
# function guarded(n, f) { let s = ""; let bad = 0; for (let i = 0; i < n; i++) { try { s += f(i); } catch { bad++; } } return s + bad; }   an append that throws leaves a record that nobody may read, so under a handler no text lies in the frame
# function told(n, f) { if (typeof n === "number") { let s = ""; for (let i = 0; i < n; i++) { s += i; f(); s += ","; } return s; } }   no cursor is carried past a call that may collect: behind the call it is read out of the record again
# each function is handed to code that nobody has seen
