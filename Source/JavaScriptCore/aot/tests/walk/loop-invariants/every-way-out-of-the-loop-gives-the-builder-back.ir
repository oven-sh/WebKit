# on each edge out of the loop of a growing text the builder goes back to the pool: the text is finished where it is read behind the edge, and let go where it is not
# function read(n, part) { .. let s = ""; for (let i = 0; i < n; i++) s += part; return s; }
# function dead(n, part) { .. let s = "", i = 0; for (; i < n; i++) s += part; return i; }   the one property that is changed: nobody reads the text behind the loop
# function left(n, part) { .. let s = ""; for (let i = 0; i < n; i++) { s += part; if (i === 7) break; } return s; }   two edges, each hands the text on as an argument
# function rows(n, part) { .. outer: for (let i = 0; i < n; i++) { let s = ""; for (let j = 0; j < n; j++) { s += part; if (j === 7) continue outer; } sink(s); } }   an edge that comes round the loop around leaves the loop of the text
