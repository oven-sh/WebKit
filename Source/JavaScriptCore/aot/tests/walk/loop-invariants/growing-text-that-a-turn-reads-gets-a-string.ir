# whoever takes a growing text in its loop and is no growth gets a string that is made of what the builder holds, and the builder goes on. The reads of one state in one block share one string
# function told(n, part) { .. let s = ""; for (let i = 0; i < n; i++) { s += part; if (kept) sink(s); } return s; }
# function twice(n, part) { .. for (..) { s += part; if (kept) { sink(s); sink(s); } } .. }
# function handed(n, part) { .. for (..) { s += part; if (kept) keep(s); } .. }   a direct call looks at the kind of no argument: only the string in the place of the name keeps the builder from the callee
# function joined(n, part) { .. for (..) { s += part; sink(s + ": " + part); } .. }   a join with the text in front whose result is never the variable again reads the text
# function older(n, part) { .. for (..) { const before = s; s += part; sink(before); } .. }   the one property that is changed: the state that is read is not the newest, so two states are live and nothing is begun
# function always(n, part) { .. for (..) { s += part; sink(s); } .. }   every iteration passes the text: a builder would copy it every time, so it stays a rope
# function either(n, part) { .. for (..) { s += part; if (kept) sink(s); else keep(s); } .. }   every iteration passes the text, on one arm or the other: a rope too
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK: StringBuilderBegin
# CHECK: isLoopHead=true
# CHECK: StringBuilderAppendString
# CHECK: StringBuilderFinish
# CHECK: [[string]]: {{*}}StringBuilderToString
# CHECK: [[boxed]]: {{*}}= Box [[string]]
# CHECK: = CallResolved {{*}}[[boxed]]
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: isLoopHead=true
# ALL: [[stringOfAll]]: {{*}}StringBuilderToString
# ALL: [[boxedOfAll]]: {{*}}= Box [[stringOfAll]]
# ALL: = CallResolved {{*}}[[boxedOfAll]]
# RUN(TWICE): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# TWICE-LABEL: code f2:Body
# TWICE-COUNT-1: StringBuilderToString
# TWICE-COUNT-2: = Call
# TWICE-NOT: StringBuilderToString
# RUN(HANDED): walk f3 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+DirectCalls
# HANDED-LABEL: code f3:Body
# HANDED: isLoopHead=true
# HANDED: [[handed]]: {{*}}StringBuilderToString
# HANDED: [[boxedHanded]]: {{*}}= Box [[handed]]
# HANDED: = CallDirect {{*}}[[boxedHanded]]
# RUN(JOINED): walk f6 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# JOINED-LABEL: code f6:Body
# JOINED: StringBuilderBegin
# JOINED: [[read]]: {{*}}StringBuilderToString
# JOINED: = Strcat [[read]]
# RUN(OLDER): walk f4 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# OLDER-LABEL: code f4:Body
# OLDER-NOT: StringBuilder
# RUN(OLDERALL): walk f4 mechanisms=all
# OLDERALL-LABEL: code f4:Body
# OLDERALL-NOT: StringBuilder
# RUN(ALWAYS): walk f7 mechanisms=all
