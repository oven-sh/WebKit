# a part of a growing text whose text is at hand is written as bytes, and the empty text is no part at all: neither in front of the loop nor in a turn
# function separated(n) { let s = ""; for (let i = 0; i < n; i++) s = s + ", " + "" + undefined + true; return s; }
# function named(n, name) { if (typeof name === "string") { let s = ""; for (let i = 0; i < n; i++) s += name; return s; } return name; }
# of the second only the type of the part is known: it goes through the stub that appends a string
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK: StringBuilderBegin
# CHECK: isLoopHead=true
# CHECK: StringBuilderAppendConstant {{*}}string=", "
# CHECK: StringBuilderAppendConstant {{*}}string="undefined"
# CHECK: StringBuilderAppendConstant {{*}}string="true"
# RUN(THREE): walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# THREE-LABEL: code f1:Body
# THREE-COUNT-3: StringBuilderAppend
# THREE-NOT: StringBuilderAppend
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: isLoopHead=true
# ALL: StringBuilderAppendConstant {{*}}string=", "
# RUN(NAMED): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# NAMED-LABEL: code f2:Body
# NAMED: isLoopHead=true
# NAMED: StringBuilderAppendString
# RUN(BYTES): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# BYTES-NOT: StringBuilderAppendConstant

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="separated" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string=""
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = String string=", "
    v8 = Add v3, v7
    v9 = String string=""
    v10 = Add v8, v9
    v11 = Undefined
    v12 = Add v10, v11
    v13 = Boolean boolean=true
    v14 = Add v12, v13
    v15 = Increment v4
    Jump -> next b1(v14, v15)
  b3():
    Return v3
}
function f2 name="named" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3):
    v4 = String string=""
    v5 = Integer
    Jump -> next b2(v4, v5)
  b2(v6, v7):
    LoopHint
    v9 = Less v7, v0
    Branch v9 -> taken b3(), notTaken b4()
  b3():
    v10 = Add v6, v3
    v11 = Increment v7
    Jump -> next b2(v10, v11)
  b4():
    Return v6
  b5():
    Return v1
}
