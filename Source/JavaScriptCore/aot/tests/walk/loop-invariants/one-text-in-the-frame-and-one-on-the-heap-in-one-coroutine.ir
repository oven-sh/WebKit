# async function g(h, n) { let a = h, b = ""; for (..) b += k; try { for (..) a += k; await null; a += b; } finally { L.push(a); } }
# `b` grows under no handler: its builder lies in the frame and is finished in front of the await. `a` is read by the `finally`: its builder is a cell of the heap and lives over the await. Both have one type. The verifier of code, which is asked under check=Validate, tells them apart by the operation that began them.
# RUN: walk f1:CoroutineBody mechanisms=all
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: = StackStringBuilderBegin
# CHECK: [[builder]]: {{*}} = StringBuilderBegin
# CHECK: [[await]]: {{*}} = AwaitBySavingFrame
# CHECK: # live at [[await]] [{{*}}[[builder]]
# layout L904 kind=Closure
