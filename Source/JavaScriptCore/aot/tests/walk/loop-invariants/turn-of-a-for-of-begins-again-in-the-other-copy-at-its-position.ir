# `for (const item of items) sum += item.weight`: the typed copy steps by index alone, so what catches a throw of the body has nothing to close and the body stands under no handler:
# a test of `item` that fails begins the turn again in the other copy, which takes the position of the iteration as it takes the parameters of the head, behind them.
# It used to be one copy, with closed arms that come back and the sum boxed: 43 instructions a turn, 21 since; by index 20.
# interface Item { weight: number; name: string }   function total(items: Item[]): number { let sum = 0; for (const item of items) sum += item.weight; return sum; }   kept = total; sink(total([{ weight: 2, name: "a" }, ..]));
# f1 = total
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# the entry of the other copy: the sum, and the position behind it. It is no rare code: one item of another shape sends all the turns that are left there
