# a part of which nothing is known may run code to give its text. It is converted where the join stands, with the hint of the join, and what the conversion gives is appended: the text lies in a builder all the same
# function joined(x) { let out = ""; for (let i = 0; i < 16; i++) out += x; return out; }   the sum converts as `"" + x` does
# function both(a, b) { let out = ""; for (let i = 0; i < 16; i++) out = `${out}${a}${b}`; return out; }   both conversions stand in front of the first append
# each function is handed to code that nobody has seen
