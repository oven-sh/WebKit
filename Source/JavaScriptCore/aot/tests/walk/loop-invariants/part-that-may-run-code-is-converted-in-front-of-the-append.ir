# ORDER-NOT: StringBuilderAppend
# ORDER: = ToString
# ORDER: StringBuilderAppendString
# ORDER: StringBuilderAppendString
# RUN(NEVER): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# NEVER-NOT: = Strcat
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: StringBuilderBegin

