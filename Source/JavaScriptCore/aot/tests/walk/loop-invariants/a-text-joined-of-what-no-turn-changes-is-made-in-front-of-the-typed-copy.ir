# function find(wanted, name, tail, turns) { .. for (let turn = 0; turn < turns; turn = turn + 1) { if (wanted === name + "-" + tail) found = found + turn; } .. }
# A text joined in every turn out of what no turn changes is made once, in front of the typed copy. A join fails where its parts are too long for one text, and the first turn may throw, answer or leave ahead of it,
# so the join in front is one that cannot fail: it stands behind the question whether the lengths of its parts, or-ed, lie below a power of two that leaves room for all of them. The no leads to the closed copy,
# where the join fails in its own place. The head's own question, asked for the values that enter, stands in front of that: a loop of no turn joins nothing.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[begins]]: boolean @Boolean = Less {{*}}form=Numbers # uses=1
# CHECK-NEXT: Branch [[begins]] -> taken [[front]](), notTaken
# CHECK: isInLoop=true isLoopHead=true
# CHECK-NOT: = Strcat
# CHECK: [[front]]():
# CHECK: = GetStringLength
# CHECK: = GetStringLength
# CHECK: [[lengths]]: {{*}} = BitOr
# CHECK: [[short]]: boolean @Boolean = Less [[lengths]],
# CHECK-NEXT: Branch [[short]] -> taken [[joined]](), notTaken
# CHECK: [[joined]]():
# CHECK-NEXT: = Strcat
# function either(wanted, name, value, turns) { .. if (wanted === name + "-" + value) .. }, value a number or a text: to expect a text of it would send every turn of a run that holds numbers to the closed copy: the join stays in the turn and nothing is asked in front
# RUN(EITHER): walk f2:Body mechanisms=all
# EITHER-LABEL: code f2:Body
# EITHER-NOT: form=Numbers # uses=1
# Under the testing word the join is made again in the turn and held against the one in front
# RUN(NET): walk f1:Body mechanisms=all testing=CheckProofsAtRunTime,CheckHoistedCallsAtRunTime
# NET-LABEL: code f1:Body
# NET: source=HoistedCall
# layout L916 kind=Closure
