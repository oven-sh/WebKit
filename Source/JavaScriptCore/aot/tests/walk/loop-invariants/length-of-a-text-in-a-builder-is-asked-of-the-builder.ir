# the length, the truth and the emptiness of a text that lies in a builder are asked of the builder: no string is made in the loop, and the length is read in the loop, behind the head
# function rows(n) { let s = ""; for (let i = 0; i < n; i++) { if (s.length > 8) s += ","; s += i; } return s; }
# function joined(n) { let s = ""; for (let i = 0; i < n; i++) { if (s) s += ","; s += i; } return s; }
# function spaced(n) { let s = ""; for (let i = 0; i < n; i++) { if (s !== "") s += ","; s += i; } return s; }
# function marked(n) { let s = ""; for (let i = 0; i < n; i++) { if (s === "0") s += ","; s += i; } return s; }   the length is asked before the equality with another text: only a builder of that length makes its string
# each function is handed to code that nobody has seen, so nothing is known of n
