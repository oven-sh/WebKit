# function swap(list: number[]) { for (let i = 0, j = 5; i < j; i++, j--) { const x = list[i]; list[i] = list[j]; list[j] = x; } }
# function scale(list: number[], by: number) { for (let i = 0, j = 5; i < j; i++, j--) { const x = list[i], y = list[j]; list[i] = x * by; list[j] = y * by; } }
# A hole of double storage is a NaN, and no NaN is ever stored there: what is read present out of it is none. So a store takes it as it is, without a question. A product may be a NaN: each store of such a turn asks; where the second finds one, what the first overwrote is put back and the turn begins again.
