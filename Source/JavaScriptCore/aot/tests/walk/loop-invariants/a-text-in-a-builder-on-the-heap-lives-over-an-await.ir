# async function g(h, s, n) { let t = s; try { t = h + s; for (let k = 0; k < n; k++) t += k; await null; t = t + "-"; await null; } finally { L.push(String(t)); } }
# The `finally` reads the text, so its builder is a cell of the heap, not room in the frame, and the ways into the handler keep it alive over the await. A cell may live over a suspension: it is a root of the saved frame. Only a builder that lies in the frame may not.
