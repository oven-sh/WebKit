# the same functions with handlers withheld: a text whose loop has a block under a handler goes round as a string
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: role=CatchHandler
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# NEVER-NOT: StringBuilder
# RUN(INSIDE): walk f3 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# INSIDE-NOT: StringBuilder
# RUN(NONE): walk f2 mechanisms=none
# NONE-NOT: StringBuilder
# PROGRAM-OF: text-in-a-builder-under-a-handler.ir
