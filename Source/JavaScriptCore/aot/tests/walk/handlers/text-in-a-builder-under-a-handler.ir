# a text that grows under a handler lies in a builder. What the handler gets is the text at the head of the block that threw
# function caught() { let s = ""; try { for (let i = 0; i < 16; i++) s += "k" + i + ","; } catch { return s; } return s; }
#   the handler block lies behind the loop and is handed the text: a block of the walk's own catches, makes the string of what the builder holds, and throws on. An append of several parts is rolled back where it fails
# function inner(n, f) { try { let s = ""; for (let i = 0; i < n; i++) s += f(i) + ","; return s; } catch { return ""; } }
#   the handler is handed nothing of the text: nothing is caught on the way, nothing is rolled back
# function kept(n, f) { let s = ""; let bad = 0; for (let i = 0; i < n; i++) { try { s += f(i); } catch { bad++; } } return s + bad; }
#   the handler block lies in the loop: it goes on with the builder, and no string is made
# function late(f) { let s = ""; try { for (let i = 0; i < 16; i++) { s += i; f(); } } catch { return s; } return s; }
#   written so that the call stands behind the append in one block whose handler edge names the text at its head: the builder would hold more than that, so there is none
# function left(n, f) { let s = ""; for (let i = 0; i < n; i++) { try { s += f(i); } catch { return s; } } return s; }
#   written so that the handler block, which lies behind the loop, reads the parameter of the head without being handed it: no edge brings it a string, so there is no builder
# function headed(n, f) { let s = ""; let i = 0; for (;;) { try { if (i >= n) break; s += f(i++); } catch { i++; } } return s; }
#   written so that the head of the loop stands under the handler, which lies in the loop: what is built in front of the loop would throw into the loop, so there is no builder
# each function is handed to code that nobody has seen
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# CHECK-LABEL: code f1:Body
# CHECK: = StringBuilderBegin
# CHECK: = StringBuilderCheckpoint
# CHECK: StringBuilderRollBack
