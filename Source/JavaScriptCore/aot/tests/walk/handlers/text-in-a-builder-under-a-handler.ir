# a text that grows under a handler lies in a builder where the handler lets it go: it lies behind the loop, is handed nothing of the text and reads nothing of it
# function caught() { let s = ""; try { for (let i = 0; i < 16; i++) s += "k" + i + ","; } catch { return s; } return s; }
#   the handler block lies behind the loop and is handed the text: there is no builder
# function inner(n, f) { try { let s = ""; for (let i = 0; i < n; i++) s += f(i) + ","; return s; } catch { return ""; } }
#   the handler is handed nothing of the text: nothing is caught on the way, nothing is rolled back
# function kept(n, f) { let s = ""; let bad = 0; for (let i = 0; i < n; i++) { try { s += f(i); } catch { bad++; } } return s + bad; }
#   the handler block lies in the loop: there is no builder
# function left(n, f) { let s = ""; for (let i = 0; i < n; i++) { try { s += f(i); } catch { return s; } } return s; }
#   written so that the handler block, which lies behind the loop, reads the parameter of the head without being handed it: there is no builder
# each function is handed to code that nobody has seen
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# CHECK-LABEL: code f1:Body
# CHECK-NOT: StringBuilder
# RUN(DEAD): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# DEAD-LABEL: code f2:Body
# DEAD: = StackStringBuilderBegin
# DEAD: = StackStringBuilderFinish
# RUN(DEADONLY): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# DEADONLY-NOT: CatchException
# DEADONLY-NOT: StringBuilderCheckpoint
# DEADONLY-NOT: StringBuilderToString
# RUN(INSIDE): walk f3 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# INSIDE-LABEL: code f3:Body
# INSIDE-NOT: StringBuilder
# RUN(LEFT): walk f4 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants+Handlers
# LEFT-NOT: StringBuilder
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL-NOT: StringBuilder

