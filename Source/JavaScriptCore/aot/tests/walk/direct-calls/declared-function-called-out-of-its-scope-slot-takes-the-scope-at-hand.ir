# -- source: declared-function-called-out-of-its-scope-slot-takes-the-scope-at-hand.js
# function outer(limit) { let n = 0; function a(x) { n++; return x < limit ? x + n : b(x); } function b(x) { for (let i = 0; i < 2; i++) n += i; return a(x >> 1); } return a; }
# print(outer(10)(100), outer(3)(100));
# -- end of source
# Functions that are declared in one scope call each other out of its slots. The slot is laid down as the closures of the one function, which was made over the scope that holds it:
# so whoever reads it there to call it has the scope at hand, and reads neither the slot nor the capture. What a closure has captured besides (`limit`, by value) is read off it as ever.
