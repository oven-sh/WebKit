# function later(v) { return new Promise(resolve => { resolve(v); }); }
# function handsOn(executor) { return new Promise(executor); }
# function forOther(v, Other) { return Reflect.construct(Promise, [..], Other); }   as the front end writes a construction with a new.target of its own
# sink(later, handsOn, forOther);
# The constructor of Promise is a function of the library that makes its own object (a naked constructor). Where the callee of a construction is proven to be that one built-in, and the executor is a closure of one function,
# the constructor's text is copied, in and outside of loops: the executor goes into the copy, the two resolving functions are never made, and what is left is the allocation and one store of the value.
# Link says that the construction names the constructor: without that word the copy would name the constructor's two arrows in a unit that does not lead to them, and it is refused.
# The library here is a stand-in with the engine's own text.
# LIBRARY: own
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: frame {{*}}callee=f5
# CHECK: frame {{*}}callee=f4
# CHECK: = NewPromise
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: = Construct
# NEVER-NOT: = NewClosure
# NEVER-NOT: = CreatePromise
# with copies withheld the construction stays as it is written, and says that it makes a Promise
# RUN(WITHHELD): walk f1 mechanisms=all-Inlining
# WITHHELD: Promise {{*}}= Construct
# an executor of which nothing is known: as written
# RUN(UNKNOWN): walk f2 mechanisms=all
# UNKNOWN-LABEL: code f2:Body
# UNKNOWN: Promise {{*}}= Construct
# RUN(UNCOPIED): walk f2 mechanisms=all
# UNCOPIED-NOT: callee=f5
# another new.target: as written
# RUN(OTHER): walk f3 mechanisms=all
# OTHER-LABEL: code f3:Body
# OTHER: = Construct
# RUN(TARGET): walk f3 mechanisms=all
# TARGET-NOT: callee=f5

