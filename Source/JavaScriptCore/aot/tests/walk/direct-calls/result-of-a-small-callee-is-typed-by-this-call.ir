# the callee returns its first parameter. Link unites what every call hands it. At one call the result is what that call hands over
# a callee that returns what another call gives is not followed: Link's union stands
# no object leaves: whoever has an object finds its class under `constructor`, and then nothing is proven of what `new` gives
# f1 = pick, f2 = same, f3 = through, f4 = useA, f5 = useB, f6 = viaA, f7 = viaB
# -- source: result-of-a-small-callee-is-typed-by-this-call.ts
# declare function sink(...values: unknown[]): void;
# class A { a = 1; }
# class B { b = "x"; }
# function pick(first: A | B, second: A | B) { return first; }
# function same(value: A | B) { return value; }
# function through(value: A | B) { return same(value); }
# function useA() { return pick(new A(), new B()) === null; }
# function useB() { return pick(new B(), new A()) === null; }
# function viaA() { return through(new A()) === null; }
# function viaB() { return through(new B()) === null; }
# sink(useA, useB, viaA, viaB);
# -- end of source
