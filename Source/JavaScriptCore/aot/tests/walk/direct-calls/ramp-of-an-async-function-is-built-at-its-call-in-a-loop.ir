# in a loop of the unit's own body the ramp of a known async function is built where the call stands: the promise is made here, and the body is started with it
# async function load(x) { await x; return x; }  function startAll(list, n) { for (let i = 0; i < n; i++) list[i] = load(i); }  sink(startAll);
# RUN: walk f2 mechanisms=none+DirectCalls
# CHECK: mechanisms DirectCalls
# CHECK-LABEL: code f2:Body
# CHECK: = NewPromise
# CHECK: = CallDirect {{*}}role=CoroutineBody
# RUN(ALL): walk f2 mechanisms=all
# ALL-LABEL: code f2:Body
# ALL: = CallDirect {{*}}role=CoroutineBody

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="load" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v0
}
function f2 name="startAll" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = NewClosure function=f1
    v7 = Call v6, -, v3 calleeName="load"
    ElemSet v0, v3, v7
    v9 = Increment v3
    Jump -> next b1(v9)
  b3():
    v10 = Undefined
    Return v10
}
