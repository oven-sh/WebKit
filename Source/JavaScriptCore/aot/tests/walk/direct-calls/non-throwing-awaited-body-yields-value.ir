# nothing in the callee suspends or throws: outside of loops too, its body stands where the call stands, and what it returns is awaited
# async function nothing(x) { }  async function thrower(x) { throw x; }  async function run(x) { await nothing(x); await thrower(x); }  sink(run);
# RUN: walk f3:CoroutineBody mechanisms=all
# CHECK-LABEL: code f3:CoroutineBody
# CHECK: : undefined @JSValue = AwaitBySavingFrame
# RUN(NEVER): walk f3:CoroutineBody mechanisms=all
# NEVER-NOT: AwaitCallBySavingFrame {{*}}function=f1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f3
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="nothing" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Return v1
}
function f2 name="thrower" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Throw v0
}
function f3 name="run" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0 calleeName="nothing"
    v3 = Await v2
    v4 = NewClosure function=f2
    v5 = Call v4, -, v0 calleeName="thrower"
    v6 = Await v5
    v7 = Undefined
    Return v7
}
