# an async function that awaits nothing returns a promise: the awaiting caller makes no promise of its own. It takes the value of a settled promise where no job could run in between, and else resolves a promise as written
# async function read(x) { return x.member; }  async function run(x) { return await read(x); }  sink(run);
# async function each(x, n) { for (let i = 0; i < n; i++) x = await read(x); return x; }
# RUN: walk f3:CoroutineBody mechanisms=all-Inlining
# CHECK-LABEL: code f3:CoroutineBody
# CHECK: [[returned]]: {{*}} = CallDirect {{*}}role=CoroutineBody
# CHECK: = IsNotThenable [[returned]]
# CHECK: = AwaitBySavingFrame [[returned]], {{*}}[awaitsResolution]
# RUN(NEVER): walk f3:CoroutineBody mechanisms=all-Inlining
# NEVER-NOT: ResolvePromise
# The promise that rejects is made as before.
# RUN(REJECTS): walk f3:CoroutineBody mechanisms=all-Inlining
# REJECTS: = RejectPromise
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = NewClosure function=f3
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="read" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="member"
    Return v1
}
function f2 name="run" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0 calleeName="read"
    v3 = Await v2
    Return v3
}
function f3 name="each" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    Jump -> next b1(v0, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = NewClosure function=f1
    v8 = Call v7, -, v3 calleeName="read"
    v9 = Await v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
