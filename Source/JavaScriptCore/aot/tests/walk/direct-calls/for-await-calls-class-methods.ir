# `for await` over an object of a class whose methods are in sight: `next` is called itself, it makes no promise, and the objects of the class and of its answers stay in sight of Link
# class Pages { at = 0;  [Symbol.asyncIterator]() { return this; }  async next() { await null; return { done: this.at++ > 3, value: this.at }; } }
# async function sum() { let s = 0; for await (const p of new Pages()) s = p; return s; }  sink(sum);
# RUN: walk f4:CoroutineBody mechanisms=-Inlining
# CHECK-LABEL: code f4:CoroutineBody
# CHECK: = CallDirect {{*}}function=f2
# CHECK: = AwaitCallBySavingFrame {{*}}function=f3
# RUN(NEVER): walk f4:CoroutineBody mechanisms=-Inlining
# NEVER-NOT: = Call v
# NEVER-NOT: = StepAsyncGenerator
# RUN(LINK): link layouts mechanisms=all
# LINK: layout L0 {{*}}changes=[]
# LINK: layout L1 {{*}}changes=[]
# RUN(WITHHELD): walk f4:CoroutineBody mechanisms=-DirectCalls
# WITHHELD: = Call v

layout L0 kind=Instance name="Pages" module=m0 constructor=f1 fields=[{key="at" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 fields=[{key="done" declared={type=boolean} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="Pages" module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f2
    DefineMethod v1, v3 layout=L0 key=@@asyncIterator
    v5 = NewClosure function=f3
    DefineMethod v1, v5 layout=L0 index=1 key="next"
    v7 = FinishClass v1 layout=L0
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = NewClosure function=f4
    v11 = Call v9, -, v10
    Return v11
}
function f1 name="Pages" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = Integer
    v3 = NewObject v1, v2 layout=L0 fields=[0]
    Return v3
}
function f2 name="[Symbol.asyncIterator]" module=m0 kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: L0):
    Return v0
}
function f3 name="next" module=m0 kind=Method flags=[IsAsync, HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: L0):
    v1 = Null
    v2 = Await v1, v0
    v3 = PropGet v0 key="at"
    v4 = Integer integer=3
    v5 = Greater v3, v4
    v6 = Increment v3
    PropSet v0, v6 key="at"
    v8 = NewObject -, v5, v6 layout=L1 fields=[0, 1]
    v9 = FinishObject v8
    Return v9
}
function f4 name="sum" module=m0 flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="Pages"
    v3 = Construct v2
    v4 = IteratorOpen v3 iteratorKind=Async
    Jump -> next b1(v0)
  b1(v5):
    LoopHint
    v7 = IteratorResume v4 iteratorKind=Async
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    Return v5
  b3():
    Jump -> next b1(v9)
}
