# -- source: method-behind-a-way-out-by-a-call-is-not-called-unasked.js
# function Gauge(v) { this.v = v; }
# function Meter(v) { this.v = v; }
# function note() { return 0; }
# (function () { if (sink(1)) return note(); Gauge.prototype.next = function () { return this.v + 1; }; })();
# (function () { Meter.prototype.next = function () { return this.v + 2; }; return note(); })();
# function readGauge(count) { var t = 0; for (var i = 0; i < count; i++) t += new Gauge(i).next(); return t; }
# function readMeter(count) { var t = 0; for (var i = 0; i < count; i++) t += new Meter(i).next(); return t; }
# sink(readGauge(10) + readMeter(10));
# -- end of source
# `return note();` leaves the body in front of Gauge's store: the name may never be laid, so the call asks whether the members are as the build knows them, and reads the name where they are not.
# SINCE 11-04 (R257) THE CLOCK OF START SAYS OF NO NAME THAT IT IS LAID AHEAD: through a hole in it the read of such a name gave undefined where the type said a function, and the process died; the claim fired on no program that we are judged by. What this test told apart by `laid-ahead` it no longer tells.
# RUN: walk f4 mechanisms=all
# CHECK: AreMembersUnchanged conditions=[{layout=L0 key="next"}]
# CHECK: PropGet {{*}}key="next"
# Meter's store stands in front of the one way out, which ends in a call too: laid ahead of every object: no guard, no read.

