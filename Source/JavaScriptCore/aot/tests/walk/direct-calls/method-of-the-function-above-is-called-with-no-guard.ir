# function Base(a) { this.a = a; }
# Base.prototype.first = function () { return this.a; };
# function Below(a, b) { Base.call(this, a); this.b = b; }
# Below.prototype = Object.create(Base.prototype);
# Below.prototype.constructor = Below;
# Below.prototype.second = function () { return this.b + this.first(); };
# function run(count) { let total = 0; for (let i = 0; i < count; i++) { const item = new Below(i & 1023, 2); total += item.second() + item.a; } return total; }
# sink(run(10));
# -- end of source
# `this.first()` on an object of Below finds what is laid on the prototype object of Base: the row is linked, and both names are laid, ahead of every object. No guard of a name, so no arm that boxes the object: it is never made.
