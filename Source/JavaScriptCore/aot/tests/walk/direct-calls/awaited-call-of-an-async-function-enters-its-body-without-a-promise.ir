# the call of one known async function looks ahead to the await that alone takes what it gives: one operation enters the body without a promise and waits for it
# async function load(x) { await x; return x; }  async function run(x) { return await load(x); }  sink(run);
# run is handed to sink, so nothing is known of x. load awaits, so its body may suspend
# RUN: walk f2:CoroutineBody mechanisms=none+DirectCalls
# CHECK: mechanisms DirectCalls
# CHECK-LABEL: code f2:CoroutineBody
# CHECK: = AwaitCallBySavingFrame
# RUN(NEVER): walk f2:CoroutineBody mechanisms=none+DirectCalls
# NEVER-NOT: = AwaitBySavingFrame
# NEVER-NOT: = CallDirect
# RUN(ALL): walk f2:CoroutineBody mechanisms=all
# ALL-LABEL: code f2:CoroutineBody
# ALL: = AwaitCallBySavingFrame

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="load" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v0
}
function f2 name="run" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0 calleeName="load"
    v3 = Await v2
    Return v3
}
