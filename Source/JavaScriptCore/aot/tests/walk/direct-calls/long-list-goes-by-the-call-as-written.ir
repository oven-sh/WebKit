function f3 name="returned" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2 calleeName="count"
    ReturnCall v4
}
