# HOW A FUNCTION IS COMPILED MAY NOT HANG ON THE REST OF THE PROGRAM. `counter.add(value)` in a loop, `this.add = this.addImpl.bind(this)` in Counter's constructor: the call asks the cell and enters addImpl.
# What is expected of the callee was the union of what EVERY layout of the program holds under the name `add`: one class anywhere that holds a plain closure under that name took the form away (163 > 301 M).
# Now the field of the receiver's own layouts is asked: what is proven of the receiver, else what is expected of it.
# declare function print(...values: unknown[]): void;
# class Counter {
#   total = 0;
#   add: (value: number) => number;
#   constructor() { this.add = this.addImpl.bind(this); }
#   addImpl(value: number): number { this.total += value; return this.total; }
# }
# class Other {
#   add: (value: number) => number;
#   constructor() { this.add = value => value + 1; }
# }
# function drive(counter: Counter, turns: number): number {
#   let last = 0;
#   for (let turn = 0; turn < turns; turn++) last += counter.add(turn & 7);
#   return last;
# }
# print(drive(new Counter(), 10), new Other().add(1));
