# nothing in the callee suspends, so its body returns and throws like a plain function. In a loop the body is called where the call stands, and what it returns is awaited: no promise is made for a value without then
# async function same(x) { return x; }  async function run(x, n) { for (let i = 0; i < n; i++) x = await same(x); return x; }  sink(run);
# RUN: walk f2:CoroutineBody mechanisms=all-Inlining
# CHECK-LABEL: code f2:CoroutineBody
# CHECK: [[returned]]: {{*}} = CallDirect {{*}}role=CoroutineBody
# CHECK: = IsNotThenable [[returned]]
# RUN(AWAITS): walk f2:CoroutineBody mechanisms=all-Inlining
# AWAITS-LABEL: code f2:CoroutineBody
# AWAITS: = AwaitBySavingFrame
# RUN(NEVER): walk f2:CoroutineBody mechanisms=all-Inlining
# NEVER-NOT: = AwaitCallBySavingFrame
# RUN(WITHHELD): walk f2:CoroutineBody mechanisms=none
# WITHHELD-NOT: role=CoroutineBody

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="same" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="run" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    Jump -> next b1(v0, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = NewClosure function=f1
    v8 = Call v7, -, v3 calleeName="same"
    v9 = Await v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
