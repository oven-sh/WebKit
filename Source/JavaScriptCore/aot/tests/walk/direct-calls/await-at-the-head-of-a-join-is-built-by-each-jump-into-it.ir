# the await stands at the head of a join and takes the parameter of the join alone. IT STAYS THERE (the name of the file says what was): a block may be passed by, and its jump is then led on by a door that builds no await
# function cached(k) { return k; }  async function load(k) { await k; return k; }  async function run(hit, k) { return await (hit === undefined ? cached(k) : load(k)); }  sink(run);
