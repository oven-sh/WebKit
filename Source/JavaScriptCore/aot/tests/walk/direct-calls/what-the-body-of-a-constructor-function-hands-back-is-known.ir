# -- source: what-the-body-of-a-constructor-function-hands-back-is-known.js
# function Pair(a, b) { if (!(this instanceof Pair)) return new Pair(a, b); this.a = a; this.b = b; }
# Pair.prototype.sum = function () { return this.a + this.b; };
# function run(count) { let total = 0; for (let i = 0; i < count; i++) { const p = i & 1 ? Pair(i & 7, 1) : new Pair(i & 3, 2); total += p.sum(); } return total; }
# sink(run(10));
# -- end of source
# `new Pair(a, b)` inside the copy of `Pair(a, b)`: the walk makes the object and enters the body directly. The body hands back what it returns, for whoever has made `this` to look at: undefined or a Pair, by Link's proof.
# If the rule of the direct call said "anything" of it, as of a construction through an entry, `p` would be anything behind the join, and `p.sum()` a guess with a closed arm.
# f2 = run
# The clock of start says of no name that it is laid ahead: through a hole in it the read of such a name gave undefined where the type said a function, and the process died; the claim fired on no real program. What this test told apart by `laid-ahead` it no longer tells.
