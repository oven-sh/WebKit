# const p = [a]; return c ? p : a;
# Nothing but the edge out of b1 names v3: the end of b1 needs the cell, and the way from b0 to b2 allocates nothing.
# RUN: sweep-code mechanisms=all
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: v3: Array @Cell = NewArray v0
# CHECK-NEXT: = Box v3
# CHECK-NOT: NewArray

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b1(), notTaken b2(v0)
#   b1():
#     v4: Array @JSValue = Box v3
#     Jump -> next b2(v4)
#   b2(v5: anything @JSValue):
#     Return v5
# }
# -- end of code
