# const inner = [a]; const outer = [inner]; if (c) keep(outer); return a;
# v4 lists v3 and is all that names it. What a birth lists is needed where that birth comes to stand: v4 goes to the call, v3 goes with it, and they keep their order.
# RUN: sweep-code mechanisms=all
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: v3: Array @Cell = NewArray v0
# CHECK-NEXT: v4: Array @Cell = NewArray v3
# CHECK-NEXT: = Call v1, -, v4
# CHECK-NOT: NewArray

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     v4: Array @Cell = NewArray v3 contents=anything traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     v5: anything @JSValue = Call v1, -, v4 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b2()
#   b2():
#     Return v0
# }
# -- end of code
