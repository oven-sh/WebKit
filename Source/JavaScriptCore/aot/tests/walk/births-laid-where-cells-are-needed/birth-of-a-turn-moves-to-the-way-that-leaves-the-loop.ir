# for (;;) { const p = [a]; if (c) return p; more(); }
# A loop that looks for something makes a candidate a turn and hands out the last. b2 never comes back to the head, so it is no part of the loop, and no loop stands around it that the birth stands outside of: the one turn that leaves makes the one list.
# RUN: sweep-code mechanisms=all
# CHECK: b1() isInLoop=true isLoopHead=true:
# CHECK-NEXT: Branch v2
# CHECK-NEXT: b2():
# CHECK-NEXT: v3: Array @Cell = NewArray v0
# CHECK-NEXT: Return v3
# CHECK-NOT: NewArray

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     Jump -> next b1()
#   b1() isInLoop=true isLoopHead=true:
#     v3: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b2(), notTaken b3()
#   b2():
#     Return v3
#   b3() isInLoop=true:
#     v4: anything @JSValue = Call v1, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b1()
# }
# -- end of code
