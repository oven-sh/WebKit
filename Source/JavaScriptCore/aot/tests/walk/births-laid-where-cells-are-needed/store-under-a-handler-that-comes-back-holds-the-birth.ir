# const s = [a]; try { f(); s[0] = b; f(); } catch { } if (c) keep(s); return a;
# By blocks b1 stands above b4 on both ways. The store in the middle of b1 does not: where the first call throws it has not run. Nothing leaves a block under a handler, so the birth stays.
# RUN: sweep-code
# CHECK: b0(
# CHECK-NEXT: v3: Array @Cell = NewArray v0
# CHECK-NEXT: Jump
# CHECK: v4: anything @JSValue = Call v1
# CHECK-NEXT: v5 @Void = SetMappedArgument v3, v1
# CHECK-NOT: NewArray

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     Jump -> next b1()
#   b1() handler=b2():
#     v4: anything @JSValue = Call v1, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v5 @Void = SetMappedArgument v3, v1 index=0 traits=[mayWriteObservableState, mayTouchMemory]
#     v6: anything @JSValue = Call v1, - traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b3()
#   b2() role=CatchHandler:
#     Jump -> next b3()
#   b3():
#     Branch v2 -> taken b4(), notTaken b5()
#   b4():
#     v7: anything @JSValue = Call v1, -, v3 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b5()
#   b5():
#     Return v0
# }
# -- end of code
