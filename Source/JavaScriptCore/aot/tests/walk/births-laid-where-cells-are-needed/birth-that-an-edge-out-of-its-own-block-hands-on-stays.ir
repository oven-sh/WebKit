# const p = [a]; let q = p; if (c) keep(a); return q;
# The edges out of b0 hand the cell on: its own block needs it.
# RUN: sweep-code
# CHECK: b0(
# CHECK-NEXT: v3: Array @Cell = NewArray v0
# CHECK-NOT: NewArray

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b1(v3), notTaken b2(v3)
#   b1(v4: Array @Cell):
#     v5: anything @JSValue = Call v1, -, v0 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b2(v4)
#   b2(v6: Array @Cell):
#     v7: Array @JSValue = Box v6
#     Return v7
# }
# -- end of code
