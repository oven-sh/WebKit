# function report(value, tell, c) { const describe = () => value; if (c) tell(describe); return value; }
# A closure is lent only to a call of its own block. Laid beside the one call that takes it, it is the first argument of a call by value: the second sweep finds the loan, and it lies in the frame.
# This one is hoped for, not sure: the move is shown by closure-moves-into-the-arm-that-hands-it-out.ir; whether the loan is found then is for findLoanOfSweptClosure() to say.
# RUN: sweep-code mechanisms=all
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: v3: f2 @Cell = NewClosure v0 function=f2 {{*}}storage=Frame
# CHECK: # cells of the frame: verified
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: f2 @Cell = NewClosure v0 function=f2 closureForm=Slim traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     v4: anything @JSValue = Call v1, -, v3 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b2()
#   b2():
#     Return v0
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0 calleeName="publish"
    Return v3
}
function f1 name="report" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = NewClosure v0 function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v4 = Call v1, -, v3
    Jump -> next b2()
  b2():
    Return v0
}
function f2 name="describe" module=m0 kind=Arrow captures=[{type=anything variableName="value"}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
