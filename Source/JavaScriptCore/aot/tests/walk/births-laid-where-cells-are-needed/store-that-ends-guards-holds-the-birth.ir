# const o = { a }; o.late = b; if (c) keep(o); return a;
# Nobody knows in which order the keys of v3 lie when v4 adds its name, so the store ends the guards under that name: it is ordered with whoever tests them and is a need like any other. The birth stays.
# RUN: sweep-code
# CHECK: b0(
# CHECK-NEXT: v3: L0 @Cell = NewObject -, v0
# CHECK-NEXT: v4 @Void = PutSlotOrAdd v3, v1
# CHECK-NEXT: Branch v2
# CHECK-NOT: NewObject

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="late" declared={type=anything}}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="f" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Return v0
}

# -- code
# code f0:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: L0 @Cell = NewObject -, v0 layout=L0 fields=[0] traits=[mayCollect, mayTouchMemory]
#     v4 @Void = PutSlotOrAdd v3, v1 key="late" receivers=[L0] level=Proven traits=[mayWriteObservableState, mayTouchMemory]
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     v5: L0 @JSValue = Box v3
#     v6: anything @JSValue = Call v1, -, v5 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b2()
#   b2():
#     Return v0
# }
# -- end of code
