# function report(value, tell, c) { const describe = () => value; if (c) tell(describe); return value; }
# The call in b1 is all that needs the cell of the closure. It is one record, so whoever is handed it is handed one function, however often it is named.
# RUN: sweep-code mechanisms=all-CellsInFrames
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: v3: f2 @Cell = NewClosure v0 function=f2
# CHECK-NEXT: = Call v1, -, v3, v3
# CHECK-NOT: NewClosure
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue, v2: boolean @Boolean) entry=0:
#     v3: f2 @Cell = NewClosure v0 function=f2 closureForm=Slim traits=[mayCollect, mayTouchMemory]
#     Branch v2 -> taken b1(), notTaken b2()
#   b1():
#     v4: anything @JSValue = Call v1, -, v3, v3 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Jump -> next b2()
#   b2():
#     Return v0
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0 calleeName="publish"
    Return v3
}
function f1 name="report" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = NewClosure v0 function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v4 = Call v1, -, v3, v3
    Jump -> next b2()
  b2():
    Return v0
}
function f2 name="describe" module=m0 kind=Arrow captures=[{type=anything variableName="value"}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
