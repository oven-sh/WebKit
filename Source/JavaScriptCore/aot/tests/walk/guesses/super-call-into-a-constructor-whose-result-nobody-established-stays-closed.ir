# Whoever takes the result of `super(..)` goes by the rule that a construction hands back an object: the fields of the class are defined on it.
# The call that stands for it is typed by what is known of the constructor's result, which the compiler establishes for every class that it lowers. This text does not: the result of Above is written as anything.
# With the body of Above in one arm of the guess at the parent, called or copied, the arms met in `anything`, and the walk stopped at the definition: "PropDefine, operand 0: OperandTypeMismatch".
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: : object{{*}} = SuperConstruct
# CHECK: = PropDefine {{*}}key="level"
# RUN(GUESS): walk f3 mechanisms=all
# GUESS-NOT: TypeTest {{*}}testedType=f1

layout L0 kind=Instance name="Above" module=m0 constructor=f1
layout L1 kind=Instance name="Meter" module=m0 base=L0 constructor=f2 fields=[{key="level" declared={type=anything}}] supertypes=[L0] flags=[HasHeritage] ownFieldCount=1
variable g0 name="Meter" module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    PutModuleVariable v6 variable=g0
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = NewClosure function=f3
    v11 = Call v9, -, v2, v6, v10
    Return v11
}
function f1 name="Above" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="make" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
function f2 name="Meter" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=anything}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=1
    PropDefine v3, v4 key="level"
    Return v3
}
function f3 name="many" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2: anything):
    LoopHint
    v4 = Call v0
    v5 = ToBoolean v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = GetModuleVariable variable=g0
    v7 = Construct v6
    Jump -> next b1(v7)
  b3():
    Return v2
}
