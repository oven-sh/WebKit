# the slot of the field holds the functions of an accessor, and whichever getter lies there is the one that the read would call: behind the test of the shape and a look whether the slot is filled it is loaded and called
# function make(x) { return { get a() { return x; }, c: 1 }; }   function use(o: View) { return o.a; }   function plain(o: View) { return o.c; }
# `use` and `plain` are handed to sink, so the type of `o` is what is written. An empty slot and another shape take the read as written
# RUN: walk f2 mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots+DirectCalls+Guesses
# CHECK-LABEL: code f2:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = IsSlotFilled {{*}}key="a"
# CHECK: = GetSlotGetter {{*}}key="a"
# RUN(ALL): walk f2 mechanisms=all
# ALL-LABEL: code f2:Body
# ALL: = GetSlotGetter {{*}}key="a"
# RUN(WRITTEN): walk f2 mechanisms=all
# WRITTEN: frequency=Rare
# WRITTEN: = PropGet {{*}}key="a"
# RUN(PLAIN): walk f3 mechanisms=all
# PLAIN-LABEL: code f3:Body
# PLAIN-NOT: GetSlotGetter
# RUN(LINK): link accesses mechanisms=all
# LINK: accessors L0.0 "a" getter=f4
# RUN(PLAN): plan layouts mechanisms=all
# PLAN: slot 0 "a" {{*}} accessor

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="c" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Integer integer=1
    v4 = Call v0, -, v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v1, v2, v4
    Return v7
}
function f1 name="make" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    v2 = NewClosure v0 function=f4
    DefineGetter v1, v2 key="a"
    v4 = Integer integer=1
    PropDefine v1, v4 key="c"
    v6 = FinishObject v1
    Return v6
}
function f2 name="use" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|L0):
    v1 = PropGet v0 key="a"
    Return v1
}
function f3 name="plain" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|L0):
    v1 = PropGet v0 key="c"
    Return v1
}
function f4 name="a" module=m0 kind=Getter captures=[{type=anything variableName="x"}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
