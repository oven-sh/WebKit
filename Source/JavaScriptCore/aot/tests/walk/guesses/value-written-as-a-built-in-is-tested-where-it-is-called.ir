# const join = given.join, other = given.other, missing = given.missing;
# function joined(list) { const text = join.call(list, ","); return [text]; }   function returned(list) { return join.call(list, ","); }   function method(list) { return [list.join(",")]; }
# The library keeps the built-ins that it calls in variables: `const ArrayPrototypeJoin = Array.prototype.join`. Where nothing is proven of such a variable, or no more than `undefined|builtin(..)`,
# what is written of it, one built-in, is a guess like any other that is written: one compare with the cell of the built-in, the call by its rows, the call as it is written in a rare block.
# As it was, only a function that Link lists was expected of what a call calls, so each such call entered the function of the engine by value.
# RUN: walk f1:Body mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: [[test]]: boolean @Boolean = TypeTest {{*}}testedType=builtin(ArrayPrototypeJoin)
# CHECK: Branch [[test]] -> taken [[typed]](), notTaken [[closed]]()
# CHECK: [[typed]]():
# CHECK: = CallBuiltin {{*}}overload=ArrayPrototypeJoin
# CHECK: [[closed]]() frequency=Rare
# CHECK: = Call
# Nothing meets behind the call that is returned: native code comes back, so the unit returns what it gave, and the call as written leaves as a tail call.
# RUN(TAIL): walk f2:Body mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls
# TAIL-LABEL: code f2:Body
# TAIL: [[test]]: boolean @Boolean = TypeTest {{*}}testedType=builtin(ArrayPrototypeJoin)
# TAIL: Branch [[test]] -> taken [[typed]](), notTaken [[closed]]()
# TAIL: [[given]]: {{*}} = CallBuiltin {{*}}overload=ArrayPrototypeJoin
# TAIL: Return [[given]]
# TAIL: [[closed]]() frequency=Rare
# TAIL: ReturnCall
# function copied(list) { return [returned(list)]; }   The copy of returned() does not return in place of the unit: the two ways meet behind the call.
# RUN(COPY): walk f8:Body mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls+Inlining
# COPY-LABEL: code f8:Body
# COPY: frame 1 callee=f2
# COPY: [[test]]: boolean @Boolean = TypeTest {{*}}testedType=builtin(ArrayPrototypeJoin)
# COPY: Branch [[test]] -> taken [[typed]](), notTaken [[closed]]()
# COPY: [[given]]: {{*}} = CallBuiltin {{*}}overload=ArrayPrototypeJoin
# COPY: Jump -> next [[behind]]([[given]])
# COPY: [[closed]]() frequency=Rare
# COPY: [[asWritten]]: {{*}} = Call
# COPY: Jump -> next [[behind]]([[asWritten]])
# RUN(NEVER): walk f8:Body mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls+Inlining
# NEVER-NOT: ReturnCall
# In closed code `list.join(",")` is one operation, which reads the method and calls it: no test takes the two apart.
# RUN(METHOD): walk f3:Body mechanisms=none+TypedOperations+Guesses+DirectCalls+BuiltinCalls
# METHOD-LABEL: code f3:Body
# METHOD-NOT: testedType=builtin
# RUN(WITHHELD): walk f1:Body f2:Body mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# WITHHELD-NOT: testedType=builtin
# What the variable holds is called, whatever is written of it: the built-in, a function of the program, nothing.
# RUN(SHELL): run-in-shell globalThis.given = { join: Array.prototype.join, other(separator) { return "mine" + this.length + separator; } }; globalThis.sink = (joined, returned, method, otherJoined, otherReturned, missingJoined, missingReturned, copied) => { const attempt = f => { try { return f(); } catch (error) { return error.constructor.name; } }; print(joined([1, 2, 3])[0], returned([1, 2, 3]), method([1, 2])[0]); print(otherJoined([1, 2, 3])[0], otherReturned([1, 2, 3])); print(attempt(() => missingJoined([1])), attempt(() => missingReturned([1]))); print(returned({ length: 2, 0: "a", 1: "b" }), attempt(() => returned(null)), attempt(() => joined(undefined))); print(copied([4, 5])[0], attempt(() => copied(null))); };
# SHELL: 1,2,3 1,2,3 1,2
# SHELL-NEXT: mine3, mine3,
# SHELL-NEXT: TypeError TypeError
# SHELL-NEXT: a,b TypeError TypeError
# SHELL-NEXT: 4,5 TypeError
# SHELL-NEXT: exited with 0

