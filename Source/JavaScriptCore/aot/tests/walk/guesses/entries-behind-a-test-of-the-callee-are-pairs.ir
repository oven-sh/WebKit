# const entries = given.entries, other = given.other;
# function clone(object, made) { for (const [property, value] of entries(object)) made[property] = value; return made; }   function cloneByOther(object, made) { .. of other(object) .. }
# DOMPurify's clone(), in a module that may run again. What is called is only expected to be Object.entries, so the call stands behind a test of the callee, and the arm as written brings a list of pairs.
# The typed arm once made the flat list of keys and values that only the loop behind it can read, the two met in front of the loop, and the loop read what had met as flat:
# the walk stopped ("GetArrayLength, operand 0: it is anything?ResultOfUnknownCallee, and Array is taken"); had the types fitted, the pairs would have been read as keys and values.
# OPTIONS: check=Validate
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: [[test]]: boolean @Boolean = TypeTest {{*}}testedType=builtin(ObjectEntries)
# CHECK: Branch [[test]] -> taken [[typed]](), notTaken [[closed]]()
# CHECK: overload=ObjectEntries/
# RUN(PAIRS): walk f1:Body f2:Body mechanisms=all
# PAIRS-NOT: OwnEntriesFlat
# RUN(SHELL): run-in-shell mechanisms=all globalThis.given = { entries: Object.entries, other(object) { return [["x", 1], ["y", object]]; } }; globalThis.sink = (clone, cloneByOther) => { print(JSON.stringify(clone({ a: 1, b: "two" }, {})), JSON.stringify(clone([7, 8], {})), JSON.stringify(cloneByOther(5, {}))); };
# SHELL: {"a":1,"b":"two"} {"0":7,"1":8} {"x":1,"y":5}
# SHELL-NEXT: exited with 0

