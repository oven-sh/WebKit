# const list: N[] = [{ kind: 1, a: 7 }, { kind: 2, b: 8 }, { kind: 3, a: 5, c: 9 }];
# let s = 0;
# for (let i = 0; i < list.length; i++) s += tell(list[i]) + chosen(list[i]) + untold(list[i]);
# console.log(s);
