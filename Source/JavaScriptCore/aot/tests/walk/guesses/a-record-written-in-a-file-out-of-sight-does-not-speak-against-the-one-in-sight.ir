# reader.js:    function joined(list) { let text = ""; for (let i = 0; i < list.length; i++) { const o = list[i]; text += o.label + o.mark; } return text; }   sink(joined, { width: 3, label: "a", mark: "b" });
# elsewhere.js: keep({ depth: 4, label: "y", mark: "z" });
# main.js:      import "./elsewhere.js"; import "./reader.js";
# Whatever comes out of the list is asked for `label` and for `mark`. Which layout has both is asked among those that the function's own file writes:
# reader.js writes one. That a file which reader.js never names writes another record with both names changes nothing in `joined`: how a function is compiled does not hang on the rest of the program.
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = GetSlot {{*}}key="label" receivers=[L0]
# CHECK: = GetSlot {{*}}key="mark" receivers=[L0]
# RUN(ANSWER): run-in-shell globalThis.keep = record => { globalThis.kept = record; }; globalThis.sink = (joined, record) => { print(joined([record, globalThis.kept, { label: "c", mark: "d" }])); };
# ANSWER: abyzcd
# ANSWER-NEXT: exited with 0

layout L0 module=m0 fields=[{key="width" declared={type=anything} flags=[IsRequired]}, {key="label" declared={type=anything} flags=[IsRequired]}, {key="mark" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m1 fields=[{key="depth" declared={type=anything} flags=[IsRequired]}, {key="label" declared={type=anything} flags=[IsRequired]}, {key="mark" declared={type=anything} flags=[IsRequired]}]
module m0 path="reader.js" displayPath="reader.js" body=f0
module m1 path="elsewhere.js" displayPath="elsewhere.js" body=f2
module m2 path="main.js" displayPath="main.js" body=f3 requests=[{target=m1 completes=true}, {target=m0 completes=true}]
entry module=m2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Integer integer=3
    v4 = String string="a"
    v5 = String string="b"
    v6 = NewObject -, v3, v4, v5 layout=L0 fields=[0, 1, 2]
    v7 = FinishObject v6
    v8 = Call v1, -, v2, v7 calleeName="sink"
    Return v8
}
function f1 name="joined" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string=""
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: anything, v4: anything):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = PropGet v8 key="label"
    v10 = PropGet v8 key="mark"
    v11 = Add v9, v10
    v12 = Add v3, v11
    v13 = Increment v4
    Jump -> next b1(v12, v13)
  b3():
    Return v3
}
function f2 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="keep" [isFreeName]
    v2 = Integer integer=4
    v3 = String string="y"
    v4 = String string="z"
    v5 = NewObject -, v2, v3, v4 layout=L1 fields=[0, 1, 2]
    v6 = FinishObject v5
    v7 = Call v1, -, v6 calleeName="keep"
    Return v7
}
function f3 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
