# What is known of the parameter are its uses: the record of the one name, which no use needs. A literal has that name, and so have the instances of a constructor function:
# both are expected, one test lets both in, and the reads go to the slot that they share.
# function P() { this.z = 3; }   function read(held) { return held.z + held.z; }   publish(read, new P(), { z: 1 });
