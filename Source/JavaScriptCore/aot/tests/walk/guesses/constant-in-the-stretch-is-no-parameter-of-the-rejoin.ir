# what both arms bring under one name needs no parameter where they meet. Two constants stand between the operations that lean on the guess and are read behind the rejoin
# the record of undefined has no word, which was taken for no value: the walk stopped with "an arm of a guess has no value for what is read behind it"
# function row(n: number) { return [n * n, undefined, 4, n * n * n]; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = TypeTest {{*}}testedType=number
# CHECK-COUNT-2: Jump -> next [[join]](
# CHECK: [[join]]([[square]]: number|bigint @JSValue, [[cube]]: number|bigint @JSValue):
# CHECK-NEXT: = NewArray [[square]], [[nothing]], [[four]], [[cube]]
# RUN(NOTHING): walk f1 mechanisms=none+TypedOperations+Guesses
# NOTHING: constants:
# NOTHING: [[nothing]]: undefined @JSValue = Undefined
# NOTHING: = NewArray [[square]], [[nothing]],
# RUN(FOUR): walk f1 mechanisms=none+TypedOperations+Guesses
# FOUR: constants:
# FOUR: [[four]]: 4 {{*}}= Integer integer=4
# FOUR: = NewArray [[square]], [[nothing]], [[four]],

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="row" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Convert v0 declared={type=number}
    v2 = Mul v1, v1
    v3 = Undefined
    v4 = Integer integer=4
    v5 = Mul v2, v1
    v6 = NewArray v2, v3, v4, v5 contents=anything
    Return v6
}
