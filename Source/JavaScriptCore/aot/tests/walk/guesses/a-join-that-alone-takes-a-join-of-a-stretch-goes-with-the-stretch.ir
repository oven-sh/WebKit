# layout L905 kind=Closure
variable g0 name="table" module=m0 declared={type=undefined|null|object|absent flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
module m0 path="/$bunfs/root/meeting.ts" displayPath="meeting.ts" flags=[CachesEvaluationError] body=f0 positions={lineStarts=[0, 42, 110, 143] quotedSources=[{position=71 start=29 end=66}, {position=111 end=15}, {position=130 end=22}] quotedSourceText="globalThis.sink(named)(i) => table[\x22k\x22 + (i & 63) + \x22_\x22 + (i & 7)]"} functionSource="const table = {};\x0aconst named = (i) => table[\x22k\x22 + (i & 63) + \x22_\x22 + (i & 7)];\x0a(globalThis).sink(named);\x0a" namespaceLayout=L(m0)
