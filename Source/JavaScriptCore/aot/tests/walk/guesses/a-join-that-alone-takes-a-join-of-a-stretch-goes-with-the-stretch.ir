# const named = (i: number) => table["k" + (i & 63) + "_" + (i & 7)];
# The test of `i` opens a stretch that ends behind the last `&`, the last operation that is better off for the test. The last `+` alone takes the join that stands in the stretch, and only a written number stands between: it goes with the stretch. Each way makes the whole name; no join takes a text that two ways hand over.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = TypeTest {{*}}testedType=number
# CHECK-COUNT-2: [isLikelyKey, isLikelyName]
# CHECK-NOT: [isLikelyKey, isLikelyName]
