  b0():
    v0 = Data data=d0 @38
    v1 = Convert v0 declared={type=undefined|null|object flags=[OmitsNull, OmitsUndefined]} @38
    PutModuleVariable v1 variable=g0 @6
    v3 = NewClosure function=f1 @56
    v4 = Builtin builtin=GlobalThis @111
    v5 = PropGet v4 key="globalThis" [isFreeName] @111
    v6 = Convert v5 declared={type=builtin(GlobalThis) flags=[IsExpected]} @111
    v7 = PropGet v6 key="sink" @111
    v8 = Call v7, v6, v3 calleeKey="sink" calleeName="globalThis.sink" @130
    v9 = Undefined @110
    Return v9 @110
}
function f1 name="named" module=m0 position=56 sourceRange={start=32 end=76} kind=Arrow flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    v1 = GetModuleVariable variable=g0 @71
