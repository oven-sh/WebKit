# interface Span { depth: number; value: number }
# function pick(spans: Span[]) { let found = 0, best = -1; for (let i = 0; i < spans.length; i++) { const span = spans[i]; if (span.depth > best) { found = span.value; best = span.depth; } } return found + best; }
# The records have got out, so a read of a field looks whether its slot is filled and what it finds is anything until a test has shown more. `span.depth` is read, shown to be a number, and read again behind `span.value`.
# The look at `value` opens a guess for the stretch, and the guess used to look at every slot that the stretch reads, `depth` too, of which the state held the value: a second load, of which nothing was shown.
# The look at the loop counts on the second read to give what was shown of the first: anything came round to a head laid down for numbers: the unit was walked again, and the verifier stopped the build.
# f1 = pick
# OPTIONS: check=Validate
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: number @Double, {{*}}isInLoop=true isLoopHead=true
# CHECK: = GetSlot {{*}}key="depth"
# CHECK: = GetSlot {{*}}key="value"
# CHECK-NOT: = GetSlot {{*}}key="depth"
# CHECK: Return

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="depth" declared={type=number} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] declaredOrder=[0, 1] ownFieldCount=2
data d0 root=Array{contents=undefined|null|L0 elements=[Object{layout=L0 members=[{key="depth" value=Number{}}, {key="value" value=Number{value=1}}]}, Object{layout=L0 members=[{key="depth" value=Number{value=2}}, {key="value" value=Number{value=3}}]}]} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="kept"
    v3 = Data data=d0
    v4 = Convert v3 declared={type=undefined|null|Array<undefined|null|L0> flags=[OmitsNull, OmitsUndefined]}
    v5 = PropGet v1 key="take" [isFreeName]
    v6 = Call v5, -, v4
    v7 = PropGet v1 key="sink" [isFreeName]
    v8 = Call v0, -, v4
    v9 = Call v7, -, v8
    Return v9
}
function f1 name="pick" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|L0> flags=[OmitsNull, OmitsUndefined]}] results=[{type=number}] {
  b0(v0: undefined|null|Array<undefined|null|L0>):
    v1 = Integer
    v2 = Convert v1 declared={type=number}
    v3 = Integer integer=-1
    v4 = Convert v3 declared={type=number}
    v5 = Integer
    v6 = Convert v5 declared={type=number}
    Jump -> next b1(v2, v4, v6)
  b1(v7: number, v8: number, v9: number):
    LoopHint
    v11 = PropGet v0 key="length"
    v12 = Less v9, v11
    Branch v12 -> taken b2(), notTaken b5()
  b2():
    v13 = ElemGet v0, v9
    v14 = PropGet v13 key="depth"
    v15 = Greater v14, v8
    Branch v15 -> taken b3(), notTaken b4(v7, v8)
  b3():
    v16 = PropGet v13 key="value"
    v17 = Convert v16 declared={type=number}
    v18 = PropGet v13 key="depth"
    v19 = Convert v18 declared={type=number}
    Jump -> next b4(v17, v19)
  b4(v20: number, v21: number):
    v22 = Increment v9
    v23 = Convert v22 declared={type=number}
    Jump -> next b1(v20, v21, v23)
  b5():
    v24 = Add v7, v8
    v25 = Convert v24 declared={type=number}
    Return v25
}
