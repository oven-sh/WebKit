# function Pair(a, b, c) { this.a = a; this.b = b; this.c = c; this.other = null; }
# function copy(from) { var to = from.other; to.a = from.a; to.b = from.b; to.c = from.c; return to; }
# function cross(from) { var to = from.other; to.a = from.b; to.b = from.a; to.c = from.a + from.b; return to; }
# `from` is tested at the entry; `to` is read out of a field and only expected to be a Pair. Each store to `to` is fed by a read off `from`, which is typed but for the look whether its slot is filled:
# found empty, the read goes by name and may run code. Such a read used to end the stretch of the guess at `to`, so every store stood alone and tested `to` for itself: a cell? this shape? not frozen? slot filled?
# Now the look at the slot of `from` is asked in front of the stretch with the others: one test of `to`, the looks, three plain stores; any look failing, the whole row runs closed.
# In `cross` the read of `from.a` stands behind a store under `a`, and `to` may be `from`: what was read in front would be stale, so that read ends the stretch as before
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: PutSlot {{*}}key="a" receivers=[L0] level=Proven
# CHECK: PutSlot {{*}}key="b" receivers=[L0] level=Proven
# CHECK: PutSlot {{*}}key="c" receivers=[L0] level=Proven
# RUN(ALONE): walk f1 mechanisms=all
# ALONE-NOT: PutSlot {{*}}level=Expected
# RUN(ANSWER): run-in-shell mechanisms=all globalThis.sink = (copy, cross, pair) => { const show = p => p.a + " " + p.b + " " + p.c; const linked = (from, to) => { from.other = to; return from; }; print(show(copy(linked(pair(1, 2, 3), pair(4, 5, 6))))); print(show(cross(linked(pair(1, 2, 3), pair(4, 5, 6))))); const one = pair(1, 2, 3); one.other = one; print(show(cross(one))); const same = pair(1, 2, 3); same.other = same; print(show(copy(same))); const gap = linked(pair(1, 2, 3), pair(4, 5, 6)); delete gap.b; print(show(copy(gap))); const sly = linked(pair(1, 2, 3), pair(4, 5, 6)); Object.defineProperty(sly, "b", { get() { Object.freeze(sly.other); return 8; } }); try { copy(sly); } catch (error) { print(error instanceof TypeError, show(sly.other)); } print(show(copy(linked(pair(1, 2, 3), { a: 0, b: 0, c: 0 })))); const ice = linked(pair(1, 2, 3), Object.freeze(pair(4, 5, 6))); try { copy(ice); } catch (error) { print(error instanceof TypeError, show(ice.other)); } const lost = pair(4, 5, 6); delete lost.b; print(Object.keys(copy(linked(pair(1, 2, 3), lost))).join(), show(lost)); try { copy(pair(1, 2, 3)); } catch (error) { print(error instanceof TypeError); } };
# ANSWER: 1 2 3
# ANSWER-NEXT: 2 1 3
# ANSWER-NEXT: 2 2 4
# ANSWER-NEXT: 1 2 3
# ANSWER-NEXT: 1 undefined 3
# ANSWER-NEXT: true 1 5 6
# ANSWER-NEXT: 1 2 3
# ANSWER-NEXT: true 4 5 6
# ANSWER-NEXT: a,c,other,b 1 2 3
# ANSWER-NEXT: true
# ANSWER-NEXT: exited with 0

