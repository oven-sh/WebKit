# A sealed or non-extensible object takes stores into its filled slots: only a frozen one rejects them. A store that may create a property needs an extensible object.
# function set(o: Point, v) { o.x = v; o.y = v; }    function Node(kind) { this.kind = kind; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = IsNotFrozen
# CHECK: = PutSlot {{*}}key="x"
# CHECK: = PutSlot {{*}}key="y"
# RUN(OVERWRITES): walk f1 mechanisms=none+TypedOperations+Guesses
# OVERWRITES-NOT: isExtensible
# RUN(CREATES): walk f2 mechanisms=none+TypedOperations+Guesses
# CREATES: = IsNotFrozen {{*}}isExtensible]
# CREATES: = PutSlotOrAdd {{*}}key="kind"

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 kind=Instance name="Node" module=m0 constructor=f2 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Construct v4, -, v1
    v6 = Call v1, -, v4, v5
    v7 = NewObject layout=L0
    PropDefine v7, v3 key="x"
    PropDefine v7, v3 key="y"
    v10 = FinishObject v7
    v11 = Call v1, -, v10
    Return v11
}
function f1 name="set" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    PropSet v2, v1 key="x" mode=Strict
    PropSet v2, v1 key="y" mode=Strict
    v5 = Undefined
    Return v5
}
function f2 name="Node" module=m0 flags=[HasThis] length=1 thisType={type=L1 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1, v1: anything):
    PropSet v0, v1 key="kind" mode=Strict
    v3 = Undefined
    Return v3
}
