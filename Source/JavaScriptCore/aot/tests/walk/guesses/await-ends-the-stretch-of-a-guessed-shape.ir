# a suspension in the middle of what leans on a guessed shape: the stretch ends in front of the await, and the reads behind it stand behind a test of their own
# async function sum(o: Point, p) { const a = o.x + o.y + o.x + o.y + o.x + o.y; await p; return a + o.x + o.y + o.x + o.y + o.x + o.y; }
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: Test {{*}}L0
# CHECK: = GetSlot
# CHECK: = AwaitBySavingFrame
# CHECK: Test {{*}}L0
# CHECK: = GetSlot
# RUN(ONCE): walk f1:CoroutineBody mechanisms=none+TypedOperations+Guesses
# ONCE-COUNT-1: = AwaitBySavingFrame
# ONCE-NOT: = AwaitBySavingFrame

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="kept" module=m0 declared={type=anything}
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    PutModuleVariable v7 variable=g0
    Return v3
}
function f1 name="sum" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    v3 = PropGet v2 key="x"
    v4 = PropGet v2 key="y"
    v5 = PropGet v2 key="x"
    v6 = PropGet v2 key="y"
    v7 = PropGet v2 key="x"
    v8 = PropGet v2 key="y"
    v9 = Await v1
    v10 = PropGet v2 key="x"
    v11 = PropGet v2 key="y"
    v12 = PropGet v2 key="x"
    v13 = PropGet v2 key="y"
    v14 = PropGet v2 key="x"
    v15 = PropGet v2 key="y"
    v16 = NewArray v3, v4, v5, v6, v7, v8, v10, v11, v12, v13, v14, v15 contents=anything
    Return v16
}
