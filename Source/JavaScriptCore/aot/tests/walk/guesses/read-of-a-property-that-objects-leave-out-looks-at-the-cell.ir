# `o.limit` with limit?: an empty slot reads as undefined only while the property lies nowhere else in the object and nothing above the object answers.
# Of an object that is out of sight the object itself says both: two bits of one byte of its cell, asked by one look, once for however many reads. A frozen object is read like any other.
# The looks cost what a closed read costs, so they are asked for where the reads come again: in a loop
# function both(o: Options, n) { let x; while (n()) x = [o.limit, o.label]; return x; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = HasLayoutPrototype {{*}}hasNoFieldOutsideSlot
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: [[closed]]() frequency=Rare isInLoop=true keepsSitesThoughRare=true:
# CHECK-NEXT: = PropGet {{*}}key="limit"
# CHECK-NEXT: = PropGet {{*}}key="label"
# CHECK: = GetSlotOrUndefined {{*}}key="limit"
# CHECK: = GetSlotOrUndefined {{*}}key="label"
# RUN(ONCE): walk f1 mechanisms=none+TypedOperations+Guesses
# ONCE-COUNT-1: = HasLayoutPrototype
# ONCE-NOT: = HasLayoutPrototype
# RUN(FROZEN): walk f1 mechanisms=none+TypedOperations+Guesses
# FROZEN-NOT: IsNotFrozen
# A look at the slot of such a property would fail as often as not
# RUN(SLOTS): walk f1 mechanisms=none+TypedOperations+Guesses
# SLOTS-NOT: IsSlotFilled
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations
# WITHHELD-NOT: GetSlotOrUndefined

layout L0 name="Options" module=m0 fields=[{key="name" declared={type=anything} flags=[IsRequired]}, {key="limit" declared={type=anything}}, {key="label" declared={type=anything}}] ownFieldCount=3
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = Call v1, -, v5
    Return v6
}
function f1 name="both" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v2 key="limit"
    v9 = PropGet v2 key="label"
    v10 = NewArray v8, v9
    Jump -> next b1(v10)
  b3():
    Return v4
}
