# `o.x` with x?: outside of a loop, in a function of a file that the checker has checked: the looks at the cell, then the slot, which reads as undefined where it is empty.
# The same function in a file that nobody has checked is built the same way: what it takes is written. Where nothing is written the reads stay closed: property-that-objects-leave-out-opens-nothing.ir
# function list(o: Options) { return [o.x, o.y, o.x]; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = HasLayoutPrototype {{*}}hasNoFieldOutsideSlot
# CHECK: = GetSlotOrUndefined {{*}}key="x"
# CHECK: = GetSlotOrUndefined {{*}}key="y"
# A look at the slot of such a property would fail as often as not
# RUN(SLOTS): walk f1 mechanisms=none+TypedOperations+Guesses
# SLOTS-NOT: IsSlotFilled
# RUN(UNCHECKED): walk f2 mechanisms=none+TypedOperations+Guesses
# UNCHECKED-LABEL: code f2:Body
# UNCHECKED: = ShapeTest {{*}}layouts=[L0]
# UNCHECKED: = HasLayoutPrototype {{*}}hasNoFieldOutsideSlot
# UNCHECKED: = GetSlotOrUndefined {{*}}key="x"
# UNCHECKED: = GetSlotOrUndefined {{*}}key="y"
# How a body is built goes by its own text, not by who leads to it: a function that names itself and one that a call in a loop enters are built as the first is
# RUN(RING): walk f3 mechanisms=none+TypedOperations+Guesses
# RING-LABEL: code f3:Body
# RING: = ShapeTest {{*}}layouts=[L0]
# RING: = HasLayoutPrototype {{*}}hasNoFieldOutsideSlot
# RING: = GetSlotOrUndefined {{*}}key="x"
# RING: = GetSlotOrUndefined {{*}}key="y"
# RUN(CALLED): walk f4 mechanisms=none+TypedOperations+Guesses
# CALLED-LABEL: code f4:Body
# CALLED: = ShapeTest {{*}}layouts=[L0]
# CALLED: = HasLayoutPrototype {{*}}hasNoFieldOutsideSlot
# CALLED: = GetSlotOrUndefined {{*}}key="x"
# CALLED: = GetSlotOrUndefined {{*}}key="y"
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations
# WITHHELD-NOT: GetSlotOrUndefined

layout L0 name="Options" module=m0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    v6 = FinishObject v4
    v7 = Call v1, -, v6
    v8 = NewClosure function=f2
    v9 = Call v1, -, v8
    v10 = NewClosure function=f3
    v11 = Call v1, -, v10
    v12 = NewObject layout=L0
    v13 = FinishObject v12
    v14 = Call v1, -, v13
    v15 = NewClosure function=f5
    v16 = Call v1, -, v15
    Return v11
}
function f1 name="list" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = PropGet v1 key="x"
    v5 = NewArray v2, v3, v4 contents=anything
    Return v5
}
function f2 name="unchecked" module=m0 length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = PropGet v1 key="x"
    v5 = NewArray v2, v3, v4 contents=anything
    Return v5
}
function f3 name="namesItself" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = PropGet v1 key="x"
    v5 = NewClosure function=f3
    v6 = NewArray v2, v3, v4, v5 contents=anything
    Return v6
}
function f4 name="calledInLoop" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = PropGet v1 key="x"
    v5 = NewArray v2, v3, v4 contents=anything
    Return v5
}
function f5 name="caller" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = NewClosure function=f4
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Call v2, -, v0
    Jump -> next b1(v8)
  b3():
    Return v4
}
