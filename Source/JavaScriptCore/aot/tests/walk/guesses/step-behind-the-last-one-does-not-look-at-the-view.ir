# An iterator that has answered done answers done for ever, and does not look at the view again. Over one byte the step of `b` ends the iteration, the default takes the memory away, and `c` is undefined: no TypeError.
# function take(view: Uint8Array, buffer: ArrayBuffer) { const [a, b = (buffer.transfer(), 7), c] = view; sink(a, b, c); }
# the records of f1 are what the front end writes of that line
# a view that has lost its memory has the length 0, so a step that finds an element asks nothing more. The step that finds none asks for the memory only while the position is not the one behind every end.
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: [[behindEveryEnd]]: 34359738368 {{*}} = Integer
# CHECK: [[position]]: int[0, 34359738368] @Int64):
# CHECK: [[inside]]: boolean {{*}} = Less [[position]], [[length]] form=Integers
# CHECK: Branch [[inside]] -> taken [[reading]](), notTaken [[ending]]()
# CHECK: [[ending]]()
# CHECK: [[goesOn]]: boolean {{*}} = Less [[position]], [[behindEveryEnd]] form=Integers
# CHECK: Branch [[goesOn]] -> taken [[asking]](), notTaken [[asked]]()
# CHECK: [[asking]]()
# CHECK: RequireAttachedTypedArray
# CHECK: Jump -> next [[asked]]()
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: [[behindEveryEnd]]: 34359738368 {{*}} = Integer
# ALL: [[position]]: int[0, 34359738368] @Int64):
# ALL: [[inside]]: boolean {{*}} = Less [[position]], [[length]] form=Integers
