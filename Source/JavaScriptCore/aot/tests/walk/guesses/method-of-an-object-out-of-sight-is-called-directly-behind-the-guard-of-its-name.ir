# `o.own(1)` on an object that unseen code has in hand. By name the call costs a lookup through two tables and an entry that knows nothing of its arguments.
# What the class wrote under the name is what a lookup finds while three things hold, and each is one look: the object is of the layout, it still stands below the prototype object of its class,
# and the guard that reads ask of the class and the name holds: the member is as the record declares it, on whichever class of the row, and no object of the class hides it.
# Behind them stands the call of the function itself. Where one fails, the read and the call as they are written.
# The two arms cost bytes at every such call of a program. They gain in a loop, and outside of loops in a plain body: method-above-is-called-itself-outside-of-loops.ir has the body of a coroutine beside it
# class Above { m(x) { return x; } }  class Meter extends Above { own(x) { return x; } }  function both(o: Meter, n) { let x; while (n()) x = [o.own(1), o.m(2)]; return x; }  function once(o: Meter) { return o.own(1); }  sink(both, once, new Meter());
# RUN: walk f5 mechanisms=none+TypedOperations+Guesses+DirectCalls
# CHECK-LABEL: code f5:Body
# CHECK: isLoopHead=true
# CHECK: = ShapeTest {{*}}layouts=[L1]
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = HasLayoutPrototype
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: [[closed]]() frequency=Rare isInLoop=true{{*}}:
# CHECK-NEXT: [[read]]: {{*}} = PropGet {{*}}key="own"
# CHECK: = Call [[read]],
# CHECK: = AreMembersUnchanged conditions=[{layout=L1 key="own"}]
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = CallDirect {{*}}function=f4
# The method of the class above: the guard is that of the object's own class, which speaks of the whole row
# CHECK: = AreMembersUnchanged conditions=[{layout=L1 key="m"}]
# CHECK: = CallDirect {{*}}function=f3
# The read is not built in the typed arm: the closure is the one that the closure table holds, and the call takes nothing of it
# RUN(READS): walk f5 mechanisms=none+TypedOperations+Guesses+DirectCalls
# READS-COUNT-2: = PropGet
# READS-NOT: = PropGet
# RUN(ONCE): walk f6 mechanisms=none+TypedOperations+Guesses+DirectCalls
# ONCE-LABEL: code f6:Body
# ONCE: = ShapeTest {{*}}layouts=[L1]
# ONCE: = AreMembersUnchanged conditions=[{layout=L1 key="own"}]
# ONCE: = CallDirect {{*}}function=f4
# RUN(WITHHELD): walk f5 mechanisms=none+TypedOperations+Guesses
# WITHHELD-NOT: AreMembersUnchanged
# WITHHELD-NOT: CallDirect
# RUN(CLOSED): walk f5 mechanisms=none+TypedOperations+DirectCalls
# CLOSED-NOT: AreMembersUnchanged
# CLOSED-NOT: CallDirect

layout L0 kind=Instance name="Above" module=m0 constructor=f1
layout L1 kind=Instance name="Meter" module=m0 base=L0 constructor=f2 supertypes=[L0] flags=[HasHeritage]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f3
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = ResolveHeritage v4
    v6 = NewClosure function=f2
    v7 = NewClass v6, v4, v5 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="own"
    v10 = FinishClass v7 layout=L1
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = NewClosure function=f5
    v14 = NewClosure function=f6
    v15 = Construct v10
    v16 = Call v12, -, v13, v14, v15
    Return v16
}
function f1 name="Above" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Meter" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="m" module=m0 kind=Method flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
function f4 name="own" module=m0 kind=Method flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
function f5 name="both" module=m0 length=2 thisType={type=anything} parameters=[{type=L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: L1, v1: anything):
    v2 = Convert v0 declared={type=L1}
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v2 key="own"
    v9 = Integer integer=1
    v10 = Call v8, v2, v9 calleeKey="own"
    v11 = PropGet v2 key="m"
    v12 = Integer integer=2
    v13 = Call v11, v2, v12 calleeKey="m"
    v14 = NewArray v10, v13
    Jump -> next b1(v14)
  b3():
    Return v4
}
function f6 name="once" module=m0 length=1 thisType={type=anything} parameters=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = Convert v0 declared={type=L1}
    v2 = PropGet v1 key="own"
    v3 = Integer integer=1
    v4 = Call v2, v1, v3 calleeKey="own"
    Return v4
}
