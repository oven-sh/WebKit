# the source declares nothing of `at`. What enters the loop is declared a Link, and what comes round is read off `at` itself: what enters is expected in every turn
# function last(first: Link) { let at = first; while (at.next) at = at.next; return at; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: ([[at]]: anything{{*}}isLoopHead=true
# CHECK: = ShapeTest [[at]] layouts=[L0]
# CHECK: = IsSlotFilled {{*}}key="next"
# CHECK: = GetSlot {{*}}key="next"

layout L0 name="Link" module=m0 fields=[{key="next" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="next"
    v6 = FinishObject v4
    v7 = Call v1, -, v6
    Return v7
}
function f1 name="last" module=m0 length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    Jump -> next b1(v0)
  b1(v1):
    LoopHint
    v3 = PropGet v1 key="next"
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = PropGet v1 key="next"
    Jump -> next b1(v5)
  b3():
    Return v1
}
