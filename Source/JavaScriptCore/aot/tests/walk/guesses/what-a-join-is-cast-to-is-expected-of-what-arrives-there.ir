# nothing is written of an element of `table`; the type stands at the cast behind the join of the two ways. It is expected of what arrives there, in a body that uses no name off any value
# function links(table, key, made: Point): Point { return table[key] || made; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: [[element]]: anything{{*}} = ElemGet
# CHECK-NEXT: = ToBoolean [[element]] form=Generic [expectsObjectOrNothing]

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = Call v1, -, v7
    Return v8
}
function f1 name="links" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=L0}] results=[{type=L0}] {
  b0(v0: anything, v1: anything, v2: L0):
    v3 = ElemGet v0, v1
    v4 = ToBoolean v3
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    Jump -> next b3(v5)
  b2():
    Jump -> next b3(v2)
  b3(v6):
    v7 = Convert v6 declared={type=L0}
    Return v7
}
