# a type written in the source is a guess that is opened anywhere: one test in front of the stretch that leans on it, the typed run, one closed arm, and a rejoin
# function poly(n: number) { return ((((((n * n) * n) * n) * n) * n) * n) * n; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK: mechanisms TypedOperations,Guesses
# CHECK-LABEL: code f1:Body
# CHECK-COUNT-1: = TypeTest {{*}}testedType=number
# CHECK-NOT: = TypeTest
# RUN(TYPED): walk f1 mechanisms=none+TypedOperations+Guesses
# TYPED-COUNT-7: = Mul {{*}}form=Numbers
# TYPED-NOT: form=Numbers
# RUN(CLOSED): walk f1 mechanisms=none+TypedOperations+Guesses
# CLOSED-COUNT-7: = Mul {{*}}form=Generic
# CLOSED-NOT: form=Generic
# RUN(REJOIN): walk f1 mechanisms=none+TypedOperations+Guesses
# REJOIN-COUNT-2: Jump -> next [[join]](

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="poly" module=m0 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Convert v0 declared={type=number}
    v2 = Mul v1, v1
    v3 = Mul v2, v1
    v4 = Mul v3, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    Return v8
}
