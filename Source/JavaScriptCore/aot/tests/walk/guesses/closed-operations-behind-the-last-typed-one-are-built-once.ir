# the stretch ends behind the last operation that the tests turn from closed into typed: the two reads of `z`, which stay closed either way, stand behind the rejoin and are built once
# function list(o: Point) { return [o.x, o.y, o.z, o.z]; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest
# RUN(ONCE): walk f1 mechanisms=none+TypedOperations+Guesses
# ONCE-COUNT-2: = PropGet {{*}}key="z"
# ONCE-NOT: = PropGet {{*}}key="z"
# RUN(CLOSED): walk f1 mechanisms=none+TypedOperations+Guesses
# CLOSED-COUNT-1: = PropGet {{*}}key="x"
# CLOSED-NOT: = PropGet {{*}}key="x"

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = Call v1, -, v7
    Return v8
}
function f1 name="list" module=m0 length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = PropGet v1 key="z"
    v5 = PropGet v1 key="z"
    v6 = NewArray v2, v3, v4, v5 contents=anything
    Return v6
}
