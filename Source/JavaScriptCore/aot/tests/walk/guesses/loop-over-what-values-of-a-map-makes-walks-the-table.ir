# a read of `values` off a Map, a call of it on that Map, and the open of what the call gives, each named by the next alone: nobody gets hold of the method or of the iterator.
# a Map that is as it was made finds the engine's own method under the name, so the loop walks the table, as `for (.. of map)` does: no iterator is made, no `next` is called, no object is made for a step.
# whatever fails the two tests reads, calls and opens as it is written.
# function each(map: Map<string, number>) { for (const value of map.values()) keep(value); }
# function kept(map: Map<string, number>) { const it = map.values(); for (const value of it) keep(value); return it; }     the iterator is seen
# function sent(map: Map<string, number>) { for (const value of map.values(1)) keep(value); }                              an argument
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = TypeTest {{*}}testedType=Map
# CHECK: = IsPristine
# CHECK: = MapNext
# RUN(WRITTEN): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# WRITTEN: = PropGet {{*}}key="values"
# WRITTEN: = PropGet {{*}}key="next"
# RUN(ONCE): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# ONCE-COUNT-1: key="values"
# ONCE-NOT: key="values"
# RUN(KEPT): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# KEPT-NOT: MapNext
# RUN(SENT): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# SENT-NOT: MapNext
# RUN(WITHHELD): walk f1 mechanisms=none
# WITHHELD-NOT: MapNext

