# function whole(x: number) { return Math.floor(x); }   print(whole(2.5))
# An executable. Math.floor is locked and is a constant: the code in line, nothing is tested, and no call as written stands beside it.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: TypeTest
# CHECK-NOT: = Call v
# CHECK: overload=MathFloor/
# CHECK-NOT: = Call v

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = NewClosure function=f1
    v2 = PropGet v0 key="print" [isFreeName]
    v3 = Double number=2.5
    v4 = Call v1, -, v3
    v5 = Call v2, -, v4
    Return v5
}
function f1 name="whole" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Math) flags=[IsExpected]}
    v4 = PropGet v3 key="floor"
    v5 = Convert v4 declared={type=builtin(MathFloor) flags=[IsExpected]}
    v6 = Call v5, v3, v0 calleeKey="floor" calleeName="Math.floor"
    Return v6
}
