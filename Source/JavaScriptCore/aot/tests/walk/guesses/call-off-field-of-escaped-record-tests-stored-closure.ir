# const loaded = load({ handler: x => x >>> 3, bias: 1 })   function run(n) { for (..) { const table = loaded.default; sum = (table.handler(sum) + table.bias) | 0 } }
# The names alone say that the table is the record, and code that nobody has seen holds it, so nothing is proven of the field. The program stores one closure there, a small leaf that answers numbers: the call tests for it, and other callees are called as written.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = TypeTest {{*}}testedType=f3
# RUN(LINK): link held fields mechanisms=all
# LINK: field L0.1 "handler" proven=f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="bias" declared={type=number} flags=[IsRequired]}, {key="handler" declared={type=undefined|null|function flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
layout L1 kind=Environment module=m0 fields=[{key=@"0" declared={type=anything} variableName="loaded"}] ownFieldCount=1
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Integer integer=1
    v2 = NewObject -, v0, v1 layout=L0 fields=[1, 0]
    v3 = FinishObject v2
    v4 = NewObject layout=L1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="load" [isFreeName]
    v7 = Call v6, -, v3
    PutEnvironmentField v4, v7 layout=L1
    v9 = NewClosure v4 function=f1
    v10 = Integer integer=1000
    v11 = Call v9, -, v10
    Return v11
}
function f1 name="run" module=m0 flags=[IsChecked, HasExplicitName] length=1 captures=[{type=env L1 flags=[IsFromCompiler]}] thisType={type=anything} parameters=[{type=number}] results=[{type=number}] {
  b0(v0: env L1, v1: number):
    v2 = Integer
    v3 = Integer
    Jump -> next b1(v2, v3)
  b1(v4: number, v5: number):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = GetEnvironmentField v0 layout=L1
    v9 = PropGet v8 key="default"
    v10 = PropGet v9 key="handler"
    v11 = Call v10, v9, v4 calleeKey="handler" calleeName="loaded.default.handler"
    v12 = PropGet v9 key="bias"
    v13 = Add v11, v12
    v14 = Integer
    v15 = BitOr v13, v14
    v16 = Increment v5
    Jump -> next b1(v15, v16)
  b3():
    Return v4
}
