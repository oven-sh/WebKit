# CHECK: [[step]]: {{*}} = StepGenerator [[iterator]], {{*}}check=IsGenerator
# CHECK: = ResultAt [[step]]
# CHECK: [[status]]: {{*}} = ResultAt [[step]] index=1
# CHECK: = StrictEq [[status]], {{*}}form=Integers
# CHECK: = StrictEq [[status]], {{*}}form=Integers
# RUN(ARM): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# ARM: = TypeTest [[next]] testedType=builtin(GeneratorPrototypeNext)
# ARM: = Call [[next]], [[iterator]]
# ARM: = PropGet {{*}}key="done"
# RUN(LIST): walk f2 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# LIST-NOT: StepGenerator
# RUN(ANYTHING): walk f3 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls+BuiltinCalls
# ANYTHING-NOT: StepGenerator
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses+DirectCalls
# WITHHELD-NOT: StepGenerator
# RUN(NOGUESS): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+DirectCalls+BuiltinCalls
# NOGUESS-NOT: StepGenerator

