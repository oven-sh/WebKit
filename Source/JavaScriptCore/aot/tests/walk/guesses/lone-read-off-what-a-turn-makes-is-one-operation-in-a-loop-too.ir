# function last(next) { let x; for (;;) { const p: Point = next(); if (!next()) return x; x = p.x; p.y = next(); } }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = GetSlot {{*}}key="x" receivers=[L0] level=Expected
# CHECK: PutSlot {{*}}key="y" receivers=[L0] level=Expected
# RUN(ALONE): walk f1 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# ALONE-NOT: = ShapeTest
# ALONE-NOT: = PropGet {{*}}key="x"
# RUN(INFRONT): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+LoopInvariants
# INFRONT-LABEL: code f2:Body
# INFRONT: = ShapeTest {{*}}layouts=[L0]
# INFRONT: isLoopHead=true
# INFRONT-NOT: level=Expected

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = Call v1, -, v7
    v9 = NewClosure function=f2
    v10 = Call v1, -, v9
    Return v10
}
function f1 name="last" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2: anything):
    LoopHint
    v4 = Call v0, -
    v5 = Convert v4 declared={type=L0}
    v6 = Call v0, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v5 key="x"
    v9 = Call v0, -
    PropSet v5, v9 key="y" mode=Strict
    Jump -> next b1(v8)
  b3():
    Return v2
}
function f2 name="same" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v2 key="x"
    Jump -> next b1(v8)
  b3():
    Return v4
}
