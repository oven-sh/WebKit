# function flagsOf(kind: Kind): string { if (kind.flags) return "flags " + (kind.flags + 1); return "none"; }
# (globalThis as any).handed = [use, flagsOf];
# const asked: (kind: Kind) => string = (globalThis as any).handed[0];
