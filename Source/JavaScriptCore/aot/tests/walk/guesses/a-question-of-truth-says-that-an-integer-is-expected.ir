    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = Call v1, -, v7
    v9 = NewClosure function=f2
    v10 = Call v1, -, v9
    v11 = NewClosure function=f3
    v12 = Call v1, -, v11
    Return v12
}
function f1 name="pick" module=m0 length=2 thisType={type=anything} parameters=[{type=undefined|L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|L0, v1: anything):
