# nothing is written of `p`, and unseen code has the box, so nothing is proven of what lies in it. Every store of the program brings a Point: Link holds that (Facts::held()), and it is what is expected of `b.p`.
# It is no proof: the read of `x` asks for the shape, as with any guess
# function read(b: Box) { return b.p.x; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: [[p]]: {{*}} = GetSlot {{*}}key="p" receivers=[L1] level=Expected
# CHECK-NEXT: = GetSlot [[p]] key="x" receivers=[L0] level=Expected

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 name="Box" module=m0 fields=[{key="p" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = NewObject layout=L1
    PropDefine v8, v7 key="p"
    v10 = FinishObject v8
    v11 = Call v1, -, v10
    Return v11
}
function f1 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = PropGet v0 key="p"
    v2 = PropGet v1 key="x"
    Return v2
}
