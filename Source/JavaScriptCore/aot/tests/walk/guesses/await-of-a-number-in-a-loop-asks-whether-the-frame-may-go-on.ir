# in a loop of an async function the await of what has no `then` asks whether anybody could tell if the frame went on at once: the frame is saved in the arm that fails, and both arms go on with the value
# async function sum(n) { let s = 0; while (s < n) s += await 1; return s; }
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: isLoopHead=true
# CHECK: = AwaitMayContinue
# CHECK: = AwaitBySavingFrame
# RUN(ALL): walk f1:CoroutineBody mechanisms=all
# ALL-LABEL: code f1:CoroutineBody
# ALL: = AwaitMayContinue
# ALL: = AwaitBySavingFrame
# outside loops the test costs more than it saves
# async function once() { return await 1; }
# RUN(ONCE): walk f2:CoroutineBody mechanisms=all
# ONCE-LABEL: code f2:CoroutineBody
# ONCE: = AwaitBySavingFrame
# RUN(PLAIN): walk f2:CoroutineBody mechanisms=all
# PLAIN-NOT: = AwaitMayContinue
# what may have a `then` is handed to the run time in every turn
# async function each(n, p) { let s = 0; while (s < n) s += await p; return s; }
# RUN(ANY): walk f3:CoroutineBody mechanisms=all
# ANY-LABEL: code f3:CoroutineBody
# ANY: = AwaitBySavingFrame
# RUN(ASKED): walk f3:CoroutineBody mechanisms=all
# ASKED-NOT: = AwaitMayContinue
# the engine resumes an async generator, which cannot pass by the suspension
# async function* steps(n) { let s = 0; while (s < n) s += await 1; }
# RUN(GENERATOR): walk f4:CoroutineBody mechanisms=all
# GENERATOR-LABEL: code f4:CoroutineBody
# GENERATOR: = AwaitBySavingFrame
# RUN(ENGINE): walk f4:CoroutineBody mechanisms=all
# ENGINE-NOT: = AwaitMayContinue

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = Call v1, -, v2, v3, v4, v5
    Return v6
}
function f1 name="sum" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Integer integer=1
    v6 = Await v5
    v7 = Add v2, v6
    Jump -> next b1(v7)
  b3():
    Return v2
}
function f2 name="once" module=m0 flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Await v0
    Return v1
}
function f3 name="each" module=m0 flags=[IsAsync] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Await v1
    v7 = Add v3, v6
    Jump -> next b1(v7)
  b3():
    Return v3
}
function f4 name="steps" module=m0 flags=[IsAsync, IsGenerator, TakesCallee] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    InitialYield
    v3 = Integer
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=1
    v8 = Await v7
    v9 = Add v4, v8
    Jump -> next b1(v9)
  b3():
    v10 = Undefined
    Return v10
}
