# six lines read one of three elements of a list, leave early if it says so and keep its field. One element of the list comes out of JSON.parse, so each read is guessed at
# the way on which the guesses hold remembers the three elements and their shape: from the fourth line on it reads no element and tests no shape again
# the ways on which a guess failed go on beside it. They come back into it only where their own copy would build more than it may: there a join of all ways makes the passing way forget
# function run(list) { const i0 = list[0]; if (i0.skip) return 0; const w0 = i0.weight; const i1 = list[1]; if (i1.skip) return 1; const w1 = i1.weight; .. const i5 = list[2]; .. return [w0, w1, w2, w3, w4, w5]; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest
# CHECK: = ShapeTest
# CHECK: = ShapeTest
# CHECK-NOT: = ShapeTest

layout L0 kind=Instance name="Item" module=m0 constructor=f2 fields=[{key="skip" declared={type=boolean} flags=[IsRequired]}, {key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClass v1 layout=L0
    v3 = FinishClass v2 layout=L0
    v4 = Boolean
    v5 = Integer integer=2
    v6 = Construct v3, -, v4, v5
    v7 = Builtin builtin=JSON
    v8 = PropGet v7 key="parse"
    v9 = String string="{}"
    v10 = Call v8, v7, v9 calleeKey="parse"
    v11 = NewArray v6, v10, v6 contents=undefined|null|L0 holes=[3]
    v12 = Integer
    Jump -> next b1(v12)
  b1(v13: number):
    LoopHint
    v15 = Integer integer=300
    v16 = Less v13, v15
    Branch v16 -> taken b2(), notTaken b3()
  b2():
    v17 = Call v0, -, v11
    v18 = Increment v13
    Jump -> next b1(v18)
  b3():
    Return v13
}
function f1 name="run" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|L0> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Array<undefined|null|L0>):
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    v3 = PropGet v2 key="skip"
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v5 = PropGet v2 key="weight"
    v6 = Integer integer=1
    v7 = ElemGet v0, v6
    v8 = PropGet v7 key="skip"
    v9 = ToBoolean v8
    Branch v9 -> taken b3(), notTaken b4()
  b3():
    Return v6
  b4():
    v10 = PropGet v7 key="weight"
    v11 = Integer integer=2
    v12 = ElemGet v0, v11
    v13 = PropGet v12 key="skip"
    v14 = ToBoolean v13
    Branch v14 -> taken b5(), notTaken b6()
  b5():
    Return v11
  b6():
    v15 = PropGet v12 key="weight"
    v16 = Integer integer=0
    v17 = ElemGet v0, v16
    v18 = PropGet v17 key="skip"
    v19 = ToBoolean v18
    Branch v19 -> taken b7(), notTaken b8()
  b7():
    Return v16
  b8():
    v20 = PropGet v17 key="weight"
    v21 = Integer integer=1
    v22 = ElemGet v0, v21
    v23 = PropGet v22 key="skip"
    v24 = ToBoolean v23
    Branch v24 -> taken b9(), notTaken b10()
  b9():
    Return v21
  b10():
    v25 = PropGet v22 key="weight"
    v26 = Integer integer=2
    v27 = ElemGet v0, v26
    v28 = PropGet v27 key="skip"
    v29 = ToBoolean v28
    Branch v29 -> taken b11(), notTaken b12()
  b11():
    Return v26
  b12():
    v30 = PropGet v27 key="weight"
    v31 = NewArray v5, v10, v15, v20, v25, v30 contents=anything
    Return v31
}
function f2 name="Item" module=m0 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=boolean}, {type=number}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: boolean, v2: number):
    v3 = GetConstructPrototype v0 layout=L0
    v4 = NewObject v3 layout=L0
    PropSet v4, v1 key="skip"
    PropSet v4, v2 key="weight"
