# The length of an unknown array is a number that a version checks to be an int32 before the loop. The array is checked there, too, and its elements are read by name at their sites: as in a loop that counts up.
# function sum(d) { const t = d.users; let s = 0; for (let i = t.length - 1; i >= 0; i--) s += t[i].id; return s; }  sink(sum);
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = HasArrayStorage {{*}}arrayStorage=Contiguous
# CHECK: = GetArrayElement {{*}}arrayStorage=Contiguous level=Proven
# CHECK: = GetValueAtSiteOrAbsent {{*}}key="id"
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="users" @5
    v2 = Convert v1 declared={type=undefined|null|Array flags=[IsExpected]}
    v3 = Integer
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = PropGet v2 key="length" @10
    v6 = Integer integer=1
    v7 = Sub v5, v6 @20
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v4, v8)
  b1(v9, v10):
    LoopHint
    v12 = Integer
    v13 = GreaterEq v10, v12
    Branch v13 -> taken b2(), notTaken b3()
  b2():
    v14 = ElemGet v2, v10 @30
    v15 = PropGet v14 key="id" @40
    v16 = Add v9, v15 @50
    v17 = Convert v16 declared={type=number flags=[IsExpected]}
    v18 = Decrement v10 @60
    v19 = Convert v18 declared={type=number flags=[IsExpected]}
    Jump -> next b1(v17, v19)
  b3():
    Return v9
}
