# function count(members: Map<unknown, unknown>) { let n = 0; members.forEach(() => { n = n + 1; }, size(members) > 1 ? "many" : "few"); return n; }   sink(count);
# The method is read in one block and called in another: a branch stands among the arguments. A stretch ends in the block in which it begins, so the guess that is opened for "the call is a loop" is not opened here.
# When its end was taken from the place of the call alone, the walk went on through the next blocks in a straight line, the parameter of the join among them, and the build aborted: "Stopped while compiling .. in walk".
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = PropGet {{*}}key="forEach"
# CHECK: = NewClosure
# CHECK: = Less
# CHECK: = Call {{*}}calleeKey="forEach"
# CHECK: Return

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Environment module=m0 fields=[{key=@"0" declared={type=anything} variableName="n"}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="count" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=undefined|null|Map<anything, anything> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Map<anything, anything>):
    v1 = NewObject layout=L0
    v2 = Integer integer=0
    PutEnvironmentField v1, v2 layout=L0
    v4 = PropGet v0 key="forEach"
    v5 = NewClosure v1 function=f2
    v6 = NewClosure function=f3
    v7 = Call v6, -, v0 calleeName="size"
    v8 = Integer integer=1
    v9 = Less v8, v7
    Branch v9 -> taken b1(), notTaken b2()
  b1():
    v10 = String string="many"
    Jump -> next b3(v10)
  b2():
    v11 = String string="few"
    Jump -> next b3(v11)
  b3(v12: anything):
    v13 = Call v4, v0, v5, v12 calleeKey="forEach" calleeName="members.forEach"
    v14 = GetEnvironmentField v1 layout=L0
    Return v14
}
function f2 module=m0 kind=Arrow flags=[IsChecked] captures=[{type=env L0 flags=[IsFromCompiler]}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0
    v2 = Integer integer=1
    v3 = Add v1, v2
    PutEnvironmentField v0, v3 layout=L0
    v5 = Undefined
    Return v5
}
function f3 name="size" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=undefined|null|Map<anything, anything> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Map<anything, anything>):
    v1 = PropGet v0 key="size"
    Return v1
}
