# `x instanceof Map` in a loop, with x anything: a cell of the class that is as its class makes it stands below the prototype object of the class, so two tests of the cell answer, and the chain is walked on their failing side
# function countMaps(x, n) { let s = 0; for (let i = 0; i < n; i++) s += x instanceof Map; return s; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# the block of the failing side is made first, so the walk of the chain is printed in front of the second test
# CHECK: = TypeTest {{*}}testedType=Map
# CHECK: = HasInPrototypeChain
# CHECK: = IsPristine {{*}}builtinClass=Map
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+Guesses+Folding+EscapeAnalysis
# NEVER-NOT: = InstanceOf
# outside a loop, with nothing expected of the value, the bytes are not paid
# RUN(ONCE): walk f2 mechanisms=none+TypedOperations+Guesses+Folding+EscapeAnalysis
# ONCE-LABEL: code f2:Body
# ONCE-NOT: IsPristine
# ONCE: = HasInPrototypeChain
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations+Folding
# WITHHELD-LABEL: code f1:Body
# WITHHELD-NOT: IsPristine
# WITHHELD: = HasInPrototypeChain

