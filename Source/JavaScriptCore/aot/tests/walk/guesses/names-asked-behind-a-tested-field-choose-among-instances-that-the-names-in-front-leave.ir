# function Node(tag) { this.tag = tag; this.state = 4; this.child = 5; }   function Root(tag) { this.tag = tag; this.pending = 6; }
# function visit(n) { return n.tag === 1 ? n.state + n.child : 0; }   function either(n) { return n.tag === 1 ? n.state : n.pending; }   function plain(n) { return n.tag; }
# sink(visit, either, plain, new Node(1), new Node(2), new Root(1));
# Nothing is written of `n`. In front of the test it is asked for `tag` alone, which the instances of two constructors have: the names in front leave several.
# What is asked behind `tag === 1` is asked of a narrower view and does not count as a name of the value in front (see name-asked-behind-a-cast-or-a-tested-field-says-nothing-of-the-value-in-front.ir).
# But where the names in front leave several and nothing else is expected, the names of the views choose: one instance alone has `tag`, `state` and `child`, so it is expected at the read of `tag`.
# In `either` no layout has all of `tag`, `state`, `pending`, and `plain` has no view: of those parameters nothing is expected and `tag` is read closed
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = GetSlot {{*}}key="tag" receivers=[L0]
# RUN(NOTHING): walk f2 f3 mechanisms=none+TypedOperations+Guesses
# NOTHING-NOT: GetSlot {{*}}key="tag"
# RUN(ANSWER): run-in-shell globalThis.sink = (visit, either, plain, one, two, root) => { print(visit(one), visit(two), visit(root), visit({ tag: 1, state: 2, child: 3 }), visit({ get tag() { return 1; }, state: 1, child: 1 }), visit(7)); print(either(one), either(two), either(root), plain(one), plain(root)); Object.defineProperty(one, "tag", { get() { return 2; } }); print(visit(one), plain(one)); delete two.tag; print(visit(two), plain(two)); try { visit(null); } catch (error) { print(error instanceof TypeError); } };
# ANSWER: 9 0 NaN 5 2 0
# ANSWER-NEXT: 4 undefined undefined 1 1
# ANSWER-NEXT: 0 2
# ANSWER-NEXT: 0 undefined
# ANSWER-NEXT: true
# ANSWER-NEXT: exited with 0

layout L0 kind=Instance name="Node" module=m0 position=1 constructor=f4 fields=[{key="tag" declared={type=anything}}, {key="state" declared={type=anything}}, {key="child" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="Root" module=m0 position=2 constructor=f5 fields=[{key="tag" declared={type=anything}}, {key="pending" declared={type=anything}}] flags=[IsConstructorFunction]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = NewClosure function=f5
    v7 = Integer integer=1
    v8 = Integer integer=2
    v9 = Construct v5, -, v7
    v10 = Construct v5, -, v8
    v11 = Construct v6, -, v7
    v12 = Call v1, -, v2, v3, v4, v9, v10, v11 calleeName="sink"
    Return v12
}
function f1 name="visit" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="tag"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="tag"
    v6 = PropGet v5 key="state"
    v7 = PropGet v5 key="child"
    v8 = Add v6, v7
    Return v8
  b2(v9):
    v10 = NarrowByField v0, v9 key="tag"
    v11 = Integer integer=0
    Return v11
}
function f2 name="either" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="tag"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="tag"
    v6 = PropGet v5 key="state"
    Return v6
  b2(v7):
    v8 = NarrowByField v0, v7 key="tag"
    v9 = PropGet v8 key="pending"
    Return v9
}
function f3 name="plain" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="tag"
    Return v1
}
function f4 name="Node" module=m0 flags=[HasThis, HasExplicitName] length=1 thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0, v1: anything):
    PropSet v0, v1 key="tag"
    v3 = Integer integer=4
