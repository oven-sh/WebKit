function f5 name="Root" module=m0 flags=[HasThis, HasExplicitName] length=1 thisType={type=L1 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1, v1: anything):
    PropSet v0, v1 key="tag"
