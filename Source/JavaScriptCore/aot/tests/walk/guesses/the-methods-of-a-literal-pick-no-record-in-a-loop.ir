# function drain(list) { let n = 0; for (let i = 0; i < list.length; i++) { const o = list[i]; const step = o.step, close = o.close; step === close; step.call(o); n++; } return n; }
# sink(drain, { step() { return 1; }, close() { return 2; } });
# In a loop the only record that has every name used off a value is expected (in-a-loop-the-only-record-that-has-every-name-used-is-expected.ir). But a typed read of a METHOD of a literal names its function,
# and nothing in Link leads from the code that guesses to that function: the build stopped by its own net ("mentions function .. and LinkTables::referrers does not lead from the one to the other").
# So such names pick no record.
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses+DirectCalls
# CHECK-LABEL: code f1:Body
# CHECK-NOT: ShapeTest
# CHECK-NOT: function=f2
# RUN(ANSWER): run-in-shell globalThis.sink = (drain, record) => { print(drain([record, record, { step() {}, close() {} }])); };
# ANSWER: 3
# ANSWER-NEXT: exited with 0

layout L0 module=m0 fields=[{key="step" declared={type=anything} flags=[IsRequired, IsMethod]}, {key="close" declared={type=anything} flags=[IsRequired, IsMethod]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewObject -, v3, v4 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    v7 = Call v1, -, v2, v6 calleeName="sink"
    Return v7
}
function f1 name="drain" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2: anything):
    LoopHint
    v4 = PropGet v0 key="length"
    v5 = Less v2, v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = ElemGet v0, v2
    v7 = PropGet v6 key="step"
    v8 = PropGet v6 key="close"
    v9 = StrictEq v7, v8
    v10 = Call v7, v6
    v11 = Increment v2
    Jump -> next b1(v11)
  b3():
    Return v2
}
function f2 name="step" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="close" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
