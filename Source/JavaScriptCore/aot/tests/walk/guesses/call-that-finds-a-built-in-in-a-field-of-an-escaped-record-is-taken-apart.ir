# type Table = { handler: (x: number) => number; bias: number }   { handler: x => x + 3, bias: 1 }   { handler: Math.abs, bias: 1 }   sink(own, native, run)   for (..) sum = (table.handler(sum) + table.bias) | 0
# the records and the function are handed to code that nobody has seen, so nothing is proven of the field. What the flow has kept of the call is listed: it finds the built-in, beside the one closure.
# The call is taken apart: a look at the slot, the load, a test for the closure, on its failing side a test for the built-in, whose row stands in line; each arm goes on to the last operation that takes the answer
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = IsSlotFilled {{*}}key="handler"
# CHECK: = GetSlot {{*}}key="handler"
# CHECK: = TypeTest {{*}}testedType=f3
# CHECK: = TypeTest {{*}}testedType=builtin(MathAbs)
# CHECK: = CallInline {{*}}inlineBuiltin=MathAbs
# CHECK: = Add {{*}}form=Integers
# RUN(LINK): link held calls mechanisms=all
# LINK: call f1 v9 finds MathAbs beside f3
# RUN(PROVEN): link calls mechanisms=all
# PROVEN-NOT: finds

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="bias" declared={type=number} flags=[IsRequired]}, {key="handler" declared={type=undefined|null|function flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Integer integer=1
    v2 = NewObject -, v0, v1 layout=L0 fields=[1, 0]
    v3 = FinishObject v2
    v4 = Builtin builtin=MathAbs
    v5 = Integer integer=1
    v6 = NewObject -, v4, v5 layout=L0 fields=[1, 0]
    v7 = FinishObject v6
    v8 = NewClosure function=f1
    v9 = Integer integer=1000
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="sink" [isFreeName]
    v12 = Call v11, -, v3, v7, v8
    v13 = Call v8, -, v3, v9
    v14 = Call v8, -, v7, v9
    v15 = Add v13, v14
    Return v15
}
function f1 name="run" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]}, {type=number}] results=[{type=number}] {
  b0(v0: undefined|null|L0, v1: number):
    v2 = Integer
    v3 = Integer
    Jump -> next b1(v2, v3)
  b1(v4: number, v5: number):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v0 key="handler"
    v9 = Call v8, v0, v4 calleeKey="handler" calleeName="table.handler"
    v10 = PropGet v0 key="bias"
    v11 = Add v9, v10
    v12 = Integer
    v13 = BitOr v11, v12
    v14 = Increment v5
    Jump -> next b1(v13, v14)
  b3():
    Return v4
}
function f2 name="unused" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f3 name="handler" module=m0 kind=Arrow flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Integer integer=3
    v2 = Add v0, v1
    Return v2
}
