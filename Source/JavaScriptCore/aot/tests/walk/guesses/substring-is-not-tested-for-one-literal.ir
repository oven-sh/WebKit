# One way brings a literal, the other an element that nobody types. The part is tested to be a string: a test for the literal compares characters in the run time.
# function replace(t, n) { let o = ""; for (let i = 0; i < n; i++) { const c = t[i]; o += c === "-" ? "_" : c; } return o; }  sink(replace);
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: testedType="_"
# CHECK: StringBuilderAppend
# CHECK-NOT: testedType="_"
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="replace" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string=""
    v3 = Convert v2 declared={type=undefined|null|string flags=[IsExpected]}
    v4 = Integer
    v5 = Convert v4 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Less v7, v1
    Branch v9 -> taken b2(), notTaken b5()
  b2():
    v10 = ElemGet v0, v7 @10
    v11 = String string="-"
    v12 = StrictEq v10, v11 @20
    Branch v12 -> taken b3(), notTaken b4(v10)
  b3():
    v13 = String string="_"
    Jump -> next b4(v13)
  b4(v14):
    v15 = Add v6, v14 @30
    v16 = Convert v15 declared={type=undefined|null|string flags=[IsExpected]}
    v17 = Increment v7 @40
    v18 = Convert v17 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v16, v18)
  b5():
    Return v6
}
