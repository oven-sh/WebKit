# a guess at a value that is written as several layouts is narrowed to the one layout that has all the names used off the value. What is asked behind `as Two` and behind `kind === 2` is asked of one member of the type:
# counted for the value in front, Two alone would be expected there, the test would fail for every One, and `kind` and `flags` would be read in the closed arm
# interface Node { kind; flags }  One = { kind, flags }  Two = { kind, flags, extra }
# function behindCast(n: Node) { return n.kind + n.flags + (n as Two).extra; }  function behindTest(n: Node) { const sum = n.kind + n.flags; return n.kind === 2 ? sum + n.extra : sum; }
