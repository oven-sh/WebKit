# -- source: apply-of-arguments-of-a-function-that-has-left-is-forwarded-behind-a-test.js
# function target(a, b) { return sink(a, b); }
# function forwards() { return target.apply(this, arguments) + 1; }
# function forwardsBehindParameter(first) { return target.apply(this, arguments) + 1; }
# function known(x) { return target.call(null, x, 2) + 1; }
# sink(forwards, forwardsBehindParameter, known, target);
# -- end of source
# target has been handed to code that nobody knows, which may give it an `apply` of its own. So what the read finds is tested, and the other arm has the call as written.
