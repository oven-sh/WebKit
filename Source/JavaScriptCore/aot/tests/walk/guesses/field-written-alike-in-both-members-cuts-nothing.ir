# `kind` is written as any text in both members, so what was read there leaves both: the tag cuts nothing. Behind the test, at the access, the one member left that lists the name is expected all the same (narrowedByNameAskedForGuesses())
# the program of tested-field-cuts-what-is-expected-of-its-holder.ir with the two written types of `kind` changed
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: key="radius" receivers=[L1]

layout L0 name="Shape" module=m0 flags=[IsNeverAllocated]
layout L1 name="Circle" module=m0 fields=[{key="kind" declared={type=string} flags=[IsRequired]}, {key="radius" declared={type=number} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Square" module=m0 fields=[{key="kind" declared={type=string} flags=[IsRequired]}, {key="side" declared={type=number} flags=[IsRequired]}] supertypes=[L0]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = String string="circle"
    v4 = Integer integer=2
    v5 = NewObject -, v3, v4 layout=L1 fields=[0, 1]
    v6 = FinishObject v5
    v7 = String string="square"
    v8 = Integer integer=3
    v9 = NewObject -, v7, v8 layout=L2 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Call v1, -, v2, v6, v10 calleeName="sink"
    Return v11
}
function f1 name="area" module=m0 length=1 thisType={type=anything} parameters=[{type=L1|L2}] results=[{type=anything}] {
  b0(v0: L1|L2):
    v1 = Convert v0 declared={type=L1|L2}
    v2 = PropGet v1 key="kind"
    v3 = String string="circle"
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    v6 = NarrowByField v1, v5 key="kind"
    v7 = PropGet v6 key="radius"
    Return v7
  b2(v8):
    v9 = NarrowByField v1, v8 key="kind"
    v10 = PropGet v9 key="side"
    Return v10
}
