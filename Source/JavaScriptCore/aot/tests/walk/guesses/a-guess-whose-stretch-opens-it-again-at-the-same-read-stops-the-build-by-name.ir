# function swap(bytes: Uint8Array, table: Uint8Array, start: number, end: number) { let i = start, j = end - 1;
#   while (i < j) { const a = bytes[i], b = bytes[j]; bytes[i++] = table[b]; bytes[j--] = table[a]; } }
# The speculation on an element of a view has one contract with its producer, buildReadOfElementOfViewBehindTestOfLength(): on every path that continues, the read is built and recorded.
# The specialized branch then visits the region from its first operation, which is that same read, and only the record keeps the read from opening the speculation again.
# Fault injection, testing=DropLengthCheckedReads: the producer emits its tests and returns nothing. Without the check the walk opens the same speculation inside itself until the stack runs out:
# 201,048 frames and "out of stack" in a real program. When the same read opens the same speculation again inside its own region, the build fails with a named internal error.
# DIAGNOSTIC: RecursiveSpeculation
# RUN: walk f1 mechanisms=all testing=DropLengthCheckedReads

