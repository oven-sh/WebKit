# the parameter is proven a text or a list: both callers stand in the program. The guess tests for the list. It is the only test, so the block on its failing side has one edge: what the refusal leaves of the value is a text, and the arm that would be closed is typed by that proof
# function square(x: string | string[]) { return x.length * x.length; }  square("ab"); square(["ab"]);
