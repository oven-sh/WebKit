# function scan(text) { let sum = 0; for (let i = 0; i < text.length; i++) sum += text.charCodeAt(i); return sum; }
# Nothing says what `text` is. Every name used off it is one that texts answer, and charCodeAt, which no other class of the table has and which reads a character, is called on it:
# it is expected to be a text. A parameter is asked where the function is entered, the result of a call in front of the loop, and the units are read in line.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: b0({{*}}: string @JSValue
# CHECK: = GetStringCodeUnit
# function made() { const text = globalThis.source(); .. the same loop .. }
# RUN(MADE): walk f2:Body mechanisms=all
# MADE-LABEL: code f2:Body
# MADE: = TypeTest {{*}}testedType=string
# MADE: isLoopHead=true
# MADE: = GetStringCodeUnit
# function field(item) { .. sum += item.link .. }: the name is only read: many a record has a field called so
# RUN(FIELD): walk f3:Body mechanisms=all
# FIELD-NOT: b0({{*}}: string @JSValue
# function both(list) { .. list.charCodeAt(i) + list.push(i) .. }: no text answers `push`
# RUN(BOTH): walk f4:Body mechanisms=all
# BOTH-NOT: b0({{*}}: string @JSValue
# function trimmed(text) { .. text.trim().length .. }: trim() reads no character: a copy of the loop would not pay
# RUN(TRIMMED): walk f5:Body mechanisms=all
# TRIMMED-NOT: b0({{*}}: string @JSValue
# layout L911 kind=Closure
