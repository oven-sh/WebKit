# The constructor of Base is copied into that of Heir, whose class may be evaluated again. The copy fills the object that was allocated for Heir: one question about what is above it, then the stores.
# class Base { constructor(n) { this.n = n; this.rest = null; } }
# globalThis.extend(Base, B => class Heir extends B { constructor(n, m) { super(n); this.m = m; this.other = null; } });
# RUN: walk f3 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: = ShapeTest {{*}}layouts=[L1]
# CHECK: = PassesStoresAbove
# CHECK: PutSlotOrAdd {{*}}key="n" receivers=[L1]
# CHECK: PutSlotOrAdd {{*}}key="rest" receivers=[L1]
# CHECK: = PassesStoresAbove
# CHECK: PutSlotOrAdd {{*}}key="m" receivers=[L1]

