# function textOf(node: Node) { return (node as Identifier).text; }  function each(list) { for (const node of list) .. node.text .. }  sink(textOf, identifier, literal, block, posOf);
# The whole family is written of the parameter, and expected. A Block has no `text`, so no typed form serves all that is expected. Whoever asks for the name expects a member that has it:
# the members that have the name are tested for. A Block and a stranger go by name
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = GetSlot {{*}}key="text" receivers=[L2, L3]
# A name that every member has is read through the family as ever
# RUN(ALL): walk f2 mechanisms=none+TypedOperations+Guesses
# ALL-LABEL: code f2:Body
# ALL: = GetSlot {{*}}key="pos" receivers=[L1, L2, L3]
# RUN(ANSWER): run-in-shell globalThis.sink = (textOf, identifier, literal, block) => { print(textOf(identifier)); print(textOf(literal)); print(textOf(block)); print(textOf({ text: 9 })); block.text = 7; print(textOf(block)); delete literal.text; print(textOf(literal)); };
# ANSWER: 2
# ANSWER-NEXT: 4
# ANSWER-NEXT: undefined
# ANSWER-NEXT: 9
# ANSWER-NEXT: 7
# ANSWER-NEXT: undefined
# ANSWER-NEXT: exited with 0

