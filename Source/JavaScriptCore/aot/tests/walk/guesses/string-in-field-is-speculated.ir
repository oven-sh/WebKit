# What a field of this holds is compared with a character at an index: the text among what it may be is told apart in front of the loop, under a counter and under an index in a field.
# class P { constructor(t) { this.t = t; this.p = 0; }
#   counts() { let n = 0; for (let i = 0; i < this.t.length; i++) if (this.t[i] === "a") n++; return n; }
#   steps() { let n = 0; while (this.p < this.t.length) { if (this.t[this.p] === "a") n++; this.p++; } return n; } }  sink(P);
# RUN: walk f2:Body mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: TypeTest {{*}}testedType=string
# CHECK: isLoopHead=true
# RUN(STEPS): walk f3:Body mechanisms=all
# STEPS-LABEL: code f3:Body
# STEPS: TypeTest {{*}}testedType=string
# STEPS: isLoopHead=true
layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="t" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
