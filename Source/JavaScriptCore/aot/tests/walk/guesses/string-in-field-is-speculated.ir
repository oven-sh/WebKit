}
function f2 name="counts" module=m0 kind=Method flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: L0):
    v1 = Integer
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    v3 = Integer
    v4 = Convert v3 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v2, v4)
  b1(v5, v6):
    LoopHint
    v8 = PropGet v0 key="t" @10
    v9 = PropGet v8 key="length" @11
    v10 = Less v6, v9 @12
    Branch v10 -> taken b2(), notTaken b5()
  b2():
    v11 = PropGet v0 key="t" @20
    v12 = ElemGet v11, v6 @21
    v13 = String string="a"
    v14 = StrictEq v12, v13 @22
    Branch v14 -> taken b3(), notTaken b4(v5)
  b3():
    v15 = Increment v5
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    Jump -> next b4(v16)
  b4(v17):
    v18 = Increment v6
    v19 = Convert v18 declared={type=i32 flags=[IsExpected]}
    Jump -> next b1(v17, v19)
  b5():
    Return v5
}
function f3 name="steps" module=m0 kind=Method flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: L0):
    v1 = Integer
