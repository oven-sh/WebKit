# in a loop one operation that the tests turn from closed into typed pays for them
# function last(o: Point, n) { let x; while (n()) x = o.x; return x; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = IsSlotFilled {{*}}key="x"
# CHECK: = PropGet {{*}}key="x"
# CHECK: = GetSlot {{*}}key="x"

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="x"
    PropDefine v4, v3 key="y"
    v7 = FinishObject v4
    v8 = Call v1, -, v7
    Return v8
}
function f1 name="last" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    v3 = Undefined
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = Call v1, -
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v2 key="x"
    Jump -> next b1(v8)
  b3():
    Return v4
}
