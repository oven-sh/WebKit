# async function each(things) { for await (const thing of things) keep(thing); }
# Whether the loop drives an async generator or calls next() and awaits decides in which context of AsyncLocalStorage it goes on. So the step by the driver is no guess:
# a walk that opens no guesses and knows no built-in calls lays the same two tests and the same step.
# RUN: walk f1:CoroutineBody mechanisms=none+Folding+DirectCalls
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: = TypeTest [[method]] testedType=builtin(AsyncIteratorPrototypeSymbolAsyncIterator)
# CHECK: = TypeTest [[next]] testedType=builtin(AsyncFromSyncIteratorPrototypeNext)|builtin(AsyncGeneratorPrototypeNext)
# CHECK: = TypeTest [[iterator]] testedType=AsyncFromSyncIterator|AsyncGenerator
# CHECK: = StepAsyncGenerator {{*}}calledBuiltin=AsyncGeneratorPrototypeNext

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="each" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = IteratorOpen v0 iteratorKind=Async
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1 iteratorKind=Async
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v6 = Undefined
    Return v6
  b3() handler=b4():
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="keep" [isFreeName]
    v9 = Call v8, -, v5
    Jump -> next b1()
  b4() role=IterationCleanup subject=v1:
    v10 = CatchException
    IteratorClose v1 iteratorKind=Async completion=Throw
    Rethrow v10
}
