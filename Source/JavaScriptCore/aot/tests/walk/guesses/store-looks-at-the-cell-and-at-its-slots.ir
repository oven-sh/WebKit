# a passed test of the shape says nothing of whether an object is frozen, and neither does a filled slot: a freeze sets bits of the order word and leaves both as they are.
# So in front of a stretch that stores, one byte of that word is asked, once for however many stores, beside the slots. A stretch that only reads does not ask it
# function set(o: Point, v) { o.x = v; o.y = v; }    function get(o: Point) { return o.x; }
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = IsNotFrozen
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: [[closed]]() frequency=Rare:
# CHECK-NEXT: = PropSet {{*}}key="x"
# CHECK-NEXT: = PropSet {{*}}key="y"
# CHECK: = IsSlotFilled {{*}}key="x"
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = IsSlotFilled {{*}}key="y"
# CHECK-NEXT: Branch {{*}}notTaken [[closed]]()
# CHECK: = PutSlot {{*}}key="x"
# CHECK: = PutSlot {{*}}key="y"
# RUN(ONCE): walk f1 mechanisms=none+TypedOperations+Guesses
# ONCE-COUNT-1: = IsNotFrozen
# ONCE-NOT: = IsNotFrozen
# RUN(READ): walk f2 mechanisms=none+TypedOperations+Guesses
# READ: = GetSlot {{*}}key="x"
# RUN(READS): walk f2 mechanisms=none+TypedOperations+Guesses
# READS-NOT: IsNotFrozen

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    v6 = NewObject layout=L0
    PropDefine v6, v3 key="x"
    PropDefine v6, v3 key="y"
    v9 = FinishObject v6
    v10 = Call v1, -, v9
    Return v10
}
function f1 name="set" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Convert v0 declared={type=L0}
    PropSet v2, v1 key="x" mode=Strict
    PropSet v2, v1 key="y" mode=Strict
    v5 = Undefined
    Return v5
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = PropGet v1 key="x"
    Return v2
}
