# `o instanceof V` with V a function that is constructed: code may give V another `prototype` or a Symbol.hasInstance at any time, so the guards of the class are asked first, and the operator as written stands on their failing side
# an object with the shape of V says itself whether it stands where it was made. Whatever has another shape is asked as written: V.prototype may stand above anything
# function V(x) { this.x = x; }  function isV(o, C) { return o instanceof C; }  isV(input, V); isV(new V(1), V);
# TODO: instanceof: no guard answers for Symbol.hasInstance on a function or a class object. findClassMember() knows texts alone and says nothing of a name that the static side lacks, so findsOrdinaryHasInstanceForInstanceOf() refuses every constructor function, and every class that Link has not proven to stay as written
# RUN: walk f2 mechanisms=none+TypedOperations+Guesses+DirectCalls+Arrivals
# CHECK-LABEL: code f2:Body
# CHECK: = AreMembersUnchanged
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = HasLayoutPrototype
# RUN(WRITTEN): walk f2 mechanisms=none+TypedOperations+Guesses+DirectCalls+Arrivals
# WRITTEN: = InstanceOf
# no walk of the chain from the object that the function is read off: that read stops where `prototype` holds no object
# RUN(NEVER): walk f2 mechanisms=none+TypedOperations+Guesses+DirectCalls+Arrivals
# NEVER-NOT: GetClassPrototype
# without arms nothing can be asked first
# RUN(WITHHELD): walk f2 mechanisms=none+TypedOperations+DirectCalls+Arrivals
# WITHHELD-LABEL: code f2:Body
# WITHHELD-NOT: ShapeTest
# WITHHELD-NOT: AreMembersUnchanged
# WITHHELD: = InstanceOf

layout L0 kind=Instance name="V" module=m0 constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Construct v0, -, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="input" [isFreeName]
    v5 = NewClosure function=f2
    v6 = Call v5, -, v4, v0 calleeName="isV"
    v7 = Call v5, -, v2, v0 calleeName="isV"
    v8 = NewArray v6, v7 contents=anything
    Return v8
}
function f1 name="V" module=m0 flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x"
    v3 = Undefined
    Return v3
}
function f2 name="isV" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = InstanceOf v0, v1
    Return v2
}
