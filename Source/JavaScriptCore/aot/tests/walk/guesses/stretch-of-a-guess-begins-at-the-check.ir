# a pattern checks what it takes apart for undefined and null, and a test of the shape proves that and more. So the test stands in front of the check: the typed run has no check, and the closed arm has the one that is written
# function sum(options: Options) { const { a, b } = options; return a + b; }  sink(sum, { a: 1, b: 2 });
# it takes the three blocks under ASK in this package's HOOKS.txt, and package 3's buildFormOnShapes()
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = RequireObjectCoercible
# RUN(COUNT): walk f1 mechanisms=none+TypedOperations+Guesses
# COUNT-COUNT-1: = RequireObjectCoercible
# RUN(ANSWER): run-in-shell globalThis.sink = (sum, options) => { print(sum(options)); print(sum({ a: 3, b: 4 })); print(sum("ab")); try { sum(undefined); } catch (error) { print(error instanceof TypeError); } try { sum(null); } catch (error) { print(error instanceof TypeError); } };
# ANSWER: 3
# ANSWER-NEXT: 7
# ANSWER-NEXT: NaN
# ANSWER-NEXT: true
# ANSWER-NEXT: true
# ANSWER-NEXT: exited with 0

layout L0 name="Options" module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = NewObject -, v3, v4 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    v7 = Call v1, -, v2, v6 calleeName="sink"
    Return v7
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Convert v0 declared={type=L0}
    v2 = RequireObjectCoercible v1
    v3 = PropGet v2 key="a"
    v4 = PropGet v2 key="b"
    v5 = Add v3, v4
    Return v5
}
