# interface Holder { child: { a: number, b: number } | { a: number, z: number } }  function sum(h: Holder) { const c = h.child as any; return c.a + c.b; }  sink(sum, { child: { a: 1, b: 2 } }, { child: { a: 3, z: 4 } });
# The field `child` is written to be one of two strangers, for which there is no one test: nothing would be tested and both reads would stay closed.
# What is read there is asked for `a` and for `b`, and of the two one alone has both: that one is expected
# RUN: walk f1 mechanisms=none+TypedOperations+Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = ShapeTest {{*}}layouts=[L0]
# CHECK: = GetSlot {{*}}key="a" receivers=[L0]
# CHECK: = GetSlot {{*}}key="b" receivers=[L0]
# RUN(ANSWER): run-in-shell globalThis.sink = (sum, first, second) => { print(sum(first)); print(sum(second)); print(sum({ child: { a: 5, b: 6 } })); };
# ANSWER: 3
# ANSWER-NEXT: NaN
# ANSWER-NEXT: 11
# ANSWER-NEXT: exited with 0

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Holder" module=m0 fields=[{key="child" declared={type=L0|L1} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = NewObject -, v3, v4 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = FinishObject v7
    v9 = Integer integer=3
    v10 = Integer integer=4
    v11 = NewObject -, v9, v10 layout=L1 fields=[0, 1]
    v12 = FinishObject v11
    v13 = NewObject -, v12 layout=L2 fields=[0]
    v14 = FinishObject v13
    v15 = Call v1, -, v2, v8, v14 calleeName="sink"
    Return v15
}
function f1 name="sum" module=m0 length=1 thisType={type=anything} parameters=[{type=L2}] results=[{type=anything}] {
  b0(v0: L2):
    v1 = Convert v0 declared={type=L2}
    v2 = PropGet v1 key="child"
    v3 = PropGet v2 key="a"
    v4 = PropGet v2 key="b"
    v5 = Add v3, v4
    Return v5
}
