#     case Tag.One: return "one";
#     case Tag.Two:
#     case Tag.Three: return "two or three";
#     case Tag.Seven: return "seven";
#     case Tag.MinusOne: return "minus one";
#     default: return "none";
#   }
# }
# function pickAndTell(shape: Shape): string {
#   const tag = shape.tag;
#   switch (tag) {
#     case Tag.Zero: return "zero";
#     case Tag.One: return "one";
#     case Tag.Two: return "two";
#     default: return "none: " + String(tag);
#   }
# }
# (globalThis as any).pick = pick;
# (globalThis as any).pickAndTell = pickAndTell;
