# CHECK: Branch [[test]] ->
# CHECK: = GetStringLength
# CHECK: frequency=Rare
# outside a loop nothing is declared of the operand, so no test pays: function once(s, p) { if (typeof s === "string") return [s.charCodeAt(p)]; }
# RUN(ONCE): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls+Guesses
# ONCE-LABEL: code f2:Body
# ONCE-NOT: testedType=i32
# ONCE: = NewArray
# the operand is proven to be an object, so no such test can pass: function never(s, p, n) { the same loop behind a test that p is an object }
# RUN(NEVER): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls+Guesses
# NEVER-NOT: testedType=i32

