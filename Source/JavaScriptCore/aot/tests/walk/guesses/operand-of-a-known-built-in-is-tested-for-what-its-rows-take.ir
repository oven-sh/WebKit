# the callee is known and the receiver lies in its row, and one operand is unknown. In a loop that operand is tested for what every row takes: behind the test the call goes by its row, and where the test fails it is made as it is written
# function sum(s, p, n) { if (typeof s !== "string") return; let t = 0; for (let i = 0; i < n; i++) t = t + s.charCodeAt(p); return t; }
