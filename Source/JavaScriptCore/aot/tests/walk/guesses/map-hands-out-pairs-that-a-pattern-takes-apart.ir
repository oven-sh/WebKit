    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="each" module=m0 length=1 thisType={type=anything} parameters=[{type=undefined|null|Map<undefined|null|string, number> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: undefined|null|Map<undefined|null|string, number>):
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v6 = Undefined
    Return v6
  b3() handler=b8():
    v7 = IteratorOpen v5 elementCount=2 [isDestructuring]
    Jump -> next b4()
  b4() handler=b7():
    v8 = IteratorResume v7 stepIndex=0
    v9 = ResultAt v8 index=1
    Jump -> next b5()
  b5() handler=b7():
    v10 = IteratorResume v7 stepIndex=1
    v11 = ResultAt v10 index=1
    Jump -> next b6()
  b6() handler=b8():
    IteratorClose v7
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="keep" [isFreeName]
    v15 = Call v14, -, v9, v11
    Jump -> next b1()
  b7() role=IterationCleanup subject=v7 handler=b8():
    v16 = CatchException
    IteratorClose v7 completion=Throw
