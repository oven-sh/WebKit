# CHECK: [[found]]: {{*}} = MapNext {{*}}, [[table]], [[entry]]
# CHECK: [[key]]: {{*}} = ResultAt [[found]] index=2
# CHECK: [[value]]: {{*}} = ResultAt [[found]] index=3
# CHECK: Jump -> next {{*}}, [[key]], [[value]])
# CHECK: = TypeTest {{*}} testedType=Map
# CHECK: = DestructureIterable {{*}} count=2 [readsListsByIndex]
# RUN(NOPAIR): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# NOPAIR-NOT: = NewArray
# RUN(ALONE): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# ALONE-NOT: builtinClass=Array
# ALONE-NOT: = GetArrayElement
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Guesses
# NEVER-NOT: NewHeapWords

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
