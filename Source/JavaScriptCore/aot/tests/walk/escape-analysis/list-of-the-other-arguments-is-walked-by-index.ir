# Whoever calls makes the list of the other arguments for the call alone, as a list is made. Nothing in the loop names it, so no read of it runs code: a for-of reads it by index, the length anew at each turn.
# There is no iterator, no result object and no call, and a way out of the loop has nothing to close: no `return` lies on the iterator of a list or above it, and the locks let nobody put one there.
# function each(...values) { for (const value of values) { if (keep(value)) break; } }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: ([[values]]: Array {{*}}entry=0
# CHECK: ([[position]]: int[0, 34359738368] {{*}}isLoopHead=true
# CHECK: [[length]]: {{*}} = GetArrayLength
# CHECK: [[inside]]: boolean {{*}} = Less [[position]], [[length]] form=Integers
# CHECK: = GetArrayElement {{*}}level=Proven
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Folding+EscapeAnalysis
# NEVER-NOT: @@iterator
# NEVER-NOT: NewHeapWords
# NEVER-NOT: key="next"
# NEVER-NOT: key="return"
# NEVER-NOT: IsPristine
# RUN(WITHHELD): walk f1 mechanisms=none
# WITHHELD: = PropGet {{*}}key=@@iterator
# WITHHELD: = NewHeapWords
# WITHHELD: = PropGet {{*}}key="return"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
