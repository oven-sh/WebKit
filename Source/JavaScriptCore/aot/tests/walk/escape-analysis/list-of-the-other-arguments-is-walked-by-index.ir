  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="each" module=m0 flags=[HasRestParameter] thisType={type=anything} parameters=[{type=Array flags=[IsFromCompiler, OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b5(), notTaken b2()
  b2() handler=b6():
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="keep" [isFreeName]
    v8 = Call v7, -, v5
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    IteratorClose v1
    Jump -> next b5()
  b4() handler=b6():
    Jump -> next b1()
  b5():
    v10 = Undefined
    Return v10
  b6() role=IterationCleanup subject=v1:
    v11 = CatchException
    IteratorClose v1 completion=Throw
