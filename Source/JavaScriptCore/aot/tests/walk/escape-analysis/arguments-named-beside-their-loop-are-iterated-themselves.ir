# a loop over `arguments` reads the hidden list in place of the object, which is then never made. Each step of the protocol reads the object anew, so the list stands for it to the last step only where nothing but the open names the object, or nothing can come between the steps.
# whatever else names the object may change what a later step finds: there the object is made and iterated itself, by the protocol. The records are what the front end writes for the five functions, without the library.
# function alone() { for (const value of arguments) keep(value); }
# function stored() { for (const value of arguments) { arguments[2] = "Z"; keep(value); } }
# function cut() { for (const value of arguments) { arguments.length = 1; keep(value); } }
# function row() { const [first, second] = arguments; arguments[0] = "Z"; keep(first, second); }
# function between() { const [first = (arguments[1] = "Y"), second] = arguments; keep(first, second); }
# RUN: walk f1 mechanisms=none+TypedOperations+UnboxedNumbers+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: [[list]]: Array{{*}} = Unbox
# CHECK: = GetArrayLength [[list]]
# CHECK: = GetArrayElement [[list]], {{*}}level=Proven
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: = CreateUnmappedArguments
# NEVER-NOT: @@iterator
# RUN(NAMED): walk f2 f3 f5 mechanisms=all
# NAMED-LABEL: code f2:Body
# NAMED: = CreateUnmappedArguments
# NAMED: = PropGet {{*}}key=@@iterator
# NAMED: = ElemSet
# NAMED-LABEL: code f3:Body
# NAMED: = CreateUnmappedArguments
# NAMED: = PropGet {{*}}key=@@iterator
# NAMED: = PropSet {{*}}key="length"
# NAMED-LABEL: code f5:Body
# NAMED: = CreateUnmappedArguments
# NAMED: = PropGet {{*}}key=@@iterator
# NAMED: = ElemSet
# RUN(UNREAD): walk f2 f3 f5 mechanisms=all
# UNREAD-NOT: level=Proven
# RUN(ROW): walk f4 mechanisms=all
# ROW-LABEL: code f4:Body
# ROW-COUNT-2: = GetArrayElement {{*}}level=Proven
# ROW: = ElemSet
# RUN(ROWNEVER): walk f4 mechanisms=all
# ROWNEVER-NOT: @@iterator
# ROWNEVER-NOT: = DestructureIterable
# RUN(WITHHELD): walk f1 mechanisms=none
# WITHHELD: = CreateUnmappedArguments
# WITHHELD: = PropGet {{*}}key=@@iterator

module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="keep" [isFreeName]
    v7 = Call v6, -, v0, v1, v2, v3, v4 calleeName="keep"
    v8 = Undefined
    Return v8
}
function f1 name="alone" module=m0 flags=[HasArgumentCount, HasHiddenRest, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: Array):
    v2 = CreateUnmappedArguments v0, v1
    v3 = IteratorOpen v2
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v8 = Undefined
    Return v8
  b3():
    Jump -> next b4()
  b4() handler=b5():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="keep" [isFreeName]
    v11 = Call v10, -, v7 calleeName="keep"
    Jump -> next b1()
  b5() role=IterationCleanup subject=v3:
    v12 = CatchException
    IteratorClose v3 completion=Throw
    Rethrow v12
}
