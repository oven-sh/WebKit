# Only `sum` names the list that a call of `make` returns, and it only reads it: behind the inner loop the list is dead, and ReleaseArray lets the next `[]` reuse the cell. `local` allocates its list itself. `kept` pushes the list onto another one.
# function make(n) { const list = []; if (n > 1) list.push(n); if (n > 2) list.push(n + 1); return list; }
# function sum(n) { let t = 0; for (let i = 0; i < n; i++) { const list = make(i); for (let k = 0; k < list.length; k++) t += list[k]; } return t; }
# function local(n) { let t = 0; for (let i = 0; i < n; i++) { const list = []; list.push(i); list.push(t); t += list.length; } return t; }
# function kept(n, all) { let t = 0; for (let i = 0; i < n; i++) { const list = make(i); all.push(list); t += list.length; } return t; }
