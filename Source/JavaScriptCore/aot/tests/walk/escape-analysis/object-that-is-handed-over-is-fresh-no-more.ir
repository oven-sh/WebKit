# the object is passed to the call, so from there on somebody else has it: it is made, and the read behind the call is a read
# function box(v, f) { const o = { x: v }; f(o); return o.x; }
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: = NewObject {{*}}layout=L0
# CHECK: = Call
# CHECK: [[x]]: {{*}}Get{{*}}key="x"
# CHECK: Return [[x]]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="box" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L0
    PropDefine v2, v0 key="x"
    v4 = FinishObject v2
    v5 = Call v1, -, v4
    v6 = PropGet v4 key="x"
    Return v6
}
