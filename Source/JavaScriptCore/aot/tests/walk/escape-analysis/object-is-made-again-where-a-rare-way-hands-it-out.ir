# only the way that throws hands the object out. It is made again in front of the call that takes it, out of what the state knows it to hold, and nothing needs the first allocation: the way that returns allocates nothing
# function check(code, msg, bad) { const e = { code, msg }; if (bad) throw wrap(e); return e.code; }
# TODO: known-state-and-effects-3a: J6 is off at its door, prepareOperandsThatLeave(): it cost the application's build and bought nothing that its five turns or TypeScript 6 show
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: b0([[code]]:
# CHECK-NOT: = NewObject
# CHECK: Branch
# CHECK: = NewObject {{*}}layout=L0
# CHECK: = Call
# CHECK: Throw
# CHECK-NOT: = NewObject
# CHECK: Return [[code]]
# A handler is taken seldom, and this one returns what the call gives: the handler alone allocates
# function guarded(code, msg, risky) { const e = { code, msg }; try { risky(); } catch { return keep(e); } return e.code; }
# RUN(CAUGHT): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+Handlers+DirectCalls
# CAUGHT-LABEL: code f2:Body
# CAUGHT: b0([[code]]:
# CAUGHT-NOT: = NewObject
# CAUGHT: Return [[code]]
# CAUGHT-NOT: = NewObject
# CAUGHT: role=CatchHandler
# CAUGHT: = NewObject {{*}}layout=L0
# CAUGHT: = CallDirect
# CAUGHT-NOT: = NewObject
# What was stored into the object in front of the branch is what the new cell is made with
# function stored(code, msg, bad) { const e = { code, msg }; e.code = msg; if (bad) throw wrap(e); return e.code; }
# RUN(STORED): walk f8 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# STORED-LABEL: code f8:Body
# STORED: b0({{*}}, [[msg]]:
# STORED: Branch
# STORED: = NewObject {{*}}[[msg]], [[msg]] {{*}}layout=L0
# The handler goes on where the other way goes on, and the object is named there: it stays one cell, made where it is written
# function reported(code, msg, risky, report) { const e = { code, msg }; try { risky(); } catch { report(e); } return e.code; }
# RUN(READ): walk f3 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+Handlers
# READ-LABEL: code f3:Body
# READ: = NewObject {{*}}layout=L0
# READ: role=CatchHandler
# READ-NOT: = NewObject
# READ: [[read]]: {{*}}Get{{*}}key="code"
# READ: Return [[read]]
# A way that is as likely as the one that made the object takes it as it is
# function likely(code, msg, c, f) { const e = { code, msg }; if (c) return f(e); return e; }
# RUN(LIKELY): walk f4 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# LIKELY-COUNT-1: = NewObject
# LIKELY-NOT: = NewObject
# Under a handler the object stays one cell: the handler may name it
# function under(code, msg, bad, f) { const e = { code, msg }; try { if (bad) throw f(e); } catch { } return e.code; }
# RUN(UNDER): walk f6 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+Handlers
# UNDER-COUNT-1: = NewObject
# UNDER-NOT: = NewObject
# The object itself is thrown behind the call
# function thrown(code, msg, bad, f) { const e = { code, msg }; if (bad) { f(e); throw e; } return e.code; }
# RUN(THROWN): walk f7 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# THROWN-COUNT-1: = NewObject
# THROWN-NOT: = NewObject

layout L0 name="Failure" module=m0 fields=[{key="code" declared={type=anything} flags=[IsRequired]}, {key="msg" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="last" module=m0 declared={type=anything}
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    v6 = NewClosure function=f3
    v7 = Call v1, -, v6
    v8 = NewClosure function=f4
    v9 = Call v1, -, v8
    v10 = NewClosure function=f6
    v11 = Call v1, -, v10
    v12 = NewClosure function=f7
    v13 = Call v1, -, v12
    v14 = NewClosure function=f8
    v15 = Call v1, -, v14
    Return v15
}
