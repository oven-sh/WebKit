# Two ways of a call meet in one list. `made` gets a list that the way itself made on both of them: nothing else names it, and ReleaseArray lets it go behind the loop that reads it. In `sum`, one of the ways hands on the list that `sum` made before the ways parted and still names behind them, so the list that meets is not let go. In `handed`, nothing names that list behind the ways, and it is let go. `stepped` is `handed` in a loop over the pickers: what the open iteration holds is asked, and the list is let go. `held` steps over the list itself, which the iteration still names, so it is not let go.
# function make(n: number): number[] { const list: number[] = []; for (let i = 0; i < n; i++) list.push(i + n); return list; }
# class Same { pick(list: number[]): number[] { return list; } }
# class Other { pick(list: number[]): number[] { return make(list.length); } }
# class Longer { pick(list: number[]): number[] { return make(list.length + 1); } }
# function sum(pickers: (Same | Other)[], n: number): number {
#   let total = 0;
#   let kept: number[] = [];
#   for (let i = 0; i < n; i++) {
#     const list = make(20 + (i & 7));
#     const picked = pickers[i & 1]!.pick(list);
#     for (let k = 0; k < picked.length; k++) total += picked[k]!;
#     for (let k = 0; k < kept.length; k++) total += kept[k]! * k;
#     kept = list;
#   }
#   return total;
# }
# function made(pickers: (Longer | Other)[], n: number): number {
#   let total = 0;
#   for (let i = 0; i < n; i++) {
#     const picked = pickers[i & 1]!.pick([i]);
#     for (let k = 0; k < picked.length; k++) total += picked[k]!;
#   }
#   return total;
# }
# function handed(pickers: (Same | Other)[], n: number): number {
#   let total = 0;
#   for (let i = 0; i < n; i++) {
#     const picked = pickers[i & 1]!.pick(make(20 + (i & 7)));
#     for (let k = 0; k < picked.length; k++) total += picked[k]!;
#   }
#   return total;
# }
# function stepped(pickers: (Same | Other)[], n: number): number {
#   let total = 0;
#   for (const picker of pickers) {
#     const list = make(20 + (n & 7));
#     const picked = picker.pick(list);
#     for (let k = 0; k < picked.length; k++) total += picked[k]!;
#   }
#   return total;
# }
# function held(pickers: (Same | Other)[], n: number): number {
#   let total = 0;
#   for (let i = 0; i < n; i++) {
#     const list = make(4 + (i & 3));
#     for (const item of list) {
#       const picked = pickers[item & 1]!.pick(list);
#       for (let k = 0; k < picked.length; k++) total += picked[k]!;
#     }
#   }
#   return total;
# }
# print(sum([new Same(), new Other()], 200));
# print(made([new Longer(), new Other()], 200));
