# function stays(a, b) { const list = [a, b, 1, 2, 3, 4, 5, 6, 7]; let s = 0; for (let i = 0; i < list.length; i++) s += list[i]; return s; }
# function leaves(a, b) { const list = [a, b]; for (let i = 0; i < 9; i++) sink(list); return list[0]; }
# function isStoredTo(a, b) { const list = [a, b]; for (let i = 0; i < 9; i++) list[i] = list[i] + 1; return list[0]; }
# sink(stays, leaves, isStoredTo);
