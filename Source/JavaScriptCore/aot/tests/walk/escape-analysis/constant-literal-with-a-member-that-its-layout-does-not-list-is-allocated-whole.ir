# `{ height: 10, style: 7 }` is constant data, and the layout that it is written of lists `style` and `width` alone. The member that the layout does not list is a definition under its name like any other: Link appends
# `height`, the allocation lists both members in their turn, nothing is defined by name behind it, and the record does not escape. The cell is as allocated, so the store behind it looks at nothing
# function grow() { const o = { height: 10, style: 7 }; o.width = 5; return o; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = NewObject {{*}}fields=[2, 0]
# CHECK: PutSlotOrAdd {{*}}key="width"
# RUN(NAME): walk f1 mechanisms=all
# NAME-NOT: PropDefine
# RUN(LOOK): walk f1 mechanisms=all
# LOOK-NOT: = IsNotFrozen
# RUN(SHELL): run-in-shell globalThis.sink = (grow, other) => { if (!grow) return; const o = grow(); print(Object.keys(o).join() + ":" + o.height + ":" + o.style + ":" + o.width); };
# SHELL: height,style,width:10:7:5

layout L0 name="Options" module=m0 fields=[{key="style" declared={type=anything}}, {key="width" declared={type=anything}}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="height" value=Number{value=10}}, {key="style" value=Number{value=7}}]} module=m0
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="width"
    v6 = FinishObject v4
    v7 = Call v1, -, v2, v6
    Return v7
}
function f1 name="grow" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Integer integer=5
    PropSet v0, v1 key="width"
    Return v0
}
