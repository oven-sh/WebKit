    v8 = Less v6, v0
    Branch v8 -> taken b2(), notTaken b6()
  b2():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="id" [isFreeName]
    v11 = Double number=0.25
    v12 = Call v10, -, v11 calleeName="id"
    v13 = TypeTest v12 testedType=number
    Branch v13 -> taken b3(| 0), notTaken b4(| 0)
  b3(v14):
