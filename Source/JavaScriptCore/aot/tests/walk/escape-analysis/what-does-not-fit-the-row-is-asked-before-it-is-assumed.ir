# function tally(turns) { let total = 0; const read = () => total; for (let at = 0; at < turns; at++) { const got = id(0.25); total = typeof got === "number" ? got * 2 : 1; } return read(); }
# tally(0);
# print(tally(2));
# print("went on");
# The state answers for a read of `total`, and what comes round to the head of the loop stands for such a read. Where the value in hand says less of itself than Link says of the slot, it stands under an AssumeType: no test, no code.
# What makes that true is the door at the store. A raw number says by its form that it is a number and no more, so the door asks it as it is, and a raw number is assumed only where it is shown to fit: by its form, or by
# such a question in the block that made it. Unasked, the head would take the double in an Int32, and NumberToInteger makes 0 of 0.5.
# THE RED CONTROL. The lie, testing=UnseenCodeAnswersUndefined: Link takes what the shell's `id` gives for undefined, so nothing passes the test for a number, and 0 and 1 are all that Link sees stored: the row is an integer.
# RUN: walk f1 mechanisms=all testing=UnseenCodeAnswersUndefined
# CHECK-LABEL: code f1:Body
# CHECK: CheckProof [[stored]] checkedType=i{{*}}source=SlotOfScope
# CHECK: @Double = AssumeType [[stored]] provenType=i
# Where proofs are checked the question stands behind the AssumeType once more, of the raw number too.
# RUN(CHECKED): walk f1 mechanisms=all testing=CheckProofsAtRunTime,UnseenCodeAnswersUndefined
# CHECKED-LABEL: code f1:Body
# CHECKED: @Double = AssumeType [[assumed]] provenType=i
# CHECKED-NEXT: CheckProof [[assumed]] checkedType=i{{*}}source=SlotOfScope
# RUN(ALL): run-in-shell mechanisms=all testing=UnseenCodeAnswersUndefined
# ALL: AOT: f{{*}} at {{*}}: what a slot of a scope holds is not of the type that the compiler has proven of it.
# ALL-NOT: went on
# ALL: crashed with
# RUN(CALLS): run-in-shell mechanisms=-Inlining testing=UnseenCodeAnswersUndefined
# CALLS: AOT: f{{*}} at {{*}}: what a slot of a scope holds is not of the type that the compiler has proven of it.
# CALLS-NOT: went on
# CALLS: crashed with

layout L0 kind=Environment module=m0 fields=[{key=@"0" declared={type=anything|absent} variableName="total"}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
