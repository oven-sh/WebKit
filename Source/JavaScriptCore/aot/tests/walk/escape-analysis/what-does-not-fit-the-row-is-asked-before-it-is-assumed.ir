  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = Integer
    v3 = Call v1, -, v2 calleeName="tally"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="print" [isFreeName]
    v6 = Integer integer=2
    v7 = Call v1, -, v6 calleeName="tally"
    v8 = Call v5, -, v7 calleeName="print"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="print" [isFreeName]
    v11 = String string="went on"
    v12 = Call v10, -, v11 calleeName="print"
    v13 = Undefined
    Return v13
}
function f1 name="tally" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    v2 = Integer
    PutEnvironmentField v1, v2 layout=L0
    v4 = NewClosure v1 function=f2
    v5 = Integer
    Jump -> next b1(v5)
  b1(v6):
