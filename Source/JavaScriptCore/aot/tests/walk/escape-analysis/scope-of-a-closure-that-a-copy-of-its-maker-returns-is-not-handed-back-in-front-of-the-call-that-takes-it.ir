# `counter` is copied into `use`, and the closure that the copy returns is taken by the next call of `use`: it has one user, so it will lie in the frame, and a closure in the frame marks no scope.
# The release of the scope stands at the copy's Return, in front of that call: it may not release, or the cell waits for its next maker while the closure still reads it. In `counter` itself the scope is born on the way of the closure: the way that returns the number makes none, and has none to release.
# function counter(keep) { let id = 0; function bump() { id++; } bump(); if (keep) return () => ++id; return id; }  function use(take) { return take(counter(true)) + 1; }  sink(counter, use);
