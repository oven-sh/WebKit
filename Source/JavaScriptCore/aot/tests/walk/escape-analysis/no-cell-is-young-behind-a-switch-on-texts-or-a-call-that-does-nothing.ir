# a switch on texts may resolve a rope, which collects, and it is the end of a block: no record stands for it
# function switched(v, s) { const o = { x: v }; switch (s) { case "a": o.y = v; } return o; }
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: = NewObject
# CHECK: SwitchString
# CHECK: = PutSlotOrAdd {{*}}key="y"
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# NEVER-NOT: OwnerIsYoung
# Link says of the callee that it neither collects nor runs other code. It polls where it sets up its frame all the same
# what the call gives is stored, or the sweep would drop a call that does nothing, and the poll with it
# function called(v) { const o = { x: v }; o.y = leaf(v); kept = o; }  function leaf(a) { return a === null; }
# RUN(LEAF): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+DirectCalls
# LEAF-LABEL: code f2:Body
# LEAF: = NewObject
# LEAF: = CallDirect
# LEAF: = PutSlotOrAdd {{*}}key="y"
# RUN(LEAFNOT): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis+DirectCalls
# LEAFNOT-NOT: OwnerIsYoung

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything}}] ownFieldCount=2
variable g0 name="kept" module=m0 declared={type=anything}
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    Return v5
}
function f1 name="switched" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    SwitchString v1 strings=["a"] -> case b1(), otherwise b2()
  b1():
    PropSet v3, v0 key="y" mode=Strict
    Jump -> next b2()
  b2():
    Return v3
}
function f2 name="called" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = Call v1, -, v0 calleeName="leaf"
    PropSet v3, v4 key="y" mode=Strict
    PutModuleVariable v3 variable=g0
    Return v0
}
function f3 name="leaf" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=null
    Return v1
}
