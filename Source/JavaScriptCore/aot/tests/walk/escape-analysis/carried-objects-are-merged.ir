# A loop carries an object that nothing else names: the header carries its slots beside it, a call of unseen code ends nothing of them, and nothing needs an allocation
# function sum(n, f) { let p = { x: n }; for (let i = 0; i < 10; i++) { f(); p = { x: p.x }; } return p.x; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = Call
# CHECK: Return
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: = NewObject
# NEVER-NOT: = GetSlot
# NEVER-NOT: = PropGet
# What the loop leaves behind is allocated behind it, once
# function last(n, f) { let p = { x: n }; for (let i = 0; i < 10; i++) { f(); p = { x: p.x }; } return p; }
# RUN(LAST): walk f2 mechanisms=all
# LAST-LABEL: code f2:Body
# LAST-NOT: = NewObject
# LAST: = Call
# LAST-NOT: = PropGet
# LAST: = NewObject
# LAST-NOT: = NewObject
# LAST: Return
# The object that enters has another name behind the loop: the loop carries cells
# function named(n, f) { const first = { x: n }; let p = first; for (let i = 0; i < 10; i++) { f(); p = { x: p.x }; } first.x = f; return p === first; }
# RUN(NAMED): walk f3 mechanisms=all
# NAMED-LABEL: code f3:Body
# NAMED: = NewObject
# NAMED: = NewObject
# One object comes round in two parameters
# function twice(n, f) { let p = { x: n }, q = { x: f }; for (let i = 0; i < 10; i++) { f(); p = q = { x: p.x }; } return p === q; }
# RUN(TWICE): walk f4 mechanisms=all
# TWICE-LABEL: code f4:Body
# TWICE: = NewObject
# TWICE: = NewObject
# TWICE: = NewObject

