# function one(path) { if (arguments.length === 1) return first(path); return wrap(rest(arguments)); }
# The front end makes `arguments` at the head of the function. The way that asks for the length alone makes nothing: the call that takes the object makes it, in front of itself, and the sweep drops the one at the head.
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = CreateUnmappedArguments
# CHECK: Branch
# CHECK-NOT: = CreateUnmappedArguments
# CHECK: key="first"
# CHECK-NOT: = CreateUnmappedArguments
# CHECK: key="rest"
# CHECK: = CreateUnmappedArguments
# CHECK: = Call
# CHECK-NOT: = CreateUnmappedArguments
# function both(c) { if (c) return left(arguments); return right(arguments); }
# Each way makes its own: no way makes two
# RUN(BOTH): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# BOTH-LABEL: code f2:Body
# BOTH-NOT: = CreateUnmappedArguments
# BOTH: Branch
# BOTH: = CreateUnmappedArguments
# BOTH: Return
# BOTH: = CreateUnmappedArguments
# BOTH: Return
# function twice(c) { if (c) { log(arguments); return keep(arguments); } return 0; }
# Behind the first call the object is named again: it is one cell, made on the one way that names it
# RUN(TWICE): walk f3 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# TWICE-LABEL: code f3:Body
# TWICE-NOT: = CreateUnmappedArguments
# TWICE: Branch
# TWICE: = CreateUnmappedArguments
# TWICE-NOT: = CreateUnmappedArguments
# function stored(c) { if (c) { arguments[0] = 1; return keep(arguments); } return 0; }
# A store changes what the object holds: the object stands in front of it
# RUN(STORED): walk f4 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# STORED-LABEL: code f4:Body
# STORED-NOT: = CreateUnmappedArguments
# STORED: Branch
# STORED: = CreateUnmappedArguments
# STORED-NOT: = CreateUnmappedArguments
# function looped(a) { do { } while (keep(arguments)); return a; }
# An object from in front of a loop is one object in every turn
# RUN(LOOPED): walk f5 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# LOOPED-LABEL: code f5:Body
# LOOPED: = CreateUnmappedArguments
# LOOPED: LoopHint
# LOOPED-NOT: = CreateUnmappedArguments
# function returned(c) { if (c) return arguments; return keep(arguments); }
# What the end of a block names is no call
# RUN(RETURNED): walk f6 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# RETURNED-LABEL: code f6:Body
# RETURNED: = CreateUnmappedArguments
# RETURNED: Branch
# RETURNED-NOT: = CreateUnmappedArguments
# RUN(WITHHELD): walk f1 mechanisms=none+TypedOperations+Folding
# WITHHELD-LABEL: code f1:Body
# WITHHELD: = CreateUnmappedArguments
# WITHHELD: Branch
# WITHHELD-NOT: = CreateUnmappedArguments

