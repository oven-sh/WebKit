# a parameter of a join is another cell on each way. What every way knows of its own cell is known of the parameter: neither is frozen, each holds its properties in slots, both list the same keys.
# One of the two still has a name behind the join, so the parameter is no object that only this code has. The store that creates a property is typed all the same, without a look at the cell
# function make(c, v, w) { const a = { x: v }; const o = c ? a : { x: w }; o.y = v; return [a, o]; }
# TODO: known-state-and-effects-3a: J2 is off at its door, KnownJoin::lookAtWays(): it cost the application's build and bought nothing that its five turns or TypeScript 6 show
# RUN: walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CHECK-LABEL: code f1:Body
# CHECK: = NewObject
# CHECK: = NewObject
# CHECK: = PutSlotOrAdd {{*}}key="y"{{*}}orderWordAfter=
# RUN(NONE): walk f1 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# NONE-NOT: IsNotFrozen
# NONE-NOT: = PropSet
# Unseen code has had one of the two in its hands: nothing is known of that cell, so nothing is known of the parameter
# function lent(c, v, f) { const a = { x: v }; let o = a; if (!c) { o = { x: v }; f(o); } o.y = v; return [a, o]; }
# RUN(LENT): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# LENT-LABEL: code f2:Body
# LENT: = PropSet {{*}}key="y"
# RUN(CLOSED): walk f2 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# CLOSED-NOT: = PutSlotOrAdd
# One object, and each way has stored another number into its slot: the read is a parameter, and nothing needs the object
# function pick(c) { const o = { x: 7 }; if (c) o.x = 1; else o.x = 2; return o.x; }
# RUN(SLOT): walk f3 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# SLOT-LABEL: code f3:Body
# SLOT: Branch
# SLOT: ([[x]]:
# SLOT: Return [[x]]
# RUN(GONE): walk f3 mechanisms=none+TypedOperations+Folding+EscapeAnalysis
# GONE-NOT: = NewObject
# GONE-NOT: GetSlot
# GONE-NOT: PutSlot

layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything}}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    v6 = NewClosure function=f3
    v7 = Call v1, -, v6
    Return v7
}
function f1 name="make" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = FinishObject v3
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4)
  b2():
    v5 = NewObject -, v2 layout=L0 fields=[0]
    v6 = FinishObject v5
    Jump -> next b3(v6)
  b3(v7):
    PropSet v7, v1 key="y" mode=Strict
    v9 = NewArray v4, v7 contents=anything
    Return v9
}
function f2 name="lent" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = FinishObject v3
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4)
  b2():
    v5 = NewObject -, v1 layout=L0 fields=[0]
    v6 = FinishObject v5
    v7 = Call v2, -, v6
    Jump -> next b3(v6)
  b3(v8):
    PropSet v8, v1 key="y" mode=Strict
    v10 = NewArray v4, v8 contents=anything
    Return v10
}
function f3 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=7
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v4 = Integer integer=1
    PropSet v3, v4 key="x" mode=Strict
    Jump -> next b3()
  b2():
    v6 = Integer integer=2
    PropSet v3, v6 key="x" mode=Strict
    Jump -> next b3()
  b3():
    v8 = PropGet v3 key="x"
    Return v8
}
