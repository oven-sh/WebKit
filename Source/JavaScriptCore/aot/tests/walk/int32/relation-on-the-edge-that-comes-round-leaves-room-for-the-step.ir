# what is written of a variable at the head of a loop is what enters from in front and what comes round. A relation that the program asks on the edge that comes round cuts the latter: what lies below an int32 has room for one more,
# what lies above one has room for one less. A `continue` goes to the same test. Nothing is reported
# function up(to: int32): int32 { let i: int32 = 0; do i++; while (i < to); return i; }  function down(to: int32): int32 { let i: int32 = 0; do i--; while (i > to); return i; }
# function past(to: int32, skip: boolean): int32 { let i: int32 = 0; do { i++; if (skip) continue; } while (i < to); return i; }
# RUN: walk f1 f2 f3 mechanisms=none
# CHECK-LABEL: code f1:Body
# CHECK-LABEL: code f2:Body
# CHECK-LABEL: code f3:Body

