  b1(v3: i32):
    LoopHint @2
    v5 = Increment v3 @3
    v6 = Convert v5 declared={type=i32 flags=[IsInt32Promise]} @3
    v7 = Less v6, v0 @4
    Branch v7 -> taken b1(v6), notTaken b2() @4
  b2():
    Return v6 @5
}
