  b1(v4: i32):
    LoopHint @10
    v6 = Increment v4 @11
    v7 = Convert v6 declared={type=i32 flags=[IsInt32Promise]} @11
    v8 = ToBoolean v1 @12
    Branch v8 -> taken b2(), notTaken b3() @12
  b2():
