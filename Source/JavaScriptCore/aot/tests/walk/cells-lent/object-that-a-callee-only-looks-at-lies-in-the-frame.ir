# The sweep has counted who uses each object. One that a single chain of names leads to a direct call, whose callee only looks at what arrives there, lies in the frame of its maker: nobody holds it when the call has returned.
# v2 goes to `area`, which reads two fields of it. v5 goes to `keep`, which lays it in a variable. v8 goes to `area` and is also returned. v11 goes to `area` by a tail call, which takes the frame away. v2 alone lies in the frame.
# function area(o) { return o.w * o.h; }  function keep(o) { held = o; return 1; }  function maker(x) { area({ w: x, h: x }); keep({ w: x, h: x }); .. }  publish(maker, () => held);
# RUN: sweep-code mechanisms=all
# CHECK: v2: L0 @Cell = NewObject -, v0, v0 layout=L0 {{*}}storage=Frame
# CHECK: v5: L0 @Cell = NewObject
# CHECK-NOT: storage=Frame
# CHECK: # cells of the frame: verified
# RUN(WITHHELD): sweep-code mechanisms=all-CellsInFrames
# WITHHELD-NOT: storage=Frame
# -- code
# code f3:Body {
#   b0(v0: anything @JSValue, v1: boolean @Boolean) entry=0:
#     v2: L0 @Cell = NewObject -, v0, v0 layout=L0 fields=[0, 1] traits=[mayCollect, mayTouchMemory]
#     v3: L0 @JSValue = Box v2
#     v4: anything @JSValue = CallDirect v3 function=f1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v5: L0 @Cell = NewObject -, v0, v0 layout=L0 fields=[0, 1] traits=[mayCollect, mayTouchMemory]
#     v6: L0 @JSValue = Box v5
#     v7: anything @JSValue = CallDirect v6 function=f2 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     v8: L0 @Cell = NewObject -, v0, v0 layout=L0 fields=[0, 1] traits=[mayCollect, mayTouchMemory]
#     v9: L0 @JSValue = Box v8
#     v10: anything @JSValue = CallDirect v9 function=f1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Branch v1 -> taken b1(), notTaken b2()
#   b1():
#     Return v9
#   b2():
#     v11: L0 @Cell = NewObject -, v0, v0 layout=L0 fields=[0, 1] traits=[mayCollect, mayTouchMemory]
#     v12: L0 @JSValue = Box v11
#     v13: anything @JSValue = CallDirect v12 function=f1 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     ReturnCall v13
# }
# -- end of code

variable g0 name="held" module=m0 declared={type=anything} initialization=Undefined
layout L0 module=m0 fields=[{key="w" declared={type=anything} flags=[IsRequired]}, {key="h" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewClosure function=f4
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v0, v1 calleeName="publish"
    Return v4
}
function f1 name="area" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="w"
    v2 = PropGet v0 key="h"
    v3 = Mul v1, v2
    Return v3
}
function f2 name="keep" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    v2 = Integer integer=1
    Return v2
}
function f3 name="maker" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = CallDirect v3 function=f1
    v5 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    v7 = CallDirect v6 function=f2
    Return v4
}
function f4 name="reader" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
