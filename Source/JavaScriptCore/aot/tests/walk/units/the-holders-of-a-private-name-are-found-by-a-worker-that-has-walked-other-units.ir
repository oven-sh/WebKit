# The holders of a private name are layouts. A set of them may lie in the arena of one unit, so a worker keeps the layouts and not the set.
# f3 asks for #grain, which L0, L1 and L2 hold. f5 asks for #edge first, which L1 and L2 hold, and then for #grain. No object has the layout L3, so the holders are no family of the program.
# OPTIONS: threads=1
# RUN: walk f3 f5 mechanisms=all
# CHECK-LABEL: code f3:Body
# CHECK: = ShapeTest {{*}}layouts=[L0, L1, L2]
# CHECK-LABEL: code f5:Body
# CHECK: = ShapeTest {{*}}layouts=[L1, L2]
# CHECK: = ShapeTest {{*}}layouts=[L0, L1, L2]
# RUN(ALONE): same-bytes-alone f3:Body f5:Body mechanisms=all
# ALONE: f3:Body same:
# ALONE: f5:Body same:
# declare function sink(...values: unknown[]): void;
# declare const count: number;
# class Plank {
#   #grain = 1;
#   static isPlank(thing: object): boolean { return #grain in thing; }
#   static count(things: object[], from: number): number {
#     let found = 0;
#     for (let i = from; i < things.length; i++) found += #grain in things[i]! ? 1 : 0;
#     return found > 1000 ? Plank.count(things, from + 1) : found;
#   }
# }
# class Board extends Plank {
#   #edge = 2;
#   static both(things: object[], from: number): number {
#     let found = 0;
#     for (let i = from; i < things.length; i++) found += #edge in things[i]! ? 1 : 0;
#     for (let i = from; i < things.length; i++) found += Plank.isPlank(things[i]!) ? 100 : 0;
#     return found > 100000 ? Board.both(things, from + 1) : found;
#   }
# }
# class Shelf extends Board {}
# class Ghost extends Shelf { static kind = 3; }
# const things: object[] = [];
# for (let i = 0; i < count; i++) things.push(i % 4 === 0 ? new Plank() : i % 4 === 1 ? new Board() : i % 4 === 2 ? new Shelf() : { i });
# sink(Board.both(things, 1), Plank.count(things, 3), Board.both(things, 1), Plank.count(things, 3), Ghost.kind);
# export {};

