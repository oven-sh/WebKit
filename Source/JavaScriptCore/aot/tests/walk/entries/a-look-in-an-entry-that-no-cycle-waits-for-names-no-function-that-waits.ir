# class Plain { take(more, give) { return give() + more; } }  class Other extends Plain { take(more, give) { return give() + more + 1; } }  held.take(turn, () => turn), with `held` of either class
# `more` comes raw, so the entry by value is a unit of its own, and take() lies under a name, so no cycle waits for that unit. `give` is proven a closure of f5, which waits for its callers
# OPTIONS: testing=CheckProofsAtRunTime
# RUN: walk f4:GenericCallEntry mechanisms=all
# CHECK-LABEL: code f4:GenericCallEntry
# The entry asks in every build, and the failing side stops by name.
# CHECK: TypeTest v2 testedType=int[0, {{*}}]
# CHECK: TypeTest v3 testedType=function
# CHECK: CheckProof v2 checkedType=never
# CHECK: CheckProof v3 checkedType=never
# RUN(TABLE): walk f4:TableEntry mechanisms=all
# TABLE-LABEL: code f4:TableEntry
# TABLE: TypeTest v2 testedType=function
# TABLE: CheckProof v2 checkedType=never
# RUN(BODY): walk f0:Body mechanisms=all
# BODY-LABEL: code f0:Body
# BODY: checkedType=f4 typeWithoutProof

layout L0 kind=Instance name="Plain" module=m0 constructor=f1
layout L1 kind=Instance name="Other" module=m0 base=L0 constructor=f3 supertypes=[L0] flags=[HasHeritage]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="take"
    v4 = FinishClass v1 layout=L0
    v5 = ResolveHeritage v4
    v6 = NewClosure function=f3
    v7 = NewClass v6, v4, v5 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="take"
    v10 = FinishClass v7 layout=L1
    v11 = Construct v4
    v12 = Integer
    Jump -> next b1(v11, v12)
  b1(v13, v14):
    LoopHint
    v16 = Integer integer=4
    v17 = Less v14, v16
    Branch v17 -> taken b2(), notTaken b5()
  b2():
    v18 = Integer integer=2
    v19 = StrictEq v14, v18
    Branch v19 -> taken b3(), notTaken b4(v13)
  b3():
    v20 = Construct v10
    Jump -> next b4(v20)
  b4(v21):
    v22 = PropGet v21 key="take"
    v23 = NewClosure v14 function=f5
    v24 = Call v22, v21, v14, v23 calleeKey="take"
    v25 = Increment v14
    Jump -> next b1(v21, v25)
  b5():
    v26 = Undefined
    Return v26
}
function f1 name="Plain" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="take" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v1
    v3 = Add v2, v0
    Return v3
}
function f3 name="Other" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f4 name="take" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v1
    v3 = Add v2, v0
    v4 = Integer integer=1
    v5 = Add v3, v4
    Return v5
}
function f5 module=m0 kind=Arrow captures=[{type=anything}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
