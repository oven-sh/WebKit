# function make() { class Point {}  class Model { get current() { return () => new Point(); } }  return new Model().current; }  make()();
# The getter and the arrow capture `Point` by value, and the front end has established both captures: closures of f2.
# A getter is not entered by calls alone and lies under a name, so f4 is in the queue from the start and no cycle waits for its entry by value. f2 waits for its callers, so that entry may name f2 in no test.
# It has nothing to ask: a capture comes out of the closure. What is established needs no door, so the reach of a door takes nothing from it: the body believes f2, as it does where nothing
# is known of its callers, and hands it on to a capture that takes f2.
# It used to believe `function` as soon as every caller was known, and the build stopped at the arrow: "NewClosure, operand 0: StoredTypeMismatch: it is function, and f2 is taken".
# RUN: walk f4:Body mechanisms=all
# CHECK-LABEL: code f4:Body
# CHECK: b0(v0: f2 @
# CHECK: NewClosure {{*}}function=f5
# RUN(ENTRY): walk f4:GenericCallEntry mechanisms=all-PromotedEnvironments
# ENTRY-LABEL: code f4:GenericCallEntry
# ENTRY-NOT: TypeTest
# ENTRY: f2 @{{*}}= GetCapture v0 function=f4
# ENTRY-NOT: TypeTest
# RUN(LINK): link functions mechanisms=all
# LINK: function f2 callers-known one-callee
# LINK-NOT: in-queue-from-start
# LINK: function f4 callers-known {{*}}in-queue-from-start
# LINK-NEXT: parameter 0 proven=f2
# RUN(WITHHELD): walk f4:Body mechanisms=all-Arrivals
# WITHHELD-LABEL: code f4:Body
# WITHHELD: b0(v0: f2 @
# WITHHELD: NewClosure {{*}}function=f5

layout L0 kind=Instance name="Point" module=m0 constructor=f2
layout L1 kind=Instance name="Model" module=m0 constructor=f3
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Call v1
    v3 = Undefined
    Return v3
}
function f1 name="make" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L1
    v6 = NewClosure v3 function=f4
    DefineMethod v5, v6 layout=L1 methodKind=Getter key="current"
    v8 = FinishClass v5 layout=L1
    v9 = Construct v8
    v10 = PropGet v9 key="current"
    Return v10
}
function f2 name="Point" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f3 name="Model" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f4 name="current" module=m0 kind=Getter flags=[HasExplicitName] captures=[{type=f2 flags=[IsFromCompiler]}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: f2):
    v1 = NewClosure v0 function=f5
    Return v1
}
function f5 module=m0 kind=Arrow captures=[{type=f2 flags=[IsFromCompiler]}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: f2):
    v1 = Construct v0
    Return v1
}
