# nothing is decided by the text of a name. The callee is whatever an unknown object holds under `max`, so the call stays a call by value though it is written like the built-in
# function larger(Math, a, b) { return Math.max(a, b); }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = PropGet {{*}}key="max"
# CHECK: = Call v
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: CallBuiltin

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="larger" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = PropGet v0 key="max"
    v4 = Call v3, v0, v1, v2 calleeKey="max" calleeName="Math.max"
    v5 = NewArray v4 contents=anything
    Return v5
}
