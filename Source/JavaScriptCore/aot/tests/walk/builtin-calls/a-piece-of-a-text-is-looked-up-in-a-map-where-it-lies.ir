# A piece of a text that is the key of Map.prototype.get is looked up by its characters where they lie: no cell is made for it. The lookup gives the place of the value, and a set under the same piece on the same map stores
# there, if no entry of any collection has moved since. The piece is cut only where the map does not tell the place, or where the key is absent and set has to add it.
# function count(s) { if (typeof s === "string") { const m = new Map(); const k = s.substring(1, 3); m.set(k, m.get(k)); return m; } }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = Substring
# CHECK: [[place]]: {{*}} = FindStringRangeInMap
# CHECK: [[moves]]: {{*}} = MovesOfEntriesInCollections
# CHECK: = GetValueAtPlaceInMap {{*}}, [[place]]
# CHECK: = Substring
# CHECK: inlineBuiltin=MapGet
# CHECK: = TryPutValueAtPlaceInMap {{*}}, [[place]], [[moves]]
# CHECK: = Substring
# CHECK: inlineBuiltin=MapSet
# a set that no lookup stands in front of is the call as written: function put(s) { if (typeof s === "string") { const m = new Map(); m.set(s.substring(1, 3), 1); return m; } }
# RUN(PUT): walk f2 mechanisms=all
# PUT-LABEL: code f2:Body
# PUT-NOT: = TryPutValueAtPlaceInMap
# PUT: inlineBuiltin=MapSet
# the place found in one map is none in another: function cross(s) { if (typeof s === "string") { const m = new Map(), n = new Map(); const k = s.substring(1, 3); n.set(k, m.get(k)); return [m, n]; } }
# RUN(CROSS): walk f3 mechanisms=all
# CROSS-LABEL: code f3:Body
# CROSS: = FindStringRangeInMap
# CROSS-NOT: = TryPutValueAtPlaceInMap
# CROSS: inlineBuiltin=MapSet
# with nothing but the closed forms the calls stand as written
# RUN(CLOSED): walk f1 mechanisms=none
# CLOSED-NOT: = FindStringRangeInMap

