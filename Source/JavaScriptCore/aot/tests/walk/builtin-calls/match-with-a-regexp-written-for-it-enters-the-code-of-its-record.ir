# `/a+b/.test(s)`: the literal is written for the one call, so it is as it was made: the method that is read off it is the member of its class, and the match enters the code that the image holds for the pattern.
# Nothing in this program can read `RegExp.$1` and its like, so the match leaves no record of itself and takes no object.
# function tested(s: string) { return /a+b/.test(s); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = RegExpMatchLiteral [[text]] overload=RegExpPrototypeTest/0 pattern="a+b"
# RUN(ALONE): walk f1 mechanisms=all
# ALONE-NOT: NewRegExp
# ALONE-NOT: SharedRegExpLiteral
# ALONE-NOT: PropGet
# function found(s: string) { return /a+(b)/.exec(s); }   function matched(s: string) { return s.match(/a+(b)/); }   function sought(s: string) { return s.search(/a+b/); }
# RUN(FORMS): walk f2 f3 f4 mechanisms=all
# FORMS-LABEL: code f2:Body
# FORMS: = RegExpMatchLiteral {{*}}overload=RegExpPrototypeExec/0 pattern="a+(b)" matchForm=Exec
# FORMS-LABEL: code f3:Body
# FORMS: = RegExpMatchLiteral {{*}}overload=StringPrototypeMatch/0 pattern="a+(b)" matchForm=Match
# FORMS-LABEL: code f4:Body
# FORMS: = RegExpMatchLiteral {{*}}overload=StringPrototypeSearch/0 pattern="a+b" matchForm=Search
# The row converts what it is passed in front of all else, and no code that the conversion runs finds the literal: function any(x) { return /a+b/.test(x); }
# RUN(ANY): walk f5 mechanisms=all
# ANY-LABEL: code f5:Body
# ANY: = ToString v0
# ANY: = RegExpMatchLiteral {{*}}overload=RegExpPrototypeTest/0 pattern="a+b"
# g begins at lastIndex and stores it, so the match takes the object, which is new each time: function global(s: string) { return /a+b/g.test(s); }
# RUN(GLOBAL): walk f6 mechanisms=all
# GLOBAL-LABEL: code f6:Body
# GLOBAL-NOT: SharedRegExpLiteral
# GLOBAL: [[re]]: RegExp @Cell = NewRegExp pattern="a+b" regExpFlags=[Global]
# GLOBAL: = RegExpMatchLiteral [[text]], [[re]] overload=RegExpPrototypeTest/0 pattern="a+b" regExpFlags=[Global]
# The array of a match under d lists indices, which the object is asked for. No match stores into it, so it is the one that all evaluations share: function places(s: string) { return /a+b/d.exec(s); }
# RUN(PLACES): walk f7 mechanisms=all
# PLACES-LABEL: code f7:Body
# PLACES-NOT: = NewRegExp
# PLACES: [[re]]: RegExp @Cell = SharedRegExpLiteral pattern="a+b" regExpFlags=[HasIndices]
# PLACES: = RegExpMatchLiteral [[text]], [[re]] {{*}}matchForm=Exec
# A pattern that is one text has no code: whoever matches with its object searches for the text. function text(s: string) { return /ab/.test(s); }
# RUN(TEXT): walk f8 mechanisms=all
# TEXT-LABEL: code f8:Body
# TEXT-NOT: RegExpMatchLiteral
# TEXT: = StringIndexOfLiteral {{*}}literal="ab"
# TEXT: = GreaterEq
# It is matched with twice, and the first match may have left something in it: function twice(s: string) { const re = /a+b/g; re.test(s); return re.test(s); }
# RUN(TWICE): walk f9 mechanisms=all
# TWICE-LABEL: code f9:Body
# TWICE-NOT: RegExpMatchLiteral
# TWICE-NOT: SharedRegExpLiteral
# TWICE: = NewRegExp pattern="a+b" regExpFlags=[Global]
# It has an `exec` of its own: function own(s: string, f) { const re = /a+b/; re.exec = f; return re.test(s); }
# RUN(OWN): walk f10 mechanisms=all
# OWN-LABEL: code f10:Body
# OWN-NOT: RegExpMatchLiteral
# OWN-NOT: RegExpPrototypeTest
# OWN: = PropGet {{*}}key="test"
# RUN(WITHHELD): walk f1 mechanisms=all-BuiltinCalls
# WITHHELD-NOT: RegExpMatchLiteral
# RUN(NOTFRESH): walk f1 mechanisms=all-EscapeAnalysis
# NOTFRESH-NOT: RegExpMatchLiteral

