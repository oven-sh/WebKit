# the proven ranges of its operands leave a function of Math less to do than its row does: an operand is the answer, an operand drops out, or a plain operator does the same
# function floored(v) { if (!isInt32(v)) return v; return [Math.floor(v), Math.abs(v & 255), Math.max(v & 255, 0), Math.max(v, v), Math.fround(v & 255)]; }
# RUN: walk f1 mechanisms=none+DirectCalls+BuiltinCalls+Folding+TypedOperations+UnboxedNumbers
# CHECK-LABEL: code f1:Body
# CHECK: = NewArray
# RUN(NEVER): walk f1 mechanisms=none+DirectCalls+BuiltinCalls+Folding+TypedOperations+UnboxedNumbers
# NEVER-NOT: = Call
# RUN(ALL): walk f1 mechanisms=all
# ALL-NOT: = Call
# function negative(v) { if (!isInt32(v)) return v; return Math.abs(-1 - (v & 255)); }
# RUN(NEGATIVE): walk f2 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# NEGATIVE-LABEL: code f2:Body
# NEGATIVE: = Negate {{*}}form=Integers
# NEGATIVE-NOT: = Call
# function hash(x) { if (typeof x !== "number") return x; return Math.imul(x, 31); } the code in line takes two int32, and the function converts as `| 0` does
# RUN(HASH): walk f3 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# HASH-LABEL: code f3:Body
# HASH: = ToInt32
# HASH: = CallInline {{*}}inlineBuiltin=MathImul
# function small(v) { if (!isInt32(v)) return v; return Math.imul(v & 255, 31); } a product that stays an int32 is the product
# RUN(SMALL): walk f4 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# SMALL-LABEL: code f4:Body
# SMALL: = Mul {{*}}form=Integers
# SMALL-NOT: = Call
# function squared(x) { if (typeof x !== "number") return x; return Math.pow(x, 2); }
# RUN(SQUARED): walk f5 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# SQUARED-LABEL: code f5:Body
# SQUARED: = Mul
# SQUARED-NOT: = Call
# function atLeastZero(x) { if (typeof x !== "number") return x; return Math.max(x, 0); } NaN among the operands is the answer, and -0 lies below 0
# RUN(NUMBER): walk f6 mechanisms=none+DirectCalls+BuiltinCalls+Folding+TypedOperations+UnboxedNumbers
# NUMBER-LABEL: code f6:Body
# NUMBER: = CallInline {{*}}inlineBuiltin=MathMax
# function distance(v) { if (!isInt32(v)) return v; return Math.abs(v); } of 0 the negation is -0
# RUN(EITHER): walk f7 mechanisms=none+DirectCalls+BuiltinCalls+Folding+TypedOperations+UnboxedNumbers
# EITHER-LABEL: code f7:Body
# EITHER: = CallInline
# EITHER-NOT: = Negate

