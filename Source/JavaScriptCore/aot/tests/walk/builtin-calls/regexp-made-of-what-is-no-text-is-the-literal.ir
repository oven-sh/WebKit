# a RegExp takes the characters of its pattern and nothing else of it: a known pattern that is no text is spelled as ToString spells it, and none, or undefined, is the empty text
# function status() { return new RegExp(404); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = NewRegExp pattern=made "404"
# function nothing() { return new RegExp(null); }
# RUN(NULL): walk f2 mechanisms=all
# NULL-LABEL: code f2:Body
# NULL: = NewRegExp pattern="null"
# function empty() { return new RegExp(); }
# RUN(EMPTY): walk f3 mechanisms=all
# EMPTY-LABEL: code f3:Body
# EMPTY: = NewRegExp
# nobody knows the pattern, and the build says so: function any(pattern) { return new RegExp(pattern); }
# DIAGNOSTIC: RegExpPatternNotConstant 1
# RUN(ANY): walk f4 mechanisms=all
# ANY-LABEL: code f4:Body
# ANY-NOT: = NewRegExp
# ANY: Return

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
