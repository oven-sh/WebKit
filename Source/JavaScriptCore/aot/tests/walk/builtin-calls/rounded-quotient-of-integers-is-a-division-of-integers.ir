# RUN(UP): walk f2 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# UP-LABEL: code f2:Body
# UP: = DivideIntegers {{*}}rounding=Ceil
# function upOfNegative(v) { if (!isInt32(v)) return v; return Math.ceil(v / ((v & 7) + 1)); } a quotient between -1 and 0 goes up to -0
# RUN(MINUS): walk f3 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# MINUS-NOT: DivideIntegers
# function byZero(v) { if (!isInt32(v)) return v; return Math.floor(v / (v & 7)); } what a zero divides is no integer
# RUN(ZERO): walk f4 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# ZERO-NOT: DivideIntegers
# function halve(v) { if (!isInt32(v)) return v; let i = v; while (i > 0) i = Math.floor(i / 2); return i; } a look at the loop types the call as the division, so what comes round is an integer
# RUN(LOOP): walk f5 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# LOOP-LABEL: code f5:Body
# LOOP: @Int32){{*}}isLoopHead=true
# LOOP: = DivideIntegers
# function named(Math, v) { if (!isInt32(v)) return v; return Math.floor(v / ((v & 7) + 1)); } nothing is decided by the text of a name
# RUN(NAME): walk f6 mechanisms=none+DirectCalls+BuiltinCalls+TypedOperations+UnboxedNumbers
# NAME-NOT: DivideIntegers

