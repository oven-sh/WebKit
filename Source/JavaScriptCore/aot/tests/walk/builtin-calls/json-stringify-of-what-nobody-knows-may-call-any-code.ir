# the field holds what the caller handed over, and anybody may call: an object with a toJSON, a getter, a proxy. The row's word stands: any code
# function show(value) { return JSON.stringify({ x: value }); }
# An object that may hold itself runs no code and throws: function ring() { const o = { next: null }; o.next = o; return JSON.stringify(o); }
# RUN: walk f1 mechanisms=-Guesses
# CHECK-LABEL: code f1:Body
# CHECK: = CallBuiltin {{*}}overload=JSONStringify{{*}}mayCallUnknownCode
# RUN(RING): walk f2 mechanisms=-Guesses
# RING-LABEL: code f2:Body
# RING: = CallBuiltin {{*}}overload=JSONStringify{{*}}mayThrowByRule
# RUN(QUIET): walk f2 mechanisms=-Guesses
# QUIET-NOT: overload=JSONStringify{{*}}mayCallUnknownCode

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="next" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3 calleeName="sink"
    Return v4
}
function f1 name="show" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=JSON [isNotReadFromHolder]
    v4 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v5 = Call v4, v3, v2 calleeName="JSON.stringify"
    Return v5
}
function f2 name="ring" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Null
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    PropSet v2, v2 key="next"
    v4 = Builtin builtin=JSON [isNotReadFromHolder]
    v5 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v6 = Call v5, v4, v2 calleeName="JSON.stringify"
    Return v6
}
