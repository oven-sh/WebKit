# three handlers are no form of the stub
# function three(x) { x.then(() => {}, () => {}, () => {}); }
# RUN(THREE): walk f4 mechanisms=all
# THREE-NOT: methodOfReceiverAsMade
# What runs: both handlers on a fulfilled promise leave no operation to call; on a pending one the operation is called once; the answers are the host's.
# RUN(RUNS): run-in-shell --aotCountsPath=/dev/null drive = function (one, both, caught) { const count = () => Number(aotOperationCount("operationAOTPromiseThen")); let before = count(); both(Promise.resolve(1)); print("both on a fulfilled promise: " + (count() - before)); before = count(); both(Promise.reject(2)); print("both on a rejected promise: " + (count() - before)); both({ then(f, g) { print("a then of its own: " + typeof f + " " + typeof g); } }); try { both(5); } catch (error) { print(error.constructor.name); } };
# RUNS: both on a fulfilled promise: 0
# RUNS-NEXT: both on a rejected promise: 1
# RUNS-NEXT: a then of its own: function function
# RUNS-NEXT: TypeError
# The driver makes the promises, out of sight of the program. The program hands it Promise: the stubs hold no fast path for a built-in that the program cannot get hold of.

