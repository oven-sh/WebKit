# function slash(s) { if (typeof s === "string") return [s.indexOf("/")]; }
# RUN(UNIT): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# UNIT-LABEL: code f3:Body
# UNIT: = StringIndexOfCharacter {{*}}codeUnit=47
# the search begins at the position clamped into the text: function next(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.indexOf("ab", i)]; }
# RUN(FROM): walk f4 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# FROM-LABEL: code f4:Body
# FROM: = StringRange
# FROM: = StringIndexOfLiteral {{*}}literal="ab"
# function lastSlash(s) { if (typeof s === "string") return [s.lastIndexOf("/")]; }
# RUN(LAST): walk f5 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# LAST-LABEL: code f5:Body
# LAST: = StringLastIndexOfLiteral {{*}}literal="/"
# function has(s) { if (typeof s === "string") return [s.includes("ab")]; }
# RUN(HAS): walk f6 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# HAS-LABEL: code f6:Body
# HAS: = StringIndexOfLiteral {{*}}literal="ab"
# HAS: = LogicalNot
# nobody knows the text that is looked for: function place(s, t) { if (typeof s === "string" && typeof t === "string") return [s.indexOf(t)]; }
# RUN(UNKNOWN): walk f7 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# UNKNOWN-LABEL: code f7:Body
# UNKNOWN-NOT: = StringIndexOfLiteral
# UNKNOWN-NOT: = StringIndexOfCharacter
# UNKNOWN: = NewArray
# a position behind the text that is looked for moves where the test begins, which the operation does not say: function flagAt(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.startsWith("--", i)]; }
# RUN(MOVED): walk f8 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# MOVED-LABEL: code f8:Body
# MOVED-NOT: = StringStartsWithLiteral
# MOVED: = NewArray
# a RegExp that is one text, written for the one call: function named(s) { if (typeof s === "string") return [/abc/.test(s)]; }
# RUN(ATOM): walk f9 mechanisms=all
# ATOM-LABEL: code f9:Body
# ATOM: = StringIndexOfLiteral {{*}}literal="abc"
# ATOM: = GreaterEq
# under i the match is no search for the text: function namedAnyCase(s) { if (typeof s === "string") return [/abc/i.test(s)]; }
# RUN(CASE): walk f10 mechanisms=all
# CASE-LABEL: code f10:Body
# CASE-NOT: = StringIndexOfLiteral
# CASE: = NewArray

