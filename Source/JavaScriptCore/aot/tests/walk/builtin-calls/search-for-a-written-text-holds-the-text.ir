# startsWith, endsWith, indexOf, lastIndexOf and includes of a text that is written, on a proven text: the operation holds the text, so no cell is loaded for it and no call by a row is left
# function isFlag(s) { if (typeof s === "string") return [s.startsWith("--")]; }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
