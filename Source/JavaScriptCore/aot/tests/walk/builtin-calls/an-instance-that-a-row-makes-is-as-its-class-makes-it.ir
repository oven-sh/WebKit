# AN INSTANCE OF ANY BUILT-IN CLASS THAT A ROW MAKES IS AS ITS CLASS MAKES IT. What `new` makes was noted so for every class; what a CALL hands back fresh, for lists alone.
# `left.union(right).has(1)`: the Set is made by the row of union, nobody has seen it: `has` is the class's own, without a look at the cell.
# A name laid on it ends the note: `both.has = ..` and the call goes by name.
# EVERY ROW THAT THE CALL MAY TAKE IS ASKED. `Promise.resolve(held)` goes by several rows; one of them hands a promise back as it is, with whatever `then` it bears.
# The first cut asked the first of the rows reached: the promise was noted fresh and as made, and `.then` was the class's own: a silent wrong answer.
# declare function print(...values: unknown[]): void;
# function joined(left: Set<number>, right: Set<number>): boolean { return left.union(right).has(1); }
# function laid(left: Set<number>, right: Set<number>): boolean { const both = left.union(right); (both as any).has = () => false; return both.has(1); }
# function handedBack(held: unknown): unknown { return Promise.resolve(held).then(() => 2); }
# const own: any = Promise.resolve(1); own.then = () => "own";
# print(joined(new Set([1]), new Set([2])), laid(new Set([1]), new Set([2])), handedBack(own), handedBack(1));
