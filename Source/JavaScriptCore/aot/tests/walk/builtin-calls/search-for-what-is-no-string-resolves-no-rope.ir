# only a string among the elements is compared by its characters, and only with a string. A search for a number compares words: it throws nothing and collects nothing
# a needle that may be a string may resolve a rope, for which memory may lack
# f1 = find, f2 = finds
# function find(n) { const xs = [1, 2, 3]; if (typeof n === "number") { try { return xs.indexOf(n); } catch { return -2; } } return -1; }
# function finds(s) { const xs = ["a", "b"]; try { return xs.indexOf(s); } catch { return -2; } }
# a search for what is no string is code in line that may miss, so it ends its block (TryCallInline), and the end of a block prints no traits. What it may do shows under a handler:
# a block whose end may throw leads an edge to the handler, which its head prints. So the block of the search for a number has none, and only the call behind the miss has one
# by hand, so that the search takes the value that the test hands on
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: handler=
# CHECK: TryCallInline {{*}}inlineBuiltin=ArrayIndexOf
# CHECK: handler=
# RUN(OTHER): walk f2 mechanisms=all
# OTHER-LABEL: code f2:Body
# OTHER: handler=
# OTHER: TryCallInline {{*}}inlineBuiltin=ArrayIndexOf

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
data d0 root=Array{contents=anything elements=[Number{value=1}, Number{value=2}, Number{value=3}]} module=m0
data d1 root=Array{contents=anything elements=[String{value="a"}, String{value="b"}]} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="find" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Data data=d0
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3):
    Jump -> next b2()
  b2() handler=b3():
    v4 = PropGet v1 key="indexOf"
    v5 = Call v4, v1, v3 calleeKey="indexOf" calleeName="xs.indexOf"
    Return v5
  b3() role=CatchHandler:
    v6 = CatchValue
    v7 = Integer integer=-2
    Return v7
  b4():
    v8 = Integer integer=-1
    Return v8
}
function f2 name="finds" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Data data=d1
    Jump -> next b1()
  b1() handler=b2():
    v2 = PropGet v1 key="indexOf"
    v3 = Call v2, v1, v0 calleeKey="indexOf" calleeName="xs.indexOf"
    Return v3
  b2() role=CatchHandler:
    v4 = CatchValue
    v5 = Integer integer=-2
    Return v5
}
