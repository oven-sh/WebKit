  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="products" module=m1 role=Library flags=[HasExplicitName] length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Integer
    v4 = BitOr v0, v3
    v5 = Undefined
    v6 = NewArrayLike v4, v5 @12
    v7 = BitOr v1, v3
    v8 = BitOr v2, v3
    v9 = Mul v7, v8
    v10 = TryPutByValDirect v6, v3, v9
    Branch v10 -> taken b3(), notTaken b1()
  b1():
    v11 = TryPutIndex v6, v3, v9
    Branch v11 -> taken b3(), notTaken b2()
  b2():
    ElemDefine v6, v3, v9
    Jump -> next b3()
  b3():
    Return v6
}
function f2 name="sums" module=m1 role=Library flags=[HasExplicitName] length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Integer
    v4 = BitOr v0, v3
    v5 = Undefined
    v6 = NewArrayLike v4, v5
    v7 = BitOr v1, v3
    v8 = BitOr v2, v3
    v9 = Add v7, v8
    v10 = BitOr v9, v3
    v11 = TryPutByValDirect v6, v3, v10
