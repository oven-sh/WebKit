# the emitter of each piece of code in line says what it takes. Where it answers for all of that it stands in the place of the call, anywhere: it is about as long as the call.
# Where it may miss, the call of the function stands behind its other edge and the two meet: that is more code than the call, and pays wherever the code comes again
# function sumOfCodes(s, n) { if (typeof s !== "string") return; let sum = 0; for (let i = 0; i < n; i++) sum = sum + s.charCodeAt(i); return sum; }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: isLoopHead=true
# CHECK: = GetStringCodeUnit
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: = CallBuiltin
# function whole(text, n) { if (typeof text !== "string") return; let last = 0; for (let i = 0; i < n; i++) last = parseInt(text); return last; }
# A rope misses.
# RUN(MISS): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# MISS-LABEL: code f2:Body
# MISS: TryCallInline {{*}}inlineBuiltin=ParseInt{{*}} -> done [[done]]({{*}}), miss [[miss]]()
# MISS: [[miss]]() frequency=Rare
# MISS: = CallBuiltin {{*}}overload=ParseInt
# Outside a loop, in a function that anybody may call again: function codeAt(s, i) { if (typeof s === "string" && typeof i === "number") return [s.charCodeAt(i), parseInt(s)]; }
# RUN(AGAIN): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# AGAIN-LABEL: code f3:Body
# AGAIN: = GetStringLength
# AGAIN: TryCallInline {{*}}inlineBuiltin=ParseInt
# AGAIN: = CallBuiltin {{*}}overload=ParseInt
# The body of a module runs once: if (typeof text === "string") parseInt(text);
# RUN(ONCE): walk f0 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ONCE-LABEL: code f0:Body
# ONCE-NOT: TryCallInline
# ONCE: = CallBuiltin {{*}}overload=ParseInt

