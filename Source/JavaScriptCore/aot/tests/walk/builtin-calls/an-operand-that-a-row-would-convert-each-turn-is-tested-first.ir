# function scan(source, i) { .. for (; i < source.length; i = i + 1) { const unit = source.charCodeAt(i); if (unit === 34) { i = skip(source, i); continue; } .. } }
# The index comes round the loop as a number or a text: one back edge hands it back out of a call, so no test in front of the loop can hold. The call goes by one row, which would convert the index
# by a stub each turn. It is tested for an int32 first; the conversion stands on the rare side alone.
# RUN: walk f2:Body mechanisms=all
# CHECK-LABEL: code f2:Body
# CHECK: isLoopHead=true
# CHECK-NOT: = ToNumber
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK: = GetStringCodeUnit
# function once(source, i) { .. return [source.charCodeAt(i)]; }: outside every loop nothing is tested first
# RUN(ONCE): walk f3:Body mechanisms=all
# ONCE-LABEL: code f3:Body
# ONCE: = ToNumber
# layout L908 kind=Closure
