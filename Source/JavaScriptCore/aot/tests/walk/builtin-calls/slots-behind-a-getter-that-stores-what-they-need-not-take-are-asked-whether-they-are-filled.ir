# interface Line { readonly b: number; c: number; } class Held implements Line { c: number; constructor(c: number) { this.c = c; } } const lines: Line[] = [new Held(1)];
# function square(line: Line) { return line.c * line.c; }   the slot of `c` is typed for it
# function values(n: number) { const record: Line = { get b() { record.c = n; return 2; }, c: 3.5 }; const made = Object.values(record); lines.push(record); return made; }
# the getter writes `c` over with what was handed in, which its slot need not take: the field has then moved out of it, so the slot is asked whether it is filled
# the names alone are read without the slots and without the getter. In `valuesWithNumberStored` the getter stores a written number, and nothing is asked
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = GetSlotGetter [[object]] key="b"
# CHECK: = IsSlotFilled [[object]] key="c"
# CHECK: = GetSlot [[object]] key="c"
# CHECK: = PropGet {{*}}key="c"
# CHECK: = NewArray
# CHECK-NOT: inlineBuiltin=ObjectValues
# RUN(KEYS): walk f2 mechanisms=all
# KEYS-LABEL: code f2:Body
# KEYS-NOT: GetSlotGetter
# KEYS-NOT: IsSlotFilled
# KEYS: = NewArray
# KEYS-NOT: inlineBuiltin=OwnPropertyKeys
# RUN(FITS): walk f6 mechanisms=all
# FITS-LABEL: code f6:Body
# FITS: = GetSlotGetter {{*}}key="b"
# FITS-NOT: IsSlotFilled
# FITS: = GetSlot {{*}}key="d"
# FITS-NOT: PropGet
# RUN(PLAN): plan layouts mechanisms=all
# PLAN-LABEL: layout L0
# PLAN: "c" OptionalDouble
# PLAN-LABEL: layout L3
# PLAN: "d" OptionalDouble

