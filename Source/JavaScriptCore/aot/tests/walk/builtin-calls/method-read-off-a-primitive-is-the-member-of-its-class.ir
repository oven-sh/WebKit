# a primitive has no property of its own but what its class lists for its instances, and the prototype objects of the engine are locked. So a method that is read off a proven text is found when the program is built:
# the read is the built-in itself, which nobody takes, and the call goes by its row
# function codeAt(s, i) { if (typeof s === "string" && typeof i === "number") return [s.charCodeAt(i)]; }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = GetStringCodeUnit
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: PropGet
# The method as a value: function methodOf(s) { if (typeof s === "string") return s.charCodeAt; }
# RUN(VALUE): walk f2 mechanisms=none+TypedOperations
# VALUE-LABEL: code f2:Body
# VALUE-NOT: PropGet
# VALUE: : builtin(StringPrototypeCharCodeAt) {{*}} = Builtin builtin=StringPrototypeCharCodeAt
# Undefined and null throw, in the words of the read. A check that throws so stands in front, and behind it the text is proven: function ofMaybe(s) { if (typeof s === "string" || s === undefined) return s.charCodeAt; }
# RUN(MAYBE): walk f3 mechanisms=none+TypedOperations
# MAYBE-LABEL: code f3:Body
# MAYBE: : string {{*}} = RequireObjectCoercible {{*}}name="charCodeAt"
# MAYBE-NOT: PropGet
# MAYBE: = Builtin builtin=StringPrototypeCharCodeAt
# An object of the class String may have a property of its own under the name: function ofObject(s) { if (s instanceof String) return s.charCodeAt; }
# RUN(OBJECT): walk f4 mechanisms=none+TypedOperations
# OBJECT-LABEL: code f4:Body
# OBJECT: : anything{{*}} = PropGet {{*}}key="charCodeAt"
# The length of a text is its own: function lengthOf(s) { if (typeof s === "string") return s.length; }
# RUN(LENGTH): walk f5 mechanisms=none+TypedOperations
# LENGTH-LABEL: code f5:Body
# LENGTH: = GetStringLength
# Where the text may be undefined the check that throws in the words of the read stands in front, and the length is read off the text behind it: function lengthOfMaybe(s) { if (typeof s === "string" || s === undefined) return s.length; }
# RUN(MAYBELENGTH): walk f6 mechanisms=none+TypedOperations
# MAYBELENGTH-LABEL: code f6:Body
# MAYBELENGTH: : string {{*}} = RequireObjectCoercible {{*}}name="length"
# MAYBELENGTH: = GetStringLength
# With typed operations withheld the read stays as it is written, and the call still finds its callee by it.
# RUN(CLOSED): walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# CLOSED-LABEL: code f1:Body
# CLOSED: = PropGet {{*}}key="charCodeAt"

