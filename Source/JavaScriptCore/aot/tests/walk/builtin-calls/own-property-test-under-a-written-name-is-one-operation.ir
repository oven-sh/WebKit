# `Object.hasOwn(object, "name")` and `object.hasOwnProperty("name")` ask an object for a property of its own under a name that is written. The kept emitters have an operation for that question, which is one call of a stub:
# no function object is fetched and no native function is entered
# function has(o) { if (typeof o === "object" && o !== null) return [Object.hasOwn(o, "name"), o.hasOwnProperty]; }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: : boolean @Boolean = PropHasOwn {{*}}key="name" calledBuiltin=ObjectHasOwn
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: = CallBuiltin
# function hasByMethod(o) { return Object.prototype.hasOwnProperty.call .. } written as a call of the built-in on the object
# RUN(METHOD): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# METHOD-LABEL: code f2:Body
# METHOD: : boolean @Boolean = PropHasOwn {{*}}key="name" calledBuiltin=ObjectPrototypeHasOwnProperty
# An index may be an element: function hasFirst(o) { .. Object.hasOwn(o, "0") }
# RUN(INDEX): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# INDEX-LABEL: code f3:Body
# INDEX-NOT: PropHasOwn
# INDEX: overload=ObjectHasOwn
# Of an object and a key that nobody knows the stub asks too, in a loop: it refuses and converts them as Object.hasOwn does. function counted(o, k, n) { let c = false; for (let i = 0; i < n; i++) c = Object.hasOwn(o, k); return c; }
# RUN(ANY): walk f4 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ANY-LABEL: code f4:Body
# ANY: isLoopHead=true
# ANY: : boolean @Boolean = CallInline {{*}}inlineBuiltin=ObjectHasOwn overload=ObjectHasOwn
# hasOwnProperty converts its key first, which a key that is an object can tell: the function itself is entered.
# RUN(ORDER): walk f5 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ORDER-LABEL: code f5:Body
# ORDER-NOT: CallInline
# ORDER: = CallBuiltin {{*}}overload=ObjectPrototypeHasOwnProperty{{*}}builtinCallForm=AnyReceiver
# With calls of built-ins withheld the call stays as it is written.
# RUN(CLOSED): walk f1 mechanisms=none+TypedOperations+DirectCalls
# CLOSED-LABEL: code f1:Body
# CLOSED-NOT: PropHasOwn
# CLOSED: : boolean @JSValue = Call v

