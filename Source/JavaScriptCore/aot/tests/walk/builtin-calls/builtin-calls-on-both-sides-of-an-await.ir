# which built-in a binding names does not change while a function is suspended: the calls in front of the await and behind it both go by its row
# async function larger(a, b, p) { if (typeof a === "number" && typeof b === "number") { const m = Math.hypot(a, b); await p; return [Math.hypot(m, b)]; } }
# RUN: walk f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:CoroutineBody
# CHECK: = CallInline {{*}}overload=MathHypot
# CHECK: = AwaitBySavingFrame
# CHECK: = CallInline {{*}}overload=MathHypot
# RUN(NEVER): walk f1:CoroutineBody mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: = Call v

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="larger" module=m0 flags=[IsAsync] length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4):
    v5 = TypeTest v1 testedType=number
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Builtin builtin=Math
    v8 = Builtin builtin=MathHypot
    v9 = Call v8, v7, v4, v6 calleeName="Math.hypot"
    v10 = Await v2
    v11 = Call v8, v7, v9, v6 calleeName="Math.hypot"
    v12 = NewArray v11 contents=anything
    Return v12
  b3():
    v13 = Undefined
    Return v13
}
