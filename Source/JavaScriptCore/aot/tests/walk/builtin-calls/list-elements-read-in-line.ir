# at() of a list as its class makes it reads the element in a loop, under an index that is proven to be from 0 up.
# Outside a loop the row calls the stub, which reads the element itself.
# function inLoop(n) { const list = [1, 2, 3]; let last; for (let i = 0; i < n; i++) last = list.at(i); return last; }
# function once(i) { if (typeof i !== "number") return; const list = [1, 2, 3]; return list.at(i); }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = GetArrayLength
# CHECK: = GetArrayElement {{*}}level=Proven
# RUN(ONCE): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ONCE-LABEL: code f2:Body
# ONCE-NOT: TryCallInline
# ONCE: = CallBuiltin {{*}}overload=ArrayPrototypeAt/0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="inLoop" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Integer integer=3
    v4 = NewArray v1, v2, v3 contents=anything
    v5 = Integer
    v6 = Undefined
    Jump -> next b1(v5, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v0
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = PropGet v4 key="at"
    v12 = Call v11, v4, v7 calleeKey="at"
    v13 = Increment v7
    Jump -> next b1(v13, v12)
  b3():
    Return v8
}
function f2 name="once" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = Integer integer=3
    v6 = NewArray v3, v4, v5 contents=anything
    v7 = PropGet v6 key="at"
    v8 = Call v7, v6, v2 calleeKey="at"
    Return v8
  b2():
    v9 = Undefined
