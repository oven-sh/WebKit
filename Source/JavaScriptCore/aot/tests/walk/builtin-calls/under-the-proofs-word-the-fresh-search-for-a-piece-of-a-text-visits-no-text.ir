# Under the proofs word the fresh search in front of a store through a place kept in a map takes the text of a piece as it is in sight. It is no reader of the text: a reader's second visit makes the text flat,
# and the build under the word would hold a FlattenString, and flat forms behind it, that the build that ships does not: the word would choose the form.
# function count(s) { if (typeof s === "string") { const m = new Map(); const k = s.substring(1, 3); m.set(k, m.get(k)); return m; } }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: = FlattenString
# CHECK: = FindStringRangeInMap
# CHECK-NOT: = FlattenString
# CHECK-NOT: = FindStringRangeInMap
# CHECK: = TryPutValueAtPlaceInMap
# CHECK-NOT: = FlattenString
# RUN(HELD): walk f1 mechanisms=all testing=CheckProofsAtRunTime
# HELD-LABEL: code f1:Body
# HELD-NOT: = FlattenString
# HELD: [[place]]: {{*}} = FindStringRangeInMap
# HELD-NOT: = FlattenString
# HELD: [[again]]: {{*}} = FindStringRangeInMap
# HELD-NOT: = FlattenString
# HELD: = TryPutValueAtPlaceInMap {{*}}, [[place]],
# HELD: = StrictEq [[again]], [[place]]
# HELD: source=RememberedFact
# HELD-NOT: = FlattenString

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="count" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Builtin builtin=Map
    v4 = Construct v3 calleeName="Map"
    v5 = PropGet v2 key="substring"
    v6 = Integer integer=1
    v7 = Integer integer=3
    v8 = Call v5, v2, v6, v7 calleeKey="substring"
    v9 = PropGet v4 key="set"
    v10 = PropGet v4 key="get"
    v11 = Call v10, v4, v8 calleeKey="get"
    v12 = Call v9, v4, v8, v11 calleeKey="set"
    Return v4
  b2():
    v13 = Undefined
    Return v13
}
function f2 name="put" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Builtin builtin=Map
    v4 = Construct v3 calleeName="Map"
    v5 = PropGet v2 key="substring"
    v6 = Integer integer=1
    v7 = Integer integer=3
    v8 = Call v5, v2, v6, v7 calleeKey="substring"
    v9 = PropGet v4 key="set"
    v10 = Call v9, v4, v8, v6 calleeKey="set"
    Return v4
  b2():
    v11 = Undefined
    Return v11
}
function f3 name="cross" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Builtin builtin=Map
    v4 = Construct v3 calleeName="Map"
    v5 = Construct v3 calleeName="Map"
    v6 = PropGet v2 key="substring"
    v7 = Integer integer=1
    v8 = Integer integer=3
    v9 = Call v6, v2, v7, v8 calleeKey="substring"
    v10 = PropGet v5 key="set"
    v11 = PropGet v4 key="get"
    v12 = Call v11, v4, v9 calleeKey="get"
    v13 = Call v10, v5, v9, v12 calleeKey="set"
    Return v13
  b2():
    v14 = Undefined
    Return v14
}
