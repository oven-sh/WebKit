# charCodeAt, codePointAt, charAt and at on a proven text and a proven number are the tests of the bounds, the read inside, and what the language gives outside: no call is left
# function codeAt(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.charCodeAt(i)]; }
# as an unsigned word a negative position lies behind every length, so one test asks both bounds
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = GetStringLength
# CHECK: = URShift
# CHECK: = Less
# CHECK: = GetStringCodeUnit
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
