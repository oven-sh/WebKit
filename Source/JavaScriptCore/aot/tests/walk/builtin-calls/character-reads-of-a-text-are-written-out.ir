# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = GetStringCodeUnit
# function pointAt(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.codePointAt(i)]; }
# RUN(POINT): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# outside loops codePointAt is one operation, whose code opens the text once
# POINT-LABEL: code f2:Body
# POINT: = CallInline {{*}}inlineBuiltin=StringCodePointAt
# function letterAt(s, i) { if (typeof s === "string" && (i | 0) === i) return [s.charAt(i)]; }
# RUN(LETTER): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# LETTER-LABEL: code f3:Body
# LETTER: = Less
# LETTER: = Substring
# function last(s) { if (typeof s === "string") return [s.at(-1)]; }
# RUN(LAST): walk f4 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# LAST-LABEL: code f4:Body
# LAST: = GetStringLength
# LAST: = Add
# LAST: = Substring
# the one way into the block leads over `i < s.length`, and no i is negative, so nothing is asked again: function inside(s, i) { if (typeof s === "string" && i is 0 .. 1000 && i < s.length) return [s.charCodeAt(i)]; }
# RUN(INSIDE): walk f5 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# INSIDE-LABEL: code f5:Body
# INSIDE: = Less
# INSIDE-NOT: = Less
# INSIDE: = GetStringCodeUnit
# nobody knows what the receiver is, so nobody knows what is called: function ofAnything(s, i) { return [s.charCodeAt(i)]; }
# RUN(ANY): walk f6 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ANY-LABEL: code f6:Body
# ANY-NOT: GetStringCodeUnit
# ANY: = Call v
# the characters of a piece are read where they lie, and the piece that nobody else reads is never cut: function firstOfRest(s, a) { if (typeof s === "string" && (a | 0) === a) return [s.slice(a).charCodeAt(0)]; }
# RUN(PIECE): walk f7 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# PIECE-LABEL: code f7:Body
# PIECE: = StringRange
# PIECE: = GetStringCodeUnit
# RUN(UNCUT): walk f7 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# UNCUT-NOT: = Substring

