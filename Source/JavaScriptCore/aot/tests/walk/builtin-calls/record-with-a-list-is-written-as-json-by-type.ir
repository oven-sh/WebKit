# a record that holds a list is written as JSON by its type: the slot proves a list and no more, and the plan has the elements from what is written
# lists that nest without end, and lists of which nothing is written, go to the host as ever
# each function is handed to code that nobody has seen
# f1 = numbers, f2 = records, f3 = endless, f4 = anything
# -- source: record-with-a-list-is-written-as-json-by-type.ts
# declare function sink(...values: unknown[]): void;
# type Nest = Nest[];
# function numbers(value: { ok: boolean; items: number[] }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# function records(value: { lines: { sku: string; n: number }[] }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# function endless(value: { nest: Nest }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# function anything(value: { any: unknown[] }, n: number) { let length = 0; for (let i = 0; i < n; i++) length += JSON.stringify(value).length; return length; }
# sink(numbers, records, endless, anything, numbers({ ok: true, items: [1] }, 2), records({ lines: [{ sku: "a", n: 1 }] }, 2), endless({ nest: [[]] }, 2), anything({ any: [1] }, 2));
