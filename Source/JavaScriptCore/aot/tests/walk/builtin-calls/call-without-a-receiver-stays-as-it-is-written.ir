# CHECK-LABEL: code f1:Body
# CHECK: = Call {{*}}calleeName="call"
# function bareApply() { const apply = Function.prototype.apply; return apply(null, []); }
# RUN(APPLY): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# APPLY-LABEL: code f2:Body
# APPLY: = CallBuiltin {{*}}overload=FunctionPrototypeApply/0

