# `const call = Function.prototype.call; call(null)`: the row of `call` forwards the call to its receiver, and this call has none.
# The built-in itself finds that `undefined` is no function, so the call stays a call of the built-in.
# The walk asked for the type of the receiver that is not there, and the compiler stopped.
# function bare() { const call = Function.prototype.call; return call(null); }
