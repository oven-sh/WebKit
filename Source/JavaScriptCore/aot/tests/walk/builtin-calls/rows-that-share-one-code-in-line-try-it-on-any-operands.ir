# function summed(list) { let sum = 0; for (let i = 0; i < 64; i++) sum += Number(list[i]); return sum; }
# Two rows of Number() may take a value that nothing types; both have the same code in line, and that code asks the value itself: a number, a boolean, undefined, null and a text are answered in line,
# an object, a symbol and a bigint miss and go by the call.
# RUN: walk f1:Body mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: TryCallInline {{*}}inlineBuiltin=CallNumberConstructor
# CHECK: frequency=Rare
# CHECK: = CallBuiltin {{*}}overload=Number/0 builtinCallForm=AnyReceiver
# function once(value) { return [Number(value)]; }: outside every loop the call stays as small as it was
# RUN(ONCE): walk f2:Body mechanisms=all
# ONCE-LABEL: code f2:Body
# ONCE-NOT: TryCallInline
# ONCE: = CallBuiltin {{*}}overload=Number/0 builtinCallForm=AnyReceiver
# function onceOfObject() { return [Number({ valueOf() { return 5; } })]; }: one row alone takes an object; outside every loop that call too stays as small as it was
# RUN(OBJECT): walk f3:Body mechanisms=all
# OBJECT-LABEL: code f3:Body
# OBJECT-NOT: TryCallInline
# OBJECT: Return
