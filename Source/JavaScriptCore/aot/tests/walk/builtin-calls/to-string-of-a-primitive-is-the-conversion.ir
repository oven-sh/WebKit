  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = PropGet v2 key="toString"
    v4 = Integer integer=10
    v5 = Call v3, v2, v4 calleeKey="toString" calleeName="n.toString"
    Return v5
  b2():
    v6 = String string=""
    Return v6
}
