# CHECK: = TryPutValueAtPlaceInMap {{*}}, [[place]], [[moves]]
# CHECK: inlineBuiltin=MapSet
# a store on one way alone leaves the lookup as it is: for (..) { if (m.get(k) === undefined) m.set(k, 1); }
