# In a loop, Map.prototype.get under a key under which every way behind it stores gives the place of the value, and the set stores there if no entry of any collection has moved since.
# function count(k, n) { if (typeof k === "string" && (n | 0) === n) { const m = new Map(); for (let i = 0; i < n; i++) m.set(k, m.get(k) + 1); return m; } }
