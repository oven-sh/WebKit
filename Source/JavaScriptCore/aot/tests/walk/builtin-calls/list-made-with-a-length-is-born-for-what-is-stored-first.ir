# A list that is made with a length holds nothing yet, so nothing at its birth says what storage it needs. The first operation that names a kind of storage for it says so, and the birth takes that kind:
# a store by the type of what it stores, a test in front of a loop by the kind that the loop is built for. A later store may ask for wider storage, never for narrower. It is a hint: each of them tests at run time.
# function whole(n) { const list = new Array(n | 0); list[0] = 1; return list; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = NewArrayLike {{*}}arrayStorage=Int32
# function fraction(n) { const list = new Array(n | 0); list[0] = 0.5; return list; }
# RUN(FRACTION): walk f2 mechanisms=all
# FRACTION-LABEL: code f2:Body
# FRACTION: = NewArrayLike {{*}}arrayStorage=Double
# function text(n) { const list = new Array(n | 0); list[0] = "x"; return list; }
# RUN(TEXT): walk f3 mechanisms=all
# TEXT-LABEL: code f3:Body
# TEXT: = NewArrayLike {{*}}arrayStorage=Contiguous
# What may be a number or not says nothing: the list is born for integers, and the store that finds them widens the storage where it stands.
# function anything(n, value) { const list = new Array(n | 0); list[0] = value; return list; }
# RUN(ANYTHING): walk f4 mechanisms=all
# ANYTHING-LABEL: code f4:Body
# ANYTHING: = NewArrayLike
# RUN(UNSAID): walk f4 mechanisms=all
# UNSAID-NOT: NewArrayLike {{*}}arrayStorage=
# Where nothing is stored nothing is said: function bare(n) { return new Array(n | 0); }
# RUN(BARE): walk f8 mechanisms=all
# BARE-LABEL: code f8:Body
# BARE: = NewArrayLike
# RUN(SILENT): walk f8 mechanisms=all
# SILENT-NOT: arrayStorage=
# function wider(n) { const list = new Array(n | 0); list[0] = 1; list[1] = "x"; return list; }
# RUN(WIDER): walk f5 mechanisms=all
# WIDER-LABEL: code f5:Body
# WIDER: = NewArrayLike {{*}}arrayStorage=Contiguous
# function narrower(n) { const list = new Array(n | 0); list[0] = "x"; list[1] = 1; return list; }
# RUN(NARROWER): walk f6 mechanisms=all
# NARROWER-LABEL: code f6:Body
# NARROWER: = NewArrayLike {{*}}arrayStorage=Contiguous
# function filled(n) { const list = new Array(n | 0); for (let i = 0; i < list.length; i++) list[i] = i & 7; return list; }
# RUN(LOOP): walk f7 mechanisms=all
# LOOP-LABEL: code f7:Body
# LOOP: = NewArrayLike {{*}}arrayStorage=Int32
# LOOP: = HasArrayStorage {{*}} [isWritable, admitsInt32Storage]
# With typed operations withheld nothing is asked of the birth.
# RUN(CLOSED): walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# CLOSED-NOT: arrayStorage=

