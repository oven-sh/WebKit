# where a formatter of dates names a time zone, the build asks ICU for the offsets of the zone and for where they change (findUTCOffset in AOTIntlBuiltinOperations.cpp), and the pattern is laid down only where what it was told agrees with what ICU formats, at instants all over two centuries and on both sides of every change
# function inNewYork() { return new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York" }); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = NewFormatterWithPattern
# a date is written by the pattern of the zone, with the time of day, which an offset that is an hour off changes: function timeInNewYork(ms: number) { return [new Date(ms).toLocaleString("en-US", { timeZone: "America/New_York" })]; }
# RUN(TIME): walk f2 mechanisms=all
# TIME-LABEL: code f2:Body
# TIME: = FormatDateWithPattern
# TIME: frequency=Rare
# a zone whose offset never changes: function fiveHoursBehind(ms: number) { return [new Date(ms).toLocaleString("en-US", { timeZone: "Etc/GMT+5" })]; }
# RUN(FIXED): walk f3 mechanisms=all
# FIXED-LABEL: code f3:Body
# FIXED: = FormatDateWithPattern
# a name that is no zone has no pattern, and the call stays as it is written: function noZone(ms: number) { return [new Date(ms).toLocaleString("en-US", { timeZone: "Mars/Olympus_Mons" })]; }
# RUN(NONE): walk f4 mechanisms=all
# NONE-LABEL: code f4:Body
# NONE-NOT: FormatDateWithPattern
# NONE: = CallBuiltin {{*}}overload=DatePrototypeToLocaleString

