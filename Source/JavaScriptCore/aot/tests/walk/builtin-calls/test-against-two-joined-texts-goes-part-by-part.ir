# `path.startsWith(dir + "/")` in a loop: the call is made on the part that lies at the start, and the one character that is written is read behind it. Nobody reads the joined text, so it is never made flat
# function under(path, dir, n) { if (typeof path !== "string" || typeof dir !== "string") return; let c = 0; for (let i = 0; i < n; i++) if (path.startsWith(dir + "/")) c++; return c; }
