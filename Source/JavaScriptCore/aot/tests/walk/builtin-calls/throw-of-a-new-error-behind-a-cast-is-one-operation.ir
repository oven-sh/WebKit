# in checked text the front end writes what the checker expects of the construction between it and the throw. A cast hands its operand on, so the error still goes to the throw alone, and the two are one operation
# function check() { throw new TypeError("bad input"); }, as the front end writes it for a .ts
# RUN: walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: ThrowNewError {{*}}errorKind=TypeError message="bad input"
# RUN(NEVER): walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# NEVER-NOT: Throw v
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: ThrowNewError
# the cast is read by a store too: function kept() { const e: any = new TypeError("bad input"); e.extra = 1; throw e; }
# RUN(KEPT): walk f2 mechanisms=none+DirectCalls+BuiltinCalls
# KEPT-NOT: ThrowNewError
# RUN(KEPTAS): walk f2 mechanisms=none+DirectCalls+BuiltinCalls
# KEPTAS-LABEL: code f2:Body
# KEPTAS: Throw v
# what stands between the two does not read the error, and runs: function told() { const e = new TypeError("bad input"); sink(1); throw e; }
# RUN(BETWEEN): walk f3 mechanisms=none+DirectCalls+BuiltinCalls
# BETWEEN-NOT: ThrowNewError
# RUN(BETWEENAS): walk f3 mechanisms=none+DirectCalls+BuiltinCalls
# BETWEENAS-LABEL: code f3:Body
# BETWEENAS: Throw v

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="check" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=TypeError
    v1 = String string="bad input"
    v2 = Construct v0, -, v1 calleeName="TypeError"
    v3 = Convert v2 declared={type=undefined|null|TypeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    Throw v3
}
function f2 name="kept" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=TypeError
    v1 = String string="bad input"
    v2 = Construct v0, -, v1 calleeName="TypeError"
    v3 = Convert v2 declared={type=undefined|null|TypeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    v4 = Integer integer=1
    PropSet v3, v4 key="extra"
    Throw v3
}
function f3 name="told" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=TypeError
    v1 = String string="bad input"
    v2 = Construct v0, -, v1 calleeName="TypeError"
    v3 = Convert v2 declared={type=undefined|null|TypeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Integer integer=1
    v7 = Call v5, -, v6
    Throw v3
}
