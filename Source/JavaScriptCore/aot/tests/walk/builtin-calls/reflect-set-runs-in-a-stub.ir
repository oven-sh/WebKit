# Reflect.set() runs in a stub, with a receiver and without one, whatever is passed. With fewer than three arguments it stays a call.
# function store(target, key, value, receiver) { Reflect.set(target, key); Reflect.set(target, key, value); return Reflect.set(target, key, value, receiver); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: CallBuiltin
# CHECK: CallInline {{*}}inlineBuiltin=ReflectSet
# CHECK: CallInline {{*}}inlineBuiltin=ReflectSet

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="store" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    v4 = Builtin builtin=Reflect
    v5 = Builtin builtin=ReflectSet
    v6 = Call v5, v4, v0, v1 calleeName="Reflect.set"
    v7 = Call v5, v4, v0, v1, v2 calleeName="Reflect.set"
    v8 = Call v5, v4, v0, v1, v2, v3 calleeName="Reflect.set"
    Return v8
}
