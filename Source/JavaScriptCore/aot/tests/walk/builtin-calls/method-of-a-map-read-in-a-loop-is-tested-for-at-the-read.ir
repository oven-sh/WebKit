# `table.get(name)` in a loop. The class of the receiver is proven; one of the Maps that arrive has got a name of its own, so Link does not say that it stays as its class makes it. The test stands at the read of the method:
# behind it the call goes by its row, and on the rare side the read and the call stand as they are written. Outside of a loop no test is opened: f2 is the same call without the loop.
# function count(table, names) { let total = 0; for (let i = 0; i < names.length; i++) total = table.get(names[i]); return total; }    function once(table, name) { return table.get(name); }
# const named = new Map(); named.tag = 1;    count(new Map(), []); count(named, []); once(new Map(), "a"); once(named, "a");
# RUN: walk f1 f2 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = IsPristine v0 builtinClass=Map aspects=[Storage, Names]
# CHECK-NEXT: Branch
# CHECK: = CallInline {{*}}inlineBuiltin=MapGet overload=MapPrototypeGet/0
# CHECK: frequency=Rare
# CHECK: = PropGet v0 key="get"
# CHECK: = Call {{*}}calleeKey="get"
# CHECK-LABEL: code f2:Body
# CHECK-NOT: IsPristine
# CHECK: = PropGet v0 key="get"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0 calleeName="Map"
    v2 = Construct v0 calleeName="Map"
    v3 = Integer integer=1
    PropSet v2, v3 key="tag"
    v5 = NewArray contents=anything
    v6 = NewClosure function=f1
    v7 = Call v6, -, v1, v5 calleeName="count"
    v8 = Call v6, -, v2, v5 calleeName="count"
    v9 = String string="a"
    v10 = NewClosure function=f2
    v11 = Call v10, -, v1, v9 calleeName="once"
    v12 = Call v10, -, v2, v9 calleeName="once"
    v13 = NewArray v7, v8, v11, v12 contents=anything
    Return v13
}
function f1 name="count" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    Jump -> next b1(v2, v2)
  b1(v3: anything, v4: anything):
    LoopHint
    v6 = PropGet v1 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v0 key="get"
    v9 = ElemGet v1, v4
    v10 = Call v8, v0, v9 calleeKey="get"
    v11 = Increment v4
    Jump -> next b1(v10, v11)
  b3():
    Return v3
}
function f2 name="once" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
