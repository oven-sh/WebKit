# slice, substring and substr on a proven text and proven numbers are the two bounds and one Substring. A bound that the ranges decide is the position, the length or 0, the others come out of one StringRange
# function rest(s) { if (typeof s === "string") return [s.slice(1)]; }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: [[length]]: {{*}} = GetStringLength
# CHECK: = StringRange [[length]]
# CHECK: = Substring {{*}}, [[length]]
# RUN(NEVER): walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: = CallInline
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = Substring
# function head(s, n) { if (typeof s === "string" && (n | 0) === n) return [s.substring(0, n)]; }
# RUN(HEAD): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# HEAD-LABEL: code f2:Body
# HEAD: = StringRange {{*}}method=Substring
# HEAD: = Substring
# function some(s, a) { if (typeof s === "string" && (a | 0) === a) return [s.substr(a, 2)]; }
# RUN(SOME): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# SOME-LABEL: code f3:Body
# SOME: = StringRange {{*}}method=Substr
# SOME: = Substring
# the whole text is the text: function whole(s) { if (typeof s === "string") return [s.slice(0)]; }
# RUN(WHOLE): walk f4 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# WHOLE-LABEL: code f4:Body
# WHOLE-NOT: = Substring
# WHOLE-NOT: = StringRange
# WHOLE: = NewArray
# nobody knows what the position is, so the function converts it itself: function from(s, a) { if (typeof s === "string") return [s.slice(a)]; }
# RUN(UNKNOWN): walk f5 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# UNKNOWN-LABEL: code f5:Body
# UNKNOWN-NOT: = StringRange
# UNKNOWN: = NewArray
# a piece is compared where it lies: function beginsWith(s, n) { if (typeof s === "string" && (n | 0) === n) return [s.slice(0, n) === "ab"]; }
# RUN(EQUAL): walk f6 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# EQUAL-LABEL: code f6:Body
# EQUAL: = StringRange
# EQUAL: literal="ab"
# RUN(UNCUT): walk f6 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# UNCUT-NOT: = Substring
# the edge hands the piece on as the text that it equals, so the piece is cut and compared: function itself(s, n) { if (typeof s === "string" && (n | 0) === n) { const p = s.slice(0, n); if (p === "ab") return p; } }
# RUN(NARROWED): walk f7 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NARROWED-LABEL: code f7:Body
# NARROWED: = Substring
# a number is read off the characters where they lie: function amount(s) { if (typeof s === "string") return [+s.slice(2)]; }
# RUN(NUMBER): walk f8 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NUMBER-LABEL: code f8:Body
# NUMBER: = StringRangeToNumber
# RUN(NUMBERUNCUT): walk f8 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NUMBERUNCUT-NOT: = Substring
# function parsed(s) { if (typeof s === "string") return [parseInt(s.slice(2), 16)]; }
# RUN(PARSED): walk f9 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# PARSED-LABEL: code f9:Body
# PARSED: = StringRangeParseInt

