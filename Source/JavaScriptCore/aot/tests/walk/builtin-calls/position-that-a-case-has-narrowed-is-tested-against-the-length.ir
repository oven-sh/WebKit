# the name that a case of a switch gives a position hangs on no test, so it says nothing of the length: the bound is tested, and the walk comes through
# function pick(s, i) { if (typeof s === "string") switch (i) { case 2: return [s.charCodeAt(i)]; } }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = GetStringLength
# CHECK: = Less
# CHECK: = GetStringCodeUnit
# RUN(ALL): walk f1 mechanisms=all
# ALL-LABEL: code f1:Body
# ALL: = GetStringCodeUnit

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="pick" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    Switch v1 cases=[2] -> case b2(| 0), otherwise b3()
  b2(v4):
    v5 = PropGet v3 key="charCodeAt"
    v6 = Call v5, v3, v4 calleeKey="charCodeAt"
    v7 = NewArray v6 contents=anything
    Return v7
  b3():
    v8 = Undefined
    Return v8
}
