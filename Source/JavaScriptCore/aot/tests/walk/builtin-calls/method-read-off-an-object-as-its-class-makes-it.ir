# an object of one of the engine's classes may hide what its class gives it under a property of its own, and may stand below something else by now. One that was made here and that nothing has changed since is as its class makes it:
# the method that is read off it is the member of the class, and the call goes by the row that takes such an object. A row that changes no names and no prototype leaves it so
# function filled(a, b) { const list = []; list.push(a); list.push(b); return list; }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = CallBuiltin {{*}}overload=ArrayPrototypePush/0
# CHECK: = CallBuiltin {{*}}overload=ArrayPrototypePush/0
# RUN(NEVER): walk f1 mechanisms=all
# NEVER-NOT: PropGet
# RUN(UNASKED): walk f1 mechanisms=all
# UNASKED-NOT: IsPristine
# A store under a name ends that. The class is still proven, so one bit of the cell says whether the object is as made: it is asked when the code runs, outside of loops too, and behind it stands the built-in's own code.
# Where the bit says no, the read and the call are made as they are written.
# function hidden(a, own) { const list = []; list.push = own; return list.push(a); }
# RUN(HIDDEN): walk f2 mechanisms=all
# HIDDEN-LABEL: code f2:Body
# HIDDEN: PropSet
# HIDDEN-NOT: overload=ArrayPrototypePush
# HIDDEN: = IsPristine {{*}}builtinClass=Array
# HIDDEN: TryCallInline {{*}}inlineBuiltin=ArrayPush
# HIDDEN: frequency=Rare
# HIDDEN: = PropGet {{*}}key="push"
# RUN(UNTESTED): walk f2 mechanisms=all-Guesses
# UNTESTED-LABEL: code f2:Body
# UNTESTED-NOT: overload=ArrayPrototypePush
# UNTESTED: = PropGet {{*}}key="push"
# UNTESTED-NOT: overload=ArrayPrototypePush
# So does another prototype: function below(a, other) { const list = []; Object.setPrototypeOf(list, other); return list.push(a); }
# RUN(BELOW): walk f3 mechanisms=all-Guesses
# BELOW-LABEL: code f3:Body
# BELOW-NOT: overload=ArrayPrototypePush
# BELOW: = PropGet {{*}}key="push"
# BELOW-NOT: overload=ArrayPrototypePush
# And code that nobody has seen: function seen(a, look) { const list = []; look(list); return list.push(a); }
# RUN(SEEN): walk f4 mechanisms=all-Guesses
# SEEN-LABEL: code f4:Body
# SEEN-NOT: overload=ArrayPrototypePush
# SEEN: = PropGet {{*}}key="push"
# SEEN-NOT: overload=ArrayPrototypePush
# What a constructor of the engine has made here is as its class makes it: function mapped(k) { const map = new Map(); map.set(k, 1); return map.get(k); }
# RUN(MAP): walk f5 mechanisms=all
# MAP-LABEL: code f5:Body
# MAP-NOT: PropGet
# MAP: overload=MapPrototypeSet
# MAP-NOT: PropGet
# MAP: overload=MapPrototypeGet

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
