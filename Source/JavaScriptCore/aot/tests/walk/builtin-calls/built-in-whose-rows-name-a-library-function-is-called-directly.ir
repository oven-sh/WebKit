# the rows of Array.prototype.findLast all name one function of the library, whose closure the function object is. Where the text is not copied the call enters that function directly
# a value that anybody hands over names no built-in, and is called by value
# function each(list, f) { return Array.prototype.findLast.call(list, f); } function calls(make, list, f) { return make.call(list, f); } sink(each, calls);
# by hand, with the text of the library function as walk/guesses/library-method-handed-a-closure-in-a-loop-is-copied-behind-tests.ir has it: what the front end writes for a source block holds no function of the library
# LIBRARY: own
# RUN: walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = CallDirect {{*}}function=f3
# RUN(NEVER): walk f1 mechanisms=none+DirectCalls+BuiltinCalls
# NEVER-NOT: = CallBuiltin
# RUN(OTHER): walk f2 mechanisms=none+DirectCalls+BuiltinCalls
# OTHER-LABEL: code f2:Body
# OTHER: = Call
# RUN(NONE): walk f2 mechanisms=none+DirectCalls+BuiltinCalls
# NONE-NOT: CallDirect

module m0 path="main.js" displayPath="main.js" body=f0
