  b0(v0: anything, v1: anything, v2: anything):
    v3 = ToObject v0
    v4 = PropGet v3 key="length"
    v5 = ToLength v4
    v6 = Integer
    Jump -> next b1(v6)
  b1(v7):
    LoopHint
    v9 = Less v7, v5
    Branch v9 -> taken b2(), notTaken b5()
  b2():
