    v5 = Builtin builtin=Array
    v6 = Builtin builtin=ArrayIsArray
    v7 = Call v6, v5, v4
    v8 = ToBoolean v7
    Branch v8 -> taken b3(), notTaken b5()
  b3():
    Jump -> next b4(v3)
  b4(v9):
    v10 = NarrowByTest v0, v9
    v11 = PropGet v10 key="length"
