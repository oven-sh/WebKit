# if (Array.isArray(x)) return x.length; return 0;   The front end writes a look at the cell in front of the call, and the call for whatever fails the look: the prototype of lists, an instance of a class below and a proxy of a list pass the function and fail the look.
# Of a value of which nothing is known the function has to be asked in any case, and it answers for a list too: the look would be one test more on every way. It is left out, and every value goes the way of the function.
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK-NOT: TypeTest
# CHECK: inlineBuiltin=ArrayIsArray
# Of a text or a list the cell answers: the look is the test, the function is asked of nothing, and the arm reads the length of a list.
# RUN(KNOWN): walk f2 mechanisms=all
# KNOWN-LABEL: code f2:Body
# KNOWN: ([[x]]: string|Array{{*}}entry=0
# KNOWN: [[look]]: boolean {{*}} = TypeTest [[x]] testedType=Array
# KNOWN: Branch [[look]]
# KNOWN: = GetArrayLength
# RUN(NEVER): walk f2 mechanisms=all
# NEVER-NOT: ArrayIsArray

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = String string="abc"
    v3 = Integer integer=1
    v4 = NewArray v3 contents=anything
    v5 = Call v1, -, v2
    v6 = Call v1, -, v4
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="sink" [isFreeName]
    v9 = Call v8, -, v0, v5, v6
    Return v9
}
function f1 name="ofAnything" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=Array
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Jump -> next b4(v2)
  b2(v3):
    v4 = NarrowByTest v0, v3
    v5 = Builtin builtin=Array
    v6 = Builtin builtin=ArrayIsArray
    v7 = Call v6, v5, v4
    v8 = ToBoolean v7
    Branch v8 -> taken b3(), notTaken b5()
  b3():
    Jump -> next b4(v3)
  b4(v9):
    v10 = NarrowByTest v0, v9
    v11 = PropGet v10 key="length"
    Return v11
  b5():
    v12 = Integer integer=0
    Return v12
}
