# -- source: a-slice-of-arguments-in-sight-is-never-made-from-source.js
# var slice = Array.prototype.slice;
# function tail() { var args = slice.call(arguments, 1); return args.length ? args[0] : 0; }
# function run(n) { var total = 0; for (var i = 0; i < n; i++) total += tail(9, i & 3); return total; }
# globalThis.run = run;
# -- end of source
