# `Object.prototype.hasOwnProperty.call(o, "name")`, `has.call(o, k)`, `Math.max.apply(null, [a, b])`: the row of `call` and of `apply` does nothing but forward the call to an operand, so that operand is
# called where the call stands. Where it is one built-in, the forwarded call goes by the rows of that built-in, as a call that is written out does: the operation, the code in line, or the function itself
# entered without a look at the value that is called.
# If the rows were not asked, a plain Call of the value would stand there, which fetches the function object and enters the host's function through the stub for calls of any value.
# function hasName(o) { return Object.prototype.hasOwnProperty.call(o, "name"); }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: : boolean @Boolean = PropHasOwn v0 key="name" calledBuiltin=ObjectPrototypeHasOwnProperty
# RUN(NEVER): walk f1 f2 f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NEVER-NOT: = Call v
# function isListed(o, k) { return Object.prototype.propertyIsEnumerable.call(o, String(k)); }
# RUN(TEXT): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# TEXT-LABEL: code f2:Body
# TEXT: : boolean @Boolean = CallInline {{*}}inlineBuiltin=ObjectPropertyIsEnumerable overload=ObjectPrototypePropertyIsEnumerable
# A key that may be an object can tell in which order the function converts: the function itself is entered, as for `o.hasOwnProperty(k)`. function has(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
# RUN(ORDER): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# ORDER-LABEL: code f3:Body
# ORDER-NOT: CallInline
# ORDER: = CallBuiltin {{*}}overload=ObjectPrototypeHasOwnProperty{{*}}builtinCallForm=AnyReceiver
# function larger(a, b) { return Math.max.apply(null, [a | 0, b | 0]); }
# RUN(LIST): walk f4 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls+Folding+EscapeAnalysis
# LIST-LABEL: code f4:Body
# LIST-NOT: = CallList v
# LIST: = CallInline {{*}}inlineBuiltin=MathMax overload=MathMax
# `f.call()` hands over undefined where a call that passes no `this` is handed the holder: it stays a call of the value. function named() { return Object.prototype.toString.call(); }
# RUN(NOTHING): walk f5 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# NOTHING-LABEL: code f5:Body
# NOTHING-NOT: CallBuiltin
# NOTHING: = Call v
# The row of a method is written for receivers that a call by a member can have, never undefined or null, and only `call` brings such a receiver. The function refuses them, so the call stays where nobody takes
# what it gives: function refused(o) { Object.prototype.hasOwnProperty.call(o, "a"); Object.prototype.isPrototypeOf.call(o, o); }
# If it were swept away, `refused(null)` would return where a TypeError is due.
# RUN(UNUSED): walk f6 mechanisms=all
# UNUSED-LABEL: code f6:Body
# UNUSED: = PropHasOwn v0 key="a" calledBuiltin=ObjectPrototypeHasOwnProperty
# UNUSED: = CallInline {{*}}inlineBuiltin=ObjectIsPrototypeOf overload=ObjectPrototypeIsPrototypeOf
# With calls of built-ins withheld the call stays as it is written.
# RUN(CLOSED): walk f1 mechanisms=none+TypedOperations+DirectCalls
# CLOSED-LABEL: code f1:Body
# CLOSED-NOT: CallInline
# CLOSED: = Call v

module m0 path="main.js" displayPath="main.js" body=f0
