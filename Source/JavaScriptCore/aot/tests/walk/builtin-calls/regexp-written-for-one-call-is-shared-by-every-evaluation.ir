# Each evaluation of a literal makes an object of its own. Where the body names it nowhere but at one call, whose row hands it to nobody and leaves it as it was made, nobody can tell:
# the one object in the cell of the literal stands in its place, and the sweep drops the allocation.
# function every(s: string, t: string) { return s.replace(/a/g, t); }
# RUN: walk f1 mechanisms=all
# CHECK-LABEL: code f1:Body
# CHECK: = SharedRegExpLiteral pattern="a" regExpFlags=[Global]
# CHECK: inlineBuiltin=StringReplace
# RUN(DROPPED): walk f1 mechanisms=all
# DROPPED-NOT: = NewRegExp
# function cut(s: string) { return s.split(/,/); }
# RUN(CUT): walk f2 mechanisms=all
# CUT-LABEL: code f2:Body
# CUT-NOT: = NewRegExp
# CUT: = SharedRegExpLiteral pattern=","
# CUT: inlineBuiltin=StringSplit
# y begins at lastIndex and stores it, so the next evaluation would go on where this one stopped: function sticky(s: string, t: string) { return s.replace(/a/y, t); }
# RUN(STICKY): walk f3 mechanisms=all
# STICKY-LABEL: code f3:Body
# STICKY-NOT: SharedRegExpLiteral
# STICKY: = NewRegExp pattern="a" regExpFlags=[Sticky]
# Somebody else has it too: function kept(s: string, t: string) { const re = /a/g; sink(re); return s.replace(re, t); }
# RUN(KEPT): walk f4 mechanisms=all
# KEPT-LABEL: code f4:Body
# KEPT-NOT: SharedRegExpLiteral
# KEPT: = NewRegExp pattern="a" regExpFlags=[Global]
# It is handed back: function returned(s: string) { const re = /,/; s.split(re); return re; }
# RUN(RETURNED): walk f5 mechanisms=all
# RETURNED-LABEL: code f5:Body
# RETURNED-NOT: SharedRegExpLiteral
# RETURNED: = NewRegExp pattern=","
# It gets a property: function tagged(s: string) { const re = /,/; re.tag = 1; return s.split(re); }
# RUN(TAGGED): walk f6 mechanisms=all
# TAGGED-LABEL: code f6:Body
# TAGGED-NOT: SharedRegExpLiteral
# TAGGED: = NewRegExp pattern=","
# Nothing is fresh with EscapeAnalysis withheld, and with BuiltinCalls withheld no call goes by a row.
# RUN(NOTFRESH): walk f1 mechanisms=all-EscapeAnalysis
# NOTFRESH-NOT: SharedRegExpLiteral
# RUN(WITHHELD): walk f1 mechanisms=all-BuiltinCalls
# WITHHELD-NOT: SharedRegExpLiteral

