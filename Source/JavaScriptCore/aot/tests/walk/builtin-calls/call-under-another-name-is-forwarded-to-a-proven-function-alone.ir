# `holder.kept = Function.prototype.call; holder.kept(undefined, 1)`: the row of `call` forwards the call to its receiver. Plain Bun compiles `f.call(..)` to a call of `f`, and where `f` is no function its error
# quotes the site. Under another name it is the built-in that finds that its receiver is no function, and its error quotes nothing: "Object is not a function".
# So under another name the call is forwarded where the receiver is proven a function, and stays as it is written where it is not.
# If it were forwarded, the error would say "holder.kept is not a function", and holder.kept is one.
# function kept(holder) { return holder.kept(undefined, 1); }
# RUN: walk f1 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# CHECK-LABEL: code f1:Body
# CHECK: = Call {{*}}calleeKey="kept"
# function spelled(holder) { return holder.call(undefined, 1); }
# RUN(SPELLED): walk f2 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# SPELLED-LABEL: code f2:Body
# SPELLED-NOT: calleeKey="call"
# function proven() { const one = () => 1; return one.kept(undefined, 1); }
# RUN(PROVEN): walk f3 mechanisms=none+TypedOperations+DirectCalls+BuiltinCalls
# PROVEN-LABEL: code f3:Body
# PROVEN-NOT: calleeKey="kept"

