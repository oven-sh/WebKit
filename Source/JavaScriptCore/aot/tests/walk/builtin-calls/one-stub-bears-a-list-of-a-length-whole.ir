# A list of a length was born at its site by a comparison, two operations for the room, the call of a stub, a test for null, the store of the length, and on a rare path the call of an operation with four operands: about 110 bytes.
# ONE STUB DOES ALL OF IT: the site is the length in a register and a call. What the stub does not bear (over 127 places, a length that is none) the operation behind it bears or refuses.
# REQUIRES: as-written
# RUN: bytes f1 mechanisms=all
# CHECK: Call Stub NewArrayOfLength
# REQUIRES(OLD): as-written
# RUN(OLD): bytes f1 mechanisms=all
# OLD-NOT: Call Stub NewArrayWithLength
# REQUIRES(GIVEN): as-written
# RUN(GIVEN): bytes f4 mechanisms=all
# GIVEN: Call Stub NewArrayOfGiven
# The list was born with the written bound as its written length: no room is reserved for it in front of the loop that fills it.
# RUN(ROOM): walk f5 mechanisms=all
# ROOM: = NewArrayLike
# RUN(NOROOM): walk f5 mechanisms=all
# NOROOM-NOT: ReserveArrayCapacity
# Lists with room for one are born between lists that live: the stub writes nothing behind its own cell.
# RUN(ANSWER): run-in-shell mechanisms=all globalThis.sink = (whole, fractions, texts, given, filled) => { const kind = list => /ArrayWith([A-Za-z0-9]+)/.exec(describe(list))[1]; const tell = f => { try { const list = f(); let holes = 0; for (let at = 0; at < list.length && at < 300; at++) if (!(at in list)) holes++; return kind(list) + ":" + list.length + ":" + holes + ":" + String(list[0]); } catch (error) { return error.constructor.name; } }; for (const f of [whole, fractions, texts]) print([0, 1, 2, 3, 4, 126, 127, 128, 129, 1000, 99999, -1, -2147483648].map(n => tell(() => f(n))).join(" ")); print([0, 1, 2, 127, 128, -1, 2147483647, 1.5, "3", null, 4.0].map(x => tell(() => given(x))).join(" ")); print(tell(filled), filled().join("").length); const many = []; for (let turn = 0; turn < 3000; turn++) { const list = given(turn & 3); for (let at = 0; at < list.length; at++) list[at] = turn; many.push(list); } let wrong = 0; for (let turn = 0; turn < 3000; turn++) { const list = many[turn]; if (list.length !== (turn & 3)) wrong++; for (let at = 0; at < list.length; at++) if (list[at] !== turn) wrong++; } print(wrong); const kept = []; for (let turn = 0; turn < 20000; turn++) { const list = given(1); list[0] = turn; if (turn & 1) kept.push(list); } gc(); const between = []; for (let turn = 0; turn < 20000; turn++) between.push(given(turn & 1)); let broken = 0; for (let at = 0; at < kept.length; at++) if (kept[at].length !== 1 || kept[at][0] !== 2 * at + 1) broken++; print(broken, between.length); };
