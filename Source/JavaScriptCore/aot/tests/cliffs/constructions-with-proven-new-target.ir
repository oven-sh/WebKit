# What the rule "a constructor allocates what new.target asks for" costs where everything is proven: nothing. class Base, class Sub extends Base, class Other; a loop that stores new Base(i), new Sub(i, 1), new Other(i)
# in variables and calls their methods. Each construction is one allocation of the exact class that lists its fields, without a read of a prototype, and no test of a shape, a type, a prototype or a slot,
# no access by name and no call is left in the loop, in whichever function the inliner leaves it. The constructor of Base as other callers enter it allocates under the prototype of new.target and takes the two layouts from flow's proof, without a test.
# RUN: pipeline NumberAndEncode
# CHECK: LoopHint
# CHECK-NOT: ShapeTest
# CHECK-NOT: TypeTest
# CHECK-NOT: GetConstructPrototype
# CHECK: : L0 = NewObject -, {{*}} layout=L0 fields=[0]
# CHECK: : L1 = NewObject -, {{*}} layout=L1 fields=[1, 0]
# CHECK: : L2 = NewObject -, {{*}} layout=L2 fields=[0]
# CHECK-NOT: ShapeTest
# CHECK-NOT: TypeTest
# CHECK-NOT: HasLayoutPrototype
# CHECK-NOT: IsSlotFilled
# CHECK-NOT: PropGet
# CHECK-NOT: PropSet
# CHECK-NOT: = Call
# CHECK: = Increment
# CHECK-LABEL: function f2 name="Base"
# CHECK: [[prototype]]: object = GetConstructPrototype
# CHECK-NEXT: [[allocated]]: object = NewObject [[prototype]] layout=L0
# CHECK-NEXT: [[proven]]: L0|L1 = AssumeType [[allocated]] provenType=L0|L1
# CHECK-NEXT: PutSlot [[proven]], -, {{*}} key="x" receivers=[L0, L1] level=Proven

layout L0 kind=Instance name="Base" module=m0 position=6 constructor=f2 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Sub" module=m0 position=83 base=L0 constructor=f4 fields=[{key="y" declared={type=anything}}] supertypes=[L0] flags=[HasHeritage]
layout L2 kind=Instance name="Other" module=m0 position=188 constructor=f6 fields=[{key="z" declared={type=anything}}]
variable g0 name="Base" module=m0 declared={type=function|absent} flags=[IsImmutable]
variable g1 name="Sub" module=m0 declared={type=function|absent} flags=[IsImmutable]
variable g2 name="Other" module=m0 declared={type=function|absent} flags=[IsImmutable]
variable g3 name="b" module=m0 declared={type=anything|absent}
variable g4 name="s" module=m0 declared={type=anything|absent}
variable g5 name="o" module=m0 declared={type=anything|absent}
variable g6 module=m0 declared={type=function} flags=[IsImmutable]
variable g7 module=m0 declared={type=function} flags=[IsImmutable]
variable g8 module=m0 declared={type=function} flags=[IsImmutable]
module m0 path="/$bunfs/root/hot-variables" displayPath="hot-variables.js" body=f0
