# A constructor allocates what new.target asks for, and for a class that is not below its own the run time makes an ordinary object. `this` is the allocation behind a check for the layouts of the class.
# Made is constructed for itself alone: flow folds the check. Given is also constructed for Other (Reflect.construct(Given, [], Other)): the check stays, and nothing assumes a layout of what it tests.
# RUN: pipeline ApplyFlowResults
# CHECK-LABEL: function f1 name="Made"
# CHECK: [[made]]: object ~ L0 = NewObject
# CHECK-NOT: = Check
# CHECK: : L0 = AssumeType [[made]] castType=L0
# CHECK: PropSet
# CHECK-LABEL: function f2 name="Given"
# CHECK: [[given]]: object ~ L1 = NewObject
# CHECK-NOT: = AssumeType [[given]]
# CHECK: : L1 = Check [[given]] castType=L1
# CHECK: PropSet

layout L0 kind=Instance name="Made" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Given" module=m0 constructor=f2 fields=[{key="x" declared={type=anything}}]
layout L2 kind=Instance name="Other" module=m0 constructor=f3 fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}]
data d0 root=Array{contents=anything} module=m0
module m0 path="/$bunfs/root/main" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = NewClosure function=f3
    v7 = NewClass v6 layout=L2
    v8 = FinishClass v7 layout=L2
    v9 = Construct v2 calleeName="Made"
    v10 = Construct v5 calleeName="Given"
    v11 = Construct v8 calleeName="Other"
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="Reflect" [isFreeName]
    v14 = PropGet v13 key="construct"
    v15 = Data data=d0
    v16 = Call v14, v13, v5, v15, v8 calleeKey="construct" calleeName="construct"
    v17 = PropGet v9 key="x"
    v18 = PropGet v10 key="x"
    v19 = PropGet v16 key="x"
    v20 = PropGet v11 key="a"
    v21 = Add v17, v18
    v22 = Add v21, v19
    v23 = Add v22, v20
    Return v23
}
function f1 name="Made" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Integer integer=1
    PropSet v3, v4 key="x"
    Return v3
}
function f2 name="Given" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    v3 = Convert v2 declared={type=L1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Integer integer=2
    PropSet v3, v4 key="x"
    Return v3
}
function f3 name="Other" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    v3 = Convert v2 declared={type=L2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Integer integer=3
    PropSet v3, v4 key="a"
    PropSet v3, v4 key="b"
    Return v3
}
entry module=m0
