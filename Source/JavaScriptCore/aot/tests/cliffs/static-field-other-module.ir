# A module that imports a class reads its static fields as variables, also in a cycle of modules: the binding it gets the class object from is stored after the definitions. A class object that the initializer hands to the partner before a definition has no proof for that field
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses
# RUN: pipeline ResolveAccesses
# RUN(ORDER): flow-order locations failed
# ORDER: g1: Unknown AtMostOnce
# ORDER-NEXT: g2: StoredBeforeEveryRead AtMostOnce
# ORDER-NEXT: g3: StoredBeforeEveryRead AtMostOnce
# ORDER: g6: Unknown AtMostOnce
# ORDER: read-before-initialization g1
# ORDER-NEXT: read-before-initialization g6
# ORDER-NOT: read-before-initialization

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}]
module m1 path="ordered.js" displayPath="ordered.js" body=f1 exports=[{name="Ordered" variable=g0}]
module m2 path="cyclic.js" displayPath="cyclic.js" body=f4 requests=[{target=m3}] exports=[{name="Cyclic" variable=g1}]
module m3 path="partner.js" displayPath="partner.js" body=f7 requests=[{target=m2}] exports=[{name="readCyclic" variable=g4}, {name="readGiven" variable=g5}]
entry module=m0
layout L0 kind=Instance name="Ordered" constructor=f2 staticFields=[{key="count" variable=g2}]
layout L1 kind=Instance name="Cyclic" constructor=f5 staticFields=[{key="count" variable=g3}, {key="late" variable=g6}]
variable g0 name="Ordered" module=m1 declared={type=function|absent} flags=[IsImmutable]
variable g1 name="Cyclic" module=m2 declared={type=function|absent} flags=[IsImmutable]
variable g2 module=m1 declared={type=anything} owner=L0
variable g3 module=m2 declared={type=anything} owner=L1
variable g4 name="readCyclic" module=m3 declared={type=function} initialization=Function function=f8 flags=[IsImmutable]
variable g5 name="readGiven" module=m3 declared={type=function} initialization=Function function=f9 flags=[IsImmutable]
variable g6 module=m2 declared={type=anything} owner=L1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="Ordered"
    v2 = PropGet v1 key="count"
    v3 = GetModuleVariable variable=g4
    v4 = Call v3
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = GetModuleVariable variable=g2
# CHECK-NOT: key="count"
function f1 name="ordered" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = CallDirect v2 function=f3
    PutModuleVariable v2 variable=g0
    Return
}
function f2 name="Ordered" module=m1 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f3 name="initializeOrdered" module=m1 kind=Initializer flags=[HasThis] thisType={type=function} results=[{type=anything}] {
  b0(v0: function):
    v1 = Integer integer=1
    PropDefine v0, v1 key="count"
    Return
}
function f4 name="cyclic" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = NewClass v0 layout=L1
    v2 = FinishClass v1 layout=L1
    v3 = CallDirect v2 function=f6
    PutModuleVariable v2 variable=g1
    Return
}
function f5 name="Cyclic" module=m2 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f6 name="initializeCyclic" module=m2 kind=Initializer flags=[HasThis] thisType={type=function} results=[{type=anything}] {
  b0(v0: function):
    v1 = Integer integer=1
    PropDefine v0, v1 key="count"
    v3 = GetModuleVariable variable=g5
    v4 = Call v3, -, v0
    PropDefine v0, v1 key="late"
    Return
}
function f7 name="partner" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f8 name="readCyclic" module=m3 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="Cyclic"
    v2 = PropGet v1 key="count"
    Return v2
}
