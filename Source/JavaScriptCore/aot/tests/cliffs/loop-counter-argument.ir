# A loop counter under a parameter that only flow knows to be an int32 reaches a callee as an integer, and the callee compares integers. Under a bound that may hold a fraction it arrives as a double
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline ChooseRepresentations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Integer integer=0
    v4 = BitOr v2, v3
    v5 = CallDirect v4, v4 function=f1
    v6 = CallDirect v2, v4 function=f3
    v7 = Add v5, v6
    Return v7
}
function f1 name="countsToInt32" parameters=[{type=undefined|null|number}, {type=i32}] results=[{type=anything}] {
  b0(v0: undefined|null|number, v1: i32):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v3, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallDirect v7, v1 function=f2
    v9 = BitXor v4, v8
    v10 = Increment v7
    Jump -> next b1(v10, v9)
  b3():
    Return v4
}
function f2 name="comparesIntegers" parameters=[{type=undefined|null|number}, {type=i32}] results=[{type=anything}] {
  b0(v0: undefined|null|number, v1: i32):
    v2 = Less v1, v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
function f3 name="countsToNumber" parameters=[{type=undefined|null|number}, {type=i32}] results=[{type=anything}] {
  b0(v0: undefined|null|number, v1: i32):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v3, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallDirect v7, v1 function=f4
    v9 = BitXor v4, v8
    v10 = Increment v7
    Jump -> next b1(v10, v9)
  b3():
    Return v4
}
function f4 name="comparesNumbers" parameters=[{type=undefined|null|number}, {type=i32}] results=[{type=anything}] {
  b0(v0: undefined|null|number, v1: i32):
    v2 = Less v1, v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
