# All evaluations of a class share the variables of its static fields, and the definition in one evaluation says nothing about the class object of the next. A class that a loop evaluates again keeps no proof and is read by name
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses
# RUN: pipeline ResolveAccesses
# RUN(ORDER): valueflow-apply
# ORDER: variable g0 module=
# ORDER-NOT: stores=AtMostOnce
# ORDER-NOT: initialization=StoredBeforeEveryRead
# ORDER: module m0 path=
# CHECK-NOT: evaluations=AtMostOnce

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" constructor=f1 staticFields=[{key="count" variable=g0}]
variable g0 module=m0 declared={type=anything} owner=L0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = NewClosure function=f1
    v5 = NewClass v4 layout=L0
    v6 = FinishClass v5 layout=L0
    v7 = CallDirect v6 function=f2
    v8 = PropGet v6 key="count"
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return
# CHECK: = PropGet [[classObject]] key="count"
}
function f1 name="Counter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="initializeCounter" kind=Initializer flags=[HasThis] thisType={type=function} results=[{type=anything}] {
    v1 = Integer integer=1
    PropDefine v0, v1 key="count"
    Return
# CHECK: PropDefine v0, v1 key="count"
}
