# A class definition with a heritage records it in the heritage node, creates the class object with the parent class as its prototype and the prototype object with the parent's prototype object; a class without a heritage has no link nodes
# RUN: flow-solve nodes
# CHECK-NOT: Heritage(L0)
# CHECK: Heritage(L1) = {f1}
# CHECK-NOT: PrototypeLink(f1
# CHECK: PrototypeLink(f2) = {f1}
# CHECK-NOT: PrototypeLink(f1
# CHECK: PrototypeLink(f2.prototype) = {f1.prototype}
# CHECK-NOT: PrototypeLink(f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" predictedBase=L0 constructor=f2 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
