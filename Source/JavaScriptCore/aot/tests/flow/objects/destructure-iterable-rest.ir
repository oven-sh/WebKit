# An array pattern gives each target the element at its position and collects the others in an array of its own, unless the array has an iterator of its own
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#0}
# CHECK-NEXT: Variable(g1) = {Array@f0:v10}
# CHECK-NEXT: Variable(g2) = {{*}}unknown
# CHECK: DeclaredPart(Array@f0:v10, 0) = {{*}}L1#1}
# CHECK: , f1, result 0) =

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Replaced" fields=[{key="r" declared={type=anything} flags=[IsRequired]}]
variable g0 name="first" declared={type=anything} initialization=Uninitialized
variable g1 name="others" declared={type=anything} initialization=Uninitialized
variable g2 name="replaced" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewArray v2, v4 contents=anything
    v6 = IteratorOpen v5 elementCount=1 [isDestructuring, hasRest]
    v7 = IteratorResume v6 stepIndex=0
    v8 = ResultAt v7 index=1
    PutModuleVariable v8 variable=g0
    v10 = NewArray contents=anything
    Jump -> next b1()
  b1():
    LoopHint
    v12 = IteratorResume v6 stepIndex=1
    v13 = ResultAt v12 index=0
    Branch v13 -> taken b3(), notTaken b2()
  b2():
    v14 = ResultAt v12 index=1
    AppendElement v10, v14
    Jump -> next b1()
  b3():
    PutModuleVariable v10 variable=g1
    v17 = NewObject -, v0 layout=L2 fields=[0]
    v18 = FinishObject v17
    v19 = NewArray v18 contents=anything
    v20 = NewClosure function=f1
    PropSet v19, v20 key=@@iterator
    v22 = IteratorOpen v19 elementCount=1 [isDestructuring]
    v23 = IteratorResume v22 stepIndex=0
    v24 = ResultAt v23 index=1
    PutModuleVariable v24 variable=g2
    Return
}
function f1 name="iterator" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="id" [isFreeName]
    Return v1
}
