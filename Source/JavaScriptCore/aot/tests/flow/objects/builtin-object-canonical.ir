# Two entries of the table that name the same object have one flow object, under the entry the alias names; another entry has an object of its own
# RUN: flow-sites solved
# RUN(NODES): flow-solve nodes
# CHECK-NOT: ArrayPrototypeSymbolIterator
# CHECK: object {{*}} ArrayPrototypeValues kind=Builtin parts=0 positions=0 undeclared=no
# CHECK-NOT: ArrayPrototypeValues
# CHECK-NOT: ArrayPrototypeSymbolIterator
# CHECK: object {{*}} ArrayPrototypeKeys kind=Builtin parts=0 positions=0 undeclared=no
# CHECK-NOT: ArrayPrototypeValues
# CHECK-NOT: ArrayPrototypeSymbolIterator
# NODES: Variable(g0) = {ArrayPrototypeValues}
# NODES-NEXT: Variable(g1) = {ArrayPrototypeValues}
# NODES-NEXT: Variable(g2) = {ArrayPrototypeKeys}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="alias" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="named" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="other" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ArrayPrototypeSymbolIterator
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=ArrayPrototypeValues
    PutModuleVariable v2 variable=g1
    v4 = Builtin builtin=ArrayPrototypeKeys
    PutModuleVariable v4 variable=g2
    Return
}
