# The pair of a step over a map is the array that the expansion of the loop creates, so with the flow results applied the body of a loop over entries stays reachable like the body of a loop over keys
# RUN: pipeline Select
# CHECK-LABEL: function f0 name="main"
# CHECK: [[print]]: anything = PropGet v0 key="print"
# CHECK-COUNT-4: = Call{{*}} [[print]],
# CHECK-LABEL: function f1 name=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Key" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Value" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = PropGet v0 key="Map" [isFreeName]
    v3 = Construct v2
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    v7 = Integer integer=2
    v8 = NewObject -, v7 layout=L1 fields=[0]
    v9 = FinishObject v8
    v10 = PropGet v3 key="set"
    v11 = Call v10, v3, v6, v9 calleeKey="set"
    v12 = PropGet v3 key="keys"
    v13 = Call v12, v3 calleeKey="keys"
    v14 = IteratorOpen v13
    Jump -> next b1()
  b1():
    LoopHint
    v16 = IteratorResume v14
    v17 = ResultAt v16 index=0
    Branch v17 -> taken b3(), notTaken b2()
  b2():
    v18 = ResultAt v16 index=1
    v19 = PropGet v18 key="x"
    v20 = Call v1, -, v19
    Jump -> next b1()
  b3():
    v21 = IteratorOpen v3
    Jump -> next b4()
  b4():
    LoopHint
    v23 = IteratorResume v21
    v24 = ResultAt v23 index=0
    Branch v24 -> taken b6(), notTaken b5()
  b5():
    v25 = ResultAt v23 index=1
    v26 = IteratorOpen v25 elementCount=2 [isDestructuring]
    v27 = IteratorResume v26 stepIndex=0
    v28 = ResultAt v27 index=1
    v29 = IteratorResume v26 stepIndex=1
    v30 = ResultAt v29 index=1
    IteratorClose v26
    v32 = PropGet v28 key="x"
    v33 = Call v1, -, v32
    v34 = PropGet v30 key="y"
    v35 = Call v1, -, v34
    Jump -> next b4()
  b6():
    v36 = String string="done"
    v37 = Call v1, -, v36
    Return
}
