# A delete on the object of one site is a mutation of its allocation class alone: another site of the layout that never meets it keeps its fields
# RUN: flow-solve objects
# CHECK: L0#0 mutations=[{{*}}DeleteField
# CHECK: L0#1 mutations=[] uses=
# RUN(ALL): flow-solve objects
# ALL-NOT: L0#1 mutations=[{{*}}DeleteField

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="changed" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    PutModuleVariable v5 variable=g1
    v7 = GetModuleVariable variable=g0
    v8 = PropDelete v7 key="y"
    Return
}
