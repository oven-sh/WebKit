# An array literal has one part per position: a read by a constant index holds that element alone without undefined, and a read past the literal holds undefined alone. An array that is filled by appending and a literal with a hole have no positions
# RUN: flow-sites solved
# RUN(NODES): flow-solve nodes
# CHECK: site {{*}} function=f0 value=v17 kind=Instance origin=Operation builtinClass=Array class=
# CHECK: site {{*}} function=f1 value=v3 kind=Instance origin=Operation builtinClass=Array positions=2 class=
# CHECK: site {{*}} function=f3 value=v0 kind=Instance origin=Operation builtinClass=Array class=
# CHECK: object {{*}} Array@f0:v17 kind=Instance parts={{*}} positions=0 undeclared=no
# CHECK: object {{*}} Array@f1:v3 kind=Instance parts={{*}} positions=2 undeclared=no
# CHECK: object {{*}} Array@f3:v0 kind=Instance parts={{*}} positions=0 undeclared=no
# NODES: Variable(g0) = {L0#[[state]]}
# NODES-NEXT: Variable(g1) = {f2}
# NODES-NEXT: Variable(g2) = {undefined}
# NODES-NEXT: Variable(g3) = {undefined|L0#[[appended]]}
# NODES-NEXT: Variable(g4) = {undefined|"a"|"b"}
# NODES-NOT: Position(Array@f0:v17
# NODES: Position(Array@f1:v3, 0) = {L0#[[state]]}
# NODES-NEXT: Position(Array@f1:v3, 1) = {f2}
# NODES-NOT: Position(Array@f3:v0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="State" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="pastTheLiteral" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="appended" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="besideHole" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Integer integer=0
    v3 = ElemGet v1, v2
    PutModuleVariable v3 variable=g0
    v5 = Integer integer=1
    v6 = ElemGet v1, v5
    PutModuleVariable v6 variable=g1
    v8 = Integer integer=2
    v9 = ElemGet v1, v8
    PutModuleVariable v9 variable=g2
    v11 = NewClosure function=f3
    v12 = Call v11
    v13 = ElemGet v12, v2
    PutModuleVariable v13 variable=g3
    v15 = String string="a"
    v16 = String string="b"
    v17 = NewArray v15, v16 contents=anything holes=[1]
    v18 = ElemGet v17, v2
    PutModuleVariable v18 variable=g4
    Return
}
function f1 name="pair" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = NewArray v1, v2 contents=anything
    Return v3
}
function f2 name="setter" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="appended" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    AppendElement v0, v2
    Return v0
}
