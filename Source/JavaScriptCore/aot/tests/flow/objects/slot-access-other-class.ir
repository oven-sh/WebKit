# A step over the keys of a map whose receiver may also be an array answers the keys of the map and the unknown value, never the elements of the array
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {{*}}unknown|L0#0}
# CHECK: Variable(g1) = {undefined|L0#0}
# CHECK: f1, parameter 0) = {Array@f0:v12|Map@f0:v2
# RUN(MAP): flow-solve nodes
# MAP: f2, parameter 0) = {Map@f0:v2
# RUN(ALL): flow-solve nodes
# ALL-NOT: Variable(g0) = {{*}}L1#
# ALL-NOT: Variable(g0) = {{*}}L2#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Key" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Value" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Element" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
variable g0 name="keyOfEither" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="keyOfMap" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Map" [isFreeName]
    v2 = Construct v1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewObject -, v3 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = PropGet v2 key="set"
    v9 = Call v8, v2, v5, v7
    v10 = NewObject -, v3 layout=L2 fields=[0]
    v11 = FinishObject v10
    v12 = NewArray v11 contents=anything
    v13 = CallDirect v2 function=f1
    v14 = CallDirect v12 function=f1
    v15 = CallDirect v2 function=f2
    Return
}
function f1 name="stepEither" role=Library parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = Integer integer=0
    v2 = CollectionTable v0
    v3 = MapNext v0, v2, v1
    v4 = ResultAt v3 index=2
    PutModuleVariable v4 variable=g0
    Return
}
function f2 name="stepMap" role=Library parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = Integer integer=0
    v2 = CollectionTable v0
    v3 = MapNext v0, v2, v1
    v4 = ResultAt v3 index=2
    PutModuleVariable v4 variable=g1
    Return
}
