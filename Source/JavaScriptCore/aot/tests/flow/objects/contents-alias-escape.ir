# One alias that reaches an unknown callee sends the array to native code, and what the array holds goes with it
# RUN: flow-solve sinks
# CHECK: nativeCode {{*}}L0#{{*}}Array@f0:v3
# CHECK-NOT: L1#
# CHECK-NOT: L2#
# CHECK-NOT: Array@f0:v13

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Holder" fields=[{key="items" declared={type=anything} flags=[IsRequired]}]
layout L2 name="KeptItem" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="called" declared={type=anything} initialization=Uninitialized
variable g1 name="kept" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray v2 contents=anything
    PutModuleVariable v3 variable=g0
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = PropGet v6 key="items"
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = Call v9, -, v7
    v11 = NewObject -, v0 layout=L2 fields=[0]
    v12 = FinishObject v11
    v13 = NewArray v12 contents=anything
    PutModuleVariable v13 variable=g1
    Return
}
