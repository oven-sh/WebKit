# Arguments of direct calls of one function meet in its entry parameter and are united, and arguments of calls by value are not
# RUN: flow-sites classes
# CHECK: class A0 layout=L0 sites=[s0, s1] shared=
# CHECK: class A1 closure=f2 sites=[s2] shared=
# CHECK: class A2 layout=L0 sites=[s3] shared=
# CHECK: class A3 layout=L0 sites=[s4] shared=
# CHECK-NOT: class A4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = CallDirect v2 function=f1
    v4 = NewObject -, v0 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = CallDirect v5 function=f1
    v7 = NewClosure function=f2
    v8 = NewObject -, v0 layout=L0 fields=[0]
    v9 = FinishObject v8
    v10 = Call v7, -, v9
    v11 = NewObject -, v0 layout=L0 fields=[0]
    v12 = FinishObject v11
    v13 = Call v7, -, v12
    Return
}
function f1 name="calledDirectly" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="calledByValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
