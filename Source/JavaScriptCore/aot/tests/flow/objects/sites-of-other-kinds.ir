# Arrays, closures and regular expressions that meet keep one class and one object per site: only sites of a layout are united
# RUN: flow-sites classes
# CHECK: class A0 builtinClass=Array sites=[s0] shared=o{{*}}(Array@f0:v2)
# CHECK: class A1 builtinClass=Array sites=[s1] shared=o{{*}}(Array@f0:v3)
# CHECK: class A2 closure=f1 sites=[s2] shared=o{{*}}(f1)
# CHECK: class A3 closure=f1 sites=[s3] shared=o{{*}}(f1)
# CHECK: class A4 builtinClass=RegExp sites=[s4] shared=o{{*}}(RegExp@f0:v6)
# CHECK: class A5 builtinClass=RegExp sites=[s5] shared=o{{*}}(RegExp@f0:v7)
# CHECK: class A6 layout=L0 sites=[s6, s7] shared=o{{*}}(L0#6)
# CHECK-NOT: class A7

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = NewArray contents=anything @10
    v3 = NewArray contents=anything @20
    v4 = NewClosure function=f1
    v5 = NewClosure function=f1
    v6 = NewRegExp pattern="a" @30
    v7 = NewRegExp pattern="a" @40
    v8 = Integer integer=1
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = NewObject -, v8 layout=L0 fields=[0]
    v12 = FinishObject v11
    v13 = ToBoolean v1
    Branch v13 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2, v4, v6, v10)
  b2():
    Jump -> next b3(v3, v5, v7, v12)
  b3(v14, v15, v16, v17):
    Return
}
function f1 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
