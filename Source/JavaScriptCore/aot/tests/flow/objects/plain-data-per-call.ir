# Each call of a parse has an object site and an array site of its own, and the contents of one call hold nothing of the other
# RUN: flow-sites solved
# CHECK: site s{{*}} function=f0 value=v4 kind=PlainObject origin=BuiltinResult builtinClass=Object class=[[firstObject]] object=o{{*}}(Object@f0:v4)
# CHECK: site s{{*}} function=f0 value=v4 kind=PlainArray origin=BuiltinResult builtinClass=Array class=[[firstArray]] object=o{{*}}(Array@f0:v4)
# CHECK: site s{{*}} function=f0 value=v5 kind=PlainObject origin=BuiltinResult builtinClass=Object class=[[secondObject]] object=o{{*}}(Object@f0:v5)
# CHECK: site s{{*}} function=f0 value=v5 kind=PlainArray origin=BuiltinResult builtinClass=Array class=[[secondArray]] object=o{{*}}(Array@f0:v5)
# CHECK: class [[firstObject]] builtinClass=Object sites=[s{{*}}] shared=o{{*}}(Object@f0:v4)
# CHECK: class [[firstArray]] builtinClass=Array sites=[s{{*}}] shared=o{{*}}(Array@f0:v4)
# CHECK: class [[secondObject]] builtinClass=Object sites=[s{{*}}] shared=o{{*}}(Object@f0:v5)
# CHECK: class [[secondArray]] builtinClass=Array sites=[s{{*}}] shared=o{{*}}(Array@f0:v5)
# CHECK: Object@f0:v4 kind=Instance parts=0 positions=0 undeclared=no events=[Allocated]
# CHECK: Array@f0:v4 kind=Instance parts=1 positions=0 undeclared=no events=[Allocated]
# CHECK: Object@f0:v5 kind=Instance parts=0 positions=0 undeclared=no events=[Allocated]
# CHECK: Array@f0:v5 kind=Instance parts=1 positions=0 undeclared=no events=[Allocated]
# RUN(OBJECTS): flow-sites solved
# OBJECTS-COUNT-2: function=f0 {{*}}kind=PlainObject
# OBJECTS-NOT: function=f0 {{*}}kind=PlainObject
# RUN(ARRAYS): flow-sites solved
# ARRAYS-COUNT-2: function=f0 {{*}}kind=PlainArray
# ARRAYS-NOT: function=f0 {{*}}kind=PlainArray
# RUN(NODES): flow-solve nodes
# NODES: DeclaredPart(Array@f0:v4, 0) = {{*}}|Object@f0:v4|Array@f0:v4}
# NODES: DeclaredPart(Array@f0:v5, 0) = {{*}}|Object@f0:v5|Array@f0:v5}
# RUN(APART): flow-solve nodes
# APART-NOT: @f0:v4{{*}} = {{*}}@f0:v5
# APART-NOT: @f0:v5{{*}} = {{*}}@f0:v4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="JSON" [isFreeName]
    v2 = PropGet v1 key="parse"
    v3 = PropGet v0 key="text" [isFreeName]
    v4 = Call v2, v1, v3
    v5 = Call v2, v1, v3
    Return
}
