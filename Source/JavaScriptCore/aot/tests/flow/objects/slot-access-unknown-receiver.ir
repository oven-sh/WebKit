# An element read from the unknown object answers the unknown value and an element appended to it reaches native code, and the same accesses on a known array stay with that array
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {{*}}unknown}
# CHECK: Variable(g1) = {undefined|L1#3}
# CHECK: DeclaredPart(Array@f0:v4, 0) = {L1#3}
# CHECK: f1, parameter 0) = {unknown}
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {{*}}L0#2
# RUN(KEPT): flow-solve sinks
# KEPT-NOT: L1#3
# KEPT-NOT: Array@f0:v4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Appended" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="fromUnknown" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromKnown" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewArray contents=anything
    v5 = CallDirect v4 function=f2
    Return
}
function f1 name="onUnknownList" role=Library parameters=[{type=Array<anything>}] results=[{type=anything}] {
  b0(v0: Array<anything>):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    AppendElement v0, v3
    v5 = Integer integer=0
    v6 = GetContiguousIndex v0, v5
    PutModuleVariable v6 variable=g0
    Return
}
function f2 name="onKnownList" role=Library parameters=[{type=Array<anything>}] results=[{type=anything}] {
  b0(v0: Array<anything>):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = FinishObject v2
    AppendElement v0, v3
    v5 = Integer integer=0
    v6 = GetContiguousIndex v0, v5
    PutModuleVariable v6 variable=g1
    Return
}
