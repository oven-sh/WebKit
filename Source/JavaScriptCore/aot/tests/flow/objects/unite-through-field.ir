# Once two sites are united their fields are one node each, so what was stored into the field of either meets there and is united as well
# RUN: flow-sites classes
# CHECK: class A0 layout=L1 sites=[s0, s2] shared=
# CHECK: class A1 layout=L0 sites=[s1, s3] shared=
# CHECK: class A2 layout=L1 sites=[s4] shared=
# CHECK: class A3 layout=L0 sites=[s5] shared=
# CHECK-NOT: class A4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="f" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Held" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    v7 = NewObject -, v2 layout=L1 fields=[0]
    v8 = FinishObject v7
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = NewObject -, v2 layout=L1 fields=[0]
    v12 = FinishObject v11
    v13 = NewObject -, v12 layout=L0 fields=[0]
    v14 = FinishObject v13
    v15 = ToBoolean v1
    Branch v15 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v6)
  b2():
    Jump -> next b3(v10)
  b3(v16):
    Return
}
