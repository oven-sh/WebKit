# Past the limit on the sites of a layout only the unknown object stands for an instance of a class that extends Map. It stands for what has reached native code, so the prototype object of the class, which the instance inherits from, goes there and becomes a prototype
# OPTIONS: limit=MaxSitesPerLayout:0
# LOSS: MaxSitesPerLayout
# RUN: flow-solve nodes objects sinks
# CHECK: f0, v5) = {unknown}
# CHECK: f1.prototype mutations=[ReachNativeCode, BecomePrototype]
# CHECK: nativeCode {{*}}f1.prototype

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = NewClosure function=f1
    v2 = ResolveHeritage v0
    v3 = NewClass v1, v0, v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="x"
    Return
}
function f1 name="A" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    Return v3
}
