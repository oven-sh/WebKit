# Objects that only meet in native code, because each is thrown out of the program or passed to an unknown callee, keep a class each
# RUN: flow-sites classes
# CHECK: class A0 layout=L0 sites=[s0] shared=
# CHECK: class A1 layout=L0 sites=[s1] shared=
# CHECK: class A4 layout=L0 sites=[s4] shared=
# CHECK: class A5 layout=L0 sites=[s5] shared=
# CHECK: class A6 layout=L0 sites=[s6] shared=
# CHECK-NOT: class A7
# RUN(SOLVED): flow-solve sinks
# SOLVED: nativeCode {{*}}L0#0, L0#1, {{*}}L0#4, L0#5
# SOLVED-NOT: L0#6

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Call v1, -, v4
    v6 = NewObject -, v2 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = Call v1, -, v7
    v9 = NewClosure function=f1
    v10 = NewClosure function=f2
    v11 = ToBoolean v5
    Branch v11 -> taken b1(), notTaken b2()
  b1():
    v12 = Call v9
    Return
  b2():
    v13 = Call v10
    Return
}
function f1 name="throwsFirst" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
function f2 name="throwsSecond" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    Throw v2
}
