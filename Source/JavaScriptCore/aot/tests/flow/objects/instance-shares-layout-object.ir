# Past the limit on sites the object that stands for its layout serves every instance: the second shared instance of a function gets no copy of it, and still a copy of the array it allocates
# OPTIONS: limit=MaxSitesPerLayout:0
# LOSS: MaxSitesPerLayout L0
# RUN: flow-sites solved
# RUN(TWO): flow-solve instances
# CHECK: site {{*}} function=f1 value=v1 kind=Layout origin=Operation layout=L0 class=[[class]] object={{*}}(L0)
# CHECK: class [[class]] layout=L0 sites=[{{*}}] shared={{*}}(L0) layout-object
# CHECK-NEXT: class {{*}} builtinClass=Array sites=[{{*}}] shared={{*}}(Array@f1:v3) copies=[{{*}}(Array@f1:v3@{{*}})]
# CHECK: object {{*}} L0 kind=Allocation parts=1 positions=0 undeclared=no events=[Allocated
# CHECK-NOT: object {{*}} L0
# CHECK: object {{*}} Array@f1:v3@{{*}} kind=Instance
# CHECK-NOT: object {{*}} L0
# CHECK-NOT: object {{*}} Array@f1:v3
# TWO-COUNT-2: {{*}} f1 {{*}}Initialized
# TWO-NOT: {{*}} f1 {{*}}Initialized

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Call v3, -, v0
    Return
}
function f1 name="inBothContexts" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray contents=anything
    Return v2
}
