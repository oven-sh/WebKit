# The pair that a step over the entries of a map creates is an array with a part per position, like the literal [key, value]: each index reads its own element alone until a call moves the elements of that pair, and a store past the pair reaches the part for the rest alone
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#0}
# CHECK-NEXT: Variable(g1) = {L1#1}
# CHECK-NEXT: Variable(g2) = {undefined|Array@f0:v13.element}
# CHECK-NEXT: Variable(g3) = {undefined|L0#0|L1#1}
# CHECK-NEXT: Variable(g4) = {L0#0}
# CHECK-NEXT: Variable(g5) = {undefined|true}
# CHECK: Position(Array@f0:v13.element, 0) = {L0#0}
# CHECK-NEXT: Position(Array@f0:v13.element, 1) = {L1#1}
# RUN(STORED): flow-solve nodes
# STORED: DeclaredPart(Array@f0:v29.element, 0) = {true}
# STORED-NEXT: Position(Array@f0:v29.element, 0) = {L0#0}
# STORED-NEXT: Position(Array@f0:v29.element, 1) = {L1#1}
# RUN(SITES): flow-sites solved
# SITES: function=f0 value=v13 kind=Instance origin=BuiltinElement builtinClass=Array positions=2
# RUN(MOVEDSITE): flow-sites solved
# MOVEDSITE: function=f0 value=v22 kind=Instance origin=BuiltinElement builtinClass=Array positions=2
# RUN(STOREDSITE): flow-sites solved
# STOREDSITE: function=f0 value=v29 kind=Instance origin=BuiltinElement builtinClass=Array positions=2
# RUN(KEPT): flow-sites solved
# KEPT: Array@f0:v13.element kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated
# RUN(MOVED): flow-sites solved
# MOVED: Array@f0:v22.element kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated{{*}}ElementsMoved, ContentsStored, HoleMade]
# RUN(ONE): flow-sites solved
# ONE-COUNT-1: ElementsMoved
# ONE-NOT: ElementsMoved
# RUN(NOWHERE): flow-sites solved
# NOWHERE-NOT: kind=Layout origin=BuiltinElement

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Key" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Value" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="pair" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="firstOfMovedPair" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="firstOfGrownPair" module=m0 declared={type=anything} initialization=Uninitialized
variable g5 name="thirdOfGrownPair" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Map" [isFreeName]
    v2 = Construct v1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewObject -, v3 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = PropGet v2 key="set"
    v9 = Call v8, v2, v5, v7
    v10 = PropGet v2 key="entries"
    v11 = Call v10, v2
    v12 = IteratorOpen v11
    v13 = IteratorResume v12
    v14 = ResultAt v13 index=1
    PutModuleVariable v14 variable=g2
    v16 = Integer integer=0
    v17 = ElemGet v14, v16
    PutModuleVariable v17 variable=g0
    v19 = ElemGet v14, v3
    PutModuleVariable v19 variable=g1
    v21 = IteratorOpen v11
    v22 = IteratorResume v21
    v23 = ResultAt v22 index=1
    v24 = PropGet v23 key="reverse"
    v25 = Call v24, v23
    v26 = ElemGet v23, v16
    PutModuleVariable v26 variable=g3
    v28 = IteratorOpen v11
    v29 = IteratorResume v28
    v30 = ResultAt v29 index=1
    v31 = Integer integer=2
    v32 = Boolean boolean=true
    ElemSet v30, v31, v32
    v34 = ElemGet v30, v16
    PutModuleVariable v34 variable=g4
    v36 = ElemGet v30, v31
    PutModuleVariable v36 variable=g5
    Return
}
