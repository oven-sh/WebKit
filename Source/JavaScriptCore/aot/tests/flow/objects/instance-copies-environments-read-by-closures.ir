# Closures made by two calls of a function read what their own call stored in the environment: each result holds one layout
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#[[first]]}
# CHECK-NEXT: Variable(g1) = {L1#[[second]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Environment fields=[{key="p" declared={type=anything}}]
variable g0 name="fromFirst" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromSecond" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = Call v5, -, v2
    v7 = Call v5, -, v4
    v8 = Call v6
    PutModuleVariable v8 variable=g0
    v10 = Call v7
    PutModuleVariable v10 variable=g1
    Return
}
function f1 name="close" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f2
    Return v2
}
function f2 name="closed" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    Return v1
}
