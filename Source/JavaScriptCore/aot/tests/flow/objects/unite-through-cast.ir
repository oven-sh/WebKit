# A cast or a test passes its object on, so two sites whose cast or tested objects meet are united, and two sites that are only cast are not
# RUN: flow-sites classes
# CHECK: class A0 layout=L0 sites=[s0, s1] shared=
# CHECK: class A1 layout=L0 sites=[s2] shared=
# CHECK: class A2 layout=L0 sites=[s3] shared=
# CHECK: class A3 layout=L0 sites=[s4, s5] shared=
# CHECK-NOT: class A4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Upcast v4 castType=undefined|null|object
    v6 = NewObject -, v2 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = Upcast v7 castType=undefined|null|object
    v9 = NewObject -, v2 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = Upcast v10 castType=undefined|null|object
    v12 = NewObject -, v2 layout=L0 fields=[0]
    v13 = FinishObject v12
    v14 = Upcast v13 castType=undefined|null|object
    v15 = CallDirect function=f1
    v16 = ToBoolean v1
    Branch v16 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v5)
  b2():
    Jump -> next b3(v8)
  b3(v17):
    Return
}
function f1 name="tested" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = TypeTest v2 testedType=object
    Branch v5 -> taken b1(| 0), notTaken b2()
  b1(v6):
    Jump -> next b5(v6)
  b2():
    v7 = TypeTest v4 testedType=undefined
    Branch v7 -> taken b3(), notTaken b4(| 0)
  b3():
    Return
  b4(v8):
    Jump -> next b5(v8)
  b5(v9):
    Return
}
