# An async function that only unseen code calls allocates the promise of its own result site: nobody can tell its calls apart, so the class has no copy
# RUN: flow-sites solved
# CHECK: site {{*}} function=f1 value=- kind=Instance origin=CoroutineResult builtinClass=Promise class=[[class]] object={{*}}(Promise@f1:result)
# CHECK: site {{*}} function=f2 value=- kind=Instance origin=CoroutineResult builtinClass=Promise class=[[never]] object={{*}}(Promise@f2:result)
# CHECK: class [[class]] builtinClass=Promise sites=[{{*}}] shared={{*}}(Promise@f1:result)
# CHECK-NOT: copies=[{{*}}Promise@f1:result
# CHECK: object {{*}} Promise@f1:result kind=Instance parts={{*}} positions=0 undeclared=no events=[Allocated
# CHECK-NEXT: object {{*}} Promise@f2:result kind=Instance parts={{*}} positions=0 undeclared=no events=[]
# CHECK-NOT: object {{*}} Promise@f1:result

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    Return
}
function f1 name="handler" flags=[IsAsync] results=[{type=anything}] {
  b0():
    Return
}
function f2 name="neverCalled" flags=[IsAsync] results=[{type=anything}] {
  b0():
    Return
}
