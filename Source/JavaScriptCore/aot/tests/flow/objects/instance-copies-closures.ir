# A small function that passes its parameter on has an instance per call site, and each instance has a copy of the closure it creates: a capture holds what its own call passed
# RUN: flow-sites solved
# RUN(NODES): flow-solve nodes
# CHECK: class {{*}} closure=f2 sites=[{{*}}] shared={{*}}(f2) copies=[{{*}}(f2@[[first]]), {{*}}(f2@[[second]])]
# CHECK: object {{*}} f2 kind=Closure parts=1 positions=0 undeclared=no events=[]
# CHECK: object {{*}} f2@[[first]] kind=Closure parts=1 positions=0 undeclared=no events=[Allocated]
# CHECK: object {{*}} f2@[[second]] kind=Closure parts=1 positions=0 undeclared=no events=[Allocated]
# CHECK-NOT: object {{*}} f2
# NODES: Variable(g0) = {f2@[[first]]}
# NODES: DeclaredPart(f2@[[first]], 0) = {L0#[[a]]}
# RUN(SECOND): flow-solve nodes
# SECOND: Variable(g1) = {f2@[[second]]}
# SECOND: DeclaredPart(f2@[[second]], 0) = {L1#[[b]]}
# RUN(SHARED): flow-solve nodes
# SHARED-NOT: DeclaredPart(f2, 0)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="overFirst" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="overSecond" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = Call v5, -, v2
    PutModuleVariable v6 variable=g0
    v8 = Call v5, -, v4
    PutModuleVariable v8 variable=g1
    Return
}
function f1 name="close" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure v0 function=f2
    Return v1
}
function f2 name="closed" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
