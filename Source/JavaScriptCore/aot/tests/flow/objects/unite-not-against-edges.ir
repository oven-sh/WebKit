# Two sites are united only where both arrive along the direction of the edges: a value that flows into both of their block parameters connects nothing
# RUN: flow-sites classes
# CHECK: class A0 layout=L0 sites=[s0] shared=
# CHECK: class A1 layout=L0 sites=[s1] shared=
# CHECK: class A2 layout=L0 sites=[s2, s3] shared=
# CHECK-NOT: class A3
# RUN(ALL): flow-sites classes
# ALL-NOT: sites=[s0, s1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    Return
}
function f1 name="sharedSource" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = NewObject -, v1 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = ToBoolean v0
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3, v5)
  b2():
    Jump -> next b3(v0, v0)
  b3(v7, v8):
    Return
}
function f2 name="sharedTarget" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = NewObject -, v1 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = ToBoolean v0
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v0)
  b3(v7):
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b6(v5)
  b5():
    Jump -> next b6(v7)
  b6(v8):
    Return
}
