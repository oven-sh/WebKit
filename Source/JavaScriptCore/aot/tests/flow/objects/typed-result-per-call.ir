# Two typed parses of one expected result have a site and an object each in one allocation class of the layout, apart from the class of the objects the program allocates
# RUN: flow-sites solved
# CHECK: site s0 function=f0 value=v9 kind=Layout origin=Operation layout=L0 class=A0 object=o{{*}}(L0#0)
# CHECK: site [[first]] function=f0 value=v4 kind=Layout origin=TypedResult layout=L0 class=[[parsed]] object=o{{*}}(L0#[[number]])
# CHECK: site [[second]] function=f0 value=v6 kind=Layout origin=TypedResult layout=L0 class=[[parsed]] object=o{{*}}(L0#[[number]])
# CHECK: class A0 layout=L0 sites=[s0] shared=o{{*}}(L0#0)
# CHECK: class [[parsed]] layout=L0 sites=[{{*}}[[first]], [[second]]] shared=o{{*}}(L0#[[number]]) copies=[o{{*}}(L0#[[number]]@i{{*}})]
# RUN(COUNT): flow-sites solved
# COUNT-COUNT-2: kind=Layout origin=TypedResult layout=L0
# COUNT-NOT: kind=Layout origin=TypedResult layout=L0
# COUNT-COUNT-2: class A{{*}} layout=L0 sites=
# COUNT-NOT: class A{{*}} layout=L0 sites=
# RUN(ONE): flow-sites solved
# ONE-NOT: layout=L0 {{*}}copies=[{{*}}, o
# RUN(NODES): flow-solve nodes
# NODES: Variable(g0) = {null|boolean|number|string|Object@f0:v4|Array@f0:v4|L0#[[class]]}
# NODES: Variable(g1) = {null|boolean|number|string|Object@f0:v6|Array@f0:v6|L0#[[class]]@i{{*}}}
# NODES: Variable(g2) = {L0#0}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0]
layout L0 name="Row" fields=[{key="id" declared={type=number} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="made" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="JSON" [isFreeName]
    v2 = PropGet v1 key="parse"
    v3 = PropGet v0 key="text" [isFreeName]
    v4 = Call v2, v1, v3 expectedResult=x0
    PutModuleVariable v4 variable=g0
    v6 = Call v2, v1, v3 expectedResult=x0
    PutModuleVariable v6 variable=g1
    v8 = Integer integer=1
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    PutModuleVariable v10 variable=g2
    Return
}
