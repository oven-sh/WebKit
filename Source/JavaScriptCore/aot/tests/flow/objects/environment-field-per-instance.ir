# Two environments of one layout from sites that never meet have a field node each: a read through one holds only what was stored through it. Two sites that meet are one object
# RUN: flow-solve nodes
# RUN(OTHER): flow-solve nodes
# RUN(SITES): flow-sites classes
# CHECK: Variable(g0) = {{*}}L0#[[first]]}
# CHECK-NEXT: Variable(g1) = {{*}}L1#[[second]]}
# CHECK-NEXT: Variable(g2) = {{*}}L0#[[first]]|L1#[[second]]}
# OTHER-NOT: Variable(g1) = {{*}}L0#
# SITES: class {{*}} layout=L2 sites=[s2] shared=
# SITES-NEXT: class {{*}} layout=L2 sites=[s3] shared=
# SITES-NEXT: class {{*}} layout=L2 sites=[s4, s5] shared=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Environment fields=[{key="held" declared={type=anything}}]
variable g0 name="fromFirst" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromSecond" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="fromEither" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject layout=L2 fields=[]
    v6 = NewObject layout=L2 fields=[]
    PutEnvironmentField v5, v2 layout=L2 field=0
    PutEnvironmentField v6, v4 layout=L2 field=0
    v9 = GetEnvironmentField v5 layout=L2 field=0
    PutModuleVariable v9 variable=g0
    v11 = GetEnvironmentField v6 layout=L2 field=0
    PutModuleVariable v11 variable=g1
    v13 = NewObject layout=L2 fields=[]
    v14 = NewObject layout=L2 fields=[]
    PutEnvironmentField v13, v2 layout=L2 field=0
    PutEnvironmentField v14, v4 layout=L2 field=0
    v17 = Builtin builtin=MathRandom
    v18 = Call v17
    v19 = ToBoolean v18
    Branch v19 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v13)
  b2():
    Jump -> next b3(v14)
  b3(v20):
    v21 = GetEnvironmentField v20 layout=L2 field=0
    PutModuleVariable v21 variable=g2
    Return
}
