# A function that compiled code calls with tracked operands and that unseen code can call has two shared instances: the second one gets a copy of what the function allocates. A function with one instance has no copy
# RUN: flow-sites solved
# RUN(TWO): flow-solve instances
# RUN(ONE): flow-solve instances
# CHECK: class {{*}} builtinClass=Array sites=[{{*}}] shared={{*}}(Array@f1:v0) copies=[{{*}}(Array@f1:v0@[[second]])]
# CHECK-NEXT: class {{*}} builtinClass=Array sites=[{{*}}] shared={{*}}(Array@f2:v0)
# CHECK-NOT: (Array@f2:v0
# CHECK: object {{*}} Array@f1:v0 kind=Instance
# CHECK: object {{*}} Array@f1:v0@[[second]] kind=Instance
# CHECK-NOT: object {{*}} Array@f1:v0
# TWO-COUNT-2: {{*}} f1 {{*}}Initialized
# TWO-NOT: {{*}} f1 {{*}}Initialized
# ONE: {{*}} f2 Proven Initialized
# ONE-NOT: {{*}} f2 {{*}}Initialized

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Call v3, -, v0
    v5 = NewClosure function=f2
    v6 = Call v5
    Return
}
function f1 name="inBothContexts" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    Return v0
}
function f2 name="inOneContext" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    Return v0
}
