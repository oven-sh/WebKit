# Sites of two functions whose objects are stored into one module variable share an allocation class, and a site stored into another variable does not
# RUN: flow-sites classes
# CHECK: site s0 function=f0 {{*}}class=A0
# CHECK: site s1 function=f0 {{*}}class=A1
# CHECK: site s2 function=f1 {{*}}class=A0
# CHECK: class A0 layout=L0 sites=[s0, s2] shared=
# CHECK: class A1 layout=L0 sites=[s1] shared=
# CHECK-NOT: class A2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="shared" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="alone" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = NewObject -, v0 layout=L0 fields=[0]
    v5 = FinishObject v4
    PutModuleVariable v5 variable=g1
    v7 = CallDirect function=f1
    Return
}
function f1 name="replace" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    Return
}
