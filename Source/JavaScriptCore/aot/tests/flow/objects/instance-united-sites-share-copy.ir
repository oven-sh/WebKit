# Two sites of one function that were united are one class, and a further instance of the function has one copy for both
# RUN: flow-sites solved
# RUN(TWO): flow-solve instances
# CHECK: site [[first]] function=f1 value=v1 kind=Layout origin=Operation layout=L0 class=[[class]] object=
# CHECK-NEXT: site [[second]] function=f1 value=v2 kind=Layout origin=Operation layout=L0 class=[[class]] object=
# CHECK-NEXT: site [[alone]] function=f1 value=v3 kind=Layout origin=Operation layout=L0 class=[[other]] object=
# CHECK: class [[class]] layout=L0 sites=[{{*}}, {{*}}] shared={{*}}(L0#[[united]]) copies=[{{*}}(L0#[[united]]@[[instance]])]
# CHECK-NEXT: class [[other]] layout=L0 sites=[{{*}}] shared={{*}}(L0#[[single]]) copies=[{{*}}(L0#[[single]]@[[instance]])]
# CHECK: object {{*}} L0#[[united]]@[[instance]] kind=Allocation
# CHECK-NOT: object {{*}} L0#[[united]]@
# TWO-COUNT-2: {{*}} f1 {{*}}Initialized
# TWO-NOT: {{*}} f1 {{*}}Initialized

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Call v3, -, v0
    Return
}
function f1 name="inBothContexts" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = Builtin builtin=MathRandom
    v5 = Call v4
    v6 = ToBoolean v5
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v2)
  b3(v7):
    Return v7
}
