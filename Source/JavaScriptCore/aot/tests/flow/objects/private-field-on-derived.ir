# A private field that a base class declares is, on an instance of a subclass, a property of that object under the private name, and a method of the base class reads it there
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L2#4}
# CHECK: Variable(g1) = {L1#[[derived]]}
# CHECK: Property(L1#[[derived]], #"x"@L0) = {L2#4}
# RUN(ALL): flow-solve nodes
# ALL-NOT: Variable(g1) = {{*}}L0#
# ALL-NOT: DeclaredPart(L0#
# ALL-NOT: DeclaredPart(L1#
# RUN(SITES): flow-sites solved
# SITES: function=f1 value=v2 kind=Layout origin=Operation layout=L1 class=
# SITES: L1#{{*}} kind=Allocation parts=0 positions=0 undeclared=no events=[Allocated, AllocatedByConstructor]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key=#"x"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 name="Held" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="read" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="instance" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f4
    DefineMethod v1, v2 layout=L0 key="read"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f2
    v6 = ResolveHeritage v4
    v7 = NewClass v5, v4, v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8
    PutModuleVariable v9 variable=g1
    v11 = PropGet v9 key="read"
    v12 = Call v11, v9
    PutModuleVariable v12 variable=g0
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = CallDirect v2 function=f3
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="initializeBase" kind=Initializer flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: object ? L0):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L2 fields=[0]
    v3 = FinishObject v2
    v4 = NewClassToken layout=L0
    PrivateDefine v0, v4, v3 layout=L0 field=0
    Return
}
function f4 name="read" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: object ? L0):
    v1 = NewClassToken layout=L0
    v2 = PrivateGet v0, v1 layout=L0 field=0
    Return v2
}
