# The allocation in a base constructor allocates the layout of the class whose prototype object arrives: with only the subclass constructed, an object of the subclass is allocated and the object of the base class is not. The fields of the subclass are declared parts of it, what the base constructor stores are properties
# RUN: flow-sites solved
# RUN(NODES): flow-solve nodes
# RUN(LISTED): flow-solve nodes
# RUN(LINK): flow-solve nodes
# CHECK: site {{*}} function=f1 value=v3 kind=Layout origin=Operation layout=L0 class=
# CHECK: site {{*}} function=f1 value=v3 kind=Layout origin=Operation layout=L1 class=
# CHECK: object {{*}} L0#{{*}} kind=Allocation parts=2 positions=0 undeclared=no events=[]
# CHECK: object {{*}} L1#{{*}} kind=Allocation parts=1 positions=0 undeclared=no events=[Allocated, AllocatedByConstructor]
# NODES: Variable(g0) = {L1#[[derived]]}
# NODES-NOT: DeclaredPart(L0#{{*}}, 0)
# NODES: , f1, v3) = {L1#[[derived]]}
# NODES-NOT: DeclaredPart(L0#{{*}}, 0)
# NODES: DeclaredPart(L1#[[derived]], 0) = {"y"}
# NODES-NOT: DeclaredPart(L0#{{*}}, 0)
# NODES: Property(L1#[[derived]], "x") = {"x"}
# NODES-NOT: DeclaredPart(L0#{{*}}, 0)
# LISTED: Property(L1#{{*}}, "listed") = {"listed"}
# LINK-NOT: PrototypeLink(L0#
# LINK: PrototypeLink(L1#{{*}}) = {f2.prototype}
# LINK-NOT: PrototypeLink(L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="listed" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="B" predictedBase=L0 constructor=f2 fields=[{key="y" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
variable g0 name="instance" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    PutModuleVariable v7 variable=g0
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = String string="listed"
    v3 = NewObject v1, v2 layout=L0 fields=[1]
    v4 = String string="x"
    PropDefine v3, v4 key="x"
    Return v3
}
function f2 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = String string="y"
    PropDefine v3, v4 key="y"
    Return v3
}
