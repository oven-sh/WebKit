# The array intrinsics of library code read and write the elements of exactly the arrays that reach them
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|L0#
# CHECK-NOT: L1#
# CHECK: Variable(g1) = {undefined|L1#{{*}}|L2#
# CHECK-NOT: L0#
# CHECK: Variable(g2) = {undefined|int[7, 9]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Put" fields=[{key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Defined" fields=[{key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="r" declared={type=anything} flags=[IsRequired]}]
variable g0 name="contiguous" declared={type=anything} initialization=Uninitialized
variable g1 name="underConstruction" declared={type=anything} initialization=Uninitialized
variable g2 name="numbers" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="fill" role=Library results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = Integer integer=0
    v2 = Boolean boolean=true
    v3 = NewContiguousArray v0
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    PutContiguousIndex v3, v1, v5
    v7 = GetContiguousIndex v3, v1
    PutModuleVariable v7 variable=g0
    v9 = NewArrayWithCapacity v0
    v10 = NewObject -, v2 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = TryPutByValDirect v9, v1, v11
    v13 = NewObject -, v2 layout=L2 fields=[0]
    v14 = FinishObject v13
    v15 = TryPutIndex v9, v1, v14
    v16 = GetContiguousIndex v9, v1
    PutModuleVariable v16 variable=g1
    v18 = NewDoubleArray v0
    v19 = Integer integer=7
    PutDoubleIndex v18, v1, v19
    v21 = Integer integer=9
    PutDoubleIndex v18, v1, v21
    v23 = ElemGet v18, v1
    PutModuleVariable v23 variable=g2
    Return
}
