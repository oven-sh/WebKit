# An object that a built-in allocates and the table does not describe is an opaque object of the call. What an operation retains in such a result is in its undeclared part and reaches no sink
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {opaque(SuppressedError)@f0:v7{{*}}}
# CHECK: Variable(g1) = {opaque(Error)@f0:v11}
# CHECK: UndeclaredPart(opaque(Error)@f0:v11) = {1|L1#1}
# RUN(ALL): flow-solve nodes
# ALL-NOT: Variable(g0) = {{*}}unknown
# ALL-NOT: Variable(g1) = {{*}}unknown
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {{*}}L2#2
# RUN(KEPT): flow-solve sinks
# KEPT-NOT: L1#1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="KeptByCall" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="KeptByOperation" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Escaped" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
variable g0 name="madeByCall" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="madeByOperation" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="SuppressedError" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v2 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = Construct v1, -, v4, v2
    PutModuleVariable v7 variable=g0
    v9 = NewObject -, v2 layout=L2 fields=[0]
    v10 = FinishObject v9
    v11 = NewSuppressedError v6, v2
    PutModuleVariable v11 variable=g1
    v13 = PropGet v0 key="sink" [isFreeName]
    v14 = Call v13, -, v10
    Return
}
