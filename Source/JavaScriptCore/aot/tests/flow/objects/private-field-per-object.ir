# A private field is a part of the object that has it: two instances made at two call sites hold what each was constructed with
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L1#0}
# CHECK: Variable(g1) = {L2#1}
# CHECK: DeclaredPart(L0#3@[[first]], 0) = {L1#0}
# CHECK: DeclaredPart(L0#3@[[second]], 0) = {L2#1}
# RUN(ALL): flow-solve nodes
# ALL-NOT: Variable(g0) = {{*}}L2#
# ALL-NOT: Variable(g1) = {{*}}L1#
# ALL-NOT: DeclaredPart(L0#3{{*}}, 0) = {L1#0|L2#1}
# RUN(INSTANCES): flow-solve instances
# INSTANCES: f1 at f0:v8
# INSTANCES: f1 at f0:v9

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Box" constructor=f1 fields=[{key=#"x"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]
layout L1 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="firstRead" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="secondRead" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = NewClass v5 layout=L0
    v7 = FinishClass v6 layout=L0
    v8 = Construct v7, -, v2
    v9 = Construct v7, -, v4
    v10 = NewClassToken layout=L0
    v11 = PrivateGet v8, v10 layout=L0 field=0
    PutModuleVariable v11 variable=g0
    v13 = PrivateGet v9, v10 layout=L0 field=0
    PutModuleVariable v13 variable=g1
    Return
}
function f1 name="Box" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = NewClassToken layout=L0
    PrivateDefine v3, v4, v1 layout=L0 field=0
    Return v3
}
