# The solve ends on arrays that hold themselves or each other, and each element slot holds exactly the array stored into it
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {Array@f0:v1}
# CHECK: Variable(g1) = {Array@f0:v4}
# CHECK: Variable(g2) = {Array@f0:v5}
# CHECK: DeclaredPart(Array@f0:v1, 0) = {Array@f0:v1}
# CHECK: DeclaredPart(Array@f0:v4, 0) = {Array@f0:v5}
# CHECK: Position(Array@f0:v5, 0) = {Array@f0:v4}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="self" declared={type=anything} initialization=Uninitialized
variable g1 name="first" declared={type=anything} initialization=Uninitialized
variable g2 name="second" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewArray contents=anything
    ElemSet v1, v0, v1
    PutModuleVariable v1 variable=g0
    v4 = NewArray contents=anything
    v5 = NewArray v4 contents=anything
    ElemSet v4, v0, v5
    PutModuleVariable v4 variable=g1
    PutModuleVariable v5 variable=g2
    Return
}
