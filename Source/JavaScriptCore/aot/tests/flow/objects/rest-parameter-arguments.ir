# Arguments past the parameters reach only the rest array, each at its position, and a parameter without an argument is undefined
# RUN: flow-solve nodes
# RUN(CHECK2): flow-solve nodes
# RUN(CHECK3): flow-solve nodes
# RUN(CHECK4): flow-solve nodes
# CHECK: Variable(g0) = {L1#1}
# CHECK2: Position(Array@f1:rest, 0) = {L1#1}
# CHECK2-NEXT: Position(Array@f1:rest, 1) = {L2#2}
# CHECK2-NEXT: Position(Array@f1:rest, 2) = {undefined}
# CHECK3: , f1, parameter 0) = {L0#0}
# CHECK3-NEXT: , f1, parameter 1) = {Array@f1:rest}
# CHECK4: , f2, parameter 0) = {L0#0}
# CHECK4-NEXT: , f2, parameter 1) = {undefined}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Third" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
variable g0 name="collected" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = FinishObject v5
    v7 = NewClosure function=f1
    v8 = Call v7, -, v2, v4, v6
    v9 = NewClosure function=f2
    v10 = Call v9, -, v2
    Return
}
function f1 name="collect" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array<anything>}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = Integer integer=0
    v3 = ElemGet v1, v2
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="pair" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
