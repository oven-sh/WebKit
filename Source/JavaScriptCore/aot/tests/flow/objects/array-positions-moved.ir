# Whatever can move, remove or shrink elements joins the positions of its array for good and puts undefined into them, also when the array escaped first and the move runs on an unknown receiver; an array nobody moves keeps exact positions, and a push only adds to them
# RUN: flow-solve nodes
# RUN(SITES): flow-sites solved
# CHECK: Variable(g0) = {undefined|L0#[[state]]|f1}
# CHECK-NEXT: Variable(g1) = {L0#[[state]]}
# CHECK: Position(Array@f0:v3, 0) = {undefined|L0#[[state]]|f1}
# CHECK-NEXT: Position(Array@f0:v3, 1) = {undefined|L0#[[state]]|f1}
# CHECK: Position(Array@f0:v4, 0) = {L0#[[state]]}
# CHECK-NEXT: Position(Array@f0:v4, 1) = {f1}
# CHECK: Position(Array@f0:v5, 0) = {undefined|
# CHECK-NEXT: Position(Array@f0:v5, 1) = {undefined|
# CHECK: Position(Array@f0:v18, 0) = {undefined|1}
# CHECK: Position(Array@f0:v21, 0) = {undefined|1}
# CHECK: Position(Array@f0:v24, 0) = {undefined|1}
# CHECK: Position(Array@f0:v27, 0) = {undefined|1}
# CHECK: Position(Array@f0:v30, 0) = {undefined|1}
# CHECK: Position(Array@f0:v33, 0) = {undefined|1}
# CHECK: Position(Array@f0:v36, 0) = {undefined|1}
# CHECK: Position(Array@f0:v38, 0) = {undefined|1}
# CHECK: Position(Array@f0:v40, 0) = {true|1}
# CHECK-NEXT: Position(Array@f0:v40, 1) = {true|1}
# SITES: object {{*}} Array@f0:v3 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v4 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated]
# SITES-NEXT: object {{*}} Array@f0:v5 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved]
# SITES-NEXT: object {{*}} Array@f0:v18 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v21 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v24 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v27 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v30 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v33 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v36 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, ContentsStored]
# SITES-NEXT: object {{*}} Array@f0:v38 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ElementsMoved, HoleMade]
# SITES-NEXT: object {{*}} Array@f0:v40 kind=Instance parts={{*}} positions=2 undeclared=no events=[Allocated, ContentsStored]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="State" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="firstOfReversed" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="firstOfUntouched" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = NewArray v1, v2 contents=anything
    v4 = NewArray v1, v2 contents=anything
    v5 = NewArray v0, v0 contents=anything
    v6 = PropGet v3 key="reverse"
    v7 = Call v6, v3
    v8 = Integer integer=0
    v9 = ElemGet v3, v8
    PutModuleVariable v9 variable=g0
    v11 = ElemGet v4, v8
    PutModuleVariable v11 variable=g1
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="keep" [isFreeName]
    v15 = Call v14, -, v5
    v16 = PropGet v13 key="kept" [isFreeName]
    v17 = ElemDelete v16, v8
    v18 = NewArray v0, v0 contents=anything
    v19 = PropGet v18 key="pop"
    v20 = Call v19, v18
    v21 = NewArray v0, v0 contents=anything
    v22 = PropGet v21 key="shift"
    v23 = Call v22, v21
    v24 = NewArray v0, v0 contents=anything
    v25 = PropGet v24 key="unshift"
    v26 = Call v25, v24, v0
    v27 = NewArray v0, v0 contents=anything
    v28 = PropGet v27 key="splice"
    v29 = Call v28, v27, v8, v0
    v30 = NewArray v0, v0 contents=anything
    v31 = PropGet v30 key="sort"
    v32 = Call v31, v30
    v33 = NewArray v0, v0 contents=anything
    v34 = PropGet v33 key="copyWithin"
    v35 = Call v34, v33, v8, v0
    v36 = NewArray v0, v0 contents=anything
    PropSet v36, v8 key="length" mode=Strict
    v38 = NewArray v0, v0 contents=anything
    v39 = ElemDelete v38, v8
    v40 = NewArray v0, v0 contents=anything
    v41 = PropGet v40 key="push"
    v42 = Boolean boolean=true
    v43 = Call v41, v40, v42
    Return
}
function f1 name="setter" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
