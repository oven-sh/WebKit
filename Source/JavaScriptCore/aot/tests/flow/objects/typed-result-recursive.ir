# The solve ends on a typed parse of a type that names itself: the parsed object holds the parsed array and the array holds the object
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {null|boolean|number|string|Object@f0:v4|Array@f0:v4|L0#[[tree]]}
# CHECK: Variable(g1) = {L0#1}
# CHECK: DeclaredPart(L0#1, 0) = {Array@f0:v6}
# CHECK: DeclaredPart(L0#[[tree]], 0) = {Array@f0:v4|Array@f0:[[list]]}
# CHECK: DeclaredPart(Array@f0:[[list]], 0) = {Object@f0:v4|Array@f0:v4|L0#[[tree]]}
# RUN(SITES): flow-sites solved
# SITES: function=f0 value=v4 kind=Layout origin=TypedResult layout=L0 class=
# SITES-NOT: origin=TypedResult layout=L0
# SITES: function=f0 value=v4 kind=Instance origin=TypedResult builtinClass=Array ordinal={{*}}(Array@f0:v4.typed.
# SITES-NOT: origin=TypedResult

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0]
layout L0 name="Tree" fields=[{key="children" declared={type=Array<L0>} flags=[IsRequired]}]
variable g0 name="parsed" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="made" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="JSON" [isFreeName]
    v2 = PropGet v1 key="parse"
    v3 = PropGet v0 key="text" [isFreeName]
    v4 = Call v2, v1, v3 expectedResult=x0
    PutModuleVariable v4 variable=g0
    v6 = NewArray contents=L0
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = FinishObject v7
    PutModuleVariable v8 variable=g1
    Return
}
