# The step over a Map answers undefined for the key and for the value where it finds no entry, and both results stand in front of the test for an entry.
# On the edge that has an entry they are what flow proved the map to hold, so the body of the loop sees the exact key and the exact value
#   const filled = new Map(); filled.set("a", 1); for (const [key, value] of filled) print(key, value); print("end")
# A map that is never filled, and a set: passes/expand-iteration-collection-rarely-filled.ir
# RUN: pipeline ExpandIteration
# CHECK: Map<"a", 1, proven,
# CHECK: [[step]]: undefined = MapNext
# CHECK: [[hasEntry]]: boolean = ResultAt [[step]]
# CHECK: [[key]]: undefined|"a" = ResultAt [[step]] index=2
# CHECK-NEXT: [[value]]: undefined|1 = ResultAt [[step]] index=3
# CHECK-NEXT: Branch [[hasEntry]]
# CHECK: String string="end"
# CHECK: "a" = AssumeType [[key]] castType="a"
# CHECK-NEXT: 1 = AssumeType [[value]] castType=1

module m0 path="main.js" displayPath="main.js" body=f0
