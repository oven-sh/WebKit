# A field that the initial list of a literal leaves out holds undefined, and the fields of a literal that lists them all do not
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#{{*}}, 0) = {"s"}
# CHECK-NEXT: DeclaredPart(L0#{{*}}, 1) = {undefined}
# CHECK: DeclaredPart(L1#{{*}}, 0) = {"s"}
# CHECK-NEXT: DeclaredPart(L1#{{*}}, 1) = {1}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Partial" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything}}]
layout L1 name="Complete" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="s"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Integer integer=1
    v4 = NewObject -, v0, v3 layout=L1 fields=[0, 1]
    v5 = FinishObject v4
    Return
}
