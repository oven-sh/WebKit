# A Map and a Set keep -0 as +0: what comes out of the keys of a map and out of the elements of a set may be the integer 0 wherever -0 may have gone in.
# A value of a map comes out as it went in, and a key that cannot be -0 gets no 0. The callback of getOrInsertComputed gets the key as the map keeps it
#   map.set(-0, -0)   zeros.add(-0)   halves.add(0.5)   map.getOrInsertComputed(-0, make)
# RUN: flow-solve nodes
# RUN(CALLBACK): flow-solve nodes
# CHECK: Variable(g0) = {undefined|0|whole}
# CHECK: Variable(g1) = {undefined|whole}
# CHECK: Variable(g2) = {undefined|0|whole}
# CHECK: Variable(g3) = {undefined|fractional}
# CALLBACK: , f2, parameter 0) = {0|whole}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="key" declared={type=anything} initialization=Uninitialized
variable g1 name="value" declared={type=anything} initialization=Uninitialized
variable g2 name="zero" declared={type=anything} initialization=Uninitialized
variable g3 name="half" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="step" role=Library results=[{type=anything}] {
  b0():
    v0 = Double number=-0
    v1 = Integer integer=0
    v2 = Builtin builtin=Map
    v3 = Construct v2
    v4 = PropGet v3 key="set"
    v5 = Call v4, v3, v0, v0
    v6 = CollectionTable v3
    v7 = MapNext v3, v6, v1
    v8 = ResultAt v7 index=2
    PutModuleVariable v8 variable=g0
    v10 = ResultAt v7 index=3
    PutModuleVariable v10 variable=g1
    v12 = Builtin builtin=Set
    v13 = Construct v12
    v14 = PropGet v13 key="add"
    v15 = Call v14, v13, v0
    v16 = CollectionTable v13
    v17 = SetNext v13, v16, v1
    v18 = ResultAt v17 index=2
    PutModuleVariable v18 variable=g2
    v20 = Construct v12
    v21 = PropGet v20 key="add"
    v22 = Double number=0.5
    v23 = Call v21, v20, v22
    v24 = CollectionTable v20
    v25 = SetNext v20, v24, v1
    v26 = ResultAt v25 index=2
    PutModuleVariable v26 variable=g3
    v28 = NewClosure function=f2
    v29 = PropGet v3 key="getOrInsertComputed"
    v30 = Call v29, v3, v0, v28
    Return
}
function f2 name="make" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=-0
    Return v1
}
