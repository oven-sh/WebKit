# A field of an environment that the allocation leaves out holds only what is stored into it, never undefined by itself; the same field of a record holds undefined
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {"s"}
# CHECK-NEXT: Variable(g1) = {undefined|"s"}
# CHECK: DeclaredPart(L0#{{*}}, 0) = {1}
# CHECK-NEXT: DeclaredPart(L0#{{*}}, 1) = {"s"}
# CHECK-NEXT: DeclaredPart(L1#{{*}}, 0) = {1}
# CHECK-NEXT: DeclaredPart(L1#{{*}}, 1) = {undefined|"s"}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}]
layout L1 name="Record" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything}}]
variable g0 name="fromEnvironment" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromRecord" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="s"
    v2 = NewObject -, v0 layout=L0 fields=[0]
    PutEnvironmentField v2, v1 layout=L0 field=1
    v4 = GetEnvironmentField v2 layout=L0 field=1
    PutModuleVariable v4 variable=g0
    v6 = NewObject -, v0 layout=L1 fields=[0]
    v7 = FinishObject v6
    PropSet v7, v1 key="b" mode=Strict
    v9 = PropGet v7 key="b"
    PutModuleVariable v9 variable=g1
    Return
}
