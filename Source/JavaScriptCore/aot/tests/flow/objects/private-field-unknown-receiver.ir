# A private read on the unknown object answers the unknown value and may throw, and a private store on it reaches the field of an instance that escaped; an instance that never escaped holds what was defined
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {{*}}unknown}
# CHECK: Variable(g1) = {opaque(Error)@host:-.error}
# CHECK: Variable(g2) = {L1#0}
# CHECK: Variable(g3) = {{*}}L1#0|L2#1}
# CHECK: f1, parameter 0) = {{*}}unknown}
# CHECK: Property(unknown, #"x"@L0) = {{*}}L2#1}
# RUN(ALL): flow-solve nodes
# ALL-NOT: Variable(g1) = {{*}}unknown
# ALL-NOT: Variable(g2) = {{*}}unknown
# ALL-NOT: Variable(g2) = {{*}}L2#
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {{*}}L2#1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Box" constructor=f3 fields=[{key=#"x"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]
layout L1 name="Held" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="StoredThroughUnknown" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="unknownRead" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="caught" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="keptRead" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="escapedRead" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f3
    v6 = NewClass v5 layout=L0
    v7 = FinishClass v6 layout=L0
    v8 = Construct v7, -, v2
    v9 = CallDirect v8 function=f2
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="register" [isFreeName]
    v12 = NewClosure function=f1
    v13 = Call v11, -, v12
    v14 = Construct v7, -, v2
    v15 = Call v11, -, v14
    v16 = NewClassToken layout=L0
    PrivateSet v15, v16, v4 layout=L0 field=0
    v18 = PrivateGet v14, v16 layout=L0 field=0
    PutModuleVariable v18 variable=g3
    Return
}
function f1 name="readsUnknown" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClassToken layout=L0
    Jump -> next b1()
  b1() handler=b3():
    v2 = PrivateGet v0, v1 layout=L0 field=0
    PutModuleVariable v2 variable=g0
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v4 = CatchValue
    PutModuleVariable v4 variable=g1
    Return
}
function f2 name="readsKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClassToken layout=L0
    v2 = PrivateGet v0, v1 layout=L0 field=0
    PutModuleVariable v2 variable=g2
    Return
}
function f3 name="Box" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = NewClassToken layout=L0
    PrivateDefine v3, v4, v1 layout=L0 field=0
    Return v3
}
