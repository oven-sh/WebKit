# A validator copies the objects its plan describes. A member that takes anything goes into the copy as it is, so the field holds what the validated value reaches, and a member typed as a number holds numbers alone. The text of a validated parse reaches plain data only
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#[[row]], 0) = {{*}}|L2#[[nested]]|{{*}}Object@f0:v4|Array@f0:v4}
# CHECK-NEXT: DeclaredPart(L0#[[row]], 1) = {number}
# CHECK: StringProperties(Object@f0:v4) = {{*}}|L2#[[nested]]|
# CHECK: StringProperties(L0#[[row]]) = {{*}}|L2#[[nested]]|
# CHECK: DeclaredPart(L0#[[row]]@[[caller]], 0) = {undefined|null|boolean|number|string|symbol|bigint|Object@f0:v8|Array@f0:v8|L0#[[row]]@[[caller]]}
# RUN(PARSED): flow-solve nodes
# PARSED-NOT: @f0:v8{{*}} = {{*}}L2#
# PARSED-NOT: @f0:v8{{*}} = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0] validation=[{shape=Object{layout=L0 members=[{key="extra" node=1 field=0}, {key="id" node=2 field=1}]} type=L0}, {type=anything}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Row" fields=[{key="extra" declared={type=anything}}, {key="id" declared={type=number}}]
layout L1 name="Input" fields=[{key="extra" declared={type=anything}}, {key="id" declared={type=anything}}]
layout L2 name="Nested" fields=[{key="x" declared={type=anything}}]
variable g0 name="validated" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="parsed" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewObject -, v1, v0 layout=L1 fields=[0, 1]
    v3 = Builtin builtin=BunBundleValidate
    v4 = Call v3, -, v2 expectedResult=x0
    PutModuleVariable v4 variable=g0
    v6 = String string="{}"
    v7 = Builtin builtin=JSONParse
    v8 = Call v7, -, v6 expectedResult=x0
    PutModuleVariable v8 variable=g1
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v10 = CatchValue
    Return
}
