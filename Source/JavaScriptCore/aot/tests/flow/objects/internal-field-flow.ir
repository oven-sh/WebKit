# A read of an internal field holds what was put into an internal field of the same object, and any primitive, and nothing of another object
# RUN: flow-solve nodes
# RUN(SINKS): flow-solve sinks
# CHECK: Variable(g0) = {undefined|null|boolean|number|string|symbol|bigint|L0#
# CHECK-NOT: L1#
# CHECK: Variable(g1) =
# SINKS: nativeCode {
# SINKS-NOT: L0#
# SINKS-NOT: L1#
# SINKS-NOT: Promise@f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Stored" fields=[{key="code" declared={type=anything}}]
layout L1 name="StoredElsewhere" fields=[{key="code" declared={type=anything}}]
variable g0 name="read" declared={type=anything} initialization=Uninitialized
variable g1 name="last" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="fields" role=Library results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewPromise
    v6 = NewPromise
    v7 = PutInternalField v5, v2 index=0
    v8 = PutInternalField v6, v4 index=0
    v9 = GetInternalField v5 index=0
    PutModuleVariable v9 variable=g0
    PutModuleVariable v0 variable=g1
    Return
}
