# A call of a built-in with a fresh result in a function with two instances has one site and one class, and the second instance gets a copy of the object
# RUN: flow-sites solved
# RUN(NODES): flow-solve nodes
# CHECK: site [[site]] function=f1 value=v4 kind=Instance origin=BuiltinResult builtinClass=Array {{*}}class=[[class]] object={{*}}(Array@f1:[[result]])
# CHECK-NOT: function=f1 {{*}} origin=BuiltinResult
# CHECK: class [[class]] builtinClass=Array sites=[{{*}}] shared={{*}}(Array@f1:[[result]]) copies=[{{*}}(Array@f1:[[result]]@[[instance]])]
# CHECK-NOT: (Array@f1:
# CHECK: object {{*}} Array@f1:[[result]] kind=Instance
# CHECK: object {{*}} Array@f1:[[result]]@[[instance]] kind=Instance
# CHECK-NOT: object {{*}} Array@f1:
# NODES: Variable(g{{*}}) = {Array@f1:[[result]]}
# RUN(COPY): flow-solve nodes
# COPY: Variable(g{{*}}) = {Array@f1:[[result]]@[[instance]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="keysOfFirst" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="keysOfSecond" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = Call v5, -, v2
    PutModuleVariable v6 variable=g0
    v8 = Call v5, -, v4
    PutModuleVariable v8 variable=g1
    Return
}
function f1 name="keysOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Object" [isFreeName]
    v3 = PropGet v2 key="keys"
    v4 = Call v3, v2, v0
    Return v4
}
