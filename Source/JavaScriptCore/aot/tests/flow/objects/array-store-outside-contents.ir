# A store through an untyped alias is in the contents of an array, whatever contents the array declares
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {Array@f0:v1}
# CHECK: DeclaredPart(Array@f0:v1, 0) = {"rest"}
# CHECK: Position(Array@f0:v1, 0) = {1|"first"}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="list" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=number
    PutModuleVariable v1 variable=g0
    v3 = String string="first"
    v4 = String string="rest"
    v5 = CallDirect v1, v3, v4 function=f1
    Return
}
function f1 name="store" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Integer integer=0
    ElemSet v0, v3, v1
    v5 = Integer integer=5
    ElemSet v0, v5, v2
    Return
}
