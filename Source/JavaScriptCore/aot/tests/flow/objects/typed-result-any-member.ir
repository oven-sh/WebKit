# A member of a parsed type that admits anything holds primitives and the plain data objects of the call, never the unknown object, and a member typed as a number holds numbers alone
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {null|boolean|number|string|Object@f0:v4|Array@f0:v4|L0#[[row]]}
# CHECK: DeclaredPart(L0#[[row]], 0) = {undefined|null|boolean|number|string{{*}}|Object@f0:v4|Array@f0:v4}
# CHECK-NEXT: DeclaredPart(L0#[[row]], 1) = {number}
# RUN(ALL): flow-solve nodes
# ALL-NOT: Part(L0#{{*}}unknown
# ALL-NOT: Variable(g0) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0]
layout L0 name="Row" fields=[{key="extra" declared={type=anything} flags=[IsRequired]}, {key="id" declared={type=number} flags=[IsRequired]}]
variable g0 name="parsed" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="JSON" [isFreeName]
    v2 = PropGet v1 key="parse"
    v3 = PropGet v0 key="text" [isFreeName]
    v4 = Call v2, v1, v3 expectedResult=x0
    PutModuleVariable v4 variable=g0
    Return
}
