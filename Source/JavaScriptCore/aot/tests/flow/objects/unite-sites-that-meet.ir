# Two sites of one layout whose objects meet in a block parameter share an allocation class, and a site that meets nobody has a class of its own
# RUN: flow-sites classes
# CHECK: site s0 function=f0 value=v3 kind=Layout origin=Operation layout=L0 class=A0 object=o{{*}}(L0#0)
# CHECK: site s1 function=f0 value=v5 kind=Layout origin=Operation layout=L0 class=A0 object=o{{*}}(L0#0)
# CHECK: site s2 function=f0 value=v7 kind=Layout origin=Operation layout=L0 class=A1 object=o{{*}}(L0#1)
# CHECK: class A0 layout=L0 sites=[s0, s1] shared=o{{*}}(L0#0)
# CHECK: class A1 layout=L0 sites=[s2] shared=o{{*}}(L0#1)
# CHECK-NOT: class A2
# RUN(ALL): flow-sites classes
# ALL-NOT: sites=[s0, s1, s2]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v2 layout=L0 fields=[0]
    v6 = FinishObject v5
    v7 = NewObject -, v2 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = ToBoolean v1
    Branch v9 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4)
  b2():
    Jump -> next b3(v6)
  b3(v10):
    Return
}
