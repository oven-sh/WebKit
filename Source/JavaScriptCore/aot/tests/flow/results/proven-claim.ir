# A Claim that flow proves becomes an AssumeType with the same type, a proof about the result of a Call is an inserted AssumeType, and a Claim that may fail stays
# RUN: flow-apply
# STATISTIC: FlowRemovedClaims = 1
# STATISTIC: FlowRemainingClaims = 1
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[first]]: L0 = AssumeType v1 castType=L0
# CHECK-NEXT: : L0 = AssumeType [[first]] castType=undefined|null|object
# CHECK: v3: anything = Call v0
# CHECK-NEXT: [[second]]: L0 = AssumeType v3 castType=L0
# CHECK-NEXT: = PropGet [[second]] key="x"
# CHECK: [[text]]: "text" = AssumeType v6 castType="text"
# CHECK-NEXT: v7: never = Claim [[text]] castType=undefined|null|number site=w1 cause=MayFail
# CHECK-NOT: = Claim

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 kind=CallResult
typesite w1 kind=CallResult
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = ClaimDeclared v1 declared={type=undefined|null|L0 site=w0}
    v3 = Call v0
    v4 = PropGet v3 key="x"
    v5 = NewClosure function=f2
    v6 = Call v5
    v7 = ClaimDeclared v6 declared={type=undefined|null|number site=w1}
    Return
}
function f1 name="makePoint" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="makeText" results=[{type=anything}] {
  b0():
    v0 = String string="text"
    Return v0
}
