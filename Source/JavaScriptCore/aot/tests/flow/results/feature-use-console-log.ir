# A program that prints a string uses no feature and asks for no locale: not the interpreter, not regular expressions, nothing of Intl
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use ConsoleLog [Read, Called] f0:v2
# ALL-NOT: feature
# ALL-NOT: locale
# ALL-NOT: unseen

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="console" [isFreeName]
    v2 = PropGet v1 key="log"
    v3 = String string="hello"
    v4 = Call v2, v1, v3 calleeKey="log"
    Return
}
