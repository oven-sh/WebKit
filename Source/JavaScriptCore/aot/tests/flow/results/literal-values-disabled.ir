# With literal values switched off a position that holds string literals is a string, and every other part of a type is as narrow as with all switches on
# OPTIONS: disable=flow:LiteralValues
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class C1 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}LoseShape] keys=NeverEnumerated addedKeysAreComplete=true
# CHECK: field L0.0 "x" type=1 written=number flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: variable g0 type=string written=undefined|null|string flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g1 type=string flow={writers=AllKnown initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g2 type=int[1, 3] written=number flow={writers=AllKnown initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g3 type=int|whole written=number flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g4 type=f1 written=function flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g5 type=L0 written=object flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead reads=NeverRead}
# CHECK-NEXT: variable g6 type=Array<string, proven, pristine[Storage, Names, Dense]> 
# CHECK-NEXT: variable g7 type=boolean written=boolean|absent flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
# CHECK-NEXT: function f0 result 0 type=undefined written=anything
# NOWHERE-NOT: type="a"
# NOWHERE-NOT: function f1 result

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 kind=CallResult
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
variable g0 name="nullish" module=m0 declared={type=undefined|null|string} initialization=Uninitialized
variable g1 name="literalString" module=m0 declared={type=string} initialization=Uninitialized
variable g2 name="integerRange" module=m0 declared={type=number} initialization=Uninitialized
variable g3 name="wholeNumber" module=m0 declared={type=number} initialization=Uninitialized
variable g4 name="exactFunction" module=m0 declared={type=function} initialization=Uninitialized
variable g5 name="layoutSet" module=m0 declared={type=object} initialization=Uninitialized
variable g6 name="provenContents" module=m0 declared={type=Array<string>} initialization=Uninitialized
variable g7 name="deadZone" module=m0 declared={type=boolean|absent} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToString v1
    PutModuleVariable v2 variable=g0
    v4 = String string="a"
    PutModuleVariable v4 variable=g1
    v6 = String string="b"
    PutModuleVariable v6 variable=g1
    v8 = Integer integer=1
    PutModuleVariable v8 variable=g2
    v10 = Integer integer=3
    PutModuleVariable v10 variable=g2
    v12 = ToNumber v1
    v13 = BitOr v12, v8
    v14 = Mul v13, v13
    PutModuleVariable v14 variable=g3
    v16 = NewClosure function=f1
    PutModuleVariable v16 variable=g4
    v18 = NewObject -, v8 layout=L0 fields=[0]
    PutModuleVariable v18 variable=g5
    v20 = NewArray v2 contents=string holes=[]
    PutModuleVariable v20 variable=g6
    v22 = ToBoolean v1
    PutModuleVariable v22 variable=g7
    v24 = GetModuleVariable variable=g7
    v25 = CheckInitialized v24 name="deadZone"
    v26 = Call v16
    v27 = Claim v26 castType=string site=w0
    Return
}
function f1 name="text" kind=Arrow results=[{type=string}] {
  b0():
    v0 = GetModuleVariable variable=g1
    Return v0
}
