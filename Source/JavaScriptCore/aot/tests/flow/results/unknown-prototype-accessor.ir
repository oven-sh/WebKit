# An object nobody knows may hold an accessor, which runs with its inheritor as this, so a record with such a prototype reaches native code when a name it lacks is read
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachUnknownJavaScript,
# CHECK-NOT: ChangePrototype
# CHECK: LoseShape]
# CHECK-NOT: cause=
# CHECK: class C1 layout=L1 impossibleMutations=[ReachUnknownJavaScript,
# CHECK-NOT: ChangePrototype
# CHECK: LoseShape]
# CHECK-NOT: cause=
# CHECK: class C2 layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK-NOT: ChangePrototype
# CHECK: LoseShape]
# CHECK-NOT: cause=
# CHECK: class C3 layout=L3
# CHECK: variable g0 type=anything
# CHECK: variable g1 type=anything
# CHECK: variable g2 type=undefined written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="StoredByName" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="NamedByLiteral" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="KnownPrototype" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3
variable g0 name="fromStoredByName" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromNamedByLiteral" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="fromKnownPrototype" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="imported" [isFreeName]
    PropSet v1, v5 key="__proto__" mode=Strict
    SetLiteralPrototype v2, v5
    v8 = FinishObject v2
    v9 = NewObject layout=L3 fields=[]
    PropSet v3, v9 key="__proto__" mode=Strict
    v11 = PropGet v1 key="y"
    PutModuleVariable v11 variable=g0
    v13 = PropGet v8 key="y"
    PutModuleVariable v13 variable=g1
    v15 = PropGet v3 key="y"
    PutModuleVariable v15 variable=g2
    Return
}
