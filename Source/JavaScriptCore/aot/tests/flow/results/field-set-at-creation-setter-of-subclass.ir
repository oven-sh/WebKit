    DefineMethod v3, v4 layout=L1 methodKind=Setter key="tag"
    v6 = FinishClass v3 layout=L1
    v7 = Integer integer=1
    v8 = Integer integer=2
    v9 = Construct v6, -, v7 calleeName="Logged"
    v10 = Construct v0, -, v8 calleeName="Base"
    v11 = NewClosure function=f4
