# function Base(v) { this.tag = v }  class Logged extends Base { set tag(v) { seen = v } }  new Logged(1); new Base(2)
# function Other(v) { this.tag = v }  class Heir extends Other {}  new Heir(1); new Other(2)
# An instance of Logged has the slot of Base's field, and the store of the base constructor runs the setter there: the slot stays empty. A field is set at creation only if it is in the objects of every class below.
# Nothing stops the store on an instance of Heir, so the field of Other stays set at creation.
# RUN: flow
# CHECK: layout L0 flow={baseState=None members=[L0, L1]
# CHECK: field L0.0 "tag" type=2 written=anything flow={location={writers=AllKnown
# CHECK: field L1.0 "tag" type=2 written=anything flags=[IsInherited] originLayout=L0 originField=0
# CHECK: field L2.0 "tag" type=int[1, 2] written=anything flow={location={writers=AllKnown {{*}}initialization=SetAtCreation {{*}}occupancy=AlwaysFilled
# RUN(SETTER): flow
# SETTER-NOT: field L0.0 {{*}}SetAtCreation
# SETTER-NOT: field L0.0 {{*}}AlwaysFilled
# SETTER-NOT: field L0.0 {{*}}AbsentOnPrototypes

layout L0 kind=Instance name="Base" module=m0 constructor=f1 fields=[{key="tag" declared={type=anything}}] flags=[IsConstructorFunction]
