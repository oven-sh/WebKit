    v14 = NewClass v13, v11, v12 layout=L3
    v15 = FinishClass v14 layout=L3
    v16 = Construct v15, -, v7 calleeName="Heir"
    v17 = Construct v11, -, v8 calleeName="Other"
    v18 = Undefined
    Return v18
}
