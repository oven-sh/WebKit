# Each reached operation that lets code in that the build does not see leaves a record: one for each cause and built-in, with the lowest witness
# RUN(FUNCTION): flow
# FUNCTION: unseen-code EvaluatesText f0:v3 Function
# FUNCTION-NOT: unseen-code EvaluatesText {{*}} Function
# RUN(EVAL): flow
# EVAL: unseen-code EvaluatesText f0:v6
# RUN(LATER): flow
# LATER-NOT: unseen-code EvaluatesText f0:v4
# LATER-NOT: unseen-code EvaluatesText f0:v7
# LATER-NOT: unseen-code EvaluatesText f1:
# LATER-NOT: unseen-code {{*}} f2:
# RUN(LOAD): flow
# LOAD: unseen-code LoadsModuleByName f0:v8
# LOAD-NOT: unseen-code RunsUnseenCode f0:v8
# DIAGNOSTIC: CodeOutsideImageIsRefused 1
# RUN(OTHER): flow
# OTHER-NOT: unseen-code ImportsUncompiledModule
# OTHER-NOT: unseen-code OptionAdmitsCode
# OTHER-NOT: unseen-code LimitReached
# OTHER-NOT: unseen-code FlowResultDisabled

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
evalscope e0 mode=Strict
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Construct v2, -, v1
    v5 = Undefined
    v6 = DirectEval v1, v5 evalScope=e0
    v7 = DirectEval v1, v5 evalScope=e0
    v8 = ImportDynamic v1 referrer=m0
    v9 = CallDirect v1 function=f1
    Return
}
function f1 name="evaluatesAgain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return v2
}
function f2 name="unreached" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    v3 = ImportDynamic v0 referrer=m0
    Return v2
}
