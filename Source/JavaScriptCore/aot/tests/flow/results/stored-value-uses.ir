# What the readers of a field of an environment do with its value is a result of the field and no use of the environment, which does not leave its frame
# RUN: flow
# CHECK: function f2 parameter 0 uses=[Inspects] 
# CHECK: function f3 parameter 0 uses=[Inspects] 
# CHECK: class C2 layout=L2
# CHECK-NOT: locality=
# CHECK: class C3
# CHECK: class C4 layout=L0 {{*}}locality=FrameLocal
# CHECK: class C5 layout=L1 {{*}}locality=FrameLocal
# CHECK: stored-value L0.0 uses=[Inspects]
# CHECK-NEXT: stored-value L0.1 uses=[Inspects, StoresByKey]
# CHECK-NEXT: stored-value L0.2 uses=[Retains]
# CHECK-NEXT: stored-value L0.3 uses=[Inspects, Calls]
# CHECK-NEXT: stored-value L1.0 uses=[Inspects]
# CHECK-NOT: stored-value L2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="tested" declared={type=anything}}, {key="written" declared={type=anything}}, {key="kept" declared={type=anything}}, {key="called" declared={type=anything}}]
layout L1 kind=Environment fields=[{key="outer" declared={type=env L0}}]
layout L2 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="outer" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewObject -, v0 layout=L2 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewClosure function=f4
    v5 = NewObject -, v1, v2, v3, v4 layout=L0 fields=[0, 1, 2, 3]
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = NewClosure v5 function=f2
    v8 = Call v7
    v9 = NewClosure v6 function=f3
    v10 = Call v9
    Return
}
function f2 name="inner" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = ToBoolean v1
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = Integer integer=2
    PropSet v3, v4 key="x" mode=Strict
    v6 = GetEnvironmentField v0 layout=L0 field=2
    PutModuleVariable v6 variable=g0
    Return
}
function f3 name="throughOuter" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = GetEnvironmentField v1 layout=L0 field=3
    v3 = Call v2
    Return
}
function f4 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
