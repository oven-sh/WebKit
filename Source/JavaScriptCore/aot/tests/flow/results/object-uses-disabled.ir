# With object uses switched off no field or variable says how it is read, no class whether its keys are listed, no layout, closure or namespace how it is used, and every other result stays
# OPTIONS: disable=flow:ObjectUses
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 callers=AllKnown executions=AtMostOnce
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}LoseShape] locality=FrameLocal addedKeysAreComplete=true
# CHECK: class C2 closureFunction=f1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}StoreOfOtherType] locality=FrameLocal addedKeysAreComplete=true
# CHECK: layout L0 flow={baseState=None members=[L0] allocationClasses=[0] constructorOrders=[{fields=[0, 1]}] fieldCreation=OnlyAtConstruction impossibleMutations=[
# CHECK: field L0.0 "hidden" type=1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation isUnchangedDuringActivation=true cause=ResultDisabled} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: layout L1 flow={baseState=None members=[L1] allocationClasses=[1] constructorOrders=[{fields=[0]}] fieldCreation=OnlyAtConstruction impossibleMutations=[
# CHECK: variable g0 type=1 written=anything flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead cause=ResultDisabled}
# CHECK: function f1 capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost]
# NOWHERE-NOT: reads=
# NOWHERE-NOT: keys=
# NOWHERE-NOT: observedUses=
# NOWHERE-NOT: closureUse=
# NOWHERE-NOT: namespaceUse=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Unread" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}, {key="shown" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Serialized" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="unread" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = PropGet v1 key="shown"
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = Builtin builtin=JSONStringify
    v5 = Call v4, -, v3
    PutModuleVariable v0 variable=g0
    v7 = NewClosure function=f1
    v8 = Call v7
    Return
}
function f1 name="onlyCalled" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
