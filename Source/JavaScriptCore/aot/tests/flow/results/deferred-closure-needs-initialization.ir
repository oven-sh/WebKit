# A deferral rests on SetAtCreation, so a field loses it when Initialization is disabled
# OPTIONS: disable=flow:Initialization
# RUN: flow
# STATISTIC: FlowDeferredClosureFields = 0
# CHECK: field L0.0 "handler" type=f1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation reads=NeverRead isUnchangedDuringActivation=true cause=ResultDisabled}
# RUN(NOTHING): flow
# NOTHING-NOT: initialization=
# NOTHING-NOT: occupancy=
# NOTHING-NOT: deferral=
# NOTHING-NOT: deferredFunction=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="CapturesNothing" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return
}
function f1 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
