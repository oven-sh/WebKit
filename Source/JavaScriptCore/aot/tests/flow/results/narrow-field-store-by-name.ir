# A field that is stored by name many times is narrowed to exact functions and to proven contents, because flow saw every store
# RUN: flow
# RUN(ALL): flow
# CHECK: field L0.0 "x" type=f2|f3 written=anything
# CHECK: field L0.1 "y" type=f2 written=anything{{*}}stores=AtMostOnce
# CHECK: field L3.0 "handler" type=f2|f3 written=anything
# CHECK: field L3.1 "items" type=Array<1, proven
# CHECK: field L3.2 "fixedItems" type=Array<1, proven{{*}}stores=AtMostOnce
# ALL-NOT: layout L0 {{*}}cause=
# ALL-NOT: field L0.0 {{*}}stores=
# ALL-NOT: layout L3 {{*}}cause=
# ALL-NOT: field L3.0 {{*}}stores=
# ALL-NOT: field L3.1 {{*}}stores=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Both" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OnlyX" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="OnlyY" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L3 name="TrackedReceiver" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}, {key="items" declared={type=anything} flags=[IsRequired]}, {key="fixedItems" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = CallDirect v1 function=f1
    v5 = CallDirect v2 function=f1
    v6 = CallDirect v3 function=f1
    v7 = Integer integer=1
    v8 = NewArray v7 contents=anything holes=[]
    v9 = NewArray v7 contents=anything holes=[]
    v10 = NewObject -, v0, v8, v9 layout=L3 fields=[0, 1, 2]
    v11 = NewClosure function=f3
    PropSet v10, v11 key="handler" mode=Strict
    v13 = NewArray v7 contents=anything holes=[]
    PropSet v10, v13 key="items" mode=Strict
    Return
}
function f1 name="replace" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f2 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
