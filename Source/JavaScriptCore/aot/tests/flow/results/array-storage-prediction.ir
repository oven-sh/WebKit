# The storage kind of an array is predicted from its elements, and the proven type of the same position names no storage kind
# RUN: flow
# RUN(NOWHERE): flow
# STATISTIC: FlowProvenContentsSites = 5
# CHECK: variable g0 type=Array<int[1, 2], proven{{*}}> predicted=Array<int[1, 2], proven, Int32
# CHECK: variable g1 type=Array<1|fractional, proven{{*}}> predicted=Array<1|fractional, proven, Double
# CHECK: variable g2 type=Array<int[1, 4294967296], proven{{*}}> predicted=Array<int[1, 4294967296], proven, Double
# CHECK: variable g3 type=Array<1|"s", proven{{*}}> predicted=Array<1|"s", proven, Contiguous
# CHECK: variable g4 type=Array<never, proven
# NOWHERE-NOT: type=Array<{{*}}Int32{{*}}predicted=
# NOWHERE-NOT: type=Array<{{*}}Double{{*}}predicted=
# NOWHERE-NOT: type=Array<{{*}}Contiguous{{*}}predicted=
# NOWHERE-NOT: variable g4 {{*}}predicted=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="smallIntegers" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fractions" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="largeIntegers" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="withString" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="empty" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = Double number=0.5
    v3 = Integer integer=4294967296
    v4 = String string="s"
    v5 = NewArray v0, v1 contents=anything @10
    v6 = NewArray v0, v2 contents=anything @20
    v7 = NewArray v0, v3 contents=anything @30
    v8 = NewArray v0, v4 contents=anything @40
    v9 = NewArray contents=anything @50
    PutModuleVariable v5 variable=g0
    PutModuleVariable v6 variable=g1
    PutModuleVariable v7 variable=g2
    PutModuleVariable v8 variable=g3
    PutModuleVariable v9 variable=g4
    Return
}
