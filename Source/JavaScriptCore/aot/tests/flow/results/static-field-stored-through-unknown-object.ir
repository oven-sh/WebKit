# A store to an unknown object reaches the static field of that name of a class object that has escaped, so the field is not stored once. The field of another name keeps its count
# RUN: flow
# CHECK: variable g0 {{*}}flow={
# CHECK-NOT: stores=
# CHECK: variable g1 {{*}}stores=AtMostOnce initialization=StoredBeforeEveryRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" constructor=f1 staticFields=[{key="count" variable=g0}, {key="total" variable=g1}]
variable g0 module=m0 declared={type=anything} owner=L0
variable g1 module=m0 declared={type=anything} owner=L0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = CallDirect v2 function=f2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Call v5, -, v2
    v7 = Integer integer=5
    PropSet v6, v7 key="count" mode=Strict
    v9 = PropGet v2 key="count"
    v10 = PropGet v2 key="total"
    Return
}
function f1 name="Counter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="initializeCounter" kind=Initializer flags=[HasThis] thisType={type=function} results=[{type=anything}] {
  b0(v0: function):
    v1 = Integer integer=1
    PropDefine v0, v1 key="count"
    PropDefine v0, v1 key="total"
    Return
}
