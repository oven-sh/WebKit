# The contents of a container that holds containers name the proven contents of the inner ones, with the storage kind predicted for them behind `~`, and an inner array that reaches nativeCode loses only its own proof
# RUN: flow
# CHECK: variable g0 type=Array<Array<L0, proven, pristine[Storage, Names, Dense]> ~ Array<L0, proven, Contiguous, pristine[Storage, Names, Dense]>, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g1 type=Array<Array<Array<L0, proven, pristine[Storage, Names, Dense]> ~ Array<L0, proven, Contiguous, pristine[Storage, Names, Dense]>, proven, pristine[Storage, Names, Dense]> ~ Array<Array<L0, proven, pristine[Storage, Names, Dense]> ~ Array<L0, proven, Contiguous, pristine[Storage, Names, Dense]>, proven, Contiguous, pristine[Storage, Names, Dense]>, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g2 type=Array<Array<{{*}}L0, Contiguous, pristine{{*}}>, proven, pristine[Storage, Names, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="rows" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="tables" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="rowsWithOneHandedOut" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything holes=[]
    v3 = NewArray v2 contents=anything holes=[]
    PutModuleVariable v3 variable=g0
    v5 = NewArray v3 contents=anything holes=[]
    PutModuleVariable v5 variable=g1
    v7 = NewObject -, v0 layout=L0 fields=[0]
    v8 = NewArray v7 contents=anything holes=[]
    v9 = NewArray v8 contents=anything holes=[]
    PutModuleVariable v9 variable=g2
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = Call v12, -, v8
    Return
}
