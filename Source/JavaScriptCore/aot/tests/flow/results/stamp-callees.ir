# A call is stamped with the functions and built-ins that can be its callee, each site with its own set, and the set is complete when every callee is known. A call whose callee is never a function enters nothing: the empty complete set, and nothing comes out of it
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call v2 accessSite={{*}} callees=[f2]
# CHECK-LABEL: function f1 name="apply"
# CHECK: = Call v0, v1 accessSite={{*}} callees=[f2, f3, builtin(ArrayPrototypePush)]
# CHECK-LABEL: function f4 name="callsNumber"
# CHECK: [[call]]: anything = Call v0 accessSite={{*}} callees=[]
# CHECK-NEXT: never = AssumeType [[call]] castType=never

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = NewClosure function=f2
    v3 = CallDirect v2, v1 function=f1
    v4 = NewClosure function=f3
    v5 = CallDirect v4, v1 function=f1
    v6 = Builtin builtin=ArrayPrototypePush
    v7 = CallDirect v6, v1 function=f1
    v8 = Call v2
    v9 = CallDirect v0 function=f4
    Return
}
function f1 name="apply" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, v1
    Return v2
}
function f2 name="first" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="second" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="callsNumber" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
