# A regular expression stays as created while it never reaches compile(), code that flow does not see or a store of anything but a number to lastIndex. Every site of one literal text has its own answer
# RUN: flow
# CHECK: variable g0 type=RegExp<"a+"[], pristine[Storage, Names, AsCreated]> written=anything
# CHECK: variable g1 type=RegExp<"a+"[], pristine[Storage, Names, AsCreated]> written=anything
# CHECK: variable g2 type=RegExp<"a+"[Global], pristine[Storage, Names, AsCreated]> written=anything
# CHECK: variable g3 type=RegExp<pristine[Storage, Names, AsCreated]> written=anything
# CHECK: variable g4 type=RegExp<"a+"[], pristine[Storage, Names]> written=anything
# CHECK: variable g5 type=RegExp<"a+"[], pristine[Storage, Names]> written=anything
# CHECK: variable g6 type=RegExp<"a+"[], pristine[Storage, Names]> written=anything
# CHECK: variable g7 type=RegExp<"a+"[], pristine[Storage, Names]> written=anything
# CHECK: variable g8 type=RegExp<"a+"[], pristine[Storage]> written=anything
# CHECK: variable g9 type=RegExp<"a+"[], "b"[], pristine[Storage, Names]> written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="tested" declared={type=anything} initialization=Uninitialized
variable g1 name="numberInLastIndex" declared={type=anything} initialization=Uninitialized
variable g2 name="advancedByExec" declared={type=anything} initialization=Uninitialized
variable g3 name="constructed" declared={type=anything} initialization=Uninitialized
variable g4 name="compiled" declared={type=anything} initialization=Uninitialized
variable g5 name="objectInLastIndex" declared={type=anything} initialization=Uninitialized
variable g6 name="stringInLastIndex" declared={type=anything} initialization=Uninitialized
variable g7 name="passedToUnknownCode" declared={type=anything} initialization=Uninitialized
variable g8 name="withOwnProperty" declared={type=anything} initialization=Uninitialized
variable g9 name="oneOfTwoCompiled" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="subject"
    v1 = NewRegExp pattern="a+" @10
    PutModuleVariable v1 variable=g0
    v3 = PropGet v1 key="test"
    v4 = Call v3, v1, v0 calleeKey="test"
    v5 = NewRegExp pattern="a+" @20
    PutModuleVariable v5 variable=g1
    v7 = Integer integer=3
    PropSet v5, v7 key="lastIndex" mode=Strict
    v9 = NewRegExp pattern="a+" regExpFlags=[Global] @30
    PutModuleVariable v9 variable=g2
    v11 = PropGet v9 key="exec"
    v12 = Call v11, v9, v0 calleeKey="exec"
    v13 = Builtin builtin=RegExp
    v14 = Construct v13, -, v0
    PutModuleVariable v14 variable=g3
    v16 = NewRegExp pattern="a+" @40
    PutModuleVariable v16 variable=g4
    v18 = PropGet v16 key="compile"
    v19 = Call v18, v16, v0 calleeKey="compile"
    v20 = NewRegExp pattern="a+" @50
    PutModuleVariable v20 variable=g5
    v22 = NewObject
    PropSet v20, v22 key="lastIndex" mode=Strict
    v24 = NewRegExp pattern="a+" @60
    PutModuleVariable v24 variable=g6
    PropSet v24, v0 key="lastIndex" mode=Strict
    v27 = NewRegExp pattern="a+" @70
    PutModuleVariable v27 variable=g7
    v29 = Builtin builtin=GlobalThis
    v30 = PropGet v29 key="sink" [isFreeName]
    v31 = Call v30, -, v27
    v32 = NewRegExp pattern="a+" @80
    PutModuleVariable v32 variable=g8
    PropSet v32, v7 key="extra" mode=Strict
    v35 = NewRegExp pattern="a+" @90
    PutModuleVariable v35 variable=g9
    v37 = NewRegExp pattern="b" @100
    PutModuleVariable v37 variable=g9
    v39 = PropGet v37 key="compile"
    v40 = Call v39, v37, v0 calleeKey="compile"
    Return
}
