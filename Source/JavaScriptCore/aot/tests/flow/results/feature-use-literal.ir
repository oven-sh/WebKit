# A reached regular expression literal counts as a construction of RegExp for the feature lines of RegExp, and a literal in a function that is never reached does not
# RUN: flow
# CHECK: feature 7 RegExp f2:v0
# CHECK: feature 53 RegExp f2:v0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f2
    Return
}
function f1 name="unreached" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" regExpFlags=[Global]
    Return v0
}
function f2 name="reached" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="b+" regExpFlags=[]
    Return
}
