# Every caller of a function is known when none of its closures reaches nativeCode or unknownJavaScript and the host does not call it. What reaches unknownJavaScript reaches nativeCode, which is the lower cause
# RUN: flow
# CHECK: function f1 callers=AllKnown
# CHECK: function f2
# CHECK-NOT: callers=
# CHECK: cause=ReachesNativeCode witness={function=f0 value=v5}
# CHECK: function f3
# CHECK-NOT: callers=
# CHECK: cause=ReachesNativeCode witness={function=f0 value=v10}
# CHECK: function f4
# CHECK-NOT: callers=
# CHECK: cause=ReachesNativeCode
# CHECK: indirect - - -> f4 Host
# CHECK: unseen-code EvaluatesText f0:v9 Function

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="handler" variable=g0}]
entry module=m0 hostReads=[{exportName="handler"}]
variable g0 name="handler" module=m0 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f2
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="register" [isFreeName]
    v5 = Call v4, -, v2
    v6 = NewClosure function=f3
    v7 = Builtin builtin=Function
    v8 = String string="return 1"
    v9 = Construct v7, -, v8
    v10 = Call v9, -, v6
    v11 = NewClosure function=f4
    PutModuleVariable v11 variable=g0
    Return
}
function f1 name="private" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="registered" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="evaluated" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="handler" results=[{type=anything}] {
  b0():
    Return
}
