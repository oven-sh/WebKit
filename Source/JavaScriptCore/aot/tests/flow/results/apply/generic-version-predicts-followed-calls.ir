# The generic version of a function takes anything, and each of its parameters is predicted to hold what the calls that flow follows pass. A prediction as read stays
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# CHECK: function f1 name="shared" {{*}}parameters=[{type=L0 written=anything}, {type=L0 written=anything{{*}}}]
# CHECK: function {{*}} name="shared" {{*}}role=GenericVersion {{*}}parameters=[{type=anything predicted=L0}, {type=anything predicted=L1}]
# CHECK-NEXT: b0(v0: anything ~ L0, v1: anything ~ L1):

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Size" fields=[{key="w" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1, v1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v2
    v7 = Call v2, -, v5, v5
    v8 = CallDirect function=f2
    Return
}
function f1 name="shared" parameters=[{type=anything}, {type=anything predicted=L1}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = PropGet v1 key="x"
    Return v0
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    Return
}
