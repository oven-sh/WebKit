# A required field that can be deleted is optional after the application, and a deleted field, declared or appended, counts as a possible mutation of its layout; a neighbor and the field of a layout without objects stay required
# RUN: flow-apply
# RUN(NOWHERE): flow-apply
# CHECK: layout L0 name="Pair" fields=[{key="a" declared={type=undefined|1 written=anything} flow={location={writers=AllKnown {{*}}cause=FieldDeleted {{*}}}, {key="b" declared={type=2 written=anything} flags=[IsRequired] flow={location={writers=AllKnown
# CHECK: layout L1 name="Unused" fields=[{key="a" declared={type=anything} flags=[IsRequired]}] {{*}}impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField,
# CHECK: layout L2 name="Grown" fields=[{key="a" declared={type=1 written=anything} flags=[IsRequired] flow={location={{*}}}, {key="c" declared={type=undefined|2} flags=[IsAppendedByFlow] flow={location={writers=AllKnown {{*}}cause=FieldDeleted
# NOWHERE-NOT: layout L0 {{*}}DeleteField
# NOWHERE-NOT: layout L2 {{*}}DeleteField

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Unused" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Grown" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = PropDelete v2 key="a" mode=Strict
    v4 = NewObject -, v0 layout=L2 fields=[0]
    PropSet v4, v1 key="c" mode=Strict
    v6 = PropDelete v4 key="c" mode=Strict
    Return
}
