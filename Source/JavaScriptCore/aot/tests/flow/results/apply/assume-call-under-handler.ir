# The cast of a call result stands behind the call in a block with a handler, and uses, edge arguments and handler arguments read the cast
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: b0() handler=b3():
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[cast]]: L0 = AssumeType v1 castType=L0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b2([[cast]]):
# CHECK-NEXT: v2: {{*}} = PropGet [[cast]] key="x"
# CHECK: v5: anything = Call v4
# CHECK-NEXT: Return
# CHECK-NEXT: b2(v6: L0) role=CatchHandler:
# CHECK-NEXT: v7: exception = CatchException
# CHECK-NEXT: v8: {{*}} = PropGet v6 key="x"
# CHECK-LABEL: function f1 name="merge"
# CHECK: b1() handler=b4():
# CHECK-NEXT: v4: anything = Call v3
# CHECK-NEXT: [[merged]]: L0 = AssumeType v4 castType=L0
# CHECK-NEXT: Jump -> next b3([[merged]])
# CHECK: b3(v7: L0):
# CHECK-NEXT: v8: {{*}} = PropGet v7 key="x"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b3():
    v0 = NewClosure function=f2
    v1 = Call v0
    Jump -> next b1()
  b1() handler=b2(v1):
    v2 = PropGet v1 key="x"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="external" [isFreeName]
    v5 = Call v4
    Return
  b2(v6) role=CatchHandler:
    v7 = CatchException
    v8 = PropGet v6 key="x"
    Rethrow v7
  b3() role=CatchHandler:
    v9 = CatchException
    v10 = NewClosure function=f1
    v11 = Call v10
    Rethrow v9
}
function f1 name="merge" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="choice" [isFreeName]
    v2 = ToBoolean v1
    v3 = NewClosure function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b1() handler=b4():
    v4 = Call v3
    Jump -> next b3(v4)
  b2():
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    Jump -> next b3(v6)
  b3(v7):
    v8 = PropGet v7 key="x"
    Return v8
  b4() role=CatchHandler:
    v9 = CatchException
    Rethrow v9
}
function f2 name="makePoint" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
