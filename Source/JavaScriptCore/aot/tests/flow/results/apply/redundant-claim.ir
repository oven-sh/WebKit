# A claim that flow proves becomes an assumed type in place, with its id, operand, type and position; a claim that a value fails stays a claim
# RUN: flow-apply
# STATISTIC: FlowRemovedClaims = 1
# STATISTIC: FlowRemainingClaims = 1
# CHECK-LABEL: function f1 name="checked"
# CHECK: b0(v0: {{*}}, v1: {{*}}):
# CHECK-NEXT: v2: {{*}} = AssumeType v0 castType=number @30
# CHECK-NEXT: v3: {{*}} = Claim v1 castType=number site=w1 cause=MayFail @40
# CHECK-NEXT: = Add v2, v3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=30 kind=Assertion
typesite w1 module=m0 position=40 kind=Assertion
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Double number=2.5
    v2 = String string="s"
    v3 = CallDirect v0, v0 function=f1
    v4 = CallDirect v1, v2 function=f1
    Return
}
function f1 name="checked" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Claim v0 castType=number site=w0 @30
    v3 = Claim v1 castType=number site=w1 @40
    v4 = Add v2, v3
    Return v4
}
