# The prediction of a promised int32 is the promise: a parameter reached by what native code returns or an object stays predicted i32, one that only small integers reach is narrowed
# RUN: flow-apply
# LOSS: MinNarrowedUsesForGenericVersion x1 f1
# LOSS: MaxFlowRangeGrowth x1 f4
# CHECK-LABEL: function f1 name="reachedByOtherValues" {{*}}parameters=[{type=anything predicted=i32 site=w0 flags=[IsInt32Promise]}]
# CHECK-LABEL: function f2 name="reachedByFive" {{*}}parameters=[{type=5 written=anything predicted=5 site=w0 flags=[IsInt32Promise]}]
# CHECK-LABEL: function f4 name="countsUp" {{*}}results=[{type=int|whole written=anything predicted=i32 site=w1 flags=[IsInt32Promise]}]
# CHECK-LABEL: function f5 name="returnsHalf" {{*}}results=[{type=fractional written=anything predicted=never site=w1 flags=[IsInt32Promise]}]

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Result
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f3
    v2 = Call v1
    v3 = Call v0, -, v2
    v4 = NewClosure function=f2
    v5 = Integer integer=5
    v6 = Call v4, -, v5
    v7 = NewClosure function=f4
    v8 = Call v7, -, v5
    v9 = NewClosure function=f5
    v10 = Call v9
    Return
}
function f1 name="reachedByOtherValues" parameters=[{type=anything predicted=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="reachedByFive" parameters=[{type=anything predicted=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="pointOrUnknown" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="external" [isFreeName]
    v2 = Call v1
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2():
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    Return v5
}
function f4 name="countsUp" parameters=[{type=anything}] results=[{type=anything predicted=i32 site=w1 flags=[IsInt32Promise]}] {
  b0(v0: anything):
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Increment v2
    Jump -> next b1(v5)
  b3():
    Return v2
}
function f5 name="returnsHalf" results=[{type=anything predicted=i32 site=w1 flags=[IsInt32Promise]}] {
  b0():
    v0 = Double number=0.5
    Return v0
}
