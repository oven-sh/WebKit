# A direct call of a function that never returns ends its block, and under a handler the handler stays
# RUN: flow-apply
# RUN(ALL): flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: v3: never = CallDirect function=f2
# CHECK-NEXT: Unreachable
# CHECK: = CallDirect function=f1
# CHECK-NEXT: Return
# CHECK-LABEL: function f1 name="callsUnderHandler"
# CHECK: b0() handler=[[handler]]():
# CHECK-NEXT: v0: never = CallDirect function=f2
# CHECK-NEXT: Unreachable
# CHECK-NEXT: [[handler]]() role=CatchHandler:
# CHECK-NEXT: = CatchException
# CHECK-LABEL: function f2 name="fail" {{*}}results=[{type=never written=anything}]
# ALL-NOT: string="unreached"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="choice" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect function=f2
    v4 = String string="unreached"
    Return v4
  b2():
    v5 = CallDirect function=f1
    Return
}
function f1 name="callsUnderHandler" results=[{type=anything}] {
  b0() handler=b2():
    v0 = CallDirect function=f2
    Jump -> next b1()
  b1():
    Return
  b2() role=CatchHandler:
    v1 = CatchException
    Rethrow v1
}
function f2 name="fail" results=[{type=anything}] {
  b0():
    v0 = String string="failed"
    Throw v0
}
