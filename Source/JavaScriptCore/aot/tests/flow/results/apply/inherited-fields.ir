# After the application a subclass lists the fields of its proven base as inherited entries behind its own, but for a key it declares again; a subclass with an unproven base lists none
# RUN: flow-apply
# RUN(NOWHERE): flow-apply
# CHECK: layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="a" declared={type={{*}}written=anything} flow={location={{*}}}, {key="b" declared={type={{*}}written=anything} flow={location={{*}}}] ownFieldCount=2
# CHECK: layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 fields=[{key="b" declared={type={{*}}written=anything} flow={location={{*}}}, {key="c" declared={type={{*}}written=anything} flow={location={{*}}}, {key="a" declared={type={{*}}written=anything} flags=[IsInherited] originLayout=L0 originField=0}] flags=[HasHeritage] ownFieldCount=2 flow={baseState=Layout base=L0
# CHECK: layout L2 kind=Instance name="Unproven" predictedBase=L0 constructor=f3 flags=[HasHeritage]
# NOWHERE-NOT: originField=1
# NOWHERE-NOT: layout L0 {{*}}IsInherited
# NOWHERE-NOT: layout L2 {{*}}IsInherited
# NOWHERE-NOT: layout L2 {{*}}baseState=
# NOWHERE-NOT: IsAppendedByFlow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}]
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 fields=[{key="b" declared={type=anything}}, {key="c" declared={type=anything}}] flags=[HasHeritage]
layout L2 kind=Instance name="Unproven" predictedBase=L0 constructor=f3 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="otherBase" [isFreeName]
    v10 = ToBoolean v9
    Branch v10 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v9)
  b2():
    Jump -> next b3(v2)
  b3(v11):
    v12 = NewClosure function=f3
    v13 = ResolveHeritage v11
    v14 = NewClass v12, v11, v13 layout=L2
    v15 = FinishClass v14 layout=L2
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="a" mode=Strict
    PropSet v2, v3 key="b" mode=Strict
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropSet v3, v4 key="b" mode=Strict
    PropSet v3, v4 key="c" mode=Strict
    Return v3
}
function f3 name="Unproven" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
