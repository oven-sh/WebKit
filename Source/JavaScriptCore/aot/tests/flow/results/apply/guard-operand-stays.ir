# A test that also feeds a parameter stays the condition of its branch, so both edges pass its proof, while the tested call result is read through its cast
# RUN: flow-apply
# RUN(ALL): flow-apply
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[cast]]: "text"|L0 = AssumeType v1 castType="text"|L0
# CHECK-NEXT: v2: boolean = TypeTest [[cast]] testedType=string
# CHECK-NEXT: Branch v2 -> taken b1(v2 | 0), notTaken b2(| 0)
# CHECK-NEXT: b1(v3: boolean, v4: "text"):
# CHECK: PutModuleVariable v3 variable=g0
# CHECK: b2(v6: L0):
# ALL-NOT: AssumeType v2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="seen" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(v2 | 0), notTaken b2(| 0)
  b1(v3, v4):
    PutModuleVariable v3 variable=g0
    Return v4
  b2(v6):
    v7 = PropGet v6 key="x"
    Return v7
}
function f1 name="makeTextOrPoint" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="choice" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = String string="text"
    Return v3
  b2():
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    Return v5
}
