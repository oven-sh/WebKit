# A use whose operand has nothing in common with the narrowed type it enters is never reached, so its block ends there, and an operand that fits stays
# RUN: flow-apply
# OPTIONS: disable=flow:NarrowedTypes disable-in=6:2
# CHECK: variable g0 name="count" module=m0 declared={type=0 written=anything}
# CHECK-LABEL: function f1 name="edgeArgument"
# CHECK: b1(v3: string):
# CHECK-NEXT: never = AssumeType v3 castType=never
# CHECK-NEXT: Unreachable
# CHECK: Jump -> next b3(v4)
# CHECK: b3(v5: 0):
# CHECK-LABEL: function f2 name="storedOperand"
# CHECK: b1(v3: string):
# CHECK-NEXT: never = AssumeType v3 castType=never
# CHECK-NEXT: Unreachable
# CHECK-NOT: PutModuleVariable
# CHECK-LABEL: function f3 name="returnedValue" {{*}}results=[{type=never written=anything}]
# CHECK: b1(v3: string):
# CHECK-NEXT: never = AssumeType v3 castType=never
# CHECK-NEXT: Unreachable
# CHECK-LABEL: function f4 name="edgeArgumentUnderHandler"
# CHECK: b1(v3: string) handler=b4():
# CHECK-NEXT: never = AssumeType v3 castType=never
# CHECK-NEXT: Unreachable
# CHECK-NOT: CallDirect
# CHECK-LABEL: function f5 name="pick"
# CHECK-LABEL: function f6 name="storedOperandNarrowingOff"
# CHECK: b1(v3: string):
# CHECK-NEXT: never = AssumeType v3 castType=0
# CHECK-NEXT: Unreachable
# CHECK-NEXT: b2():
# CHECK-NEXT: v5: 0 = Integer
# CHECK-NEXT: PutModuleVariable v5 variable=g0
# CHECK-LABEL: function f7 name="passedOperandNarrowingOff"
# CHECK: b1(v3: string):
# CHECK-NEXT: never = AssumeType v3 castType=0
# CHECK-NEXT: Unreachable
# CHECK-NEXT: b2():
# CHECK-NEXT: v5: 0 = Integer
# CHECK-NEXT: = CallDirect v5 function=f8
# CHECK-LABEL: function f8 name="takesCount" {{*}}parameters=[{type=0 written=anything}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="count" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    PutModuleVariable v0 variable=g0
    v2 = CallDirect function=f1
    v3 = CallDirect function=f2
    v4 = CallDirect function=f4
    v5 = CallDirect function=f6
    v6 = CallDirect function=f7
    v7 = CallDirect function=f3
    Return
}
function f1 name="edgeArgument" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Jump -> next b3(v3)
  b2():
    v4 = Integer integer=0
    Jump -> next b3(v4)
  b3(v5):
    Return v5
}
function f2 name="storedOperand" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    PutModuleVariable v3 variable=g0
    Return
  b2():
    Return
}
function f3 name="returnedValue" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Return v3
  b2():
    v4 = String string="not text"
    Throw v4
}
function f4 name="edgeArgumentUnderHandler" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3) handler=b4():
    v4 = CallDirect function=f5
    Jump -> next b3(v3)
  b2():
    v5 = Integer integer=0
    Jump -> next b3(v5)
  b3(v6):
    Return v6
  b4() role=CatchHandler:
    v7 = CatchException
    Rethrow v7
}
function f5 name="pick" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="choice" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Boolean boolean=true
    Return v4
}
function f6 name="storedOperandNarrowingOff" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    PutModuleVariable v3 variable=g0
    Return
  b2():
    v5 = Integer integer=0
    PutModuleVariable v5 variable=g0
    Return
}
function f7 name="passedOperandNarrowingOff" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    v2 = TypeTest v1 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallDirect v3 function=f8
    Return
  b2():
    v5 = Integer integer=0
    v6 = CallDirect v5 function=f8
    Return
}
function f8 name="takesCount" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
