# The result of a call that flow knows gets an assumed type right behind the call and every use reads it; a narrower type that changes no representation is worth no cast
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[point]]: L0 = AssumeType v1 castType=L0
# CHECK-NEXT: = PropGet [[point]] key="x"
# CHECK-NEXT: = StrictEq [[point]], [[point]]
# CHECK-NEXT: = NewClosure function=f2
# CHECK-NEXT: v5: anything = Call v4
# CHECK-NEXT: [[text]]: string = AssumeType v5 castType=string
# CHECK-NEXT: = Add [[text]], [[text]]
# CHECK-NEXT: = NewClosure function=f3
# CHECK-NEXT: v8: anything = Call v7
# CHECK-NEXT: = TypeTest v8 testedType="a"|"b"
# CHECK-NEXT: Branch v9 -> taken b1([[point]] | 0), notTaken b2()
# CHECK-NEXT: b1(v10: L0, v11: "a"|"b"):
# CHECK-NEXT: = PropGet v10 key="x"
# CHECK-NEXT: = Add v11, v11
# CHECK-LABEL: function f1 name="makePoint"
# CHECK-LABEL: function f3 name="numberOrText" {{*}}results=[{type=1|"a" written=anything}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = PropGet v1 key="x"
    v3 = StrictEq v1, v1
    v4 = NewClosure function=f2
    v5 = Call v4
    v6 = Add v5, v5
    v7 = NewClosure function=f3
    v8 = Call v7
    v9 = TypeTest v8 testedType="a"|"b"
    Branch v9 -> taken b1(v1 | 0), notTaken b2()
  b1(v10, v11):
    v12 = PropGet v10 key="x"
    v13 = Add v11, v11
    Return
  b2():
    Return
}
function f1 name="makePoint" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="makeText" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = ToString v1
    Return v2
}
function f3 name="numberOrText" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = String string="a"
    Return v3
  b2():
    v4 = Integer integer=1
    Return v4
}
