# The read of a brand moves no value flow follows, so nothing is assumed of it and the code behind it stays: the call of the private method keeps its callee. A private field that no object among the receivers has is read by nobody: its block ends behind the read
# RUN: flow-apply
# CHECK-LABEL: function f3 name="callsPrivateMethod"
# CHECK: v2: classtoken = PrivateGet v0, v1 layout=L0
# CHECK-NOT: AssumeType v2
# CHECK-NOT: Unreachable
# CHECK: = GetModuleVariable variable=g1
# CHECK: = Call {{*}}, v0 {{*}}callees=[f2]
# CHECK-LABEL: function f4 name="callsOnAnything"
# CHECK: v2: classtoken = PrivateGet v0, v1 layout=L0
# CHECK-NOT: AssumeType v2
# CHECK-NOT: Unreachable
# CHECK: = Call {{*}}, v0 {{*}}callees=[f2]
# CHECK-LABEL: function f5 name="readsFieldOfStranger"
# CHECK: v2: anything = PrivateGet v0, v1 layout=L0 field=1
# CHECK-NEXT: : never = AssumeType v2 castType=never
# CHECK-NEXT: Unreachable
# CHECK-NOT: TypeOf

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="C" constructor=f1 fields=[{key=#"#"@L0 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}, {key=#"x"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]
layout L1 name="Stranger" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="token" module=m0 declared={type=classtoken} flags=[IsImmutable]
variable g1 name="privateMethod" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClassToken layout=L0
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = NewClosure function=f2
    PutModuleVariable v4 variable=g1
    v6 = FinishClass v3 layout=L0
    v7 = Construct v6
    v8 = CallDirect v7 function=f3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = CallDirect v10 function=f4
    v12 = Integer integer=1
    v13 = NewObject -, v12 layout=L1 fields=[0]
    v14 = FinishObject v13
    v15 = CallDirect v14 function=f5
    Return
}
function f1 name="C" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = GetModuleVariable variable=g0
    PrivateDefine v2, v3, v3 layout=L0
    v5 = Integer integer=1
    PrivateDefine v2, v3, v5 layout=L0 field=1
    Return v2
}
function f2 name="#m" kind=Method results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="callsPrivateMethod" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = PrivateGet v0, v1 layout=L0
    v3 = GetModuleVariable variable=g1
    v4 = Call v3, v0 calleeName="#m"
    Return v4
}
function f4 name="callsOnAnything" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = PrivateGet v0, v1 layout=L0
    v3 = GetModuleVariable variable=g1
    v4 = Call v3, v0 calleeName="#m"
    Return v4
}
function f5 name="readsFieldOfStranger" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = PrivateGet v0, v1 layout=L0 field=1
    v3 = TypeOf v2
    Return v3
}
