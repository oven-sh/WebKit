# A call result that is an object of one layout or what nativeCode returns is predicted, not assumed, and its uses read the prediction; a result that is only the layout is assumed
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[predicted]]: anything ~ L0 = Predict v1 predicted=L0
# CHECK-NEXT: = PropGet [[predicted]] key="x"
# CHECK-NEXT: = NewClosure function=f2
# CHECK-NEXT: v4: anything = Call v3
# CHECK-NEXT: [[assumed]]: L0 = AssumeType v4 castType=L0
# CHECK-NEXT: = PropGet [[assumed]] key="x"
# CHECK-NEXT: Return
# CHECK-LABEL: function f1 name="pointOrUnknown" {{*}}results=[{type=anything predicted=L0}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = PropGet v1 key="x"
    v3 = NewClosure function=f2
    v4 = Call v3
    v5 = PropGet v4 key="x"
    Return
}
function f1 name="pointOrUnknown" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="external" [isFreeName]
    v2 = Call v1
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2():
    v4 = CallDirect function=f2
    Return v4
}
function f2 name="makePoint" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
