# A position that holds a container with proven contents carries what is predicted of them in its type, so a read from it has the prediction by its result rule; contents proven to the layout and to nothing more give none
# RUN: flow-apply
# CHECK: variable g0 name="losable" module=m0 declared={type=Array<object ~ L0, proven,
# CHECK: variable g1 name="kept" module=m0 declared={type=Array<L0, proven,
# CHECK: variable g2 name="rows" module=m0 declared={type=Array<Array<fractional, proven, pristine[Storage, Names, Dense]> ~ Array<fractional, proven, Double, pristine[Storage, Names, Dense]>, proven,
# CHECK-LABEL: function f0 name="main"
# CHECK: = AssumeType v7 castType=Array<object ~ L0, proven,
# CHECK-LABEL: function f1 name="readsLosable"
# CHECK: v2: undefined|object ~ undefined|L0 = ElemGet v1, v0
# CHECK-LABEL: function f2 name="readsKept"
# CHECK: v2: undefined|L0 = ElemGet v1, v0
# CHECK-LABEL: function f3 name="readsRow"
# CHECK: v2: undefined|Array<fractional, proven, pristine[Storage, Names, Dense]> ~ undefined|Array<fractional, proven, Double, pristine[Storage, Names, Dense]> = ElemGet v1, v0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="losable" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="rows" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0] @10
    v2 = NewObject -, v0 layout=L0 fields=[0] @20
    v3 = Builtin builtin=ObjectDefineProperty
    v4 = Integer integer=0
    v5 = NewObject -, v0 layout=L1 fields=[0]
    v6 = Call v3, -, v1, v4, v5
    v7 = NewArray v1 contents=anything holes=[] @30
    PutModuleVariable v7 variable=g0
    v9 = NewArray v2 contents=anything holes=[] @40
    PutModuleVariable v9 variable=g1
    v11 = Double number=0.5
    v12 = NewArray v11 contents=anything holes=[] @50
    v13 = NewArray v12 contents=anything holes=[] @60
    PutModuleVariable v13 variable=g2
    v15 = Builtin builtin=MathRandom
    v16 = Call v15
    v17 = CallDirect v16 function=f1
    v18 = CallDirect v16 function=f2
    v19 = CallDirect v16 function=f3
    Return
}
function f1 name="readsLosable" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = ElemGet v1, v0
    v3 = PropGet v2 key="x"
    Return v3
}
function f2 name="readsKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = ElemGet v1, v0
    v3 = PropGet v2 key="x"
    Return v3
}
function f3 name="readsRow" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g2
    v2 = ElemGet v1, v0
    v3 = ElemGet v2, v0
    Return v3
}
