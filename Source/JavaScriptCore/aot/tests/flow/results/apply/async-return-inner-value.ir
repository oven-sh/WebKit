# The Return of an async body carries the inner value and is not held to the promise type of the result, and a plain Return is held to its result type
# RUN: flow-apply
# CHECK-LABEL: function f1 name="unknownValue" {{*}}results=[{type=Promise}]
# CHECK-NOT: AssumeType
# CHECK: v1: anything = PropGet v0 key="input"
# CHECK-NEXT: Return v1
# CHECK-LABEL: function f2 name="constant" {{*}}results=[{type=Promise<number>}]
# CHECK-NOT: AssumeType
# CHECK: v0: 1 = Integer integer=1
# CHECK-NEXT: Return v0
# CHECK-LABEL: function f3 name="declared" {{*}}results=[{type=undefined|null|Promise<number>}]
# CHECK-NOT: AssumeType
# CHECK: b0(v0: 5):
# CHECK-NEXT: Return v0
# CHECK-LABEL: function f4 name="plain" {{*}}results=[{type=true|1 written=anything}]
# CHECK: v1: anything = Call v0
# CHECK-NEXT: [[cast]]: true|1 = AssumeType v1 castType=true|1
# CHECK-NEXT: Return [[cast]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = Integer integer=5
    v3 = CallDirect v2 function=f3
    v4 = CallDirect function=f4
    Return
}
function f1 name="unknownValue" flags=[IsAsync] results=[{type=Promise}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    Return v1
}
function f2 name="constant" flags=[IsAsync] results=[{type=Promise<number>}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="declared" flags=[IsAsync] parameters=[{type=undefined|null|number}] results=[{type=undefined|null|Promise<number>}] {
  b0(v0: undefined|null|number):
    Return v0
}
function f4 name="plain" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = Call v0
    Return v1
}
function f5 name="pick" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="choice" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Boolean boolean=true
    Return v4
}
