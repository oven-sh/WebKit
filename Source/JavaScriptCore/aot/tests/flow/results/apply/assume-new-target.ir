# new.target has no position in a signature: where flow knows every construction, a cast at the head of the constructor says which classes it is
# RUN: flow-apply
# CHECK-LABEL: function f1 name="OnlyItself"
# CHECK: b0(v0: anything):
# CHECK-NEXT: [[itself]]: f1 = AssumeType v0 castType=f1
# CHECK-NEXT: = GetConstructPrototype [[itself]] layout=L0
# CHECK-LABEL: function f2 name="Extended"
# CHECK: b0(v0: anything):
# CHECK-NEXT: [[either]]: f2|f3 = AssumeType v0 castType=f2|f3
# CHECK-NEXT: = GetConstructPrototype [[either]] layout=L1
# CHECK-LABEL: function f4 name="UnknownNewTarget"
# CHECK: b0(v0: anything):
# CHECK-NEXT: = GetConstructPrototype v0 layout=L3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="OnlyItself" constructor=f1
layout L1 kind=Instance name="Extended" constructor=f2
layout L2 kind=Instance name="Heir" predictedBase=L1 constructor=f3 flags=[HasHeritage]
layout L3 kind=Instance name="UnknownNewTarget" constructor=f4
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = NewClosure function=f2
    v5 = NewClass v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    v8 = NewClosure function=f3
    v9 = ResolveHeritage v6
    v10 = NewClass v8, v6, v9 layout=L2
    v11 = FinishClass v10 layout=L2
    v12 = Construct v11
    v13 = NewClosure function=f4
    v14 = NewClass v13 layout=L3
    v15 = FinishClass v14 layout=L3
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="other" [isFreeName]
    v18 = Construct v15, v17
    Return
}
function f1 name="OnlyItself" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Extended" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f3 name="Heir" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=object}] constructedClass=L2 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f4 name="UnknownNewTarget" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] constructedClass=L3 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
