# A loop parameter that is added to in the loop narrows with what flow proves about the other operand; one that a turn may add text to keeps every part
# RUN: flow-apply
# LOSS: MaxFlowRangeGrowth

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
