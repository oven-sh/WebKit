# Proven contents whose objects can lose their shape are `object`, and the layout flow saw there is what is predicted of them. Objects that keep their shape need no prediction, and contents that are not proven have one list
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: variable g0 type=Array<object ~ L0, proven,
# CHECK: variable g1 type=Array<L0, proven,
# CHECK: variable g2 type=Map<"k", object ~ L0, proven
# CHECK: variable g3 type=Array<L0, Contiguous,
# CHECK: variable g4 type=Array<Array<fractional, proven, pristine[Storage, Names, Dense]> ~ Array<fractional, proven, Double, pristine[Storage, Names, Dense]>, proven,
# NOWHERE-NOT: variable g1 type=Array<{{*}}~
# NOWHERE-NOT: variable g3 type=Array<{{*}}~

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="losable" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="losableByKey" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="handedOut" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="rows" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0] @10
    v2 = NewObject -, v0 layout=L0 fields=[0] @20
    v3 = Builtin builtin=ObjectDefineProperty
    v4 = Integer integer=0
    v5 = NewObject -, v0 layout=L1 fields=[0]
    v6 = Call v3, -, v1, v4, v5
    v7 = NewArray v1 contents=anything holes=[] @30
    PutModuleVariable v7 variable=g0
    v9 = NewArray v2 contents=anything holes=[] @40
    PutModuleVariable v9 variable=g1
    v11 = Builtin builtin=Map
    v12 = Construct v11
    v13 = PropGet v12 key="set"
    v14 = String string="k"
    v15 = Call v13, v12, v14, v1
    PutModuleVariable v12 variable=g2
    v17 = NewArray v1 contents=anything holes=[] @50
    PutModuleVariable v17 variable=g3
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="sink" [isFreeName]
    v21 = Call v20, -, v17
    v22 = Double number=0.5
    v23 = NewArray v22 contents=anything holes=[] @60
    v24 = NewArray v23 contents=anything holes=[] @70
    PutModuleVariable v24 variable=g4
    Return
}
