# A typed JSON.parse that flow applied before its function passed the work limit (its layout has objects in the solve) has no typed result either: the answer does not depend on how far the solve had come
# OPTIONS: limit=MaxFlowWorkPerFunction:600
# LOSS: MaxFlowWorkPerFunction f1
# RUN: flow
# CHECK-NOT: typed-result S
# CHECK: typed-result [[call]] L3
# CHECK-NOT: typed-result S
# CHECK-NOT: layout L2 flow={allocation=NeverAllocated
# CHECK: layout L3 flow={{*}}observedUses=[ReachesTypedParse]
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L2 layouts=[L2]
expectedresult x1 type=L3 layouts=[L3]
layout L0 name="BusyBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="IdleBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="ParsedByBusy" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
layout L3 name="ParsedByIdle" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = CallDirect v3 function=f2
    Return
}
