# A function that keeps its own closure through its callee parameter keeps it past the frame, also when a built-in calls it
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f3 parameter 1 uses=[{{*}}Retains
# CHECK: class {{*}} layout=L1 {{*}}locality=FrameLocal
# CHECK: class {{*}} closureFunction=f4 {{*}}locality=FrameLocal
# NOWHERE-NOT: function f4 parameter 1 uses={{*}}Retains
# NOWHERE-NOT: layout=L0 {{*}}locality=FrameLocal
# NOWHERE-NOT: closureFunction=f3 {{*}}locality=FrameLocal

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="n" declared={type=anything}}]
layout L1 kind=Environment fields=[{key="n" declared={type=anything}}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="kept" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f3
    v2 = Builtin builtin=Uint8Array
    v3 = Integer integer=1
    v4 = Construct v2, -, v3
    v5 = PropGet v4 key="forEach"
    v6 = Call v5, v4, v1
    Return
}
function f2 name="control" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1 fields=[]
    v1 = NewClosure v0 function=f4
    v2 = Builtin builtin=Uint8Array
    v3 = Integer integer=1
    v4 = Construct v2, -, v3
    v5 = PropGet v4 key="forEach"
    v6 = Call v5, v4, v1
    Return
}
function f3 name="keepsItself" flags=[TakesCallee] captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0, v1: function):
    PutModuleVariable v1 variable=g0
    Return
}
function f4 name="callback" flags=[TakesCallee] captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1, v1: function):
    Return
}
