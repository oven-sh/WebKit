# A member of a holder of the host that a lookup takes for a constant changes only where the holder itself is among the receivers. A store by name, a store, a definition and a deletion under a key nobody can name,
# all through an unknown receiver, leave the members of an escaped holder constant. A name that the table does not list is unknown there, and a store under such a key to the holder itself writes each member
# RUN: flow
# CHECK: builtin-location Bun."sleep" Unknown written at f0:v21
# CHECK: builtin-location Bun."inspect" Unknown written at f0:v21
# CHECK: builtin-location Console."log" Constant
# CHECK: builtin-location Console."warn" Constant
# CHECK: builtin-use Bun [{{*}}Escaped
# CHECK: builtin-use Console [{{*}}Escaped
# RUN(NODES): flow-solve nodes
# NODES: Variable(g0) = {ConsoleLog}
# NODES-NEXT: Variable(g1) = {ConsoleWarn}
# NODES-NEXT: Variable(g2) = {{*}}unknown}
# NODES-NEXT: Variable(g3) = {{*}}1|BunSleep}
# RUN(TABLES): tables constants
# TABLES: constantBuiltinMember member=ConsoleLog
# TABLES: constantBuiltinMember member=ConsoleWarn
# TABLES-NOT: constantBuiltinMember member=Bun

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="log" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="warn" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="added" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="sleep" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Console
    v2 = Builtin builtin=Bun
    v3 = PropGet v0 key="sink" [isFreeName]
    v4 = Call v3, -, v1
    v5 = Call v3, -, v2
    v6 = PropGet v0 key="input" [isFreeName]
    v7 = PropGet v0 key="name" [isFreeName]
    v8 = ToPropertyKey v7
    v9 = Integer integer=1
    PropSet v6, v9 key="log" mode=Strict
    ElemSet v6, v8, v9 mode=Strict
    v12 = ClaimDeclared v6 declared={type=object flags=[IsFromCompiler]}
    ElemDefine v12, v8, v9
    v14 = ElemDelete v6, v8 mode=Strict
    v15 = PropGet v1 key="log"
    PutModuleVariable v15 variable=g0
    v17 = PropGet v1 key="warn"
    PutModuleVariable v17 variable=g1
    v19 = PropGet v1 key="added"
    PutModuleVariable v19 variable=g2
    ElemSet v2, v8, v9 mode=Strict
    v22 = PropGet v2 key="sleep"
    PutModuleVariable v22 variable=g3
    Return
}
