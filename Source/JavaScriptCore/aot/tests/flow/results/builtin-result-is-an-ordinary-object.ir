# CHECK: class C{{*}} layout=L(ReadAndWrittenCounts) impossibleMutations=[{{*}}, StoreOfOtherType] {{*}}cause=NonLayoutObject witness={function=f0 value=v19
# CHECK: class C{{*}} layout=L(IteratorResult) impossibleMutations=[{{*}}, StoreOfOtherType] {{*}}cause=NonLayoutObject witness={function=f0 value=v5
# CHECK: layout L(IteratorResult) flow={baseState=None members=[L(IteratorResult)] allocationClasses=[1] {{*}}, LoseShape]
# CHECK-NOT: cause=
# CHECK: field L(IteratorResult).0 "value" type=undefined
# CHECK-NEXT: field L(IteratorResult).1 "done" type=true
# CHECK: layout L(ReadAndWrittenCounts) flow={allocation=NeverAllocated
# CHECK: variable g0 type=object written=anything {{*}}cause=NonLayoutObject witness={function=f0 value=v5}}
# CHECK-NEXT: variable g1 type=L(IteratorResult) written=anything
# CHECK-NEXT: variable g2 type=object written=anything {{*}}cause=NonLayoutObject witness={function=f0 value=v19}}
# CHECK-NEXT: variable g3 type=int[0, 4294967296] written=anything
# RUN(APPLY): flow-apply
