# APPLY-NEXT: : object = AssumeType [[stepOfMap]] castType=object
# APPLY-NEXT: PutModuleVariable
# APPLY: [[stepOfArray]]: anything = Call {{*}}callees=[f1, builtin(ArrayIteratorPrototypeNext)]
# APPLY-NEXT: : L(IteratorResult) = AssumeType [[stepOfArray]] castType=L(IteratorResult)
# APPLY: [[counts]]: anything = Call {{*}}callees=[builtin(Uint8ArrayPrototypeSetFromBase64)]
# APPLY-NEXT: [[object]]: object = AssumeType [[counts]] castType=object
# APPLY-NOT: receivers=
# APPLY: [[read]]: anything = PropGet [[object]] key="read"
# APPLY-NEXT: : int[0, 4294967296] = AssumeType [[read]] castType=int[0, 4294967296]
# APPLY: : L(IteratorResult) = CreateIteratorResult v1, v2 allocationSite=1 [keepsShape]

