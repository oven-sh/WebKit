# A class lists its method definitions by index, with no key for a computed key, beside the list by name. A function that a store puts on the prototype object is listed by name only, a constructor function has no definitions, and copies of a definition that disagree have no key
# RUN: flow
# CHECK: layout L1 flow={{*}} members=[{key="z" function=f2{{*}}}, {key="a" function=f3{{*}}}, {key="b" side=Static function=f4{{*}}}, {function=f5}, {key="g" kind=Getter function=f6{{*}}}, {key="g" kind=Setter function=f7{{*}}}] namedMembers=[{key="g" kind=Getter function=f6{{*}}}, {key="g" kind=Setter function=f7{{*}}}, {key="a" function=f3{{*}}}, {key="z" function=f2{{*}}}, {key="q" function=f8{{*}}}, {key="b" side=Static function=f4{{*}}}]}
# CHECK: layout L2 flow={{*}} staticNamesAreComplete=true members=[{key="get" function=f8{{*}}}] namedMembers=[{key="get" function=f8
# CHECK: layout L3 flow={{*}} members=[{function=f2}, {function=f3}] namedMembers=[{key="m" function=f2{{*}}}, {key="m" function=f3{{*}}}]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="KeyNumbers" fields=[{key="g" declared={type=anything}}, {key="a" declared={type=anything}}, {key="z" declared={type=anything}}]
layout L1 kind=Instance name="Ordered" constructor=f1
layout L2 kind=Instance name="Legacy" constructor=f9 flags=[IsConstructorFunction]
layout L3 kind=Instance name="DefinedTwice" constructor=f10
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="key" [isFreeName]
    v2 = ToPropertyKey v1
    v3 = NewClosure function=f1
    v4 = NewClass v3 layout=L1
    v5 = NewClosure function=f2
    DefineMethod v4, v5 layout=L1 key="z"
    v7 = NewClosure function=f3
    DefineMethod v4, v7 layout=L1 index=1 key="a"
    v9 = NewClosure function=f4
    DefineMethod v4, v9 layout=L1 side=Static index=2 key="b"
    v11 = NewClosure function=f5
    DefineMethod v4, v11, v2 layout=L1 index=3
    v13 = NewClosure function=f6
    DefineMethod v4, v13 layout=L1 methodKind=Getter index=4 key="g"
    v15 = NewClosure function=f7
    DefineMethod v4, v15 layout=L1 methodKind=Setter index=5 key="g"
    v17 = FinishClass v4 layout=L1
    v18 = PropGet v17 key="prototype"
    v19 = NewClosure function=f8
    PropSet v18, v19 key="q" mode=Strict
    v21 = NewClosure function=f9
    v22 = PropGet v21 key="prototype"
    v23 = NewClosure function=f8
    PropSet v22, v23 key="get" mode=Strict
    v25 = NewClosure function=f10
    v26 = NewClass v25 layout=L3
    v27 = NewClosure function=f2
    DefineMethod v26, v27 layout=L3 key="m"
    v29 = FinishClass v26 layout=L3
    v30 = NewClosure function=f10
    v31 = NewClass v30 layout=L3
    v32 = NewClosure function=f3
    DefineMethod v31, v32 layout=L3 key="m"
    v34 = FinishClass v31 layout=L3
    Return
}
function f1 name="Ordered" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f2 name="z" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="a" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="b" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="computed" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f6 name="g" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f7 name="g" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f8 name="stored" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f9 name="Legacy" flags=[HasThis] thisType={type=L2} results=[{type=anything}] {
  b0(v0: object ? L2):
