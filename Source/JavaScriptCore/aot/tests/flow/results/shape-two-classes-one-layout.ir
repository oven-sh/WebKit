# A loss belongs to the allocation class, not to the layout: of two construct sites of one constructor function the objects of one get an accessor under an index key, and the objects of the other keep their shape
# RUN: flow
# CHECK: class [[kept]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK-NOT: cause=
# CHECK: class [[lost]] layout=L0 {{*}}cause={{*}} witness={function=f0 value=v9}
# CHECK: layout L0 flow={{*}}cause={{*}} witness={function=f0 value=v9}
# CHECK: variable g0 type=L0 written=anything
# CHECK: variable g1 type=object predicted=L0 written=anything
# CHECK: variable g2 type=object predicted=L0 written=anything
# CHECK: function f1 this type=object predicted=L0 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Point" constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 name="AccessorDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="lost" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="either" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Construct v0
    v2 = Construct v0
    PutModuleVariable v1 variable=g0
    PutModuleVariable v2 variable=g1
    v5 = NewClosure function=f2
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = Integer integer=0
    v8 = Builtin builtin=ObjectDefineProperty
    v9 = Call v8, -, v2, v7, v6
    v10 = Builtin builtin=MathRandom
    v11 = Call v10
    v12 = ToBoolean v11
    Branch v12 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v2)
  b3(v13):
    PutModuleVariable v13 variable=g2
    Return
}
function f1 name="Point" flags=[HasThis] thisType={type=anything predicted=L0} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f2 name="first" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
