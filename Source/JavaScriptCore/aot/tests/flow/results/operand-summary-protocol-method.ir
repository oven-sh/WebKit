# A method that a built-in finds on an operand runs with the operand as this, so the operand also has the uses of that parameter
# RUN: flow
# RUN(ALL): flow
# CHECK: function f1 parameter 0 uses=[Inspects, Retains] 
# CHECK: function f2 parameter 0 uses=[Inspects] 
# CHECK: indirect f1 {{*}} -> f4 Protocol
# CHECK: indirect f2 {{*}} -> f6 Protocol
# ALL-NOT: function f2 parameter 0 uses=[{{*}}Ret{{*}}] retainedIn

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Kept" constructor=f3
layout L1 kind=Instance name="Dropped" constructor=f5
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f4
    DefineMethod v1, v2 layout=L0 key="valueOf"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = CallDirect v5 function=f1
    v7 = NewClosure function=f5
    v8 = NewClass v7 layout=L1
    v9 = NewClosure function=f6
    DefineMethod v8, v9 layout=L1 key="valueOf"
    v11 = FinishClass v8 layout=L1
    v12 = Construct v11
    v13 = CallDirect v12 function=f2
    Return
}
function f1 name="convertKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=IsNaN
    v2 = Call v1, -, v0
    Return
}
function f2 name="convertDropped" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=IsNaN
    v2 = Call v1, -, v0
    Return
}
function f3 name="Kept" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f4 name="valueOf" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    Return
}
function f5 name="Dropped" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f6 name="valueOf" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
