# A class that is defined and never constructed is never allocated and a member of no set, unless nativeCode holds the class object and can construct it
# RUN: flow
# RUN(ALL): flow
# CHECK: layout L0 flow={allocation=NeverAllocated baseState=None
# CHECK: layout L1 flow={baseState=None members=[L1]
# CHECK: layout L2 flow={baseState=None members=[L2]
# ALL-NOT: layout L0 {{*}}members=
# ALL-NOT: members=[L0
# ALL-NOT: layout L1 flow={allocation=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Defined" constructor=f1
layout L1 kind=Instance name="Escaped" constructor=f2
layout L2 name="Allocated" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = Boolean boolean=true
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="publish" [isFreeName]
    v10 = Call v9, -, v5
    Return
}
function f1 name="Defined" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Escaped" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
