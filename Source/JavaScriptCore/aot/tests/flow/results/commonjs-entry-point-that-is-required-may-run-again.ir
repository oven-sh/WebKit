# helper.cjs requires the entry point back. If the body of the entry point has thrown by then, the loader has forgotten it and runs it again, so it does not run at most once.
# Without that site: flow/results/commonjs-entry-point-that-throws-ends-the-program.ir
# RUN: flow
# CHECK: function f0
# CHECK-NOT: executions=
# CHECK: function f3

module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="helper.cjs" displayPath="helper.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = RequireModule module=m1 referrer=m0 specifier="./helper.cjs"
    v7 = CallDirect function=f2
    Return
}
function f1 name="helper" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = RequireModule module=m0 referrer=m1 specifier="./main.cjs"
    Return
}
function f2 name="calledByMain" module=m0 results=[{type=anything}] {
  b0():
    Return
}
function f3 name="unused" module=m0 results=[{type=anything}] {
  b0():
    Return
}
