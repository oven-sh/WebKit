# A function past the work limit keeps its signature and its values as read, and what it stores, passes and returns has the type as read. The same function below the limit is narrowed
# OPTIONS: limit=MaxFlowWorkPerFunction:120
# LOSS: MaxFlowWorkPerFunction f1
# RUN: flow
# CHECK: variable g0 type=anything flow=
# CHECK: variable g1 type=1 written=anything
# CHECK: variable g2 type=anything flow=
# CHECK: variable g3 type=1 written=anything
# CHECK: function f2 parameter 0 type=L1 written=anything
# CHECK: function f2 result 0 type=1 written=anything
# CHECK: function f4 parameter 0 type=1 written=anything
# CHECK: function f4 result 0 type=1 written=anything
# RUN(BUSY): flow
# BUSY-NOT: function f1 parameter 0 type=
# BUSY-NOT: function f1 result 0 type=
# BUSY-NOT: function f3 parameter 0 type=
# BUSY-NOT: function f3 result 0 type=
# RUN(APPLY): flow-apply
# APPLY-LABEL: function f1 name="busy"
# APPLY-NOT: AssumeType
# APPLY: [[read]]: anything = PropGet v0 key="y"
# APPLY-NOT: AssumeType
# APPLY: anything = CallDirect [[read]] function=f3
# APPLY-NOT: AssumeType
# APPLY-LABEL: function f2 name="idle"
# APPLY: b0(v0: L1):
# APPLY: [[narrowed]]: 1 = PropGet v0 key="y"
# APPLY: 1 = CallDirect {{*}}function=f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="BusyBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="IdleBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="storedByBusy" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="storedByIdle" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="returnedByBusy" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="returnedByIdle" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1 function=f1
    PutModuleVariable v2 variable=g2
    v4 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v5 = CallDirect v4 function=f2
    PutModuleVariable v5 variable=g3
    Return
}
function f1 name="busy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
    v11 = PropGet v0 key="x"
    v12 = PropGet v0 key="x"
    v13 = PropGet v0 key="x"
    v14 = PropGet v0 key="x"
    v15 = PropGet v0 key="x"
    v16 = PropGet v0 key="x"
    v17 = PropGet v0 key="x"
    v18 = PropGet v0 key="x"
    v19 = PropGet v0 key="x"
    v20 = PropGet v0 key="x"
    v21 = PropGet v0 key="x"
    v22 = PropGet v0 key="x"
    v23 = PropGet v0 key="x"
    v24 = PropGet v0 key="x"
    v25 = PropGet v0 key="x"
    v26 = PropGet v0 key="x"
    v27 = PropGet v0 key="x"
    v28 = PropGet v0 key="x"
    v29 = PropGet v0 key="x"
    v30 = PropGet v0 key="x"
    v31 = PropGet v0 key="x"
    v32 = PropGet v0 key="x"
    v33 = PropGet v0 key="x"
    v34 = PropGet v0 key="x"
    v35 = PropGet v0 key="x"
    v36 = PropGet v0 key="x"
    v37 = PropGet v0 key="x"
    v38 = PropGet v0 key="x"
    v39 = PropGet v0 key="x"
    v40 = PropGet v0 key="x"
    v41 = PropGet v0 key="x"
    v42 = PropGet v0 key="x"
    v43 = PropGet v0 key="x"
    v44 = PropGet v0 key="x"
    v45 = PropGet v0 key="x"
    v46 = PropGet v0 key="x"
    v47 = PropGet v0 key="x"
    v48 = PropGet v0 key="x"
    v49 = PropGet v0 key="x"
    v50 = PropGet v0 key="x"
    v51 = PropGet v0 key="x"
    v52 = PropGet v0 key="x"
    v53 = PropGet v0 key="x"
    v54 = PropGet v0 key="x"
    v55 = PropGet v0 key="x"
    v56 = PropGet v0 key="x"
    v57 = PropGet v0 key="x"
    v58 = PropGet v0 key="x"
    v59 = PropGet v0 key="x"
    v60 = PropGet v0 key="x"
    v61 = PropGet v0 key="y"
    PutModuleVariable v61 variable=g0
    v63 = CallDirect v61 function=f3
    Return v63
}
function f2 name="idle" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y"
    PutModuleVariable v1 variable=g1
    v3 = CallDirect v1 function=f4
    Return v3
}
function f3 name="busyCallee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="idleCallee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
