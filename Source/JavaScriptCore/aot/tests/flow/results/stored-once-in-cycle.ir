# One store site in a cycle of blocks runs many times, and a field of an environment allocated in the same cycle is stored once per environment
# RUN: flow
# CHECK: field L0.0 "i" {{*}}flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation
# CHECK: field L1.0 "total" {{*}}flow={location={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: layout L(
# CHECK: variable g0 {{*}}flow={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: variable g1 {{*}}flow={writers=AllKnown stores=AtMostOnce

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="i" declared={type=anything}}]
layout L1 kind=Environment fields=[{key="total" declared={type=anything}}]
variable g0 name="n" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="after" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1 fields=[]
    Jump -> next b1()
  b1():
    v1 = Integer integer=1
    PutModuleVariable v1 variable=g0
    v3 = NewObject layout=L0 fields=[]
    PutEnvironmentField v3, v1 layout=L0 field=0
    PutEnvironmentField v0, v1 layout=L1 field=0
    v6 = NewClosure v3, v0 function=f1
    v7 = Call v6
    v8 = ToBoolean v7
    Jump -> next b2()
  b2():
    LoopHint
    Branch v8 -> taken b1(), notTaken b3()
  b3():
    PutModuleVariable v1 variable=g1
    Return
}
function f1 name="read" kind=Arrow captures=[{type=env L0}, {type=env L1}] results=[{type=anything}] {
  b0(v0: env L0, v1: env L1):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = GetEnvironmentField v1 layout=L1 field=0
    v4 = Add v2, v3
    Return v4
}
