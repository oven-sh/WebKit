# An object that gets another prototype keeps its shape, and a name that may be missing on it may be found on a prototype
# RUN: flow
# RUN(INSTANCE): flow
# CHECK: class [[plain]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: class [[parent]] layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: class [[literal]] layout=L3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: class [[untouched]] layout=L4 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: layout L0 flow={
# CHECK-NOT: cause=
# CHECK: field L0.0 "x" type=undefined|1 written=anything flow={location={writers=AllKnown
# CHECK-NOT: prototypeName=
# CHECK: layout L1 flow={
# CHECK: field L4.0 "x" type=undefined|1 written=anything {{*}}prototypeName=AbsentOnPrototypes
# CHECK: variable g0 type=undefined|1 written=anything
# CHECK: variable g1 type=undefined|1 written=anything
# CHECK: variable g2 type={{*}}1 written=anything
# CHECK: variable g3 type=undefined written=anything
# INSTANCE: class [[instance]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, BecomePrototype, StoreOfOtherType, LoseShape]
# INSTANCE: layout L1 flow={
# INSTANCE-NOT: cause=
# INSTANCE: field L1.0 "x" type=undefined|1 written=anything flow={location={writers=AllKnown
# INSTANCE-NOT: prototypeName=
# INSTANCE: layout L2 flow={

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Instance" constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L2 name="Parent" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L3 name="LiteralPrototype" fields=[{key="x" declared={type=anything}}]
layout L4 name="Untouched" fields=[{key="x" declared={type=anything}}]
variable g0 name="fromPlain" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromInstance" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="fromLiteralPrototype" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="fromUntouched" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject layout=L0 fields=[]
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L1
    v4 = FinishClass v3 layout=L1
    v5 = Construct v4
    v6 = NewObject -, v0 layout=L2 fields=[0]
    v7 = Builtin builtin=ObjectSetPrototypeOf
    v8 = Call v7, -, v1, v6
    v9 = Call v7, -, v5, v6
    v10 = NewObject layout=L3 fields=[]
    SetLiteralPrototype v10, v6
    v12 = FinishObject v10
    v13 = NewObject layout=L4 fields=[]
    PropSet v1, v0 key="x" mode=Strict
    PropSet v5, v0 key="x" mode=Strict
    PropSet v12, v0 key="x" mode=Strict
    PropSet v13, v0 key="x" mode=Strict
    v18 = PropGet v1 key="y"
    PutModuleVariable v18 variable=g0
    v20 = PropGet v5 key="y"
    PutModuleVariable v20 variable=g1
    v22 = PropGet v12 key="y"
    PutModuleVariable v22 variable=g2
    v24 = PropGet v13 key="y"
    PutModuleVariable v24 variable=g3
    Return
}
function f1 name="Instance" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
