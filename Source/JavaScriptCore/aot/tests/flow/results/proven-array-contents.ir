# Every store through every alias of an array is in its contents, and then the contents are proven
# RUN: flow
# STATISTIC: FlowProvenContentsSites = 1
# CHECK: field L0.0 "items" type=Array<true|int[1, 2], proven,
# CHECK: variable g0 type=Array<true|int[1, 2], proven,
# CHECK: variable g1 type=true|int[1, 2] written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="items" declared={type=anything} flags=[IsRequired]}]
variable g0 name="list" declared={type=anything} initialization=Uninitialized
variable g1 name="first" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = Integer integer=0
    v5 = GetModuleVariable variable=g0
    v6 = Integer integer=2
    ElemSet v5, v4, v6 mode=Strict
    v8 = PropGet v3 key="items"
    v9 = Boolean boolean=true
    ElemSet v8, v4, v9 mode=Strict
    v11 = ElemGet v5, v4
    PutModuleVariable v11 variable=g1
    Return
}
