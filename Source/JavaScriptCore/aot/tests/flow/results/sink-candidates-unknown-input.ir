# One string nobody knows does not erase the literal beside it: the pattern lists the literal and is not complete. A pattern that only literals reach is complete
# RUN: flow
# CHECK: sink [[mixed]] operand 0 ["a+"]
# CHECK-NOT: mayBeUndefined
# CHECK-NOT: complete
# CHECK: sink [[mixed]] operand 1 [] mayBeUndefined complete
# CHECK-NEXT: sink [[literals]] operand 0 ["a+", "b+"] complete

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToString v1
    v3 = PropGet v0 key="condition" [isFreeName]
    v4 = ToBoolean v3
    v5 = String string="a+"
    v6 = String string="b+"
    v7 = Builtin builtin=RegExp
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v5, v5)
  b2():
    Jump -> next b3(v2, v6)
  b3(v8, v9):
    v10 = Construct v7, -, v8
    v11 = Construct v7, -, v9
    Return
}
