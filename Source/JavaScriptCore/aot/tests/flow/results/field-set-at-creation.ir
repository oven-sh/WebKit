# A field is set at creation when every allocation of its layout has it among the initial fields
# RUN: flow
# CHECK: field L0.0 "x" type=1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation {{*}}occupancy=AlwaysFilled
# CHECK: field L0.1 "y" type=1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation {{*}}occupancy=AlwaysFilled
# CHECK: field L1.0 "x" type=1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation {{*}}occupancy=AlwaysFilled
# CHECK: field L1.1 "y" type=undefined|1 written=anything flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation
# RUN(PARTIAL): flow
# PARTIAL-NOT: field L1.1 {{*}}SetAtCreation
# PARTIAL-NOT: field L1.1 {{*}}AlwaysFilled

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Full" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Partial" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v3 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v4 = NewObject -, v0 layout=L1 fields=[0]
    Return
}
