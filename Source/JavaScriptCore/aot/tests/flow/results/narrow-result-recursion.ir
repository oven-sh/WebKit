# The result of a recursive function is the join of its other returns
# RUN: flow
# RUN(ALL): flow
# CHECK: function f4 callers=AllKnown cause=UnknownObject witness={function=f4 value=v1}
# CHECK: function f1 parameter 0 type="deep" written=anything
# CHECK: function f1 result 0 type=L0 written=anything
# CHECK: function f2 result 0 type=true written=anything
# CHECK: function f3 result 0 type=true written=anything
# CHECK: function f5 result 0 type=never written=anything
# ALL-NOT: function f4 result 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Leaf" fields=[{key="path" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="deep"
    v1 = CallDirect v0 function=f1
    v2 = CallDirect function=f2
    v3 = CallDirect function=f4
    v4 = CallDirect function=f5
    Return
}
function f1 name="descend" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f1
    Return v2
  b2():
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Return v3
}
function f2 name="even" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="more" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect function=f3
    Return v3
  b2():
    v4 = Boolean boolean=true
    Return v4
}
function f3 name="odd" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f2
    Return v0
}
function f4 name="guess" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="more" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect function=f4
    Return v3
  b2():
    Return v1
}
function f5 name="spin" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f5
    Return v0
}
