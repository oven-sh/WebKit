# With own names switched off no class lists the names its objects get, no class says that its members are all its names, no field whether a prototype has its name, and every other result stays
# OPTIONS: disable=flow:OwnNames,flow:AppendedFields
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, {{*}}LoseShape] keys=NeverEnumerated locality=FrameLocal
# CHECK: layout L0 flow={baseState=None members=[L0] allocationClasses=[0] constructorOrders=[{fields=[0]}] impossibleMutations=[{{*}}LoseShape] keys=NeverEnumerated}
# CHECK: field L0.0 "a" type=1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true
# CHECK: field L0.1 "sometimes" type=undefined written=anything flow={location={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation reads=NeverRead isUnchangedDuringActivation=true cause=ResultDisabled} stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: layout L1 flow={{*}}classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed members=[{key="method" function=f2 mutability=Fixed closureUse=CalledOnly isWritableData=true}] namedMembers=[{key="method" function=f2 mutability=Fixed closureUse=CalledOnly isWritableData=true}]}
# NOWHERE-NOT: addedKeys
# NOWHERE-NOT: ownAccessors
# NOWHERE-NOT: NamesAreComplete
# NOWHERE-NOT: prototypeName=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Named" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="sometimes" declared={type=anything}}]
layout L1 kind=Instance name="Complete" constructor=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v1, v0 key="p" mode=Strict
    PropSet v1, v0 key="q" mode=Strict
    v4 = NewClosure function=f1
    v5 = NewClass v4 layout=L1
    v6 = NewClosure function=f2
    DefineMethod v5, v6 layout=L1 key="method"
    v8 = FinishClass v5 layout=L1
    Return
}
function f1 name="Complete" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f2 name="method" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
