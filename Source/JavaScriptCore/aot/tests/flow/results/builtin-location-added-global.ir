# A property the program adds to the global object is no table member: it is listed because it is written, and its state is unknown
# RUN: flow
# STATISTIC: FlowWrittenBuiltinLocations = 1
# CHECK: builtin-location GlobalThis."foo" Unknown written at f0:v2
# CHECK: builtin-location GlobalThis."Math" Constant
# RUN(READ): flow
# READ-NOT: builtin-location GlobalThis."bar"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Integer integer=1
    PropSet v0, v1 key="foo" mode=Strict
    v3 = PropGet v0 key="bar"
    v4 = PropGet v0 key="Math" [isFreeName]
    Return
}
