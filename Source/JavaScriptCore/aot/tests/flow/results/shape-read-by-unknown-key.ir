# A record read under a string nobody knows stays out of native code: the key may name __proto__, whose getter answers the prototype of its receiver and keeps nothing. What the read can hand out or run still counts: the prototype, an own getter, an accessor of a prototype nobody knows
# OPTIONS: disable=flow:CallVersions
# RUN: flow
# RUN(VALUES): flow-solve nodes
# RUN(KNOWN): flow-solve nodes
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] keys=NeverEnumerated locality=FrameLocal addedKeysAreComplete=true
# CHECK: class {{*}} layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: class {{*}} layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, {{*}}LoseShape] keys=NeverEnumerated
# CHECK: class {{*}} layout=L3 {{*}}cause=ReachesUnknownJavaScript
# CHECK: class {{*}} layout=L4 {{*}}cause=ReachesUnknownJavaScript
# VALUES: f0, v5) = {undefined|1|ObjectPrototype|
# VALUES: f0, v10) = {undefined|1|L1#
# KNOWN-NOT: f0, v5) = {{*}}unknown
# KNOWN-NOT: f0, v5) = {{*}}L0#
# KNOWN-NOT: f0, v10) = {{*}}unknown
# KNOWN-NOT: f0, v10) = {{*}}L2#
# KNOWN-NOT: f0, v10) = {{*}}ObjectPrototype|

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="OnlyRead" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="HandedOutParent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Child" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="WithOwnGetter" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L4 name="WithUnknownParent" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="which" [isFreeName]
    v3 = TypeOf v2
    v4 = NewObject -, v0 layout=L0 fields=[0]
    v5 = ElemGet v4, v3
    v6 = NewObject -, v0 layout=L1 fields=[0]
    v7 = NewObject -, v0 layout=L2 fields=[0]
    SetLiteralPrototype v7, v6
    v9 = FinishObject v7
    v10 = ElemGet v9, v3
    v11 = Builtin builtin=ObjectFreeze
    v12 = Call v11, -, v10
    v13 = NewObject -, v0 layout=L3 fields=[0]
    v14 = NewClosure function=f1
    DefineGetter v13, v14 key="leak"
    v16 = FinishObject v13
    v17 = ElemGet v16, v3
    v18 = NewObject -, v0 layout=L4 fields=[0]
    v19 = PropGet v1 key="imported" [isFreeName]
    SetLiteralPrototype v18, v19
    v21 = FinishObject v18
    v22 = ElemGet v21, v3
    Return
}
function f1 name="leak" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
