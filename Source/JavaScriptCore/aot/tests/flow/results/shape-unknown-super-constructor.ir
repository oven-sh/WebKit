# A class with a proven base whose class object gets another prototype nobody knows: super() may run a constructor nobody sees, so what that SuperConstruct allocates may lose its shape. A sibling whose class object is left alone keeps it, and so does what `new` without a new.target allocates for a constructor function beside an unknown callee
# RUN: flow
# RUN(KEPT): flow
# RUN(OWN): flow
# CHECK: class [[fromUnknown]] layout=L1 {{*}}cause=UnknownCallee witness={function=f2 value=v3}
# CHECK: layout L1 flow={baseState=Layout base=L0
# CHECK-NOT: LoseShape
# CHECK: layout L2
# KEPT: class [[kept]] layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}LoseShape]
# KEPT: layout L2 flow={baseState=Layout base=L0 members=[L2]
# KEPT-NOT: cause=
# KEPT: layout L3
# OWN: class [[made]] layout=L3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}LoseShape]
# OWN: site {{*}} function=f0 layout=L3
# OWN: layout L3 flow={
# OWN-NOT: cause=
# OWN: variable g0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1
layout L1 kind=Instance name="Reparented" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="Kept" predictedBase=L0 constructor=f3 flags=[HasHeritage]
layout L3 kind=Instance name="Made" constructor=f4 flags=[IsConstructorFunction]
variable g0 name="last" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = NewClosure function=f3
    v8 = ResolveHeritage v2
    v9 = NewClass v7, v2, v8 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="otherBase" [isFreeName]
    v13 = Builtin builtin=ObjectSetPrototypeOf
    v14 = Call v13, -, v6, v12
    v15 = Construct v6
    v16 = Construct v10
    v17 = NewClosure function=f4
    v18 = ToBoolean v12
    Branch v18 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v17)
  b2():
    Jump -> next b3(v12)
  b3(v19):
    v20 = Construct v19
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Reparented" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Kept" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f4 name="Made" flags=[HasThis] thisType={type=anything predicted=L3} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
