# A generic version whose derivation does not name its proven version is an error of the proven version
# RUN: flow-validate unlink-version=f5
# CHECK: invalid
# DIAGNOSTIC: FlowVersionMismatch 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1 function=f1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="external" [isFreeName]
    v5 = CallDirect v4 function=f1
    v6 = CallDirect v1 function=f2
    v7 = CallDirect function=f3
    Return
}
function f1 name="both" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    Return v2
}
function f2 name="provenOnly" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    Return v2
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
