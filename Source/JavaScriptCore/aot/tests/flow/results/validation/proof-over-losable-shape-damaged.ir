# The stamp that an object keeps its shape is an error on an allocation whose object reaches unknown JavaScript
# RUN: flow-validate keeps-shape=f0:v2
# CHECK: invalid
# DIAGNOSTIC: FlowProofOverLosableShape 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Kept" fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Escaping" fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Builtin builtin=Function
    v4 = String string="return 1"
    v5 = Construct v3, -, v4
    v6 = Call v5, -, v2
    Return
}
