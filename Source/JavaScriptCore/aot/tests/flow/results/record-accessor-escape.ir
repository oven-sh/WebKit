# nativeCode and a copy run the getter of a record that reaches them, and a getter nothing reads is not reached
# RUN: flow
# RUN(ALL): flow
# CHECK: function f3 reachability=Unreached
# ALL-NOT: function f1 reachability=Unreached
# ALL-NOT: function f2 reachability=Unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Copied" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Unread" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Copy"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    DefineGetter v1, v2 key="x"
    v4 = FinishObject v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="log" [isFreeName]
    v7 = Call v6, -, v4
    v8 = NewObject -, v0 layout=L1 fields=[0]
    v9 = NewClosure function=f2
    DefineGetter v8, v9 key="x"
    v11 = FinishObject v8
    v12 = NewObject layout=L3
    CopyDataProperties v12, v11
    v14 = FinishObject v12
    v15 = NewObject -, v0 layout=L2 fields=[0]
    v16 = NewClosure function=f3
    DefineGetter v15, v16 key="x"
    v18 = FinishObject v15
    v19 = PropGet v18 key="a"
    Return
}
function f1 name="x" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="x" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="x" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
