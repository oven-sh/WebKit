# With pristine instances switched off the allocation classes of built-in instances have no impossible mutation and no pristine part, and classes with a layout or a closure keep theirs
# OPTIONS: disable=flow:PristineInstances
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class C0 builtinClass=Array keys=NeverEnumerated addedKeys=["label"] addedKeysAreComplete=true
# CHECK: class C1 builtinClass=Array keys=NeverEnumerated addedKeysAreComplete=true
# CHECK: class C2 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] keys=NeverEnumerated addedKeysAreComplete=true
# CHECK: class C3 closureFunction=f1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType] keys=NeverEnumerated addedKeysAreComplete=true
# CHECK: class {{*}} builtinClass=Map keys=NeverEnumerated addedKeys=["label"] addedKeysAreComplete=true
# CHECK: class {{*}} builtinClass=Map keys=NeverEnumerated addedKeysAreComplete=true
# CHECK: layout L0 flow={{*}}impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, {{*}}LoseShape] keys=NeverEnumerated addedKeysAreComplete=true ownAccessorsAreComplete=true}
# CHECK: variable g0 type=Map<never, never, proven> written=anything
# CHECK: variable g1 type=Map<never, never, proven> written=anything
# CHECK: variable g2 type=Array<"t", proven> 
# CHECK: variable g3 type=Array<"t", proven> 
# CHECK: variable g4 type=L0 written=anything
# CHECK: variable g5 type=f1 written=anything
# NOWHERE-NOT: builtinClass={{*}}impossibleMutations=
# NOWHERE-NOT: pristine

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="labeledMap" declared={type=anything} initialization=Uninitialized
variable g1 name="plainMap" declared={type=anything} initialization=Uninitialized
variable g2 name="labeledList" declared={type=anything} initialization=Uninitialized
variable g3 name="plainList" declared={type=anything} initialization=Uninitialized
variable g4 name="point" declared={type=anything} initialization=Uninitialized
variable g5 name="closure" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    PutModuleVariable v1 variable=g0
    v3 = String string="t"
    PropSet v1, v3 key="label" mode=Strict
    v5 = Construct v0
    PutModuleVariable v5 variable=g1
    v7 = NewArray v3 contents=anything holes=[]
    PutModuleVariable v7 variable=g2
    PropSet v7, v3 key="label" mode=Strict
    v10 = NewArray v3 contents=anything holes=[]
    PutModuleVariable v10 variable=g3
    v12 = NewObject -, v3 layout=L0 fields=[0]
    PutModuleVariable v12 variable=g4
    v14 = NewClosure function=f1
    PutModuleVariable v14 variable=g5
    Return
}
function f1 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
