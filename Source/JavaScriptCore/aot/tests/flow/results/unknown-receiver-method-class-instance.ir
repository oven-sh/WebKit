    v11 = NewClass v10 layout=L2
    v12 = FinishClass v11 layout=L2
    v13 = Construct v12
    v14 = Call v2, -, v13
    v15 = PropGet v1 key="input" [isFreeName]
    v16 = String string="value"
    v17 = NewClosure function=f2
    v18 = PropGet v15 key="__defineGetter__"
    v19 = Call v18, v15, v16, v17 calleeKey="__defineGetter__"
    Return
}
