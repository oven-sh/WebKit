    v16 = Construct v15
    v17 = NewClosure function=f10
    v18 = ResolveHeritage v15
    v19 = NewClass v17, v15, v18 layout=L3
    v20 = FinishClass v19 layout=L3
    PutModuleVariable v20 variable=g1
    v22 = Construct v20
    v23 = NewClosure function=f11
    v24 = ResolveHeritage v15
    v25 = NewClass v23, v15, v24 layout=L4
    v26 = FinishClass v25 layout=L4
    PutModuleVariable v26 variable=g2
    v28 = Construct v26
    v29 = PropGet v28 key="onClick"
    v30 = Call v29, v28 calleeKey="onClick"
