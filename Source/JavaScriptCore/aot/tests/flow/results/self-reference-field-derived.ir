# A read of a field that comes before the store of a self reference only sees the field absent. A read that comes after it, in the constructor of a subclass too, is where this leaks
# RUN: flow
# CHECK: layout L1 flow={{*}} thisLeak=DoesNotLeak
# CHECK: field L1.0 "x" type=1 {{*}} occupancy=AlwaysFilled
# CHECK: field L1.1 "onClick" type=undefined|f5
# CHECK-NOT: occupancy=
# CHECK: field L1.2 "y" type=2 {{*}} occupancy=AlwaysFilled
# CHECK: layout L2 flow={{*}} thisLeak=DoesNotLeak
# CHECK: field L2.0 "onClick" type=f9 {{*}} occupancy=AlwaysFilled
# CHECK: layout L3 flow={
# CHECK-NOT: fieldCreation=
# CHECK-NOT: thisLeak=
# CHECK: field L3.0 "y" type=undefined|2
# CHECK-NOT: occupancy=
# CHECK: layout L4 flow={{*}} thisLeak=DoesNotLeak
# CHECK: field L4.0 "y" type=2 {{*}} occupancy=AlwaysFilled

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="ReadEarly" module=m0 declared={type=function} initialization=Uninitialized
variable g1 name="ReadsInherited" module=m0 declared={type=function} initialization=Uninitialized
variable g2 name="StoresAfterSuper" module=m0 declared={type=function} initialization=Uninitialized
layout L0 kind=Instance name="Base" constructor=f1
