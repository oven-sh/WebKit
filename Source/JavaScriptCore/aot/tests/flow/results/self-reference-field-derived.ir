layout L2 kind=Instance name="Handlers" constructor=f7 fields=[{key="onClick" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="ReadsInherited" predictedBase=L2 constructor=f10 fields=[{key="y" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
layout L4 kind=Instance name="StoresAfterSuper" predictedBase=L2 constructor=f11 fields=[{key="y" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
