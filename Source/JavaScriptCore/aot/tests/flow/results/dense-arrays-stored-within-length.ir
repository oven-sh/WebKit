# A store under a key that was found below a length of the same array, or that is such a length, makes no hole in an array that never gets shorter. Each case stands beside one that differs in the one thing that costs the proof
# OPTIONS: check=FlowFixpoint
# RUN: flow
# LOSS: MaxFlowRangeGrowth f0
# CHECK: variable g0 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g1 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g2 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g3 type=Array<{{*}}, proven, pristine[Storage, Dense]> 
# CHECK: variable g4 type=Array<{{*}}, proven, pristine[Storage]> 
# CHECK: variable g5 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g6 type=Array<{{*}}, proven, pristine[Storage, Names]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="belowItsLength" declared={type=anything} initialization=Uninitialized
variable g1 name="belowItsLengthAndPopped" declared={type=anything} initialization=Uninitialized
variable g2 name="belowTheLengthOfAnother" declared={type=anything} initialization=Uninitialized
variable g3 name="atItsLength" declared={type=anything} initialization=Uninitialized
variable g4 name="aboveItsLength" declared={type=anything} initialization=Uninitialized
variable g5 name="notAtOrAboveItsLength" declared={type=anything} initialization=Uninitialized
variable g6 name="onTheOtherEdge" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=0
    v2 = NewArray v0, v0 contents=anything
    PutModuleVariable v2 variable=g0
    v4 = NewArray v0, v0 contents=anything
    PutModuleVariable v4 variable=g1
    v6 = PropGet v4 key="pop"
    v7 = Call v6, v4
    v8 = NewArray v0, v0 contents=anything
    PutModuleVariable v8 variable=g2
    v10 = NewArray v0, v0 contents=anything
    PutModuleVariable v10 variable=g3
    v12 = PropGet v10 key="length"
    ElemSet v10, v12, v0 mode=Strict
    v14 = NewArray v0, v0 contents=anything
    PutModuleVariable v14 variable=g4
    v16 = PropGet v14 key="length"
    v17 = Increment v16
    ElemSet v14, v17, v0 mode=Strict
    v19 = NewArray v0, v0 contents=anything
    PutModuleVariable v19 variable=g5
    v21 = NewArray v0, v0 contents=anything
    PutModuleVariable v21 variable=g6
    Jump -> next b1(v1)
  b1(v23):
    LoopHint
    v25 = PropGet v2 key="length"
    v26 = Less v23, v25
    Branch v26 -> taken b2(| 0), notTaken b9()
  b2(v27):
    ElemSet v2, v27, v0 mode=Strict
    ElemSet v8, v27, v0 mode=Strict
    v30 = PropGet v4 key="length"
    v31 = Less v27, v30
    Branch v31 -> taken b3(| 0), notTaken b4()
  b3(v32):
    ElemSet v4, v32, v0 mode=Strict
    Jump -> next b4()
  b4():
    v34 = PropGet v19 key="length"
    v35 = GreaterEq v27, v34
    Branch v35 -> taken b6(), notTaken b5()
  b5():
    ElemSet v19, v27, v0 mode=Strict
    Jump -> next b6()
  b6():
    v37 = PropGet v21 key="length"
    v38 = Less v27, v37
    Branch v38 -> taken b8(), notTaken b7()
  b7():
    ElemSet v21, v27, v0 mode=Strict
    Jump -> next b8()
  b8():
    v40 = Increment v27
    Jump -> next b1(v40)
  b9():
    Return
}
