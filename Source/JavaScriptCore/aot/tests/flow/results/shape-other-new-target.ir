# A constructor that runs with an unrelated class as new.target creates an object with the prototype of that class: its own objects keep their shape and may have another prototype
# RUN: flow
# RUN(OTHER): flow
# CHECK: class [[constructed]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: class [[plain]] layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: layout L0 flow={
# CHECK-NOT: cause=
# CHECK: field L0.0
# CHECK: layout L2 flow={
# CHECK-NOT: cause=
# CHECK: field L2.0
# CHECK: variable g2 type=L2 written=anything
# OTHER: class [[derived]] layout=L1 {{*}}cause=OtherNewTarget witness={function=f0 value=v9}
# OTHER: site [[site]] function=f1 layout=L1
# OTHER: layout L1 flow={{*}}cause=OtherNewTarget witness={function=f0 value=v9}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Constructed" constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Unrelated" constructor=f2
layout L2 kind=Instance name="Plain" constructor=f3 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="ConstructedByBuiltin" constructor=f4 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="withOtherNewTarget" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="constructed" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="plain" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = NewClosure function=f3
    v7 = NewClass v6 layout=L2
    v8 = FinishClass v7 layout=L2
    v9 = Construct v2, v5
    PutModuleVariable v9 variable=g0
    v11 = Construct v2
    PutModuleVariable v11 variable=g1
    v13 = Construct v8
    PutModuleVariable v13 variable=g2
    v15 = NewClosure function=f4
    v16 = NewClass v15 layout=L3
    v17 = FinishClass v16 layout=L3
    v18 = Builtin builtin=ReflectConstruct
    v19 = NewArray contents=anything holes=[]
    v20 = Call v18, -, v17, v19, v5
    v21 = Construct v17
    Return
}
function f1 name="Constructed" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f2 name="Unrelated" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f4 name="ConstructedByBuiltin" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
