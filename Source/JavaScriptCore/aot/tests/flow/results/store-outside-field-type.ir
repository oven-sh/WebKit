# An untyped store by name of a value outside the type of a field as read costs that field, the object keeps its shape, and a store inside the type costs nothing
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, LoseShape]
# CHECK-NOT: cause=
# CHECK: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: layout L0 flow={
# CHECK-NOT: cause=
# CHECK: field L0.0 "n" {{*}}cause=StoreOfOtherType witness={function=f1 value=v2}}{{*}}stability=[IsNeverDeleted, IsNeverRedefined]}
# CHECK: field L1.0 "n" type=1 written=number {{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: variable g0 type=1|"text" written=anything
# CHECK: variable g1 type=1 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Overwritten" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
variable g0 name="fromOverwritten" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="fromKept" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="text"
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = CallDirect v2, v1 function=f1
    v5 = CallDirect v3, v0 function=f2
    v6 = PropGet v2 key="n"
    PutModuleVariable v6 variable=g0
    v8 = PropGet v3 key="n"
    PutModuleVariable v8 variable=g1
    Return
}
function f1 name="storeText" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="n" mode=Strict
    Return
}
function f2 name="storeInteger" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="n" mode=Strict
    Return
}
