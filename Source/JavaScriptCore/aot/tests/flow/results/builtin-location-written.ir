# A write in reached code costs the one location it names, a write in a function nobody reaches costs nothing
# RUN: flow
# STATISTIC: FlowWrittenBuiltinLocations = 1
# CHECK: function f2 reachability=Unreached
# CHECK: builtin-location GlobalThis."Date" Constant
# CHECK: builtin-location Date."now" Unknown written at f0:v3
# CHECK: builtin-location Date."parse" Constant
# CHECK-NOT: written at

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Date" [isFreeName]
    v2 = NewClosure function=f1
    PropSet v1, v2 key="now" mode=Strict
    v4 = PropGet v1 key="parse"
    v5 = NewClosure function=f2
    Return
}
function f1 name="fixedTime" results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    Return v0
}
function f2 name="neverCalled" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Date" [isFreeName]
    v2 = NewClosure function=f1
    PropSet v1, v2 key="parse" mode=Strict
    Return
}
