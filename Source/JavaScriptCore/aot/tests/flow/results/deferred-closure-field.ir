    v13 = NewClosure function=f6
    v14 = NewObject -, v13 layout=L3 fields=[0]
    v15 = NewClosure function=f7
    v16 = NewObject -, v15 layout=L3 fields=[0]
    v17 = Integer integer=1
    v18 = NewObject -, v17 layout=L8 fields=[0]
    v19 = NewClosure v18 function=f8
    v20 = NewObject -, v19 layout=L4 fields=[0]
    v21 = NewClosure function=f6
    v22 = NewObject -, v21 layout=L5 fields=[0]
    PutModuleVariable v21 variable=g0
    v24 = NewClosure function=f6
    v25 = NewObject -, v24 layout=L6 fields=[0]
    v26 = NewObject layout=L6 fields=[]
    v27 = NewClosure function=f6
    v28 = NewObject -, v27 layout=L7 fields=[0]
    v29 = Builtin builtin=GlobalThis
    v30 = PropGet v29 key="text" [isFreeName]
    v31 = Builtin builtin=Function
    v32 = Construct v31, -, v30
    v33 = Call v32, -, v28
    v34 = NewClosure function=f9
    v35 = NewClass v34 layout=L9
    v36 = FinishClass v35 layout=L9
    v37 = Construct v36
    v38 = NewClosure function=f6
    v39 = NewObject -, v38 layout=L10 fields=[0]
    v40 = Call v32, -, v39
    v41 = NewClosure function=f7
    PropSet v39, v41 key="handler" mode=Strict
    Return
}
function f1 name="Widget" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    v4 = ToBoolean v1
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = NewClosure v3 function=f2
    PropSet v3, v5 key="conditional" mode=Strict
    Jump -> next b2()
  b2():
    v7 = Upcast v3 castType=undefined|null|object
    v8 = NewClosure v7 function=f2
    PropSet v3, v8 key="handler" mode=Strict
    Return v3
}
function f2 name="handler" kind=Arrow captures=[{type=undefined|null|L0}] results=[{type=anything}] {
