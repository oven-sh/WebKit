function f9 name="StoredCapturesEnvironment" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L9
    v2 = NewObject v1 layout=L9 fields=[]
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L8 fields=[0]
    v5 = NewClosure v4 function=f8
