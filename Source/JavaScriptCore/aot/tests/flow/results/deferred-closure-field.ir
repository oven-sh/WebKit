# A field defers its closure when every object gets a closure of its own there at creation, all of one function, and the closure captures nothing or only the object
# RUN: flow
# STATISTIC: FlowDeferredClosureFields = 4
# CHECK: field L0.0 "handler" type=f2 {{*}}location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation deferral=CapturesObject deferredFunction=f2}
# CHECK: field L0.1 "conditional" {{*}}location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}
# CHECK: field L1.0 "handler" type=f5 {{*}}initialization=SetAtCreation reads=NeverRead deferral=CapturesObject deferredFunction=f5}
# CHECK: field L2.0 "handler" type=f6 {{*}}initialization=SetAtCreation reads=NeverRead deferral=CapturesNothing deferredFunction=f6 isUnchangedDuringActivation=true}
# CHECK: field L3.0 "handler" type=f6|f7 {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: field L4.0 "handler" type=f8 {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: field L5.0 "handler" type=f6 {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: field L6.0 "handler" type=undefined|f6 {{*}}location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead reads=NeverRead isUnchangedDuringActivation=true}
# What unknown code does to the object is no obstacle: the slot takes a later cell, and anything else makes that object an ordinary one
# CHECK: field L7.0 "handler" type=anything {{*}}location={initialization=SetAtCreation deferral=CapturesNothing deferredFunction=f6 mayKeepObservedObjectAlive=true cause=UnknownWriter
# CHECK: field L9.0 "handler" type=f8 {{*}}location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead}
# A store of seen code that names the field is one: nothing is emitted for a store into such a slot
# CHECK: field L10.0 "handler" type=anything {{*}}location={initialization=SetAtCreation mayKeepObservedObjectAlive=true cause=UnknownWriter

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance name="Widget" constructor=f1 fields=[{key="handler" declared={type=anything} flags=[IsRequired]}, {key="conditional" declared={type=anything}}]
layout L1 kind=Instance name="Panel" constructor=f3 fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L2 name="CapturesNothing" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L3 name="TwoFunctions" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L4 name="CapturesEnvironment" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L5 name="ClosureUsedTwice" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L6 name="SometimesAbsent" fields=[{key="handler" declared={type=anything}}]
layout L7 name="ReachesUnknownJavaScript" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L8 kind=Environment name="scope" fields=[{key="count" declared={type=anything}}]
layout L9 kind=Instance name="StoredCapturesEnvironment" constructor=f9 fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L10 name="ReachesUnknownJavaScriptAndIsStoredByName" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Boolean boolean=true
    v4 = Construct v2, -, v3
    v5 = PropGet v4 key="handler"
