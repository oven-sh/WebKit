# Every evaluation of a class allocates the layout of the class, so the instances of a class whose definition can run twice keep their shape, and so do those of a subclass of it. What belongs to one evaluation stays unproven. A class whose base differs from one evaluation to the next loses the shape
# RUN: flow
# CHECK: class [[inFunction]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: class [[topLevel]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: class [[derived]] layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: class [[overParameter]] layout=L3 {{*}}cause=UnknownBase
# CHECK: layout L0 flow={
# CHECK-NOT: cause=
# CHECK-NOT: evaluations=
# CHECK: layout L1 flow={
# CHECK-NOT: cause=
# CHECK: classFlow={evaluations=AtMostOnce
# CHECK: layout L2 flow={baseState=Layout base=L0
# CHECK-NOT: cause=
# CHECK: classFlow={evaluations=AtMostOnce
# CHECK: layout L3 flow={{*}}cause=UnknownBase
# CHECK-NOT: evaluations=
# CHECK: layout L4 flow={
# CHECK: variable g0 type=L0|L2 written=anything
# CHECK: variable g1 type=L1 written=anything
# CHECK: variable g2 type=L0|L2 written=anything
# CHECK: variable g3 type=object {{*}}cause=UnknownBase

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="InFunction" constructor=f2
layout L1 kind=Instance name="TopLevel" constructor=f3
layout L2 kind=Instance name="Derived" predictedBase=L0 constructor=f4 flags=[HasHeritage]
layout L3 kind=Instance name="OverParameter" constructor=f6 flags=[HasHeritage]
layout L4 kind=Instance name="FirstBase" constructor=f7
layout L5 kind=Instance name="SecondBase" constructor=f8
variable g0 name="inFunction" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="topLevel" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="derived" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="overParameter" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f1
    v2 = Construct v0
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    PutModuleVariable v7 variable=g1
    v9 = NewClosure function=f4
    v10 = ResolveHeritage v0
    v11 = NewClass v9, v0, v10 layout=L2
    v12 = FinishClass v11 layout=L2
    v13 = Construct v12
    PutModuleVariable v13 variable=g2
    v15 = NewClosure function=f7
    v16 = NewClass v15 layout=L4
    v17 = FinishClass v16 layout=L4
    v18 = NewClosure function=f8
    v19 = NewClass v18 layout=L5
    v20 = FinishClass v19 layout=L5
    v21 = CallDirect v17 function=f5
    v22 = CallDirect v20 function=f5
    v23 = Construct v21
    PutModuleVariable v23 variable=g3
    v25 = Construct v22
    PutModuleVariable v25 variable=g3
    Return
}
function f1 name="makeClass" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    Return v2
}
function f2 name="InFunction" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f3 name="TopLevel" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f5 name="mixin" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f6
    v2 = ResolveHeritage v0
    v3 = NewClass v1, v0, v2 layout=L3
    v4 = FinishClass v3 layout=L3
    Return v4
}
function f6 name="OverParameter" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L3
    Return v3
}
function f7 name="FirstBase" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L4
    v2 = NewObject v1 layout=L4 fields=[]
    Return v2
}
function f8 name="SecondBase" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L5
    v2 = NewObject v1 layout=L5 fields=[]
    Return v2
}
