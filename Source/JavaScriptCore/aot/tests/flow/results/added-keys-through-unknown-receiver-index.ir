# A store through an unknown receiver under an array index gives every escaped object an index key: it may get a property, and the list of added names stays complete, because an index is no name
# RUN: flow
# OPTIONS: disable=flow:AppendedFields
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, {{*}}LoseShape] addedKeysAreComplete=true
# CHECK: layout L0 flow={baseState=None {{*}}addedKeysAreComplete=true ownAccessorsAreComplete=true}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="escaped" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = Call v4, -, v1
    v6 = PropGet v3 key="input" [isFreeName]
    ElemSet v6, v0, v0 mode=Strict
    Return
}
