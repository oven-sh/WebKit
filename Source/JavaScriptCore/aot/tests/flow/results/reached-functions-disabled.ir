# With reached functions switched off a function no reached code enters keeps its body, no function has a reachability, and the program counts as one that may run unseen code
# OPTIONS: disable=flow:ReachedFunctions
# RUN: flow
# RUN(NOWHERE): flow
# RUN(APPLY): flow-apply
# STATISTIC: FlowUnreachedFunctions = 0
# CHECK: function f1 callers=AllKnown executions=AtMostOnce closureUse=CalledOnly
# CHECK-NEXT: function f2 callers=AllKnown closureUse=CalledOnly
# CHECK: unseen-code FlowResultDisabled
# CHECK: variable g0 type=1 written=anything flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
# CHECK: function f1 result 0 type=1 written=anything
# NOWHERE-NOT: reachability=
# APPLY-LABEL: function f1 name="reader"
# APPLY: GetModuleVariable variable=g0
# APPLY-LABEL: function f2 name="unreached"
# APPLY: b0():
# APPLY-NEXT: String string="dropped"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="narrow" declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v2
    Return
}
function f1 name="reader" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f2 name="unreached" results=[{type=anything}] {
  b0():
    v0 = String string="dropped"
    PutModuleVariable v0 variable=g0
    Return
}
