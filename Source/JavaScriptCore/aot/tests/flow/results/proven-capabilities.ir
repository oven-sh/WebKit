# A function that only direct calls enter gets both proven capabilities, one that is also called by value only the second, one that nativeCode or the host can call keeps what its role gives
# RUN: flow
# RUN(NOWHERE): flow
# RUN(APPLY): flow-apply
# CHECK: function f1 callers=AllKnown
# CHECK: function f2 callers=AllKnown
# CHECK: function f3 cause=ReachesNativeCode witness={function=f0 value=v8}
# CHECK: function f1 capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost]
# CHECK: function f2 capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost]
# CHECK: function f4 capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost]
# NOWHERE-NOT: function f3 callers=
# NOWHERE-NOT: function f3 capabilities=
# NOWHERE-NOT: function f5 capabilities=
# APPLY: function f1 name="calledDirectly" {{*}}HasOnlyDirectCallers, IsNeverCalledByHost]
# APPLY: function f2 name="calledByValue" {{*}}HasOrdinaryFrame, IsNeverCalledByHost]
# APPLY: function f3 name="handedOut" {{*}}HasOrdinaryFrame, IsNeverCalledByHost]
# APPLY: function f4 name="libraryHelper" {{*}}capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost]
# APPLY: function f5 name="library" {{*}}capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f1
    v2 = CallDirect function=f2
    v3 = NewClosure function=f2
    v4 = Call v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = NewClosure function=f3
    v8 = Call v6, -, v7
    v9 = CallDirect function=f3
    v10 = CallDirect function=f4
    Return
}
function f1 name="calledDirectly" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="calledByValue" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="handedOut" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="libraryHelper" role=Library results=[{type=anything}] {
  b0():
    Return
}
