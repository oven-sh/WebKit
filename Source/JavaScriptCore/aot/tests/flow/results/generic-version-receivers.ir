# Any call may enter a generic version, also one that flow linked to the proven version, so the receivers of its accesses list the layouts of the proven callers beside the unknown objects
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# CHECK-LABEL: function f1 name="both"
# CHECK: = PropGet v0 key="x" {{*}}receivers=[L0]
# CHECK: = PropGet v0 key="y" {{*}}receivers=[L0]
# CHECK-LABEL: function f2 name="provenOnly"
# CHECK: = PropGet v0 key="x" {{*}}receivers=[L1]
# CHECK-LABEL: name="both" {{*}}role=GenericVersion
# CHECK: = PropGet v0 key="x" {{*}}receivers=[L0, ..]
# CHECK: = PropGet v0 key="y" {{*}}receivers=[L0, ..]
# CHECK: = NewObject {{*}}layout=L2
# CHECK: = PropGet {{*}} key="z" {{*}}receivers=[L2]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Other" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Local" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1 function=f1
    v3 = NewClosure function=f1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v3
    v7 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v8 = CallDirect v7 function=f2
    v9 = CallDirect function=f3
    Return
}
function f1 name="both" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = NewObject -, v1 layout=L2 fields=[0]
    v4 = PropGet v3 key="z"
    Return v2
}
function f2 name="provenOnly" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    Return v2
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
    v51 = Undefined
    v52 = Undefined
    v53 = Undefined
    v54 = Undefined
    v55 = Undefined
    v56 = Undefined
    v57 = Undefined
    v58 = Undefined
    v59 = Undefined
    Return
}
