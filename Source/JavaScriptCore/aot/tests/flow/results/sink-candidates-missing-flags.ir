# Flags that are not passed are a complete empty list that may be undefined, flags that are undefined or one literal list the literal, and flags that are always a literal cannot be undefined
# RUN: flow
# CHECK: sink [[missing]] operand 0 ["a+"] complete
# CHECK-NEXT: sink [[missing]] operand 1 [] mayBeUndefined complete
# CHECK-NEXT: sink [[either]] operand 0 ["a+"] complete
# CHECK-NEXT: sink [[either]] operand 1 ["g"] mayBeUndefined complete
# CHECK-NEXT: sink [[always]] operand 0 ["a+"] complete
# CHECK-NEXT: sink [[always]] operand 1 ["g"] complete
# CHECK-NOT: sink

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToBoolean v1
    v3 = String string="a+"
    v4 = String string="g"
    v5 = Undefined
    v6 = Builtin builtin=RegExp
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4)
  b2():
    Jump -> next b3(v5)
  b3(v7):
    v8 = Construct v6, -, v3
    v9 = Construct v6, -, v3, v7
    v10 = Construct v6, -, v3, v4
    Return
}
