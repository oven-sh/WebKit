# The allocation in a base constructor that also runs for a subclass is assumed to have one of both layouts; run for its own class alone it keeps its shape; run for an unrelated class the allocation proves no shape
# RUN: flow-apply
# RUN(FLOW): flow
# RUN(FLOW2): flow
# RUN(FLOW3): flow
# RUN(FLOW4): flow
# RUN(FLOW5): flow
# RUN(FLOW6): flow
# RUN(FLOW7): flow
# CHECK-LABEL: function f1 name="A"
# CHECK: v2: {{*}} = NewObject v1 layout=L0 allocationSite=
# CHECK-NEXT: [[both]]: L0|L1 {{*}}= AssumeType v2 castType=L0|L1
# CHECK-NEXT: Return [[both]]
# CHECK-LABEL: function f2 name="B"
# CHECK-LABEL: function f3 name="Alone"
# CHECK: v2: L2 = NewObject v1 layout=L2 {{*}}[keepsShape]
# CHECK-NEXT: Return v2
# CHECK-LABEL: function f4 name="Host"
# CHECK-NOT: keepsShape
# CHECK-NOT: AssumeType v2
# CHECK-LABEL: function f5 name="Unrelated"
# RUN(NOWHERE): flow-apply
# NOWHERE-NOT: NewObject v1 layout=L0 {{*}}keepsShape
# FLOW: class [[own]] layout=L0 impossibleMutations=[{{*}}LoseShape]
# FLOW2: class [[alone]] layout=L2 impossibleMutations=[{{*}}LoseShape]
# FLOW3: class [[derived]] layout=L1 impossibleMutations=[{{*}}LoseShape]
# FLOW4: class [[unrelated]] layout=L4 {{*}}cause=OtherNewTarget witness={function=f0 value=v19}
# FLOW5: site {{*}} function=f1 layout=L0 allocationClass=
# FLOW6: site {{*}} function=f1 layout=L1 allocationClass=
# FLOW7: site {{*}} function=f4 layout=L4 allocationClass=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="Alone" constructor=f3
layout L3 kind=Instance name="Host" constructor=f4
layout L4 kind=Instance name="Unrelated" constructor=f5
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = NewClosure function=f3
    v8 = NewClass v7 layout=L2
    v9 = FinishClass v8 layout=L2
    v10 = NewClosure function=f4
    v11 = NewClass v10 layout=L3
    v12 = FinishClass v11 layout=L3
    v13 = NewClosure function=f5
    v14 = NewClass v13 layout=L4
    v15 = FinishClass v14 layout=L4
    v16 = Construct v2
    v17 = Construct v6
    v18 = Construct v9
    v19 = Construct v12, v15
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Alone" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f4 name="Host" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
function f5 name="Unrelated" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L4
    v2 = NewObject v1 layout=L4
    Return v2
}
