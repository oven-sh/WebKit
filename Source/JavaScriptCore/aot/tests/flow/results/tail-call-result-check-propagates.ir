# A typed function that tail calls a function whose callers test its result, on the same cycle of required tail calls, leaves the test to its own callers as well
# RUN: flow-apply
# RUN(FLOW): flow
# STATISTIC: FlowGenericVersions = 1
# STATISTIC: ReturnCallsDemoted = 1
# FLOW: function f1 {{*}}resultCheck=ByCallers
# FLOW-NOT: resultCheck=
# FLOW: function f3 {{*}}resultCheck=ByCallers
# FLOW-NOT: resultCheck=

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Result
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="pair" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="tested" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    PutModuleVariable v3 variable=g1
    v5 = CallDirect function=f1
    v6 = CallDirect v1 function=f3
    v7 = CallDirect function=f4
    v8 = NewClosure function=f3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="register" [isFreeName]
    v11 = Call v10, -, v8
    v12 = CallDirect function=f6
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[first]]: anything ~ number = CallDirect function=f1 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: = Claim [[first]] castType=number site=w0 cause=MayFail
# CHECK-NEXT: [[second]]: anything ~ number = CallDirect v1 function=f3 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: = Claim [[second]] castType=number site=w1 cause=MayFail
# CHECK-NEXT: = CallDirect function=f4 accessSite=
# CHECK-NOT: resultCheck=
# CHECK-NOT: Claim
function f1 name="tested" flags=[IsChecked] results=[{type=number site=w0}] {
  b0():
    v0 = CallDirect function=f2
    ReturnCall v0 casts=[{declared={type=number site=w0}}]
}
# CHECK-LABEL: function f1 name="tested"
# CHECK: ReturnCall v0
# CHECK-NOT: casts=
# CHECK-NOT: requirement=Allowed
function f2 name="untyped" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="outside" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v3 = PropGet v0 key="first" [isFreeName]
    v4 = ToBoolean v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = GetModuleVariable variable=g0
    v6 = CallDirect v5 function=f3
    ReturnCall v6
  b4():
    v7 = PropGet v0 key="second" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    v9 = CallDirect function=f4
    ReturnCall v9
  b6():
    v10 = CallDirect function=f5
    ReturnCall v10
}
# CHECK-LABEL: function f2 name="untyped"
# CHECK: = CallDirect {{*}} function=f3 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: ReturnCall v6
# CHECK-NOT: Claim
# CHECK-NOT: requirement=Allowed
# CHECK: ReturnCall v9
# CHECK-NOT: requirement=Allowed
# CHECK: ReturnCall v10 requirement=Allowed
function f3 name="typedCaller" flags=[IsChecked] parameters=[{type=anything}] results=[{type=number site=w1}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = CallDirect function=f1
    ReturnCall v3 casts=[{declared={type=number site=w1}}]
}
# CHECK-LABEL: function f3 name="typedCaller"
# CHECK: b0(v0: L0):
# CHECK: v3: anything ~ number = CallDirect function=f1 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: ReturnCall v3
# CHECK-NOT: Claim
# CHECK-NOT: requirement=Allowed
function f4 name="untypedCaller" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    ReturnCall v0
}
# CHECK-LABEL: function f4 name="untypedCaller"
# CHECK: = CallDirect function=f1 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: ReturnCall v0
# CHECK-NOT: Claim
# CHECK-NOT: requirement=Allowed
function f5 name="throughBuiltin" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = PropGet v0 key="apply"
    v2 = Null
    v3 = Call v1, v0, v2
    ReturnCall v3
}
# CHECK-LABEL: function f5 name="throughBuiltin"
# CHECK: ReturnCall v3 requirement=Allowed
function f6 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
    v51 = Undefined
    v52 = Undefined
    v53 = Undefined
    v54 = Undefined
    v55 = Undefined
    v56 = Undefined
    v57 = Undefined
    v58 = Undefined
    v59 = Undefined
    Return
}
# CHECK-LABEL: function f6 name="padding"
# CHECK-LABEL: name="typedCaller" {{*}}role=GenericVersion
# CHECK: [[call]]: anything ~ number = CallDirect function=f1 accessSite={{*}} resultCheck=ByCallers
# CHECK-NEXT: [[claim]]: number = Claim [[call]] castType=number site=w0 cause=MayFail
# CHECK-NEXT: Return [[claim]]
# CHECK-NOT: ReturnCall
