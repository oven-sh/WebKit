# A factory that picks a closure by a constant argument gives both closures at each call, never a wrong single one
# RUN: flow
# CHECK: variable g0 type=f2|f3 written=anything
# CHECK: variable g1 type=f2|f3 written=anything
# CHECK: variable g2 type=int[1, 2] written=anything
# CHECK: function f1 result 0 type=f2|f3 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="first" declared={type=anything} initialization=Uninitialized
variable g1 name="second" declared={type=anything} initialization=Uninitialized
variable g2 name="called" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = CallDirect v0 function=f1
    PutModuleVariable v1 variable=g0
    v3 = String string="b"
    v4 = CallDirect v3 function=f1
    PutModuleVariable v4 variable=g1
    v6 = GetModuleVariable variable=g0
    v7 = Call v6
    PutModuleVariable v7 variable=g2
    Return
}
function f1 name="pick" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewClosure function=f2
    Return v3
  b2():
    v4 = NewClosure function=f3
    Return v4
}
function f2 name="left" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="right" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
