# An access by name on an unknown receiver finds the instance members of that name of every built-in class: a call uses their features with the operands of that call, a read that escapes uses them, a test uses none
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use ArrayPrototypeFlat [Read, Called{{*}}] f0:v2
# CHECK: builtin-use DatePrototypeToLocaleDateString [Read, Called] f0:v4
# CHECK: builtin-use StringPrototypePadStart [Read, {{*}}Escaped] f0:v7
# CHECK: builtin-use StringPrototypeRepeat [Tested]
# CHECK: feature 11 DatePrototypeToLocaleDateString f0:v4
# CHECK: feature 33 ArrayPrototypeFlat f0:v2
# CHECK: feature 48 StringPrototypePadStart f0:v7
# CHECK: locale Constant "de" f0:v6
# ALL-NOT: builtin-use ArrayPrototypeWith
# ALL-NOT: builtin-use DatePrototypeToLocaleTimeString
# ALL-NOT: builtin-use StringPrototypePadEnd
# ALL-NOT: feature 1 Function
# ALL-NOT: feature 49
# ALL-NOT: locale Unknown
# ALL-NOT: locale HostDefault

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v1 key="flat"
    v3 = Call v2, v1 calleeKey="flat"
    v4 = PropGet v1 key="toLocaleDateString"
    v5 = String string="de"
    v6 = Call v4, v1, v5 calleeKey="toLocaleDateString"
    v7 = PropGet v1 key="padStart"
    v8 = PropGet v0 key="keep" [isFreeName]
    v9 = Call v8, -, v7
    v10 = PropGet v1 key="repeat" [isForTypeOf]
    v11 = TypeOf v10
    Return
}
