# An array is dense when its creator fills every index below the length and nothing that reaches it can make a hole. Each dense array stands beside one that differs in the one thing that costs the proof
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK: variable g0 type=Array<1, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g1 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g2 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g3 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g4 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g5 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g6 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g7 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g8 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g9 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g10 type=Array<{{*}}, proven, pristine[Storage, Names]> 
# CHECK: variable g11 type=Array<{{*}}, proven, pristine[Storage, Names, Dense]> 
# CHECK: variable g12 type=Array<{{*}}, proven, pristine[Storage, Names]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="literal" declared={type=anything} initialization=Uninitialized
variable g1 name="literalWithElision" declared={type=anything} initialization=Uninitialized
variable g2 name="pushedPoppedShifted" declared={type=anything} initialization=Uninitialized
variable g3 name="storedUnderIndex" declared={type=anything} initialization=Uninitialized
variable g4 name="appendedTo" declared={type=anything} initialization=Uninitialized
variable g5 name="appendedHole" declared={type=anything} initialization=Uninitialized
variable g6 name="emptied" declared={type=anything} initialization=Uninitialized
variable g7 name="lengthened" declared={type=anything} initialization=Uninitialized
variable g8 name="elementDeleted" declared={type=anything} initialization=Uninitialized
variable g9 name="listOfItems" declared={type=anything} initialization=Uninitialized
variable g10 name="ofLength" declared={type=anything} initialization=Uninitialized
variable g11 name="sliceOfDense" declared={type=anything} initialization=Uninitialized
variable g12 name="sliceOfHoley" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=0
    v2 = NewArray v0 contents=anything
    PutModuleVariable v2 variable=g0
    v4 = NewArray v0 contents=anything holes=[0]
    PutModuleVariable v4 variable=g1
    v6 = NewArray v0, v0 contents=anything
    PutModuleVariable v6 variable=g2
    v8 = PropGet v6 key="push"
    v9 = Call v8, v6, v0
    v10 = PropGet v6 key="pop"
    v11 = Call v10, v6
    v12 = PropGet v6 key="shift"
    v13 = Call v12, v6
    v14 = PropGet v6 key="unshift"
    v15 = Call v14, v6, v0
    v16 = PropGet v6 key="splice"
    v17 = Call v16, v6, v1, v0
    v18 = PropGet v6 key="reverse"
    v19 = Call v18, v6
    v20 = PropGet v6 key="fill"
    v21 = Call v20, v6, v0
    v22 = NewArray v0, v0 contents=anything
    PutModuleVariable v22 variable=g3
    ElemSet v22, v1, v0 mode=Strict
    v25 = NewArray v0 contents=anything
    AppendElement v25, v0
    AppendSpread v25, v4
    PutModuleVariable v25 variable=g4
    v29 = NewArray v0 contents=anything
    AppendHole v29
    PutModuleVariable v29 variable=g5
    v32 = NewArray v0 contents=anything
    PutModuleVariable v32 variable=g6
    PropSet v32, v1 key="length" mode=Strict
    v35 = NewArray v0 contents=anything
    PutModuleVariable v35 variable=g7
    PropSet v35, v0 key="length" mode=Strict
    v38 = NewArray v0 contents=anything
    PutModuleVariable v38 variable=g8
    v40 = ElemDelete v38, v1
    v41 = Builtin builtin=GlobalThis
    v42 = PropGet v41 key="Array" [isFreeName]
    v43 = Construct v42, -, v0, v0
    PutModuleVariable v43 variable=g9
    v45 = Construct v42, -, v0
    PutModuleVariable v45 variable=g10
    v47 = PropGet v2 key="slice"
    v48 = Call v47, v2
    PutModuleVariable v48 variable=g11
    v50 = PropGet v4 key="slice"
    v51 = Call v50, v4
    PutModuleVariable v51 variable=g12
    Return
}
