# Each function past the work limit leaves one record of unseen code at its declaration, and a function below the limit leaves none
# OPTIONS: limit=MaxFlowWorkPerFunction:24
# RUN: flow
# LOSS: MaxFlowWorkPerFunction f1
# CHECK: unseen-code LimitReached f1
# CHECK-NEXT: unseen-code LimitReached f2
# CHECK-NOT: unseen-code
# RUN(DECLARATION): flow
# DECLARATION-NOT: unseen-code LimitReached f1:
# DECLARATION-NOT: unseen-code LimitReached f2:
# DECLARATION-NOT: unseen-code LimitReached f0
# DECLARATION-NOT: unseen-code LimitReached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = CallDirect function=f3
    Return
}
function f1 name="busy" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = PropGet v4 key="x"
    v6 = PropGet v5 key="x"
    v7 = PropGet v6 key="x"
    v8 = PropGet v7 key="x"
    Return v8
}
function f2 name="busyAsWell" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = PropGet v4 key="x"
    v6 = PropGet v5 key="x"
    v7 = PropGet v6 key="x"
    v8 = PropGet v7 key="x"
    Return v8
}
function f3 name="idle" results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    Return v0
}
