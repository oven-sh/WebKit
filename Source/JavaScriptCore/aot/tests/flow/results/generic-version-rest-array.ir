# function make(pair, ...given) { pair.x; pair.y; return given[0] }   print(make(new Pair(input, input), new Box(input)), make(input, 1))
# Each instance of `make` has a rest array of its own. A pass may send the first call, which flow tracks, into the generic version, so what that version reads from its rest array
# is what any call passes: the box beside the 1. The proven version reads the box alone, and each caller knows what it gets back
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# CHECK-LABEL: function f0 name="main"
# CHECK: [[tracked]]: anything = Call v3, -, v2, v4 accessSite={{*}} callees=[f1]
# CHECK: L1 = AssumeType [[tracked]] castType=L1
# CHECK: [[other]]: anything = Call v3, -, v1, v6 accessSite={{*}} callees=[f4]
# CHECK: 1 = AssumeType [[other]] castType=1
# CHECK-LABEL: function f1 name="make"
# CHECK: L1 = AssumeType v5 castType=L1
# CHECK-LABEL: function f4 name="make" {{*}}role=GenericVersion
# CHECK: = AssumeType v5 castType=1|L1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Box" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    v3 = NewClosure function=f1
    v4 = NewObject -, v1 layout=L1 fields=[0]
    v5 = Call v3, -, v2, v4
    v6 = Integer integer=1
    v7 = Call v3, -, v1, v6
    v8 = CallDirect function=f2
    v9 = PropGet v0 key="print" [isFreeName]
    v10 = Call v9, -, v5, v7
    Return
}
function f1 name="make" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="y"
    v4 = Integer integer=0
    v5 = ElemGet v1, v4
    Return v5
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
    v51 = Undefined
    v52 = Undefined
    v53 = Undefined
    v54 = Undefined
    v55 = Undefined
    v56 = Undefined
    v57 = Undefined
    v58 = Undefined
    v59 = Undefined
    v60 = Undefined
    v61 = Undefined
    v62 = Undefined
    v63 = Undefined
    v64 = Undefined
    v65 = Undefined
    v66 = Undefined
    v67 = Undefined
    v68 = Undefined
    v69 = Undefined
    v70 = Undefined
    v71 = Undefined
    v72 = Undefined
    v73 = Undefined
    v74 = Undefined
    v75 = Undefined
    v76 = Undefined
    v77 = Undefined
    v78 = Undefined
    v79 = Undefined
    Return
}
