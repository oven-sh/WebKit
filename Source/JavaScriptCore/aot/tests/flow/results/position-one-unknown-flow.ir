# APPLY: = PropGet v0 key="x"{{*}}receivers=[L0, ..]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
variable g0 name="origin" declared={type=undefined|null|L0}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    v4 = Call v3, -, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="outside" [isFreeName]
    v7 = NewClosure function=f2
    v8 = Call v7, -, v6
    v9 = Call v7, -, v1
    Return
}
function f1 name="proven" parameters=[{type=undefined|null|L0}] results=[{type=undefined|null|L0}] {
