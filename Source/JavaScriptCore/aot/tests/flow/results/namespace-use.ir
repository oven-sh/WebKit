# The namespace object of a module is never created when bindings alone import the module, and has named reads only until a key that nobody knows, a list of its keys or nativeCode reaches it
# RUN: flow
# RUN(ALL): flow
# CHECK: module m0 namespaceUse=NeverCreated
# CHECK: module m1 namespaceUse=NeverCreated
# CHECK: module m2 namespaceUse=NamedReadsOnly
# ALL-NOT: module m3
# ALL-NOT: module m4
# ALL-NOT: module m5

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}, {target=m3}, {target=m4}, {target=m5}]
module m1 path="bindings.js" displayPath="bindings.js" body=f1 exports=[{name="a" variable=g0}]
module m2 path="named.js" displayPath="named.js" body=f2 exports=[{name="a" variable=g1}]
module m3 path="keyed.js" displayPath="keyed.js" body=f3 exports=[{name="a" variable=g2}]
module m4 path="listed.js" displayPath="listed.js" body=f4 exports=[{name="a" variable=g3}]
module m5 path="escaped.js" displayPath="escaped.js" body=f5 exports=[{name="a" variable=g4}]
entry module=m0
variable g0 name="a" module=m1 declared={type=anything}
variable g1 name="a" module=m2 declared={type=anything}
variable g2 name="a" module=m3 declared={type=anything}
variable g3 name="a" module=m4 declared={type=anything}
variable g4 name="a" module=m5 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ModuleNamespace module=m2
    v2 = PropGet v1 key="a"
    v3 = ModuleNamespace module=m3
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="which" [isFreeName]
    v6 = ToString v5
    v7 = ElemGet v3, v6
    v8 = ModuleNamespace module=m4
    v9 = Builtin builtin=ObjectKeys
    v10 = Call v9, -, v8
    v11 = ModuleNamespace module=m5
    v12 = PropGet v4 key="register" [isFreeName]
    v13 = Call v12, -, v11
    Return
}
function f1 name="bindings" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="named" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
function f3 name="keyed" module=m3 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    Return
}
function f4 name="listed" module=m4 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g3
    Return
}
function f5 name="escaped" module=m5 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g4
    Return
}
