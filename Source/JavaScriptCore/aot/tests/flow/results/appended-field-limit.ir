# A layout gets at most as many appended fields as the limit: the names that most operations mention become fields, the others stay added keys, and another layout at the limit keeps all of its names
# RUN: flow
# RUN(NOWHERE): flow
# OPTIONS: limit=MaxAppendedFieldsPerLayout:2
# LOSS: MaxAppendedFieldsPerLayout x1 L0
# STATISTIC: FlowAppendedFields = 4
# CHECK: class {{*}} layout=L0 {{*}}addedKeys=["first"] addedKeysAreComplete=true
# CHECK: class {{*}} layout=L1 impossibleMutations=[{{*}}AddProperty
# CHECK: field L0.1 "second" type=1 flags=[IsAppendedByFlow]
# CHECK-NEXT: field L0.2 "third" type=1 flags=[IsAppendedByFlow]
# CHECK-NEXT: layout L1 flow={
# CHECK: field L1.1 "second" type=1 flags=[IsAppendedByFlow]
# CHECK-NEXT: field L1.2 "third" type=1 flags=[IsAppendedByFlow]
# NOWHERE-NOT: layout=L0 impossibleMutations=[{{*}}AddProperty
# NOWHERE-NOT: field L0.3
# NOWHERE-NOT: layout=L1 {{*}}addedKeys=[
# NOWHERE-NOT: field L1.3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ThreeNames" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="TwoNames" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v1, v0 key="first" mode=Strict
    PropSet v1, v0 key="second" mode=Strict
    PropSet v1, v0 key="third" mode=Strict
    v5 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v5, v0 key="third" mode=Strict
    PropSet v5, v0 key="second" mode=Strict
    Return
}
