# What resolves a promise is retained by it: an object handed to Promise.resolve does not stay in the frame of its allocation
# RUN: flow
# RUN(ALL): flow
# CHECK: function f1 parameter 0 uses=[Inspects, Retains] 
# CHECK: function f2 parameter 0 uses=[Inspects] 
# CHECK: class C1 layout=L1 {{*}}locality=FrameLocal
# CHECK: variable g0 type=Promise<
# ALL-NOT: class C0 {{*}}locality=FrameLocal

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Kept" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Tested" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
variable g0 name="promise" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = CallDirect v3 function=f2
    Return
}
function f1 name="keep" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Promise
    v2 = Builtin builtin=PromiseResolve
    v3 = Call v2, v1, v0
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="test" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Promise
    v2 = Builtin builtin=PromiseResolve
    v3 = ToBoolean v0
    v4 = Call v2, v1, v3
    PutModuleVariable v4 variable=g0
    Return
}
