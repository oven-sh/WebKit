# A require of a source text module reads the export that gives its result, so only the other exports are never read
# RUN: flow
# CHECK: variable g0
# CHECK-NOT: reads=
# CHECK: variable g1 {{*}}reads=NeverRead
# CHECK: variable g2
# CHECK-NOT: reads=
# CHECK: variable g3 {{*}}reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="value.mjs" displayPath="value.mjs" requireResult=Namespace body=f1 exports=[{name="module.exports" variable=g0}, {name="other" variable=g1}]
module m2 path="default.mjs" displayPath="default.mjs" requireResult=DefaultExport body=f2 exports=[{name="default" variable=g2}, {name="other" variable=g3}]
entry module=m0
variable g0 name="value" module=m1 declared={type=anything}
variable g1 name="other" module=m1 declared={type=anything}
variable g2 name="value" module=m2 declared={type=anything}
variable g3 name="other" module=m2 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1
    v1 = RequireModule module=m2
    Return
}
function f1 name="value" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="default" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    PutModuleVariable v0 variable=g3
    Return
}
