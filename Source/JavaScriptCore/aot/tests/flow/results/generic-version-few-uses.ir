# A parameter with one use gains less than a second copy of the function costs, so the function stands for all its callers, and its neighbor with three uses gets a generic version
# RUN: flow
# RUN(ALL): flow
# LOSS: MinNarrowedUsesForGenericVersion x1 f1
# STATISTIC: FlowGenericVersions = 1
# CHECK: function f1 cause=ReachesNativeCode witness={function=f0 value=v6}
# CHECK: function f2 genericVersion=[[generic]] cause=ReachesNativeCode witness={function=f0 value=v9}
# CHECK: function f1 parameter 0 type=anything predicted={{*}}L0
# CHECK: function f2 parameter 0 type=L0 written=anything
# CHECK: function [[generic]] role=GenericVersion of f2
# ALL-NOT: function f1 genericVersion=
# ALL-NOT: function f1 parameter 0 type=L0
# ALL-NOT: role=GenericVersion of f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Triple" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0, v0 layout=L0 fields=[0, 1, 2]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = CallDirect v1 function=f1
    v5 = NewClosure function=f1
    v6 = Call v3, -, v5
    v7 = CallDirect v1 function=f2
    v8 = NewClosure function=f2
    v9 = Call v3, -, v8
    v10 = CallDirect function=f3
    Return
}
function f1 name="oneUse" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return
}
function f2 name="threeUses" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = PropGet v0 key="z"
    Return
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    Return
}
