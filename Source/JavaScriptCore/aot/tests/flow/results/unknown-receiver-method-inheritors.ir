# A method called on a receiver nobody knows runs on the escaped objects that inherit it and on no others: x.push(v) stores into an escaped array and into an escaped object whose chain has Array.prototype or a prototype nobody knows, and costs a plain escaped record and an array that stayed in the program nothing
# RUN: flow
# RUN(CHECK2): flow
# RUN(CHECK3): flow
# RUN(CHECK4): flow
# RUN(CHECK5): flow
# RUN(NOWHERE): flow
# RUN(NOWHERE2): flow
# OPTIONS: disable=flow:AppendedFields
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] addedKeysAreComplete=true
# CHECK2: class {{*}} layout=L1 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, StoreOfOtherType, LoseShape] addedKeys=["length"] addedKeysAreComplete=true
# CHECK3: class {{*}} layout=L2 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, StoreOfOtherType, LoseShape] addedKeys=["length"] addedKeysAreComplete=true
# CHECK4: variable g0 type=Array<undefined|1|"stored", Contiguous, pristine[Storage]> written=anything
# CHECK5: variable g2 type=Array<1, proven, pristine[Storage, Names, Dense]>
# NOWHERE-NOT: layout=L1 impossibleMutations=[{{*}}AddProperty
# NOWHERE2-NOT: layout=L2 impossibleMutations=[{{*}}AddProperty
# RUN(NODES): flow-solve nodes
# RUN(NODES2): flow-solve nodes
# RUN(NODES3): flow-solve nodes
# RUN(NODES4): flow-solve nodes
# NODES-NOT: (unknown, "length")
# NODES2: Property(L1#{{*}}, "length") = {int[
# NODES3: Property(L2#{{*}}, "length") = {
# NODES4-NOT: (unknown, "length")

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L1 name="InheritsFromArrayPrototype" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L2 name="InheritsFromUnknownObject" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="escapedArray" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="escapedRecord" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="keptArray" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v5 variable=g2
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="publish" [isFreeName]
    v9 = Call v8, -, v1
    v10 = Call v8, -, v3
    v11 = Builtin builtin=ArrayPrototype
    v12 = NewObject v11, v0 layout=L1 fields=[0]
    v13 = Call v8, -, v12
    v14 = PropGet v7 key="input" [isFreeName]
    v15 = NewObject -, v0 layout=L2 fields=[0]
    SetLiteralPrototype v15, v14
    v17 = FinishObject v15
    v18 = Call v8, -, v17
    v19 = String string="stored"
    v20 = PropGet v14 key="push"
    v21 = Call v20, v14, v19 calleeKey="push"
    Return
}
