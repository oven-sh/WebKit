# An access through a receiver nobody knows may hit any closure that reached nativeCode, and no closure that stayed in compiled code
# RUN: flow
# CHECK: function f1 cause=ReachesNativeCode witness={function=f0 value=v4}
# CHECK: function f2 callers=AllKnown executions=AtMostOnce closureUse=CalledOnly
# CHECK: class C0 closureFunction=f1 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class C1 closureFunction=f2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Copy"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Call v3, -, v0
    v5 = NewClosure function=f2
    v6 = Call v5
    v7 = PropGet v2 key="found" [isFreeName]
    v8 = CallDirect v7 function=f3
    v9 = CallDirect v7 function=f4
    v10 = CallDirect v7 function=f5
    v11 = CallDirect v7 function=f6
    v12 = CallDirect v7 function=f7
    Return
}
function f1 name="registered" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="apart" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="read" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="name"
    Return v1
}
function f4 name="presenceTest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropHas v0 key="name"
    Return v1
}
function f5 name="deleteByName" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropDelete v0 key="name" mode=Strict
    Return v1
}
function f6 name="copy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0 fields=[]
    CopyDataProperties v1, v0 excludedKeys=[]
    v3 = FinishObject v1
    Return v3
}
function f7 name="call" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
