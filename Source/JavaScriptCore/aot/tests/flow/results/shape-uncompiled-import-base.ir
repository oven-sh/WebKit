# A class that extends an export of a module the build does not compile gets its objects from a constructor nobody sees: the layout is allocated, and its objects may lose their shape
# RUN: flow
# RUN(UNSEEN): flow
# CHECK: class [[importedBase]] layout=L0 {{*}}cause=UnknownBase witness={function=f0 value=v0}
# CHECK: layout L0 flow={
# CHECK-NOT: allocation=NeverAllocated
# CHECK-NOT: baseState=
# CHECK: cause=UnknownBase witness={function=f0 value=v0}
# CHECK-NOT: LoseShape
# CHECK: field L0.0
# UNSEEN: unseen-code ImportsUncompiledModule

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="uncompiled.js" displayPath="uncompiled.js" kind=External referrer=m0
entry module=m0
layout L0 kind=Instance name="ExtendsImport" constructor=f1 fields=[{key="y" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="Base"
    v2 = NewClosure function=f1
    v3 = ResolveHeritage v1
    v4 = NewClass v2, v1, v3 layout=L0
    v5 = FinishClass v4 layout=L0
    v6 = Construct v5
    Return
}
function f1 name="ExtendsImport" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = Integer integer=1
    PropSet v3, v4 key="y" mode=Strict
    Return v3
}
