# Resolving a computed specifier loads no module, and a specifier that may be an object is converted by its own methods, which run
# RUN: flow
# RUN(ALL): flow
# CHECK: function f1 reachability=Unreached
# CHECK: class C1 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: indirect f0 {{*}} -> f2 Protocol
# CHECK: function f2 this type=L0 written=anything
# ALL-NOT: function f2 reachability=Unreached
# ALL-NOT: unseen-code
# ALL-NOT: variable g0 {{*}}written=

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="other.js" displayPath="other.js" body=f1
entry module=m0
layout L0 name="Specifier" fields=[{key="path" declared={type=anything} flags=[IsRequired]}, {key="toString" declared={type=anything} flags=[IsRequired]}]
variable g0 name="resolved" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="./other.js"
    v1 = NewClosure function=f2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = ResolveDynamic v2 referrer=m0
    PutModuleVariable v3 variable=g0
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="toString" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="path"
    Return v1
}
