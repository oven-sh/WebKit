# A name that flow appends to the layout of a class whose objects a store through a receiver nobody knows can reach has the type that the types below what the class implements declare for the name:
# a store that this type does not admit is a store of another type. A plain number has no such type: a typed slot would not make it smaller. A name that none of them declares is not appended.
# A layout for whose objects the program declares no type takes every name. Where flow sees every store, the type that it finds stands
# RUN: flow
# CHECK: field L2.0 "count" type=undefined|int[-2147483643, 2147483647] predicted=undefined|int[0, 7] written=undefined|null|number flags=[IsAppendedByFlow]
# CHECK-NEXT: field L2.1 "text" type=undefined|null|string flags=[IsAppendedByFlow]
# CHECK-NEXT: field L2.2 "width" type=anything flags=[IsAppendedByFlow]
# CHECK-NOT: field L2.3
# CHECK: field L3.0 "other" type=anything flags=[IsAppendedByFlow]
# CHECK: field L4.0 "count" type="s" flags=[IsAppendedByFlow] flow={{*}}IsNeverStoredWithOtherType

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Node" module=m0 fields=[{key="kind" declared={type=undefined|null|number} flags=[IsRequired]}]
layout L1 name="Leaf" module=m0 fields=[{key="kind" declared={type=undefined|null|number} flags=[IsRequired]}, {key="count" declared={type=undefined|null|number predicted=int[0, 7]}}, {key="text" declared={type=undefined|null|string} flags=[IsRequired]}, {key="width" declared={type=undefined|null|number}}] supertypes=[L0]
layout L2 kind=Instance name="HandedOut" constructor=f1 supertypes=[L0]
layout L3 kind=Instance name="WithoutDeclaredType" constructor=f2
layout L4 kind=Instance name="KeptToItself" constructor=f3 supertypes=[L0]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="s"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="keep" [isFreeName]
    v4 = NewClosure function=f1
    v5 = NewClass v4 layout=L2
    v6 = FinishClass v5 layout=L2
    v7 = Construct v6
    PropSet v7, v0 key="count" mode=Strict
    PropSet v7, v1 key="text" mode=Strict
    PropSet v7, v0 key="width" mode=Strict
    PropSet v7, v1 key="other" mode=Strict
    v12 = Call v3, -, v7
    v13 = NewClosure function=f2
    v14 = NewClass v13 layout=L3
    v15 = FinishClass v14 layout=L3
    v16 = Construct v15
    PropSet v16, v1 key="other" mode=Strict
    v18 = Call v3, -, v16
    v19 = NewClosure function=f3
    v20 = NewClass v19 layout=L4
    v21 = FinishClass v20 layout=L4
    v22 = Construct v21
    PropSet v22, v1 key="count" mode=Strict
    v24 = PropGet v2 key="thing" [isFreeName]
    v25 = PropGet v2 key="name" [isFreeName]
    ElemSet v24, v25, v24 mode=Strict
    Return
}
function f1 name="HandedOut" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f2 name="WithoutDeclaredType" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
function f3 name="KeptToItself" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L4
    v2 = NewObject v1 layout=L4
    Return v2
}
