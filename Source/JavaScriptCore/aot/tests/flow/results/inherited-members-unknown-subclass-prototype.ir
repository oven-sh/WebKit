# A field record answers for the objects of every subclass, so a subclass whose prototype object gets names nobody knows costs the fields of its base the proof that no prototype has their name, and no other layout
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: field L2.{{*}} "own" {{*}}prototypeName=AbsentOnPrototypes
# CHECK: field L3.0 "other" {{*}}prototypeName=AbsentOnPrototypes
# NOWHERE-NOT: "maybe" {{*}}prototypeName=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="maybe" declared={type=anything}}]
layout L1 kind=Instance name="UnknownNames" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="KnownNames" predictedBase=L0 constructor=f3 fields=[{key="own" declared={type=anything}}] flags=[HasHeritage]
layout L3 name="Options" fields=[{key="other" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    v8 = ResolveHeritage v2
    v9 = NewClosure function=f3
    v10 = NewClass v9, v2, v8 layout=L2
    v11 = FinishClass v10 layout=L2
    v12 = Construct v11
    v13 = PropGet v6 key="prototype"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="key" [isFreeName]
    v16 = ToString v15
    v17 = Integer integer=1
    ElemSet v13, v16, v17 mode=Strict
    v19 = NewObject layout=L3 fields=[]
    v20 = FinishObject v19
    v21 = PropGet v20 key="other"
    v22 = PropGet v7 key="maybe"
    v23 = PropGet v12 key="own"
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = FinishObject v2
    Return v3
}
function f2 name="UnknownNames" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="KnownNames" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
