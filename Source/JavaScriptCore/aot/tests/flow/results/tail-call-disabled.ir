# With result checks switched off every tail call is required and every function tests its own written result type
# OPTIONS: disable=flow:ResultChecks
# RUN: flow-apply
# RUN(NOWHERE): flow-apply
# STATISTIC: ReturnCallsDemoted = 1
# NOWHERE-NOT: requirement=Allowed
# NOWHERE-NOT: ByCallers

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
variable g0 name="next" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="other" [isFreeName]
    PutModuleVariable v3 variable=g0
    v5 = CallDirect function=f1
    v6 = CallDirect function=f2
    Return
}
function f1 name="onCycle" flags=[IsChecked] results=[{type=boolean site=w0}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=boolean site=w0}}]
}
# CHECK-LABEL: function f1 name="onCycle"
# CHECK: [[claim]]: boolean = Claim v1 castType=boolean site=w0
# CHECK-NEXT: Return [[claim]]
function f2 name="callsLeaf" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f3
    ReturnCall v0
}
# CHECK-LABEL: function f2 name="callsLeaf"
# CHECK: ReturnCall v0
function f3 name="leaf" results=[{type=anything}] {
  b0():
    Return
}
