# Reading name or length of a closure, or binding it, only inspects the closure: its callers stay known, and what bind gives is a closure of a bound function, the first function behind those of the text. A name the program redefined is found first, and a closure handed to unknown code is lost
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 callers=AllKnown
# CHECK: function f2 callers=AllKnown
# CHECK: function f3 callers=AllKnown
# CHECK: function f4 callers=AllKnown
# CHECK: function f5 cause=ReachesNativeCode
# CHECK: class {{*}} closureFunction=f1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty,
# CHECK: class {{*}} closureFunction=f2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty,
# CHECK: class {{*}} closureFunction=f3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, ChangeIntegrity,
# CHECK: indirect f0 {{*}} -> f4 Accessor Once
# CHECK: variable g0 type={{*}}string written=anything
# CHECK: variable g1 type={{*}}number written=anything
# CHECK: variable g2 type={{*}}7|string written=anything
# CHECK: variable g3 type=f7 written=anything
# NOWHERE-NOT: -> f1 Host
# NOWHERE-NOT: -> f2 Host
# NOWHERE-NOT: -> f3 Host

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="AccessorDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
variable g0 name="functionName" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="functionLength" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="redefinedName" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="bound" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="name"
    PutModuleVariable v1 variable=g0
    v3 = PropGet v0 key="length"
    PutModuleVariable v3 variable=g1
    v5 = Call v0
    v6 = NewClosure function=f2
    v7 = PropGet v6 key="bind"
    v8 = Undefined
    v9 = Call v7, v6, v8 calleeKey="bind"
    PutModuleVariable v9 variable=g3
    v11 = Call v9
    v12 = NewClosure function=f3
    v13 = Builtin builtin=ObjectDefineProperty
    v14 = String string="name"
    v15 = NewClosure function=f4
    v16 = NewObject -, v15 layout=L0 fields=[0]
    v17 = Call v13, -, v12, v14, v16
    v18 = PropGet v12 key="name"
    PutModuleVariable v18 variable=g2
    v20 = Call v12
    v21 = NewClosure function=f5
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="publish" [isFreeName]
    v24 = Call v23, -, v21
    Return
}
function f1 name="read" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="bound" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="renamed" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f4 name="getName" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
function f5 name="published" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
