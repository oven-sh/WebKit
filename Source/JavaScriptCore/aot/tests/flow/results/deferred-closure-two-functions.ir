# A field defers its closure only if closures of one function reach it and no object is stored to twice
# RUN: flow
# STATISTIC: FlowDeferredClosureFields = 1
# CHECK: field L0.0 "handler" type=f1|f2 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: field L1.0 "handler" type=f3 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead deferral=CapturesNothing deferredFunction=f3 isUnchangedDuringActivation=true}
# CHECK: field L2.0 "handler" type=f4 written=anything flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="TwoFunctions" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OneFunction" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L2 name="StoredAgain" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f3
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = CallDirect function=f5
    v5 = NewClosure function=f4
    v6 = NewObject -, v5 layout=L2 fields=[0]
    v7 = NewClosure function=f4
    PropSet v6, v7 key="handler" mode=Strict
    Return
}
function f1 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="shared" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f4 name="replaced" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f5 name="allocateElsewhere" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f3
    v3 = NewObject -, v2 layout=L1 fields=[0]
    Return
}
