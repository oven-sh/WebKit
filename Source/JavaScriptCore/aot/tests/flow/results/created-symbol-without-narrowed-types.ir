# With NarrowedTypes off the Symbol() call is not replaced by a constant, so the symbol does not count as created once: no field is appended for it and the store under it is an AddProperty
# RUN: flow-apply
# OPTIONS: disable=flow:NarrowedTypes
# STATISTIC: FlowAppendedFields = 0
# CHECK: layout L0 name="Keyed" flow={
# CHECK-NOT: IsAppendedByFlow
# CHECK-NOT: AddProperty
# CHECK-NOT: = KeyConstant

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Keyed"
variable g0 name="key" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = String string="k"
    v2 = Call v0, -, v1 @100
    PutModuleVariable v2 variable=g0
    v4 = NewObject layout=L0
    v5 = Integer integer=1
    ElemSet v4, v2, v5 mode=Strict
    Return
}
