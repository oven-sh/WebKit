# A read that names its own this calls a getter on that value, also when the key is a constant
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: variable g0 type=undefined|L1 written=anything
# CHECK: function f2 this type=L1 written=anything
# NOWHERE-NOT: variable g0 type={{*}}L0
# NOWHERE-NOT: function f2 this type={{*}}L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Holder" constructor=f1
layout L1 name="Receiver" fields=[{key="p" declared={type=anything} flags=[IsRequired]}]
variable g0 name="getterThis" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="self"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = Boolean boolean=true
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = String string="self"
    v9 = CallDirect v5, v7, v8 function=f3
    PutModuleVariable v9 variable=g0
    Return
}
function f1 name="Holder" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="self" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="readWithThis" role=Library parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = GetByValWithThis v0, v1, v2
    Return v3
}
