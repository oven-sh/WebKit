# The type of an appended field is made from the objects that are stored to under its name. A store under a key nobody knows on another object of the layout may bring any value under that name:
# the field may leave its slot, nothing is known of its stores and reads, and the class of that object may see a store of another type.
# Where the object that has the name is the one stored to under the unknown key, the type has both values and the proofs stand
# RUN: flow
# STATISTIC: FlowAppendedFields = 2
# CHECK: layout L0 flow={baseState=None {{*}}impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, LoseShape]
# CHECK: field L0.1 "late" type="text" flags=[IsAppendedByFlow] flow={location={writers=AllKnown cause=StoreOfOtherType} stability=[IsNeverDeleted, IsNeverRedefined]}
# CHECK: layout L1 flow={baseState=None {{*}}impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: field L1.1 "late" type=5|"text" flags=[IsAppendedByFlow] flow={location={writers=AllKnown} stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# RUN(KEY): flow
# KEY: class {{*}} layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, LoseShape] {{*}}isStoredUnderUnnamedKeys=true
# RUN(NAME): flow
# NAME: class {{*}} layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape] {{*}}addedKeysAreComplete=true

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="TwoObjects" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OneObject" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=5
    v2 = String string="text"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="key" [isFreeName]
    v5 = ToString v4
    v6 = NewObject -, v0 layout=L0 fields=[0]
    ElemSet v6, v5, v1 mode=Strict
    v8 = ElemGet v6, v5
    v9 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v9, v2 key="late" mode=Strict
    v11 = NewObject -, v0 layout=L1 fields=[0]
    ElemSet v11, v5, v1 mode=Strict
    PropSet v11, v2 key="late" mode=Strict
    v14 = ElemGet v11, v5
    Return
}
