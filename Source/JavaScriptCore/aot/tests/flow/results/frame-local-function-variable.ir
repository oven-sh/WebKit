# A function that a module variable starts as has a closure that no NewClosure creates, and the class of that closure is not frame local
# RUN: flow
# CHECK: class C0 closureFunction=f3 {{*}}locality=FrameLocal
# CHECK: class C1 closureFunction=f4 {{*}}locality=FrameLocal
# CHECK: class {{*}} closureFunction=f3
# CHECK-NOT: locality
# CHECK: class
# CHECK-NOT: closureFunction=f3
# CHECK: site {{*}} function=f1 allocationClass=0
# CHECK: site {{*}} function=f2 allocationClass=1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="declared" module=m0 declared={type=function} initialization=Function function=f3
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="alsoCreated" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    Return
}
function f2 name="control" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = Call v0
    Return
}
function f3 name="declared" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="expression" results=[{type=anything}] {
  b0():
    Return
}
