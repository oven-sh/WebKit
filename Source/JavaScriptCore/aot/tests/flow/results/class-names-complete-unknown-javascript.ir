# The names of a prototype object that reaches unknownJavaScript are not complete. A class of the same program that stays out of its reach keeps both answers
# RUN: flow
# CHECK: layout L0 flow={{*}} prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="m" function=f2 mutability=Fixed{{*}}}] namedMembers=[{key="m" function=f2 mutability=Fixed
# CHECK: layout L1 flow=
# CHECK-NOT: prototypeNamesAreComplete
# CHECK: layout L(

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Complete" constructor=f1
layout L1 kind=Instance name="ReachesUnknownJavaScript" constructor=f3
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = NewClosure function=f1
    v2 = NewClass v1 layout=L0
    v3 = NewClosure function=f2
    DefineMethod v2, v3 layout=L0 key="m"
    v5 = FinishClass v2 layout=L0
    v6 = NewClosure function=f3
    v7 = NewClass v6 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="m"
    v10 = FinishClass v7 layout=L1
    v11 = PropGet v10 key="prototype"
    v12 = PropGet v0 key="text" [isFreeName]
    v13 = Builtin builtin=Function
    v14 = Construct v13, -, v12
    v15 = Call v14, -, v11
    Return
}
function f1 name="Complete" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="m" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="ReachesUnknownJavaScript" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="m" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
