# A module variable that only closures of one function reach has that function as its type
# RUN: flow
# CHECK: variable g0 type=f1 written=anything
# CHECK: variable g1 type=null|f1 written=anything
# CHECK: variable g2 type=f1 written=anything
# CHECK: variable g3 type=undefined|f1 written=anything
# CHECK: variable g4 type=f1 written=anything
# CHECK: variable g5 type=f1 written=anything
# CHECK: variable g6 type=anything predicted=f1 flow=
# CHECK: function f2 parameter 0 type=f1 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="direct" declared={type=anything} initialization=Uninitialized
variable g1 name="cleared" declared={type=anything} initialization=Uninitialized
variable g2 name="selfCopy" declared={type=anything} initialization=Uninitialized
variable g3 name="installed" declared={type=anything} initialization=Uninitialized
variable g4 name="joined" declared={type=anything} initialization=Uninitialized
variable g5 name="forwarded" declared={type=anything} initialization=Uninitialized
variable g6 name="replaced" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    v3 = Null
    PutModuleVariable v3 variable=g1
    PutModuleVariable v0 variable=g2
    v6 = GetModuleVariable variable=g2
    PutModuleVariable v6 variable=g2
    v8 = Undefined
    PutModuleVariable v8 variable=g3
    v10 = CallDirect v0 function=f2
    v11 = GetModuleVariable variable=g0
    PutModuleVariable v11 variable=g5
    PutModuleVariable v0 variable=g6
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="override" [isFreeName]
    PutModuleVariable v15 variable=g6
    v17 = ToBoolean v15
    Branch v17 -> taken b1(), notTaken b2()
  b1():
    v18 = NewClosure function=f1
    Jump -> next b3(v18)
  b2():
    v19 = NewClosure function=f1
    Jump -> next b3(v19)
  b3(v20):
    PutModuleVariable v20 variable=g4
    Return
}
function f1 name="task" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="install" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g3
    Return
}
