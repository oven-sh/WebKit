# Freezing an object is a mutation of its own and costs nothing else, and a record that is never stored to cannot be stored to after its creation
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK-NOT: cause=
# CHECK: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK-NOT: cause=
# CHECK: class C2 layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: layout L0 flow={
# CHECK-NOT: cause=
# CHECK: field L0.0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Frozen" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Untouched" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=ObjectFreeze
    v3 = Call v2, -, v1
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = NewObject -, v0 layout=L2 fields=[0]
    PropSet v5, v0 key="x" mode=Strict
    Return
}
