# APPLIED: v4: L0 = CallDirect v1 function=f1
# APPLIED: function f1 {{*}}parameters=[{type=L0 written=undefined|null|L0}] results=[{type=L0 written=undefined|null|L0}]
# APPLIED: b0(v0: L0):

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="held" module=m0 declared={type=undefined|null|L0} initialization=Undefined
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Holder" fields=[{key="point" declared={type=undefined|null|L0} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v1 layout=L1 fields=[0]
    v4 = CallDirect v1 function=f1
    Return
}
function f1 name="same" parameters=[{type=undefined|null|L0}] results=[{type=undefined|null|L0}] {
  b0(v0: undefined|null|object ? L0):
    Return v0
}
