# A reached call of a built-in uses each feature its table entry names, with the first mention of the built-in as the witness
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use MathMax [Read, Called] f0:v7
# CHECK: builtin-use MathSumPrecise [Read, Called] f0:v2
# CHECK: feature 41 MathSumPrecise f0:v2
# ALL-NOT: builtin-use AtomicsPause
# ALL-NOT: feature {{*}} MathMax
# ALL-NOT: feature {{*}} AtomicsPause

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Math" [isFreeName]
    v2 = PropGet v1 key="sumPrecise"
    v3 = NewArray contents=anything
    v4 = Call v2, v1, v3
    v5 = PropGet v1 key="sumPrecise"
    v6 = Call v5, v1, v3
    v7 = PropGet v1 key="max"
    v8 = Call v7, v1, v4, v6
    Return
}
function f1 name="unreached" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Atomics" [isFreeName]
    v2 = PropGet v1 key="pause"
    v3 = Call v2, v1
    Return
}
