# An operand that an operation without a statement of its own retains in an opaque value stays out of the sinks: nothing reads it back out of the enumerator. The use is recorded: its keys are enumerated
# RUN: flow
# RUN(ALL): flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,{{*}} keys=NeverEnumerated
# ALL-NOT: class C0 {{*}}cause=
# ALL-NOT: class C0 {{*}}NeverEnumerated

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Enumerated" fields=[{key="code" declared={type=anything}}]
layout L1 name="Held" fields=[{key="code" declared={type=anything}}]
variable g0 name="held" declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = ForInOpen v1
    PutModuleVariable v2 variable=g0
    Return
}
