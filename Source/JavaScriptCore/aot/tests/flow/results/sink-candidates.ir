# The pattern of a RegExp constructed from a value lists the string literals that can reach it, here through a variable and through a parameter, and the list is complete. Another construct site has a list of its own
# RUN: flow
# CHECK: access [[compile]] function=f1 kind=Construct
# CHECK: access [[other]] function=f2 kind=Construct
# CHECK-NOT: sink
# CHECK: sink [[compile]] operand 0 ["a+", "b+"] complete
# CHECK-NEXT: sink [[compile]] operand 1 [] mayBeUndefined complete
# CHECK-NEXT: sink [[other]] operand 0 ["c+"] complete
# CHECK-NEXT: sink [[other]] operand 1 [] mayBeUndefined complete
# CHECK-NOT: sink

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="pattern" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="a+"
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    v3 = CallDirect v2 function=f1
    v4 = String string="b+"
    v5 = CallDirect v4 function=f1
    v6 = String string="c+"
    v7 = CallDirect v6 function=f2
    Return
}
function f1 name="compile" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=RegExp
    v2 = Construct v1, -, v0
    Return v2
}
function f2 name="compileOther" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=RegExp
    v2 = Construct v1, -, v0
    Return v2
}
