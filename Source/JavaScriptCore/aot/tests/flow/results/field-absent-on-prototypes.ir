# A field that may be empty reads as its type or undefined when no object on a prototype chain of its objects can have the name. Object.prototype takes no key, so a store to it changes nothing
# RUN: flow
# RUN(APPLY): flow-apply
# CHECK: builtin-location ObjectPrototype."c" Constant written at f0:v23
# CHECK: field L0.0 "a" {{*}}prototypeName=AbsentOnPrototypes
# CHECK: field L1.0 "b"
# CHECK-NOT: prototypeName=
# CHECK: field L1.1 "k"
# CHECK-NOT: prototypeName=
# CHECK: field L1.2 "e" {{*}}prototypeName=AbsentOnPrototypes
# CHECK: field L2.0 "c" {{*}}prototypeName=AbsentOnPrototypes
# CHECK: field L3.0 "d"
# CHECK-NOT: prototypeName=
# CHECK: function f0
# APPLY: [[plain]]: L0 = NewObject layout=L0
# APPLY: : undefined|1 = PropGet [[plain]] key="a"
# APPLY: [[instance]]: L1 = AssumeType
# APPLY: : anything {{*}}= PropGet [[instance]] key="b"
# APPLY: : anything {{*}}= PropGet [[instance]] key="k"
# APPLY: : undefined|1 = PropGet [[instance]] key="e"
# APPLY: [[closed]]: L2 = NewObject layout=L2
# APPLY: : undefined|1 = PropGet [[closed]] key="c"
# APPLY: [[unknown]]: L3 = NewObject layout=L3
# APPLY: : anything {{*}}= PropGet [[unknown]] key="d"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="a" declared={type=number}}]
layout L1 kind=Instance name="Class" constructor=f1 fields=[{key="b" declared={type=number}}, {key="k" declared={type=number}}, {key="e" declared={type=number}}]
layout L2 name="UnderObjectPrototype" fields=[{key="c" declared={type=number}}]
layout L3 name="UnderUnknownPrototype" fields=[{key="d" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject layout=L0 fields=[]
    PropSet v1, v0 key="a" mode=Strict
    v3 = PropGet v1 key="a"
    v4 = NewClosure function=f1
    v5 = NewClass v4 layout=L1
    v6 = NewClosure function=f2
    DefineMethod v5, v6 layout=L1 key="b"
    v8 = FinishClass v5 layout=L1
    v9 = PropGet v8 key="prototype"
    PropSet v9, v0 key="k" mode=Strict
    v11 = Construct v8
    PropSet v11, v0 key="b" mode=Strict
    PropSet v11, v0 key="k" mode=Strict
    PropSet v11, v0 key="e" mode=Strict
    v15 = PropGet v11 key="b"
    v16 = PropGet v11 key="k"
    v17 = PropGet v11 key="e"
    v18 = NewObject layout=L2 fields=[]
    PropSet v18, v0 key="c" mode=Strict
    v20 = PropGet v18 key="c"
    v21 = Builtin builtin=GlobalThis
    v22 = Builtin builtin=ObjectPrototype
    PropSet v22, v0 key="c" mode=Sloppy
    v24 = PropGet v21 key="base" [isFreeName]
    v25 = NewObject layout=L3 fields=[]
    SetLiteralPrototype v25, v24
    PropSet v25, v0 key="d" mode=Strict
    v28 = PropGet v25 key="d"
    Return
}
function f1 name="Class" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f2 name="b" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
