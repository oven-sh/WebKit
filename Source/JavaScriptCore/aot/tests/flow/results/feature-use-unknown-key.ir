# A read under a key nobody can name through an unknown receiver may find every member of the built-in prototypes that native code holds, so from that read on the members follow their prototypes; the members of a namespace that nobody handed out stay unused
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use ArrayPrototype [Read, Escaped] f0:v4
# CHECK: builtin-use ArrayPrototypeFlat [{{*}}Escaped] f0
# CHECK: feature 33 ArrayPrototypeFlat f0
# ALL-NOT: builtin-use MathSumPrecise
# ALL-NOT: feature 41

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="keep" [isFreeName]
    v2 = Integer integer=1
    v3 = NewArray v2 contents=anything
    v4 = Call v1, -, v3
    v5 = PropGet v0 key="input" [isFreeName]
    v6 = PropGet v0 key="name" [isFreeName]
    v7 = ElemGet v5, v6
    Return
}
