# One closure that a loop stores into many objects is not deferred, and a closure that the loop creates for each object is
# RUN: flow
# STATISTIC: FlowDeferredClosureFields = 1
# CHECK: field L0.0 "handler" type=f1 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: field L1.0 "handler" type=f2 written=anything flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead deferral=CapturesNothing deferredFunction=f2 isUnchangedDuringActivation=true}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="SharesClosure" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OwnsClosure" fields=[{key="handler" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    Jump -> next b1()
  b1():
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="more" [isFreeName]
    v6 = ToBoolean v5
    Jump -> next b2()
  b2():
    LoopHint
    Branch v6 -> taken b1(), notTaken b3()
  b3():
    Return
}
function f1 name="shared" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="fresh" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
