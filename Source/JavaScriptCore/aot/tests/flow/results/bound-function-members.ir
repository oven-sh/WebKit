# A bound function inherits from what its target inherits from, so a member read from it is found like on any function and costs neither the bound function nor its target anything
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 callers=AllKnown
# CHECK: function f2 callers=AllKnown
# CHECK: class {{*}} closureFunction=f1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: class {{*}} builtinClass=BoundFunction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: variable g0 type=string written=anything
# CHECK: variable g1 type=number written=anything
# CHECK: variable g2 type=undefined written=anything
# CHECK: variable g3 type=5 written=anything
# CHECK: variable g4 type=undefined|7 written=anything
# CHECK: variable g5 type=undefined written=anything
# NOWHERE-NOT: -> f1 Host
# NOWHERE-NOT: -> f2 Host
# NOWHERE-NOT: cause=UnknownCallee

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="extra" declared={type=anything} flags=[IsRequired]}]
variable g0 name="boundName" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="boundLength" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="absent" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="called" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="inherited" module=m0 declared={type=anything} initialization=Uninitialized
variable g5 name="notInherited" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Undefined
    v2 = PropGet v0 key="bind"
    v3 = Call v2, v0, v1 calleeKey="bind"
    v4 = PropGet v3 key="name"
    PutModuleVariable v4 variable=g0
    v6 = PropGet v3 key="length"
    PutModuleVariable v6 variable=g1
    v8 = PropGet v3 key="listener"
    PutModuleVariable v8 variable=g2
    v10 = Builtin builtin=ReflectApply
    v11 = NewArray contents=anything holes=[]
    v12 = Call v10, -, v3, v1, v11
    PutModuleVariable v12 variable=g3
    v14 = PropGet v3 key="extra"
    PutModuleVariable v14 variable=g5
    v16 = NewClosure function=f2
    v17 = Integer integer=7
    v18 = Builtin builtin=FunctionPrototype
    v19 = NewObject v18, v17 layout=L0 fields=[0]
    v20 = Builtin builtin=ObjectSetPrototypeOf
    v21 = Call v20, -, v16, v19
    v22 = Builtin builtin=FunctionPrototypeBind
    v23 = Call v22, v16, v1
    v24 = PropGet v23 key="extra"
    PutModuleVariable v24 variable=g4
    v26 = Call v23
    Return
}
function f1 name="target" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    Return v0
}
function f2 name="reparented" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
