# The engine gives a function a name and a length and a prototype of a built-in class a constructor, so a read of one is not undefined alone
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: variable g0 type=
# CHECK: variable g1 type=
# CHECK: variable g2 type=undefined written=anything
# CHECK: variable g3 type={{*}}builtin(Array)
# NOWHERE-NOT: variable g0 type=undefined written
# NOWHERE-NOT: variable g1 type=undefined written
# NOWHERE-NOT: variable g3 type=undefined written

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="functionName" declared={type=anything} initialization=Uninitialized
variable g1 name="functionLength" declared={type=anything} initialization=Uninitialized
variable g2 name="absent" declared={type=anything} initialization=Uninitialized
variable g3 name="arrayConstructor" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="name"
    PutModuleVariable v1 variable=g0
    v3 = PropGet v0 key="length"
    PutModuleVariable v3 variable=g1
    v5 = PropGet v0 key="other"
    PutModuleVariable v5 variable=g2
    v7 = NewArray contents=anything holes=[]
    v8 = PropGet v7 key="constructor"
    PutModuleVariable v8 variable=g3
    Return
}
function f1 name="named" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
