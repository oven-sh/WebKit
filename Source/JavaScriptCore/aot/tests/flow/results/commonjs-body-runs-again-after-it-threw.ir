# The loader forgets a CommonJS module whose body threw, and the next require() runs the body again, beside whatever the failed run has let out: a closure of the first run must not see the variables
# of the second. So a body that may throw does not run at most once, and neither does a function that only it calls or a class that it defines: `setUp` belongs to helper.cjs and is called by throws.cjs.
# The body of an ES module keeps the outcome of its one evaluation. A CommonJS body that cannot throw: flow/results/module-evaluates-once.ir
# RUN: flow
# CHECK: function f0 {{*}}executions=AtMostOnce
# CHECK: function f1
# CHECK-NOT: executions=
# CHECK: function f6
# CHECK: layout L0
# CHECK-NOT: evaluations=AtMostOnce
# CHECK: layout L2 {{*}}classFlow={evaluations=AtMostOnce

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="throws.cjs" displayPath="throws.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
module m2 path="helper.cjs" displayPath="helper.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f3
entry module=m0
layout L0 kind=Instance name="InThrowingModule" module=m1 constructor=f2
layout L1 kind=Instance name="InHelperFunction" module=m2 constructor=f5
layout L2 kind=Instance name="InMain" module=m0 constructor=f6
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0() handler=b2():
    v0 = NewClosure function=f6
    v1 = NewClass v0 layout=L2
    v2 = FinishClass v1 layout=L2
    v3 = RequireModule module=m1 referrer=m0 specifier="./throws.cjs"
    Jump -> next b1()
  b1():
    v4 = RequireModule module=m1 referrer=m0 specifier="./throws.cjs"
    Return
  b2() role=CatchHandler:
    v5 = CatchValue
    Jump -> next b1()
}
function f1 name="throws" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = NewClosure function=f2
    v7 = NewClass v6 layout=L0
    v8 = FinishClass v7 layout=L0
    v9 = RequireModule module=m2 referrer=m1 specifier="./helper.cjs"
    v10 = PropGet v9 key="setUp"
    v11 = Call v10
    v12 = Builtin builtin=MathRandom
    v13 = Call v12
    v14 = ToBoolean v13
    Branch v14 -> taken b1(), notTaken b2()
  b1():
    Throw v13
  b2():
    Return
}
function f2 name="InThrowingModule" module=m1 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f3 name="helper" module=m2 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = NewClosure function=f4
    PropSet v1, v6 key="setUp" mode=Strict
    Return
}
function f4 name="setUp" module=m2 results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = NewClass v0 layout=L1
    v2 = FinishClass v1 layout=L1
    Return v2
}
function f5 name="InHelperFunction" module=m2 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f6 name="InMain" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    Return v2
}
