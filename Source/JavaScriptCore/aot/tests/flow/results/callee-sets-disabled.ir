# With callee sets switched off no call gets a callees stamp and no function has known callers or a proven capability; access site ids and indirect calls stay
# OPTIONS: disable=flow:CalleeSets
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call v0 accessSite=0
# CHECK: = Call v2, -, v3 accessSite=1
# CHECK: = CallDirect function=f3 accessSite=2
# RUN(STAMPS): flow-apply
# STAMPS-NOT: callees=
# STAMPS-NOT: HasOnlyDirectCallers
# RUN(FLOW): flow
# FLOW: function f1 {{*}}cause=ResultDisabled
# FLOW: function f2 {{*}}cause=ResultDisabled
# FLOW: function f3 {{*}}cause=ResultDisabled
# FLOW: indirect f0 S1 -> f2 BuiltinCallback Later
# RUN(NOTHING): flow
# NOTHING-NOT: callers=AllKnown
# NOTHING-NOT: capabilities=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=QueueMicrotask
    v3 = NewClosure function=f2
    v4 = Call v2, -, v3
    v5 = CallDirect function=f3
    Return
}
function f1 name="calledThroughClosure" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="calledByBuiltin" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="calledDirectly" results=[{type=anything}] {
  b0():
    Return
}
