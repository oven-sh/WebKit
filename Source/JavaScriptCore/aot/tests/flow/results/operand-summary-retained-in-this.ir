# A constructor that stores its argument in this retains it in that operand, and a constructor that allocates this itself retains it in its result
# RUN: flow
# CHECK: function f1 parameter 0 uses=[Inspects, StoresByKey] retainedIn=UnknownMemory
# CHECK-NEXT: function f1 parameter 1 uses=[Retains] retainedIn=Operand retainingOperand=0
# CHECK: function f2 parameter 2 uses=[Retains] retainedIn=UnknownMemory
# CHECK: function f3 parameter 1 uses=[Retains] retainedIn=Result

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Node" constructor=f1 fields=[{key="leaf" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 name="Leaf" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="StoresInTwoOperands" constructor=f2 fields=[{key="leaf" declared={type=anything}}] flags=[IsConstructorFunction]
layout L3 kind=Instance name="ClassNode" constructor=f3 fields=[{key="leaf" declared={type=anything}}]
variable g0 name="tree" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure function=f1
    v3 = Construct v2, -, v1
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = NewClosure function=f2
    v6 = Construct v5, -, v3, v4
    v7 = NewObject -, v0 layout=L1 fields=[0]
    v8 = NewClosure function=f3
    v9 = NewClass v8 layout=L3
    v10 = FinishClass v9 layout=L3
    v11 = Construct v10, -, v7
    v12 = NewArray v3, v6, v11 contents=anything holes=[]
    PutModuleVariable v12 variable=g0
    Return
}
function f1 name="Node" flags=[HasThis] thisType={type=anything predicted=L0} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="leaf" mode=Strict
    Return
}
function f2 name="StoresInTwoOperands" flags=[HasThis] thisType={type=anything predicted=L2} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    PropSet v0, v2 key="leaf" mode=Strict
    PropSet v1, v2 key="leaf" mode=Strict
    Return
}
function f3 name="ClassNode" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L3
    v3 = NewObject v2 layout=L3 fields=[]
    PropSet v3, v1 key="leaf" mode=Strict
    Return v3
}
