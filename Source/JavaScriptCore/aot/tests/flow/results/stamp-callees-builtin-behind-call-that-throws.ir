# Dead code stays where the narrowed types are switched off: behind a call that always throws, on the edge of a test that never passes. A call of a built-in in it names the built-in, a call whose callee nothing flows into has no set at all (a pass may follow the prediction of the callee, which a set that says "does nothing" would contradict), and the program builds
# FORM: AsRead
# OPTIONS: disable=flow:NarrowedTypes,pass:InlineCalls
# RUN: flow-apply
# RUN(BUILDS): pipeline Select

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = CallDirect function=f2
    v2 = Call v0, -
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="String" [isFreeName]
    v5 = Call v4, -, v2
    Return v5
}
function f1 name="fail" results=[{type=anything}] {
  b0():
    v0 = String string="always"
    Throw v0
}
function f2 name="passesUndefined" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = CallDirect v0 function=f3
    Return v1
}
function f3 name="textOfNumber" parameters=[{type=anything predicted=undefined|number}] results=[{type=anything}] {
  b0(v0: anything ~ undefined|number):
    v1 = TypeTest v0 testedType=undefined
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    v4 = PropGet v3 key="toString"
    v5 = Integer integer=16
    v6 = Call v4, v3, v5 calleeKey="toString"
    Return v6
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[failing]]: anything = Call v0 accessSite={{*}} callees=[f1]
# CHECK: = Call {{*}}, -, [[failing]] accessSite={{*}} callees=[builtin(String)]
# CHECK-LABEL: function f3 name="textOfNumber"
# CHECK-NOT: callees=
# BUILDS-LABEL: function f0 name="main"
# BUILDS-LABEL: function f3 name="textOfNumber"
