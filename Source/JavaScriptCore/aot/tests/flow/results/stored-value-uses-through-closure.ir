# A parameter only called through a closure that captured it is only called, and a closure stored into an outer environment outlives its creator
# RUN: flow
# CHECK: function f1 parameter 0 uses=[Inspects, Calls] 
# CHECK: class [[inner]] closureFunction=f3 {{*}}locality=FrameLocal
# CHECK: class [[left]] closureFunction=f7
# CHECK-NOT: locality=
# CHECK: class [[host]] builtinClass=
# CHECK: stored-value L0.0 uses=[Inspects, Calls]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="callback" declared={type=anything}}]
layout L1 kind=Environment fields=[{key="saved" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = CallDirect v0 function=f1
    v2 = CallDirect function=f5
    Return
}
function f1 name="each" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f3
    v3 = CallDirect v2 function=f2
    Return
}
function f2 name="run" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
function f3 name="inner" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = Call v1
    Return v2
}
function f4 name="callback" results=[{type=anything}] {
  b0():
    Return
}
function f5 name="outer" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1 fields=[]
    v1 = NewClosure v0 function=f6
    v2 = Call v1
    Return
}
function f6 name="storing" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = NewClosure function=f7
    PutEnvironmentField v0, v1 layout=L1 field=0
    Return
}
function f7 name="left" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
