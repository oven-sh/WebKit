# function choose(pair, flag) { const x = pair.x; pair.y; return flag === undefined ? x : flag }   print(choose(new Pair(input, input)), choose(input, false))
# A function with a generic version of its own has two copies of each access. A call enters the generic version where flow does not know the caller,
# as an access takes its slow half where a prediction fails: the version that flow's calls enter decides the level
# OPTIONS: report=Flow
# RUN: flow-report through=ResolveAccesses
# STATISTIC: FlowGenericVersions = 1
# CHECK: access m0:20 Read Proven copies=2 function=f1
# RUN(PROGRAM): pipeline ResolveAccesses
# PROGRAM-LABEL: function f1 name="choose"
# PROGRAM: = GetSlot {{*}}key="x" {{*}}level=Proven
# PROGRAM-LABEL: function f4 name="choose" {{*}}role=GenericVersion
# PROGRAM: = PropGet {{*}}key="x"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2
    v5 = Boolean boolean=false
    v6 = Call v3, -, v1, v5
    v7 = CallDirect function=f2
    v8 = PropGet v0 key="print" [isFreeName]
    v9 = Call v8, -, v4, v6
    Return
}
function f1 name="choose" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="x" @20
    v3 = PropGet v0 key="y" @21
    v4 = TypeTest v1 testedType=undefined
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    Return v2
  b2(v6):
    Return v6
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
    v51 = Undefined
    v52 = Undefined
    v53 = Undefined
    v54 = Undefined
    v55 = Undefined
    v56 = Undefined
    v57 = Undefined
    v58 = Undefined
    v59 = Undefined
    v60 = Undefined
    v61 = Undefined
    v62 = Undefined
    v63 = Undefined
    v64 = Undefined
    v65 = Undefined
    v66 = Undefined
    v67 = Undefined
    v68 = Undefined
    v69 = Undefined
    v70 = Undefined
    v71 = Undefined
    v72 = Undefined
    v73 = Undefined
    v74 = Undefined
    v75 = Undefined
    v76 = Undefined
    v77 = Undefined
    v78 = Undefined
    v79 = Undefined
    Return
}
