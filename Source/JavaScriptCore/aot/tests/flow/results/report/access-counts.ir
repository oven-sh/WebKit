# Source accesses and calls are counted per level and per module of the source location, also for a copy inlined into another module and in a build without the flow report
# RUN: flow-report through=InlineCalls
# STATISTIC: InlineDecisionInline >= 1
# STATISTIC: AccessesUnknown = 6
# STATISTIC: AccessesPredicted = 1
# STATISTIC: AccessesWritten = 0
# STATISTIC: AccessesProven = 1
# STATISTIC: DirectCalls = 1
# STATISTIC: IndirectCalls = 1
# CHECK: access-count m0 accesses=[4, 1, 0, 1] calls=[1, 0, 0, 1] typeTests=1
# CHECK-NEXT: access-count m1 accesses=[2, 0, 0, 0] calls=[0, 0, 0, 0] typeTests=0
# CHECK-NOT: access

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="other.js" displayPath="other.js" body=f1
entry module=m0
layout L0 name="Proven" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Predicted" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = PropGet v2 key="x" @10
    v4 = PropGet v1 key="x" @11
    v5 = CallDirect v1 function=f2 @12
    v6 = Call v1 @13
    v7 = PropGet v1 key="withoutLocation"
    v8 = Predict v1 predicted=L1
    v9 = PropGet v8 key="x" @15
    v10 = NewArray v3, v4, v5, v6, v7, v9 contents=anything holes=[]
    PropSet v0, v10 key="output" [isFreeName] @16
    v12 = NewObject -, v1 layout=L1 fields=[0]
    PropSet v0, v12 key="predictedObject" [isFreeName] @17
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="other" [isFreeName] @1
    Return
}
function f2 name="readsInOther" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x" @20
    Return v1
}
