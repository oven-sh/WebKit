# RUN(SPLIT): flow-report through=SplitCoroutines
# RUN(PROGRAM): pipeline SplitCoroutines
# OPTIONS: report=Flow
# CHECK: check 604c54dc6484 m0:60 cause=UnknownObject site=Parameter witness f2:v1
# CHECK-NEXT: check a0fa8aa814c8 m0:40 cause=UnknownObject site=Parameter witness f1:v1
# CHECK-NEXT: check ea3d72eb4d00 m0:80 cause=UnknownObject site=Parameter witness f3:v1
