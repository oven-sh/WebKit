# PROGRAM-LABEL: function f1 name="claims"
# PROGRAM-NOT: site=w0
# PROGRAM-LABEL: function f2 name="claimsAsync"
# PROGRAM-NOT: site=w1
# PROGRAM-LABEL: function f3 name="claimsWithoutVersion"
# PROGRAM: = Claim v0 castType=number site=w2
# PROGRAM-LABEL: function f6 name="claims" {{*}}role=GenericVersion {{*}}derivation={source=f1
# PROGRAM: = Claim v0 castType=number site=w0
# PROGRAM-LABEL: function f7 name="claimsAsync" {{*}}role=CoroutineRamp {{*}}derivation={source=f2
# PROGRAM-NOT: site=w1
# PROGRAM-LABEL: function f9 name="claimsAsync" {{*}}role=CoroutineBody {{*}}derivation={source=f7
# PROGRAM: = Claim v0 castType=number site=w1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=40 kind=Parameter
typesite w1 module=m0 position=60 kind=Parameter
typesite w2 module=m0 position=80 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = CallDirect v0 function=f1 @1
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName] @2
    v4 = CallDirect v3 function=f1 @3
    v5 = CallDirect v0 function=f2 @4
    v6 = CallDirect v3 function=f2 @5
    v7 = CallDirect v3 function=f3 @6
    v8 = CallDirect function=f4 @7
    Return
}
