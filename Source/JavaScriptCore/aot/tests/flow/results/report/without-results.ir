# Without the flow analysis the report says that nothing is known about what can run, and has no other line: no built-in, no locale, no access
# RUN: flow-report
# OPTIONS: disable=pass:AnalyzeFlow
# CHECK-NOT: -used
# CHECK-NOT: access
# CHECK: unseen-code FlowResultDisabled witness -
# CHECK-NOT: unseen-code
# CHECK-NOT: -used
# CHECK-NOT: access
# CHECK-NOT: check
# CHECK-NOT: type-test

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = PropGet v1 key="toLocaleString" @2
    v3 = String string="en-US"
    v4 = Call v2, v1, v3 @3
    Return
}
