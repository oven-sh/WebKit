# With the flow report every type test that runs is one line, a placed test and a check of a written type alike, and the count of each module is the number of its lines
# RUN: flow-report through=PlaceTypeTests
# OPTIONS: report=Flow
# CHECK: access-count m0 {{*}}typeTests=2
# CHECK-NEXT: access-count m1 {{*}}typeTests=1
# CHECK-NOT: type-test
# CHECK: type-test m0:10 f0 TakesGenericPath copies=1
# CHECK-NEXT: type-test m0:20 f0 Throws copies=1
# CHECK-NEXT: type-test m1:5 f1 Throws copies=1
# CHECK-NOT: type-test

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="other.js" displayPath="other.js"
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v0, v2 key="point" [isFreeName] @2
    v4 = Predict v1 predicted=L0
    v5 = PropGet v4 key="x" @10
    v6 = Claim v1 castType=number @20
    v7 = CallDirect v1 function=f1 @3
    v8 = NewArray v5, v6, v7 contents=anything holes=[]
    PropSet v0, v8 key="output" [isFreeName] @4
    Return
}
function f1 name="claimsInOtherModule" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=string @5
    Return v1
}
