# Each read is one line with the level of its receiver and one cause: proven by type, predicted by a written type, predicted by the checker, unknown, behind a test because of a mutation
# RUN: flow-report through=PlaceTypeTests
# RUN(UNGUARDED): flow-report through=ResolveAccesses
# OPTIONS: report=Flow
# CHECK: access m0:10 Read Proven copies=1 function=f0
# CHECK-NEXT: access m0:20 Read Predicted cause=UnknownObject witness f0:v1 copies=1 layout=L1 function=f0
# CHECK-NEXT: access m0:30 Read Predicted cause=UnknownObject witness f0:v1 copies=1 layout=L2 function=f0
# CHECK-NEXT: access m0:40 Read Unknown cause=UnknownObject witness f0:v1 copies=1 function=f0
# CHECK-NEXT: access m0:50 Read Proven copies=1 function=f0
# CHECK: access m0:70 Read Predicted cause=PropertyRedefined witness f0:v19 copies=1 layout=L4 function=f0
# CHECK-NEXT: access m0:71 Read Proven copies=1 function=f0
# UNGUARDED: access m0:10 Read Proven copies=1 function=f0
# UNGUARDED-NEXT: access m0:20 Read Unknown cause=UnknownObject witness f0:v1 copies=1 function=f0
# UNGUARDED-NEXT: access m0:30 Read Unknown cause=UnknownObject witness f0:v1 copies=1 function=f0
# UNGUARDED-NEXT: access m0:40 Read Unknown cause=UnknownObject witness f0:v1 copies=1 function=f0
# UNGUARDED-NEXT: access m0:50 Read Proven copies=1 function=f0
# UNGUARDED: access m0:70 Read Unknown cause=PropertyRedefined witness f0:v19 copies=1 layout=L4 function=f0
# UNGUARDED-NEXT: access m0:71 Read Proven copies=1 function=f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=19 kind=Assertion
typesite w1 module=m0 position=21 kind=PropertyRead
layout L0 name="Proven" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Written" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 name="Predicted" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="OtherProven" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Redefined" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Descriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = PropGet v2 key="x" @10
    v4 = ClaimDeclared v1 declared={type=L1 site=w0}
    v5 = PropGet v4 key="x" @20
    v6 = ClaimRead v5, v4 source=Field{key="x"} site=w1
    v7 = Predict v1 predicted=L2
    v8 = PropGet v7 key="x" @30
    v9 = PropGet v1 key="x" @40
    v10 = ToBoolean v1
    Branch v10 -> taken b1(), notTaken b2()
  b1():
    v11 = NewObject -, v1 layout=L3 fields=[0]
    Jump -> next b3(v11)
  b2():
    Jump -> next b3(v2)
  b3(v12):
    v13 = PropGet v12 key="x" @50
    v14 = NewObject -, v1, v1 layout=L4 fields=[0, 1]
    v15 = NewClosure function=f1
    v16 = NewObject -, v15 layout=L5 fields=[0]
    v17 = Builtin builtin=ObjectDefineProperty
    v18 = String string="x"
    v19 = Call v17, -, v14, v18, v16 @60
    v20 = PropGet v14 key="x" @70
    v21 = PropGet v14 key="y" @71
    v22 = Integer integer=1
    v23 = NewObject -, v22 layout=L1 fields=[0]
    v24 = NewObject -, v1 layout=L2 fields=[0]
    v25 = NewArray v3, v6, v8, v9, v13, v20, v21 contents=anything holes=[]
    PropSet v0, v25 key="output" [isFreeName] @2
    PropSet v0, v23 key="written" [isFreeName] @3
    PropSet v0, v24 key="predicted" [isFreeName] @4
    Return
}
function f1 name="getter" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
