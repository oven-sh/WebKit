# An access in a function that is inlined at two sites and kept is one line with three copies and the level of the copy in the function itself: which calls are inlined does not change it
# OPTIONS: report=Flow
# RUN: flow-report through=InlineCalls
# RUN(COPIES): pipeline InlineCalls
# LOSS: MinNarrowedUsesForGenericVersion f1
# CHECK: access-count m0 accesses=[2, 1, 0, 1] calls=[0, 0, 0, 4] 
# CHECK: access m0:10 Call Proven copies=0 function=f0
# CHECK-NEXT: access m0:11 Call Proven copies=0 function=f0
# CHECK-NEXT: access m0:12 Call Proven copies=1 function=f0
# CHECK-NEXT: access m0:13 Call Proven copies=1 function=f0
# CHECK-NEXT: access m0:20 Read Predicted cause=UnknownObject witness f0:v1 copies=3 layout=L0 function=f1
# CHECK-NEXT: access m0:30 Read Proven copies=1 function=f2
# CHECK-NOT: access m0:
# COPIES-LABEL: function f0 name="main"
# COPIES: = PropGet {{*}}key="x" accessSite=[[site]] {{*}}@20:
# COPIES: = PropGet {{*}}key="x" accessSite=[[site]] {{*}}@20:
# COPIES-LABEL: function f1 name="inlinedTwiceAndKept"
# COPIES: = GetSlot {{*}}key="x" receivers=[L0] level=Predicted accessSite=[[site]] @20
# COPIES-LABEL: function f2 name="onlyKept"
# COPIES: = GetSlot v0 key="y" receivers=[L0] level=Proven accessSite={{*}} @30

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    v3 = CallDirect v2 function=f1 [isAlwaysInlined] @10
    v4 = CallDirect v1 function=f1 [isAlwaysInlined] @11
    v5 = CallDirect v2 function=f1 [isNeverInlined] @12
    v6 = CallDirect v2 function=f2 [isNeverInlined] @13
    v7 = NewArray v3, v4, v5, v6 contents=anything holes=[]
    PropSet v0, v7 key="output" [isFreeName] @2
    Return
}
function f1 name="inlinedTwiceAndKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x" @20
    Return v1
}
function f2 name="onlyKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y" @30
    Return v1
}
