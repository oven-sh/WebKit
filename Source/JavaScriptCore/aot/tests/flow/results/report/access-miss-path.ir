# The access by name on the failing side of a type test is the slow half of a guarded access: the slot access decides the level and is the one copy counted. An access by name that stands alone in an unlikely block counts
# RUN: flow-report through=PlaceTypeTests
# RUN(PROGRAM): pipeline PlaceTypeTests
# OPTIONS: report=Flow
# CHECK: access-count m0 accesses=[{{*}}, 1, 0, 0]
# CHECK: access m0:10 Read Predicted cause=UnknownObject witness f0:v1 copies=1
# CHECK-NEXT: access m0:20 Read Unknown cause=UnknownObject witness f0:v1 copies=1
# PROGRAM: = GetSlot {{*}}key="x" receivers=[L0] level=Predicted accessSite=[[site]] @10
# PROGRAM: () frequency=Unlikely:
# PROGRAM-NEXT: = PropGet v4 key="x" accessSite=[[site]] @10

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v0, v2 key="point" [isFreeName] @2
    v4 = Predict v1 predicted=L0
    v5 = PropGet v4 key="x" @10
    PropSet v0, v5 key="guarded" [isFreeName] @3
    v7 = ToBoolean v1
    Branch v7 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v8 = PropGet v1 key="x" @20
    PropSet v0, v8 key="unlikely" [isFreeName] @4
    Jump -> next b2()
  b2():
    Return
}
