# A loop over an array brings the library's next into the image and nothing else: no code that the build cannot see, no feature, and no built-in in use but the method that makes the iterator and what the body of the loop names itself (the two prototypes are those of the run time's own errors)
# LIBRARY: own
# RUN: flow-report
# RUN(KEPT): pipeline RemoveUnreachableFunctions
# STATISTIC: FlowUnreachedFunctions = 0
# LOSS: MaxFlowRangeGrowth f0
# CHECK-NOT: unseen-code
# CHECK-NOT: feature-used
# CHECK-NOT: builtin-used
# CHECK: builtin-used ErrorPrototype [Read, Escaped]
# CHECK-NEXT: builtin-used ObjectPrototype [Read, Escaped]
# CHECK-NEXT: builtin-used ArrayPrototypeValues [Called] witness f0:v7
# CHECK-NEXT: builtin-used StringPrototypeLength [Read] witness f0:v13
# CHECK-NOT: unseen-code
# CHECK-NOT: feature-used
# CHECK-NOT: builtin-used
# KEPT-LABEL: function f1 name="next"
# KEPT-NEXT: b0(v0: anything):
# KEPT-NEXT: = HasJSType v0 first=5 last=5
# KEPT: = NewObject {{*}} layout=L(IteratorResult)

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
entry module=m0
runtimefunction id=70 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="ada"
    v3 = String string="grace"
    v4 = String string="edsger"
    v5 = NewArray v2, v3, v4 contents=anything
    v6 = Integer
    v7 = IteratorOpen v5
    Jump -> next b1(v6)
  b1(v8):
    LoopHint
    v10 = IteratorResume v7
    v11 = ResultAt v10
    Branch v11 -> taken b3(), notTaken b2()
  b2():
    v12 = ResultAt v10 index=1
    v13 = PropGet v12 key="length"
    v14 = Add v8, v13
    v15 = Call v1, -, v12
    Jump -> next b1(v14)
  b3():
    v16 = Call v1, -, v8
    Return
}
function f1 name="next" module=m1 role=Library flags=[HasThis] enclosingRuntimeFunction=70 results=[{type=anything}] {
  b0(v0: anything):
    v1 = HasJSType v0 first=5 last=5
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ClaimDeclared v0 declared={type=object flags=[IsFromCompiler]}
    v3 = StepArrayIterator v2
    v4 = ResultAt v3 index=1
    v5 = ResultAt v3
    v6 = CreateIteratorResult v4, v5
    Return v6
  b2():
    v7 = ThrowNewError errorKind=TypeError message="not an array iterator"
    Unreachable
}
