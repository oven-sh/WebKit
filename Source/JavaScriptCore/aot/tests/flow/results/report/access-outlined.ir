# An access by name that outlining moves into a body shared by many sites stays an access by name of its own site: the report does not follow heat
# OPTIONS: report=Flow heat=EverythingIsCold
# RUN: flow-report through=OutlineColdOperations
# RUN(PROGRAM): pipeline OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# CHECK: access-count m0 accesses=[8, 0, 0, 0] calls=[0, 0, 0, 6]
# CHECK: access m0:20 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NEXT: access m0:21 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NEXT: access m0:22 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NEXT: access m0:23 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NEXT: access m0:24 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NEXT: access m0:25 Read Unknown cause=UnknownObject witness f0:v1 copies=5
# CHECK-NOT: access m0:
# PROGRAM-LABEL: function f1 name="first"
# PROGRAM-NOT: ElemGet
# PROGRAM: role=OutlinedBody
# PROGRAM: = ElemGet

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = CallDirect v1 function=f1 [isNeverInlined] @10
    v3 = CallDirect v1 function=f2 [isNeverInlined] @11
    v4 = CallDirect v1 function=f3 [isNeverInlined] @12
    v5 = CallDirect v1 function=f4 [isNeverInlined] @13
    v6 = CallDirect v1 function=f5 [isNeverInlined] @14
    v7 = CallDirect v1 function=f6 [isNeverInlined] @15
    v8 = NewArray v2, v3, v4, v5, v6, v7 contents=anything holes=[]
    PropSet v0, v8 key="output" [isFreeName] @2
    Return
}
function f1 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @20
    v2 = ElemGet v1, v0 @20
    v3 = ElemGet v2, v0 @20
    v4 = ElemGet v3, v0 @20
    v5 = ElemGet v4, v0 @20
    Return v5
}
function f2 name="second" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @21
    v2 = ElemGet v1, v0 @21
    v3 = ElemGet v2, v0 @21
    v4 = ElemGet v3, v0 @21
    v5 = ElemGet v4, v0 @21
    Return v5
}
function f3 name="third" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @22
    v2 = ElemGet v1, v0 @22
    v3 = ElemGet v2, v0 @22
    v4 = ElemGet v3, v0 @22
    v5 = ElemGet v4, v0 @22
    Return v5
}
function f4 name="fourth" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @23
    v2 = ElemGet v1, v0 @23
    v3 = ElemGet v2, v0 @23
    v4 = ElemGet v3, v0 @23
    v5 = ElemGet v4, v0 @23
    Return v5
}
function f5 name="fifth" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @24
    v2 = ElemGet v1, v0 @24
    v3 = ElemGet v2, v0 @24
    v4 = ElemGet v3, v0 @24
    v5 = ElemGet v4, v0 @24
    Return v5
}
function f6 name="sixth" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ElemGet v0, v0 @25
    v2 = ElemGet v1, v0 @25
    v3 = ElemGet v2, v0 @25
    v4 = ElemGet v3, v0 @25
    v5 = ElemGet v4, v0 @25
    Return v5
}
