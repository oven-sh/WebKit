# The accesses and calls of a function that is never reached are neither listed nor counted, those of a function that is called are
# RUN: flow-report
# RUN(FLOW): flow
# OPTIONS: report=Flow
# CHECK: access-count m0 accesses=[2, 0, 0, 0] calls=[0, 0, 0, 1] typeTests=0
# CHECK-NEXT: access m0:10 Read Unknown
# CHECK-NEXT: access m0:11 Call Proven copies=1
# CHECK-NEXT: access m0:30 Read Unknown cause=UnknownObject witness f0:v1 copies=1
# CHECK-NOT: access
# FLOW: function f1 reachability=Unreached
# FLOW-NOT: function f2 reachability=Unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @10
    v2 = CallDirect v1 function=f2 @11
    Return
}
function f1 name="neverCalled" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x" @20
    v2 = Call v1 @21
    Return v2
}
function f2 name="called" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x" @30
    Return v1
}
