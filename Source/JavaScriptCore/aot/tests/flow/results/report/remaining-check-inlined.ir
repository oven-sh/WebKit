# A check that InlineCalls copied names the function it was written in, not the function that holds the copy, and all copies fold into one record
# RUN: flow-report through=InlineCalls
# RUN(COPIES): pipeline InlineCalls
# RUN(NESTED): flow-report through=SinkConstants
# RUN(FRAMES): pipeline SinkConstants
# OPTIONS: report=Flow
# CHECK-NOT: site=
# CHECK: check 614c54dc6637 m0:60 cause=UnknownObject site=Unknown witness f3:
# CHECK-NEXT: check a1fa8aa8167b m0:40 cause=UnknownObject site=Unknown witness f1:
# CHECK-NEXT: check cd9f2f3437a1 m0:10 cause=UnknownObject site=Unknown witness f2:
# CHECK-NOT: site=
# COPIES-COUNT-2: = Claim {{*}}castType=number cause=UnknownObject @10
# NESTED-NOT: site=
# NESTED: check 614c54dc6637 m0:60 cause=UnknownObject site=Unknown witness f3:
# NESTED-NEXT: check a1fa8aa8167b m0:40 cause=UnknownObject site=Unknown witness f1:
# NESTED-NEXT: check cd9f2f3437a1 m0:10 cause=UnknownObject site=Unknown witness f2:
# NESTED-NOT: site=
# FRAMES-LABEL: function f0 name="main"
# FRAMES: = Claim v1 castType=number cause=UnknownObject @40:
# FRAMES: = Claim v2 castType=number cause=UnknownObject @10:
# FRAMES: = Claim v3 castType=number cause=UnknownObject @60:
# FRAMES-LABEL: function f1 name="caller"
# FRAMES-NOT: Claim
# FRAMES-LABEL: function f4 name="library"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="first" [isFreeName] @1
    v2 = PropGet v0 key="second" [isFreeName] @2
    v3 = PropGet v0 key="third" [isFreeName] @3
    v4 = CallDirect v1, v2, v3 function=f1 @4
    v5 = CallDirect v2, v3 function=f2 @5
    v6 = Add v4, v5 @6
    PropSet v0, v6 key="output" [isFreeName] @7
    Return
}
function f1 name="caller" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Claim v0 castType=number @40
    v4 = CallDirect v1, v2 function=f2 @50
    v5 = Add v3, v4 @51
    Return v5
}
function f2 name="callee" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Claim v0 castType=number @10
    v3 = CallDirect v1 function=f3 @12
    v4 = Add v2, v3 @13
    Return v4
}
function f3 name="nestedCallee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=number @60
    Return v1
}
