# The id of a check is 48 bits of the FNV-1a hash of the path of the module, the position and the kind of its type site: each of the three changes it, and the function and the value that hold the check do not
# RUN: flow-report
# OPTIONS: report=Flow
# CHECK-NOT: check
# CHECK: check 146adb0c0bca m0:70000 cause=UnknownObject site=Parameter witness f1:v1
# CHECK-NEXT: check 9efa8aa81162 m0:40 cause=UnknownObject site=Assertion witness f2:v3
# CHECK-NEXT: check a0fa8aa814c8 m0:40 cause=UnknownObject site=Parameter witness f2:v2
# CHECK-NEXT: check bfd00d58adcb m0:41 cause=UnknownObject site=Parameter witness f2:v4
# CHECK-NEXT: check c4c432f2933d m1:40 cause=UnknownObject site=Parameter witness f3:v1
# CHECK-NOT: check

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="other.js" displayPath="other.js"
entry module=m0
typesite w0 module=m0 position=40 kind=Parameter
typesite w1 module=m0 position=40 kind=Assertion
typesite w2 module=m0 position=41 kind=Parameter
typesite w3 module=m1 position=40 kind=Parameter
typesite w4 module=m0 position=70000 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = CallDirect v1 function=f1 @2
    v3 = CallDirect v1 function=f2 @3
    v4 = CallDirect v1 function=f3 @4
    Return
}
function f1 name="standsInFront" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=number site=w4 @70001
    Return v1
}
function f2 name="claims" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = Claim v0 castType=number site=w0 @50
    v3 = Claim v0 castType=string site=w1 @51
    v4 = Claim v0 castType=boolean site=w2 @52
    Return v1
}
function f3 name="claimsInOtherModule" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=number site=w3 @50
    Return v1
}
