# A Claim that flow does not remove is listed once per type site, ascending by id, with its cause and the kind of its site, Unknown for a Claim without one
# RUN: flow-report
# OPTIONS: report=Flow
# STATISTIC: FlowRemovedClaims = 1
# STATISTIC: FlowRemainingClaims = 3
# CHECK-NOT: site=
# CHECK: check 39f2098c090b m0:24 cause=MayFail site=Unknown witness f1:v6
# CHECK-NEXT: check 9e75c2085ad1 m0:5 cause=UnknownObject site=Assertion witness f1:v3
# CHECK-NOT: site=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=5 kind=Assertion
typesite w1 module=m0 position=7 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName] @1
    v2 = String string="text"
    v3 = Integer integer=1
    v4 = CallDirect v1, v2, v3 function=f1 @3
    Return
}
function f1 name="claims" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Claim v0 castType=number site=w0 @10
    v4 = Claim v2 castType=number site=w1 @14
    v5 = Claim v0 castType=number site=w0 @2
    v6 = Claim v1 castType=number @24
    Return v3
}
