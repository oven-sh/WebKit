# With the mutations of holders switched off no mutation counts as impossible, no shape is proven, no field is stable and no member or link of a class is fixed. The results of the other switches stay
# RUN: flow
# RUN(NOWHERE): flow
# OPTIONS: disable=flow:HolderMutations
# CHECK: class [[literal]] layout=L0 keys=NeverEnumerated addedKeysAreComplete=true cause=ResultDisabled
# CHECK: class [[constructor]] closureFunction=f1 keys=NeverEnumerated
# CHECK: class [[instance]] layout=L1 keys=NeverEnumerated addedKeysAreComplete=true cause=ResultDisabled
# CHECK: layout L0 flow={{*}}cause=ResultDisabled keys=NeverEnumerated
# CHECK: field L0.0 "x" type=1 written=anything flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation
# CHECK: layout L1 flow={{*}}cause=ResultDisabled keys=NeverEnumerated {{*}}classFlow={evaluations=AtMostOnce prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="norm" function=f2{{*}}}] namedMembers=[{key="norm" function=f2
# CHECK: variable g0 type=object predicted=L0 written=anything {{*}}cause=ResultDisabled
# CHECK: variable g1 type=object predicted=L1 written=anything {{*}}cause=ResultDisabled
# NOWHERE-NOT: stability=
# NOWHERE-NOT: occupancy=
# NOWHERE-NOT: mutability=
# NOWHERE-NOT: =Fixed

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Literal" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Point" constructor=f1
variable g0 name="literal" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="instance" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    v4 = NewClass v3 layout=L1
    v5 = NewClosure function=f2
    DefineMethod v4, v5 layout=L1 key="norm"
    v7 = FinishClass v4 layout=L1
    v8 = Construct v7
    PutModuleVariable v8 variable=g1
    Return
}
function f1 name="Point" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f2 name="norm" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
