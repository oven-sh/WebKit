# A function that native code can call gets receivers nobody knows: the method may be a property of the receiver, so what happens to it counts for the receiver
# RUN: flow
# LOSS: MaxGenericVersionGrowthPercent
# CHECK: function f1 cause=ReachesNativeCode
# CHECK-NOT: function f1 parameter 0 uses=[Inspects, ReadsContents, WritesContents] 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1, v0
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    v6 = Call v5, -, v2
    Return
}
function f1 name="add" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push"
    Return
}
