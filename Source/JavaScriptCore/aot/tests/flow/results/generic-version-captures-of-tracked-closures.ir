# const record = members => pair => { pair.x; pair.y; return members[1] === undefined ? "required" : "optional" }   record(["c", true])(new Pair())   record(["a"])(input)
# Each call of `record` makes a closure of its own. Flow follows the first closure into the proven version of the arrow and the second into the Generic instance, which has seen the captured list ["a"] alone.
# A call by value goes through the entrypoint into the generic version, whichever closure it calls, so the generic version stands for the captures of every closure: the arm for a second element stays
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# CHECK-LABEL: function f2 name="made" {{*}}captures=[{type=Array<
# CHECK: true = AssumeType {{*}} castType=true
# CHECK-NOT: string="required"
# CHECK-LABEL: name="made" {{*}}role=GenericVersion
# CHECK-NOT: Unreachable
# CHECK: String string="required"
# CHECK-NOT: Unreachable
# CHECK: String string="optional"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" declared={type=anything} initialization=Undefined
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = String string="c"
    v2 = NewArray v1, v0 contents=anything holes=[]
    v3 = CallDirect v2 function=f1
    v4 = String string="a"
    v5 = NewArray v4 contents=anything holes=[]
    v6 = CallDirect v5 function=f1
    v7 = Integer integer=1
    v8 = NewObject -, v7, v7 layout=L0 fields=[0, 1]
    v9 = Call v3, -, v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Call v6, -, v11
    v13 = CallDirect function=f3
    PutModuleVariable v9 variable=g0
    PutModuleVariable v12 variable=g0
    Return
}
function f1 name="record" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure v0 function=f2
    Return v1
}
function f2 name="made" kind=Arrow captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = Integer integer=1
    v5 = ElemGet v0, v4
    v6 = TypeTest v5 testedType=undefined
    Branch v6 -> taken b1(| 0), notTaken b2(| 0)
  b1(v7):
    v8 = String string="required"
    Return v8
  b2(v9):
    v10 = String string="optional"
    Return v10
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
