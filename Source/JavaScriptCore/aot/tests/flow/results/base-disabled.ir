# With class bases switched off a layout with a heritage has no base, its allocation classes lose their shape for that reason, and a class without a heritage keeps its answers
# RUN: flow
# RUN(NOWHERE): flow
# OPTIONS: disable=flow:ClassBases
# STATISTIC: FlowProvenBases = 0
# CHECK: class {{*}} layout=L1 {{*}}cause=UnknownBase
# CHECK: layout L0 flow={baseState=None
# CHECK: layout L1 flow={{*}}cause=UnknownBase
# NOWHERE-NOT: layout L1 {{*}}baseState=
# NOWHERE-NOT: layout L1 {{*}}base=L0
# NOWHERE-NOT: layout=L1 {{*}}LoseShape
# NOWHERE-NOT: IsInherited

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
