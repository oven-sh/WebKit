# The names stored on the objects of an allocation class are listed, and the list is complete unless a store under a key nobody knows reaches them
# RUN: flow
# RUN(NOWHERE): flow
# OPTIONS: disable=flow:AppendedFields
# STATISTIC: FlowAppendedFields = 0
# CHECK: class {{*}} layout=L0 {{*}}addedKeys=["p", "q"] addedKeysAreComplete=true
# CHECK: class {{*}} layout=L1 {{*}}addedKeys=["p", "q"]
# CHECK: class {{*}} layout=L2 impossibleMutations=[{{*}}AddProperty{{*}}] {{*}}addedKeysAreComplete=true
# CHECK: layout L0 flow={baseState=None {{*}}addedKeys=["p", "q"] addedKeysAreComplete=true ownAccessorsAreComplete=true}
# CHECK: layout L1 flow={baseState=None {{*}}addedKeys=["p", "q"] ownAccessorsAreComplete=true}
# CHECK: layout L2 flow={baseState=None {{*}}addedKeysAreComplete=true ownAccessorsAreComplete=true}
# NOWHERE-NOT: layout=L0 impossibleMutations=[{{*}}AddProperty
# NOWHERE-NOT: layout=L1 impossibleMutations=[{{*}}AddProperty
# NOWHERE-NOT: layout=L1 {{*}}addedKeysAreComplete
# NOWHERE-NOT: layout L1 {{*}}addedKeysAreComplete
# NOWHERE-NOT: layout=L2 {{*}}addedKeys=[
# NOWHERE-NOT: IsAppendedByFlow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Named" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="UnknownKey" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Untouched" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v1, v0 key="p" mode=Strict
    PropSet v1, v0 key="q" mode=Strict
    v4 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v4, v0 key="p" mode=Strict
    PropSet v4, v0 key="q" mode=Strict
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="which" [isFreeName]
    v9 = ToString v8
    ElemSet v4, v9, v0 mode=Strict
    v11 = NewObject -, v0 layout=L2 fields=[0]
    Return
}
