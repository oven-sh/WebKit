# The passes tell the instances of a class by their layout, so a prototype object stands for one class. `Alias.prototype = Class.prototype` makes an instance of either an instance of both,
# and the members an instance of Alias finds are those of Class: an assigned prototype object that another class has too is not followed, and the prototype property of the function counts as one that may hold anything.
# The same for one object that is assigned to two functions. An object that one function alone is assigned is followed.
# RUN: flow
# CHECK: layout L0 flow={{*}} prototypeProperty=Fixed
# CHECK: layout L1 flow=
# CHECK-NOT: hasAssignedPrototype
# CHECK: layout L4 flow={{*}} hasAssignedPrototype=true
# CHECK: layout L5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Class" constructor=f1
layout L1 kind=Instance name="Alias" constructor=f2 flags=[IsConstructorFunction]
layout L2 kind=Instance name="First" constructor=f3 flags=[IsConstructorFunction]
layout L3 kind=Instance name="Second" constructor=f4 flags=[IsConstructorFunction]
layout L4 kind=Instance name="Alone" constructor=f5 flags=[IsConstructorFunction]
layout L5 name="Literal"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = PropGet v2 key="prototype"
    PropSet v3, v4 key="prototype" mode=Strict
    v6 = NewClosure function=f3
    v7 = NewClosure function=f4
    v8 = NewObject layout=L5 fields=[]
    PropSet v6, v8 key="prototype" mode=Strict
    PropSet v7, v8 key="prototype" mode=Strict
    v11 = NewClosure function=f5
    v12 = NewObject layout=L5 fields=[]
    PropSet v11, v12 key="prototype" mode=Strict
    v14 = Construct v2
    v15 = Construct v3
    v16 = Construct v6
    v17 = Construct v7
    v18 = Construct v11
    Return
}
function f1 name="Class" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="Alias" flags=[HasThis] thisType={type=L1} results=[{type=anything}] {
  b0(v0: object ? L1):
    Return
}
function f3 name="First" flags=[HasThis] thisType={type=L2} results=[{type=anything}] {
  b0(v0: object ? L2):
    Return
}
function f4 name="Second" flags=[HasThis] thisType={type=L3} results=[{type=anything}] {
  b0(v0: object ? L3):
    Return
}
function f5 name="Alone" flags=[HasThis] thisType={type=L4} results=[{type=anything}] {
  b0(v0: object ? L4):
    Return
}
