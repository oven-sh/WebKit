# An argument passed on to a constructor that stores it in this is retained where the caller's own this lives, and two constructors that call each other give up
# RUN: flow
# CHECK: function f1 parameter 1 uses=[Retains] retainedIn=Operand retainingOperand=0
# CHECK: function f2 parameter 1 uses=[Retains] retainedIn=Operand retainingOperand=0
# CHECK: function f3 parameter 1 uses=[Retains] retainedIn=Result
# CHECK: function f4 parameter 2 uses=[Retains] retainedIn=Result
# CHECK: function f5 parameter 1 uses=[Inspects, Retains] retainedIn=UnknownMemory
# CHECK: function f6 parameter 1 uses=[Inspects, Retains] retainedIn=UnknownMemory

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="Derived" constructor=f2 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L2 kind=Instance name="BaseClass" constructor=f3 fields=[{key="x" declared={type=anything}}]
layout L3 kind=Instance name="DerivedClass" predictedBase=L2 constructor=f4 supertypes=[L2] flags=[HasHeritage]
layout L4 kind=Instance name="First" constructor=f5 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L5 name="Item" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L5 fields=[0]
    v2 = NewClosure function=f2
    v3 = Construct v2, -, v1
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L2
    v6 = FinishClass v5 layout=L2
    v7 = ResolveHeritage v6
    v8 = NewClosure function=f4
    v9 = NewClass v8, v6, v7 layout=L3
    v10 = FinishClass v9 layout=L3
    v11 = Construct v10, -, v1
    v12 = NewClosure function=f5
    v13 = Construct v12, -, v1
    v14 = NewArray v3, v11, v13 contents=anything holes=[]
    PutModuleVariable v14 variable=g0
    Return
}
function f1 name="Base" flags=[HasThis] thisType={type=anything predicted=L0} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f2 name="Derived" flags=[HasThis] thisType={type=anything predicted=L1} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v0, v1 function=f1
    Return
}
function f3 name="BaseClass" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L2
    v3 = NewObject v2 layout=L2 fields=[]
    PropSet v3, v1 key="x" mode=Strict
    Return v3
}
function f4 name="DerivedClass" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L3
    Return v4
}
function f5 name="First" flags=[HasThis] thisType={type=anything predicted=L4} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x" mode=Strict
    v3 = ToBoolean v1
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = CallDirect v0, v1 function=f6
    Return
  b2():
    Return
}
function f6 name="Second" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v0, v1 function=f5
    Return
}
