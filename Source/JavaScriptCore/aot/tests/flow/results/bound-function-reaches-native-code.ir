# Native code that holds a bound function calls it, constructs it and tests instances with it: what the target returns reaches native code, a target that can be constructed reaches it with all that was bound to it, in one step or in two, and the target's own @@hasInstance runs
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 cause=ReachesNativeCode
# CHECK: function f2 cause=ReachesNativeCode
# CHECK: function f3 cause=ReachesNativeCode
# CHECK: function f4 cause=ReachesNativeCode
# CHECK: class {{*}} closureFunction=f1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class {{*}} closureFunction=f2 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class {{*}} layout=L1 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class {{*}} closureFunction=f3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: class {{*}} layout=L3 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class {{*}} layout=L4 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: indirect - - -> f1 Host
# CHECK: indirect - - -> f2 Host
# CHECK: indirect - - -> f3 Host
# CHECK: indirect - - -> f4 Protocol
# CHECK: function f1 this type=L0 written=anything
# CHECK: function f2 this type=anything
# NOWHERE-NOT: function f4 reachability=Unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Returned" fields=[]
layout L1 name="BoundToConstructor" fields=[]
layout L2 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L3 name="BoundAgainToConstructor" fields=[]
layout L4 name="BoundAgainToArrow" fields=[]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Builtin builtin=FunctionPrototypeBind
    v3 = NewClosure function=f1
    v4 = NewObject layout=L0 fields=[]
    v5 = Call v2, v3, v4
    v6 = NewClosure function=f2
    v7 = NewObject layout=L1 fields=[]
    v8 = Call v2, v6, v7
    v9 = NewClosure function=f3
    v10 = NewClosure function=f4
    v11 = NewObject -, v10 layout=L2 fields=[0]
    v12 = Builtin builtin=ObjectDefineProperty
    v13 = Builtin builtin=SymbolHasInstance
    v14 = Call v12, -, v9, v13, v11
    v15 = Undefined
    v16 = Call v2, v9, v15
    v17 = NewObject layout=L3 fields=[]
    v18 = Call v2, v8, v15, v17
    v19 = NewObject layout=L4 fields=[]
    v20 = Call v2, v16, v15, v19
    v21 = Call v1, -, v5, v8, v16, v18, v20
    Return
}
function f1 name="returnsThis" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="Constructible" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="tested" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f4 name="hasInstance" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=true
    Return v1
}
