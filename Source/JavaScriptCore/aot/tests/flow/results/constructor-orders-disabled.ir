# With constructor field orders switched off no layout lists an order or says when its fields are created; bases, members and leaks of this stay proven
# OPTIONS: disable=flow:ConstructorFieldOrders
# RUN: flow
# CHECK: layout L0 flow={baseState=None members=[L0] allocationClasses={{*}}] thisLeak=DoesNotLeak
# CHECK: layout L1 flow={baseState=None members=[L1] allocationClasses={{*}}] impossibleMutations=
# CHECK: layout L3 flow={baseState=Layout base=L2 members=[L3] allocationClasses={{*}}] thisLeak=DoesNotLeak
# CHECK: field L3.2 "p" {{*}}flags=[IsInherited]
# CHECK: layout L4 flow={baseState=None members=[L4] allocationClasses={{*}}] thisLeak=DoesNotLeak
# CHECK: layout L5 flow={baseState=None members=[L5] allocationClasses={{*}}] thisLeak=DoesNotLeak
# RUN(NOTHING): flow
# NOTHING-NOT: constructorOrders=
# NOTHING-NOT: fieldCreation=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="TwoBranches" constructor=f1 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 name="Literal" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="Base" constructor=f2 fields=[{key="p" declared={type=anything}}]
layout L3 kind=Instance name="Derived" predictedBase=L2 constructor=f3 fields=[{key="q" declared={type=anything}}, {key="r" declared={type=anything}}] flags=[HasHeritage]
layout L4 kind=Instance name="StoredAtConstruction" constructor=f4 fields=[{key="x" declared={type=anything}}, {key="z" declared={type=anything}}]
layout L5 kind=Instance name="StoredLater" constructor=f5 fields=[{key="x" declared={type=anything}}, {key="z" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Builtin builtin=MathRandom
    v4 = Call v3
    v5 = Construct v2, -, v4
    v6 = Integer integer=1
    v7 = NewObject -, v6, v6 layout=L1 fields=[0, 1]
    v8 = NewClosure function=f2
    v9 = NewClass v8 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = NewClosure function=f3
    v12 = ResolveHeritage v10
    v13 = NewClass v11, v10, v12 layout=L3
    v14 = FinishClass v13 layout=L3
    v15 = Construct v14
    v16 = NewClosure function=f4
    v17 = NewClass v16 layout=L4
    v18 = FinishClass v17 layout=L4
    v19 = Construct v18
    v20 = NewClosure function=f5
    v21 = NewClass v20 layout=L5
    v22 = NewClosure function=f6
    DefineMethod v21, v22 layout=L5 key="late"
    v24 = FinishClass v21 layout=L5
    v25 = Construct v24
    v26 = PropGet v25 key="late"
    v27 = Call v26, v25
    Return
}
function f1 name="TwoBranches" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    v4 = Integer integer=1
    v5 = ToBoolean v1
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    PropSet v3, v4 key="x" mode=Strict
    PropSet v3, v4 key="y" mode=Strict
    Jump -> next b3()
  b2():
    PropSet v3, v4 key="y" mode=Strict
    PropSet v3, v4 key="x" mode=Strict
    Jump -> next b3()
  b3():
    Return v3
}
function f2 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="p" mode=Strict
    Return v2
}
function f3 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L3
    v4 = Integer integer=2
    PropSet v3, v4 key="q" mode=Strict
    PropSet v3, v4 key="r" mode=Strict
    Return v3
}
function f4 name="StoredAtConstruction" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L4
    v2 = NewObject v1 layout=L4 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    PropSet v2, v3 key="z" mode=Strict
    Return v2
}
function f5 name="StoredLater" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L5
    v2 = NewObject v1 layout=L5 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f6 name="late" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=3
    PropSet v0, v1 key="z" mode=Strict
    Return
}
