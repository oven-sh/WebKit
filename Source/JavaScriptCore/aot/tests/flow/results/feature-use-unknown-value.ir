# What a program ordinarily does with a value nobody knows uses no feature and asks for no locale: printing it, converting it to a string, reading its length, spreading and serializing it, calling map and then with a callback
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use ArrayPrototypeMap [Read, Called
# CHECK: builtin-use ObjectPrototypeToString [
# CHECK: builtin-use PromisePrototypeThen [Read, Called
# ALL-NOT: builtin-use RegExpPrototype
# ALL-NOT: feature
# ALL-NOT: locale
# ALL-NOT: unseen

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Copy"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="console" [isFreeName]
    v2 = PropGet v1 key="log"
    v3 = PropGet v0 key="input" [isFreeName]
    v4 = Call v2, v1, v3 calleeKey="log"
    v5 = ToString v3
    v6 = PropGet v3 key="length"
    v7 = PropGet v3 key="toString"
    v8 = Call v7, v3 calleeKey="toString"
    v9 = NewObject layout=L0 fields=[]
    CopyDataProperties v9, v3
    v11 = FinishObject v9
    v12 = PropGet v0 key="JSON" [isFreeName]
    v13 = PropGet v12 key="stringify"
    v14 = Call v13, v12, v3 calleeKey="stringify"
    v15 = PropGet v3 key="map"
    v16 = NewClosure function=f1
    v17 = Call v15, v3, v16 calleeKey="map"
    v18 = PropGet v3 key="then"
    v19 = Call v18, v3, v16 calleeKey="then"
    Return
}
function f1 name="callback" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
