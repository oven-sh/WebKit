# A field that is called through an object that only inherits it counts as read; called on its own object it is only called
# RUN: flow
# CHECK: field L0.0 "run" type=f1 {{*}}location={writers=AllKnown {{*}}reads=OnlyCalled
# CHECK: field L1.0 "run" type=f2 {{*}}location={writers=AllKnown
# CHECK-NOT: reads=
# CHECK: field L2.0 "x"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="CalledOnItself" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
layout L1 name="CalledThroughHeir" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Heir" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = PropGet v1 key="run"
    v3 = Call v2, v1
    v4 = NewClosure function=f2
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = Builtin builtin=ObjectSetPrototypeOf
    v9 = Call v8, -, v7, v5
    v10 = PropGet v7 key="run"
    v11 = Call v10, v7
    Return
}
function f1 name="own" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="inherited" results=[{type=anything}] {
  b0():
    Return
}
