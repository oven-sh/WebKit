# A built-in that the program only tests uses none of its features, and one that is tested and then constructed uses them
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use CompressionStream [Tested, Read, Constructed] f0:v11
# CHECK: builtin-use DecompressionStream [
# CHECK: builtin-use WebSocket [Tested]
# CHECK: feature 245 CompressionStream f0:v11
# ALL-NOT: feature {{*}} WebSocket
# ALL-NOT: feature {{*}} DecompressionStream

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = String string="undefined"
    v2 = PropGet v0 key="WebSocket" [isFreeName, isForTypeOf]
    v3 = TypeOf v2
    v4 = StrictEq v3, v1
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2():
    v5 = PropGet v0 key="DecompressionStream"
    v6 = ToBoolean v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b4()
  b4():
    v7 = PropGet v0 key="CompressionStream" [isFreeName, isForTypeOf]
    v8 = TypeOf v7
    v9 = StrictEq v8, v1
    Branch v9 -> taken b5(), notTaken b6()
  b5():
    Return
  b6():
    v10 = String string="gzip"
    v11 = PropGet v0 key="CompressionStream" [isFreeName]
    v12 = Construct v11, -, v10
    Return
}
