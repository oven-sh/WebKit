# A SuperConstruct keeps its shape when every object it can return is of a class at or below its layout whose shape cannot be lost, and its type is then the members of the layout
# RUN: flow-apply

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="C" predictedBase=L1 constructor=f3 flags=[HasHeritage]
layout L3 kind=Instance name="P" constructor=f4
layout L4 kind=Instance name="Q" predictedBase=L3 constructor=f5 flags=[HasHeritage]
layout L5 kind=Instance name="R" predictedBase=L4 constructor=f6 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = NewClosure function=f3
    v8 = ResolveHeritage v6
    v9 = NewClass v7, v6, v8 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = Construct v6
    v12 = Construct v10
    v13 = NewClosure function=f4
    v14 = NewClass v13 layout=L3
    v15 = FinishClass v14 layout=L3
    v16 = NewClosure function=f5
    v17 = ResolveHeritage v15
    v18 = NewClass v16, v15, v17 layout=L4
    v19 = FinishClass v18 layout=L4
    v20 = NewClosure function=f6
    v21 = ResolveHeritage v19
    v22 = NewClass v20, v19, v21 layout=L5
    v23 = FinishClass v22 layout=L5
    v24 = Construct v19
    v25 = Construct v23
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="text" [isFreeName]
    v28 = Builtin builtin=Function
    v29 = Construct v28, -, v27
    v30 = Call v29, -, v25
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
# CHECK-LABEL: function f2 name="B"
# CHECK: : L1|L2 = SuperConstruct {{*}} layout=L1 {{*}}[keepsShape]
function f3 name="C" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f4 name="P" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3 fields=[]
    Return v2
}
function f5 name="Q" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L4
    Return v3
}
# CHECK-LABEL: function f5 name="Q"
# CHECK: : object ~ L4|L5 = SuperConstruct {{*}} layout=L4
# CHECK-NOT: keepsShape
function f6 name="R" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L5
    Return v3
}
# CHECK-LABEL: function f6 name="R"
# CHECK: : object ~ L5 = SuperConstruct {{*}} layout=L5
# CHECK-NOT: keepsShape
