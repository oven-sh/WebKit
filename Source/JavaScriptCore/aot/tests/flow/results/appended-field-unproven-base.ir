# The super call of a subclass whose base is only predicted enters the base constructor for unknown operands, where the new.target is the unknown object. The subclass beside it has escaped and is a prediction,
# which allocates nothing: the object is the one that the super call makes for a constructor nobody knows, and the name that the base constructor stores is a name added to it, no field of the layout.
# A subclass with a proven base inherits the field.
# RUN: flow
# STATISTIC: FlowAppendedFields = 0
# STATISTIC: FlowProvenBases = 1
# CHECK: class {{*}} layout=L1 {{*}}addedKeys=["x"] {{*}}cause=UnknownBase witness={function=f0 value=v4}
# RUN(BASE): flow
# BASE: field L0.0 "x" type={{*}}1 written=anything flow={location={writers=AllKnown
# RUN(UNPROVEN): flow
# UNPROVEN: layout L1 flow={{*}}cause=UnknownBase witness={function=f0 value=v4}
# RUN(PROVEN): flow
# PROVEN: layout L2 flow={baseState=Layout base=L0
# PROVEN-NEXT: field L2.0 "x" type={{*}}1 written=anything flags=[IsInherited] originLayout=L0 originField=0
# RUN(NOWHERE): flow
# NOWHERE-NOT: layout L1 {{*}}baseState=
# NOWHERE-NOT: field L1.0
# NOWHERE-NOT: field L2.0 {{*}}IsAppendedByFlow
# NOWHERE-NOT: field L2.1
# NOWHERE-NOT: site {{*}} function=f1 layout=L1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="Proven" predictedBase=L0 constructor=f3 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="otherBase" [isFreeName]
    v5 = ToBoolean v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4)
  b2():
    Jump -> next b3(v2)
  b3(v6):
    v7 = NewClosure function=f2
    v8 = ResolveHeritage v6
    v9 = NewClass v7, v6, v8 layout=L1
    v10 = FinishClass v9 layout=L1
    v11 = NewClosure function=f3
    v12 = ResolveHeritage v2
    v13 = NewClass v11, v2, v12 layout=L2
    v14 = FinishClass v13 layout=L2
    v15 = Construct v10
    v16 = Construct v14
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Proven" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
