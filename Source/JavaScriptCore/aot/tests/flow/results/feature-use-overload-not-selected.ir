# A feature line of one overload is not used where flow never selects that overload: splitting a string at a string needs no regular expression
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use StringPrototypeSplit [Read, Called] f0:v1
# ALL-NOT: feature 7
# ALL-NOT: feature 53

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="a,b"
    v1 = PropGet v0 key="split"
    v2 = String string=","
    v3 = Call v1, v0, v2 calleeKey="split"
    Return
}
