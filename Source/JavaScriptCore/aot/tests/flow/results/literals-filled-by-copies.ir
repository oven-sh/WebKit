# An untyped literal, or the rest of a pattern, that is allocated empty and filled at once by a copy of keys nobody can name has no layout of its own: the allocation and the copy become one CopyObject, whose result is an ordinary object. A literal with a written type, one that defines a name or gets a prototype first, and one whose source flow knows keep their layouts
# RUN: flow-apply
# RUN(CLASSES): flow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="SpreadThenName" fields=[{key="a" declared={type=anything}}]
layout L1 name="Rest"
layout L2 name="TypedSpreadThenName" fields=[{key="a" declared={type=number}}]
layout L3 name="NameThenSpread" fields=[{key="a" declared={type=anything}}]
layout L4 name="KnownSource" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L5 name="SpreadOfKnownSource"
layout L6 name="UnderPrototype"
layout L7 name="RestWithComputedKey"
layout L8 name="SpreadAlone"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject layout=L0
    CopyDataProperties v3, v1
    PropDefine v3, v2 key="a"
    v6 = FinishObject v3
    v7 = NewObject layout=L1
    CopyDataProperties v7, v1 excludedKeys=["x", "y"]
    v9 = FinishObject v7
    v10 = NewObject layout=L2
    CopyDataProperties v10, v1
    PropDefine v10, v2 key="a"
    v13 = FinishObject v10
    v14 = NewObject layout=L3
    PropDefine v14, v2 key="a"
    CopyDataProperties v14, v1
    v17 = FinishObject v14
    v18 = NewObject -, v2 layout=L4 fields=[0]
    v19 = FinishObject v18
    v20 = NewObject layout=L5
    CopyDataProperties v20, v19
    v22 = FinishObject v20
    v23 = NewObject v19 layout=L6
    CopyDataProperties v23, v1
    v25 = FinishObject v23
    v26 = PropGet v0 key="which" [isFreeName]
    v27 = ToPropertyKey v26
    v28 = NewObject layout=L7
    CopyDataProperties v28, v1, v27 excludedKeys=["x"]
    v30 = FinishObject v28
    v31 = NewObject layout=L8
    CopyDataProperties v31, v1
    v33 = FinishObject v31
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[copy]]: object = CopyObject v1
# CHECK-NOT: CopyDataProperties
# CHECK: PropDefine [[copy]], v2 key="a"
# CHECK-NEXT: = FinishObject [[copy]]
# CHECK-NEXT: [[rest]]: object = CopyObject v1 excludedKeys=["x", "y"]
# CHECK-NOT: CopyDataProperties
# CHECK: = FinishObject [[rest]]
# CHECK: [[typed]]: {{*}} = NewObject layout=L2
# CHECK-NEXT: CopyDataProperties [[typed]], v1
# CHECK: [[named]]: {{*}} = NewObject layout=L3
# CHECK: CopyDataProperties [[named]], v1
# CHECK: [[ofKnown]]: {{*}} = NewObject layout=
# CHECK-NEXT: CopyDataProperties [[ofKnown]],
# CHECK: [[heir]]: {{*}} = NewObject {{*}} layout=L6
# CHECK-NEXT: CopyDataProperties [[heir]], v1
# CHECK: [[computed]]: object = CopyObject v1, {{*}} excludedKeys=["x"]
# CHECK: [[alone]]: object = CopyObject v1
# CHECK-NOT: CopyDataProperties
# CHECK: = FinishObject [[alone]]
# CLASSES: class C{{*}} layout=L0 {{*}}cause=NonLayoutObject
# CLASSES: class C{{*}} layout=L1 {{*}}cause=NonLayoutObject
# CLASSES: class C{{*}} layout=L2 impossibleMutations=[
# CLASSES: class C{{*}} layout=L3 impossibleMutations=[
# CLASSES: class C{{*}} layout=L7 {{*}}cause=NonLayoutObject
# CLASSES: class C{{*}} layout=L8 {{*}}cause=NonLayoutObject
