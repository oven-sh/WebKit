# Access sites are numbered by function as read, then by value, over every access and call, and a generic version repeats the numbers of its proven version
# RUN: flow-apply
# RUN(NOWHERE): flow-apply
# RUN(FLOW): flow
# STATISTIC: FlowGenericVersions = 1
# CHECK-LABEL: function f0 name="main"
# CHECK: = PropGet v1 key="x" accessSite=0 {{*}}@10
# CHECK-NEXT: PropSet v1, v0 key="x" accessSite=1 {{*}}@20
# CHECK: = ElemGet {{*}}, v0 accessSite=2 @30
# CHECK: = Call v6, -, v1 accessSite=3 {{*}}@40
# CHECK: = Construct v8 accessSite=4 {{*}}@50
# CHECK-NEXT: = CallDirect v1 function=f1 accessSite=5 @60
# CHECK: = PropGet v11 key="external" accessSite=6 [isFreeName] @70
# CHECK-NEXT: = CallDirect v12 function=f5 accessSite=7 @80
# CHECK-NEXT: = CallDirect function=f3 accessSite=8 @85
# CHECK-LABEL: function f1 name="both"
# CHECK: = PropGet v0 key="x" accessSite=9 {{*}}@90
# CHECK-NEXT: = PropGet v0 key="y" accessSite=10 {{*}}@100
# CHECK-LABEL: function f2 name="last"
# CHECK: = PropGet v0 key="y" accessSite=11 {{*}}@110
# CHECK-LABEL: function f5 name="both" {{*}}role=GenericVersion
# CHECK: = PropGet v0 key="x" accessSite=9 receivers=[L0, ..] @90
# CHECK-NEXT: = PropGet v0 key="y" accessSite=10 receivers=[L0, ..] @100
# NOWHERE-NOT: accessSite=12
# NOWHERE-NOT: NewObject {{*}}accessSite=
# NOWHERE-NOT: NewArray {{*}}accessSite=
# NOWHERE-NOT: NewClosure {{*}}accessSite=
# NOWHERE-NOT: Builtin {{*}}accessSite=
# FLOW: access S0 function=f0 location={module=m0 position=10} kind=Read
# FLOW-NEXT: access S1 function=f0 location={module=m0 position=20} kind=Store
# FLOW-NEXT: access S2 function=f0 location={module=m0 position=30} kind=Read
# FLOW-NEXT: access S3 function=f0 location={module=m0 position=40} kind=Call
# FLOW-NEXT: access S4 function=f0 location={module=m0 position=50} kind=Construct
# FLOW-NEXT: access S5 function=f0 location={module=m0 position=60} kind=Call
# FLOW-NEXT: access S6 function=f0 location={module=m0 position=70} kind=Read
# FLOW-NEXT: access S7 function=f0 location={module=m0 position=80} kind=Call
# FLOW-NEXT: access S8 function=f0 location={module=m0 position=85} kind=Call
# FLOW-NEXT: access S9 function=f1 location={module=m0 position=90} kind=Read
# FLOW-NEXT: access S10 function=f1 location={module=m0 position=100} kind=Read
# FLOW-NEXT: access S11 function=f2 location={module=m0 position=110} kind=Read
# FLOW-NOT: access S

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = PropGet v1 key="x" @10
    PropSet v1, v0 key="x" mode=Strict @20
    v4 = NewArray v0 contents=anything
    v5 = ElemGet v4, v0 @30
    v6 = NewClosure function=f2
    v7 = Call v6, -, v1 @40
    v8 = Builtin builtin=Map
    v9 = Construct v8 @50
    v10 = CallDirect v1 function=f1 @60
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="external" [isFreeName] @70
    v13 = CallDirect v12 function=f1 @80
    v14 = CallDirect function=f3 @85
    Return
}
function f1 name="both" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x" @90
    v2 = PropGet v0 key="y" @100
    Return v2
}
function f2 name="last" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y" @110
    Return v1
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    Return
}
