# A function that reaches no Return has the result type never, and one Return on any path keeps its value
# OPTIONS: disable=flow:NarrowedTypes disable-in=4:1
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 result 0 type=never
# CHECK: function f2 result 0 type=true
# CHECK: function f3 result 0 type=never
# CHECK: function f3 result 1 type=never
# NOWHERE-NOT: function f2 result 0 type=never
# NOWHERE-NOT: function f4 result

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f2
    v1 = CallDirect function=f1
    v2 = CallDirect function=f3
    v3 = CallDirect function=f4
    Return
}
function f1 name="fail" results=[{type=anything}] {
  b0():
    v0 = String string="failed"
    Throw v0
}
function f2 name="sometimes" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="more" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Boolean boolean=true
    Return v3
  b2():
    v4 = String string="failed"
    Throw v4
}
function f3 name="failWithTwoResults" results=[{type=anything}, {type=anything}] {
  b0():
    v0 = String string="failed"
    Throw v0
}
function f4 name="failWithoutNarrowing" results=[{type=anything}] {
  b0():
    v0 = String string="failed"
    Throw v0
}
