# A layout whose object reaches JSON.stringify is seen as serialized, the layouts of the expected result of a typed JSON.parse as reaching a typed parse, and no other layout has either use
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: layout L0 flow={{*}}observedUses=[Serialized] 
# CHECK: layout L1 flow={{*}}observedUses=[Serialized] 
# CHECK: layout L2 flow={{*}}observedUses=[ReachesTypedParse] 
# CHECK: layout L3 flow={{*}}observedUses=[ReachesTypedParse] 
# CHECK: layout L4 flow={baseState=None members=[L4] 
# CHECK: layout L5 flow={{*}}observedUses=[Serialized, ReachesTypedParse] 
# NOWHERE-NOT: layout L4 flow={{*}}observedUses=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=undefined|null|L2 layouts=[L2, L3]
expectedresult x1 type=L5 layouts=[L5]
layout L0 name="Serialized" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
layout L1 name="HeldBySerialized" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Parsed" fields=[{key="owner" declared={type=L3} flags=[IsRequired]}]
layout L3 name="HeldByParsed" fields=[{key="name" declared={type=string} flags=[IsRequired]}]
layout L4 name="OnlyReadByName" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L5 name="ParsedThenSerialized" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
variable g0 name="parsed" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = Builtin builtin=JSONStringify
    v4 = Call v3, -, v2
    v5 = Builtin builtin=JSONParse
    v6 = String string="{}"
    v7 = Call v5, -, v6 expectedResult=x0
    PutModuleVariable v7 variable=g0
    v9 = NewObject -, v0 layout=L4 fields=[0]
    v10 = PropGet v9 key="n"
    v11 = Call v5, -, v6 expectedResult=x1
    v12 = Call v3, -, v11
    Return
}
