# The body of an ES module runs at most once, and so does the body of a CommonJS module that cannot throw and whose cache entry nothing in the program can remove, however many sites require it
# RUN: flow
# CHECK: function f0 executions=AtMostOnce
# CHECK: function f1 executions=AtMostOnce
# CHECK: function f2 executions=AtMostOnce
# CHECK: function f3 callers=AllKnown executions=AtMostOnce
# CHECK: function f4 callers=AllKnown
# CHECK-NOT: executions=
# CHECK: function f5

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="imported.js" displayPath="imported.js" body=f1
module m2 path="required.cjs" displayPath="required.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m2
    v1 = RequireModule module=m2
    v2 = CallDirect function=f4
    v3 = CallDirect function=f4
    Return
}
function f1 name="imported" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m2
    v1 = CallDirect function=f3
    Return
}
function f2 name="required" module=m2 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
function f3 name="calledByBody" module=m1 results=[{type=anything}] {
  b0():
    Return
}
function f4 name="calledTwice" module=m0 results=[{type=anything}] {
  b0():
    Return
}
