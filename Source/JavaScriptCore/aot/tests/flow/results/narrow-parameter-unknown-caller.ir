# A closure that nativeCode can call does not widen what a call with proven arguments gets back
# RUN: flow
# RUN(ALL): flow
# STATISTIC: FlowGenericVersions = 1
# CHECK: function f1 genericVersion=[[generic]] cause=ReachesNativeCode witness={function=f0 value=v7}
# CHECK: function f2 callers=AllKnown
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: variable g0 type=L0 written=anything
# CHECK: variable g1 type=anything flow={{*}}cause=UnknownObject witness={function=f0 value=v6}}
# CHECK: function f1 parameter 0 type=L0 written=anything
# CHECK: function f1 result 0 type=L0 written=anything
# CHECK: function f2 parameter 0 type=L0 written=anything
# CHECK: function [[generic]] role=GenericVersion of f1
# ALL-NOT: function f1 callers=
# ALL-NOT: class C0 {{*}}cause=
# ALL-NOT: variable g1 {{*}}written=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="proven" declared={type=anything} initialization=Uninitialized
variable g1 name="generic" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="register" [isFreeName]
    v7 = Call v6, -, v2
    v8 = Call v2, -, v6
    PutModuleVariable v8 variable=g1
    v10 = NewClosure function=f2
    v11 = Call v10, -, v1
    v12 = CallDirect function=f3
    Return
}
function f1 name="shared" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v0
}
function f2 name="private" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    Return
}
