# An own property costs the allocation class of a built-in instance AddProperty and its pristine names, and leaves its contents proven
# RUN: flow
# RUN(ALL): flow
# CHECK: class C0 builtinClass=Array pristine=[Storage, Dense] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity,{{*}}addedKeys=["label"] addedKeysAreComplete=true
# CHECK: class C1 builtinClass=Array pristine=[Storage, Names, Dense] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity,
# CHECK: class [[labeledMap]] builtinClass=Map pristine=[Storage] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity,{{*}}addedKeys=["label"] addedKeysAreComplete=true
# CHECK: class [[plainMap]] builtinClass=Map pristine=[Storage, Names] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity,
# CHECK: variable g0 type=Map<never, never, proven, pristine[Storage]> written=anything
# CHECK: variable g1 type=Map<never, never, proven, pristine[Storage, Names]> written=anything
# CHECK: variable g2 type=Array<"t", proven, pristine[Storage, Dense]> 
# CHECK: variable g3 type=Array<"t", proven, pristine[Storage, Names, Dense]> 
# ALL-NOT: pristine=[Storage, Names] {{*}}addedKeys=[

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="labeledMap" declared={type=anything} initialization=Uninitialized
variable g1 name="plainMap" declared={type=anything} initialization=Uninitialized
variable g2 name="labeledList" declared={type=anything} initialization=Uninitialized
variable g3 name="plainList" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    PutModuleVariable v1 variable=g0
    v3 = String string="t"
    PropSet v1, v3 key="label" mode=Strict
    v5 = Construct v0
    PutModuleVariable v5 variable=g1
    v7 = NewArray v3 contents=anything holes=[]
    PutModuleVariable v7 variable=g2
    PropSet v7, v3 key="label" mode=Strict
    v10 = NewArray v3 contents=anything holes=[]
    PutModuleVariable v10 variable=g3
    Return
}
