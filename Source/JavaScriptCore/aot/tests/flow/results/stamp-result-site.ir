# A call that one overload of a built-in answers with an allocation names the site of its result, and a call that two overloads may answer names none
# RUN(SLICE): flow
# SLICE: site [[copy]] function=f1 builtinClass=Array
# SLICE-NOT: function=f1 builtinClass=Array
# SLICE: access [[slice]] function=f1 kind=Call
# SLICE: result-site [[slice]] [[copy]]
# RUN(ONE): flow
# ONE: site [[values]] function=f2 builtinClass=Array
# ONE-NOT: function=f2 builtinClass=Array
# ONE: access [[call]] function=f2 kind=Call
# ONE: result-site [[call]] [[values]]
# RUN(TWO): flow
# TWO-COUNT-2: function=f3 builtinClass=Array
# TWO: access [[either]] function=f3 kind=Call
# TWO-NOT: result-site [[either]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = String string="ab"
    v4 = CallDirect v1 function=f1
    v5 = CallDirect v2 function=f2
    v6 = CallDirect v2 function=f3
    v7 = CallDirect v3 function=f3
    Return
}
function f1 name="sliced" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="slice"
    v2 = Call v1, v0
    Return v2
}
function f2 name="oneOverload" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=ObjectValues
    v2 = Call v1, -, v0
    Return v2
}
function f3 name="twoOverloads" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=ObjectValues
    v2 = Call v1, -, v0
    Return v2
}
