# An array passed to a native call keeps its class, its contents are what flow saw and no proof, and an array from another site keeps its proof
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class C1 builtinClass=Array {{*}}impossibleMutations=[ReachUnknownJavaScript, 
# CHECK: class C3 builtinClass=Array {{*}}impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, 
# CHECK: variable g0 type=Array<{{*}}L0, Contiguous{{*}}> written=anything
# CHECK: variable g1 type=Array<L0, proven, pristine[Storage, Names, Dense]> 
# NOWHERE-NOT: variable g0 {{*}}proven

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="handedOut" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything holes=[]
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Call v5, -, v2
    v7 = NewObject -, v0 layout=L0 fields=[0]
    v8 = NewArray v7 contents=anything holes=[]
    PutModuleVariable v8 variable=g1
    Return
}
