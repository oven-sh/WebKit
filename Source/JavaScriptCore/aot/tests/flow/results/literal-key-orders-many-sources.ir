# A copy whose source may have more layouts than a walk over own keys tests lists the orders of the first layouts and records one loss
# RUN: flow
# OPTIONS: limit=MaxExpandedKeyOrders:2
# LOSS: MaxExpandedKeyOrders x1 f1
# CHECK: layout L3 flow={{*}} constructorOrders=[{fields=[1, 0]}, {fields=[2, 0]}]
# CHECK: field L3.1 "a"
# CHECK: field L3.2 "b"
# CHECK: field L3.3 "c"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything}}]
layout L1 name="Second" fields=[{key="b" declared={type=anything}}]
layout L2 name="Third" fields=[{key="c" declared={type=anything}}]
layout L3 name="CopyOfAny" fields=[{key="z" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = FinishObject v5
    v7 = Builtin builtin=MathRandom
    v8 = Call v7
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b5(v2)
  b2():
    v10 = Call v7
    v11 = ToBoolean v10
    Branch v11 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b5(v4)
  b4():
    Jump -> next b5(v6)
  b5(v12):
    v13 = CallDirect v12 function=f1
    Return
}
function f1 name="copyOfAny" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L3 fields=[]
    CopyDataProperties v1, v0
    v3 = Integer integer=7
    PropDefine v1, v3 key="z"
    v5 = FinishObject v1
    Return v5
}
