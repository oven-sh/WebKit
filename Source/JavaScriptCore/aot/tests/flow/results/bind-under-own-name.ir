# A method bound to the object under its own name hides the method: whoever reads the name after the constructor gets the bound function alone. Unknown code that is handed what the read gives calls the method with the bound object and never holds the method itself. Where the constructor binds on one path only, the read may give the method, and the method goes to unknown code with it
# RUN: flow
# RUN(NODES): flow-solve nodes
# CHECK: function f2 cause=ReachesNativeCode
# CHECK: function f4 cause=ReachesNativeCode
# CHECK: class {{*}} closureFunction=f2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK-NOT: class {{*}} closureFunction=f4 impossibleMutations=[ReachNativeCode
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: indirect - - -> f2 Host
# CHECK: function f2 this type=L0 written=anything
# CHECK-NOT: function f4 this type=L1
# NODES: Local(i{{*}}, f0, v6) = {BoundFunction@f1:v5{{*}}}
# NODES: Local(i{{*}}, f0, v18) = {f4|BoundFunction@f3:v9{{*}}}
# NODES: Local(i{{*}}, f1, v3) = {f2}
# RUN(OTHER): flow-solve nodes
# OTHER: Local(i{{*}}, f3, v7) = {f4}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Listener" constructor=f1 fields=[{key="count" declared={type=anything}}]
layout L1 kind=Instance name="SometimesBound" constructor=f3 fields=[{key="count" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="handle"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="handle"
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="publish" [isFreeName]
    v9 = Call v8, -, v6
    v10 = NewClosure function=f3
    v11 = NewClass v10 layout=L1
    v12 = NewClosure function=f4
    DefineMethod v11, v12 layout=L1 key="handle"
    v14 = FinishClass v11 layout=L1
    v15 = Builtin builtin=MathRandom
    v16 = Call v15
    v17 = Construct v14, -, v16
    v18 = PropGet v17 key="handle"
    v19 = Call v8, -, v18
    Return
}
function f1 name="Listener" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = PropGet v2 key="handle"
    v4 = PropGet v3 key="bind"
    v5 = Call v4, v3, v2 calleeKey="bind"
    PropSet v2, v5 key="handle" mode=Strict
    v7 = Integer integer=1
    PropSet v2, v7 key="count" mode=Strict
    Return v2
}
function f2 name="handle" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="count"
    Return v1
}
function f3 name="SometimesBound" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1 fields=[]
    v4 = Integer integer=1
    PropSet v3, v4 key="count" mode=Strict
    v6 = ToBoolean v1
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    v7 = PropGet v3 key="handle"
    v8 = PropGet v7 key="bind"
    v9 = Call v8, v7, v3 calleeKey="bind"
    PropSet v3, v9 key="handle" mode=Strict
    Jump -> next b2()
  b2():
    Return v3
}
function f4 name="handle" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="count"
    Return v1
}
