# A name that no module answers to fails with an object of the host, a ResolveMessage, which is no instance of the class Error: what the resolution throws is unknown, also behind an operation of the same block that throws an Error of the engine
#   function resolves() { try { null.x; return import.meta.resolveSync("./missing") } catch (error) { return error } }
# RUN: flow-apply
# CHECK-LABEL: function f1 name="resolves"
# CHECK: = ResolveDynamic
# CHECK: [[caught]]: anything = CatchValue
# CHECK-NOT: AssumeType [[caught]]

module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = PropGet v1 key="given" [isFreeName]
    v4 = Call v0, -, v3
    v5 = Call v2, -, v4
    v6 = Undefined
    Return v6
}
function f1 name="resolves" module=m0 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b2():
    v1 = RequireObjectCoercible v0 name="x"
    v2 = String string="./missing"
    v3 = ResolveDynamic v2 referrer=m0
    Return v3
  b2() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
entry module=m0
