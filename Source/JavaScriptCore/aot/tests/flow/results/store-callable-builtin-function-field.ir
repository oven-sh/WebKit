# A callable built-in stored by name is inside a field read as a function, and a built-in that cannot be called is not
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, LoseShape]
# CHECK: field L0.0 "held" type=null|builtin(ArrayPrototypePush) written=undefined|null|function {{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: layout L1 flow={
# CHECK-NOT: cause=
# CHECK: field L1.0 "held" {{*}}cause=StoreOfOtherType witness={function=f2 value=v2}}{{*}}stability=[IsNeverDeleted, IsNeverRedefined]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="HoldsMethod" fields=[{key="held" declared={type=undefined|null|function} flags=[IsRequired]}]
layout L1 name="HoldsNamespace" fields=[{key="held" declared={type=undefined|null|function} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Null
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Builtin builtin=ArrayPrototypePush
    v4 = Builtin builtin=Math
    v5 = CallDirect v1, v3 function=f1
    v6 = CallDirect v2, v4 function=f2
    Return
}
function f1 name="storeMethod" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f2 name="storeNamespace" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="held" mode=Strict
    Return
}
