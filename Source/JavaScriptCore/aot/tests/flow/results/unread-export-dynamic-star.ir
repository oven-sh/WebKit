# The run time decides which names exist from the export entries of a module with a dynamic star export, of its target and of a module a required name mentions, so their exports count as read
# RUN: flow
# CHECK: variable g0
# CHECK-NOT: reads=
# CHECK: variable g4 {{*}}reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m4}, {target=m5}] requiredNames=[{module=m4 name="d"}]
module m1 path="star.js" displayPath="star.js" body=f1 requests=[{target=m2 isDynamicStarExport=true}, {target=m3 isDynamicStarExport=true}] exports=[{name="a" variable=g0}, {name="b" variable=g1}]
module m2 path="target.js" displayPath="target.js" body=f2 exports=[{name="c" variable=g2}]
module m3 path="starred.cjs" displayPath="starred.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f3
module m4 path="required.js" displayPath="required.js" body=f4 exports=[{name="d" variable=g3}]
module m5 path="plain.js" displayPath="plain.js" body=f5 exports=[{name="e" variable=g4}]
entry module=m0
variable g0 name="a" module=m1 declared={type=anything}
variable g1 name="b" module=m1 declared={type=anything}
variable g2 name="c" module=m2 declared={type=anything}
variable g3 name="d" module=m4 declared={type=anything}
variable g4 name="e" module=m5 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return
}
function f1 name="star" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="target" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    Return
}
function f3 name="starred" module=m3 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
function f4 name="required" module=m4 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g3
    Return
}
function f5 name="plain" module=m5 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g4
    Return
}
