# With dictionary objects switched off an empty object literal that is stored under a key nobody can name keeps its layout
# RUN: flow-apply
# OPTIONS: disable=flow:DictionaryObjects
# CHECK-NOT: builtin=ObjectCreate
# CHECK: = NewObject layout=L0
# CHECK: = Data data=d0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ByString"
layout L1 name="FromData"
data d0 root=Object{layout=L1 members=[]} module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="which" [isFreeName]
    v2 = ToString v1
    v3 = Integer integer=1
    v4 = NewObject layout=L0
    ElemSet v4, v2, v3 mode=Strict
    v6 = Data data=d0
    ElemSet v6, v2, v3 mode=Strict
    Return
}
