# With predictions switched off nothing is predicted of proven contents
# OPTIONS: disable=flow:Predictions
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: variable g0 type=Array<object, proven,
# CHECK: variable g1 type=Array<Array<fractional, proven, pristine[Storage, Names, Dense]>, proven,
# NOWHERE-NOT: ~

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="losable" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="rows" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=ObjectDefineProperty
    v3 = Integer integer=0
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = Call v2, -, v1, v3, v4
    v6 = NewArray v1 contents=anything holes=[] @10
    PutModuleVariable v6 variable=g0
    v8 = Double number=0.5
    v9 = NewArray v8 contents=anything holes=[] @20
    v10 = NewArray v9 contents=anything holes=[] @30
    PutModuleVariable v10 variable=g1
    Return
}
