# A store by name on a receiver nobody knows reaches that field of each object in nativeCode, no other field, and no object that never got there. An object in nativeCode without the field may get the name, and no other name
# RUN: flow
# RUN(ALL): flow
# CHECK: class [[both]] layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty,{{*}}StoreOfOtherType, LoseShape]
# CHECK: class [[onlyY]] layout=L2 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty,{{*}}StoreAfterCreation, StoreOfOtherType, LoseShape] addedKeys=["x"] addedKeysAreComplete=true
# CHECK: class [[apart]] layout=L3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]{{*}}addedKeysAreComplete=true
# CHECK: field L0.0 "x" type=boolean written=anything{{*}}writers=AllKnown
# CHECK: field L0.1 "y" type=true written=anything{{*}}stores=AtMostOnce
# CHECK: field L1.0 "x" type=boolean written=anything
# CHECK: field L2.0 "y" type=true written=anything{{*}}stores=AtMostOnce
# CHECK: field L3.0 "x" type=true written=anything{{*}}stores=AtMostOnce
# ALL-NOT: layout=L0 {{*}}StoreAfterCreation
# ALL-NOT: layout=L2 {{*}}AddProperty
# ALL-NOT: field L0.0 {{*}}stores=
# ALL-NOT: field L1.0 {{*}}stores=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Both" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OnlyX" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="OnlyY" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Apart" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewObject -, v0 layout=L3 fields=[0]
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="keep" [isFreeName]
    v7 = Call v6, -, v1, v2, v3
    v8 = CallDirect v7 function=f1
    Return
}
function f1 name="clear" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=false
    PropSet v0, v1 key="x" mode=Strict
    Return
}
