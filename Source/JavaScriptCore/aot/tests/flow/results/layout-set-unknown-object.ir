# One object nobody knows makes the object part of the positions it reaches object, and of no other
# RUN: flow
# CHECK: class {{*}} layout=L0 impossibleMutations=[{{*}}LoseShape]
# CHECK: variable g0 type=undefined|null|object {{*}}cause=UnknownObject witness={function=f0 value=v2}
# CHECK: variable g1 type=L0 written=undefined|null|L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=0 kind=Assertion
variable g0 name="held" module=m0 declared={type=undefined|null|L0} initialization=Undefined
variable g1 name="held" module=m0 declared={type=undefined|null|L0} initialization=Undefined
layout L0 name="Shape" fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="load" [isFreeName]
    v3 = Call v2
    v4 = ClaimDeclared v3 declared={type=undefined|null|L0 site=w0}
    PutModuleVariable v4 variable=g0
    v6 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v6 variable=g1
    Return
}
