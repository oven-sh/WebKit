# A closure that is returned, stored or thrown outlives its frame, also when it passes a position typed anything on the way
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class {{*}} layout=L4 {{*}}locality=FrameLocal
# CHECK: class {{*}} closureFunction=f10 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L0 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L1 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L2 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L3 {{*}}locality=FrameLocal
# NOWHERE-NOT: closureFunction=f6 {{*}}locality=FrameLocal
# NOWHERE-NOT: closureFunction=f7 {{*}}locality=FrameLocal
# NOWHERE-NOT: closureFunction=f8 {{*}}locality=FrameLocal
# NOWHERE-NOT: closureFunction=f9 {{*}}locality=FrameLocal

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="n" declared={type=anything}}]
layout L1 kind=Environment fields=[{key="n" declared={type=anything}}]
layout L2 kind=Environment fields=[{key="n" declared={type=anything}}]
layout L3 kind=Environment fields=[{key="n" declared={type=anything}}]
layout L4 kind=Environment fields=[{key="n" declared={type=anything}}]
variable g0 name="stored" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="storedLater" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = CallDirect function=f4
    v3 = CallDirect function=f5
    v4 = CallDirect function=f3
    Return
}
function f1 name="returned" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f6
    Return v1
}
function f2 name="stored" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1 fields=[]
    v1 = NewClosure v0 function=f7
    PutModuleVariable v1 variable=g0
    Return
}
function f3 name="thrown" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L2 fields=[]
    v1 = NewClosure v0 function=f8
    Throw v1
}
function f4 name="widened" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L3 fields=[]
    v1 = NewClosure v0 function=f9
    Jump -> next b1(v1)
  b1(v2):
    PutModuleVariable v2 variable=g1
    Return
}
function f5 name="called" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L4 fields=[]
    v1 = NewClosure v0 function=f10
    v2 = Call v1
    Return
}
function f6 name="inner" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    Return
}
function f7 name="inner" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    Return
}
function f8 name="inner" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    Return
}
function f9 name="inner" kind=Arrow captures=[{type=env L3}] results=[{type=anything}] {
  b0(v0: env L3):
    Return
}
function f10 name="inner" kind=Arrow captures=[{type=env L4}] results=[{type=anything}] {
  b0(v0: env L4):
    Return
}
