# A field is never read when no operation reads it by name, no key that nobody knows can name it, nothing lists the values of its object and nativeCode never holds the object
# RUN: flow
# CHECK: field L0.0 "hidden" {{*}}reads=NeverRead
# CHECK: field L0.1 "shown"
# CHECK-NOT: reads=
# CHECK: field L1.0 "hidden"
# CHECK-NOT: reads=
# CHECK: field L2.0 "hidden"
# CHECK-NOT: reads=
# CHECK: field L3.0 "hidden"
# CHECK-NOT: reads=
# CHECK: field L4.0 "hidden" {{*}}reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Unread" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}, {key="shown" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Escaped" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}]
layout L2 name="ReadByKey" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Listed" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Neighbor" fields=[{key="hidden" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = PropGet v1 key="shown"
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v3
    v7 = NewObject -, v0 layout=L2 fields=[0]
    v8 = PropGet v4 key="which" [isFreeName]
    v9 = ToString v8
    v10 = ElemGet v7, v9
    v11 = NewObject -, v0 layout=L3 fields=[0]
    v12 = Builtin builtin=ObjectValues
    v13 = Call v12, -, v11
    v14 = NewObject -, v0 layout=L4 fields=[0]
    Return
}
