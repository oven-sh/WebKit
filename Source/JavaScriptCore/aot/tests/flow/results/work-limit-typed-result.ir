# A typed JSON.parse in a function past the work limit is an ordinary call: no typed result is published for it and its layout is never allocated. The same call in a function below the limit has its typed result, and the program builds
# OPTIONS: limit=MaxFlowWorkPerFunction:110
# LOSS: MaxFlowWorkPerFunction f1
# RUN: flow
# CHECK: builtin-use JSONParse [Read, Called, Escaped] f1
# CHECK-NOT: typed-result S
# CHECK: typed-result [[call]] L3
# CHECK-NOT: typed-result S
# CHECK: typed-result-site L3
# CHECK-NOT: typed-result-site
# CHECK: layout L2 flow={allocation=NeverAllocated
# CHECK: layout L3 flow={{*}}observedUses=[ReachesTypedParse]
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L2 layouts=[L2]
expectedresult x1 type=L3 layouts=[L3]
layout L0 name="BusyBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="IdleBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="ParsedByBusy" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
layout L3 name="ParsedByIdle" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = CallDirect v3 function=f2
    Return
}
function f1 name="busy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
    v11 = PropGet v0 key="x"
    v12 = PropGet v0 key="x"
    v13 = PropGet v0 key="x"
    v14 = PropGet v0 key="x"
    v15 = PropGet v0 key="x"
    v16 = PropGet v0 key="x"
    v17 = PropGet v0 key="x"
    v18 = PropGet v0 key="x"
    v19 = PropGet v0 key="x"
    v20 = PropGet v0 key="x"
    v21 = PropGet v0 key="x"
    v22 = PropGet v0 key="x"
    v23 = PropGet v0 key="x"
    v24 = PropGet v0 key="x"
    v25 = PropGet v0 key="x"
    v26 = PropGet v0 key="x"
    v27 = PropGet v0 key="x"
    v28 = PropGet v0 key="x"
    v29 = PropGet v0 key="x"
    v30 = PropGet v0 key="x"
    v31 = PropGet v0 key="x"
    v32 = PropGet v0 key="x"
    v33 = PropGet v0 key="x"
    v34 = PropGet v0 key="x"
    v35 = PropGet v0 key="x"
    v36 = PropGet v0 key="x"
    v37 = PropGet v0 key="x"
    v38 = PropGet v0 key="x"
    v39 = PropGet v0 key="x"
    v40 = PropGet v0 key="x"
    v41 = PropGet v0 key="x"
    v42 = PropGet v0 key="x"
    v43 = PropGet v0 key="x"
    v44 = PropGet v0 key="x"
    v45 = PropGet v0 key="x"
    v46 = PropGet v0 key="x"
    v47 = PropGet v0 key="x"
    v48 = PropGet v0 key="x"
    v49 = PropGet v0 key="x"
    v50 = PropGet v0 key="x"
    v51 = PropGet v0 key="x"
    v52 = PropGet v0 key="x"
    v53 = PropGet v0 key="x"
    v54 = PropGet v0 key="x"
    v55 = PropGet v0 key="x"
    v56 = PropGet v0 key="x"
    v57 = PropGet v0 key="x"
    v58 = PropGet v0 key="x"
    v59 = PropGet v0 key="x"
    v60 = PropGet v0 key="x"
    v61 = Builtin builtin=JSONParse
    v62 = String string="{}"
    v63 = Call v61, -, v62 expectedResult=x0
    v64 = PropGet v63 key="n"
    Return v64
}
function f2 name="idle" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=JSONParse
    v2 = String string="{}"
    v3 = Call v1, -, v2 expectedResult=x1
    v4 = PropGet v3 key="n"
    Return v4
}
