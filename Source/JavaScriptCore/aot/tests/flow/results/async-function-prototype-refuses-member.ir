# The prototype of async functions is closed to every string key, as Function.prototype is: a store that would add a member to it is refused, so the name stays absent on a closure of an async function, like a name that nobody stores, and a member of Function.prototype is found behind it
# RUN: flow
# CHECK: builtin-location AsyncFunctionPrototype."extra" Constant written at f0:v3
# CHECK: variable g0 type=undefined written=anything
# CHECK: variable g1 type=undefined written=anything
# CHECK: variable g2 type=builtin(FunctionPrototypeBind) written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="refused" declared={type=anything} initialization=Uninitialized
variable g1 name="absent" declared={type=anything} initialization=Uninitialized
variable g2 name="inherited" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=AsyncFunctionPrototype
    v2 = NewClosure function=f2
    PropSet v1, v2 key="extra" mode=Strict
    v4 = PropGet v0 key="extra"
    PutModuleVariable v4 variable=g0
    v6 = PropGet v0 key="other"
    PutModuleVariable v6 variable=g1
    v8 = PropGet v0 key="bind"
    PutModuleVariable v8 variable=g2
    Return
}
function f1 name="later" flags=[IsAsync] results=[{type=anything}] {
  b0():
    Return
}
function f2 name="extra" results=[{type=anything}] {
  b0():
    Return
}
