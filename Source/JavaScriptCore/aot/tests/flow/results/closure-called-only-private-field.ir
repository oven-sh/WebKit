# A private field becomes an own property of whatever object receives it, so a closure that receives one is not called only
# RUN: flow
# CHECK: function f2 {{*}}closureUse=CalledOnly
# RUN(OTHER): flow
# OTHER-NOT: function f1 reachability
# OTHER-NOT: function f1 {{*}}closureUse

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Tagger" fields=[{key=#"tag"@L0 declared={type=anything} flags=[IsPrivate]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClassToken layout=L0
    v3 = Boolean boolean=true
    PrivateDefine v0, v2, v3 layout=L0 field=0
    v5 = NewClosure function=f2
    v6 = Call v5
    Return
}
function f1 name="tagged" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="apart" results=[{type=anything}] {
  b0():
    Return
}
