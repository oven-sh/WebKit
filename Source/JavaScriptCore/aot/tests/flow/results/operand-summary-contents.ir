# What happens to a loaded value counts for the receiver as a use of its contents, and a load whose value is only inspected costs the receiver nothing
# RUN: flow
# CHECK: function f1 parameter 0 uses=[Inspects] 
# CHECK: function f2 parameter 0 uses=[Inspects, RetainsContents, AppliesTransitively] 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    Return
}
function f1 name="inspected" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = ToBoolean v1
    Return
}
function f2 name="stored" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    PutModuleVariable v1 variable=g0
    Return
}
