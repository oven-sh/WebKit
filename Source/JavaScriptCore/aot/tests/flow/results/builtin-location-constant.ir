# A built-in location that reached code mentions and never writes is constant, and a member nobody mentions has no line
# RUN: flow
# STATISTIC: FlowConstantBuiltinLocations >= 4
# STATISTIC: FlowWrittenBuiltinLocations = 0
# CHECK: builtin-location GlobalThis."Math" Constant
# CHECK: builtin-location GlobalThis."console" Constant
# CHECK: builtin-location Math."max" Constant
# CHECK: builtin-location Console."log" Constant
# RUN(UNMENTIONED): flow
# UNMENTIONED-NOT: builtin-location GlobalThis."JSON"
# UNMENTIONED-NOT: builtin-location Math."min"
# UNMENTIONED-NOT: builtin-location Console."warn"
# UNMENTIONED-NOT: written at

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Math" [isFreeName]
    v2 = PropGet v1 key="max"
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = Call v2, v1, v3, v4
    v6 = PropGet v0 key="console" [isFreeName]
    v7 = PropGet v6 key="log"
    v8 = Call v7, v6, v5
    Return
}
