# An unknown object, an array or a closure among the receivers leaves the layouts in the stamp and makes it incomplete, and the site names its loss
# RUN: flow-apply
# RUN(FLOW): flow
# LOSS: MinNarrowedUsesForGenericVersion x1 f1
# FLOW: access [[unknown]] function=f1 kind=Read loss cause=UnknownObject witness=f0:v3
# FLOW: access [[array]] function=f2 kind=Read loss cause=NonLayoutObject
# FLOW: access [[closure]] function=f3 kind=Read loss cause=NonLayoutObject
# FLOW: access [[alone]] function=f4 kind=Read loss cause=NonLayoutObject
# FLOW: access [[complete]] function=f5 kind=Read
# FLOW-NOT: loss

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Circle" fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="outside" [isFreeName]
    v4 = NewArray v0 contents=anything holes=[]
    v5 = NewClosure function=f6
    v6 = CallDirect v1 function=f1
    v7 = CallDirect v3 function=f1
    v8 = CallDirect v1 function=f2
    v9 = CallDirect v4 function=f2
    v10 = CallDirect v1 function=f3
    v11 = CallDirect v5 function=f3
    v12 = CallDirect v4 function=f4
    v13 = CallDirect v1 function=f5
    Return
}
function f1 name="unknownObjectAmongReceivers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
# CHECK-LABEL: function f1 name="unknownObjectAmongReceivers"
# CHECK: = PropGet v0 key="size" accessSite={{*}} receivers=[L0, ..]
function f2 name="arrayAmongReceivers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
# CHECK-LABEL: function f2 name="arrayAmongReceivers"
# CHECK: = PropGet v0 key="size" accessSite={{*}} receivers=[L0, ..]
function f3 name="closureAmongReceivers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
# CHECK-LABEL: function f3 name="closureAmongReceivers"
# CHECK: = PropGet v0 key="size" accessSite={{*}} receivers=[L0, ..]
function f4 name="noLayoutAmongReceivers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
# CHECK-LABEL: function f4 name="noLayoutAmongReceivers"
# CHECK: = PropGet v0 key="size" accessSite=
# CHECK-NOT: receivers=
function f5 name="onlyTheLayout" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="size"
    Return v1
}
# CHECK-LABEL: function f5 name="onlyTheLayout"
# CHECK: = PropGet v0 key="size" accessSite={{*}} receivers=[L0]
function f6 name="callback" results=[{type=anything}] {
  b0():
    Return
}
