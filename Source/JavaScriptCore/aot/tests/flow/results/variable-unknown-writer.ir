# A variable that evaluated text can name, and a static field whose class object reaches unknownJavaScript, have an unknown writer; a namespace object gives nobody a way to write, and each neighbor keeps its known writers
# RUN: flow
# CHECK: variable g0 {{*}}flow={writers=AllKnown
# CHECK: variable g1 {{*}}flow={writers=AllKnown
# CHECK: variable g2
# CHECK-NOT: writers=
# CHECK: cause=UnknownWriter witness={function=f0 value=v10}
# CHECK: variable g3 {{*}}flow={writers=AllKnown
# CHECK: variable g4
# CHECK-NOT: writers=
# CHECK: cause=UnknownWriter witness={function=f0 value=[[escape]]}
# CHECK: variable g5 {{*}}flow={writers=AllKnown

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="shared.js" displayPath="shared.js" body=f1 exports=[{name="shared" variable=g0}]
entry module=m0
evalscope e0 mode=Strict bindings=[{name="named" variable=g2}]
layout L0 kind=Instance name="Escaped" constructor=f2 staticFields=[{key="count" variable=g4}]
layout L1 kind=Instance name="Kept" constructor=f3 staticFields=[{key="count" variable=g5}]
variable g0 name="shared" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="hidden" module=m1 declared={type=anything} initialization=Undefined
variable g2 name="named" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="unnamed" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="count" module=m0 declared={type=anything} initialization=Undefined owner=L0
variable g5 name="count" module=m0 declared={type=anything} initialization=Undefined owner=L1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = ModuleNamespace module=m1
    v5 = Call v3, -, v4
    v6 = Integer integer=1
    PutModuleVariable v6 variable=g2
    PutModuleVariable v6 variable=g3
    v9 = Undefined
    v10 = DirectEval v1, v9 evalScope=e0
    v11 = NewClosure function=f2
    v12 = NewClass v11 layout=L0
    PutModuleVariable v6 variable=g4
    v14 = FinishClass v12 layout=L0
    v15 = Call v3, -, v14
    v16 = NewClosure function=f3
    v17 = NewClass v16 layout=L1
    PutModuleVariable v6 variable=g5
    v19 = FinishClass v17 layout=L1
    Return
}
function f1 name="shared" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="Escaped" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f3 name="Kept" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
