# With every flow result switched off the program leaves ApplyFlowResults as it was read
# OPTIONS: disable=flow-results
# RUN: flow-apply
# CHECK: layout L0 name="Point" fields=[{key="x" declared={type=anything} flow={location={cause=ResultDisabled}}}] ownFieldCount=1 flow={baseState=None allocationClasses=[0] cause=ResultDisabled}
# CHECK: variable g0 name="point" module=m0 declared={type=anything} flow={cause=ResultDisabled}
# CHECK: v1: object ~ L0 = NewObject -, v0 layout=L0 fields=[0]
# CHECK: v4: anything = Call v3, -, v1 accessSite=0
# CHECK-NEXT: [[claim]]: undefined|null|object = Claim v4 castType=undefined|null|object site=w0 cause=ResultDisabled
# CHECK: function f1 name="identity"{{*}}parameters=[{type=anything}] results=[{type=anything}]
# CHECK: string="unreached"
# RUN(NOTHING): flow-apply
# NOTHING-NOT: written=
# NOTHING-NOT: AssumeType
# NOTHING-NOT: receivers=
# NOTHING-NOT: callees=
# NOTHING-NOT: keepsShape
# NOTHING-NOT: EvaluatesAtMostOnce
# NOTHING-NOT: role=GenericVersion
# RUN(FLOW): flow
# FLOW: function f0 cause=ResultDisabled
# FLOW-NEXT: function f1 cause=ResultDisabled
# FLOW-NEXT: function f2 cause=ResultDisabled
# FLOW: class C0 layout=L0 cause=ResultDisabled
# FLOW-NEXT: class C1 closureFunction=f1
# FLOW-NEXT: class C2 closureFunction=f2
# FLOW-NEXT: class C3
# FLOW: access S0 function=f0 kind=Call loss cause=ResultDisabled
# FLOW: unseen-code FlowResultDisabled
# FLOW: layout L0 flow={baseState=None allocationClasses=[0] cause=ResultDisabled}
# FLOW-NEXT: field L0.0 "x" type=anything flow={location={cause=ResultDisabled}}
# FLOW: variable g0 type=anything flow={cause=ResultDisabled}
# FLOW-NOT: function f

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 kind=CallResult
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]
variable g0 name="point" declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="x"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    v4 = Call v3, -, v1
    v5 = ClaimDeclared v4 declared={type=undefined|null|L0 site=w0}
    v6 = NewClosure function=f2
    Return
}
function f1 name="identity" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="unreached" results=[{type=anything}] {
  b0():
    v0 = String string="unreached"
    Return v0
}
