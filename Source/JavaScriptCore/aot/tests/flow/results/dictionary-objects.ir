# An empty object literal that gets properties under a computed key nobody can name, or under an index, is created as an ordinary object. A literal that is stored under names only, has a field, lies inside a data tree, only gets copies of the properties of objects that flow knows, or is only handed to code nobody sees keeps its layout. A literal that begins with a copy of keys nobody can name: literals-filled-by-copies.ir
# RUN: flow-apply
# RUN(CLASSES): flow
# CHECK-LABEL: function f0 name="main"
# CHECK: [[create]]: builtin(ObjectCreate) = Builtin builtin=ObjectCreate
# CHECK-NEXT: [[prototype]]: builtin(ObjectPrototype) = Builtin builtin=ObjectPrototype
# CHECK-NEXT: [[created]]: anything = Call [[create]], -, [[prototype]]
# CHECK-NEXT: [[byString]]: object = AssumeType [[created]] castType=object
# CHECK-NEXT: ElemSet [[byString]], v2, v3
# CHECK: [[createForData]]: builtin(ObjectCreate) = Builtin builtin=ObjectCreate
# CHECK-NEXT: [[prototypeForData]]: builtin(ObjectPrototype) = Builtin builtin=ObjectPrototype
# CHECK-NEXT: [[createdForData]]: anything = Call [[createForData]], -, [[prototypeForData]]
# CHECK-NEXT: [[fromData]]: object = AssumeType [[createdForData]] castType=object
# CHECK-NEXT: ElemSet [[fromData]], v2, v3
# CHECK: [[createForIndex]]: builtin(ObjectCreate) = Builtin builtin=ObjectCreate
# CHECK-NEXT: [[prototypeForIndex]]: builtin(ObjectPrototype) = Builtin builtin=ObjectPrototype
# CHECK-NEXT: [[createdForIndex]]: anything = Call [[createForIndex]], -, [[prototypeForIndex]]
# CHECK-NEXT: [[byIndex]]: object = AssumeType [[createdForIndex]] castType=object
# CHECK-NEXT: ElemSet [[byIndex]], v3, v3
# CHECK: [[createdByDefinition]]: anything = Call
# CHECK-NEXT: [[byDefinition]]: object = AssumeType [[createdByDefinition]] castType=object
# CHECK-NEXT: ElemDefine [[byDefinition]], v2, v3
# CHECK-NEXT: = FinishObject [[byDefinition]]
# CHECK-NOT: builtin=ObjectCreate
# CHECK: = NewObject layout=L3
# CHECK: = NewObject -, v3 layout=L4 fields=[0]
# CHECK: = Data data=d1
# CHECK: = NewObject layout=L7
# CHECK: [[createdAndPassedOn]]: anything = Call
# CHECK-NEXT: [[passedOn]]: object = AssumeType [[createdAndPassedOn]] castType=object
# CHECK-NEXT: ElemSet [[passedOn]], v3, v3
# CHECK: = Call {{*}}, {{*}}, [[passedOn]], v3
# CHECK-NOT: builtin=ObjectCreate
# CHECK: = NewObject layout=L10
# `{ type: 1, ...unknown }`, `{ type: 1 }` stored under a computed key afterwards and `{ get type() {}, [key]: 1 }`
# CHECK: = NewObject layout=L11
# CHECK: = NewObject layout=L12
# CHECK: = NewObject layout=L13
# CLASSES: class C{{*}} layout=L0 {{*}}cause=NonLayoutObject
# CLASSES: class C{{*}} layout=L1 {{*}}cause=NonLayoutObject
# CLASSES: class C{{*}} layout=L2 {{*}}cause=NonLayoutObject
# CLASSES-NEXT: class C{{*}} layout=L8 {{*}}cause=NonLayoutObject
# CLASSES-NEXT: class C{{*}} layout=L3 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L4 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L5 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L6 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L7 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L9 {{*}}cause=NonLayoutObject
# CLASSES-NEXT: class C{{*}} layout=L10 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L11 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L12 impossibleMutations=[
# CLASSES-NEXT: class C{{*}} layout=L13 impossibleMutations=[
# CLASSES: layout L0 flow={allocation=NeverAllocated
# CLASSES: layout L1 flow={allocation=NeverAllocated
# CLASSES: layout L2 flow={allocation=NeverAllocated
# CLASSES-NEXT: layout L3 flow={baseState=None members=[L3]
# CLASSES: layout L4 flow={baseState=None members=[L4]
# CLASSES: layout L6 flow={baseState=None members=[L6]
# CLASSES: layout L7 flow={baseState=None members=[L7]
# CLASSES: layout L8 flow={allocation=NeverAllocated
# CLASSES-NEXT: layout L9 flow={allocation=NeverAllocated

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ByString"
layout L1 name="FromData"
layout L2 name="ByIndex"
layout L3 name="ByName"
layout L4 name="WithField" fields=[{key="total" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Holder" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
layout L6 name="Inner"
layout L7 name="Copy"
layout L8 name="ByDefinition"
layout L9 name="ByIndexAndTestedThroughCall"
layout L10 name="OnlyPassedToUnknownCode"
layout L11 name="NamesThenSpread"
layout L12 name="NamesThenComputedStore"
layout L13 name="GetterThenComputedDefinition"
data d0 root=Object{layout=L1 members=[]} module=m0
data d1 root=Object{layout=L5 members=[{key="inner" value=Object{layout=L6 members=[]}}]} module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="which" [isFreeName]
    v2 = ToString v1
    v3 = Integer integer=1
    v4 = NewObject layout=L0
    ElemSet v4, v2, v3 mode=Strict
    v6 = Data data=d0
    ElemSet v6, v2, v3 mode=Strict
    v8 = NewObject layout=L2
    ElemSet v8, v3, v3 mode=Strict
    v10 = NewObject layout=L8
    ElemDefine v10, v2, v3
    v12 = FinishObject v10
    v13 = NewObject layout=L3
    PropSet v13, v3 key="a" mode=Strict
    v15 = NewObject -, v3 layout=L4 fields=[0]
    ElemSet v15, v2, v3 mode=Strict
    v17 = Data data=d1
    v18 = PropGet v17 key="inner"
    ElemSet v18, v2, v3 mode=Strict
    v20 = NewObject layout=L7
    CopyDataProperties v20, v13
    v22 = NewObject layout=L9
    ElemSet v22, v3, v3 mode=Strict
    v24 = Builtin builtin=ObjectPrototypeHasOwnProperty
    v25 = PropGet v24 key="call"
    v26 = Call v25, v24, v22, v3
    v27 = NewObject layout=L10
    v28 = Call v1, -, v27
    v29 = NewObject layout=L11
    PropDefine v29, v3 key="type"
    PropDefine v29, v3 key="check"
    CopyDataProperties v29, v1
    v33 = FinishObject v29
    v34 = NewObject layout=L12
    PropDefine v34, v3 key="type"
    v36 = FinishObject v34
    ElemSet v36, v2, v3 mode=Strict
    v38 = NewObject layout=L13
    v39 = NewClosure function=f1
    DefineGetter v38, v39 key="type"
    ElemDefine v38, v2, v3
    v42 = FinishObject v38
    Return
}
function f1 name="type" results=[{type=anything}] {
  b0():
    Return
}
