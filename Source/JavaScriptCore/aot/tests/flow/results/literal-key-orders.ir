# A literal that is completed by pieces lists its keys in the order in which its definitions and the objects it copies create them
# RUN: flow
# CHECK: layout L0 flow={{*}} constructorOrders=[{fields=[0, 1, 2]}] fieldCreation=OnlyAtConstruction
# CHECK: layout L1 flow={{*}} constructorOrders=[{fields=[0, 1, 2]}]
# CHECK: field L1.1 "b" {{*}}flags=[IsAppendedByFlow]
# CHECK: layout L2 flow={{*}} constructorOrders=[{fields=[1, 2, 3, 0]}]
# CHECK: layout L3 flow={{*}} constructorOrders=[{fields=[0, 1]}]
# CHECK: field L3.0 "b"
# CHECK: field L3.1 "c"
# CHECK-NOT: layout L4 flow={{*}}constructorOrders
# CHECK-NOT: layout L5 flow={{*}}constructorOrders
# CHECK: layout L6 flow={{*}} constructorOrders=[{}]
# CHECK: layout L7 flow={{*}} constructorOrders=[{fields=[1, 0]}] fieldCreation=OnlyAtConstruction
# CHECK: layout L8 flow={{*}} constructorOrders=[{fields=[1, 2, 3, 0]}, {fields=[0]}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source" fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}, {key="c" declared={type=anything}}]
layout L1 name="CopyThenReplace" fields=[{key="a" declared={type=anything}}]
layout L2 name="CopyThenAdd" fields=[{key="z" declared={type=anything}}]
layout L3 name="Rest"
layout L4 name="ComputedKeyBetween" fields=[{key="z" declared={type=anything}}]
layout L5 name="CopyOfUnknownObject" fields=[{key="z" declared={type=anything}}]
layout L6 name="Empty"
layout L7 name="ListedThenCopy" fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}]
layout L8 name="CopyOfObjectOrNothing" fields=[{key="z" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0, v0 layout=L0 fields=[0, 1, 2]
    v2 = FinishObject v1
    v3 = CallDirect v2 function=f1
    v4 = CallDirect v3 function=f1
    v5 = CallDirect v2 function=f2
    v6 = CallDirect v2 function=f3
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = CallDirect v2, v8 function=f4
    v10 = CallDirect v8 function=f5
    v11 = CallDirect function=f6
    v12 = Builtin builtin=MathRandom
    v13 = Call v12
    v14 = CallDirect v2, v13 function=f7
    Return
}
function f1 name="copyThenReplace" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L1 fields=[]
    CopyDataProperties v1, v0
    v3 = Integer integer=7
    PropDefine v1, v3 key="a"
    v5 = FinishObject v1
    Return v5
}
function f2 name="copyThenAdd" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L2 fields=[]
    CopyDataProperties v1, v0
    v3 = Integer integer=7
    PropDefine v1, v3 key="z"
    v5 = FinishObject v1
    Return v5
}
function f3 name="rest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L3 fields=[]
    CopyDataProperties v1, v0 excludedKeys=["a"]
    v3 = FinishObject v1
    Return v3
}
function f4 name="computedKeyBetween" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L4 fields=[]
    CopyDataProperties v2, v0
    v4 = Integer integer=7
    ElemDefine v2, v1, v4
    PropDefine v2, v4 key="z"
    v7 = FinishObject v2
    Return v7
}
function f5 name="copyOfUnknownObject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L5 fields=[]
    CopyDataProperties v1, v0
    v3 = Integer integer=7
    PropDefine v1, v3 key="z"
    v5 = FinishObject v1
    Return v5
}
function f6 name="listedThenCopy" results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    v1 = NewObject -, v0, v0 layout=L7 fields=[1, 0]
    v2 = NewObject layout=L6 fields=[]
    v3 = FinishObject v2
    CopyDataProperties v1, v3
    v5 = FinishObject v1
    Return v5
}
function f7 name="copyOfObjectOrNothing" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Undefined
    v3 = ToBoolean v1
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v2)
  b3(v4):
    v5 = NewObject layout=L8 fields=[]
    CopyDataProperties v5, v4
    v7 = Integer integer=7
    PropDefine v5, v7 key="z"
    v9 = FinishObject v5
    Return v9
}
