# What a built-in does to the receiver of a method call comes from its table alone: the method is found on the prototype and is no part of the receiver. A receiver that the built-in returns also has the uses of the result
# RUN: flow
# RUN(ALL): flow
# CHECK: function f1 parameter 0 uses=[Inspects, ReadsContents, WritesContents] 
# CHECK: function f2 parameter 0 uses=[Inspects, ReadsContents, WritesContents, MovesElements] 
# CHECK: function f3 parameter 0 uses=[Inspects, Retains, ReadsContents, WritesContents, MovesElements] 
# CHECK: function f4 parameter 0 uses=[Inspects, ReadsContents] 
# ALL-NOT: function f1 parameter 0 uses=[{{*}}Ret{{*}}] retainedIn
# ALL-NOT: function f2 parameter 0 uses=[{{*}}Ret{{*}}] retainedIn
# ALL-NOT: function f4 parameter 0 uses=[{{*}}Ret{{*}}] retainedIn

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = CallDirect v1, v0 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect v1, v0 function=f4
    Return
}
function f1 name="add" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1
    Return
}
function f2 name="flip" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="reverse"
    v2 = Call v1, v0
    Return
}
function f3 name="flipAndKeep" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="reverse"
    v2 = Call v1, v0
    PutModuleVariable v2 variable=g0
