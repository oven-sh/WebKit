# After Object.setPrototypeOf(Failure, Plain) the super call of a class that extends Error constructs a compiled base constructor, whose allocation is handed the prototype object of Failure. A class whose chain ends in a built-in class is below no compiled constructor, so the run time answers with an ordinary object: the allocation in Plain makes no compiled object of the layout either, the layout gets no slots, and what has the type of the layout is a cell of the built-in class.
# RUN: flow
# RUN(SLOTS): plan-slots layouts
# OPTIONS: disable=flow:CallVersions
# CHECK: site {{*}} function=f1 layout=L0 builtinClass=Error allocationClass=
# CHECK: site {{*}} function=f2 layout=L0 allocationClass=
# CHECK: layout L0 flow={allocation=NeverAllocated baseState=BuiltinClass baseClass=Error
# CHECK-NOT: allocationClasses=[
# CHECK: classFlow=
# SLOTS-NOT: L0 CompiledObject
# SLOTS: L1 CompiledObject

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Failure" module=m0 constructor=f1 fields=[{key="cursor" declared={type=anything}}] flags=[HasHeritage]
layout L1 kind=Instance name="Plain" module=m0 constructor=f2 fields=[{key="plain" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Error" [isFreeName]
    v2 = NewClosure function=f1
    v3 = ResolveHeritage v1
    v4 = NewClass v2, v1, v3 layout=L0
    v5 = FinishClass v4 layout=L0
    v6 = NewClosure function=f2
    v7 = NewClass v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v5
    v10 = Construct v8
    v11 = Builtin builtin=ObjectSetPrototypeOf
    v12 = Call v11, -, v5, v8
    v13 = Construct v5
    Return
}
function f1 name="Failure" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = Integer integer=0
    PropDefine v3, v4 key="cursor"
    Return v3
}
function f2 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    v3 = Boolean boolean=true
    PropDefine v2, v3 key="plain"
    Return v2
}
