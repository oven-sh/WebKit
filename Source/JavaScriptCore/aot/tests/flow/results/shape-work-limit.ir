# The objects that a function past the work limit allocates may lose their shape, each of its allocation classes says so, and a class of the same layout that another function allocates keeps its shape
# RUN: flow
# OPTIONS: limit=MaxFlowWorkPerFunction:24
# LOSS: MaxFlowWorkPerFunction f1
# CHECK: class [[first]] layout=L0 cause=LimitReached witness={function=f1 value=v1}
# CHECK: class [[second]] layout=L0 cause=LimitReached witness={function=f1 value=v3}
# CHECK: class [[kept]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK-NOT: cause=
# CHECK: class
# CHECK-NOT: unseen-code
# CHECK: unseen-code LimitReached f1
# CHECK-NOT: unseen-code
# CHECK: layout L0 flow={{*}}cause=LimitReached witness={function=f1 value=v1}
# CHECK: variable g0 type=object predicted=L0 written=anything {{*}}cause=LimitReached
# CHECK: variable g1 type=object predicted=L0 written=anything {{*}}cause=LimitReached
# CHECK: variable g2 type=L0 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="busy" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = PropGet v1 key="x"
    v6 = PropGet v3 key="x"
    v7 = PropGet v1 key="x"
    v8 = PropGet v3 key="x"
    v9 = PropGet v1 key="x"
    v10 = PropGet v3 key="x"
    v11 = PropGet v1 key="x"
    v12 = PropGet v3 key="x"
    Return
}
function f2 name="idle" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g2
    Return
}
