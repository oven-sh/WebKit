# A helper that the compiled function of a built-in calls directly is analyzed once for each call of the built-in, in a library module and in any other. What goes through a variable is joined
# RUN: flow
# CHECK: variable g0 type=L0 written=anything
# CHECK: variable g1 type=L1 written=anything
# CHECK: variable g2 type=L0 written=anything
# CHECK: variable g3 type=L1 written=anything
# CHECK: variable g4 type=L0|L1 written=anything
# CHECK: variable g5 type=L0|L1 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="library.js" displayPath="library.js" flags=[IsLibrary]
entry module=m0
layout L0 name="First" fields=[{key="length" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="length" declared={type=anything} flags=[IsRequired]}]
variable g0 name="firstThroughLibrary" declared={type=anything}
variable g1 name="secondThroughLibrary" declared={type=anything}
variable g2 name="firstThroughProgram" declared={type=anything}
variable g3 name="secondThroughProgram" declared={type=anything}
variable g4 name="firstThroughVariable" declared={type=anything}
variable g5 name="secondThroughVariable" declared={type=anything}
variable g6 name="shared" module=m1 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewClosure function=f8
    v4 = NewArray v0 contents=anything holes=[]
    v5 = PropGet v4 key="find"
    v6 = Call v5, v4, v3, v1 calleeKey="find"
    PutModuleVariable v6 variable=g0
    v8 = Call v5, v4, v3, v2 calleeKey="find"
    PutModuleVariable v8 variable=g1
    v10 = PropGet v4 key="every"
    v11 = Call v10, v4, v3, v1 calleeKey="every"
    PutModuleVariable v11 variable=g2
    v13 = Call v10, v4, v3, v2 calleeKey="every"
    PutModuleVariable v13 variable=g3
    v15 = PropGet v4 key="some"
    v16 = Call v15, v4, v3, v1 calleeKey="some"
    PutModuleVariable v16 variable=g4
    v18 = Call v15, v4, v3, v2 calleeKey="some"
    PutModuleVariable v18 variable=g5
    Return
}
function f1 name="find" module=m1 role=Library enclosingRuntimeFunction=36 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v1 function=f2
    Return v2
}
function f2 name="libraryHelper" module=m1 role=Library enclosingRuntimeFunction=36 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="every" module=m1 role=Library enclosingRuntimeFunction=32 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v1 function=f4
    Return v2
}
function f4 name="programHelper" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="some" module=m1 role=Library enclosingRuntimeFunction=90 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v1 function=f6
    Return v2
}
function f6 name="helperWithVariable" module=m1 role=Library enclosingRuntimeFunction=90 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g6
    v2 = CallDirect function=f7
    Return v2
}
function f7 name="readVariable" module=m1 role=Library enclosingRuntimeFunction=90 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g6
    Return v0
}
function f8 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
runtimefunction id=32 function=f3
runtimefunction id=36 function=f1
runtimefunction id=90 function=f5
