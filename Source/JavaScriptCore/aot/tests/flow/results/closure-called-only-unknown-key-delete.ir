# A delete under an unknown key may remove an own property of the closure, so it is not called only
# RUN: flow
# CHECK: function f2 {{*}}closureUse=CalledOnly
# RUN(OTHER): flow
# OTHER-NOT: function f1 reachability
# OTHER-NOT: function f1 {{*}}closureUse

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="which" [isFreeName]
    v4 = ToString v3
    v5 = ElemDelete v0, v4 mode=Strict
    v6 = NewClosure function=f2
    v7 = Call v6
    Return
}
function f1 name="deletedFrom" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="apart" results=[{type=anything}] {
  b0():
    Return
}
