# A store of a value outside the type of a static field moves the field out of its variable at run time, so the variable has a writer that flow does not list: a read through the class object is not the variable's value
#   class Counter { static count: number = 1; static kept: number = 5 }  (Counter as any).count = "x"; (Counter as any).kept = 6; print((Counter as any).count, (Counter as any).kept)
# RUN: flow
# CHECK: variable g1 type=1 {{*}}flow={initialization=StoredBeforeEveryRead cause=StoreOfOtherType
# CHECK-NEXT: variable g2 type=int[5, 6] {{*}}flow={writers=AllKnown
# RUN(FINAL): pipeline CheckPlacement
# FINAL-LABEL: function f0
# FINAL: PropSet {{*}}key="count"
# FINAL: PutModuleVariable {{*}}variable=g2
# FINAL: [[unchanged]]: boolean = IsMemberUnchanged layout=L0 side=Static key="count"
# FINAL: TestAndBranch [[unchanged]]
# FINAL: PropGet {{*}}key="count"
# FINAL: GetModuleVariable variable=g2

typesite w0 module=m0 position=75 kind=StaticField
typesite w1 module=m0 position=101 kind=StaticField
layout L0 kind=Instance name="Counter" module=m0 position=58 constructor=f1 staticFields=[{key="count" variable=g1}, {key="kept" variable=g2}]
variable g0 module=m0 declared={type=function} flags=[IsImmutable]
variable g1 module=m0 declared={type=undefined|null|number predicted=number site=w0} owner=L0
variable g2 module=m0 declared={type=undefined|null|number predicted=number site=w1} owner=L0
module m0 path="main.ts" displayPath="main.ts" body=f0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1() @0
  b1():
    v0 = NewClosure function=f1 @52
    v1 = NewClass v0 layout=L0 @52
    PutModuleVariable v1 variable=g0 @52
    v3 = FinishClass v1 layout=L0 @52
    v4 = ClaimDeclared v3 declared={type=function} @52
    v5 = ClaimDeclared v3 declared={type=function} @52
    v6 = CallDirect v5 function=f2 @52
    v7 = ClaimDeclared v3 declared={type=function} @52
    v8 = String string="x" @146
    PropSet v7, v8 key="count" @121
    v10 = Integer integer=6 @175
    PropSet v7, v10 key="kept" @151
    v12 = Builtin builtin=GlobalThis @178
    v13 = PropGet v12 key="print" [isFreeName] @178
    v14 = Predict v13 predicted=function @178
    v15 = PropGet v7 key="count" @185
    v16 = PropGet v7 key="kept" @209
    v17 = Call v14, -, v15, v16 calleeName="print" @178
    v18 = Undefined @178
    Return v18 @178
}
function f1 name="Counter" module=m0 position=58 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] thisType={type=anything} results=[{type=object}] {
  b0(v0: anything):
    Jump -> next b1() @58
  b1():
    v1 = GetConstructPrototype v0 layout=L0 @52
    v2 = NewObject v1 layout=L0 @52
    Return v2 @52
}
function f2 module=m0 position=58 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=function} results=[{type=anything}] {
  b0(v0: function):
    Jump -> next b1() @58
  b1():
    v1 = Integer integer=1 @91
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number site=w0} @91
    PropDefine v0, v2 key="count" @75
    v4 = Integer integer=5 @116
    v5 = ClaimDeclared v4 declared={type=undefined|null|number predicted=number site=w1} @116
    PropDefine v0, v5 key="kept" @101
    v7 = Undefined @58
    Return v7 @58
}
entry module=m0
