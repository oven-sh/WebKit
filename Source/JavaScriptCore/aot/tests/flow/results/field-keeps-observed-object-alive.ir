# CHECK: field L4.0 "keep" {{*}}initialization=SetAtCreation isUnchangedDuringActivation=true mayKeepObservedObjectAlive=true
# CHECK: field L5.0 "keep" {{*}}initialization=SetAtCreation isUnchangedDuringActivation=true mayKeepObservedObjectAlive=true
# CHECK: field L6.0 "keep" {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true
# CHECK: field L7.0 "keep" {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true
# CHECK: field L8.0 "keep" {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true
# CHECK: field L9.0 "keep" {{*}}initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true
