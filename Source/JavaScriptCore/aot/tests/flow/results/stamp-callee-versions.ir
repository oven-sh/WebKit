# A call names the version it enters: a site whose arguments are all proven lists the function as read, a site where one link passes a value nobody knows lists only the generic version, and a direct call is retargeted the same way
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# LOSS: MinNarrowedUsesForGenericVersion x1 f2
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call v2, -, v1 accessSite={{*}} callees=[f1]
# CHECK-NEXT: = Call v2, -, v4 accessSite={{*}} callees=[f5]
# CHECK-NEXT: = CallDirect v1 function=f1 accessSite=
# CHECK-NEXT: = CallDirect v4 function=f5 accessSite=
# CHECK-LABEL: function f2 name="apply"
# CHECK: = Call v0, -, v1 accessSite={{*}} callees=[f5]
# CHECK-LABEL: function f5 name="sum" {{*}}role=GenericVersion {{*}}creator=Version{provenVersion=f1}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = NewClosure function=f1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="input" [isFreeName]
    v5 = Call v2, -, v1
    v6 = Call v2, -, v4
    v7 = CallDirect v1 function=f1
    v8 = CallDirect v4 function=f1
    v9 = CallDirect v2, v1 function=f2
    v10 = CallDirect v2, v4 function=f2
    v11 = CallDirect function=f3
    Return
}
function f1 name="sum" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    Return v3
}
function f2 name="apply" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
function f3 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    Return
}
