# RUN: flow-apply
# LOSS: MaxFlowWorkPerFunction x1 f12

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 kind=CallResult
typesite w1 kind=CallResult
typesite w2 kind=CallResult
typesite w3 kind=CallResult
typesite w4 kind=CallResult
typesite w5 kind=CallResult
typesite w6 kind=CallResult
typesite w7 kind=CallResult
typesite w8 kind=CallResult
typesite w9 kind=CallResult
typesite w10 kind=CallResult
typesite w11 kind=CallResult
