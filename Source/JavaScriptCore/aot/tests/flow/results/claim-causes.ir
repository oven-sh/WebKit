layout L2 name="B" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="C" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="any" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="copy" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f3
    v1 = CallDirect function=f4
    v2 = CallDirect function=f5
    v3 = CallDirect function=f6
    v4 = CallDirect function=f7
    v5 = CallDirect function=f8
    v6 = CallDirect function=f10
    v7 = CallDirect function=f11
    v8 = CallDirect function=f12
    v9 = NewClosure function=f1
    v10 = CallDirect v9 function=f13
    v11 = CallDirect function=f2
    v12 = CallDirect v11 function=f13
    Return
}
