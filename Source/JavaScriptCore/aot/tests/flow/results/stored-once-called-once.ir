# A variable whose one store is in a function the module body calls once is stored at most once, a function called from two sites is not
# RUN: flow
# CHECK: function f1 callers=AllKnown executions=AtMostOnce
# CHECK: function f2 callers=AllKnown
# CHECK-NOT: executions=
# CHECK: function f3
# CHECK: variable g0 {{*}}flow={writers=AllKnown stores=AtMostOnce}
# CHECK: variable g1 {{*}}flow={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: function f0 result 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="once" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="twice" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f2
    v3 = Call v2
    v4 = Call v2
    v5 = GetModuleVariable variable=g0
    v6 = GetModuleVariable variable=g1
    Return
}
function f1 name="setOnce" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="setTwice" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
