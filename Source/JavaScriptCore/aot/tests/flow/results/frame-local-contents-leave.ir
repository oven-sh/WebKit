# An object stays in its frame when a callee gives back or keeps what it reads from it: only what the object holds leaves. An object that the callee keeps leaves, and so does an object held by one whose field the callee keeps
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f4 parameter 0 uses=[Inspects, RetainsContents, AppliesTransitively] 
# CHECK: function f5 parameter 0 uses=[Inspects, RetainsContents, AppliesTransitively] 
# CHECK: function f6 parameter 0 uses=[Retains] 
# CHECK: class {{*}} layout=L0 {{*}}locality=FrameLocal
# CHECK: class {{*}} layout=L1 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L2 {{*}}locality=FrameLocal
# NOWHERE-NOT: layout=L3 {{*}}locality=FrameLocal

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="FieldGivenBack" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="FieldKept" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Kept" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="HeldInFieldKept" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect v1 function=f7
    Return
}
function f1 name="fieldGivenBack" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f4
    Return v2
}
function f2 name="fieldKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = CallDirect v1 function=f5
    Return
}
function f3 name="objectKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = CallDirect v1 function=f6
    Return
}
function f4 name="givesFieldBack" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f5 name="keepsField" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    PutModuleVariable v1 variable=g0
    Return
}
function f6 name="keepsObject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    Return
}
function f7 name="heldObjectKept" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = CallDirect v2 function=f5
    Return
}
