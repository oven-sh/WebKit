# A read under a string nobody knows through an unknown receiver may hand out any method of a built-in prototype, which may then run on any escaped object. An escaped object keeps its shape, and the names it may get are those that such methods store: the list stays complete
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, {{*}}LoseShape] addedKeys=[{{*}}"length"{{*}}] addedKeysAreComplete=true
# CHECK: variable g0 type=L0 written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="escaped" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = Call v4, -, v1
    v6 = PropGet v3 key="input" [isFreeName]
    v7 = PropGet v3 key="which" [isFreeName]
    v8 = ToString v7
    v9 = ElemGet v6, v8
    v10 = ToBoolean v9
    Return
}
