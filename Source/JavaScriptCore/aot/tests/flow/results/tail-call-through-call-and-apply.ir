# function viaCall(n) { return n === 0 ? 0 : viaCall.call(undefined, n - 1) }, the same with apply and Reflect.apply, and function once(n) { return leaf.call(undefined, n) }
# call, apply and Reflect.apply in tail position call their operand in tail position, so the function is on a cycle of tail calls and the call has to reuse the frame. A call that is passed on to a function on no cycle may become an ordinary call
# RUN: flow-apply
# LOSS: MaxFlowRangeGrowth x3
# CHECK-LABEL: function f1 name="viaCall"
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f2 name="viaApply"
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f3 name="viaReflectApply"
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f4 name="once"
# CHECK: ReturnCall {{*}}requirement=Allowed
# CHECK-LABEL: function f5 name="leaf"
# RUN(BUILT): pipeline Select
# BUILT-LABEL: function f1 name="viaCall"
# BUILT: [[next]]: {{*}} = CallDirect {{*}}function=f1
# BUILT-NEXT: ReturnCall [[next]]
# BUILT-LABEL: function f2 name="viaApply"
# BUILT: [[next]]: {{*}} = CallDirect {{*}}function=f2
# BUILT-NEXT: ReturnCall [[next]]
# BUILT-LABEL: function f3 name="viaReflectApply"
# BUILT: [[next]]: {{*}} = CallDirect {{*}}function=f3
# BUILT-NEXT: ReturnCall [[next]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="viaCall" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="viaApply" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="viaReflectApply" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="leaf" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g1
    v4 = NewClosure function=f3
    PutModuleVariable v4 variable=g2
    v6 = NewClosure function=f5
    PutModuleVariable v6 variable=g3
    v8 = Builtin builtin=GlobalThis
    v9 = Integer integer=300000
    v10 = PropGet v8 key="sink" [isFreeName]
    v11 = Call v0, -, v9
    v12 = Call v2, -, v9
    v13 = Call v4, -, v9
    v14 = NewClosure function=f4
    v15 = Call v14, -, v9
    v16 = Call v10, -, v11, v12, v13, v15
    Return
}
function f1 name="viaCall" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v3 = GetModuleVariable variable=g0
    v4 = PropGet v3 key="call"
    v5 = Undefined
    v6 = Integer integer=1
    v7 = Sub v0, v6
    v8 = Call v4, v3, v5, v7 calleeKey="call"
    ReturnCall v8
}
function f2 name="viaApply" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v3 = GetModuleVariable variable=g1
    v4 = PropGet v3 key="apply"
    v5 = Undefined
    v6 = Integer integer=1
    v7 = Sub v0, v6
    v8 = NewArray v7 contents=anything holes=[]
    v9 = Call v4, v3, v5, v8 calleeKey="apply"
    ReturnCall v9
}
function f3 name="viaReflectApply" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v3 = GetModuleVariable variable=g2
    v4 = Builtin builtin=ReflectApply
    v5 = Undefined
    v6 = Integer integer=1
    v7 = Sub v0, v6
    v8 = NewArray v7 contents=anything holes=[]
    v9 = Call v4, -, v3, v5, v8
    ReturnCall v9
}
function f4 name="once" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g3
    v2 = PropGet v1 key="call"
    v3 = Undefined
    v4 = Call v2, v1, v3, v0 calleeKey="call"
    ReturnCall v4
}
function f5 name="leaf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
