# A counter stops growing at the limit and is any integer, and a field that constants fill keeps its range
# RUN: flow
# LOSS: MaxFlowRangeGrowth f0 v10
# CHECK: field L0.0 "count" type=int|whole written=anything
# CHECK: field L0.1 "level" type=int[0, 3] written=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Counter" fields=[{key="count" declared={type=anything} flags=[IsRequired]}, {key="level" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = Integer integer=1
    PropSet v2, v3 key="level" mode=Strict
    v5 = Integer integer=2
    PropSet v2, v5 key="level" mode=Strict
    v7 = Integer integer=3
    PropSet v2, v7 key="level" mode=Strict
    v9 = PropGet v2 key="count"
    v10 = Add v9, v3
    PropSet v2, v10 key="count" mode=Strict
    Return
}
