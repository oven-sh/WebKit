# An object handed to a function made from text at run time reaches unknown JavaScript: every mutation of its allocation class is possible and its shape is only predicted. A literal of the same layout from another site keeps every answer
# RUN: flow
# CHECK: class [[escaped]] layout=L0 cause=ReachesUnknownJavaScript witness={function=f0 value=v9}
# CHECK: class [[kept]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK-NOT: cause=
# CHECK: class
# CHECK: layout L0 flow={{*}}cause=ReachesUnknownJavaScript witness={function=f0 value=v9}}
# CHECK: variable g0 type=object predicted=L0 written=anything {{*}}cause=ReachesUnknownJavaScript witness={function=f0 value=v9}
# CHECK: variable g1 type=L0 written=anything
# CHECK-NOT: cause=
# CHECK: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="escaped" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    PutModuleVariable v2 variable=g1
    v5 = Builtin builtin=Function
    v6 = String string="point"
    v7 = String string="delete point.x"
    v8 = Construct v5, -, v6, v7
    v9 = Call v8, -, v1
    Return
}
