# Every store to a field names it when each one is the creation of the object or an access by key that flow stamps with the receivers. A copy, Object.assign, a definition from a descriptor and a store through an unknown receiver name nothing
# RUN: flow
# CHECK: field L0.0 "created" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L0.1 "stored" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L0.2 "storedByComputedKey" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L0.3 "neverStored" {{*}}stores=Never storeNaming=EveryStoreNamesLocation
# CHECK: field L1.0 "copied"
# CHECK-NOT: storeNaming
# CHECK: field L1.1 "beside" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L2.0 "assigned"
# CHECK-NOT: storeNaming
# CHECK: field L2.1 "beside" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L3.0 "described"
# CHECK-NOT: storeNaming
# CHECK: field L3.1 "beside" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK: field L4.0 "copied"
# CHECK: field L7.0 "loose"
# CHECK-NOT: storeNaming
# CHECK: field L7.1 "beside" {{*}}storeNaming=EveryStoreNamesLocation

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Named" fields=[{key="created" declared={type=anything} flags=[IsRequired]}, {key="stored" declared={type=anything}}, {key="storedByComputedKey" declared={type=anything}}, {key="neverStored" declared={type=anything}}]
layout L1 name="CopyTarget" fields=[{key="copied" declared={type=anything}}, {key="beside" declared={type=anything}}]
layout L2 name="AssignTarget" fields=[{key="assigned" declared={type=anything}}, {key="beside" declared={type=anything}}]
layout L3 name="Described" fields=[{key="described" declared={type=anything}}, {key="beside" declared={type=anything}}]
layout L4 name="CopySource" fields=[{key="copied" declared={type=anything} flags=[IsRequired]}]
layout L5 name="AssignSource" fields=[{key="assigned" declared={type=anything} flags=[IsRequired]}]
layout L6 name="Descriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L7 name="ReachesNativeCode" fields=[{key="loose" declared={type=anything} flags=[IsRequired]}, {key="beside" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PropSet v2, v0 key="stored" mode=Strict
    v4 = String string="storedByComputedKey"
    ElemSet v2, v4, v0 mode=Strict
    v6 = NewObject -, v0 layout=L4 fields=[0]
    v7 = FinishObject v6
    v8 = NewObject layout=L1 fields=[]
    CopyDataProperties v8, v7
    v10 = FinishObject v8
    PropSet v10, v0 key="beside" mode=Strict
    v12 = NewObject -, v0 layout=L5 fields=[0]
    v13 = FinishObject v12
    v14 = NewObject layout=L2 fields=[]
    v15 = FinishObject v14
    v16 = Builtin builtin=ObjectAssign
    v17 = Call v16, -, v15, v13
    PropSet v15, v0 key="beside" mode=Strict
    v19 = NewObject -, v0 layout=L6 fields=[0]
    v20 = FinishObject v19
    v21 = NewObject layout=L3 fields=[]
    v22 = FinishObject v21
    v23 = Builtin builtin=ObjectDefineProperty
    v24 = String string="described"
    v25 = Call v23, -, v22, v24, v20
    PropSet v22, v0 key="beside" mode=Strict
    v27 = NewObject -, v0 layout=L7 fields=[0]
    v28 = FinishObject v27
    PropSet v28, v0 key="beside" mode=Strict
    v30 = Builtin builtin=GlobalThis
    v31 = PropGet v30 key="publish" [isFreeName]
    v32 = Call v31, -, v28
    PropSet v32, v0 key="loose" mode=Strict
    Return
}
