# A symbol that its call creates at most once is a constant key: the uses of the call read KeyConstant, a binding that holds it has the symbol literal as its type, and a store under it appends a field
# RUN: flow-apply
# RUN(STATIC): flow-apply
# STATISTIC: FlowAppendedFields = 3
# CHECK: layout L0 name="KeyedInCommonJS" fields=[{key=symbol("k")@m1:100 declared={{*}} flags=[IsAppendedByFlow]
# CHECK: layout L3 name="KeyedInFunction" fields=[{key=symbol@m0:300 declared={{*}} flags=[IsAppendedByFlow]
# CHECK: layout L4 kind=Environment name="scopeOfCommonJS" fields=[{key="k" declared={type=symbol("k")@m1:100 written=anything}
# CHECK: variable g1 name="made" module=m0 declared={type=symbol@m0:300 written=anything}
# STATIC: layout L2 name="KeyedByStaticField" fields=[{key=symbol("k")@m0:200 declared={{*}} flags=[IsAppendedByFlow]
# STATIC: variable g0 name="k" module=m0 declared={type=symbol("k")@m0:200 written=anything}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="keys.cjs" displayPath="keys.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
layout L0 name="KeyedInCommonJS"
layout L1 kind=Instance name="Holder" constructor=f3 staticFields=[{key="k" variable=g0}]
layout L2 name="KeyedByStaticField"
layout L3 name="KeyedInFunction"
layout L4 kind=Environment name="scopeOfCommonJS" fields=[{key="k" declared={type=anything}}]
variable g0 name="k" module=m0 declared={type=anything} owner=L1
variable g1 name="made" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewClass v0 layout=L1
    v2 = Builtin builtin=Symbol
    v3 = String string="k"
    v4 = Call v2, -, v3 @200
    PutModuleVariable v4 variable=g0
    v6 = FinishClass v1 layout=L1
    v7 = Integer integer=1
    v8 = GetModuleVariable variable=g0
    v9 = NewObject layout=L2
    ElemSet v9, v8, v7 mode=Strict
    v11 = CallDirect function=f2
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call v2, -, v3
# CHECK-NEXT: [[static]]: symbol("k")@m0:200 = KeyConstant key=symbol("k")@m0:200
# CHECK-NEXT: PutModuleVariable [[static]] variable=g0
# STATIC-LABEL: function f0 name="main"
# STATIC: [[read]]: symbol("k")@m0:200 = GetModuleVariable variable=g0
# STATIC: ElemSet {{*}}, [[read]], v7
function f1 name="keys" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Builtin builtin=Symbol
    v7 = String string="k"
    v8 = Call v6, -, v7 @100
    v9 = NewObject -, v8 layout=L4 fields=[0]
    v10 = NewClosure v9 function=f4
    v11 = Call v10
    Return
}
# CHECK-LABEL: function f1 name="keys"
# CHECK: = Call v6, -, v7
# CHECK-NEXT: [[top]]: symbol("k")@m1:100 = KeyConstant key=symbol("k")@m1:100
# CHECK-NEXT: = NewObject -, [[top]] layout=L4
function f2 name="makeKey" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = Call v0 @300
    PutModuleVariable v1 variable=g1
    v3 = NewObject layout=L3
    v4 = Integer integer=1
    ElemSet v3, v1, v4 mode=Strict
    Return
}
# CHECK-LABEL: function f2 name="makeKey"
# CHECK: = Call v0
# CHECK-NEXT: [[once]]: symbol@m0:300 = KeyConstant key=symbol@m0:300
# CHECK-NEXT: PutModuleVariable [[once]] variable=g1
# CHECK: ElemSet {{*}}, [[once]], v4
function f3 name="Holder" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="storeUnderKey" module=m1 kind=Arrow captures=[{type=env L4}] results=[{type=anything}] {
  b0(v0: env L4):
    v1 = GetEnvironmentField v0 layout=L4 field=0
    v2 = NewObject layout=L0
    v3 = Integer integer=1
    ElemSet v2, v1, v3 mode=Strict
    Return
}
# CHECK-LABEL: function f4 name="storeUnderKey"
# CHECK: [[captured]]: symbol("k")@m1:100 = GetEnvironmentField v0 layout=L4
# CHECK: ElemSet {{*}}, [[captured]], v3
