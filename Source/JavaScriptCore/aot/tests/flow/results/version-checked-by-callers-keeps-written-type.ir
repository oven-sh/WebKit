# function even(n: number, pair): Flag { return n === 0 ? true : odd(n, pair) }, with a type Flag that the front end erases to boolean; register(even)
# The front end declares a result with the type that is enforced and, where that is wider, the type as written. A version whose callers test its result takes anything,
# and what the callers claim stays the type as written in the source, as it does in the function as read.
# RUN: flow-apply
# STATISTIC: FlowGenericVersions = 1
# CHECK: name="even" {{*}}role=GenericVersion {{*}}results=[{type=anything written=true site=w0}]
# RUN(FLOW): flow
# FLOW: function f1 genericVersion=[[version]] cause=
# FLOW: function [[version]] {{*}}resultCheck=ByCallers

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
layout L0 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="odd" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="answer" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="otherOdd" [isFreeName]
    PutModuleVariable v1 variable=g0
    v3 = Integer integer=7
    v4 = NewObject -, v3, v3 layout=L0 fields=[0, 1]
    v5 = CallDirect v3, v4 function=f1
    PutModuleVariable v5 variable=g1
    v7 = NewClosure function=f1
    v8 = PropGet v0 key="register" [isFreeName]
    v9 = Call v8, -, v7
    v10 = CallDirect function=f2
    Return
}
function f1 name="even" flags=[IsChecked] parameters=[{type=number}, {type=anything}] results=[{type=boolean written=true site=w0}] {
  b0(v0: number, v1: anything):
    v2 = PropGet v1 key="x"
    v3 = PropGet v1 key="y"
    v4 = Integer integer=0
    v5 = StrictEq v0, v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    v6 = Boolean boolean=true
    Return v6
  b2():
    v7 = GetModuleVariable variable=g0
    v8 = Call v7, -, v0, v1
    ReturnCall v8 casts=[{declared={type=boolean written=true site=w0}}]
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
