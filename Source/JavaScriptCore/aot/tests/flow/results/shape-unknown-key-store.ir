# A store under a key nobody knows may add a property and may store to every field with a string key, and the object keeps its shape
# RUN: flow
# CHECK: class [[box]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape]
# CHECK-NOT: addedKeysAreComplete
# CHECK-NOT: cause=
# CHECK: class [[cell]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType, LoseShape] {{*}}addedKeysAreComplete=true
# CHECK: layout L0 flow={
# CHECK-NOT: addedKeysAreComplete
# CHECK-NOT: cause=
# CHECK: field L0.0 "value" type=true|1 {{*}}flow={location={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: field L0.1 "other" type=true|1 {{*}}flow={location={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: layout L1 flow={
# CHECK-NOT: cause=
# CHECK: field L1.0 "value" type=true|1 {{*}}flow={location={writers=AllKnown
# CHECK-NOT: stores=
# CHECK: field L1.1 "other" type=true {{*}}flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Box" constructor=f1 fields=[{key="value" declared={type=anything} flags=[IsRequired]}, {key="other" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Cell" constructor=f2 fields=[{key="value" declared={type=anything} flags=[IsRequired]}, {key="other" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = Boolean boolean=true
    v7 = Construct v2, -, v6
    v8 = Construct v5, -, v6
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="key" [isFreeName]
    v11 = ToString v10
    v12 = Integer integer=1
    ElemSet v7, v11, v12 mode=Strict
    v14 = String string="value"
    ElemSet v8, v14, v12 mode=Strict
    Return
}
function f1 name="Box" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    PropSet v3, v1 key="value" mode=Strict
    PropSet v3, v1 key="other" mode=Strict
    Return v3
}
function f2 name="Cell" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1 fields=[]
    PropSet v3, v1 key="value" mode=Strict
    PropSet v3, v1 key="other" mode=Strict
    Return v3
}
