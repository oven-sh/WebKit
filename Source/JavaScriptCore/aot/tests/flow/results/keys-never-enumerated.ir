# The keys of a class are never enumerated while its objects are only read by name, and Object.keys, JSON.stringify, a spread and nativeCode each cost that for their own class alone
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: class {{*}} layout=L0 {{*}}keys=NeverEnumerated
# CHECK: class {{*}} layout=L5
# CHECK-NOT: keys=
# CHECK: class {{*}} layout=L5 {{*}}keys=NeverEnumerated
# CHECK: layout L0 flow={{*}}keys=NeverEnumerated
# NOWHERE-NOT: layout=L1 {{*}}keys=
# NOWHERE-NOT: layout=L2 {{*}}keys=
# NOWHERE-NOT: layout=L3 {{*}}keys=
# NOWHERE-NOT: layout=L4 {{*}}keys=
# NOWHERE-NOT: layout L1 flow={{*}}keys=
# NOWHERE-NOT: layout L2 flow={{*}}keys=
# NOWHERE-NOT: layout L3 flow={{*}}keys=
# NOWHERE-NOT: layout L4 flow={{*}}keys=
# NOWHERE-NOT: layout L5 flow={{*}}keys=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ReadByName" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Listed" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Serialized" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Spread" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Published" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L5 name="TwoSites" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L6 name="Copy"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = PropGet v2 key="a"
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = FinishObject v4
    v6 = Builtin builtin=ObjectKeys
    v7 = Call v6, -, v5
    v8 = NewObject -, v0 layout=L2 fields=[0]
    v9 = FinishObject v8
    v10 = Builtin builtin=JSONStringify
    v11 = Call v10, -, v9
    v12 = NewObject -, v0 layout=L3 fields=[0]
    v13 = FinishObject v12
    v14 = NewObject layout=L6 fields=[]
    CopyDataProperties v14, v13 excludedKeys=[]
    v16 = FinishObject v14
    v17 = NewObject -, v0 layout=L4 fields=[0]
    v18 = FinishObject v17
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="publish" [isFreeName]
    v21 = Call v20, -, v18
    v22 = NewObject -, v0 layout=L5 fields=[0]
    v23 = FinishObject v22
    v24 = Call v6, -, v23
    v25 = NewObject -, v0 layout=L5 fields=[0]
    v26 = FinishObject v25
    v27 = PropGet v26 key="a"
    Return
}
