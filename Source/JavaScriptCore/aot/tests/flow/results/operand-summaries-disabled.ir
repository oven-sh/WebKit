# With operand summaries switched off no parameter and no field of an environment has a list of uses, and every other result stays
# OPTIONS: disable=flow:OperandSummaries
# RUN: flow
# RUN(NOWHERE): flow
# CHECK: function f1 callers=AllKnown executions=AtMostOnce
# CHECK: function f2 callers=AllKnown executions=AtMostOnce closureUse=CalledOnly
# CHECK: class {{*}} layout=L0 {{*}}locality=FrameLocal
# CHECK: function f1 parameter 0 type=L1 written=anything
# NOWHERE-NOT: uses=
# NOWHERE-NOT: retainedIn=
# NOWHERE-NOT: stored-value

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="kept" declared={type=anything}}]
layout L1 name="Item" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="outer" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f2
    v3 = Call v2
    Return
}
function f2 name="inner" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    PutModuleVariable v1 variable=g0
    Return
}
