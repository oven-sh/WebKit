# Each callee of a construct without a new.target operand is its own new.target, so two derived classes constructed at one site do not count as each other's new.target
# RUN: flow
# CHECK: class [[first]] layout=L1 impossibleMutations=[{{*}}ChangePrototype{{*}}LoseShape]
# CHECK: site {{*}} function=f1 layout=L1
# CHECK: function f2 result 0 type=L1 written=anything
# RUN(SECOND): flow
# SECOND: class [[second]] layout=L3 impossibleMutations=[{{*}}ChangePrototype{{*}}LoseShape]
# SECOND: site {{*}} function=f3 layout=L3
# SECOND: function f4 result 0 type=L3 written=anything
# RUN(NOTHING): flow
# NOTHING-NOT: OtherNewTarget
# NOTHING-NOT: function=f1 layout=L3
# NOTHING-NOT: function=f3 layout=L1
# NOTHING-NOT: layout=L1 {{*}}cause=
# NOTHING-NOT: layout=L3 {{*}}cause=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="FirstParent" constructor=f1
layout L1 kind=Instance name="First" predictedBase=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="SecondParent" constructor=f3
layout L3 kind=Instance name="Second" predictedBase=L2 constructor=f4 flags=[HasHeritage]
variable g0 name="First" module=m0 declared={type=function} initialization=Uninitialized
variable g1 name="Second" module=m0 declared={type=function} initialization=Uninitialized
variable g2 name="callee" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    PutModuleVariable v6 variable=g0
    PutModuleVariable v6 variable=g2
    v9 = NewClosure function=f3
    v10 = NewClass v9 layout=L2
    v11 = FinishClass v10 layout=L2
    v12 = ResolveHeritage v11
    v13 = NewClosure function=f4
    v14 = NewClass v13, v11, v12 layout=L3
    v15 = FinishClass v14 layout=L3
    PutModuleVariable v15 variable=g1
    PutModuleVariable v15 variable=g2
    v18 = GetModuleVariable variable=g2
    v19 = Construct v18
    Return
}
function f1 name="FirstParent" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="First" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = GetSuperBase v1
    v3 = SuperConstruct v2, v0 layout=L1
    Return v3
}
function f3 name="SecondParent" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    Return v2
}
function f4 name="Second" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = GetSuperBase v1
    v3 = SuperConstruct v2, v0 layout=L3
    Return v3
}
