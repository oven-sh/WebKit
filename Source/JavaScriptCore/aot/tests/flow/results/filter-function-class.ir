# A closure may be an instance of a class with callable instances, so it stays in a value claimed as such a class, and leaves one claimed as a class without callable instances
# RUN: flow
# CHECK: function f1 callers=AllKnown
# CHECK: function f2 reachability=Unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 kind=Assertion
typesite w1 kind=Assertion
variable g0 name="first" declared={type=anything}
variable g1 name="second" declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    v3 = Claim v2 castType=undefined|null|BoundFunction site=w0
    v4 = Call v3
    v5 = NewClosure function=f2
    PutModuleVariable v5 variable=g1
    v7 = GetModuleVariable variable=g1
    v8 = Claim v7 castType=undefined|null|RegExp site=w1
    v9 = Call v8
    Return
}
function f1 name="throughBoundFunction" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="throughRegExp" results=[{type=anything}] {
  b0():
    Return
}
