# A store through an unknown receiver under a name gives every escaped object that name and no other: the list of added names stays complete. An object that stayed in the program gets nothing
# RUN: flow
# RUN(NOWHERE): flow
# OPTIONS: disable=flow:AppendedFields
# CHECK: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] addedKeys=["extra"] addedKeysAreComplete=true
# CHECK: class {{*}} layout=L1 impossibleMutations=[ReachNativeCode, {{*}}AddProperty{{*}}] {{*}}addedKeysAreComplete=true
# CHECK: layout L0 flow={baseState=None {{*}}addedKeys=["extra"] addedKeysAreComplete=true ownAccessorsAreComplete=true}
# NOWHERE-NOT: layout=L1 {{*}}addedKeys=[

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="escaped" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="publish" [isFreeName]
    v7 = Call v6, -, v1
    v8 = PropGet v5 key="input" [isFreeName]
    PropSet v8, v0 key="extra" mode=Strict
    Return
}
