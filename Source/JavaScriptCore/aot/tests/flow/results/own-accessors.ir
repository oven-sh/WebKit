# A layout lists the accessors its objects can own, by key, kind and function. The list is complete unless a getter or setter is no function of the program, an accessor has a key nobody can name, or an object reaches unknown JavaScript
# RUN: flow
# CHECK: layout L0 flow={{*}} addedKeys=["g", "s"] addedKeysAreComplete=true ownAccessors=[{key="g" kind=Getter function=f1}, {key="g" kind=Setter function=f2}, {key="s" kind=Setter function=f2}] ownAccessorsAreComplete=true}
# CHECK: layout L1 flow={{*}} addedKeysAreComplete=true ownAccessorsAreComplete=true}
# CHECK: layout L2 flow={{*}} ownAccessors=[{key="g" kind=Getter function=f1}]}
# CHECK: layout L3 flow=
# CHECK-NOT: ownAccessorsAreComplete
# CHECK: layout L4 flow=
# CHECK-NOT: ownAccessorsAreComplete
# CHECK: layout L5 flow=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="HasAccessors" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="GainsDataProperty" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="GetterMayBeBuiltin" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="AccessorUnderUnknownKey" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L4 name="ReachesUnknownJavaScript" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Last"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    DefineGetter v1, v2 key="g"
    v4 = NewClosure function=f2
    DefineSetter v1, v4 key="g"
    DefineSetter v1, v4 key="s"
    v7 = FinishObject v1
    v8 = NewObject -, v0 layout=L1 fields=[0]
    v9 = FinishObject v8
    PropSet v9, v0 key="y" mode=Strict
    v11 = NewObject -, v0 layout=L2 fields=[0]
    DefineGetter v11, v2 key="g"
    v13 = Builtin builtin=ObjectKeys
    DefineGetter v11, v13 key="g"
    v15 = FinishObject v11
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="key" [isFreeName]
    v18 = ToPropertyKey v17
    v19 = NewObject -, v0 layout=L3 fields=[0]
    DefineGetter v19, v2, v18
    v21 = FinishObject v19
    v22 = NewObject -, v0 layout=L4 fields=[0]
    v23 = FinishObject v22
    v24 = PropGet v16 key="text" [isFreeName]
    v25 = Builtin builtin=Function
    v26 = Construct v25, -, v24
    v27 = Call v26, -, v23
    Return
}
function f1 name="g" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="g" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
