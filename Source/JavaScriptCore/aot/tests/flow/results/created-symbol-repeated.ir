# A symbol whose call may run again, or whose description nobody knows, is no constant: the call stays, every position that holds it is a symbol; a neighbor created once keeps its constant
# RUN: flow-apply
# CHECK: variable g0 name="looped" module=m0 declared={type=symbol written=anything}
# CHECK: variable g1 name="calledTwice" module=m0 declared={type=symbol written=anything}
# CHECK: variable g2 name="unknownDescription" module=m0 declared={type=symbol written=anything}
# CHECK: variable g3 name="once" module=m0 declared={type=symbol@m0:10 written=anything}
# RUN(CONSTANTS): flow-apply
# CONSTANTS-COUNT-1: = KeyConstant
# CONSTANTS-NOT: = KeyConstant

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="looped" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="calledTwice" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="unknownDescription" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="once" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = Call v0 @10
    PutModuleVariable v1 variable=g3
    v3 = CallDirect function=f1
    v4 = CallDirect function=f1
    v5 = Builtin builtin=MathRandom
    v6 = Call v5
    v7 = ToString v6
    v8 = Call v0, -, v7 @40
    PutModuleVariable v8 variable=g2
    Jump -> next b1()
  b1():
    LoopHint
    v11 = Call v0 @20
    PutModuleVariable v11 variable=g0
    v13 = Call v5
    v14 = ToBoolean v13
    Branch v14 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call v0
# CHECK-NEXT: [[once]]: symbol@m0:10 = KeyConstant key=symbol@m0:10
# CHECK-NEXT: PutModuleVariable [[once]] variable=g3
# CHECK: [[described]]: anything = Call v0, -, v7
# CHECK-NEXT: [[second]]: symbol = AssumeType [[described]] castType=symbol
# CHECK-NEXT: PutModuleVariable [[second]] variable=g2
# CHECK: [[looped]]: anything = Call v0
# CHECK-NEXT: [[third]]: symbol = AssumeType [[looped]] castType=symbol
# CHECK-NEXT: PutModuleVariable [[third]] variable=g0
function f1 name="makeKey" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = Call v0 @30
    PutModuleVariable v1 variable=g1
    Return
}
# CHECK-LABEL: function f1 name="makeKey"
# CHECK: [[twice]]: anything = Call v0
# CHECK-NEXT: [[fourth]]: symbol = AssumeType [[twice]] castType=symbol
# CHECK-NEXT: PutModuleVariable [[fourth]] variable=g1
