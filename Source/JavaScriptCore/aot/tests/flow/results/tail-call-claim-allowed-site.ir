# An allowed tail call whose cast has to test the result becomes the call, the Claim and a Return, and one whose cast flow proves stays a tail call
# RUN: flow-apply
# STATISTIC: ReturnCallsDemoted = 1
# STATISTIC: FlowRemovedClaims = 1
# STATISTIC: FlowRemainingClaims = 1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Result
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="tested" flags=[IsChecked] results=[{type=number site=w0}] {
  b0():
    v0 = CallDirect function=f3
    ReturnCall v0 casts=[{declared={type=number site=w0}}]
}
# CHECK-LABEL: function f1 name="tested"
# CHECK: v0: anything = CallDirect function=f3
# CHECK-NEXT: [[claim]]: number = Claim v0 castType=number site=w0
# CHECK-NEXT: Return [[claim]]
# CHECK-NOT: ReturnCall
function f2 name="proven" flags=[IsChecked] results=[{type=number site=w1}] {
  b0():
    v0 = CallDirect function=f4
    ReturnCall v0 casts=[{declared={type=number site=w1}}]
}
# CHECK-LABEL: function f2 name="proven"
# CHECK: v0{{*}} = CallDirect function=f4
# CHECK-NEXT: ReturnCall v0 casts=[{declared={type=number site=w1} resolution=Assume}] requirement=Allowed
# CHECK-NOT: Claim
function f3 name="fromOutside" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="outside" [isFreeName]
    Return v1
}
function f4 name="one" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
