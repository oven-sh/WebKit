# An escaped object is never stored to under the name of an appended field of its layout. An accessor defined by name through an unknown receiver may be defined on it, and a delete by name may take it away again:
# the name is a field, so no property is added, and the field leaves its slot. A delete alone finds nothing on such an object: the layout beside it, where the accessor would be an added property
# RUN: flow
# STATISTIC: FlowAppendedFields = 2
# CHECK: field L0.1 "late" type="text" flags=[IsAppendedByFlow] flow={{*}}stability=[IsNeverStoredWithOtherType]}
# CHECK: field L1.1 "other" type="text" flags=[IsAppendedByFlow] flow={{*}}stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}
# RUN(DEFINED): flow
# DEFINED: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# RUN(DELETED): flow
# DELETED: class {{*}} layout=L1 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] addedKeys=["late"]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="DefinedThroughUnknownReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="DeletedThroughUnknownReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="text"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = NewObject -, v0 layout=L0 fields=[0]
    v5 = Call v3, -, v4
    v6 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v6, v1 key="late" mode=Strict
    v8 = NewObject -, v0 layout=L1 fields=[0]
    v9 = Call v3, -, v8
    v10 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v10, v1 key="other" mode=Strict
    v12 = PropGet v2 key="input" [isFreeName]
    v13 = TypeTest v12 testedType=object
    Branch v13 -> taken b1(| 0), notTaken b2()
  b1(v14):
    v15 = NewClosure function=f1
    DefineGetter v14, v15 key="late"
    v17 = PropDelete v14 key="late" mode=Strict
    v18 = PropDelete v14 key="other" mode=Strict
    Return
  b2():
    Return
}
function f1 name="late" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
