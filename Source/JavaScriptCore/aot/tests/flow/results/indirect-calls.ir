# A call that no call operation names is listed with its caller, its site, its kind and how often it runs: a callback of a built-in, an accessor, a method a protocol finds, a call by the host. The instances of a caller share one line
# RUN: flow
# RUN(ALL): flow
# RUN(LINKS): flow-links calls
# CHECK: indirect f1 [[callbackSite]] -> f4 BuiltinCallback PerElement
# CHECK-NOT: indirect f1
# CHECK: indirect f2 [[readSite]] -> f5 Accessor Once
# CHECK-NOT: indirect f2
# CHECK: indirect f3 [[serializeSite]] -> f6 Protocol
# CHECK-NOT: indirect f3
# CHECK: indirect - - -> f0 Host Once
# CHECK: indirect - - -> f7 Host Repeatedly
# ALL-NOT: indirect f0
# ALL-NOT: -> f8
# LINKS: [[first]] f1 v4 -> {{*}} f4 BuiltinCallback PerElement
# LINKS: [[second]] f1 v4 -> {{*}} f4 BuiltinCallback PerElement

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="handler" variable=g0}]
entry module=m0 hostReads=[{exportName="handler"}]
layout L0 name="WithGetter" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="WithToJSON" fields=[{key="toJSON" declared={type=anything} flags=[IsRequired]}]
variable g0 name="handler" module=m0 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = NewClosure function=f5
    DefineGetter v4, v5 key="v"
    v7 = CallDirect v4 function=f2
    v8 = NewClosure function=f6
    v9 = NewObject -, v8 layout=L1 fields=[0]
    v10 = CallDirect v9 function=f3
    v11 = NewClosure function=f7
    PutModuleVariable v11 variable=g0
    v13 = NewClosure function=f8
    v14 = Call v13
    Return
}
function f1 name="visitAll" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Uint8Array
    v2 = Construct v1
    v3 = PropGet v2 key="forEach"
    v4 = Call v3, v2, v0 calleeKey="forEach"
    Return
}
function f2 name="read" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="v"
    Return v1
}
function f3 name="serialize" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=JSONStringify
    v2 = Call v1, -, v0
    Return v2
}
function f4 name="visit" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="v" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f6 name="toJSON" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f7 name="handler" results=[{type=anything}] {
  b0():
    Return
}
function f8 name="calledByValue" results=[{type=anything}] {
  b0():
    Return
}
