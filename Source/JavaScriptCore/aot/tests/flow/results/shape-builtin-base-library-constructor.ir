# The constructor of Promise is a function of the library, and its CreatePromise makes the cell for the prototype that new.target holds. An instance of a class that extends Promise is that cell, so it never has the shape of the layout
# RUN: flow
# RUN(BODIES): flow-apply
# CHECK: class [[task]] layout=L0 {{*}}cause=BuiltinBase witness={function=f2 value=v2}
# CHECK: layout L0 flow={allocation=NeverAllocated baseState=BuiltinClass baseClass=Promise
# CHECK-NOT: allocationClasses=[
# CHECK: classFlow=
# BODIES-NOT: keepsShape
# BODIES-LABEL: function f1 name="Task"
# BODIES: v4: object{{*}}= SuperConstruct
# BODIES-LABEL: function f2 name="Promise"
# BODIES: v2: Promise{{*}}= CreatePromise v

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="library.js" displayPath="library.js" flags=[IsLibrary]
entry module=m0
layout L0 kind=Instance name="Task" constructor=f1 fields=[{key="label" declared={type=anything}}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Promise" [isFreeName]
    v2 = NewClosure function=f1
    v3 = ResolveHeritage v1
    v4 = NewClass v2, v1, v3 layout=L0
    v5 = FinishClass v4 layout=L0
    v6 = NewClosure function=f3
    v7 = Construct v5, -, v6
    v8 = PropGet v7 key="label"
    Return
}
function f1 name="Task" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0 homeKind=Object
    v4 = SuperConstruct v3, v1, v2 layout=L0
    v5 = String string="task"
    PropSet v4, v5 key="label" mode=Strict
    Return v4
}
function f2 name="Promise" module=m1 kind=BaseConstructor role=Library flags=[HasNewTarget, IsNakedConstructor] length=1 enclosingRuntimeFunction=0 parameters=[{type=anything}] results=[{type=object}] {
  b0(v0: anything, v1: anything):
    v2 = CreatePromise v0
    v3 = Call v1
    Return v2
}
function f3 name="executor" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
runtimefunction id=0 function=f2
