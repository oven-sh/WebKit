# A field is always filled when it is set at creation and has all three stability flags, and each of the four alone takes the answer away
# RUN: flow
# CHECK: field L0.0 "late"
# CHECK-NOT: SetAtCreation
# CHECK-NOT: occupancy=
# CHECK: stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: field L0.1 "deleted" {{*}}initialization=SetAtCreation
# CHECK-NOT: occupancy=
# CHECK: stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: field L0.2 "redefined" {{*}}initialization=SetAtCreation
# CHECK-NOT: occupancy=
# CHECK: stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}
# CHECK: field L0.3 "retyped" {{*}}initialization=SetAtCreation
# CHECK-NOT: occupancy=
# CHECK: stability=[IsNeverDeleted, IsNeverRedefined]}
# CHECK: field L0.4 "filled" {{*}}initialization=SetAtCreation {{*}}} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Five" fields=[{key="late" declared={type=number}}, {key="deleted" declared={type=number} flags=[IsRequired]}, {key="redefined" declared={type=number} flags=[IsRequired]}, {key="retyped" declared={type=number} flags=[IsRequired]}, {key="filled" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0, v0, v0 layout=L0 fields=[1, 2, 3, 4]
    PropSet v1, v0 key="late" mode=Strict
    v3 = PropDelete v1 key="deleted" mode=Strict
    v4 = NewClosure function=f1
    DefineGetter v1, v4 key="redefined"
    v6 = String string="text"
    v7 = CallDirect v1, v6 function=f2
    Return
}
function f1 name="redefined" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="storeText" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="retyped" mode=Strict
    Return
}
