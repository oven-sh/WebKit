# An untyped parameter gets the union of what its direct callers pass
# RUN: flow
# RUN(ALL): flow
# STATISTIC: FlowGenericVersions = 0
# LOSS: MinNarrowedUsesForGenericVersion x1 f2
# CHECK: function f2 callers=AllKnown cause=UnknownObject witness={function=f0 value=v8}
# CHECK: function f1 parameter 0 type=L0|L1 written=anything
# CHECK: function f1 result 0 type=int[2, 4] written=anything
# CHECK: function f2 parameter 0 type=anything predicted=L0
# CHECK: function f3 parameter 0 type=null|L0 written=anything
# ALL-NOT: function f2 parameter 0{{*}}written=
# ALL-NOT: function f2 result 0{{*}}written=
# ALL-NOT: role=GenericVersion

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Cat" fields=[{key="legs" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Bird" fields=[{key="legs" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Integer integer=2
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = CallDirect v1 function=f1
    v5 = CallDirect v3 function=f1
    v6 = CallDirect v1 function=f2
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="pet" [isFreeName]
    v9 = CallDirect v8 function=f2
    v10 = CallDirect v1 function=f3
    v11 = Null
    v12 = CallDirect v11 function=f3
    Return
}
function f1 name="legs" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="legs"
    Return v1
}
function f2 name="same" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="ignore" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
