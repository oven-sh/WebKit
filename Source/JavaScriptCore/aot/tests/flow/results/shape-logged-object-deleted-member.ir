# Once the program deletes console.log a lookup of it goes on to the prototype of console, which the table does not name: the callee is unknown and the logged object reaches native code. console.warn is not touched
# RUN: flow
# CHECK: class C0 layout=L0 impossibleMutations=[ReachUnknownJavaScript,
# CHECK: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,
# CHECK: field L0.0 "value" type=true|"stored" written=anything
# CHECK: field L1.0 "value" type=true written=anything
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {unknown, L0#
# SINKS-NOT: L1#
# RUN(CALLEE): flow-solve nodes
# CALLEE: , f0, v6) = {undefined|null|boolean|number|string|symbol|bigint|unknown|ConsoleLog}
# CALLEE: , f0, v8) = {ConsoleWarn}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Logged" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Warned" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="held" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=Console
    v6 = PropGet v5 key="log"
    v7 = Call v6, v5, v1 calleeKey="log"
    v8 = PropGet v5 key="warn"
    v9 = Call v8, v5, v3 calleeKey="warn"
    v10 = PropDelete v5 key="log" mode=Sloppy
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = String string="stored"
    PropSet v12, v13 key="value" mode=Strict
    Return
}
