# A holder that reaches nativeCode keeps its members constant; a store through an unknown receiver costs the name it stores on a holder that escaped, and on no other
# RUN: flow
# CHECK: builtin-location GlobalThis."Math" Constant
# CHECK: builtin-location GlobalThis."console" Constant
# CHECK: builtin-location JSON."parse" Constant
# CHECK: builtin-location Math."max" Constant
# CHECK: builtin-location Console."log" Constant
# CHECK: builtin-location Console."warn" Unknown
# CHECK: builtin-use Math [{{*}}Escaped
# CHECK: builtin-use Console [{{*}}Escaped
# RUN(MATH): flow
# MATH-NOT: builtin-location Math."{{*}}" Unknown
# MATH-NOT: builtin-use JSON [{{*}}Escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Math" [isFreeName]
    v2 = PropGet v0 key="console" [isFreeName]
    v3 = PropGet v2 key="log"
    v4 = Call v3, v2, v1
    v5 = PropGet v0 key="sink" [isFreeName]
    v6 = Call v5, -, v1
    v7 = Call v5, -, v2
    v8 = PropGet v0 key="input" [isFreeName]
    v9 = Integer integer=1
    PropSet v8, v9 key="warn" mode=Strict
    PropSet v8, v9 key="parse" mode=Strict
    v12 = PropGet v1 key="max"
    v13 = PropGet v0 key="JSON" [isFreeName]
    v14 = PropGet v13 key="parse"
    Return
}
