# A closure over this that is stored into a field of this is a self reference, not a leak. this leaks where the closure is read out of the field during construction, or goes anywhere else
# RUN: flow
# STATISTIC: FlowConstructorsLeakingThis = 3
# CHECK: layout L0 flow={{*}} constructorOrders=[{fields=[0, 1, 2]}] fieldCreation=OnlyAtConstruction thisLeak=DoesNotLeak
# CHECK: field L0.0 "x" type=1 {{*}}initialization=SetAtCreation{{*}} occupancy=AlwaysFilled
# CHECK: field L0.1 "onClick" type=f3 {{*}}initialization=SetAtCreation{{*}} occupancy=AlwaysFilled
# CHECK: field L0.2 "y" type=2 {{*}}initialization=SetAtCreation{{*}} occupancy=AlwaysFilled
# CHECK: layout L1 flow={
# CHECK-NOT: fieldCreation=
# CHECK-NOT: thisLeak=
# CHECK: field L1.0 "x" type=1 {{*}} occupancy=AlwaysFilled
# CHECK: field L1.1 "onClick" type=f6 {{*}} occupancy=AlwaysFilled
# CHECK: field L1.2 "y" type=undefined|2
# CHECK-NOT: occupancy=
# CHECK: layout L2 flow={
# CHECK-NOT: fieldCreation=
# CHECK-NOT: thisLeak=
# CHECK: field L2.0 "x" type=1 {{*}} occupancy=AlwaysFilled
# CHECK: field L2.1 "onClick" type=f9 {{*}} occupancy=AlwaysFilled
# CHECK: field L2.2 "y" type=undefined|2
# CHECK-NOT: occupancy=
# CHECK: layout L3 flow={
# CHECK-NOT: fieldCreation=
# CHECK-NOT: thisLeak=
# CHECK: field L3.0 "x" type=1 {{*}} occupancy=AlwaysFilled
# CHECK: field L3.1 "y" type=undefined|2
# CHECK-NOT: occupancy=
# CHECK: layout L4 flow={

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="registry" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance name="OnlyStored" constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="onClick" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="PassedOn" constructor=f4 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="onClick" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="CalledEarly" constructor=f7 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="onClick" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="StoredElsewhere" constructor=f10 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Registry" fields=[{key="onClick" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L4 fields=[]
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="onClick"
    v7 = Call v6, v5 calleeKey="onClick"
    v8 = NewClosure function=f4
    v9 = NewClass v8 layout=L1
    v10 = FinishClass v9 layout=L1
    v11 = Construct v10
    v12 = NewClosure function=f7
    v13 = NewClass v12 layout=L2
    v14 = FinishClass v13 layout=L2
    v15 = Construct v14
    v16 = NewClosure function=f10
    v17 = NewClass v16 layout=L3
    v18 = FinishClass v17 layout=L3
    v19 = Construct v18
    Return
}
function f1 name="OnlyStored" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = CallDirect v2 function=f2
    Return v2
}
function f2 name="initializeOnlyStored" kind=Initializer flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: object ? L0):
    v1 = Integer integer=1
    PropDefine v0, v1 key="x"
    v3 = NewClosure v0 function=f3
    PropDefine v0, v3 key="onClick"
    v5 = Integer integer=2
    PropDefine v0, v5 key="y"
