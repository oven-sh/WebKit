    Return v2
}
function f8 name="initializeCalledEarly" kind=Initializer flags=[HasThis] thisType={type=L2} results=[{type=anything}] {
  b0(v0: object ? L2):
    v1 = Integer integer=1
    PropDefine v0, v1 key="x"
