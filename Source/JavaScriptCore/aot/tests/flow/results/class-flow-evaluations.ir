# A class definition is evaluated at most once at the top of an ES module and in a function that runs at most once; not in a loop, in a function called from two sites, or in a CommonJS module:
# a definition may throw, and a CommonJS body that threw is run again by the next require(), whether or not the program can remove its cache entry
# RUN: flow
# CHECK: function f9
# CHECK-NOT: executions=
# CHECK: function f11
# CHECK: class [[top]] layout=L0 impossibleMutations=[{{*}}LoseShape]
# CHECK: class [[once]] layout=L1 impossibleMutations=[{{*}}LoseShape]
# CHECK: class [[loop]] layout=L2 impossibleMutations=[{{*}}LoseShape]
# CHECK: class [[twice]] layout=L3 impossibleMutations=[{{*}}LoseShape]
# CHECK: class [[kept]] layout=L4 impossibleMutations=[{{*}}LoseShape]
# CHECK: class [[removed]] layout=L5 impossibleMutations=[{{*}}LoseShape]
# CHECK: layout L0 flow={{*}} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L1 flow={{*}} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L2 flow={{*}} classFlow={prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L3 flow={{*}} classFlow={prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L4 flow={{*}} classFlow={prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L5 flow={{*}} classFlow={prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}]
module m1 path="kept.cjs" displayPath="kept.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f9
module m2 path="removed.cjs" displayPath="removed.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f10
