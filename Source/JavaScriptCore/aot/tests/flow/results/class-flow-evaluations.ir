  b1():
    v7 = NewClosure function=f3
    v8 = NewClass v7 layout=L2
    v9 = FinishClass v8 layout=L2
    v10 = Construct v9
    v11 = Builtin builtin=MathRandom
    v12 = Call v11
    v13 = ToBoolean v12
    LoopHint
    Branch v13 -> taken b1(), notTaken b2()
  b2():
    Return
}
