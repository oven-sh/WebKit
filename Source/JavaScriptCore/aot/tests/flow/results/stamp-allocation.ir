# Every allocation is stamped with its site, an object with a layout also with its allocation class and, when the class cannot lose its shape, with the flag that gives it the type of its layout, an array literal with the elements that flow found at its site. Data has the site of its root
# RUN: flow-apply
# RUN(SITES): flow
# CHECK: v1: L0 = NewObject -, v0 layout=L0 fields=[0] allocationSite=0 allocationClass=0 [keepsShape]
# CHECK-NEXT: v2:{{*}}= NewArray v0 contents=1 allocationSite=1
# CHECK-NOT: allocationClass
# CHECK: v3: f1 = NewClosure function=f1 allocationSite=2
# CHECK-NOT: allocationClass
# CHECK: v4:{{*}}= Data data=d0 allocationSite=3
# CHECK-NEXT: v5: object ~ L1 = NewObject -, v0 layout=L1 fields=[0] allocationSite=5 allocationClass=5
# CHECK-NOT: keepsShape
# SITES: site A0 function=f0 layout=L0 allocationClass=0
# SITES-NEXT: site A1 function=f0 builtinClass=Array allocationClass=1
# SITES-NEXT: site A2 function=f0 allocationClass=2
# SITES-NEXT: site A3 function=f0 layout=L2 allocationClass=3
# SITES-NEXT: site A4 function=f0 builtinClass=Array allocationClass=4
# SITES-NEXT: site A5 function=f0 layout=L1 allocationClass=5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Losing" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Settings" fields=[{key="sizes" declared={type=anything} flags=[IsRequired]}]
data d0 root=Object{layout=L2 members=[{key="sizes" value=Array{contents=number elements=[Number{value=1}, Number{value=2}]}}]} module=m0
variable g0 name="all" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v0 contents=anything holes=[]
    v3 = NewClosure function=f1
    v4 = Data data=d0
    v5 = NewObject -, v0 layout=L1 fields=[0]
    DefineGetter v5, v3 key="0"
    v7 = NewArray v1, v2, v3, v4, v5 contents=anything holes=[]
    PutModuleVariable v7 variable=g0
    Return
}
function f1 name="first" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
