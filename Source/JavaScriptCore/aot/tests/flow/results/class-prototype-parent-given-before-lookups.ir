    v29 = ToBoolean v28
    Branch v29 -> taken b1(), notTaken b2(v27)
  b1():
    Jump -> next b2(v11)
  b2(v30: anything):
    v31 = Call v2, v1, v26, v30 calleeKey="setPrototypeOf"
    v32 = NewClosure function=f7
    v33 = PropGet v32 key="prototype"
    v34 = Call v2, v1, v33, v11 calleeKey="setPrototypeOf"
    v35 = PropGet v32 key="prototype"
    v36 = Call v2, v1, v35, v27 calleeKey="setPrototypeOf"
