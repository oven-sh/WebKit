# Object.setPrototypeOf(Child.prototype, Parent.prototype) gives the prototype object that a function is created with its parent. Where one call does that before anybody else
# has read the prototype property, nobody ever follows the link that the object was created with: the link counts as fixed, and the class of the parent is the next one on the chain.
# It does not where the class was constructed or the property read before, where the parent is one of two objects, where two calls give a parent,
# or where the call is in a helper that flow enters once for all its callers, so that it has several receivers
# RUN: flow
# CHECK: layout L1 flow={{*}} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed {{*}} prototypeBase=L0}
# CHECK: layout L2 flow={{*}} classFlow={evaluations=AtMostOnce staticLink=Fixed
# CHECK-NOT: prototypeBase
# CHECK: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Parent" constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="Direct" constructor=f2 flags=[IsConstructorFunction]
layout L2 kind=Instance name="ThroughHelper" constructor=f3 flags=[IsConstructorFunction]
layout L3 kind=Instance name="ConstructedFirst" constructor=f4 flags=[IsConstructorFunction]
layout L4 kind=Instance name="ReadFirst" constructor=f5 flags=[IsConstructorFunction]
layout L5 kind=Instance name="OneOfTwoParents" constructor=f6 flags=[IsConstructorFunction]
layout L6 kind=Instance name="GivenTwice" constructor=f7 flags=[IsConstructorFunction]
layout L7 name="end" fields=[{key="end" declared={type=anything} flags=[IsRequired]}]
layout L8 kind=Instance name="Grandchild" constructor=f11 flags=[IsConstructorFunction]
