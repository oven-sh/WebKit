# A tail call of an unknown callee is required only in a function that code outside the program can call: only through such a function can the callee come back
# RUN: flow-apply

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = PropGet v0 key="callback" [isFreeName]
    v5 = Integer integer=1
    v6 = CallDirect v4, v5 function=f2
    v7 = NewClosure function=f3
    v8 = Call v1, -, v7
    Return
}
function f1 name="calledByNativeCode" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    ReturnCall v2
}
# CHECK-LABEL: function f1 name="calledByNativeCode"
# CHECK: = Call v0, -, v1 accessSite=
# CHECK-NOT: callees=
# CHECK: ReturnCall v2
# CHECK-NOT: requirement=Allowed
function f2 name="everyCallerKnown" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    ReturnCall v2
}
# CHECK-LABEL: function f2 name="everyCallerKnown"
# CHECK: = Call v0, -, v1 accessSite=
# CHECK-NOT: callees=
# CHECK: ReturnCall v2 requirement=Allowed
function f3 name="calledByNativeCodeWithKnownCallee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f4
    ReturnCall v1
}
# CHECK-LABEL: function f3 name="calledByNativeCodeWithKnownCallee"
# CHECK: ReturnCall v1 requirement=Allowed
function f4 name="leaf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
