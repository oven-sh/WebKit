# The engine throws instances of Error. A built-in of the host also throws objects of its own classes, a DOMException or a ResolveMessage, which are no instances of the class Error: what it throws is unknown
#   function byHost() { try { return structuredClone(() => 1) } catch (error) { return error } }
#   function byEngine() { try { return JSON.parse("{") } catch (error) { return error } }
