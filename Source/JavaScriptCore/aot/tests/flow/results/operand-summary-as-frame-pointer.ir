# A parameter kept in a cell that dies with the call is not retained, and still may be no pointer into a frame: the collector would follow the cell into the stack. The same holds for an operand of a built-in and for the receiver of a computed key, which native code gets. `asFramePointer` lists those further uses, for parameters and for what an environment field holds
# RUN: flow
# RUN(READ): flow
# CHECK: function f2 parameter 0 uses=[] retainedIn=UnknownMemory asFramePointer=[Retains]
# CHECK: function f3 parameter 0 uses=[] retainedIn=UnknownMemory asFramePointer=[Retains]
# CHECK: function f4 parameter 0 uses=[Inspects] retainedIn=UnknownMemory asFramePointer=[Retains]
# CHECK: function f5 parameter 0 uses=[Inspects] retainedIn=UnknownMemory asFramePointer=[Retains
# CHECK: function f6 parameter 0 uses=[Inspects] retainedIn=UnknownMemory asFramePointer=[RetainsContents, AppliesTransitively]
# READ-NOT: function f1 parameter 0 {{*}}asFramePointer

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="y" declared={type=anything}}]
layout L1 name="Holder" fields=[{key="held" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = CallDirect v2 function=f1
    v4 = CallDirect v2 function=f2
    v5 = CallDirect v2 function=f3
    v6 = CallDirect v2 function=f4
    v7 = ToString v1
    v8 = CallDirect v2, v7 function=f5
    v9 = NewObject -, v2 layout=L1 fields=[0]
    v10 = CallDirect v9 function=f6
    Return
}
function f1 name="readsField" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y"
    v2 = ToBoolean v1
    Return v2
}
function f2 name="holdsInArray" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray v0 contents=anything
    v2 = PropGet v1 key="length"
    Return v2
}
function f3 name="passesToHolding" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f2
    Return v1
}
function f4 name="listsKeys" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Object" [isFreeName]
    v3 = PropGet v2 key="keys"
    v4 = Call v3, v2, v0
    Return
}
function f5 name="readsByKey" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: anything, v1: string):
    v2 = ElemGet v0, v1
    v3 = ToBoolean v2
    Return v3
}
function f6 name="holdsWhatItReads" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="held"
    v2 = NewArray v1 contents=anything
    v3 = PropGet v2 key="length"
    Return v3
}
