# No call or access in a function past the work limit has a complete set, whatever it calls: a built-in, a closure, a bound function, a method, a constructor. The same operations in a function below the limit keep theirs, and the program builds
# OPTIONS: limit=MaxFlowWorkPerFunction:450
# LOSS: MaxFlowWorkPerFunction f1
# LOSS: MaxFlowInstanceValues f1
# RUN: flow-apply
# CHECK-LABEL: function f1 name="busy"
# CHECK: Call {{*}}callees=[builtin(ObjectGetPrototypeOf), ..]
# CHECK: Call {{*}}callees=[f3, ..]
# CHECK: Construct {{*}}callees=[f5, ..]
# CHECK-LABEL: function f2 name="idle"
# CHECK: Call {{*}}callees=[builtin(ObjectGetPrototypeOf)]
# CHECK: Call {{*}}callees=[f7]
# CHECK: calleeKey="bind" {{*}}callees=[builtin(FunctionPrototypeBind)]
# CHECK: Call {{*}}callees=[f7]
# CHECK: key="method" {{*}}receivers=[L1]
# CHECK: calleeKey="method" {{*}}callees=[f8]
# CHECK: Construct {{*}}callees=[f9]
# CHECK: key="got" {{*}}receivers=[L1]
# RUN(COMPLETE): flow-apply
# COMPLETE-LABEL: function f1 name="busy"
# COMPLETE-NOT: callees=[]
# COMPLETE-NOT: )]
# COMPLETE-NOT: callees=[f3]
# COMPLETE-NOT: callees=[f4]
# COMPLETE-NOT: callees=[f5]
# COMPLETE-NOT: receivers=[]
# COMPLETE-NOT: receivers=[L0]
# COMPLETE-LABEL: function f2 name="idle"
# RUN(LOSSES): flow
# LOSSES-NOT: function=f1 kind=Call{{*}}loss cause=Unknown
# LOSSES: function=f1 kind=Call loss cause=LimitReached limit=MaxFlowWorkPerFunction
# LOSSES: function=f1 kind=Construct loss cause=LimitReached limit=MaxFlowWorkPerFunction
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="BusyReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="method" declared={type=anything} flags=[IsRequired]}]
layout L1 name="IdleReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="method" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="BusyMade" constructor=f5 flags=[IsConstructorFunction]
layout L3 kind=Instance name="IdleMade" constructor=f9 flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewClosure function=f4
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = NewClosure function=f6
    DefineGetter v2, v3 key="got"
    v5 = FinishObject v2
    v6 = CallDirect v5 function=f1
    v7 = NewClosure function=f8
    v8 = NewObject -, v0, v7 layout=L1 fields=[0, 1]
    v9 = NewClosure function=f10
    DefineGetter v8, v9 key="got"
    v11 = FinishObject v8
    v12 = CallDirect v11 function=f2
    Return
}
