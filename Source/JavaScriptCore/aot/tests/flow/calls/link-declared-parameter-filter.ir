# A value outside the declared type of a parameter throws on entry and never arrives: a layout lets every object in, a primitive kind lets only that kind in
# RUN: flow-solve nodes
# RUN(NUMBER): flow-solve nodes
# RUN(ANYTHING): flow-solve nodes
# CHECK: , f0, v1) = {L0#[[declared]]}
# CHECK-NEXT: , f0, v2) = {L1#[[other]]}
# CHECK: , f1, parameter 0) = {null|L0#[[declared]]|L1#[[other]]}
# NUMBER: , f2, parameter 0) = {1}
# ANYTHING: , f0, v1) = {L0#[[declared]]}
# ANYTHING-NEXT: , f0, v2) = {L1#[[other]]}
# ANYTHING: , f3, parameter 0) = {null|"text"|L0#[[declared]]|L1#[[other]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Declared" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Other" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = String string="text"
    v4 = Null
    v5 = NewClosure function=f1
    v6 = Call v5, -, v1
    v7 = Call v5, -, v2
    v8 = Call v5, -, v3
    v9 = Call v5, -, v4
    v10 = NewClosure function=f2
    v11 = Call v10, -, v1
    v12 = Call v10, -, v3
    v13 = Call v10, -, v0
    v14 = NewClosure function=f3
    v15 = Call v14, -, v1
    v16 = Call v14, -, v2
    v17 = Call v14, -, v3
    v18 = Call v14, -, v4
    Return
}
function f1 name="takesLayout" parameters=[{type=undefined|null|L0}] results=[{type=anything}] {
  b0(v0: undefined|null|object ? L0):
    Return
}
function f2 name="takesNumber" parameters=[{type=undefined|null|number}] results=[{type=anything}] {
  b0(v0: undefined|null|number):
    Return
}
function f3 name="takesAnything" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
