# The function behind a built-in accessor is an object nobody tracks. Once a program has read the setter of __proto__ as a value, a call of an unknown function may be a call of it, so the prototype link of whatever has escaped is no longer fixed. Without that read native code changes no prototype
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[ReachNativeCode, ChangePrototype] uses
# CHECK-NEXT: L1#{{*}} mutations=[] uses
# RUN(VALUES): flow-solve nodes
# VALUES: f0, v8) = {undefined|unknown}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="PassedAsThis" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = NewObject -, v3 layout=L2 fields=[0]
    v7 = Builtin builtin=ObjectPrototype__lookupSetter__
    v8 = Call v7, v5, v2
    v9 = Call v8, v4, v6
    Return
  b1() role=CatchHandler:
    v10 = CatchValue
    Return
}
