# Once unseen code can run, an object that was handed to a function nobody knows can be changed in every way but against the declared type of a field, and an object nobody handed out stays as it is
# RUN: flow-solve objects nodes sinks
# CHECK: L0#[[kept]] mutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: L1#[[private]] mutations=[] uses=[]
# CHECK: Variable(g0) = {JSONRawJSON}
# CHECK-NEXT: Variable(g1) = {L1#[[private]]}
# CHECK: DeclaredPart(L0#[[kept]], 0) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# CHECK-NEXT: DeclaredPart(L0#[[kept]], 1) =
# CHECK-NOT: null
# CHECK-NOT: boolean
# CHECK-NOT: string
# CHECK-NOT: unknown
# CHECK: number}
# CHECK-NEXT: DeclaredPart(L1#[[private]], 0) = {"first"}
# CHECK: nativeCode {{*}}L0#[[kept]]
# CHECK-NOT: L1#
# CHECK: unknownJavaScript {{*}}L0#[[kept]]
# CHECK-NOT: L1#

module m0 path="main.js" displayPath="main.js" body=f0
evalscope e0
entry module=m0
layout L0 name="Kept" fields=[{key="untyped" declared={type=anything} flags=[IsRequired]}, {key="count" declared={type=number} flags=[IsRequired]}]
layout L1 name="Private" fields=[{key="untyped" declared={type=anything} flags=[IsRequired]}]
variable g0 name="rawJSON" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="private" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="first"
    v1 = Integer integer=1
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = FinishObject v4
    PutModuleVariable v5 variable=g1
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="keep" [isFreeName]
    v9 = Call v8, -, v3
    v10 = PropGet v7 key="text" [isFreeName]
    v11 = Undefined
    v12 = DirectEval v10, v11 evalScope=e0
    v13 = Builtin builtin=JSON
    v14 = PropGet v13 key="rawJSON"
    PutModuleVariable v14 variable=g0
    Return
}
