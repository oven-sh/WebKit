# A built-in whose result has the class of its receiver answers an instance of each class that reaches the call, and the unknown object for a receiver nobody knows
# RUN: flow-solve nodes
# CHECK: f0, v9) = {Uint8Array@f0:v9{{*}}|Float64Array@f0:v9{{*}}}
# CHECK: f0, v11) = {Uint8Array@f0:v11{{*}}}
# CHECK: f0, v15) = {{*}}unknown
# CHECK: DeclaredPart(Uint8Array@f0:v9{{*}}, 0) = {int[0, 255]}
# CHECK: DeclaredPart(Float64Array@f0:v9{{*}}, 0) = {{*}}number
# RUN(ONE): flow-solve nodes
# ONE-NOT: f0, v9) = {{*}}unknown
# ONE-NOT: f0, v11) = {{*}}Float64Array
# ONE-NOT: f0, v11) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="views" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=8
    v1 = Builtin builtin=Uint8Array
    v2 = Construct v1, -, v0
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=Float64Array
    v5 = Construct v4, -, v0
    PutModuleVariable v5 variable=g0
    v7 = GetModuleVariable variable=g0
    v8 = PropGet v7 key="slice"
    v9 = Call v8, v7 calleeKey="slice"
    v10 = PropGet v2 key="slice"
    v11 = Call v10, v2 calleeKey="slice"
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="view" [isFreeName]
    v14 = Builtin builtin=TypedArrayPrototypeSlice
    v15 = Call v14, v13
    Return
}
