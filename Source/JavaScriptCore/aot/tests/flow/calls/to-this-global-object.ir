# `this` of a sloppy function called without a receiver is the global object, and a neighbor that is only called as a method keeps its receiver alone
# RUN: flow-solve nodes objects
# CHECK: Variable(g0) = {GlobalThis}
# CHECK-NEXT: Variable(g1) = {GlobalThis}
# CHECK-NEXT: Variable(g2) = {L0#[[receiver]]}
# CHECK: GlobalThis mutations=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
variable g0 name="thisOfPlainCall" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="thisOfNull" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="thisOfMethod" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f2
    v3 = Null
    v4 = Call v2, v3
    v5 = NewClosure function=f3
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = PropGet v7 key="method"
    v9 = Call v8, v7 calleeKey="method"
    Return
}
function f1 name="calledPlainly" flags=[IsSloppy, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    PutModuleVariable v1 variable=g0
    Return
}
function f2 name="calledOnNull" flags=[IsSloppy, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    PutModuleVariable v1 variable=g1
    Return
}
function f3 name="method" flags=[IsSloppy, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    PutModuleVariable v1 variable=g2
    Return
}
