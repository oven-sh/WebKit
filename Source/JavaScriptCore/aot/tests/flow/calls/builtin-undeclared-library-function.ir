# A call that only the undeclared overload of a built-in takes stays a call of the entry's own function object. Where a function of the library is behind it, flow enters that function the way native code does
# LIBRARY: own
# RUN: flow-links
# RUN(SOLVE): flow-solve instances nodes
# RUN(RESULTS): flow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=48 function=f1
runtimefunction id=51 function=f2

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = Integer integer=1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Array" [isFreeName]
    v3 = PropGet v2 key="from"
    v4 = Call v3, v2, v0, v0 calleeKey="from"
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v5 = CatchValue
    Return
}
function f1 name="from" role=Library flags=[HasThis] enclosingRuntimeFunction=48 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v1
}
function f2 name="fromAsync" role=Library flags=[HasThis] enclosingRuntimeFunction=51 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}

