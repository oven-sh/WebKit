# Data has one site per array and object node, numbered in preorder with the primitives counted; a list has positions up to the limit and none with a hole
# RUN: flow-summary f0
# LOSS: MaxPositionalParts x1 f0
# CHECK: [[outerA]] = SiteField s0 0
# CHECK: [[outerC]] = SiteField s0 1
# CHECK: [[first]] = SitePosition s1 0
# CHECK: [[second]] = SitePosition s1 1
# CHECK-NOT: SiteSlot s1
# CHECK: [[innerB]] = SiteField s2 0
# CHECK: [[pastLimit]] = SiteSlot s3 ArrayElement
# CHECK: [[eighth]] = SitePosition s3 7
# CHECK-NOT: SitePosition s3 8
# CHECK: [[fieldP]] = SiteField s4 0
# CHECK-NOT: SiteField s4 1
# CHECK: [[holey]] = SiteSlot s5 ArrayElement
# CHECK-NOT: SitePosition s5
# CHECK: s0 = Layout DataNode v0 L0
# CHECK-NEXT: s1 = Instance DataNode v0 Array positions=2 ordinal=1
# CHECK-NEXT: s2 = Layout DataNode v0 L1 ordinal=3
# CHECK-NEXT: s3 = Instance DataNode v1 Array positions=8
# CHECK-NEXT: s4 = Layout DataNode v2 L2
# CHECK-NEXT: s5 = Instance DataNode v3 Array
# CHECK-NEXT: seed [[outer]] Site s0
# CHECK-NEXT: seed [[array]] Site s1
# CHECK-NEXT: seed [[one]] Integers [1, 1]
# CHECK-NEXT: seed [[inner]] Site s2
# CHECK-NEXT: seed [[x]] String "x"
# CHECK-NEXT: seed [[null]] Primitives [Null]
# CHECK-NEXT: seed [[nine]] Site s3
# CHECK: seed [[elementEight]] Integers [8, 8]
# CHECK-NEXT: seed [[elementNine]] Integers [9, 9]
# CHECK-NEXT: seed [[extraKey]] Site s4
# CHECK-NEXT: seed [[ten]] Integers [10, 10]
# CHECK-NEXT: seed [[eleven]] Integers [11, 11]
# CHECK-NEXT: seed [[holes]] Site s5
# CHECK-NEXT: seed [[twenty]] Integers [20, 20]
# CHECK-NEXT: seed [[hole]] Primitives [Undefined]
# CHECK-NEXT: seed [[twentyOne]] Integers [21, 21]
# CHECK: copy [[outer]] -> l2
# CHECK-NEXT: copy [[array]] -> [[outerA]]
# CHECK-NEXT: copy [[one]] -> [[first]]
# CHECK-NEXT: copy [[inner]] -> [[second]]
# CHECK-NEXT: copy [[x]] -> [[innerB]]
# CHECK-NEXT: copy [[null]] -> [[outerC]]
# CHECK-NEXT: copy [[nine]] -> l3
# CHECK: copy [[elementEight]] -> [[eighth]]
# CHECK-NEXT: copy [[elementNine]] -> [[pastLimit]]
# CHECK-NEXT: copy [[extraKey]] -> l4
# CHECK-NEXT: copy [[ten]] -> [[fieldP]]
# CHECK-NEXT: copy [[holes]] -> l5
# CHECK-NEXT: copy [[twenty]] -> [[holey]]
# CHECK-NEXT: copy [[hole]] -> [[holey]]
# CHECK-NEXT: copy [[twentyOne]] -> [[holey]]
# CHECK-NEXT: Allocation#0 origin=v0 site=s0
# CHECK-NEXT: Allocation#1 origin=v0 site=s1
# CHECK-NEXT: Allocation#2 origin=v0 site=s2
# CHECK-NEXT: Allocation#3 origin=v1 site=s3
# CHECK-NEXT: Allocation#4 origin=v2 site=s4
# CHECK-NEXT: Allocation#5 origin=v3 site=s5
# CHECK-NEXT: PropertyAccess#0 kind=Define use=Value origin=v2 receiver=[[extraKey]] key="extra" value=[[eleven]] thrown=l1
# CHECK-NOT: PropertyAccess#1

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Outer" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="c" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Inner" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="WithExtraKey" fields=[{key="p" declared={type=anything} flags=[IsRequired]}]
data d0 root=Object{layout=L0 members=[{key="a" value=Array{contents=anything elements=[Number{value=1}, Object{layout=L1 members=[{key="b" value=String{value="x"}}]}]}}, {key="c" value=Null}]}
data d1 root=Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}, Number{value=5}, Number{value=6}, Number{value=7}, Number{value=8}, Number{value=9}]}
data d2 root=Object{layout=L2 members=[{key="p" value=Number{value=10}}, {key="extra" value=Number{value=11}}]}
data d3 root=Array{contents=number elements=[Number{value=20}, Hole, Number{value=21}]}
function f0 name="data" results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Data data=d1
    v2 = Data data=d2
    v3 = Data data=d3
    Return
}
