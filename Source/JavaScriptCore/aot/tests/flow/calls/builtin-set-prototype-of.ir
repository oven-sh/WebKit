# Object.setPrototypeOf(a, p) puts p into the prototype link of a alone, and a read through a finds what p holds
# RUN: flow-solve objects nodes
# CHECK: L0#[[first]] mutations=[ChangePrototype]
# CHECK-NEXT: L1#[[second]] mutations=[ChangePrototype]
# CHECK-NEXT: L2#[[firstParent]] mutations=[BecomePrototype]
# CHECK-NEXT: L3#[[secondParent]] mutations=[BecomePrototype]
# CHECK-NEXT: L4#[[untouched]] mutations=[] uses=
# CHECK: f0, v10) = {undefined|1}
# CHECK-NEXT: f0, v11) = {undefined|2}
# CHECK-NEXT: f0, v12) = {undefined}
# CHECK: PrototypeLink(L0#[[first]]) = {L2#[[firstParent]]|ObjectPrototype}
# CHECK: PrototypeLink(L1#[[second]]) = {L3#[[secondParent]]|ObjectPrototype}
# CHECK: PrototypeLink(L4#[[untouched]]) = {ObjectPrototype}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="FirstParent" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
layout L3 name="SecondParent" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Untouched" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = NewObject -, v0 layout=L2 fields=[0]
    v5 = NewObject -, v1 layout=L3 fields=[0]
    v6 = NewObject -, v0 layout=L4 fields=[0]
    v7 = Builtin builtin=ObjectSetPrototypeOf
    v8 = Call v7, -, v2, v4
    v9 = Call v7, -, v3, v5
    v10 = PropGet v2 key="m"
    v11 = PropGet v3 key="m"
    v12 = PropGet v6 key="m"
    Return
}
