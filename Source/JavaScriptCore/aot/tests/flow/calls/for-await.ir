# An asynchronous loop holds what the promises of an array hold and the value field of what the promises of a next method of the program hold, and the unknown object only over an iterable nobody knows
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|L0#[[held]]}
# CHECK-NEXT: Variable(g1) = {undefined|L1#[[value]]}
# CHECK-NEXT: Variable(g2) = {{*}}unknown}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Held" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Value" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Iterable" fields=[{key=@@asyncIterator declared={type=anything} flags=[IsRequired]}]
layout L3 name="Iterator" fields=[{key="next" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Result" fields=[{key="value" declared={type=anything} flags=[IsRequired]}, {key="done" declared={type=anything} flags=[IsRequired]}]
variable g0 name="ofArrayOfPromises" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="ofAsyncIterator" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="ofUnknownIterable" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return
}
function f1 name="run" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0
    v2 = NewArray v1 contents=anything
    v3 = IteratorOpen v2 iteratorKind=Async
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3 iteratorKind=Async
    v6 = ResultAt v5
    Branch v6 -> taken b3(), notTaken b2()
  b2():
    v7 = ResultAt v5 index=1
    PutModuleVariable v7 variable=g0
    Jump -> next b1()
  b3():
    v9 = NewClosure function=f3
    v10 = NewObject -, v9 layout=L2 fields=[0]
    v11 = IteratorOpen v10 iteratorKind=Async
    v12 = IteratorResume v11 iteratorKind=Async
    v13 = ResultAt v12 index=1
    PutModuleVariable v13 variable=g1
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = IteratorOpen v16 iteratorKind=Async
    v18 = IteratorResume v17 iteratorKind=Async
    v19 = ResultAt v18 index=1
    PutModuleVariable v19 variable=g2
    Return
}
function f2 name="load" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f3 name="asyncIterator" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f4
    v2 = NewObject -, v1 layout=L3 fields=[0]
    Return v2
}
function f4 name="next" kind=Method flags=[IsAsync, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = Boolean boolean=false
    v4 = NewObject -, v2, v3 layout=L4 fields=[0, 1]
    Return v4
}
