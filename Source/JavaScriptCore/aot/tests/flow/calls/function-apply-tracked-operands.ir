# apply and Reflect.apply with a receiver and a list that are tracked enter a small function per call site, never as generic, so each call gets back its own argument
# RUN: flow-solve instances
# RUN(SECOND): flow-solve instances
# RUN(REFLECT): flow-solve instances
# RUN(GENERIC): flow-solve instances
# RUN(NODES): flow-solve nodes
# CHECK: f1 at f0:v7
# SECOND: f1 at f0:v9
# REFLECT: f2 at f0:v14
# GENERIC-NOT: f1 Generic
# GENERIC-NOT: f2 Generic
# NODES: , f0, v2) = {L1#[[a]]}
# NODES-NEXT: , f0, v3) = {L2#[[b]]}
# NODES: , f0, v7) = {L1#[[a]]}
# NODES: , f0, v9) = {L2#[[b]]}
# NODES: , f0, v14) = {L1#[[a]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="t" declared={type=anything} flags=[IsRequired]}]
layout L1 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewClosure function=f1
    v5 = PropGet v4 key="apply"
    v6 = NewArray v2 contents=anything
    v7 = Call v5, v4, v1, v6 calleeKey="apply"
    v8 = NewArray v3 contents=anything
    v9 = Call v5, v4, v1, v8 calleeKey="apply"
    v10 = NewClosure function=f2
    v11 = Builtin builtin=Reflect
    v12 = PropGet v11 key="apply"
    v13 = NewArray v2 contents=anything
    v14 = Call v12, v11, v10, v1, v13 calleeKey="apply"
    Return
}
function f1 name="calledByApply" flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
function f2 name="calledByReflectApply" flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
