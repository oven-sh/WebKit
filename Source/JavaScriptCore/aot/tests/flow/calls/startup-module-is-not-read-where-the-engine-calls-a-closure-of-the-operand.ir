# String.prototype.replace finds @@replace of its operand under the name: a closure, which a statement of its own calls. It is a built-in of the engine: what it passes is what the language says, and no function of the host.
# The host's twin: flow/calls/startup-module-is-read-where-the-host-calls-a-closure-of-the-operand.ir
# RUN: flow-links calls modules
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: f0 v6 -> {{*}} f3 Protocol
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Pattern"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject layout=L1
    PropSet v1, v0 key=@@replace
    v3 = String string="text"
    v4 = String string="other"
    v5 = PropGet v3 key="replace"
    v6 = Call v5, v3, v1, v4 calleeKey="replace"
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="replace" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="replaced"
    Return v2
}
