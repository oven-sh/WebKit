# The formatter of console.log prints the enumerable properties that its operand inherits: the objects above the operand are listed and their values read, up the whole chain.
# A prototype of an object that is not printed has no use, and neither has the prototype object of a class whose instance is printed: what a class defines is not enumerable
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[BecomePrototype] uses=[ReadByUnknownKey, Enumerated]
# CHECK: L1#{{*}} mutations=[BecomePrototype] uses=[ReadByUnknownKey, Enumerated]
# CHECK: L2#{{*}} mutations=[BecomePrototype] uses=[]
# RUN(CLASS): flow-solve objects
# CLASS: f2.prototype mutations=[BecomePrototype] uses=[] events
# RUN(VALUES): flow-solve locations
# VALUES: DeclaredPart(L0#{{*}}, 0) events=[InitializedAtAllocation, ReadAsValue
# VALUES: DeclaredPart(L0#{{*}}, 1) events=[InitializedAtAllocation, ReadAsValue
# VALUES: DeclaredPart(L1#{{*}}, 0) events=[InitializedAtAllocation, ReadAsValue

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Printed" fields=[{key="run" declared={type=anything} flags=[IsRequired]}, {key="unit" declared={type=anything} flags=[IsRequired]}]
layout L1 name="PrintedTwoLevelsUp" fields=[{key="deep" declared={type=anything} flags=[IsRequired]}]
layout L2 name="NotPrinted" fields=[{key="unit" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="Printable" constructor=f2

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=ObjectCreate
    v3 = Builtin builtin=ConsoleLog
    v4 = NewClosure function=f1
    v5 = NewObject -, v4, v1 layout=L0 fields=[0, 1]
    v6 = Call v2, -, v5
    v7 = Call v3, -, v6
    v8 = NewObject -, v1 layout=L1 fields=[0]
    v9 = Call v2, -, v8
    v10 = Call v2, -, v9
    v11 = Call v3, -, v10
    v12 = NewObject -, v1 layout=L2 fields=[0]
    v13 = Call v2, -, v12
    v14 = NewClosure function=f2
    v15 = NewClass v14 layout=L3
    v16 = NewClosure function=f1
    DefineMethod v15, v16 layout=L3 key="run"
    v18 = FinishClass v15 layout=L3
    v19 = Construct v18
    v20 = Call v3, -, v19
    Return
}

function f1 name="run" kind=Method results=[{type=anything}] {
  b0():
    Return
}
function f2 name="Printable" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3 fields=[]
    Return v2
}
