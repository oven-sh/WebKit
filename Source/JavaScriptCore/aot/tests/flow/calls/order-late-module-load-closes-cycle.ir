# A module load whose name becomes known only after the order of execution was computed once makes the order be computed again, though it adds no instance, evaluated module, call link or escaped object
# main imports owner, then reader, and reader imports x from owner. The body of owner calls `early` before both of its stores. The key of `early` is "a" until the first computation of the order adds
# undefined to g1. Only then does the table answer "/app/reader.js", and the loader, called as a value, evaluates reader while owner is still running: reader reads x before its store
# RUN: flow-order failed locations modules before m1 m2
# RUN(NODES): flow-solve nodes
# CHECK: read-before-initialization g0
# CHECK: g0: Unknown AtMostOnce
# CHECK: m1: component [[cycle]] cycle
# CHECK-NEXT: m2: component [[cycle]] cycle
# CHECK: before m1 m2 Unknown
# NODES: Variable(g0) = {1|absent}
# NODES: , f2, v0) = {1|absent}

module m0 path="/app/main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}]
module m1 path="/app/owner.js" displayPath="owner.js" body=f1 exports=[{name="x" variable=g0}]
module m2 path="/app/reader.js" displayPath="reader.js" body=f2 requests=[{target=m1}]
module m3 path="/app/other.js" displayPath="other.js" body=f4
entry module=m0
layout L0 name="Table" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="undefined" declared={type=anything} flags=[IsRequired]}]
variable g0 name="x" module=m1 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="key" module=m1 declared={type=anything} initialization=Undefined
variable g2 name="early" module=m1 declared={type=function} initialization=Function function=f3
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="owner" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    v1 = Call v0
    v2 = String string="a"
    PutModuleVariable v2 variable=g1
    v4 = Integer integer=1
    PutModuleVariable v4 variable=g0
    Return
}
function f2 name="reader" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="x"
    Return
}
function f3 name="early" module=m1 results=[{type=anything}] {
  b0():
    v0 = String string="/app/other.js"
    v1 = String string="/app/reader.js"
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = GetModuleVariable variable=g1
    v5 = ElemGet v3, v4
    v6 = TypeTest v5 testedType=string
    Branch v6 -> taken b1(| 0), notTaken b2()
  b1(v7):
    v8 = ModuleBuiltin builtin=ModuleRequire module=m1
    v9 = Call v8, -, v7
    Return
  b2():
    Return
}
function f4 name="other" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
