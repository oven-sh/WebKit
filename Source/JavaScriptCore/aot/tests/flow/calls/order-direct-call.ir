# A function whose one mention is a direct call in the module body runs only as a part of that body: a store that dominates its returns has run when the call returns, and what it enters is entered at that point of its body, not at the call
# RUN: flow-order timelines locations failed
# CHECK: timeline f0: f1 after b0#0, f2 after f1:b0#3, f3 after b0#1
# CHECK-NEXT: g0: StoredBeforeEveryRead AtMostOnce
# CHECK-NEXT: g1: Unknown AtMostOnce
# CHECK-NEXT: g2: Unknown AtMostOnce
# CHECK-NEXT: read-before-initialization g1
# CHECK-NEXT: read-before-initialization g2
# CHECK-NEXT: read-before-initialization g3
# CHECK-NOT: read-before-initialization

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="storedAboveCall" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="storedBelowCall" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g2 name="storedOnOnePath" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g3 name="storedByFunctionCalledTwice" module=m0 declared={type=anything|absent} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f3
    v2 = CallDirect function=f3
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="storedAboveCall"
    v5 = GetModuleVariable variable=g1
    v6 = CheckInitialized v5 name="storedBelowCall"
    v7 = GetModuleVariable variable=g2
    v8 = CheckInitialized v7 name="storedOnOnePath"
    v9 = GetModuleVariable variable=g3
    v10 = CheckInitialized v9 name="storedByFunctionCalledTwice"
    Return
}
function f1 name="initialize" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    v3 = Call v2
    PutModuleVariable v0 variable=g1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="flag" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v0 variable=g2
    Jump -> next b2()
  b2():
    Return
}
function f2 name="readDuringCall" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="storedAboveCall"
    v2 = GetModuleVariable variable=g1
    v3 = CheckInitialized v2 name="storedBelowCall"
    Return v3
}
function f3 name="storeTwice" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g3
    Return
}
