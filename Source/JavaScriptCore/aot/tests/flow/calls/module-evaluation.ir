# Every module the entry module reaches through its requests is evaluated, whatever the phase of the request or the kind of the module, and its body is linked once though two modules import it; a module nobody requests is not
# RUN: flow-links calls modules
# CHECK-COUNT-5: host - -> {{*}} Host Once
# CHECK-NOT: Host Once
# CHECK: evaluated m0 m1 m2 m3 m4
# CHECK-NOT: m5
# CHECK: namespaces
# RUN(MAIN): flow-links calls
# MAIN: host - -> {{*}} f0 Host Once
# RUN(FIRST): flow-links calls
# FIRST: host - -> {{*}} f1 Host Once
# RUN(SECOND): flow-links calls
# SECOND: host - -> {{*}} f2 Host Once
# RUN(DEFERRED): flow-links calls
# DEFERRED: host - -> {{*}} f3 Host Once
# RUN(DATA): flow-links calls
# DATA: host - -> {{*}} f4 Host Once
# RUN(UNREACHED): flow-links calls
# UNREACHED-NOT: -> {{*}} f5

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}, {target=m3 phase=Defer}, {target=m4}]
module m1 path="/first.js" displayPath="first.js" body=f1 requests=[{target=m2}]
module m2 path="/second.js" displayPath="second.js" body=f2
module m3 path="/deferred.js" displayPath="deferred.js" body=f3
module m4 path="/data.json" displayPath="data.json" kind=Data requireResult=DefaultExport body=f4 data=d0 exports=[{name="default" variable=g0}]
module m5 path="/never-requested.js" displayPath="never-requested.js" body=f5
entry module=m0
layout L0 name="Data" fields=[{key="a" declared={type=number}}]
variable g0 name="default" module=m4 declared={type=anything} initialization=Uninitialized
data d0 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}]} module=m4
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="first" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="deferred" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f4 name="data" module=m4 kind=Module results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    PutModuleVariable v0 variable=g0
    Return
}
function f5 name="neverRequested" module=m5 kind=Module results=[{type=anything}] {
  b0():
    Return
}
