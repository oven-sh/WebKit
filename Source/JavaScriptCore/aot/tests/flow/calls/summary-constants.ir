# The seed of every constant: a number is an integer range only when it is a tracked integer, a built-in is an object only when its entry is one
# RUN: flow-summary f0
# CHECK: summary f0: parameters=0 results=1 locals=16 values=14 flags=[]
# CHECK: l15 = v13
# CHECK-NEXT: seed l2 Primitives [Undefined]
# CHECK-NEXT: seed l3 Primitives [Null]
# CHECK-NEXT: seed l4 Primitives [Absent]
# CHECK-NEXT: seed l5 Primitives [True]
# CHECK-NEXT: seed l6 Primitives [False]
# CHECK-NEXT: seed l7 Integers [3, 3]
# CHECK-NEXT: seed l8 Integers [4, 4]
# CHECK-NEXT: seed l9 Primitives [FractionalNumber]
# CHECK-NEXT: seed l10 Primitives [WholeNumber]
# CHECK-NEXT: seed l11 String "text"
# CHECK-NEXT: seed l12 Primitives [BigInt]
# CHECK-NEXT: seed l13 Builtin MathMax
# CHECK-NEXT: seed l14 TypeAsRead symbol
# CHECK-NEXT: seed l15 TypeAsRead whole
# CHECK-NOT: Site

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="constants" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Null
    v2 = Absent
    v3 = Boolean boolean=true
    v4 = Boolean boolean=false
    v5 = Integer integer=3
    v6 = Double number=4
    v7 = Double number=0.5
    v8 = Double number=-0
    v9 = String string="text"
    v10 = BigInt digits="12"
    v11 = Builtin builtin=MathMax
    v12 = Builtin builtin=SymbolIterator
    v13 = Integer integer=4611686018427387904
    Return
}
