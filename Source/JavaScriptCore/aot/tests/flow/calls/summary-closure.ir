# A closure creation says whether the closure is stored once and whether it captures nothing or only the object it is stored into
# RUN: flow-summary f0
# CHECK: [[captureOfStored]] = SiteCapture s3 0
# CHECK-NEXT: [[captureOfOtherObject]] = SiteCapture s4 0
# CHECK-NEXT: [[captureOfUsedTwice]] = SiteCapture s5 0
# CHECK-NOT: SiteCapture
# CHECK: s0 = Closure Operation v1 f1
# CHECK: s3 = Closure Operation v4 f2
# CHECK-NEXT: s4 = Closure Operation v6 f2
# CHECK-NEXT: s5 = Closure Operation v8 f2
# CHECK-NEXT: s6 = Closure Operation v11 f1
# CHECK-NEXT: s7 = Closure Operation v14 f1
# CHECK: copy l4 -> [[captureOfOtherObject]]
# CHECK-NEXT: copy l5 -> [[captureOfStored]]
# CHECK-NEXT: copy l5 -> [[captureOfUsedTwice]]
# CHECK: closure l3 f1 s0 StoredOnce Nothing
# CHECK-NEXT: closure l6 f2 s3 StoredOnce StoredIntoObject
# CHECK-NEXT: closure l7 f2 s4 StoredOnce Other
# CHECK-NEXT: closure l8 f2 s5 Other Other
# CHECK-NEXT: closure l9 f1 s6 Other Nothing
# CHECK-NEXT: closure l10 f1 s7 StoredOnce Nothing

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Holder" fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Filled" fields=[{key="method" declared={type=anything}}, {key="other" declared={type=anything}}]
function f0 name="creates" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    v1 = NewClosure function=f1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewObject layout=L1
    v4 = NewClosure v3 function=f2
    PropSet v3, v4 key="method"
    v6 = NewClosure v2 function=f2
    PropSet v3, v6 key="method"
    v8 = NewClosure v3 function=f2
    PropSet v3, v8 key="method"
    PropSet v3, v8 key="other"
    v11 = NewClosure function=f1
    Jump -> next b1()
  b1():
    LoopHint
    PropSet v3, v11 key="other"
    v14 = NewClosure function=f1
    PropSet v3, v14 key="other"
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="capturesNothing" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="capturesObject" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
