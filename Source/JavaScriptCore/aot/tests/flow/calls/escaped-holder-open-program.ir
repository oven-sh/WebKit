# Where the whole program is open, unknown JavaScript names every member of every built-in object, also the ones that stayed behind when their holder escaped
# OPTIONS: admit=RuntimeCode
# RUN: flow-links unseen uses
# CHECK: unknown-javascript yes
# CHECK: use ProcessDlopen [{{*}}Escaped]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Builtin builtin=Process
    v3 = Call v1, -, v2
    v4 = PropGet v0 key="input" [isFreeName]
    v5 = PropGet v0 key="key" [isFreeName]
    v6 = ElemGet v4, v5
    Return
}
