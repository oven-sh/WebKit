# What a callee throws reaches the handler of the call, or the caller's own callers, or native code when the host entered the function
# RUN: flow-solve nodes sinks
# CHECK: Variable(g0) = {L0#[[thrown]]|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g1) = {L0#[[thrown]]|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g2) = {L1#[[elsewhere]]|opaque(Error)@host:-.error}
# CHECK: nativeCode {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK: L2#[[toHost]],
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK: unknownJavaScript {

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Thrown" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="ThrownElsewhere" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="ThrownToHost" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
variable g0 name="caughtAtCall" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="caughtTwoCallsUp" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="caughtElsewhere" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = CallDirect function=f1
    Jump -> next b3()
  b2() role=CatchHandler:
    v1 = CatchValue
    PutModuleVariable v1 variable=g0
    Jump -> next b3()
  b3():
    v3 = CallDirect function=f3
    v4 = CallDirect function=f6
    v5 = NewClosure function=f4
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="register" [isFreeName]
    Jump -> next b4()
  b4() handler=b5():
    v8 = Call v7, -, v5
    Return
  b5() role=CatchHandler:
    v9 = CatchValue
    Return
}
function f1 name="throws" results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
function f2 name="callsWithoutTry" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return v0
}
function f3 name="catchesTwoCallsUp" results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = CallDirect function=f2
    Return
  b2() role=CatchHandler:
    v1 = CatchValue
    PutModuleVariable v1 variable=g1
    Return
}
function f4 name="enteredByHost" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f5
    Return
}
function f5 name="throwsToHost" results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
function f6 name="catchesItsOwnCallee" results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = CallDirect function=f7
    Return
  b2() role=CatchHandler:
    v1 = CatchValue
    PutModuleVariable v1 variable=g2
    Return
}
function f7 name="throwsElsewhere" results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
