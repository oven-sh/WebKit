# What is pushed through a helper, or through one variable that holds nine arrays, is in the element slot of each of the arrays, and no array is in a sink
# RUN: flow-solve nodes sinks
# CHECK: Variable(g0) = {Array@f0:v4|Array@f0:v7|Array@f0:v10|Array@f0:v13|Array@f0:v16|Array@f0:v19|Array@f0:v22|Array@f0:v25|Array@f0:v28}
# CHECK: DeclaredPart(Array@f0:v4, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v7, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v10, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v13, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v16, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v19, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v22, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v25, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NEXT: DeclaredPart(Array@f0:v28, 0) = {L0#[[pushed]]|L1#[[shared]]}
# CHECK-NOT: DeclaredPart(Array@f0:v31, 0)
# CHECK: , f0, v1) = {L0#[[pushed]]}
# CHECK: , f2, v1) = {L1#[[shared]]}
# CHECK-LABEL: nativeCode {
# CHECK-NOT: Array@f0
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-LABEL: unknownJavaScript {
# CHECK-NOT: Array@f0
# CHECK-NOT: L0#
# CHECK-NOT: L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L1 name="SharedItem" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
variable g0 name="lists" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = NewArray contents=anything @10
    v5 = Call v3, -, v4, v2
    PutModuleVariable v4 variable=g0
    v7 = NewArray contents=anything @20
    v8 = Call v3, -, v7, v2
    PutModuleVariable v7 variable=g0
    v10 = NewArray contents=anything @30
    v11 = Call v3, -, v10, v2
    PutModuleVariable v10 variable=g0
    v13 = NewArray contents=anything @40
    v14 = Call v3, -, v13, v2
    PutModuleVariable v13 variable=g0
    v16 = NewArray contents=anything @50
    v17 = Call v3, -, v16, v2
    PutModuleVariable v16 variable=g0
    v19 = NewArray contents=anything @60
    v20 = Call v3, -, v19, v2
    PutModuleVariable v19 variable=g0
    v22 = NewArray contents=anything @70
    v23 = Call v3, -, v22, v2
    PutModuleVariable v22 variable=g0
    v25 = NewArray contents=anything @80
    v26 = Call v3, -, v25, v2
    PutModuleVariable v25 variable=g0
    v28 = NewArray contents=anything @90
    v29 = Call v3, -, v28, v2
    PutModuleVariable v28 variable=g0
    v31 = NewArray contents=anything @100
    v32 = CallDirect function=f2
    Return
}
function f1 name="add" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push"
    Return
}
function f2 name="addToEach" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    v3 = GetModuleVariable variable=g0
    v4 = PropGet v3 key="push"
    v5 = Call v4, v3, v2 calleeKey="push"
    Return
}
