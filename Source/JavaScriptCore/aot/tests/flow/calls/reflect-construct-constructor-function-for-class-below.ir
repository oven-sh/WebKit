# Reflect.construct runs a constructor function for a class below it as new.target: what comes back is an object of the layout of that class, made at the call, which inherits from the prototype of the class and never went through its constructor
# RUN(RESULT): flow-solve nodes
# RUN(OBJECTS): flow-solve objects
# RESULT: f0, v10) = {L1#[[made]]}
# RESULT: PrototypeLink(L1#[[made]]) = {f2.prototype}
# The class object inherits from the function. Nothing else happens to it
# OBJECTS: f1 mutations=[BecomePrototype] {{*}}events=[{{*}}OtherNewTarget

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Legacy" constructor=f1 fields=[{key="value" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="Below" constructor=f2 fields=[{key="next" declared={type=anything}}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = ResolveHeritage v0
    v2 = NewClosure function=f2
    v3 = NewClass v2, v0, v1 layout=L1
    v4 = FinishClass v3 layout=L1
    v5 = Integer integer=1
    v6 = Construct v4, -, v5
    v7 = Integer integer=8
    v8 = NewArray v7 contents=anything
    v9 = Builtin builtin=ReflectConstruct
    v10 = Call v9, -, v0, v8, v4
    Return
}
function f1 name="Legacy" flags=[HasThis] thisType={type=anything predicted=L0} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="value"
    v3 = Undefined
    Return v3
}
function f2 name="Below" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=object}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1
    v5 = Integer integer=1
    v6 = Add v2, v5
    PropSet v4, v6 key="next"
    Return v4
}
