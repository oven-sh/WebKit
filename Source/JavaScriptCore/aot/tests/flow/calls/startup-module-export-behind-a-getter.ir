# What native code reads from a start-up module is a read of a property: where the name is an accessor, native code runs the getter with the object as `this`, and what the getter answers reaches native code
# RUN: flow-links calls modules
# RUN(OTHERS): flow-links calls
# RUN(SINKS): flow-solve nodes sinks
# CHECK: host - -> {{*}} f5 Accessor
# CHECK: host - -> {{*}} f2 Host
# OTHERS-NOT: -> {{*}} f4
# SINKS: , f5, parameter 0) = {L0#[[exports]]}
# SINKS-LABEL: nativeCode {
# SINKS-NOT: L0#
# SINKS-NOT: f4
# SINKS-NOT: f5
# SINKS-LABEL: unknownJavaScript {

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="format" declared={type=anything} flags=[IsRequired]}]
variable g0 name="inspect" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="printed" [isFreeName]
    v2 = Builtin builtin=Console
    v3 = Builtin builtin=ConsoleLog
    v4 = Call v3, v2, v1
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f4
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure function=f5
    DefineGetter v3, v4 key="inspect"
    Return v3
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="unused" module=m1 role=Library results=[{type=anything}] {
  b0():
    Return
}
function f4 name="format" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="inspect" module=m1 kind=Getter role=Library flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    Return v1
}
