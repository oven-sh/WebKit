    v5 = Call v4, -, v0, v3, v2
    v6 = PropGet v0 key="prototype"
    v7 = NewClosure function=f3
    PropSet v6, v7 key="kill"
    v9 = PropGet v2 key="prototype"
    v10 = NewClosure function=f4
    PropSet v9, v10 key="on"
    v12 = NewClosure function=f5
    v13 = NewObject -, v12 layout=L2 fields=[0]
    v14 = NewObject -, v13 layout=L3 fields=[0]
    v15 = Builtin builtin=ObjectDefineProperties
    v16 = PropGet v0 key="prototype"
    v17 = Call v15, -, v16, v14
    v18 = Construct v0, -
    v19 = PropGet v18 key="kill"
    v20 = Call v19, v18 calleeKey="kill"
    v21 = PropGet v18 key="on"
    v22 = Call v21, v18 calleeKey="on"
    v23 = PropGet v18 key="size"
    PutModuleVariable v18 variable=g0
    Return
}
