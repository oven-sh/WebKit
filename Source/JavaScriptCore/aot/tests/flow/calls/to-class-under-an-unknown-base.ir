layout L0 kind=Instance name="Worker" module=m0 constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="EventEmitter" module=m0 constructor=f2 flags=[IsConstructorFunction]
layout L2 name="Descriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Map" fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
layout L4 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="made" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module role=Library results=[{type=anything}] {
  b0():
