    v11 = NewArray v4 contents=anything
    v12 = PropGet v1 key="race"
    v13 = Call v12, v1, v11 calleeKey="race"
    Return
}
function f1 name="load" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = String string="ann"
    v1 = NewObject -, v0 layout=L0 fields=[0]
