# Copy edges of a summary: local to a variable, a variable to a local, local to a result, each printed once, and none for a value nobody passes on. A block parameter that every edge fills from one value shares the local of that value
# RUN: flow-summary f0
# CHECK: summary f0: parameters=2 results=1 locals=5 values=5
# CHECK-NEXT: l0 = v0, v2
# CHECK-NEXT: l1 = v1
# CHECK-NEXT: l4 = v4
# CHECK-NEXT: x0 = Variable g0
# CHECK-NOT: Variable g1
# CHECK-NOT: seed
# CHECK: copy l0 -> x0
# CHECK-NOT: copy l0
# CHECK-NOT: copy l1
# CHECK: copy l4 -> l2
# CHECK-NEXT: copy x0 -> l4
# CHECK-NEXT: LocationAccess#0 kind=Store use=Value origin=v3 location=x0 value=l0
# CHECK-NEXT: LocationAccess#1 kind=Load use=Value origin=v4 location=x0 value=l4
# CHECK-NEXT: waiters l0: LocationAccess#0
# CHECK-NOT: LocationAccess
# CHECK-NOT: waiters

module m0 path="main.js" displayPath="main.js"
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="untouched" module=m0 declared={type=anything} initialization=Undefined
function f0 name="copies" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v0)
  b3(v2):
    PutModuleVariable v2 variable=g0
    v4 = GetModuleVariable variable=g0
    Return v4
}
