# Code that could run unseen code costs nothing while nothing reaches it: no record, no unknown JavaScript, and every module keeps its order
# RUN: flow-links unseen modules
# CHECK: evaluated m0 m1
# CHECK-NOT: m2
# CHECK-NOT: m3
# CHECK: namespaces
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# RUN(ORDER): flow-order modules before m0 m1
# ORDER-NOT: cycle
# ORDER: m0: component [[imported]] after {}
# ORDER-NEXT: m1: component [[main]] after {[[imported]]}
# ORDER-NOT: cycle
# ORDER: before m0 m1 CompletesBefore

module m0 path="imported.js" displayPath="imported.js" body=f0
module m1 path="main.js" displayPath="main.js" body=f1 requests=[{target=m0}]
module m2 path="unimported.js" displayPath="unimported.js" body=f2 requests=[{target=m3}]
module m3 path="uncompiled.js" displayPath="uncompiled.js" kind=External referrer=m2
evalscope e0
entry module=m1
function f0 name="imported" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="main" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="unimported" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="evaluates" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return v2
}
function f4 name="makesFunction" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Function
    v2 = Construct v1, -, v0
    Return v2
}
function f5 name="requires" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = RequireDynamic v0 referrer=m1
    Return v1
}
function f6 name="imports" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ImportDynamic v0 referrer=m1
    Return v1
}
