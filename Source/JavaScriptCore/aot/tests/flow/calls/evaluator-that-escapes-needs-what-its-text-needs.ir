# The evaluator is handed to a function that nobody knows, which may call it.
# Without the call: flow/calls/evaluator-that-is-only-read-evaluates-no-text.ir
# RUN: flow-links calls
# CHECK: host - -> {{*}} f1 Host

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Function" [isFreeName]
    v2 = PropGet v0 key="notListedAnywhere" [isFreeName]
    v3 = Call v2, -, v1
    Return
}
function f1 name="performIteration" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
runtimefunction id=74 function=f1
