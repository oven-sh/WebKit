# The statements of the class operations: the class and its methods, reads of `prototype`, and what stands in for a heritage of null or a prototype that is no object
# RUN: flow-summary f0 f1
# CHECK-LABEL: summary f0:
# CHECK: copy l5 -> l6
# CHECK-NEXT: copy l6 -> l2
# CHECK: copy l11 -> l12
# CHECK: ConditionalSeed#0 from=l0 type=null kind=Inside origin=v2 seed=(l4 Primitives [Null])
# CHECK-NOT: ConditionalSeed
# CHECK: PropertyAccess#0 kind=Load use=Value origin=v2 receiver=l0 key="prototype" value=l4 thrown=l3
# CHECK-NEXT: PropertyAccess#1 kind=Load use=Value origin=v5 receiver=l6 key="prototype" value=l7 thrown=l3
# CHECK-NEXT: ClassDefinition#0 origin=v4 layout=L0 constructor=l5 heritage=l0 prototypeParent=l4
# CHECK-NEXT: ClassDefinition#1 origin=v13 layout=L1 constructor=l11
# CHECK-NOT: heritage
# CHECK: MethodDefinition#0 origin=v7 layout=L0 side=Prototype methodKind=Method index=0 classObject=l6 function=l8 key="m"
# CHECK-NEXT: MethodDefinition#1 origin=v10 layout=L0 side=Static methodKind=Getter index=1 classObject=l6 function=l10 computedKey=l9
# CHECK-LABEL: summary f1:
# CHECK: Filter#0 from=[[read]] to=l3 type=object kind=Inside
# CHECK-NEXT: ConditionalSeed#0 from=[[read]] type=object kind=Outside origin=v1 seed=(l3 Builtin ObjectPrototype)
# CHECK-NEXT: PropertyAccess#0 kind=Load use=Value origin=v1 receiver=l0 key="prototype" value=[[read]] thrown=l2

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 kind=Instance name="Derived" constructor=f1 flags=[HasHeritage]
layout L1 kind=Instance name="Base" constructor=f3
function f0 name="definesClass" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ResolveHeritage v0
    v3 = NewClosure function=f1
    v4 = NewClass v3, v0, v2 layout=L0
    v5 = GetClassPrototype v4 layout=L0
    v6 = NewClosure function=f2
    DefineMethod v4, v6 layout=L0 key="m"
    v8 = ToPropertyKey v1
    v9 = NewClosure function=f2
    DefineMethod v4, v9, v8 layout=L0 side=Static methodKind=Getter index=1
    v11 = FinishClass v4 layout=L0
    v12 = NewClosure function=f3
    v13 = NewClass v12 layout=L1
    v14 = FinishClass v13 layout=L1
    Return v11
}
function f1 name="Derived" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    Return v1
}
function f2 name="method" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    v3 = FinishObject v2
    Return v3
}
