# A require() whose specifier is one of two constants has an arm for each and no arm that loads by name: a module that neither names is not evaluated, the result is what the two export, and the build does not warn
# RUN: flow-links modules unseen
# CHECK: evaluated m0 m1 m2
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# RUN(NODES): flow-solve nodes
# NODES: , f0, v8) = {L0#0|L1#1|ModuleObjectExports@m1|ModuleObjectExports@m2}
# RUN(CODE): compile
# CODE: image not empty

module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="first.cjs" displayPath="first.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
module m2 path="second.cjs" displayPath="second.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
module m3 path="third.cjs" displayPath="third.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f3
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    SwitchString v4 strings=["./first.cjs", "./second.cjs"] -> case b1(), case b2(), otherwise b3()
  b1():
    v6 = RequireModule module=m1 referrer=m0 specifier="./first.cjs"
    Jump -> next b4(v6)
  b2():
    v7 = RequireModule module=m2 referrer=m0 specifier="./second.cjs"
    Jump -> next b4(v7)
  b3():
    Unreachable
  b4(v8: anything):
    Return
}
function f1 name="first" module=m1 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Boolean boolean=true
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = FinishObject v7
    PropSet v3, v8 key="exports"
    Return
}
function f2 name="second" module=m2 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Boolean boolean=true
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = FinishObject v7
    PropSet v3, v8 key="exports"
    Return
}
function f3 name="third" module=m3 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
