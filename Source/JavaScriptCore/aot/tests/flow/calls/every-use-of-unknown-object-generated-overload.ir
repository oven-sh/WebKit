# Every use is also what an operand gets whose uses nobody wrote. The setter of BuildMessage.prototype.message comes from a class definition: a store of a value nobody knows through a receiver nobody knows finds it,
# and it is native code, which stores into, redefines, freezes and reparents nothing that has escaped. The store itself adds the name and no more
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#{{*}}, 0) = {1}
# CHECK: PrototypeLink(L0#{{*}}) = {ObjectPrototype}
# RUN(OBJECTS): flow-solve objects
# OBJECTS: o0 unknown mutations=[AddProperty] uses
# OBJECTS: L0#{{*}} mutations=[ReachNativeCode] uses
# RUN(LINKS): flow-links builtins
# LINKS: builtin {{*}} v5 BuildMessagePrototypeMessage/1 Set

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="launder" [isFreeName]
    v4 = Call v3, -, v1
    PropSet v4, v4 key="message"
    Return
}
