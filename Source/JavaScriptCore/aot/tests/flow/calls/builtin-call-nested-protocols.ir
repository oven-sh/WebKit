# `array + ""` runs Array.prototype.toString, which joins the elements, which runs toString of each element, which may be an array again, here also the array itself.
# Each built-in that runs for another one is a statement of its own: one on the operands of the first call under its key, one with nodes of its own for all the others,
# so a cycle of arrays ends. A toString of the program's own is entered with the object as `this`, and what it does is seen. An object without one enters nothing.
# RUN: flow-links calls statements
# RUN(NODES): flow-solve nodes sinks
# STATISTIC: FlowWorklistSteps <= 2000

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="seen" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Named" fields=[{key="toString" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Plain" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray v2 contents=anything
    v4 = NewArray v3 contents=anything
    v5 = PropGet v4 key="push"
    v6 = Call v5, v4, v4 calleeKey="push"
    v7 = String string=""
    v8 = Add v4, v7
    v9 = Integer integer=1
    v10 = NewObject -, v9 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = NewArray v11 contents=anything
    v13 = Add v12, v7
    Return
}
function f1 name="toString" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    v2 = String string="named"
    Return v2
}
# CHECK: f0 v8 -> i{{*}} f1 Protocol Once
# CHECK-NOT: f0 v13 ->
# CHECK: statement i{{*}} v8 ArrayPrototypeToString Call Protocol Once
# CHECK: statement i{{*}} v13 ArrayPrototypeToString Call Protocol Once
# CHECK: statement i{{*}} v8 ArrayPrototypeToString Call Protocol Once own-nodes
# CHECK-NOT: v8 ArrayPrototypeToString
# NODES: Variable(g0) = {L0#[[named]]}
# NODES: Position(Array@f0:v4, 0) = {Array@f0:v3|Array@f0:v4}
# NODES: , f0, v8) = {string}
# NODES: , f0, v13) = {string}
# NODES: , f1, parameter 0) = {L0#[[named]]}
# NODES-NOT: , f1, parameter 0) =
# NODES: nativeCode {
# NODES-NOT: L0#
# NODES-NOT: L1#
# NODES-NOT: Array@
