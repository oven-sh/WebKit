# A direct call passes one argument per entry parameter, captures included, each result goes to its ResultAt, and a direct call of an async function gives a promise
# RUN: flow-links calls operands
# RUN(ASYNC): flow-links calls operands
# RUN(NODES): flow-solve nodes
# RUN(PROMISE): flow-solve nodes
# CHECK: link [[swap]]: [[main]] f0 v3 -> [[instance]] f1 Call Once
# CHECK-NOT: f1 Call
# CHECK: operand [[captured]](f0:l{{*}}) -> [[capture]](f1:l0) link [[swap]]
# CHECK-NEXT: operand [[argument]](f0:l{{*}}) -> [[parameter]](f1:l1) link [[swap]]
# CHECK-NOT: (f1:l
# ASYNC: link [[later]]: [[main]] f0 v6 -> [[instance]] f2 Call Once
# ASYNC-NOT: f2 Call
# ASYNC: operand [[argument]](f0:l{{*}}) -> [[parameter]](f2:l0) link [[later]]
# ASYNC-NOT: (f2:l
# NODES: , f0, v1) = {L0#[[captured]]}
# NODES-NEXT: , f0, v2) = {L1#[[argument]]}
# NODES-NEXT: , f0, v4) = {L1#[[argument]]}
# NODES-NEXT: , f0, v5) = {L0#[[captured]]}
# NODES: , f1, parameter 0) = {L0#[[captured]]}
# NODES-NEXT: , f1, parameter 1) = {L1#[[argument]]}
# NODES-NEXT: , f1, result 0) = {L1#[[argument]]}
# NODES-NEXT: , f1, result 1) = {L0#[[captured]]}
# PROMISE: , f0, v2) = {L1#[[argument]]}
# PROMISE: , f0, v6) = {Promise@f2:result@[[call]]}
# PROMISE: DeclaredPart(Promise@f2:result@[[call]], 0) = {L1#[[argument]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Captured" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Argument" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = CallDirect v1, v2 function=f1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    v6 = CallDirect v2 function=f2
    Return
}
function f1 name="swap" captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}, {type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Results v1, v0
    Return v2
}
function f2 name="later" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
