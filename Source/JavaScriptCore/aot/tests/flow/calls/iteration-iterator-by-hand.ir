# An array iterator that the program steps by calling next itself gives the elements of its array, and neither the array nor an element reaches a sink
# RUN: flow-solve nodes sinks
# RUN(KNOWN): flow-solve nodes
# CHECK: Variable(g0) = {{*}}L0#[[a]]|L1#[[b]]}
# CHECK: , f0, v5) = {ArrayIterator@f0:[[iterator]]}
# CHECK: nativeCode {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-NOT: @f0:
# KNOWN-NOT: Variable(g0) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
entry module=m0
runtimefunction id=70 function=f1
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="value" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewArray v1, v2 contents=anything
    v4 = PropGet v3 key="values"
    v5 = Call v4, v3 calleeKey="values"
    v6 = PropGet v5 key="next"
    v7 = Call v6, v5 calleeKey="next"
    v8 = PropGet v7 key="value"
    PutModuleVariable v8 variable=g0
    Return
}
function f1 name="next" module=m1 role=Library flags=[HasThis] enclosingRuntimeFunction=70 results=[{type=anything}] {
  b0(v0: anything):
    v1 = HasJSType v0 first=5 last=5
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ClaimDeclared v0 declared={type=object flags=[IsFromCompiler]}
    v3 = StepArrayIterator v2
    v4 = ResultAt v3 index=1
    v5 = ResultAt v3
    v6 = CreateIteratorResult v4, v5
    Return v6
  b2():
    v7 = ThrowNewError errorKind=TypeError message="not an array iterator"
    Unreachable
}
