# setTimeout keeps the callback and its arguments in cells of native memory, which JavaScript reaches only through a Timeout. Text evaluated at run time that is handed the Timeout replaces the callback
# and gets the arguments, so both cells are open to it
# RUN: flow-solve sinks
# CHECK: unknownJavaScript {{*}}L0#{{*}}f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Builtin builtin=SetTimeout
    v4 = Call v3, -, v2, v0, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="text" [isFreeName]
    v7 = PropGet v5 key="Function" [isFreeName]
    v8 = Call v7, -, v6
    v9 = Call v8, -, v4
    Return
}
function f1 name="callback" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
