# The default export that the host passes to Bun.serve, of an ES module or of a CommonJS module, gets the flow the table declares for its options: fetch is called with a request, and the options object reaches no sink
# RUN: flow-solve sinks nodes
# RUN(COMMONJS): flow-solve sinks nodes
# CHECK-NOT: L0#
# CHECK-NOT: f1
# CHECK: n0 NativeCode()
# CHECK: Variable(g0) = {L0#[[options]]}
# CHECK: , f1, parameter 1) = {Request@host:-[[request]]}
# COMMONJS-NOT: L1#
# COMMONJS-NOT: f3
# COMMONJS: n0 NativeCode()
# COMMONJS: , f3, parameter 1) = {Request@host:-[[request]]}

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="default" variable=g0}]
module m1 path="/app/server.cjs" displayPath="server.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
entry module=m0 hostReads=[{exportName="default" builtin=BunServe}]
entry module=m1 hostReads=[{exportName="default" builtin=BunServe}]
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
layout L1 name="CommonJSOptions" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
variable g0 name="default" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    Return
}
function f1 name="fetch" module=m0 kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="server" module=m1 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = NewClosure function=f3
    v7 = NewObject -, v6 layout=L1 fields=[0]
    PropSet v3, v7 key="exports"
    Return
}
function f3 name="fetch" module=m1 kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
