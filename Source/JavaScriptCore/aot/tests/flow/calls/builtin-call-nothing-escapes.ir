# Unknown code is called and handed nothing: no built-in reaches it, so native code calls none, and no unknown JavaScript can run.
# RUN: flow-solve sinks
# RUN(STATEMENTS): flow-links statements
# STATISTIC: FlowWorklistSteps <= 500

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Call v1
    Return
}
# CHECK: nativeCode {
# CHECK-NOT: GlobalThis
# CHECK-NOT: ArrayPrototype
# CHECK: unknownJavaScript {
