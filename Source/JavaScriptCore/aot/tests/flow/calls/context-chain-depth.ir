# Instances for call sites nest two levels deep. A function that the inner level calls has one instance for the call site in that function, whoever is further out
# RUN: flow-solve instances
# RUN(SECOND): flow-solve instances
# RUN(THIRD): flow-solve instances
# RUN(FOURTH): flow-solve instances
# CHECK-COUNT-2: f1 at f0:v
# CHECK-NOT: f1 at f0:v
# SECOND-COUNT-2: f2 at f1:v2 in
# SECOND-NOT: f2 at f1:v2
# THIRD-NOT: f3 at f2:v2 in
# THIRD: [[third]] f3 at f2:v2 Initialized
# THIRD-NOT: f3 at f2:v2
# FOURTH: [[third]] f3 at f2:v2 Initialized
# FOURTH: f4 at f3:v2 in [[third]] Initialized
# FOURTH-NOT: f4 at f3:v2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="third" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="fourth" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f3
    PutModuleVariable v2 variable=g1
    v4 = NewClosure function=f4
    PutModuleVariable v4 variable=g2
    v6 = NewClosure function=f1
    v7 = Integer integer=1
    v8 = NewObject -, v7 layout=L0 fields=[0]
    v9 = NewObject -, v7 layout=L1 fields=[0]
    v10 = Call v6, -, v8
    v11 = Call v6, -, v9
    Return
}
function f1 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0
    Return v2
}
function f2 name="second" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = Call v1, -, v0
    Return v2
}
function f3 name="third" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g2
    v2 = Call v1, -, v0
    Return v2
}
function f4 name="fourth" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
