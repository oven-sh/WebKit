# A reached import of a module the image does not hold as compiled code is one event of the program, and unknown JavaScript can run
# RUN: flow-links modules unseen
# CHECK: evaluated m0 m1
# CHECK-COUNT-1: unseen ImportsUncompiledModule -
# CHECK-NOT: unseen ImportsUncompiledModule
# CHECK: unknown-javascript yes

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/uncompiled.js" displayPath="uncompiled.js" kind=External referrer=m0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
