# An operand that is only inspected has a use with its origin and operand alone, which waits for nothing and sends the object to no sink; an operand that is converted has a use that can throw and waits for the operand
# RUN: flow-solve sinks
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[inspected]] mutations=[] uses=[]
# OBJECTS-NEXT: L1#[[inspectedByIntrinsic]] mutations=[] uses=[]
# RUN(SUMMARY): flow-summary f0
# SUMMARY: [[object]] = v1
# SUMMARY: [[converted]] = v7
# SUMMARY: OperandUse#[[typeOf]] origin=v2 operandIndex=0 operand=[[object]]
# SUMMARY-NEXT: OperandUse#[[strictEq]] origin=v3 operandIndex=0 operand=[[object]]
# SUMMARY-NEXT: OperandUse#[[toBoolean]] origin=v4 operandIndex=0 operand=[[object]]
# SUMMARY: OperandUse#[[toNumber]] origin=v8 operandIndex=0 operand=[[converted]] thrown=
# SUMMARY-NOT: OperandUse#[[typeOf]]
# SUMMARY-NOT: OperandUse#[[strictEq]]
# SUMMARY-NOT: OperandUse#[[toBoolean]]
# SUMMARY: waiters [[converted]]: {{*}}OperandUse#[[toNumber]]
# RUN(ALONE): flow-summary f0
# ALONE-NOT: OperandUse#{{*}} origin=v2 operandIndex=0 operand={{*}}=
# ALONE-NOT: OperandUse#{{*}} origin=v3 operandIndex=0 operand={{*}}=
# ALONE-NOT: OperandUse#{{*}} origin=v4 operandIndex=0 operand={{*}}=
# RUN(INTRINSIC): flow-summary f1
# INTRINSIC: [[parameter]] = v0
# INTRINSIC: OperandUse#[[isConstructor]] origin=v1 operandIndex=0 operand=[[parameter]]
# INTRINSIC-NOT: OperandUse#[[isConstructor]]
# RUN(INTRINSICALONE): flow-summary f1
# INTRINSICALONE-NOT: OperandUse#{{*}} operand={{*}}=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Inspected" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="InspectedByIntrinsic" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Converted" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = TypeOf v1
    v3 = StrictEq v1, v0
    v4 = ToBoolean v1
    v5 = NewObject -, v0 layout=L1 fields=[0]
    v6 = CallDirect v5 function=f1
    v7 = NewObject -, v0 layout=L2 fields=[0]
    v8 = ToNumber v7
    Return
}
function f1 name="isConstructor" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = IsConstructor v0
    Return v1
}
