    v6 = NewClosure function=f3
    v7 = Call v2, v1, v6
    PutModuleVariable v7 variable=g1
    v9 = CallDirect function=f4
    PutModuleVariable v9 variable=g2
    Return
}
function f1 name="mapFirst" module=m1 role=Library flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
