# The statement of every call operation: mode, flags, operands, where each result goes
# RUN: flow-summary f0 f1 f4 f5
# CHECK-LABEL: summary f0:
# CHECK: copy l19 -> l4
# CHECK-NEXT: copy [[firstResult]] -> l15
# CHECK-NEXT: copy [[secondResult]] -> l14
# CHECK: Call#0 mode=Call origin=v4 callee=l0 thisValue=l1 arguments=[l2, l2] result=l6 thrown=l5 expectedResult=x0
# CHECK-NEXT: Call#1 mode=Call flags=[IsAnnotatedPure] origin=v5 callee=l0 result=l7 thrown=l5
# CHECK-NEXT: Call#2 mode=Call origin=v7 callee=l0 thisValue=l1 argumentList=l8 result=l9 thrown=l5
# CHECK-NEXT: Call#3 mode=Construct origin=v8 callee=l0 newTarget=l1 arguments=[l2] result=l10 thrown=l5
# CHECK-NEXT: Call#4 mode=Construct origin=v9 callee=l0 arguments=[l2] result=l11 thrown=l5
# CHECK-NEXT: Call#5 mode=Construct origin=v10 callee=l0 argumentList=l8 result=l12 thrown=l5
# CHECK-NEXT: Call#6 mode=Call flags=[IsInCycle] origin=v16 callee=l0 result=l17 thrown=l5
# CHECK-NEXT: Call#7 mode=Call flags=[IsTailCall, ResultIsHandedUp] origin=v18 callee=l0 arguments=[l14] result=l19 thrown=l5
# CHECK-NEXT: DirectCall#0 origin=v11 function=f2 arguments=[l1, l2] results={{*}}[[firstResult]], [[secondResult]]] thrown=l5
# CHECK-NEXT: DirectCall#1 origin=v14 function=f3 results=[l16] thrown=l5
# CHECK-NEXT: DirectCall#2 flags=[IsInCycle] origin=v17 function=f3 results=[l18] thrown=l5
# CHECK: waiters l0: Call#0, Call#1, Call#2, Call#3, Call#4, Call#5, Call#6, Call#7
# CHECK-NEXT: waiters l1: Call#0, Call#2, Call#3, DirectCall#0
# CHECK-NEXT: waiters l2: Call#0, Call#3, Call#4, DirectCall#0
# CHECK-NEXT: waiters l8: Call#2, Call#5
# CHECK-NEXT: waiters l14: Call#7
# CHECK-LABEL: summary f1:
# CHECK: Call#0 mode=SuperConstruct origin=v2 callee=l1 newTarget=l0 arguments=[l1] result=l4 thrown=l3 derivedLayout=L0
# CHECK-LABEL: summary f4: parameters=1 results=2
# CHECK-NOT: seed
# CHECK: copy [[wholeFirst]] -> l1
# CHECK-NEXT: copy [[wholeSecond]] -> l2
# CHECK-NEXT: DirectCall#0 origin=v1 function=f2 arguments=[l0, l0] results={{*}}[[wholeFirst]], [[wholeSecond]]] thrown=l3
# CHECK-LABEL: summary f5: parameters=2 results=4
# CHECK: seed l2 TypeAsRead boolean
# CHECK-NEXT: seed l3 TypeAsRead int[0, 2147483647]
# CHECK-NEXT: seed l4 TypeAsRead anything
# CHECK-NEXT: seed l5 TypeAsRead anything
# CHECK-NEXT: copy {{*}} -> l2
# CHECK-NEXT: copy {{*}} -> l3
# CHECK-NEXT: copy [[key]] -> l4
# CHECK-NEXT: copy [[value]] -> l5
# CHECK-NEXT: SlotAccess#0 kind=Load origin=v3 receiver=l0 contentsSlot=Key value=[[key]]
# CHECK-NEXT: SlotAccess#1 kind=Load origin=v3 receiver=l0 contentsSlot=Value value=[[value]]

expectedresult x0 type=anything
module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 kind=Instance name="Derived" constructor=f1 flags=[HasHeritage]
function f0 name="calls" parameters=[{type=anything}, {type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: boolean):
    v4 = Call v0, v1, v2, v2 expectedResult=x0
    v5 = Call v0 [isAnnotatedPure]
    v6 = NewArray v2 contents=anything
    v7 = CallList v0, v1, v6
    v8 = Construct v0, v1, v2
    v9 = Construct v0, -, v2
    v10 = ConstructList v0, -, v6
    v11 = CallDirect v1, v2 function=f2
    v12 = ResultAt v11 index=1
    v13 = ResultAt v11
    v14 = CallDirect function=f3
    Jump -> next b1()
  b1():
    LoopHint
    v16 = Call v0
    v17 = CallDirect function=f3
    Branch v3 -> taken b1(), notTaken b2()
  b2():
    v18 = Call v0, -, v12
    ReturnCall v18
}
function f1 name="Derived" kind=DerivedConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = SuperConstruct v1, v0, v1 layout=L0
    Return v2
}
function f2 name="twoResults" parameters=[{type=anything}, {type=anything}] results=[{type=anything}, {type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Results v0, v1
    Return v2
}
function f3 name="oneResult" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="returnsDirectCallWhole" parameters=[{type=anything}] results=[{type=anything}, {type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0, v0 function=f2
    Return v1
}
function f5 name="returnsMapNextWhole" role=Library parameters=[{type=Map}, {type=i32}] results=[{type=boolean}, {type=int[0, 2147483647]}, {type=anything}, {type=anything}] {
  b0(v0: Map, v1: i32):
    v2 = CollectionTable v0
    v3 = MapNext v0, v2, v1
    Return v3
}
