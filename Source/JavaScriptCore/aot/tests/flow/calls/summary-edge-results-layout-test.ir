# The edges of a test of a layout, which only text of a form after AsRead can hold, filter by the tested layout: inside on the taken edge, outside on the other
# FORM: Prepared
# RUN: flow-summary f0
# CHECK: l4 = v2
# CHECK-NEXT: l5 = v3
# CHECK: Filter#0 from=l0 to=l4 type=L0 kind=Inside
# CHECK-NEXT: Filter#1 from=l0 to=l5 type=L0 kind=Outside
# CHECK-NOT: Filter#2

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Tested" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="narrows" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=L0
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return v3
}
