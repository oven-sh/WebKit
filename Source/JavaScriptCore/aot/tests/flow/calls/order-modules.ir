# A module completes before every module that imports it, directly or through a diamond, and never before itself, its own requests or a sibling
# RUN: flow-order modules before m0 m1 before m1 m0 before m0 m3 before m3 m0 before m1 m3 before m2 m3 before m1 m2 before m2 m1 before m0 m0 before m3 m3
# CHECK: m0: component [[base]] after {}
# CHECK-NEXT: m1: component [[left]] after {[[base]]}
# CHECK-NEXT: m2: component [[right]] after {[[base]]}
# CHECK-NEXT: m3: component [[top]] after {[[base]], [[left]], [[right]]}
# CHECK-NEXT: before m0 m1 CompletesBefore
# CHECK-NEXT: before m1 m0 Unknown
# CHECK-NEXT: before m0 m3 CompletesBefore
# CHECK-NEXT: before m3 m0 Unknown
# CHECK-NEXT: before m1 m3 CompletesBefore
# CHECK-NEXT: before m2 m3 CompletesBefore
# CHECK-NEXT: before m1 m2 Unknown
# CHECK-NEXT: before m2 m1 Unknown
# CHECK-NEXT: before m0 m0 Unknown
# CHECK-NEXT: before m3 m3 Unknown

module m0 path="base.js" displayPath="base.js" body=f0
module m1 path="left.js" displayPath="left.js" body=f1 requests=[{target=m0}]
module m2 path="right.js" displayPath="right.js" body=f2 requests=[{target=m0}]
module m3 path="main.js" displayPath="main.js" body=f3 requests=[{target=m1}, {target=m2}]
entry module=m3
function f0 name="base" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="left" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="right" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="main" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
