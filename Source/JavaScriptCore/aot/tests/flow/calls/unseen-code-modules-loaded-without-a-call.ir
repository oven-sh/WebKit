# Loading node:vm, evaluating its body, creating its native binding, reading from the binding and holding what was read start nothing: only a call does.
# An import by a name that one of the host's own files computes names code outside the image
# RUN: flow-links unseen modules
# CHECK: evaluated m0 m1 m2
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="node:readline" displayPath="node:readline" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeReadline body=f1
module m2 path="node:vm" displayPath="node:vm" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeVm body=f2
entry module=m0
variable g0 name="held" module=m2 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m2 referrer=m0 specifier="node:vm"
    Return
}
function f1 name="readline" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m2 referrer=m1 specifier="node:vm"
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName]
    v3 = ImportDynamic v2 referrer=m1
    Return
}
function f2 name="vm" module=m2 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeCppNodeVMCppBunCreateNodeVMBinding
    v1 = PropGet v0 key="Script"
    PutModuleVariable v1 variable=g0
    Return
}
