# A promise made by NewPromise holds what it is resolved with in its value slot and what it is rejected with in its reason slot, and one resolved with another promise holds what that promise holds, never the promise
# RUN: flow-solve nodes
# RUN(AWAITED): flow-solve nodes
# RUN(NOWHERE): flow-solve nodes
# CHECK: DeclaredPart(Promise@f1:v3, 0) = {L0#[[value]]}
# CHECK: DeclaredPart(Promise@f1:v5, 1) = {L1#[[reason]]}
# CHECK: DeclaredPart(Promise@f1:v7, 0) = {L0#[[value]]}
# CHECK: DeclaredPart(Promise@f1:v9, 1) = {L1#[[reason]]
# AWAITED: , f1, v1) = {L0#[[value]]}
# AWAITED-NEXT: , f1, v2) = {L1#[[reason]]}
# AWAITED: , f1, v11) = {L0#[[value]]}
# AWAITED: , f1, v13) = {L0#[[value]]}
# AWAITED-NEXT: , f1, v14) = {L1#[[reason]]
# NOWHERE-NOT: DeclaredPart(Promise@f1:v3, 1) = {{*}}L1#
# NOWHERE-NOT: DeclaredPart(Promise@f1:v5, 0) =
# NOWHERE-NOT: DeclaredPart(Promise@f1:v7, 1) = {{*}}L1#
# NOWHERE-NOT: DeclaredPart(Promise@f1:v9, 0) =
# NOWHERE-NOT: , 1) = {{*}}L0#
# NOWHERE-NOT: , f1, v12) =
# NOWHERE-NOT: , f1, v14) = {{*}}L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Value" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Reason" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="run" role=Library flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewPromise
    ResolvePromise v3, v1
    v5 = NewPromise
    RejectPromise v5, v2
    v7 = NewPromise
    ResolvePromise v7, v3
    v9 = NewPromise
    ResolvePromise v9, v5
    Jump -> next b1()
  b1() handler=b2():
    v11 = Await v3
    v12 = Await v5
    v13 = Await v7
    Return
  b2() role=CatchHandler:
    v14 = CatchValue
    Return
}
