# In a build that excludes evaluated text a reached call that evaluates text only throws: it is no event and unknown JavaScript cannot run
# RUN: flow-links unseen
# OPTIONS: exclude=EvaluatedText
# CHECK-NOT: EvaluatesText
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="source" [isFreeName]
    v2 = PropGet v0 key="Function" [isFreeName]
    v3 = Construct v2, -, v1
    Return
}
