# What an object in the hands of unknown JavaScript holds is there too, and the unknown object stands for it: a use that applies transitively does not follow such an object. It follows an object that nobody else holds
# OPTIONS: admit=Inspector
# RUN: flow-solve nodes
# RUN(ABSENT): flow-solve nodes
# CHECK: Temporary(i{{*}}, f0) = {{*}}unknown|L1#{{*}}|L4#{{*}}|L3#{{*}}|L0#{{*}}}
# ABSENT-NOT: Temporary(i{{*}}, f0) = {{*}}L2#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Outer" fields=[{key="handed" declared={type=anything} flags=[IsRequired]}, {key="kept" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Handed" fields=[{key="deep" declared={type=anything} flags=[IsRequired]}]
layout L2 name="LeafOfHanded"
layout L3 name="Kept" fields=[{key="deep" declared={type=anything} flags=[IsRequired]}]
layout L4 name="LeafOfKept"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewObject layout=L2 fields=[]
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Call v1, -, v3
    v5 = NewObject layout=L4 fields=[]
    v6 = NewObject -, v5 layout=L3 fields=[0]
    v7 = NewObject -, v3, v6 layout=L0 fields=[0, 1]
    v8 = Builtin builtin=JSONStringify
    v9 = Call v8, -, v7
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v10 = CatchValue
    Return
}
