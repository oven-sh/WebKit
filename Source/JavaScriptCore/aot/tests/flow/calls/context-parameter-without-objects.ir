# A function gets an instance for each call site to keep apart the objects its callers pass. One that passes on only parameters that hold no object, by their type or by their prediction, shares one instance
# RUN: flow-solve instances
# RUN(TYPED): flow-solve instances
# RUN(PREDICTED): flow-solve instances
# CHECK-COUNT-2: f1 at f0:v
# CHECK-NOT: f1 at f0:v
# TYPED-NOT: f2 at
# TYPED: f2 Proven
# TYPED-NOT: f2 at
# PREDICTED-NOT: f3 at
# PREDICTED: f3 Proven
# PREDICTED-NOT: f3 at

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = String string="a"
    v4 = String string="b"
    v5 = Call v0, -, v3
    v6 = Call v0, -, v4
    v7 = Call v1, -, v3
    v8 = Call v1, -, v4
    v9 = Call v2, -, v3
    v10 = Call v2, -, v4
    Return
}
function f1 name="passesAnythingOn" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="passesStringOn" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    Return v0
}
function f3 name="passesPredictedStringOn" parameters=[{type=anything predicted=string}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
