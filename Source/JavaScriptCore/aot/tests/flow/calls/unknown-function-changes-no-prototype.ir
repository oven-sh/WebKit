# Native code changes no prototype: an object passed as this to an unknown function keeps its prototype link as long as the program has not read the function behind the setter of __proto__
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[ReachNativeCode] uses
# CHECK-NEXT: L1#{{*}} mutations=[] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="PassedAsThis" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = NewObject -, v3 layout=L2 fields=[0]
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="imported" [isFreeName]
    v9 = Call v8, v4, v6
    Return
  b1() role=CatchHandler:
    v10 = CatchValue
    Return
}
