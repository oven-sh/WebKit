# Code that nobody follows can read every export of the namespace object of a barrel that it is handed, so every module that has a variable behind it is evaluated, though their package declares them free of side effects
# RUN: flow-links modules
# CHECK: evaluated m0 m1 m2 m3

variable g0 name="first" module=m2 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m3 declared={type=anything} initialization=Uninitialized
variable g2 name="kept" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/package/index.js" displayPath="package/index.js" flags=[HasNoSideEffects] body=f1 requests=[{target=m2}, {target=m3}] exports=[{name="first" variable=g0}, {name="second" variable=g1}]
module m2 path="/package/first.js" displayPath="package/first.js" flags=[HasNoSideEffects] body=f2 exports=[{name="first" variable=g0}]
module m3 path="/package/second.js" displayPath="package/second.js" flags=[HasNoSideEffects] body=f3 exports=[{name="second" variable=g1}]
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f1 name="index" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="first" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
function f3 name="second" module=m3 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g1
    Return
}
