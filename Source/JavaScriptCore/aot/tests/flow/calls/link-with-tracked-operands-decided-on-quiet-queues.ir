# reads(flag ? first : input); reads(second)
# The first call passes an object of the program or a value nobody knows, so it enters the instance for unknown operands. Whether the callee or the unknown value reaches the call first depends on the order of the solve:
# a link with tracked operands is made only while nothing is queued, so `first` never reaches the instance that the second call enters, whose parameter holds `second` alone.
# RUN: flow-solve nodes
# CHECK: , f1, parameter 0) = {L1#[[second]]}
# RUN(GENERIC): flow-solve nodes
# GENERIC: , f1, parameter 0) = {{*}}unknown|L0#
# RUN(APART): flow-solve nodes
# APART-NOT: , f1, parameter 0) = {L0#
# RUN(INSTANCES): flow-solve instances
# INSTANCES-COUNT-2: f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewObject -, v1 layout=L1 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = PropGet v4 key="flag" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v5)
  b3(v8):
    v9 = Call v0, -, v8
    v10 = Call v0, -, v3
    Return
}
function f1 name="reads" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
