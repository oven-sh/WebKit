# Reading members of the module object of a CommonJS module, by name or by a key nobody knows, and requiring a known path through it lets no unseen code in and sends no module object to a sink.
# The require stays a call, so the host gets the name, and the run time takes names from the whole program or from nobody: the image loads modules by name, and every module of the program may be evaluated
# RUN: flow-links unseen modules
# RUN(SINKS): flow-solve sinks
# RUN(NODES): flow-solve nodes
# CHECK: evaluated m0 m1 m2
# CHECK: unseen LoadsModuleByName
# CHECK: unknown-javascript no
# SINKS-NOT: ModuleObject
# SINKS-NOT: ModuleRequire
# NODES: f0, parameter 3) = {ModuleObject@m0}
# NODES: f0, v20) = {{*}}ModuleObjectExports@m1

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="/app/named.cjs" displayPath="named.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
module m2 path="/app/other.cjs" displayPath="other.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = PropGet v3 key="id"
    PutModuleVariable v6 variable=g0
    v8 = PropGet v3 key="filename"
    PutModuleVariable v8 variable=g0
    v10 = PropGet v3 key="children"
    PutModuleVariable v10 variable=g0
    v12 = PropGet v3 key="parent"
    PutModuleVariable v12 variable=g0
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="k" [isFreeName]
    v16 = ElemGet v3, v15
    PutModuleVariable v16 variable=g0
    v18 = String string="/app/named.cjs"
    v19 = PropGet v3 key="require"
    v20 = Call v19, v3, v18 calleeKey="require"
    PutModuleVariable v20 variable=g0
    Return
}
function f1 name="named" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
function f2 name="other" module=m2 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
