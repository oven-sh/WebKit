# A built-in object that reaches native code leaves its members behind: native code calls none of them, and none of them is an event. The global object, process and Object are such holders
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {unknown, GlobalThis,
# SINKS: unknownJavaScript {}
# RUN(USES): flow-links uses
# USES: use GlobalThis [{{*}}Escaped]
# USES: use Object [{{*}}Escaped]
# USES: use Process [{{*}}Escaped]
# RUN(MEMBERS): flow-links uses statements
# MEMBERS-NOT: use Function [
# MEMBERS-NOT: use Eval [
# MEMBERS-NOT: use ObjectFreeze
# MEMBERS-NOT: use ProcessDlopen
# MEMBERS-NOT: ObjectFreeze Call Host
# MEMBERS-NOT: ProcessDlopen Call Host

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Call v1, -, v0
    v3 = Builtin builtin=Object
    v4 = Call v1, -, v3
    v5 = Builtin builtin=Process
    v6 = Call v1, -, v5
    Return
}
