# The unknown object stands for a built-in object only once that object has reached native code: `x.dlopen(..)` on an unknown x is no event in a program that keeps process to itself
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Process
    v2 = PropGet v1 key="pid"
    v3 = PropGet v0 key="input" [isFreeName]
    v4 = PropGet v3 key="dlopen"
    v5 = Call v4, v3, v3 calleeKey="dlopen"
    Return
}
