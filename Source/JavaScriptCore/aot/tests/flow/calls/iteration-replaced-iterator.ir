# An array that gets an iterator method of its own in a function reached after the loop was linked gives the loop variable its elements and what the method yields, and another array is not touched
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|L0#[[element]]|L1#[[yielded]]}
# CHECK-NEXT: Variable(g1) = {Array@f0:v2}
# CHECK-NEXT: Variable(g2) = {undefined|L2#[[other]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Element" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Yielded" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Other" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Iterator" fields=[{key="next" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Result" fields=[{key="value" declared={type=anything} flags=[IsRequired]}, {key="done" declared={type=anything} flags=[IsRequired]}]
variable g0 name="element" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="array" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="elementOfOtherArray" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    PutModuleVariable v2 variable=g1
    v4 = IteratorOpen v2
    Jump -> next b1()
  b1():
    LoopHint
    v6 = IteratorResume v4
    v7 = ResultAt v6
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v8 = ResultAt v6 index=1
    PutModuleVariable v8 variable=g0
    v10 = CallDirect function=f1
    Jump -> next b1()
  b3():
    v11 = NewObject -, v0 layout=L2 fields=[0]
    v12 = NewArray v11 contents=anything
    v13 = IteratorOpen v12
    v14 = IteratorResume v13
    v15 = ResultAt v14 index=1
    PutModuleVariable v15 variable=g2
    Return
}
function f1 name="replace" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = NewClosure function=f2
    PropSet v0, v1 key=@@iterator
    Return
}
function f2 name="replacement" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = NewObject -, v1 layout=L3 fields=[0]
    Return v2
}
function f3 name="next" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = Boolean boolean=false
    v4 = NewObject -, v2, v3 layout=L4 fields=[0, 1]
    Return v4
}
