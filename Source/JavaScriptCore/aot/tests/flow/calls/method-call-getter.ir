# A method call whose name finds a getter runs the getter and calls the closure it returns, both with the receiver as this; a getter under another name and a setter under the same name are not linked
# RUN: flow-links calls
# CHECK: [[caller]] f0 v8 -> [[getter]] f1 Accessor Once
# CHECK: [[caller]] f0 v8 -> [[returned]] f2 Call Once
# RUN(NOWHERE): flow-links calls
# NOWHERE-NOT: -> {{*}} f3
# NOWHERE-NOT: -> {{*}} f4
# NOWHERE-NOT: -> {{*}} f5
# NOWHERE-NOT: f0 v14 ->
# RUN(NODES): flow-solve nodes
# NODES: , f0, v1) = {L0#[[receiver]]}
# NODES: , f1, parameter 0) = {L0#[[receiver]]}
# NODES: , f2, parameter 0) = {L0#[[receiver]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="WithGetter" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="WithSetter" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    DefineGetter v1, v2 key="handler"
    v4 = NewClosure function=f3
    DefineGetter v1, v4 key="other"
    v6 = FinishObject v1
    v7 = PropGet v6 key="handler"
    v8 = Call v7, v6 calleeKey="handler"
    v9 = NewObject -, v0 layout=L1 fields=[0]
    v10 = NewClosure function=f5
    DefineSetter v9, v10 key="handler"
    v12 = FinishObject v9
    v13 = PropGet v12 key="handler"
    v14 = Call v13, v12 calleeKey="handler"
    Return
}
function f1 name="handler" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    Return v1
}
function f2 name="returnedByHandler" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="other" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f4
    Return v1
}
function f4 name="returnedByOther" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="handler" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
