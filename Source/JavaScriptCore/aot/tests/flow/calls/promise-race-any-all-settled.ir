    v5 = NewArray v0 contents=anything
    v6 = PropGet v2 key="any"
    v7 = Call v6, v2, v5 calleeKey="any"
    v8 = NewArray v0 contents=anything
    v9 = PropGet v2 key="allSettled"
    v10 = Call v9, v2, v8 calleeKey="allSettled"
    Return
}
function f1 name="load" flags=[IsAsync] results=[{type=anything}] {
