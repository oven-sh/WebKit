# The promises of Promise.race and Promise.any hold what an element is fulfilled with, never the element itself; the array of Promise.allSettled holds records of the engine, and only what the elements settle with reaches native code, not the elements and not the array they came in
# RUN(RACE): flow-solve nodes
# RUN(ANY): flow-solve nodes
# RUN(SETTLED): flow-solve nodes
# RUN(NOWHERE): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# RACE: DeclaredPart(Promise@f0:v4{{*}}, 0) = {{*}}L0#[[raced]]}
# ANY: DeclaredPart(Promise@f0:v7{{*}}, 0) = {{*}}L0#[[first]]}
# NOWHERE-NOT: DeclaredPart(Promise@f0:v4{{*}}, 0) = {{*}}Promise@
# NOWHERE-NOT: DeclaredPart(Promise@f0:v4{{*}}, 0) = {{*}}unknown
# NOWHERE-NOT: DeclaredPart(Promise@f0:v7{{*}}, 0) = {{*}}Promise@
# NOWHERE-NOT: DeclaredPart(Promise@f0:v7{{*}}, 0) = {{*}}unknown
# SETTLED: DeclaredPart(Promise@f0:v10{{*}}, 0) = {Array@f0:v10
# SINKS: nativeCode {{*}}L0#
# SINKS-NOT: Promise@f
# SINKS-NOT: Array@f

module m0 path="main.js" displayPath="main.js" body=f0
