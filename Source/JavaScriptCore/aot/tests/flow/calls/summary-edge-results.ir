# What an edge proves is a filter from the tested value to the block parameter, and a guard has no local
# RUN: flow-summary f0
# CHECK: l6 = v4
# CHECK-NEXT: l7 = v5
# CHECK: l9 = v7
# CHECK-NEXT: l10 = v8
# CHECK-NEXT: l11 = v9
# CHECK-NEXT: l12 = v10
# CHECK-NOT: = v11
# CHECK: Filter#0 from=l0 to=l6 type=Array kind=Inside
# CHECK-NEXT: Filter#1 from=l0 to=l7 type=Array kind=Outside
# CHECK-NEXT: Filter#2 from=l1 to=l9 type=true|number|string|symbol|bigint|object kind=Inside
# CHECK-NEXT: Filter#3 from=l1 to=l10 type=undefined|null|false|0|whole|string|bigint kind=Inside
# CHECK-NEXT: Filter#4 from=l2 to=l11 type=1 kind=Inside
# CHECK-NOT: Filter#5
# CHECK: waiters l0: Filter#0, Filter#1,
# CHECK-NEXT: waiters l1: Filter#2, Filter#3,
# CHECK-NEXT: waiters l2: Filter#4

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="narrows" role=Library parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = TypeTest v0 testedType=Array
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    Return v4
  b2(v5):
    v6 = ToBoolean v1
    Branch v6 -> taken b3(| 0), notTaken b4(| 0)
  b3(v7):
    Return v7
  b4(v8):
    Switch v2 cases=[1, 2] -> case b5(| 0), case b6(), otherwise b7()
  b5(v9):
    Return v9
  b6():
    Return v5
  b7():
    v10 = IsPristineArray v0
    Branch v10 -> taken b8(| 0), notTaken b9()
  b8(v11):
    Return v8
  b9():
    Return
}
