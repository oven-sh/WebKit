# OBJECTS2: L0#{{*}} mutations=[] uses=
# OBJECTS3: L1#{{*}} mutations=[] uses=
# OBJECTS4: L2#{{*}} mutations=[{{*}}ReachUnknownJavaScript
# OBJECTS5: L3#{{*}} mutations=[] uses=

