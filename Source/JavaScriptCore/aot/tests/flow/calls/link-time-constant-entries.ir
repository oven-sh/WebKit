layout L2 name="ResolvedByOtherConstructor" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Wrapped" fields=[{key="d" declared={type=anything} flags=[IsRequired]}]
variable g0 name="element" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    v3 = CallDirect v2 function=f1
    v4 = Integer integer=0
    v5 = ElemGet v3, v4
    PutModuleVariable v5 variable=g0
    v7 = NewObject -, v0 layout=L1 fields=[0]
    v8 = CallDirect v7 function=f2
    v9 = NewObject -, v0 layout=L2 fields=[0]
    v10 = NewClosure function=f5
    v11 = CallDirect v10, v9 function=f3
    v12 = NewObject -, v0 layout=L3 fields=[0]
    v13 = CallDirect v12 function=f4
    Return
}
function f1 name="copy" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=LinkTimeConstantArrayFromFastWithoutMapFn
    v2 = Builtin builtin=Array
    v3 = Call v1, -, v2, v0
    Return v3
}
