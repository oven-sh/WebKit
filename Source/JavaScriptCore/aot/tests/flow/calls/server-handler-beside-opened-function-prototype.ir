# Bun.serve converts what it finds in its options to primitives. Another function of the program is handed to a native function that nobody has described, which sends Function.prototype to the sink for "everything can happen". The handler still reaches no native code and is entered with what the table declares alone.
# RUN: flow-solve sinks
# RUN(OPENED): flow-solve sinks
# RUN(INSTANCES): flow-solve instances
# RUN(RESULTS): flow
# CHECK-NOT: f1
# OPENED: unknownJavaScript {{*}}FunctionPrototype
# INSTANCES-NOT: f1 Generic
# RESULTS-NOT: genericVersion

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=BunServe
    v3 = Builtin builtin=Bun
    v4 = Call v2, v3, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key=@"nativeThatNobodyDescribed"
    v7 = NewClosure function=f2
    v8 = Call v6, -, v7
    Return
}
function f1 name="fetch" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="handedOver" results=[{type=anything}] {
  b0():
    Return
}
