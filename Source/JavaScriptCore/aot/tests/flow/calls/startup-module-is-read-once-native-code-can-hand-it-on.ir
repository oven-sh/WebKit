# Native code requires a start-up module where it hands one of its functions to code of the program. A program in which no built-in of the host calls a member of an operand with operands of its own choice,
# and which reads no method by which a class of the host prints itself, does not evaluate the module and enters none of the functions it exports. A function of the application that reaches native code
# is called with the unknown value, which stands only for what has reached native code.
# With such a read: flow/calls/startup-module-is-read-where-seen-code-reads-the-method-that-prints-a-host-object.ir
# RUN: flow-links calls modules
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="escaped" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
