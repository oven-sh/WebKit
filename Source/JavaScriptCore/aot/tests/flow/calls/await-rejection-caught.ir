# What an awaited async function throws is caught by the handler around the await, and without a handler it rejects the promise of the awaiting function
# RUN: flow-solve nodes
# RUN(UNCAUGHT): flow-solve nodes
# RUN(CAUGHT): flow-solve nodes
# CHECK: , f1, v3) = {L1#[[failure]]|opaque(Error)@host:-.error}
# UNCAUGHT: , f0, v1) = {Promise@f2:result@[[main]]}
# UNCAUGHT: DeclaredPart(Promise@f2:result@[[main]], 1) = {L1#[[failure]]|opaque(Error)@host:-.error}
# CAUGHT-NOT: DeclaredPart(Promise@f1:result{{*}}, 1) = {{*}}L1#
# CAUGHT-NOT: , f0, thrown) = {{*}}L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Row" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Failure" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="caught" flags=[IsAsync] results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = NewClosure function=f3
    v1 = Call v0
    v2 = Await v1
    Return
  b2() role=CatchHandler:
    v3 = CatchValue
    Return
}
function f2 name="uncaught" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    v2 = Await v1
    Return
}
function f3 name="fails" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
