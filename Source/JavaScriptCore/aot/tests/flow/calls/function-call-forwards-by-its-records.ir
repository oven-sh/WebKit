# f.call(t, a, b) only forwards a call, so its records say which operand arrives where: the callee is entered from the call with this and each argument at its own parameter, whatever the function of the library does with its operands.
# Native code alone enters that function, so that it has a body. A call through call inside a callee of call is followed the same way
# RUN: flow-solve nodes
# CHECK: , f0, v1) = {L0#[[t]]}
# CHECK-NEXT: , f0, v2) = {L1#[[a]]}
# CHECK-NEXT: , f0, v3) = {L2#[[b]]}
# CHECK: , f1, parameter 0) = {L0#[[t]]}
# CHECK-NEXT: , f1, parameter 1) = {L1#[[a]]}
# CHECK-NEXT: , f1, parameter 2) = {L2#[[b]]}
# CHECK: , f2, parameter 0) = {L0#[[t]]}
# CHECK-NEXT: , f2, parameter 1) = {L2#[[b]]}
# RUN(LINKS): flow-links calls
# LINKS: host - -> {{*}} f3 Host
# LINKS: f0 v6 -> {{*}} f1 BuiltinCallback Once
# LINKS: f1 v5 -> {{*}} f2 BuiltinCallback Once
# RUN(BODY): flow-links calls
# BODY-NOT: f0 v6 -> {{*}} f3
# BODY-NOT: f1 v5 -> {{*}} f3
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {
# SINKS-NOT: L0#
# SINKS-NOT: L1#
# SINKS-NOT: L2#

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
entry module=m0
runtimefunction id=12 function=f3
layout L0 name="Receiver" fields=[{key="t" declared={type=anything} flags=[IsRequired]}]
layout L1 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewClosure function=f1
    v5 = PropGet v4 key="call"
    v6 = Call v5, v4, v1, v2, v3 calleeKey="call"
    Return
}
function f1 name="outer" flags=[HasThis] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewClosure function=f2
    v4 = PropGet v3 key="call"
    v5 = Call v4, v3, v0, v2 calleeKey="call"
    Return
}
function f2 name="inner" flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f3 name="call" module=m1 role=Library flags=[HasRestParameter, HasThis] enclosingRuntimeFunction=12 parameters=[{type=anything}, {type=Array<anything>}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: Array<anything>):
    v3 = NewArray v1 contents=anything
    v4 = CallList v0, v1, v3
    Return v4
}
