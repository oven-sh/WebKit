# An option that admits the inspector is one event of the program without a built-in and without a witness, and unknown JavaScript can run in a program that does nothing
# OPTIONS: admit=Inspector
# RUN: flow-links unseen
# CHECK-COUNT-1: unseen OptionAdmitsCode - -
# CHECK-NOT: unseen OptionAdmitsCode
# CHECK: unknown-javascript yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Return
}
