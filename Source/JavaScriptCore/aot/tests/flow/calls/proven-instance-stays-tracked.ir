# A call whose operand comes to hold an unknown value enters the generic instance of its callee, and the proven instance, which the call with a tracked object enters, never receives the unknown object
# RUN(PROVEN): flow-solve instances nodes
# RUN(GENERIC): flow-solve instances nodes
# RUN(CALLER): flow-solve nodes
# RUN(NOWHERE): flow-solve nodes
# PROVEN: [[instance]] f1 Proven
# PROVEN: Local([[instance]], f1, parameter 0) = {{*}}L0#[[tracked]]|L1#[[first]]}
# GENERIC: [[instance]] f1 Generic
# GENERIC: Local([[instance]], f1, parameter 0) = {{*}}unknown|L1#[[first]]}
# CALLER: Variable(g0) = {{*}}unknown|L1#[[first]]}
# CALLER: , f0, v3) = {{*}}1}
# CALLER: , f0, v7) = {{*}}unknown
# NOWHERE-NOT: , f1, parameter 0) = {{*}}unknown{{*}}L0#
# NOWHERE-NOT: , f0, v3) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Tracked" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="StoredFirst" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="shared" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    v4 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v4 variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = Call v2, -, v6
    v8 = NewClosure function=f2
    v9 = Call v8
    Return
}
function f1 name="readX" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f2 name="callsStore" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    Return
}
function f3 name="storesUnknown" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    PutModuleVariable v1 variable=g0
    Return
}
