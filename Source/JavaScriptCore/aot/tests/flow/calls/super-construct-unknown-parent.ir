# A parent nobody sees makes the instances of a class: the SuperConstruct allocates an object of the layout of each new.target that has a heritage, native code holds it, and the unknown object stays beside it
# RUN: flow-solve nodes objects sinks
# CHECK: f0, v11) = {unknown|L0#[[instance]]}
# CHECK: f0, v12) = {unknown|L1#[[below]]}
# CHECK: f1, v3) = {{*}}unknown|L0#[[instance]]}
# CHECK: DeclaredPart(L0#[[instance]], 0) = {undefined|1}
# CHECK: PrototypeLink(L0#[[instance]]) = {f1.prototype}
# CHECK: f1, v3) = {{*}}unknown|L1#[[below]]}
# CHECK: PrototypeLink(L1#[[below]]) = {f2.prototype}
# CHECK: L0#[[instance]] mutations=[ReachNativeCode{{*}} events=[Allocated, AllocatedByConstructor
# CHECK: L1#[[below]] mutations=[ReachNativeCode{{*}} events=[Allocated, AllocatedByConstructor
# CHECK: nativeCode {unknown{{*}}L0#[[instance]]{{*}}L1#[[below]]
# RUN(BASE): flow-solve nodes
# BASE: f0, v16) = {undefined|null|boolean|number|string|symbol|bigint|unknown}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="ExtendsUnknown" constructor=f1 fields=[{key="y" declared={type=anything}}] flags=[HasHeritage]
layout L1 kind=Instance name="Below" predictedBase=L0 constructor=f2 fields=[{key="z" declared={type=anything}}] flags=[HasHeritage]
layout L2 kind=Instance name="Base" constructor=f3
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="makeBase" [isFreeName]
    v2 = Call v1
    v3 = NewClosure function=f1
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L0
    v6 = FinishClass v5 layout=L0
    v7 = NewClosure function=f2
    v8 = ResolveHeritage v6
    v9 = NewClass v7, v6, v8 layout=L1
    v10 = FinishClass v9 layout=L1
    v11 = Construct v6
    v12 = Construct v10
    v13 = PropGet v11 key="y"
    v14 = NewClosure function=f3
    v15 = NewClass v14 layout=L2
    v16 = Construct v2, v15
    Return
}
function f1 name="ExtendsUnknown" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = Integer integer=1
    PropDefine v3, v4 key="y"
    Return v3
}
function f2 name="Below" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropDefine v3, v4 key="z"
    Return v3
}
function f3 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
