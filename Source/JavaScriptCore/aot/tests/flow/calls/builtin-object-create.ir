# Object.create(p) answers a fresh object whose prototype link holds p from its creation on, where Object.setPrototypeOf changes a link
# RUN: flow-solve objects nodes
# CHECK: L0#[[parent]] mutations=[BecomePrototype]
# CHECK: L1#[[bystander]] mutations=[] uses=
# CHECK: L2#[[changed]] mutations=[ChangePrototype]
# CHECK: Object@f0:[[created]] mutations=[] uses=
# CHECK: Variable(g0) = {Object@f0:[[created]]}
# CHECK: PrototypeLink(Object@f0:[[created]]) = {L0#[[parent]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Bystander" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Changed" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
variable g0 name="created" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = Builtin builtin=ObjectCreate
    v5 = Call v4, -, v1
    PutModuleVariable v5 variable=g0
    v7 = Builtin builtin=ObjectSetPrototypeOf
    v8 = Call v7, -, v3, v1
    Return
}
