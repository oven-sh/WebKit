# CHECK: Variable(g0) = {undefined|L0#[[yielded]]}
# CHECK: L0#[[yielded]] mutations=[] uses
# CHECK: AsyncGenerator@f2:result@{{*}} mutations=[] uses
# RUN(LINKS): flow-links calls
# LINKS: f1 v18 -> {{*}} f4 Protocol

