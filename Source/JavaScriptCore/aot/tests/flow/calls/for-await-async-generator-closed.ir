  b2():
    v6 = ResultAt v4 index=1
    PutModuleVariable v6 variable=g0
    v8 = ToBoolean v6
    Branch v8 -> taken b4(), notTaken b1()
  b3():
    Return
  b4():
    IteratorClose v2 iteratorKind=Async
    v10 = NewClosure function=f3
    v11 = PropGet v10 key="prototype"
    v12 = NewClosure function=f4
    PropSet v11, v12 key="return" mode=Strict
    v14 = Call v10
    v15 = IteratorOpen v14 iteratorKind=Async
    v16 = IteratorResume v15 iteratorKind=Async
    v17 = ResultAt v16
    Branch v17 -> taken b3(), notTaken b5()
  b5():
    IteratorClose v15 iteratorKind=Async
    Return
}
