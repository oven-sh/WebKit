# A require of a runtime module answers what the body of its module returns when the program has the module, and the built-in namespace object, which then counts as read, when it has not
# RUN: flow-solve nodes
# RUN(USES): flow-links uses modules
# RUN(NOWHERE): flow-solve nodes
# CHECK: , f1, v0) = {f3}
# CHECK-NEXT: , f1, v1) = {BunFfi}
# USES: evaluated m0 m1
# USES: use BunFfi [Read] f1:v1
# NOWHERE-NOT: , f1, v0) = {{*}}unknown
# NOWHERE-NOT: , f1, v1) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="bun:sqlite" displayPath="bun:sqlite" kind=RuntimeSource exportRule=RuntimeModule requireResult=ModuleExports runtimeModule=BunSqlite body=f2
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="requireBoth" module=m0 role=Library results=[{type=anything}] {
  b0():
    v0 = RequireBuiltinModule runtimeModule=BunSqlite
    v1 = RequireBuiltinModule runtimeModule=BunFfi
    Return
}
function f2 name="sqlite" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    Return v0
}
function f3 name="exported" module=m1 results=[{type=anything}] {
  b0():
    Return
}
