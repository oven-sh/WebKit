# At an operand the unknown object stands for the escaped objects that the operand takes. Set.prototype.union with a set-like argument declares every use of its receiver and throws for a receiver that is no Set:
# with a receiver nobody knows the escaped Set is opened like the set-like record that flows in, and so is a Set that escapes later. The escaped record and the error of the run time keep their proofs
# RUN: flow-solve nodes
# CHECK: UnknownJavaScript() = {{*}}L1#{{*}}Set@f0:v3
# CHECK: DeclaredPart(L0#{{*}}, 0) = {1}
# CHECK: PrototypeLink(L0#{{*}}) = {ObjectPrototype}
# RUN(OBJECTS): flow-solve objects
# OBJECTS-NOT: o0 unknown mutations=[{{*}}RedefineProperty
# OBJECTS: L0#{{*}} mutations=[ReachNativeCode] uses
# OBJECTS: L1#{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS: opaque(Error)@host{{*}} mutations=[ReachNativeCode] uses
# OBJECTS: Set@f0:v3{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS: Set@f0:v10{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript,
# RUN(LINKS): flow-links builtins
# LINKS: builtin {{*}} v9 SetPrototypeUnion/1 Call

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
layout L1 name="SetLike" fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=Set
    v3 = Construct v2, -
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="launder" [isFreeName]
    v6 = Call v5, -, v1, v3
    v7 = NewObject -, v0 layout=L1 fields=[0]
    v8 = Builtin builtin=SetPrototypeUnion
    v9 = Call v8, v6, v7
    v10 = Construct v2, -
    v11 = Call v5, -, v10
    Return
}
