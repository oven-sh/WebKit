# close() of a server's websocket calls the close handler that Bun.serve was given before it returns, with the socket, a number and a string, and so may a write. What the handler stores is among the values of the variable
# RUN: flow-links calls
# RUN(CHECK2): flow-links calls
# RUN(ARGUMENTS): flow-solve nodes
# RUN(ARGUMENTS2): flow-solve nodes
# RUN(ARGUMENTS3): flow-solve nodes
# RUN(STORED): flow-solve nodes
# CHECK: f1 v3 -> {{*}} f2 BuiltinCallback Once
# CHECK2: f1 v7 -> {{*}} f2 BuiltinCallback Once
# ARGUMENTS: , f2, parameter 0) = {ServerWebSocket@f0:v6{{*}}}
# ARGUMENTS2: , f2, parameter 1) = {number}
# ARGUMENTS3: , f2, parameter 2) = {string}
# STORED: Variable(g0) = {undefined|number}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="websocket" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Handlers" fields=[{key="message" declared={type=anything} flags=[IsRequired]}, {key="close" declared={type=anything} flags=[IsRequired]}]
variable g0 name="lastCode" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewObject -, v0, v1 layout=L1 fields=[0, 1]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Builtin builtin=BunServe
    v5 = Builtin builtin=Bun
    v6 = Call v4, v5, v3
    Return
}
function f1 name="message" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="close"
    v3 = Call v2, v0 calleeKey="close"
    v4 = GetModuleVariable variable=g0
    v5 = String string="text"
    v6 = PropGet v0 key="send"
    v7 = Call v6, v0, v5 calleeKey="send"
    Return v4
}
function f2 name="close" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    PutModuleVariable v1 variable=g0
    Return
}
