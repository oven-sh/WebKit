    v4 = PropGet v3 key="value"
    PutModuleVariable v4 variable=g0
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L1 fields=[0]
    Jump -> next b1()
  b1() handler=b2():
    v8 = PropGet v1 key="throw"
    v9 = Call v8, v1, v7 calleeKey="throw"
    Jump -> next b3()
  b2() role=CatchHandler:
    v10 = CatchValue
    PutModuleVariable v10 variable=g1
    Jump -> next b3()
  b3():
    v12 = NewClosure function=f2
    v13 = Call v12
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="keep" [isFreeName]
    v16 = Call v15, -, v13
    Return
}
