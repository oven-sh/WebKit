# A CommonJS body that takes its callee hands it out through `arguments.callee`, so any code can call the body again with arguments of its own: beside the loader's entry it has an entry from native code with any values, and what the loader passes is only predicted. A body that does not take its callee has the loader's entry alone, and what the loader passes is proven
# RUN: flow-solve nodes
# CHECK: , f0, parameter 2) = {5}
# CHECK-NEXT: , f0, parameter 3) = {ModuleObjectExports@m0}
# CHECK: , f0, parameter 2) = {int[0, 2147483647]}
# CHECK-NEXT: , f0, parameter 3) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# CHECK: , f0, v10) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# RUN(LOADER): flow-solve nodes
# LOADER: , f1, parameter 1) = {5}
# LOADER-NEXT: , f1, parameter 2) = {ModuleObjectExports@m1}
# LOADER-NOT: , f1, parameter 2) =
# RUN(APPLIED): flow-apply
# APPLIED-LABEL: function f0 name="takesCallee"
# APPLIED: b0(v0: anything ~ {{*}}, v1: function, v2: {{*}}, v3: anything ~
# APPLIED: v10: anything = GetMappedArgument
# APPLIED-LABEL: function f1 name="takesNoCallee"
# APPLIED: b0(v0: builtin(ModuleObjectExports), v1: {{*}}, v2: builtin(ModuleObjectExports), v3: builtin(ModuleRequire), v4: builtin(ModuleObject), v5: string, v6: string,

module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="/other.cjs" displayPath="other.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
entry module=m1
function f0 name="takesCallee" module=m0 kind=CommonJsModule flags=[IsSloppy, HasThis, TakesCallee, HasArgumentCount, HasHiddenRest] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: int[0, 4294967295], v3: anything, v4: anything, v5: anything, v6: anything, v7: anything, v8: Array):
    v9 = CreateMappedArguments v1, v2, v8, v3, v4, v5, v6, v7
    v10 = GetMappedArgument v9
    Return v10
}
function f1 name="takesNoCallee" module=m1 kind=CommonJsModule flags=[HasThis, HasArgumentCount, HasHiddenRest] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: int[0, 4294967295], v2: anything, v3: anything, v4: anything, v5: anything, v6: anything, v7: Array):
    v8 = CreateUnmappedArguments v1, v7, v2, v3, v4, v5, v6
    Return v2
}
