# Object.assign stores the values of its source under the keys of the source in its target, and takes nothing else from either object
# RUN: flow-solve nodes objects sinks
# CHECK: DeclaredPart(L0#[[target]], 0) = {1|"s"}
# CHECK: DeclaredPart(L0#[[other]], 0) = {1}
# CHECK: , f0, v1) = {L2#[[value]]}
# CHECK: , f0, v3) = {L0#[[target]]}
# CHECK: , f0, v6) = {L1#[[source]]}
# CHECK: , f0, v10) = {L0#[[target]]}
# CHECK: , f0, v11) = {L0#[[other]]}
# CHECK-NOT: Property(L0#[[other]]
# CHECK: Property(L0#[[target]], "b") = {L2#[[value]]}
# CHECK-NOT: Property(L0#[[other]]
# CHECK: L0#[[target]] mutations=[AddProperty, StoreAfterCreation] uses=
# CHECK-NEXT: L1#[[source]] mutations=[] uses=[{{*}}Enumerated
# CHECK-NEXT: L0#[[other]] mutations=[] uses=[] events=[Allocated]
# CHECK-LABEL: nativeCode {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-NOT: L2#
# CHECK-LABEL: unknownJavaScript {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-NOT: L2#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Source" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Value" fields=[{key="v" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = String string="s"
    v6 = NewObject -, v5, v2 layout=L1 fields=[0, 1]
    v7 = FinishObject v6
    v8 = Builtin builtin=Object
    v9 = PropGet v8 key="assign"
    v10 = Call v9, v8, v4, v7 calleeKey="assign"
    v11 = NewObject -, v0 layout=L0 fields=[0]
    v12 = FinishObject v11
    Return
}
