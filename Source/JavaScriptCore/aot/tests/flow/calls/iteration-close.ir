# Closing an iterator of the program calls its return method, also when a built-in iterates, an asynchronous close awaits the value of what return answers, and closing an array iterator, which has no return, calls nothing
# RUN: flow-links calls
# RUN(BUILTIN): flow-links calls
# RUN(ARRAY): flow-links calls
# RUN(NODES): flow-solve nodes
# RUN(LOCATIONS): flow-solve locations
# CHECK: : [[main]] f0 v5 -> [[close]] f3 Protocol Once
# ARRAY-NOT: f0 v8 ->
# BUILTIN: : [[main]] f0 v11 -> [[close]] f3 Protocol Once
# LOCATIONS: DeclaredPart(L1#[[iterator]], 1) events=[{{*}}ReadAsValue
# NODES: Variable(g0) = {L3#[[reason]]|opaque(Error)@host:-.error}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Iterable" fields=[{key=@@iterator declared={type=anything} flags=[IsRequired]}]
layout L1 name="Iterator" fields=[{key="next" declared={type=anything} flags=[IsRequired]}, {key="return" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Result" fields=[{key="value" declared={type=anything} flags=[IsRequired]}, {key="done" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Reason" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
variable g0 name="caught" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = IteratorOpen v2
    v4 = IteratorResume v3
    IteratorClose v3
    v6 = NewArray v2 contents=anything
    v7 = IteratorOpen v6
    IteratorClose v7
    v9 = Builtin builtin=Math
    v10 = PropGet v9 key="sumPrecise"
    v11 = Call v10, v9, v2 calleeKey="sumPrecise"
    v12 = NewClosure function=f4
    v13 = Call v12
    Return
}
function f1 name="iterator" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewObject -, v1, v2 layout=L1 fields=[0, 1]
    Return v3
}
function f2 name="next" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Boolean boolean=false
    v3 = NewObject -, v1, v2 layout=L2 fields=[0, 1]
    Return v3
}
function f3 name="return" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = Boolean boolean=true
    v3 = NewObject -, v1, v2 layout=L2 fields=[0, 1]
    Return v3
}
function f4 name="closeAsynchronously" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = IteratorOpen v1 iteratorKind=Async
    Jump -> next b1()
  b1() handler=b2():
    IteratorClose v2 iteratorKind=Async
    Jump -> next b3()
  b2() role=CatchHandler:
    v4 = CatchValue
    PutModuleVariable v4 variable=g0
    Jump -> next b3()
  b3():
    Return
}
function f5 name="iteratorWithRejectingReturn" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = NewClosure function=f6
    v3 = NewObject -, v1, v2 layout=L1 fields=[0, 1]
    Return v3
}
function f6 name="returnOfRejectedPromise" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f7
    v2 = Call v1
    v3 = Boolean boolean=true
    v4 = NewObject -, v2, v3 layout=L2 fields=[0, 1]
    Return v4
}
function f7 name="rejects" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L3 fields=[0]
    Throw v1
}
