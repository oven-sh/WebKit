# An event is an application by seen code. An evaluator or a loader that only travels as a value, to a function nobody knows or inside an object, is none: the run time refuses it in a program whose build has seen no such event.
# The same evaluator as the callback of a built-in is applied at that call, with its witness
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="make" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = PropGet v0 key="Function" [isFreeName]
    v3 = Call v1, -, v2
    v4 = PropGet v0 key="eval" [isFreeName]
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    v7 = Call v1, -, v6
    Return
}
