# A built-in that only reads the contents of an array records the read, and neither the array nor what it holds gets a mutation or reaches a sink
# RUN: flow-solve objects sinks
# CHECK: L0#{{*}} mutations=[] uses=
# CHECK: Array@f0:v2 mutations=[] uses=[{{*}}ReadByUnknownKey
# CHECK: Array@f0:v6 mutations=[] uses=[{{*}}ReadByUnknownKey
# CHECK: Array@f0:v9 mutations=[] uses=[ReadByName] events=
# CHECK: Array@f0:v11 mutations=[] uses=[{{*}}ReadByUnknownKey
# CHECK: nativeCode {
# CHECK-NOT: Array@f0
# CHECK-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Element" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v0, v0 contents=anything @10
    v3 = String string=","
    v4 = PropGet v2 key="join"
    v5 = Call v4, v2, v3 calleeKey="join"
    v6 = NewArray v0, v0 contents=anything @20
    v7 = PropGet v6 key="includes"
    v8 = Call v7, v6, v0 calleeKey="includes"
    v9 = NewArray v0, v0 contents=anything @30
    v10 = PropGet v9 key="length"
    v11 = NewArray v1 contents=anything @40
    v12 = PropGet v11 key="join"
    v13 = Call v12, v11, v3 calleeKey="join"
    Return
}
