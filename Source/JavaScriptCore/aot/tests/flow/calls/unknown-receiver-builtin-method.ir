# A method that an unknown receiver finds by name is the built-in of that name applied to the unknown object: what push stores arrives in the array native code holds and in no other array
# RUN: flow-links builtins
# CHECK: ArrayPrototypePush/0 Call
# RUN(TYPES): flow
# TYPES: variable g0 type=Array<1|"text", Contiguous,
# TYPES: variable g1 type=1|"text"
# TYPES: variable g2 type=Array<1, proven,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="handedOut" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="element" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v3 variable=g2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="keep" [isFreeName]
    v7 = Call v6, -, v1
    v8 = PropGet v5 key="input" [isFreeName]
    v9 = PropGet v8 key="push"
    v10 = String string="text"
    v11 = Call v9, v8, v10 calleeKey="push"
    v12 = GetModuleVariable variable=g0
    v13 = Integer integer=0
    v14 = ElemGet v12, v13
    PutModuleVariable v14 variable=g1
    Return
}
