# A loop over a map gives pairs that keep keys and values apart, the iterators of keys and of values give one of the two, and the entries of a set give the element twice
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#[[key]]}
# CHECK-NEXT: Variable(g1) = {L1#[[value]]}
# CHECK-NEXT: Variable(g2) = {undefined|L0#[[key]]}
# CHECK-NEXT: Variable(g3) = {undefined|L1#[[value]]}
# CHECK-NEXT: Variable(g4) = {L2#[[element]]}
# CHECK-NEXT: Variable(g5) = {L2#[[element]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Key" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Value" fields=[{key="v" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Element" fields=[{key="e" declared={type=anything} flags=[IsRequired]}]
variable g0 name="a" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="b" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="ofKeys" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="ofValues" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="firstOfSetEntry" module=m0 declared={type=anything} initialization=Uninitialized
variable g5 name="secondOfSetEntry" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Builtin builtin=Map
    v4 = Construct v3
    v5 = PropGet v4 key="set"
    v6 = Call v5, v4, v1, v2 calleeKey="set"
    v7 = IteratorOpen v4
    Jump -> next b1()
  b1():
    LoopHint
    v9 = IteratorResume v7
    v10 = ResultAt v9
    Branch v10 -> taken b3(), notTaken b2()
  b2():
    v11 = ResultAt v9 index=1
    v12 = IteratorOpen v11 elementCount=2 [isDestructuring]
    v13 = IteratorResume v12 stepIndex=0
    v14 = ResultAt v13 index=1
    PutModuleVariable v14 variable=g0
    v16 = IteratorResume v12 stepIndex=1
    v17 = ResultAt v16 index=1
    PutModuleVariable v17 variable=g1
    IteratorClose v12
    Jump -> next b1()
  b3():
    v20 = PropGet v4 key="keys"
    v21 = Call v20, v4 calleeKey="keys"
    v22 = IteratorOpen v21
    v23 = IteratorResume v22
    v24 = ResultAt v23 index=1
    PutModuleVariable v24 variable=g2
    v26 = PropGet v4 key="values"
    v27 = Call v26, v4 calleeKey="values"
    v28 = IteratorOpen v27
    v29 = IteratorResume v28
    v30 = ResultAt v29 index=1
    PutModuleVariable v30 variable=g3
    v32 = NewObject -, v0 layout=L2 fields=[0]
    v33 = Builtin builtin=Set
    v34 = Construct v33
    v35 = PropGet v34 key="add"
    v36 = Call v35, v34, v32 calleeKey="add"
    v37 = PropGet v34 key="entries"
    v38 = Call v37, v34 calleeKey="entries"
    v39 = IteratorOpen v38
    v40 = IteratorResume v39
    v41 = ResultAt v40 index=1
    v42 = IteratorOpen v41 elementCount=2 [isDestructuring]
    v43 = IteratorResume v42 stepIndex=0
    v44 = ResultAt v43 index=1
    PutModuleVariable v44 variable=g4
    v46 = IteratorResume v42 stepIndex=1
    v47 = ResultAt v46 index=1
    PutModuleVariable v47 variable=g5
    IteratorClose v42
    Return
}
