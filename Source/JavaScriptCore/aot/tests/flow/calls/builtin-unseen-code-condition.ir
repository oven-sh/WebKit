# A reached call of an entry that runs unseen code raises the event with that call as its witness, and a call of an entry that runs only code the build has seen raises none
# RUN: flow-links unseen
# CHECK-NOT: ProcessBinding
# CHECK-NOT: f0:v3
# CHECK: unseen RunsUnseenCode ProcessDlopen f0:v6
# CHECK-NOT: ProcessBinding
# CHECK-NOT: f0:v3
# CHECK: unknown-javascript yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = String string="natives"
    v2 = Builtin builtin=ProcessBinding
    v3 = Call v2, v0, v1
    v4 = Builtin builtin=ProcessDlopen
    v5 = String string="addon.node"
    v6 = Call v4, v0, v3, v5
    Return
}
