# A test of a layout, which only text of a form after AsRead can hold, takes the error of the run time out of a caught value and leaves the thrown object alone
# FORM: Prepared
# RUN: flow-solve nodes sinks
# CHECK: Variable(g0) = {L0#[[parseError]]|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g1) = {L0#[[parseError]]}
# CHECK-NEXT: Variable(g2) = {true}
# CHECK: nativeCode {}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ParseError" fields=[{key="token" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Parser" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
variable g0 name="caught" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="caughtParseError" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="token" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Jump -> next b1()
  b1() handler=b2():
    v3 = PropGet v2 key="m"
    v4 = Call v3, v2 calleeKey="m"
    Return
  b2() role=CatchHandler:
    v5 = CatchValue
    PutModuleVariable v5 variable=g0
    v7 = TypeTest v5 testedType=L0
    Branch v7 -> taken b3(| 0), notTaken b6()
  b3(v8):
    PutModuleVariable v8 variable=g1
    Jump -> next b4()
  b4() handler=b5():
    v10 = PropGet v8 key="token"
    PutModuleVariable v10 variable=g2
    Return
  b5() role=CatchHandler:
    v12 = CatchValue
    Return
  b6():
    Return
}
function f1 name="m" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=true
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    Throw v3
}
