# Evaluated text loads no module by name: the run time refuses it unless the program loads by a name nobody knows. So a direct eval that is reached leaves the order of evaluation as it is
# RUN: flow-order modules before m0 m1
# CHECK: m0: component 0 after {}
# CHECK-NEXT: m1: component 1 after {0}
# CHECK-NEXT: before m0 m1 CompletesBefore

module m0 path="imported.js" displayPath="imported.js" body=f0
module m1 path="main.js" displayPath="main.js" body=f1 requests=[{target=m0}]
evalscope e0
entry module=m1
function f0 name="imported" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="main" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="1"
    v1 = CallDirect v0 function=f2
    Return
}
function f2 name="evaluate" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return v2
}
