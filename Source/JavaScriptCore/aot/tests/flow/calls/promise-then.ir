# RUN(DERIVED): flow-solve nodes
# RUN(CALLBACK): flow-solve nodes
# RUN(TWO): flow-solve nodes
# RUN(REJECTION): flow-solve nodes
# RUN(OTHER): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# ONE: , f1, v1) = {Promise@f5:result@[[caller]]}
# ONE: , f1, v4) = {Promise@f1:v4
# ONE: DeclaredPart(Promise@f5:result@[[caller]], 0) = {L0#[[user]]}
# DERIVED: DeclaredPart(Promise@f1:v4{{*}}, 0) = {L1#[[name]]}
# CALLBACK: , f7, parameter 0) = {L0#[[user]]}
# CALLBACK-NEXT: , f7, result 0) = {L1#[[name]]}
# TWO: DeclaredPart(Promise@f2:v5{{*}}, 0) = {L3#[[recovered]]@[[recover]]}
# REJECTION: , f8, parameter 0) = {L2#[[failure]]
# OTHER: , f3, v1) = {Promise@f5:result@[[caller]]}
# OTHER-NEXT: , f3, v2) = {L0#[[user]]}
# OTHER: DeclaredPart(Promise@f5:result@[[caller]], 0) = {L0#[[user]]}
# SINKS-NOT: L0#
# SINKS-NOT: L1#
# SINKS-NOT: L3#
# SINKS-NOT: Promise@f
# SINKS-NOT: f4
# SINKS-NOT: f5
# SINKS-NOT: f7
# SINKS-NOT: f8

