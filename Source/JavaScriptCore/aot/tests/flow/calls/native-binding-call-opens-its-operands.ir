# Nothing describes what a native binding answers. Its operands, and those of what is read from it, can be changed in every way, those objects alone: it is no event of the program, and an object that is not passed keeps its proofs
# RUN: flow-links unseen
# RUN(SINKS): flow-solve sinks
# RUN(NEIGHBOR): flow-solve sinks
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# SINKS: unknownJavaScript {{*}}L0#{{*}}L2#
# NEIGHBOR-NOT: unknownJavaScript {{*}}L1#
# NEIGHBOR-NOT: nativeCode {{*}}L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Passed" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Neighbor" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="PassedToMember" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NativeBinding builtin=NativeCppNoOpForTestingCppCreateNoOpForTesting
    v5 = Call v4, -, v1
    v6 = PropGet v5 key="member"
    v7 = Call v6, v5, v3 calleeKey="member"
    PutModuleVariable v2 variable=g0
    Return
}
