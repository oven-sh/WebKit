# CHECK2: f4 mutations={{*}} events=[Allocated]
# CHECK2-NEXT: f5 mutations={{*}} events=[Allocated]
# CHECK2-NEXT: f6 mutations={{*}} events=[{{*}}OtherNewTarget
# CHECK3: f6, parameter 0) = {f3}
# CHECK4: f1, v2) = {L0#[[plain]]}
# CHECK5: f2, parameter 0) = {f3}
# CHECK6: f2, v2) = {[[layout]]#[[allocated]]}
# CHECK7: f4, parameter 0) = {f5}
# CHECK4: PrototypeLink(L0#[[plain]]) = {f1.prototype}
# CHECK6: PrototypeLink([[layout]]#[[allocated]]) = {{*}}f3.prototype

