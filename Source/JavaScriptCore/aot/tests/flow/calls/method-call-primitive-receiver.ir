# A method call on a string or a number is linked with the overload of the built-in its prototype holds and nothing about it is unknown; a receiver that is undefined alone is linked with nothing
# RUN: flow-links builtins
# CHECK-COUNT-2: builtin
# CHECK-NOT: builtin
# RUN(STRING): flow-links builtins
# STRING: builtin [[main]] v2 StringPrototypeToUpperCase/0 Call
# RUN(NUMBER): flow-links builtins
# NUMBER: builtin [[main]] v6 NumberPrototypeToFixed/0 Call
# RUN(UNKNOWN): flow-links unknown unseen
# UNKNOWN-NOT: unknown-callee
# UNKNOWN-NOT: unseen
# UNKNOWN: unknown-javascript no
# RUN(NODES): flow-solve nodes
# NODES: , f0, v2) = {string}
# NODES: , f0, v6) = {string}
# NODES-NEXT: , f0, v7) = {undefined}
# NODES-NOT: , f0, v9)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="neverStored" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = String string="a"
    v1 = PropGet v0 key="toUpperCase"
    v2 = Call v1, v0 calleeKey="toUpperCase"
    v3 = Integer integer=1
    v4 = Integer integer=2
    v5 = PropGet v3 key="toFixed"
    v6 = Call v5, v3, v4 calleeKey="toFixed"
    v7 = GetModuleVariable variable=g0
    v8 = PropGet v7 key="toFixed"
    v9 = Call v8, v7, v4 calleeKey="toFixed"
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v10 = CatchValue
    Return
}
