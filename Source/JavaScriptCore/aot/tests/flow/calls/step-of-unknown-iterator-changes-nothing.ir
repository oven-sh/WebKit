# `x.next(v)` and `x.throw(v)` on an x nobody knows find every member of those names in the table, and native code applies them with operands nobody knows. What is sent into a generator goes on to its body,
# and the iterator of String.prototype.matchAll advances: none of them stores into, redefines or reparents anything, so an escaped record keeps its proofs
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#{{*}}, 0) = {1}
# CHECK: PrototypeLink(L0#{{*}}) = {ObjectPrototype}
# RUN(OBJECTS): flow-solve objects
# OBJECTS: o0 unknown mutations=[] uses
# OBJECTS: L0#{{*}} mutations=[ReachNativeCode] uses
# RUN(LINKS): flow-links builtins
# LINKS: GeneratorPrototypeNext/0 Call
# LINKS: GeneratorPrototypeThrow/0 Call
# LINKS: RegExpStringIteratorPrototypeNext/0 Call

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="launder" [isFreeName]
    v4 = Call v3, -, v1
    v5 = PropGet v4 key="next"
    v6 = Call v5, v4, v4 calleeKey="next"
    v7 = PropGet v4 key="throw"
    v8 = Call v7, v4, v4 calleeKey="throw"
    Return
}
