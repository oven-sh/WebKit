# ws.data answers what upgrade was given and what the setter stored, and no other object. An object that only reached native memory elsewhere is not among them
# RUN: flow-solve nodes
# RUN(ASSIGNED): flow-solve nodes
# RUN(OTHERS): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# CHECK: , f2, v2) = {undefined|null|boolean|number|string|symbol|bigint|{{*}}L2#
# ASSIGNED: , f2, v2) = {undefined|null|boolean|number|string|symbol|bigint|{{*}}L3#
# OTHERS-NOT: , f2, v2) = {{*}}unknown
# OTHERS-NOT: , f2, v2) = {{*}}L5#
# SINKS-NOT: L2#
# SINKS-NOT: L3#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}, {key="websocket" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Handlers" fields=[{key="message" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Given" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Assigned" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L4 name="UpgradeOptions" fields=[{key="data" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Logged" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = NewObject -, v0, v2 layout=L0 fields=[0, 1]
    v4 = Builtin builtin=BunServe
    v5 = Builtin builtin=Bun
    v6 = Call v4, v5, v3
    Return
}
function f1 name="fetch" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L2 fields=[0]
    v4 = NewObject -, v3 layout=L4 fields=[0]
    v5 = PropGet v1 key="upgrade"
    v6 = Call v5, v1, v0, v4 calleeKey="upgrade"
    Return
}
function f2 name="message" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="data"
    v3 = Integer integer=2
    v4 = NewObject -, v3 layout=L3 fields=[0]
    PropSet v0, v4 key="data"
    v6 = NewObject -, v3 layout=L5 fields=[0]
    v7 = Builtin builtin=StructuredClone
    v8 = Call v7, -, v6
    Return v2
}
