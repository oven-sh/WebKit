# A call of a built-in is linked with the overload that the kind or the class of its argument selects, and with no other
# RUN: flow-links builtins
# CHECK: builtin [[main]] v2 ObjectValues/1 Call
# CHECK-NEXT: builtin [[main]] v5 ObjectValues/0 Call
# CHECK-NEXT: builtin [[main]] v8 Uint8Array/
# CHECK-NEXT: builtin [[main]] v10 ArrayFrom/0 Call
# CHECK-NEXT: builtin [[main]] v11 ArrayFrom/1 Call
# CHECK-NEXT: builtin [[main]] v13 Map/1 Construct
# CHECK-NEXT: builtin [[main]] v14 Map/2 Construct

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectValues
    v1 = String string="ab"
    v2 = Call v0, -, v1
    v3 = Integer integer=1
    v4 = NewArray v3 contents=anything
    v5 = Call v0, -, v4
    v6 = Builtin builtin=ArrayFrom
    v7 = Builtin builtin=Uint8Array
    v8 = Construct v7, -, v3
    v9 = Builtin builtin=Array
    v10 = Call v6, v9, v8
    v11 = Call v6, v9, v1
    v12 = Builtin builtin=Map
    v13 = Construct v12
    v14 = Construct v12, -, v4
    Return
}
