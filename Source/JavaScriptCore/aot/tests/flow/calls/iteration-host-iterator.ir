# A loop over a Headers or a URLSearchParams object calls the host's iterator method and the next of the host's iterator class, so no callee is unknown. One class steps over entries, keys and values, so a step holds a pair of strings, a string or undefined, whether a loop or the program calls next. A pattern takes strings out of it, and nothing reaches a sink
# RUN: flow-solve nodes
# RUN(OPEN): flow-links builtins
# RUN(STEP): flow-links builtins
# RUN(PARAMETERS): flow-links builtins
# RUN(UNKNOWN): flow-links unknown unseen
# RUN(SINKS): flow-solve sinks
# CHECK: Variable(g0) = {undefined|string}
# CHECK-NEXT: Variable(g1) = {undefined|string}
# CHECK-NEXT: Variable(g2) = {undefined|string|Array@f0:v4.element
# CHECK-NEXT: Variable(g3) = {undefined|string|Array@f0:v19.element
# CHECK-NEXT: Variable(g4) = {undefined|string|Array@f0:v25.element
# CHECK-NEXT: Variable(g5) = {undefined|string|Array@f0:v31.element
# CHECK: , f0, v2) = {HeadersIterator@f0:v2
# CHECK: , f0, v17) = {HeadersIterator@f0:v17
# CHECK: , f0, v24) = {URLSearchParamsIterator@f0:v24
# OPEN: builtin [[main]] v2 HeadersPrototypeEntries/0 Call
# STEP: builtin [[main]] v4 HeadersIteratorPrototypeNext/0 Call
# PARAMETERS: builtin [[main]] v25 URLSearchParamsIteratorPrototypeNext/0 Call
# UNKNOWN-NOT: unknown-callee
# UNKNOWN-NOT: unseen
# UNKNOWN: unknown-javascript no
# SINKS: nativeCode {
# SINKS-NOT: @f0:

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="name" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="value" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="entry" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="ofKeys" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="parameter" module=m0 declared={type=anything} initialization=Uninitialized
variable g5 name="steppedByHand" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Headers
    v1 = Construct v0
    v2 = IteratorOpen v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v6 = ResultAt v4 index=1
    PutModuleVariable v6 variable=g2
    v8 = IteratorOpen v6 elementCount=2 [isDestructuring]
    v9 = IteratorResume v8 stepIndex=0
    v10 = ResultAt v9 index=1
    PutModuleVariable v10 variable=g0
    v12 = IteratorResume v8 stepIndex=1
    v13 = ResultAt v12 index=1
    PutModuleVariable v13 variable=g1
    IteratorClose v8
    Jump -> next b1()
  b3():
    v16 = PropGet v1 key="keys"
    v17 = Call v16, v1 calleeKey="keys"
    v18 = IteratorOpen v17
    v19 = IteratorResume v18
    v20 = ResultAt v19 index=1
    PutModuleVariable v20 variable=g3
    v22 = Builtin builtin=URLSearchParams
    v23 = Construct v22
    v24 = IteratorOpen v23
    v25 = IteratorResume v24
    v26 = ResultAt v25 index=1
    PutModuleVariable v26 variable=g4
    v28 = PropGet v23 key="values"
    v29 = Call v28, v23 calleeKey="values"
    v30 = PropGet v29 key="next"
    v31 = Call v30, v29 calleeKey="next"
    v32 = PropGet v31 key="value"
    PutModuleVariable v32 variable=g5
    Return
}
