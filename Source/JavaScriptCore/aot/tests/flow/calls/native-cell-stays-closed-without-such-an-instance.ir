# The program of native-cell-opens-with-an-instance-that-leads-to-it.ir, but the evaluated text is not handed the Timeout. A timer that the text starts itself pairs its own callback with its own arguments,
# so what the program's timers hold stays out of its reach
# RUN: flow-solve sinks
# RUN(LINKS): flow-links unseen
# CHECK-NOT: unknownJavaScript {{*}}L0#
# CHECK-NOT: unknownJavaScript {{*}}f1
# LINKS: unseen EvaluatesText Function f0:v8

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Builtin builtin=SetTimeout
    v4 = Call v3, -, v2, v0, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="text" [isFreeName]
    v7 = PropGet v5 key="Function" [isFreeName]
    v8 = Call v7, -, v6
    v9 = Call v8, -, v0
    Return
}
function f1 name="callback" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
