# The symbol comes from Object.getOwnPropertySymbols, so nobody can name it. It may be the one under which a class of the host has the method that prints it, but a key that the program
# computes loads nothing: what no source names may be missing from the executable, and the call of the method says so.
# Under a key that is the symbol: flow/calls/startup-module-is-read-where-seen-code-reads-the-listed-method-that-prints-a-host-object.ir
# RUN: flow-links calls modules
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ReadableStreamPrototype
    v1 = Builtin builtin=ObjectGetOwnPropertySymbols
    v2 = Call v1, -, v0
    v3 = Integer integer=0
    v4 = ElemGet v2, v3
    v5 = ElemGet v0, v4
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
