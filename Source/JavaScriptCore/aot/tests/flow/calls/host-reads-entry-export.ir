# The host passes the export the entry record names to the built-in the record names and reads no other export, and a name that only a dynamic star export can bring takes the namespace object to native code
# RUN: flow-summary host
# RUN(SOLVE): flow-solve sinks nodes
# RUN(STAR): flow-solve sinks
# RUN(LISTED): flow-solve sinks
# RUN(UNREAD): flow-solve nodes
# CHECK: summary host:
# CHECK: [[export]] = Variable g0
# CHECK-NOT: Variable g1
# CHECK: [[native]] = NativeCode
# CHECK-NOT: Variable g1
# CHECK: seed [[callee]] Builtin BunServe
# CHECK: seed [[holder]] Builtin Bun
# CHECK: seed [[namespace]] Namespace m1
# CHECK: copy [[result]] -> [[native]]
# CHECK: copy [[namespace]] -> [[native]]
# CHECK: copy [[export]] -> [[value]]
# CHECK: LocationAccess#0 kind=Load use=Value location=[[export]] value=[[value]]
# CHECK-NOT: LocationAccess#1
# CHECK: Call#0 mode=Call callee=[[callee]] thisValue=[[holder]] arguments={{*}}[[value]]] result=[[result]]
# CHECK-NOT: Call#1
# SOLVE-NOT: L1#
# SOLVE: n0 NativeCode()
# SOLVE: Variable(g0) = {L0#[[options]]}
# SOLVE-NEXT: Variable(g1) = {L1#[[unnamed]]}
# SOLVE: , f1, parameter 1) =
# UNREAD-NOT: , f2,
# STAR: nativeCode {{*}}namespace m1
# LISTED-NOT: namespace m0

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="default" variable=g0}, {name="unnamed" variable=g1}]
module m1 path="barrel.js" displayPath="barrel.js" body=f3 requests=[{target=m2 isDynamicStarExport=true}]
module m2 path="dynamic.cjs" displayPath="dynamic.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f4
entry module=m0 hostReads=[{exportName="default" builtin=BunServe}]
entry module=m1 hostReads=[{exportName="default"}]
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Unnamed" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
variable g0 name="default" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="unnamed" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f2
    v4 = NewObject -, v3 layout=L1 fields=[0]
    PutModuleVariable v4 variable=g1
    Return
}
function f1 name="fetch" kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="run" kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f3 name="barrel" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f4 name="dynamic" module=m2 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
