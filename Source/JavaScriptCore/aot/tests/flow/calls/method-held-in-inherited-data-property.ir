# A function that a data property of an instance of a built-in class holds is found through an object that inherits from the instance, so a call under that name runs it
# RUN: flow
# CHECK-NOT: function f1 reachability=Unreached
# CHECK: function f1 cause=ReachesNativeCode
# CHECK: variable g0 type=anything {{*}}cause=UnknownObject
# CHECK: function f1 result 0 type="called"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="result" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a"
    v1 = NewClosure function=f1
    PropSet v0, v1 key="lastIndex" mode=Strict
    v3 = Builtin builtin=Object
    v4 = Builtin builtin=ObjectCreate
    v5 = Call v4, v3, v0
    v6 = PropGet v5 key="lastIndex"
    v7 = Call v6, v5 calleeKey="lastIndex"
    PutModuleVariable v7 variable=g0
    Return
}
function f1 name="held" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="called"
    Return v1
}
