# An instance of a class that trimming can remove has reached native code, so an unknown receiver may be that instance. A member whose call starts unseen code is not found by its name all the same:
# no event, no use, and the run time refuses the call
# RUN: flow-links unseen uses
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# CHECK-NOT: use ShadowRealmPrototypeEvaluate [

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v1 key="evaluate"
    v3 = String string="1"
    v4 = Call v2, v1, v3 calleeKey="evaluate"
    v5 = PropGet v0 key="ShadowRealm" [isFreeName]
    v6 = Construct v5
    v7 = PropGet v0 key="keep" [isFreeName]
    v8 = Call v7, -, v6
    Return
}
