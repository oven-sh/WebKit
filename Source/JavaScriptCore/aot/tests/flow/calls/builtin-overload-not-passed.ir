# An argument that is not passed and an argument that is undefined select different overloads, and a list whose length is not known selects both
# RUN: flow-links builtins
# CHECK: builtin [[main]] v4 ReflectGet/0 Call
# CHECK-NEXT: builtin [[main]] v6 ReflectGet/1 Call
# CHECK-NEXT: builtin [[main]] v8 ReflectGet/0 Call
# CHECK-NEXT: builtin [[main]] v8 ReflectGet/1 Call
# CHECK-NEXT: builtin [[main]] v10 Array/0 Call
# CHECK-NEXT: builtin [[main]] v11 Array/1 Call
# CHECK-NEXT: builtin [[main]] v13 Array/0 Call
# CHECK-NEXT: builtin [[main]] v13 Array/1 Call

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = String string="a"
    v3 = Builtin builtin=ReflectGet
    v4 = Call v3, -, v1, v2
    v5 = Undefined
    v6 = Call v3, -, v1, v2, v5
    v7 = NewArray v1, v2 contents=anything
    v8 = CallList v3, -, v7
    v9 = Builtin builtin=Array
    v10 = Call v9, -, v0
    v11 = Call v9, -, v0, v5
    v12 = NewArray v0 contents=anything
    v13 = CallList v9, -, v12
    Return
}
