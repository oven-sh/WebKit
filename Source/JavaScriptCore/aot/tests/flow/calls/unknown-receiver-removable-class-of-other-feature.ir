# Native code of the host that is entered brings the classes whose features its entry names and no other: Bun.color does not name the feature of Buffer, so what it answers is no Buffer, and neither is a value nobody knows
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use BunColor [Read, Called] f0:v2
# CHECK: feature {{*}} BunColor f0:v2
# ALL-NOT: builtin-use Buffer

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Bun" [isFreeName]
    v2 = PropGet v1 key="color"
    v3 = String string="red"
    v4 = Call v2, v1, v3 calleeKey="color"
    v5 = PropGet v4 key="toJSON"
    v6 = Call v5, v4 calleeKey="toJSON"
    v7 = PropGet v0 key="input" [isFreeName]
    v8 = PropGet v7 key="toJSON"
    v9 = Call v8, v7 calleeKey="toJSON"
    Return
}
