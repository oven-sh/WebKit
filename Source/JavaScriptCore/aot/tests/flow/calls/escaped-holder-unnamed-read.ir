# A read under a key nobody can name through the unknown object lets the members follow their holders, so native code calls them. The call of a member that is an event is none of those calls: the run time refuses it in a program without such an event
# RUN: flow-links unseen uses
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# CHECK: use MathAbs [{{*}}Escaped]
# CHECK: use ProcessCwd [{{*}}Escaped]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Builtin builtin=Process
    v3 = Call v1, -, v2
    v4 = Builtin builtin=Math
    v5 = Call v1, -, v4
    v6 = PropGet v0 key="input" [isFreeName]
    v7 = PropGet v0 key="key" [isFreeName]
    v8 = ElemGet v6, v7
    Return
}
