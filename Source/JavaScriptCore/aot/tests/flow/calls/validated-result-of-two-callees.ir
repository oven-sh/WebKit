# One call with a validated result may call the parser or the validator. The call has one copy, allocated when the first of the two is looked at,
# and a position of the copy that takes any object holds what the validated value of either callee reaches: the object under `extra` of the validator's operand.
# A position that the plan copies by its type holds that type alone.
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#[[row]], 0) = {{*}}|L2#
# CHECK-NEXT: DeclaredPart(L0#[[row]], 1) = {number}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0] validation=[{shape=Object{layout=L0 members=[{key="extra" node=1 field=0}, {key="id" node=2 field=1}]} type=L0}, {type=anything}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Row" fields=[{key="extra" declared={type=anything}}, {key="id" declared={type=number}}]
layout L1 name="Input" fields=[{key="extra" declared={type=anything}}, {key="id" declared={type=anything}}]
layout L2 name="Nested" fields=[{key="x" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewObject -, v1, v0 layout=L1 fields=[0, 1]
    v3 = Builtin builtin=JSONParse
    v4 = Builtin builtin=BunBundleValidate
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="flag" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v4)
  b3(v8):
    v9 = Call v8, -, v2 expectedResult=x0
    Return v9
}
