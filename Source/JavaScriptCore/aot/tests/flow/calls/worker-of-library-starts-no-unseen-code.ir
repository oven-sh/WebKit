# The constructor that node:worker_threads gets from its native binding starts a realm with a heap of its own, and the loader of that realm refuses what is not in the image. Constructing it is no event: its operands can be changed in every way, those objects alone
# RUN: flow-links unseen
# RUN(SINKS): flow-solve sinks
# RUN(NEIGHBOR): flow-solve sinks
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# SINKS: unknownJavaScript {{*}}L0#
# NEIGHBOR-NOT: unknownJavaScript {{*}}L1#
# NEIGHBOR-NOT: nativeCode {{*}}L1#

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="node:worker_threads" displayPath="node:worker_threads" kind=RuntimeSource exportRule=RuntimeModule requireResult=ModuleExports runtimeModule=NodeWorker_threads body=f2
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="WebWorker" module=m1 declared={type=anything} initialization=Undefined
layout L0 name="Options" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Neighbor" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f1
    v5 = Call v4, -, v1
    Return
}
function f1 name="startWorker" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = String string="/app/worker.js"
    v3 = Construct v1, -, v2, v0
    Return v3
}
function f2 name="worker_threads" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeCppWorkerCppCreateNodeWorkerConstructor
    PutModuleVariable v0 variable=g1
    Return
}
