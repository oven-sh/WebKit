# The build warns once at each reached require(x) and import(x) by a computed name in the program's own code: not in a function nothing calls, and not in a module of the runtime
# RUN: flow
# DIAGNOSTIC: CodeOutsideImageIsRefused 3
# CHECK: function f1 reachability=Unreached

module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="node:path" displayPath="node:path" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodePath body=f2
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = RequireDynamic v4 referrer=m0
    v7 = ImportDynamic v4 referrer=m0
    v8 = RequireDynamic v5 referrer=m0
    Return
}
function f1 name="uncalled" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = RequireDynamic v0 referrer=m0
    Return
}
function f2 name="loader" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="x"
    v1 = RequireDynamic v0 referrer=m1
    Return
}
