# The engine's own native code answers what its entries say: a regular expression that stays in the program has not reached native code, so a value nobody knows is none
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-use RegExp [Read, Constructed] f0:v1
# CHECK: feature {{*}} RegExp f0:v
# ALL-NOT: builtin-use RegExpPrototype

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="RegExp" [isFreeName]
    v2 = String string="a"
    v3 = Construct v1, -, v2
    v4 = PropGet v0 key="input" [isFreeName]
    v5 = PropGet v4 key="exec"
    v6 = Call v5, v4, v2 calleeKey="exec"
    Return
}
