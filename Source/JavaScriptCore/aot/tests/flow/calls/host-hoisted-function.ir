# The loader makes the closure of a hoisted function and stores it into the variable, so the closure is a site of the host summary and every module reads it from the variable
# RUN: flow-summary host
# RUN(SOLVE): flow-solve nodes
# CHECK: summary host:
# CHECK: [[variable]] = Variable g1
# CHECK-NOT: Variable g0
# CHECK: [[site]] = Closure Operation f2 ordinal=1
# CHECK-NOT: = Closure
# CHECK: seed [[closure]] Site [[site]]
# CHECK: copy [[closure]] -> [[variable]]
# CHECK: closure [[closure]] f2 [[site]] StoredOnce Nothing
# SOLVE: Variable(g1) = {f2}
# SOLVE: , f0, v0) = {f2}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="dependency.js" displayPath="dependency.js" body=f1 exports=[{name="hoisted" variable=g1}]
entry module=m0
variable g0 name="plain" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="hoisted" module=m1 declared={type=function} initialization=Function function=f2
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = GetModuleVariable variable=g0
    Return
}
function f1 name="dependency" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="hoisted" module=m1 results=[{type=anything}] {
  b0():
    Return
}
