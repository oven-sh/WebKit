# Bun.serve converts what it reads under `port` to a number, whatever it is: the `valueOf` of a function that stands there is called. A handler is tested for being callable and kept: the `valueOf` of the function under `fetch` is never called, and the handler does not go to native code, although Function.prototype.toString may have been replaced once Function.prototype has been opened
# RUN: flow-solve instances
# RUN(SINKS): flow-solve sinks
# CHECK-NOT: f1 Generic
# CHECK: f3 
# CHECK-NOT: f4 
# SINKS: unknownJavaScript {{*}}FunctionPrototype
# SINKS-NOT: f1,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="port" declared={type=anything} flags=[IsRequired]}, {key="fetch" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f4
    PropSet v0, v1 key="valueOf"
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    PropSet v3, v4 key="valueOf"
    v6 = NewObject -, v3, v0 layout=L0 fields=[0, 1]
    v7 = Builtin builtin=BunServe
    v8 = Builtin builtin=Bun
    v9 = Call v7, v8, v6
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key=@"nativeThatNobodyDescribed"
    v12 = NewClosure function=f5
    v13 = Call v11, -, v12
    Return
}
function f1 name="fetch" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="port" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="valueOfPort" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="valueOfHandler" results=[{type=anything}] {
  b0():
    Return
}
function f5 name="handedOver" results=[{type=anything}] {
  b0():
    Return
}
