# Reflect.construct with a third operand constructs its target and does nothing else to it: the target gets the listed arguments and that operand as new.target, what it makes comes back, and neither function is opened
# RUN(OBJECTS): flow-solve objects
# RUN(TARGET): flow-solve nodes
# RUN(ARGUMENT): flow-solve nodes
# RUN(RESULT): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# OBJECTS: f1 mutations=[] {{*}}events=[{{*}}OtherNewTarget
# OBJECTS: f2 mutations=[]
# TARGET: f1, parameter 0) = {f2}
# ARGUMENT: f1, parameter 1) = {L2#[[passed]]}
# RESULT: f0, v12) = {[[layout]]#[[made]]}
# RESULT: PrototypeLink([[layout]]#[[made]]) = {f2.prototype}
# SINKS-NOT: f1
# SINKS-NOT: f2
# SINKS-NOT: L2#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Target" constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="NewTarget" constructor=f2
layout L2 name="Passed" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = NewArray v7 contents=anything
    v9 = Builtin builtin=ReflectConstruct
    v10 = Undefined
    v11 = Undefined
    v12 = Call v9, -, v2, v8, v5
    Return
}
function f1 name="Target" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    PropSet v3, v1 key="x" mode=Strict
    Return v3
}
function f2 name="NewTarget" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
