# A thenable whose then is Function: Promise.all finds the member by the name of its protocol and calls it of its own accord. Seen code names it neither as a callee nor as an operand of a call,
# so it is no event, and the run time refuses the evaluation
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Thenable" fields=[{key="then" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Function
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray v2 contents=anything
    v4 = Builtin builtin=Promise
    v5 = PropGet v4 key="all"
    v6 = Call v5, v4, v3 calleeKey="all"
    Return
}
