# The inheritor is an object that nobody knows. Native code holds it and whoever holds an object reads its prototype, so `parent` reaches native code and its method is entered.
# With a built-in object as the inheritor: flow/calls/prototype-given-to-a-builtin-object-stays-with-seen-code.ir
# RUN: flow-links calls
# RUN(SINKS): flow-solve sinks
# CHECK: host - -> {{*}} f1 Host
# SINKS: nativeCode {{*}}L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="listen" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="notListedAnywhere" [isFreeName]
    v4 = Builtin builtin=ObjectSetPrototypeOf
    v5 = Call v4, -, v3, v1
    Return
}
function f1 name="listen" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
