# A conversion leaves a receiver that has reached native code to native code: the call gets the unknown callee and no link to the member. A receiver that only the program holds keeps its link
# RUN: flow-links calls unknown
# CHECK: f0 v8 -> [[tracked]] f1 Protocol
# CHECK-NOT: f0 v9 -> {{*}} f2
# CHECK: unknown-callee [[main]] v9 Protocol
# RUN(TRACKED): flow-links unknown
# TRACKED-NOT: unknown-callee {{*}} v8

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Tracked" fields=[{key="toString" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Escaped" fields=[{key="toString" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Call v5, -, v3
    v7 = Builtin builtin=String
    v8 = Call v7, -, v1
    v9 = Call v7, -, v3
    Return
}
function f1 name="describeTracked" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="describeEscaped" results=[{type=anything}] {
  b0():
    Return
}
