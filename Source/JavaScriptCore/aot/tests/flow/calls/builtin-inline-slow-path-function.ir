# The slow path of an inline built-in calls the entry's own function object. Where a function of the library is behind it, flow enters that function the way native code does, and the records of the overload stay the analysis of the call
# LIBRARY: own
# RUN: flow-links
# RUN(SOLVE): flow-solve instances nodes
# RUN(RESULTS): flow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=4 function=f2
runtimefunction id=8 function=f1

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = PropGet v1 key="at"
    v3 = Integer integer=0
    v4 = Call v2, v1, v3 calleeKey="at"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="Array" [isFreeName]
    v7 = PropGet v6 key="isArray"
    v8 = Call v7, v6, v1 calleeKey="isArray"
    v9 = PropGet v5 key="Math" [isFreeName]
    v10 = PropGet v9 key="abs"
    v11 = Call v10, v9, v3 calleeKey="abs"
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v12 = CatchValue
    Return
}
function f1 name="at" role=Library flags=[HasThis] enclosingRuntimeFunction=8 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    v3 = ElemGet v0, v2
    Return v3
}
function f2 name="apply" role=Library flags=[HasThis] enclosingRuntimeFunction=4 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Call v0, v1
    Return v3
}

# Array.prototype.at on an array: inline code, otherwise the function of the library
# CHECK: host - -> [[at]] f1 Host Repeatedly cycle
# Nothing calls Function.prototype.apply
# CHECK-NOT: f2
# CHECK: builtin [[main]] v4 ArrayPrototypeAt/0 Call
# Array.isArray: inline code, otherwise native code. Math.abs: inline code and nothing else
# CHECK: builtin [[main]] v8 ArrayIsArray/0 Call
# CHECK: builtin [[main]] v11 MathAbs/0 Call

# SOLVE: f1 Generic
# SOLVE-NOT: f1 at f0
# SOLVE-NOT: f2
# SOLVE: , f0, v4) = {undefined|1}
# SOLVE: , f1, parameter 0) = {{*}}unknown

# RESULTS-NOT: function f1 reachability=Unreached
# RESULTS: function f2 reachability=Unreached
# RESULTS: indirect - - -> f1 Host Repeatedly
