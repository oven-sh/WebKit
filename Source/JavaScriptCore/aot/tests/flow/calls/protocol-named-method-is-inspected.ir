# A method that console.log reads under a name it lists is called with the logged object as this, and the function itself is only inspected: it reaches no sink and the host does not enter it
# RUN: flow-links calls
# RUN(NOWHERE): flow-links calls
# RUN(SINKS): flow-solve sinks
# RUN(NODES): flow-solve nodes
# CHECK: f0 v7 -> [[logged]] f2 Protocol
# NOWHERE-NOT: host - -> {{*}} f2
# SINKS-NOT: L0#
# SINKS-NOT: f1
# SINKS-NOT: f2
# NODES: , f2, parameter 0) = {L0#[[instance]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Printable" constructor=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="toJSON"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = Builtin builtin=ConsoleLog
    v7 = Call v6, -, v5
    Return
}
function f1 name="Printable" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="toJSON" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
