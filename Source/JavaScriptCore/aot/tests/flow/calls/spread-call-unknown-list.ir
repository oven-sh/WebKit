# A spread of an unknown list makes every parameter unknown in the generic instance of the callee alone: the proven instance never gets the unknown object
# RUN: flow-solve instances nodes
# CHECK: [[proven]] f1 Proven
# CHECK: Local([[proven]], f1, parameter 0) =
# CHECK-NOT: unknown
# CHECK: L0#[[a]]}
# CHECK-NOT: unknown
# CHECK: Local([[proven]], f1, result 0)
# RUN(GENERIC): flow-solve instances nodes
# GENERIC: [[generic]] f1 Generic
# GENERIC: Local([[generic]], f1, parameter 0) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# GENERIC-NEXT: Local([[generic]], f1, parameter 1) = {undefined|null|boolean|number|string|symbol|bigint|unknown}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="A" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="unknownList" [isFreeName]
    v7 = NewArray contents=anything
    AppendSpread v7, v6
    v9 = CallList v3, -, v7
    Return
}
function f1 name="calledWithUnknownList" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
