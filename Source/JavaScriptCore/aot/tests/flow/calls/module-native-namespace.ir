# The namespace of a native module is a namespace object, for an import declaration and for import(); require answers the object the table of built-ins names for the module
# RUN: flow-solve nodes
# CHECK: , f0, v0) = {namespace m1}
# CHECK-NEXT: , f0, v1) = {BunJsc}
# CHECK-NEXT: , f0, v2) = {Promise@f0:v2}
# CHECK: DeclaredPart(Promise@f0:v2, 0) = {namespace m1}
# RUN(MODULES): flow-links modules
# MODULES: evaluated m0 m1
# MODULES: namespaces m1

module m0 path="/main.js" displayPath="main.js" body=f0
module m1 path="bun:jsc" displayPath="bun:jsc" kind=Runtime exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=BunJsc
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = ModuleNamespace module=m1
    v1 = RequireModule module=m1 referrer=m0 specifier="bun:jsc"
    v2 = ImportModule module=m1 referrer=m0
    Return
  b2() role=CatchHandler:
    v3 = CatchValue
    Return
}
