# The program hands the handler itself to a native function that nobody has described: that one can call it with anything, so the handler has an instance for unknown operands beside the one the host's requests enter.
# RUN: flow-solve instances
# RUN(SINKS): flow-solve sinks
# CHECK: f1 Generic
# SINKS: nativeCode {{*}}f1,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=BunServe
    v3 = Builtin builtin=Bun
    v4 = Call v2, v3, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key=@"nativeThatNobodyDescribed"
    v7 = Call v6, -, v0
    Return
}
function f1 name="fetch" flags=[IsAsync] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
