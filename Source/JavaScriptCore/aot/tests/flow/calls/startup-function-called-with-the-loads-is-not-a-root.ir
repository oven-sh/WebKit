# A program that prints a number gives the host no custom inspect method to call, so the host makes no options for one: getStylizeWithColor is not entered and the start-up module is not evaluated.
# With such a call: flow/calls/startup-function-called-with-the-loads-is-entered-with-them.ir
# RUN: flow-links calls modules
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK-NOT: -> {{*}} f3
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
runtimefunction id=65582 function=f3
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    v1 = Builtin builtin=Console
    v2 = Builtin builtin=ConsoleLog
    v3 = Call v2, v1, v0
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="getStylizeWithColor" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
