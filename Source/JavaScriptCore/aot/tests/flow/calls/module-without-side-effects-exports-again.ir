# A barrel without side effects through which a used name is exported again is used itself, so the module that it imports for its side effects is evaluated, as in an executable without --aot. The module whose name nobody uses is not
# RUN: flow-links modules
# CHECK: evaluated m0 m1 m2 m4
# RUN(TABLES): tables modules
# TABLES: request 0 target=m1
# TABLES-NEXT: request 1 target=m2
# TABLES-NEXT: request 2 target=m4
# TABLES-NOT: request 3

variable g0 name="first" module=m2 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m3 declared={type=anything} initialization=Uninitialized
variable g2 name="kept" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/package/index.js" displayPath="package/index.js" flags=[HasNoSideEffects] body=f1 requests=[{target=m2}, {target=m3}, {target=m4}] exports=[{name="first" variable=g0}, {name="second" variable=g1}]
module m2 path="/package/first.js" displayPath="package/first.js" body=f2 exports=[{name="first" variable=g0}]
module m3 path="/package/second.js" displayPath="package/second.js" flags=[HasNoSideEffects] body=f3 exports=[{name="second" variable=g1}]
module m4 path="/package/polyfill.js" displayPath="package/polyfill.js" body=f4
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = Call v1, -, v2
    Return
}
function f1 name="index" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="first" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    PutModuleVariable v2 variable=g0
    Return
}
function f3 name="second" module=m3 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    PutModuleVariable v2 variable=g1
    Return
}
function f4 name="polyfill" module=m4 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    Return
}
