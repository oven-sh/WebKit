# `promise.$then(reaction)`, as library code writes it: on a receiver that flow proves, the call under the private alias has the member as its one callee, the reaction is reached and the program compiles. A call under an engine private name that the table does not list calls unknown code: it gets no callee set, it returns, and its argument is reached
# RUN: flow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: Call [[then]], [[promise]], v0 calleeKey=@"then" {{*}}callees=[builtin(PromisePrototypeThen)]
# CHECK: Call [[set]], [[map]], v3, {{*}} calleeKey=@"set" {{*}}callees=[builtin(MapPrototypeSet)]
# CHECK: [[result]]: anything = Call [[hidden]], [[other]], v11 calleeKey=@"hidden" accessSite=
# CHECK-NEXT: Return [[result]]
# CHECK-LABEL: function f1 name="reaction"
# CHECK-NEXT: b0(
# CHECK-LABEL: function f2 name="givenToHiddenMember"
# CHECK-NEXT: b0(
# RUN(COMPLETE): flow-apply
# COMPLETE-NOT: callees=[]
# COMPLETE-NOT: never
# COMPLETE-NOT: Unreachable
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=Promise
    v2 = Builtin builtin=PromiseResolve
    v3 = Integer integer=1
    v4 = Call v2, v1, v3 calleeKey="resolve"
    v5 = PropGet v4 key=@"then"
    v6 = Call v5, v4, v0 calleeKey=@"then"
    v7 = Builtin builtin=Map
    v8 = Construct v7
    v9 = PropGet v8 key=@"set"
    v10 = Call v9, v8, v3, v6 calleeKey=@"set"
    v11 = NewClosure function=f2
    v12 = Call v2, v1, v3 calleeKey="resolve"
    v13 = PropGet v12 key=@"hidden"
    v14 = Call v13, v12, v11 calleeKey=@"hidden"
    Return v14
}
function f1 name="reaction" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="givenToHiddenMember" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
