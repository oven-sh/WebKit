# The program follows the link from a prototype to its constructor like any other property: the constructor of the constructor of its own object is Function, and calling it with unknown text evaluates text
# RUN: flow-links unseen
# RUN(NODES): flow-solve nodes
# CHECK: unseen EvaluatesText Function f0:v7
# CHECK: unknown-javascript yes
# NODES: , f0, v3) = {Object}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = PropGet v2 key="constructor"
    v4 = PropGet v3 key="constructor"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="text" [isFreeName]
    v7 = Call v4, -, v6
    Return
}
