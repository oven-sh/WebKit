    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = Builtin builtin=ObjectSetPrototypeOf
    v7 = Call v6, -, v1, v5
    v8 = NewClosure function=f4
    v9 = NewObject -, v8 layout=L2 fields=[0]
