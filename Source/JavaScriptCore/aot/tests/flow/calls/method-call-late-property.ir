layout L3 name="Starter" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
variable g0 name="receiverOrStarter" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="receiver" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L3 fields=[0]
    PutModuleVariable v1 variable=g1
    PutModuleVariable v1 variable=g0
    PutModuleVariable v3 variable=g0
    v7 = GetModuleVariable variable=g0
    v8 = PropGet v7 key="m"
    v9 = Call v8, v7 calleeKey="m"
    Return
}
function f1 name="givesTheReceiverItsMethods" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = NewClosure function=f2
