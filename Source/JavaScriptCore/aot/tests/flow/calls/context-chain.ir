# A function that passes its parameter on is entered once for each call site, and a function it calls once for each of those instances, so two results of a chain of calls stay apart
# RUN: flow-solve nodes
# RUN(FIRST): flow-solve instances nodes
# RUN(SECOND): flow-solve instances nodes
# RUN(OUTER): flow-solve instances
# RUN(INNER): flow-solve instances
# RUN(SHARED): flow-solve instances
# CHECK: f0, v4) = {L0#[[a]]}
# CHECK-NEXT: f0, v5) = {L1#[[b]]}
# CHECK-NEXT: f0, v6) = {L0#[[a]]}
# CHECK-NEXT: f0, v7) = {L1#[[b]]}
# FIRST: [[outer]] f1 at f0:v6 Initialized
# FIRST: [[inner]] f2 at f1:v2 in [[outer]] Initialized
# FIRST: Local([[outer]], f1, parameter 0) = {L0#{{*}}}
# FIRST: Local([[inner]], f2, parameter 0) = {L0#{{*}}}
# FIRST-NEXT: Local([[inner]], f2, result 0) = {L0#{{*}}}
# SECOND: [[outer]] f1 at f0:v7 Initialized
# SECOND: [[inner]] f2 at f1:v2 in [[outer]] Initialized
# SECOND: Local([[outer]], f1, parameter 0) = {L1#{{*}}}
# SECOND: Local([[inner]], f2, parameter 0) = {L1#{{*}}}
# SECOND-NEXT: Local([[inner]], f2, result 0) = {L1#{{*}}}
# OUTER-COUNT-2: f1 at f0:v
# OUTER-NOT: f1 at f0:v
# INNER-COUNT-2: f2 at f1:v2 in
# INNER-NOT: f2 at f1:v2
# SHARED-NOT: f1 Proven
# SHARED-NOT: f2 Proven
# SHARED: f2 at f0:v8 Initialized
# SHARED-NOT: f1 Proven
# SHARED-NOT: f2 Proven

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="id" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = Call v2, -, v4
    v7 = Call v2, -, v5
    v8 = Call v0, -, v5
    Return
}
function f1 name="id2" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0
    Return v2
}
function f2 name="id" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
