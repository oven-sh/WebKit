# A member that a protocol finds under one of its names is called by native code of its own accord: seen code names it neither as a callee nor as an operand of a call.
# A function that starts unseen code stored under such a name raises no event, and the run time refuses it. The second program calls the same function by name
# RUN: flow-links unseen builtins
# CHECK: builtin [[main]] v4 BunPlugin/0 Call
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Converted" fields=[{key="valueOf" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=BunPlugin
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Integer integer=1
    v4 = BitAnd v2, v3
    Return
}
