# Object.freeze changes the integrity of the objects it is given and of no other object of their layout
# RUN: flow-solve nodes objects
# CHECK: , f0, v1) = {L0#[[frozen]]}
# CHECK: , f0, v3) = {L0#[[other]]}
# CHECK: , f0, v7) = {L0#[[frozen]]}
# CHECK: L0#[[frozen]] mutations=[ChangeIntegrity] uses=
# CHECK-NEXT: L0#[[other]] mutations=[] uses=[] events=[Allocated]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Builtin builtin=Object
    v6 = PropGet v5 key="freeze"
    v7 = Call v6, v5, v2 calleeKey="freeze"
    Return
}
