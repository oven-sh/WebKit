# A fresh result is an instance of its call site whose slots hold nothing until something is stored, and a result of a built-in layout has its fields filled by their types
# RUN: flow-solve objects nodes
# RUN(EMPTY): flow-solve nodes
# CHECK: Map@f0:v1{{*}} mutations=[] uses=
# CHECK: Map@f0:v2{{*}} mutations=[] uses=
# CHECK: f0, v1) = {Map@f0:v1{{*}}}
# CHECK-NEXT: f0, v2) = {Map@f0:v2{{*}}}
# CHECK-NEXT: f0, v3) = {Map@f0:v3{{*}}}
# CHECK: f0, v11) = {undefined|[[layout]]#[[descriptor]]}
# CHECK: DeclaredPart(Map@f0:v3{{*}}, 0) = {1}
# CHECK-NEXT: DeclaredPart(Map@f0:v3{{*}}, 1) = {"a"}
# CHECK: DeclaredPart([[layout]]#[[descriptor]], 0) = {{*}}absent|unknown}
# CHECK-NEXT: DeclaredPart([[layout]]#[[descriptor]], 1) = {{*}}boolean|absent}
# CHECK-NEXT: DeclaredPart([[layout]]#[[descriptor]], 2) = {{*}}absent|unknown}
# CHECK-NEXT: DeclaredPart([[layout]]#[[descriptor]], 3) = {{*}}absent|unknown}
# CHECK-NEXT: DeclaredPart([[layout]]#[[descriptor]], 4) = {boolean}
# CHECK-NEXT: DeclaredPart([[layout]]#[[descriptor]], 5) = {boolean}
# EMPTY-NOT: Part(Map@f0:v1
# EMPTY-NOT: Part(Map@f0:v2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    v2 = Construct v0
    v3 = Construct v0
    v4 = Integer integer=1
    v5 = String string="a"
    v6 = PropGet v3 key="set"
    v7 = Call v6, v3, v4, v5 calleeKey="set"
    v8 = NewObject -, v4 layout=L0 fields=[0]
    v9 = Builtin builtin=ObjectGetOwnPropertyDescriptor
    v10 = Builtin builtin=Object
    v11 = Call v9, v10, v8, v5
    Return
}
