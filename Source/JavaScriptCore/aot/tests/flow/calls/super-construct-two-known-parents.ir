# A parent that is one of two compiled classes allocates in their constructors: the SuperConstruct allocates nothing, holds no unknown object, and native code never sees the instances
# RUN: flow-solve nodes objects sinks
# CHECK: f0, v14) = {L2#[[fromA]]|L2#[[fromB]]}
# CHECK: f3, v3) = {L2#[[fromA]]|L2#[[fromB]]}
# CHECK: L2#[[fromA]] mutations=[
# CHECK-NOT: ReachNativeCode
# CHECK: nativeCode {
# RUN(SITES): flow-solve objects
# SITES-COUNT-2: L2#
# SITES-NOT: L2#
# RUN(KEPT): flow-solve sinks
# KEPT-NOT: L2#
# RUN(RESULTS): flow
# RUN(RESULTS2): flow
# RUN(RESULTS3): flow
# RUN(RESULTS4): flow
# RESULTS: class {{*}} layout=L0 {{*}}LoseShape]
# RESULTS2: class {{*}} layout=L1 {{*}}LoseShape]
# RESULTS3: site {{*}} function=f1 layout=L2
# RESULTS4: site {{*}} function=f2 layout=L2
# RUN(NOWHERE): flow
# NOWHERE-NOT: function=f3 layout=L2
# NOWHERE-NOT: cause=UnknownCallee

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" constructor=f2
layout L2 kind=Instance name="D" predictedBase=L0 constructor=f3 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = Builtin builtin=MathRandom
    v7 = Call v6
    v8 = ToBoolean v7
    Branch v8 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v5)
  b3(v9):
    v10 = NewClosure function=f3
    v11 = ResolveHeritage v9
    v12 = NewClass v10, v9, v11 layout=L2
    v13 = FinishClass v12 layout=L2
    v14 = Construct v13
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="B" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f3 name="D" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
