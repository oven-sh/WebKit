# A function that unknown code calls too fills an array of its own and hands it to two helpers, one with a shared instance and one with an instance per call site. The helpers' instances under the generic caller, one per function, are not those under the proven caller, so what the proven caller passes never meets the unknown receiver of the generic one. An item that is passed beside an unknown operand does reach native code
# RUN: flow-solve objects
# RUN(CHECK2): flow-solve objects
# CHECK: L0#[[kept]] mutations=[] uses
# CHECK2: L0#[[handedOver]] mutations=[ReachNativeCode
# RUN(INSTANCES): flow-solve instances
# RUN(INSTANCES2): flow-solve instances
# RUN(INSTANCES3): flow-solve instances
# RUN(INSTANCES4): flow-solve instances
# RUN(INSTANCES5): flow-solve instances
# RUN(INSTANCES6): flow-solve instances
# RUN(INSTANCES7): flow-solve instances
# INSTANCES: f1 Proven Initialized
# INSTANCES2: f1 Generic Initialized
# INSTANCES3: f2 Proven Initialized
# INSTANCES4: f3 at f1:v8 Initialized
# INSTANCES5: f2 ProvenUnderGeneric Initialized
# INSTANCES6: f3 ProvenUnderGeneric Initialized
# INSTANCES7-NOT: at f1:v8 ProvenUnderGeneric

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    v3 = NewArray contents=anything
    v4 = NewClosure function=f1
    v5 = Call v4, -, v2, v3
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="publish" [isFreeName]
    v8 = Call v7, -, v4
    v9 = NewObject -, v0 layout=L0 fields=[0]
    v10 = NewArray v9 contents=anything
    v11 = PropGet v6 key="somewhere" [isFreeName]
    v12 = Call v4, -, v10, v11
    Return
}
function f1 name="keep" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    v3 = NewArray contents=anything
    v4 = ElemGet v0, v2
    ElemSet v3, v2, v4 mode=Strict
    v6 = CallDirect v3 function=f2
    v7 = NewArray contents=anything
    v8 = CallDirect v6, v7 function=f3
    v9 = ElemGet v8, v2
    ElemSet v1, v2, v9 mode=Strict
    Return
}
function f2 name="copy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = NewArray contents=anything
    v3 = ElemGet v0, v1
    ElemSet v2, v1, v3 mode=Strict
    Return v2
}
function f3 name="move" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    v3 = ElemGet v0, v2
    ElemSet v1, v2, v3 mode=Strict
    Return v1
}
