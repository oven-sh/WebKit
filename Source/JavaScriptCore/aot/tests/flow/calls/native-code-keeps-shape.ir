# An instance handed to native code, and what its fields hold, reaches native code and nothing more: no other mutation, no field written by unknown code, nothing in unknownJavaScript, no event of the program; an object that stays in the program reaches no sink
# RUN: flow-solve objects sinks
# CHECK: L2#[[local]] mutations=[] uses=[]
# CHECK: L1#[[inner]] mutations=[ReachNativeCode] uses=
# CHECK: L0#[[kept]] mutations=[ReachNativeCode] uses=
# CHECK-LABEL: nativeCode {
# CHECK: L1#[[inner]]
# CHECK: L0#[[kept]]
# CHECK-LABEL: unknownJavaScript {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# RUN(LOCAL): flow-solve sinks
# LOCAL-NOT: L2#
# RUN(READ): flow-solve locations
# READ: DeclaredPart(L1#[[inner]], 0) events=[ReadByUnknownCode,
# READ: DeclaredPart(L0#[[kept]], 0) events=[ReadByUnknownCode,
# RUN(WRITTEN): flow-solve locations
# WRITTEN-NOT: WrittenByUnknownCode
# RUN(UNSEEN): flow-links unseen uses
# UNSEEN-NOT: unseen
# UNSEEN: unknown-javascript no
# UNSEEN-NOT: use Function [{{*}}Escaped
# UNSEEN-NOT: use Object [{{*}}Escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Kept" constructor=f1 fields=[{key="inner" declared={type=anything}}]
layout L1 name="Inner" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Local" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="keep" [isFreeName]
    v6 = Call v5, -, v3
    v7 = Integer integer=1
    v8 = NewObject -, v7 layout=L2 fields=[0]
    Return
}
function f1 name="Kept" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = NewObject v1, v3 layout=L0 fields=[0]
    Return v4
}
