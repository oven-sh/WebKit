# Start-up fixes each member of a built-in object that compiled code takes as a constant, so evaluated text replaces none: the read of a member of the table stays proven.
# What such text may add is another matter: a name the table does not have is unknown
# RUN: flow-solve nodes
# RUN(ADDED): flow-solve nodes
# CHECK: , f0, v5) = {ObjectKeys}
# ADDED: , f0, v6) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="eval" [isFreeName]
    v3 = Call v2, -, v1
    v4 = PropGet v0 key="Object" [isFreeName]
    v5 = PropGet v4 key="keys"
    v6 = PropGet v4 key="added"
    Return
}
