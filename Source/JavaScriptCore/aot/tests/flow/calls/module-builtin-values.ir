# A value that belongs to one module is one object for each entry of the table and module, however many operations name it, two modules have two import.meta objects, and an entry that holds a string is a string
# RUN: flow-solve nodes
# CHECK: , f0, v0) = {ImportMeta@m0}
# CHECK-NEXT: , f0, v1) = {ImportMeta@m0}
# CHECK-NEXT: , f0, v2) = {string}
# RUN(COMMONJS): flow-solve nodes
# COMMONJS: , f1, v6) = {ModuleRequire@m1}
# COMMONJS-NEXT: , f1, v7) = {ModuleObjectExports@m1}
# RUN(OTHER): flow-solve nodes
# OTHER: , f2, v0) = {ImportMeta@m2}
# RUN(MAINMETA): flow-solve objects
# MAINMETA-COUNT-1: ImportMeta@m0 mutations=
# MAINMETA-NOT: ImportMeta@m0 mutations=
# RUN(OTHERMETA): flow-solve objects
# OTHERMETA-COUNT-1: ImportMeta@m2 mutations=
# OTHERMETA-NOT: ImportMeta@m2 mutations=
# RUN(REQUIRE): flow-solve objects
# REQUIRE-COUNT-1: ModuleRequire@m1 mutations=
# REQUIRE-NOT: ModuleRequire@m
# RUN(EXPORTS): flow-solve objects
# EXPORTS-COUNT-1: ModuleObjectExports@m1 mutations=
# EXPORTS-NOT: ModuleObjectExports@m
# RUN(STRING): flow-solve objects
# STRING-NOT: ImportMetaPath

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}]
module m1 path="/library.cjs" displayPath="library.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
module m2 path="/other.js" displayPath="other.js" body=f2
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ImportMeta module=m0
    v1 = ModuleBuiltin builtin=ImportMeta module=m0
    v2 = ModuleBuiltin builtin=ImportMetaPath module=m0
    Return
}
function f1 name="library" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = ModuleBuiltin builtin=ModuleRequire module=m1
    v7 = ModuleBuiltin builtin=ModuleObjectExports module=m1
    Return
}
function f2 name="other" module=m2 kind=Module results=[{type=anything}] {
  b0():
