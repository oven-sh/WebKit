# What an unknown object holds under the name constructor is the constructor of a built-in class, whether or not that constructor has escaped. So a static member is found by name through the unknown object and applied where it stands:
# `x.constructor.defineProperty(record, ..)` and `.freeze(other)` change their operands and no other object
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[{{*}}RedefineProperty
# CHECK: L1#{{*}} mutations=[{{*}}ChangeIntegrity
# CHECK: L2#{{*}} mutations=[]
# RUN(UNSEEN): flow-links unseen
# UNSEEN-NOT: unseen
# UNSEEN: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Redefined" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Frozen" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Descriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewObject -, v0 layout=L3 fields=[0]
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = PropGet v6 key="constructor"
    v8 = PropGet v7 key="defineProperty"
    v9 = String string="a"
    v10 = Call v8, v7, v1, v9, v4 calleeKey="defineProperty"
    v11 = PropGet v7 key="freeze"
    v12 = Call v11, v7, v2 calleeKey="freeze"
    Return
}
