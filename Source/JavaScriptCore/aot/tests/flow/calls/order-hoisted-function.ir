# A hoisted function is entered where its variable is first read, or after its module has completed when only an importer calls it, so a constant stored before that point is stored before every read
# RUN: flow-order timelines locations failed
# CHECK: timeline f0: f1 after b0#[[exit]], f2 after b0#[[exit]]
# CHECK-NEXT: timeline f2: f3 after b0#3
# CHECK-NEXT: timeline f2 by use: f3 after b0#2
# CHECK-NEXT: g0: SetAtCreation AtMostOnce
# CHECK-NEXT: g1: StoredBeforeEveryRead AtMostOnce
# CHECK-NEXT: g2: SetAtCreation AtMostOnce
# CHECK-NEXT: g3: StoredBeforeEveryRead AtMostOnce
# CHECK-NEXT: g4: Unknown AtMostOnce
# CHECK-NEXT: read-before-initialization g4
# CHECK-NOT: read-before-initialization

module m0 path="dependency.js" displayPath="dependency.js" body=f0 exports=[{name="readLimit" variable=g0}]
module m1 path="main.js" displayPath="main.js" body=f2 requests=[{target=m0}]
entry module=m1
variable g0 name="readLimit" module=m0 declared={type=function} initialization=Function function=f1
variable g1 name="limit" module=m0 declared={type=anything|absent} initialization=Uninitialized flags=[IsImmutable]
variable g2 name="readLocal" module=m1 declared={type=function} initialization=Function function=f3
variable g3 name="x" module=m1 declared={type=anything|absent} initialization=Uninitialized flags=[IsImmutable]
variable g4 name="late" module=m1 declared={type=anything|absent} initialization=Uninitialized flags=[IsImmutable]
function f0 name="dependency" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
function f1 name="readLimit" module=m0 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="limit"
    Return v1
}
function f2 name="main" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g3
    v2 = GetModuleVariable variable=g2
    v3 = Call v2
    v4 = GetModuleVariable variable=g0
    v5 = Call v4
    PutModuleVariable v0 variable=g4
    Return
}
function f3 name="readLocal" module=m1 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="x"
    v2 = GetModuleVariable variable=g4
    v3 = CheckInitialized v2 name="late"
