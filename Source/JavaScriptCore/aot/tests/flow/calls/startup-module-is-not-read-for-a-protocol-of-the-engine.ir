# `x.replace(/a/, "b")` on a receiver nobody knows hands the regular expression to native code, where `x[k] = x` may give it another prototype. String.prototype.replace, which the lookup finds by name
# beside the unknown callee, then looks up @@replace on it, gets an answer nobody knows and calls that.
# It is a built-in of the engine: what it passes is what the language says, and no function of the host. So nobody requires a start-up module.
# console.log is a built-in of the host: flow/calls/startup-module-is-read-where-native-code-calls-the-program.ir
# RUN: flow-links calls modules builtins
# LOSS: MaxPositionalParts f0
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: builtin {{*}} v5 StringPrototypeReplace/3 Call
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = NewRegExp pattern="a"
    v3 = String string="b"
    v4 = PropGet v1 key="replace"
    v5 = Call v4, v1, v2, v3 calleeKey="replace"
    v6 = PropGet v0 key="key" [isFreeName]
    ElemSet v1, v6, v1
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
