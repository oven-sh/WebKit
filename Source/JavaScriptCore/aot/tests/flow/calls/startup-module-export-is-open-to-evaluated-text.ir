# Native code does not keep what it reads from a module to itself: it hangs it on objects of the realm and passes it to whatever it calls. Text evaluated at run time finds it there,
# so the function is open to everything JavaScript can do. The object that the require answers is still out of reach.
# Without the call of eval the function only reaches native code: flow/calls/startup-module-is-read-where-native-code-calls-the-program.ir
# RUN: flow-links unseen
# RUN(SINKS): flow-solve nodes sinks
# RUN(OTHERS): flow-solve nodes sinks
# CHECK: unseen EvaluatesText
# SINKS-LABEL: unknownJavaScript {
# SINKS: f2
# OTHERS-LABEL: nativeCode {
# OTHERS-NOT: L0#
# OTHERS-LABEL: unknownJavaScript {
# OTHERS-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Printed"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject layout=L1
    v2 = Builtin builtin=SymbolFor
    v3 = String string="nodejs.util.inspect.custom"
    v4 = Call v2, -, v3
    ElemSet v1, v4, v0
    v6 = Builtin builtin=Console
    v7 = Builtin builtin=ConsoleLog
    v8 = Call v7, v6, v1
    v9 = Builtin builtin=GlobalThis
    v10 = Builtin builtin=DateNow
    v11 = Call v10
    v12 = ToString v11
    v13 = PropGet v9 key="eval" [isFreeName]
    v14 = Call v13, -, v12
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="custom" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="printed"
    Return v2
}
