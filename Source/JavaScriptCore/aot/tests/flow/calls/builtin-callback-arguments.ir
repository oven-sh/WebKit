# A callback that an entry of the table declares is called with what the entry names: operands of the call, values of the types it states and the receiver
# RUN: flow-links calls
# RUN(MAKE): flow-links calls
# RUN(OTHERS): flow-links calls
# RUN(VISITED): flow-solve nodes
# RUN(MADE): flow-solve nodes
# RUN(STORED): flow-solve nodes
# CHECK: [[main]] f0 v7 -> [[visit]] f1 BuiltinCallback PerElement
# MAKE: [[main]] f0 v14 -> [[make]] f2 BuiltinCallback Once
# OTHERS-NOT: f3
# VISITED: , f0, v1) = {L0#[[receiver]]}
# VISITED: , f0, v4) = {Uint8Array@f0:[[view]]}
# VISITED: , f1, parameter 0) = {L0#[[receiver]]}
# VISITED-NEXT: , f1, parameter 1) = {undefined|number|bigint}
# VISITED-NEXT: , f1, parameter 2) = {int[0, 4294967296]}
# VISITED-NEXT: , f1, parameter 3) = {Uint8Array@f0:[[view]]}
# MADE: , f0, v8) = {L1#[[key]]}
# MADE: , f0, v14) = {L2#[[made]]}
# MADE: , f2, parameter 0) = {L1#[[key]]}
# MADE-NEXT: , f2, result 0) = {L2#[[made]]}
# STORED: , f0, v8) = {L1#[[key]]}
# STORED: , f0, v11) = {Map@f0:[[map]]}
# STORED: , f0, v14) = {L2#[[made]]}
# STORED: DeclaredPart(Map@f0:[[map]], 0) = {L1#[[key]]}
# STORED-NEXT: DeclaredPart(Map@f0:[[map]], 1) = {L2#[[made]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="r" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Key" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Made" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=Uint8Array
    v4 = Construct v3, -, v0
    v5 = NewClosure function=f1
    v6 = PropGet v4 key="forEach"
    v7 = Call v6, v4, v5, v2 calleeKey="forEach"
    v8 = NewObject -, v0 layout=L1 fields=[0]
    v9 = FinishObject v8
    v10 = Builtin builtin=Map
    v11 = Construct v10
    v12 = NewClosure function=f2
    v13 = PropGet v11 key="getOrInsertComputed"
    v14 = Call v13, v11, v9, v12 calleeKey="getOrInsertComputed"
    v15 = NewClosure function=f3
    Return
}
function f1 name="visit" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return
}
function f2 name="make" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L2 fields=[0]
    v3 = FinishObject v2
    Return v3
}
function f3 name="neverPassed" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
