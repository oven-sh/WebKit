# JSON.stringify takes the list of keys at the start and reads each with Get. A key that a toJSON method deletes from the holder in the meantime is found on the prototype, so a field of the prototype under that name is read; the prototype of a holder that loses no key is not looked at
# The statement asks for quiet queues once outside its loop over the objects and once inside it: a release that undid another would show in the number of runs.
# STATISTIC: FlowStatementRuns <= 200
# RUN: flow
# RUN(KEPT): flow
# CHECK: field L2.0 "z" {{*}}flow={
# CHECK-NOT: reads=NeverRead
# CHECK: field L4.0 "z"
# KEPT: field L4.0 "z" {{*}}reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="first" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Deleter" fields=[{key="toJSON" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Prototype" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L3 name="HolderThatKeepsItsKeys" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L4 name="PrototypeNotLookedAt" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
variable g0 name="current" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="inherited"
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Integer integer=3
    v5 = NewObject v1, v3, v4 layout=L0 fields=[0, 1]
    PutModuleVariable v5 variable=g0
    v7 = Builtin builtin=JSONStringify
    v8 = Call v7, -, v5
    v9 = NewObject -, v0 layout=L4 fields=[0]
    v10 = NewObject v9, v4 layout=L3 fields=[0]
    v11 = Call v7, -, v10
    Return
}
function f1 name="toJSON" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropDelete v0 key="z"
    v2 = String string="deleter"
    Return v2
}
