# A parameter no argument is passed for holds undefined, a parameter with an argument does not, and the argument count is the number of arguments of the call
# RUN: flow-solve nodes
# RUN(BOTH): flow-solve nodes
# CHECK: , f0, v1) = {L0#[[a]]}
# CHECK: , f1, parameter 0) = {1}
# CHECK-NEXT: , f1, parameter 1) = {L0#[[a]]}
# CHECK-NEXT: , f1, parameter 2) = {undefined}
# BOTH: , f0, v1) = {L0#[[a]]}
# BOTH: , f2, parameter 0) = {2}
# BOTH-NEXT: , f2, parameter 1) = {L0#[[a]]}
# BOTH-NEXT: , f2, parameter 2) = {L0#[[a]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    v4 = NewClosure function=f2
    v5 = Call v4, -, v1, v1
    Return
}
function f1 name="oneArgument" flags=[HasArgumentCount] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: anything):
    Return
}
function f2 name="bothArguments" flags=[HasArgumentCount] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: anything):
    Return
}
