# console.log finds the custom inspect method of its operand under a name: a closure, which a statement of its own calls. The operands are still the host's choice, and one of them is a function of a start-up module.
# The method answers a constant, so nothing that nobody knows comes back to the formatter: the call of the closure alone makes native code read the module
# RUN: flow-links calls modules
# CHECK: f0 v8 -> {{*}} f3 Protocol
# CHECK: host - -> {{*}} f2 Host
# CHECK: evaluated m0 m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Printed"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject layout=L1
    v2 = Builtin builtin=SymbolFor
    v3 = String string="nodejs.util.inspect.custom"
    v4 = Call v2, -, v3
    ElemSet v1, v4, v0
    v6 = Builtin builtin=Console
    v7 = Builtin builtin=ConsoleLog
    v8 = Call v7, v6, v1
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="custom" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="printed"
    Return v2
}
