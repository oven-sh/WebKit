# A thrown value reaches the handler of its block and no other handler, and a rethrown exception goes on to the next one
# RUN: flow-solve nodes sinks
# CHECK: Variable(g0) = {L0#[[inside]]
# CHECK-NOT: L1#
# CHECK: Variable(g1) = {L1#[[rethrown]]
# CHECK-NOT: , f0, thrown)
# CHECK: , f0, v5) = {L0#[[inside]]
# CHECK-NOT: L1#
# CHECK: , f0, v7) = {L1#[[rethrown]]
# CHECK-NEXT: , f0, v8) = {L1#[[rethrown]]
# CHECK: nativeCode {}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="CaughtInside" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Rethrown" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="inner" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="outer" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    Jump -> next b1()
  b1() handler=b2():
    Throw v2
  b2() role=CatchHandler handler=b5():
    v5 = CatchValue
    PutModuleVariable v5 variable=g0
    Jump -> next b3()
  b3() handler=b4():
    Throw v4
  b4() role=CleanupHandler handler=b5():
    v7 = CatchException
    Rethrow v7
  b5() role=CatchHandler:
    v8 = CatchValue
    PutModuleVariable v8 variable=g1
    Return
}
