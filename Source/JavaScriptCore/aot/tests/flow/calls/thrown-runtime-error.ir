# An error of the run time is one opaque object of class Error, not the unknown object, so a test takes it out of a caught value
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#[[parseError]]|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g1) = {opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g2) = {L0#[[parseError]]|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g3) = {Array@f5:v0|opaque(Error)@host:-.error}
# CHECK-NEXT: Variable(g4) = {Array@f5:v0}
# CHECK-NOT: Variable(g5)
# CHECK: Variable(g6) = {opaque(Error)@host:-.error}
# RUN(OBJECTS): flow-solve objects
# OBJECTS: opaque(Error)@host:-.error mutations=
# OBJECTS-NOT: opaque(Error)@host:-.error

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ParseError" fields=[{key="token" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Parser" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
variable g0 name="caught" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="caughtAndAnError" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="caughtAndMaybeNoError" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="caughtList" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="caughtAndAList" module=m0 declared={type=anything} initialization=Undefined
variable g5 name="caughtAroundIntegers" module=m0 declared={type=anything} initialization=Undefined
variable g6 name="caughtAroundCall" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Jump -> next b1()
  b1() handler=b2():
    v3 = PropGet v2 key="m"
    v4 = Call v3, v2 calleeKey="m"
    Jump -> next b5()
  b2() role=CatchHandler:
    v5 = CatchValue
    PutModuleVariable v5 variable=g0
    v7 = TypeTest v5 testedType=Error
    Branch v7 -> taken b3(| 0), notTaken b4(| 0)
  b3(v8):
    PutModuleVariable v8 variable=g1
    Jump -> next b5()
  b4(v10):
    PutModuleVariable v10 variable=g2
    Jump -> next b5()
  b5():
    v12 = CallDirect function=f2
    v13 = CallDirect function=f3
    v14 = CallDirect function=f4
    Return
}
function f1 name="m" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=true
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    Throw v3
}
function f2 name="addsIntegers" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    Jump -> next b1()
  b1() handler=b2():
    v2 = Add v0, v1
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    PutModuleVariable v3 variable=g5
    Return
}
function f3 name="callsFunctionWithoutThrow" results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = CallDirect function=f6
    Return
  b2() role=CatchHandler:
    v1 = CatchValue
    PutModuleVariable v1 variable=g6
    Return
}
function f4 name="catchesList" results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = CallDirect function=f5
    Return
  b2() role=CatchHandler:
    v1 = CatchValue
    PutModuleVariable v1 variable=g3
    v3 = TypeTest v1 testedType=Array
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4):
    PutModuleVariable v4 variable=g4
    Return
  b4():
    Return
}
function f5 name="throwsList" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    Throw v0
}
function f6 name="throwsNothing" results=[{type=anything}] {
  b0():
    Return
}
