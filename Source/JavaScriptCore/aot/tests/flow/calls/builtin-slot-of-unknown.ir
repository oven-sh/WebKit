# What Map.prototype.set stores through a receiver nobody knows reaches native code and the unknown object, and an escaped map sees it
# RUN: flow-solve nodes sinks
# RUN(KEPT): flow-solve sinks
# CHECK: UndeclaredPart(unknown) = {{*}}L1#[[stored]]
# CHECK: f0, v9) = {{*}}unknown
# CHECK: f0, v14) = {{*}}L1#[[stored]]
# CHECK: f0, v17) = {undefined|L2#[[kept]]}
# CHECK: nativeCode {{*}}L1#[[stored]]
# KEPT-NOT: L2#
# KEPT-NOT: Map@f0:v15

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Key" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="v" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Kept" fields=[{key="w" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="shared" [isFreeName]
    v6 = Builtin builtin=MapPrototypeSet
    v7 = Call v6, v5, v1, v2
    v8 = Builtin builtin=MapPrototypeGet
    v9 = Call v8, v5, v1
    v10 = Builtin builtin=Map
    v11 = Construct v10
    v12 = PropGet v4 key="publish" [isFreeName]
    v13 = Call v12, -, v11
    v14 = Call v8, v11, v1
    v15 = Construct v10
    v16 = Call v6, v15, v1, v3
    v17 = Call v8, v15, v1
    Return
}
