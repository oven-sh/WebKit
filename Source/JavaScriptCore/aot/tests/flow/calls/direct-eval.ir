# A direct eval is an event of the program: the text can do anything to this, to the environments it sees and to the variables its scope lists, and nothing to a variable of another module
# RUN: flow-links unseen
# RUN(SOLVE): flow-solve sinks nodes
# CHECK: unseen EvaluatesText - f1:v3
# CHECK: unknown-javascript yes
# SOLVE: unknownJavaScript {{*}} L0#[[environment]], L1#[[receiver]],
# SOLVE: Variable(g0) = {{*}}unknown}
# SOLVE-NEXT: Variable(g1) = {2}
# SOLVE: , f0, v2) = {L0#[[environment]]}
# SOLVE-NEXT: , f0, v3) = {L1#[[receiver]]}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="other.js" displayPath="other.js" body=f2
entry module=m0
layout L0 kind=Environment fields=[{declared={type=anything}}]
layout L1 name="Receiver" fields=[{key="r" declared={type=anything} flags=[IsRequired]}]
variable g0 name="listed" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="ofOtherModule" module=m1 declared={type=anything} initialization=Uninitialized
evalscope e0 bindings=[{name="local" layout=L0 field=0 operand=0}, {name="listed" variable=g0}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = NewClosure v2 function=f1
    v5 = String string="local = listed"
    v6 = Call v4, v3, v5
    Return
}
function f1 name="evaluate" module=m0 flags=[HasThis] captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: anything):
    v3 = DirectEval v2, v1, -, v0 evalScope=e0
    Return v3
}
function f2 name="other" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g1
    Return
}
