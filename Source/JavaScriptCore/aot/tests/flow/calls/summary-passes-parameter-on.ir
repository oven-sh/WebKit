# A summary has PassesParameterOn when a parameter can leave through a result, a store, a call or as a callee, and not when it is only compared or thrown
# RUN: flow-summary
# CHECK: summary f0:{{*}} flags=[PassesParameterOn]
# CHECK: summary f1:{{*}} flags=[PassesParameterOn, CreatesObjects]
# CHECK: summary f2:{{*}} flags=[PassesParameterOn, HasCalls]
# CHECK: summary f3:{{*}} flags=[PassesParameterOn, HasCalls]
# CHECK: summary f4:{{*}} flags=[PassesParameterOn]
# CHECK: summary f5:{{*}} flags=[]
# CHECK: summary f6:{{*}} flags=[]

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Box" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
function f0 name="returnsIt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f1 name="storesIt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    Return
}
function f2 name="passesIt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=MathMax
    v2 = Call v1, -, v0
    Return
}
function f3 name="callsIt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
function f4 name="returnsItThroughCast" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Upcast v0 castType=anything
    Return v1
}
function f5 name="comparesIt" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = Null
    v2 = StrictEq v0, v1
    Return v2
}
function f6 name="throwsIt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Throw v0
}
