# Object.getPrototypeOf, Reflect.getPrototypeOf and the getter of __proto__ answer what the prototype link of their operand holds and keep nothing. The answer is the object itself: what becomes of it happens to the prototype, and an operand nobody knows has a prototype nobody knows
# RUN: flow-solve nodes sinks
# CHECK: , f0, v7) = {L0#[[parent]]}
# CHECK: , f0, v9) = {L0#[[parent]]}
# CHECK: , f0, v10) = {L0#[[parent]]}
# CHECK: , f0, v12) = {ObjectPrototype}
# CHECK: , f0, v14) = {StringPrototype}
# CHECK: , f0, v19) = {L0#[[parent]]|L2#[[second]]}
# CHECK: , f0, v21) = {null|unknown}
# CHECK: , f0, v26) = {L3#[[published]]}
# CHECK-LABEL: nativeCode {
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-NOT: L2#
# CHECK-NOT: L4#
# CHECK-NOT: L5#
# CHECK: L3#[[published]]
# CHECK-NOT: L0#
# CHECK-NOT: L1#
# CHECK-NOT: L2#
# CHECK-NOT: L4#
# CHECK-NOT: L5#
# CHECK-LABEL: unknownJavaScript {

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Child" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="SecondParent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L3 name="PublishedParent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L4 name="ChildOfPublished" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Reparented" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=GlobalThis
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L1 fields=[0]
    SetLiteralPrototype v3, v2
    v5 = FinishObject v3
    v6 = Builtin builtin=ObjectGetPrototypeOf
    v7 = Call v6, -, v5
    v8 = Builtin builtin=ReflectGetPrototypeOf
    v9 = Call v8, -, v5
    v10 = PropGet v5 key="__proto__"
    v11 = NewObject -, v0 layout=L2 fields=[0]
    v12 = Call v6, -, v11
    v13 = String string="text"
    v14 = PropGet v13 key="__proto__"
    v15 = NewObject -, v0 layout=L5 fields=[0]
    SetLiteralPrototype v15, v2
    v17 = FinishObject v15
    PropSet v17, v11 key="__proto__" mode=Strict
    v19 = Call v6, -, v17
    v20 = PropGet v1 key="imported" [isFreeName]
    v21 = Call v8, -, v20
    v22 = NewObject -, v0 layout=L3 fields=[0]
    v23 = NewObject -, v0 layout=L4 fields=[0]
    SetLiteralPrototype v23, v22
    v25 = FinishObject v23
    v26 = Call v6, -, v25
    v27 = PropGet v1 key="publish" [isFreeName]
    v28 = Call v27, -, v26
    Return
}
