# RUN: flow-links calls
# CHECK: host - -> {{*}} f1 Host

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Function" [isFreeName]
    v2 = Builtin builtin=Process
    v3 = PropGet v2 key="title"
    v4 = Call v1, -, v3
    Return
}
function f1 name="performIteration" role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
runtimefunction id=74 function=f1
