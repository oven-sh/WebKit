# The statement of every access operation: its kind, its flags, how a read is used, and which value is `this`
# RUN: flow-summary f0 f1 f2
# CHECK-LABEL: summary f0:
# CHECK: seed l10 TypeAsRead boolean
# CHECK-NEXT: seed l11 TypeAsRead boolean
# CHECK-NEXT: seed l12 TypeAsRead boolean
# CHECK: seed [[name]] TypeAsRead string
# CHECK: Filter#0 from=[[unscopables]] to=[[unscopablesObject]] type=object kind=Inside
# CHECK: PrototypeAccess#0 kind=Store origin=v19 object=l2 value=l0
# CHECK-NEXT: PrototypeAccess#1 kind=Load origin=v21 object=l2 value=l15
# CHECK-NEXT: PrototypeAccess#2 kind=Load origin=v22 object=[[classPrototype]] value=l16
# CHECK-NEXT: PropertyAccess#0 kind=Load use=Value origin=v3 receiver=l0 key="a" value=l5 thrown=l4
# CHECK-NEXT: PropertyAccess#1 kind=Load use=Value flags=[IsFreeName] origin=v4 receiver=l0 key="b" value=l6 thrown=l4
# CHECK-NEXT: PropertyAccess#2 kind=Load use=Value flags=[IsFreeName, IsForTypeOf] origin=v5 receiver=l0 key="c" value=l7 thrown=l4
# CHECK-NEXT: PropertyAccess#3 kind=Load use=CalleeOnly origin=v6 receiver=l0 key="d" value=l8 thrown=l4
# CHECK-NEXT: PropertyAccess#4 kind=Store use=Value flags=[NamesReceivers] origin=v8 receiver=l0 key="e" value=l1 thrown=l4
# CHECK-NEXT: PropertyAccess#5 kind=Store use=Value flags=[IsFreeName, IsSloppy, NamesReceivers] origin=v9 receiver=l0 key="f" value=l1 thrown=l4
# CHECK-NEXT: PropertyAccess#6 kind=Define use=Value flags=[NamesReceivers] origin=v10 receiver=l2 key="g" value=l1 thrown=l4
# CHECK-NEXT: PropertyAccess#7 kind=Test use=Value origin=v11 receiver=l0 key="h" thrown=l4
# CHECK-NEXT: PropertyAccess#8 kind=Delete use=Value flags=[IsSloppy] origin=v12 receiver=l0 key="i" thrown=l4
# CHECK-NEXT: PropertyAccess#9 kind=Test use=Value origin=v13 receiver=l2 key="j" thrown=l4
# CHECK-NEXT: PropertyAccess#10 kind=Load use=Value origin=v13 receiver=l2 key=@@unscopables value=[[unscopables]] thrown=l4
# CHECK-NEXT: PropertyAccess#11 kind=Load use=Value origin=v13 receiver=[[unscopablesObject]] key="j" value={{*}} thrown=l4
# CHECK-NEXT: PropertyAccess#12 kind=DefineGetter use=Value origin=v15 receiver=l2 key="k" value=l13 thrown=l4
# CHECK-NEXT: PropertyAccess#13 kind=DefineSetter use=Value origin=v16 receiver=l2 key="k" value=l13 thrown=l4
# CHECK-NEXT: PropertyAccess#14 kind=Define use=Value origin=v18 receiver=l13 key="name" value=[[name]] thrown=l4
# CHECK-NEXT: PropertyAccess#15 kind=Load use=Value origin=v22 receiver=l13 key="prototype" value=[[classPrototype]] thrown=l4
# CHECK-NEXT: PropertyAccess#16 kind=Load use=Value origin=v23 receiver=l15 key="l" value=l17 thisValue=l0 thrown=l4
# CHECK-NEXT: PropertyAccess#17 kind=Store use=Value flags=[IsSloppy] origin=v24 receiver=l15 key="m" value=l1 thisValue=l0 thrown=l4
# CHECK-NEXT: PropertyCopy#0 origin=v20 source=l0 target=l2 excludedKeys=[l14] thrown=l4
# CHECK-LABEL: summary f1:
# CHECK: seed l7 TypeAsRead boolean
# CHECK-NEXT: seed l8 TypeAsRead boolean
# CHECK-NOT: seed l14
# CHECK: PropertyAccess#0 kind=Load use=Value flags=[IsOwnOnly] origin=v16 receiver=l0 key="own" value=l14 thrown=l5
# CHECK-NEXT: ElementAccess#0 kind=Load use=Value origin=v4 receiver=l0 key=l3 value=l6 thrown=l5
# CHECK-NEXT: ElementAccess#1 kind=Store use=Value flags=[IsSloppy, NamesReceivers] origin=v5 receiver=l0 key=l3 value=l1 thrown=l5
# CHECK-NEXT: ElementAccess#2 kind=Define use=Value flags=[NamesReceivers] origin=v6 receiver=l2 key=l3 value=l1 thrown=l5
# CHECK-NEXT: ElementAccess#3 kind=Test use=Value origin=v7 receiver=l0 key=l3 thrown=l5
# CHECK-NEXT: ElementAccess#4 kind=Delete use=Value origin=v8 receiver=l0 key=l3 thrown=l5
# CHECK-NEXT: ElementAccess#5 kind=DefineGetter use=Value origin=v11 receiver=l2 key=l9 value=l10 thrown=l5
# CHECK-NEXT: ElementAccess#6 kind=Load use=Value origin=v13 receiver=l11 key=l3 value=l12 thisValue=l0 thrown=l5
# CHECK-NEXT: ElementAccess#7 kind=Store use=Value origin=v14 receiver=l11 key=l3 value=l1 thisValue=l0 thrown=l5
# CHECK-NEXT: ElementAccess#8 kind=Load use=Value origin=v15 receiver=l0 key=l3 value=l13 thisValue=l1 thrown=l5
# CHECK-NOT: OperandUse{{*}} origin=v4 operandIndex=1
# CHECK-LABEL: summary f2:
# CHECK: seed l11 TypeAsRead boolean
# CHECK: copy l3 -> l14
# CHECK: FieldAccess#0 kind=Load use=Value origin=v9 receiver=l3 layout=L1 field=1 value=l10 thrown=l9
# CHECK-NEXT: FieldAccess#1 kind=Store use=Value origin=v10 receiver=l3 layout=L1 field=1 value=l4 thrown=l9
# CHECK-NEXT: FieldAccess#2 kind=Define use=Value origin=v11 receiver=l3 layout=L1 field=0 value=l4 thrown=l9
# CHECK-NEXT: FieldAccess#3 kind=Test use=Value origin=v12 receiver=l3 layout=L1 field=0 thrown=l9
# CHECK-NEXT: FieldAccess#4 kind=Load use=Value origin=v13 receiver=l0 layout=L2 field=1 value=l12
# CHECK-NOT: thrown
# CHECK: FieldAccess#5 kind=Store use=Value origin=v14 receiver=l0 layout=L2 field=0 value=l3
# CHECK-NOT: thrown
# CHECK: SlotAccess#0 kind=Load origin=v15 receiver=l4 internalFieldIndex=2 value=l13
# CHECK-NEXT: SlotAccess#1 kind=Store origin=v16 receiver=l4 internalFieldIndex=1 value=l3
# CHECK: SlotAccess#3 kind=Load origin=v18 receiver=l15 contentsSlot=Element position=3 value=l16
# CHECK-NEXT: SlotAccess#4 kind=Store origin=v19 receiver=l15 contentsSlot=Element position=3 value=l3
# CHECK-NEXT: SlotAccess#5 kind=Load origin=v20 receiver=l5 contentsSlot=Element value=l17
# CHECK-NEXT: SlotAccess#6 kind=Store origin=v21 receiver=l5 contentsSlot=Element value=l3
# CHECK-NEXT: SlotAccess#7 kind=Store origin=v22 receiver=l5 contentsSlot=Element value=l3

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Literal" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="WithPrivate" fields=[{key=#"p"@L1 declared={type=anything} flags=[IsPrivate]}, {key=#"q"@L1 declared={type=anything} flags=[IsPrivate]}]
layout L2 kind=Environment fields=[{declared={type=anything}}, {declared={type=anything}}]
function f0 name="named" parameters=[{type=anything}, {type=anything}, {type=object}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: object):
    v3 = PropGet v0 key="a"
    v4 = PropGet v0 key="b" [isFreeName]
    v5 = PropGet v0 key="c" [isFreeName, isForTypeOf]
    v6 = PropGet v0 key="d"
    v7 = Call v6, v0
    PropSet v0, v1 key="e"
    PropSet v0, v1 key="f" mode=Sloppy [isFreeName]
    PropDefine v2, v1 key="g"
    v11 = PropHas v0 key="h"
    v12 = PropDelete v0 key="i" mode=Sloppy
    v13 = ScopeHasBinding v2 key="j"
    v14 = NewClosure function=f3
    DefineGetter v2, v14 key="k"
    DefineSetter v2, v14 key="k"
    v17 = ToPropertyKey v1
    SetFunctionName v14, v17
    SetLiteralPrototype v2, v0
    CopyDataProperties v2, v0, v17 excludedKeys=["x"]
    v21 = GetSuperBase v2
    v22 = GetSuperBase v14 homeKind=ClassPrototype
    v23 = SuperGet v21, v0 key="l"
    SuperSet v21, v0, v1 mode=Sloppy key="m"
    Return v3
}
function f1 name="computed" role=Library parameters=[{type=anything}, {type=anything}, {type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: object, v3: anything):
    v4 = ElemGet v0, v3
    ElemSet v0, v3, v1 mode=Sloppy
    ElemDefine v2, v3, v1
    v7 = ElemHas v0, v3
    v8 = ElemDelete v0, v3
    v9 = ToPropertyKey v3
    v10 = NewClosure function=f3
    DefineGetter v2, v10, v9
    v12 = GetSuperBase v2
    v13 = SuperGet v12, v0, v3
    SuperSet v12, v0, v1, v3
    v15 = GetByValWithThis v0, v1, v3
    v16 = GetOwnProperty v0 key="own"
    Return v4
}
function f2 name="fieldsAndSlots" role=Library flags=[IsSloppy, TakesCallee, HasArgumentCount, HasHiddenRest] captures=[{type=env L2}] parameters=[{type=anything}, {type=object}, {type=Array}, {type=i32}] results=[{type=anything}] {
  b0(v0: env L2, v1: function, v2: int[0, 4294967295], v3: anything, v4: object, v5: Array, v6: i32, v7: Array):
    v8 = NewClassToken layout=L1
    v9 = PrivateGet v3, v8 layout=L1 field=1
    PrivateSet v3, v8, v4 layout=L1 field=1
    PrivateDefine v3, v8, v4 layout=L1
    v12 = PrivateHas v3, v8 layout=L1
    v13 = GetEnvironmentField v0 layout=L2 field=1
    PutEnvironmentField v0, v3 layout=L2
    v15 = GetInternalField v4 index=2
    v16 = PutInternalField v4, v3 index=1
    v17 = CreateMappedArguments v1, v2, v7, v3
    v18 = GetMappedArgument v17 index=3
    SetMappedArgument v17, v3 index=3
    v20 = GetContiguousIndex v5, v6
    PutContiguousIndex v5, v6, v3
    AppendElement v5, v3
    Return v9
}
function f3 name="accessor" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
