# The program puts an evaluator of text into an object that a built-in reads. The entry names no member that it calls, so the evaluator only travels as a value, which is no event
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="body" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="fetch" [isFreeName]
    v2 = String string="https://example.com"
    v3 = Builtin builtin=Function
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = Call v1, -, v2, v5
    Return
}
