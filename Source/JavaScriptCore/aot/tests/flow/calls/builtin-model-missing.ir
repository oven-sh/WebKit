# A model that the program lacks is an internal error, and the records of the entry are applied in its place
# LIBRARY: own
# RUN: flow-links builtins
# RUN(NODES): flow-solve nodes
# DIAGNOSTIC: FlowRuntimeFunctionMissing 1
# CHECK: builtin [[main]] v5 ObjectEntries/0 Call
# NODES: , f0, v5) = {Array@f0:[[entries]]}
# NODES: DeclaredPart(Array@f0:[[entries]], 0) = {Array@f0:[[pair]]}
# NODES: Position(Array@f0:[[pair]], 0) = {{*}}unknown}
# NODES-NEXT: Position(Array@f0:[[pair]], 1) = {{*}}unknown}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=Object
    v4 = PropGet v3 key="entries"
    v5 = Call v4, v3, v2 calleeKey="entries"
    Return
  b2() role=CatchHandler:
    v6 = CatchValue
    Return
}
