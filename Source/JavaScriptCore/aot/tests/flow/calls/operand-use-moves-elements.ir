# reverse() moves the elements of its receiver: every position holds every element and undefined, also at a call that took the array as its list, or spread it, before the reverse was reached, which only the callee of that call does; an array nothing moves keeps its positions
# RUN: flow-solve nodes objects
# CHECK: Position(Array@f0:v3, 0) = {undefined|L0#[[a]]|L1#[[b]]}
# CHECK-NEXT: Position(Array@f0:v3, 1) = {undefined|L0#[[a]]|L1#[[b]]}
# CHECK: Position(Array@f0:v7, 0) = {undefined|L0#[[a]]|L1#[[b]]}
# CHECK-NEXT: Position(Array@f0:v7, 1) = {undefined|L0#[[a]]|L1#[[b]]}
# CHECK: Position(Array@f0:v13, 0) = {L0#[[a]]}
# CHECK-NEXT: Position(Array@f0:v13, 1) = {L1#[[b]]}
# CHECK: Array@f0:v3 mutations=[StoreAfterCreation] uses={{*}} events=[{{*}}ElementsMoved
# CHECK: Array@f0:v7 mutations=[StoreAfterCreation] uses={{*}} events=[{{*}}ElementsMoved
# CHECK: Array@f0:v13 mutations=[] uses={{*}} events=[Allocated]
# RUN(LIST): flow-solve nodes
# LIST: , f0, v1) = {L0#[[a]]}
# LIST-NEXT: , f0, v2) = {L1#[[b]]}
# LIST: , f1, parameter 0) = {undefined|L0#[[a]]|L1#[[b]]}
# LIST-NEXT: , f1, parameter 1) = {undefined|L0#[[a]]|L1#[[b]]}
# RUN(SPREAD): flow-solve nodes
# SPREAD: , f0, v1) = {L0#[[a]]}
# SPREAD-NEXT: , f0, v2) = {L1#[[b]]}
# SPREAD: , f2, parameter 0) = {undefined|L0#[[a]]|L1#[[b]]}
# SPREAD-NEXT: , f2, parameter 1) = {undefined|L0#[[a]]|L1#[[b]]}
# RUN(UNTOUCHED): flow-solve nodes
# UNTOUCHED: , f0, v1) = {L0#[[a]]}
# UNTOUCHED-NEXT: , f0, v2) = {L1#[[b]]}
# UNTOUCHED: , f3, parameter 0) = {L0#[[a]]}
# UNTOUCHED-NEXT: , f3, parameter 1) = {L1#[[b]]}
# RUN(LINKS): flow-links builtins
# LINKS: v2 ArrayPrototypeReverse/0 Call

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="A" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="B" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
variable g0 name="passedAsList" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="spread" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewArray v1, v2 contents=anything @10
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f1
    v6 = CallList v5, -, v3
    v7 = NewArray v1, v2 contents=anything @20
    PutModuleVariable v7 variable=g1
    v9 = NewClosure function=f2
    v10 = NewArray contents=anything @30
    AppendSpread v10, v7
    v12 = CallList v9, -, v10
    v13 = NewArray v1, v2 contents=anything @40
    v14 = NewClosure function=f3
    v15 = CallList v14, -, v13
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v16 = CatchValue
    Return
}
function f1 name="takesTheListAndReversesIt" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g0
    v3 = CallDirect v2 function=f4
    Return
}
function f2 name="takesTheSpreadAndReversesIt" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g1
    v3 = CallDirect v2 function=f4
    Return
}
function f3 name="takesUntouched" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f4 name="reverses" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="reverse"
    v2 = Call v1, v0 calleeKey="reverse"
    Return
}
