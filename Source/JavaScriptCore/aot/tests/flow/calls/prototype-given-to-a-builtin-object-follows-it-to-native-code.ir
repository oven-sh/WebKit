# The built-in object that got `parent` as its prototype is handed to a function that nobody knows. The prototype link follows it, so `parent` reaches native code and its method is entered.
# Without the call: flow/calls/prototype-given-to-a-builtin-object-stays-with-seen-code.ir
# RUN: flow-links calls
# RUN(SINKS): flow-solve sinks
# CHECK: host - -> {{*}} f1 Host
# SINKS: nativeCode {{*}}L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="listen" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=EventEmitterPrototype
    v3 = Builtin builtin=ObjectSetPrototypeOf
    v4 = Call v3, -, v2, v1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="notListedAnywhere" [isFreeName]
    v7 = Call v6, -, v2
    Return
}
function f1 name="listen" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
