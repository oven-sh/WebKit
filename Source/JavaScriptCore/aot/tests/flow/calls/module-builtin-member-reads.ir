# Reading a member the table lists on import.meta or on the module object is a read of that member alone: no getter of another built-in under the same name, no event of the program, no object of the module in a sink
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# RUN(SINKS): flow-solve sinks
# SINKS-NOT: ImportMeta
# SINKS-NOT: ModuleObject
# SINKS-NOT: ModuleRequire
# RUN(WALK): flow-walk f0
# WALK: v1 Get {"url"}
# WALK-NEXT: ImportMeta@m0: BuiltinGetter own {{*}} ImportMetaUrl
# WALK-NOT: BuiltinGetter {{*}}"url"
# WALK: v2 Get {"dir"}

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/library.cjs" displayPath="library.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ImportMeta module=m0
    v1 = PropGet v0 key="url"
    v2 = PropGet v0 key="dir"
    v3 = PropGet v0 key="main"
    Return
}
function f1 name="library" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = PropGet v3 key="id"
    v7 = PropGet v3 key="exports"
    Return
}
