# A call of a closure links the caller with the function, passes the capture and each argument to its parameter and brings the result back
# RUN: flow-links calls operands
# RUN(NODES): flow-solve nodes instances
# CHECK-NOT: f2
# CHECK: link [[call]]: [[caller]] f0 v5 -> [[callee]] f1 Call Once
# CHECK-NOT: cycle
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: f2
# CHECK: operand [[capture]](f1.part0) -> [[parameter0]](f1:l0) link [[call]]
# CHECK-NEXT: operand [[first]](f0:l{{*}}) -> [[parameter1]](f1:l1) link [[call]]
# CHECK-NEXT: operand [[second]](f0:l{{*}}) -> [[parameter2]](f1:l2) link [[call]]
# CHECK-NOT: operand
# NODES: Variable(g0) = {L2#[[secondObject]]}
# NODES: f1, parameter 0) = {L0#{{*}}}
# NODES-NEXT: f1, parameter 1) = {L1#{{*}}}
# NODES-NEXT: f1, parameter 2) = {L2#[[secondObject]]}
# NODES-NEXT: f1, result 0) = {L2#[[secondObject]]}
# NODES: i0 host
# NODES-NOT: f2
# NODES: f1 at f0:v5
# NODES-NOT: f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Captured" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="First" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Second" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
variable g0 name="result" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewClosure v1 function=f1
    v5 = Call v4, -, v2, v3
    PutModuleVariable v5 variable=g0
    v7 = NewClosure v1 function=f2
    PutModuleVariable v7 variable=g1
    Return
}
function f1 name="called" captures=[{type=anything}] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v2
}
function f2 name="neverCalled" captures=[{type=anything}] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v2
}
