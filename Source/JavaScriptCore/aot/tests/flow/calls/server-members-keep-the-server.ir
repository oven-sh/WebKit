# The program reads `url` and `port` of the server that Bun.serve answers with and calls `stop`. None of them keeps the server or hands it on, so the server does not reach native code, `fetch` of its prototype is not among what an unknown callee may be, and the handler has no instance for unknown operands. The value nobody knows that the program hands to a native function is what such a call would get as its receiver, and the read under a key nobody can name is what lets the members of an escaped prototype follow it.
# RUN: flow-solve instances
# RUN(SINKS): flow-solve sinks
# RUN(RESULTS): flow
# CHECK-NOT: f1 Generic
# SINKS-NOT: HTTPServer@
# RESULTS: variable g1 type=undefined|number
# RESULTS-NOT: genericVersion

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="fetch" declared={type=anything} flags=[IsRequired]}]
variable g0 name="url" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="port" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=BunServe
    v3 = Builtin builtin=Bun
    v4 = Call v2, v3, v1
    v5 = PropGet v4 key="url"
    PutModuleVariable v5 variable=g0
    v7 = PropGet v4 key="port"
    PutModuleVariable v7 variable=g1
    v9 = PropGet v4 key="stop"
    v10 = Boolean boolean=true
    v11 = Call v9, v4, v10 calleeKey="stop"
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key=@"nativeThatNobodyDescribed"
    v14 = Call v13, -
    v15 = Call v13, -, v14
    v16 = ElemGet v14, v15
    Return
}
function f1 name="fetch" flags=[IsAsync] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
