# A read through a receiver nobody knows finds the members of the built-in objects that have escaped, by their names. It names no function that starts unseen code: the call is no event and the run time refuses it.
# A member that starts nothing is still found
# RUN: flow-links unseen builtins
# CHECK-NOT: BunPlugin
# CHECK: builtin [[main]] v10 BunInspect/{{*}} Call
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Builtin builtin=Bun
    v3 = Call v1, -, v2
    v4 = PropGet v0 key="given" [isFreeName]
    v5 = PropGet v4 key="plugin"
    v6 = Integer integer=1
    v7 = Call v5, v4, v6 calleeKey="plugin"
    v8 = PropGet v4 key="inspect"
    v9 = Undefined
    v10 = Call v8, v4, v6 calleeKey="inspect"
    Return
}
