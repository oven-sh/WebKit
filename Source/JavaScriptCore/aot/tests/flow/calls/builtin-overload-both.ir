# An argument that holds values of two kinds selects the overload of each kind, and a call whose argument nothing reaches selects none
# RUN: flow-links builtins
# CHECK: builtin [[main]] v7 ObjectValues/0 Call
# CHECK-NEXT: builtin [[main]] v7 ObjectValues/1 Call
# CHECK-NOT: builtin [[main]] v10

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="either" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    PutModuleVariable v0 variable=g0
    v2 = Integer integer=1
    v3 = NewArray v2 contents=anything
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=ObjectValues
    v6 = GetModuleVariable variable=g0
    v7 = Call v5, -, v6
    v8 = NewClosure function=f1
    v9 = Call v8
    v10 = Call v5, -, v9
    Return
}
function f1 name="neverReturns" results=[{type=anything}] {
  b0():
    v0 = String string="thrown"
    Throw v0
}
