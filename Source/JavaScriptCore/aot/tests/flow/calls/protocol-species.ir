# SUBCLASS: , f2, v11) = {L0#
# SUBCLASS: , f2, v13) = {{*}}L1#
# ARRAY: , f2, v13) = {{*}}Array@f2:v13
# GETTER: f2 v13 -> [[callee]] f4 Accessor
# CONSTRUCTOR: f2 v13 -> [[callee]] f5 Construct
# NOWHERE-NOT: , f1, v3) = {{*}}L
# NOWHERE-NOT: , f1, v3) = {{*}}unknown
# UNLINKED-NOT: f1 v3 ->

module m0 path="main.js" displayPath="main.js" body=f0
