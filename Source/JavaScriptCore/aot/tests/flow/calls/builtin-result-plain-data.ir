# JSON.parse without a reviver answers primitives, a plain object and a plain array of that call, whose contents are each other and primitives, and never the unknown object
# RUN: flow-solve nodes objects
# RUN(TRACKED): flow-solve nodes
# CHECK: f0, v4) = {{*}}null|boolean|number|string{{*}}Object@f0:v4|Array@f0:v4}
# CHECK-NEXT: f0, v5) = {{*}}null|boolean|number|string{{*}}Object@f0:v5|Array@f0:v5}
# CHECK: f0, v7) = {{*}}unknown
# CHECK: DeclaredPart(Array@f0:v4, 0) = {{*}}|Object@f0:v4|Array@f0:v4}
# CHECK: Object@f0:v4 mutations=[] uses=
# CHECK: Array@f0:v4 mutations=[] uses=
# CHECK: Object@f0:v5 mutations=[] uses=
# CHECK: Array@f0:v5 mutations=[] uses=
# TRACKED-NOT: f0, v4) = {{*}}unknown
# TRACKED-NOT: f0, v4) = {{*}}@f0:v5
# TRACKED-NOT: f0, v5) = {{*}}unknown
# TRACKED-NOT: f0, v5) = {{*}}@f0:v4
# TRACKED-NOT: (Array@f0:v4, 0) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = Builtin builtin=JSONParse
    v4 = Call v3, -, v2
    v5 = Call v3, -, v2
    v6 = NewClosure function=f1
    v7 = Call v3, -, v2, v6
    Return
}
function f1 name="reviver" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
