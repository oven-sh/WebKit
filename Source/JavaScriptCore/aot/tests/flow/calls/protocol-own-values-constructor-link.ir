# A built-in that reads the own values of everything it reaches does not take the constructor out of a built-in prototype. The formatter behind process.emitWarning meets an unknown object here, whose constructor may be the prototype that generator functions inherit from, and the own values of that prototype do not lead on to GeneratorFunction, which evaluates text
# RUN: flow-links unseen uses
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# CHECK-NOT: use GeneratorFunction [
# CHECK: use GeneratorPrototypeConstructor [Read] f0:v11
# CHECK-NOT: use GeneratorFunction [

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Warning" fields=[{key="detail" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Reflect
    v1 = PropGet v0 key="construct"
    v2 = NewClosure function=f1
    v3 = NewArray contents=anything
    v4 = NewClosure function=f1
    v5 = Call v1, v0, v2, v3, v4 calleeKey="construct"
    v6 = Builtin builtin=Process
    v7 = PropGet v6 key="emitWarning"
    v8 = Integer integer=1
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = Call v7, v6, v10 calleeKey="emitWarning"
    Return
}
function f1 name="Made" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
