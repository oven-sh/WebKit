# import() answers a promise, awaiting it gives the namespace object of the imported module, and what the body of the module throws is caught around the await; a module nobody imports is not evaluated
# RUN: flow-solve nodes
# CHECK: , f1, v0) = {Promise@f1:v0}
# CHECK-NEXT: , f1, v1) = {namespace m1}
# CHECK-NEXT: , f1, v2) = {L0#[[failure]]|opaque(Error)@host:-.error}
# RUN(OTHER): flow-solve nodes
# OTHER-NOT: namespace m2
# OTHER-NOT: L1#
# RUN(MODULES): flow-links modules
# MODULES: evaluated m0 m1
# MODULES-NOT: m2
# MODULES: namespaces m1
# MODULES-NOT: m2

module m0 path="/main.js" displayPath="main.js" body=f0
module m1 path="/imported.js" displayPath="imported.js" body=f2
module m2 path="/never-imported.js" displayPath="never-imported.js" body=f3
entry module=m0
layout L0 name="Failure" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
layout L1 name="OtherFailure" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    Return
}
function f1 name="imports" module=m0 flags=[IsAsync] results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = ImportModule module=m1 referrer=m0
    v1 = Await v0
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return
}
function f2 name="imported" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Throw v1
}
function f3 name="neverImported" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    Throw v1
}
