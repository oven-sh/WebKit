# A call with a list that has positions passes each position to its parameter: an array literal, a rest array, and beside a caller that passes arguments one by one
# RUN: flow-solve nodes
# CHECK: , f1, parameter 0) = {L0#[[x]]}
# CHECK-NEXT: , f1, parameter 1) = {L1#[[a]]}
# CHECK-NEXT: , f1, parameter 2) = {L2#[[b]]}
# RUN(SHARED): flow-solve nodes
# SHARED: , f2, parameter 0) = {L0#[[x]]|L3#[[c]]}
# SHARED-NEXT: , f2, parameter 1) = {undefined|L1#[[a]]}
# SHARED-NEXT: , f2, parameter 2) = {undefined|L2#[[b]]}
# RUN(REST): flow-solve nodes
# REST: , f4, parameter 0) = {L1#[[a]]}
# REST-NEXT: , f4, parameter 1) = {L2#[[b]]}
# REST-NEXT: , f4, parameter 2) = {undefined}

