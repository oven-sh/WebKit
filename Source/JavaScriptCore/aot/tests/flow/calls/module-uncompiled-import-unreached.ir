# An import of a value the host provides is no event, and neither is an import of uncompiled code in a module nobody evaluates: no unknown JavaScript can run
# RUN: flow-links modules unseen
# CHECK: evaluated m0 m1
# CHECK-NOT: m2
# CHECK: namespaces
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="host:value" displayPath="host:value" kind=External exportRule=RuntimeModule externalKind=HostValue referrer=m0
module m2 path="/never-requested.js" displayPath="never-requested.js" body=f1 requests=[{target=m3}]
module m3 path="/uncompiled.js" displayPath="uncompiled.js" kind=External referrer=m2
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="neverRequested" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
