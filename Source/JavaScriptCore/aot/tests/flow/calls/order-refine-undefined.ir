# A variable starts without the value it has before its first store, and gets that value, undefined or absent, only when the proof that the store comes before every read fails
# RUN: flow-order failed locations
# RUN(NODES): flow-solve nodes
# CHECK: read-before-initialization g1
# CHECK-NEXT: read-before-initialization g2
# CHECK-NEXT: g0: StoredBeforeEveryRead AtMostOnce
# CHECK-NEXT: g1: Unknown AtMostOnce
# CHECK-NEXT: g2: Unknown AtMostOnce
# CHECK-NEXT: g3: SetAtCreation AtMostOnce
# NODES: Variable(g0) = {L0#0}
# NODES-NEXT: Variable(g1) = {undefined|L0#0}
# NODES-NEXT: Variable(g2) = {absent|L0#0}
# NODES: f1, v0) = {L0#0}
# NODES-NEXT: f1, v1) = {undefined|L0#0}
# NODES-NEXT: f1, v2) = {absent|L0#0}
# NODES-NEXT: f1, v3) = {L0#0}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="a" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="b" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="c" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g3 name="read" module=m0 declared={type=function} initialization=Function function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g3
    v4 = Call v3
    PutModuleVariable v1 variable=g1
    PutModuleVariable v1 variable=g2
    Return
}
function f1 name="read" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = GetModuleVariable variable=g2
    v3 = CheckInitialized v2 name="c"
    Return v3
}
