# `f = f.bind(undefined, argument)` in a loop: the target of a bound function may be that bound function. The call of a bound function is a statement of its own, made once for the
# bound function, so the chain of targets ends. Each turn of the chain puts one more argument in front: past the limit the positions are one rest, and the loss is recorded once.
# The function at the end of the chain is entered, with the bound argument at each position it can have. A function that is only bound is not entered.
# RUN: flow-links calls statements
# RUN(NODES): flow-solve nodes
# LOSS: MaxPositionalParts x1 f0
# STATISTIC: FlowWorklistSteps <= 2000

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = Builtin builtin=MathRandom
    v5 = NewClosure function=f2
    v6 = PropGet v5 key="bind"
    v7 = Undefined
    v8 = Call v6, v5, v7, v3 calleeKey="bind"
    Jump -> next b1(v0)
  b1(v9):
    LoopHint
    v11 = PropGet v9 key="bind"
    v12 = Call v11, v9, v7, v3 calleeKey="bind"
    v13 = Call v4
    v14 = ToBoolean v13
    Branch v14 -> taken b1(v12), notTaken b2()
  b2():
    v15 = Call v12
    Return
}
function f1 name="target" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f2 name="onlyBound" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK: f0 v15 -> i{{*}} f1 Call Once
# CHECK-NOT: -> i{{*}} f2
# CHECK: statement i{{*}} v15 BoundFunction@f0:v12{{*}} Call Once
# CHECK: statement i{{*}} v15 BoundFunction@f0:v12{{*}} Call Once own-nodes
# CHECK-NOT: statement i{{*}} v15
# NODES: , f0, v15) = {L0#[[argument]]}
# NODES: DeclaredPart(BoundFunction@f0:v12{{*}}, 0) = {f1|BoundFunction@f0:v12
# NODES: , f1, parameter 0) = {L0#[[argument]]}
# NODES: , f1, parameter 1) = {undefined|L0#[[argument]]}
# NODES-NOT: , f2, parameter 0)
