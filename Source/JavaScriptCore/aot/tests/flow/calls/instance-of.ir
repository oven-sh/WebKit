# instanceof calls the Symbol.hasInstance method of a class or of an object, which it reads as a value, and for a plain class it calls nothing of the program, notes the test on the class object and sends nothing to a sink
# RUN: flow-links calls
# RUN(OBJECT): flow-links calls
# RUN(PLAIN): flow-links calls
# RUN(OBJECTS): flow-solve objects sinks
# RUN(LOCATIONS): flow-solve locations
# RUN(FIELDS): pipeline RemoveUnreadFields
# CHECK: : [[main]] f0 v11 -> [[method]] f3 Protocol Once
# OBJECT: : [[main]] f0 v14 -> [[method]] f3 Protocol Once
# PLAIN-NOT: f0 v10 ->
# OBJECTS: f1 mutations=[] uses=[{{*}}TestedByInstanceOf
# OBJECTS: f1.prototype mutations=[]
# OBJECTS: nativeCode {
# OBJECTS-NOT: f1
# OBJECTS-NOT: L2#
# LOCATIONS: DeclaredPart(L3#[[tester]], 0) events=[{{*}}ReadAsValue
# FIELDS: = NewObject -, [[method]] layout=L3 fields=[0]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Plain" constructor=f1
layout L1 kind=Instance name="Custom" constructor=f2
layout L2 name="Tested" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Tester" fields=[{key=@@hasInstance declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = NewClosure function=f3
    DefineMethod v4, v5 layout=L1 side=Static key=@@hasInstance
    v7 = FinishClass v4 layout=L1
    v8 = Integer integer=1
    v9 = NewObject -, v8 layout=L2 fields=[0]
    v10 = InstanceOf v9, v2
    v11 = InstanceOf v9, v7
    v12 = NewClosure function=f3
    v13 = NewObject -, v12 layout=L3 fields=[0]
    v14 = InstanceOf v9, v13
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="print" [isFreeName]
    v17 = Call v16, -, v10, v11, v14
    Return
}
function f1 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="Custom" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="hasInstance" kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Boolean boolean=true
    Return v2
}
