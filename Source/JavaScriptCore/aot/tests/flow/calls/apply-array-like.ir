# A list of arguments that is no array is read by index: a parameter holds what the list has under its index and undefined, never what it has under a name
# RUN: flow-solve nodes
# RUN(OTHER): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# CHECK: , f0, v1) = {L0#[[first]]}
# CHECK: , f0, v3) = {L1#[[second]]}
# CHECK: , f1, parameter 0) = {undefined|L0#[[first]]
# CHECK-NEXT: , f1, parameter 1) = {undefined|{{*}}L1#[[second]]}
# OTHER: , f0, v3) = {L1#[[second]]}
# OTHER: , f2, parameter 0) = {undefined|L1#[[second]]}
# OTHER-NEXT: , f2, parameter 1) = {undefined
# SINKS-NOT: L0#
# SINKS-NOT: L1#
# SINKS-NOT: L2#
# SINKS-NOT: f1
# SINKS-NOT: f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="ArrayLike" fields=[{key="length" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = Integer integer=0
    ElemDefine v5, v6, v2
    v8 = Integer integer=1
    ElemDefine v5, v8, v4
    v10 = FinishObject v5
    v11 = NewClosure function=f1
    v12 = PropGet v11 key="apply"
    v13 = Undefined
    v14 = Call v12, v11, v13, v10 calleeKey="apply"
    v15 = NewObject -, v8 layout=L2 fields=[0]
    ElemDefine v15, v6, v4
    v17 = FinishObject v15
    v18 = NewClosure function=f2
    v19 = PropGet v18 key="apply"
    v20 = Call v19, v18, v13, v17 calleeKey="apply"
    Return
}
function f1 name="pair" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="other" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
