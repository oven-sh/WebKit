# An instance of a class that extends Map is an object of the layout of the class: its own fields are tracked, and what it holds as a map is not
# RUN: flow-solve nodes objects sinks
# RUN(TRACKED): flow-solve nodes
# RUN(KEPT): flow-solve sinks
# CHECK: f0, v5) = {L0#[[instance]]}
# CHECK-NEXT: f0, v6) = {{*}}1}
# CHECK: f0, v13) = {{*}}unknown
# CHECK: PrototypeLink(L0#[[instance]]) = {{*}}f1.prototype
# CHECK: L0#[[instance]] mutations={{*}} events=[{{*}}AllocatedByConstructor
# CHECK: nativeCode {{*}}L2#
# TRACKED-NOT: f0, v5) = {{*}}unknown
# TRACKED-NOT: f0, v6) = {{*}}unknown
# KEPT-NOT: L0#
# KEPT-NOT: L3#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[HasHeritage]
layout L1 name="Key" fields=[{key="k" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="v" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Kept" fields=[{key="w" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = NewClosure function=f1
    v2 = ResolveHeritage v0
    v3 = NewClass v1, v0, v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="x"
    v7 = Integer integer=1
    v8 = NewObject -, v7 layout=L1 fields=[0]
    v9 = NewObject -, v7 layout=L2 fields=[0]
    v10 = PropGet v5 key="set"
    v11 = Call v10, v5, v8, v9 calleeKey="set"
    v12 = PropGet v5 key="get"
    v13 = Call v12, v5, v8 calleeKey="get"
    v14 = NewObject -, v7 layout=L3 fields=[0]
    v15 = Construct v0
    v16 = PropGet v15 key="set"
    v17 = Call v16, v15, v8, v14 calleeKey="set"
    Return
}
function f1 name="A" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = Integer integer=1
    PropDefine v3, v4 key="x"
    Return v3
}
