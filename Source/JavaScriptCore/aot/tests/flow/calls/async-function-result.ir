# Each call of an async function has a promise of its own: what the body returns is in its value slot, what the body throws in its reason slot
# RUN: flow-solve nodes
# RUN(OUTER): flow-solve nodes
# RUN(FAILS): flow-solve nodes
# RUN(OBJECTS): flow-solve nodes objects
# CHECK: , f0, thrown) = {opaque(Error)@host:-.error}
# CHECK: , f0, v1) = {Promise@f1:result@[[main]]}
# CHECK-NEXT: , f0, v2) = {Promise@f1:result@[[main]]}
# CHECK-COUNT-2: DeclaredPart(Promise@f1:result@[[main]], 0) = {L0#[[row]]}
# OUTER: , f0, v4) = {Promise@f2:result@[[main]]}
# OUTER: DeclaredPart(Promise@f2:result@[[main]], 0) = {L0#[[row]]}
# FAILS: , f0, v6) = {Promise@f3:result@[[main]]}
# FAILS-NOT: DeclaredPart(Promise@f3:result@[[main]], 0)
# FAILS: DeclaredPart(Promise@f3:result@[[main]], 1) = {L1#[[failure]]
# FAILS-NOT: DeclaredPart(Promise@f3:result@[[main]], 0)
# OBJECTS: , f0, v1) = {Promise@f1:result@[[main]]}
# OBJECTS-COUNT-2: Promise@f1:result@[[main]] mutations=
# OBJECTS-NOT: Promise@f1:result@[[main]] mutations=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Row" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Failure" fields=[{key="code" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Call v0
    v3 = NewClosure function=f2
    v4 = Call v3
    v5 = NewClosure function=f3
    v6 = Call v5
    Return
}
function f1 name="row" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    Return v2
}
function f2 name="outer" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return v1
}
function f3 name="fails" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    Throw v2
}
