# `this` of a sloppy function is the receiver itself or the wrapper of a primitive receiver, and without an undefined or null receiver the program has no global object
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {L0#[[receiver]]}
# CHECK-NEXT: Variable(g1) = {String@f2:v1@[[instance]]}
# RUN(GLOBAL): flow-solve nodes objects
# GLOBAL-NOT: GlobalThis

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
variable g0 name="thisOfMethod" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="thisOfString" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = PropGet v2 key="method"
    v4 = Call v3, v2 calleeKey="method"
    v5 = NewClosure function=f2
    v6 = String string="text"
    v7 = Call v5, v6
    Return
}
function f1 name="method" flags=[IsSloppy, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    PutModuleVariable v1 variable=g0
    Return
}
function f2 name="calledOnString" flags=[IsSloppy, HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    PutModuleVariable v1 variable=g1
    Return
}
