# Each element of an array literal has a position of its own, and a literal that is appended to has none
# RUN: flow-solve nodes
# RUN(POSITIONS): flow-solve nodes
# RUN(APPENDED): flow-solve nodes
# CHECK: , f0, v1) = {L0#[[first]]}
# CHECK: , f0, v3) = {L1#[[second]]}
# CHECK: , f0, v7) = {L0#[[first]]}
# CHECK-NEXT: , f0, v8) = {L1#[[second]]}
# CHECK: , f0, v11) = {undefined|L0#[[first]]|L1#[[second]]}
# CHECK-NEXT: , f0, v12) = {undefined|L0#[[first]]|L1#[[second]]}
# POSITIONS: Position(Array@f0:v5, 0) = {L0#[[first]]}
# POSITIONS-NEXT: Position(Array@f0:v5, 1) = {L1#[[second]]}
# APPENDED-NOT: Position(Array@f0:v9

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewArray v2, v4 contents=anything @10
    v6 = Integer integer=1
    v7 = ElemGet v5, v0
    v8 = ElemGet v5, v6
    v9 = NewArray v2, v4 contents=anything @20
    AppendElement v9, v2
    v11 = ElemGet v9, v0
    v12 = ElemGet v9, v6
    Return
}
