# An asynchronous loop over an async generator holds what the generator yields and never the unknown object
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|L0#[[yielded]]}
# CHECK: , f1, v1) = {AsyncGenerator@f2:result@[[run]]}
# CHECK-NEXT: , f1, v2) = {AsyncGenerator@f2:result@[[run]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Yielded" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="ofAsyncGenerator" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return
}
function f1 name="run" flags=[IsAsync] results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0
    v2 = IteratorOpen v1 iteratorKind=Async
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2 iteratorKind=Async
    v5 = ResultAt v4
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v6 = ResultAt v4 index=1
    PutModuleVariable v6 variable=g0
    Jump -> next b1()
  b3():
    Return
}
function f2 name="asyncGenerator" flags=[IsAsync, IsGenerator, TakesCallee] results=[{type=anything}] {
  b0(v0: function):
    InitialYield
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Await v3
    v5 = Yield v4
    Return
}
