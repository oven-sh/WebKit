# A key that is some string is not the symbol under which a class of the host has the method that prints it.
# Under a symbol that the program computes: flow/calls/startup-module-is-not-read-where-seen-code-reads-a-host-object-under-a-computed-key.ir
# RUN: flow-links calls modules
# CHECK-NOT: -> {{*}} f1
# CHECK-NOT: -> {{*}} f2
# CHECK: evaluated m0
# CHECK-NOT: m1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal/util/inspect" displayPath="internal/util/inspect" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=InternalUtilInspect body=f1
entry module=m0
layout L0 name="Exports" fields=[{key="inspect" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="notListedAnywhere" [isFreeName]
    v2 = Builtin builtin=String
    v3 = Call v2, -, v1
    v4 = ElemGet v1, v3
    Return
}
function f1 name="inspectModule" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="inspect" module=m1 role=Library parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
