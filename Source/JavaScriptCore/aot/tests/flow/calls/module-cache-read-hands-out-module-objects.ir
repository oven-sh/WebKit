# require.cache hands out the module object of every evaluated module, so a program that reads it lets them reach native code: what it stores through an entry arrives in the exports of the module.
# It loads nothing by name, and a require with a constant name keeps its answer
# RUN: flow-solve sinks
# CHECK: nativeCode {{*}}ModuleObject
# RUN(UNSEEN): flow-links unseen
# UNSEEN-NOT: unseen
# UNSEEN: unknown-javascript no

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="/app/other.cjs" displayPath="other.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = RequireModule module=m1 referrer=m0 specifier="./other.cjs"
    v7 = PropGet v2 key="cache"
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="k" [isFreeName]
    v10 = ElemGet v7, v9
    Return
}
function f1 name="other" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
