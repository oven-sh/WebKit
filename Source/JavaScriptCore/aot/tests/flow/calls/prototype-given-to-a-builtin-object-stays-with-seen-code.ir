# Object.setPrototypeOf(Object.getPrototypeOf(process), parent): the inheritor is a built-in object of the realm, which flow tracks. No unseen code can run, so nobody but seen code
# finds `parent` above it: `parent` and its method reach no sink, and nobody enters the method.
# With evaluated text: flow/calls/prototype-given-to-a-builtin-object-is-open-to-evaluated-text.ir. With an inheritor that nobody knows: flow/calls/prototype-given-to-an-unknown-object-reaches-native-code.ir
# RUN: flow-links calls
# RUN(SINKS): flow-solve sinks
# CHECK-NOT: -> {{*}} f1
# SINKS-LABEL: nativeCode {
# SINKS-NOT: L0#
# SINKS-NOT: f1
# SINKS-LABEL: unknownJavaScript {
# SINKS-NOT: L0#
# SINKS-NOT: f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="listen" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=Process
    v3 = Builtin builtin=ObjectGetPrototypeOf
    v4 = Call v3, -, v2
    v5 = Builtin builtin=ObjectSetPrototypeOf
    v6 = Call v5, -, v4, v1
    Return
}
function f1 name="listen" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
