# A worker started with a path the build does not know starts an entry point of the build, which is a root already, or the run time refuses the path: no event, no warning, and no other module is evaluated for it
# RUN: flow-links modules unseen uses
# CHECK: evaluated m0 m1
# CHECK-NOT: m2
# CHECK: namespaces
# CHECK-NOT: unseen
# CHECK: unknown-javascript no
# CHECK: use Worker [{{*}}Constructed{{*}}] f0:v2

module m0 path="/app/main.js" displayPath="main.js" body=f0
module m1 path="/app/worker.js" displayPath="worker.js" body=f1
module m2 path="/app/other.js" displayPath="other.js" body=f2
entry module=m0
entry module=m1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Worker
    v1 = String string="/app/worker.js"
    v2 = Construct v0, -, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="path" [isFreeName]
    v5 = Construct v0, -, v4
    Return
}
function f1 name="worker" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="other" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
