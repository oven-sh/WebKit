# The holder escapes after the lookup by name has run: the lookup runs again, and still finds no member whose call starts unseen code
# RUN: flow-links unseen
# CHECK-NOT: unseen
# CHECK: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = PropGet v0 key="input" [isFreeName]
    v3 = PropGet v2 key="dlopen"
    v4 = Call v3, v2, v2 calleeKey="dlopen"
    v5 = CallDirect function=f1
    v6 = Call v1, -, v5
    Return
}
function f1 name="late" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    Return v0
}
