# A loop over a string gives the loop variable strings, and a loop over a number, which throws, gives nothing
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|string}
# CHECK-NOT: Variable(g1)
# CHECK: , f0, v1) = {StringIterator@f0:v1
# CHECK-NOT: , f0, v8)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="character" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="ofNumber" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    Branch v4 -> taken b3(), notTaken b2()
  b2():
    v5 = ResultAt v3 index=1
    PutModuleVariable v5 variable=g0
    Jump -> next b1()
  b3():
    v7 = Integer integer=7
    v8 = IteratorOpen v7
    Jump -> next b4()
  b4():
    LoopHint
    v10 = IteratorResume v8
    v11 = ResultAt v10
    Branch v11 -> taken b6(), notTaken b5()
  b5():
    v12 = ResultAt v10 index=1
    PutModuleVariable v12 variable=g1
    Jump -> next b4()
  b6():
    Return
}
