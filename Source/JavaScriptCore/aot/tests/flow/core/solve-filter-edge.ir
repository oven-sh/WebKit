# A cast is an edge with a filter: what reaches its source after the cast was first looked at still passes, and only the part inside the type
# RUN: flow-solve nodes
# CHECK: Local({{*}}f1, v0) = {undefined|1|L0#[[record]]|Array@f0:v3}
# CHECK-NEXT: Local({{*}}f1, v1) = {undefined|Array@f0:v3}
# CHECK-NEXT: Local({{*}}f1, v2) = {undefined|Array@f0:v3}
# CHECK-NEXT: Local({{*}}f1, v3) = {undefined|L0#[[record]]|Array@f0:v3}
# CHECK-NEXT: Local({{*}}f1, v4) = {1}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=0 kind=Assertion
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="source" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewArray v1 contents=anything
    v4 = CallDirect v1 function=f2
    v5 = CallDirect v2 function=f2
    v6 = CallDirect v3 function=f2
    Return
}
function f1 name="read" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Claim v0 castType=undefined|Array site=w0
    v2 = Upcast v1 castType=undefined|Array
    v3 = Claim v0 castType=undefined|object site=w0
    v4 = Claim v0 castType=number site=w0
    Return
}
function f2 name="write" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    Return
}
