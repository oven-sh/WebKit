    v3 = Integer integer=0
    v4 = BitOr v2, v3
    v5 = CallDirect v4 function=f1
    v6 = CallDirect v2 function=f3
    v7 = Integer integer=100
    v8 = NewObject -, v7 layout=L0 fields=[0]
    v9 = CallDirect v8 function=f5
    v10 = CallDirect v4 function=f7
    Return
}
