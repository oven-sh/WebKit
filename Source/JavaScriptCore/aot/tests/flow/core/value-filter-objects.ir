# The edges of a type test on objects: the taken edge has what may be inside, the other edge loses only what is always inside
# RUN: flow-solve nodes
# CHECK: Local({{*}}f2, v0) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|Array@f0:v7|f1|namespace m1}
# CHECK: Local({{*}}f2, v2) = {unknown|L1#[[failure]]|Array@f0:v7}
# CHECK-NEXT: Local({{*}}f2, v3) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|f1|namespace m1}
# RUN(CALLABLE): flow-solve nodes
# CALLABLE: Local({{*}}f3, v2) = {unknown|f1}
# CALLABLE-NEXT: Local({{*}}f3, v3) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|Array@f0:v7|namespace m1}
# RUN(OBJECT): flow-solve nodes
# OBJECT: Local({{*}}f4, v2) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|Array@f0:v7|f1|namespace m1}
# OBJECT-NOT: f4, v3)
# RUN(ERROR): flow-solve nodes
# ERROR: Local({{*}}f5, v2) = {unknown|L1#[[failure]]}
# ERROR-NEXT: Local({{*}}f5, v3) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|Array@f0:v7|f1|namespace m1}
# RUN(NAMESPACE): flow-solve nodes
# NAMESPACE: Local({{*}}f6, v3) = {unknown|namespace m1}
# NAMESPACE-NEXT: Local({{*}}f6, v4) = {unknown|L0#[[record]]|L1#[[failure]]|L2#[[plain]]|Array@f0:v7|f1|namespace m1}
# RUN(OPAQUE): flow-solve nodes
# OPAQUE: Local({{*}}f7, v2) = {opaque(Error)@{{*}}}
# OPAQUE: Local({{*}}f7, v4) = {opaque(Error)@{{*}}}
# OPAQUE-NEXT: Local({{*}}f7, v5) = {opaque(Error)@{{*}}}
# OPAQUE-NOT: f7, v7)
# OPAQUE: Local({{*}}f7, v8) = {opaque(Error)@{{*}}}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="library.js" displayPath="library.js" body=f8 exports=[{name="a" variable=g1}]
entry module=m0
typesite w0 module=m0 position=0 kind=Assertion
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Failure" flags=[HasHeritage]
layout L2 kind=Instance name="Plain"
variable g0 name="mixed" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="a" module=m1 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject layout=L1
    PutModuleVariable v3 variable=g0
    v5 = NewObject layout=L2
    PutModuleVariable v5 variable=g0
    v7 = NewArray v0 contents=anything
    PutModuleVariable v7 variable=g0
    v9 = NewClosure function=f1
    PutModuleVariable v9 variable=g0
    v11 = ModuleNamespace module=m1
    PutModuleVariable v11 variable=g0
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Claim v14 castType=object site=w0
    PutModuleVariable v15 variable=g0
    v17 = CallDirect function=f2
    v18 = CallDirect function=f3
    v19 = CallDirect function=f4
    v20 = CallDirect function=f5
    v21 = CallDirect function=f6
    v22 = CallDirect v0 function=f7
    Return
}
function f1 name="closure" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="array" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = TypeTest v0 testedType=Array
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return v3
}
function f3 name="callable" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = TypeTest v0 testedType=function
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return v3
}
function f4 name="anyObject" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = TypeTest v0 testedType=object
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return v3
}
function f5 name="error" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = TypeTest v0 testedType=Error
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return v3
}
function f6 name="namespace" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ModuleNamespace module=m1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return v3
  b2(v4):
    Return v4
}
function f7 name="caught" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b2():
    v1 = Negate v0
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    v3 = TypeTest v2 testedType=Error
    Branch v3 -> taken b3(| 0), notTaken b4(| 0)
  b3(v4):
    Return v4
  b4(v5):
    v6 = TypeTest v5 testedType=Map
    Branch v6 -> taken b5(| 0), notTaken b6(| 0)
  b5(v7):
    Return v7
  b6(v8):
    Return v8
}
function f8 name="library" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
