# Members of several chunks go out of line in ascending order, and a set that shrinks to one chunk is one word again
# RUN: flow-object-set a+3 a+40 a a+100000 a+2147483647 a a?40 a?41 a?2147483647 a-40 a-100000 a a-2147483647 a
# CHECK: a+40: added
# CHECK-NEXT: a: {o3, o40} size=2 out-of-line
# CHECK-NEXT: a+100000: added
# CHECK-NEXT: a+2147483647: added
# CHECK-NEXT: a: {o3, o40, o100000, o2147483647} size=4 out-of-line
# CHECK-NEXT: a?40: yes
# CHECK-NEXT: a?41: no
# CHECK-NEXT: a?2147483647: yes
# CHECK-NEXT: a-40: removed
# CHECK-NEXT: a-100000: removed
# CHECK-NEXT: a: {o3, o2147483647} size=2 out-of-line
# CHECK-NEXT: a-2147483647: removed
# CHECK-NEXT: a: {o3} size=1 only=o3 inline
# RUN(DESCENDING): flow-object-set a+2147483647 a a+100000 a+40 a+3 a a-3 a-40 a-100000 a
# DESCENDING: a: {o2147483647} size=1 only=o2147483647 inline
# DESCENDING: a+3: added
# DESCENDING-NEXT: a: {o3, o40, o100000, o2147483647} size=4 out-of-line
# DESCENDING: a-100000: removed
# DESCENDING-NEXT: a: {o2147483647} size=1 only=o2147483647 inline
# RUN(RANGE): flow-object-set a+2147483648
# RANGE: error: bad argument
