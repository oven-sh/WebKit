# What is found through the unknown object names the operation that let that object in, and of two such operations a node names the nearer one
# RUN: flow-solve nodes witnesses
# CHECK: [[far]] Variable(g0) = {{*}}unknown}
# CHECK-NEXT: [[near]] Variable(g1) = {{*}}unknown}
# CHECK-NEXT: [[both]] Variable(g2) = {{*}}unknown}
# CHECK: [[first]] Local({{*}}f0, v1) = {{*}}unknown}
# CHECK-NEXT: [[result]] Local({{*}}f0, v2) = {{*}}unknown}
# CHECK-NEXT: [[member]] Local({{*}}f0, v3) = {{*}}unknown}
# CHECK-NEXT: [[inner]] Local({{*}}f0, v4) = {{*}}unknown}
# CHECK: [[second]] Local({{*}}f0, v6) = {{*}}unknown}
# CHECK: [[far]] unknown f0:v1
# CHECK-NEXT: [[near]] unknown f0:v6
# CHECK-NEXT: [[both]] unknown f0:v6
# CHECK: [[first]] unknown f0:v1
# CHECK-NEXT: [[result]] unknown f0:v1
# CHECK-NEXT: [[member]] unknown f0:v1
# CHECK-NEXT: [[inner]] unknown f0:v1
# CHECK: [[second]] unknown f0:v6

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="far" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="near" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="both" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1
    v3 = PropGet v2 key="member"
    v4 = PropGet v3 key="inner"
    PutModuleVariable v4 variable=g0
    v6 = PropGet v0 key="other" [isFreeName]
    PutModuleVariable v6 variable=g1
    PutModuleVariable v4 variable=g2
    PutModuleVariable v6 variable=g2
    Return
}
