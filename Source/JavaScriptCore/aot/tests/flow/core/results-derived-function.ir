# A function that is younger than the analysis answers through the function it was derived from, parameter by parameter
# RUN: flow-query function f1 parameter f1 0 parameter f1 1 parameter f1 2 derive f1 map=[1,-,0] function f4 parameter f4 0 parameter f4 1 parameter f4 2 parameter f4 3 derive f4 map=[2,0,1] function f5 parameter f5 0 parameter f5 1 parameter f5 2
# CHECK: function f1: {callers=AllKnown executions=AtMostOnce}
# CHECK-NEXT: parameter f1 0: uses=[Returns] retainedIn=
# CHECK-NEXT: parameter f1 1: uses=[Retains] retainedIn=UnknownMemory
# CHECK-NEXT: parameter f1 2: uses=all retainedIn=UnknownMemory
# CHECK-NEXT: derive f1 map=[1,-,0]: f4
# CHECK-NEXT: function f4: {callers=AllKnown executions=AtMostOnce}
# CHECK-NEXT: parameter f4 0: uses=[Retains] retainedIn=UnknownMemory
# CHECK-NEXT: parameter f4 1: uses=all retainedIn=UnknownMemory
# CHECK-NEXT: parameter f4 2: uses=[Returns] retainedIn=
# CHECK-NEXT: parameter f4 3: uses=all retainedIn=UnknownMemory
# CHECK-NEXT: derive f4 map=[2,0,1]: f5
# CHECK-NEXT: function f5: {callers=AllKnown executions=AtMostOnce}
# CHECK-NEXT: parameter f5 0: uses=[Returns] retainedIn=
# CHECK-NEXT: parameter f5 1: uses=[Retains] retainedIn=UnknownMemory
# CHECK-NEXT: parameter f5 2: uses=all retainedIn=UnknownMemory
# RUN(RETAINER): flow-query parameter f2 1 derive f2 map=[1,0] parameter f4 0 derive f2 map=[1] parameter f5 0 derive f4 map=[1,0] parameter f6 1
# RETAINER: parameter f2 1: uses=[Retains] retainedIn=Operand retainingOperand=0
# RETAINER-NEXT: derive f2 map=[1,0]: f4
# RETAINER-NEXT: parameter f4 0: uses=[Retains] retainedIn=Operand retainingOperand=1
# RETAINER-NEXT: derive f2 map=[1]: f5
# RETAINER-NEXT: parameter f5 0: uses=[Retains] retainedIn=UnknownMemory
# RETAINER-NEXT: derive f4 map=[1,0]: f6
# RETAINER-NEXT: parameter f6 1: uses=[Retains] retainedIn=Operand retainingOperand=0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = CallDirect v1, v2 function=f1
    v4 = CallDirect v1, v2 function=f2
    Return
}
function f1 name="source" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PutModuleVariable v1 variable=g0
    Return v0
}
function f2 name="stores" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x"
    Return
}
