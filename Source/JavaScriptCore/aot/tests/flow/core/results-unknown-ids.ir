# Every accessor of the flow results answers unknown for a null id and for an id past its table
# RUN: flow-query unknown-ids function f1
# CHECK-NOT: =known
# CHECK: unknown-ids: function=unknown mayBeReached=unknown runsAtMostOnce=unknown parameterSummary=unknown indirectCallsFrom=unknown storedValueUses=unknown typedResultSite=unknown module=unknown builtinLocation=unknown findBuiltinLocation=unknown usesOf=unknown accessSite=unknown lossOf=unknown seesOnlyFinishedObjects=unknown resultSiteOf=unknown sinkCandidates=unknown typedResultType=unknown allocationSite=unknown classOf=unknown dataNodeStamp=unknown allocationClass=unknown
# CHECK-NOT: =known
# CHECK: function f1: {callers=AllKnown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="read" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
