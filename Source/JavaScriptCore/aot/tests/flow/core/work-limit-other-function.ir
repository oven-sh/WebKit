function f2 name="small" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = PropGet v1 key="y"
    v3 = PropGet v1 key="missing"
    v4 = PropGet v1 key="hasOwnProperty"
    Return v2
}
