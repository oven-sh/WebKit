# One function gives up at the work limit; the host, which allocates every hoisted function, and the other functions keep their results
# OPTIONS: limit=MaxFlowWorkPerFunction:60
# RUN: flow-solve work instances objects nodes
# LOSS: MaxFlowWorkPerFunction f1
# CHECK: past-work-limit f1
# CHECK-NOT: past-work-limit
# CHECK: host Proven Initialized
# CHECK-NOT: PastWorkLimit
# CHECK: f0 Proven Initialized
# CHECK-NOT: PastWorkLimit
# CHECK: f1 Proven PastWorkLimit
# CHECK-NOT: PastWorkLimit
# CHECK: f2 Proven Initialized
# CHECK-NOT: PastWorkLimit
# CHECK: L0#[[argument]] mutations=[ReachNativeCode, ReachUnknownJavaScript, 
# CHECK-NEXT: L1#[[neighbor]] mutations=[] uses=
# CHECK-NEXT: f4 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f5 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f6 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f7 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f8 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f9 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f10 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f11 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f12 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f13 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f14 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f15 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f16 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f17 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f18 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f19 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f20 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f21 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f22 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f23 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f24 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f25 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f26 mutations=[] uses=[] events=[Allocated]
# CHECK-NEXT: f27 mutations=[] uses=[] events=[Allocated]
# CHECK: Variable(g0) = {f4}
# CHECK: Variable(g23) = {f27}
# CHECK: DeclaredPart(L1#[[neighbor]], 0) = {2}
# CHECK: Local({{*}}f0, v1) = {L0#[[argument]]}
# CHECK-NEXT: Local({{*}}f0, v2) = {number}
# CHECK-NEXT: Local({{*}}f0, v3) = {2}
# CHECK: Local({{*}}f2, result 0) = {2}
# CHECK: Local({{*}}f2, v1) = {L1#[[neighbor]]}
# CHECK-NEXT: Local({{*}}f2, v2) = {2}
# CHECK-NEXT: Local({{*}}f2, v3) = {undefined}
# CHECK-NEXT: Local({{*}}f2, v4) = {ObjectPrototypeHasOwnProperty}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="helpers.js" displayPath="helpers.js" body=f3
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Neighbor" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="helper1" module=m1 declared={type=anything} initialization=Function function=f4
variable g1 name="helper2" module=m1 declared={type=anything} initialization=Function function=f5
variable g2 name="helper3" module=m1 declared={type=anything} initialization=Function function=f6
