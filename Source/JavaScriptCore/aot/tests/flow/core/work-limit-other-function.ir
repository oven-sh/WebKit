variable g21 name="helper22" module=m1 declared={type=anything} initialization=Function function=f25
variable g22 name="helper23" module=m1 declared={type=anything} initialization=Function function=f26
variable g23 name="helper24" module=m1 declared={type=anything} initialization=Function function=f27
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect function=f2
    Return
}
