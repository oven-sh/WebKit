# A join is a plain union: ranges unite in either order, literal lists unite, the wide string takes its literals in, absent is kept
# RUN: flow-value join p0 p1 join p1 p0 join p0 p0
# CHECK: join p0 p1: {int[0, 12]}
# CHECK-NEXT: join p1 p0: {int[0, 12]}
# CHECK-NEXT: join p0 p0: {int[0, 3]}
# RUN(LITERALS): flow-value join p2 p3 join p3 p2 join p2 p4 join p4 p2 join p0 p2
# LITERALS: join p2 p3: {"a"|"b"|"c"}
# LITERALS-NEXT: join p3 p2: {"a"|"b"|"c"}
# LITERALS-NEXT: join p2 p4: {string}
# LITERALS-NEXT: join p4 p2: {string}
# LITERALS-NEXT: join p0 p2: {int[0, 3]|"a"|"b"}
# RUN(ABSENT): flow-value join p5 p6 join p6 p5 join p6 p0 join p5 p0
# ABSENT: join p5 p6: {undefined|number|absent}
# ABSENT-NEXT: join p6 p5: {undefined|number|absent}
# ABSENT-NEXT: join p6 p0: {i32|absent}
# ABSENT-NEXT: join p5 p0: {undefined|number}
# RUN(STEPS): flow-value join p7 p8 p9 p10 p11 join p11 p10 p9 p8 p7 join p9 p7 p11 p8 p10
# STEPS: join p7 p8 p9 p10 p11: {int[100, 500]}
# STEPS-NEXT: join p11 p10 p9 p8 p7: {int[100, 500]}
# STEPS-NEXT: join p9 p7 p11 p8 p10: {int[100, 500]}
# RUN(SUBSET): flow-value subset p0 p5 subset p5 p0 subset p0 p1 subset p3 p4 subset p4 p3 subset p3 p2 subset p0 p6 subset p6 p5
# SUBSET: subset p0 p5: yes
# SUBSET-NEXT: subset p5 p0: no
# SUBSET-NEXT: subset p0 p1: no
# SUBSET-NEXT: subset p3 p4: yes
# SUBSET-NEXT: subset p4 p3: no
# SUBSET-NEXT: subset p3 p2: no
# SUBSET-NEXT: subset p0 p6: yes
# SUBSET-NEXT: subset p6 p5: no

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="values" parameters=[{type=int[0, 3]}, {type=int[10, 12]}, {type="a"|"b"}, {type="c"}, {type=string}, {type=undefined|number}, {type=absent|i32}, {type=int[100, 100]}, {type=int[200, 200]}, {type=int[300, 300]}, {type=int[400, 400]}, {type=int[500, 500]}] results=[{type=undefined}] {
  b0(v0: int[0, 3], v1: int[10, 12], v2: "a"|"b", v3: "c", v4: string, v5: undefined|number, v6: absent|i32, v7: int[100, 100], v8: int[200, 200], v9: int[300, 300], v10: int[400, 400], v11: int[500, 500]):
    Return
}
