# A call of a built-in that is given up with its function leaves a link that names the built-in and no overload, and an unknown callee at the same operation
# OPTIONS: limit=MaxFlowWorkPerFunction:300
# LOSS: MaxFlowWorkPerFunction f1
# LOSS: MaxFlowInstanceValues f1
# RUN: flow-links builtins unknown statements
# CHECK: builtin [[instance]] v3 - Call
# CHECK: unknown-callee [[instance]] v3 Call
# CHECK: statement [[instance]] v3 ObjectSetPrototypeOf Call Call Once abandoned
# RUN(STAMP): flow-apply
# STAMP: = Call v1, -, v0, v2 {{*}}callees=[builtin(ObjectSetPrototypeOf), ..]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="large" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=ObjectSetPrototypeOf
    v2 = Null
    v3 = Call v1, -, v0, v2
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
