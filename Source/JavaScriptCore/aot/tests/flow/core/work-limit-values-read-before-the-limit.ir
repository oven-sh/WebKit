# A statement of a function past the work limit no longer runs, and an object that arrives later in a node that it reads goes to unknown JavaScript. Whether an object is early or late depends on the order
# of the worklist, so what the node holds when the function gives up goes there too: here the list of arguments that a bound function made in "busy" keeps, which the call of that bound function reads.
# The call reads the list with a wait on the node and no cursor. In the order of this seed the list was early and stayed out of the sink, and running the rules again over the finished solve sent it there.
# The reads that use up the work read the result of a call, which is linked once nothing is queued, so "busy" gives up after its bound function is made. The list of the same call in "idle" reaches no sink.
# OPTIONS: limit=MaxFlowWorkPerFunction:450 check=FlowFixpoint flow-order-seed=2
# LOSS: MaxFlowWorkPerFunction f1
# LOSS: MaxFlowInstanceValues f1
# RUN: flow-solve sinks
# CHECK-LABEL: unknownJavaScript {
# CHECK: Array@f1:
# RUN(IDLE): flow-solve sinks
# IDLE-NOT: Array@f2:

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="BusyReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="method" declared={type=anything} flags=[IsRequired]}]
layout L1 name="IdleReceiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="method" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="BusyMade" constructor=f5 flags=[IsConstructorFunction]
layout L3 kind=Instance name="IdleMade" constructor=f9 flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewClosure function=f4
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = NewClosure function=f6
    DefineGetter v2, v3 key="got"
    v5 = FinishObject v2
    v6 = CallDirect v5 function=f1
    v7 = NewClosure function=f8
    v8 = NewObject -, v0, v7 layout=L1 fields=[0, 1]
    v9 = NewClosure function=f10
    DefineGetter v8, v9 key="got"
    v11 = FinishObject v8
    v12 = CallDirect v11 function=f2
    Return
}
