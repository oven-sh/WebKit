# Filters on primitives: the part inside a type is exact, the part outside keeps what cannot be split
# RUN: flow-value filter p0 p1 filter-out p0 p1 filter p2 p1 filter-out p2 p1 filter p1 p0 filter-out p1 p0
# CHECK: filter p0 p1: {"a"|"b"}
# CHECK-NEXT: filter-out p0 p1: {string}
# CHECK-NEXT: filter p2 p1: {"a"}
# CHECK-NEXT: filter-out p2 p1: {"c"}
# CHECK-NEXT: filter p1 p0: {"a"|"b"}
# CHECK-NEXT: filter-out p1 p0: {}
# RUN(RANGES): flow-value filter p3 p4 filter-out p3 p4 filter-out p4 p3 filter p3 p5 filter p4 p5 filter-out p4 p5 filter p6 p4 filter-out p6 p4 filter-out p3 p6
# RANGES: filter p3 p4: {int[0, 4]}
# RANGES-NEXT: filter-out p3 p4: {int[0, 9]}
# RANGES-NEXT: filter-out p4 p3: {}
# RANGES-NEXT: filter p3 p5: {int[5, 9]}
# RANGES-NEXT: filter p4 p5: {}
# RANGES-NEXT: filter-out p4 p5: {int[0, 4]}
# RANGES-NEXT: filter p6 p4: {int[0, 4]}
# RANGES-NEXT: filter-out p6 p4: {number}
# RANGES-NEXT: filter-out p3 p6: {}
# RUN(NULLISH): flow-value filter p7 p8 filter-out p7 p8 filter p7 p9 filter-out p7 p9 filter-out p9 p8 filter p8 p6
# NULLISH: filter p7 p8: {undefined|null}
# NULLISH-NEXT: filter-out p7 p8: {number|string}
# NULLISH-NEXT: filter p7 p9: {undefined|null|number|string}
# NULLISH-NEXT: filter-out p7 p9: {}
# NULLISH-NEXT: filter-out p9 p8: {boolean|number|string|symbol|bigint|unknown}
# NULLISH-NEXT: filter p8 p6: {}
# RUN(SYMBOLS): flow-value filter p10 p11 filter-out p10 p11 filter p11 p10 filter-out p11 p10 filter p11 p0
# SYMBOLS: filter p10 p11: {@@iterator}
# SYMBOLS-NEXT: filter-out p10 p11: {symbol}
# SYMBOLS-NEXT: filter p11 p10: {@@iterator}
# SYMBOLS-NEXT: filter-out p11 p10: {}
# SYMBOLS-NEXT: filter p11 p0: {}
# RUN(ABSENT): flow-value filter p12 p9 filter p12 p12 filter-out p12 p6 filter-out p12 p12
# ABSENT: filter p12 p9: {number}
# ABSENT-NEXT: filter p12 p12: {number|absent}
# ABSENT-NEXT: filter-out p12 p6: {absent}
# ABSENT-NEXT: filter-out p12 p12: {}

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="values" parameters=[{type=string}, {type="a"|"b"}, {type="a"|"c"}, {type=int[0, 9]}, {type=int[0, 4]}, {type=int[5, 20]}, {type=number}, {type=undefined|null|number|string}, {type=undefined|null}, {type=anything}, {type=symbol}, {type=@@iterator}, {type=number|absent}] results=[{type=undefined}] {
  b0(v0: string, v1: "a"|"b", v2: "a"|"c", v3: int[0, 9], v4: int[0, 4], v5: int[5, 20], v6: number, v7: undefined|null|number|string, v8: undefined|null, v9: anything, v10: symbol, v11: @@iterator, v12: number|absent):
    Return
}
