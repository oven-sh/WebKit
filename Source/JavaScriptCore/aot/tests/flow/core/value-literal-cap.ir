# A list of string literals past the limit becomes string; the symbols and the range of the same value stay
# OPTIONS: limit=MaxLiteralsInType:2
# RUN: flow-value join p0 p1 join p0 p1 p2 join p2 p1 p0 join p3 p4
# LOSS: MaxLiteralsInType x2 f0
# CHECK: join p0 p1: {int[0, 3]|"a"|"b"|@@iterator}
# CHECK-NEXT: join p0 p1 p2: {int[0, 3]|string|@@iterator}
# CHECK-NEXT: join p2 p1 p0: {int[0, 3]|string|@@iterator}
# CHECK-NEXT: join p3 p4: {@@asyncIterator|@@hasInstance|@@iterator}

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="values" parameters=[{type=int[0, 3]|"a"|@@iterator}, {type="b"}, {type="c"}, {type=@@iterator|@@hasInstance}, {type=@@asyncIterator}] results=[{type=undefined}] {
  b0(v0: int[0, 3]|"a"|@@iterator, v1: "b", v2: "c", v3: @@iterator|@@hasInstance, v4: @@asyncIterator):
    Return
}
