# The witness of a mutation is the lowest function and value that cause it, whichever is looked at first
# RUN: flow-solve objects witnesses
# CHECK: [[first]] L0#{{*}} mutations=[{{*}}DeleteField
# CHECK-NEXT: [[second]] L1#{{*}} mutations=[{{*}}DeleteField
# CHECK: [[first]] DeleteField f1:v2
# CHECK: [[second]] DeleteField f3:v1
# RUN(ONCE): flow-solve witnesses
# ONCE-COUNT-2: DeleteField
# ONCE-NOT: DeleteField

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="HigherFunctionFirst" fields=[{key="x" declared={type=anything}}]
layout L1 name="LowerFunctionFirst" fields=[{key="x" declared={type=anything}}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="second" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = CallDirect function=f2
    v6 = CallDirect function=f1
    v7 = CallDirect function=f3
    v8 = CallDirect function=f4
    Return
  b2() role=CatchHandler:
    v9 = CatchValue
    Return
}
function f1 name="calledSecond" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=1
    v2 = PropDelete v0 key="x"
    v3 = PropDelete v0 key="x"
    Return
}
function f2 name="calledFirst" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropDelete v0 key="x"
    Return
}
function f3 name="calledThird" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = PropDelete v0 key="x"
    Return
}
function f4 name="calledFourth" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = PropDelete v0 key="x"
    Return
}
