# let calls = 0; class A { static get f() { calls++; return 1 } static set f(v) { calls += 10 } }  class B extends A { static early = [calls, (B.f = 3), calls].join(); static f = 2 }  print(B.early)
# function define() { return class C { m() { return 1 } } }  define()
# The definition of a class and of a member is recorded once the closure of the class has reached it, and the passes take the records for the whole definition.
# The module body passes the work limit in the first run of its statements, while the closures are still on their way to the definitions. They are pushed on before the last run,
# so A lists its accessor, and the store to B.f ahead of the field's initializer finds the setter above B.
# C is defined in a function within the limit. The reads at the end of the module body are there to pass the limit.
# OPTIONS: limit=MaxFlowWorkPerFunction:64
# LOSS: MaxFlowWorkPerFunction f0
# RUN: flow-apply
# CHECK: name="A"{{*}} members=[{key="f" side=Static kind=Getter function=f2}, {key="f" side=Static kind=Setter function=f3}]
# CHECK: name="C"{{*}} members=[{key="m" function=f8}]

