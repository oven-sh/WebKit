# An object has a node per declared field from the start, and every other node only once something is stored or read there
# RUN: flow-solve nodes
# CHECK-NOT: DeclaredPart(L0#
# CHECK: DeclaredPart(L0#{{*}}, 0) = {true|1}
# CHECK-NEXT: DeclaredPart(L0#{{*}}, 1) = {true|2}
# CHECK-NEXT: DeclaredPart(L1#{{*}}, 0) = {1}
# CHECK-NOT: DeclaredPart(L0#
# CHECK-NOT: DeclaredPart(L1#
# RUN(PROPERTY): flow-solve nodes
# PROPERTY-NOT: Property(L0#
# PROPERTY: Property(L0#{{*}}, "c") = {true|3}
# PROPERTY-NOT: Property(L0#
# RUN(GETTER): flow-solve nodes
# GETTER-NOT: Getter(L0#
# GETTER: Getter(L0#{{*}}, "d") = {f1}
# GETTER-NOT: Getter(L0#
# RUN(STRINGS): flow-solve nodes
# STRINGS-NOT: StringProperties(L0#
# STRINGS: StringProperties(L0#{{*}}) = {true}
# STRINGS-NOT: StringProperties(L0#
# RUN(ABSENT): flow-solve nodes
# ABSENT-NOT: SymbolProperties(L0#
# ABSENT-NOT: PrototypeLink(L0#
# ABSENT-NOT: Setter(L0#
# ABSENT-NOT: UndeclaredPart(L0#
# ABSENT-NOT: Position(L0#
# RUN(STORED): flow-solve nodes
# STORED-NOT: Getter(L1#
# STORED-NOT: StringProperties(L1#
# STORED-NOT: IndexedProperties(L1#
# STORED: PrototypeLink(L1#{{*}}) = {ObjectPrototype}
# STORED-NOT: Getter(L1#
# STORED-NOT: StringProperties(L1#
# STORED-NOT: IndexedProperties(L1#
# RUN(NEIGHBOR): flow-solve nodes
# NEIGHBOR: Property(L1#{{*}}, "c") = {3}
# RUN(DECLARED): flow-solve nodes
# DECLARED-NOT: Property(L2#
# DECLARED: DeclaredPart(L2#{{*}}, 0) = {int[1, 3]}
# DECLARED-NEXT: DeclaredPart(L2#{{*}}, 1) = {2}
# DECLARED-NOT: Property(L2#
# DECLARED: Getter(L2#{{*}}, "b") = {f1}
# DECLARED-NOT: Property(L2#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Defined" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="DeclaredKeys" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = Integer integer=3
    PropDefine v2, v3 key="c"
    v5 = NewClosure function=f1
    DefineGetter v2, v5 key="d"
    v7 = TypeOf v0
    v8 = Boolean boolean=true
    ElemDefine v2, v7, v8
    v10 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v10, v3 key="c"
    v12 = NewObject -, v0, v1 layout=L2 fields=[0, 1]
    PropSet v12, v3 key="a"
    DefineGetter v12, v5 key="b"
    Return
}
function f1 name="d" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
