# The host is no function that could be given up as a whole, so each call that native code makes counts its own work. A call past the limit is given up alone: the loss is recorded,
# the built-in counts as unseen code, and its operands and result are unknown. The calls of the other built-ins go on, and so does the program's own function.
# OPTIONS: limit=MaxFlowWorkPerFunction:40 admit=RuntimeCode
# LOSS: MaxFlowWorkPerFunction
# RUN: flow-links statements
# RUN(CHEAP): flow-links statements
# RUN(KEPT): flow-links statements
# RUN(UNSEEN): flow-links unseen

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Return
}
# CHECK: statement i0 - JSONStringify Call Host Repeatedly abandoned
# CHEAP: statement i0 - MathAbs Call Host Repeatedly
# KEPT-NOT: MathAbs Call Host Repeatedly abandoned
# UNSEEN: unseen LimitReached JSONStringify
# UNSEEN-NOT: unseen LimitReached MathAbs
