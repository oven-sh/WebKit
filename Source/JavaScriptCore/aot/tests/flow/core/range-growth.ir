# An arithmetic result that grows more often than the limit jumps to the next landmark; a field fed by constants never does
# OPTIONS: limit=MaxFlowRangeGrowth:4
# RUN: flow-solve nodes
# LOSS: MaxFlowRangeGrowth x2 f0 v10
# CHECK: DeclaredPart(L0#{{*}}, 0) = {int[0, 6]}
# CHECK: Local({{*}}f0, v6) = {int[0, 2147483647]}
# CHECK: Local({{*}}f0, v9) = {int[0, 2147483646]}
# CHECK-NEXT: Local({{*}}f0, v10) = {int[1, 2147483647]}
# RUN(DOWN): flow-solve nodes
# DOWN: Local({{*}}f1, v3) = {int[-2147483648, 100]}
# DOWN: Local({{*}}f1, v6) = {int[-2147483647, 100]}
# DOWN-NEXT: Local({{*}}f1, v7) = {int[-2147483648, 99]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Level" fields=[{key="level" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Integer integer=0
    v4 = BitOr v2, v3
    v5 = Integer integer=1
    Jump -> next b1(v3)
  b1(v6):
    LoopHint
    v8 = Less v6, v4
    Branch v8 -> taken b2(| 0), notTaken b3()
  b2(v9):
    v10 = Add v9, v5
    Jump -> next b1(v10)
  b3():
    v11 = NewObject -, v3 layout=L0 fields=[0]
    PropSet v11, v5 key="level"
    v13 = Integer integer=2
    PropSet v11, v13 key="level"
    v15 = Integer integer=3
    PropSet v11, v15 key="level"
    v17 = Integer integer=4
    PropSet v11, v17 key="level"
    v19 = Integer integer=5
    PropSet v11, v19 key="level"
    v21 = Integer integer=6
    PropSet v11, v21 key="level"
    v23 = CallDirect v4 function=f1
    Return
}
function f1 name="down" parameters=[{type=i32}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = Integer integer=100
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Greater v3, v0
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Sub v6, v2
    Jump -> next b1(v7)
  b3():
    Return
}
