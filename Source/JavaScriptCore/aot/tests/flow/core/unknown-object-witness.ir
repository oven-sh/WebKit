# The unknown object in a node names the operation that let it in, also behind a variable, in another function and behind both edges of a test
# RUN: flow-solve nodes witnesses
# CHECK: [[variable]] Variable(g0) = {{*}}unknown}
# CHECK-NEXT: [[tracked]] Variable(g1) = {L0#
# CHECK: [[callee]] Local({{*}}f0, v1) = {{*}}unknown}
# CHECK-NEXT: [[call]] Local({{*}}f0, v2) = {{*}}unknown}
# CHECK-NEXT: [[later]] Local({{*}}f0, v4) = {{*}}unknown}
# CHECK: [[returned]] Local({{*}}f0, v9) = {{*}}unknown}
# CHECK: [[read]] Local({{*}}f1, v0) = {{*}}unknown}
# CHECK-NEXT: [[other]] Local({{*}}f1, v1) = {L0#
# CHECK: [[inside]] Local({{*}}f1, v3) = {unknown}
# CHECK-NEXT: [[outside]] Local({{*}}f1, v4) = {{*}}unknown}
# CHECK: [[variable]] unknown f0:v1
# CHECK-NOT: [[tracked]] unknown
# CHECK: [[callee]] unknown f0:v1
# CHECK-NEXT: [[call]] unknown f0:v1
# CHECK-NEXT: [[later]] unknown f0:v1
# CHECK-NEXT: [[returned]] unknown f0:v1
# CHECK: [[read]] unknown f0:v1
# CHECK-NOT: [[other]] unknown
# CHECK: [[inside]] unknown f0:v1
# CHECK-NEXT: [[outside]] unknown f0:v1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Tracked" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="fromUnknownCallee" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="tracked" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1
    PutModuleVariable v2 variable=g0
    v4 = Call v1
    PutModuleVariable v4 variable=g0
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L0 fields=[0]
    PutModuleVariable v7 variable=g1
    v9 = CallDirect function=f1
    Return
}
function f1 name="read" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = TypeTest v0 testedType=Array
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return v0
  b2(v4):
    Return v0
}
