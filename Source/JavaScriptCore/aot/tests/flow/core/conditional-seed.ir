# The this value of a sloppy function is the global object only where undefined or null can arrive, and a wrapper only where its primitive can
# RUN: flow-solve nodes
# CHECK: Local({{*}}f1, parameter 0) = {L0#[[receiver]]}
# CHECK: Local({{*}}f1, v1) = {L0#[[receiver]]}
# RUN(SEEDED): flow-solve nodes
# SEEDED: Local({{*}}f2, parameter 0) = {undefined|L0#[[receiver]]}
# SEEDED: Local({{*}}f2, v1) = {L0#[[receiver]]|GlobalThis}
# RUN(WRAPPER): flow-solve nodes
# WRAPPER: Local({{*}}f3, parameter 0) = {1}
# WRAPPER-NEXT: Local({{*}}f3, result 0) = {Number@f3:
# WRAPPER-NOT: GlobalThis
# WRAPPER-NOT: L0#
# WRAPPER: Local({{*}}f3, v1) = {Number@f3:

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = Undefined
    v4 = Boolean boolean=true
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v3)
  b3(v5):
    v6 = CallDirect v5 function=f2
    v7 = CallDirect v0 function=f3
    Return
}
function f1 name="objectOnly" flags=[IsSloppy, HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    Return v1
}
function f2 name="objectOrUndefined" flags=[IsSloppy, HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    Return v1
}
function f3 name="numberOnly" flags=[IsSloppy, HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    Return v1
}
