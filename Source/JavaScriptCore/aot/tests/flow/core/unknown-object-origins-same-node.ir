# A node that holds the unknown object already still records the next operation that puts the object into it: both are origins of what is read through the node
# RUN: flow-solve origins
# RUN(MUTATIONS): flow-solve mutations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="first" [isFreeName]
    v2 = PropGet v0 key="second" [isFreeName]
    v3 = NewClosure function=f1
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = Call v1, -, v3
    v7 = Call v2, -, v4
    v8 = Call v2, -, v5
    Return
}
function f1 name="handedToBoth" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    Return
}
function f2 name="handedToSecond" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="b"
    Return
}
# Either unknown callee calls a closure of f1 with unknown operands, so the parameter is freed only when both are known.
# CHECK: origin f0:v2 alone=1 {{*}} accesses=2
# CHECK: origin f0:v1 alone=0 {{*}} accesses=1
# CHECK: meeting-point accesses=1 {{*}} origins=2 at {{*}}f1, parameter 0) | f0:v1 f0:v2
# CHECK-NOT: meeting-point accesses=1

