# One read of a name sees 24 receivers, and each of them gets the name later, one after the other: each store brings back its own receiver alone, and the read never starts over.
# A store that makes a location and a read that passes a holder come out once more when nothing is queued.
# RUN: flow-solve nodes
# STATISTIC: FlowStatementsStartedOver = 0
# STATISTIC: FlowCursorsNotReached = 0
# STATISTIC: FlowMembersRepeated >= 24
# STATISTIC: FlowMembersRepeated <= 144
# CHECK: , f1, v0) = {L0#{{*}}|L23#
# CHECK-NEXT: , f1, v1) = {undefined|7}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver0" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Receiver1" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
