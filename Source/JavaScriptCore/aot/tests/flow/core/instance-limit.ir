# Past the limit of call-site instances a call enters the shared instance of its callee, and the call that the solve looked at before it keeps its own
# OPTIONS: limit=MaxFlowInstances:1
# RUN: flow-solve instances nodes
# LOSS: MaxFlowInstances f0 v4
# CHECK-NOT: f1
# CHECK: f1 at f0:v6 Initialized
# CHECK-NEXT: f1 Proven Initialized
# CHECK-NOT: f1 at
# CHECK-NOT: f1 Generic
# CHECK: Local({{*}}f0, v4) = {L0#[[first]]|L1#[[second]]}
# CHECK-NEXT: Local({{*}}f0, v5) = {L0#[[first]]|L1#[[second]]}
# CHECK-NEXT: Local({{*}}f0, v6) = {L2#[[third]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Third" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = CallDirect v1 function=f1
    v5 = CallDirect v2 function=f1
    v6 = CallDirect v3 function=f1
    Return
}
function f1 name="id" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
