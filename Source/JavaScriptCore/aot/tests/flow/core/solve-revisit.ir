# A call of an inherited method is linked though the prototype is set, and the method stored, after the call was first looked at; a store of the same name on another object wakes nobody
# RUN: flow-solve nodes
# STATISTIC: FlowWorklistSteps <= 896
# CHECK: Local({{*}}f1, v1) = {undefined|f4}
# CHECK-NEXT: Local({{*}}f1, v2) = {7}
# CHECK: Local({{*}}f1, v47) = {undefined|f4}
# CHECK-NEXT: Local({{*}}f1, v48) = {7}
# RUN(LINK): flow-solve nodes
# LINK: PrototypeLink(L0#{{*}}) = {L1#{{*}}|ObjectPrototype}
# RUN(METHOD): flow-solve nodes
# METHOD: Property(L1#{{*}}, "m") = {f4}
# RUN(OTHER): flow-solve nodes
# OTHER-NOT: Property(L0#
# OTHER: Property(L2#{{*}}, "m") = {L7#
# OTHER-NOT: Property(L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Receiver" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Parent" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Unrelated" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L3 name="First" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
layout L4 name="FirstHolder" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Second" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]
layout L6 name="SecondHolder" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
layout L7 name="Link0" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L8 name="Link1" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L9 name="Link2" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
