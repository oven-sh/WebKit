    v30 = Call v29, v0
    v31 = PropGet v0 key="m"
    v32 = Call v31, v0
    v33 = PropGet v0 key="m"
    v34 = Call v33, v0
    v35 = PropGet v0 key="m"
    v36 = Call v35, v0
    v37 = PropGet v0 key="m"
    v38 = Call v37, v0
    v39 = PropGet v0 key="m"
    v40 = Call v39, v0
    v41 = PropGet v0 key="m"
    v42 = Call v41, v0
    v43 = PropGet v0 key="m"
    v44 = Call v43, v0
    v45 = PropGet v0 key="m"
    v46 = Call v45, v0
    v47 = PropGet v0 key="m"
    v48 = Call v47, v0
    Return
}
function f2 name="setsPrototype" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = Builtin builtin=ObjectSetPrototypeOf
    v3 = Call v2, -, v0, v1
    v4 = NewClosure function=f3
    v5 = NewObject -, v4 layout=L5 fields=[0]
    v6 = NewObject -, v5 layout=L6 fields=[0]
    v7 = PropGet v6 key="inner"
    v8 = PropGet v7 key="run"
    v9 = Call v8, v7
    Return
}
function f3 name="storesMethod" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = NewClosure function=f4
    PropSet v0, v1 key="m"
    Return
}
function f4 name="m" results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
function f5 name="storesOnOthers" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = GetModuleVariable variable=g2
    v2 = NewObject -, v0 layout=L7 fields=[0]
    PropSet v1, v2 key="m"
    v4 = PropGet v1 key="m"
    v5 = NewObject -, v0 layout=L8 fields=[0]
