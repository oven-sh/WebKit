layout L20 name="Link13" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L21 name="Link14" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L22 name="Link15" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L23 name="Link16" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L24 name="Link17" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L25 name="Link18" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L26 name="Link19" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L27 name="Link20" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L28 name="Link21" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L29 name="Link22" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
layout L30 name="Link23" fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
variable g0 name="receiver" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="parent" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="unrelated" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewObject -, v0 layout=L1 fields=[0]
    PutModuleVariable v3 variable=g1
    v5 = NewObject -, v0 layout=L2 fields=[0]
    PutModuleVariable v5 variable=g2
    v7 = CallDirect function=f1
    v8 = NewClosure function=f2
    v9 = NewObject -, v8 layout=L3 fields=[0]
    v10 = NewObject -, v9 layout=L4 fields=[0]
    v11 = PropGet v10 key="inner"
    v12 = PropGet v11 key="run"
    v13 = Call v12, v11
    v14 = CallDirect function=f5
    Return
  b2() role=CatchHandler:
    v15 = CatchValue
    Return
}
function f1 name="callsMethod" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0
    v3 = PropGet v0 key="m"
    v4 = Call v3, v0
    v5 = PropGet v0 key="m"
