# class P { m() { return 1 } }  function call(o) { return o.m() }  function busy(pair) { pair.x; ..; return call(new P()) }  call(new P()); busy({ x: 1 })
# The module body calls `call` with an object it follows, so `call` has a version with proven operands. `busy` gives up at the work limit: what it passes goes to unknown JavaScript
# and never to a callee, so its call must not enter that version. A call in a function past the limit enters the generic version, which takes anything.
# A call in a function within the limit names the proven version, here in the module body.
# OPTIONS: limit=MaxFlowWorkPerFunction:160
# LOSS: MaxFlowWorkPerFunction f5
# RUN: flow-apply
# CHECK-LABEL: function f0
# CHECK: calleeName="call"{{*}}callees=[f1]
# CHECK-LABEL: function f5 name="busy"
# CHECK: calleeName="call"{{*}}callees=[f7, ..]
# CHECK-LABEL: role=GenericVersion
# RUN(VERSION): flow-apply
# VERSION: function {{*}} name="call" {{*}}role=GenericVersion

layout L0 kind=Instance name="P" module=m0 constructor=f3
layout L1 name="Pair" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="P" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="call" module=m0 declared={type=anything} initialization=Undefined
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g1
    v2 = NewClosure function=f3
    v3 = NewClass v2 layout=L0
    v4 = NewClosure function=f4
    DefineMethod v3, v4 layout=L0 key="m"
    v6 = FinishClass v3 layout=L0
    PutModuleVariable v6 variable=g0
    v8 = Construct v6 calleeName="P"
    v9 = Call v0, -, v8 calleeName="call"
    v10 = Integer integer=1
    v11 = NewObject -, v10 layout=L1 fields=[0]
    v12 = CallDirect v11 function=f5
    Return
}
function f1 name="call" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m" calleeName="m"
    Return v2
}
function f2 name="unused" module=m0 results=[{type=anything}] {
  b0():
    Return
}
function f3 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f4 name="m" module=m0 kind=Method results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f5 name="busy" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
    v11 = PropGet v0 key="x"
    v12 = PropGet v0 key="x"
    v13 = PropGet v0 key="x"
    v14 = PropGet v0 key="x"
    v15 = PropGet v0 key="x"
    v16 = PropGet v0 key="x"
    v17 = PropGet v0 key="x"
    v18 = PropGet v0 key="x"
    v19 = PropGet v0 key="x"
    v20 = PropGet v0 key="x"
    v21 = PropGet v0 key="x"
    v22 = PropGet v0 key="x"
    v23 = PropGet v0 key="x"
    v24 = PropGet v0 key="x"
    v25 = PropGet v0 key="x"
    v26 = PropGet v0 key="x"
    v27 = PropGet v0 key="x"
    v28 = PropGet v0 key="x"
    v29 = PropGet v0 key="x"
    v30 = PropGet v0 key="x"
    v31 = PropGet v0 key="x"
    v32 = PropGet v0 key="x"
    v33 = PropGet v0 key="x"
    v34 = PropGet v0 key="x"
    v35 = PropGet v0 key="x"
    v36 = PropGet v0 key="x"
    v37 = PropGet v0 key="x"
    v38 = PropGet v0 key="x"
    v39 = PropGet v0 key="x"
    v40 = PropGet v0 key="x"
    v41 = PropGet v0 key="x"
    v42 = PropGet v0 key="x"
    v43 = PropGet v0 key="x"
    v44 = PropGet v0 key="x"
    v45 = PropGet v0 key="x"
    v46 = PropGet v0 key="x"
    v47 = PropGet v0 key="x"
    v48 = PropGet v0 key="x"
    v49 = PropGet v0 key="x"
    v50 = PropGet v0 key="x"
    v51 = PropGet v0 key="x"
    v52 = PropGet v0 key="x"
    v53 = PropGet v0 key="x"
    v54 = PropGet v0 key="x"
    v55 = PropGet v0 key="x"
    v56 = PropGet v0 key="x"
    v57 = PropGet v0 key="x"
    v58 = PropGet v0 key="x"
    v59 = PropGet v0 key="x"
    v60 = PropGet v0 key="x"
    v61 = PropGet v0 key="x"
    v62 = PropGet v0 key="x"
    v63 = PropGet v0 key="x"
    v64 = PropGet v0 key="x"
    v65 = PropGet v0 key="x"
    v66 = PropGet v0 key="x"
    v67 = PropGet v0 key="x"
    v68 = PropGet v0 key="x"
    v69 = PropGet v0 key="x"
    v70 = PropGet v0 key="x"
    v71 = PropGet v0 key="x"
    v72 = PropGet v0 key="x"
    v73 = PropGet v0 key="x"
    v74 = PropGet v0 key="x"
    v75 = PropGet v0 key="x"
    v76 = PropGet v0 key="x"
    v77 = PropGet v0 key="x"
    v78 = PropGet v0 key="x"
    v79 = PropGet v0 key="x"
    v80 = PropGet v0 key="x"
    v81 = GetModuleVariable variable=g0
    v82 = Construct v81 calleeName="P"
    v83 = GetModuleVariable variable=g1
    v84 = Call v83, -, v82 calleeName="call"
    Return v84
}
