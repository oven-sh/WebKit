# What flows into a function after it gave up at the work limit reaches unknown JavaScript as well, and a closure among it is entered as unseen code enters it
# OPTIONS: limit=MaxFlowWorkPerFunction:120
# LOSS: MaxFlowWorkPerFunction f1
# RUN: flow-solve work instances objects
# CHECK: past-work-limit f1
# CHECK-NOT: past-work-limit
# CHECK: f1 Proven PastWorkLimit
# CHECK: f2 Generic Initialized
# CHECK: L0#{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript, 
# CHECK-NEXT: L1#{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript, 
# CHECK-NEXT: f2 mutations=[ReachNativeCode, ReachUnknownJavaScript, 
# CHECK-NEXT: L2#{{*}} mutations=[] uses=
# CHECK-NEXT: L3#{{*}} mutations=[] uses=
# CHECK-NEXT: L4#{{*}} mutations=[] uses=[] events=[Allocated]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Early" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Late" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Holder" fields=[{key="item" declared={type=anything} flags=[IsRequired]}, {key="callback" declared={type=anything} flags=[IsRequired]}]
layout L3 name="OuterHolder" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
layout L4 name="NeverPassed" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = NewClosure function=f2
    v5 = NewObject -, v3, v4 layout=L2 fields=[0, 1]
    v6 = NewObject -, v5 layout=L3 fields=[0]
    v7 = PropGet v6 key="inner"
    v8 = PropGet v7 key="item"
    v9 = CallDirect v8 function=f1
    v10 = PropGet v7 key="callback"
    v11 = CallDirect v10 function=f1
    v12 = NewObject -, v0 layout=L4 fields=[0]
    Return
}
