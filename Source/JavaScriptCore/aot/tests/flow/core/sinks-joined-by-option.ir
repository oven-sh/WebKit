# Where an option lets code in, what reached native code reaches unknown JavaScript too, and everything can happen to it
# OPTIONS: admit=RuntimeCode
# RUN: flow-solve sinks objects
# CHECK: nativeCode {{*}}L0#[[retained]]
# CHECK-NOT: L1#
# CHECK: unknownJavaScript {{*}}L0#[[retained]]
# CHECK-NOT: L1#
# CHECK: L0#[[retained]] mutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] uses=
# CHECK-NEXT: L1#[[kept]] mutations=[] uses=[] events=[Allocated]

module m0 path="main.js" displayPath="main.js" body=f0
evalscope e0
entry module=m0
layout L0 name="Retained" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Builtin builtin=SuppressedError
    v4 = Undefined
    v5 = Construct v3, -, v1, v4
    v6 = String string="1"
    v7 = CallDirect v6 function=f1
    Return
  b2() role=CatchHandler:
    v8 = CatchValue
    Return
}
function f1 name="evaluate" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return v2
}
