# A set whose members share one chunk of 32 ids is one word, and the empty set is too
# RUN: flow-object-set a a+3 a+3 a+31 a a?3 a?4 a-4 a-3 a a-31 a
# CHECK: a: {} size=0 inline
# CHECK-NEXT: a+3: added
# CHECK-NEXT: a+3: present
# CHECK-NEXT: a+31: added
# CHECK-NEXT: a: {o3, o31} size=2 inline
# CHECK-NEXT: a?3: yes
# CHECK-NEXT: a?4: no
# CHECK-NEXT: a-4: absent
# CHECK-NEXT: a-3: removed
# CHECK-NEXT: a: {o31} size=1 only=o31 inline
# CHECK-NEXT: a-31: removed
# CHECK-NEXT: a: {} size=0 inline
# RUN(UNKNOWN): flow-object-set a?0 a+0 a a?0 a+1 a
# UNKNOWN: a?0: no
# UNKNOWN-NEXT: a+0: added
# UNKNOWN-NEXT: a: {unknown} size=1 only=unknown inline
# UNKNOWN-NEXT: a?0: yes
# UNKNOWN-NEXT: a+1: added
# UNKNOWN-NEXT: a: {unknown, o1} size=2 inline
