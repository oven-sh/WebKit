    v8 = Call v4, -, v7 calleeName="big" @1831
    v9 = Builtin builtin=GlobalThis @1848
    v10 = PropGet v9 key="print" [isFreeName] @1848
    v11 = PropGet v3 key="k" @1854
    v12 = Predict v11 predicted=number @1854
    v13 = Integer integer=1 @1860
    v14 = Add v12, v13 @1854
    v15 = Call v10, -, v14 calleeName="print" @1848
    v16 = NewObject -, v13 layout=L1 fields=[0] @1848
    v17 = PropGet v16 key="k" @1848
    v18 = Undefined @1848
    Return v18 @1848
}
