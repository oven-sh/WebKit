# A call of a built-in in a function past the work limit has no complete set of callees, least of all the empty one, and the program still builds
# OPTIONS: limit=MaxFlowWorkPerFunction:20
# LOSS: MaxFlowWorkPerFunction f1
# RUN: flow-apply
# CHECK-LABEL: function f1 name="large"
# CHECK: = Call v13, -, v0, v14
# CHECK-NOT: callees=[]
# CHECK-NOT: callees=[builtin(ObjectSetPrototypeOf)]
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="large" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
    v11 = PropGet v0 key="x"
    v12 = PropGet v0 key="x"
    v13 = Builtin builtin=ObjectSetPrototypeOf
    v14 = Null
    v15 = Call v13, -, v0, v14
    Return v15
}
