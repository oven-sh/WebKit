# A function past the work limit gives up alone: its values are their types as read, and its objects and what flowed into it reach unknown JavaScript
# OPTIONS: limit=MaxFlowWorkPerFunction:20
# LOSS: MaxFlowWorkPerFunction f1
# STATISTIC: MaxFlowWorkPerFunctionHits >= 1
# RUN: flow-solve work instances objects nodes
# CHECK: past-work-limit f1
# CHECK-NOT: past-work-limit
# CHECK: f0 Proven Initialized
# CHECK-NEXT: f1 Proven PastWorkLimit
# CHECK-NOT: PastWorkLimit
# CHECK: L0#[[argument]] mutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] uses=
# CHECK-NEXT: L1#[[allocated]] mutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] uses=
# CHECK: Variable(g0) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# CHECK: Local({{*}}f0, v1) = {L0#[[argument]]}
# CHECK-NEXT: Local({{*}}f0, v2) = {number}
# CHECK: Local({{*}}f1, parameter 0) = {undefined|null|boolean|number|string|symbol|bigint|unknown|L0#[[argument]]}
# CHECK-NEXT: Local({{*}}f1, result 0) = {number}
# CHECK-NEXT: Local({{*}}f1, thrown) = {undefined|null|boolean|number|string|symbol|bigint|unknown
# CHECK-NEXT: Local({{*}}f1, v1) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# CHECK: Local({{*}}f1, v12) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# CHECK: Local({{*}}f1, v16) = {number}
# RUN(CALLEE): flow-solve nodes
# CALLEE: Local({{*}}f2, parameter 0) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# RUN(UNSEEN): flow-links unseen
# UNSEEN-NOT: unseen LimitReached - f
# UNSEEN: unseen LimitReached - f1
# UNSEEN-NOT: unseen LimitReached - f
# UNSEEN: unknown-javascript no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Allocated" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="stored" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="large" parameters=[{type=anything}] results=[{type=number}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
    v5 = PropGet v0 key="x"
    v6 = PropGet v0 key="x"
    v7 = PropGet v0 key="x"
    v8 = PropGet v0 key="x"
    v9 = PropGet v0 key="x"
    v10 = PropGet v0 key="x"
    v11 = PropGet v0 key="x"
    v12 = PropGet v0 key="x"
    v13 = NewObject -, v12 layout=L1 fields=[0]
    PutModuleVariable v12 variable=g0
    v15 = CallDirect v12 function=f2
    v16 = ToNumber v12
    Return v16
}
function f2 name="callee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=7
    Return v1
}
