# The prototype a literal names is its only prototype and part of its creation, and a value that is neither an object nor null leaves the literal its default
# RUN: flow-walk f0 prototypes
# RUN(ALONE): flow-walk f0 prototypes
# RUN(OBJECTS): flow-solve objects
# CHECK: f0@i{{*}} v6 Get {"inherited"}
# CHECK-NEXT: L1#{{*}}: Value Proven L0#{{*}} "inherited"
# CHECK-NEXT: f0@i{{*}} v10 Get {"inherited"}
# CHECK-NEXT: L2#{{*}}: Absent Proven
# CHECK: L1#{{*}} -> L0#
# CHECK: L2#{{*}} -> ObjectPrototype
# ALONE-NOT: L1#{{*}} -> {{*}}ObjectPrototype
# ALONE-NOT: L1#{{*}} -> {{*}}null
# ALONE-NOT: L1#{{*}} -> {{*}}unknown
# ALONE-NOT: L2#{{*}} -> {{*}}L
# ALONE-NOT: L2#{{*}} -> {{*}}null
# ALONE-NOT: L2#{{*}} -> {{*}}unknown
# OBJECTS: L0#{{*}} mutations=[BecomePrototype] uses
# OBJECTS: L1#{{*}} mutations=[] uses
# OBJECTS: L2#{{*}} mutations=[] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Parent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L1 name="WithParent" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="WithNumber" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    SetLiteralPrototype v3, v2
    v5 = FinishObject v3
    v6 = PropGet v5 key="inherited"
    v7 = NewObject -, v0 layout=L2 fields=[0]
    SetLiteralPrototype v7, v0
    v9 = FinishObject v7
    v10 = PropGet v9 key="inherited"
    Return
}
