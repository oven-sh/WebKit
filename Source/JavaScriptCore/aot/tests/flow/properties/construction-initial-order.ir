# The initial order lists the fields in the order every object gets them, through a helper, and ends at the first store that is not certain to come next
# RUN(ORDERED): flow-construction
# RUN(CONDITIONAL): flow-construction
# RUN(LOOP): flow-construction

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Ordered" constructor=f1 fields=[{key="c" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}, {key="a" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Instance name="ConditionalStoreLast" constructor=f3 fields=[{key="c" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}, {key="a" declared={type=number} flags=[IsRequired]}, {key="d" declared={type=number}}]
layout L2 kind=Instance name="StoresInLoop" constructor=f4 fields=[{key="c" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}, {key="a" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4
    v6 = NewClosure function=f3
    v7 = NewClass v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8, -, v1
    v10 = NewClosure function=f4
    v11 = NewClass v10 layout=L2
    v12 = FinishClass v11 layout=L2
    v13 = Construct v12, -, v1
    Return
}
function f1 name="Ordered" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="a"
    v5 = NewClosure function=f2
    v6 = Call v5, v2
    v7 = Integer integer=3
    PropSet v2, v7 key="c"
    Return v2
}
function f2 name="storeB" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    PropSet v0, v1 key="b"
    Return
}
# ORDERED: construction f1@i{{*}} root v2: DoesNotLeak before-leak "c" "b" "a" at-exit "c" "b" "a" read-early initial-order "a" "b" "c" stores OnlyInitialOrder
# ORDERED-NOT: construction f1@i{{*}} stores Unknown
# ORDERED: layout L0: DoesNotLeak OnlyAtConstruction set [0, 1, 2] orders [2, 1, 0]
function f3 name="ConditionalStoreLast" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    v4 = Integer integer=1
    PropSet v3, v4 key="a"
    v6 = NewClosure function=f2
    v7 = Call v6, v3
    v8 = Integer integer=3
    PropSet v3, v8 key="c"
    v10 = ToBoolean v1
    Branch v10 -> taken b1(), notTaken b2()
  b1():
    v11 = Integer integer=4
    PropSet v3, v11 key="d"
    Jump -> next b2()
  b2():
    Return v3
}
# CONDITIONAL: construction f3@i{{*}} root v3: DoesNotLeak before-leak "c" "b" "a" at-exit "c" "b" "a" read-early initial-order "a" "b" "c" stores Unknown
# CONDITIONAL-NOT: construction f3@i{{*}} stores OnlyInitialOrder
# CONDITIONAL: layout L1: DoesNotLeak Unknown set [0, 1, 2] orders [2, 1, 0]
function f4 name="StoresInLoop" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L2
    v3 = NewObject v2 layout=L2
    v4 = Integer integer=1
    PropSet v3, v4 key="a"
    v6 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    PropSet v3, v4 key="b"
    PropSet v3, v4 key="c"
    Branch v6 -> taken b1(), notTaken b2()
  b2():
    Return v3
}
# LOOP: construction f4@i{{*}} root v3: DoesNotLeak before-leak "c" "b" "a" at-exit "c" "b" "a" read-early initial-order "a" stores Unknown
# LOOP-NOT: construction f4@i{{*}} stores OnlyInitialOrder
# LOOP: layout L2: DoesNotLeak Unknown set [0, 1, 2] orders [2]
