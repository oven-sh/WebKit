# A walk waits on nothing at a holder where its name is immutable, and still answers otherwise once unseen code has reached the holder. A kept lookup is walked again after any change of an object it visited: the base constructor, which reads "prototype" of the class late, is not handed what the class definition found early
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve fixpoint nodes
# CHECK: nothing changes
# CHECK: , f0, v12) = {{*}}unknown}
# CHECK: , f0, v13) = {f3}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Failure" constructor=f1 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Error" [isFreeName]
    v2 = NewClosure function=f1
    v3 = ResolveHeritage v1
    v4 = NewClass v2, v1, v3 layout=L0
    v5 = NewClosure function=f2
    DefineMethod v4, v5 layout=L0 methodKind=Getter key="message"
    v7 = NewClosure function=f3
    DefineMethod v4, v7 layout=L0 index=1 key="describe"
    v9 = FinishClass v4 layout=L0
    v10 = String string="given"
    v11 = Construct v9, -, v10
    v12 = PropGet v11 key="message"
    v13 = PropGet v11 key="describe"
    Return
}
function f1 name="Failure" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0 homeKind=Object
    v4 = SuperConstruct v3, v1, v2 layout=L0
    Return v4
}
function f2 name="message" kind=Getter flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="from getter"
    Return v1
}
function f3 name="describe" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
