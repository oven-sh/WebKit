# A method is found on the prototype object of the class, and on the finished solution the lookup ends there, because the location is proven filled
# RUN: flow-walk f0
# CHECK: f0@i{{*}} v6 Get {"m"}
# CHECK-NEXT: L0#{{*}}: Value Proven f1.prototype "m"
# CHECK-NEXT: f0@i{{*}} v7 Get {"n"}
# CHECK-NEXT: L0#{{*}}: Absent Proven
# CHECK-NEXT: f0@i{{*}} v8 Get {"toString"}
# CHECK-NEXT: L0#{{*}}: BuiltinMember Proven ObjectPrototype "toString" ObjectPrototypeToString
# CHECK-NOT: Absent

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Shape" constructor=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="m"
    v7 = PropGet v5 key="n"
    v8 = PropGet v5 key="toString"
    Return
  b1() role=CatchHandler:
    v9 = CatchValue
    Return
}
function f1 name="Shape" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="m" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
