# A store to a member of a built-in object that is not locked is one more value of that member. A store to a member of a locked object changes nothing
# RUN: flow-walk f0
# RUN(LINKS): flow-links calls builtins
# RUN(NODES): flow-solve nodes
# RUN(USES): flow-links uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="console" [isFreeName]
    v2 = NewClosure function=f1
    PropSet v1, v2 key="log"
    v4 = PropGet v1 key="log"
    v5 = Integer integer=1
    v6 = Call v4, v1, v5
    v7 = PropGet v1 key="warn"
    v8 = PropGet v0 key="Array" [isFreeName]
    v9 = PropGet v8 key="prototype"
    PropSet v9, v2 key="push"
    v11 = NewArray contents=anything
    v12 = PropGet v11 key="push"
    Return
}
function f1 name="replacement" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
# CHECK: f0@i{{*}} v3 Set {"log"}
# CHECK-NEXT: Console: Value own Proven Console "log" ConsoleLog
# CHECK-NEXT: f0@i{{*}} v4 Get {"log"}
# CHECK-NEXT: Console: Value own Proven Console "log"
# CHECK-NEXT: Console: BuiltinMember own Proven Console "log" ConsoleLog
# CHECK: f0@i{{*}} v7 Get {"warn"}
# CHECK-NEXT: Console: BuiltinMember own Proven Console "warn" ConsoleWarn
# CHECK-NOT: Value
# CHECK: f0@i{{*}} v10 Set {"push"}
# CHECK-NEXT: f0@i{{*}} v12 Get {"push"}
# CHECK-NEXT: Array@f0:v11: BuiltinMember Proven ArrayPrototype "push" ArrayPrototypePush
# CHECK-NOT: Array@f0:v11:
# LINKS: f0 v6 -> i{{*}} f1 Call Once
# LINKS: builtin i{{*}} v6 ConsoleLog/0 Call
# NODES-NOT: (ArrayPrototype, "push")
# NODES-NOT: (Console, "warn")
# NODES: , f0, v4) = {{*}}f1|ConsoleLog}
# NODES: , f0, v12) = {ArrayPrototypePush}
# NODES: Property(Console, "log") = {f1}
# NODES-NOT: (ArrayPrototype, "push")
# NODES-NOT: (Console, "warn")
# USES: use ConsoleLog [{{*}}Written{{*}}] f0:v3
# USES-NOT: use ConsoleWarn [{{*}}Written
