# A read that finds the getters of two classes calls each getter with the receivers that find it, not with every object of the receiver's node
# RUN: flow-links calls
# RUN(NODES): flow-solve nodes
# RUN(OTHER): flow-solve nodes
# CHECK: f0 v15 -> {{*}} f3 Accessor
# CHECK: f0 v15 -> {{*}} f4 Accessor
# CHECK-NOT: f0 v15 ->
# NODES: Variable(g0) = {L0#{{*}}|L1#{{*}}}
# NODES: Variable(g1) = {{*}}1|"b"}
# NODES: f3, parameter 0) = {L0#
# NODES: f4, parameter 0) = {L1#
# OTHER-NOT: f3, parameter 0) = {{*}}L1#
# OTHER-NOT: f4, parameter 0) = {{*}}L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" constructor=f2
variable g0 name="either" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="found" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f3
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="v"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f2
    v6 = NewClass v5 layout=L1
    v7 = NewClosure function=f4
    DefineMethod v6, v7 layout=L1 methodKind=Getter key="v"
    v9 = FinishClass v6 layout=L1
    v10 = Construct v4
    PutModuleVariable v10 variable=g0
    v12 = Construct v9
    PutModuleVariable v12 variable=g0
    v14 = GetModuleVariable variable=g0
    v15 = PropGet v14 key="v"
    PutModuleVariable v15 variable=g1
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="B" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="v" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
function f4 name="v" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="b"
    Return v1
}
