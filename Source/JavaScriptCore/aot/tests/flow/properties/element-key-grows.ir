# When the key of a read by key grows, the receivers the read has seen are read under the added name as well, and a field no key names stays unread
# RUN: flow-solve nodes
# RUN(LOCATIONS): flow-solve locations
# RUN(UNREAD): flow-solve locations
# CHECK: Variable(g0) = {"a"|"b"}
# CHECK: Variable(g1) = {1|"two"}
# LOCATIONS: DeclaredPart(L0#{{*}}, 0) events=[{{*}}ReadAsValue
# LOCATIONS: DeclaredPart(L0#{{*}}, 1) events=[{{*}}ReadAsValue
# UNREAD-NOT: DeclaredPart(L0#{{*}}, 2) events={{*}}Read

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}, {key="c" declared={type=anything} flags=[IsRequired]}]
variable g0 name="key" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="found" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="record" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="two"
    v2 = Boolean boolean=true
    v3 = NewObject -, v0, v1, v2 layout=L0 fields=[0, 1, 2]
    PutModuleVariable v3 variable=g2
    v5 = String string="a"
    PutModuleVariable v5 variable=g0
    v7 = NewClosure function=f1
    v8 = Call v7
    v9 = NewClosure function=f2
    v10 = Call v9
    v11 = Call v7
    Return
}
function f1 name="read" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    v1 = GetModuleVariable variable=g0
    v2 = ElemGet v0, v1
    PutModuleVariable v2 variable=g1
    Return
}
function f2 name="changeKey" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    Return
}
function f3 name="storeSecondKey" results=[{type=anything}] {
  b0():
    v0 = String string="b"
    PutModuleVariable v0 variable=g0
    Return
}
