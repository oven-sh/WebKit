# The second argument of Object.create defines one property per key of the map on the new object, each from its own descriptor, and the first is its prototype
# RUN: flow-solve nodes
# RUN(LINKS): flow-links calls
# RUN(WALK): flow-walk f0 prototypes
# RUN(OBJECTS): flow-solve objects
# CHECK: Variable(g2) = {{*}}1}
# CHECK: Variable(g3) = {{*}}"got"}
# CHECK: Variable(g4) = {{*}}true}
# LINKS: f0 v19 -> {{*}} f1 Accessor
# WALK: Object@f0:v15{{*}} -> L4#
# OBJECTS: L4#{{*}} mutations=[BecomePrototype] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target"
layout L1 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L2 name="GetterDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Descriptors" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Parent" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Neighbor"
variable g0 name="aOfTarget" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="bOfTarget" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="aOfCreated" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="bOfCreated" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="inheritedOfCreated" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = NewClosure function=f1
    v4 = NewObject -, v3 layout=L2 fields=[0]
    v5 = NewObject -, v2, v4 layout=L3 fields=[0, 1]
    v6 = Builtin builtin=ObjectDefineProperties
    v7 = Call v6, -, v0, v5
    v8 = PropGet v0 key="a"
    PutModuleVariable v8 variable=g0
    v10 = PropGet v0 key="b"
    PutModuleVariable v10 variable=g1
    v12 = Boolean boolean=true
    v13 = NewObject -, v12 layout=L4 fields=[0]
    v14 = Builtin builtin=ObjectCreate
    v15 = Call v14, -, v13, v5
    v16 = NewObject layout=L5 fields=[]
    v17 = PropGet v15 key="a"
    PutModuleVariable v17 variable=g2
    v19 = PropGet v15 key="b"
    PutModuleVariable v19 variable=g3
    v21 = PropGet v15 key="inherited"
    PutModuleVariable v21 variable=g4
    Return
}
function f1 name="get" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="got"
    Return v1
}
