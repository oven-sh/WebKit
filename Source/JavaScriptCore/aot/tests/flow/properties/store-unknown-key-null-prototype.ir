# A dictionary without a prototype inherits no setter: under every string, __proto__ too, a store defines an own property. Its prototype link stays fixed and what is stored becomes no prototype
# RUN: flow-solve objects
# CHECK: L1#{{*}} mutations=[] uses
# CHECK-NEXT: L0#{{*}} mutations=[AddProperty, StoreAfterCreation] uses
# RUN(LINKS): flow-walk prototypes
# LINKS: L0#{{*}} -> null
# LINKS-NOT: -> L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Bare" fields=[{key="first" declared={type=anything} flags=[IsRequired]}]
layout L1 name="User" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Undefined
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = Null
    SetLiteralPrototype v6, v7
    v9 = FinishObject v6
    ElemSet v9, v2, v4 mode=Strict
    Return
  b1() role=CatchHandler:
    v11 = CatchValue
    Return
}
