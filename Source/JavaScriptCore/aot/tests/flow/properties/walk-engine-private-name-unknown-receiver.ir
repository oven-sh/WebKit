# The unknown object stands for instances of every built-in class, and the members of a built-in prototype do not follow it into native code. So a read under an engine private name on an unknown receiver names the members that have the private alias, as a read under the public name does. A name that is no alias names none
# RUN: flow-walk
# CHECK: v3 Get {@"then"}
# CHECK-NEXT: unknown: Unknown own Predicted unknown *
# CHECK-NEXT: unknown: BuiltinMember Predicted PromisePrototype @"then" PromisePrototypeThen
# CHECK: v5 Get {@"hidden"}
# CHECK-NEXT: unknown: Unknown own Predicted unknown *
# CHECK-NOT: BuiltinMember
# CHECK: v6 Get {@"catch"}
# CHECK-NEXT: unknown: Unknown own Predicted unknown *
# CHECK-NOT: BuiltinMember
# CHECK: v7 Get {"catch"}
# CHECK-NEXT: unknown: Unknown own Predicted unknown *
# CHECK-NEXT: unknown: BuiltinMember Predicted PromisePrototype "catch" PromisePrototypeCatch

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="given" [isFreeName]
    v2 = NewClosure function=f1
    v3 = PropGet v1 key=@"then"
    v4 = Call v3, v1, v2 calleeKey=@"then"
    v5 = PropGet v1 key=@"hidden"
    v6 = PropGet v1 key=@"catch"
    v7 = PropGet v1 key="catch"
    Return
  b1() role=CatchHandler:
    v8 = CatchValue
    Return
}
function f1 name="reaction" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
