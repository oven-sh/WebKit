# A built-in that stores by key converts what it stores into a typed array like the store of the program: valueOf of the object runs, and the array holds numbers
# OPTIONS: check=FlowFixpoint
# RUN(CONVERTED): flow-links calls
# CONVERTED: f0 v21 -> i{{*}} f1 Protocol
# RUN(WRITTEN): flow-solve nodes
# WRITTEN: DeclaredPart(L0#{{*}}, 0) = {1|"text"}
# RUN(ELEMENTS): flow-solve nodes
# ELEMENTS: DeclaredPart(Float64Array@{{*}}, 0) = {number}
# RUN(FIXPOINT): flow-solve fixpoint
# FIXPOINT: nothing changes

layout L0 module=m0 position=14 fields=[{key="n" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L1 module=m0 position=42 fields=[{key="valueOf" declared={type=anything predicted=function} flags=[IsRequired, IsMethod]}]
variable g0 name="state" module=m0 declared={type=anything|absent predicted=L0} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1() @0
  b1():
    v0 = Data data=d0 @14
    v1 = Predict v0 predicted=L0 @6
    PutModuleVariable v1 variable=g0 @6
    v3 = NewObject layout=L1 @44
    v4 = NewClosure function=f1 @44
    v5 = ClaimDeclared v4 declared={type=anything predicted=function} @44
    PropDefine v3, v5 key="valueOf" @44
    v7 = FinishObject v3 @42
    v8 = Predict v7 predicted=L1 @30
    v9 = Builtin builtin=GlobalThis @109
    v10 = PropGet v9 key="Float64Array" [isFreeName] @109
    v11 = Predict v10 predicted=builtin(Float64Array) @109
    v12 = Integer integer=2 @122
    v13 = Construct v11, -, v12 calleeName="Float64Array" @109
    v14 = Predict v13 predicted=Float64Array @105
    v15 = Builtin builtin=GlobalThis @126
    v16 = PropGet v15 key="Reflect" [isFreeName] @126
    v17 = Predict v16 predicted=builtin(Reflect) @126
    v18 = PropGet v17 key="set" @126
    v19 = Predict v18 predicted=function @126
    v20 = Predict v19 predicted=builtin(ReflectSet) @126
    v21 = Integer integer=1 @147
    v22 = Call v20, v17, v14, v21, v8 calleeKey="set" calleeName="set" @134
    v23 = Builtin builtin=GlobalThis @162
    v24 = PropGet v23 key="print" [isFreeName] @162
    v25 = PropGet v1 key="n" @168
    v26 = Predict v25 predicted=number @168
    v27 = Call v24, -, v26 calleeName="print" @162
    v28 = Undefined @162
    Return v28 @162
}
function f1 name="valueOf" module=m0 position=44 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything predicted=number}] {
  b0():
    Jump -> next b1() @44
  b1():
    v0 = GetModuleVariable variable=g0 @56
    v1 = CheckInitialized v0 name="state" @56
    v2 = String string="text" @66
    v3 = ClaimDeclared v2 declared={type=anything predicted=number} @56
    PropSet v1, v3 key="n" @56
    v5 = Integer integer=7 @81
    v6 = ClaimDeclared v5 declared={type=anything predicted=number} @81
    Return v6 @81
}
data d0 root=Object{layout=L0 members=[{key="n" value=Number{value=1}}]} module=m0
entry module=m0
