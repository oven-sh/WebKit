# DefineMethod puts a method, a getter and a static method on the holder of its side as part of the creation of the class, and an instance field that the constructor always fills hides a method of its name
# RUN: flow-walk f0
# RUN(NODES): flow-solve nodes
# RUN(OBJECTS): flow-solve objects
# CHECK: f0@i{{*}} v12 Get {"run"}
# CHECK-NEXT: L0#{{*}}: Value own Proven L0#{{*}} "run"
# CHECK-NEXT: f0@i{{*}} v13 Get {"stop"}
# CHECK-NEXT: L0#{{*}}: Value Proven f1.prototype "stop"
# CHECK-NEXT: f0@i{{*}} v14 Get {"size"}
# CHECK-NEXT: L0#{{*}}: Getter Proven f1.prototype "size"
# CHECK: f0@i{{*}} v15 Get {"create"}
# CHECK-NEXT: f1: Value own Proven f1 "create"
# CHECK-NOT: f1
# NODES: Property(f1.prototype, "run") = {f2}
# NODES: Property(f1.prototype, "stop") = {f3}
# NODES: Getter(f1.prototype, "size") = {f4}
# NODES: Property(f1, "create") = {f5}
# OBJECTS: f1 mutations=[] uses
# OBJECTS: f1.prototype mutations=[BecomePrototype] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Task" constructor=f1 fields=[{key="run" declared={type=anything}}]
