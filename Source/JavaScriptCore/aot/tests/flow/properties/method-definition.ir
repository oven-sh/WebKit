    v6 = NewClosure function=f4
    DefineMethod v1, v6 layout=L0 methodKind=Getter index=2 key="size"
    v8 = NewClosure function=f5
    DefineMethod v1, v8 layout=L0 side=Static index=3 key="create"
    v10 = FinishClass v1 layout=L0
    v11 = Construct v10
    v12 = PropGet v11 key="run"
    v13 = PropGet v11 key="stop"
    v14 = PropGet v11 key="size"
    v15 = PropGet v10 key="create"
    Return
}
function f1 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
