# A lookup that finds a member of the host on an escaped built-in holder ends there and is proven, whatever is stored through an unknown receiver under that name or under a key nobody can name.
# A lookup that misses on the holder finds what was stored that way. A member that is stored to through the holder itself aliases the unknown object like any other location, and the member beside it does not
# RUN: flow-walk f0
# CHECK: v13 Get {"log"}
# CHECK-NEXT: Console: BuiltinMember own Proven Console "log" ConsoleLog
# CHECK-NEXT: v14 Get {"warn"}
# CHECK-NEXT: Console: BuiltinMember own Proven Console "warn" ConsoleWarn
# CHECK-NEXT: v15 Get {"added"}
# CHECK: Console: Value own Predicted Console *
# CHECK-NEXT: Console: Value own Predicted Console "added"
# CHECK: v16 Get {"other"}
# CHECK: Console: Value own Predicted Console *
# CHECK: v18 Get {"inspect"}
# CHECK-NEXT: Bun: Value own Predicted Bun "inspect"
# CHECK-NEXT: Bun: BuiltinMember own Predicted Bun "inspect" BunInspect
# CHECK: v19 Get {"sleep"}
# CHECK-NEXT: Bun: BuiltinMember own Proven Bun "sleep" BunSleep
# CHECK-NEXT: f0@

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=Console
    v2 = Builtin builtin=Bun
    v3 = PropGet v0 key="sink" [isFreeName]
    v4 = Call v3, -, v1
    v5 = Call v3, -, v2
    v6 = PropGet v0 key="input" [isFreeName]
    v7 = PropGet v0 key="name" [isFreeName]
    v8 = ToPropertyKey v7
    v9 = Integer integer=1
    PropSet v6, v9 key="log" mode=Strict
    PropSet v6, v9 key="added" mode=Strict
    ElemSet v6, v8, v9 mode=Strict
    v13 = PropGet v1 key="log"
    v14 = PropGet v1 key="warn"
    v15 = PropGet v1 key="added"
    v16 = PropGet v1 key="other"
    PropSet v2, v9 key="inspect" mode=Strict
    v18 = PropGet v2 key="inspect"
    v19 = PropGet v2 key="sleep"
    Return
}
