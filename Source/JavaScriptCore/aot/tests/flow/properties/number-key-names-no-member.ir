# A number used as a key names an array index or a canonical numeric string, never a field, a method or an accessor with an ordinary name. A property and a built-in member whose name is such a string are found, and a string or a bigint nobody knows still names everything
# RUN: flow
# RUN(VALUES): flow-solve nodes
# RUN(WALK): flow-walk f0
# CHECK: class {{*}} builtinClass=Array pristine=[Storage, Names, Dense] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype,
# The number that the other array is stored under may be -1 or 1.5, which adds a property, or an index above the length, which leaves a hole.
# CHECK: class {{*}} builtinClass=Array pristine=[Storage] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype,
# CHECK: class {{*}} layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape]
# CHECK: field L0.0 "x" type=1 {{*}}reads=NeverRead
# CHECK: field L1.0 "x" type=1 {{*}}stores=AtMostOnce
# CHECK: field L3.0 "x" type=1
# CHECK-NOT: reads=NeverRead
# CHECK: field L4.0 "x" type=1
# CHECK-NOT: reads=NeverRead
# CHECK: layout
# VALUES: Position(Array@f0:v7, 0) = {1|"s"}
# VALUES: , f0, v6) = {undefined|1}
# VALUES: , f0, v10) = {undefined}
# VALUES: , f0, v15) = {undefined|"s"}
# VALUES: , f0, v20) = {undefined|1|ObjectPrototype|
# VALUES: , f0, v24) = {undefined|1|ObjectPrototype|
# VALUES: , f0, v25) = {undefined|"s"}
# WALK: v6 Get {[0,4294967294], number*}
# WALK: v8 Set {[0,4294967294], number*}
# WALK: v17 Get {[0,4294967294], number*}
# WALK-NEXT: Number: BuiltinMember own Proven Number "NaN" NumberNaN
# WALK-NEXT: Number: Absent Proven
# WALK: v20 Get {[0,4294967294], string*}
# WALK: v24 Get {[0,4294967294], string*}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ReadByNumber" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="StoredByNumber" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="WithNumericName" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L3 name="ReadByString" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L4 name="ReadByBigInt" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="which" [isFreeName]
    v3 = ToNumber v2
    v4 = String string="s"
    v5 = NewArray v0, v0 contents=anything
    v6 = ElemGet v5, v3
    v7 = NewArray v0, v0 contents=anything
    ElemSet v7, v3, v4 mode=Strict
    v9 = NewObject -, v0 layout=L0 fields=[0]
    v10 = ElemGet v9, v3
    v11 = NewObject -, v0 layout=L1 fields=[0]
    ElemSet v11, v3, v4 mode=Strict
    v13 = NewObject -, v0 layout=L2 fields=[0]
    PropSet v13, v4 key="-1" mode=Strict
    v15 = ElemGet v13, v3
    v16 = Builtin builtin=Number
    v17 = ElemGet v16, v3
    v18 = NewObject -, v0 layout=L3 fields=[0]
    v19 = ToString v2
    v20 = ElemGet v18, v19
    v21 = NewObject -, v0 layout=L4 fields=[0]
    v22 = Builtin builtin=BigInt
    v23 = Call v22, -, v2
    v24 = ElemGet v21, v23
    v25 = PropGet v11 key="-1"
    Return
}
