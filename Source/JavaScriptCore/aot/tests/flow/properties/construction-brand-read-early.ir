# A method that the base constructor calls reads the brand of the subclass before the subclass defines it: the read is an early read of that name, whether the operation tests or reads, so the brand is not set at creation. In the class whose constructor calls nothing the brand is
# RUN: flow-construction
# RUN(CHECK2): flow-construction
# RUN(CHECK3): flow-construction
# RUN(CHECK4): flow-construction
# RUN(CHECK5): flow-construction
# CHECK: construction f2@i{{*}} root v4: DoesNotLeak {{*}}read-early #"#"@L1 initial-order
# CHECK2: construction f1@i{{*}} root v2: DoesNotLeak {{*}}read-early #"#"@L1 initial-order
# CHECK3: construction f6@i{{*}} root v2: DoesNotLeak {{*}}read-early initial-order
# CHECK4: layout L1: DoesNotLeak OnlyAtConstruction set [] orders
# CHECK5: layout L2: DoesNotLeak OnlyAtConstruction set [0] orders

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 fields=[{key=#"#"@L1 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}] flags=[HasHeritage]
layout L2 kind=Instance name="Alone" constructor=f6 fields=[{key=#"#"@L2 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}]
variable g0 name="tokenOfDerived" module=m0 declared={type=classtoken} flags=[IsImmutable]
variable g1 name="tokenOfAlone" module=m0 declared={type=classtoken} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClassToken layout=L1
    PutModuleVariable v4 variable=g0
    v6 = NewClosure function=f2
    v7 = NewClass v6, v2, v3 layout=L1
    v8 = NewClosure function=f3
    DefineMethod v7, v8 layout=L1 key="hook"
    v10 = FinishClass v7 layout=L1
    v11 = Construct v10
    v12 = NewClassToken layout=L2
    PutModuleVariable v12 variable=g1
    v14 = NewClosure function=f6
    v15 = NewClass v14 layout=L2
    v16 = NewClosure function=f5
    DefineMethod v15, v16 layout=L2 key="hook"
    v18 = FinishClass v15 layout=L2
    v19 = Construct v18
    v20 = PropGet v19 key="hook"
    v21 = Call v20, v19 calleeKey="hook"
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = PropGet v2 key="hook"
    v4 = Call v3, v2 calleeKey="hook"
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=object}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = GetModuleVariable variable=g0
    v4 = SuperConstruct v2, v1 layout=L1
    PrivateDefine v4, v3, v3 layout=L1
    Return v4
}
function f3 name="hook" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = PrivateGet v0, v1 layout=L1
