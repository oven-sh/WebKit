# The constructor of an error class, and the engine later on its own, put a known list of own properties on the object they make for a subclass. A store under any other name finds nothing there and nothing above: what is stored stays known. A listed name may be there already, as whatever the engine made it, so a store under it asks the unknown setter, and what is stored is handed over
# RUN: flow-walk f1 f2
# CHECK: f1@{{*}} v5 Set {"node"}
# CHECK-NEXT: L1#{{*}}: Value own Proven L1#{{*}} "node"
# CHECK-NEXT: f2@{{*}} v5 Set {"cause"}
# CHECK: L2#{{*}}: Unknown own Predicted L2#{{*}} *
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[underOtherName]] mutations=[] uses
# OBJECTS: L0#[[underListedName]] mutations=[ReachNativeCode

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Failure" module=m0 constructor=f1 fields=[{key="node" declared={type=anything}}] flags=[HasHeritage]
layout L2 kind=Instance name="Refusal" module=m0 constructor=f2 fields=[{key="cause" declared={type=anything}}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Integer integer=1
    v1 = Builtin builtin=TypeError
    v2 = ResolveHeritage v1
    v3 = NewClosure function=f1
    v4 = NewClass v3, v1, v2 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = NewObject -, v0 layout=L0 fields=[0]
    v7 = Construct v5, -, v6
    v8 = Builtin builtin=RangeError
    v9 = ResolveHeritage v8
    v10 = NewClosure function=f2
    v11 = NewClass v10, v8, v9 layout=L2
    v12 = FinishClass v11 layout=L2
    v13 = NewObject -, v0 layout=L0 fields=[0]
    v14 = Construct v12, -, v13
    Return
  b1() role=CatchHandler:
    v15 = CatchValue
    Return
}
function f1 name="Failure" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1 layout=L1
    PropSet v4, v2 key="node"
    Return v4
}
function f2 name="Refusal" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1 layout=L2
    PropSet v4, v2 key="cause"
    Return v4
}
