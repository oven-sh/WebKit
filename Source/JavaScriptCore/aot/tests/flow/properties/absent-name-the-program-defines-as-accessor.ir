# CHECK: f0 v2 -> {{*}} f1 Accessor
# RUN(TABLES): tables constants
# TABLES-NOT: closedAbsentName holder=ArrayPrototype name="mark"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Descriptor" fields=[{key="set" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    PropSet v1, v0 key="mark"
    v3 = Builtin builtin=ArrayPrototype
    v4 = NewClosure function=f1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = String string="mark"
    v7 = Builtin builtin=ObjectDefineProperty
    v8 = Call v7, -, v3, v6, v5
    Return
}
function f1 name="mark" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
