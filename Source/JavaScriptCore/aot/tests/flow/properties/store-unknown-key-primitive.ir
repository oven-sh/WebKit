# The setter of __proto__ ignores a value that is neither an object nor null, so a number, a string or a boolean stored under an unknown string key leaves the prototype link of the receiver fixed. null takes the prototype away
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[AddProperty, StoreAfterCreation] uses
# CHECK-NEXT: L1#{{*}} mutations=[AddProperty, ChangePrototype, StoreAfterCreation] uses
# RUN(LINKS): flow-walk prototypes
# LINKS: L0#{{*}} -> ObjectPrototype
# LINKS-NEXT: L1#{{*}} -> ObjectPrototype, null

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Counts" fields=[{key="total" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Cleared" fields=[{key="total" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = Integer integer=0
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    ElemSet v5, v2, v1 mode=Strict
    ElemSet v5, v2, v2 mode=Strict
    v8 = Boolean boolean=true
    ElemSet v5, v2, v8 mode=Strict
    v10 = NewObject -, v3 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = Null
    ElemSet v11, v2, v12 mode=Strict
    Return
  b1() role=CatchHandler:
    v14 = CatchValue
    Return
}
