# `derived` inherits from `base`, the target of a proxy, to which everything can happen: somebody may have defined a setter on it under any name. A function has its own `prototype` for good, so
# `derived.prototype = replacement` finds the property on `derived` and asks nobody above: neither `derived` nor `replacement` is passed to a setter that nobody has seen.
# Under a name that `derived` does not have: flow/properties/store-to-new-name-of-function-under-opened-parent.ir
# RUN: flow-solve sinks
# CHECK-LABEL: nativeCode {
# CHECK-NOT: f1
# CHECK-NOT: L0#
# CHECK-LABEL: unknownJavaScript {
# CHECK-NOT: f1
# CHECK-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Replacement" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Handler"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=ObjectSetPrototypeOf
    v3 = Call v2, -, v0, v1
    v4 = Builtin builtin=Proxy
    v5 = NewObject layout=L1
    v6 = Construct v4, -, v1, v5
    v7 = Integer integer=1
    v8 = NewObject -, v7 layout=L0 fields=[0]
    PropSet v0, v8 key="prototype"
    PutModuleVariable v0 variable=g0
    Return
}
function f1 name="derived" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="base" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
