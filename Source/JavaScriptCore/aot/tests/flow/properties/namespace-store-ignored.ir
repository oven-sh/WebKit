# A store, a delete and a definition on a namespace object change neither the variable of the export nor the object, while the same three on a record do
# RUN: flow-solve nodes
# RUN(OBJECTS): flow-solve objects
# RUN(LOCATIONS): flow-solve locations
# CHECK: Variable(g0) = {1}
# CHECK: DeclaredPart(L0#{{*}}, 0) = {undefined|1|"other"}
# CHECK-NOT: (namespace m1
# OBJECTS: L0#{{*}} mutations=[DeleteField, StoreAfterCreation] uses
# OBJECTS: namespace m1 mutations=[] uses
# LOCATIONS: Variable(g0) events=[StoredByOperation, StoredOtherValue]
# LOCATIONS: DeclaredPart(L0#{{*}}, 0) events=[{{*}}Deleted

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="library.js" displayPath="library.js" body=f1 exports=[{name="a" variable=g0}]
entry module=m0
layout L0 name="Record" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="a" module=m1 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = String string="other"
    PropSet v0, v1 key="a" mode=Sloppy
    v3 = PropDelete v0 key="a" mode=Sloppy
    PropDefine v0, v1 key="a"
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    PropSet v6, v1 key="a" mode=Sloppy
    v8 = PropDelete v6 key="a" mode=Sloppy
    PropDefine v6, v1 key="a"
    Return
}
function f1 name="library" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
