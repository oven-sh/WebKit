# An undeclared call hands a set, an array and an object under Error.prototype to unknown JavaScript, and their prototypes with them. A name that a lookup of the program passes as absent on one of those prototypes stays absent: the run time refuses whoever defines it, so a read and a store under such a name ask no unknown accessor, and the receiver and what it holds stay known. Error.prototype has no lock of its own: it is listed for the run time, which fixes its prototype link too
# RUN: flow-walk
# CHECK: f0@{{*}} v15 Get {"length"}
# CHECK-NEXT: Set@f0:v12{{*}}: Absent Proven
# CHECK-NEXT: f0@{{*}} v18 Set {"total"}
# CHECK-NEXT: Array@f0:v17: Value own Proven Array@f0:v17 "total"
# CHECK-NEXT: f0@{{*}} v21 Set {"node"}
# CHECK-NEXT: L1#{{*}}: Value own Proven L1#{{*}} "node"
# CHECK-NOT: Unknown
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[inSet]] mutations=[] uses
# OBJECTS: L0#[[inArray]] mutations=[] uses
# OBJECTS: Array@f0:v17 mutations=[AddProperty] uses
# OBJECTS: L0#[[inError]] mutations=[] uses
# OBJECTS: ErrorPrototype mutations=[ReachNativeCode, ReachUnknownJavaScript,
# RUN(TABLES): tables constants
# TABLES: holderOfClosedAbsentNames holder=ArrayPrototype
# TABLES-NEXT: closedAbsentName holder=ArrayPrototype name="total"
# TABLES-NEXT: holderOfClosedAbsentNames holder=ErrorPrototype
# TABLES-NEXT: closedAbsentName holder=ErrorPrototype name="node"
# TABLES-NEXT: holderOfClosedAbsentNames holder=SetPrototype
# TABLES-NEXT: closedAbsentName holder=SetPrototype name="length"
# TABLES-NOT: ClosedAbsentName

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="UnderError" fields=[]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=ArrayFrom
    v1 = Builtin builtin=Set
    v2 = Construct v1
    v3 = Call v0, -, v2
    v4 = NewArray contents=anything
    v5 = Call v0, -, v4
    v6 = Builtin builtin=ErrorPrototype
    v7 = NewObject v6 layout=L1 fields=[]
    v8 = Call v0, -, v7
    v9 = Integer integer=1
    v10 = NewObject -, v9 layout=L0 fields=[0]
    v11 = Undefined
    v12 = Construct v1
    v13 = PropGet v12 key="add"
    v14 = Call v13, v12, v10 calleeKey="add"
    v15 = PropGet v12 key="length"
    v16 = NewObject -, v9 layout=L0 fields=[0]
    v17 = NewArray v16 contents=anything
    PropSet v17, v9 key="total"
    v19 = NewObject v6 layout=L1 fields=[]
    v20 = NewObject -, v9 layout=L0 fields=[0]
    PropSet v19, v20 key="node"
    Return
  b1() role=CatchHandler:
    v22 = CatchValue
    Return
}
