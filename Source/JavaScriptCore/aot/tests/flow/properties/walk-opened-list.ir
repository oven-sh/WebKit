# Unseen JavaScript holds a list: a load by index still predicts what the program put into it, beside the unknown value, and a store by index still reaches its elements. A load under a key nobody names answers the unknown value alone
# RUN: flow-solve nodes
# CHECK: , f0, v11) = {{*}}unknown|f1|{{*}}f2
# CHECK: , f0, v15) = {undefined|null|boolean|number|string|symbol|bigint|unknown}

module m0 path="main.js" displayPath="main.js" body=f0
evalscope e0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="keep" [isFreeName]
    v4 = Call v3, -, v1
    v5 = PropGet v2 key="text" [isFreeName]
    v6 = Undefined
    v7 = DirectEval v5, v6 evalScope=e0
    v8 = Integer integer=0
    v9 = NewClosure function=f2
    ElemSet v1, v8, v9 mode=Strict
    v11 = ElemGet v1, v8
    v12 = Builtin builtin=MathRandom
    v13 = Call v12
    v14 = ToString v13
    v15 = ElemGet v1, v14
    Return
}
function f1 name="first" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="stored" results=[{type=anything}] {
  b0():
    Return
}
