# A module outside the image may add a name to a built-in prototype. A read of the program that finds its name nowhere says that somebody else supplies it: the name is not closed, the read answers unknown, and what supplies it may be a getter, which gets the receiver.
# A name that the program resolves itself stays closed: the store of a field under Error.prototype, and a read that a member of the table answers further up, whose name the table closes on every prototype below in every program
# RUN: flow-walk
# CHECK: f0@{{*}} v2 Get {"last"}
# CHECK: Array@f0:v1: Unknown Predicted ArrayPrototype
# CHECK: f0@{{*}} v5 Set {"node"}
# CHECK-NEXT: L0#{{*}}: Value own Proven L0#{{*}} "node"
# CHECK-NEXT: f0@{{*}} v7 Get {"hasOwnProperty"}
# CHECK-NEXT: Array@f0:v6: BuiltinMember Proven ObjectPrototype "hasOwnProperty"
# RUN(TABLES): tables constants
# TABLES: closedAbsentName holder=ErrorPrototype name="node"
# RUN(OPEN): tables constants
# OPEN-NOT: closedAbsentName holder=ArrayPrototype name="last"

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/uncompiled.js" displayPath="uncompiled.js" kind=External referrer=m0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="UnderError" fields=[]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    v2 = PropGet v1 key="last"
    v3 = Builtin builtin=ErrorPrototype
    v4 = NewObject v3 layout=L0 fields=[]
    PropSet v4, v0 key="node"
    v6 = NewArray v0 contents=anything
    v7 = PropGet v6 key="hasOwnProperty"
    PutModuleVariable v7 variable=g0
    Return
}
