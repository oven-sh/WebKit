# A String object has the characters of its string as own properties under indexes, whoever makes it: the constructor, a conversion to an object or a call of Object. A read by index on it or on an object that inherits from it answers a string or undefined, a copy of its properties defines strings under indexes, and what the program stores under an index lies beside the characters. A Number object has nothing under an index
# RUN: flow-solve nodes
# RUN(NUMBER): flow-solve nodes
# CHECK: , f0, v4) = {undefined|string}
# CHECK: , f0, v6) = {undefined|string}
# CHECK: , f0, v9) = {undefined|string}
# CHECK: , f0, v15) = {undefined}
# CHECK: , f0, v19) = {undefined|string}
# CHECK: , f0, v23) = {undefined|true|string}
# CHECK: IndexedProperties(L0#{{*}}) = {string}
# NUMBER-NOT: IndexedProperties(L1#
# NUMBER-NOT: IndexedProperties(Number@{{*}}string

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="CopyOfText"
layout L1 name="CopyOfNumber"
layout L2 name="HeirOfText"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=String
    v1 = String string="abc"
    v2 = Integer integer=1
    v3 = Construct v0, -, v1
    v4 = ElemGet v3, v2
    v5 = ToObject v1
    v6 = ElemGet v5, v2
    v7 = Builtin builtin=Object
    v8 = Call v7, -, v1
    v9 = ElemGet v8, v2
    v10 = Construct v0, -, v1
    v11 = NewObject layout=L0 fields=[]
    CopyDataProperties v11, v10
    v13 = Builtin builtin=Number
    v14 = Construct v13, -, v2
    v15 = ElemGet v14, v2
    v16 = NewObject layout=L1 fields=[]
    CopyDataProperties v16, v14
    v18 = NewObject v3 layout=L2 fields=[]
    v19 = ElemGet v18, v2
    v20 = Construct v0, -, v1
    v21 = Boolean boolean=true
    ElemSet v20, v2, v21 mode=Sloppy
    v23 = ElemGet v20, v2
    Return
}
