# Start-up locks length and every numeric key of Array.prototype, so a read or a store under them on an array asks no unknown code although the prototype has reached unseen JavaScript: the array and its elements stay known. A name that the program itself puts on the prototype stays open, and that name, or a key of unknown type, hands both over
# RUN: flow-walk
# CHECK: f0@i{{*}} v8 Get {"length"}
# CHECK-NEXT: Array@f0:v7: BuiltinGetter Proven ArrayPrototype "length" ArrayPrototypeLength
# CHECK-NEXT: f0@i{{*}} v14 Set {"length"}
# CHECK-NEXT: Array@f0:v7: BuiltinSetter Proven ArrayPrototype "length" ArrayPrototypeLength
# CHECK-NEXT: f0@i{{*}} v17 Get {"total"}
# CHECK: Array@f0:v16: Unknown Predicted ArrayPrototype *
# CHECK: f0@i{{*}} v23 Set {"total"}
# CHECK: Array@f0:v22: Unknown Predicted ArrayPrototype *
# CHECK: f0@i{{*}} v11 Get {[0,4294967294], number*}
# CHECK-NEXT: Array@f0:v7: Value own Proven Array@f0:v7 *
# CHECK-NEXT: Array@f0:v7: Value own Proven Array@f0:v7 *
# CHECK-NEXT: Array@f0:v7: Absent Proven
# CHECK-NEXT: f0@i{{*}} v13 Set {[0,4294967294], number*}
# CHECK-NEXT: Array@f0:v7: Value own Proven Array@f0:v7 *
# CHECK-NEXT: Array@f0:v7: Value own Proven Array@f0:v7 *
# CHECK-NEXT: f0@i{{*}} v20 Get {
# CHECK: Array@f0:v19: Unknown Predicted ArrayPrototype *
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[read]] mutations=[] uses
# OBJECTS-NEXT: Array@f0:v7 mutations=[AddProperty, StoreAfterCreation] uses
# OBJECTS-NEXT: L0#[[stored]] mutations=[] uses
# OBJECTS-NEXT: L0#[[underOpenName]] mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS-NEXT: Array@f0:v16 mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS-NEXT: L0#[[underUnknownKey]] mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS-NEXT: Array@f0:v19 mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS-NEXT: L0#[[besideOpenName]] mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS-NEXT: Array@f0:v22 mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS: ArrayPrototype mutations=[ReachNativeCode, ReachUnknownJavaScript,
# RUN(NODES): flow-solve nodes
# NODES-NOT: Property(Array@f0:v7, "length")
# NODES: Local(i{{*}}, f0, v11) = {undefined|L0#[[read]]|L0#[[stored]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = Call v1
    v3 = PropGet v0 key="Function" [isFreeName]
    v4 = Construct v3, -, v2
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = NewArray v6 contents=anything
    v8 = PropGet v7 key="length"
    v9 = Builtin builtin=MathRandom
    v10 = Call v9
    v11 = ElemGet v7, v10
    v12 = NewObject -, v5 layout=L0 fields=[0]
    ElemSet v7, v10, v12 mode=Strict
    PropSet v7, v5 key="length"
    v15 = NewObject -, v5 layout=L0 fields=[0]
    v16 = NewArray v15 contents=anything
    v17 = PropGet v16 key="total"
    v18 = NewObject -, v5 layout=L0 fields=[0]
    v19 = NewArray v18 contents=anything
    v20 = ElemGet v19, v2
    v21 = NewObject -, v5 layout=L0 fields=[0]
    v22 = NewArray v21 contents=anything
    PropSet v22, v5 key="total"
    v24 = Builtin builtin=ArrayPrototype
    PropSet v24, v5 key="total"
    Return
  b1() role=CatchHandler:
    v26 = CatchValue
    Return
}
