# The table lists length under Array.prototype, and it is an own property of each array. A record that inherits from an array finds a data property of another object there: its store defines a property of its own, converts nothing and moves no element. A store to the length of the array itself runs the setter
# RUN: flow-links builtins
# CHECK: builtin i{{*}} v9 ArrayPrototypeLength/{{*}} Set
# CHECK-NOT: ArrayPrototypeLength/{{*}} Set
# RUN(NODES): flow-solve nodes
# NODES: Property(L0#{{*}}, "length") = {L1#
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L1#{{*}} mutations=[] uses=[] events

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Inheritor" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything holes=[]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    SetLiteralPrototype v2, v1
    v4 = FinishObject v2
    v5 = NewObject -, v0 layout=L1 fields=[0]
    v6 = FinishObject v5
    PropSet v4, v6 key="length" mode=Strict
    v8 = NewArray v0 contents=anything holes=[]
    PropSet v8, v0 key="length" mode=Strict
    Return
  b1() role=CatchHandler:
    v10 = CatchValue
    Return
}
