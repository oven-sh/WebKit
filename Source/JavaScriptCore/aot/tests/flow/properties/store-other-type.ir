# What is stored outside the declared type of a field does not enter the field: it goes to the part for unnamed keys, where an untyped read of the name finds it. A store whose type as read fits changes nothing
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#[[outside]], 0) = {1}
# CHECK-NEXT: DeclaredPart(L0#[[inside]], 0) = {int[1, 2]}
# CHECK: Local(i{{*}}, f0, v9) = {1|"text"}
# CHECK: Local(i{{*}}, f0, v10) = {int[1, 2]}
# CHECK-NOT: StringProperties(L0#[[inside]])
# CHECK: StringProperties(L0#[[outside]]) = {"text"}
# CHECK-NOT: StringProperties(L0#[[inside]])
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#{{*}} mutations=[StoreAfterCreation, StoreOfOtherType] uses
# OBJECTS-NEXT: L0#{{*}} mutations=[StoreAfterCreation] uses
# RUN(LOCATIONS): flow-solve locations
# LOCATIONS: DeclaredPart(L0#{{*}}, 0) events=[{{*}}StoredOutsideType
# LOCATIONS-NEXT: DeclaredPart(L0#{{*}}, 0) events=[
# LOCATIONS-NOT: StoredOutsideType
# RUN(WALK): flow-walk f0
# WALK: f0@i{{*}} v9 Get {"n"}
# WALK-NEXT: L0#[[outside]]: Value own Proven L0#[[outside]] "n"
# WALK-NEXT: L0#[[outside]]: Value own Predicted L0#[[outside]] *
# WALK-NEXT: f0@i{{*}} v10 Get {"n"}
# WALK-NEXT: L0#[[inside]]: Value own Proven L0#[[inside]] "n"
# WALK-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Counter" fields=[{key="n" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = String string="text"
    v6 = CallDirect v2, v5 function=f1
    v7 = Integer integer=2
    v8 = CallDirect v4, v7 function=f2
    v9 = PropGet v2 key="n"
    v10 = PropGet v4 key="n"
    Return
  b1() role=CatchHandler:
    v11 = CatchValue
    Return
}
function f1 name="storeAnything" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="n" mode=Strict
    Return
}
function f2 name="storeNumber" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    PropSet v0, v1 key="n" mode=Strict
    Return
}
