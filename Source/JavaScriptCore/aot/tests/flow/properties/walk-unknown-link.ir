# Above a class whose heritage is an unknown value the chain is unknown: a name the instance and its prototype lack may be anything, and the instance reaches native code. A method of the class itself stays proven
# RUN: flow-walk f0
# CHECK: f0@i{{*}} v10 Get {"own"}
# CHECK: L0#[[derived]]: Value Proven f1.prototype "own"
# CHECK: f0@i{{*}} v11 Get {"missing"}
# CHECK: L0#[[derived]]: Unknown Predicted f1.prototype *
# CHECK: f0@i{{*}} v18 Get {"own"}
# CHECK-NEXT: L1#[[plain]]: Value Proven f3.prototype "own"
# CHECK-NEXT: f0@i{{*}} v19 Get {"missing"}
# CHECK-NEXT: L1#[[plain]]: Absent Proven
# RUN(SINKS): flow-solve sinks
# SINKS: nativeCode {{*}}L0#
# SINKS-NOT: L1#
# SINKS: unknownJavaScript {
# SINKS-NOT: L0#
# RUN(PLAIN): flow-solve sinks
# PLAIN-NOT: L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Derived" constructor=f1 flags=[HasHeritage]
layout L1 kind=Instance name="Plain" constructor=f3
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="makeBase" [isFreeName]
    v2 = Call v1
    v3 = NewClosure function=f1
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L0
    v6 = NewClosure function=f2
    DefineMethod v5, v6 layout=L0 key="own"
    v8 = FinishClass v5 layout=L0
    v9 = Construct v8
    v10 = PropGet v9 key="own"
    v11 = PropGet v9 key="missing"
    v12 = NewClosure function=f3
    v13 = NewClass v12 layout=L1
    v14 = NewClosure function=f4
    DefineMethod v13, v14 layout=L1 key="own"
    v16 = FinishClass v13 layout=L1
    v17 = Construct v16
    v18 = PropGet v17 key="own"
    v19 = PropGet v17 key="missing"
    Return
}
function f1 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    Return v3
}
function f2 name="own" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f4 name="own" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
