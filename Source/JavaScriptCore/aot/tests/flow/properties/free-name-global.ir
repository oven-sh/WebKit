# A free name is a property of the global object: a store of a global nobody declares creates the property, a read in another function finds it, and what is stored reaches no unknown code
# RUN: flow-walk
# RUN(NODES): flow-solve nodes
# RUN(SINKS): flow-solve sinks
# CHECK: f0@i{{*}} v3 Set {"shared"}
# CHECK-NEXT: GlobalThis: Value own Proven GlobalThis "shared"
# CHECK-NOT: Unknown
# CHECK: f1@i{{*}} v1 Get {"shared"}
# CHECK-NEXT: GlobalThis: Value own Proven GlobalThis "shared"
# CHECK-NOT: Unknown
# CHECK: f1@i{{*}} v3 Get {"missing"}
# CHECK-NEXT: GlobalThis: Unknown own Predicted GlobalThis *
# NODES: Variable(g0) = {{*}}L0#
# NODES-NOT: unknown
# NODES: Variable(g1) = {{*}}unknown}
# NODES: Property(GlobalThis, "shared") = {L0#{{*}}}
# NODES-NOT: Property(GlobalThis,
# SINKS-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Shared" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="readOfShared" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="readOfMissing" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v0, v2 key="shared" mode=Sloppy [isFreeName]
    v4 = NewClosure function=f1
    v5 = Call v4
    Return
}
function f1 name="reader" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="shared" [isFreeName]
    PutModuleVariable v1 variable=g0
    v3 = PropGet v0 key="missing" [isFreeName]
    PutModuleVariable v3 variable=g1
    Return
}
