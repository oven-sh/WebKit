# A member of a built-in prototype that can never change ends the lookup, during the solve as well: the read has no undefined. A name the prototype lacks goes on to the end of the chain
# RUN: flow-walk
# CHECK: f0@i{{*}} v2 Get {"push"}
# CHECK-NEXT: Array@f0:v1: BuiltinMember Proven ArrayPrototype "push" ArrayPrototypePush
# CHECK-NEXT: f0@i{{*}} v3 Get {"nope"}
# CHECK-NEXT: Array@f0:v1: Absent Proven
# CHECK-NEXT: f0@i{{*}} v4 Get {"toString"}
# CHECK-NEXT: Array@f0:v1: BuiltinMember Proven ArrayPrototype "toString" ArrayPrototypeToString
# CHECK-NOT: ObjectPrototype
# RUN(NODES): flow-solve nodes
# NODES: Local(i{{*}}, f0, v2) = {ArrayPrototypePush}
# NODES: Local(i{{*}}, f0, v3) = {undefined}
# NODES: Local(i{{*}}, f0, v4) = {ArrayPrototypeToString}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    v2 = PropGet v1 key="push"
    v3 = PropGet v1 key="nope"
    v4 = PropGet v1 key="toString"
    Return
  b1() role=CatchHandler:
    v5 = CatchValue
    Return
}
