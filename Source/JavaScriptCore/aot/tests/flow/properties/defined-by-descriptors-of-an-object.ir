# Object.defineProperties(target, Object.getOwnPropertyDescriptors(definition)) gives the target the own properties of the definition under their names: a value as a value, a getter as a getter.
# A map that anything else has seen (the program may have changed a descriptor in it), and the map of an object nobody follows, define anything
# RUN: flow
# CHECK: variable g0 type=undefined|3 
# CHECK: variable g1 type=undefined|f1 
# CHECK: variable g2 type=undefined|"perimeter" 
# CHECK: variable g3 type=4 
# CHECK: variable g4 type=anything
# CHECK: variable g5 type=anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="side" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="scale" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="perimeter" module=m0 declared={type=anything} initialization=Uninitialized
variable g3 name="sides" module=m0 declared={type=anything} initialization=Uninitialized
variable g4 name="throughEscapedMap" module=m0 declared={type=anything} initialization=Uninitialized
variable g5 name="ofUnknownObject" module=m0 declared={type=anything} initialization=Uninitialized
layout L0 name="Target" fields=[{key="sides" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Definition" fields=[{key="side" declared={type=anything} flags=[IsRequired]}, {key="scale" declared={type=anything} flags=[IsRequired]}]
layout L2 name="SecondTarget"
layout L3 name="ThirdTarget"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Integer integer=3
    v4 = NewClosure function=f1
    v5 = NewObject -, v3, v4 layout=L1 fields=[0, 1]
    v6 = NewClosure function=f2
    DefineGetter v5, v6 key="perimeter"
    v8 = FinishObject v5
    v9 = Builtin builtin=ObjectGetOwnPropertyDescriptors
    v10 = Call v9, -, v8
    v11 = Builtin builtin=ObjectDefineProperties
    v12 = Call v11, -, v2, v10
    v13 = PropGet v2 key="side"
    PutModuleVariable v13 variable=g0
    v15 = PropGet v2 key="scale"
    PutModuleVariable v15 variable=g1
    v17 = PropGet v2 key="perimeter"
    PutModuleVariable v17 variable=g2
    v19 = PropGet v2 key="sides"
    PutModuleVariable v19 variable=g3
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="unknown" [isFreeName]
    v23 = Call v9, -, v8
    v24 = Call v22, -, v23
    v25 = NewObject layout=L2
    v26 = Call v11, -, v25, v23
    v27 = PropGet v25 key="side"
    PutModuleVariable v27 variable=g4
    v29 = Call v9, -, v22
    v30 = NewObject layout=L3
    v31 = Call v11, -, v30, v29
    v32 = PropGet v30 key="side"
    PutModuleVariable v32 variable=g5
    Return
}
function f1 name="scale" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="perimeter" results=[{type=anything}] {
  b0():
    v0 = String string="perimeter"
    Return v0
}
