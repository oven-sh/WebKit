# What the program itself puts on a built-in prototype is counted and stays open, whichever the solver sees first, the lookup or the store: the read finds the value, unseen code may have put an accessor there, and the run time is told nothing about the name. A store under another name on an array looks for a setter on the same prototype, and closes that name there
# OPTIONS: admit=RuntimeCode
# RUN: flow-walk
# CHECK: v8 Get {"extra"}
# CHECK: Array@f0:v7: Value Predicted ArrayPrototype "extra"
# CHECK: Array@f0:v7: Unknown Predicted ArrayPrototype *
# CHECK: v13 Set {"other"}
# CHECK-NEXT: Array@f0:v12: Value own Proven Array@f0:v12 "other"
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[underOpenName]] mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS: L0#[[underClosedName]] mutations=[] uses
# RUN(TABLES): tables constants
# TABLES-NOT: closedAbsentName holder=ArrayPrototype name="extra"
# TABLES: closedAbsentName holder=ArrayPrototype name="other"
# TABLES-NOT: closedAbsentName holder=ArrayPrototype name="extra"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = Call v1
    v3 = PropGet v0 key="Function" [isFreeName]
    v4 = Construct v3, -, v2
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = NewArray v6 contents=anything
    v8 = PropGet v7 key="extra"
    v9 = Builtin builtin=ArrayPrototype
    PropSet v9, v5 key="extra"
    v11 = NewObject -, v5 layout=L0 fields=[0]
    v12 = NewArray v11 contents=anything
    PropSet v12, v5 key="other"
    Return
  b1() role=CatchHandler:
    v14 = CatchValue
    Return
}
