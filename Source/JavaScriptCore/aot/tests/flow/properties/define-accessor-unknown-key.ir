# A getter under a key nobody can name has no node: its holder and the function reach unknown JavaScript. Under one of two names it has two nodes and nothing escapes
# RUN: flow-solve objects
# RUN(NODES): flow-solve nodes
# RUN(SINKS): flow-solve sinks

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="UnderAnyString" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="UnderIndex" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 name="UnderTwoNames" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=MathRandom
    v2 = Call v1
    v3 = ToString v2
    v4 = ToPropertyKey v3
    v5 = NewObject -, v0 layout=L0 fields=[0]
    v6 = NewClosure function=f1
    DefineGetter v5, v6, v4
    v8 = NewObject -, v0 layout=L1 fields=[0]
    v9 = NewClosure function=f2
    DefineGetter v8, v9 key="0"
    v11 = ToBoolean v2
    Branch v11 -> taken b1(), notTaken b2()
  b1():
    v12 = String string="a"
    Jump -> next b3(v12)
  b2():
    v13 = String string="b"
    Jump -> next b3(v13)
  b3(v14):
    v15 = ToPropertyKey v14
    v16 = NewObject -, v0 layout=L2 fields=[0]
    v17 = NewClosure function=f3
    DefineGetter v16, v17, v15
    Return
}
function f1 name="underAnyString" kind=Getter flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="underIndex" kind=Getter flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="underTwoNames" kind=Getter flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
# CHECK: L0#{{*}} mutations=[{{*}}ReachUnknownJavaScript{{*}}RedefineProperty
# CHECK: f1 mutations=[{{*}}ReachUnknownJavaScript
# CHECK: L1#{{*}} mutations=[{{*}}ReachUnknownJavaScript{{*}}RedefineProperty
# CHECK: f2 mutations=[{{*}}ReachUnknownJavaScript
# CHECK: L2#{{*}} mutations=[] uses=
# CHECK: f3 mutations=[] uses=
# NODES-NOT: Getter(L0#
# NODES-NOT: Getter(L1#
# NODES: Getter(L2#[[names]], "a") = {f3}
# NODES: Getter(L2#[[names]], "b") = {f3}
# NODES-NOT: Getter(L0#
# NODES-NOT: Getter(L1#
# SINKS-NOT: L2#
# SINKS-NOT: f3
# SINKS: unknownJavaScript {{*}}L0#{{*}}f1{{*}}L1#{{*}}f2
# SINKS-NOT: L2#
# SINKS-NOT: f3
