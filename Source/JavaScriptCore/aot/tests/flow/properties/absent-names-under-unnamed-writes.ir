# The program writes a built-in prototype under a key nobody can name, with the prototype itself as the receiver. Any name may be what it writes, so nothing is closed on that prototype, and a lookup that passes it asks the unknown accessor. A store through an object nobody knows closes nothing open: Set.prototype keeps its closed name
# OPTIONS: admit=RuntimeCode
# RUN: flow-walk
# CHECK: v10 Get {"other"}
# CHECK: Array@f0:v7: Unknown Predicted ArrayPrototype *
# CHECK: v17 Set {"other"}
# CHECK-NEXT: Set@f0:v13{{*}}: Value own Proven Set@f0:v13{{*}} "other"
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#[[inArray]] mutations=[ReachNativeCode, ReachUnknownJavaScript,
# OBJECTS: L0#[[inSet]] mutations=[] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Item" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = Call v1
    v3 = PropGet v0 key="Function" [isFreeName]
    v4 = Construct v3, -, v2
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = NewArray v6 contents=anything
    v8 = Builtin builtin=ArrayPrototype
    ElemSet v8, v2, v5 mode=Sloppy
    v10 = PropGet v7 key="other"
    v11 = NewObject -, v5 layout=L0 fields=[0]
    v12 = Builtin builtin=Set
    v13 = Construct v12
    v14 = PropGet v13 key="add"
    v15 = Call v14, v13, v11 calleeKey="add"
    ElemSet v4, v2, v5 mode=Sloppy
    PropSet v13, v5 key="other"
    Return
  b1() role=CatchHandler:
    v18 = CatchValue
    Return
}
