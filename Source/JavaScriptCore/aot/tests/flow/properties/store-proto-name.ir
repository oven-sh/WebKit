# A store under the name __proto__ finds the accessor of Object.prototype, which changes the prototype and defines nothing. On an object with a null prototype nothing is found, and the same store defines a property
# RUN: flow-walk prototypes
# CHECK: f0@i{{*}} v5 Set {"__proto__"}
# CHECK-NEXT: L0#[[child]]: BuiltinSetter {{*}} ObjectPrototype "__proto__" ObjectPrototype__proto__
# CHECK-NEXT: f0@i{{*}} v12 Set {"__proto__"}
# CHECK-NEXT: L2#[[bare]]: Value own Proven L2#[[bare]] "__proto__"
# CHECK-NEXT: L0#[[child]] -> L1#[[parent]], ObjectPrototype
# CHECK: L2#[[bare]] -> null
# CHECK-NOT: unknown
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L0#{{*}} mutations=[ChangePrototype] uses
# OBJECTS-NEXT: L1#{{*}} mutations=[BecomePrototype] uses
# OBJECTS-NEXT: L2#{{*}} mutations=[AddProperty] uses
# OBJECTS-NEXT: L1#{{*}} mutations=[] uses
# RUN(NODES): flow-solve nodes
# NODES-NOT: Property(L0#
# NODES: Property(L2#{{*}}, "__proto__") = {L1#
# NODES-NOT: Property(L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Child" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Parent" fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Bare" fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    PropSet v2, v4 key="__proto__" mode=Strict
    v6 = NewObject -, v0 layout=L2 fields=[0]
    v7 = Null
    SetLiteralPrototype v6, v7
    v9 = FinishObject v6
    v10 = NewObject -, v0 layout=L1 fields=[0]
    v11 = FinishObject v10
    PropSet v9, v11 key="__proto__" mode=Strict
    Return
  b1() role=CatchHandler:
    v13 = CatchValue
    Return
}
