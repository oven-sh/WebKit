# A store of an object under an unknown string key through the unknown object may run the setter of __proto__ on whatever has escaped, so the prototype link of an escaped record is no longer fixed. A record that stays in the program keeps its link
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[ReachNativeCode, ChangePrototype] uses
# CHECK-NEXT: L1#{{*}} mutations=[] uses
# RUN(WALK): flow-walk f0 prototypes
# WALK: v13 Set {
# WALK: unknown: BuiltinSetter Predicted ObjectPrototype "__proto__" ObjectPrototype__proto__
# WALK: unknown -> L2#
# RUN(RESULTS): flow
# RESULTS: class {{*}} layout=L0 impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, StoreOfOtherType, LoseShape]
# RESULTS: class {{*}} layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Escaped" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Stored" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="identity" [isFreeName]
    v2 = Builtin builtin=MathRandom
    v3 = Call v2
    v4 = ToString v3
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = NewObject -, v5 layout=L1 fields=[0]
    v9 = FinishObject v8
    v10 = NewObject -, v5 layout=L2 fields=[0]
    v11 = FinishObject v10
    v12 = Call v1, -, v7
    ElemSet v12, v4, v11 mode=Strict
    Return
  b1() role=CatchHandler:
    v14 = CatchValue
    Return
}
