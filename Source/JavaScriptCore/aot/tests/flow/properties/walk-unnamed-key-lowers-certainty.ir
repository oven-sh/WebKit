layout L5 kind=Instance name="Branch" predictedBase=L0 constructor=f7 flags=[HasHeritage]
layout L6 kind=Instance name="Label" predictedBase=L0 constructor=f8 flags=[HasHeritage]
variable g0 name="node" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
