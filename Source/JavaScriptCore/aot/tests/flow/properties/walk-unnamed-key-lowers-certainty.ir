    v21 = NewClass v20, v4, v5 layout=L5
    v22 = FinishClass v21 layout=L5
    v23 = NewClosure function=f8
    v24 = NewClass v23, v4, v5 layout=L6
    v25 = FinishClass v24 layout=L6
    v26 = Construct v10
    PutModuleVariable v26 variable=g0
    v28 = Construct v13
    PutModuleVariable v28 variable=g0
    v30 = Construct v16
    PutModuleVariable v30 variable=g0
    v32 = Construct v19
    PutModuleVariable v32 variable=g0
    v34 = Construct v22
    PutModuleVariable v34 variable=g0
    v36 = Construct v25
    PutModuleVariable v36 variable=g0
    v38 = Builtin builtin=MathRandom
    v39 = Call v38
    v40 = ToString v39
    v41 = PropGet v26 key="tag"
    v42 = Call v41, v26, v40 calleeKey="tag"
    v43 = GetModuleVariable variable=g0
    v44 = PropGet v43 key="getText"
    Return
  b1() role=CatchHandler:
    v45 = CatchValue
    Return
}
