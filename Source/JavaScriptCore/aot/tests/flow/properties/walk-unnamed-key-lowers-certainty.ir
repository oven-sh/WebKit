# A store under an unknown string key lowers what its receivers find by name to predicted and does not end the lookup. Instances of the five sibling classes keep their proofs
# RUN: flow-walk f0
# CHECK: f0@i{{*}} v44 Get {"getText"}
# CHECK: L1#[[tagged]]: Value own Predicted L1#[[tagged]] *
# CHECK-NEXT: L1#[[tagged]]: Value Predicted f1.prototype "getText"
# CHECK-NEXT: L1#[[tagged]]: Absent Predicted
# RUN(SIBLINGS): flow-walk f0
# SIBLINGS: f0@i{{*}} v44 Get {"getText"}
# SIBLINGS-NOT: L1#{{*}}: Value Proven
# SIBLINGS-COUNT-5: : Value Proven f1.prototype "getText"
# SIBLINGS-NOT: L1#{{*}}: Value Proven
# RUN(OBJECTS): flow-solve objects
# OBJECTS-COUNT-1: events=[Allocated, AllocatedByConstructor, StoredByUnknownKey
# OBJECTS-NOT: StoredByUnknownKey

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Node" constructor=f1
layout L1 kind=Instance name="Identifier" predictedBase=L0 constructor=f3 flags=[HasHeritage]
layout L2 kind=Instance name="Literal" predictedBase=L0 constructor=f4 flags=[HasHeritage]
