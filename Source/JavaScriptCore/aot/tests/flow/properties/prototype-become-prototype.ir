# An object handed to Object.create becomes a prototype and nothing else happens to it, also when nobody reads the result. An object stored under a number does not: no number names __proto__
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[BecomePrototype] uses
# CHECK: L1#{{*}} mutations=[] uses
# CHECK: L2#{{*}} mutations=[AddProperty] uses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Typed" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Dictionary"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, -, v1
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = NewObject layout=L2 fields=[]
    v6 = Builtin builtin=MathRandom
    v7 = Call v6
    ElemSet v5, v7, v4 mode=Strict
    Return
}
