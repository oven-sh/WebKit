# A read under an unknown string finds each field of the literal and each member of Object.prototype. Nothing about it is unknown, so the argument of the call stays away from unknown JavaScript
# RUN: flow-walk
# CHECK: f0@i{{*}} v10 Get {[0,4294967294], string*}
# CHECK-NEXT: L0#[[handlers]]: Value own Proven L0#[[handlers]] "get"
# CHECK-NEXT: L0#[[handlers]]: Value own Proven L0#[[handlers]] "put"
# CHECK-NEXT: L0#[[handlers]]: Value own Proven L0#[[handlers]] "remove"
# CHECK-COUNT-12: L0#[[handlers]]: Builtin{{*}} Proven ObjectPrototype "
# CHECK-NEXT: L0#[[handlers]]: Absent Proven
# RUN(KNOWN): flow-walk
# KNOWN-NOT: Unknown
# RUN(MEMBERS): flow-walk
# MEMBERS: BuiltinGetter Proven ObjectPrototype "__proto__" ObjectPrototype__proto__
# MEMBERS: BuiltinMember Proven ObjectPrototype "hasOwnProperty" ObjectPrototypeHasOwnProperty
# MEMBERS: BuiltinMember Proven ObjectPrototype "toString" ObjectPrototypeToString
# RUN(LINKS): flow-links calls
# LINKS: f0 v13 -> i{{*}} f1 Call
# LINKS: f0 v13 -> i{{*}} f2 Call
# LINKS: f0 v13 -> i{{*}} f3 Call
# LINKS-NOT: f0 v13 -> i{{*}} f4
# RUN(SINKS): flow-solve sinks
# SINKS: unknownJavaScript {
# SINKS-NOT: L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Handlers" fields=[{key="get" declared={type=anything} flags=[IsRequired]}, {key="put" declared={type=anything} flags=[IsRequired]}, {key="remove" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Request" fields=[{key="url" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewObject -, v0, v1, v2 layout=L0 fields=[0, 1, 2]
    v5 = FinishObject v4
    v6 = Builtin builtin=MathRandom
    v7 = Call v6
    v8 = ToString v7
    v9 = String string="/"
    v10 = ElemGet v5, v8
    v11 = NewObject -, v9 layout=L1 fields=[0]
    v12 = FinishObject v11
    v13 = Call v10, v5, v12
    Return
  b1() role=CatchHandler:
    v14 = CatchValue
    Return
}
function f1 name="get" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="put" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="remove" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="neverStored" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
