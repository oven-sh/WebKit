# A conversion to a primitive looks for valueOf and toString in one walk. On Function.prototype nobody can add the first. The second is a member of the language that the table leaves open, because real packages replace it: once the holder has been opened it may hold anything, so the converted function is handed to whatever stands there
# RUN: flow-solve sinks
# RUN(RESULTS): flow
# CHECK: nativeCode {{*}}f1,
# CHECK: unknownJavaScript {{*}}FunctionPrototype
# RESULTS: function f1 cause=ReachesNativeCode witness={function=f0 value=v2}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="text" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=String
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key=@"nativeThatNobodyDescribed"
    v6 = NewClosure function=f2
    v7 = Call v5, -, v6
    Return
}
function f1 name="converted" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="handedOver" results=[{type=anything}] {
  b0():
    Return
}
