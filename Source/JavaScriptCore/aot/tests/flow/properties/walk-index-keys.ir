# An index finds the positions of a short list, the element slot behind them, or the indexed part of a record, also when it is written as a name. A name that is no index never reads the indexed part
# RUN: flow-walk
# CHECK: f0@i{{*}} v17 Get {"x"}
# CHECK-NEXT: L0#[[record]]: Value own Proven L0#[[record]] "x"
# CHECK-NEXT: f0@i{{*}} v18 Get {[0,0]}
# CHECK-NEXT: L0#[[record]]: Value own Predicted L0#[[record]] *
# CHECK-NEXT: L0#[[record]]: Absent Predicted
# CHECK-NEXT: f0@i{{*}} v6 Get {[0,0]}
# CHECK-NEXT: Array@f0:v2: Value own Proven Array@f0:v2 *
# CHECK-NEXT: f0@i{{*}} v11 Get {[0,5]}
# CHECK-NEXT: Array@f0:v2: Value own Proven Array@f0:v2 *
# CHECK-NEXT: Array@f0:v2: Value own Proven Array@f0:v2 *
# CHECK-NEXT: Array@f0:v2: Value own Proven Array@f0:v2 *
# CHECK-NEXT: Array@f0:v2: Absent Proven
# CHECK-NEXT: f0@i{{*}} v15 Set {[1,1]}
# CHECK: f0@i{{*}} v16 Get {[0,0]}
# CHECK-NEXT: L0#[[record]]: Value own Predicted L0#[[record]] *
# CHECK-NEXT: L0#[[record]]: Absent Predicted
# RUN(NODES): flow-solve nodes
# NODES: Local(i{{*}}, f0, v6) = {"a"}
# NODES: Local(i{{*}}, f0, v11) = {undefined|"a"|"b"}
# NODES: Local(i{{*}}, f0, v16) = {undefined|"s"}
# NODES: Local(i{{*}}, f0, v17) = {1}
# NODES: Local(i{{*}}, f0, v18) = {undefined|"s"}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b4():
    v0 = String string="a"
    v1 = String string="b"
    v2 = NewArray v0, v1 contents=anything
    v3 = Integer integer=0
    v4 = Integer integer=5
    v5 = Integer integer=1
    v6 = ElemGet v2, v3
    v7 = Builtin builtin=MathRandom
    v8 = Call v7
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b2()
  b1() handler=b4():
    Jump -> next b3(v3)
  b2() handler=b4():
    Jump -> next b3(v4)
  b3(v10) handler=b4():
    v11 = ElemGet v2, v10
    v12 = NewObject -, v5 layout=L0 fields=[0]
    v13 = FinishObject v12
    v14 = String string="s"
    ElemSet v13, v5, v14 mode=Strict
    v16 = ElemGet v13, v3
    v17 = PropGet v13 key="x"
    v18 = PropGet v13 key="0"
    Return
  b4() role=CatchHandler:
    v19 = CatchValue
    Return
}
