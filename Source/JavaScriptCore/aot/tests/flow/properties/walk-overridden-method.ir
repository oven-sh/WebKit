# A receiver of the subclass finds only the overriding method, on the finished solution and during the solve: the call does not link the overridden method
# RUN: flow-walk f0 f5
# CHECK: f0@i{{*}} v15 Get {"m"}
# CHECK: L0#{{*}}: Value Proven f1.prototype "m"
# CHECK: f5@i{{*}} v1 Get {"m"}
# CHECK-NEXT: L1#{{*}}: Value Proven f3.prototype "m"
# CHECK-NOT: f1.prototype
# RUN(OVERRIDING): flow-links calls
# OVERRIDING: f5 v2 -> i{{*}} f4 Call
# RUN(OVERRIDDEN): flow-links calls
# OVERRIDDEN-NOT: f5 v2 -> i{{*}} f2 Call
# RUN(BASE): flow-solve nodes
# BASE: Local(i{{*}}, f2, parameter 0) = {L0#[[a]]}
# RUN(SUBCLASS): flow-solve nodes
# SUBCLASS: Local(i{{*}}, f4, parameter 0) = {L1#[[b]]}
# RUN(CALLER): flow-solve nodes
# CALLER: Local(i{{*}}, f5, parameter 0) = {L1#[[b]]}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" predictedBase=L0 constructor=f3 flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f3
    v6 = ResolveHeritage v4
    v7 = NewClass v5, v4, v6 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="m"
    v10 = NewClosure function=f5
    DefineMethod v7, v10 layout=L1 index=1 key="run"
    v12 = FinishClass v7 layout=L1
    v13 = Construct v4
    v14 = Construct v12
    v15 = PropGet v13 key="m"
    v16 = Call v15, v13 calleeKey="m"
    v17 = PropGet v14 key="run"
    v18 = Call v17, v14 calleeKey="run"
    Return
  b1() role=CatchHandler:
    v19 = CatchValue
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="m" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f4 name="m" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="run" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
