# Unseen JavaScript defines accessors on a built-in prototype under a name that the program itself puts there, which stays open, so a lookup that passes it answers Unknown and hands over the receiver and a stored value; a locked member, a closed index and Function.prototype, which takes no name, answer as without it
# RUN: flow-walk f2
# CHECK: f2@i{{*}} v1 Get {"label"}
# CHECK: Map@f1:v1.{{*}}: Unknown Predicted MapPrototype *
# RUN(SET): flow-walk f3
# SET: f3@i{{*}} v2 Set {"label"}
# SET: Map@f1:v3.{{*}}: Unknown Predicted MapPrototype *
# RUN(MEMBER): flow-walk f4
# MEMBER: f4@i{{*}} v1 Get {"get"}
# MEMBER-NEXT: Map@f1:v7.{{*}}: BuiltinMember Proven MapPrototype "get" MapPrototypeGet
# RUN(FUNCTION): flow-walk f5
# FUNCTION: f5@i{{*}} v1 Get {"label"}
# FUNCTION-NEXT: f6{{*}}: Absent Proven
# RUN(INDEX): flow-walk f7
# INDEX: f7@i{{*}} v2 Get {[0,0]}
# INDEX-NEXT: Map@f1:v11.{{*}}: Absent Proven
# RUN(READ): flow-solve sinks
# READ: unknownJavaScript {unknown{{*}}Map@f1:v1.
# RUN(STORED): flow-solve sinks
# STORED: unknownJavaScript {unknown{{*}}Map@f1:v3.
# RUN(VALUE): flow-solve sinks
# VALUE: unknownJavaScript {unknown{{*}}L0#
# RUN(KEPT): flow-solve sinks
# KEPT-NOT: Map@f1:v7.
# KEPT-NOT: Map@f1:v11.
# KEPT-NOT: f6

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Stored" fields=[{key="s" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="eval" [isFreeName]
    v3 = Call v2, -, v1
    v4 = CallDirect function=f1
    v5 = Builtin builtin=MapPrototype
    PropSet v5, v1 key="label"
    Return
}
function f1 name="makes" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    v2 = CallDirect v1 function=f2
    v3 = Construct v0
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = CallDirect v3, v5 function=f3
    v7 = Construct v0
    v8 = CallDirect v7 function=f4
    v9 = NewClosure function=f6
    v10 = CallDirect v9 function=f5
    v11 = Construct v0
    v12 = CallDirect v11 function=f7
    Return
}
function f2 name="readsName" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="label"
    Return v1
}
function f3 name="storesName" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="label" mode=Strict
    Return
}
function f4 name="readsLockedMember" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="get"
    Return v1
}
function f5 name="readsNameOfClosure" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="label"
    Return v1
}
function f6 name="closure" results=[{type=anything}] {
  b0():
    Return
}
function f7 name="readsIndex" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    Return v2
}
