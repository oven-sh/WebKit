# What is stored in a data property that an instance of a built-in class is created with comes back from a read through an object that inherits from the instance, at any depth,
# and the fields of the object that comes back count as read. An heir of the prototype alone finds no instance
# RUN: flow-solve nodes
# RUN(RESULTS): flow
# CHECK: , f0, v7) = {int[0, 9007199254740991]|L0#[[stored]]}
# CHECK: , f0, v8) = {undefined|7}
# CHECK: , f0, v10) = {int[0, 9007199254740991]|L0#[[stored]]}
# CHECK: , f0, v13) = {undefined|null|boolean|number|string|symbol|bigint|unknown}
# RESULTS: field L0.0 "tag"
# RESULTS-NOT: reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a" regExpFlags=[Global]
    v1 = Integer integer=7
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v0, v2 key="lastIndex"
    v4 = Builtin builtin=Object
    v5 = Builtin builtin=ObjectCreate
    v6 = Call v5, v4, v0
    v7 = PropGet v6 key="lastIndex"
    v8 = PropGet v7 key="tag"
    v9 = Call v5, v4, v6
    v10 = PropGet v9 key="lastIndex"
    v11 = Builtin builtin=RegExpPrototype
    v12 = Call v5, v4, v11
    v13 = PropGet v12 key="lastIndex"
    Return v8
}
