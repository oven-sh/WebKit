# An export that is the namespace of another module reads as that module's namespace object, and a read on it finds that module's variable
# RUN: flow-walk f0
# RUN(NODES): flow-solve nodes
# CHECK: f0@i{{*}} v1 Get {"inner"}
# CHECK-NEXT: namespace m1: Value own Proven namespace m1 "inner"
# CHECK-NEXT: f0@i{{*}} v2 Get {"x"}
# CHECK-NEXT: namespace m2: Value own Proven namespace m2 "x"
# CHECK-NEXT: f0@i{{*}} v4 Get {"x"}
# CHECK-NEXT: namespace m1: Absent Proven
# CHECK-NOT: namespace m
# NODES: Variable(g0) = {7}
# NODES: Variable(g1) = {7}
# NODES: Variable(g2) = {undefined}
# NODES: Property(namespace m1, "inner") = {namespace m2}

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="outer.js" displayPath="outer.js" body=f1 requests=[{target=m2}] exports=[{name="inner" kind=Namespace module=m2}]
module m2 path="inner.js" displayPath="inner.js" body=f2 exports=[{name="x" variable=g0}]
entry module=m0
variable g0 name="x" module=m2 declared={type=anything}
variable g1 name="readThroughInner" module=m0 declared={type=anything}
variable g2 name="readOnOuter" module=m0 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="inner"
    v2 = PropGet v1 key="x"
    PutModuleVariable v2 variable=g1
    v4 = PropGet v0 key="x"
    PutModuleVariable v4 variable=g2
    Return
}
function f1 name="outer" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="inner" module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    PutModuleVariable v0 variable=g0
    Return
}
