# A call through a namespace object under an unknown string finds each export and the mark of `require` by value and links the exported functions, and nothing reaches unknown code
# RUN: flow-walk f0
# RUN(LINKS): flow-links calls unknown
# RUN(HELPER): flow-links calls
# RUN(SINKS): flow-solve sinks
# CHECK: f0@i{{*}} v4 Get
# CHECK-NEXT: namespace m1: Value own Proven namespace m1 "build"
# CHECK-NEXT: namespace m1: Value own Proven namespace m1 "clean"
# CHECK-NEXT: namespace m1: Value own Proven namespace m1 "version"
# CHECK-NEXT: namespace m1: Value {{*}}"__esModule"
# CHECK-NEXT: namespace m1: Absent Proven
# CHECK-NOT: namespace m1:
# LINKS: f0 v7 -> {{*}} f2 Call
# LINKS: f0 v7 -> {{*}} f3 Call
# LINKS-NOT: f0 v7 ->
# LINKS-NOT: unknown-callee {{*}} v7
# HELPER-NOT: f4
# SINKS-NOT: namespace m1
# SINKS-NOT: L0#
# SINKS-NOT: , f2
# SINKS-NOT: , f3
# SINKS-NOT: , f4

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="commands.js" displayPath="commands.js" body=f1 exports=[{name="build" variable=g0}, {name="clean" variable=g1}, {name="version" variable=g2}]
entry module=m0
layout L0 name="Arguments" fields=[{key="verbose" declared={type=anything} flags=[IsRequired]}]
variable g0 name="build" module=m1 declared={type=anything}
variable g1 name="clean" module=m1 declared={type=anything}
variable g2 name="version" module=m1 declared={type=anything}
variable g3 name="helper" module=m1 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="name" [isFreeName]
    v3 = ToString v2
    v4 = ElemGet v0, v3
    v5 = Boolean boolean=true
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = Call v4, v0, v6
    Return
}
function f1 name="commands" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f3
    PutModuleVariable v2 variable=g1
    v4 = String string="1.0"
    PutModuleVariable v4 variable=g2
    v6 = NewClosure function=f4
    PutModuleVariable v6 variable=g3
    Return
}
function f2 name="build" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="clean" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="helper" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
