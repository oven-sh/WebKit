# A store under an unknown string key reaches the receiver under every string and nothing else. One of those strings is __proto__, so an object that is stored joins the prototype link of the receiver. What is stored keeps its own link and fields, and another object of the receiver's layout is untouched
# RUN: flow-solve objects
# CHECK: L1#{{*}} mutations=[BecomePrototype] uses
# CHECK-NEXT: L0#{{*}} mutations=[AddProperty, ChangePrototype, StoreAfterCreation, StoreOfOtherType] uses={{*}} events=[Allocated, StoredByUnknownKey, StoredByComputedKey]
# CHECK-NEXT: L0#{{*}} mutations=[] uses={{*}} events=[Allocated]
# RUN(NODES): flow-solve nodes
# NODES: DeclaredPart(L0#[[byId]], 0) = {undefined|L1#[[user]]}
# NODES-NEXT: DeclaredPart(L0#[[byId]], 1) = {0}
# NODES-NEXT: DeclaredPart(L0#[[other]], 0) = {undefined}
# NODES-NEXT: DeclaredPart(L0#[[other]], 1) = {0}
# NODES: StringProperties(L0#[[byId]]) = {L1#[[user]]}
# RUN(LOCATIONS): flow-solve locations
# LOCATIONS-NOT: DeclaredPart(L0#{{*}}, 0) events=[{{*}}StoredOutsideType
# LOCATIONS: DeclaredPart(L0#[[byId]], 1) events=[{{*}}StoredOutsideType
# LOCATIONS-NOT: StoredOutsideType
# RUN(LINKS): flow-walk f0 prototypes
# LINKS: v13 Get {"id"}
# LINKS: L0#[[byId]]: Value Predicted L1#[[user]] "id"
# LINKS: L0#[[byId]] -> L1#[[user]], ObjectPrototype
# LINKS-NOT: -> L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Index" fields=[{key="first" declared={type=anything} flags=[IsRequired]}, {key="count" declared={type=number} flags=[IsRequired]}]
layout L1 name="User" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Undefined
    v6 = Integer integer=0
    v7 = NewObject -, v5, v6 layout=L0 fields=[0, 1]
    v8 = FinishObject v7
    v9 = NewObject -, v5, v6 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = PropGet v4 key="id"
    ElemSet v8, v11, v4 mode=Strict
    v13 = PropGet v8 key="id"
    Return
  b1() role=CatchHandler:
    v14 = CatchValue
    Return
}
