# Reflect.set under an unknown string key and Object.assign from parsed data store with [[Set]], so both may run the setter of __proto__ on their target. A spread of the same data defines own properties and changes no prototype
# RUN: flow-solve objects
# CHECK: L0#{{*}} mutations=[AddProperty, ChangePrototype, StoreAfterCreation] uses
# CHECK-NEXT: L1#{{*}} mutations=[BecomePrototype] uses
# CHECK-NEXT: L2#{{*}} mutations=[AddProperty, ChangePrototype, StoreAfterCreation] uses
# CHECK-NEXT: L3#{{*}} mutations=[AddProperty, StoreAfterCreation] uses
# RUN(LINKS): flow-walk prototypes
# LINKS: L0#{{*}} -> L1#{{*}}, ObjectPrototype
# LINKS: L2#{{*}} -> {{*}}Object@f0:v14{{*}}ObjectPrototype
# LINKS-NOT: L3#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="SetByReflect" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="inherited" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Assigned" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Spread" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewObject -, v3 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = NewObject -, v3 layout=L2 fields=[0]
    v9 = FinishObject v8
    v10 = NewObject -, v3 layout=L3 fields=[0]
    v11 = Builtin builtin=ReflectSet
    v12 = Call v11, -, v5, v2, v7
    v13 = Builtin builtin=JSONParse
    v14 = Call v13, -, v2
    v15 = Builtin builtin=ObjectAssign
    v16 = Call v15, -, v9, v14
    CopyDataProperties v10, v14
    v18 = FinishObject v10
    Return
  b1() role=CatchHandler:
    v19 = CatchValue
    Return
}
