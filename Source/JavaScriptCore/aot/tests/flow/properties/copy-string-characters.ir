# A spread of a string defines its characters under indexes, a spread of a number defines nothing
# RUN: flow-solve nodes objects

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="OfString"
layout L1 name="OfNumber"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = NewObject layout=L0 fields=[]
    CopyDataProperties v1, v0
    v3 = Integer integer=7
    v4 = NewObject layout=L1 fields=[]
    CopyDataProperties v4, v3
    Return
}
# CHECK-NOT: Properties(L1#
# CHECK: IndexedProperties(L0#[[characters]]) = {string}
# CHECK-NOT: Properties(L1#
# CHECK-NOT: StringProperties(L0#
# CHECK: L0#[[characters]] mutations=[AddProperty] uses=[] events=[Allocated, CopiedUnderUnknownKeys]
# CHECK: L1#{{*}} mutations=[] uses=[] events=[Allocated]
