# node:buffer hands out the constructors of the realm under `Buffer` and `Blob`: a read of the export answers the built-in, its members are found as through the global name, and nothing is unknown
# RUN: flow
# RUN(ALL): flow
# CHECK: builtin-location NodeBuffer."Buffer" Constant
# CHECK: builtin-location NodeBuffer."Blob" Constant
# CHECK: builtin-location Buffer."from" Constant
# CHECK: builtin-use Blob [Constructed] f0:v
# CHECK: builtin-use BufferFrom [Read, Called] f0:v2
# ALL-NOT: cause=UnknownObject
# ALL-NOT: cause=UnknownCallee
# ALL-NOT: builtin-use ArrayFrom

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=NodeBuffer
    v1 = PropGet v0 key="Buffer"
    v2 = PropGet v1 key="from"
    v3 = String string="abc"
    v4 = Call v2, v1, v3 calleeKey="from"
    v5 = PropGet v0 key="Blob"
    v6 = Construct v5
    Return
}
