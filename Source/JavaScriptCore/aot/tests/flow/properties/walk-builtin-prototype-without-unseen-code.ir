# Without unseen JavaScript nobody defines an accessor on Map.prototype: a name it lacks is absent, proven, and neither the map nor a stored value leaves the program
# RUN: flow-walk f1 f2
# CHECK: f1@i{{*}} v1 Get {"label"}
# CHECK-NEXT: Map@f0:v1{{*}}: Absent Proven
# CHECK-NEXT: f2@i{{*}} v2 Set {"label"}
# CHECK-NEXT: Map@f0:v3{{*}}: Value own Proven Map@f0:v3{{*}} "label"
# CHECK-NOT: Unknown
# RUN(SINKS): flow-solve sinks
# SINKS-NOT: Map@f0:
# SINKS-NOT: L0#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Stored" fields=[{key="s" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    v2 = CallDirect v1 function=f1
    v3 = Construct v0
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = CallDirect v3, v5 function=f2
    Return
}
function f1 name="readsName" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="label"
    Return v1
}
function f2 name="storesName" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="label" mode=Strict
    Return
}
