# A module variable records how often it is stored and whether it is read as a value or only called
# RUN: flow-solve locations
# RUN(NODES): flow-solve nodes
# CHECK: Variable(g0) events=[StoredByOperation, ReadAsValue, StoredOtherValue]
# CHECK: Variable(g1) events=[StoredByOperation, StoredByManyOperations, ReadAsValue, StoredOtherValue]
# CHECK: Variable(g2) events=[StoredByOperation, StoredByManyOperations, ReadAsValue, StoredOtherValue]
# CHECK: Variable(g3) events=[StoredByOperation, ReadAsCallee,
# CHECK: Variable(g4) events=[StoredByOperation, ReadAsValue, ReadAsCallee,
# CHECK-NOT: Variable(g5)
# NODES: Variable(g0) = {1}
# NODES: Variable(g1) = {1|"two"}
# NODES: Variable(g2) = {1}
# NODES: Variable(g3) = {f1}
# NODES: Variable(g4) = {f1}
# NODES-NOT: Variable(g5)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="storedOnce" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="storedByTwoOperations" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="storedInCycle" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="onlyCalled" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="calledAndKept" module=m0 declared={type=anything} initialization=Undefined
variable g5 name="untouched" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="two"
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    PutModuleVariable v1 variable=g1
    v5 = NewClosure function=f1
    PutModuleVariable v5 variable=g3
    PutModuleVariable v5 variable=g4
    Jump -> next b1()
  b1():
    LoopHint
    PutModuleVariable v0 variable=g2
    v10 = GetModuleVariable variable=g2
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b2()
  b2():
    v12 = GetModuleVariable variable=g0
    v13 = GetModuleVariable variable=g1
    v14 = Add v12, v13
    v15 = GetModuleVariable variable=g3
    v16 = Call v15
    v17 = GetModuleVariable variable=g4
    v18 = Call v17
    v19 = GetModuleVariable variable=g4
    v20 = NewArray v19 contents=anything
    Return
}
function f1 name="callee" results=[{type=anything}] {
  b0():
    Return
}
