# A spread defines each property of its source under its own name on the target: the source is enumerated and changed by nothing, and the target is not stored to under an unknown key
# RUN(SOURCE): flow-solve nodes objects locations
# RUN(TARGET): flow-solve nodes objects locations
# RUN(APART): flow-solve nodes objects locations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Copy" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = String string="s"
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = PropGet v3 key="w"
    v5 = NewObject layout=L1 fields=[]
    CopyDataProperties v5, v3
    v7 = Integer integer=2
    PropDefine v5, v7 key="y"
    v9 = FinishObject v5
    v10 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v11 = FinishObject v10
    Return
}
# SOURCE: , f0, v3) = {L0#[[source]]}
# SOURCE: L0#[[source]] mutations=[] uses=[ReadByName, Enumerated] events=[Allocated]
# SOURCE: DeclaredPart(L0#[[source]], 0) events=[{{*}}ReadAsValue, PresenceObserved
# SOURCE-NEXT: DeclaredPart(L0#[[source]], 1) events=[{{*}}ReadAsValue, PresenceObserved
# TARGET: DeclaredPart(L1#[[target]], 0) = {undefined|1}
# TARGET-NEXT: DeclaredPart(L1#[[target]], 1) = {undefined|2}
# TARGET: Property(L1#[[target]], "z") = {"s"}
# TARGET-NOT: StringProperties(L1#[[target]]) =
# TARGET: L1#[[target]] mutations=[AddProperty, StoreAfterCreation] uses=[] events=[Allocated]
# TARGET: DeclaredPart(L1#[[target]], 0) events=[{{*}}StoredByManyOperations
# TARGET: Property(L1#[[target]], "z") events=[{{*}}StoredByManyOperations
# APART: , f0, v11) = {L0#[[apart]]}
# APART: L0#[[apart]] mutations=[] uses=[] events=[Allocated]
# APART-NOT: DeclaredPart(L0#[[apart]], {{*}}ReadAsValue
# APART-NOT: DeclaredPart(L0#[[apart]], {{*}}PresenceObserved
