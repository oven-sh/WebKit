# A delete by name puts undefined into that field of the objects it reaches, through an unknown receiver of the objects that escaped, and leaves the other field and every other object alone
# RUN(DELETED): flow-solve nodes objects locations
# RUN(KEPT): flow-solve nodes objects locations
# RUN(ESCAPED): flow-solve nodes locations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = PropDelete v2 key="x"
    v4 = PropGet v2 key="x"
    v5 = PropGet v2 key="y"
    v6 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v7 = PropGet v6 key="x"
    v8 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = Call v10, -, v8
    v12 = PropGet v9 key="input" [isFreeName]
    v13 = PropDelete v12 key="x"
    v14 = PropGet v8 key="x"
    v15 = PropGet v8 key="y"
    Return
}
# DELETED: DeclaredPart(L0#[[deleted]], 0) = {undefined|1}
# DELETED-NEXT: DeclaredPart(L0#[[deleted]], 1) = {2}
# DELETED: , f0, v2) = {L0#[[deleted]]}
# DELETED: , f0, v4) = {undefined|1}
# DELETED-NEXT: , f0, v5) = {2}
# DELETED: L0#[[deleted]] mutations=[DeleteField] uses=
# DELETED: DeclaredPart(L0#[[deleted]], 0) events=[{{*}}Deleted
# DELETED-NOT: DeclaredPart(L0#[[deleted]], 1) events=[{{*}}Deleted
# KEPT: DeclaredPart(L0#[[kept]], 0) = {1}
# KEPT-NEXT: DeclaredPart(L0#[[kept]], 1) = {2}
# KEPT: , f0, v6) = {L0#[[kept]]}
# KEPT-NEXT: , f0, v7) = {1}
# KEPT: L0#[[kept]] mutations=[] uses=
# KEPT-NOT: DeclaredPart(L0#[[kept]], {{*}}Deleted
# ESCAPED: , f0, v8) = {L0#[[escaped]]}
# ESCAPED: , f0, v14) = {undefined|1}
# ESCAPED-NEXT: , f0, v15) = {2}
# ESCAPED: Property(unknown, "x") events=[{{*}}Deleted
# ESCAPED-NOT: Property(unknown, "y") events=[{{*}}Deleted
