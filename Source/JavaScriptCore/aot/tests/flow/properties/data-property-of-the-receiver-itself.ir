# A data property that an instance of a built-in class is created with answers for that instance: what is stored in lastIndex of a RegExp comes back from a read of it,
# and the fields of the object that comes back count as read
# RUN: flow-solve nodes
# RUN(RESULTS): flow
# CHECK: , f0, v4) = {{*}}L0#[[stored]]
# CHECK: , f0, v5) = {undefined|7}
# RESULTS: field L0.0 "tag"
# RESULTS-NOT: reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a" regExpFlags=[Global]
    v1 = Integer integer=7
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v0, v2 key="lastIndex"
    v4 = PropGet v0 key="lastIndex"
    v5 = PropGet v4 key="tag"
    Return v5
}
