# A field that the base class declares is a field of an object of the subclass: shown by value also to a reader reached before the constructor, filtered by its declared type, and a store to it adds no property
# RUN: flow-walk f0 f3
# CHECK: f0@i{{*}} v15 Get {"q"}
# CHECK: L1#[[derived]]: Value own Proven L1#[[derived]] "q"
# CHECK: L1#[[derived]]: Absent Proven
# CHECK: f3@i{{*}} v1 Get {"x"}
# CHECK: L1#[[derived]]: Value own Proven L1#[[derived]] "x"
# CHECK-NEXT: L1#[[derived]]: Value own Predicted L1#[[derived]] *
# RUN(SHOWN): flow-walk f3
# SHOWN-NOT: Absent
# RUN(READ): flow-solve nodes
# READ: Local(i{{*}}, f3, v1) = {1|"s"}
# RUN(FIELD): flow-solve nodes
# FIELD: Property(L1#{{*}}, "x") = {1}
# RUN(OUTSIDE): flow-solve nodes
# OUTSIDE: StringProperties(L1#{{*}}) = {"s"}
# RUN(OBJECTS): flow-solve objects
# OBJECTS: L1#{{*}} mutations=[AddProperty, StoreAfterCreation, StoreOfOtherType] uses
# RUN(WITNESSES): flow-solve witnesses
# WITNESSES-NOT: AddProperty f1:
# WITNESSES-NOT: AddProperty f0:v12
# WITNESSES: AddProperty f0:v14
# WITNESSES: StoreOfOtherType f0:v12
# WITNESSES-NOT: AddProperty f1:
# WITNESSES-NOT: AddProperty f0:v12
# RUN(LOCATIONS): flow-solve locations
# LOCATIONS: Property(L1#{{*}}, "x") events=[{{*}}StoredOutsideType
# RUN(INSIDE): flow-solve locations
# INSIDE-NOT: "q") events=[{{*}}StoredOutsideType

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="x" declared={type=number}}]
layout L1 kind=Instance name="Derived" predictedBase=L0 constructor=f2 flags=[HasHeritage]
variable g0 name="derived" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0() handler=b1():
    v0 = CallDirect function=f3
    v1 = NewClosure function=f1
    v2 = NewClass v1 layout=L0
    v3 = FinishClass v2 layout=L0
    v4 = NewClosure function=f2
    v5 = ResolveHeritage v3
    v6 = NewClass v4, v3, v5 layout=L1
    v7 = FinishClass v6 layout=L1
    v8 = Construct v7
    PutModuleVariable v8 variable=g0
    v10 = GetModuleVariable variable=g0
    v11 = String string="s"
    PropSet v10, v11 key="x" mode=Strict
    v13 = Integer integer=2
    PropSet v10, v13 key="q" mode=Strict
    v15 = PropGet v10 key="q"
    Return
  b1() role=CatchHandler:
    v16 = CatchValue
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="readEarly" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="x"
    Return v1
}
