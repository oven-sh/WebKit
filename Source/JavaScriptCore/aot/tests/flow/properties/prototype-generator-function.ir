# A generator function inherits from the prototype of generator functions and its prototype property from the prototype of generators, and an async arrow function has no prototype property
# RUN: flow-walk f0 prototypes
# RUN(NODES): flow-solve nodes
# CHECK: f0@i{{*}} v1 Get {"prototype"}
# CHECK-NEXT: f1: Value own Proven f1 "prototype"
# CHECK-NEXT: f0@i{{*}} v2 Get {"next"}
# CHECK-NOT: Unknown
# CHECK: f1.prototype: BuiltinMember Proven GeneratorPrototype "next" GeneratorPrototypeNext
# CHECK-NOT: Unknown
# CHECK: f0@i{{*}} v4 Get {"prototype"}
# CHECK-NEXT: f2: Absent Proven
# CHECK-NEXT: f0@i{{*}} v6 Get {"bind"}
# CHECK-NEXT: f1: BuiltinMember Proven FunctionPrototype "bind" FunctionPrototypeBind
# CHECK: f1 -> GeneratorFunctionPrototype
# CHECK: f2 -> AsyncFunctionPrototype
# CHECK: f1.prototype -> GeneratorPrototype
# NODES: Variable(g0) = {undefined}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="prototypeOfArrow" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = PropGet v1 key="next"
    v3 = NewClosure function=f2
    v4 = PropGet v3 key="prototype"
    PutModuleVariable v4 variable=g0
    v6 = PropGet v0 key="bind"
    Return
}
function f1 name="generate" flags=[IsGenerator, TakesCallee] results=[{type=anything}] {
  b0(v0: function):
    InitialYield
    Return
}
function f2 name="load" kind=Arrow flags=[IsAsync] results=[{type=anything}] {
  b0():
    Return
}
