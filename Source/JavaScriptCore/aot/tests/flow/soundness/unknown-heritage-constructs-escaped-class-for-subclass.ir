# A class that has reached native code comes back as the unknown value and is extended: the super call passes the subclass as new.target, so the base constructor's new.target and the prototype of its object are unknown
# RUN: flow-solve nodes
# CHECK-NOT: f1, parameter 0) = {undefined|f1}
# CHECK-NOT: DeclaredPart(L0#{{*}}, 0) = {"base"}

layout L0 kind=Instance name="Base" module=m0 constructor=f1 fields=[{key="tag" declared={type=anything predicted=string}}]
layout L1 kind=Instance name="Derived" module=m0 constructor=f3 flags=[HasHeritage]
variable g0 module=m0 declared={type=function} flags=[IsImmutable]
variable g1 module=m0 declared={type=function} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f2
    DefineMethod v1, v3 layout=L0 key="name"
    v5 = FinishClass v1 layout=L0
    v6 = ClaimDeclared v5 declared={type=anything predicted=function}
    v7 = ClaimDeclared v5 declared={type=anything predicted=function}
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="launder" [isFreeName]
    v10 = Call v9, -, v7 calleeName="launder"
    v11 = ResolveHeritage v10
    v12 = NewClosure function=f3
    v13 = NewClass v12, v10, v11 layout=L1
    PutModuleVariable v13 variable=g1
    v15 = NewClosure function=f4
    DefineMethod v13, v15 layout=L1 key="name"
    v17 = FinishClass v13 layout=L1
    v18 = ClaimDeclared v17 declared={type=anything predicted=function}
    v19 = ClaimDeclared v17 declared={type=anything predicted=function}
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="print" [isFreeName]
    v22 = Construct v19 calleeName="Derived"
    v23 = Predict v22 predicted=L1
    v24 = PropGet v23 key="tag"
    v25 = Call v21, -, v24 calleeName="print"
    v26 = Undefined
    Return v26
}
function f1 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Predict v2 predicted=L0
    v4 = Predict v2 predicted=L0
    v5 = PropGet v4 key="name"
    v6 = Predict v5 predicted=function
    v7 = Call v6, v4 calleeKey="name" calleeName="name"
    v8 = Predict v7 predicted=string
    PropSet v3, v8 key="tag"
    v10 = Undefined
    v11 = TypeTest v10 testedType=object
    Branch v11 -> taken b2(| 0), notTaken b3(| 0)
  b2(v12):
    Jump -> next b4(v12)
  b3(v13):
    Jump -> next b4(v2)
  b4(v14):
    Return v14
}
function f2 name="name" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything predicted=string}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = String string="base"
    v1 = ClaimDeclared v0 declared={type=anything predicted=string}
    Return v1
}
function f3 name="Derived" module=m0 kind=DerivedConstructor flags=[HasRestParameter, HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} parameters=[{type=Array}] results=[{type=object}] {
  b0(v0: function, v1: anything, v2: Array):
    Jump -> next b1()
  b1():
    v3 = GetSuperBase v0
    v4 = SuperConstructList v3, v1, v2 layout=L1
    Return v4
}
function f4 name="name" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything predicted=string}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = String string="derived"
    v1 = ClaimDeclared v0 declared={type=anything predicted=string}
    Return v1
}
entry module=m0
