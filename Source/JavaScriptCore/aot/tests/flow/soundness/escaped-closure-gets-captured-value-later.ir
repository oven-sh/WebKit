# A closure reaches native code, and the field of the environment it captures gets an object only in a function that is entered later: the call that native code makes reads that object and hands it back to native code
# RUN: flow-solve sinks nodes
# CHECK: nativeCode {{*}}L1#

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{declared={type=anything}}]
layout L1 name="Late" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
variable g0 name="environment" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Undefined
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewClosure v2 function=f5
    v4 = PropGet v0 key="keep" [isFreeName]
    v5 = Call v4, -, v3
    v6 = NewClosure v2 function=f1
    v7 = Call v6
    Return
}
function f1 name="one" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = NewClosure v0 function=f2
    v2 = Call v1
    Return v2
}
function f2 name="two" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = NewClosure v0 function=f3
    v2 = Call v1
    Return v2
}
function f3 name="three" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = NewClosure v0 function=f4
    v2 = Call v1
    Return v2
}
function f4 name="four" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = FinishObject v2
    PutEnvironmentField v0, v3 layout=L0 field=0
    Return
}
function f5 name="kept" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
