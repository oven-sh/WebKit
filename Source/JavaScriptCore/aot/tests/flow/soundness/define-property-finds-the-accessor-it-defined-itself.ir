# The get of the descriptor is behind a getter, so Object.defineProperty defines the accessor at a later run of its statement than the run that looked for what it redefines.
# Another run of the statement finds the accessor that the statement itself defined, and says nothing else about it than the runs before
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve nodes

layout L0 name="descriptor"
layout L1 name="target"
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = NewClosure function=f1
    DefineGetter v0, v1 key="get"
    v3 = FinishObject v0
    v4 = NewObject layout=L1
    v5 = FinishObject v4
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="Object" [isFreeName]
    v8 = PropGet v7 key="defineProperty"
    v9 = String string="x"
    v10 = Call v8, v7, v5, v9, v3 calleeKey="defineProperty"
    Return v10
}
function f1 name="get" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="x" results=[{type=anything}] {
  b0():
    v0 = Integer integer=44
    Return v0
}
