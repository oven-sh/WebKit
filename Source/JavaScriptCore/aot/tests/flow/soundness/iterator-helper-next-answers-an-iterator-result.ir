# function* each() { yield item }   const helper = $iteratorHelperCreate(each(), null)
#   spread = [...helper][0]   step = helper.next()   value = step.value   done = step.done
# next of an iterator helper is `return $resumeGenerator(<its generator>, next, undefined)`, and ResumeGenerator answers what the run time makes: an iterator result, never the yielded value itself.
# So a loop of native code over the helper finds the item under `value` and the array it fills holds it, and a step by hand is an object with `value` and `done`.
# What comes out stays exact: the one item, or undefined once the generator has completed, and nothing unknown. L2 is the layout of iterator results
# RUN: flow-solve nodes
# CHECK: Variable(g0) = {undefined|L0#[[item]]}
# CHECK-NEXT: Variable(g1) = {L2#{{*}}}
# CHECK-NEXT: Variable(g2) = {undefined|L0#[[item]]}
# CHECK-NEXT: Variable(g3) = {boolean}

