# Of a function of the host that is reached under a private name of the global object and has no entry in the table, nothing says what it does to its operands: each of them reaches
# unknown JavaScript. That holds for the operands beyond the eighth, and for one that has reached native code before it is passed
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve objects
# CHECK-COUNT-10: L0#{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript
# CHECK: L1#{{*}} mutations=[ReachNativeCode, ReachUnknownJavaScript

layout L0 name="other"
layout L1 name="late"
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key=@"hostFunctionWithoutEntry" [isFreeName]
    v2 = PropGet v0 key="sink" [isFreeName]
    v3 = Call v2
    v4 = NewObject layout=L0
    v5 = NewObject layout=L0
    v6 = NewObject layout=L0
    v7 = NewObject layout=L0
    v8 = NewObject layout=L0
    v9 = NewObject layout=L0
    v10 = NewObject layout=L0
    v11 = NewObject layout=L0
    v12 = NewObject layout=L0
    v13 = NewObject layout=L0
    v14 = Call v1, -, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13
    v15 = NewObject layout=L1
    v16 = Call v2, -, v15
    v17 = NewClosure function=f1
    v18 = Call v17, -, v15
    v19 = Call v17, -, v18
    v20 = Call v1, -, v19
    Return v20
}
function f1 name="same" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
