# The prototype of an object that has reached native code is changed in a function that is entered later: the prototype and what it holds reach native code too
# RUN: flow-solve sinks nodes
# CHECK: nativeCode {{*}}L1#[[prototype]]
# CHECK: , f5, parameter 0) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Kept" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Parent" fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g0
    v5 = PropGet v0 key="keep" [isFreeName]
    v6 = Call v5, -, v3
    v7 = NewClosure function=f1
    v8 = Call v7
    Return
}
function f1 name="one" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0
    Return v1
}
function f2 name="two" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    Return v1
}
function f3 name="three" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = Call v0
    Return v1
}
function f4 name="four" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = GetModuleVariable variable=g0
    v2 = NewClosure function=f5
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = PropGet v0 key="Object" [isFreeName]
    v6 = PropGet v5 key="setPrototypeOf"
    v7 = Call v6, v5, v1, v4 calleeKey="setPrototypeOf"
    Return
}
function f5 name="inheritedMethod" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
