# function F() { this.x = 1 }  const plain = {};  const T = { a: F.prototype, undefined: plain };  function key() { return k }
# T[key()].m = function () { return 1 };  var k = "a";  function use(o) { return o.m() }  use(new F())
# The key is undefined when the store runs, so the function goes to `plain` and `new F().m` is not there.
# The receiver of the store holds F.prototype alone when the order of execution is computed first. That computation adds undefined to k, and the table then answers `plain` too.
# The statement of the store sees the second receiver arrive and records that it may miss the member, so the order is computed again and claims nothing.
# A store whose receiver stays the one holder: results/class-member-assigned-by-a-store-that-may-miss.ir
# RUN: flow-order locations
# CHECK-NOT: StoredBeforeEveryRead Unknown

