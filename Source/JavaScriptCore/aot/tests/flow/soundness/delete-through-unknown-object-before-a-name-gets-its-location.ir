# A store through the unknown object gives it a location for "shell" after a delete through the unknown object under a key nobody can name has run.
# Another run of the delete says nothing about that location: what the delete does is on record at the unknown object and in its unnamed parts
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve nodes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Call v1
    v3 = Call v1
    v4 = ElemDelete v2, v3 mode=Strict
    v5 = NewClosure function=f1
    v6 = Call v5, -, v2
    v7 = Call v5, -, v6
    v8 = Integer integer=1
    PropSet v7, v8 key="shell" mode=Strict
    Return v4
}
function f1 name="same" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
