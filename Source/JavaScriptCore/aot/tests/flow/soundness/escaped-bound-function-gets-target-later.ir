# One call of bind binds whatever a variable holds, and the variable gets a second function after the bound function has reached native code: native code calls both targets with unknown arguments
# RUN: flow-solve sinks nodes
# CHECK: nativeCode {{*}}BoundFunction@
# CHECK: , f5, parameter 0) = {{*}}unknown
# CHECK: , f6, parameter 0) = {{*}}unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="target" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = NewClosure function=f5
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g0
    v4 = Null
    v5 = PropGet v3 key="bind"
    v6 = Call v5, v3, v4 calleeKey="bind"
    v7 = PropGet v0 key="keep" [isFreeName]
    v8 = Call v7, -, v6
    v9 = NewClosure function=f1
    v10 = Call v9
    Return
}
function f1 name="one" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0
    Return v1
}
function f2 name="two" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = Call v0
    Return v1
}
function f3 name="three" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = Call v0
    Return v1
}
function f4 name="four" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f6
    PutModuleVariable v0 variable=g0
    Return
}
function f5 name="firstTarget" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f6 name="secondTarget" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
