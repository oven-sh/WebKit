# The property "prototype" of a class is neither writable nor configurable, so unknown JavaScript that reaches the class changes nothing about it.
# A read that runs before the class is reached and one that runs after it give the same answer
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve nodes
# CHECK: f0, v3) = {f1.prototype}
# CHECK: f0, v12) = {f1.prototype}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = PropGet v2 key="prototype"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="text" [isFreeName]
    v6 = Builtin builtin=Function
    v7 = Construct v6, -, v5
    v8 = Call v7, -, v2
    v9 = NewClosure function=f2
    v10 = Call v9, -, v2
    v11 = Call v9, -, v10
    v12 = PropGet v11 key="prototype"
    Return v3
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="same" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
