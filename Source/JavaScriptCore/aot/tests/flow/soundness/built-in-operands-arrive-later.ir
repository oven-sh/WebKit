# Operands of built-in calls that arrive three calls after the first run of the call are treated like the ones that were there: overloads, keys, descriptors, prototypes, ranges, receivers, a refusal
# RUN: flow-links builtins
# RUN(NODES): flow-solve nodes
# CHECK: builtin [[main]] v32 ArrayFrom/0 Call
# CHECK-NEXT: builtin [[main]] v32 ArrayFrom/1 Call
# CHECK-NEXT: builtin [[main]] v33 ArrayFrom/0 Call
# CHECK-NEXT: builtin [[main]] v33 ArrayFrom/1 Call
# NODES: DeclaredPart(L0#[[early]], 0) = {true|1|"stored"}
# NODES-NEXT: DeclaredPart(L0#[[early]], 1) = {1|"stored"}
# NODES: DeclaredPart(L0#[[late]], 0) = {null|true|2}
# NODES-NEXT: DeclaredPart(L0#[[late]], 1) = {2}
# NODES: , f0, v10) = {L0#[[early]]}
# NODES: , f0, v21) = {L0#[[late]]}
# NODES: , f0, v26) = {L3#[[earlyPrototype]]|L3#[[latePrototype]]}
# NODES: , f0, v37) = {L0#[[defined]]}
# NODES: , f0, v40) = {L0#[[child]]}
# NODES: , f0, v46) = {number}
# NODES: PrototypeLink(L0#[[child]]) = {L3#[[earlyPrototype]]|L3#[[latePrototype]]|ObjectPrototype}
# NODES: PrototypeLink(Object@f0:v44{{*}}) = {L3#[[earlyPrototype]]|L3#[[latePrototype]]}
# NODES: Getter(L0#[[defined]], "a") = {{*}}f4}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L2 name="GetterDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Proto" fields=[{key="p" declared={type=anything} flags=[IsRequired]}]
layout L4 name="Bag" fields=[{key="typed" declared={type=anything} flags=[IsRequired]}, {key="list" declared={type=anything} flags=[IsRequired]}, {key="key" declared={type=anything} flags=[IsRequired]}, {key="descriptor" declared={type=anything} flags=[IsRequired]}, {key="proto" declared={type=anything} flags=[IsRequired]}, {key="fraction" declared={type=anything} flags=[IsRequired]}, {key="target" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = ToBoolean v1
    v3 = Integer integer=1
    v4 = NewArray v3 contents=anything
    v5 = Builtin builtin=Uint8Array
    v6 = Construct v5, -, v3
    v7 = String string="a"
    v8 = NewObject -, v3 layout=L1 fields=[0]
    v9 = NewObject -, v3 layout=L3 fields=[0]
    v10 = NewObject -, v3, v3 layout=L0 fields=[0, 1]
    v11 = NewClosure function=f1
    v12 = Call v11
    v13 = Call v12
    v14 = Call v13
    v15 = PropGet v14 key="typed"
    v16 = PropGet v14 key="list"
    v17 = PropGet v14 key="key"
    v18 = PropGet v14 key="descriptor"
    v19 = PropGet v14 key="proto"
    v20 = PropGet v14 key="fraction"
    v21 = PropGet v14 key="target"
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v4, v6, v7, v8, v9, v3, v10, v3)
  b2():
    Jump -> next b3(v15, v16, v17, v18, v19, v20, v21, v21)
  b3(v22, v23, v24, v25, v26, v27, v28, v29):
    v30 = Builtin builtin=ArrayFrom
    v31 = Builtin builtin=Array
    v32 = Call v30, v31, v22
    v33 = Call v30, v31, v23
    v34 = Builtin builtin=ReflectSet
    v35 = String string="stored"
    v36 = Call v34, -, v10, v24, v35
    v37 = NewObject -, v3, v3 layout=L0 fields=[0, 1]
    v38 = Builtin builtin=ObjectDefineProperty
    v39 = Call v38, -, v37, v7, v25
    v40 = NewObject -, v3, v3 layout=L0 fields=[0, 1]
    v41 = Builtin builtin=ObjectSetPrototypeOf
    v42 = Call v41, -, v40, v26
    v43 = Builtin builtin=ObjectCreate
    v44 = Call v43, -, v26
    v45 = Builtin builtin=MathMax
    v46 = Call v45, -, v27, v3
    v47 = Boolean boolean=true
    v48 = Call v34, -, v28, v7, v47
    v49 = Null
    v50 = Call v34, -, v29, v7, v49
    Return
}
function f1 name="stage1" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="stage2" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    Return v0
}
function f3 name="stage3" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = Builtin builtin=Uint8Array
    v2 = Construct v1, -, v0
    v3 = NewArray v0 contents=anything
    v4 = String string="b"
    v5 = NewClosure function=f4
    v6 = NewObject -, v5 layout=L2 fields=[0]
    v7 = NewObject -, v0 layout=L3 fields=[0]
    v8 = Double number=0.5
    v9 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v10 = NewObject -, v2, v3, v4, v6, v7, v8, v9 layout=L4 fields=[0, 1, 2, 3, 4, 5, 6]
    Return v10
}
function f4 name="getter" results=[{type=anything}] {
  b0():
    Return
}
