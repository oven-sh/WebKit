# A store through a set that holds the unknown object and five escaped objects reaches the field of each of them, and of no object that has not escaped
# RUN: flow-solve nodes
# CHECK: DeclaredPart(L0#{{*}}, 0) = {1|"stored"}
# CHECK: DeclaredPart(L4#{{*}}, 0) = {5|"stored"}
# CHECK: DeclaredPart(L5#{{*}}, 0) = {6}
# CHECK: Property(unknown, "k") = {"stored"}

layout L0 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L3 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L4 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
layout L5 module=m0 fields=[{key="k" declared={type=anything predicted=number} flags=[IsRequired]}]
variable g0 name="isAbsent" module=m0 declared={type=anything|absent predicted=boolean} flags=[IsImmutable]
variable g1 name="unknown" module=m0 declared={type=anything|absent} flags=[IsImmutable]
variable g2 name="all" module=m0 declared={type=anything|absent predicted=Array<L0>} flags=[IsImmutable]
variable g3 name="index" module=m0 declared={type=anything|absent predicted=number} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = ClaimDeclared v0 declared={type=anything predicted=function}
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Predict v3 predicted=builtin(GlobalThis)
    v5 = PropGet v4 key="missing"
    v6 = TypeTest v5 testedType=undefined
    v7 = Predict v6 predicted=boolean
    PutModuleVariable v7 variable=g0
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="globalThis" [isFreeName]
    v11 = Predict v10 predicted=builtin(GlobalThis)
    v12 = PropGet v11 key="alsoMissing"
    PutModuleVariable v12 variable=g1
    v14 = Data data=d0
    v15 = Predict v14 predicted=L0
    v16 = Data data=d1
    v17 = Predict v16 predicted=L1
    v18 = Data data=d2
    v19 = Predict v18 predicted=L2
    v20 = Data data=d3
    v21 = Predict v20 predicted=L3
    v22 = Data data=d4
    v23 = Predict v22 predicted=L4
    v24 = Data data=d5
    v25 = Predict v24 predicted=L5
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="globalThis" [isFreeName]
    v28 = Predict v27 predicted=builtin(GlobalThis)
    v29 = PropGet v28 key="sink"
    v30 = TypeTest v29 testedType=undefined|null
    Branch v30 -> taken b2(| 0), notTaken b4(| 0)
  b2(v31):
    Jump -> next b3()
  b3():
    v32 = Undefined
    Jump -> next b5(v32)
  b4(v33):
    v34 = Call v33, v28, v15, v17, v19, v21, v23 calleeKey="sink" calleeName="sink"
    Jump -> next b5(v34)
  b5(v35):
    v36 = NewArray v15, v17, v19, v21, v23 contents=anything
    v37 = Predict v36 predicted=Array<L0>
    PutModuleVariable v37 variable=g2
    v39 = ToBoolean v7
    Branch v39 -> taken b6(| 0), notTaken b8(| 0)
  b6(v40):
    Jump -> next b7()
  b7():
    v41 = Integer integer=4
    Jump -> next b10(v41)
  b8(v42):
    Jump -> next b9()
  b9():
    v43 = Integer
    Jump -> next b10(v43)
  b10(v44):
    v45 = Predict v44 predicted=number
    PutModuleVariable v45 variable=g3
    v47 = Predict v1 predicted=function
    v48 = Call v47 calleeName="pick"
    v49 = String string="stored"
    PropSet v48, v49 key="k"
    v51 = Call v47 calleeName="pick"
    v52 = PropDelete v51 key="gone"
    v53 = Builtin builtin=GlobalThis
    v54 = PropGet v53 key="print" [isFreeName]
    v55 = PropGet v23 key="k"
    v56 = Predict v55 predicted=number
    v57 = PropGet v25 key="k"
    v58 = Predict v57 predicted=number
    v59 = Call v54, -, v56, v58 calleeName="print"
    v60 = Undefined
    Return v60
}
function f1 name="pick" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="isAbsent"
    v2 = ToBoolean v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = GetModuleVariable variable=g2
    v5 = CheckInitialized v4 name="all"
    v6 = GetModuleVariable variable=g3
    v7 = CheckInitialized v6 name="index"
    v8 = ElemGet v5, v7
    v9 = Predict v8 predicted=L0
    Jump -> next b6(v9)
  b4(v10):
    Jump -> next b5()
  b5():
    v11 = GetModuleVariable variable=g1
    v12 = CheckInitialized v11 name="unknown"
    Jump -> next b6(v12)
  b6(v13):
    Return v13
}
data d0 root=Object{layout=L0 members=[{key="k" value=Number{value=1}}]} module=m0
data d1 root=Object{layout=L1 members=[{key="k" value=Number{value=2}}]} module=m0
data d2 root=Object{layout=L2 members=[{key="k" value=Number{value=3}}]} module=m0
data d3 root=Object{layout=L3 members=[{key="k" value=Number{value=4}}]} module=m0
data d4 root=Object{layout=L4 members=[{key="k" value=Number{value=5}}]} module=m0
data d5 root=Object{layout=L5 members=[{key="k" value=Number{value=6}}]} module=m0
entry module=m0
