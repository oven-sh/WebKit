# A built-in that takes only objects throws for the number among the values of its operand, also where an object is among them from the first run on
# RUN: flow-solve nodes
# CHECK: , f0, v6) = {5|L0#
# CHECK: , f0, v8) = {opaque(Error)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Proto" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = ToBoolean v1
    v3 = Integer integer=5
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = Builtin builtin=ObjectCreate
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v4)
  b3(v6) handler=b4():
    v7 = Call v5, -, v6
    Return v7
  b4() role=CatchHandler:
    v8 = CatchValue
    Return v8
}
