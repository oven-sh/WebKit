# No code, seen or unseen, writes what a bound function holds: it can only call or construct the function. Native code binds a function here, and text that is evaluated later
# lets unknown JavaScript reach the bound function after native code has been given what it holds: nothing of it is opened, in that order or in the other
# OPTIONS: check=FlowFixpoint
# RUN: flow-solve locations
# CHECK: DeclaredPart(BoundFunction@host{{*}}, 0) events=[ReadByUnknownCode
# CHECK-NOT: DeclaredPart(BoundFunction@host{{*}}WrittenByUnknownCode

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Function" [isFreeName]
    v2 = PropGet v1 key="prototype"
    v3 = PropGet v2 key="bind"
    v4 = PropGet v0 key="sink" [isFreeName]
    v5 = Call v4, -, v3
    v6 = NewClosure function=f1
    v7 = PropGet v0 key="text" [isFreeName]
    v8 = Call v6, -, v7
    v9 = Call v6, -, v8
    v10 = Construct v1, -, v9
    Return v10
}
function f1 name="same" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
