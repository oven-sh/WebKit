# A loader called as a value requires what an element of an escaped array names, and the name of the importing module gets there through a method called on a receiver nobody knows, after the order of the modules was first computed: the two modules are in a cycle
# RUN: flow-order modules before m0 m1
# CHECK: m0: component [[cycle]] cycle after
# CHECK-NEXT: m1: component [[cycle]] cycle after
# CHECK: before m0 m1 Unknown

module m0 path="/low.cjs" displayPath="low.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
module m1 path="/above.js" displayPath="above.js" body=f1 requests=[{target=m0}]
module m2 path="/first.cjs" displayPath="first.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
entry module=m1
function f0 name="low" module=m0 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = String string="/first.cjs"
    v9 = NewArray v8
    v10 = PropGet v6 key="keep" [isFreeName]
    v11 = Call v10, -, v9
    v12 = String string="/above.js"
    v13 = PropGet v7 key="fill"
    v14 = Call v13, v7, v12 calleeKey="fill"
    v15 = Integer integer=0
    v16 = ElemGet v9, v15
    v17 = Call v2, -, v16
    Return
}
function f1 name="above" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="first" module=m2 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
