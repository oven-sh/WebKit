# Object.freeze of a value nobody knows freezes every array that has reached native code, so such an array keeps no pristine aspect. An array that stays inside keeps both
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK: variable g0 type=Array<"t"
# CHECK-NOT: variable g0 type={{*}}pristine
# CHECK: variable g1 type=Array<"t", proven, pristine[Storage, Names, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="escaped" declared={type=anything} initialization=Uninitialized
variable g1 name="inside" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="t"
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v1
    v8 = Builtin builtin=Object
    v9 = PropGet v8 key="freeze"
    v10 = Call v9, v8, v7
    Return
}
