# a = launder([]); a.constructor.foo = 1; Array.foo   and   c = launder(new C()); c.constructor.foo = 1; C.foo
# What the unknown object holds under the name constructor is the constructor of whatever it stands for, and the read answers unknown. So from such a read on every built-in constructor shares its
# locations with the unknown object: the store reaches Array.foo, and Map.foo and Function.foo too, because the unknown object also stands for a Map that native code made and for a function.
# The closure of a compiled class has followed its prototype object into native code, so it shares its locations anyway.
# No constructor reaches native code for that: nothing calls it and no member follows it. Array.from is the function of the table, and a name that nothing stores through an unknown receiver is absent.
# RUN: flow-solve nodes sinks
# CHECK-NOT: Variable(g0) = {undefined}
# CHECK-NOT: Variable(g1) = {undefined}
# CHECK: Variable(g2) = {ArrayFrom}
# CHECK-NOT: Variable(g3) = {undefined}
# CHECK-NOT: Variable(g4) = {undefined}
# CHECK: Variable(g5) = {undefined}
# CHECK-LABEL: nativeCode {
# CHECK-NOT: , Array,
# CHECK-NOT: ArrayFrom
# CHECK-NOT: , Map,
# CHECK-NOT: , Function,
# CHECK-LABEL: unknownJavaScript {

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="C" constructor=f1
variable g0 name="onArray" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="onClass" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="from" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="onMap" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="onFunction" module=m0 declared={type=anything} initialization=Undefined
variable g5 name="neverStored" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="launder" [isFreeName]
    v2 = Integer integer=1
    v3 = NewArray
    v4 = Call v1, -, v3
    v5 = PropGet v4 key="constructor"
    PropSet v5, v2 key="foo" mode=Sloppy
    v7 = Builtin builtin=Array
    v8 = PropGet v7 key="foo"
    PutModuleVariable v8 variable=g0
    v10 = NewClosure function=f1
    v11 = NewClass v10 layout=L0
    v12 = FinishClass v11 layout=L0
    v13 = Construct v12
    v14 = Call v1, -, v13
    v15 = PropGet v14 key="constructor"
    PropSet v15, v2 key="foo" mode=Sloppy
    v17 = PropGet v12 key="foo"
    PutModuleVariable v17 variable=g1
    v19 = PropGet v7 key="from"
    PutModuleVariable v19 variable=g2
    v21 = Builtin builtin=Map
    v22 = PropGet v21 key="foo"
    PutModuleVariable v22 variable=g3
    v24 = Builtin builtin=Function
    v25 = PropGet v24 key="foo"
    PutModuleVariable v25 variable=g4
    v27 = PropGet v7 key="bar"
    PutModuleVariable v27 variable=g5
    Return
}
function f1 name="C" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
