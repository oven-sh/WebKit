# The regular expression that the built-in constructor makes for RegExp.prototype[Symbol.matchAll] is what the entries say, and nothing reaches unknown JavaScript.
# RUN: flow-solve sinks
# CHECK: unknownJavaScript {}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="b" regExpFlags=[Global]
    v1 = Builtin builtin=RegExpPrototype
    v2 = PropGet v1 key=@@matchAll
    v3 = String string="bbb"
    v4 = Call v2, v0, v3 calleeKey=@@matchAll
    Return
}
