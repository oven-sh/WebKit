# a = launder([]); a.foo = 1; Array.foo
# An array reaches native code and comes back as the unknown object. Nothing looks up the name constructor or a key nobody can name through it, so the program holds no constructor as an unknown value
# and no store through the unknown object reaches Array.
# RUN: flow-solve nodes sinks
# CHECK: Variable(g0) = {undefined}
# CHECK-LABEL: nativeCode {
# CHECK: ArrayPrototype
# CHECK-NOT: , Array,
# CHECK-LABEL: unknownJavaScript {

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="onArray" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="launder" [isFreeName]
    v2 = Integer integer=1
    v3 = NewArray
    v4 = Call v1, -, v3
    PropSet v4, v2 key="foo" mode=Sloppy
    v6 = Builtin builtin=Array
    v7 = PropGet v6 key="foo"
    PutModuleVariable v7 variable=g0
    Return
}
