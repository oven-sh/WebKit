# An index that was below the length is inside for good only in an array that never gets shorter, and a method nobody knows, called on a receiver nobody knows, may shorten every array that has reached native code. An array that stays inside keeps the proof
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK-NOT: variable g0 type={{*}}Dense
# CHECK: variable g1 type=Array<{{*}}, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="escaped" declared={type=anything} initialization=Uninitialized
variable g1 name="inside" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="t"
    v1 = NewArray v0, v0, v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewArray v0, v0, v0 contents=anything holes=[]
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v1
    v8 = Integer integer=2
    v9 = PropGet v1 key="length"
    v10 = Less v8, v9
    Branch v10 -> taken b1(), notTaken b3()
  b1():
    v11 = PropGet v7 key="pop"
    v12 = Call v11, v7
    v13 = Call v11, v7
    ElemSet v1, v8, v0 mode=Strict
    v15 = PropGet v3 key="length"
    v16 = Less v8, v15
    Branch v16 -> taken b2(), notTaken b3()
  b2():
    ElemSet v3, v8, v0 mode=Strict
    Jump -> next b3()
  b3():
    Return
}
