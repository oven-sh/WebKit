# A store under "-1", under the number -1 or under a number nobody knows adds a property to an array: the names are not proven and, where no operation names the key, the added keys are not complete. The storage aspect stays: the property is no accessor. A store under an index and a read under such a name cost nothing
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK: class C0 builtinClass=Array pristine=[Storage] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity,{{*}}addedKeys=["-1"] addedKeysAreComplete=true
# CHECK: class C1 builtinClass=Array pristine=[Storage] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity,
# CHECK-NOT: class C1 {{*}}addedKeysAreComplete
# CHECK: class C2 builtinClass=Array pristine=[Storage] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity,
# CHECK-NOT: class C2 {{*}}addedKeysAreComplete
# CHECK: class C3 builtinClass=Array pristine=[Storage, Names] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity,{{*}}addedKeysAreComplete=true
# CHECK: class C4 builtinClass=Array pristine=[Storage, Names, Dense] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity,{{*}}addedKeysAreComplete=true
# CHECK: variable g0 type=Array<"t", proven, pristine[Storage]> 
# CHECK: variable g1 type=Array<"t", proven, pristine[Storage]> 
# CHECK: variable g2 type=Array<"t", proven, pristine[Storage]> 
# CHECK: variable g3 type=Array<"t", proven, pristine[Storage, Names]> 
# CHECK: variable g4 type=Array<"t", proven, pristine[Storage, Names, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="underTheNameMinusOne" declared={type=anything} initialization=Uninitialized
variable g1 name="underTheNumberMinusOne" declared={type=anything} initialization=Uninitialized
variable g2 name="underAnyNumber" declared={type=anything} initialization=Uninitialized
variable g3 name="underIndex" declared={type=anything} initialization=Uninitialized
variable g4 name="readUnderMinusOne" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="t"
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    PropSet v1, v0 key="-1" mode=Strict
    v4 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v4 variable=g1
    v6 = Integer integer=-1
    ElemSet v4, v6, v0 mode=Strict
    v8 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v8 variable=g2
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="sink" [isFreeName]
    v12 = ToNumber v11
    ElemSet v8, v12, v0 mode=Strict
    v14 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v14 variable=g3
    v16 = Integer integer=1
    ElemSet v14, v16, v0 mode=Strict
    v18 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v18 variable=g4
    v20 = PropGet v18 key="-1"
    v21 = ElemGet v18, v6
    Return
}
