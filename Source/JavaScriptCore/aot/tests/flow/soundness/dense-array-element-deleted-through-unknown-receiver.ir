# A delete under an index through a receiver nobody knows may leave a hole in every array that has reached native code. An array that stays inside has none
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK-NOT: variable g0 type={{*}}Dense
# CHECK: variable g1 type=Array<{{*}}, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="escaped" declared={type=anything} initialization=Uninitialized
variable g1 name="inside" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="t"
    v1 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v1 variable=g0
    v3 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v1
    v8 = Integer integer=0
    v9 = ElemDelete v7, v8 mode=Strict
    Return
}
