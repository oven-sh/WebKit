# RUN: flow-solve nodes
# RUN(CHECK2): flow-solve nodes
# CHECK: f1, parameter 0) = {Promise}
# CHECK2: f1, parameter 0) = {undefined|null|boolean|number|string|symbol|bigint|unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=0 function=f1

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Promise" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Construct v1, -, v2 calleeName="Promise"
    v4 = PropGet v0 key="launder" [isFreeName]
    v5 = Call v4, -, v1
    v6 = NewClosure function=f3
    v7 = Call v6, -, v5
    v8 = Call v6, -, v7
    v9 = Construct v8, v2
    Return v9
}
function f1 name="Promise" kind=BaseConstructor role=Library flags=[HasNewTarget, HasExplicitName, IsNakedConstructor] length=1 enclosingRuntimeFunction=0 parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject
    Return v2
}
function f2 name="executor" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="same" parameters=[{type=anything}] results=[{type=anything}] {
