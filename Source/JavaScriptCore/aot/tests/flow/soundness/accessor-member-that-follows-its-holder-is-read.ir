# v = module[k]
# The read under a key nobody can name meets the unknown object above the module object, so the members of the built-in objects in native code follow them. Iterator.prototype is there, and its
# member constructor is an accessor: what follows is what its getter answers, the function Iterator. From then on a lookup by name through the unknown object leaves the member to native code,
# and nothing in this program has looked the name up before, so nobody else applies the getter.
# RUN: flow-solve sinks
# CHECK-LABEL: nativeCode {
# CHECK: , Iterator,
# CHECK-LABEL: unknownJavaScript {

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="k" [isFreeName]
    v8 = ElemGet v3, v7
    PutModuleVariable v8 variable=g0
    Return
}
