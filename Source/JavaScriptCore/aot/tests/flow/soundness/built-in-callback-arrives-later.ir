# The node whose values a built-in calls holds nothing, or only undefined, when the call is first looked at. A function that arrives three calls later is called with what the built-in passes
# RUN: flow-links calls
# RUN(NODES): flow-solve nodes
# CHECK: f0 v13 -> [[first]] f4 BuiltinCallback Once
# RUN(SECOND): flow-links calls
# SECOND: f0 v14 -> [[second]] f4 BuiltinCallback Once
# NODES: , f4, parameter 0) = {string}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="x"
    v1 = Builtin builtin=StringPrototypeReplace
    v2 = Undefined
    v3 = NewClosure function=f1
    v4 = Call v3
    v5 = Call v4
    v6 = Call v5
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="flag" [isFreeName]
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v6)
  b3(v10):
    v11 = Integer integer=1
    v12 = Integer integer=2
    v13 = Call v1, v0, v0, v10
    v14 = Call v1, v0, v0, v6
    Return
}
function f1 name="stage1" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="stage2" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    Return v0
}
function f3 name="stage3" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    Return v0
}
function f4 name="replacer" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
