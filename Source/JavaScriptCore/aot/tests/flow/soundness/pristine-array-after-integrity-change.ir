# A sealed, closed or frozen array may have lost the marks that the pristine test reads, so flow proves no aspect of it. An array whose integrity is only asked about keeps both
# OPTIONS: check=FlowFixpoint
# RUN: flow
# CHECK: variable g0 type=Array<"t", proven> 
# CHECK: variable g1 type=Array<"t", proven> 
# CHECK: variable g2 type=Array<"t", proven> 
# CHECK: variable g3 type=Array<"t", proven, pristine[Storage, Names, Dense]> 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="sealed" declared={type=anything} initialization=Uninitialized
variable g1 name="closed" declared={type=anything} initialization=Uninitialized
variable g2 name="frozen" declared={type=anything} initialization=Uninitialized
variable g3 name="asked" declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="t"
    v1 = Builtin builtin=Object
    v2 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v2 variable=g0
    v4 = PropGet v1 key="seal"
    v5 = Call v4, v1, v2
    v6 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v6 variable=g1
    v8 = PropGet v1 key="preventExtensions"
    v9 = Call v8, v1, v6
    v10 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v10 variable=g2
    v12 = PropGet v1 key="freeze"
    v13 = Call v12, v1, v10
    v14 = NewArray v0 contents=anything holes=[]
    PutModuleVariable v14 variable=g3
    v16 = PropGet v1 key="isFrozen"
    v17 = Call v16, v1, v14
    Return
}
