# function F() { this.x = 1 }  function install(p, f) { p.m = f }  const T = { a: install, undefined: Boolean };  function key() { return k }
# T[key()](F.prototype, function () { return 1 });  var k = "a";  function use(o) { return o.m() }  use(new F())
# The key is undefined when the call runs, so Boolean is called and nothing is installed.
# A store in an instance that stands for the calls of one site counts as that call while the site has this one callee. The built-in arrives after the order of execution
# was computed first (that computation adds undefined to k). Its link is counted, so the order is computed again and claims nothing.
# A helper that stays the one callee: results/class-prototype-assigned-before-reads.ir
