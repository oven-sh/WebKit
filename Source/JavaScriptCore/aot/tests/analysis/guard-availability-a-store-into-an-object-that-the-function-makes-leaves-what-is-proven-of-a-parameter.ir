# A store into an object that the function makes leaves the guard of a test of an entry parameter, though the new object has been handed on: it was not there when the function was entered
# FORM: Prepared
# RUN: guards points uses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Item" fields=[{key="count" declared={type=undefined|number}}]
variable g0 name="kept" module=m0 declared={type=anything}

function f0 name="anEntryParameterIsTested" parameters=[{type=L0}, {type=undefined|number}] results=[{type=anything}] {
    v2 = IsSlotFilled v0 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = NewObject layout=L0
    PutModuleVariable v4 variable=g0
    PutSlot v4, -, v1 key="count" receivers=[L0] level=Proven
    v7 = GetSlot v0, v3 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Return v7
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b1:2 available: [v3]
# CHECK-NEXT: b1:3 available: [v3]
# CHECK: v7 guard v3: Available

function f1 name="oneOfTwoEntryParametersIsTestedBehindTheNewObject" parameters=[{type=L0}, {type=L0}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
    v4 = NewObject layout=L0
    PutModuleVariable v4 variable=g0
    Branch v3 -> taken b1(v0), notTaken b1(v1)
  b1(v6: L0):
    v7 = IsSlotFilled v6 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    PutSlot v4, -, v2 key="count" receivers=[L0] level=Proven
    v10 = GetSlot v6, v8 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Return v10
  b3():
    Return
}
# CHECK-LABEL: function f1
# CHECK: b2:0 available: [v8]
# CHECK-NEXT: b2:1 available: [v8]
# CHECK: v10 guard v8: Available

function f2 name="whatAReadGaveIsTested" parameters=[{type=undefined|number}] results=[{type=anything}] {
    v1 = NewObject layout=L0
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g0
    v4 = AssumeType v3 provenType=L0
    v5 = IsSlotFilled v4 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Branch v5 -> taken b1(| 0), notTaken b2()
  b1(v6):
    PutSlot v1, -, v0 key="count" receivers=[L0] level=Proven
    Return
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK: b1:0 available: [v6]
# CHECK-NEXT: b1:1 available: []

function f3 name="theParameterOrTheNewObjectIsTested" parameters=[{type=L0}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject layout=L0
    PutModuleVariable v3 variable=g0
    Branch v2 -> taken b1(v0), notTaken b1(v3)
  b1(v5: L0):
    v6 = IsSlotFilled v5 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    PutSlot v3, -, v1 key="count" receivers=[L0] level=Proven
    Return
  b3():
    Return
}
# CHECK-LABEL: function f3
# CHECK: b2:0 available: [v7]
# CHECK-NEXT: b2:1 available: []

function f4 name="theStoreGoesToAnotherEntryParameter" parameters=[{type=L0}, {type=L0}, {type=undefined|number}] results=[{type=anything}] {
    v3 = IsSlotFilled v0 key="count" receivers=[L0] level=Proven [holdsDeclaredType]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    PutSlot v1, -, v2 key="count" receivers=[L0] level=Proven
    Return
  b2():
    Return
}
# CHECK-LABEL: function f4
# CHECK: b1:0 available: [v4]
# CHECK-NEXT: b1:1 available: []
