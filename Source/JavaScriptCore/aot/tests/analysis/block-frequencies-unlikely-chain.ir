# A block recorded as unlikely stays unlikely where an unlikely block jumps to it: each failing test of a chain enters one unlikely copy of the chain at its own place. A jump from a normal block makes the block normal, and so does a jump from a block whose own record is ignored for that reason
# FORM: Prepared
# RUN: frequencies

module m0 path="main.js" displayPath="main.js"
function f0 name="chain" parameters=[{type=boolean}, {type=boolean}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean, v1: boolean, v2: boolean):
    Branch v0 -> taken b1(), notTaken b4()
  b1():
    Branch v1 -> taken b2(), notTaken b5()
  b2():
    Branch v2 -> taken b3(), notTaken b6()
  b3():
    Return
  b4() frequency=Unlikely:
    Jump -> next b5()
  b5() frequency=Unlikely:
    Jump -> next b6()
  b6() frequency=Unlikely:
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: b0 frequency: Normal
# CHECK-NEXT: b1 frequency: Normal
# CHECK-NEXT: b2 frequency: Normal
# CHECK-NEXT: b3 frequency: Normal
# CHECK-NEXT: b4 frequency: Unlikely
# CHECK-NEXT: b5 frequency: Unlikely
# CHECK-NEXT: b6 frequency: Unlikely

function f1 name="enteredFromNormalBlocks" parameters=[{type=boolean}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean, v1: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2() frequency=Unlikely:
    Jump -> next b3()
  b3() frequency=Unlikely:
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: b0 frequency: Normal
# CHECK-NEXT: b1 frequency: Normal
# CHECK-NEXT: b2 frequency: Normal count: 1.000000
# CHECK-NEXT: b3 frequency: Normal count: 1.000000
