# A store into an object that this function allocated and that has not escaped yet cannot reach an object from outside, even if the new object escapes later.
# FORM: Prepared
# RUN: guards points

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
variable g0 name="published" module=m0 declared={type=anything} initialization=Undefined

function f0 name="returnedLater" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
