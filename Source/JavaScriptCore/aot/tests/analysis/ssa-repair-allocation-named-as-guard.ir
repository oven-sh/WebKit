# A store into a new object names the allocation as its guard. Where two copies of the allocation meet, the parameter they meet in is the object and no guard,
# so the guard gets a parameter of its own, for which each way passes an AllGuards of its allocation
# FORM: Prepared
# RUN: repair function=f0 variable=v2,v3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="twoCopiesOfTheAllocation" parameters=[{type=boolean}, {type=number}] results=[{type=anything}] {
  b0(v0: boolean, v1: number):
    v2 = NewObject layout=L0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    v3 = NewObject layout=L0
    Jump -> next b3()
  b3():
    PutSlotOrAdd v2, v2, v1 key="x" receivers=[L0]
    Return v2
}
# CHECK: function f0
# CHECK: v2: L0 = NewObject layout=L0
# CHECK-NEXT: [[first]]: guard = AllGuards v2
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v2, [[first]])
# CHECK-NEXT: b2():
# CHECK-NEXT: v3: L0 = NewObject layout=L0
# CHECK-NEXT: [[second]]: guard = AllGuards v3
# CHECK-NEXT: Jump -> next b3(v3, [[second]])
# CHECK-NEXT: b3([[object]]: L0, [[guard]]: guard):
# CHECK-NEXT: PutSlotOrAdd [[object]], [[guard]], v1 key="x" receivers=[L0]
# CHECK-NEXT: Return [[object]]
