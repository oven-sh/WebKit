# A guard parameter proves what every incoming guard proves
# FORM: Prepared
# RUN: guards

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]
layout L1 name="Size" fields=[{key="x" declared={type=anything}}]

function f0 name="sameLayoutsSameObject" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b3(| 0), notTaken b4()
  b2():
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4):
    v5 = GetSlotOrUndefined v0, v4 key="x" receivers=[L0] level=Proven
    Return v5
  b4():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v4 facts: [Shape of v0 by v2 reads ShapeWords[L0]]

function f1 name="differentLayouts" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b3(| 0), notTaken b4()
  b2():
    v3 = ShapeTest v0 layouts=[L1]
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4):
    Return v0
  b4():
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v4 facts: [Shape of v0 by v2 or v3 reads ShapeWords[L0] ShapeWords[L1]]

function f2 name="differentObjects" parameters=[{type=object}, {type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: object, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b3(| 0), notTaken b4()
  b2():
    v4 = ShapeTest v1 layouts=[L0]
    Branch v4 -> taken b3(| 0), notTaken b4()
  b3(v5):
    Return v0
  b4():
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v5 facts: []

function f3 name="carriedAroundLoop" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2):
    LoopHint
    v4 = GetSlotOrUndefined v0, v2 key="x" receivers=[L0] level=Proven
    v5 = ToBoolean v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v2)
  b3():
    Return v4
  b4():
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v2 facts: [Shape of v0 by v1 reads ShapeWords[L0]]

function f4 name="testedAgainInLoop" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    LoopHint
    v4 = GetSlotOrUndefined v0, v2 key="x" receivers=[L0] level=Proven
    v5 = ShapeTest v0 layouts=[L0]
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    Jump -> next b1(v6)
  b3():
    Return
}
# CHECK-LABEL: function f4
# CHECK-NEXT: v2 facts: [Shape of v0 by v1 reads ShapeWords[L0]]
# CHECK-NEXT: v6 facts: [Shape of v0 by v5 reads ShapeWords[L0]]

function f5 name="loopPassesAnotherLayout" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    LoopHint
    v4 = ShapeTest v0 layouts=[L1]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Jump -> next b1(v5)
  b3():
    Return
}
# CHECK-LABEL: function f5
# CHECK-NEXT: v2 facts: [Shape of v0 by v1 or v4 reads ShapeWords[L0] ShapeWords[L1]]
# CHECK-NEXT: v5 facts: [Shape of v0 by v4 reads ShapeWords[L1]]

function f6 name="allocationMeetsTest" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    Branch v1 -> taken b1(), notTaken b3()
  b1():
    v3 = ShapeTest v2 layouts=[L0]
    Branch v3 -> taken b4(| 0), notTaken b2()
  b2():
    Return
  b3():
    v4 = AllGuards v2
    Jump -> next b4(v4)
  b4(v5):
    v6 = GetSlotOrUndefined v2, v5 key="x" receivers=[L0] level=Proven
    Return v6
}
# CHECK-LABEL: function f6
# CHECK: v5 facts: [Shape of v2 by v3 reads ShapeWords[L0]]
