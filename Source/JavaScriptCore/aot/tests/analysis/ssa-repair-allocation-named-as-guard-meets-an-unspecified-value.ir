# A store into a new object names the allocation as its guard. Where the allocation meets a value that stands for no object, that way passes a guard that proves nothing
# FORM: Prepared
# RUN: repair function=f0 variable=v2,v4

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="oneWayBringsNoObject" parameters=[{type=boolean}, {type=number}] results=[{type=anything}] {
    v2 = NewObject layout=L0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Jump -> next b3(v3)
  b2():
    v4 = Unspecified valueType=L0
    v5 = Integer
    Jump -> next b3(v5)
  b3(v6):
    Switch v6 cases=[1] -> case b4(), otherwise b5()
  b4():
    PutSlotOrAdd v2, v2, v1 key="x" receivers=[L0]
    Return v2
  b5():
    Return
}
# CHECK: function f0
# CHECK: v2: L0 = NewObject layout=L0
# CHECK-NEXT: [[proof]]: guard = AllGuards v2
# CHECK: Jump -> next b3(v3, v2, [[proof]])
# CHECK: v4: L0 = Unspecified valueType=L0
# CHECK-NEXT: [[nothing]]: guard = AllGuards
# CHECK-NEXT: v5: 0 = Integer
# CHECK-NEXT: Jump -> next b3(v5, v4, [[nothing]])
# CHECK: PutSlotOrAdd [[object]], [[guard]], v1 key="x" receivers=[L0]
# CHECK-NEXT: Return [[object]]
