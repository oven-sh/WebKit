# What an array is declared to hold says which kind of storage an access expects of it: Double for numbers, with or without undefined and null, Int32 for integers that all fit an int32, Contiguous for anything else, and no kind where nothing is declared. A kind that a type names goes before the elements
# FORM: Prepared
# RUN: element-access

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]

function f0 name="expected-receivers" parameters=[{type=Array<number> flags=[IsExpected]}, {type=Array<int[0, 7]> flags=[IsExpected]}, {type=Array<string> flags=[IsExpected]}, {type=Array<anything> flags=[IsExpected]}, {type=int[0, 9]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number>, v1: anything ~ Array<int[0, 7]>, v2: anything ~ Array<string>, v3: anything ~ Array<anything>, v4: int[0, 9]):
    v5 = ElemGet v0, v4
    v6 = ElemGet v1, v4
    v7 = ElemGet v2, v4
    v8 = ElemGet v3, v4
    Return v5
}
# CHECK: F0 v5 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[class, pristine(Storage), storage]
# CHECK-NEXT: F0 v6 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[class, pristine(Storage), storage]
# CHECK-NEXT: F0 v7 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[class, pristine(Storage), storage]
# CHECK-NEXT: F0 v8 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Other integralKey tests=[class, pristine(Storage)]
function f1 name="numbers" parameters=[{type=Array<number>}, {type=Array<undefined|number>}, {type=Array<null|number>}, {type=Array<undefined|null|number>}, {type=Array<int[0, 4294967295]>}, {type=int[0, 9]}] results=[{type=anything}] {
    v6 = ElemGet v0, v5
    v7 = ElemGet v1, v5
    v8 = ElemGet v2, v5
    v9 = ElemGet v3, v5
    v10 = ElemGet v4, v5
    Return v6
}
# CHECK-NEXT: F1 v6 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F1 v7 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F1 v8 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F1 v9 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F1 v10 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
function f2 name="integers-that-fit-an-int32" parameters=[{type=Array<i32>}, {type=Array<int[0, 7]>}, {type=Array<undefined|int[0, 7]>}, {type=Array<int[-1, 1]>}, {type=int[0, 9]}] results=[{type=anything}] {
    v5 = ElemGet v0, v4
    v6 = ElemGet v1, v4
    v7 = ElemGet v2, v4
    v8 = ElemGet v3, v4
    Return v5
}
# CHECK-NEXT: F2 v5 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F2 v6 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F2 v7 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F2 v8 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
function f3 name="other-elements" parameters=[{type=Array<string>}, {type=Array<number|string>}, {type=Array<boolean>}, {type=Array<bigint>}, {type=Array<L0>}, {type=Array<undefined|L0>}, {type=Array<number|L0>}, {type=int[0, 9]}] results=[{type=anything}] {
    v8 = ElemGet v0, v7
    v9 = ElemGet v1, v7
    v10 = ElemGet v2, v7
    v11 = ElemGet v3, v7
    v12 = ElemGet v4, v7
    v13 = ElemGet v5, v7
    v14 = ElemGet v6, v7
    Return v8
}
# CHECK-NEXT: F3 v8 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v9 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v10 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v11 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v12 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v13 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F3 v14 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
function f4 name="nothing-declared" parameters=[{type=Array<anything>}, {type=Array<undefined>}, {type=Array<undefined|null>}, {type=int[0, 9]}] results=[{type=anything}] {
    v4 = ElemGet v0, v3
    v5 = ElemGet v1, v3
    v6 = ElemGet v2, v3
    Return v4
}
# CHECK-NEXT: F4 v4 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Other integralKey tests=[pristine(Storage)]
# CHECK-NEXT: F4 v5 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Other integralKey tests=[pristine(Storage)]
# CHECK-NEXT: F4 v6 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Other integralKey tests=[pristine(Storage)]
function f5 name="named-kind-goes-first" parameters=[{type=Array<number, Int32> flags=[IsExpected]}, {type=Array<number>}, {type=Array<number, proven, Int32>}, {type=Array<anything>}, {type=Array<number, proven>}, {type=int[0, 9]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number, Int32>, v1: Array<number> ~ Array<number, Int32>, v2: Array<number, proven, Int32>, v3: Array<anything> ~ Array<number>, v4: Array<number, proven>, v5: int[0, 9]):
    v6 = ElemGet v0, v5
    v7 = ElemGet v1, v5
    v8 = ElemGet v2, v5
    v9 = ElemGet v3, v5
    v10 = ElemGet v4, v5
    Return v6
}
# CHECK-NEXT: F5 v6 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[class, pristine(Storage), storage]
# CHECK-NEXT: F5 v7 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F5 v8 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage)]
# CHECK-NEXT: F5 v9 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F5 v10 ElemGet: form=Array level=Expected operation=GetArrayElement class=[[array]] storage=Double integralKey tests=[pristine(Storage), storage]
function f6 name="every-access-expects-the-same-kind" parameters=[{type=Array<int[0, 7]>}, {type=Array<string>}, {type=int[0, 9]}, {type=int[0, 7]}, {type=string}] results=[{type=boolean}] {
    ElemSet v0, v2, v3
    ElemDefine v0, v2, v3
    v7 = ElemHas v0, v2
    ElemSet v1, v2, v4
    ElemDefine v1, v2, v4
    v10 = ElemHas v1, v2
    Return v7
}
# CHECK-NEXT: F6 v5 ElemSet: form=Array level=Expected operation=PutArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F6 v6 ElemDefine: form=Array level=Expected operation=PutArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F6 v7 ElemHas: form=Array level=Expected operation=HasArrayElement class=[[array]] storage=Int32 integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F6 v8 ElemSet: form=Array level=Expected operation=PutArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F6 v9 ElemDefine: form=Array level=Expected operation=PutArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NEXT: F6 v10 ElemHas: form=Array level=Expected operation=HasArrayElement class=[[array]] storage=Contiguous integralKey tests=[pristine(Storage), storage]
# CHECK-NOT: storage=
