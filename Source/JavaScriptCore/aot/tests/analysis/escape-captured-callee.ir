# A captured object that a called closure calls escapes at the capture unless it is a closure whose call is harmless
# FORM: AsRead
# RUN: analyses escape flow function=f0

layout L0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f1
    v2 = CallDirect v1 function=f4
    v3 = NewObject layout=L0 fields=[]
    v4 = NewClosure v3 function=f3
    v5 = NewClosure v4 function=f2
    v6 = CallDirect v5 function=f4
    Return
}
function f1 name="callsCapturedObject" kind=Arrow captures=[{type=object}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
function f2 name="callsCapturedClosure" kind=Arrow captures=[{type=function}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
function f3 name="inspectsCapture" kind=Arrow captures=[{type=object}] results=[{type=undefined}] {
    v1 = TypeTest v0 testedType=object
    Return
}
function f4 name="callsArgument" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
