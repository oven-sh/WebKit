# A block is in a cycle avoiding another block if control can return to it without entering the other block
# FORM: Prepared
# RUN: analyses cycles-avoiding-blocks

module m0 path="main.js" displayPath="main.js"
function f0 name="nestedLoops" parameters=[{type=boolean}, {type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    Jump -> next b2()
  b2():
    LoopHint
    Branch v0 -> taken b2(), notTaken b3()
  b3():
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Return
}
# CHECK: function f0
# CHECK-NEXT: cycles-avoiding-blocks:
# CHECK-NEXT: b0 in cycle avoiding: []
# CHECK-NEXT: b1 in cycle avoiding: [b0 b4]
# CHECK-NEXT: b2 in cycle avoiding: [b0 b1 b3 b4]
# CHECK-NEXT: b3 in cycle avoiding: [b0 b4]
# CHECK-NEXT: b4 in cycle avoiding: []

function f1 name="diamondInLoop" parameters=[{type=boolean}, {type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b4()
  b3():
    Jump -> next b4()
  b4():
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return
}
# CHECK-NEXT: function f1
# CHECK-NEXT: cycles-avoiding-blocks:
# CHECK-NEXT: b0 in cycle avoiding: []
# CHECK-NEXT: b1 in cycle avoiding: [b0 b2 b3 b5]
# CHECK-NEXT: b2 in cycle avoiding: [b0 b3 b5]
# CHECK-NEXT: b3 in cycle avoiding: [b0 b2 b5]
# CHECK-NEXT: b4 in cycle avoiding: [b0 b2 b3 b5]
# CHECK-NEXT: b5 in cycle avoiding: []
