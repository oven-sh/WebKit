# A store to a local allocation does not kill guards on a parameter, even when the allocation is returned
# FORM: Prepared
# RUN: guards points uses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="fieldAddedToOwnAllocationThatIsReturned" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4):
    v5 = HasKeyOrder v0, v4 layout=L0 fields=[0]
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    PutSlotOrAdd v2, v2, v1 key="y" receivers=[L0] level=Proven
    v8 = AllGuards v4, v6
    PutSlot v0, v8, v1 key="x" receivers=[L0] level=Proven
    Return v2
  b3():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b2:0 available: [v2 v4 v6]
# CHECK-NEXT: b2:1 available: [v4 v6]
# CHECK-NEXT: b2:2 available: [v4 v6 v8]
# CHECK-NEXT: b2:3 available: [v4 v6 v8]
# CHECK: v9 guard v8: Available

function f1 name="slotOfOwnAllocationThatIsReturnedIsStored" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4):
    v5 = IsSlotFilled v0, v4 key="x" receivers=[L0] level=Proven
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    PutSlot v2, v2, v1 key="x" receivers=[L0] level=Proven
    v8 = AllGuards v4, v6
    v9 = GetSlot v0, v8 key="x" receivers=[L0] level=Proven
    Return v2
  b3():
    Return
}
# CHECK-LABEL: function f1
# CHECK: b2:0 available: [v2 v4 v6]
# CHECK-NEXT: b2:1 available: [v2 v4 v6]
# CHECK-NEXT: b2:2 available: [v2 v4 v6 v8]
# CHECK: v9 guard v8: Available
