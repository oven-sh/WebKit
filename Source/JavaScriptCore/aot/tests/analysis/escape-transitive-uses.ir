# Uses that a callee applies transitively reach what a container holds whatever the order of the calls
# FORM: AsRead
# RUN: analyses escape flow function=f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Leaf" fields=[{key="v" declared={type=anything}}]
layout L1 name="Middle" fields=[{key="y" declared={type=anything}}, {key="n" declared={type=anything}}]
layout L2 name="Root" fields=[{key="x" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Undefined
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v1, v0 layout=L1 fields=[0, 1]
    v3 = NewObject -, v2 layout=L2 fields=[0]
    v4 = NewClosure v2 function=f1
    v5 = CallDirect v4 function=f4
    v6 = CallDirect v3 function=f2
    v7 = CallDirect v3 function=f3
    v8 = NewObject -, v0 layout=L0 fields=[0]
    v9 = NewObject -, v8, v0 layout=L1 fields=[0, 1]
    v10 = NewObject -, v9 layout=L2 fields=[0]
    v11 = NewClosure v9 function=f1
    v12 = CallDirect v11 function=f4
    v13 = CallDirect v10 function=f3
    v14 = CallDirect v10 function=f2
    v15 = NewObject -, v0 layout=L0 fields=[0]
    v16 = NewObject -, v15, v0 layout=L1 fields=[0, 1]
    v17 = NewClosure v16 function=f1
    v18 = CallDirect v17 function=f4
    Return
}
function f1 name="storesCapturedField" kind=Arrow captures=[{type=anything}] results=[{type=undefined}] {
    v1 = Undefined
    PropSet v0, v1 key="n" mode=Strict
    Return
}
function f2 name="storesDeep" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = PropGet v0 key="x"
    v2 = PropGet v1 key="y"
    v3 = Undefined
    PropSet v2, v3 key="v" mode=Strict
    Return
}
function f3 name="readsDeep" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = PropGet v0 key="x"
    v2 = PropGet v1 key="y"
    v3 = PropGet v2 key="v"
    Return
}
function f4 name="callsArgument" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
# CHECK: function f0
# CHECK: objects: 11
# CHECK: o0 definition: v1
# CHECK: o0 uses: [{{*}}StoresByKey{{*}}]
# CHECK: o0 containers: [o1]
# CHECK: o4 definition: v8
# CHECK: o4 uses: [{{*}}StoresByKey{{*}}]
# CHECK: o4 containers: [o5]
# CHECK: o8 definition: v15
# CHECK: o8 uses: [Retains]
# CHECK: o8 containers: [o9]
