# A handler inside the loop: an exception thrown before the test reaches the back edge without passing the test, one thrown after the test has passed it
# FORM: Prepared
# RUN: induction

module m0 path="main.js" displayPath="main.js"

function f0 name="throwsBeforeTest" parameters=[{type=int[0, 1000]}, {type=anything}] results=[{type=undefined}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3) handler=b3():
    LoopHint
    v5 = Call v1, -, v3
    v6 = Less v3, v0
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    v7 = Increment v3
    Jump -> next b1(v7)
  b3() role=CatchHandler:
    v8 = CatchValue
    Jump -> next b2()
  b4():
    Return
}
