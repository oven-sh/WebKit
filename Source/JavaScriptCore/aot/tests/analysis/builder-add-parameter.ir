module m0 path="main.js" displayPath="main.js"
function f0 name="proofOnOneEdge" parameters=[{type=anything}, {type=number}, {type=number}] results=[{type=string}] {
  b0(v0: anything, v1: number, v2: number):
    Jump -> next b1()
  b1():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(v0 | 0), notTaken b2()
  b2():
    v4 = String string="none"
    Jump -> next b3(v0, v4)
  b3(v5, v6):
    Return v6
}
