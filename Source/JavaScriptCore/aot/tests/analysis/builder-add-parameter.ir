# TWO-NEXT: Return v6
function f1 name="argumentsOnEveryEdge" parameters=[{type=anything}, {type=number}, {type=number}] results=[{type=string}] {
  b0(v0: anything, v1: number, v2: number):
    Jump -> next b1()
  b1():
    v3 = TypeTest v0 testedType=string
    v4 = String string="some"
    Branch v3 -> taken b3(v0, v4), notTaken b2()
  b2():
    v5 = String string="none"
    Jump -> next b3(v0, v5)
  b3(v6, v7):
    Return v7
}
# ARGUMENTS: function f1
# ARGUMENTS: Branch v3 -> taken b3(v0, v4, v1), notTaken b2()
# ARGUMENTS: Jump -> next b3(v0, v5, v2)
# ARGUMENTS-NEXT: b3(v6: anything, v7: "none"|"some", [[added]]: number):
# ARGUMENTS-NEXT: Return v7
function f2 name="landingBlock" parameters=[{type=anything}, {type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number, v2: number) handler=b3():
    v3 = Call v0
    Jump -> next b1()
  b1() handler=b3():
    v4 = Call v0
    Jump -> next b2()
  b2():
    Return v4
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v5
}
# LANDING: function f2
# LANDING-NEXT: b0(v0: anything, v1: number, v2: number) handler=b3(v1):
# LANDING: b1() handler=b3(v2):
# LANDING: b3([[added]]: number) role=CatchHandler:
# LANDING-NEXT: v5: anything = CatchValue
# LANDING-NEXT: Return v5
function f3 name="twoProofsOnOneEdge" parameters=[{type=number|string}, {type=string}, {type=number}, {type=number}] results=[{type=string}] {
  b0(v0: number|string, v1: string, v2: number, v3: number):
    Jump -> next b1()
  b1():
    v4 = StrictEq v0, v1
    Branch v4 -> taken b3(| 0, 1), notTaken b2()
  b2():
    Jump -> next b3(v1, v1)
  b3(v5, v6):
    Return v5
}
