# A guard that enters a block on the same edge as its subject proves the same about the parameter that receives the subject
# FORM: Prepared
# RUN: guards uses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 name="Size" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="twoAllocations" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v3 = AllGuards v2
    Jump -> next b3(v2, v3)
  b2():
    v4 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v5 = AllGuards v4
    Jump -> next b3(v4, v5)
  b3(v6, v7):
    v8 = GetSlot v6, v7 key="x" receivers=[L0] level=Proven
    Return v8
}
# CHECK-LABEL: function f0
# CHECK: v7 facts: [Shape OwnInstance of v6 by allocation v2 reads -, SlotFilled of v6 by allocation v2 reads ShapeWords[L0], NoExtraProperties of v6 by allocation v2 reads NamedProperties, NoFieldOutsideSlot of v6 by allocation v2 reads NamedProperties, NotFrozen of v6 by allocation v2 reads ShapeWords[L0], KeyOrder of v6 by allocation v2 reads ShapeWords[L0] OrderWords]
# CHECK: b3 available at head: [v7.0 v7.1 v7.2 v7.3 v7.4 v7.5]
