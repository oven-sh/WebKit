# A type that only a declaration file states (`.d.ts`) is expected and never tested: nobody compared it with the code it describes.
# Where the program allocates no object of its family, a guard for the family would be the largest form of the access and would miss every time.
# The reader says of such layouts that they are never allocated, so the receiver has no candidates and the access is planned by name:
# no test of the receiver, no test of the slot, no path for a miss.
# At the end: a family with a member that the program allocates is still expected, and the test names that member alone
# FORM: AsRead
# RUN: property-access
# RUN(CANDIDATES): receiver-candidates

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=CallResult
layout L0 name="Options" fields=[{key="depth" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="inner" declared={type=undefined|null|L0 flags=[IsExpected]}}, {key="run" declared={type=undefined|null|function flags=[IsExpected]} flags=[IsRequired, IsMethod]}]
layout L1 name="WideOptions" fields=[{key="depth" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="inner" declared={type=undefined|null|L0 flags=[IsExpected]}}, {key="run" declared={type=undefined|null|function flags=[IsExpected]} flags=[IsRequired, IsMethod]}, {key="width" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Settings" fields=[{key="depth" declared={type=number flags=[IsExpected]} flags=[IsRequired]}]
layout L3 name="literal" fields=[{key="depth" declared={type=number} flags=[IsRequired]}] supertypes=[L2]

# `const settings: Settings = { depth: 1 }`
function f0 name="makesSettings" results=[{type=anything}] {
    v0 = NewObject layout=L3
    Return v0
}
function f1 name="readsMember" parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="depth"
    Return v1
}
# CHECK: F1 v1 PropGet [[depth]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES: F1 v1: proof=Unknown level=Unknown otherParts nullish
function f2 name="storesMember" parameters=[{type=undefined|null|L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="depth"
    Return
}
# CHECK-NEXT: F2 v2 PropSet [[depth]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES-NEXT: F2 v2: proof=Unknown level=Unknown otherParts nullish
function f3 name="testsMember" parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropHas v0 key="depth"
    Return v1
}
# CHECK-NEXT: F3 v1 PropHas [[depth]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES-NEXT: F3 v1: proof=Unknown level=Unknown otherParts nullish
function f4 name="callsMethod" parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
}
# CHECK-NEXT: F4 v1 PropGet [[run]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES-NEXT: F4 v1: proof=Unknown level=Unknown otherParts nullish
# The fields of layouts that nobody allocates say nothing about what a read finds, so nothing is expected of `options.inner` either
function f5 name="readsThroughMember" parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="inner"
    v2 = PropGet v1 key="depth"
    Return v2
}
# CHECK-NEXT: F5 v1 PropGet [[inner]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CHECK-NEXT: F5 v2 PropGet [[depth]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES-NEXT: F5 v1: proof=Unknown level=Unknown otherParts nullish
# CANDIDATES-NEXT: F5 v2: proof=Unknown level=Unknown otherParts nullish
# `declare function load(): Options`. The type of the result is the callee's own, so the call is no built-in that creates what its caller asks for
function f6 name="readsResultOfDeclaredFunction" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    v2 = Convert v1 declared={type=undefined|null|L0 site=w0 flags=[IsExpected]} illTypedCause=DeclarationWithoutBody
    v3 = PropGet v2 key="depth"
    Return v3
}
# CHECK-NEXT: F6 v3 PropGet [[depth]]: form=ByName level=Unknown receivers=[] cause=UnknownObject
# CANDIDATES-NEXT: F6 v3: proof=Unknown level=Unknown otherParts nullish
function f7 name="memberOfFamilyIsAllocated" parameters=[{type=undefined|null|L2 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="depth"
    Return v1
}
# CHECK-NEXT: F7 v1 PropGet [[depth]]: form=Slot level=Expected operation=GetSlot{{*}} receivers=[L3] receiverTest=Type
# CANDIDATES-NEXT: F7 v1: proof=Unknown level=Expected {{*}}=[L3] otherParts nullish
function f8 name="unionOfBothFamilies" parameters=[{type=undefined|null|L0|L2 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="depth"
    Return v1
}
# CHECK-NEXT: F8 v1 PropGet [[depth]]: form=Slot level=Expected operation=GetSlot{{*}} receivers=[L3] receiverTest=Type
# CANDIDATES-NEXT: F8 v1: proof=Unknown level=Expected {{*}}=[L3] otherParts nullish
