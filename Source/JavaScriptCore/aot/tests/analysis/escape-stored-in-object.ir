# CHECK-NEXT: o0 kind: Allocation
# CHECK-NEXT: o0 state: Escapes
# CHECK-NEXT: o0 reasons: [StoredInEscapingObject]
# CHECK-NEXT: o0 first escape: v2(0)
# CHECK-NEXT: o0 uses: [Inspects Retains]
# CHECK: o0 object uses: [v2(0) v4(0)]
# CHECK-NEXT: o0 escaping uses: [v2(0)]
