# CHECK-NEXT: o1 state: DoesNotEscape
# CHECK-NEXT: o1 reasons: []
# CHECK-NEXT: o1 first escape: none
# CHECK-NEXT: o1 uses: []
# CHECK: o1 contents: [o0]
# CHECK-NEXT: o1 containers: []
# CHECK: function f1
# CHECK-NEXT: escape:
