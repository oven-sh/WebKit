# A counter that steps down is bounded from below
# FORM: Prepared
# RUN: induction

module m0 path="main.js" displayPath="main.js"

function f0 name="subtractsOne" parameters=[{type=int[0, 1000]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    Jump -> next b1(v0)
  b1(v2):
    LoopHint
    v4 = GreaterEq v2, v1
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = Integer integer=1
    v7 = Sub v5, v6
    Jump -> next b1(v7)
  b3():
    Return
}
