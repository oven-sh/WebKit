# Unknown code does not call what flow proves to run at most once: a module body that calls unknown code is on no cycle with it and has one activation, and so has what it calls once
# FORM: AsRead
# RUN: heat-graph flow
# RUN(CLASSES): heat-graph flow classes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = NewClosure function=f2
    v5 = Call v3, -, v4
    v6 = CallDirect function=f1
    v7 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    v9 = CallDirect function=f3
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return
}
function f1 name="calledOnce" results=[{type=undefined}] {
    Return
}
function f2 name="escapes" results=[{type=undefined}] {
    Return
}
function f3 name="calledInLoop" results=[{type=undefined}] {
    Return
}
# CHECK: f0 size 14 mass 49.000000: f1*1.000000 f2*1.000000 f3*10.000000 unknown*
# CHECK: host: f0*1.000000 f4*1.000000
# CHECK-NEXT: unknown:
# CHECK-NEXT: activations:
# CHECK-NEXT: f0 1.000000
# CHECK-NEXT: f1 1.000000
# CHECK-NEXT: f2 [[activationsOfEscapedFunction]]
# CHECK-NEXT: f3 10.000000
# CHECK-NEXT: f4 [[activationsOfEscapedFunction]]
