# A call by value whose callees are all known ends a guard on an array only where one of them may write the array it is handed. A callee without a body counts as unknown code
# FORM: Prepared
# RUN: guards points summaries

module m0 path="main.js" displayPath="main.js"
function f0 name="calleesLeaveTheArrayAlone" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=f4|f5}] results=[{type=anything}] {
    v2 = HasArrayStorage v0 arrayStorage=Int32
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    v4 = Call v1, -, v0 callees=[f4, f5]
    Return v4
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: [v3]

