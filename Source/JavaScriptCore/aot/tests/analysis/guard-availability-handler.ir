function f3 name="calleeRunsUnknownCodeBeforeItThrows" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3) handler=b3():
    v4 = CallDirect v1 function=f4
    Jump -> next b2()
  b2():
    Return v0
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v5
  b4():
    Return
}
