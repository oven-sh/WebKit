function f7 name="thrownObjectIsWrittenThroughTheCaughtValue" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = GetSlot v2, v2 key="x" receivers=[L0] level=Proven
    Jump -> next b1()
  b1() handler=b2():
    Throw v2
  b2() role=CatchHandler:
    v4 = CatchValue
    v5 = Claim v4 castType=object
    DefineGetter v5, v0 key="z"
    Return v3
}
# CHECK-LABEL: function f7
