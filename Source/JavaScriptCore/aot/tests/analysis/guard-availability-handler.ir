function f4 name="logsBeforeThrow" parameters=[{type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="log" [isFreeName]
    v3 = Call v2, -, v0
    Throw v0
}

