# CHECK-NEXT: b1:1 available: [v4]
# CHECK-NEXT: b1:2 available: [v4]
# CHECK-NEXT: b2:0 available: [v4]
# CHECK-NEXT: b3:0 available: [v4]
# CHECK-NEXT: b3:1 available: [v4]
# CHECK-NEXT: b3:2 available: [v4]
# CHECK-NEXT: b4:0 available: []

function f2 name="oneOfTwoCoveredBlocksEndsIt" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3) handler=b4():
    v4 = GetSlotOrUndefined v0, v3 key="x" receivers=[L0] level=Proven
    v5 = Claim v4 castType=number
    Jump -> next b2()
  b2() handler=b4():
    v6 = Call v1
    Jump -> next b3()
  b3():
    Return v5
  b4() role=CatchHandler:
    v7 = CatchValue
    Return v7
  b5():
    Return
}
