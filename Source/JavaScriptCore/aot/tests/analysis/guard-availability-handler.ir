# In a landing block a guard is available only if nothing in the covered block may have ended it before the throw
# FORM: Prepared
# RUN: guards points
# RUN(SUMMARIES): guards points summaries function=f3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="unknownCodeInCoveredBlock" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3) handler=b3():
    v4 = GetSlotOrUndefined v0, v3 key="x" receivers=[L0] level=Proven
    v5 = Call v1
    Jump -> next b2()
  b2():
    Return v4
  b3() role=CatchHandler:
    v6 = CatchValue
    Return v6
  b4():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v3 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: b0 available at head: []
# CHECK-NEXT: b1 available at head: [v3.0]
# CHECK-NEXT: b2 available at head: []
# CHECK-NEXT: b3 available at head: []
# CHECK-NEXT: b4 available at head: []
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: [v3]
# CHECK-NEXT: b1:2 available: []
# CHECK-NEXT: b2:0 available: []
# CHECK-NEXT: b3:0 available: []
# CHECK-NEXT: b3:1 available: []
# CHECK-NEXT: b4:0 available: []

function f1 name="unknownCodeBeforeTheTest" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = Call v1
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4) handler=b3():
    v5 = GetSlotOrUndefined v0, v4 key="x" receivers=[L0] level=Proven
    v6 = Claim v5 castType=number
    Jump -> next b2()
  b2():
    Return v6
  b3() role=CatchHandler:
    v7 = CatchValue
    v8 = GetSlotOrUndefined v0, v4 key="x" receivers=[L0] level=Proven
    Return v8
  b4():
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v4 facts: [Shape of v0 by v3 reads ShapeWords[L0]]
# CHECK-NEXT: b0 available at head: []
