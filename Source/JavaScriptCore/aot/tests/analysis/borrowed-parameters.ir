# CHECK-LABEL: f26: 0 leaks, 1 leaks

function f27 name="callsFunctionThatReturnsItself" parameters=[{type=f28}] results=[{type=anything}] {
    v1 = Call v0 callees=[f28]
    Return v1
}
# A closure of a function that takes its callee lies in no frame, and whoever makes it knows that.
# CHECK-LABEL: f27: 0 borrowed

function f28 name="returnsItself" flags=[TakesCallee] results=[{type=function}] {
    Return v0
}
# CHECK-LABEL: f28: 0 leaks

function f29 name="returnsOneOfTwo" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    Return v3
}
# CHECK-LABEL: f29: 0 leaks, 1 leaks, 2 leaks

function f30 name="returnsNarrowedCopy" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=object
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return v2
  b2():
    Return
}
# CHECK-LABEL: f30: 0 leaks

function f31 name="returnsCast" parameters=[{type=object}] results=[{type=anything}] {
