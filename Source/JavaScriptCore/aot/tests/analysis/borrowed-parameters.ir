# CHECK-LABEL: f40: 0 borrowed
# CHECK-NOT: contents-leak

# The summary of a function is made from its body and from this table for its callees. Nothing two calls down calls the operand, so no call is named: the escape analysis takes an object that is called and is no closure for one that unknown code got.
function f41 name="nothingIsCalledTwoCallsDown" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = CallDirect v0 function=f40
    Return v1
}
# CHECK-LABEL: f41: 0 borrowed
# CHECK-NOT: contents-leak
# USES-LABEL: function f41
# USES: v1 CallDirect 0: [Inspects,
# USES-NOT: Calls

function f42 name="calledTwoCallsDown" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    Return v1
}
# CHECK-LABEL: f42: 0 borrowed
# CHECK-NOT: contents-leak
# USES-LABEL: function f42
# USES: v1 CallDirect 0: [Inspects, Calls, CallsPerElement, CallsRepeatedly,

# What becomes of a value in a field of an environment is known by the field, so a call of it says nothing about the environment.
function f43 name="callsWhatItReads" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = Call v1
    Return v2
}
# CHECK-LABEL: f43: 0 borrowed
# CHECK-NOT: contents-leak

function f44 name="passesEnvironmentToCallsWhatItReads" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = CallDirect v0 function=f43
    Return v1
}
# CHECK-LABEL: f44: 0 borrowed
# CHECK-NOT: contents-leak
# USES-LABEL: function f44
# USES: v1 CallDirect 0: [Inspects,
# USES-NOT: Calls

function f45 name="coroutine" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
# CHECK-LABEL: f45: 0 leaks

function f46 name="storesAfterAwait" role=CoroutineRamp flags=[IsAsync] parameters=[{type=L1}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f46 body=f47 entryWithoutPromise=f47 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f47
    Return v1
}
# CHECK-LABEL: f46: 0 leaks

function f47 name="storesAfterAwait" role=CoroutineBody flags=[IsAsync] parameters=[{type=L1}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f46 body=f47 entryWithoutPromise=f47 promiseType=Promise promiseParameter=1} {
    v2 = Null
    v3 = AwaitBySavingFrame v2, v1
    PutSlot v0, -, v2 key="held" receivers=[L1] level=Proven
    Return v3
}
# CHECK-LABEL: f47: 0 leaks, 1 leaks

# The rest array holds the arguments of the frame, which are no operands of the operation that makes it.
function f48 name="takesRest" role=GenericEntrypoint flags=[HasThis] captures=[{type=f18}] results=[{type=anything}] derivation={source=f18} creator=Entrypoint{target=f18} {
    v2 = CreateRest firstArgument=1
    Return v2
}
# CHECK-LABEL: f48: 0 leaks, 1 leaks
