# A function borrows an entry parameter that it only looks at, calls, reads, fills or hands to a function that borrows it. It does not borrow what it stores, returns, throws, captures, reads by name, constructs or hands to code that is not known to borrow it. What is read through a parameter is judged apart, and so is whether anything of it is called
# FORM: Prepared
# RUN: borrowed-parameters
# RUN(USES): operands summaries f41 f42 f44

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]
layout L1 name="Holder" fields=[{key="held" declared={type=anything} flow={occupancy=AlwaysFilled}}] flow={members=[L1]}
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="onlyCalls" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
# CHECK-LABEL: f0: 0 borrowed
# CHECK-NOT: contents-leak

function f1 name="passesToOnlyCalls" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    Return v1
}
# CHECK-LABEL: f1: 0 borrowed
# CHECK-NOT: contents-leak

function f2 name="ping" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f3
    Return v1
}
# CHECK-LABEL: f2: 0 borrowed
# CHECK-NOT: contents-leak

function f3 name="pong" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f2
    Return v1
}
# CHECK-LABEL: f3: 0 borrowed
# CHECK-NOT: contents-leak

function f4 name="readsAndWritesEnvironment" kind=Arrow captures=[{type=env L0}] results=[{type=boolean}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = ToBoolean v1
    PutEnvironmentField v0, v2 layout=L0 field=0
    Return v2
}
# CHECK-LABEL: f4: 0 borrowed
# CHECK-NOT: contents-leak

function f5 name="callsKnownCallees" parameters=[{type=f0|f1}, {type=anything}] results=[{type=anything}] {
    v2 = Call v0, -, v1 callees=[f0, f1]
    Return v2
}
# CHECK-LABEL: f5: 0 borrowed, 1 borrowed
# CHECK-NOT: contents-leak

function f6 name="compares" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v2 = StrictEq v0, v1
    Return v2
}
# CHECK-LABEL: f6: 0 borrowed, 1 borrowed
# CHECK-NOT: contents-leak

function f7 name="passesWhatItReadsToOnlyCalls" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = CallDirect v1 function=f0
    Return v2
}
# CHECK-LABEL: f7: 0 borrowed
# CHECK-NOT: contents-leak

function f8 name="returnsCallOfOnlyCalls" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    ReturnCall v1
}
# CHECK-LABEL: f8: 0 borrowed
# CHECK-NOT: contents-leak

function f9 name="storesInField" parameters=[{type=anything}, {type=L1}] results=[{type=undefined}] {
    PutSlot v1, -, v0 key="held" receivers=[L1] level=Proven
    Return
}
# CHECK-LABEL: f9: 0 leaks, 1 borrowed
# CHECK-NOT: contents-leak

function f10 name="storesInEnvironmentField" kind=Arrow captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: env L0, v1: anything):
    PutEnvironmentField v0, v1 layout=L0 field=0
    Return
}
# CHECK-LABEL: f10: 0 borrowed, 1 leaks

function f11 name="storesInVariable" parameters=[{type=anything}] results=[{type=undefined}] {
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-LABEL: f11: 0 leaks

function f12 name="returns" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
# CHECK-LABEL: f12: 0 leaks

function f13 name="throws" parameters=[{type=anything}] results=[{type=anything}] {
