    Return v1
}
# CHECK-LABEL: f15: 0 borrowed
# CHECK-NOT: contents-leak

function f16 name="passesOneArgumentTooMany" parameters=[{type=anything}, {type=anything}, {type=f0}] results=[{type=anything}] {
    v3 = Call v2, -, v0, v1 callees=[f0]
    Return v3
}
# CHECK-LABEL: f16: 0 borrowed, 1 leaks, 2 borrowed
# CHECK-NOT: contents-leak

function f17 name="passesToRestParameter" parameters=[{type=anything}, {type=f18}] results=[{type=anything}] {
