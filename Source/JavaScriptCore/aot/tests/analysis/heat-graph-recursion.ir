# A recursive cycle runs ten times what enters it, whatever the multipliers of the calls inside it
# FORM: Prepared
# RUN: heat-graph

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="" kind=Module results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    v1 = CallDirect function=f1
    v2 = CallDirect v0 function=f3
    v3 = CallDirect function=f4
    v4 = CallDirect function=f6
    Jump -> next b1()
  b1():
    LoopHint
    v6 = CallDirect function=f2
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="recursive" role=OutlinedBody results=[{type=undefined}] {
  b0():
    v0 = CallDirect function=f1
    Return v0
}
function f2 name="inLoop" role=OutlinedBody results=[{type=undefined}] {
  b0():
    Return
}
function f3 name="callsItselfInLoop" role=OutlinedBody parameters=[{type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = CallDirect v0 function=f3
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f4 name="even" role=OutlinedBody results=[{type=undefined}] {
  b0():
    v0 = CallDirect function=f5
    Return v0
}
function f5 name="odd" role=OutlinedBody results=[{type=undefined}] {
  b0():
    v0 = CallDirect function=f4
    Return v0
}
function f6 name="once" role=OutlinedBody results=[{type=undefined}] {
  b0():
    Return
}
