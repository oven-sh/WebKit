# Arguments and proofs go with their parameters on every edge
# FORM: Prepared
# RUN: remove-parameters function=f0 block=b3 indexes=0,2
# RUN(PROOF): remove-parameters function=f1 block=b3 indexes=1
# RUN(ARGUMENT): remove-parameters function=f1 block=b3 indexes=0

module m0 path="main.js" displayPath="main.js"
function f0 name="parameters" parameters=[{type=boolean}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number, v2: number, v3: number):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1, v2, v3)
  b2():
    Branch v0 -> taken b3(v3, v2, v1), notTaken b3(v2, v1, v2)
  b3(v4, v5, v6):
    LoopHint
    Branch v0 -> taken b3(v4, v5, v6), notTaken b4(v5, v5)
  b4(v8, v9):
    Return v8
  b5():
    Branch v0 -> taken b3(v1, v2, v3), notTaken b4(v1, v2)
}
# CHECK: function f0
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v2)
# CHECK-NEXT: b2():
# CHECK-NEXT: Branch v0 -> taken b3(v2), notTaken b3(v1)
# CHECK-NEXT: b3(v5: number):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Branch v0 -> taken b3(v5), notTaken b4(v5, v5)
# CHECK-NEXT: b4(v8: number, v9: number):
# CHECK-NEXT: Return v8
# CHECK-NEXT: b5():
# CHECK-NEXT: Branch v0 -> taken b3(v2), notTaken b4(v1, v2)
function f1 name="proofAndArgument" parameters=[{type=boolean}, {type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything, v2: string):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v1 testedType=string
    Branch v3 -> taken b3(v0 | 0), notTaken b2()
  b2():
    Jump -> next b3(v0, v2)
  b3(v4, v5):
    Return v1
}
# PROOF: function f1
# PROOF: b1():
# PROOF-NEXT: v3: boolean = TypeTest v1 testedType=string
# PROOF-NEXT: Branch v3 -> taken b3(v0), notTaken b2()
# PROOF-NEXT: b2():
# PROOF-NEXT: Jump -> next b3(v0)
# PROOF-NEXT: b3(v4: boolean):
# PROOF-NEXT: Return v1
# ARGUMENT: function f1
