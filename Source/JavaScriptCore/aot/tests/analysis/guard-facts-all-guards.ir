# AllGuards proves what its operands prove, each fact once, and nothing is known of it when one operand is unknown
# FORM: Prepared
# RUN: guards

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="unionOfTwoTests" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = IsSlotFilled v0, v2 key="x" receivers=[L0] level=Proven
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = AllGuards v2, v4
    v6 = GetSlot v0, v5 key="x" receivers=[L0] level=Proven
    Return v6
  b3():
    Return
}
# CHECK-LABEL: function f0
# CHECK: v5 facts: [Shape of v0 by v1 reads -, SlotFilled of v0 by v3 reads ObjectFields["x"]]

function f1 name="sameFactTwice" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = AllGuards v2, v4, v2
    v6 = GetSlotOrUndefined v0, v5 key="x" receivers=[L0] level=Proven
    Return v6
  b3():
    Return
}
# CHECK-LABEL: function f1
# CHECK: v4 facts: [Shape of v0 by v3 reads -]
# CHECK-NEXT: v5 facts: [Shape of v0 by v1 reads -]

function f2 name="unknownOperand" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Unspecified valueType=guard
    v4 = AllGuards v3
    v5 = AllGuards v2, v3
    v6 = AllGuards v2
    v7 = AllGuards
    Return v0
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK: v3 facts: unknown
# CHECK-NEXT: v4 facts: unknown
# CHECK-NEXT: v5 facts: unknown
# CHECK-NEXT: v6 facts: [Shape of v0 by v1 reads -]
# CHECK-NEXT: v7 facts: []
