# A callback that a function of the program calls in a loop counts with the weight of the site that hands it over, also through a function that only hands it on. The function that hands its own parameter on adds nothing. A callback that its receiver calls once has the edge out of the receiver alone
# FORM: AsRead
# RUN: heat-graph flow

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    v2 = NewClosure function=f2
    v3 = CallDirect v0, v2 function=f1
    v4 = NewClosure function=f5
    v5 = CallDirect v0, v4 function=f6
    v6 = NewClosure function=f8
    v7 = CallDirect v0, v6 function=f7
    v8 = NewClosure function=f10
    v9 = CallDirect v0, v8 function=f9
    Jump -> next b1()
  b1():
    LoopHint
    Jump -> next b2()
  b2():
    LoopHint
    v12 = NewClosure function=f3
    v13 = CallDirect v0, v12 function=f1
    Branch v1 -> taken b2(), notTaken b3()
  b3():
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Branch v1 -> taken b5(), notTaken b6()
  b5():
    v14 = NewClosure function=f4
    v15 = CallDirect v0, v14 function=f1
    Throw v0
  b6():
    Return
}
