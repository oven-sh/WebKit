# What the readers of an environment field do with its value reaches the object stored in that field
# FORM: AsRead
# RUN: analyses escape flow function=f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="outerScope" fields=[{key="tested" declared={type=anything}}, {key="written" declared={type=anything}}, {key="kept" declared={type=anything}}, {key="called" declared={type=anything}}]
layout L1 kind=Environment name="innerScope" fields=[{key="outer" declared={type=env L0}}]
layout L2 name="Point" fields=[{key="x" declared={type=anything}}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    Return
}
function f1 name="outer" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewObject -, v0 layout=L2 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewClosure function=f5
    v5 = NewObject -, v1, v2, v3, v4 layout=L0 fields=[0, 1, 2, 3]
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = NewClosure v5 function=f2
    v8 = CallDirect v7 function=f4
    v9 = NewClosure v6 function=f3
    v10 = CallDirect v9 function=f4
    Return
}
function f2 name="inner" kind=Arrow captures=[{type=env L0}] results=[{type=undefined}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = TypeTest v1 testedType=object
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = Integer integer=2
    PropSet v3, v4 key="x" mode=Strict
    v6 = GetEnvironmentField v0 layout=L0 field=2
    PutModuleVariable v6 variable=g0
    Return
}
function f3 name="throughOuter" kind=Arrow captures=[{type=env L1}] results=[{type=undefined}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = GetEnvironmentField v1 layout=L0 field=3
    v3 = Call v2
    Return
}
function f4 name="callsArgument" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
function f5 name="callback" kind=Arrow results=[{type=undefined}] {
    Return
}
# CHECK: function f1
# CHECK: objects: 8
# CHECK: o0 definition: v1
# CHECK: o0 state: DoesNotEscape
# CHECK: o0 uses: [Inspects Retains]
# CHECK: o0 containers: [o4]
# CHECK: o1 definition: v2
# CHECK: o1 state: DoesNotEscape
# CHECK: o1 uses: [Inspects Retains StoresByKey]
# CHECK: o1 containers: [o4]
# CHECK: o2 definition: v3
# CHECK: o2 state: Escapes
# CHECK: o2 reasons: [RetainedByCallee]
# CHECK: o2 first escape: v5(3)
# CHECK: o2 escaping uses: [v5(3)]
# CHECK: o3 definition: v4
# CHECK: o3 state: DoesNotEscape
# CHECK: o3 uses: [Inspects Retains Calls]
# CHECK: o3 escaping uses: []
# CHECK: o4 definition: v5
# CHECK: o4 state: DoesNotEscape
# CHECK: o4 contents: [o0 o1 o2 o3]
# CHECK: o4 containers: [o5 o6]
# CHECK: o5 definition: v6
# CHECK: o5 state: DoesNotEscape
