# const [...[...copy]] = numbers()
# FuseGeneratorLoops puts the body of the generator into the caller as a loop over states. What lives across the loop becomes a parameter of its head, and on the way in, where the value does not exist yet,
# an Unspecified value is passed. Nobody reads it, so it brings no object: the parameter still points to the one array, and an append to another fresh array does not end a guard about it.
# FORM: Prepared
# RUN: analyses escape aliases function=f0 alias-values=v4,v5,v6
# CHECK: v4 points to: [o1]
# CHECK: v4 may be untracked: no
# CHECK: v5 points to: [o0]
# CHECK: v5 may be untracked: no
# CHECK: aliases:
# CHECK: v4 v5 alias: NoAlias
# CHECK: v4 v6 alias: NoAlias

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="merge" parameters=[{type=boolean}, {type=Array}] results=[{type=anything}] {
  b0(v0: boolean, v1: Array):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = NewArray contents=anything
    Jump -> next b3(v2, v1)
  b2():
    v3 = Unspecified valueType=Array
    Jump -> next b3(v3, v3)
  b3(v4, v5):
    v6 = NewArray contents=anything
    v7 = Integer integer=1
    AppendElement v6, v7
    v9 = CallBuiltin v4 overload=ArrayPrototypeLength/0
    v10 = CallBuiltin v5 overload=ArrayPrototypeLength/0
    v11 = CallBuiltin v6 overload=ArrayPrototypeLength/0
    v12 = Add v9, v10
    v13 = Add v12, v11
    Return v13
}
