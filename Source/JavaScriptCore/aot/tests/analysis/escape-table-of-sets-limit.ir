# Past 64 objects a row with a bit for each object has more than one word. A set holds the words in which it has a member, and those count against the work limit:
# the set of one object takes one word however many objects the function makes. As whole rows the sets of f0 and of f2 took 142 words, and the analysis gave up
# FORM: Prepared
# OPTIONS: limit=MaxEscapeAnalysisWork:140
# RUN: analyses escape

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point"
function f0 name="setsOfObjectsAloneTakeOneWordEach" results=[{type=boolean}] {
# REPEAT: i = 0..70
    v%(i) = NewObject layout=L0 fields=[]
# END REPEAT
    v71 = TypeTest v0 testedType=object
    Return v71
}
# CHECK-LABEL: function f0
# CHECK-NEXT: escape:
# CHECK-NEXT: objects: 71
# CHECK: o0 state: DoesNotEscape
# CHECK: o70 state: DoesNotEscape
function f1 name="setsOfObjectsAloneFit" results=[{type=boolean}] {
# REPEAT: i = 0..69
    v%(i) = NewObject layout=L0 fields=[]
# END REPEAT
    v70 = TypeTest v0 testedType=object
    Return v70
}
# CHECK-LABEL: function f1
# CHECK-NEXT: escape:
# CHECK-NEXT: objects: 70
# CHECK: o0 state: DoesNotEscape
# CHECK: o69 state: DoesNotEscape
function f2 name="sixCopiesTakeOneWordEach" results=[{type=boolean}] {
# REPEAT: i = 0..64
    v%(i) = NewObject layout=L0 fields=[]
# END REPEAT
    Jump -> next b1(v0, v1, v2, v3, v4, v5)
  b1(v65, v66, v67, v68, v69, v70):
    v71 = TypeTest v0 testedType=object
    Return v71
}
# CHECK-LABEL: function f2
# CHECK-NEXT: escape:
# CHECK-NEXT: objects: 65
# CHECK: o0 state: DoesNotEscape
# CHECK: o0 aliases: [v0 v65]
# CHECK: o5 aliases: [v5 v70]
# CHECK: o64 state: DoesNotEscape
function f3 name="fiveCopiesFit" results=[{type=boolean}] {
# REPEAT: i = 0..64
    v%(i) = NewObject layout=L0 fields=[]
# END REPEAT
    Jump -> next b1(v0, v1, v2, v3, v4)
  b1(v65, v66, v67, v68, v69):
    v70 = TypeTest v0 testedType=object
    Return v70
}
# CHECK-LABEL: function f3
# CHECK-NEXT: escape:
# CHECK-NEXT: objects: 65
# CHECK: o0 state: DoesNotEscape
# CHECK: o0 aliases: [v0 v65]
# CHECK: o64 state: DoesNotEscape
