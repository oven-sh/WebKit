# CHECK: objects: 1
# CHECK: o0 definition: v2
# CHECK: o0 state: DoesNotEscape
# CHECK: o0 uses: [Inspects]
# CHECK: o0 aliases: [v2]
# CHECK: o0 object uses: [v3(0) v4(0)]
# CHECK: function f1
# CHECK: objects: 1
# CHECK: o0 definition: v2
