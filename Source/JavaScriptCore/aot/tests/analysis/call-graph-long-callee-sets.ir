# A callee set of 16 functions or more is kept once in the call graph. Callees, callers, recursion and ranks are those of a graph that lists each member at each caller
# FORM: Prepared
# RUN: pass BuildCallGraph

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="State" fields=[{key="a" declared={type=anything}}] flow={members=[L0]}

function f0 name="" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewObject layout=L0
    v2 = Call v0, -, v0, v1 callees=[f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20]
    Return v2
}
