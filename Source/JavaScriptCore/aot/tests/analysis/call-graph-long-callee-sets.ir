function f9 name="step9" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Boolean boolean=true
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Call v0, -, v0, v1 callees=[f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20]
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return v1
}
