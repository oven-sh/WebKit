# A test proves nothing when what it read may be written between the test and its branch
# FORM: Prepared
# RUN: guards points

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="writeBetweenTestAndBranch" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = IsNotFrozen v0
    PutSlotOrAdd v0, -, v1 key="y" receivers=[L0] level=Proven
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v4):
    Return v0
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v4 facts: [NotFrozen of v0 by v2 reads ShapeWords OrderWords]
# CHECK: b1 available at head: []
# CHECK: b1:0 available: []

function f1 name="writeBeforeTest" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
