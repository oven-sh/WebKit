    PutSlotOrAdd v0, -, v1 key="y" receivers=[L0] level=Proven
    v3 = IsNotFrozen v0
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    Return v0
  b2():
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v4 facts: [NotFrozen of v0 by v3 reads ShapeWords OrderWords]
# CHECK: b1 available at head: [v4.0]
# CHECK: b1:0 available: [v4]

