# function Dog() { this.name = .. }  Puppy.prototype = new Dog()          class Button { constructor() { this.press = this.press.bind(this) }  press() { .. } }
# A store that finds the slot empty goes to what the object inherits. A writable data property there does not stop it: the store creates the property of the object, as where it inherits nothing.
# Without the fact that the member stays a writable data property the store creates nothing, and a read of the name learns no more than before
# FORM: Prepared
# RUN: property-access

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="InheritsData" constructor=f0 fields=[{key="name" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="press" declared={type=anything} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="fragile" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="frozen" declared={type=anything} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype] keys=NeverEnumerated} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="name" isWritableData=true}, {key="press" function=f1 mutability=Fixed isWritableData=true}, {key="fragile"}, {key="frozen" function=f1 mutability=Fixed}]}
layout L1 kind=Instance name="Below" constructor=f2 fields=[{key="name" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="fragile" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype] keys=NeverEnumerated} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="name" isWritableData=true}, {key="fragile" isWritableData=true}] prototypeBase=L0}

