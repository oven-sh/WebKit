module m0 path="main.js" displayPath="main.js"
function f0 name="caller" parameters=[{type=boolean}, {type=anything}, {type=number}] results=[{type=anything}, {type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    v3 = CallDirect v1, v2 function=f1
