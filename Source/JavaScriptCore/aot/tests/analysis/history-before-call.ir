# An object has not escaped before the call that takes it, and may have escaped after that call and around a loop
# FORM: AsRead
# RUN: analyses escape-history history-points function=f0
# RUN(WRITES): analyses history-points function=f0 history-uses=WritesContents
# RUN(IGNORED): analyses history-points function=f0 ignored-blocks=b2
# RUN(FRESH): analyses history-points function=f1

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]
function f0 name="beforeCall" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = Call v0
    v5 = Call v0, -, v2
    v6 = Call v0
    Jump -> next b1(v1)
  b1(v7):
    LoopHint
    v9 = TypeTest v6 testedType=object
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = NewArray contents=anything
    v11 = NewArray contents=anything
    v12 = TypeTest v7 testedType=object
    AppendElement v10, v6
    AppendElement v11, v6
    v15 = Call v0, -, v3
    Jump -> next b1(v11)
  b3():
    Return v1
}
function f1 name="escapesEachIteration" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = TypeTest v0 testedType=object
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = NewObject -, v1 layout=L0 fields=[0]
    v6 = NewObject -, v1 layout=L0 fields=[0]
    v7 = TypeTest v2 testedType=object
    v8 = Call v0, -, v5, v6
    Jump -> next b1(v6)
  b3():
    Return v1
}
