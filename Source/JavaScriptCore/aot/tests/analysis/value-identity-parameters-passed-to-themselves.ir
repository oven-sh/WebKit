# Two parameters of a loop head that get one value on each way in, and themselves on the way round, hold one value: whether the way round passes them as they are or behind a cast.
# A pair that gets two values on one way in holds two
# FORM: Prepared
# RUN: analyses identities

module m0 path="main.js" displayPath="main.js"

function f0 name="passedAsTheyAre" parameters=[{type=object}, {type=object}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: object, v1: object, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0, v0)
  b2():
    Jump -> next b3(v1, v1)
  b3(v3: object, v4: object):
    LoopHint
    Branch v2 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b3(v3, v4)
  b5():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: identities:
# CHECK-NEXT: v4 identity: v3

