# ReserveArrayCapacity writes the storage of its array and of no other: a guard on the array that a loop copies from lasts across the reservation for the array it copies to. It ends for the array itself and for one that may be the same
# FORM: Prepared
# RUN: guards points

module m0 path="main.js" displayPath="main.js"
function f0 name="anotherArray" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=int[0, 100]}] results=[{type=undefined}] {
    v2 = NewArray contents=number
    v3 = HasArrayStorage v0 arrayStorage=Int32
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: guard):
    ReserveArrayCapacity v2, v1
    v6 = Integer integer=0
    v7 = GetArrayElement v0, v6, v4 arrayStorage=Int32 level=Expected [keyIsIntegral]
    AppendElement v2, v7
    Return
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b1:0 available: [{{*}}v4]
# CHECK-NEXT: b1:1 available: [{{*}}v4]

function f1 name="theArrayItself" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=int[0, 100]}] results=[{type=undefined}] {
    v2 = HasArrayStorage v0 arrayStorage=Int32
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    ReserveArrayCapacity v0, v1
    Return
  b2():
    Return
}
# CHECK-LABEL: function f1
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: []

function f2 name="perhapsTheSameArray" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=int[0, 100]}, {type=Array<number, proven, pristine[Storage, Names]>}] results=[{type=undefined}] {
    v3 = HasArrayStorage v0 arrayStorage=Int32
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: guard):
