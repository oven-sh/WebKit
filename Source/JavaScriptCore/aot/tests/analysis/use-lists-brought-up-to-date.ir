# Use lists that are held when the builder edits a long function read the blocks that have changed again for the next who asks, and keep the rest. A checking build compares them with the function
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN(ORDER): repair function=f0 redirect=b2.1:b1 use-lists
# RUN(SWAP): repair function=f0 redirect=b0.0:b2 redirect=b0.1:b1 use-lists
# RUN(ERASE): erase-values function=f0 block=b1 indexes=1 use-lists
# RUN(SPLIT): split-block function=f0 block=b3 indexes=1 use-lists
# RUN(EDGE): split-edge function=f0 edge=b2.0 use-lists
# RUN(JUMP): convert-branch function=f0 block=b2 target=0 use-lists
# RUN(INSERT): insert function=f0 points=b1:0,b3:1 use-lists
# RUN(REPLACE): substitute function=f0 replace=v5:v2 use-lists
# RUN(ADD): add-parameter function=f0 block=b3 type=number arguments=b1.0:v1,b2.0:v2 use-lists
# RUN(REMOVE): remove-parameters function=f0 block=b3 indexes=1 use-lists
# RUN(EXPAND): expand function=f0 value=v8 arms=1 use-lists
# RUN(UNCOVERED): remove-handler function=f1 block=b1 use-lists

module m0 path="main.js" displayPath="main.js"
function f0 name="lists" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
    v2 = Add v1, v1
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Mul v2, v1
    v4 = Negate v2
    Jump -> next b3(v3, v1)
  b2():
    v5 = Sub v2, v1
    Branch v0 -> taken b3(v5, v2), notTaken b4()
  b3(v6, v7):
    v8 = Add v6, v2
    v9 = Negate v8
    Return v8
  b4():
    v10 = Negate v2
    v11 = Negate v10
