# CHECK-NEXT: b1:1 available: [v3]
function f2 name="putAtAnyNumber" parameters=[{type=number}, {type=anything}] results=[{type=undefined}] {
  b0(v0: number, v1: anything):
    v2 = GetModuleVariable variable=g0
    PutArrayElement v2, v0, v1 level=Proven
    Return
}
