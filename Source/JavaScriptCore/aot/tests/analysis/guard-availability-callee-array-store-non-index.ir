function f4 name="inTheSameBody" parameters=[{type=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: L0, v1: number):
    v2 = HasBirthFieldsFilled v0
    Branch v2 -> taken b1(| 0), notTaken b2()
