# What receiverCandidates knows about the object of an access: only the type proves layouts, an expected type and a stamp say which ones to expect
# FORM: Prepared
# RUN: receiver-candidates

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
layout L1 name="Named" fields=[{key="x" declared={type=number}}]
layout L2 name="NeverMade" fields=[{key="x" declared={type=number}}] flow={allocation=NeverAllocated}

function f0 name="type-lists-layouts" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F0 v1: proof=Type level=Proven proven=[L0, L1]
# CHECK-NOT: predicted
# CHECK-NOT: otherParts
# CHECK-NOT: nullish
function f1 name="expected-type-is-a-strict-subset" parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1 ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F1 v1: proof=Type level=Proven proven=[L0, L1] predicted=[L0]
function f2 name="type-has-members-without-layout" parameters=[{type=L0|nolayout}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-NEXT: F2 v1: proof=Unknown level=Expected predicted=[L0] otherParts
# CHECK-NOT: nullish
function f3 name="expected-parameter" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F3 v1: proof=Unknown level=Expected predicted=[L0] otherParts nullish
function f4 name="object-with-expected-type" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-NEXT: F4 v1: proof=Unknown level=Expected predicted=[L0] otherParts
# CHECK-NOT: nullish
function f5 name="object-without-expected-type" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F5 v1: proof=Unknown level=Unknown otherParts
function f6 name="type-admits-no-object" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" receivers=[L0]
    Return v1
}
# CHECK-NEXT: F6 v1: proof=Unknown level=Unknown otherParts
function f7 name="layout-or-string" parameters=[{type=string|L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-NEXT: F7 v1: proof=Type level=Proven proven=[L0] otherParts
# CHECK-NOT: nullish
function f8 name="layout-or-null" parameters=[{type=null|L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F8 v1: proof=Type level=Proven proven=[L0] nullish
function f9 name="complete-stamp-on-proven-set" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" receivers=[L0]
    Return v1
}
# CHECK-NEXT: F9 v1: proof=Type level=Proven proven=[L0, L1] predicted=[L0]
function f10 name="incomplete-stamp-on-proven-set" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" receivers=[L0, ..]
    Return v1
}
# CHECK-NEXT: F10 v1: proof=Type level=Proven proven=[L0, L1]
# CHECK-NOT: predicted
function f11 name="complete-stamp-on-object" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" receivers=[L0]
    Return v1
}
# CHECK: F11 v1: proof=Unknown level=Expected predicted=[L0] otherParts
function f12 name="incomplete-stamp-on-object" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" receivers=[L0, ..]
    Return v1
}
# CHECK-NEXT: F12 v1: proof=Unknown level=Expected predicted=[L0] otherParts
function f13 name="expected-type-and-stamp-are-joined" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="x" receivers=[L1]
    Return v1
}
# CHECK-NEXT: F13 v1: proof=Unknown level=Expected predicted=[L0, L1] otherParts
function f14 name="member-never-allocated" parameters=[{type=L0|L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-NEXT: F14 v1: proof=Type level=Proven proven=[L0]
# CHECK-NOT: predicted
function f15 name="expected-member-never-allocated" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0|L2):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: F15 v1: proof=Unknown level=Expected predicted=[L0] otherParts
function f16 name="check-brought-the-layouts" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=L0
    v2 = PropGet v1 key="x"
    Return v2
}
# CHECK-NEXT: F16 v2: proof=Type level=Proven proven=[L0]
function f17 name="check-through-upcast" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=L0
    v2 = Upcast v1 castType=L0|L1
    v3 = PropGet v2 key="x"
    Return v3
}
# CHECK-NEXT: F17 v3: proof=Type level=Proven proven=[L0]
function f18 name="check-of-a-proven-set" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = Check v0 expectedType=L0
    v2 = PropGet v1 key="x"
    Return v2
}
# CHECK-NEXT: F18 v2: proof=Type level=Proven proven=[L0]
function f19 name="store-and-test-name-their-receiver" parameters=[{type=L0}, {type=L1}, {type=number}] results=[{type=anything}] {
    PropSet v0, v2 key="x"
    v4 = PropHas v1 key="x"
    Return v4
}
# CHECK-NEXT: F19 v3: proof=Type level=Proven proven=[L0]
# CHECK-NEXT: F19 v4: proof=Type level=Proven proven=[L1]
function f20 name="expected-type-never-allocated-leaves-the-stamp" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L2):
    v1 = PropGet v0 key="x" receivers=[L0]
    Return v1
}
# CHECK-NEXT: F20 v1: proof=Unknown level=Expected predicted=[L0] otherParts
function f21 name="expected-type-never-allocated" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L2):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-NEXT: F21 v1: proof=Unknown level=Unknown otherParts
