# `ring[i & 7] = x; ring[j & 7]`: a store near the start of a list may lengthen its storage or move it, and leaves the form of it: the guard of the test of the form holds behind the store. It ends where the position may lie so far out that the list becomes sparse, where the storage may have to be converted for the value, and where the position is any number. What was asked about the length ends at every one of these stores
# FORM: Prepared
# RUN: guards points uses

module m0 path="main.js" displayPath="main.js"

function f0 name="nearTheStart" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=int[0, 7]}, {type=anything}] results=[{type=anything}] {
    v3 = HasArrayStorage v0 arrayStorage=Contiguous [isWritable]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    PutArrayElement v0, v1, v2, v4 arrayStorage=Contiguous mode=Strict level=Expected [keyIsIntegral]
    v6 = GetArrayElement v0, v1, v4 arrayStorage=Contiguous level=Expected [keyIsIntegral]
    Return v6
  b2():
    Return
}
