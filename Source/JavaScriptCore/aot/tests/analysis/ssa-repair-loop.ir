# A definition that reaches a loop header around the back edge gives it a parameter unless the variable is dead there
# FORM: Prepared
# RUN: repair function=f0 variable=v3,v6
# RUN(DEAD): repair function=f1 variable=v3,v5
# RUN(ENTERED): repair function=f2 redirect=b4.0:b2 variable=v4,v8

module m0 path="main.js" displayPath="main.js"
function f0 name="liveAtHeader" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number, v2: number):
    v3 = Add v1, v2
    Jump -> next b1()
  b1():
    LoopHint
    v5 = Mul v3, v3
    v6 = Sub v5, v2
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    v7 = Negate v3
    Return v7
}
function f1 name="deadAtHeader" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number, v2: number):
    v3 = Add v1, v2
    Jump -> next b1()
  b1():
    LoopHint
    v5 = Sub v1, v2
    v6 = Mul v3, v3
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    v7 = Negate v3
    Return v7
}
function f2 name="secondEntry" parameters=[{type=boolean}, {type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: boolean, v2: number, v3: number):
    Branch v0 -> taken b1(), notTaken b4()
  b1():
    v4 = Add v2, v3
    Jump -> next b2()
  b2():
    LoopHint
    v6 = Mul v4, v4
    Branch v1 -> taken b2(), notTaken b3()
  b3():
    v7 = Negate v4
    Return v7
  b4():
    v8 = Sub v2, v3
    Branch v1 -> taken b5(), notTaken b5()
  b5():
    Return v8
}
