# CHECK: v3: number = Add v1, v2
# CHECK: Jump -> next b1(v3)
# CHECK: b1([[P]]: number):
# CHECK: v5: number = Mul [[P]], [[P]]
# CHECK: v6: number = Sub v5, v2
# CHECK: Branch v0 -> taken b1(v6), notTaken b2()
# CHECK: b2():
# CHECK: v7: number = Negate v6
# CHECK: Return v7
