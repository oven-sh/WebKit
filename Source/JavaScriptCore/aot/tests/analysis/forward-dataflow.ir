# The forward solver meets at merges and loop headers, and into a handler the state at the head of the covered block and around each value that may throw
# FORM: Prepared
# RUN: forward-dataflow
# RUN(THROW): forward-dataflow throw-transfer
# RUN(SOME): forward-dataflow some-path
# RUN(SOMETHROW): forward-dataflow some-path throw-transfer

module m0 path="main.js" displayPath="main.js"
function f0 name="straightLine" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v0
    Jump -> next b1()
  b1():
    v2 = Add v1, v1
    Jump -> next b2()
  b2():
    Return v2
}
# CHECK-LABEL: function f0
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v1]
# CHECK-NEXT: b2 head: [v1 v2]
function f1 name="diamond" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number):
    v2 = Add v1, v1
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Add v2, v2
    Jump -> next b3()
  b2():
    v4 = Add v2, v1
    Jump -> next b3()
  b3():
    Return v2
}
# CHECK-LABEL: function f1
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v2]
# CHECK-NEXT: b2 head: [v2]
# CHECK-NEXT: b3 head: [v2]
# SOME-LABEL: function f1
# SOME-NEXT: b0 head: []
# SOME-NEXT: b1 head: [v2]
# SOME-NEXT: b2 head: [v2]
# SOME-NEXT: b3 head: [v2 v3 v4]
function f2 name="loop" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number):
    v2 = Add v1, v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Add v2, v2
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    v5 = Add v4, v4
    Jump -> next b1()
  b3():
    Return v4
}
# CHECK-LABEL: function f2
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v2]
# CHECK-NEXT: b2 head: [v2 v3 v4]
# CHECK-NEXT: b3 head: [v2 v3 v4]
# SOME-LABEL: function f2
# SOME-NEXT: b0 head: []
# SOME-NEXT: b1 head: [v2 v3 v4 v5]
# SOME-NEXT: b2 head: [v2 v3 v4 v5]
# SOME-NEXT: b3 head: [v2 v3 v4 v5]
function f3 name="throwingValueInTheMiddle" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = Add v1, v1
    Jump -> next b1()
  b1() handler=b3():
    v3 = Add v2, v2
    v4 = Call v0
    v5 = Add v3, v3
    Jump -> next b2()
  b2():
    Return v5
  b3() role=CatchHandler:
    v6 = CatchValue
    Return v6
}
# CHECK-LABEL: function f3
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v2]
# CHECK-NEXT: b2 head: [v2 v3 v4 v5]
# CHECK-NEXT: b3 head: [v2]
# THROW-LABEL: function f3
# THROW-NEXT: b0 head: []
# THROW-NEXT: b1 head: [v2]
# THROW-NEXT: b2 head: [v2 v3 v4 v5]
# THROW-NEXT: b3 head: [v2]
# SOME-LABEL: function f3
# SOME-NEXT: b0 head: []
# SOME-NEXT: b1 head: [v2]
# SOME-NEXT: b2 head: [v2 v3 v4 v5]
# SOME-NEXT: b3 head: [v2 v3 v4]
# SOMETHROW-LABEL: function f3
# SOMETHROW-NEXT: b0 head: []
# SOMETHROW-NEXT: b1 head: [v2]
# SOMETHROW-NEXT: b2 head: [v2 v3 v4 v5]
# SOMETHROW-NEXT: b3 head: [v2 v3]
function f4 name="nothingThrows" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Add v0, v0
    Jump -> next b1()
  b1() handler=b3():
    v2 = Add v1, v1
    v3 = Add v2, v2
    Jump -> next b2()
  b2():
    Return v3
  b3() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
# CHECK-LABEL: function f4
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v1]
# CHECK-NEXT: b2 head: [v1 v2 v3]
# CHECK-NEXT: b3 head: [v1]
# THROW-LABEL: function f4
# THROW: b3 head: [v1]
# SOME-LABEL: function f4
# SOME-NEXT: b0 head: []
# SOME-NEXT: b1 head: [v1]
# SOME-NEXT: b2 head: [v1 v2 v3]
# SOME-NEXT: b3 head: [v1]
# SOMETHROW-LABEL: function f4
# SOMETHROW: b3 head: [v1]
function f5 name="throwingTerminator" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Add v0, v0
    Jump -> next b1()
  b1() handler=b2():
    v2 = Add v1, v1
    Throw v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f5
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v1]
# CHECK-NEXT: b2 head: [v1]
# SOME-LABEL: function f5
# SOME-NEXT: b0 head: []
# SOME-NEXT: b1 head: [v1]
# SOME-NEXT: b2 head: [v1 v2]
# SOMETHROW-LABEL: function f5
# SOMETHROW: b2 head: [v1 v2]
function f6 name="nestedHandlers" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = Add v1, v1
    Jump -> next b1()
  b1() handler=b5():
    v3 = Call v0
    Jump -> next b2()
  b2() handler=b3():
    v4 = Call v0
    Jump -> next b4()
  b3() role=CatchHandler handler=b5():
    v5 = CatchValue
    v6 = Call v0
    Jump -> next b4()
  b4():
    Return v2
  b5() role=CatchHandler:
    v7 = CatchValue
    Return v7
}
# CHECK-LABEL: function f6
# CHECK-NEXT: b0 head: []
# CHECK-NEXT: b1 head: [v2]
# CHECK-NEXT: b2 head: [v2 v3]
# CHECK-NEXT: b3 head: [v2 v3]
# CHECK-NEXT: b4 head: [v2 v3]
# CHECK-NEXT: b5 head: [v2]
