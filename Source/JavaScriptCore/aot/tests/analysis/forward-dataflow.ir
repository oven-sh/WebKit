# THROW-NEXT: b1 head: [v2]
# THROW-NEXT: b2 head: [v2 v3]
# THROW-NEXT: b3 head: [v2 v3]
# THROW-NEXT: b4 head: [v2 v3]
# THROW-NEXT: b5 head: [v2]
