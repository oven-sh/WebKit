# CHECK-NEXT: v2 use points: [b0:0]
# CHECK-NEXT: v3 location: b1 parameter 0
# CHECK-NEXT: v3 uses: [b1.terminator(0)]
# CHECK-NEXT: v3 use points: [b1:0]
# CHECK-NEXT: detached: []

