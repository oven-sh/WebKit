function f1 name="constantThatSelectsTheRareSide" parameters=[{type=boolean}] results=[{type=undefined}] {
    v1 = Boolean boolean=true
    v2 = Boolean boolean=false
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v2)
  b3(v3):
    Branch v3 -> taken b4(), notTaken b5()
  b4():
    Unreachable
  b5():
    Return
}
