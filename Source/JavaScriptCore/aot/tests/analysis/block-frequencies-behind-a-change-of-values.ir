# Frequencies that are held when values change are handed out again only where the estimate would read the same of the function
# FORM: Prepared
# RUN(SAME): substitute function=f0 replace=v3:v2 frequencies
# RUN(DECIDED): substitute function=f1 replace=v1:v2 frequencies
# RUN(NEGATED): substitute function=f2 replace=v5:v0 frequencies

module m0 path="main.js" displayPath="main.js"
function f0 name="valuesThatTheEstimateDoesNotRead" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
    v2 = Negate v1
    v3 = Negate v1
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Unreachable
  b2():
    Return v3
}
