function f2 name="conditionThatIsNoLongerNegated" parameters=[{type=boolean}, {type=boolean}] results=[{type=undefined}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Boolean boolean=true
    Jump -> next b3(v2)
  b2():
    v3 = Boolean boolean=false
    Jump -> next b3(v3)
  b3(v4):
    v5 = LogicalNot v4
    Branch v5 -> taken b4(), notTaken b5()
  b4():
    Unreachable
  b5():
    Return
}
