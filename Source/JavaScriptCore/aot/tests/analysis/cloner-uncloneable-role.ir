module m0 path="main.js" displayPath="main.js"
function f0 name="origin" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
    Return v1
}
function f1 name="outlined" role=OutlinedBody parameters=[{type=boolean}, {type=number}] results=[{type=number}] derivation={source=f0} {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    Return v1
}
function f2 name="caller" role=OutlinedBody parameters=[{type=boolean}, {type=number}] results=[{type=number}] derivation={source=f0} {
    v2 = CallDirect v0, v1 function=f1
    v3 = CallDirect v0, v2 function=f0
    Return v3
}
