# A body that calls a member of a long callee set some other way too, or two long sets with a member in common, lists the members. What comes to a function both ways is added up in another order
# FORM: Prepared
# RUN: heat-graph

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="State" fields=[{key="a" declared={type=anything}}] flow={members=[L0]}

function f0 name="" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewObject layout=L0
    v2 = Call v0, -, v0, v1 callees=[f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20]
    Return v2
}
