# RUN(UNFILLED): add-parameter function=f1 block=b2 type=number arguments=b0.1:v1
# RUN(CAUGHT): expand function=f1 value=v4

module m0 path="main.js" displayPath="main.js"
function f0 name="only" parameters=[{type=number}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    Return
}
function f1 name="covered" parameters=[{type=boolean}, {type=number}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2(v1)
  b1() handler=b3():
    v2 = Add v1, v1
    Jump -> next b2(v2)
  b2(v3):
    Return v3
  b3() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
