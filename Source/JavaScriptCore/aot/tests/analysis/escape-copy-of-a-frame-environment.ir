# The copy of an environment that lay in the frame is an object that the function has made: a store into it is no effect of the function
# FORM: Prepared
# RUN: effects summaries f0 f1
# RUN(BASES): analyses base-objects

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="count" declared={type=anything}}]
function f0 name="storesIntoEnvironmentOrCopy" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    v1 = NewObject layout=L0 fields=[] storage=FrameUntilMaterialized
    Branch v0 -> taken b1(), notTaken b2(v1)
  b1():
    v2 = MaterializeEnvironment v1 layout=L0
    Jump -> next b2(v2)
  b2(v3):
    v4 = Integer integer=1
    PutEnvironmentField v3, v4 layout=L0
    v6 = GetEnvironmentField v3 layout=L0
    Return v6
}
# CHECK: f0 return: reads(EnvironmentFields, AllocatorState) writes(AllocatorState) collects throw: none p0: [Inspects]
# BASES-LABEL: function f0
# BASES: v1 base objects: [OwnAllocation]
# BASES-NEXT: v2 base objects: [OwnAllocation OwnAllocation]
# BASES-NEXT: v3 base objects: [OwnAllocation OwnAllocation]
function f1 name="storesIntoEnvironmentOfCaller" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = Integer integer=1
    PutEnvironmentField v0, v1 layout=L0
    v3 = GetEnvironmentField v0 layout=L0
    Return v3
}
# CHECK-NEXT: f1 return: reads(EnvironmentFields/1) throw: none p0: [Inspects, RetainsContents] writes(EnvironmentFields/1)
# BASES-LABEL: function f1
# BASES: v0 base objects: [EntryParameter(0)]
