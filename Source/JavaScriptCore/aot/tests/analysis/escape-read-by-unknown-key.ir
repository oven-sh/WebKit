# A read under a key nobody knows on a record without accessors does not let the record escape, and it may answer whatever the record holds: the held object leaves with the result. A record that may get an accessor is handed to code of the program
# FORM: Prepared
# RUN: analyses escape

module m0 path="main.js" displayPath="main.js"
layout L0 name="Held"
layout L1 name="Holder" fields=[{key="inner" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={members=[L1] impossibleMutations=[RedefineProperty, AddProperty, ChangePrototype]}
layout L2 name="HolderThatMayGetAccessor" fields=[{key="inner" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={members=[L2] impossibleMutations=[AddProperty, ChangePrototype]}
function f0 name="handsOutWhatItHolds" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject -, v1 layout=L1 fields=[0] [keepsShape]
    v3 = ElemGet v2, v0
    Return v3
}
# CHECK: function f0
# CHECK: o0 definition: v1
# CHECK: o0 state: Escapes
# CHECK-NEXT: o0 reasons: [Returned]
# CHECK: o1 definition: v2
# CHECK: o1 state: DoesNotEscape
# CHECK-NEXT: o1 reasons: []
function f1 name="onlyTests" parameters=[{type=string}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject -, v1 layout=L1 fields=[0] [keepsShape]
    v3 = ElemHas v2, v0
    Return v3
}
# CHECK: function f1
# CHECK: o0 definition: v1
# CHECK: o0 state: DoesNotEscape
# CHECK: o1 definition: v2
# CHECK: o1 state: DoesNotEscape
function f2 name="mayRunAccessor" parameters=[{type=string}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject -, v1 layout=L2 fields=[0] [keepsShape]
    v3 = ElemHas v2, v0
    v4 = ElemGet v2, v0
    Return v3
}
# CHECK: function f2
# CHECK: o0 definition: v1
# CHECK: o0 state: Escapes
# CHECK: o1 definition: v2
# CHECK: o1 state: Escapes
# CHECK-NEXT: o1 reasons: [PassedToUnknownCode]
