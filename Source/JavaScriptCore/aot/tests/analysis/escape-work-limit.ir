# Past the work limit every object of the one function is unknown, and the functions beside it are analyzed
# FORM: Prepared
# OPTIONS: limit=MaxEscapeAnalysisWork:4
# RUN: analyses escape
# LOSS: MaxEscapeAnalysisWork x1 f0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point"
function f0 name="fiveObjects" results=[{type=boolean}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject layout=L0 fields=[]
    v3 = NewObject layout=L0 fields=[]
    v4 = NewObject layout=L0 fields=[]
    v5 = TypeTest v0 testedType=object
    Return v5
}
# CHECK-LABEL: function f0
# CHECK-NEXT: escape:
# CHECK-NEXT: gave up: true
# CHECK-NEXT: objects: 5
# CHECK-NEXT: o0 definition: v0
# CHECK-NEXT: o0 kind: Allocation
# CHECK-NEXT: o0 state: Unknown
# CHECK-NEXT: o0 reasons: [LimitReached]
# CHECK: o0 uses: all
# CHECK-NEXT: o0 live instances: Unknown
# CHECK: o1 definition: v1
# CHECK-NEXT: o1 kind: Allocation
# CHECK-NEXT: o1 state: Unknown
# CHECK-NEXT: o1 reasons: [LimitReached]
# CHECK: o2 definition: v2
# CHECK-NEXT: o2 kind: Allocation
# CHECK-NEXT: o2 state: Unknown
# CHECK-NEXT: o2 reasons: [LimitReached]
# CHECK: o3 definition: v3
# CHECK-NEXT: o3 kind: Allocation
# CHECK-NEXT: o3 state: Unknown
# CHECK-NEXT: o3 reasons: [LimitReached]
# CHECK: o4 definition: v4
# CHECK-NEXT: o4 kind: Allocation
# CHECK-NEXT: o4 state: Unknown
# CHECK-NEXT: o4 reasons: [LimitReached]
# CHECK: o4 uses: all
# CHECK-NEXT: o4 live instances: Unknown
function f1 name="fourObjects" results=[{type=boolean}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject layout=L0 fields=[]
    v3 = NewObject layout=L0 fields=[]
    v4 = TypeTest v0 testedType=object
    Return v4
}
# CHECK-LABEL: function f1
# CHECK-NEXT: escape:
# CHECK-NEXT: objects: 4
# CHECK-NEXT: o0 definition: v0
# CHECK-NEXT: o0 kind: Allocation
# CHECK-NEXT: o0 state: DoesNotEscape
