# The guard of a passed IsShapeEpochCurrent has the facts of its guard operand that the shape epoch renews
# FORM: Prepared
# RUN: guards

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="shapeIsRenewed" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = GetShapeEpoch
    v5 = Call v1
    v6 = IsShapeEpochCurrent v4, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = GetSlotOrUndefined v0, v7 key="x" receivers=[L0] level=Proven
    Return v8
  b3():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v3 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: v7 facts: [Shape of v0 by v2 reads ShapeWords[L0]]

function f1 name="filledSlotIsNotRenewed" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = IsSlotFilled v0 key="x" receivers=[L0] level=Proven
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = GetShapeEpoch
    v5 = Call v1
    v6 = IsShapeEpochCurrent v4, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Return v0
  b3():
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v3 facts: [SlotFilled of v0 by v2 reads ObjectFields["x"]]
# CHECK-NEXT: v7 facts: []

function f2 name="allocationKeepsItsShape" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = GetShapeEpoch
    v3 = Call v0, -, v1
    v4 = IsShapeEpochCurrent v2, v1
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    v6 = GetSlotOrUndefined v1, v5 key="x" receivers=[L0] level=Proven
    Return v6
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v1 facts: [Shape OwnInstance of v1 by allocation v1 reads ShapeWords[L0], SlotFilled of v1
# CHECK-NEXT: v5 facts: [Shape OwnInstance of v1 by allocation v1 reads ShapeWords[L0]]

function f3 name="unknownOperand" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Unspecified valueType=guard
    v2 = GetShapeEpoch
    v3 = IsShapeEpochCurrent v2, v1
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    Return v0
  b2():
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v1 facts: unknown
# CHECK-NEXT: v4 facts: unknown
