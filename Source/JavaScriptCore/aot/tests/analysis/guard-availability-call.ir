# A summarized call ends a guard only when it may write the tested object, and unknown code ends the guards of what it can reach and of nothing else
# FORM: Prepared
# RUN: guards points uses summaries
# RUN(PLAIN): guards points uses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="calleeWritesOwnAllocation" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = HasKeyOrder v0 layout=L0 fields=[0]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallDirect v1 function=f5
    Return v4
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v3 facts: [KeyOrder of v0 by v2 reads OrderWords]
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: [v3]
# PLAIN-LABEL: function f0
# PLAIN: b1:0 available: [v3]
# PLAIN-NEXT: b1:1 available: []

function f1 name="calleeWritesTestedObject" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = HasKeyOrder v0 layout=L0 fields=[0]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallDirect v0, v1 function=f6
    Return
  b2():
    Return
}
# CHECK-LABEL: function f1
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: []
# PLAIN-LABEL: function f1
# PLAIN: b1:0 available: [v3]
# PLAIN-NEXT: b1:1 available: []

function f2 name="calleeWritesPossibleAlias" parameters=[{type=L0}, {type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: L0, v2: anything):
    v3 = HasKeyOrder v0 layout=L0 fields=[0]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = CallDirect v1, v2 function=f6
    Return
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK: b1:0 available: [v4]
# CHECK-NEXT: b1:1 available: []

function f3 name="calleeWritesFreshArgument" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0] [keepsShape]
    v3 = GetSlot v2, v2 key="x" receivers=[L0] level=Proven
    v4 = HasKeyOrder v0 layout=L0 fields=[0]
    Branch v4 -> taken b1(| 0), notTaken b3()
  b1(v5):
    v6 = CallDirect v2, v1 function=f6
    Jump -> next b2()
  b2():
    Return v3
  b3():
    Return
}
# CHECK-LABEL: function f3
# CHECK: b1 available at head: [v2.0 v2.1 v2.2 v2.3 v5.0]
# CHECK-NEXT: b2 available at head: [v2.0 v2.1 v2.2 v5.0]
# CHECK: b1:0 available: [v2 v5]
# CHECK-NEXT: b1:1 available: [v5]
# PLAIN-LABEL: function f3
# PLAIN: b1 available at head: [v2.0 v2.1 v2.2 v2.3 v5.0]
# PLAIN-NEXT: b2 available at head: []
# PLAIN: b1:0 available: [v2 v5]
# PLAIN-NEXT: b1:1 available: []

function f4 name="unknownCode" parameters=[{type=object}, {type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: function, v2: anything):
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = GetSlot v3, v3 key="x" receivers=[L0] level=Proven
    v6 = GetSlot v4, v4 key="x" receivers=[L0] level=Proven
    PutModuleVariable v4 variable=g0
    v8 = ShapeTest v0 layouts=[L0]
    Branch v8 -> taken b1(| 0), notTaken b2()
  b1(v9):
    v10 = Call v1
    v11 = GetSlot v3, v3 key="x" receivers=[L0] level=Proven
    Return v11
  b2():
    Return
}
# CHECK-LABEL: function f4
# CHECK: b0:5 available: [v3 v4]
# CHECK-NEXT: b0:6 available: [v3 v4]
# CHECK-NEXT: b1:0 available: [v3 v4 v9]
# CHECK-NEXT: b1:1 available: [v3]
# CHECK-NEXT: b1:2 available: [v3]
# CHECK-NEXT: b2:0 available: [v3 v4]
# CHECK-NEXT: v5 guard v3: Available
# CHECK-NEXT: v6 guard v4: Available
# CHECK-NEXT: v11 guard v3: Available
# PLAIN-LABEL: function f4
# PLAIN: b1:0 available: [v3 v4 v9]
# PLAIN-NEXT: b1:1 available: [v3]
# PLAIN: v11 guard v3: Available

function f5 name="makesPoint" parameters=[{type=anything}] results=[{type=L0}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    PutSlotOrAdd v1, v1, v0 key="y" receivers=[L0] level=Proven
    Return v1
}
function f6 name="addsField" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: anything):
    PutSlotOrAdd v0, -, v1 key="y" receivers=[L0] level=Proven
    Return
}
