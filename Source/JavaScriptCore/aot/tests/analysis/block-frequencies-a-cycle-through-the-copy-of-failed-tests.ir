# A test in a loop fails into an unlikely copy, and the copy comes back in front of the loop. The way round through the copy is a cycle around the loop, and no loop of the program:
# it is gone round as often as the test fails. So the loop counts ten turns, a loop in a loop a hundred, and the copy next to nothing, however many tests there are.
# An edge that leaves a loop gets a share by its class: the failure of a test is no way out like the loop's own.
# FORM: Prepared
# RUN: frequencies

module m0 path="main.js" displayPath="main.js"
function f0 name="oneLoop" parameters=[{type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean):
    Jump -> next b1()
  b1():
    Jump -> next b2()
  b2():
    LoopHint
    Branch v0 -> taken b3(), notTaken b8()
  b3():
    Branch v0 -> taken b4(), notTaken b7()
  b4():
    Branch v0 -> taken b5(), notTaken b7()
  b5():
    Branch v0 -> taken b6(), notTaken b7()
  b6():
    Jump -> next b2()
  b7() frequency=Unlikely:
    Jump -> next b1()
  b8():
    Return
}
