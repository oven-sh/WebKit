  b3(v7, v8):
    v9 = GetArrayElement v7, v2, v8 arrayStorage=Contiguous [keyIsIntegral]
    Return v9
}
# CHECK-LABEL: function f1
# CHECK: v8 facts: [Pristine of v7 by allocation v3 reads PrototypeLinks NamedProperties, ArrayStorage of v7 by allocation v3 reads ArrayStorage]

function f2 name="objectsOnOneWayNumbersOnTheOther" parameters=[{type=object}, {type=boolean}, {type=i32}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewArray v0 contents=object
    v4 = AllGuards v3
