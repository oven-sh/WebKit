# Past the limit on blocks times objects every query about the function answers Unknown
# FORM: AsRead
# OPTIONS: limit=MaxUseEffectHistoryBits:1
# LOSS: MaxUseEffectHistoryBits x1 f0
# RUN: analyses escape-history history-points

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 name="Point"
function f0 name="pastTheLimit" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    Jump -> next b1()
  b1():
    Return v0
}
function f1 name="withinTheLimit" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    Return v0
}
