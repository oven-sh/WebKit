# A value in the middle of a covered block expands to a diamond whose arms and continuation keep the handler
# FORM: Prepared
# RUN: expand function=f0 value=v3
# RUN(ONE): expand function=f0 value=v3 arms=1
# RUN(NONE): expand function=f1 value=v2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]
function f0 name="underHandler" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b1(v1):
    v2 = Add v1, v1
    v3 = Call v0, -, v2 @12
    v4 = TypeTest v3 testedType=object
    Return v3
  b1(v5) role=CatchHandler:
    v6 = CatchValue
    Return v6
}
function f1 name="noHandler" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    PutEnvironmentField v0, v1 layout=L0 field=0
    Return v1
}
