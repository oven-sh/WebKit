# CHECK-NEXT: b0(v0: anything, v1: number) handler=b1(v1):
# CHECK-NEXT: v2: number = Add v1, v1
# CHECK-NEXT: [[T]]: true = Boolean boolean=true
# CHECK-NEXT: Branch [[T]] -> taken [[A]](), notTaken [[B]]()
# CHECK-NEXT: b1(v5: number) role=CatchHandler:
# CHECK-NEXT: v6: anything = CatchValue
# CHECK-NEXT: Return v6
# CHECK-NEXT: [[C]](v3: anything) handler=b1(v1):
# CHECK-NEXT: v4: boolean = TypeTest v3 testedType=object
# CHECK-NEXT: Return v3
# CHECK-NEXT: [[A]]() handler=b1(v1):
# CHECK-NEXT: [[CA]]: anything = Call v0, -, v2 @12
# CHECK-NEXT: Jump -> next [[C]]([[CA]])
# CHECK-NEXT: [[B]]() frequency=Unlikely handler=b1(v1):
# CHECK-NEXT: [[CB]]: anything = Call v0, -, v2 @12
# CHECK-NEXT: Jump -> next [[C]]([[CB]])
# CHECK-NEXT: }
