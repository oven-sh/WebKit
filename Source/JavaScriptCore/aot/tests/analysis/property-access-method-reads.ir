# A read of a method or of a deferred closure field needs no function object when its value is only called
# FORM: Prepared
# RUN: property-access

module m0 path="main.js" displayPath="main.js"
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance name="Scanner" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed prototypeNamesAreComplete=true namedMembers=[{key="m" function=f1 mutability=Fixed}, {key="capturing" function=f2 mutability=Fixed}, {key="recursive" function=f3 mutability=Fixed}]}
layout L1 name="Widget" fields=[{key="onObject" declared={type=f4} flow={location={stores=AtMostOnce deferral=CapturesObject deferredFunction=f4} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="onNothing" declared={type=f5} flow={location={stores=AtMostOnce deferral=CapturesNothing deferredFunction=f5} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="eager" declared={type=f5} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="OtherWidget" fields=[{key="onNothing" declared={type=f6} flow={location={stores=AtMostOnce deferral=CapturesNothing deferredFunction=f6} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="SameWidget" fields=[{key="onNothing" declared={type=f5} flow={location={stores=AtMostOnce deferral=CapturesNothing deferredFunction=f5} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="Scanner" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f1 name="m" kind=Method flags=[HasThis] results=[{type=anything}]
function f2 name="capturing" kind=Method flags=[HasThis] captures=[{type=number}] results=[{type=anything}]
function f3 name="recursive" kind=Method flags=[HasThis, TakesCallee] results=[{type=anything}]
function f4 name="onObject" kind=Arrow captures=[{type=L1}] results=[{type=anything}]
function f5 name="onNothing" kind=Arrow results=[{type=anything}]
function f6 name="onNothing" kind=Arrow results=[{type=anything}]

function f7 name="member-call" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
# CHECK: F7 v1 PropGet [[m]]: form=Method level=Proven receivers=[L0] member=(Method level=Proven holder=L0 method=F1)
function f8 name="called-twice" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0
    v3 = Call v1
    Return v3
}
# CHECK-NEXT: F8 v1 PropGet [[m]]: form=Method level=Proven receivers=[L0] member=(Method level=Proven holder=L0 method=F1)
function f9 name="called-through-upcast" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Upcast v1 castType=anything
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
# CHECK-NEXT: F9 v1 PropGet [[m]]: form=Method level=Proven receivers=[L0] member=(Method level=Proven holder=L0 method=F1)
function f10 name="called-with-argument-list" parameters=[{type=L0}, {type=Array<anything>}] results=[{type=anything}] {
  b0(v0: L0, v1: Array<anything>):
    v2 = PropGet v0 key="m"
    v3 = CallList v2, v0, v1 calleeKey="m"
    Return v3
}
# CHECK-NEXT: F10 v2 PropGet [[m]]: form=Method level=Proven receivers=[L0] member=(Method level=Proven holder=L0 method=F1)
function f11 name="called-and-stored" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    PutModuleVariable v1 variable=g0
    Return v2
}
# CHECK-NEXT: F11 v1 PropGet [[m]]: form=ByName level=Unknown receivers=[L0] member=(Method level=Proven holder=L0 method=F1)
function f12 name="called-and-stored-through-upcast" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Upcast v1 castType=anything
    v3 = Call v1, v0 calleeKey="m"
    PutModuleVariable v2 variable=g0
