function f2 name="catchReturns" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b4()
