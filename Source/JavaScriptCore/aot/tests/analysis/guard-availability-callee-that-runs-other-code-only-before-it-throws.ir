# A callee that converts its argument to a string and then always throws runs other code only on the way to the handler. Where it is handed a string, a guard on an array stands behind the call, as it stands behind a call of its caller. In a try the handler has lost the guard
# FORM: Prepared
# RUN: guards points summaries

module m0 path="main.js" displayPath="main.js"
function f0 name="callsTheCaller" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = HasArrayStorage v0 arrayStorage=Int32
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: guard):
    v3 = CallDirect function=f5
    Return v3
  b2():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b1:0 available: [v2]
# CHECK-NEXT: b1:1 available: [v2]

