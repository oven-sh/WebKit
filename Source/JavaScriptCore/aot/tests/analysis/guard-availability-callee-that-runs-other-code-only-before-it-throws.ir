function f4 name="catchesWhatTheCalleeThrows" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
    v2 = HasArrayStorage v0 arrayStorage=Int32
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard) handler=b3():
    v4 = CallDirect v1 function=f6
    Jump -> next b4()
  b2():
    Return
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v5
  b4():
    Return v4
}
