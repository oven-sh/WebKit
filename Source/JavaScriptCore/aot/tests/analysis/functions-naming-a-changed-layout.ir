    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
# REPEAT: i = 0..24
    v%(i+2) = NewClosure function=f%(i)
# END REPEAT
    v27 = Call v1, -, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26
