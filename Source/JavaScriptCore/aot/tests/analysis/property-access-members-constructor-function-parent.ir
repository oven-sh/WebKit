# function Made() {}  Object.setPrototypeOf(Made.prototype, Base.prototype)
# The base of a constructor function is the class from whose prototype object its own is expected to inherit: a lookup from an instance goes on there, and each such link is tested for.
# Its function object inherits from no class object, as that of a class with a heritage does. Once flow has looked at the function, only what flow says about the prototype object counts
# FORM: Prepared
# RUN(METHOD): member-lookup layout=L1 key="on"
# METHOD: Method level=Expected holder=L0 method=F1 conditions=[PrototypeLinkUnchanged(L1, Prototype)]
# RUN(ABSENT): member-lookup layout=L1 key="missing"
# ABSENT: Absent level=Expected conditions=[PrototypeLinkUnchanged(L1, Prototype)]
# RUN(CREATINGSTORE): member-lookup layout=L1 key="missing" access=Store
# CREATINGSTORE: Absent level=Expected conditions=[PrototypeLinkUnchanged(L1, Prototype)]
# RUN(SETTER): member-lookup layout=L1 key="size" access=Store
# SETTER: Accessor level=Expected holder=L0 getter=none setter=F2 conditions=[PrototypeLinkUnchanged(L1, Prototype)]
# RUN(STATIC): member-lookup start=ClassObject layout=L1 key="make"
# STATIC: Absent level=Proven
# RUN(CLASSMETHOD): member-lookup layout=L2 key="on"
# CLASSMETHOD: Method level=Expected holder=L0 method=F1 conditions=[PrototypeLinkUnchanged(L2, Prototype)]
# RUN(CLASSSTATIC): member-lookup start=ClassObject layout=L2 key="make"
# CLASSSTATIC: Method level=Expected holder=L0 method=F3 conditions=[PrototypeLinkUnchanged(L2, Static)]
# RUN(AFTERFLOW): member-lookup layout=L3 key="on"
# AFTERFLOW: Method level=Expected holder=L0 method=F1 conditions=[PrototypeLinkUnchanged(L3, Prototype)]
# RUN(AFTERFLOWSTATIC): member-lookup start=ClassObject layout=L3 key="make"
# AFTERFLOWSTATIC: Absent level=Proven
# RUN(NOCLASSAFTERFLOW): member-lookup layout=L4 key="on"
# NOCLASSAFTERFLOW: Absent level=Proven
# RUN(TWOLINKS): member-lookup layout=L5 key="on"
# TWOLINKS: Method level=Expected holder=L0 method=F1 conditions=[PrototypeLinkUnchanged(L1, Prototype), PrototypeLinkUnchanged(L5, Prototype)]
# RUN(BELOWCLASS): member-lookup layout=L6 key="on"
# BELOWCLASS: Method level=Expected holder=L0 method=F1 conditions=[PrototypeLinkUnchanged(L2, Prototype), PrototypeLinkUnchanged(L6, Prototype)]
# RUN(BELOWCLASSSTATIC): member-lookup start=ClassObject layout=L6 key="make"
# BELOWCLASSSTATIC: Absent level=Proven
# RUN(CIRCLE): member-lookup layout=L7 key="on"
# CIRCLE: Unknown level=Unknown cause=UnknownBase

