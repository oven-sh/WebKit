# A captured object escapes when its closure escapes, and when the closure is called while nothing says what its function does with what it captures. The call alone keeps the closure: only a function that takes its callee gets hold of it
# FORM: AsRead
# RUN: analyses escape
# RUN(FLOW): analyses escape flow function=f0

module m0 path="main.js" displayPath="main.js" body=f0
layout L0 name="Empty"
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f4
    v2 = CallDirect v1 function=f5
    Return
}
function f1 name="closureStaysLocal" results=[{type=undefined}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f4
    Return
}
function f2 name="closureReturned" results=[{type=function}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f4
    Return v1
}
function f3 name="closureCalled" results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure v0 function=f4
    v2 = Call v1
    Return v2
}
function f4 name="capturing" kind=Arrow captures=[{type=object}] results=[{type=undefined}] {
    v1 = TypeTest v0 testedType=object
    Return
}
function f5 name="callsArgument" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = Call v0
    Return
}
# CHECK: function f0
