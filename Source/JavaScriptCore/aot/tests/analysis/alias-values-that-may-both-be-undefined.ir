# RUN: analyses aliases function=f0 alias-values=v0,v1,v2,v3,v4

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
layout L0 name="A" fields=[{key="flags" declared={type=number} flags=[IsRequired]}]
layout L1 name="B" fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=string} flags=[IsRequired]}]
function f0 name="alias" parameters=[{type=undefined|null|L0}, {type=undefined|null|L1}, {type=undefined|null|L0}, {type=undefined|number}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|L0, v1: undefined|null|L1, v2: undefined|null|L0, v3: undefined|number, v4: anything):
    Return v4
}
