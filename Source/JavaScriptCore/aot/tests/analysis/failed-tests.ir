# A test has failed where the edge it failed on dominates: for the same condition on the same value, and nowhere else
# FORM: Prepared
# RUN: failed-tests

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
layout L1 name="Size" fields=[{key="width" declared={type=number}}]
layout L2 name="Name" fields=[{key="text" declared={type=string}}]
function f0 name="slowBlockAndMerge" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=string
    Jump -> next b4()
  b2():
    v4 = TypeTest v0 testedType=string
    v5 = TypeTest v0 testedType=number
    v6 = TypeTest v1 testedType=string
    Jump -> next b3()
  b3():
    Jump -> next b4()
  b4():
    v7 = TypeTest v0 testedType=string
    Return v7
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v2 at b2: Failed
# CHECK-NEXT: v3 at b2: Failed
# CHECK-NEXT: v4 at b2: Failed
# CHECK-NEXT: v7 at b2: Failed
# CHECK-NEXT: v2 at b3: Failed
# CHECK-NEXT: v3 at b3: Failed
# CHECK-NEXT: v4 at b3: Failed
# CHECK-NEXT: v7 at b3: Failed
# CHECK-NOT: Failed
function f1 name="narrowedCopyOfTheSubject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(), notTaken b2(| 0)
  b1():
    Return v0
  b2(v2):
    v3 = TypeTest v2 testedType=string
    v4 = Upcast v2 castType=anything
    v5 = TypeTest v4 testedType=string
    Return v3
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v1 at b2: Failed
# CHECK-NEXT: v3 at b2: Failed
# CHECK-NEXT: v5 at b2: Failed
# CHECK-NOT: Failed
function f2 name="slowBlockHasAnotherWayIn" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b3()
  b1():
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3():
    v3 = TypeTest v0 testedType=string
    Return v3
}
# CHECK-LABEL: function f2
# CHECK-NOT: Failed
function f3 name="testForStretch" parameters=[{type=object}] results=[{type=undefined}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return
  b2():
    v3 = ShapeTest v0 layouts=[L0]
    v4 = ShapeTest v0 layouts=[L1]
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v1 at b2: Failed
# CHECK-NEXT: v3 at b2: Failed
# CHECK-NOT: Failed
function f4 name="otherwiseOfSwitchOnShape" parameters=[{type=object}, {type=object}] results=[{type=undefined}] {
  b0(v0: object, v1: object):
    SwitchOnShape v0 layoutSets=[[L0], [L1]] -> case b1(| 0), case b2(| 0), otherwise b3()
  b1(v2):
    v3 = ShapeTest v0 layouts=[L1]
    Return
  b2(v4):
    Return
  b3():
    v5 = ShapeTest v0 layouts=[L0]
    v6 = ShapeTest v0 layouts=[L0, L1]
    v7 = ShapeTest v0 layouts=[L2]
    v8 = ShapeTest v0 layouts=[L0, L2]
    v9 = ShapeTest v1 layouts=[L0]
    Return
}
# CHECK-LABEL: function f4
# CHECK-NEXT: v3 at b3: Failed
# CHECK-NEXT: v5 at b3: Failed
# CHECK-NEXT: v6 at b3: Failed
