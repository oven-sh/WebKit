# A block that is recorded as rare is rare whatever leads to it, which isRecordedAsRare() relies on. Nothing that is recorded makes the entry block rare
# FORM: Prepared
# RUN: frequencies

module m0 path="main.js" displayPath="main.js"
function f0 name="enteredByJumpFromNormalBlock" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    Jump -> next b2()
  b2() frequency=Rare:
    Return
  b3():
    Return
}
# CHECK-LABEL: function f0
# CHECK: b2 frequency: Rare
function f1 name="onlyWayThroughTheFunction" parameters=[{type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1() frequency=Rare:
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: b0 frequency: Normal
# CHECK-NEXT: b1 frequency: Rare
function f2 name="headerOfLoop" parameters=[{type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1() frequency=Rare:
    LoopHint
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: b0 frequency: Normal
# CHECK-NEXT: b1 frequency: Rare
function f3 name="entryBlock" parameters=[{type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean) frequency=Rare:
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: b0 frequency: Normal
