# An allocation proves its own shape, one fact per set of locations it depends on
# FORM: Prepared
# RUN: guards

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="objectNamedAsGuard" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = GetSlot v1, v1 key="x" receivers=[L0] level=Proven
    Return v2
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v1 facts: [Shape OwnInstance of v1 by allocation v1 reads -, SlotFilled NotFrozen of v1 by allocation v1 reads ShapeWords[L0], NoExtraProperties NoFieldOutsideSlot of v1 by allocation v1 reads NamedProperties, KeyOrder of v1 by allocation v1 reads ShapeWords[L0] OrderWords]
# CHECK-NEXT: b0 available at head: []

function f1 name="arrayNamedAsGuard" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray v0 contents=anything
    v2 = GetArrayLength v1, v1
    Return v2
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v1 facts: [Pristine of v1 by allocation v1 reads PrototypeLinks NamedProperties, ArrayStorage of v1 by allocation v1 reads ArrayStorage]
# CHECK-NEXT: b0 available at head: []

function f2 name="objectNobodyNames" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = GetSlot v2, v2 key="x" receivers=[L0] level=Proven
    v4 = PropGet v1 key="x"
    Return v3
}
# CHECK-LABEL: function f2
# CHECK-NOT: v1 facts:
# CHECK: v2 facts: [Shape OwnInstance of v2 by allocation v2
# CHECK-NOT: v1 facts:

function f3 name="arrayNobodyNames" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray v0 contents=anything
    Return v1
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v1 facts: [Pristine of v1 by allocation v1 reads PrototypeLinks NamedProperties, ArrayStorage of v1 by allocation v1 reads ArrayStorage]
