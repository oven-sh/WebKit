# Covering blocks sets the handler of each listed block that has none and cuts no block
# FORM: Prepared
# RUN: cover function=f0 handler=b6 blocks=b1,b2,b3,b4,b5
# RUN(ONE): cover function=f0 handler=b6 blocks=b3

module m0 path="main.js" displayPath="main.js"
function f0 name="cover" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b6():
    v2 = Call v0
    Jump -> next b1()
  b1():
    v3 = Add v1, v1
    v4 = Call v0, -, v3
    v5 = TypeTest v4 testedType=object
    v6 = Call v0, -, v4
    Branch v5 -> taken b2(), notTaken b3()
  b2() handler=b5():
    v7 = Call v0
    Jump -> next b4()
  b3():
    Throw v6
  b4():
    Return v7
  b5() role=CatchHandler:
    v8 = CatchValue
    Return v8
  b6() role=CatchHandler:
    v9 = CatchValue
    Return v9
}
# CHECK: function f0
# CHECK-NEXT: b0(v0: anything, v1: number) handler=b6():
# CHECK-NEXT: v2: anything = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b6():
# CHECK-NEXT: v3: number = Add v1, v1
# CHECK-NEXT: v4: anything = Call v0, -, v3
# CHECK-NEXT: v5: boolean = TypeTest v4 testedType=object
# CHECK-NEXT: v6: anything = Call v0, -, v4
# CHECK-NEXT: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2() handler=b5():
# CHECK-NEXT: v7: anything = Call v0
# CHECK-NEXT: Jump -> next b4()
# CHECK-NEXT: b3() handler=b6():
# CHECK-NEXT: Throw v6
# CHECK-NEXT: b4() handler=b6():
# CHECK-NEXT: Return v7
# CHECK-NEXT: b5() role=CatchHandler handler=b6():
# CHECK-NEXT: v8: anything = CatchValue
# CHECK-NEXT: Return v8
# CHECK-NEXT: b6() role=CatchHandler:
# CHECK-NEXT: v9: anything = CatchValue
# CHECK-NEXT: Return v9
# CHECK-NEXT: }
