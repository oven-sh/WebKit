function f5 name="caughtValuesStayTogether" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Return v1
  b1() role=CatchHandler:
    v2 = CatchException
    Jump -> next b2()
  b2() handler=b3():
    v3 = Call v0
    Rethrow v2
  b3() role=CatchHandler handler=b4():
    v4 = CatchException
    v5 = CatchValue
    v6 = Call v0, -, v5
    Rethrow v2
  b4() role=CatchHandler:
    v7 = CatchValue
    Rethrow v2
}
