function f0 name="definedTwiceInOneBlock" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
  b0(v0: anything, v1: number):
    v2 = Add v1, v1
    Jump -> next b1()
  b1() handler=b3():
    v3 = Call v0
    v4 = Mul v1, v1
    v5 = Call v0
    v6 = Sub v1, v1
    v7 = Call v0
    Jump -> next b2()
  b2():
    v8 = Negate v2
    Return v8
  b3() role=CatchHandler:
    v9 = CatchValue
    v10 = Negate v2
    Return v10
}
