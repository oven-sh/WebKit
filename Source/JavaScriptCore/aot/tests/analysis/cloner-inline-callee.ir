# A callee with a loop, a handler and a tail call cloned into a caller: its blocks without a handler get the handler of the call
# FORM: Prepared
# RUN: inline function=f0 value=v2
# RUN(COVERED): inline function=f2 value=v2

module m0 path="main.js" displayPath="main.js"
function f0 name="caller" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
    v2 = CallDirect v0, v1 function=f1
    v3 = TypeTest v2 testedType=object
    Return v2
}
function f1 name="callee" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
    Jump -> next b1(v1)
  b1(v2) handler=b4():
    v3 = Call v0, -, v2
    Jump -> next b2()
  b2():
    LoopHint
    v5 = TypeTest v3 testedType=object
    v6 = Add v2, v1
    Branch v5 -> taken b3(), notTaken b1(v6)
  b3():
    v7 = CallDirect v6 function=f3
    ReturnCall v7 casts=[{declared={type=anything} resolution=Upcast}]
  b4() role=CatchHandler:
    v8 = CatchValue
    Return v8
}
function f2 name="coveredCaller" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b1():
    v2 = CallDirect v0, v1 function=f1
    Return v2
  b1() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
function f3 name="tailCallee" parameters=[{type=number}] results=[{type=number}] {
    Return v0
}
