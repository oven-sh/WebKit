# CHECK-NEXT: v0 uses: [v4(0)]
# CHECK-NEXT: v0 use points: [b1:0]
# CHECK-NEXT: v1 location: b0 parameter 1
# CHECK-NEXT: v1 uses: [v2(0) v2(1) b0.terminator(0) b0.0(0) b1.handler(0) v4(2) v7(1) v9(1)]
