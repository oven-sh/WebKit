# Operand, terminator, edge argument and handler argument uses with their order and use points
# FORM: Prepared
# RUN: analyses control-flow use-lists

module m0 path="main.js" displayPath="main.js"
function f0 name="uses" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = Add v1, v1
    Switch v1 cases=[0] -> case b1(v1), otherwise b3(v2)
  b1(v3) handler=b2(v1):
    v4 = Call v0, -, v1
    Jump -> next b3(v3)
  b2(v5) role=CatchHandler:
    v6 = CatchValue
    v7 = Add v5, v1
    Return v7
  b3(v8):
    v9 = Add v8, v1
    Return v9
}
# CHECK: function f0
# CHECK-NEXT: control-flow:
# CHECK-NEXT: reverse postorder: [b0 b1 b2 b3]
# CHECK: use-lists:
