# answers = { get body() {}, set body(value) {}, get status() {} }; globalThis[name] = handle; globalThis[name](Object.create(answers))        handle(answer) { answer.body = 1; return answer.status }
# Nobody knows what `answer` is. The store under `body` may run the setter that the literal holds under that name, and the read under `status` the getter under that one: both count as entered.
# The getter under `body` does not: nothing reads that name. No weight comes from the site, which says nothing about how often the receiver is that object: the host enters them as it enters what has escaped.
# FORM: AsRead
# RUN: heat-graph flow classes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Answers"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = NewClosure function=f2
    DefineGetter v0, v1 key="body"
    v3 = NewClosure function=f3
    DefineSetter v0, v3 key="body"
    v5 = NewClosure function=f4
    DefineGetter v0, v5 key="status"
    v7 = FinishObject v0
    v8 = Builtin builtin=GlobalThis
    v9 = Builtin builtin=Process
    v10 = PropGet v9 key="title"
    v11 = NewClosure function=f1
    ElemSet v8, v10, v11 mode=Sloppy
    v13 = Builtin builtin=Object
    v14 = Builtin builtin=ObjectCreate
    v15 = Call v14, v13, v7
    v16 = ElemGet v8, v10
    v17 = Call v16, -, v15
    Return v17
}
function f1 name="handle" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="body"
    v3 = PropGet v0 key="status"
    Return v3
}
function f2 name="body" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="held"
    Return v1
}
function f3 name="body" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="held"
    Return
}
function f4 name="status" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="code"
    Return v1
}
