# A passed test of the shape epoch renews what held where the epoch was read, and only what the epoch counts changes of
# FORM: Prepared
# RUN: guards points uses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}]

function f0 name="shapeIsRenewed" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = GetShapeEpoch
    v5 = Call v1
    v6 = IsShapeEpochCurrent v4, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = GetSlotOrUndefined v0, v7 key="x" receivers=[L0] level=Proven
    Return v8
  b3():
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v3 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: v7 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: b0 available at head: []
# CHECK-NEXT: b1 available at head: [v3.0]
# CHECK-NEXT: b2 available at head: [v7.0]
# CHECK-NEXT: b3 available at head: []
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: [v3]
# CHECK-NEXT: b1:2 available: []
# CHECK-NEXT: b1:3 available: []
# CHECK-NEXT: b2:0 available: [v7]
# CHECK-NEXT: b2:1 available: [v7]
# CHECK-NEXT: b3:0 available: []
# CHECK: v8 guard v7: Available

function f1 name="endedBeforeTheEpochWasRead" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = Call v1
    v5 = GetShapeEpoch
    v6 = IsShapeEpochCurrent v5, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Return v0
  b3():
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v3 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: v7 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: b0 available at head: []
# CHECK-NEXT: b1 available at head: [v3.0]
# CHECK-NEXT: b2 available at head: []
# CHECK-NEXT: b3 available at head: []
# CHECK: b1:0 available: [v3]
# CHECK-NEXT: b1:1 available: []
# CHECK-NEXT: b1:2 available: []
# CHECK-NEXT: b1:3 available: []
# CHECK-NEXT: b2:0 available: []
# CHECK-NEXT: b3:0 available: []

function f2 name="unknownCodeAfterTheEpochTest" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = GetShapeEpoch
    v5 = Call v1
    v6 = IsShapeEpochCurrent v4, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = Call v1
    Return v8
  b3():
    Return
}
# CHECK-LABEL: function f2
# CHECK: b2 available at head: [v7.0]
# CHECK: b2:0 available: [v7]
# CHECK-NEXT: b2:1 available: []

function f3 name="keyOrderIsNotRenewed" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3):
    v4 = HasKeyOrder v0, v3 layout=L0 fields=[0]
    Branch v4 -> taken b2(| 0), notTaken b4()
  b2(v5):
    v6 = AllGuards v3, v5
    v7 = GetShapeEpoch
    v8 = Call v1
    v9 = IsShapeEpochCurrent v7, v6
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10):
    v11 = GetSlotOrUndefined v0, v10 key="x" receivers=[L0] level=Proven
    Return v11
  b4():
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v3 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK-NEXT: v5 facts: [KeyOrder of v0 by v4 reads OrderWords]
# CHECK-NEXT: v6 facts: [Shape of v0 by v2 reads ShapeWords[L0], KeyOrder of v0 by v4 reads OrderWords]
# CHECK-NEXT: v10 facts: [Shape of v0 by v2 reads ShapeWords[L0]]
# CHECK: b2 available at head: [v3.0 v5.0]
# CHECK-NEXT: b3 available at head: [v10.0]
# CHECK: b2:0 available: [v3 v5]
# CHECK-NEXT: b2:1 available: [v3 v5 v6]
# CHECK-NEXT: b2:2 available: [v3 v5 v6]
# CHECK-NEXT: b2:3 available: []
# CHECK-NEXT: b2:4 available: []
# CHECK-NEXT: b3:0 available: [v10]
# CHECK: v11 guard v10: Available

function f4 name="keyOrderAlone" parameters=[{type=L0}, {type=function}] results=[{type=anything}] {
  b0(v0: L0, v1: function):
    v2 = HasKeyOrder v0 layout=L0 fields=[0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = GetShapeEpoch
    v5 = Call v1
    v6 = IsShapeEpochCurrent v4, v3
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Return v0
  b3():
    Return
}
# CHECK-LABEL: function f4
# CHECK-NEXT: v3 facts: [KeyOrder of v0 by v2 reads OrderWords]
# CHECK-NEXT: v7 facts: []
# CHECK: b1 available at head: [v3.0]
# CHECK-NEXT: b2 available at head: []
# CHECK: b1:1 available: [v3]
# CHECK-NEXT: b1:2 available: []
# CHECK-NEXT: b1:3 available: []
# CHECK-NEXT: b2:0 available: []

function f5 name="shapeOfEscapedAllocationIsRenewed" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = GetShapeEpoch
    v4 = Call v0, -, v2
    v5 = IsShapeEpochCurrent v3, v2
    Branch v5 -> taken b1(| 0), notTaken b2()
  b1(v6):
    v7 = GetSlotOrUndefined v2, v6 key="x" receivers=[L0] level=Proven
    Return v7
  b2():
    Return
}
# CHECK-LABEL: function f5
# CHECK: v6 facts: [Shape OwnInstance of v2 by allocation v2 reads ShapeWords[L0]]
# CHECK-NEXT: b0 available at head: []
# CHECK-NEXT: b1 available at head: [v6.0]
# CHECK-NEXT: b2 available at head: []
# CHECK: b0:1 available: [v2]
# CHECK-NEXT: b0:2 available: [v2]
# CHECK-NEXT: b0:3 available: []
# CHECK-NEXT: b0:4 available: []
# CHECK-NEXT: b1:0 available: [v6]
# CHECK: v7 guard v6: Available
