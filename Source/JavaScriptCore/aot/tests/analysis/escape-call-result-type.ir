# An argument flows into the result of a call only if the result can hold a reference
# FORM: Prepared
# RUN: analyses escape

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point"
function f0 name="numberResult" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = NewObject layout=L0 fields=[]
    v2 = CallDirect v1, v0 function=f3
    Return v2
}
function f1 name="anyResult" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject layout=L0 fields=[]
