function f2 name="runsOnceCallee" results=[{type=undefined}] {
  b0():
    Return
}
# CHECK-LABEL: function f2
# FLOW-LABEL: function f2
function f3 name="runsTwice" parameters=[{type=boolean}] results=[{type=undefined}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = CallDirect function=f4
    Jump -> next b2()
  b2():
    Return
}
