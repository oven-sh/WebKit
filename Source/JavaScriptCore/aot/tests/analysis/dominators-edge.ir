function f0 name="edgeDominance" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b3(| 0)
