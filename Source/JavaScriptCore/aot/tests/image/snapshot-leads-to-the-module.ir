# In a heap snapshot the cell that stands for a module hangs below the module loader of the realm, and every closure of a function that the module defines leads to it: also that of a function that reads no variable, and that of a class without a constructor of its own.
# -- source: snapshot-leads-to-the-module.js
# let keptInModule = fresh();
# const reads = () => keptInModule;
# const touchesNothing = n => n + 1;
# class Empty {}
# hold(reads, touchesNothing, Empty);
# print(whoLeadsToTheModule());
# -- end of source
