# take(require.me);
# The control of require-read-under-a-name-that-the-table-lacks-has-gone-out-of-sight.ir: the program lays the name on no built-in, so nothing lies under it, and `require` has gone nowhere: `module.constructor`.
# OPTIONS: exclude=CodeOutsideImage
# RUN: image
# CHECK: flags
# CHECK-NOT: LoadsModulesByName

module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Integer integer=0
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = ModuleBuiltin builtin=ModuleRequire module=m0
    v4 = PropGet v3 key="me"
    v5 = PropGet v2 key="take" [isFreeName]
    v6 = Call v5, -, v4
    Return
}
