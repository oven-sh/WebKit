# if (never()) JSON.stringify = 0; say(); say(); replace(); say(); restore(); say()   with   say = () => { asked("a"); }   function asked(value: any) { const text = JSON.stringify(value); print(text); return text; }
# The program stores to JSON.stringify where the build sees it, so the member is open and no constant of the build: the call goes by name. It cost 35 instructions more than the call of a locked member:
# the answer of the site, the call of a value, the look at the cell, the look for the door of the host function. An application made that call 100,000 times a session.
# The call names the function that the built-in object gives under that key as it is written. That is a hint alone. The head holds `this` against a word of the instance: the object, while its member is as built.
# The run time fills the word at the first call, where the holder tells of writes and nobody has written the member. Whoever writes it is announced first, and the word goes for good:
# replace() lays another function: the site finds it; put back, the word stays empty and the lookup answers.
# RUN: run-in-shell mechanisms=all const holder = JSON, real = holder.stringify; globalThis.never = () => false; globalThis.replace = () => { holder.stringify = value => "laid " + value; }; globalThis.restore = () => { holder.stringify = real; };
# CHECK: "a"
# CHECK-NEXT: "a"
# CHECK-NEXT: laid a
# CHECK-NEXT: "a"
# CHECK-NEXT: exited with 0
# RUN(DELETED): run-in-shell mechanisms=all const holder = JSON, real = holder.stringify; globalThis.never = () => false; globalThis.replace = () => { delete holder.stringify; Object.defineProperty(holder, "stringify", { get() { return value => "got " + value; }, configurable: true }); }; globalThis.restore = () => { Object.defineProperty(holder, "stringify", { value: real, configurable: true, writable: true }); };
# DELETED: "a"
# DELETED-NEXT: "a"
# DELETED-NEXT: got a
# DELETED-NEXT: "a"
