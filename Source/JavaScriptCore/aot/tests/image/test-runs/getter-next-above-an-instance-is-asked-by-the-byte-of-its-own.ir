# hidden(Map.prototype); say(); lay(); say(); replace(); say(); restore(); say()   with   say = () => { print(sizes(map, 2)); }
# function sizes(things: Map<number, number>, turns: number) { let sum = 0; for (let at = 0; at < turns; at++) sum += things.size; return sum; }
# The prototype of Maps is handed to code that nobody has seen, so `size` is open in this test run. It is a getter that no cell of the image names. It is found NEXT ABOVE the instance, so it is asked as a method there is:
# the cell alone and ONE BYTE OF THAT MEMBER, not the byte of the class, which any write on any prototype above sets for the rest of the process.
# lay() lays a name that has nothing to do with it; replace() lays another getter, and the closed arm finds it; put back, the byte stays set and the built-in answers through the closed arm.
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell mechanisms=all const aboveMaps = Map.prototype, kept = Object.getOwnPropertyDescriptor(aboveMaps, "size"); globalThis.hidden = () => {}; globalThis.map = new Map([[1, 4], [2, 5]]); globalThis.lay = () => { aboveMaps.laid = 1; }; globalThis.replace = () => { Object.defineProperty(aboveMaps, "size", { get() { return 70; }, configurable: true }); }; globalThis.restore = () => { Object.defineProperty(aboveMaps, "size", kept); };
# CHECK: 4
# CHECK-NEXT: 4
# CHECK-NEXT: 140
