# hidden(Object.prototype); say(); lay(); say(); shadow(); say(); uncover(); say(); replace(); say()   with   say = () => { print(owns(list, 2)); }
# function owns(things: number[], turns: number) { let sum = 0; for (let at = 0; at < turns; at++) sum += things.hasOwnProperty("length"); return sum; }
# The prototype of all objects is handed to code that nobody has seen, so `hasOwnProperty` is open in this test run, and a test file of the run is seen to lay that name above lists: the record in front of the module.
# The member lies TWO steps above a list. It is as built while nobody has written it AND nobody has added a name to the holder below it. So the typed form asks the cell alone, ONE BYTE OF THE MEMBER AND ONE OF THAT HOLDER,
# not the byte of the class, which any write on any prototype above sets for the rest of the process.
# lay() lays a name above all objects, further up than the member: it can stand in front of nothing that is found below it. shadow() lays the name above lists, and the closed arm finds it; taken away, the byte stays set and the
# built-in answers through the closed arm; replace() writes the member itself.
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell mechanisms=all const aboveAll = Object.prototype, aboveLists = Array.prototype; globalThis.hidden = () => {}; globalThis.list = [1, 2]; globalThis.lay = () => { Object.defineProperty(aboveAll, "laid", { value: 1, configurable: true }); }; globalThis.shadow = () => { aboveLists.hasOwnProperty = () => 20; }; globalThis.uncover = () => { delete aboveLists.hasOwnProperty; }; globalThis.replace = () => { aboveAll.hasOwnProperty = () => 70; };
# CHECK: 2
# CHECK-NEXT: 2
# CHECK-NEXT: 40
# CHECK-NEXT: 2
# CHECK-NEXT: 140
# CHECK-NEXT: exited with 0
# RUN(LOCKS): locks open
# LOCKS: open ObjectPrototypeHasOwnProperty holder-let-go-by-program
# RUN(FORM): walk f1 mechanisms=all
# FORM-LABEL: code f1:Body
