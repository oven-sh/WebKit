# a.test.ts names Array.prototype.values, so a test of this run may replace it: print(total(list)); replace(); print(total(list)); print(total(odd))
# with   function total(things: number[]) { let sum = 0; for (const thing of things) sum += thing; return sum; }
# The method under Symbol.iterator above lists is ANOTHER PLACE that holds the same function as `values`. The table locks that place in every build: no test can write it. It was taken for open together with `values`,
# and then no list of the whole build was walked by index: one test file that names Array.prototype was enough.
# The shell's code really replaces `values`: the loop goes on by index. (By the protocol it would call a built-in written in JavaScript, which this shell does not have: the run would stop.)
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell mechanisms=all const above = Array.prototype; const once = value => function () { let given = false; return { next() { const done = given; given = true; return { done, value: done ? undefined : value }; }, [Symbol.iterator]() { return this; } }; }; globalThis.list = [1, 2, 3]; globalThis.odd = [1, 2, 3]; globalThis.odd[Symbol.iterator] = once(40); globalThis.replace = () => { above.values = once(50); };
# CHECK: 6
# CHECK-NEXT: 6
# CHECK-NEXT: 40
# CHECK-NEXT: exited with 0
# RUN(WALK): walk f1 mechanisms=all
# WALK-LABEL: code f1:Body
# WALK: = IsPristine {{*}}builtinClass=Array aspects=[Storage, Names, CellAlone]
# WALK: = GetArrayElement

