# `$isObjectPrototypeWithoutAddedNames()` reads its result from one byte, which the runtime sets when a name is added.
# After a true result the library's source omits lookups, and no operation is there for any run-time check to test.
# With testing=CheckWalkAtRunTime the true result is checked against the object: each name that its structure lists must be one that the table of built-ins gives it.
# 4097 means "nothing, answered by the true result that no name was added".
# OPTIONS: admit=ReplacedBuiltins
# RUN(EMIT): emit f1 mechanisms=all testing=CheckWalkAtRunTime
# EMIT: = Const32(4097)
# RUN(BARE): emit f1 mechanisms=all
# BARE-NOT: = Const32(4097)
# RUN(ASKED): run-in-shell mechanisms=all testing=CheckWalkAtRunTime const aboveAll = Object.prototype; globalThis.lay = () => { Object.defineProperty(aboveAll, "laid", { value: 1, configurable: true }); }; globalThis.take = () => { delete aboveAll.laid; };
# ASKED: true
# ASKED-NEXT: false
# ASKED-NEXT: false
# ASKED-NEXT: exited with 0
# RUN(BOTH): run-in-shell mechanisms=all testing=CheckProofsAtRunTime,CheckWalkAtRunTime const aboveAll = Object.prototype; globalThis.lay = () => { Object.defineProperty(aboveAll, "laid", { value: 1, configurable: true }); }; globalThis.take = () => { delete aboveAll.laid; };
# BOTH: true
# BOTH-NEXT: false
# BOTH-NEXT: false
# BOTH-NEXT: exited with 0
# Fault injection, testing=AssumeGuardsAndFacts: the byte is assumed to say "as built". With that fault alone the test silently returns true while the name is there.
# RUN(BITES): run-in-shell mechanisms=all testing=AssumeGuardsAndFacts const aboveAll = Object.prototype; globalThis.lay = () => { Object.defineProperty(aboveAll, "laid", { value: 1, configurable: true }); }; globalThis.take = () => { delete aboveAll.laid; };
# BITES: true
# BITES-NEXT: true
# BITES-NEXT: true
# BITES-NEXT: exited with 0
# RUN(ASKEDLIE): run-in-shell mechanisms=all testing=CheckWalkAtRunTime,AssumeGuardsAndFacts const aboveAll = Object.prototype; globalThis.lay = () => { Object.defineProperty(aboveAll, "laid", { value: 1, configurable: true }); }; globalThis.take = () => { delete aboveAll.laid; };
# ASKEDLIE: true
# ASKEDLIE-NEXT: bun: internal AOT error: property lookup check failed
# ASKEDLIE-NEXT: the check that a built-in object has no added properties passed, but the object has an added property, a computed key
# ASKEDLIE: crashed with
# PROGRAM-OF: whether-a-name-was-added-above-all-objects-is-asked-of-a-byte.ir
