# member-that-nobody-writes-refuses-a-store-that-nobody-followed.ir for a holder that hangs under no name of the global object
# hidden(); print(new Int32Array(3).length)   where `hidden` is a function of the shell's own, which climbs to %TypedArray%.prototype from Int32Array.prototype: the program hands it nothing
# the getter is a constant in the code, so the lock has to hold whoever writes: the definition by code that nobody has seen is refused, and the code goes on with the getter of the table
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell globalThis.hidden = () => { try { Object.defineProperty(Object.getPrototypeOf(Int32Array.prototype), "length", { get() { return 7; } }); print("stored"); } catch (error) { print(error.constructor.name); } };
# CHECK: TypeError
# CHECK-NEXT: 3
# CHECK-NEXT: exited with 0
# RUN(LOCKS): locks open
# LOCKS: locked TypedArrayPrototypeLength constant

module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="hidden" [isFreeName]
    v2 = Call v1, -
    v3 = Builtin builtin=Int32Array
    v4 = Integer integer=3
    v5 = Construct v3, -, v4 calleeName="Int32Array"
    v6 = PropGet v5 key="length"
    v7 = PropGet v0 key="print" [isFreeName]
    v8 = Call v7, -, v6
    Return v8
}
