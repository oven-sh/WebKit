# hidden().has = 0; climb(hidden()); say(); replace(); say(); restore(); say()   with   say = () => { print(asked(map, 1)); print(asked(set, 1)); print(asked(own, 1)); }
# function asked(thing: any, key: number) { return thing.has(key); }
# `has` above Maps and above Sets is open in this test run: a store nobody followed may reach it. Nobody knows the class of `thing`: the call goes by name.
# The call still names the method that a class gives under that key, and the stub looks at the receiver and enters the built-in without a lookup, as where the member is locked:
# in a test run that stub also asks the byte of the member. replace() replaces `has` above Maps alone: the Map finds what was laid, the Set goes on through the stub of its own class; put back, the byte stays set and the lookup answers.
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell mechanisms=all const aboveMaps = Map.prototype, has = aboveMaps.has; globalThis.hidden = () => [1]; globalThis.map = new Map([[1, 2]]); globalThis.set = new Set([2]); globalThis.own = { has: () => "own" }; globalThis.replace = () => { aboveMaps.has = () => "laid"; }; globalThis.restore = () => { aboveMaps.has = has; };
# CHECK: true
# CHECK-NEXT: false
# CHECK-NEXT: own
# CHECK-NEXT: laid
# CHECK-NEXT: false
# CHECK-NEXT: own
# CHECK-NEXT: true
# CHECK-NEXT: false
# CHECK-NEXT: own
# CHECK-NEXT: exited with 0
# RUN(LOCKS): locks open
# LOCKS: open MapPrototypeHas spelled-through-unseen
# LOCKS: open SetPrototypeHas spelled-through-unseen
# RUN(WALK): walk f1 mechanisms=all
# WALK-LABEL: code f1:Body
# WALK: = Call {{*}}calleeKey="has"{{*}}methodOfReceiverAsMade=

module m0 path="/a.test.ts" displayPath="a.test.ts" body=f0
entry module=m0
