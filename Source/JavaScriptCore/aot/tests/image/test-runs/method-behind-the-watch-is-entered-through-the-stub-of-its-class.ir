    v1 = NewClosure function=f1
    v2 = NewClosure function=f2
    v3 = PropGet v0 key="hidden" [isFreeName]
    v4 = Call v3, -
    v5 = Integer integer=0
    PropSet v4, v5 key="has"
    v7 = Call v3, -
    v8 = PropGet v0 key="Object" [isFreeName]
    v9 = PropGet v8 key="getPrototypeOf"
    v10 = Call v9, v8, v7 calleeKey="getPrototypeOf"
    v11 = Call v2, -, v1
    v12 = PropGet v0 key="replace" [isFreeName]
    v13 = Call v12, -
    v14 = Call v2, -, v1
    v15 = PropGet v0 key="restore" [isFreeName]
    v16 = Call v15, -
    v17 = Call v2, -, v1
    Return v17
}
function f1 name="asked" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = PropGet v0 key="has"
