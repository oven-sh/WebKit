    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v2, -, v1, v3
    v5 = PropGet v1 key="imul"
    v6 = Integer integer=2
    v7 = Call v5, v1, v6, v6 calleeKey="imul"
    v8 = PropGet v0 key="print" [isFreeName]
    v9 = Call v8, -, v7
    Return v9
}
