    v5 = PropGet v0 key="lay" [isFreeName]
    v6 = Call v5, -
    v7 = Call v1, -
    v8 = Call v2, -, v7
    v9 = PropGet v0 key="take" [isFreeName]
    v10 = Call v9, -
    v11 = Call v1, -
    v12 = Call v2, -, v11
    Return v12
}
function f1 name="asks" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
