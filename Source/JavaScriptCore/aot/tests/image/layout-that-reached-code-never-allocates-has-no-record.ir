# If the image described every layout of the program, the names of the properties of an object literal could be read out of the executable though only code that nothing reaches would have made the object
# function dead() { return { onlyBehindTheArm: 1 } }  function live() { return { kept: 2 } }  enum Mode { On = 1 }  sink(Mode.On === 1 ? live() : dead());
# Link says which layouts reached code allocates. The plan gives the others no cells and no shape, so no table has a record of them and nothing numbers their names.
# RUN(LINK): link layouts mechanisms=all
# LINK: layout L0 never-allocated
# RUN(PLAN): plan layouts shapes mechanisms=all
# PLAN: layout L0 None never-allocated
# PLAN-NOT: onlyBehindTheArm
# PLAN: layout L1 CompiledObject
# PLAN: slot 0 "kept"
# PLAN: shape 1 L1
# With Folding withheld both calls are built.
# RUN(BOTH): plan layouts shapes mechanisms=-Folding
# BOTH: layout L0 CompiledObject
# BOTH: slot 0 "onlyBehindTheArm"
# RUN(ALL): run-in-shell mechanisms=all globalThis.sink = value => print(JSON.stringify(value));
# ALL: {"kept":2}
# ALL-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none globalThis.sink = value => print(JSON.stringify(value));
# NONE: {"kept":2}
# NONE-NEXT: exited with 0

layout L0 module=m0 fields=[{key="onlyBehindTheArm" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="kept" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="sink" [isFreeName]
    v4 = Integer integer=1
    v5 = Integer integer=1
    v6 = StrictEq v4, v5
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    v7 = Call v1, - calleeName="live"
    Jump -> next b3(v7)
  b2():
    v8 = Call v0, - calleeName="dead"
    Jump -> next b3(v8)
  b3(v9: anything):
    v10 = Call v3, -, v9 calleeName="sink"
    Return v10
}
function f1 name="dead" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = Integer integer=1
    PropDefine v0, v1 key="onlyBehindTheArm"
    v3 = FinishObject v0
    Return v3
}
function f2 name="live" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1
    v1 = Integer integer=2
    PropDefine v0, v1 key="kept"
    v3 = FinishObject v0
    Return v3
}
