# function handedOn() { return [/a**/, /[b-a]/]; }  function lookedAt() { return /(/; }  hold(handedOn, typeof lookedAt);
# A build asks about each literal while it lowers a file and stops there (TS100307). Behind that the image has a check of its own: a literal that JavaScript rejects has no record, and the build stops
# It is asked of the literals that compiled code mentions: Link does not reach the second function, so nobody builds its literal: two of the three are reported
# RUN: image Text
# DIAGNOSTIC: InvalidRegExpLiteral 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="hold" [isFreeName]
    v6 = TypeOf v3
    v7 = Call v5, -, v1, v6 calleeName="hold"
    v8 = Undefined
    Return v8
}
function f1 name="handedOn" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a**"
    v1 = NewRegExp pattern="[b-a]"
    v2 = NewArray v0, v1 contents=anything
    Return v2
}
function f2 name="lookedAt" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="("
    Return v0
}
