# hold(/^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/);
# Yarr keeps the place to go back to in its frame, without a signature, and jumps to it from there. An engine that signs return addresses lets it (aot/README.md, "Signed return addresses")
# STATISTIC: RegExpsCompiled >= 1
# RUN: image
# CHECK-NOT: section RegExps 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="hold" [isFreeName]
    v2 = NewRegExp pattern="^[+-]?(\\d+\\.?\\d*|\\.\\d+)(e[+-]?\\d+)?$"
    v3 = Call v1, -, v2 calleeName="hold"
    v4 = Undefined
    Return v4
}
