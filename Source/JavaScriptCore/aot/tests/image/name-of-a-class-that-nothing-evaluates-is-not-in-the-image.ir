# If every class had a record, the name of a class that stands in a branch which the build has cut away, or in a file that nobody imports, could be read out of the executable
# if (false) { class qqq.. { x = 1 } }  class zzz.. { constructor(x) { this.x = x; } }  print(new zzz..(3).constructor.name.length);
# The record of a class holds its name. A class has a record where reached code evaluates it. No NewClass of the first is left in the program.
# Each name is one letter 32 times: wherever the text begins, one line of 16 bytes holds nothing else. A text that is only shown is coded and printed as it reads.
# LIBRARY: own
# RUN(KEPT): image Text mechanisms=all
# KEPT: coded zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
# Link says that nothing allocates an object of the first. With Link withheld any layout may be allocated, and the record of its objects holds the name.
# RUN(GONE): image Text mechanisms=all
# GONE-NOT: 71 71 71 71 71 71 71 71 71 71 71 71 71 71 71 71
# GONE-NOT: coded qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
# RUN(PLAN): plan classes mechanisms=all
# PLAN-NOT: class L0
# PLAN: class L1
# RUN: run-in-shell
# CHECK: 32
# CHECK-NEXT: exited with 0

layout L0 kind=Instance name="qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 kind=Instance name="zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz" module=m0 constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L1
    v2 = FinishClass v1 layout=L1
    v3 = Integer integer=3
    v4 = Construct v2, -, v3 calleeName="zzz"
    v5 = PropGet v4 key="constructor"
    v6 = PropGet v5 key="name"
    v7 = PropGet v6 key="length"
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="print" [isFreeName]
    v10 = Call v9, -, v7 calleeName="print"
    v11 = Undefined
    Return v11
}
function f1 name="zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    PropSet v3, v1 key="x"
    Return v3
}
