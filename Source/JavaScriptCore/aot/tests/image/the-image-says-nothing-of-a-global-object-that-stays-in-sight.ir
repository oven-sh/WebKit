# take(1)
# The control of the-image-says-that-the-global-object-is-let-go.ir: a name is read off the global object and called; the object itself goes nowhere.
# RUN: image
# CHECK: flags
# CHECK-NOT: LetsGlobalObjectGo

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="take" [isFreeName]
    v2 = Integer integer=1
    v3 = Call v1, -, v2 calleeName="take"
    v4 = Undefined
    Return v4
}
