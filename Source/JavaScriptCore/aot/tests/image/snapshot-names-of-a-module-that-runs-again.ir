# A file that may run again keeps the variables of its scope with each run: what a function reads of them it captures, and what a function stores into lies in an environment. A heap snapshot shows them
# where the interpreter has them: in the scope of the module, each once, however many functions capture it. What a call of a function declares stays in a scope of its own, captured or kept in an
# environment, and that scope leads on to the scope of the module.
# const keptByValue = fresh(); let keptInEnvironment; const set = () => { keptInEnvironment = fresh(); }; const first = () => keptByValue; const second = () => keptByValue === keptInEnvironment;
# const make = keptInCall => { let keptInScope = fresh(); return () => { const was = keptInScope; keptInScope = keptInCall; return was === keptByValue; }; }; set(); hold(first, second, make(fresh())); print(namesOfVariables());
# RUN(TABLES): image ProgramTables
# TABLES-LABEL: ProgramTables:
# TABLES-COUNT-3: namedCapture closure={{*}} slot={{*}} name=[[byValue]] isVariableOfModule
# RUN: run-in-shell globalThis.fresh = () => ({}); globalThis.held = []; globalThis.hold = (...values) => { held.push(...values); }; globalThis.namesOfVariables = () => { const snapshot = generateHeapSnapshot(); const kind = snapshot.edgeTypes.indexOf("Variable"); const internal = snapshot.edgeTypes.indexOf("Internal"); const classes = new Map(); for (let i = 0; i < snapshot.nodes.length; i += 4) classes.set(snapshot.nodes[i], snapshot.nodeClassNames[snapshot.nodes[i + 2]]); const underLoader = new Set(); for (let i = 0; i < snapshot.edges.length; i += 4) { if (snapshot.edges[i + 2] === internal && classes.get(snapshot.edges[i]) === "ModuleLoader") underLoader.add(snapshot.edges[i + 1]); } const overModule = new Set(); for (let i = 0; i < snapshot.edges.length; i += 4) { if (snapshot.edges[i + 2] === internal && underLoader.has(snapshot.edges[i + 1])) overModule.add(snapshot.edges[i]); } const found = []; for (let i = 0; i < snapshot.edges.length; i += 4) { const name = snapshot.edgeNames[snapshot.edges[i + 3]]; if (snapshot.edges[i + 2] === kind && name.startsWith("kept")) found.push(name + " in " + classes.get(snapshot.edges[i]) + (underLoader.has(snapshot.edges[i]) ? " under the loader" : overModule.has(snapshot.edges[i]) ? " over the module" : "")); } return found.sort().join(", "); };
# CHECK: keptByValue in JSModuleEnvironment under the loader, keptInCall in JSLexicalEnvironment over the module, keptInEnvironment in JSModuleEnvironment under the loader, keptInScope in JSLexicalEnvironment over the module
# CHECK-NEXT: exited with 0

