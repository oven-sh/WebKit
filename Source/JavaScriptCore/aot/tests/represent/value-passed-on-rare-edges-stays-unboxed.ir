# What an edge passes is converted on the edge. Four edges that take the sum of a loop boxed do not outvote the addition and the back edge if they lead to a block that is seldom entered,
# or out of the loop: the loop carries a double, and the sum is boxed on the four edges. Four edges to a block that runs as often as the rest of the loop do
# FORM: Placed
# RUN: pass ChooseRepresentations

module m0 path="main.js" displayPath="main.js"
function f0 name="rareEdgesTakeTheSumBoxed" parameters=[{type=number}, {type=boolean}, {type=boolean}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: boolean, v2: boolean, v3: boolean, v4: boolean):
    Jump -> next b1(v0)
  b1(v5: number):
    LoopHint
    Branch v1 -> taken b2(), notTaken b6(v5)
  b2():
    Branch v2 -> taken b3(), notTaken b6(v5)
  b3():
    Branch v3 -> taken b4(), notTaken b6(v5)
  b4():
    Branch v4 -> taken b5(), notTaken b6(v5)
  b5():
    v7 = Add v5, v0 form=Numbers
    Jump -> next b1(v7)
  b6(v8: anything) frequency=Rare:
    Branch v1 -> taken b1(v0), notTaken b7(v8)
  b7(v9: anything):
    Return v9
}
