# if (x) where the number arrives boxed: it is tested as it is: behind the test of the tag an int32 is tested for zero, and nothing is unboxed to a double. A number that is a double already is tested as a double
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: pass ChooseRepresentations
# RUN(CODE): generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="testedNumber" parameters=[{type=anything}] results=[{type=i32}] {
    v1 = TypeTest v0 testedType=number
    TestAndBranch v1 -> taken b1(| 0), notTaken b3()
  b1(v2: number):
    v3 = ToBoolean v2 form=Numbers
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    v4 = Integer integer=1
    Return v4
  b3():
    v5 = Integer integer=2
    Return v5
# CHECK: b1(v2: number @JSValue):
# CHECK-NEXT: v3: boolean @Boolean = ToBoolean v2 form=Numbers
}

function f1 name="doubleStaysDouble" parameters=[{type=number}] results=[{type=boolean}] {
    v1 = Mul v0, v0 form=Numbers
    v2 = ToBoolean v1 form=Numbers
    Return v2
}
# CHECK-LABEL: function f1 name="doubleStaysDouble"
# CHECK: v1: number @Double = Mul
# CHECK-NEXT: v2: boolean @Boolean = ToBoolean v1 form=Numbers
# CODE-NOT: no code
