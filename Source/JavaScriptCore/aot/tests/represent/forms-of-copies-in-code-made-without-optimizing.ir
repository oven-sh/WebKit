function f0 name="twoCopiesAreAskedTogether" parameters=[{type=anything}] results=[{type=i32}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|i32
    TestAndBranch v1 -> taken b3(| 0), notTaken b1()
