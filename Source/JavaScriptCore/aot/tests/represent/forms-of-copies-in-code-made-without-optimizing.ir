function f1 name="constantTakesTheFormOfMostOfItsUses" parameters=[{type=i32}, {type=boolean}] results=[{type=anything}] {
  b0(v0: i32, v1: boolean):
    v2 = Integer integer=3
    v3 = BitAnd v0, v2 form=Integers
    v4 = BitOr v3, v2 form=Integers
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v4
  b2():
    Return v2
}
# CHECK-LABEL: function f1 name="constantTakesTheFormOfMostOfItsUses"
# CHECK: v2: 3 @Int32 = Integer integer=3
# CHECK: b2():
# CHECK-NEXT: Return v2

function f2 name="parameterFollowsItsUses" parameters=[{type=anything}, {type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: number, v2: boolean):
    v3 = AssumeType v0 castType=number
    Branch v2 -> taken b1(v3), notTaken b1(v1)
  b1(v4: number):
    v5 = Mul v4, v1 form=Numbers
    v6 = Mul v4, v5 form=Numbers
    Return v6
}
