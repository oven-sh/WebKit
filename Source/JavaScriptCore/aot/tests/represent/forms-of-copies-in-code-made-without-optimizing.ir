function f3 name="parameterFollowsWhatArrives" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = AssumeType v0 castType=number
    v4 = AssumeType v1 castType=number
