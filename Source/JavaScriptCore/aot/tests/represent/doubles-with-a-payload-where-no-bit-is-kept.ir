function f0 name="readAtSumOfNumbers" parameters=[{type=Array<i32, proven, Int32>}, {type=number}, {type=undefined|number}] results=[{type=undefined|i32}] {
    v3 = Add v1, v1 form=Numbers
    v4 = IsElementPresent v0, v3 arrayStorage=Int32
    TestAndBranch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    v6 = GetArrayElement v0, v3, v5 arrayStorage=Int32 level=Proven [isPresent]
    Return v6
  b2():
    v7 = Undefined
    Return v7
}
