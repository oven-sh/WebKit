# A block parameter that takes narrow references stays narrow as long as the collector cannot run. Where it also takes a parameter of the function it does not: the caller may have handed in an object that lies in its frame,
# outside of the cage that a narrow reference counts from. That holds for every cell of a frame, whether or not an array stands in the function.
# OPTIONS: references=narrow
# RUN: pipeline ChooseRepresentations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="second" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="third" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g0
    v5 = NewObject -, v1 layout=L0 fields=[0]
    v6 = FinishObject v5
    PutModuleVariable v6 variable=g1
    v8 = NewObject -, v1 layout=L0 fields=[0]
    v9 = FinishObject v8
    PutModuleVariable v9 variable=g2
    v11 = NewObject -, v1 layout=L0 fields=[0]
    v12 = FinishObject v11
    v13 = CallDirect v12, v1 function=f1 [isNeverInlined]
    v14 = PropGet v0 key="keep" [isFreeName]
    v15 = Call v14, -, v13
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: v11: {{*}} = NewObject {{*}} storage=Frame

function f1 name="parameterOrVariable" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = Null
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b7(v0)
  b2():
    v4 = ToBoolean v1
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = GetModuleVariable variable=g0
    Jump -> next b7(v5)
  b4():
    v6 = Undefined
    v7 = StrictEq v1, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    v8 = GetModuleVariable variable=g1
    Jump -> next b7(v8)
  b6():
    v9 = GetModuleVariable variable=g2
    Jump -> next b7(v9)
  b7(v10: L0):
    v11 = PropGet v10 key="x"
    Return v11
}
# CHECK-LABEL: function f1 name="parameterOrVariable"
# CHECK-NOT: Compress v0
# CHECK-NOT: (v10: {{*}} @Cell32)
