# a + b + c where a and b arrive boxed. The first sum goes into the second, which adds doubles. Only blocks that are seldom entered take it boxed.
# An argument on an edge counts for as often as the edge is taken, not for as often as the block runs that the edge leaves: the sum is a double, and is boxed on the rare edges.
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: pass ChooseRepresentations
# RUN(CODE): generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="sumOfThree" parameters=[{type=anything}, {type=anything}, {type=number}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v5 = AssumeType v0 provenType=number
    v6 = AssumeType v1 provenType=number
    v7 = Add v5, v6 form=Numbers
    Branch v3 -> taken b1(), notTaken b3(v7)
  b1():
    Branch v4 -> taken b2(), notTaken b3(v7)
  b2():
    v8 = Add v7, v2 form=Numbers
    Return v8
  b3(v9: anything) frequency=Rare:
    Return v9
# CHECK: v7: number @Double = Add v5, v6 form=Numbers
# CHECK: number @Double = Add v7, v2 form=Numbers
}

function f1 name="sumThatLikelyBlocksTakeBoxed" parameters=[{type=anything}, {type=anything}, {type=number}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v5 = AssumeType v0 provenType=number
    v6 = AssumeType v1 provenType=number
    v7 = Add v5, v6 form=Numbers
    Branch v3 -> taken b1(), notTaken b3(v7)
  b1():
    Branch v4 -> taken b2(), notTaken b3(v7)
  b2():
    v8 = Add v7, v2 form=Numbers
    Return v8
  b3(v9: anything):
    Return v9
# CHECK: v7: number @JSValue = Add v5, v6 form=Numbers
}
