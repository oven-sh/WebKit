# A bitwise operator in the form Numbers takes a number that is boxed as it is: an int32 is its low word behind one test of the tag, and only a double is converted.
# A number that is made as a double stays a double
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: pass ChooseRepresentations
# RUN(CODE): generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="orOfTestedNumber" parameters=[{type=anything}, {type=i32}] results=[{type=i32}] {
    v2 = TypeTest v0 testedType=number
    TestAndBranch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: number):
    v4 = BitOr v3, v1 form=Numbers
    Return v4
  b2():
    Return v1
# CHECK: TestAndBranch v2 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v3: number @JSValue):
# CHECK-NEXT: i32 @Int32 = BitOr v3, v1 form=Numbers
}

function f1 name="eachOperatorOnBoxedNumbers" parameters=[{type=anything}] results=[{type=int}] {
    v1 = TypeTest v0 testedType=number
    TestAndBranch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: number):
    v3 = BitAnd v2, v2 form=Numbers
    v4 = BitXor v2, v3 form=Numbers
    v5 = LShift v2, v4 form=Numbers
    v6 = RShift v5, v2 form=Numbers
    v7 = URShift v2, v6 form=Numbers
    Return v7
  b2():
    v8 = Integer
    Return v8
# CHECK: b1(v2: number @JSValue):
# CHECK-NOT: = Unbox
}

function f2 name="orOfComputedNumber" parameters=[{type=number}, {type=i32}] results=[{type=i32}] {
    v2 = Mul v0, v0 form=Numbers
    v3 = BitOr v2, v1 form=Numbers
    Return v3
# CHECK: number @Double = Mul v0, v0 form=Numbers
# CHECK-NEXT: i32 @Int32 = BitOr v2, v1 form=Numbers
}

function f3 name="usedAsDoubleToo" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = TypeTest v0 testedType=number
    TestAndBranch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: number):
    v4 = Mul v3, v1 form=Numbers
    v5 = Add v3, v4 form=Numbers
    v6 = BitOr v3, v3 form=Numbers
    v7 = Add v5, v6 form=Numbers
    Return v7
  b2():
    Return v1
}
# CHECK-LABEL: function f3 name="usedAsDoubleToo"
# CHECK: b1(v3: number @Double):
# CHECK: i32 @Int32 = BitOr v3, v3 form=Numbers
# CODE-NOT: diagnostic
