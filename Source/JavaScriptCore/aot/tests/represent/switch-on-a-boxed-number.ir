# A switch takes a number that is boxed as it is: an int32 is its low word behind one test of the tag, and only a double is converted.
# A number that is made as a double stays a double, and an integer stays an integer
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: pass ChooseRepresentations
# RUN(CODE): generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="switchOnTestedNumber" parameters=[{type=anything}] results=[{type=i32}] {
    v1 = TypeTest v0 testedType=number
    TestAndBranch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: number):
    Switch v2 cases=[1, 2] -> case b2(), case b3(), otherwise b4()
  b2():
    v3 = Integer integer=10
    Return v3
  b3():
    v4 = Integer integer=20
    Return v4
  b4():
    v5 = Integer
    Return v5
# CHECK: b1(v2: number @JSValue):
# CHECK-NEXT: Switch v2
}

function f1 name="switchOnComputedNumber" parameters=[{type=number}] results=[{type=i32}] {
    v1 = Mul v0, v0 form=Numbers
    Switch v1 cases=[1, 4] -> case b1(), case b2(), otherwise b3()
  b1():
    v2 = Integer integer=10
    Return v2
  b2():
    v3 = Integer integer=20
    Return v3
  b3():
    v4 = Integer
    Return v4
# CHECK: number @Double = Mul v0, v0 form=Numbers
# CHECK-NEXT: Switch v1
}

function f2 name="switchOnInteger" parameters=[{type=i32}] results=[{type=i32}] {
    Switch v0 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    v1 = Integer integer=10
    Return v1
  b2():
    v2 = Integer integer=20
    Return v2
  b3():
    v3 = Integer
    Return v3
}
# CHECK-LABEL: function f2 name="switchOnInteger"
# CHECK: b0(v0: i32 @Int32):
# CHECK-NEXT: Switch v0
# CODE-NOT: diagnostic
