  b1():
    LoopHint
    v4 = TypeTest v0 testedType=number
    TestAndBranch v4 -> taken b2(| 0), notTaken b6()
  b2(v5: number):
    Branch v2 -> taken b3(v1), notTaken b1()
  b3(v6: number):
    LoopHint
    v8 = Less v6, v5 form=Numbers
    Branch v8 -> taken b4(), notTaken b5()
  b4():
    v9 = Increment v6 form=Numbers
    Jump -> next b3(v9)
  b5():
    Return v6
  b6():
    Return v1
}
# CHECK-LABEL: function f1 name="boundMadeInCycleThatTheLoopLeaves"
# CHECK: b2(v5: number @Double):
# CHECK: = Less v6, v5 form=Numbers

