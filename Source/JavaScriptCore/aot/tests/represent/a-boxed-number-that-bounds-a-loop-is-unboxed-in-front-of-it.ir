# `i < bound` where the bound arrives boxed, out of a field that holds anything: a comparison takes a boxed number as it is and looks at its tag, which in a loop is once a turn.
# f0: the bound comes into the loop from outside and the counter is a double: the bound is unboxed once, where it is made.
# f1: the loop is left for good, so it lies in none of the cycles around the block that makes the bound. It still runs more often than that block.
# f2: beside an int32 the tag decides whether integers are compared: the bound stays as it is. f3: a bound that is made in the turn stays as it is.
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: pass ChooseRepresentations
# RUN(CODE): generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="boundFromOutside" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = TypeTest v0 testedType=number
    TestAndBranch v2 -> taken b1(| 0), notTaken b4()
  b1(v3: number):
    Jump -> next b2(v1)
  b2(v4: number):
    LoopHint
    v6 = Less v4, v3 form=Numbers
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Increment v4 form=Numbers
    Jump -> next b2(v7)
  b4():
    Return v1
}
