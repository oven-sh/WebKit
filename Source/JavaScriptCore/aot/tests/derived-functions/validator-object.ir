# The validator of an object node does what ends a stretch first, reads all members under one guard, validates them, and copies the input as the layout with the replaced members. It runs no getter and no trap: an input that is not plain data is left to the general validator, which spreads it once. The copy is an ordinary object where the run time gives up, so it is only expected to have the layout: the validator tests it and leaves it to the general validator otherwise
# FORM: Prepared optimizing
# RUN: derived-functions Validator:x0.0 Validator:x1.0 Validator:x2.0 Validator:x3.0 Validator:x4.0 Validator:x5.0
# STATISTIC: ValidatorsCreated = 8
# STATISTIC: ParsersCreated = 0

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=L0 layouts=[L0, L1] validation=[{shape=Object{layout=L0 members=[{key="a" node=1 field=0}, {key="inner" node=2 field=1}, {key="u" node=3 field=2}] undeclared=Rejected} type=L0}, {shape=Primitive{primitive=Number} type=number}, {shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}, {type=anything}]
expectedresult x1 type=L2 layouts=[L2] validation=[{shape=Object{layout=L2 members=[{key="toString" node=1 field=0}, {key="200" node=1}]} type=L2}, {shape=Primitive{primitive=Number} type=number}]
expectedresult x2 type=object validation=[{shape=Object{members=[{key="inner" node=1}]} type=object}, {shape=Object{layout=L1 members=[{key="x" node=2 field=0}]} type=L1}, {shape=Primitive{primitive=Number} type=number}]
expectedresult x3 type=L1 layouts=[L1] validation=[{shape=Object{layout=L1 members=[{key="x" node=1 field=0}] undeclared=Validated undeclaredValue=2} type=L1}, {shape=Primitive{primitive=Number} type=number}, {shape=Primitive{} type=string}]
expectedresult x4 type=object validation=[{shape=Dictionary{value=1} type=object}, {shape=Primitive{primitive=Number} type=number}]
expectedresult x5 type=L3 layouts=[L3] validation=[{shape=Object{layout=L3 members=[{key="n" node=1 field=0 isOptional=true}, {key="d" node=2 field=1}]} type=L3}, {shape=Primitive{primitive=Number} type=number}, {shape=Primitive{primitive=Number} type=number rules=[DefaultNumber{value=7}]}]
layout L0 name="Outer" fields=[{key="a" declared={type=number}}, {key="inner" declared={type=L1}}, {key="u" declared={type=anything}}]
layout L1 name="Inner" fields=[{key="x" declared={type=number}}]
layout L2 name="OddNames" fields=[{key="toString" declared={type=number}}]
layout L3 name="OptionalAndDefault" fields=[{key="n" declared={type=undefined|number}}, {key="d" declared={type=number}}]

