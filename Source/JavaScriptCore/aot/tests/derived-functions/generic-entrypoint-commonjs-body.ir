# From the program as read: the loader calls the body of a CommonJS module like any function, through its generic entrypoint. Flow knows the five arguments, and no Claim names an object that belongs to one module
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# OPTIONS: check=VerifyEachPass

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/library.cjs" displayPath="library.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="library" module=m1 kind=CommonJsModule flags=[IsSloppy, HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    Return
}
# CHECK-NOT: Claim {{*}}castType=builtin(
# CHECK: function f1 name="library"{{*}}thisType={type=builtin(ModuleObjectExports) written=anything} parameters=[{type=builtin(ModuleObjectExports) written=anything}, {type=builtin(ModuleRequire) written=anything}, {type=builtin(ModuleObject) written=anything}, {type=string written=anything}, {type=string written=anything}]
# CHECK-NOT: Claim {{*}}castType=builtin(
# CHECK: name="library"{{*}}role=GenericEntrypoint
# CHECK-NEXT: b0([[closure]]: f1, [[this]]: anything, [[exports]]: anything, [[require]]: anything, [[module]]: anything, [[filename]]: anything, [[dirname]]: anything):
# CHECK-NEXT: [[thisObject]]: object = Claim [[this]] castType=object cause=AddedByPass
# CHECK-NEXT: = AssumeType [[thisObject]] castType=builtin(ModuleObjectExports)
# CHECK-NEXT: [[exportsObject]]: object = Claim [[exports]] castType=object cause=AddedByPass
# CHECK-NEXT: = AssumeType [[exportsObject]] castType=builtin(ModuleObjectExports)
# CHECK-NEXT: [[requireFunction]]: function = Claim [[require]] castType=function cause=AddedByPass
# CHECK-NEXT: = AssumeType [[requireFunction]] castType=builtin(ModuleRequire)
# CHECK-NEXT: [[moduleObject]]: object = Claim [[module]] castType=object cause=AddedByPass
# CHECK-NEXT: = AssumeType [[moduleObject]] castType=builtin(ModuleObject)
# CHECK-NEXT: = Claim [[filename]] castType=string cause=AddedByPass
# CHECK-NEXT: = Claim [[dirname]] castType=string cause=AddedByPass
# CHECK-NEXT: = CallDirect {{*}}function=f1
# CHECK-NOT: Claim {{*}}castType=builtin(
