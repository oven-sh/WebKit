# The version of a derived constructor that takes the allocated object passes it on: super(..) is a direct call of the parent's version
# FORM: Prepared
# RUN: derived-functions AllocatedThisVersion:f3 AllocatedThisVersion:f4 AllocatedThisVersion:f5 AllocatedThisVersion:f7

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Shape" module=m0 constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flow={baseState=None members=[L0, L1, L2, L3, L4] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L1 kind=Instance name="Circle" module=m0 predictedBase=L0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0 members=[L1, L2] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L2 kind=Instance name="Ring" module=m0 predictedBase=L1 constructor=f3 flags=[HasHeritage] flow={baseState=Layout base=L1 members=[L2] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L3 kind=Instance name="Relinkable" module=m0 predictedBase=L0 constructor=f4 flags=[HasHeritage] flow={baseState=Layout base=L0 members=[L3] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed prototypeProperty=Fixed}
layout L4 kind=Instance name="Unlinked" module=m0 predictedBase=L0 constructor=f5 flags=[HasHeritage] flow={baseState=Layout base=L0 members=[L4] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L5 kind=Instance name="Cached" module=m0 constructor=f6 flow={baseState=None members=[L5, L6] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L6 kind=Instance name="BelowCached" module=m0 predictedBase=L5 constructor=f7 flags=[HasHeritage] flow={baseState=Layout base=L5 members=[L6] impossibleMutations=[LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}

function f0 name="main" results=[{type=undefined}] {
  b0():
    Return
}
function f1 name="Shape" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = AssumeType v3 castType=L0|L1|L2|L3|L4
    PropSet v4, v1 key="x"
    Return v4
}
function f2 name="Circle" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1 callees=[f1] [keepsShape]
    Return v4
}
function f3 name="Ring" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L2 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L2 callees=[f2] [keepsShape]
    Return v4
}
# CHECK-LABEL: function f3 name="Ring"
# CHECK-NOT: role=
# CHECK: = SuperConstruct v3, v1, v2 layout=L2
function f4 name="Relinkable" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L3 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L3 callees=[f1] [keepsShape]
    Return v4
}
function f5 name="Unlinked" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L4 {
  b0(v0: function, v1: anything, v2: anything):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L4 [keepsShape]
    Return v4
}
function f6 name="Cached" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=undefined|object}] results=[{type=object}] constructedClass=L5 {
  b0(v0: anything, v1: undefined|object):
    v2 = GetConstructPrototype v0 layout=L5
    v3 = NewObject v2 layout=L5
    v4 = AssumeType v3 castType=L5|L6
    v5 = TypeTest v1 testedType=object
    Branch v5 -> taken b1(| 0), notTaken b2()
  b1(v6):
    Return v6
  b2():
    Return v4
}
function f7 name="BelowCached" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=undefined|object}] results=[{type=anything}] constructedClass=L6 {
  b0(v0: function, v1: anything, v2: undefined|object):
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L6 callees=[f6]
    Return v4
}
# CHECK-LABEL: function f7 name="BelowCached"
# CHECK: = SuperConstruct v3, v1, v2 layout=L6

# CHECK: function [[shapeVersion]] name="Shape" module=m0 kind=BaseConstructor role=AllocatedThisVersion
# CHECK-NOT: NewObject

# CHECK: function [[circleVersion]] name="Circle" module=m0 kind=DerivedConstructor role=AllocatedThisVersion flags=[HasThis, HasNewTarget, TakesCallee]
# CHECK-NEXT: b0([[circleThis]]:{{*}}, [[circleCallee]]: function, [[circleNewTarget]]: anything, [[circleX]]: anything):
# CHECK-NOT: SuperConstruct
# CHECK: = CallDirect [[circleThis]], [[circleNewTarget]], [[circleX]] function=[[shapeVersion]] [isConstruction]
# CHECK-NOT: SuperConstruct
# CHECK: [[circleUndefined]]: undefined = Undefined
# CHECK-NEXT: Return [[circleUndefined]]

# CHECK: function [[ringVersion]] name="Ring" module=m0 kind=DerivedConstructor role=AllocatedThisVersion flags=[HasThis, HasNewTarget, TakesCallee]
# CHECK: derivation={source=f3 parameterMap=[{}, {original=0}, {original=1}, {original=2}]} creator=Version{provenVersion=f3} constructedClass=L2 {
# CHECK-NEXT: b0([[ringThis]]:{{*}}, [[ringCallee]]: function, [[ringNewTarget]]: anything, [[ringX]]: anything):
# CHECK-NOT: SuperConstruct
# CHECK: = CallDirect [[ringThis]], {{*}}[[ringNewTarget]], [[ringX]] function=[[circleVersion]] [isConstruction]
# CHECK-NOT: SuperConstruct
# CHECK: [[ringUndefined]]: undefined = Undefined
# CHECK-NEXT: Return [[ringUndefined]]

# CHECK: function [[relinkableVersion]] name="Relinkable" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NEXT: b0([[relinkableThis]]:{{*}}, [[relinkableCallee]]: function, [[relinkableNewTarget]]: anything, [[relinkableX]]: anything):
# CHECK-NEXT: = GetSuperBase [[relinkableCallee]]
# CHECK-NEXT: [[unchanged]]: boolean = IsPrototypeLinkUnchanged layout=L3 side=Static
# CHECK-NEXT: Branch [[unchanged]] -> taken [[direct]](| 0), notTaken [[startsOver]]()
# CHECK: [[direct]]([[guard]]: guard):
# CHECK-NOT: SuperConstruct
# CHECK: = CallDirect [[relinkableThis]], [[relinkableNewTarget]], [[relinkableX]] function=[[shapeVersion]] [isConstruction]
# CHECK-NOT: SuperConstruct
# CHECK: [[relinkableUndefined]]: undefined = Undefined
# CHECK-NEXT: Return [[relinkableUndefined]]
# CHECK-NEXT: [[startsOver]]() frequency=Rare:
# CHECK-NEXT: [[constructed]]:{{*}}= CallDirect [[relinkableCallee]], [[relinkableNewTarget]], [[relinkableX]] function=f4 [isConstruction]
# CHECK-NEXT: Return [[constructed]]

# CHECK: function [[unlinkedVersion]] name="Unlinked" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NOT: CallDirect
# CHECK: [[stillConstructed]]:{{*}}= SuperConstruct {{*}}layout=L4
# CHECK-NEXT: Return [[stillConstructed]]

# CHECK: function [[cachedVersion]] name="Cached" module=m0 kind=BaseConstructor role=AllocatedThisVersion
# CHECK: function [[belowVersion]] name="BelowCached" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NEXT: b0([[belowThis]]:{{*}}, [[belowCallee]]: function, [[belowNewTarget]]: anything, [[belowOther]]: undefined|object):
# CHECK-NOT: SuperConstruct
# CHECK: [[returned]]: undefined|object = CallDirect [[belowThis]], [[belowNewTarget]], [[belowOther]] function=[[cachedVersion]] [isConstruction]
# CHECK-NEXT: [[isObject]]: boolean = TypeTest [[returned]] testedType=object
# CHECK-NEXT: Branch [[isObject]] -> taken [[replaced]](| 0), notTaken [[kept]](
# CHECK-NEXT: [[belowJoin]]([[belowResult]]:
# CHECK-NEXT: Return [[belowResult]]
# CHECK-NEXT: [[replaced]]([[other]]: object)
# CHECK-NEXT: Jump -> next [[belowJoin]]([[other]])
# CHECK-NEXT: [[kept]](
# CHECK-NEXT: Jump -> next [[belowJoin]]([[belowThis]])
