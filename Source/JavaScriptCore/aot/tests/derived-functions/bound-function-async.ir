# A bound function of an async function is async, and one of an arrow function captures no this
# FORM: Prepared
# RUN: derived-functions BoundFunction:f0:0 BoundFunction:f2:0
# STATISTIC: BoundFunctions = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    Return v1
}
function f1 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    v2 = Undefined
    v3 = ReturnAsyncResult v1, v2
    Return v3
}
function f2 name="arrow" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
    Return v0
}
