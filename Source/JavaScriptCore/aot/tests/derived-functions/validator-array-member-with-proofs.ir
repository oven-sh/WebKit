# CHECK: [[assumed3]]:{{*}}= AssumeType {{*}} castType=null|Array<anything, proven, pristine[Storage, Names]>
# CHECK: = NewObject -, [[assumed3]] layout=L3 fields=[0]
# CHECK: [[assumedAgain3]]:{{*}}= AssumeType {{*}} castType=null|Array<anything, proven, pristine[Storage, Names]>
# CHECK: = CloneAs {{*}}, [[assumedAgain3]] layout=L3 fields=[0]
# CHECK: function {{*}}creator=Validator{type=L4 layout=L4 expectedResult=x4}
# CHECK: [[assumed4]]:{{*}}= AssumeType {{*}} castType=undefined|Array<anything, proven, pristine[Storage, Names]>
