# From the program as read: unknown code enters a function through its generic entrypoint, which calls the generic version and tests nothing
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=ChooseCallingConventions
# STATISTIC: FlowGenericVersions = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="register" [isFreeName]
    v5 = Call v4, -, v0
    v6 = CallDirect function=f2
    Return
}
# CHECK-LABEL: function f1 name="versioned"
# CHECK: parameters=[{type=fractional written=anything}]
function f1 name="versioned" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Mul v0, v0
    v2 = Add v1, v0
    Return v2
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    Return
}
# CHECK: function [[generic]] name="versioned"{{*}}role=GenericVersion{{*}}parameters=[{type=anything predicted=fractional}]
# CHECK: name="versioned"{{*}}role=GenericEntrypoint{{*}}derivation={source=f1} creator=Entrypoint{target=f1 arguments=Registers} {
# CHECK-NEXT: b0([[closure]]: f1, [[this]]: anything, [[argument]]: anything):
# CHECK-NEXT: [[result]]:{{*}}= CallDirect [[argument]] function=[[generic]]
# CHECK-NEXT: ReturnCall [[result]] requirement=Allowed
