# RUN: derived-functions GenericEntrypoint:f0
# STATISTIC: GenericEntrypoints = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="Class" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
