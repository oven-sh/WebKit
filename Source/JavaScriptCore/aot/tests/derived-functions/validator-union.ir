# The validator of a union node tests the kinds of value in a fixed order, tries the arms of one kind in order, and picks object arms by a tag that it reads once, from plain data only: reading it from anything else may run code of the program, which the general validator would run again
# FORM: Prepared optimizing
# RUN: derived-functions Validator:x0.0 Validator:x1.0 Validator:x2.0 Validator:x3.0
# STATISTIC: ValidatorsCreated = 12
# STATISTIC: ParsersCreated = 0

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=null|number|string|Array<number> validation=[{shape=Union{arms=[1, 2, 3, 4, 5]} type=null|number|string|Array<number>}, {shape=Array{element=3} type=Array<number>}, {shape=Primitive{} type=string rules=[MinimumLength{length=2}]}, {shape=Primitive{primitive=Number} type=number}, {shape=StringLiteral{value="a"} type="a"}, {shape=Null type=null}]
expectedresult x1 type=L0|L1|L2 layouts=[L0, L1, L2] validation=[{shape=Union{arms=[1, 2, 3]} type=L0|L1|L2}, {shape=Object{layout=L0 members=[{key="kind" node=4 field=0}]} type=L0}, {shape=Object{layout=L1 members=[{key="kind" node=5 field=0}]} type=L1}, {shape=Object{layout=L2 members=[{key="z" node=6 field=0}]} type=L2}, {shape=StringLiteral{value="a"} type="a"}, {shape=StringLiteral{value="b"} type="b"}, {shape=Primitive{primitive=Number} type=number}]
expectedresult x2 type=L3|L4 layouts=[L2, L3, L4, L5] validation=[{shape=Union{arms=[1, 2]} type=L3|L4}, {shape=Object{layout=L3 members=[{key="p" node=3 field=0}]} type=L3}, {shape=Object{layout=L4 members=[{key="p" node=4 field=0}]} type=L4}, {shape=Object{layout=L2 members=[{key="z" node=5 field=0}]} type=L2}, {shape=Object{layout=L5 members=[{key="w" node=5 field=0}]} type=L5}, {shape=Primitive{primitive=Number} type=number}]
expectedresult x3 type=anything validation=[{shape=Union{arms=[1, 2]} type=anything}, {shape=Primitive{primitive=Number} type=number rules=[Minimum{bound=1}]}, {type=anything}]
