# A bound function captures this, the bound arguments and the closure of the target, reads the captures of the target out of that closure, and takes the parameters that are left
# FORM: Prepared
# RUN: derived-functions BoundFunction:f0:1
# STATISTIC: BoundFunctions = 1
# CHECK: {role=BoundFunction target=f0 parameter=1} -> request 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Receiver"
layout L1 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]
function f0 name="target" kind=Method flags=[HasThis] length=2 captures=[{type=env L1}] thisType={type=L0} parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: env L1, v1: L0, v2: anything, v3: boolean):
    Return v2
}
# CHECK: function f1 name="target" module=m0 kind=Method role=BoundFunction length=1 captures=[{type=L0}, {type=anything}, {type=f0}] thisType={type=anything} parameters=[{type=boolean}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] derivation={source=f0 parameter=1} creator=BoundFunction{target=f0 numberOfBoundArguments=1 numberOfCapturedArguments=1 capturesTargetClosure=true} {
# CHECK-NEXT: b0([[receiver]]: L0, [[bound]]: anything, [[closure]]: f0, [[parameter]]: boolean):
# CHECK-NEXT: [[scope]]: env L1 = GetCapture [[closure]] function=f0
# CHECK-NEXT: [[result]]: anything = CallDirect [[scope]], [[receiver]], [[bound]], [[parameter]] function=f0
# CHECK-NEXT: ReturnCall [[result]] requirement=Allowed
# CHECK-NOT: role=BoundFunction
