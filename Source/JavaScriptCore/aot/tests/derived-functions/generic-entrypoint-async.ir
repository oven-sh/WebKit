# The generic entrypoint of an async function is like any other: it tests nothing, so no argument makes it reject. It has no handler and no promise of its own, and jumps to the ramp, which returns the promise
# FORM: Prepared
# RUN: derived-functions GenericEntrypoint:f0
# RUN(QUIET): derived-functions GenericEntrypoint:f0
# STATISTIC: GenericEntrypoints = 1

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Parameter
function f0 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number site=w0}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    Return v1
}
function f1 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    v2 = Undefined
    v3 = ReturnAsyncResult v1, v2
    Return v3
}
# CHECK: name="asynchronous" module=m0 role=GenericEntrypoint
# CHECK-NEXT: b0([[closure]]: f0, [[this]]: anything, [[argument]]: anything):
# CHECK-NEXT: [[number]]: number = AssumeType [[argument]] provenType=number
# CHECK-NEXT: [[promise]]: Promise = CallDirect [[number]] function=f0
# CHECK-NEXT: ReturnCall [[promise]] requirement=Allowed
# QUIET-LABEL: name="asynchronous" module=m0 role=GenericEntrypoint
# QUIET-NOT: Throw
# QUIET-NOT: handler=
# QUIET-NOT: CatchHandler
# QUIET-NOT: NewPromise
# QUIET-NOT: RejectPromise
