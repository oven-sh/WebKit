# The serializer of a record that runs no code and may hold itself tests the limit that fails at watched levels, and where the test fails it asks the run time whether it goes on.
# The serializer of a record that cannot hold itself, and that of a record around which code may run, test the limit of the stack alone.
# FORM: Prepared
# RUN: derived-functions Serializer:L0 Serializer:L1 Serializer:L2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Link" fields=[{key="x" declared={type=number} flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="below" declared={type=Array<L0, proven, pristine[Storage, Names]>} flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={constructorOrders=[{fields=[0, 1]}] impossibleMutations=[RedefineProperty, AddProperty, ChangePrototype]}
layout L1 name="Point" fields=[{key="x" declared={type=number} flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={constructorOrders=[{fields=[0]}] impossibleMutations=[RedefineProperty, AddProperty, ChangePrototype]}
layout L2 name="Crate" fields=[{key="link" declared={type=L0} flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="any" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1]}]}

# CHECK: function {{*}}creator=Serializer{layout=L0}
# CHECK-NEXT: b0(v0: object, v1: stringbuilder):
# CHECK: [[hasSpace0]]: boolean = JSONHasStackSpace [failsAtWatchedLevels]
# CHECK-NEXT: Branch [[hasSpace0]] -> taken [[body0]](), notTaken [[asks0]]()
# CHECK: [[gaveUp0]]() frequency=Rare:
# CHECK-NEXT: [[zero0]]: 0 = Integer
# CHECK-NEXT: Return [[zero0]]
# CHECK: [[asks0]]() frequency=Rare:
# CHECK-NEXT: [[goesOn0]]: boolean = JSONEnterWatchedLevel v1, v0
# CHECK-NEXT: Branch [[goesOn0]] -> taken [[yes0]](), notTaken [[no0]]()
# CHECK: [[yes0]]() frequency=Rare:
# CHECK-NEXT: Jump -> {{*}}[[body0]]()
# CHECK: [[no0]]() frequency=Rare:
# CHECK-NEXT: Jump -> {{*}}[[gaveUp0]]()

# CHECK: function {{*}}creator=Serializer{layout=L1}
# CHECK: boolean = JSONHasStackSpace
# CHECK-NOT: failsAtWatchedLevels
# CHECK-NOT: JSONEnterWatchedLevel

# CHECK: function {{*}}creator=Serializer{layout=L2}
# CHECK: boolean = JSONHasStackSpace
# CHECK-NOT: failsAtWatchedLevels
# CHECK-NOT: JSONEnterWatchedLevel
