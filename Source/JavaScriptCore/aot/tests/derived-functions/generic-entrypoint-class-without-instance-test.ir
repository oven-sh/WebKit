# What flow narrowed to a class without an instance test: no test finds the instances, and a Claim of the class would throw for every value, so the entrypoint tests for an object and takes the rest from flow. A class with an instance test is what the Claim names
# FORM: Prepared
# RUN: derived-functions GenericEntrypoint:f0
# OPTIONS: check=VerifyEachPass

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point"
function f0 name="narrowed" flags=[HasThis] thisType={type=Object written=anything} parameters=[{type=TypeError written=anything}, {type=undefined|Arguments written=anything}, {type=Function written=anything}, {type=L0|Object written=anything}, {type=Error written=anything}, {type=undefined|Map written=anything}] results=[{type=undefined}] {
  b0(v0: Object, v1: TypeError, v2: undefined|Arguments, v3: Function, v4: L0|Object, v5: Error, v6: undefined|Map):
    Return
}
# CHECK: name="narrowed" module=m0 role=GenericEntrypoint
# CHECK-NEXT: b0([[closure]]: f0, [[this]]: anything, [[error]]: anything, [[arguments]]: anything, [[function]]: anything, [[point]]: anything, [[testable]]: anything, [[map]]: anything):
# CHECK-NEXT: [[thisObject]]: object = Claim [[this]] castType=object cause=AddedByPass
# CHECK-NEXT: [[thisProven]]: Object = AssumeType [[thisObject]] castType=Object
# CHECK-NEXT: [[errorObject]]: object = Claim [[error]] castType=object cause=AddedByPass
# CHECK-NEXT: [[errorProven]]: TypeError = AssumeType [[errorObject]] castType=TypeError
# CHECK-NEXT: [[argumentsObject]]: undefined|object = Claim [[arguments]] castType=undefined|object cause=AddedByPass
# CHECK-NEXT: [[argumentsProven]]: undefined|Arguments = AssumeType [[argumentsObject]] castType=undefined|Arguments
# CHECK-NEXT: [[functionObject]]: object = Claim [[function]] castType=object cause=AddedByPass
# CHECK-NEXT: [[functionProven]]: Function = AssumeType [[functionObject]] castType=Function
# CHECK-NEXT: [[pointObject]]: object = Claim [[point]] castType=object cause=AddedByPass
# CHECK-NEXT: [[pointProven]]: L0|Object = AssumeType [[pointObject]] castType=L0|Object
# CHECK-NEXT: [[tested]]: Error = Claim [[testable]] castType=Error cause=AddedByPass
# CHECK-NEXT: [[testedMap]]: undefined|Map = Claim [[map]] castType=undefined|Map cause=AddedByPass
# CHECK-NEXT: = CallDirect [[thisProven]], [[errorProven]], [[argumentsProven]], [[functionProven]], [[pointProven]], [[tested]], [[testedMap]] function=f0
