# The source does not say what Derived extends: the base is a value. Flow finds that it is Base whatever happens, so Derived is below Base although the declared family of Base does not list it.
# The version of Base that takes the allocated object admits Derived, and the version of Derived hands its object on. It was `never` there, and everything behind super(..) was cut.
# FORM: Prepared
# RUN: derived-functions AllocatedThisVersion:f2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Base" module=m0 constructor=f1 fields=[{key="title" declared={type=anything} flags=[IsRequired]}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L1 kind=Instance name="Derived" module=m0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}

function f0 name="main" results=[{type=undefined}] {
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="title"
    Return v3
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1 callees=[f1]
    Return v4
}

# CHECK: function [[baseVersion]] name="Base" module=m0 kind=BaseConstructor role=AllocatedThisVersion {{*}}thisType={type=L0|L1}
# CHECK-NOT: NewObject
# CHECK: function [[derivedVersion]] name="Derived" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NEXT: b0([[this]]:{{*}}, [[callee]]: function, [[newTarget]]: anything, [[title]]: anything):
# CHECK-NOT: never
# CHECK-NOT: SuperConstruct
# CHECK: = CallDirect [[this]], [[newTarget]], [[title]] function=[[baseVersion]] [isConstruction]
