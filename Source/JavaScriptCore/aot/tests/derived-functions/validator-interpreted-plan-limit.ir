# The nodes of a validation list from the limit on are interpreted and the nodes below it stay compiled, in the validator that a parser asks for.
# The interpreter builds ordinary objects, which are in no family of layouts, so the field that takes its copy is an `object`
# FORM: Prepared optimizing
# OPTIONS: limit=MaxParserPlanNodes:2
# RUN: derived-functions Validator:x0.0
# STATISTIC: ValidatorsCreated = 1

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=L0 layouts=[L0, L1] validation=[{shape=Object{layout=L0 members=[{key="a" node=1 field=0}, {key="b" node=2 field=1}]} type=L0}, {shape=Primitive{primitive=Number} type=number}, {shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}]
expectedresult x1 type=L1 layouts=[L1] validation=[{shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Outer" fields=[{key="a" declared={type=number}}, {key="b" declared={type=object}}]
layout L1 name="Inner" fields=[{key="x" declared={type=number}}]

# CHECK: function {{*}}role=Validator {{*}}creator=Validator{type=L0 layout=L0 expectedResult=x0}
# CHECK: [[a]]: anything = GetOwnDataProperty {{*}} key="a"
# CHECK-NEXT: [[b]]: anything = GetOwnDataProperty {{*}} key="b"
# CHECK-NEXT: = TypeTest [[a]] testedType=number
# CHECK: [[plan]]:{{*}}= String string="[{\"shape\":\"Object\",\"members\":[{\"key\":\"x\",\"node\":1,\"isOptional\":false,\"mustBeOwn\":false}],\"undeclared\":\"Allowed\"},{\"shape\":\"Primitive\",\"primitive\":\"number\"}]"
# CHECK-NEXT: [[preparedAt1]]: anything = GetPreparedPlans
# CHECK-NEXT: [[pair]]: anything = CallBuiltin -, [[b]], [[plan]], [[preparedAt1]] overload=CompilerHelpersInterpretNode/0
# CHECK: = CloneAs {{*}} layout=L0 fields=[1]
# CHECK-NOT: role=Validator
