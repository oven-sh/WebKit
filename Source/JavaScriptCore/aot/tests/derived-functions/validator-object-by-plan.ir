# What holds for every object of one Structure is asked once: whether it is plain data with declared keys alone and no required member missing, where its members lie, and the order of its keys. The members are then loaded from their places, validated, and the copy is allocated as a parser allocates it. Every other input goes the way that reads member by member.
# FORM: Prepared optimizing
# RUN: derived-functions Validator:x0.0 Validator:x1.0 Validator:x2.0
# STATISTIC: ValidatorsCreated = 3

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=L0 layouts=[L0] validation=[{shape=Object{layout=L0 members=[{key="x" node=1 field=0}, {key="label" node=2 field=1 isOptional=true}] undeclared=Rejected} type=L0}, {shape=Primitive{primitive=Number} type=number}, {shape=Primitive{} type=string}]
expectedresult x1 type=L1 layouts=[L1] validation=[{shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}, {type=anything}]
expectedresult x2 type=L2 layouts=[L2] validation=[{shape=Object{layout=L2 members=[{key="x" node=1 field=0}, {key="7" node=1}]} type=L2}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Point" fields=[{key="x" declared={type=number}}, {key="label" declared={type=undefined|string}}]
layout L1 name="OwnMember" fields=[{key="x" declared={type=anything}}]
layout L2 name="IndexedMember" fields=[{key="x" declared={type=number}}]

# CHECK: function {{*}}creator=Validator{type=L0 layout=L0 expectedResult=x0}
# CHECK: ([[object]]: object):
# CHECK-NEXT: [[found]]: undefined = FindSourcePlan [[object]] layout=L0 fields=[0, 1]
# CHECK-NEXT: [[isUsable]]: boolean = ResultAt [[found]]
# CHECK-NEXT: Branch [[isUsable]] -> taken [[byPlan]](), notTaken [[noPlan]]()
# CHECK: [[memberByMember]]() frequency=Rare:
# CHECK-NEXT: = IsPlainDataObject [[object]]
# CHECK: [[byPlan]]():
# CHECK-NEXT: [[plan]]: sourceplan = ResultAt [[found]] index=1
# CHECK-NEXT: [[order]]: keyorder = ResultAt [[found]] index=2
# CHECK-NEXT: [[first]]: undefined = GetPlannedProperty [[object]], [[plan]] @
# CHECK-NEXT: [[x]]: anything = ResultAt [[first]] @
# CHECK-NEXT: = ResultAt [[first]] index=1
# CHECK-NEXT: [[second]]: undefined = GetPlannedProperty [[object]], [[plan]] memberIndex=1
# CHECK-NEXT: [[label]]: anything = ResultAt [[second]] @
# CHECK-NEXT: [[hasLabel]]: boolean = ResultAt [[second]] index=1
# CHECK-NEXT: = TypeTest [[x]] testedType=number
# CHECK: [[noPlan]]() frequency=Rare:
# CHECK-NEXT: Jump -> next [[memberByMember]]()
# CHECK: Branch [[hasLabel]] -> taken [[labelIsThere]](), notTaken
# CHECK: ([[validatedLabel]]: undefined|string):
# CHECK-NEXT: [[copy]]: L0 = NewObject -, {{*}} layout=L0 fields=[0]
# CHECK-NEXT: Branch [[hasLabel]] -> taken [[storesLabel]](), notTaken
# CHECK: [[labelIsThere]]():
# CHECK-NEXT: [[labelIsUndefined]]: boolean = TypeTest [[label]] testedType=undefined
# CHECK-NEXT: Branch [[labelIsUndefined]] -> taken [[holdsUndefined]](| 0), notTaken
# CHECK: [[holdsUndefined]]({{*}}: undefined) frequency=Rare:
# CHECK-NEXT: Jump -> next [[memberByMember]]()
# CHECK: [[storesLabel]]():
# CHECK-NEXT: PutSlot [[copy]], [[copy]], [[validatedLabel]] key="label"
# CHECK: = JSONObjectFinish [[order]], [[copy]], {{*}} layout=L0
# CHECK: overload=ObjectKeys/0
# CHECK: = GetOwnDataProperty [[object]], {{*}} key="x"
# CHECK: = CloneAs [[object]],

# CHECK: function {{*}}creator=Validator{type=L1 layout=L1 expectedResult=x1}
# CHECK-NOT: FindSourcePlan
# CHECK: = CloneAs

# CHECK: function {{*}}creator=Validator{type=L2 layout=L2 expectedResult=x2}
# CHECK-NOT: FindSourcePlan
# CHECK: = CloneAs
