# function down(n, next): number { return n === 0 ? 0.5 : next(n - 1, next) }   sink(down)   down(input, input)
# Nobody knows `next`, so flow cannot prove the written result and the tail call lies on a cycle through code nobody sees: the callers of `down` test its result. The generic entrypoint is such a caller,
# and any call by value enters it, a tail call too. A frame that stayed behind for the test would then be a frame per call of the chain. So the entrypoint asks whether the frame it returns to already
# waits to test a result: then it returns with a tail call that has to reuse the frame, else it calls, tests and returns
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=AnalyzeFlow
# CHECK-LABEL: function f1 name="down"
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f2 name="untyped"
# CHECK: name="down"{{*}}role=GenericEntrypoint
# CHECK: [[isTested]]: boolean {{*}}= ReturnsToResultTest
# CHECK-NEXT: TestAndBranch [[isTested]] -> taken [[goesOn]](), notTaken [[waits]]()
# CHECK: [[goesOn]]():
# CHECK-NEXT: [[passedOn]]: {{*}} = CallDirect {{*}} resultCheck=ByCallers
# CHECK-NEXT: ReturnCall [[passedOn]]
# CHECK-NOT: requirement=Allowed
# CHECK: [[waits]]():
# CHECK-NEXT: [[untested]]: {{*}} = CallDirect {{*}} resultCheck=ByCallers
# CHECK-NEXT: [[tested]]: {{*}} = Claim [[untested]] castType=undefined|null|number site=w0
# CHECK-NEXT: Return [[tested]]
# An entrypoint that has nothing to test asks nothing
# CHECK: name="untyped"{{*}}role=GenericEntrypoint
# CHECK-NOT: ReturnsToResultTest
# CHECK: ReturnCall {{*}} requirement=Allowed

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="sink" [isFreeName]
    v3 = NewClosure function=f1
    v4 = Call v2, -, v3
    v5 = Call v3, -, v1, v1
    v6 = NewClosure function=f2
    v7 = Call v2, -, v6
    Return
}
function f1 name="down" flags=[IsChecked] parameters=[{type=anything}, {type=anything}] results=[{type=undefined|null|number site=w0}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Double number=0.5
    Return v4
  b2():
    v5 = Integer integer=1
    v6 = Sub v0, v5
    v7 = Call v1, -, v6, v1
    ReturnCall v7 casts=[{declared={type=undefined|null|number site=w0}}]
}
function f2 name="untyped" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v1, -, v0, v1
    ReturnCall v2
}
