# function down(n, next): number { return n === 0 ? 0.5 : next(n - 1, next) }   sink(down)   down(input, input)
# Nobody knows `next`, so nothing proves that `down` returns a number. A test behind the call of `next` would end the tail call, and a frame that stayed behind for the test would be a frame per call of the chain.
# So nobody tests the result where it is returned: the type of the result is only expected, `down` keeps its tail call, and whoever reads the result as a number tests it there.
# The generic entrypoint reads it as nothing: it hands the result on with a tail call, like the entrypoint of a function without types
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=AnalyzeFlow
# CHECK-LABEL: function f1 name="down"
# CHECK: results=[{type=undefined|null|number site=w0 flags=[IsExpected]}]
# CHECK-NOT: = Check
# CHECK-NOT: = TypeTest
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f2 name="untyped"
# CHECK: name="down"{{*}}role=GenericEntrypoint
# CHECK-NOT: = Check
# CHECK-NOT: = TypeTest
# CHECK: [[passedOn]]:{{*}}= CallDirect {{*}}function=f1
# CHECK-NEXT: ReturnCall [[passedOn]] requirement=Allowed
# CHECK: name="untyped"{{*}}role=GenericEntrypoint
# CHECK: ReturnCall {{*}} requirement=Allowed

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="sink" [isFreeName]
    v3 = NewClosure function=f1
    v4 = Call v2, -, v3
    v5 = Call v3, -, v1, v1
    v6 = NewClosure function=f2
    v7 = Call v2, -, v6
    Return
}
function f1 name="down" flags=[IsChecked] parameters=[{type=anything}, {type=anything}] results=[{type=undefined|null|number site=w0}] {
    v2 = Integer
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Double number=0.5
    Return v4
  b2():
    v5 = Integer integer=1
    v6 = Sub v0, v5
    v7 = Call v1, -, v6, v1
    ReturnCall v7 casts=[{declared={type=undefined|null|number site=w0}}]
}
function f2 name="untyped" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Call v1, -, v0, v1
    ReturnCall v2
}
