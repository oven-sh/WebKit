# The parser of an IR type allocates the head layouts the type names, absorbs a member or element of another kind as a plain value, and gives up only where the field or the array cannot hold it:
# an object of the generic parser has no layout, so it is no element of an array of a layout
# FORM: Prepared
# RUN: derived-functions Parser:g0 Parser:g1 Parser:g2 Parser:g3 ValidatingParser:x0.0
# STATISTIC: ParsersCreated = 7
# STATISTIC: ValidatorsCreated = 0

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=L3 layouts=[L3] validation=[{shape=Object{layout=L3 members=[{key="items" node=1 field=0}, {key="n" node=2 field=1}]} type=L3}, {type=anything}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="User" fields=[{key="id" declared={type=number}}, {key="name" declared={type=undefined|string}}]
layout L1 name="UserLiteral" fields=[{key="id" declared={type=number}}, {key="name" declared={type=undefined|string}}] supertypes=[L0]
layout L2 name="Int32Field" fields=[{key="count" declared={type=i32}}]
layout L3 name="ArrayFieldWithProofs" fields=[{key="items" declared={type=Array<number, pristine[Storage, Names]>}}, {key="n" declared={type=number}}]
variable g0 name="t0" declared={type=undefined|null|L0|L1} initialization=Undefined
variable g1 name="t1" declared={type=Array<L0>} initialization=Undefined
variable g2 name="t2" declared={type=L2} initialization=Undefined
variable g3 name="t3" declared={type=L3} initialization=Undefined

