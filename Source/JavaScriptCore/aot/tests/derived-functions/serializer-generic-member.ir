# A member of which nothing is known is written by kind of value. Only the arm that the host writes may run user code: it renews the guards, or the remaining keys go to a helper, and the other arms keep the guards they have
# FORM: Prepared
# RUN: derived-functions Serializer:L0 Serializer:L1 Serializer:L2
# STATISTIC: SerializersCreated = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="GenericInTheMiddle" fields=[{key="a" declared={type=number}}, {key="any" declared={type=anything}}, {key="z" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2]}]}
layout L1 name="GenericLast" fields=[{key="a" declared={type=number}}, {key="any" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1]}]}
layout L2 name="OnlyRequired" fields=[{key="a" declared={type=number}}, {key="b" declared={type=string}}] flow={constructorOrders=[{fields=[0, 1]}]}

# CHECK: function {{*}}creator=Serializer{layout=L0}
# CHECK: [[one0]]: 1 = Integer integer=1
# CHECK-NEXT: Return [[one0]]
# CHECK: [[guard]]: guard = AllGuards
# CHECK: = JSONAppendKey v1, {{*}} string="a" [opensObject]
# CHECK-NEXT: [[afterA]]: buildercursor = JSONAppendNumber v1,
# CHECK-NEXT: [[any]]: anything = GetSlot v0, [[guard]] key="any" receivers=[L0] level=Predicted
# CHECK-NEXT: [[comma]]: buildercursor = JSONAppendToken v1, [[afterA]] jsonToken=Comma
# CHECK-NEXT: [[hasText]]: boolean = TypeTest [[any]] testedType=null|boolean|number|string
# CHECK-NEXT: Branch [[hasText]] -> taken [[primitive]](| 0), notTaken [[other]](| 0)
# CHECK: [[primitive]]([[narrowed]]: null|boolean|number|string):
# CHECK-NEXT: [[key]]: buildercursor = JSONAppendKey v1, [[comma]] string="any" @
# CHECK-NEXT: [[appended]]:{{*}}= JSONAppendValue v1, [[key]], [[narrowed]] jsonPosition=Element
# CHECK-NEXT: [[valueWritten]]: buildercursor = ResultAt [[appended]] index=1
# CHECK-NEXT: [[valueComma]]: buildercursor = JSONAppendToken v1, [[valueWritten]] jsonToken=Comma
# CHECK-NEXT: Jump -> next [[afterAny]]([[valueComma]])
# CHECK: [[other]]([[withoutText]]:{{*}})
# CHECK-NEXT: [[isUndefined]]: boolean = TypeTest [[withoutText]] testedType=undefined
# CHECK-NEXT: Branch [[isUndefined]] -> taken [[leftOut]](| 0), notTaken [[byHost]](| 0)
# CHECK: [[afterAny]]([[cursorAfterAny]]: buildercursor):
# CHECK-NEXT: Jump -> next [[memberZ]]([[cursorAfterAny]], [[guard]])
# CHECK: [[leftOut]]({{*}}: undefined)
# CHECK-NEXT: Jump -> next [[afterAny]]([[comma]])
# CHECK: [[byHost]]([[cell]]:{{*}}) frequency=Rare:
# CHECK-NEXT: StringBuilderCommit v1, [[comma]]
# CHECK-NEXT: [[beforeKey]]:{{*}}= StringBuilderCheckpoint v1
# CHECK-NEXT: [[roomForKey]]: buildercursor = StringBuilderReserve v1
# CHECK-NEXT: [[hostKey]]: buildercursor = JSONAppendKey v1, [[roomForKey]] string="any" @
# CHECK-NEXT: [[keyText]]: "any" = String string="any"
# CHECK-NEXT: StringBuilderCommit v1, [[hostKey]]
# CHECK-NEXT: [[hasHostText]]: boolean = StringBuilderAppendJSON v1, [[cell]], [[keyText]]
# CHECK-NEXT: Branch [[hasHostText]] -> taken [[written]](), notTaken [[omitted]]()
# CHECK: [[written]]() frequency=Rare:
# CHECK-NEXT: [[afterText]]: buildercursor = StringBuilderReserve v1
# CHECK-NEXT: = JSONAppendToken v1, [[afterText]] jsonToken=Comma
# CHECK: [[omitted]]() frequency=Rare:
# CHECK-NEXT: StringBuilderRollBack v1, [[beforeKey]]
# CHECK: StringBuilderCommit v1,
# CHECK-NEXT: [[shapeAgain]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[shapeAgain]] -> taken [[orderAgainBlock]](| 0), notTaken [[shapeIsStale]]()
# CHECK: [[memberZ]]([[cursorAtZ]]: buildercursor, [[guardAtZ]]: guard):
# CHECK-NEXT: [[z]]: number = GetSlot v0, [[guardAtZ]] key="z" receivers=[L0] level=Predicted
# CHECK-NEXT: [[zKey]]: buildercursor = JSONAppendKey v1, [[cursorAtZ]] string="z" @
# CHECK-NEXT: [[zWritten]]: buildercursor = JSONAppendNumber v1, [[zKey]], [[z]]
# CHECK-NEXT: [[zComma]]: buildercursor = JSONAppendToken v1, [[zWritten]] jsonToken=Comma
# CHECK-NEXT: [[closed]]: buildercursor = JSONAppendToken v1, [[zComma]] jsonToken=CloseObjectOverComma
# CHECK-NEXT: StringBuilderCommit v1, [[closed]]
# CHECK-NEXT: Jump -> next [[parsed0]]()
# CHECK: [[stale]]() frequency=Rare:
# CHECK-NEXT: [[nextMember]]: 2 = Integer integer=2
# CHECK-NEXT: Jump -> next [[remainder]]([[nextMember]])
# CHECK: [[orderAgainBlock]]([[shapeGuardAgain]]: guard) frequency=Rare:
# CHECK-NEXT: = HasKeyOrder v0, [[shapeGuardAgain]] layout=L0 fields=[0, 1, 2]
# CHECK: [[shapeIsStale]]() frequency=Rare:
# CHECK-NEXT: Jump -> next [[stale]]()
# CHECK: = HasNoExtraProperties v0, [[shapeGuardAgain]]
# CHECK: [[renewed]]: guard = AllGuards [[shapeGuardAgain]],
# CHECK-NEXT: [[roomAfterRenewal]]: buildercursor = StringBuilderReserve v1
# CHECK-NEXT: Jump -> next [[memberZ]]([[roomAfterRenewal]], [[renewed]])
# CHECK: [[remainder]]([[from]]: i32) frequency=Rare:
# CHECK-NEXT: [[k0]]: "a" = String string="a"
# CHECK-NEXT: [[k1]]: "any" = String string="any"
# CHECK-NEXT: [[k2]]: "z" = String string="z"
# CHECK-NEXT: [[keys]]: Array<string> = NewArray [[k0]], [[k1]], [[k2]] contents=string
# CHECK-NEXT: [[isFirst]]: true = Boolean boolean=true
# CHECK-NEXT: [[rest]]: string = CallBuiltin -, v0, [[keys]], [[from]], [[isFirst]] overload=CompilerHelpersStringifyProperties/0
# CHECK-NEXT: [[restLength]]:{{*}}= GetStringLength [[rest]]
# CHECK: = JSONAppendToken v1, {{*}} jsonToken=CloseObjectOverComma
# CHECK: Jump -> next [[parsed0]]()
# CHECK: StringBuilderAppend v1, [[rest]]
# CHECK-NEXT: [[brace]]: "}" = String string="}"
# CHECK-NEXT: StringBuilderAppend v1, [[brace]]
# CHECK-NEXT: Jump -> next [[parsed0]]()

# CHECK: function {{*}}creator=Serializer{layout=L1}
# CHECK: = ShapeTest v0 layouts=[L1]
# CHECK: = HasKeyOrder v0, {{*}} layout=L1 fields=[0, 1]
# CHECK: = HasNoExtraProperties v0,
# CHECK-NOT: ShapeTest
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: HasNoExtraProperties
# CHECK-NOT: CompilerHelpersStringifyProperties
# CHECK: = JSONAppendValue v1, {{*}} jsonPosition=Element
# CHECK-NOT: ShapeTest
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: HasNoExtraProperties
# CHECK-NOT: CompilerHelpersStringifyProperties
# CHECK: = StringBuilderAppendJSON v1,
# CHECK-NOT: ShapeTest
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: HasNoExtraProperties
# CHECK-NOT: CompilerHelpersStringifyProperties
# CHECK: = JSONAppendToken v1, {{*}} jsonToken=CloseObjectOverComma
# CHECK-NOT: ShapeTest
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: HasNoExtraProperties
# CHECK-NOT: CompilerHelpersStringifyProperties

# CHECK: function {{*}}creator=Serializer{layout=L2}
# CHECK-NOT: JSONAppendToken
# CHECK: = JSONAppendKey v1, {{*}} string="a" [opensObject]
# CHECK-NOT: JSONAppendToken
# CHECK: = JSONAppendKey v1, {{*}} string="b" [followsMember]
# CHECK-NEXT: [[bWritten]]: buildercursor = JSONAppendString v1,
# CHECK-NEXT: = JSONAppendToken v1, [[bWritten]] jsonToken=CloseObject @
# CHECK-NOT: JSONAppendToken
# CHECK-NOT: NewArray
# CHECK-NOT: CallBuiltin
