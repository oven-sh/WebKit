# A parameter that flow narrowed to a built-in of a module: no test finds that object, so the entrypoint tests for an object or a function and takes the rest from flow. A built-in of the realm is one cell, which the Claim names
# FORM: Prepared
# RUN: derived-functions GenericEntrypoint:f0
# OPTIONS: check=VerifyEachPass

module m0 path="main.js" displayPath="main.js"
function f0 name="narrowed" flags=[HasThis] thisType={type=builtin(ModuleObjectExports) written=anything} parameters=[{type=builtin(ModuleRequire) written=anything}, {type=builtin(ModuleObject) written=anything}, {type=undefined|builtin(ImportMeta) written=anything}, {type=builtin(GlobalThis) written=anything}, {type=string written=anything}] results=[{type=anything}] {
  b0(v0: builtin(ModuleObjectExports), v1: builtin(ModuleRequire), v2: builtin(ModuleObject), v3: undefined|builtin(ImportMeta), v4: builtin(GlobalThis), v5: string):
    Return
}
# CHECK: name="narrowed" module=m0 role=GenericEntrypoint
# CHECK-NEXT: b0([[closure]]: f0, [[this]]: anything, [[require]]: anything, [[module]]: anything, [[meta]]: anything, [[global]]: anything, [[text]]: anything):
# CHECK-NEXT: [[thisObject]]: object = Claim [[this]] castType=object cause=AddedByPass
# CHECK-NEXT: [[thisProven]]: builtin(ModuleObjectExports) = AssumeType [[thisObject]] castType=builtin(ModuleObjectExports)
# CHECK-NEXT: [[requireFunction]]: function = Claim [[require]] castType=function cause=AddedByPass
# CHECK-NEXT: [[requireProven]]: builtin(ModuleRequire) = AssumeType [[requireFunction]] castType=builtin(ModuleRequire)
# CHECK-NEXT: [[moduleObject]]: object = Claim [[module]] castType=object cause=AddedByPass
# CHECK-NEXT: [[moduleProven]]: builtin(ModuleObject) = AssumeType [[moduleObject]] castType=builtin(ModuleObject)
# CHECK-NEXT: [[metaObject]]: undefined|object = Claim [[meta]] castType=undefined|object cause=AddedByPass
# CHECK-NEXT: [[metaProven]]: undefined|builtin(ImportMeta) = AssumeType [[metaObject]] castType=undefined|builtin(ImportMeta)
# CHECK-NEXT: [[globalCell]]: builtin(GlobalThis) = Claim [[global]] castType=builtin(GlobalThis) cause=AddedByPass
# CHECK-NEXT: [[string]]: string = Claim [[text]] castType=string cause=AddedByPass
# CHECK-NEXT: = CallDirect [[thisProven]], [[requireProven]], [[moduleProven]], [[metaProven]], [[globalCell]], [[string]] function=f0
