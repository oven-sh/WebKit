# Flow has not proven what Expected extends: unseen code holds the class. The source names Shape, and the run time clears the guard of the static link where the class is defined with another parent
# or gets one later. So the version that takes the allocated object calls Shape's version behind the test of that link, although staticLink is Fixed, and starts over where the test fails.
# Nameless extends a value of which the source says nothing: its super call stays.
# FORM: Prepared
# RUN: derived-functions AllocatedThisVersion:f2 AllocatedThisVersion:f3

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Shape" module=m0 constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L1 kind=Instance name="Expected" module=m0 base=L0 constructor=f2 supertypes=[L0] flags=[HasHeritage] classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L2 kind=Instance name="Nameless" module=m0 constructor=f3 flags=[HasHeritage] classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}

function f0 name="main" results=[{type=undefined}] {
    Return
}
function f1 name="Shape" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="Expected" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1
    Return v4
}
function f3 name="Nameless" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L2 {
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L2
    Return v4
}

# CHECK: function [[shapeVersion]] name="Shape" module=m0 kind=BaseConstructor role=AllocatedThisVersion
# CHECK-NOT: NewObject
# CHECK: function [[expectedVersion]] name="Expected" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NEXT: b0([[this]]:{{*}}, [[callee]]: function, [[newTarget]]: anything, [[x]]: anything):
# CHECK-NEXT: = GetSuperBase [[callee]]
# CHECK-NEXT: [[unchanged]]: boolean = AreMembersUnchanged conditions=[{kind=PrototypeLinkUnchanged layout=L1 side=Static}]
# CHECK-NEXT: Branch [[unchanged]] -> taken [[direct]](| 0), notTaken [[startsOver]]()
# CHECK: [[direct]]([[guard]]: guard):
# CHECK-NOT: SuperConstruct
# CHECK: = CallDirect [[this]], [[newTarget]], [[x]] function=[[shapeVersion]] [isConstruction]
# CHECK-NOT: SuperConstruct
# CHECK: [[startsOver]]() frequency=Rare:
# CHECK-NEXT: [[constructed]]:{{*}}= CallDirect [[callee]], [[newTarget]], [[x]] function=f2 [isConstruction]
# CHECK-NEXT: ReturnCall [[constructed]] requirement=Allowed
# CHECK: function [[namelessVersion]] name="Nameless" module=m0 kind=DerivedConstructor role=AllocatedThisVersion
# CHECK-NOT: CallDirect
# CHECK: = SuperConstruct {{*}}layout=L2
