# From the program as read: unknown code can call a bound function, so it declares the types as written and calls the generic version of its target
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=PlaceTypeTests,ResolveCalls,ChooseCallingConventions
# STATISTIC: FlowGenericVersions = 1
# STATISTIC: BoundFunctions = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    v3 = Undefined
    v4 = PropGet v0 key="bind"
    v5 = Call v4, v0, v3 calleeKey="bind"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="register" [isFreeName]
    v8 = Call v7, -, v5
    v9 = CallDirect function=f2
    Return
}
# CHECK-LABEL: function f1 name="versioned"
# CHECK: parameters=[{type=fractional written=anything}]
function f1 name="versioned" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Mul v0, v0
    v2 = Add v1, v0
    Return v2
}
function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    Return
}
# CHECK: function [[generic]] name="versioned"{{*}}role=GenericVersion{{*}}parameters=[{type=anything predicted=fractional}]
# CHECK: name="versioned"{{*}}role=BoundFunction captures=[{type=function}] thisType={type=anything} parameters=[{type=anything predicted=fractional}] results=[{type=anything}]
# CHECK: = CallDirect {{*}} function=[[generic]]
