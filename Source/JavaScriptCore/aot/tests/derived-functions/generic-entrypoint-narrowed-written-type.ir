# A written parameter that flow narrowed meets two tests: the type the source wrote, at the site, so that the message names it, then what flow narrowed it to. Untyped code has the second alone, and a position flow left alone has the first alone
# FORM: Prepared
# RUN: derived-functions GenericEntrypoint:f0
# OPTIONS: check=VerifyEachPass

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Point"
typesite w0 module=m0 position=17 kind=Parameter
typesite w1 module=m0 position=28 kind=Parameter
typesite w2 module=m0 position=39 kind=Parameter
function f0 name="narrowed" position=1 parameters=[{type=int written=undefined|null|number site=w0}, {type=int written=anything}, {type=undefined|null|number site=w1}, {type=undefined|null|object written=undefined|null|L0 site=w2}] results=[{type=anything}] {
  b0(v0: int, v1: int, v2: undefined|null|number, v3: undefined|null|object ? undefined|null|L0):
    Return
}
# CHECK: name="narrowed" module=m0 position=1 role=GenericEntrypoint
# CHECK: b0([[closure]]: f0, [[this]]: anything, [[typed]]: anything, [[untyped]]: anything, [[asRead]]: anything, [[point]]: anything):
# CHECK-NEXT: [[written]]: undefined|null|number = Claim [[typed]] castType=undefined|null|number site=w0 cause=UnknownObject @17
# CHECK-NEXT: [[proven]]: int = Claim [[written]] castType=int cause=AddedByPass @1
# CHECK-NEXT: [[untypedProven]]: int = Claim [[untyped]] castType=int cause=AddedByPass @1
# CHECK-NEXT: [[number]]: undefined|null|number = Claim [[asRead]] castType=undefined|null|number site=w1 cause=UnknownObject @28
# CHECK-NEXT: [[object]]: undefined|null|object{{*}} = Claim [[point]] castType=undefined|null|object site=w2 cause=UnknownObject @39
# CHECK-NEXT: = CallDirect [[proven]], [[untypedProven]], [[number]], [[object]] function=f0
