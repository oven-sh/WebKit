# The elements of an array member are written as what is predicted of its proven contents; without a prediction every object goes to the helper
# FORM: Prepared
# RUN: derived-functions Serializer:L0 Serializer:L1
# STATISTIC: SerializersCreated = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Predicted" fields=[{key="list" declared={type=Array<object ~ L2, proven>}}] flow={constructorOrders=[{fields=[0]}]}
layout L1 name="Unknown" fields=[{key="list" declared={type=Array<object, proven>}}] flow={constructorOrders=[{fields=[0]}]}
layout L2 name="Item" fields=[{key="x" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}

# CHECK: function {{*}}creator=Serializer{layout=L0}
# CHECK: = GetArrayElement {{*}} arrayStorage=Contiguous [keyIsIntegral]
# CHECK: = ShapeTest [[object]] layouts=[L2]
# CHECK: = CallDirect [[object]], v1 function=[[serializerOfItem]]
# CHECK: function {{*}}creator=Serializer{layout=L1}
# CHECK: = GetArrayElement {{*}} arrayStorage=Contiguous [keyIsIntegral]
# CHECK-NOT: ShapeTest
# CHECK-NOT: CallDirect
# CHECK: function [[serializerOfItem]] {{*}}creator=Serializer{layout=L2}
