# The host enters the generic entrypoint of the entry module's body once, like the body. A variable that only the module body's call tree writes survives a call of unknown code
# RUN: pipeline ReadCapturesFromEnvironments

module m0 path="main.js" displayPath="main.js" body=f1
entry module=m0
layout L0 name="Printed" fields=[{key="x" declared={type=number}}]
variable g0 name="counter" module=m0 declared={type=number} initialization=Undefined
function f0 name="increment" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=1
    v2 = Add v0, v1
    v3 = Convert v2 declared={type=number}
    PutModuleVariable v3 variable=g0
    Return
}
function f1 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer
    PutModuleVariable v0 variable=g0
    v2 = CallDirect function=f0 [isNeverInlined]
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = CallDirect v3 function=f2 [isNeverInlined]
    v5 = CallDirect v4 function=f3 [isNeverInlined]
    v6 = CallDirect function=f0 [isNeverInlined]
    v7 = CallDirect v3 function=f2 [isNeverInlined]
    v8 = CallDirect v7 function=f3 [isNeverInlined]
    Return
}
function f2 name="readsAroundPrint" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetModuleVariable variable=g0
    v2 = CallDirect v0 function=f3 [isNeverInlined]
    v3 = GetModuleVariable variable=g0
    v4 = Sub v3, v1
    Return v4
}
function f3 name="print" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = Call v2, -, v0 calleeName="print"
    Return
}
# CHECK-LABEL: function f2 name="readsAroundPrint"
# CHECK: = GetModuleVariable variable=g0
# CHECK: = CallDirect
# CHECK-NOT: = GetModuleVariable variable=g0
# CHECK: Return
