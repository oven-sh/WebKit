# declare const input: any;
# function make(n: number) { return { a: n, b: 2 }; }
# const o = make(input);
# (globalThis as any).answer = o.a;
# All of it runs once and gets no tests. A slot for a double would be filled by a store by name behind the allocation and read by name. The slot holds any value: the allocation lists what it is given, and the read goes to the slot.
# FORM: AsRead
# RUN: pipeline Select
# OPTIONS: check=VerifyEachPass
# STATISTIC: InitialValuesStoredBehindAllocations = 0
# CHECK: layout L0 {{*}}{key="a" declared={type=number flags=[IsExpected]} flags=[IsRequired] {{*}}occupancy=AlwaysFilled
# CHECK-LABEL: function f0 module=m0 kind=Module
# CHECK: [[made]]: L0 = CallDirect {{*}}function=f1
# CHECK-NOT: PropGet [[made]]
# CHECK: = GetSlot [[made]] key="a" receivers=[L0] level=Proven
# CHECK-LABEL: function f1 name="make"
# CHECK-NEXT: b0(v0: anything):
# CHECK-NOT: PropSet
# CHECK: = NewObject -, v0{{*}} layout=L0
# CHECK-NOT: PropSet
# CHECK: Return

typesite w0 module=m0 position=40 kind=Parameter function=f1
typesite w1 module=m0 position=26 kind=Result
typesite w2 module=m0 position=88 kind=CallResult
layout L0 module=m0 position=60 fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = Call v1, -, v4 calleeName="make"
    v6 = Convert v5 declared={type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="globalThis" [isFreeName]
    v9 = Convert v8 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v10 = Convert v9 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v11 = PropGet v6 key="a"
    PropSet v10, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="make" module=m0 position=26 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=number}
    v2 = Integer integer=2
    v3 = Convert v2 declared={type=number}
    v4 = NewObject -, v1, v3 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = Convert v5 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}
entry module=m0
