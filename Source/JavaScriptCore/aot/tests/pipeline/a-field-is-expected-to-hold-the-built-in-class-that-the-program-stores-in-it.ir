# `{ items: [] }` reaches code that nobody sees, which may store anything in `items`. The program stores arrays there and nothing else, so an array is expected.
# `mixed` is given an array and a string: nothing is expected of it. `{ items: record.items }` holds what the other field holds.
# FORM: AsRead
# RUN: pipeline ApplyFlowResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="items" declared={type=anything}}, {key="mixed" declared={type=anything}}]
layout L1 fields=[{key="items" declared={type=anything}}]
# CHECK: layout L0 {{*}}{key="items" declared={type=undefined|null|Array flags=[IsExpected]}{{*}}{key="mixed" declared={type=anything}
# CHECK: layout L1 {{*}}{key="items" declared={type=undefined|null|Array flags=[IsExpected]}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="items"
    PropDefine v1, v0 key="mixed"
    v4 = FinishObject v1
    v5 = String string="a"
    PropSet v4, v5 key="mixed" mode=Strict
    v7 = NewArray v5 contents=anything
    PropSet v4, v7 key="items" mode=Strict
    v9 = NewClosure function=f1
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="text" [isFreeName]
    v12 = Builtin builtin=Function
    v13 = Construct v12, -, v11
    v14 = Call v13, -, v4, v9
    Return v14
}
function f1 name="copy" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="items"
    v2 = NewObject layout=L1
    PropDefine v2, v1 key="items"
    v4 = FinishObject v2
    Return v4
}
