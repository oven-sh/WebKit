# const kState = Symbol("state")  interface Holder { a: number; [kState]: number; z: number }
# function make(n): Holder { return { a: 1, [kState]: n, z: 3 } }  function read(h: Holder) { return h[kState] }  function write(h: Holder, n) { h[kState] = n }
# A field under a symbol that one call at the top of a module makes has a slot like a field under a name
# FORM: AsRead
# OPTIONS: validate
# RUN: run-in-shell globalThis.register = (make, read, write, k) => { const h = make(7); print(read(h), h[k], h.a, h.z); write(h, 9); print(read(h), h[k]); h[k] = 11; print(read(h)); print(Object.keys(h).join(), Object.getOwnPropertySymbols(h).length, Object.getOwnPropertySymbols(h)[0] === k, Reflect.ownKeys(h).map(String).join()); print(JSON.stringify(h), k in h, Object.hasOwn(h, k)); const d = Object.getOwnPropertyDescriptor(h, k); print(d.value, d.writable, d.enumerable, d.configurable); const copy = { ...h }; print(copy[k], Object.assign({}, h)[k]); print(delete h[k], k in h, read(h), Reflect.ownKeys(h).map(String).join()); write(h, 13); print(read(h), Reflect.ownKeys(h).map(String).join()); const other = make(1); Object.defineProperty(other, k, { get() { return 42; }, configurable: true }); print(read(other)); const text = make(2); text[k] = "text"; print(read(text)); };
# CHECK: 7 7 1 3
# CHECK-NEXT: 9 9
# CHECK-NEXT: 11
# CHECK-NEXT: a,z 1 true a,z,Symbol(state)
# CHECK-NEXT: {"a":1,"z":3} true true
# CHECK-NEXT: 11 true true true
# CHECK-NEXT: 11 11
# CHECK-NEXT: true false undefined a,z
# CHECK-NEXT: 13 a,z,Symbol(state)
# CHECK-NEXT: 42
# CHECK-NEXT: text
# CHECK-NEXT: exited with 0
# PROGRAM-OF: field-under-a-created-symbol-has-a-slot.ir
