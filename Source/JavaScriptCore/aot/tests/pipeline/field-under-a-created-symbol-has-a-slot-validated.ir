# const kState = Symbol("state")  interface Holder { a: number; [kState]: number; z: number }
# function make(n): Holder { return { a: 1, [kState]: n, z: 3 } }  function read(h: Holder) { return h[kState] }  function write(h: Holder, n) { h[kState] = n }
# A field under a symbol that one call at the top of a module makes has a slot like a field under a name
# FORM: AsRead
# OPTIONS: validate
# RUN: run-in-shell globalThis.register = (make, read, write, k) => { const h = make(7); print(read(h), h[k], h.a, h.z); write(h, 9); print(read(h), h[k]); h[k] = 11; print(read(h)); print(Object.keys(h).join(), Object.getOwnPropertySymbols(h).length, Object.getOwnPropertySymbols(h)[0] === k, Reflect.ownKeys(h).map(String).join()); print(JSON.stringify(h), k in h, Object.hasOwn(h, k)); const d = Object.getOwnPropertyDescriptor(h, k); print(d.value, d.writable, d.enumerable, d.configurable); const copy = { ...h }; print(copy[k], Object.assign({}, h)[k]); print(delete h[k], k in h, read(h), Reflect.ownKeys(h).map(String).join()); write(h, 13); print(read(h), Reflect.ownKeys(h).map(String).join()); const other = make(1); Object.defineProperty(other, k, { get() { return 42; }, configurable: true }); print(read(other)); const text = make(2); text[k] = "text"; print(read(text)); };
# CHECK: 7 7 1 3
# CHECK-NEXT: 9 9
# CHECK-NEXT: 11
# CHECK-NEXT: a,z 1 true a,z,Symbol(state)
# CHECK-NEXT: {"a":1,"z":3} true true
# CHECK-NEXT: 11 true true true
# CHECK-NEXT: 11 11
# CHECK-NEXT: true false undefined a,z
# CHECK-NEXT: 13 a,z,Symbol(state)
# CHECK-NEXT: 42
# CHECK-NEXT: text
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=200 kind=Parameter
typesite w1 module=m0 position=240 kind=Parameter
typesite w2 module=m0 position=280 kind=Parameter
typesite w3 module=m0 position=300 kind=Parameter
typesite w4 module=m0 position=340 kind=Parameter
layout L0 name="Holder" fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key=symbol("state")@m0:100 declared={type=number} flags=[IsRequired]}, {key="z" declared={type=number} flags=[IsRequired]}]
variable g0 name="kState" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Symbol
    v1 = String string="state"
    v2 = Call v0, -, v1 @100
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = NewClosure function=f3
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="register" [isFreeName]
    v9 = NewClosure function=f4
    v10 = Call v8, -, v4, v5, v6, v2, v9
    Return
}
function f1 name="make" flags=[IsChecked] parameters=[{type=number site=w0}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Integer integer=1
    v2 = Integer integer=3
    v3 = NewObject -, v1, v0, v2 layout=L0 fields=[0, 1, 2]
    v4 = FinishObject v3
    Return v4
}
function f2 name="read" flags=[IsChecked] parameters=[{type=L0 site=w1}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="kState"
    v3 = ElemGet v0, v2
    Return v3
}
function f3 name="write" flags=[IsChecked] parameters=[{type=L0 site=w2}, {type=number site=w3}] results=[{type=anything}] {
  b0(v0: L0, v1: number):
    v2 = GetModuleVariable variable=g0
    v3 = CheckInitialized v2 name="kState"
    ElemSet v0, v3, v1 mode=Strict
    Return
}
function f4 name="readName" flags=[IsChecked] parameters=[{type=L0 site=w4}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="z"
    Return v1
}
