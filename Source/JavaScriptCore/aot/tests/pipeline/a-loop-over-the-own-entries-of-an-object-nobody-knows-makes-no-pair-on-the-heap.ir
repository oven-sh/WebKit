    v8 = Call v6, v4, v7 calleeKey="parse" calleeName="JSON.parse"
    v9 = Convert v8 declared={type=undefined|null|Array<undefined|null|string|object> flags=[IsExpected]}
    v10 = Integer
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v11)
  b2(v12):
