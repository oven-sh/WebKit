    v18 = Mod v16, v17
    v19 = ElemGet v9, v18
    v20 = Convert v19 declared={type=undefined|null|string|object flags=[IsExpected]}
    v21 = Call v1, -, v3, v20 calleeName="applyAll"
    Jump -> next b5()
  b5():
