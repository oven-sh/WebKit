    v23 = Convert v22 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v23)
  b6(v24):
    Jump -> next b7()
  b7():
    v25 = Builtin builtin=GlobalThis
    v26 = PropGet v25 key="print" [isFreeName]
    v27 = PropGet v3 key="n"
    v28 = Convert v27 declared={type=number flags=[IsExpected]}
    v29 = Call v26, -, v28 calleeName="print"
    v30 = Undefined
    Return v30
}

function f1 name="apply" module=m0 flags=[HasExplicitName] length=3 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}, {type=undefined|null|string flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
