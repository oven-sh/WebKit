# function applyAll(node, props) { for (const [key, value] of Object.entries(props)) apply(node, key, value) }   props comes out of JSON.parse
# The loop alone has the list, so the run time is asked for the keys and values in one list. The pattern takes each pair apart again: none is made, and nothing walks one
# FORM: AsRead
# RUN: pipeline Select
# CHECK-LABEL: function f2 name="applyAll"
# CHECK-NOT: = NewArray
# CHECK: = CallBuiltin -, v1 overload=CompilerHelpersOwnEntriesFlat/0
# CHECK-NOT: = NewArray
# CHECK-LABEL: function f3
# RUN(GONE): pipeline Select
# GONE-LABEL: function f2 name="applyAll"
# GONE-NOT: ObjectEntries
# GONE-NOT: IteratorOpen
# GONE-NOT: IteratorResume
# GONE-NOT: DestructureIterable
# GONE-LABEL: function f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="n" declared={type=anything}}]
variable g0 name="apply" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
data d0 root=Object{layout=L0 members=[{key="n" value=Number{}}]} module=m0

