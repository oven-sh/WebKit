# class C { #m() { return 1 } n() { return this.#m() } static s(o) { return o.#m() } }: behind the read of the brand the call of the private method is resolved and inlined. On a proven instance nothing is left of the read; on a value nobody knows the read stays in front of the inlined body, because it is what throws
# RUN: pipeline Select
# CHECK-LABEL: function f3 name="n"
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: [[answer]]: 1 = Integer integer=1
# CHECK-NEXT: Return [[answer]]
# CHECK-LABEL: function f4 name="s"
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: [[token]]: classtoken = GetModuleVariable variable=g0
# CHECK-NEXT: : classtoken = PrivateGet v0, [[token]] layout=L0
# CHECK-NEXT: [[result]]: 1 = Integer integer=1
# CHECK-NEXT: Return [[result]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="C" module=m0 constructor=f1 fields=[{key=#"#"@L0 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}]
