    v8 = Integer integer=1
    v9 = Call v7, v5, v8 calleeKey=@"call" calleeName="call"
    v10 = PropGet v6 key=@"call"
    v11 = Integer integer=2
    v12 = Call v10, v6, v11 calleeKey=@"call" calleeName="call"
