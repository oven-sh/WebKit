# function f(): number { const list: string[] = []; const s = list[0]; list[0] = s + 0; let n = 1; (() => { n = 2; s })(); return n }  for (let i = 0; i < 1; i++) print(f())
# The sum that goes back into the list is no string, so the rest of f runs in the copy without types. The arrow function holds s, which rests on a check: its call in the copy names
