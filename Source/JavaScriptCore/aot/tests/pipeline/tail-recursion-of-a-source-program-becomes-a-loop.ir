# The front end writes every call of the program as a call of a value. A function whose last act is to call itself becomes a loop once ResolveCalls has named the callee
# FORM: AsRead
# RUN: pipeline EliminateTailRecursion
# STATISTIC: TailRecursionsEliminated = 1
# CHECK-LABEL: function f1 name="sum"
# CHECK: LoopHint
# CHECK-NOT: ReturnCall
# CHECK: function f2 name="library"

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="sum" module=m0 declared={type=f1} initialization=Function function=f1 flags=[IsImmutable]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=100000
    v2 = Integer
    v3 = Call v0, -, v1, v2
    Return v3
}
function f1 name="sum" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v4 = Integer integer=1
    v5 = Sub v0, v4
    v6 = Add v1, v0
    v7 = GetModuleVariable variable=g0
    v8 = Call v7, -, v5, v6
    ReturnCall v8
}
