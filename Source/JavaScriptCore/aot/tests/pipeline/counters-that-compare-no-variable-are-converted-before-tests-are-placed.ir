# `i-- > 0` and `++i < values.length`: what is compared is no variable, so the front end passes on nothing of what the comparison says. A round converts such a counter before it places its tests:
# a test for int32 on it would stay in the loop for good, since a list may be longer than that.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass disable=pass:InlineCalls
# RUN: pipeline EliminateGuards
# CHECK: name="down"
# CHECK-NOT: TypeTest {{*}} testedType=i32
# CHECK: name="up"
# CHECK-NOT: TypeTest {{*}} testedType=i32
# CHECK: data d0

