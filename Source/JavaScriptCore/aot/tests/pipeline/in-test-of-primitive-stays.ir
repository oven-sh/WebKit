# The `in` test of a value that cannot be an object always throws, so the optimize stage keeps it in front of Unreachable. The same test of a record that has no such name is folded
# RUN: pipeline PlanSlots

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="record" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f1
    v6 = NewClosure function=f2
    v7 = Call v1, -, v5, v6
    Return
}
function f1 name="testsPrimitive" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=object
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = GetModuleVariable variable=g0
    v4 = StrictEq v2, v3
    Return v4
  b2(v5) frequency=Unlikely:
    v6 = PropHas v5 key="missing"
    Unreachable
}
# Only its entrypoint enters each function, so the body is there
# CHECK-LABEL: name="testsPrimitive" module=m0 role=GenericEntrypoint
# CHECK: frequency=Rare:
# CHECK-NEXT: = PropHas {{*}}key="missing"
# CHECK-NEXT: Unreachable
function f2 name="testsRecord" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = PropHas v0 key="missing"
    Return v1
}
# CHECK-LABEL: name="testsRecord" module=m0 role=GenericEntrypoint
# CHECK-NOT: PropHas
# CHECK: false = Boolean
# CHECK-NOT: PropHas
# CHECK-LABEL: entry module=m0
