# function sum(x) { const list = [1.5, x]; let s = 0; for (let i = 0; i < list.length; i++) s += list[i]; return s }  report(sum())
# The second element is there, and it is undefined: the list has storage that holds any value. PlanArrayCapacities copies the reads of a loop for such storage only where the list is proven to hold nothing but numbers:
# the copy leaves into code that stands behind the test for Double storage, where a question such as `list[i] === undefined` may have been answered with nothing left of its read. So this list goes where the test fails.
# The list is kept for it: SinkAllocations would take it apart, and no loop would be left.
# FORM: AsRead
# OPTIONS: disable=pass:SinkAllocations
# RUN: run-in-shell globalThis.report = value => { print(String(value)); };
# CHECK: NaN
# CHECK-NEXT: exited with 0
# RUN(ARM): pipeline PlanArrayCapacities
# ARM-LABEL: function f1 name="sum"
# ARM: HasArrayStorage {{*}} arrayStorage=Double
# ARM-NOT: arrayStorage=Contiguous

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="report" [isFreeName]
    v3 = Call v0
    v4 = Call v2, -, v3
    Return
}
function f1 name="sum" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = NewArray v1, v0 contents=anything
    v3 = Integer
    v4 = Integer
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = PropGet v2 key="length"
    v9 = Less v6, v8
    Branch v9 -> taken b2(| 0), notTaken b3(| 0)
  b2(v10):
    v11 = ElemGet v2, v10
    v12 = Add v5, v11
    v13 = Increment v10
    Jump -> next b1(v12, v13)
  b3(v14):
    Return v5
}
