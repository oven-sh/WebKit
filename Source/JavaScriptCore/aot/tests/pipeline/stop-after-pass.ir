# The pipeline stops after the first run of the pass that is named
# RUN: pipeline ApplyFlowResults
# RUN(FOLD): pipeline FoldConstants
# RUN(SELECT): pipeline Select
# RUN(REPRESENT): pipeline ChooseRepresentations

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}

function f1 name="callsIdentity" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = Add v0, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = PropGet v4 key="x"
    v6 = CallDirect v5 function=f2
    v7 = Mul v6, v2
    v8 = Call v4, -, v7
    Return v8
}

function f2 name="identity" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK-LABEL: function f1 name="callsIdentity"
# CHECK: = Add
# CHECK: = CallDirect {{*}}function=f2
# CHECK: = Mul
# CHECK-NOT: form=
# CHECK-LABEL: function f2 name="identity"
