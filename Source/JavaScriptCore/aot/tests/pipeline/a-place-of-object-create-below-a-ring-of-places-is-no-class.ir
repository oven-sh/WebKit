# function one(below) { .. created.a = 1 .. }   function two(below) { .. created.b = 2 .. }   function three(below) { .. created.c = 3 .. }   and `oneCopy`, a second copy of `one`
# const first = one(null); const second = two(first); const again = one(second); const third = three(oneCopy(second)); first.late = 4; print(third.a, third.b, third.c, third.late)
# A copy of a function makes its objects at the place of the function, so `one` and `oneCopy` are one place with two objects. `two` is handed what `one` makes and `one` what `two` makes:
# a ring. `three` is handed what `oneCopy` makes, so its row of bases leads into the ring and `three` is not on it. None of the three places is a class.
# `three` has the highest layout number: the walk from it stops at a place that an earlier walk has refused.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# STATISTIC: CopyClosureFactoriesChanges = 0
# RUN: run-in-shell
# FLOW: layout L0 {{*}}IsOfCreatedObject
# FLOW-NOT: classFlow
# FLOW: layout L1 {{*}}IsOfCreatedObject
# FLOW-NOT: classFlow
# FLOW: layout L2 {{*}}IsOfCreatedObject
# FLOW-NOT: classFlow
# FLOW: function f0
# CHECK: 1 2 3 4
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Null
    v5 = Call v0, -, v4
    v6 = Call v1, -, v5
    v7 = Call v0, -, v6
    v8 = Call v2, -, v6
    v9 = Call v3, -, v8
    v10 = Integer integer=4
    PropSet v5, v10 key="late"
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="print" [isFreeName]
    v14 = PropGet v9 key="a"
    v15 = PropGet v9 key="b"
    v16 = PropGet v9 key="c"
    v17 = PropGet v9 key="late"
    v18 = Call v13, -, v14, v15, v16, v17
    Return
}
function f1 name="one" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, v1, v0 @50
    v4 = Integer integer=1
    PropSet v3, v4 key="a"
    Return v3
}
function f2 name="two" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, v1, v0 @150
    v4 = Integer integer=2
    PropSet v3, v4 key="b"
    Return v3
}
function f3 name="oneCopy" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, v1, v0 @50
    v4 = Integer integer=1
    PropSet v3, v4 key="a"
    Return v3
}
function f4 name="three" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, v1, v0 @250
    v4 = Integer integer=3
    PropSet v3, v4 key="c"
    Return v3
}
