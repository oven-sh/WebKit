# const kMass = Symbol("mass"), kLabel = Symbol("label")  interface Body { plain: number; [kLabel]: number; [kMass]: number }
# function make(n): Body { const b = { plain: 1 }; define b[kMass] = n; define b[kLabel] = n + 1; return b }
# function readAny(o) { return o[kMass] }  function writeAny(o, v) { o[kMass] = v }  function has(o) { return kMass in o }  function remove(o) { return delete o[kMass] }
# Code that knows the symbol and nothing of the object reads, stores, tests and deletes the field in its slot. The definitions of a literal give the order of the keys
# FORM: AsRead
# RUN(IR): pipeline ChooseCallingConventions
# RUN: run-in-shell globalThis.register = (make, readAny, writeAny, has, remove, k) => { const b = make(7); const keys = o => Reflect.ownKeys(o).map(String).join(); print(readAny(b), has(b), keys(b)); writeAny(b, 9); print(readAny(b), b[k]); print(remove(b), has(b), readAny(b), keys(b)); writeAny(b, 10); print(readAny(b), has(b), keys(b)); print(remove(b), remove(b), keys(b)); const plain = {}; print(readAny(plain), has(plain), remove(plain)); writeAny(plain, 1); print(readAny(plain), has(plain)); const heir = Object.create(make(3)); print(readAny(heir), has(heir), remove(heir), readAny(heir)); writeAny(heir, 4); print(readAny(heir), readAny(Object.getPrototypeOf(heir)), keys(heir)); const frozen = Object.freeze(make(5)); try { writeAny(frozen, 6); print("stored"); } catch (e) { print(e.constructor.name); } try { print(remove(frozen)); } catch (e) { print(e.constructor.name); } print(readAny(frozen)); try { readAny(undefined); } catch (e) { print(e.constructor.name); } print(readAny(5), readAny("text")); };
