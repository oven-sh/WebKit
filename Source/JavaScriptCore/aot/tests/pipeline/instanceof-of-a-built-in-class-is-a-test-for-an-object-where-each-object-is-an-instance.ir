# const values = [new Error("x"), "text", new TypeError("y"), 5]      values[i & 3] instanceof Error
# Flow has followed both errors: each keeps the prototype of its class, and TypeError.prototype keeps Error.prototype above it. So every object that arrives is an instance and no primitive is:
# the walk up the chain is a test for an object. `instanceof TypeError` tells the two errors apart, and they differ in nothing but the chain: that walk stays.
# RUN: pipeline ResolveBuiltins

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="values" module=m0 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Error
    v1 = String string="x"
    v2 = Construct v0, -, v1
    v3 = String string="text"
    v4 = Builtin builtin=TypeError
    v5 = String string="y"
    v6 = Construct v4, -, v5
    v7 = Integer integer=5
    v8 = NewArray v2, v3, v6, v7
    PutModuleVariable v8 variable=g0
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="register" [isFreeName]
    v12 = NewClosure function=f1
    v13 = NewClosure function=f2
    v14 = Call v11, -, v12, v13
    Return
}
function f1 name="isError" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = Integer integer=3
    v3 = BitAnd v0, v2
    v4 = ElemGet v1, v3
    v5 = Builtin builtin=Error
    v6 = InstanceOf v4, v5
    Return v6
}
function f2 name="isTypeError" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = Integer integer=3
    v3 = BitAnd v0, v2
    v4 = ElemGet v1, v3
    v5 = Builtin builtin=TypeError
    v6 = InstanceOf v4, v5
    Return v6
}
# CHECK-LABEL: name="isError"
# CHECK-NOT: HasInPrototypeChain
# CHECK: = TypeTest {{*}} testedType=object
# CHECK-LABEL: name="isTypeError"
# CHECK: = HasInPrototypeChain
