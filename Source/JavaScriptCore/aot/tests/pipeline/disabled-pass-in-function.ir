# CHECK: = Add v1, v2
# PROGRAM-LABEL: function f7 name="disabledFunction" {{*}}results=[{type=number}, {type=number}, {type=number}]
# PROGRAM: = Mul

function f8 name="trimmed" role=ResultWorker parameters=[{type=number}] results=[{type=number}, {type=number}, {type=number}] derivation={source=f2} creator=ResultWorker{origin=f2} {
  b0(v0: number):
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Add v1, v2
    v4 = Mul v0, v0
    v5 = Sub v0, v0
    v6 = Results v3, v4, v5
