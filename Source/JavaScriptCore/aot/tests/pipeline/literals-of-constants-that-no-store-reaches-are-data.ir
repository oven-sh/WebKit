# The arrays of `[1, 2, 3]` that are kept, and that no store of the program reaches, are made from a data record: each is a cell around the storage in the image.
# A literal one of whose arrays is stored into, one with an element that is no constant, and one with strings that is made once, stay as they are
# RUN: pipeline EmbedConstantCollections

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Call v0, - [isNeverInlined]
    v2 = NewClosure function=f2
    v3 = Call v2, - [isNeverInlined]
    v4 = Integer integer=0
    v5 = Integer integer=9
    ElemSet v3, v4, v5 mode=Strict
    v7 = NewClosure function=f3
    v8 = ElemGet v3, v4
    v9 = Call v7, -, v8 [isNeverInlined]
    v10 = NewClosure function=f4
    v11 = Call v10, - [isNeverInlined]
    v12 = ElemGet v1, v4
    v13 = ElemGet v9, v4
    v14 = ElemGet v11, v4
    v15 = Add v12, v13
    v16 = Add v15, v14
    v17 = Call v10, - [isNeverInlined]
    v18 = ElemGet v17, v4
    v19 = Add v16, v18
    v20 = NewClosure function=f5
    v21 = Call v20, - [isNeverInlined]
    v22 = ElemGet v21, v4
    v23 = Add v19, v22
    v24 = NewClosure function=f6
    v25 = Call v24, -, v8 [isNeverInlined]
    v26 = ElemGet v25, v4
    v27 = Add v23, v26
    Return v27
}

function f1 name="unwritten" module=m0 results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = Integer integer=3
    v3 = NewArray v0, v1, v2
    Return v3
}
# CHECK-LABEL: name="unwritten"
# CHECK-NEXT: b0():
# CHECK-NEXT: = Data data=d0

function f2 name="written" module=m0 results=[{type=anything}] {
    v0 = Integer integer=4
    v1 = Integer integer=5
    v2 = NewArray v0, v1
    Return v2
}
# CHECK-LABEL: name="written"
# CHECK-NOT: Data
# CHECK: = NewArray

function f3 name="notConstant" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=6
    v2 = NewArray v1, v0
    Return v2
}
# CHECK-LABEL: name="notConstant"
# CHECK-NOT: Data
# CHECK: = NewArray

function f4 name="strings" module=m0 results=[{type=anything}] {
    v0 = String string="first"
    v1 = String string="second"
    v2 = NewArray v0, v1
    Return v2
}
# CHECK-LABEL: name="strings"
# CHECK-NEXT: b0():
# CHECK-NEXT: = Data data=d1

function f5 name="stringsMadeOnce" module=m0 results=[{type=anything}] {
    v0 = String string="third"
    v1 = String string="fourth"
    v2 = NewArray v0, v1
    Return v2
}
# CHECK-LABEL: name="stringsMadeOnce"
# CHECK-NOT: Data
# CHECK: = NewArray

function f6 name="readWhereItIsMade" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=10
    v2 = Integer integer=11
    v3 = NewArray v1, v2
    v4 = ElemGet v3, v0
    v5 = NewArray v4, v3
    Return v5
}
# CHECK-LABEL: name="readWhereItIsMade"
# CHECK-NEXT: b0(
# CHECK-NEXT: = Data data=d2
# CHECK: = GetArrayElement {{*}}level=Proven
# CHECK: data d0 root=Array{contents=int[1, 3] elements=[Number{value=1}, Number{value=2}, Number{value=3}]}
# CHECK-NEXT: data d1 root=Array{contents=string elements=[String{value="first"}, String{value="second"}]}
# CHECK-NEXT: data d2 root=Array{contents=int[10, 11] elements=[Number{value=10}, Number{value=11}]}
