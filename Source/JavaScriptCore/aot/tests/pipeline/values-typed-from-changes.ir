# Typing a function again starts over only the values that have changed since it was last typed, and what they reach.
# `counts` inlines `step` and is typed, which narrows what goes round its loop. Simplify then joins the inlined blocks, and the next typing starts from those changes.
# In `waitsForLimit` the only change after the first typing moves the read of `limit` in front of the loop. That changes no definition, so the function is typed as before.
# With VerifyEachPass the types are compared with those that typing every value gives, and a wider one is TypeOutOfDate.
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass
# RUN: pipeline RemoveUnreadFields
# STATISTIC: InlineCallsChanges >= 1
# STATISTIC: HoistLoopInvariantReadsChanges >= 1
# STATISTIC: FunctionsTypedFromNever >= 1
# STATISTIC: FunctionsTypedFromChanges >= 1
# STATISTIC: FunctionsTypedAsBefore >= 1

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="limit" module=m0 declared={type=anything} initialization=Undefined

function f0 name="" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f3
    v4 = NewClosure function=f4
    v5 = Call v1, -, v2, v3, v4
    Return v5
}

function f1 name="counts" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = BitOr v0, v1
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Integer integer=100
    v7 = Less v3, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = CallDirect v4 function=f2
    v9 = Integer integer=1
    v10 = Add v3, v9
    Jump -> next b1(v10, v8)
  b3():
    Return v4
}

function f2 name="step" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=3
    v2 = BitAnd v0, v1
    Return v2
}

function f3 name="setsLimit" parameters=[{type=anything}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    Return
}

function f4 name="waitsForLimit" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v2 = GetModuleVariable variable=g0
    v3 = StrictEq v2, v0
    Branch v3 -> taken b3(), notTaken b2()
  b2():
    Jump -> next b1()
  b3():
    Return v2
}
