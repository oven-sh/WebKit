# function add(n) { return n + 1 }   let kept = add   function bindAgain() { kept = kept.bind(null) }   function run(n) { return kept(n) }
# function putAdd() { kept = add }
# The variable holds the function and then the result of binding it, like the field in `this.add = this.add.bind(this)`. The target of the bind is not proven, but flow saw closures of only
# one function arrive: the bind tests for one and creates a closure of the bound function, and the engine binds anything else.
# Flow saw the result of that bind reach the call in `run`: the call tests for such a closure and enters the function directly. Anything else in the variable is called as a value.
# The call of `bind` itself creates such a closure and does not receive one, so it expects none as its callee.
