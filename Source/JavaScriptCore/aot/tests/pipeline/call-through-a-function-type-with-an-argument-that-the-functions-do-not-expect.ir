# type Unary = (n: number) => number  function call(f: Unary, n) { return f(n) }  register(call, one, two, three, four, five, six)
# The functions that are converted to the type test at their heads what they declare for a parameter, here a number. A call through the type proves nothing of its argument:
# what is no number is passed to the same function, which does with it what plain JavaScript does
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (call, ...all) => { let text = ""; for (const f of all) text += " " + call(f, 10) + " " + call(f, "a") + " " + call(f, undefined) + " " + call(f, { valueOf() { return 5; } }); print(text); };
# CHECK: {{*}}11 a1 NaN 6 12 a2 NaN 7 13 a3 NaN 8 14 a4 NaN 9 15 a5 NaN 10 16 a6 NaN 11
# CHECK-NEXT: exited with 0

