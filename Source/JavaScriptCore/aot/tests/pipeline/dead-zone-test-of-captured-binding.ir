# The read of a captured let loses its dead-zone test where every closure that reads it is created after the store, and keeps it where such a closure may run before the store
# FORM: AsRead
# RUN: pipeline SimplifyCasts
# LOSS: MaxFlowRangeGrowth

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="scope" fields=[{key=@"binding.0" declared={type=anything|absent}}, {key=@"binding.1" declared={type=anything|absent}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = CallDirect v0 function=f1
    v2 = Integer integer=2
    v3 = CallDirect v2 function=f1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    v6 = Call v5, -, v1, v3
    Return
}
function f1 name="owner" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    v2 = Integer integer=0
    PutEnvironmentField v1, v2 layout=L0 field=0
    v4 = NewClosure v1 function=f2
    v5 = Call v4
    PutEnvironmentField v1, v0 layout=L0 field=1
    Return v4
}
function f2 name="step" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = CheckInitialized v1 name="count"
    v3 = Integer integer=1
    v4 = Add v2, v3
    PutEnvironmentField v0, v4 layout=L0 field=0
    v6 = GetEnvironmentField v0 layout=L0 field=1
    v7 = CheckInitialized v6 name="late"
    v8 = Add v4, v7
    Return v8
}
# CHECK: layout L0 kind=Environment {{*}}key=@"binding.0" declared={type=int|whole written=anything|absent}{{*}}initialization=StoredBeforeEveryRead{{*}}key=@"binding.1" declared={type=int[1, 2]|absent written=anything|absent}
# CHECK-LABEL: function f2 name="step"
# CHECK: [[count]]: int|whole = GetEnvironmentField v0 layout=L0
# CHECK-NOT: name="count"
# CHECK: [[late]]: int[1, 2]|absent = GetEnvironmentField v0 layout=L0 field=1
# CHECK-NEXT: int[1, 2] = CheckInitialized [[late]] name="late"
