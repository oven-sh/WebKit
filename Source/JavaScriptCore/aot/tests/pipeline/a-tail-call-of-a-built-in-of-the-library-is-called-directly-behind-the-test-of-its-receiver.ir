# function doubled(list: number[]): number[] { return list.map(v => v * 2) }   list is what new Array(n) made, and it is offered to a function nobody knows
# One thing is left to test: that nobody has put a `map` of his own on the list. The test is placed for the call in tail position too, not for the read of `map` alone: the call behind it is direct.
# Inlined into its caller the call is no tail call, so nothing is inlined here
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline PlaceTypeTests
# CHECK-LABEL: function f2 name="doubled"
# CHECK: [[pristine]]: boolean = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch [[pristine]] -> taken [[direct]](| 0), notTaken
# CHECK-LABEL: function f3
# RUN(DIRECT): pipeline PlaceTypeTests
# DIRECT-LABEL: function f2 name="doubled"
# DIRECT: guard):
# DIRECT: [[result]]: {{*}} = CallDirect
# DIRECT-NEXT: ReturnCall [[result]]
# DIRECT-LABEL: function f3

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="mayKeep" declared={type=anything} flags=[IsMethod, IsNeverWritten]}] flags=[IsNeverAllocated]

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Integer integer=50
    v5 = Call v1, -, v4 calleeName="holes"
    v6 = Convert v5 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="somebody" [isFreeName]
    v9 = Convert v8 declared={type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}
    v10 = PropGet v9 key="mayKeep"
    v11 = Convert v10 declared={type=undefined|null|function flags=[IsExpected]}
    v12 = TypeTest v11 testedType=undefined|null
    Branch v12 -> taken b2(| 0), notTaken b4(| 0)
  b2(v13):
    Jump -> next b3()
  b3():
    v14 = Undefined
    Jump -> next b5(v14)
  b4(v15):
    v16 = Call v15, v9, v6 calleeKey="mayKeep" calleeName="somebody.mayKeep"
    Jump -> next b5(v16)
  b5(v17):
    v18 = Integer
    v19 = Convert v18 declared={type=number}
    v20 = Integer
    v21 = Convert v20 declared={type=number}
    Jump -> next b6(v19, v21)
  b6(v22: number, v23: number):
    LoopHint
    v25 = Integer integer=100
    v26 = Less v23, v25
    Branch v26 -> taken b7(| 0), notTaken b10(| 0)
  b7(v27):
    Jump -> next b8()
  b8():
    v28 = Call v3, -, v6 calleeName="doubled"
    v29 = Convert v28 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    v30 = Integer integer=50
    v31 = Mod v27, v30
    v32 = ElemGet v29, v31
    v33 = Convert v32 declared={type=number} illTypedCause=ContainerWriterUnseen
    v34 = Add v22, v33
    v35 = Convert v34 declared={type=number}
    Jump -> next b9()
  b9():
    v36 = Increment v27
    v37 = Convert v36 declared={type=number}
    Jump -> next b6(v35, v37)
  b10(v38):
    Jump -> next b11()
  b11():
    v39 = Builtin builtin=GlobalThis
    v40 = PropGet v39 key="print" [isFreeName]
    v41 = Call v40, -, v22 calleeName="print"
    v42 = Undefined
    Return v42
}

function f1 name="holes" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Array
    v2 = Call v1, -, v0 calleeName="Array" [isDoneInPlace]
    v3 = Convert v2 declared={type=undefined|null|Array flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v4 = Convert v3 declared={type=undefined|null|Array<number> flags=[OmitsNull, OmitsUndefined]}
    v5 = Integer
    v6 = Convert v5 declared={type=number}
