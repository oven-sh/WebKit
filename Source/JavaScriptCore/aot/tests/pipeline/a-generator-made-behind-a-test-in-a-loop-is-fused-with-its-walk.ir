# A loop makes a generator from its counter and walks it. The test of the counter has a generic copy, and the copy does not come back between the creation and the walk:
# only a generator with one creation is merged into the loop that walks it.
# class Span {
#   constructor(from, to) {
#     this.from = from;
#     this.to = to;
#   }
#   *values() {
#     for (let k = this.from; k < this.to; k++) yield k;
#   }
#   [Symbol.iterator]() {
#     return this.values();
#   }
# }
# function sums(n) {
#   let sum = 0;
#   for (let i = 0; i < n; i++) {
#     for (const value of new Span(i & 3, 8)) sum = (sum + value) | 0;
#   }
#   return sum;
# }
