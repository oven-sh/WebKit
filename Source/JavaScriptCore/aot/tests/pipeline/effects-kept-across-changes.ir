# What a value does is kept from one change of its function to the next where the value, its type and the types of its operands are as they were.
# EliminateDeadCode asks what the call in `callsItsArgument` does. The sum stays: its operand may still be the text. RetypeValues leaves numbers only,
# so EliminateDeadCode runs again and removes the sum. The call is as it was, so it gets the answer it got.
# With VerifyEachPass every kept answer is compared with a fresh one, and what EliminateDeadCode takes from the row of an operation with the effects of the value.
# OPTIONS: check=VerifyEachPass
# RUN: pipeline NarrowConstantVariables
# STATISTIC: EliminateDeadCodeChanges >= 1
# STATISTIC: EffectsComputed >= 1
# STATISTIC: EffectsKept >= 1

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}

function f1 name="callsItsArgument" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Boolean boolean=false
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = String string="text"
    Jump -> next b5(v2)
  b2():
    v3 = ToBoolean v0
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Integer integer=1
    Jump -> next b5(v4)
  b4():
    v5 = Integer integer=2
    Jump -> next b5(v5)
  b5(v6):
    v7 = Add v6, v6
    v8 = Call v0, -, v0
    Return v8
}
# CHECK-LABEL: function f1
# CHECK-NOT: = Add
# CHECK: = Call
# CHECK: Return
