# const values = [new Error("x"), "text", new TypeError("y"), 5]      const value = values[i & 3]; value instanceof Error ? value.message : 0
# Each object that arrives is an error, so the walk up the chain is a test for an object. Behind it the value is one of the two errors, and the read is that of the slot where their constructors leave the message.
# RUN: pipeline Select

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="values" module=m0 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Error
    v1 = String string="x"
    v2 = Construct v0, -, v1
    v3 = String string="text"
    v4 = Builtin builtin=TypeError
    v5 = String string="y"
    v6 = Construct v4, -, v5
    v7 = Integer integer=5
    v8 = NewArray v2, v3, v6, v7
    PutModuleVariable v8 variable=g0
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="register" [isFreeName]
    v12 = NewClosure function=f1
    v13 = Call v11, -, v12
    Return
}
function f1 name="messageOfError" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = Integer integer=3
    v3 = BitAnd v0, v2
    v4 = ElemGet v1, v3
    v5 = Builtin builtin=Error
    v6 = InstanceOf v4, v5
    v7 = ToBoolean v6
    Branch v7 -> taken b1(), notTaken b2()
  b1():
    v8 = PropGet v4 key="message"
    Return v8
  b2():
    v9 = Integer integer=0
    Return v9
}
# CHECK-LABEL: name="messageOfError"
# CHECK-NOT: HasInPrototypeChain
# CHECK: = TypeTest {{*}} testedType=object
# CHECK-NOT: = PropGet {{*}} key="message"
# CHECK: = CallBuiltin {{*}} overload=ErrorPrototypeMessage/0
