# const members = { get size() { return this.items } }   function g() { return tick() }   function make(proto) { const made = Object.create(proto); made.items = g(); return made }
# report(make(members).size)   try { make(1); report("no error") } catch (error) { report(error.message) }
# Object.create refuses what is neither an object nor null before it makes anything, and the link to the prototype does that for the call. The allocation moves down behind the call of g()
# and lists what g() answers, and the link goes along. The program sees that call, so a test stays where the link stood and the link refuses nothing: g() does not run for a prototype that
# is refused. The call still stands between the test and the link behind selection, so the test is there.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN(MADE): pipeline AllocateTaggedLayouts
# RUN(LISTED): pipeline ResolveAccesses
# RUN(SELECTED): pipeline Select
# RUN: run-in-shell globalThis.ticks = 0; globalThis.tick = () => ++ticks; globalThis.report = text => print(text, ticks);
# MADE-LABEL: function f2 name="make"
# MADE-NOT: RequireType
# MADE: = NewObject layout=
# MADE-NEXT: SetLiteralPrototype {{*}}[refusesOtherValues]
# MADE-NEXT: = FinishObject
# LISTED-LABEL: function f2 name="make"
# LISTED: = RequireType v0 requiredType=null|object runtimeError=PrototypeIsNeitherObjectNorNull calledBuiltin=ObjectCreate
# LISTED: = Call
# LISTED: = NewObject -,
# LISTED-NEXT: SetLiteralPrototype
# LISTED-NOT: refusesOtherValues
# SELECTED-LABEL: function f2 name="make"
# SELECTED: = RequireType
# SELECTED: = NewObject -,
# SELECTED-NEXT: SetLiteralPrototype
# SELECTED-NOT: refusesOtherValues
# CHECK: 1 1
# CHECK-NEXT: Object prototype may only be an Object or null. 1
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
variable g0 name="g" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    v3 = NewObject layout=L0
    v4 = NewClosure function=f3
    DefineGetter v3, v4 key="size"
    v6 = FinishObject v3
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="report" [isFreeName]
    v9 = Call v2, -, v6
    v10 = PropGet v9 key="size"
    v11 = Call v8, -, v10
    Jump -> next b1()
  b1() handler=b3():
    v12 = Integer integer=1
    v13 = Call v2, -, v12
    v14 = String string="no error"
    v15 = Call v8, -, v14
    Jump -> next b2()
  b2():
    Return
  b3() role=CatchHandler:
    v16 = CatchValue
    v17 = PropGet v16 key="message"
    v18 = Call v8, -, v17
    Jump -> next b2()
}
function f1 name="g" results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="tick" [isFreeName]
    v2 = Call v1, -
    Return v2
}
function f2 name="make" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Call v2, v1, v0
    v4 = GetModuleVariable variable=g0
    v5 = Call v4, -
    PropSet v3, v5 key="items"
    Return v3
}
function f3 name="size" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="items"
    Return v1
}
