# type Unary = (n: number) => number  interface Holder { run: Unary }  function hold(f: Unary): Holder { return { run: f } }  function callField(h: Holder, n) { return h.run(n) }
# A field of a function type lists the functions that are converted to the type too, here more than a dispatch has arms. Its slot takes every function, listed or not.
# A function of the shell that is stored there satisfies the type, no check turns it away, and it stays in the slot; the call of it goes by value as plain JavaScript does.
# What is no function takes the property out of its slot
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (callField, hold, ...all) => { let text = ""; for (const f of all) text += " " + callField(hold(f), 10); print(text); const holder = hold(all[0]); holder.run = all[5]; print(callField(holder, 10)); holder.run = all[6]; print(callField(holder, 10)); holder.run = n => n * 3; print(callField(holder, 10)); holder.run = all[1]; print(callField(holder, 10)); for (const none of ["text", undefined, null]) { holder.run = none; try { callField(holder, 10); } catch (error) { print(error instanceof TypeError); } } delete holder.run; try { callField(holder, 10); } catch (error) { print(error instanceof TypeError); } };
