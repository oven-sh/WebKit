# whole = [1, 2]; walksWhole(whole); register(walksGiven)
# A loop over `number[]` expects Double storage, and an array of integers that is handed in is converted where that test fails, once: every later element is one load.
# The program also has an array whose kind of storage is decided for the whole program: that one is never converted, and it does not end the conversion of the others.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline PlanArrayCapacities
# CHECK-LABEL: name="walksWhole"
# CHECK-NOT: ConvertToDoubleStorage
# CHECK-LABEL: name="walksGiven"
# CHECK: ConvertToDoubleStorage

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewArray v0, v1 contents=anything
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="register" [isFreeName]
    v7 = NewClosure function=f2
    v8 = Call v6, -, v7, v4
    Return
}

function f1 name="walksWhole" parameters=[{type=Array<number> flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number>):
    v1 = IteratorOpen v0
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3: anything):
    LoopHint
    v5 = IteratorResume v1
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b3(), notTaken b2()
  b2():
    v8 = Add v3, v7
    Jump -> next b1(v8)
  b3():
    Return v3
}

function f2 name="walksGiven" parameters=[{type=Array<number> flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number>):
    v1 = IteratorOpen v0
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3: anything):
    LoopHint
    v5 = IteratorResume v1
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b3(), notTaken b2()
  b2():
    v8 = Add v3, v7
    Jump -> next b1(v8)
  b3():
    Return v3
}
