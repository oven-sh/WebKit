# class Item { value; flag }   register(new Item(), readsValue, WebAssembly)   function readsValue(item) { return item.value }
# `value` is also an accessor of WebAssembly.Global, and this program reads WebAssembly and hands it on: an object that is asked for its `value` alone may well be such a global.
# A test for the layout would turn it away, so the read goes by name.
# RUN: pipeline PlaceTypeTests

module m0 path="/application.js" displayPath="application.js" body=f0
entry module=m0
layout L0 name="Item" module=m0 fields=[{key="value" declared={type=anything}}, {key="flag" declared={type=anything}}]

function f0 name="" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = Integer integer=2
    v3 = Integer integer=3
    v4 = NewObject -, v2, v3 layout=L0 fields=[0, 1]
    v5 = NewClosure function=f1
    v6 = PropGet v0 key="WebAssembly" [isFreeName]
    v7 = Call v1, -, v4, v5, v6
    Return v7
}

function f1 name="readsValue" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="value"
    Return v1
}
# CHECK-LABEL: name="readsValue"
# CHECK-NOT: = TypeTest
