# `wrapper.req.method`, `wrapper.req.url`: three classes have both names, more than are expected of a field. Two of them get `url` after the constructor has returned, so not every instance has it.
# FORM: AsRead
# RUN: pipeline ApplyFlowResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Incoming" constructor=f1 fields=[{key="method" declared={type=anything} flags=[IsRequired]}, {key="url" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Other" constructor=f2 fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="Wrapper" constructor=f3 fields=[{key="req" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="Third" constructor=f4 fields=[{key="method" declared={type=anything} flags=[IsRequired]}]
# CHECK: layout L2 {{*}}{key="req" declared={type=undefined|null|L0 flags=[IsExpected]}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
