    v7 = NewClass v6 layout=L2
    v8 = FinishClass v7 layout=L2
    v9 = NewClosure function=f4
    v10 = NewClass v9 layout=L3
    v11 = FinishClass v10 layout=L3
    v12 = String string="a"
    v13 = Construct v2, v2, v12
    v14 = Construct v5, v5, v12
    v15 = Construct v8, v8, v12
    v16 = Construct v11, v11, v12
    v17 = NewClosure function=f5
    v18 = NewClosure function=f6
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="text" [isFreeName]
    v21 = Builtin builtin=Function
    v22 = Construct v21, -, v20
    v23 = Call v22, -, v2, v5, v8, v11, v13, v14, v15, v16, v17, v18
    PropSet v14, v12 key="url" mode=Strict
    PropSet v16, v12 key="url" mode=Strict
    Return v23
}
function f1 name="Incoming" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="method" mode=Strict
    PropSet v3, v1 key="url" mode=Strict
    Return v3
}
