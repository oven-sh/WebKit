  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L2
    v3 = NewObject v2 layout=L2
    PropSet v3, v1 key="req" mode=Strict
    Return v3
}
function f4 name="Third" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L3
