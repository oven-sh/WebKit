# `const holder = Object.create(prototype); holder.extra = value;`: the field is no part of the layout as written, but the code that allocates the object fills it at once. `later` is stored by somebody else.
# FORM: AsRead
# RUN: pipeline ApplyFlowResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Holder" constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
# CHECK: layout L0 {{*}}{key="later" declared={type=anything} flags=[IsAddedLate, IsEnforced]}, {key="extra" declared={type=anything} flags=[IsAddedLate, IsEnforced, IsFilledByCreator]}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, v2, v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="text" [isFreeName]
    v7 = Builtin builtin=Function
    v8 = Construct v7, -, v6
    v9 = Call v8, -, v2, v4
    PropSet v4, v3 key="later" mode=Strict
    Return v9
}
function f1 name="Holder" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="a" mode=Strict
    PropSet v3, v1 key="extra" mode=Strict
    Return v3
}
