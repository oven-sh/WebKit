# Under check=CountChangesBehindSimplify the passes of the schedule Simplify run on a copy wherever the schedule is about to run, and every run that changes the copy is counted:
# what one walk in the place of the schedule has left undone. The function itself goes the way that it goes without the option.
#   f1 holds a sum of constants, a branch on a constant and a value that nobody uses
# FORM: AsRead
# OPTIONS: check=CountChangesBehindSimplify
# RUN: pipeline CheckPlacement
# STATISTIC: ChangesBehindSimplify >= 1
# CHECK-LABEL: function f1 name="folds"
# CHECK: Return

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="folds" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Add v1, v2
    v4 = Mul v3, v3
    v5 = Boolean boolean=true
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    Return v3
  b2():
    Return v0
}
