# An initializer that is put off reads a variable of another file at its own first read. It may where that file has run to its end before the file of the initializer begins.
# main.js requires middle.js, which calls import() on late.js, which imports main.js: late.js may begin while main.js runs, and its initializer stays. ended.js loads nothing.
# FORM: AsRead
# RUN: pipeline DeferInitializers
# OPTIONS: check=VerifyEachPass
# STATISTIC: InitializersDeferred = 1
# CHECK-LABEL: function f2 name="late"
# CHECK: NewObject layout=L0
# CHECK: PutModuleVariable {{*}} variable=g1
# CHECK-LABEL: function f5 name="after"
# CHECK-NOT: NewObject
# CHECK-LABEL: function f6 name="read"
# CHECK: role=OutlinedBody
# CHECK: NewObject layout=L0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m4 completes=true}] exports=[{name="count" variable=g0}]
module m1 path="/middle.js" displayPath="middle.js" body=f1
module m2 path="/late.js" displayPath="late.js" body=f2 requests=[{target=m0 completes=true}]
module m3 path="/ended.js" displayPath="ended.js" body=f4 exports=[{name="total" variable=g2}]
module m4 path="/after.js" displayPath="after.js" body=f5 requests=[{target=m3 completes=true}]
entry module=m0
layout L0 fields=[{key="first" declared={type=anything} flags=[IsRequired]}, {key="inner" declared={type=anything} flags=[IsRequired]}, {key="list" declared={type=anything} flags=[IsRequired]}]
layout L1 fields=[{key="deep" declared={type=anything} flags=[IsRequired]}, {key="more" declared={type=anything} flags=[IsRequired]}]
variable g0 name="count" module=m0 declared={type=anything} initialization=Undefined flags=[IsImmutable]
variable g1 name="kept" module=m2 declared={type=anything|absent} flags=[IsImmutable]
variable g2 name="total" module=m3 declared={type=anything} initialization=Undefined flags=[IsImmutable]
variable g3 name="kept" module=m4 declared={type=anything|absent} flags=[IsImmutable]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = RequireModule module=m1 referrer=m0 specifier="./middle.js"
    v1 = Integer integer=1
    PutModuleVariable v1 variable=g0
    Return
}

function f1 name="middle" module=m1 kind=Module results=[{type=anything}] {
    v0 = ImportModule module=m2 referrer=m1
    Return
}

function f2 name="late" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="first"
    v3 = Integer integer=2
    v4 = Integer integer=3
    v5 = NewArray v0, v3, v4 contents=anything
    PropDefine v1, v5 key="list"
    v7 = NewObject layout=L1
    PropDefine v7, v0 key="deep"
    v9 = Integer integer=4
    v10 = Integer integer=5
    v11 = NewArray v9, v10 contents=anything
    PropDefine v7, v11 key="more"
    v13 = FinishObject v7
    PropDefine v1, v13 key="inner"
    v15 = FinishObject v1
    PutModuleVariable v15 variable=g1
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="publish" [isFreeName]
    v19 = NewClosure function=f3
    v20 = Call v18, -, v19
    Return
}

function f3 name="read" module=m2 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="kept"
    v2 = PropGet v1 key="first"
    Return v2
}

function f4 name="ended" module=m3 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    Return
}

function f5 name="after" module=m4 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="first"
    v3 = Integer integer=2
    v4 = Integer integer=3
    v5 = NewArray v0, v3, v4 contents=anything
    PropDefine v1, v5 key="list"
    v7 = NewObject layout=L1
    PropDefine v7, v0 key="deep"
    v9 = Integer integer=4
    v10 = Integer integer=5
    v11 = NewArray v9, v10 contents=anything
    PropDefine v7, v11 key="more"
    v13 = FinishObject v7
    PropDefine v1, v13 key="inner"
    v15 = FinishObject v1
    PutModuleVariable v15 variable=g3
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="publish" [isFreeName]
    v19 = NewClosure function=f6
    v20 = Call v18, -, v19
    Return
}

function f6 name="read" module=m4 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="kept"
    v2 = PropGet v1 key="first"
    Return v2
}
