# class A { m(x) { return x + 1 } }  class B { m(x) { return x + 2 } }  function call(o: A | B, x) { return o.m(x) }  register(call, A, B)
# The receiver is of one of two classes, each with its own method, and the shell may replace either: the call goes through the method table. Behind the test of the receiver's type it tests nothing.
# Whatever changes what an object finds under the name sends the entries that it touches to the lookup of the selector, which calls what the receiver has under the name, as plain JavaScript does:
# a store to a prototype, an own property, a deleted method, another prototype, an accessor. The other class keeps its entry
# FORM: AsRead
# RUN(IR): pipeline ChooseCallingConventions
# RUN: run-in-shell globalThis.register = (call, A, B) => { const a = new A(), b = new B(); const show = () => { let text = ""; for (const o of [a, b, new A(), new B()]) { try { text += " " + call(o, 10); } catch (error) { text += " " + (error instanceof TypeError ? "TypeError" : "error"); } } print(text); }; show(); B.prototype.m = x => x * 3; show(); a.m = x => x * 5; show(); delete A.prototype.m; show(); Object.setPrototypeOf(b, A.prototype); show(); Object.defineProperty(A.prototype, "m", { get() { return x => x * 7; }, configurable: true }); show(); print(call({ m: x => x * 9 }, 10)); };
# STATISTIC: TableLookups = 1
# STATISTIC: TableEntrypoints = 2
# IR: = CallTable {{*}} key="m" receivers=[L0, L1]
# CHECK: {{*}}11 12 11 12
# CHECK-NEXT: {{*}}11 30 11 30
# CHECK-NEXT: {{*}}50 30 11 30
# CHECK-NEXT: {{*}}50 30 TypeError 30
# CHECK-NEXT: {{*}}50 TypeError TypeError 30
# CHECK-NEXT: {{*}}50 70 70 30
# CHECK-NEXT: 90
# CHECK-NEXT: exited with 0

layout L0 kind=Instance name="A" module=m0 position=10 constructor=f2
layout L1 kind=Instance name="B" module=m0 position=60 constructor=f4
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=120 kind=Parameter
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f3
    DefineMethod v1, v2 layout=L0 side=Prototype key="m"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f4
    v6 = NewClass v5 layout=L1
    v7 = NewClosure function=f5
    DefineMethod v6, v7 layout=L1 side=Prototype key="m"
    v9 = FinishClass v6 layout=L1
    v10 = NewClosure function=f1
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="register" [isFreeName]
    v13 = Call v12, -, v10, v4, v9
    Return
}
function f1 name="call" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 site=w0}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|L0|L1, v1: anything):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0, v1 calleeKey="m" calleeName="m"
    Return v3
}
function f2 name="A" module=m0 position=10 kind=BaseConstructor flags=[HasNewTarget] thisType={type=anything} results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f3 name="m" module=m0 position=20 kind=Method length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Add v0, v1
    Return v2
}
function f4 name="B" module=m0 position=60 kind=BaseConstructor flags=[HasNewTarget] thisType={type=anything} results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f5 name="m" module=m0 position=70 kind=Method length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    v2 = Add v0, v1
    Return v2
}
