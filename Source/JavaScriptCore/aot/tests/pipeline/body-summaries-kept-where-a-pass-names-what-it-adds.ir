# A program pass that says what its edits add leaves the summary of a function that covers it as it is, as an upper bound, and any other function is read again.
# DeferClosuresInFields lets a read of `run` make the closure. `readsRun` allocated nothing before. `handsOn` calls code that nobody knows, which does all of that.
# With VerifyEachPass the summaries that are computed from nothing must lie within the kept ones behind every pass.
# FORM: AsRead
# RUN: pipeline Select
# OPTIONS: check=VerifyEachPass references=narrow heat=EverythingIsHot disable=pass:InlineCalls
# STATISTIC: FieldsDeferringClosures >= 1
# STATISTIC: BodySummariesKept >= 1
# CHECK: = GetDeferredClosureSlot

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Widget" constructor=f1 fields=[{key="count" declared={type=anything} flags=[IsRequired]}, {key="handler" declared={type=anything} flags=[IsRequired]}, {key="plain" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Literal" fields=[{key="run" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v3
    v7 = PropGet v3 key="handler"
    v8 = Call v5, -, v7
    v9 = NewClosure function=f3
    v10 = NewObject -, v9 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = Call v5, -, v11
    v13 = NewClosure function=f4
    v14 = Call v13, -, v11
    v15 = Call v5, -, v14
    v16 = NewClosure function=f5
    v17 = Call v16, -, v11
    Return v17
}
function f1 name="Widget" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=0
    PropDefine v2, v3 key="count"
    v5 = NewClosure v2 function=f2
    PropDefine v2, v5 key="handler"
    v7 = NewClosure function=f3
    PropDefine v2, v7 key="plain"
    Return v2
}
function f2 name="handler" kind=Arrow captures=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
}
function f3 name="plain" kind=Arrow results=[{type=anything}] {
    Return
}
function f4 name="readsRun" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="run"
    Return v1
}
function f5 name="handsOn" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="register" [isFreeName]
    v3 = PropGet v0 key="run"
    v4 = Call v2, -, v3
    Return v4
}
