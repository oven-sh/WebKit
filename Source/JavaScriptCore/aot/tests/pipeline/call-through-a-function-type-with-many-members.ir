# type Unary = (n: number) => number  function call(f: Unary, n) { return f(n) }  register(call, one, two, three, four, five, six, stranger)
# A position of a function type admits every function, and lists the functions that are converted to it, here more than a dispatch has arms. The test at the head of the function asks for a function.
# A closure of a listed function, a closure of another compiled function and a function of the shell satisfy the type: all are called by value, in the same code.
# A text and an object that cannot be called fail the test at the head and take the generic version, which does what plain JavaScript does
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (call, ...all) => { let text = ""; for (const f of all) text += " " + call(f, 10); print(text); print(call(n => n * 3, 10)); for (const none of ["text", undefined, null, {}]) { try { call(none, 10); } catch (error) { print(error instanceof TypeError); } } };
