# FORM: AsRead
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Settings" constructor=f1 fields=[{key="id" declared={type=anything} flags=[IsRequired]}, {key="options" declared={type=anything}}, {key="count" declared={type=number}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, v2, v3
    v5 = NewClosure function=f2
    v6 = NewClosure function=f3
    v7 = NewClosure function=f4
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="text" [isFreeName]
    v10 = Builtin builtin=Function
    v11 = Construct v10, -, v9
    v12 = Call v11, -, v4, v2, v5, v6, v7
    Return v12
}
function f1 name="Settings" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="id" mode=Strict
    Return v3
}

function f2 name="counts" parameters=[{type=L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: number):
    PropSet v0, v1 key="count" mode=Strict
    Return v1
}
# CHECK-LABEL: name="counts"
# CHECK-NOT: PutSlotOrAdd

function f3 name="readsOnly" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="options"
    Return v1
}
# CHECK-LABEL: name="readsOnly"
# CHECK: = IsSlotFilled {{*}} key="options"
# CHECK-NOT: = Undefined

function f4 name="update" parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: anything):
    v2 = PropGet v0 key="options"
    v3 = Call v1, -, v2
    PropSet v0, v3 key="options" mode=Strict
    Return v2
}
# CHECK-LABEL: name="update"
# CHECK: PutSlot {{*}} key="options"
# CHECK: [[filled]]: boolean = IsSlotFilled [[object]] key="options"
# CHECK-NEXT: Branch [[filled]] -> taken [[read]](| 0), notTaken [[empty]]()
# CHECK: = HasNoFieldOutsideSlot [[object]]
# CHECK: PutSlotOrAdd {{*}} key="options"
# CHECK: [[empty]]():
# CHECK-NEXT: = HasLayoutPrototype [[object]]
# CHECK: = HasNoFieldOutsideSlot [[object]]
# CHECK: : undefined = Undefined
