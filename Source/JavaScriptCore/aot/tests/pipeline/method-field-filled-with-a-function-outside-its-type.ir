# Two literals are allocated at one layout, and the type of its method lists the function of the first alone. A method cannot be stored behind the allocation,
# so the type is only expected (NarrowFieldTypes): the program builds, and a call through the layout runs the function that the object holds.
# Compiled code calls both through the typed parameter, code that nobody has seen calls both by name, lists the keys, and puts a third function and a number in the method's place
# FORM: AsRead
# RUN(IR): pipeline NarrowFieldTypes
# RUN: run-in-shell globalThis.report = (callRun, first, second) => { print(callRun(first), callRun(second)); print(first.run(), second.run(), Object.keys(second).join()); second.run = () => 3; print(callRun(second)); second.run = 4; try { callRun(second); } catch (error) { print(error instanceof TypeError); } print(callRun(first)); };
# IR: layout L0 name="SharedByTwoLiterals" fields=[{key="run" declared={type=undefined|null|f1 flags=[IsExpected]} flags=[IsRequired, IsMethod]}]
# CHECK: 1 2
# CHECK-NEXT: 1 2 run
# CHECK-NEXT: 3
# CHECK-NEXT: true
# CHECK-NEXT: 1
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
