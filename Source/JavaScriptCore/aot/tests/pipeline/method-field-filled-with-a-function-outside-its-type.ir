    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewClosure function=f3
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="report" [isFreeName]
    v9 = Call v8, -, v6, v2, v5
    Return
}
