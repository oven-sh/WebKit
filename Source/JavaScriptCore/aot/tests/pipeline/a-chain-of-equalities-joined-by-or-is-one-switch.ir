# `kind === 1 || kind === 2 || ..` as a value: behind each test that passed, the value of the left side is `true` and nothing else, so every passing edge leads to one place and the chain is a switch
# FORM: AsRead
# RUN: pipeline Select
# CHECK-LABEL: name="isListed" module=m0 role=GenericEntrypoint
# CHECK: Switch {{*}} cases=[3, 4, 9, 7, 5] -> case [[listed]](), case [[listed]](), case [[listed]](), case [[listed]](), case [[listed]](), otherwise
# CHECK-NOT: StrictEq

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="isListed" parameters=[{type=i32}] results=[{type=boolean}] {
  b0(v0: i32):
    v1 = Integer integer=3
    v2 = StrictEq v0, v1
    v3 = ToBoolean v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    Jump -> next b3(v4)
  b2():
    v5 = Integer integer=4
    v6 = StrictEq v0, v5
    Jump -> next b3(v6)
  b3(v7):
    v8 = ToBoolean v7
    Branch v8 -> taken b4(| 0), notTaken b5()
  b4(v9):
    Jump -> next b6(v9)
  b5():
    v10 = Integer integer=9
    v11 = StrictEq v0, v10
    Jump -> next b6(v11)
  b6(v12):
    v13 = ToBoolean v12
    Branch v13 -> taken b7(| 0), notTaken b8()
  b7(v14):
    Jump -> next b9(v14)
  b8():
    v15 = Integer integer=7
    v16 = StrictEq v0, v15
    Jump -> next b9(v16)
  b9(v17):
    v18 = ToBoolean v17
    Branch v18 -> taken b10(| 0), notTaken b11()
  b10(v19):
    Jump -> next b12(v19)
  b11():
    v20 = Integer integer=5
    v21 = StrictEq v0, v20
    Jump -> next b12(v21)
  b12(v22):
    v23 = ToBoolean v22
    Branch v23 -> taken b13(| 0), notTaken b14()
  b13(v24):
    Jump -> next b15(v24)
  b14():
    v25 = Boolean
    Jump -> next b15(v25)
  b15(v26):
    Return v26
}
