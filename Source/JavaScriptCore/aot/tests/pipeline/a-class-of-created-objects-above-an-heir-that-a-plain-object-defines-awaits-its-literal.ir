# const base = { get size() { return this.items } }   function mid(below) { const made = Object.create(below); made.items = 7; return made }   function leaf(below) { const made = Object.create(below); made.extra = 1; return made }   function read(made) { return made.size }   function readMid(made) { return made.size }   register(mid, leaf, read, base, readMid)   readMid(mid(base)); read(leaf(mid(base)))
# Two places: the second makes objects below what the first makes. The second place is handed a plain object first, which defines its class. What lies above that object is Object.prototype,
# and the definition hands it on to the class of the first place. Object.prototype defines no class: the class of the first place awaits its prototype object as before, and the literal
# defines it when the first place is handed it. From then on an object of the first place below the literal asks the run time nothing, and an object below Object.prototype has no getter.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.register = (mid, leaf, read, base, readMid) => { const asked = () => aotOperationCount("operationAOTFillSiteCache") + aotOperationCount("operationAOTGetByIdAndCache"); const plain = { items: 5 }; const heir = leaf(plain); print("heir:", read(heir), Object.getPrototypeOf(heir) === plain); const middle = mid(base); const before = asked(); let wrong = 0; for (let turn = 0; turn < 1000; turn++) wrong += readMid(mid(base)) !== 7; print("below the literal:", readMid(middle), wrong, asked() - before); const early = mid(Object.prototype); print("below Object.prototype:", readMid(early), Object.getPrototypeOf(early) === Object.prototype); print("below an object below the literal:", read(leaf(middle)), read(heir)); Object.defineProperty(base, "size", { get() { return "redefined"; }, configurable: true }); print("redefined:", readMid(middle), readMid(mid(base)), readMid(early), read(heir)); };
