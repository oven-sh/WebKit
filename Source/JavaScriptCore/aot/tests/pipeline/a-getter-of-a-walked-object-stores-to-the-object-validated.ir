    v1 = Integer integer=1
    v2 = NewObject layout=L0
    PropDefine v2, v1 key="first"
    v4 = NewClosure function=f2
    DefineGetter v2, v4 key="counted"
    v6 = Integer integer=2
    PropDefine v2, v6 key="last"
    v8 = FinishObject v2
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="register" [isFreeName]
    v11 = Call v10, -, v0, v8
    Return
}
function f1 name="walk" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v7 = Undefined
    Return v7
  b3():
    v8 = ElemGet v0, v6
    v9 = Call v1, -, v6, v8
