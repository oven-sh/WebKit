# const literal = { first: 1, get counted() { this.last = this.last + 1; return 7 }, last: 2 }
# function walk(walked, report) { for (const key in walked) report(key, walked[key]) }   register(walk, literal)
# The read under the key of a for..in loop is a load behind a test of the enumerator, and says that it runs no code and writes nothing.
# The test fails for every name of an object that has an accessor among its own names, and the read as written, which may run a getter, takes its place.
# FORM: AsRead
# OPTIONS: validate
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.register = (walk, literal) => { const show = walked => { let line = ""; walk(walked, (key, value) => { line += " " + key + "=" + value; }); print(line); }; show(literal); show(literal); show({ first: 1, last: 2 }); show(Object.defineProperty({ first: 1, last: 2 }, "counted", { get() { this.last++; return 8; }, enumerable: true })); Object.defineProperty(literal, "counted", { value: 9, enumerable: true }); show(literal); };
# IR: = IsEnumeratorCurrent
# IR: = EnumeratorGetByVal
# IR: = ElemGet
# CHECK: first=1 counted=7 last=3
# CHECK-NEXT: first=1 counted=7 last=4
# CHECK-NEXT: first=1 last=2
# CHECK-NEXT: first=1 last=2 counted=8
# CHECK-NEXT: first=1 counted=9 last=4
# CHECK-NEXT: exited with 0

