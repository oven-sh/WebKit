layout L0 fields=[{key="counted" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="first" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="last" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] declaredOrder=[1, 0, 2]
function f0 name="main" kind=Module results=[{type=anything}] {
