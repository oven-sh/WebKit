# A file that only stores constants has nothing left to run once every reader holds the constant: nothing calls it, and for the loader it has no body. Nor has a file that never had anything to run. A function that
# is exported and only asked what it is has no way in.
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# OPTIONS: check=VerifyEachPass
# STATISTIC: UnreadVariableStoresRemoved = 1
# CHECK: variable g0 name="named"{{*}}stores=Never{{*}}reads=NeverRead
# CHECK: variable g1 name="declared"{{*}}reads=NeverRead
# CHECK: module m0 path="/main.js"{{*}} body=f0
# CHECK: module m1 path="/named.js" displayPath="named.js" exports=
# CHECK: module m2 path="/declared.js" displayPath="declared.js" exports=
# CHECK-NOT: CallDirect function=f1
# CHECK-NOT: CallDirect function=f2
# CHECK-NOT: creator=Entrypoint{target=f3

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="/named.js" displayPath="named.js" body=f1 exports=[{name="named" variable=g0}]
module m2 path="/declared.js" displayPath="declared.js" body=f2 exports=[{name="declared" variable=g1}]
entry module=m0
variable g0 name="named" module=m1 declared={type=123} flags=[IsImmutable]
variable g1 name="declared" module=m2 declared={type=f3} initialization=Function function=f3 flags=[IsImmutable]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = TypeTest v1 testedType=function
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = Call v4, -, v0, v2
    Return
}

function f1 name="named" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=123
    PutModuleVariable v0 variable=g0
    Return
}

function f2 name="declared" module=m2 kind=Module results=[{type=anything}] {
    Return
}

function f3 name="declared" module=m2 results=[{type=anything}] {
    Return
}
