# An initializer that is put off reads what it takes of the body out of the variable that holds it. The variable is read from then on, whatever its readers were before, and keeps its store.
# FORM: AsRead
# RUN: pipeline CallModules
# OPTIONS: check=VerifyEachPass
# STATISTIC: InitializersDeferred = 1
# CHECK-LABEL: function f1 name="file"
# CHECK: PutModuleVariable {{*}} variable=g1
# CHECK: role=OutlinedBody
# CHECK: GetModuleVariable variable=g1

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/file.js" displayPath="file.js" body=f1 exports=[{name="factory" variable=g2}, {name="made" variable=g0}]
entry module=m0
layout L0 fields=[{key="a" declared={type=number} flags=[IsRequired]}]
variable g0 name="made" module=m1 declared={type=anything|absent} flags=[IsImmutable]
variable g1 name="held" module=m1 declared={type=anything|absent} flags=[IsImmutable]
variable g2 name="factory" module=m1 declared={type=f2} initialization=Function function=f2 flags=[IsImmutable]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = Double number=2.5
    v2 = Call v0, -, v1
    v3 = Call v2, -
    v4 = GetModuleVariable variable=g0
    v5 = CheckInitialized v4 name="made"
    v6 = Call v5, -
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="publish" [isFreeName]
    v9 = Call v8, -, v3, v6
    Return
}

function f1 name="file" module=m1 kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = Double number=1.5
    PropDefine v0, v1 key="a"
    v3 = FinishObject v0
    PutModuleVariable v3 variable=g1
    v5 = GetModuleVariable variable=g2
    v6 = Call v5, -, v3
    PutModuleVariable v6 variable=g0
    Return
}

function f2 name="factory" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure v0 function=f3
    Return v1
}

function f3 name="made" module=m1 kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
