# The program of ../../answers is one in which unions are split, records are passed as their parts, a function that calls itself last becomes a loop, and that loop is separated from its unlikely paths.
# FORM: AsRead
# RUN: compile
# STATISTIC: UnionsSplit >= 1
# STATISTIC: AggregateParametersPromoted >= 1
# STATISTIC: TailRecursionsEliminated >= 1
# STATISTIC: LoopsSeparatedFromUnlikelyPaths >= 1
# STATISTIC: StretchCopiesToEndOfFunction >= 1
# CHECK: image not empty
# PROGRAM-OF: ../../answers/functions-called-with-rare-argument-types.ir
