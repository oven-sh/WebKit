# function outer(list: string[]) { let last = ""; reads(); return last; function reads() { last = list[0] } }  for (let i = 0; i < 3; i++) outer(["a" + i])
# The summaries of effects are solved over bodies that are analyzed against what flow says of parameters: nothing that `reads` does keeps its list. The summary that comes out for `reads` says more:
# the slow way of the read of an element may run code, and that code may keep the list. A validating build summarizes each body once more and compares. It analyzes the body as the solver did. Against
# the solved summaries `outer` would count its list among what lies in memory, and what `reads` writes to the scope that `outer` made would be booked on the list.
# FORM: AsRead
# RUN: compile
# RUN(IR): pipeline ChooseRepresentations
# OPTIONS: validate disable=pass:InlineCalls,flow:ProvenContents
# CHECK: image not empty
# IR: = NewObject {{*}} layout=L0 {{*}} storage=Frame
# IR: = CallDirect {{*}} function=f2
# IR: = ElemGet

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="last" declared={type=undefined|null|string|absent flags=[OmitsNull, OmitsUndefined]}}]
function f0 name="main" kind=Module flags=[IsChecked] results=[{type=anything}] {
    v0 = Integer
    v1 = Convert v0 declared={type=number}
    Jump -> next b1(v1)
  b1(v2: number):
    LoopHint
    v4 = Integer integer=3
    v5 = Less v2, v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = String string="a"
    v7 = Add v6, v2
    v8 = NewArray v7 contents=undefined|null|string
    v9 = CallDirect v8 function=f1
    v10 = Increment v2
    v11 = Convert v10 declared={type=number}
    Jump -> next b1(v11)
  b3():
    v12 = Undefined
    Return v12
}
function f1 name="outer" flags=[IsChecked] parameters=[{type=undefined|null|Array<undefined|null|string> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
    v1 = NewObject layout=L0
    v2 = String string=""
    PutEnvironmentField v1, v2 layout=L0
    v4 = CallDirect v1, v0 function=f2
    v5 = GetEnvironmentField v1 layout=L0
    Return v5
}
function f2 name="reads" flags=[IsChecked] captures=[{type=env L0 flags=[IsFromCompiler]}, {type=undefined|null|Array<undefined|null|string> flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] {
  b0(v0: env L0, v1: undefined|null|Array<undefined|null|string>):
    v2 = Integer
    v3 = ElemGet v1, v2
    v4 = Convert v3 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} illTypedCause=ContainerWriterUnseen
    PutEnvironmentField v0, v4 layout=L0
    v6 = Undefined
    Return v6
}
