# A function that no optimized body refers to loses its body, and one that a closure names keeps it
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline RemoveUnusedResults
# LOSS: MaxOptimizationRounds x0
# STATISTIC: UnreachableFunctionsRemoved = 1

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}

function f1 name="caller" results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = CallDirect v1 function=f2
    v3 = NewClosure function=f3
    v4 = Call v1, -, v3, v2
    Return v4
# CHECK-NOT: function=f2
# CHECK: = NewClosure {{*}}function=f3
}

function f2 name="inlined" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
# CHECK-NOT: b0(
}

function f3 name="closureOnly" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
# CHECK-NEXT: b0(
}
