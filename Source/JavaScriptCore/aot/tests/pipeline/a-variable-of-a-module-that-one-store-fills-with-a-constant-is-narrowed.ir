# const text: string = "a" + "b"; const base: number = 3 + 4; function work(i) { return text + (base + i) }
# The form that NarrowConstantVariables is for, as a front end writes it: the whole build gets to it
# Flow leaves the constants to the pass.
# FORM: AsRead
# OPTIONS: disable=flow:LiteralValues
# RUN: compile
# STATISTIC: NarrowConstantVariablesChanges >= 1
# CHECK: image not empty

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="text" module=m0 declared={type=undefined|null|string|absent flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
variable g1 name="base" module=m0 declared={type=number|absent} flags=[IsImmutable]

function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = String string="ab"
    v3 = Convert v2 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Integer integer=7
    v6 = Convert v5 declared={type=number}
    PutModuleVariable v6 variable=g1
    v8 = String string=""
    v9 = Convert v8 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}
    v10 = Integer
    v11 = Convert v10 declared={type=number}
    Jump -> next b2(v9, v11)
  b2(v12: undefined|null|string, v13: number):
    LoopHint
    v15 = Integer integer=100
    v16 = Less v13, v15
    Branch v16 -> taken b3(| 0), notTaken b6(| 0)
  b3(v17):
    Jump -> next b4()
  b4():
    v18 = Call v1, -, v17 calleeName="work"
    v19 = Convert v18 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}
    Jump -> next b5()
  b5():
    v20 = Increment v17
    v21 = Convert v20 declared={type=number}
    Jump -> next b2(v19, v21)
  b6(v22):
    Jump -> next b7()
  b7():
    v23 = Builtin builtin=GlobalThis
    v24 = PropGet v23 key="print" [isFreeName]
    v25 = Call v24, -, v12 calleeName="print"
    v26 = Undefined
    Return v26
}

function f1 name="work" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="text"
    v3 = GetModuleVariable variable=g1
    v4 = CheckInitialized v3 name="base"
    v5 = Add v4, v0
    v6 = Add v2, v5
    v7 = Convert v6 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}
    Return v7
}
