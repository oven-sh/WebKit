# declare const input: any;
# function make(n: number) { return { a: n, b: 2 }; }
# const o = make(input);
# let sum = 0;
# for (let i = 0; i < 1000; i++) sum += o.a;
# (globalThis as any).answer = sum;
# The object is made by code that runs once, and the loop gets tests: behind one test of the slot it reads a double. So the field keeps its form, and the one store by name behind the allocation is its price.
# FORM: AsRead
# RUN: pipeline Select
# OPTIONS: check=VerifyEachPass
# STATISTIC: InitialValuesStoredBehindAllocations = 1
# CHECK: layout L0 {{*}}{key="a" declared={type=number} flags=[IsRequired, IsEnforced]
# CHECK-LABEL: function f0 module=m0 kind=Module
# CHECK: : number = GetSlot {{*}}key="a" receivers=[L0] level=Expected

typesite w0 module=m0 position=105 kind=Variable
typesite w1 module=m0 position=40 kind=Parameter function=f1
typesite w2 module=m0 position=26 kind=Result
typesite w3 module=m0 position=88 kind=CallResult
typesite w4 module=m0 position=123 kind=Variable
layout L0 module=m0 position=60 fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = Call v1, -, v4 calleeName="make"
    v6 = Convert v5 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    v7 = Integer
    v8 = Convert v7 declared={type=number site=w0}
    v9 = Integer
    v10 = Convert v9 declared={type=number site=w4}
    Jump -> next b2(v8, v10)
  b2(v11: number, v12: number):
    LoopHint
    v14 = Integer integer=1000
    v15 = Less v12, v14
    Branch v15 -> taken b3(| 0), notTaken b6(| 0)
  b3(v16):
    Jump -> next b4()
  b4():
    v17 = PropGet v6 key="a"
    v18 = Add v11, v17
    v19 = Convert v18 declared={type=number site=w0}
    Jump -> next b5()
  b5():
    v20 = Increment v16
    v21 = Convert v20 declared={type=number site=w4}
    Jump -> next b2(v19, v21)
  b6(v22):
    Jump -> next b7()
  b7():
    v23 = Builtin builtin=GlobalThis
    v24 = PropGet v23 key="globalThis" [isFreeName]
    v25 = Convert v24 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v26 = Convert v25 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    PropSet v26, v11 key="answer"
    v28 = Undefined
    Return v28
}
function f1 name="make" module=m0 position=26 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=number}
    v2 = Integer integer=2
    v3 = Convert v2 declared={type=number}
    v4 = NewObject -, v1, v3 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = Convert v5 declared={type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}
entry module=m0
