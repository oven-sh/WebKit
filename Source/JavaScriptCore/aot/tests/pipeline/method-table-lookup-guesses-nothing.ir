# class E0 { m(x: number) { return x * 1.5 } } .. class E5 { m(x: number) { return x * 6.5 } }  function call(o: E0 | .. | E5, x: number) { return o.m(x) }
# Six classes with a method of one name that nobody can replace: more than a switch on the shape takes, so the call goes through the method table.
# The table sends a receiver to the lookup of the selector only where it does not find what the class definitions say, so the lookup calls by name and guesses nothing.
# Then nothing but entrypoints enters a method, each with a tail call and each returning any value: every method returns its result in that form, no entrypoint keeps a frame to box it,
# and where the locations agree the table names the method itself
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline ChooseCallingConventions
# STATISTIC: TableCalls = 1
# STATISTIC: TableEntrypoints = 6
# STATISTIC: ReturnCallsDemoted = 0
# CHECK: f3 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: f5 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: f7 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: f9 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: f11 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: f13 Direct (xmm0:Double) -> (rax:JSValue) boxed-result
# CHECK: = CallTable v0, v1 {{*}}key="m" receivers=[L0, L1, L2, L3, L4, L5]
# CHECK-LABEL: role=TableLookup
# CHECK-NOT: TypeTest
# CHECK-NOT: CallDirect
# CHECK: Return

layout L0 kind=Instance name="E0" module=m0 position=10 constructor=f2
layout L1 kind=Instance name="E1" module=m0 position=60 constructor=f4
layout L2 kind=Instance name="E2" module=m0 position=110 constructor=f6
layout L3 kind=Instance name="E3" module=m0 position=160 constructor=f8
layout L4 kind=Instance name="E4" module=m0 position=210 constructor=f10
layout L5 kind=Instance name="E5" module=m0 position=260 constructor=f12
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L0
    v5 = NewClosure function=f3
    DefineMethod v4, v5 layout=L0 side=Prototype key="m"
    v7 = FinishClass v4 layout=L0
    v8 = Construct v7, -
    v9 = Convert v8 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v10 = CallDirect v9, v2 function=f1
    v11 = NewClosure function=f4
    v12 = NewClass v11 layout=L1
    v13 = NewClosure function=f5
    DefineMethod v12, v13 layout=L1 side=Prototype key="m"
    v15 = FinishClass v12 layout=L1
    v16 = Construct v15, -
    v17 = Convert v16 declared={type=L1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v18 = CallDirect v17, v2 function=f1
    v19 = NewClosure function=f6
    v20 = NewClass v19 layout=L2
    v21 = NewClosure function=f7
    DefineMethod v20, v21 layout=L2 side=Prototype key="m"
    v23 = FinishClass v20 layout=L2
    v24 = Construct v23, -
    v25 = Convert v24 declared={type=L2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v26 = CallDirect v25, v2 function=f1
    v27 = NewClosure function=f8
    v28 = NewClass v27 layout=L3
    v29 = NewClosure function=f9
    DefineMethod v28, v29 layout=L3 side=Prototype key="m"
    v31 = FinishClass v28 layout=L3
    v32 = Construct v31, -
    v33 = Convert v32 declared={type=L3 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v34 = CallDirect v33, v2 function=f1
    v35 = NewClosure function=f10
    v36 = NewClass v35 layout=L4
    v37 = NewClosure function=f11
    DefineMethod v36, v37 layout=L4 side=Prototype key="m"
    v39 = FinishClass v36 layout=L4
    v40 = Construct v39, -
    v41 = Convert v40 declared={type=L4 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v42 = CallDirect v41, v2 function=f1
    v43 = NewClosure function=f12
    v44 = NewClass v43 layout=L5
    v45 = NewClosure function=f13
    DefineMethod v44, v45 layout=L5 side=Prototype key="m"
    v47 = FinishClass v44 layout=L5
    v48 = Construct v47, -
    v49 = Convert v48 declared={type=L5 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v50 = CallDirect v49, v2 function=f1
    v51 = Builtin builtin=GlobalThis
    v52 = PropGet v51 key="publish" [isFreeName]
    v53 = Call v52, -, v10, v18, v26, v34, v42, v50
    Return
}
function f1 name="call" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0|L1|L2|L3|L4|L5}, {type=number}] results=[{type=anything}] {
  b0(v0: L0|L1|L2|L3|L4|L5, v1: number):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0, v1 calleeKey="m" calleeName="m"
    Return v3
}
function f2 name="E0" module=m0 position=10 kind=BaseConstructor flags=[HasNewTarget] thisType={type=anything} results=[{type=object}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f3 name="m" module=m0 position=20 kind=Method length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Double number=1.5
    v2 = Mul v0, v1
    Return v2
}
