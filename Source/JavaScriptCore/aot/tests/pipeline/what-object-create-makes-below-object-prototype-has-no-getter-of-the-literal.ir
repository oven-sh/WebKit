# const members = { get size() { return this.items } }   function make(below) { const made = Object.create(below); made.items = 7; return made }   function read(made) { return made.size }   register(() => make(Object.prototype), () => make(members), read, members)   read(make(members))
# One place hands Object.create the Object.prototype of the realm and a literal. The class of the objects that are made there has the members of the literal, and the literal becomes its prototype
# object when the run time is first handed it. The first object of the class is born below an object that no program holds, so the operation hears of it whatever the call is handed. An object
# below Object.prototype has no class, like one below null: read() finds no getter above it, before the class has its prototype object and after, also where the program sets the prototype that
# the object has again, and the class awaits the literal as before. From the second object below either on, no object asks the run time.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN(IR): pipeline Select
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.register = (belowObjectPrototype, belowMembers, read, members) => { const first = belowObjectPrototype(); print("first:", read(first), Object.getPrototypeOf(first) === Object.prototype, Object.keys(first).join()); Object.setPrototypeOf(first, Object.prototype); Reflect.setPrototypeOf(first, Object.prototype); first.__proto__ = Object.prototype; print("set again:", read(first)); let wrong = 0; for (let turn = 0; turn < 1000; turn++) wrong += read(belowObjectPrototype()) !== undefined; const second = belowMembers(); print("second:", read(first), read(second), Object.getPrototypeOf(second) === members, wrong); for (let turn = 0; turn < 1000; turn++) wrong += read(turn % 2 ? belowMembers() : belowObjectPrototype()) !== (turn % 2 ? 7 : undefined); print("in turns:", read(first), read(second), wrong); const calls = aotOperationCount("operationAOTSetLiteralPrototype"); print(calls > 0 && calls < 10 ? "a few objects asked the run time" : calls); Object.defineProperty(members, "size", { get() { return "redefined"; }, configurable: true }); print("redefined:", read(first), read(second), read(belowMembers()), read(belowObjectPrototype())); };
