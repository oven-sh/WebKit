# CHECK-NEXT: below Object.prototype: 0 0
# CHECK-NEXT: below null: 0 a few objects asked the run time
# CHECK-NEXT: undefined undefined 7 true
# CHECK-NEXT: below the literal: 0 0
# CHECK-NEXT: exited with 0

