# const members = { get size() { return this.items } }   function make(below) { const made = Object.create(below); made.items = 7; return made }   function read(made) { return made.size }   register(() => make(null), () => make(Object.prototype), () => make(members), read, members)   read(make(members))
# One place hands Object.create null first, then the Object.prototype of the realm, then a literal. The object below null is the first that the operation hears of, and it has no class. From
# then on the objects of the place are born below Object.prototype until the literal comes: an object below Object.prototype asks the run time nothing, before a collection and behind one.
# An object below null asks it where no object before it has since the last collection. The literal defines the class when it comes, and the objects below it ask nothing either.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.register = (belowNull, belowObjectPrototype, belowMembers, read, members) => { const calls = () => aotOperationCount("operationAOTSetLiteralPrototype"); const first = belowNull(); const second = belowObjectPrototype(); print(Object.getPrototypeOf(first) === null, Object.getPrototypeOf(second) === Object.prototype, read(first), read(second), calls()); let wrong = 0; let before = calls(); for (let turn = 0; turn < 3000; turn++) { if (turn % 1000 === 500) gc(); wrong += read(belowObjectPrototype()) !== undefined; } print("below Object.prototype:", wrong, calls() - before); before = calls(); for (let turn = 0; turn < 3000; turn++) { if (turn % 1000 === 500) gc(); wrong += Object.getPrototypeOf(belowNull()) !== null; } print("below null:", wrong, calls() - before < 10 ? "a few objects asked the run time" : calls() - before); const third = belowMembers(); print(read(first), read(second), read(third), Object.getPrototypeOf(third) === members); before = calls(); for (let turn = 0; turn < 3000; turn++) { if (turn % 1000 === 500) gc(); wrong += read(belowMembers()) !== 7; } print("below the literal:", wrong, calls() - before); };
