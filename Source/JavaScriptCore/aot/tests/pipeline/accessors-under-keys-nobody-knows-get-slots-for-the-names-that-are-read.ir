# function build(name) { const made = Object.create(null); Object.defineProperty(made, name, { get: () => name + "!", enumerable: true, configurable: true }); return made }
# const held = build("fi" + "rst")   function read() { return held.first }   function hand() { return held }   function plain() { return Object.create(null) }
# Object.create stands in the program as a literal with a layout of its own until the flow analysis has run. Nobody knows the key of the definition, but whatever it is, it names an accessor of one form
# whose getter is a closure of f5. So each name that a read asks of the object gets a field for such an accessor, and the definition finds the field by its name at run time.
# The object of plain() gets no accessor: Object.create makes it, as it is written.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.register = (read, hand, plain, build) => { const o = hand(); print(read(), o.first, Object.keys(o).join(), Object.getPrototypeOf(o)); const other = build("second"); print(other.second, other.first, Object.keys(other).join()); delete o.first; print(read()); print(Object.getPrototypeOf(plain()), Object.keys(plain()).length); };
# FLOW: layout {{*}}key="first" {{*}}form=[IsAccessor]{{*}}IsOfCreatedObject
# FLOW: function f1 name="build"
# FLOW: = NewObject layout=
# FLOW: SetLiteralPrototype {{*}}[refusesOtherValues]
# FLOW: function f4 name="plain"
# FLOW-NOT: NewObject
# FLOW: = Call {{*}}
# IR: name="read"
# IR: = IsSlotFilled {{*}} key="first"
# CHECK: first! first! first null
# CHECK-NEXT: second! undefined second
# CHECK-NEXT: undefined
# CHECK-NEXT: null 0
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="get" declared={type=anything} flags=[IsRequired]}, {key="enumerable" declared={type=anything} flags=[IsRequired]}, {key="configurable" declared={type=anything} flags=[IsRequired]}]
variable g0 name="held" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = String string="fi"
    v5 = String string="rst"
    v6 = Add v4, v5
    v7 = Call v0, -, v6
    PutModuleVariable v7 variable=g0
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="register" [isFreeName]
    v11 = Call v10, -, v1, v2, v3, v0
    Return
}
function f1 name="build" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = Null
    v4 = Call v2, v1, v3
    v5 = NewClosure v0 function=f5
    v6 = Boolean boolean=true
    v7 = NewObject -, v5, v6, v6 layout=L0 fields=[0, 1, 2]
    v8 = FinishObject v7
    v9 = Builtin builtin=ObjectDefineProperty
    v10 = Call v9, v1, v4, v0, v8
    Return v4
}
function f2 name="read" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="first"
    Return v1
}
function f3 name="hand" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f4 name="plain" results=[{type=anything}] {
    v0 = Builtin builtin=Object
    v1 = Builtin builtin=ObjectCreate
    v2 = Null
    v3 = Call v1, v0, v2
    v4 = Upcast v3 castType=anything
    Return v4
}
function f5 kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    v1 = String string="!"
    v2 = Add v0, v1
    Return v2
}
