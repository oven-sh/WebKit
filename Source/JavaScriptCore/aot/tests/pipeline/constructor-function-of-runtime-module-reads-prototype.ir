# function Made() { this.x = 1 } in a module of the runtime has no prototype property until the module defines one, perhaps as an accessor: whoever constructs it reads the property each time and compares nothing with the closure. The same function in the program is allocated without a read
# TODO: operations: the constructor function of a runtime module is compiled like one of the program, without the read of `prototype` that native code may have changed
# RUN: pipeline CheckPlacement
# CHECK-LABEL: function f0 name="main"
# CHECK: : L1 = NewObject layout=L1
# CHECK: [[closure]]: f2 = NewClosure function=f2
# CHECK: [[prototype]]: object = GetConstructPrototype [[closure]] layout=L0
# CHECK: = NewObject [[prototype]] layout=L0
# CHECK: : boolean = InstanceOf {{*}}, [[closure]]
# CHECK-LABEL: function f1 name="constructOfRuntime"

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="bun:sqlite" displayPath="bun:sqlite" kind=RuntimeSource exportRule=RuntimeModule requireResult=ModuleExports runtimeModule=BunSqlite body=f4
entry module=m0
layout L0 kind=Instance name="OfRuntime" constructor=f2 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="OfProgram" constructor=f3 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f3
    v3 = Construct v2
    v4 = InstanceOf v3, v2
    v5 = CallDirect function=f1
    v6 = Call v1, -, v3, v4, v5
    Return
}
function f1 name="constructOfRuntime" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Construct v0
    v2 = InstanceOf v1, v0
    Return v2
}
function f2 name="OfRuntime" module=m1 flags=[HasThis] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f3 name="OfProgram" flags=[HasThis] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f4 name="sqlite" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
