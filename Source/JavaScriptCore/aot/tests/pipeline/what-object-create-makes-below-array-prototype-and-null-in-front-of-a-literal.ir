# const members = { get size() { return this.items } }, others = { get size() { return this.items } }
# function make(below) { const made = Object.create(below); made.items = 7; return made }   function makeOther(below) { const made = Object.create(below); made.items = 7; return made }
# function read(made) { return made.size }   function readOther(made) { return made.size }
# register([() => make(Array.prototype), () => make(Object.prototype), () => make(members), read, members], [() => makeOther(null), () => makeOther(Object.prototype), () => makeOther(others), readOther, others])
# read(make(members)); readOther(makeOther(others))
# Two places hand Object.create what is no prototype object of a class before they hand it their literal. Array.prototype is no object that a class of created objects is made of: the first
# place has no class from then on, and its objects are read by name whatever they are made below. An object below null has no class and leaves the second place its class: the literal defines
# it when it comes. At either place only the first object below each of the three asks the run time.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.register = (...places) => { const calls = () => aotOperationCount("operationAOTSetLiteralPrototype"); for (const [belowFirst, belowObjectPrototype, belowLiteral, read, literal] of places) { const before = calls(); const first = belowFirst(); const second = belowObjectPrototype(); print(read(first), read(second), Object.getPrototypeOf(second) === Object.prototype, Object.keys(second).join()); let wrong = 0; for (let turn = 0; turn < 1000; turn++) wrong += read(turn % 2 ? belowFirst() : belowObjectPrototype()) !== undefined; const third = belowLiteral(); print(read(first), read(second), read(third), Object.getPrototypeOf(third) === literal, wrong); for (let turn = 0; turn < 1500; turn++) wrong += read([belowFirst, belowObjectPrototype, belowLiteral][turn % 3]()) !== (turn % 3 === 2 ? 7 : undefined); print(read(first), read(second), read(third), wrong, calls() - before < 10 ? "a few objects asked the run time" : calls() - before); Object.defineProperty(literal, "size", { get() { return "redefined"; }, configurable: true }); print(read(first), read(second), read(third), read(belowLiteral()), read(belowObjectPrototype()), read(belowFirst())); } };
