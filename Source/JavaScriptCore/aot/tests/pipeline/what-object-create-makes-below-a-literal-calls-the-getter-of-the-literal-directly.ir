# const members = { get size() { return this.items } }   function make() { const made = Object.create(members); made.items = 7; return made }   function read(made) { return made.size }   register(make, read, members)   read(make())
# What Object.create makes at one place is an instance of a class without a constructor. The members of the class are what the program defines on the object that the call is handed, and the names
# that are stored into the instances are its fields. The run time takes the first object that the call is handed for the prototype object of the class and sets the guards of the class by what it
# finds there, so read() calls the getter behind a test of the layout and of one bit. An object below another object, and every object once the getter is redefined, is read by name.
# FORM: AsRead
# RUN(FLOW): pipeline ApplyFlowResults
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.register = (make, read, members) => { const first = make(); print(read(first), read(make()), Object.getPrototypeOf(first) === members, Object.keys(first).join()); Object.setPrototypeOf(first, { size: "elsewhere" }); print(read(first), read(make())); Object.defineProperty(members, "size", { get() { return "redefined"; }, configurable: true }); print(read(first), read(make())); delete members.size; print(read(make())); };
# FLOW: layout {{*}}kind=Instance {{*}}key="items" {{*}}IsOfCreatedObject{{*}}classFlow={evaluations=AtMostOnce members=[{key="size" kind=Getter function=f3}]
# FLOW: function f1 name="make"
# FLOW: = NewObject layout=
# FLOW: SetLiteralPrototype {{*}}[refusesOtherValues]
# IR: = AreMembersUnchanged conditions=[{layout={{*}} key="size"}
# CHECK: 7 7 true items
# CHECK-NEXT: elsewhere 7
# CHECK-NEXT: elsewhere redefined
# CHECK-NEXT: undefined
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="size" declared={type=anything} flags=[IsRequired]}]
variable g0 name="members" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = NewClosure function=f3
    DefineGetter v0, v1 key="size"
    v3 = FinishObject v0
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f1
    v6 = NewClosure function=f2
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="register" [isFreeName]
    v9 = Call v8, -, v5, v6, v3
    v10 = Call v5, -
    v11 = Call v6, -, v10
    Return
}
function f1 name="make" results=[{type=anything}] {
    v0 = Builtin builtin=Object
    v1 = Builtin builtin=ObjectCreate
    v2 = GetModuleVariable variable=g0
    v3 = Call v1, v0, v2
    v4 = Integer integer=7
    PropSet v3, v4 key="items"
    Return v3
}
function f2 name="read" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="size"
    Return v1
}
function f3 name="size" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="items"
    Return v1
}
