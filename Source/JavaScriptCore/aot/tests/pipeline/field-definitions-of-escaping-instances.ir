# CHECK-NEXT: PutSlotOrAdd [[context]], [[context]], [[text]] key="text" receivers=[L0]
# CHECK-NEXT: = Call {{*}}, -, [[context]]
function f5 name="Leaks" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    v3 = Convert v2 declared={type=L1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = CallDirect v3 function=f6
    Return v3
}
function f6 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=L1 flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: L1):
    v1 = Integer integer=1
    PropDefine v0, v1 key="first"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v0
    PropDefine v0, v5 key="second"
    v7 = Integer integer=3
    PropDefine v0, v7 key="third"
    v9 = Undefined
    Return v9
}
function f7 name="leaks" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    v1 = Construct v0
    Return v1
}
