variable g0 name="Sum" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    PutModuleVariable v2 variable=g0
    v4 = CallDirect function=f3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = NewClosure function=f4
    v8 = Call v6, -, v7
    v9 = Call v6, -, v4
    v10 = CallDirect function=f5
    Return
}
function f1 name="Sum" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = CallDirect v3 function=f2
    v5 = PropGet v1 key="x"
    v6 = PropGet v1 key="y"
    v7 = Add v5, v6
    PropSet v3, v7 key="total"
    PropSet v3, v1 key="source"
    Return v3
}
function f2 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=object written=L0 flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: object):
    v1 = Integer
    PropDefine v0, v1 key="total"
    v3 = Undefined
    PropDefine v0, v3 key="source"
    Return v3
}
function f3 name="known" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v2 = FinishObject v1
    v3 = GetModuleVariable variable=g0
    v4 = Construct v3, -, v2
    Return v4
}
function f4 name="unknown" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Construct v1, -, v0
    Return v2
}
