# A construction whose arguments nobody knows enters the generic version of the constructor. The caller allocates all the same, so the definitions and stores of the constructor become the field list of the allocation
# FORM: AsRead
# RUN: pipeline Select
# STATISTIC: FlowGenericVersions = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Sum" constructor=f1 fields=[{key="total" declared={type=anything} flags=[IsRequired]}, {key="source" declared={type=anything} flags=[IsRequired]}]
