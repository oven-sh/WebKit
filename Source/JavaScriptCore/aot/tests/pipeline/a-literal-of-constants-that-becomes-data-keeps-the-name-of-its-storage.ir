# A list literal names the storage that it is born with, and what is typed from it names it too. The data record that takes the place of the literal says the same, so those types are still what their rules give
# RUN: pipeline EmbedConstantCollections
# RUN(VERIFIED): pipeline PlanSlots
# OPTIONS: check=VerifyEachPass disable=flow:ProvenContents

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
data d0 root=Array{contents=Array<number> elements=[Array{contents=number elements=[Number{value=1}, Number{value=2}]}, Array{contents=number elements=[Number{value=3}, Number{value=4}]}]} module=m0
data d1 root=Array{contents=Array<number> elements=[Array{contents=number elements=[Number{value=1.5}, Number{value=2}]}, Array{contents=number elements=[Number{value=3}, Number{value=4.25}]}]} module=m0
function f0 module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Data data=d0
    v2 = Call v0, -, v1 [isNeverInlined]
    v3 = NewClosure function=f2
    v4 = Data data=d1
    v5 = Call v3, -, v4 [isNeverInlined]
    v6 = Add v2, v5
    Return v6
}
# CHECK-LABEL: function f0
# CHECK: [[integers]]: Array<int[1, 4], Int32> = Data data={{*}} arrayStorage=Int32
# CHECK-NEXT: : Array<int[1, 4], Int32, pristine[Storage, Names, Dense]> = AssumeType [[integers]]
# CHECK: [[fractions]]: Array<{{*}}, Double> = Data data={{*}} arrayStorage=Double
# CHECK-NEXT: , Double, pristine[Storage, Names, Dense]> = AssumeType [[fractions]]
# VERIFIED: = Data data={{*}} arrayStorage=Int32

function f1 name="readsIntegers" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = ElemGet v0, v1
    v4 = ElemGet v3, v1
    v5 = ElemGet v0, v2
    v6 = ElemGet v5, v2
    v7 = Add v4, v6
    Return v7
}
function f2 name="readsFractions" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = ElemGet v0, v1
    v4 = ElemGet v3, v1
    v5 = ElemGet v0, v2
    v6 = ElemGet v5, v2
    v7 = Add v4, v6
    Return v7
}
