    v39 = Call v2, -, v0
    v40 = Call v2, -, v0
    v41 = Call v2, -, v0
    v42 = Call v2, -, v0
    v43 = CallDirect v0 function=f5
    Return v43
}
# CHECK-LABEL: function f1 name="compact"
# CHECK: = CallDirect v0 function=f5

