# A run that only checks a program that nothing refuses reports nothing, emits no code and makes no image (check-only-twin-is-compiled.ir: the same program without the word)
# RUN: compile CodeBytesEmitted
# OPTIONS: check-only
# CHECK-NOT: diagnostic
# CHECK: image empty
# CHECK: statistic CodeBytesEmitted 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    Return
}
function f1 name="kept" results=[{type=anything}] {
    Return
}
