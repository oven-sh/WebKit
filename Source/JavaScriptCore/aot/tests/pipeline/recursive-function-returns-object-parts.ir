# The wrapper of a function that calls itself stays what it was made as: it calls the worker and puts the parts together.
# CHECK-LABEL: function f1 name="walk" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[walk]] layout=L0} {
# CHECK-NEXT: b0(
# CHECK-NEXT: [[parts]]:{{*}}= CallDirect v0, v1 function=[[walk]]
# CHECK-NEXT: = ResultAt [[parts]]
# CHECK-NEXT: = ResultAt [[parts]] index=1
# CHECK-NEXT: = NewObject
# CHECK-NEXT: Return
# CHECK-LABEL: function f2 name="pairs" module=m0 position=218 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[pairs]]} {
# CHECK-NEXT: b0(
# CHECK-NEXT: [[parts]]:{{*}}= CallDirect v0, v1 function=[[pairs]]
# CHECK-NEXT: = ResultAt [[parts]]
# CHECK-NEXT: = ResultAt [[parts]] index=1
# CHECK-NEXT: = NewArray
# Whoever takes the result apart calls the workers, also behind a level that was copied in.
# CHECK-LABEL: function f3 name="total"
# CHECK-NOT: function=f1
# CHECK-NOT: function=f2
# CHECK-NOT: = NewObject
# CHECK-NOT: = NewArray
# CHECK-LABEL: function f4
# Each worker calls itself and makes nothing.
# CHECK-LABEL: name="walk" module=m0 role=ResultWorker
# CHECK-NOT: function=f1
# CHECK-NOT: = NewObject
# CHECK: = CallDirect {{*}} function=[[walk]]
# CHECK-NOT: function=f1
# CHECK-NOT: = NewObject
# CHECK-LABEL: name="pairs" module=m0 position=218 role=ResultWorker
# CHECK-NOT: function=f2
# CHECK-NOT: = NewArray
# CHECK: = CallDirect {{*}} function=[[pairs]]
# CHECK-NOT: function=f2
# CHECK-NOT: = NewArray
# CHECK-LABEL: role=GenericEntrypoint
