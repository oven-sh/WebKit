# function Made() { this.inner = 1 }   readsWhatWasMade(new Made()); readsWhatIsGiven(given); register({ inner: 2 }, readsWhatWasMade, readsWhatIsGiven)      each: function (rule) { return rule.inner }
# One record of the program has an `inner`, so the name predicts its layout. What a plain function without a layout constructs arrives too, an ordinary object that the test for the layout turns away
# each time: no layout is predicted there, and the read goes by name. Beside it: the same read where no such object arrives gets its test
# RUN: pipeline PlaceTypeTests

module m0 path="/application.js" displayPath="application.js" body=f0
entry module=m0
layout L0 name="Rule" module=m0 fields=[{key="inner" declared={type=anything}}]

function f0 name="" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = Integer integer=2
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure function=f1
    v5 = Construct v4
    v6 = NewClosure function=f2
    v7 = Call v6, -, v5
    v8 = NewClosure function=f3
    v9 = PropGet v0 key="given" [isFreeName]
    v10 = Call v8, -, v9
    v11 = Call v1, -, v3, v6, v8
    Return v11
}

function f1 name="Made" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=1
    PropSet v0, v1 key="inner" mode=Sloppy
    Return
}

function f2 name="readsWhatWasMade" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="inner"
    Return v1
}

function f3 name="readsWhatIsGiven" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="inner"
    Return v1
}
# CHECK-LABEL: name="readsWhatWasMade"
# CHECK-NOT: = TypeTest
# CHECK-LABEL: name="readsWhatIsGiven"
# CHECK: = TypeTest {{*}} testedType={{*}}L0
