# function multiply(a: number, b: number) { return a * b }   const triple = multiply.bind(null, 3)   function run(n) { return triple(n) }   function hand() { return triple }   multiply(2, 2)
# `multiply` takes its parameters as numbers and not as values. It is a plain function, which `new` can construct, and so can what `bind` makes of it:
# the run time answers that, and hands the bound arguments on as it finds them in the closure: as values. So the closure of the bound function holds the 3 as a value,
# and the body of the bound function, which whoever binds has shown a number, takes it for one.
# FORM: AsRead
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.register = (run, hand) => { const triple = hand(); print(run(5), triple(6), triple.name, triple.length); const made = new triple(7); print(typeof made, Object.getPrototypeOf(made) === Object.getPrototypeOf(new (Object.getPrototypeOf(made).constructor)(1, 1))); print(made instanceof triple); };
