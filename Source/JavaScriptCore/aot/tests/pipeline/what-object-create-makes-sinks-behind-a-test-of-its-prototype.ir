# const members = { items: 0 }   function turn(i) { const made = Object.create(members); made.items = i; return made.items }
# The object takes its prototype where it is made and stays virtual: the test of the prototype becomes a comparison of what the call was handed with the prototype of the class, and the object is made only behind that test failing.
# FORM: AsRead
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.register = (turn, members) => { print(turn(1), turn(2)); members.other = 3; print(turn(4)); };
# IR: function f1 name="turn"
# IR: = IsPrototypeOfClass v{{*}} layout=
# IR-NOT: NewObject
# IR: TestAndBranch
# CHECK: 1 2
# CHECK-NEXT: 4
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="items" declared={type=anything} flags=[IsRequired]}]
variable g0 name="members" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = Integer integer=0
    PropDefine v0, v1 key="items"
    v3 = FinishObject v0
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f1
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="register" [isFreeName]
    v8 = Call v7, -, v5, v3
    Return
}
function f1 name="turn" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectCreate
    v3 = GetModuleVariable variable=g0
    v4 = Call v2, v1, v3
    PropSet v4, v0 key="items"
    v6 = PropGet v4 key="items"
    Return v6
}
