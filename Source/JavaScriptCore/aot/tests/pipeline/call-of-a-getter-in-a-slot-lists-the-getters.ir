# function make(n, other) { const o = { plain: 1 }; if (other) define(o, "doubled", { get() { return n * 2 } }); else define(o, "doubled", { get() { return n * 3 } }); return o }   function read() { return held.doubled }
# The slot of the accessor holds a pair whose getter is a closure of f4 or of f5. The read becomes a load of the getter out of the pair and a call by value.
# THE CALL LISTS BOTH AND NOBODY ELSE: the plan has promised the effects of these two getters (effectsAfterRewrite()), and whoever places a test across the read has relied on that.
# A call that lists nobody is unknown code to everybody who reads the body afterwards: the verifier then refuses a guard that is used again behind it (GuardNotAvailable).
# FORM: AsRead
# RUN(IR): pipeline PlaceTypeTests
# RUN: run-in-shell globalThis.seed = 4; globalThis.register = (read, hand) => { print(read(), hand().doubled); };
# IR: name="read"
# IR: = GetSlotGetter {{*}} key="doubled"
# IR: = Call {{*}} callees=[f4, f5]
# IR: name="hand"
# CHECK: 8 8
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="plain" declared={type=anything} flags=[IsRequired]}]
variable g0 name="held" module=m0 declared={type=anything} flags=[IsImmutable]
variable g1 name="spare" module=m0 declared={type=anything} flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="seed" [isFreeName]
    v5 = Boolean boolean=true
    v6 = Call v0, -, v4, v5
    PutModuleVariable v6 variable=g0
    v8 = PropGet v3 key="register" [isFreeName]
    v9 = Integer integer=1
    v10 = Boolean boolean=false
    v11 = Call v0, -, v9, v10
    PutModuleVariable v11 variable=g1
    v13 = Call v8, -, v1, v2
    Return
}
function f1 name="make" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = ToBoolean v1
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = NewClosure v0 function=f4
    DefineGetter v3, v5 key="doubled"
    Jump -> next b3()
  b2():
    v7 = NewClosure v0 function=f5
    DefineGetter v3, v7 key="doubled"
    Jump -> next b3()
  b3():
    v9 = FinishObject v3
    Return v9
}
function f2 name="read" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="doubled"
    Return v1
}
function f3 name="hand" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f4 name="doubled" kind=Getter captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    v2 = Mul v0, v1
    Return v2
}
function f5 name="tripled" kind=Getter captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=3
    v2 = Mul v0, v1
    Return v2
}
