# function takesText(text: string) { return text + "!"; }   function takesCount(count: number) { return count + 1; }   function keeps(text: string) { return () => text; }
# An expected type says which test is worth making, so the program means the same whichever types are expected. Under testing=ShuffleExpectedTypes each expected type of the program's own code
# becomes another of them, drawn from the seed: here the two trade places, in the record of the parameter and in the test at the entrance alike.
# `keeps` hands its parameter on to a capture of the type of the parameter without a conversion: its test stays as it was read, and only what is expected of the parameter changes.
# FORM: AsRead
# OPTIONS: testing=ShuffleExpectedTypes layout-seed=1
# RUN: pipeline TypeValues
# CHECK-LABEL: function f1 name="takesText"
# CHECK: parameters=[{type=number site=w0 flags=[IsExpected]}]
# CHECK: = Check v0 expectedType=number site=w0
# CHECK-LABEL: function f2 name="takesCount"
# CHECK: parameters=[{type=string site=w1 flags=[IsExpected]}]
# CHECK: = Check v0 expectedType=string site=w1
# CHECK-LABEL: function f3 name="keeps"
# CHECK: parameters=[{type=number site=w2 flags=[IsExpected]}]
# CHECK: = Check v0 expectedType=string site=w2

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Parameter
typesite w2 module=m0 position=30 kind=Parameter

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="keep" [isFreeName]
    v5 = Call v4, -, v0, v1, v2
    Return v5
}
function f1 name="takesText" module=m0 flags=[IsChecked] length=1 parameters=[{type=string site=w0}] results=[{type=anything}] {
    v1 = String string="!"
    v2 = Add v0, v1
    Return v2
}
function f2 name="takesCount" module=m0 flags=[IsChecked] length=1 parameters=[{type=number site=w1}] results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = Add v0, v1
    Return v2
}
function f3 name="keeps" module=m0 flags=[IsChecked] length=1 parameters=[{type=string site=w2}] results=[{type=anything}] {
    v1 = NewClosure v0 function=f4
    Return v1
}
function f4 name="kept" module=m0 kind=Arrow flags=[IsChecked] captures=[{type=string}] results=[{type=anything}] {
    Return v0
}
