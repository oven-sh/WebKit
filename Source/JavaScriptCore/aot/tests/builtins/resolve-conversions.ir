# An operand outside its parameter's type is converted by operations in front of the call, in operand order, and only where the conversion cannot change what the built-in already read
# FORM: Prepared
# RUN: pass ResolveBuiltins
# RUN(PLACED): pass ResolveBuiltins PlaceTypeTests
# CHECK: outcome: Changed
# STATISTIC: BuiltinConversionsInserted = 19

module m0 path="main.js" displayPath="main.js"
function f0 name="toNumber" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=MathFloor
    v2 = Call v1, -, v0
    Return v2
# CHECK: [[number0]]: number = ToNumber v0
# CHECK-NEXT: v2: {{*}} = CallBuiltin -, [[number0]] overload=MathFloor/0
}

function f1 name="toString" parameters=[{type=number}] results=[{type=anything}] {
    v1 = Builtin builtin=DateParse
    v2 = Call v1, -, v0
    Return v2
# CHECK: [[text1]]: string = ToString v0
# CHECK-NEXT: v2: number = CallBuiltin -, [[text1]] overload=DateParse/0
}

