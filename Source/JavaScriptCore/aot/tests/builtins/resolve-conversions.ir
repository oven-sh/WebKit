function f19 name="readsStateBeforeConversions" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=anything}, {type=anything}, {type=object}] results=[{type=anything}] {
    v4 = Builtin builtin=ArrayPrototypeFill
    v5 = Call v4, v0, v1, v2
    v6 = Call v4, v0, v1, v3
    Return v6
# CHECK-NOT: ToNumber
# CHECK: v5: {{*}} = CallBuiltin v0, v1, v2 overload=ArrayPrototypeFill/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: v6: {{*}} = CallBuiltin v0, v1, v3 overload=ArrayPrototypeFill/0 builtinCallForm=AnyReceiver
}

