function f22 name="nullishReceiverThrowsInBuiltin" parameters=[{type=anything}, {type=undefined|string}] results=[{type=anything}] {
    v2 = Builtin builtin=StringPrototypeTrim
    v3 = Call v2, v0
    v4 = Call v2, v1
    Return v4
# CHECK-NOT: RequireObjectCoercible
# CHECK: v3: string = CallBuiltin v0 overload=StringPrototypeTrim/0 builtinCallForm=AnyReceiver
# The second call is direct too, and waits so for the test of its receiver, which is expected to be there: resolve-receiver-expected-to-be-present.ir
# CHECK-NEXT: v4: string = CallBuiltin v1 overload=StringPrototypeTrim/0 builtinCallForm=AnyReceiver
}

function f23 name="nullishReceiverThrowsAtRead" parameters=[{type=undefined|string}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: [[checked23]]: string = RequireObjectCoercible v0 name="length"
# CHECK-NEXT: v1: int[0, 2147483647] = CallBuiltin [[checked23]] overload=StringPrototypeLength/0
}

function f24 name="acceptedUndefinedIsNotConverted" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=anything}, {type=undefined|number}, {type=undefined|string}, {type=number}] results=[{type=anything}] {
    v5 = Builtin builtin=ArrayPrototypeJoin
    v6 = Call v5, v0, v1
    v7 = Call v5, v0, v2
    v8 = Call v5, v0, v3
    v9 = Call v5, v0, v4
    Return v9
# CHECK-NOT: ToString
# CHECK: v6: string = CallBuiltin v0, v1 overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: v7: string = CallBuiltin v0, v2 overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: v8: string = CallBuiltin v0, v3 overload=ArrayPrototypeJoin/0
# CHECK-NEXT: [[text24]]: string = ToString v4
# CHECK-NEXT: v9: string = CallBuiltin v0, [[text24]] overload=ArrayPrototypeJoin/0
}

function f25 name="expectedInsideAcceptedType" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=string flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: Array<anything, pristine[Storage, Names]>, v1: anything ~ string):
    v2 = Builtin builtin=ArrayPrototypeJoin
    v3 = Call v2, v0, v1
    Return v3
# CHECK-NOT: ToString
# The callee is proven, so the call is direct at once, with the result that the table gives. What its operands still have to be is tested by PlaceTypeTests, and the side that passes gets the matched form.
# CHECK: v3: string = CallBuiltin v0, v1 overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver
# PLACED-NOT: ToString
# PLACED: = TypeTest v1 testedType=string
# PLACED: ([[tested25]]: string):
# PLACED-NOT: ToString
# PLACED: string = CallBuiltin v0, [[tested25]] overload=ArrayPrototypeJoin/0
# PLACED-NOT: ToString
# PLACED: frequency=Unlikely:
# PLACED-NEXT: string = CallBuiltin v0, {{*}} overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver
}

function f26 name="codeBehindAnIndexStaysInTheBuiltin" parameters=[{type=DataView}, {type=number}, {type=object}, {type=anything}, {type=string}] results=[{type=anything}] {
    v5 = Builtin builtin=DataViewPrototypeSetInt8
    v6 = Call v5, v0, v1, v2
    v7 = Call v5, v0, v1, v3
    v8 = Call v5, v0, v1, v4
    Return v8
# The built-in refuses a negative index before it converts the value, so a conversion that may run code or throw is left to it.
# CHECK: v6: undefined = CallBuiltin v0, v1, v2 overload=DataViewPrototypeSetInt8/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: v7: undefined = CallBuiltin v0, v1, v3 overload=DataViewPrototypeSetInt8/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: [[number26]]: number = ToNumber v4
# CHECK-NEXT: v8: undefined = CallBuiltin v0, v1, [[number26]] overload=DataViewPrototypeSetInt8/0
# A value of which nothing is known is tested for one whose conversion does neither, which nearly every stored value is.
# PLACED: v6: undefined = CallBuiltin v0, v1, v2 overload=DataViewPrototypeSetInt8/0 builtinCallForm=AnyReceiver
# PLACED: ([[tested26]]: undefined|null|boolean|number|string):
# PLACED-NEXT: [[converted26]]: number = ToNumber [[tested26]]
# PLACED-NEXT: v7: undefined = CallBuiltin v0, v1, [[converted26]] overload=DataViewPrototypeSetInt8/0
# PLACED: = TypeTest v3 testedType=undefined|null|boolean|number|string
# PLACED: frequency=Unlikely:
# PLACED-NEXT: undefined = CallBuiltin v0, v1, {{*}} overload=DataViewPrototypeSetInt8/0 builtinCallForm=AnyReceiver
}
