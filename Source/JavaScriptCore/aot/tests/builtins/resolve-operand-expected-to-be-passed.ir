# An operand that may be undefined stands for a missing one. It is tested for what it is expected to be, so that the call behind the test knows whether the operand is there
# FORM: Prepared
# RUN: pass ResolveBuiltins PlaceTypeTests ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="expectedNumber" parameters=[{type=string}, {type=undefined|null|number}] results=[{type=anything}] {
  b0(v0: string, v1: undefined|null|number ~ number):
    v2 = Builtin builtin=StringPrototypeCharCodeAt
    v3 = Call v2, v0, v1
    Return v3
# CHECK: [[test0]]: boolean ~ true = TypeTest v1 testedType=number
# CHECK: ([[passed0]]: number):
# CHECK: v3: number = CallBuiltin v0, [[passed0]] overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: Return v3
# CHECK: CallBuiltin v0, [[missing0]] overload=StringPrototypeCharCodeAt/0 builtinCallForm=AnyReceiver
# CHECK: ([[missing0]]: undefined|null) frequency=Unlikely:
}

function f1 name="expectedNumberOrUndefined" parameters=[{type=string}, {type=undefined|null|number}] results=[{type=anything}] {
  b0(v0: string, v1: undefined|null|number ~ undefined|number):
    v2 = Builtin builtin=StringPrototypeCharCodeAt
    v3 = Call v2, v0, v1
    Return v3
# CHECK: TypeTest v1 testedType=undefined|number
# CHECK: ([[passed1]]: undefined|number):
# CHECK: v3: number = CallBuiltin v0, [[passed1]] overload=StringPrototypeCharCodeAt/0
}

# With both undefined and null beside it a type is as the front end hands over what is declared a T: the operand is expected to be the T.
function f2 name="nothingElseExpected" parameters=[{type=string}, {type=undefined|null|number}] results=[{type=anything}] {
    v2 = Builtin builtin=StringPrototypeCharCodeAt
    v3 = Call v2, v0, v1
    Return v3
# CHECK: TypeTest v1 testedType=number
# CHECK: ([[passed2]]: number):
# CHECK: v3: number = CallBuiltin v0, [[passed2]] overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: Return v3
}

function f3 name="expectedEnd" parameters=[{type=string}, {type=number}, {type=undefined|null|number}] results=[{type=anything}] {
  b0(v0: string, v1: number, v2: undefined|null|number ~ number):
    v3 = Builtin builtin=StringPrototypeSlice
    v4 = Call v3, v0, v1, v2
    Return v4
# CHECK: TypeTest v2 testedType=number
# CHECK: ([[end3]]: number):
# CHECK: v4: string = CallBuiltin v0, v1, [[end3]] overload=StringPrototypeSlice/0
}

function f4 name="expectedSeparator" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=string flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: Array<anything, pristine[Storage, Names]>, v1: anything ~ string):
    v2 = Builtin builtin=ArrayPrototypeJoin
    v3 = Call v2, v0, v1
    Return v3
# CHECK: TypeTest v1 testedType=string
# CHECK: ([[separator4]]: string):
# CHECK: v3: string = CallBuiltin v0, [[separator4]] overload=ArrayPrototypeJoin/0
}

# A field that is declared a string and that nobody has checked.
function f5 name="separatorOutOfDeclaredField" parameters=[{type=string}, {type=undefined|null|string flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: string, v1: anything ~ undefined|null|string):
    v2 = Builtin builtin=StringPrototypeSplit
    v3 = Call v2, v0, v1
    Return v3
# CHECK: TypeTest v1 testedType=string
# CHECK: ([[separator5]]: string):
# CHECK: v3: Array<string{{*}}> = CallBuiltin v0, [[separator5]] overload=StringPrototypeSplit/0
# CHECK: CallBuiltin v0, {{*}} overload=StringPrototypeSplit/{{*}} builtinCallForm=AnyReceiver
}

# The program has written `null | number` itself, and nothing says which of the two comes.
function f6 name="writtenWithNull" parameters=[{type=string}, {type=null|number}] results=[{type=anything}] {
    v2 = Builtin builtin=StringPrototypeCharCodeAt
    v3 = Call v2, v0, v1
    Return v3
# CHECK-NOT: TypeTest
}

# Nothing is known of the operand.
function f7 name="nothingKnown" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=StringPrototypeSplit
    v3 = Call v2, v0, v1
    Return v3
# CHECK-NOT: TypeTest
# CHECK: CallBuiltin v0, v1 overload=StringPrototypeSplit/{{*}} builtinCallForm=AnyReceiver
}

# Nothing is known of an operand that the built-in takes as a position: it is tested for a number.
function f8 name="positionOfWhichNothingIsKnown" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=StringPrototypeCharCodeAt
    v3 = Call v2, v0, v1
    Return v3
# CHECK: TypeTest v1 testedType=number
# CHECK: ([[position8]]: number):
# CHECK: v3: number = CallBuiltin v0, [[position8]] overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: Return v3
# CHECK: CallBuiltin v0, {{*}} overload=StringPrototypeCharCodeAt/0 builtinCallForm=AnyReceiver
}

function f9 name="bothEndsOfWhichNothingIsKnown" parameters=[{type=string}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=StringPrototypeSlice
    v4 = Call v3, v0, v1, v2
    Return v4
# CHECK: TypeTest v1 testedType=number
# CHECK: v4: string = CallBuiltin v0, {{*}}, {{*}} overload=StringPrototypeSlice/0
# CHECK-NEXT: Return v4
# CHECK: TypeTest v2 testedType=number
}

function f10 name="startOfSearchOfWhichNothingIsKnown" parameters=[{type=string}, {type=string}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=StringPrototypeIndexOf
    v4 = Call v3, v0, v1, v2
    Return v4
# CHECK: TypeTest v2 testedType=number
# CHECK: ([[start10]]: number):
# CHECK: CallBuiltin v0, v1, [[start10]] overload=StringPrototypeIndexOf/0
# CHECK-NEXT: Return v4
}
