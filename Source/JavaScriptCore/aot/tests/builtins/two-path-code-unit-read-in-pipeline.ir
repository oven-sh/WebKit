# The operations behind a read of a code unit at an unproven integer work on integers: the joined value is tested for them, the edge from inside the string skips the test, and NaN takes a copy of its own
# FORM: Prepared optimizing
# RUN: pass SimplifyBuiltinCalls RetypeValues PlaceTypeTests FoldConstants SimplifyControlFlow RemoveTrivialParameters PropagateBranchConditions HoistTestsIntoPredecessors ThreadJumps EliminateDeadCode FoldConstants SimplifyControlFlow RemoveTrivialParameters SimplifyCasts RetypeValues EliminateDeadCode CompactBlocks

module m0 path="main.js" displayPath="main.js"
function f0 name="comparesUnit" parameters=[{type=string}, {type=int[0, 1000]}] results=[{type=number}] {
  b0(v0: string, v1: int[0, 1000]):
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    v3 = Integer integer=47
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = Integer integer=1
    Return v5
  b2():
    v6 = Integer integer=48
    v7 = GreaterEq v2, v6
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    v8 = Sub v2, v6
    Return v8
  b4():
    v9 = Integer integer=-1
    Return v9
}
# CHECK: [[unit]]: int[0, 65535] = GetStringCodeUnit v0,
# CHECK: = StrictEq [[narrowed]],
# CHECK: = GreaterEq [[narrowed]],
# CHECK: int[-48, 65487] = Sub [[narrowed]],
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = Double number=NaN
