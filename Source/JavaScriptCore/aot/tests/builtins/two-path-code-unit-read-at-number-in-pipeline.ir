# A code unit is the position of the next read. The joined answer of a read is a number, so the next read tests it for an int32, and the edge from inside the string skips that test: on the path that stays inside the string only the first of the three reads tests its position
# FORM: Prepared optimizing
# RUN: pass SimplifyBuiltinCalls RetypeValues PlaceTypeTests FoldConstants SimplifyControlFlow RemoveTrivialParameters HoistTestsIntoPredecessors ThreadJumps EliminateDeadCode FoldConstants SimplifyControlFlow RemoveTrivialParameters SimplifyCasts RetypeValues EliminateDeadCode CompactBlocks

module m0 path="main.js" displayPath="main.js"
function f0 name="chainOfReads" parameters=[{type=string}, {type=number}] results=[{type=number}] {
  b0(v0: string, v1: number):
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    v3 = CallBuiltin v0, v2 overload=StringPrototypeCharCodeAt/0
    v4 = CallBuiltin v0, v3 overload=StringPrototypeCharCodeAt/0
    Return v4
}
# CHECK: b0(v0: string, v1: number):
# CHECK-NEXT: = TypeTest v1 testedType=i32
# CHECK: [[unit1]]: int[0, 65535] = GetStringCodeUnit v0,
# CHECK-NEXT: Jump -> next [[second]]([[unit1]])
# CHECK: [[second]]([[position2]]: i32{{*}}):
# CHECK-NEXT: [[zero2]]: 0 = Integer
# CHECK-NEXT: = URShift [[position2]], [[zero2]]
# CHECK: [[unit2]]: int[0, 65535] = GetStringCodeUnit v0,
# CHECK-NEXT: Jump -> next [[third]]([[unit2]])
# CHECK: [[third]]([[position3]]: i32{{*}}):
# CHECK-NEXT: [[zero3]]: 0 = Integer
# CHECK-NEXT: = URShift [[position3]], [[zero3]]
# CHECK: [[unit3]]: int[0, 65535] = GetStringCodeUnit v0,
