# A code unit is the position of the next read. Every code unit that a read answers with joins the others as an integer, also the one of the call in unlikely code, and NaN goes its own way: only the first of the three reads tests its position
# FORM: Prepared optimizing
# RUN: pass SimplifyBuiltinCalls RetypeValues PlaceTypeTests FoldConstants SimplifyControlFlow RemoveTrivialParameters PropagateBranchConditions HoistTestsIntoPredecessors ThreadJumps EliminateDeadCode FoldConstants SimplifyControlFlow RemoveTrivialParameters SimplifyCasts RetypeValues EliminateDeadCode CompactBlocks

module m0 path="main.js" displayPath="main.js"
function f0 name="chainOfReads" parameters=[{type=string}, {type=number}] results=[{type=number}] {
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    v3 = CallBuiltin v0, v2 overload=StringPrototypeCharCodeAt/0
    v4 = CallBuiltin v0, v3 overload=StringPrototypeCharCodeAt/0
    Return v4
}
# CHECK: b0(v0: string, v1: number):
# CHECK-NEXT: = TypeTest v1 testedType=i32
# CHECK: [[unit1]]: int[0, 65535] = GetStringCodeUnit v0,
# CHECK-NEXT: Jump -> next [[second]]([[unit1]])
# CHECK: [[second]]([[position2]]: int[0, 65535]):
# CHECK-NEXT: [[zero2]]: 0 = Integer
# CHECK-NEXT: = URShift [[position2]], [[zero2]]
# CHECK: [[unit2]]: int[0, 65535] = GetStringCodeUnit v0,
# CHECK-NEXT: Jump -> next [[third]]([[unit2]])
# CHECK: [[third]]([[position3]]: int[0, 65535]):
# CHECK-NEXT: [[zero3]]: 0 = Integer
# CHECK-NEXT: = URShift [[position3]], [[zero3]]
# CHECK: [[unit3]]: int[0, 65535] = GetStringCodeUnit v0,
