# What a literal of the program makes is no error
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="HasMessage" fields=[{key="message" declared={type=string} flags=[IsRequired]}]
function f0 name="everyObjectHasTheLayout" parameters=[{type=L0}] results=[{type=boolean}] {
    v1 = CallBuiltin -, v0 overload=ErrorIsError/0
    Return v1
# CHECK-NOT: CallBuiltin
# CHECK: v1: false = Boolean
}
