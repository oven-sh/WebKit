# A family may have members that no layout stands for, and such a member may be an object of a built-in class: instanceof with a built-in constructor asks the object
# FORM: Prepared
# RUN: pass ResolveBuiltins

module m0 path="main.js" displayPath="main.js"
layout L0 name="Kept" fields=[{key="x" declared={type=number} flags=[IsRequired]}] flow={impossibleMutations=[ChangePrototype]}
function f0 name="everyObjectHasTheLayout" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = InstanceOf v0, v1
    Return v2
# CHECK-NOT: HasInPrototypeChain
# CHECK: v2: false = Boolean
}

function f1 name="memberWithoutLayout" parameters=[{type=L0|nolayout}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = InstanceOf v0, v1
    Return v2
# CHECK-NOT: false = Boolean
# CHECK: = TypeTest v0 testedType=Promise
# CHECK: = HasInPrototypeChain
}
