# Array.isArray is a test of the type of its operand, except where the operand may be a Proxy or an object that nobody knows
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="listOrText" parameters=[{type=string|Array}] results=[{type=boolean}] {
    v1 = CallBuiltin -, v0 overload=ArrayIsArray/0
    Return v1
# CHECK-NOT: CallBuiltin
# CHECK: = TypeTest v0 testedType=Array
}

