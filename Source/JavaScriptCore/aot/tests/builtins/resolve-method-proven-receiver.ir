# A member of a primitive or of a receiver that is proven pristine resolves without a test: the read becomes a constant, the call a CallBuiltin
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="stringMethod" parameters=[{type=string}, {type=i32}] results=[{type=anything}] {
    v2 = PropGet v0 key="charCodeAt"
    v3 = Call v2, v0, v1 calleeKey="charCodeAt"
    Return v3
# CHECK-NOT: TypeTest
# CHECK-NOT: IsPristine
# CHECK: v2: builtin(StringPrototypeCharCodeAt) = Builtin builtin=StringPrototypeCharCodeAt
# CHECK-NEXT: v3: {{*}} = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
}

function f1 name="stringLength" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: v1: int[0, 2147483647] = CallBuiltin v0 overload=StringPrototypeLength/0
}

function f2 name="regExpMethod" parameters=[{type=RegExp<pristine[Names]>}, {type=string}] results=[{type=anything}] {
    v2 = PropGet v0 key="exec"
    v3 = Call v2, v0, v1 calleeKey="exec"
    Return v3
# CHECK-NOT: TypeTest
# CHECK-NOT: IsPristine
# CHECK: v2: builtin(RegExpPrototypeExec) = Builtin builtin=RegExpPrototypeExec
# CHECK-NEXT: v3: {{*}} = CallBuiltin v0, v1 overload=RegExpPrototypeExec/0
# CHECK-NOT: needsPristineReceiver
}

function f3 name="regExpProperties" parameters=[{type=RegExp<pristine[Names]>}, {type=number}] results=[{type=anything}] {
    v2 = PropGet v0 key="global"
    v3 = PropGet v0 key="lastIndex"
    PropSet v0, v1 key="lastIndex" mode=Strict
    Return v3
# CHECK: v2: boolean = CallBuiltin v0 overload=RegExpPrototypeGlobal/0
# CHECK-NEXT: v3: {{*}} = CallBuiltin v0 overload=RegExpPrototypeLastIndex/0
# CHECK-NEXT: CallBuiltin v0, v1 overload=RegExpPrototypeLastIndex/
}

function f4 name="parentClassMember" parameters=[{type=Uint8Array<number, pristine[Names]>}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    v2 = PropGet v0 key="setFromHex"
    v3 = String string="00"
    v4 = Call v2, v0, v3 calleeKey="setFromHex"
    Return v4
# CHECK-NOT: TypeTest
# CHECK-NOT: IsPristine
# CHECK: v1: {{*}} = CallBuiltin v0 overload=TypedArrayPrototypeLength/0
# CHECK-NEXT: v2: builtin(Uint8ArrayPrototypeSetFromHex) = Builtin builtin=Uint8ArrayPrototypeSetFromHex
# CHECK: v4: {{*}} = CallBuiltin v0, v3 overload=Uint8ArrayPrototypeSetFromHex/0
}

function f5 name="arrayMethod" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push"
    Return v3
# CHECK-NOT: TypeTest
# CHECK-NOT: IsPristine
# CHECK: v2: builtin(ArrayPrototypePush) = Builtin builtin=ArrayPrototypePush
# CHECK-NEXT: v3: int[0, 4294967295] = CallBuiltin v0, v1 overload=ArrayPrototypePush/0
# CHECK-NOT: needsPristineReceiver
}

function f6 name="methodOfFreshArray" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray contents=anything
    v2 = PropGet v1 key="push"
    v3 = Call v2, v1, v0 calleeKey="push"
    Return v3
# CHECK-NOT: TypeTest
# CHECK-NOT: IsPristine
# CHECK: v2: builtin(ArrayPrototypePush) = Builtin builtin=ArrayPrototypePush
# CHECK-NEXT: v3: int[0, 4294967295] = CallBuiltin v1, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
}

function f7 name="unknownCodeSeesFreshArray" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray contents=anything
    v2 = Call v0, -, v1
    v3 = PropGet v1 key="push"
    v4 = Call v3, v1, v0 calleeKey="push"
    Return v4
# CHECK-NOT: Builtin
# CHECK: v3: anything = PropGet v1 key="push"
# CHECK-NEXT: v4: anything = Call v3, v1, v0 calleeKey="push"
}

function f8 name="unknownCodeBetweenReadAndCall" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray contents=anything
    v2 = PropGet v1 key="push"
    v3 = Call v0, -, v1
    v4 = Call v2, v1, v3 calleeKey="push"
    Return v4
# CHECK: v2: builtin(ArrayPrototypePush) = Builtin builtin=ArrayPrototypePush
# CHECK-NEXT: v3: anything = Call v0, -, v1
# The callee is proven, so the call is direct at once, with the result that the table gives. What its operands still have to be is tested by PlaceTypeTests, and the side that passes gets the matched form.
# CHECK-NEXT: v4: int[0, 9007199254740991] = CallBuiltin v1, v3 overload=ArrayPrototypePush/0 builtinCallForm=AnyReceiver
}

function f9 name="nullableString" parameters=[{type=undefined|string}] results=[{type=anything}] {
    v1 = PropGet v0 key="toLowerCase"
    Return v1
# CHECK: string = RequireObjectCoercible v0 name="toLowerCase"
# CHECK-NEXT: v1: builtin(StringPrototypeToLowerCase) = Builtin builtin=StringPrototypeToLowerCase
}

function f10 name="nullableStringLength" parameters=[{type=undefined|string}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: [[checked]]: string = RequireObjectCoercible v0 name="length"
# CHECK-NEXT: v1: int[0, 2147483647] = CallBuiltin [[checked]] overload=StringPrototypeLength/0
}

function f11 name="nullableStringUnderHandler" parameters=[{type=undefined|string}] results=[{type=anything}] {
  b0(v0: undefined|string) handler=b2():
    v1 = PropGet v0 key="length"
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: b0(v0: undefined|string) handler=b2():
# CHECK-NEXT: [[checkedUnderHandler]]: string = RequireObjectCoercible v0 name="length"
# CHECK-NEXT: v1: int[0, 2147483647] = CallBuiltin [[checkedUnderHandler]] overload=StringPrototypeLength/0
# CHECK-NEXT: Jump -> next b1()
}

function f12 name="operandConvertedInFront" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="repeat"
    v3 = Call v2, v0, v1 calleeKey="repeat"
    Return v3
# CHECK: [[number]]: number = ToNumber v1
# CHECK-NEXT: [[integer]]: {{*}} = ToIntegerOrInfinity [[number]]
# CHECK-NEXT: v3: string = CallBuiltin v0, [[integer]] overload=StringPrototypeRepeat/0
}

function f13 name="twoClasses" parameters=[{type=RegExp<pristine[Names]>|Uint8Array<number, pristine[Names]>}] results=[{type=anything}] {
    v1 = PropGet v0 key="toString"
    v2 = Call v1, v0 calleeKey="toString"
    Return v2
# CHECK-NOT: Builtin
# CHECK: v1: anything = PropGet v0 key="toString"
# CHECK-NEXT: v2: anything = Call v1, v0 calleeKey="toString"
}

function f14 name="twoPrimitiveKinds" parameters=[{type=number|string}] results=[{type=anything}] {
    v1 = PropGet v0 key="toString"
    v2 = Call v1, v0 calleeKey="toString"
    Return v2
# CHECK-NOT: Builtin
# CHECK: v1: anything = PropGet v0 key="toString"
# CHECK-NEXT: v2: anything = Call v1, v0 calleeKey="toString"
}

function f15 name="nameWithoutMember" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="exec"
    v2 = Call v1, v0 calleeKey="exec"
    Return v2
# CHECK-NOT: Builtin
# CHECK: v1: anything = PropGet v0 key="exec"
# CHECK-NEXT: v2: anything = Call v1, v0 calleeKey="exec"
}

function f16 name="privateAlias" parameters=[{type=Map<anything, anything, pristine[Names]>}, {type=WeakMap<anything, anything, pristine[Names]>}] results=[{type=anything}] {
    v2 = PropGet v0 key=@"size"
    v3 = PropGet v1 key=@"get"
    Return v3
# CHECK: v2: {{*}} = CallBuiltin v0 overload=MapPrototypeSize/0
# CHECK-NEXT: v3: anything = PropGet v1 key=@"get"
}

function f17 name="unmatchedOperands" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="charCodeAt"
    v3 = Call v2, v0, v1 calleeKey="charCodeAt"
    Return v3
# CHECK: v2: builtin(StringPrototypeCharCodeAt) = Builtin builtin=StringPrototypeCharCodeAt
# CHECK-NEXT: v3: number = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0 builtinCallForm=AnyReceiver
}

function f18 name="ownPropertyOfInstances" parameters=[{type=RegExp}, {type=number}] results=[{type=anything}] {
    v2 = PropGet v0 key="lastIndex"
    PropSet v0, v1 key="lastIndex" mode=Strict
    Return v2
# CHECK-NEXT: b0(v0: RegExp, v1: number):
# CHECK-NEXT: v2: anything = CallBuiltin v0 overload=RegExpPrototypeLastIndex/0
# CHECK-NEXT: v3: undefined = CallBuiltin v0, v1 overload=RegExpPrototypeLastIndex/1
}

function f19 name="sloppyStore" parameters=[{type=RegExp}, {type=number}] results=[{type=undefined}] {
    PropSet v0, v1 key="lastIndex" mode=Sloppy
    Return
# CHECK-NOT: CallBuiltin
# CHECK: PropSet v0, v1 key="lastIndex" mode=Sloppy
}
