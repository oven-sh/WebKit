function f11 name="accessorOfParentClass" parameters=[{type=L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="byteLength"
    Return v1
# CHECK: v1: {{*}} = CallBuiltin v0 overload=TypedArrayPrototypeByteLength/0
}

function f12 name="shadowingField" parameters=[{type=L3}] results=[{type=anything}] {
    v1 = PropGet v0 key="size"
    Return v1
# CHECK-NOT: CallBuiltin
# CHECK: = PropGet v0 key="size"
