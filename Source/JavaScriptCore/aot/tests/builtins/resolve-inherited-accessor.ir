# An accessor of a built-in class that is found at the end of a chain of compiled classes becomes a call of that entry, where flow says no compiled layout shadows the name
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed
# STATISTIC: BuiltinReadsResolved = 4

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Registry" constructor=f0 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Map impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L1 kind=Instance name="SubRegistry" base=L0 constructor=f1 flags=[HasHeritage] flow={baseState=Layout base=L0 impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L2 kind=Instance name="Bytes" constructor=f2 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Uint8Array impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L3 kind=Instance name="FieldShadows" constructor=f3 fields=[{key="size" declared={type=number}}] flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Map impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L4 kind=Instance name="GetterShadows" constructor=f4 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Map impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="size" kind=Getter function=f7 mutability=Fixed}]}
layout L5 kind=Instance name="PrototypeMayGainNames" constructor=f5 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Map impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce staticLink=Fixed staticNamesAreComplete=true}
layout L6 kind=Instance name="InstanceMayGainNames" constructor=f6 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Map} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}

function f0 name="Registry" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f1 name="SubRegistry" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L1
function f2 name="Bytes" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L2
function f3 name="FieldShadows" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L3
function f4 name="GetterShadows" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L4
function f5 name="PrototypeMayGainNames" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L5
function f6 name="InstanceMayGainNames" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L6
function f7 name="size" kind=Getter flags=[HasThis] results=[{type=number}] {
    v1 = Integer integer=0
    Return v1
}

function f8 name="accessor" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="size"
    Return v1
# CHECK: v1: int[0, 2147483647] = CallBuiltin v0 overload=MapPrototypeSize/0
}

function f9 name="throughCompiledBase" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="size"
    Return v1
# CHECK: v1: int[0, 2147483647] = CallBuiltin v0 overload=MapPrototypeSize/0
}

function f10 name="bothLayoutsFindOneEntry" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="size"
    Return v1
# CHECK: v1: int[0, 2147483647] = CallBuiltin v0 overload=MapPrototypeSize/0
