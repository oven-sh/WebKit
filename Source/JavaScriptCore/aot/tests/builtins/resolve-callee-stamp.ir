# A callee that flow narrowed to one built-in resolves by its type, and a callees stamp that is incomplete or lists more than one callee resolves nothing
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed
# STATISTIC: BuiltinCallsResolved = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="calleeNarrowedByFlow" parameters=[{type=anything}, {type=Array<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage, Names]>, v2: anything):
    v3 = AssumeType v0 castType=builtin(ArrayPrototypePush)
    v4 = Call v3, v1, v2 callees=[builtin(ArrayPrototypePush)]
    Return v4
}
# CHECK-LABEL: function f0 name="calleeNarrowedByFlow"
# CHECK: v3: builtin(ArrayPrototypePush) = AssumeType v0 castType=builtin(ArrayPrototypePush)
# CHECK-NEXT: v4: int[0, 4294967295] = CallBuiltin v1, v2 overload=ArrayPrototypePush/0

function f1 name="incompleteStamp" parameters=[{type=anything}, {type=Array<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage, Names]>, v2: anything):
    v3 = Call v0, v1, v2 callees=[builtin(ArrayPrototypePush), ..]
    Return v3
}
# CHECK-LABEL: function f1 name="incompleteStamp"
# CHECK-NOT: CallBuiltin
# CHECK: v3: anything = Call v0, v1, v2 callees=[builtin(ArrayPrototypePush), ..]

function f2 name="builtinAndFunction" parameters=[{type=anything}, {type=Array<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage, Names]>, v2: anything):
    v3 = Call v0, v1, v2 callees=[f4, builtin(ArrayPrototypePush)]
    Return v3
}
# CHECK-LABEL: function f2 name="builtinAndFunction"
# CHECK-NOT: CallBuiltin
# CHECK: v3: anything = Call v0, v1, v2 callees=[f4, builtin(ArrayPrototypePush)]

function f3 name="twoBuiltins" parameters=[{type=anything}, {type=Array<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage, Names]>, v2: anything):
    v3 = AssumeType v0 castType=builtin(ArrayPrototypePush)|builtin(ArrayPrototypeUnshift)
    v4 = Call v3, v1, v2 callees=[builtin(ArrayPrototypePush), builtin(ArrayPrototypeUnshift)]
    Return v4
}
# CHECK-LABEL: function f3 name="twoBuiltins"
# CHECK-NOT: CallBuiltin
# CHECK: v4: anything = Call v3, v1, v2 callees=[builtin(ArrayPrototypePush), builtin(ArrayPrototypeUnshift)]

function f4 name="append" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
