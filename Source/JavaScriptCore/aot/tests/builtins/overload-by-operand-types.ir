# A call of a built-in takes the overload that the types of its operands reach in the entry's decision tree, and moves to another overload when the types have narrowed
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="firstOperandDecides" parameters=[{type=string}, {type=RegExp<pristine[Names]>}, {type=number}, {type=Array}] results=[{type=anything}] {
  b0(v0: string, v1: RegExp<pristine[Names]>, v2: number, v3: Array):
    v4 = Builtin builtin=RegExp
    v5 = Call v4, -, v0
    v6 = Call v4, -, v1
    v7 = Call v4, -, v2
    v8 = Call v4
    v9 = Call v4, -, v3
    Return v9
}
# CHECK-LABEL: function f0 name="firstOperandDecides"
# CHECK: v5: RegExp = CallBuiltin -, v0 overload=RegExp/0
# CHECK-NEXT: v6: {{*}} = CallBuiltin -, v1 overload=RegExp/1
# CHECK-NEXT: v7: RegExp = CallBuiltin -, v2 overload=RegExp/2
# CHECK-NEXT: v8: RegExp = CallBuiltin overload=RegExp/2
# CHECK-NEXT: v9: {{*}} = CallBuiltin -, v3 overload=RegExp/3

function f1 name="secondOperandDecides" parameters=[{type=string}, {type=string}, {type=function}] results=[{type=anything}] {
  b0(v0: string, v1: string, v2: function):
    v3 = Builtin builtin=StringPrototypeReplace
    v4 = Call v3, v0, v1, v1
    v5 = Call v3, v0, v1, v2
    Return v5
}
# CHECK-LABEL: function f1 name="secondOperandDecides"
# CHECK: v4: string = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/1
# CHECK-NEXT: v5: string = CallBuiltin v0, v1, v2 overload=StringPrototypeReplace/2

function f2 name="classOfOperandDecides" parameters=[{type=string}, {type=string}, {type=RegExp<pristine[Names]>}, {type=Map}, {type=i32}] results=[{type=anything}] {
  b0(v0: string, v1: string, v2: RegExp<pristine[Names]>, v3: Map, v4: i32):
    v5 = Builtin builtin=StringPrototypeReplace
    v6 = Call v5, v0, v2, v1
    v7 = Call v5, v0, v3, v1
    v8 = Call v5, v0, v4, v1
    Return v8
}
# CHECK-LABEL: function f2 name="classOfOperandDecides"
# CHECK: v6: string = CallBuiltin v0, v2, v1 overload=StringPrototypeReplace/0
# CHECK-NEXT: v7: anything = CallBuiltin v0, v3, v1 overload=StringPrototypeReplace/3
# CHECK-NEXT: v8: string = CallBuiltin v0, v4, v1 overload=StringPrototypeReplace/2

function f3 name="receiverDecides" parameters=[{type=null}, {type=string}] results=[{type=anything}] {
  b0(v0: null, v1: string):
    v2 = Builtin builtin=StringPrototypeReplace
    v3 = Call v2, v0, v1, v1
    Return v3
}
# CHECK-LABEL: function f3 name="receiverDecides"
# CHECK: v3: anything = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/3

function f4 name="typesDoNotDecide" parameters=[{type=string}, {type=string}, {type=anything}, {type=object}] results=[{type=anything}] {
  b0(v0: string, v1: string, v2: anything, v3: object):
    v4 = Builtin builtin=StringPrototypeReplace
    v5 = Call v4, v0, v1, v2
    v6 = Call v4, v0, v3, v1
    Return v6
}
# CHECK-LABEL: function f4 name="typesDoNotDecide"
# CHECK: v5: string = CallBuiltin v0, v1, v2 overload=StringPrototypeReplace/{{*}} builtinCallForm=AnyReceiver
# CHECK-NEXT: v6: anything = CallBuiltin v0, v3, v1 overload=StringPrototypeReplace/{{*}} builtinCallForm=AnyReceiver

function f5 name="overloadNeedsTest" parameters=[{type=string}, {type=string}, {type=RegExp}] results=[{type=anything}] {
  b0(v0: string, v1: string, v2: RegExp):
    v3 = Builtin builtin=StringPrototypeReplace
    v4 = Call v3, v0, v2, v1
    Return v4
}
# CHECK-LABEL: function f5 name="overloadNeedsTest"
# The callee is proven, so the call is direct at once, with the result that the table gives. What its operands still have to be is tested by PlaceTypeTests, and the side that passes gets the matched form.
# CHECK: v4: anything = CallBuiltin v0, v2, v1 overload=StringPrototypeReplace/{{*}} builtinCallForm=AnyReceiver

function f6 name="moveToOverloadOfNarrowedTypes" parameters=[{type=string}, {type=string}, {type=RegExp<pristine[Names]>}] results=[{type=anything}] {
  b0(v0: string, v1: string, v2: RegExp<pristine[Names]>):
    v3 = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/2
    v4 = CallBuiltin v0, v2, v1 overload=StringPrototypeReplace/3
    v5 = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/3 builtinCallForm=AnyReceiver
    v6 = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/1
    Return v6
}
# CHECK-LABEL: function f6 name="moveToOverloadOfNarrowedTypes"
# CHECK: v3: string = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/1
# CHECK-NEXT: v4: string = CallBuiltin v0, v2, v1 overload=StringPrototypeReplace/0
# CHECK-NEXT: v5: string = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/1
# CHECK-NEXT: v6: string = CallBuiltin v0, v1, v1 overload=StringPrototypeReplace/1

function f7 name="listFormStays" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
  b0(v0: Array<number, pristine[Storage, Names]>):
    v1 = CallBuiltin -, v0 overload=MathMax/0 builtinCallForm=List
    Return v1
}
# CHECK-LABEL: function f7 name="listFormStays"
# CHECK: v1: number = CallBuiltin -, v0 overload=MathMax/0 builtinCallForm=List
