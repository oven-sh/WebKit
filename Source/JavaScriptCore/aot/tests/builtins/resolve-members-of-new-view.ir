# A view over a buffer is a new object that shares only its bytes: its members resolve without a test since its creation, and what is stored through it stays
# FORM: Prepared
# RUN: pass ResolveBuiltins ResolveBuiltins
# RUN(FRESH): result-freshness
# RUN(DEAD): pass EliminateDeadCode
# RUN(READS): pass EliminateRedundantReads
# CHECK-NOT: IsPristine

module m0 path="main.js" displayPath="main.js"
function f0 name="sinceCreation" parameters=[{type=ArrayBuffer}] results=[{type=anything}] {
    v1 = Builtin builtin=Uint8Array
    v2 = Construct v1, -, v0
    v3 = PropGet v2 key="subarray"
    v4 = PropGet v2 key="length"
    v5 = Builtin builtin=DataView
    v6 = Construct v5, -, v0
    v7 = PropGet v6 key="getInt8"
    v8 = NewArray v3, v4, v7 contents=anything
    Return v8
# CHECK: v2: Uint8Array = CallBuiltin -, v0 overload=Uint8Array/2
# CHECK-NEXT: v3: builtin(TypedArrayPrototypeSubarray) = Builtin builtin=TypedArrayPrototypeSubarray
# CHECK-NEXT: v4: int[0, 4294967296] = CallBuiltin v2 overload=TypedArrayPrototypeLength/0
# CHECK: v6: DataView = CallBuiltin -, v0 overload=DataView/1
# CHECK-NEXT: v7: builtin(DataViewPrototypeGetInt8) = Builtin builtin=DataViewPrototypeGetInt8
}

function f1 name="partOfNewView" parameters=[{type=ArrayBuffer}] results=[{type=anything}] {
    v1 = CallBuiltin -, v0 overload=Uint8Array/2
    v2 = Builtin builtin=TypedArrayPrototypeSubarray
    v3 = Call v2, v1
    v4 = PropGet v3 key="subarray"
    Return v4
# CHECK: v3: Uint8Array = CallBuiltin v1 overload=TypedArrayPrototypeSubarray/0
# CHECK-NEXT: v4: builtin(TypedArrayPrototypeSubarray) = Builtin builtin=TypedArrayPrototypeSubarray
}

function f2 name="untilItEscapes" parameters=[{type=ArrayBuffer}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin -, v0 overload=Uint8Array/2
    v3 = Call v1, -, v0
    v4 = PropGet v2 key="subarray"
    v5 = Call v1, -, v2
    v6 = PropGet v2 key="subarray"
    v7 = NewArray v4, v6 contents=anything
    Return v7
# CHECK: v3: anything = Call v1, -, v0
# CHECK-NEXT: v4: builtin(TypedArrayPrototypeSubarray) = Builtin builtin=TypedArrayPrototypeSubarray
# CHECK-NEXT: v5: anything = Call v1, -, v2
# CHECK-NEXT: v6: anything = PropGet v2 key="subarray"
}

function f3 name="viewOfUnknownOrigin" parameters=[{type=Uint8Array}] results=[{type=anything}] {
    v1 = PropGet v0 key="subarray"
    v2 = CallBuiltin v0 overload=TypedArrayPrototypeSubarray/1
    v3 = PropGet v2 key="subarray"
    v4 = CallBuiltin v0 overload=TypedArrayPrototypeBuffer/0
    v5 = PropGet v4 key="slice"
    v6 = NewArray v1, v3, v5 contents=anything
    Return v6
}
# CHECK-LABEL: function f3 name="viewOfUnknownOrigin"
# CHECK: v1: anything = PropGet v0 key="subarray"
# CHECK: v3: anything = PropGet v2 key="subarray"
# CHECK: v5: anything = PropGet v4 key="slice"
# FRESH-LABEL: function f0
# FRESH-LABEL: function f1
# FRESH-NEXT: v1 CallBuiltin: fresh
# FRESH-LABEL: function f3
# FRESH: v2 CallBuiltin: unknown
# FRESH: v4 CallBuiltin: unknown

function f4 name="storeThroughViewNobodyReads" parameters=[{type=ArrayBuffer}, {type=i32}] results=[{type=undefined}] {
    v2 = CallBuiltin -, v0 overload=Uint8Array/2
    v3 = Integer
    PutTypedArrayElement v2, v3, v1 typedArrayType=2 level=Proven [keyIsIntegral]
    Return
# DEAD: v2: Uint8Array = CallBuiltin -, v0 overload=Uint8Array/2
# DEAD: PutTypedArrayElement v2, v3, v1
}

function f5 name="storeThroughOtherView" parameters=[{type=ArrayBuffer}, {type=i32}] results=[{type=anything}] {
    v2 = CallBuiltin -, v0 overload=Uint8Array/2
    v3 = CallBuiltin -, v0 overload=Uint8Array/2
    v4 = Integer
    v5 = GetTypedArrayElement v2, v4 typedArrayType=2 level=Proven [keyIsIntegral]
    PutTypedArrayElement v3, v4, v1 typedArrayType=2 level=Proven [keyIsIntegral]
    v7 = GetTypedArrayElement v2, v4 typedArrayType=2 level=Proven [keyIsIntegral]
    v8 = NewArray v5, v7 contents=anything
    Return v8
# READS: v5: {{*}} = GetTypedArrayElement v2, v4
# READS-NEXT: PutTypedArrayElement v3, v4, v1
# READS-NEXT: v7: {{*}} = GetTypedArrayElement v2, v4
}
