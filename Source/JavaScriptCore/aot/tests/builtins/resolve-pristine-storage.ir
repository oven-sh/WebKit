function f3 name="noProof" parameters=[{type=Array}, {type=Array<anything, pristine[Names]>}, {type=string}] results=[{type=anything}] {
  b0(v0: Array, v1: Array<anything, pristine[Names]>, v2: string):
    v3 = Builtin builtin=ArrayPrototypeJoin
    v4 = Call v3, v0, v2
    v5 = Call v3, v1, v2
    Return v5
}
# CHECK-LABEL: function f3 name="noProof"
# CHECK-NOT: IsPristine
# The callee is proven, so the call is direct at once, with the result that the table gives. What its operands still have to be is tested by PlaceTypeTests, and the side that passes gets the matched form.
# CHECK: v4: string = CallBuiltin v0, v2 overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver
# CHECK-NEXT: v5: string = CallBuiltin v1, v2 overload=ArrayPrototypeJoin/0 builtinCallForm=AnyReceiver

function f4 name="unknownCodeBeforeCall" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: anything, v1: string):
    v2 = NewArray contents=anything
    v3 = Builtin builtin=ArrayPrototypeJoin
    v4 = Call v0
    v5 = Call v3, v2, v1
    Return v5
}
# CHECK-LABEL: function f4 name="unknownCodeBeforeCall"
# CHECK: v4: anything = Call v0
# CHECK-NEXT: v5: string = CallBuiltin v2, v1 overload=ArrayPrototypeJoin/0 [needsPristineReceiver]

