# An overload that demands pristine storage is taken on a proof by type, or on a proof that holds since the allocation: then the call carries a flag and no user code runs between proof and call
# FORM: Prepared optimizing
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="provenByType" parameters=[{type=Array<anything, pristine[Storage]>}, {type=string}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<anything, pristine[Storage]>, v1: string, v2: number):
    v3 = Builtin builtin=ArrayPrototypeJoin
    v4 = Call v3, v0, v1
    v5 = Builtin builtin=ArrayPrototypeIndexOf
    v6 = Call v5, v0, v2
    Return v6
}
