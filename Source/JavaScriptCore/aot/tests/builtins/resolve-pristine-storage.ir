# CHECK-NOT: needsPristineReceiver
# CHECK: v4: string = CallBuiltin v0, v1 overload=ArrayPrototypeJoin/0
# CHECK-NOT: needsPristineReceiver
# CHECK: v6: int[-1, 4294967295] = CallBuiltin v0, v2 overload=ArrayPrototypeIndexOf/0
# CHECK-NOT: needsPristineReceiver

