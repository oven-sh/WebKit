# charCodeAt at a position that lies outside every string: on the path inside the string the position has the type never, so that path ends at once and nothing is computed from the position
# FORM: Prepared optimizing
# RUN: pass SimplifyBuiltinCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="positionIsNegative" parameters=[{type=string}] results=[{type=number}] {
    v1 = Integer integer=-1
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    Return v2
# CHECK: [[isNotNegative0]]:{{*}}= LessEq {{*}}, v1
# CHECK-NEXT: Branch [[isNotNegative0]] -> taken [[inside0]](| 1), notTaken [[outside0]](
# CHECK-NOT: GetStringLength
# CHECK-NOT: GetStringCodeUnit
# CHECK: [[inside0]]({{*}}: never):
# CHECK-NEXT: Unreachable
# CHECK: = Double number=NaN
}

function f1 name="positionIsPastEveryString" parameters=[{type=string}, {type=int[4294967296, 4294967300]}] results=[{type=number}] {
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    Return v2
# CHECK: [[length1]]:{{*}}= GetStringLength v0
# CHECK-NEXT: [[isBelowLength1]]:{{*}}= Less v1, [[length1]]
# CHECK-NEXT: Branch [[isBelowLength1]] -> taken [[inside1]](| 0), notTaken [[outside1]](
# CHECK-NOT: GetStringCodeUnit
# CHECK: [[inside1]]({{*}}: never):
# CHECK-NEXT: Unreachable
# CHECK: = Double number=NaN
}

function f2 name="positionMayBeInside" parameters=[{type=string}, {type=int[-1, 100]}] results=[{type=number}] {
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    Return v2
# CHECK: [[unsigned2]]: int[0, 4294967295] = URShift v1,
# CHECK: = Less [[unsigned2]],
# CHECK: = GetStringCodeUnit v0,
}
