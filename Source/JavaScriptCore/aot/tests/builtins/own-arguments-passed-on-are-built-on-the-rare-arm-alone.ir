# f.apply(this, arguments) in a function with parameters and a hidden rest list: where no more arguments were passed than there are parameters, no arguments object and no list is made.
# Where more were passed and apply alone takes the object, the list is made of the parameters and the hidden rest list, and the object only where somebody has changed what an array is
# FORM: Prepared
# RUN: pass ResolveBuiltins SinkAllocations

module m0 path="main.js" displayPath="main.js"

function f0 name="tailCall" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: anything, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5
    ReturnCall v7
}
# CHECK-LABEL: function f0 name="tailCall"
# CHECK-NOT: CreateUnmappedArguments
# CHECK: Switch v2 cases=[0, 1] -> case [[none0]](), case [[one0]](), otherwise [[more0]]()
# CHECK-NOT: CreateUnmappedArguments
# CHECK-NOT: NewArgumentList
# CHECK: [[more0]]() frequency=Unlikely:
# CHECK-NEXT: [[pristine0]]: boolean = IsPristine v4 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch [[pristine0]] -> taken [[listed0]](| 0), notTaken [[changed0]]()
# CHECK: [[listed0]]([[guard0]]: guard) frequency=Unlikely:
# CHECK-NEXT: [[parameters0]]: Array = NewArray v3 contents=anything
# CHECK-NEXT: AppendElements [[parameters0]], v4, [[guard0]]
# CHECK-NEXT: [[callListed0]]: anything = CallList v0, v1, [[parameters0]]
# CHECK-NEXT: ReturnCall [[callListed0]]
# CHECK: [[changed0]]() frequency=Rare:
# CHECK-NEXT: [[object0]]: Arguments = CreateUnmappedArguments v2, v4, v3
# CHECK-NEXT: [[list0]]: Array = NewArgumentList v0, [[object0]]
# CHECK-NEXT: [[call0]]: anything = CallList v0, v1, [[list0]]
# CHECK-NEXT: ReturnCall [[call0]]

# The typed version of a function hands the object to the generic copy where a check fails.
function f1 name="handedToTheGenericCopy" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: boolean, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    Branch v3 -> taken b1(), notTaken b2(v5)
  b1():
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5
    ReturnCall v7
  b2(v8: Arguments) frequency=Unlikely:
    v9 = Builtin builtin=FunctionPrototypeApply
    v10 = Call v9, v0, v1, v8
    ReturnCall v10
}
# CHECK-LABEL: function f1 name="handedToTheGenericCopy"
# CHECK-NOT: CreateUnmappedArguments
# CHECK: Switch v2 cases=[0, 1] -> case [[none1]](), case [[one1]](), otherwise [[more1]]()
# CHECK: [[none1]]():
# CHECK-NEXT: [[callNone1]]: anything = Call v0, v1
# CHECK-NEXT: ReturnCall [[callNone1]]
# CHECK: [[one1]]():
# CHECK-NEXT: [[callOne1]]: anything = Call v0, v1, v3
# CHECK-NEXT: ReturnCall [[callOne1]]
# CHECK: [[more1]]() frequency=Unlikely:
# CHECK-NEXT: [[object1]]: Arguments = CreateUnmappedArguments v2, v4, v3

function f2 name="resultIsUsed" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: anything, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5
    v8 = Call v0, v1, v7
    Return v8
}
# CHECK-LABEL: function f2 name="resultIsUsed"
# CHECK-NOT: CreateUnmappedArguments
# CHECK: Switch v2 cases=[0, 1] -> case [[none2]](), case [[one2]](), otherwise [[more2]]()
# CHECK-NOT: CreateUnmappedArguments
# CHECK-NOT: CallBuiltin
# CHECK: [[more2]]() frequency=Unlikely:
# CHECK-NEXT: = IsPristine v4
# CHECK: [[parameters2]]: Array = NewArray v3 contents=anything
# CHECK-NEXT: AppendElements [[parameters2]], v4,
# CHECK: frequency=Rare:
# CHECK-NEXT: [[object2]]: Arguments = CreateUnmappedArguments v2, v4, v3
# CHECK-NEXT: [[call2]]: anything = CallBuiltin v0, v1, [[object2]] overload=FunctionPrototypeApply/0
