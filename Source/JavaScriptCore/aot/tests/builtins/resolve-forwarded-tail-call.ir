# A required tail call of a built-in that calls one operand once and returns its result becomes a call of that operand and stays a tail call
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed
# STATISTIC: BuiltinCallsResolved = 15

module m0 path="main.js" displayPath="main.js"
function f0 name="applyWithAnyList" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeApply
    v4 = Call v3, v0, v1, v2 calleeKey="apply" calleeName="f.apply"
    ReturnCall v4
# CHECK-NOT: CallBuiltin
# An array is handed on as it is. Of anything else a list is made.
# CHECK: [[isArray0]]: boolean = TypeTest v2 testedType=Array
# CHECK-NEXT: Branch [[isArray0]] -> taken [[array0]](| 0), notTaken [[other0]](| 0)
# CHECK: [[array0]]([[asItIs0]]: Array):
# CHECK-NEXT: [[passedArray0]]: anything = CallList v0, v1, [[asItIs0]]
# CHECK-NEXT: ReturnCall [[passedArray0]]
# CHECK: [[other0]]([[arrayLike0]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[list]]: {{*}} = NewArgumentList v0, [[arrayLike0]]
# CHECK-NEXT: [[passedList0]]: anything = CallList v0, v1, [[list]]
# CHECK-NEXT: ReturnCall [[passedList0]]
}

function f1 name="applyWithArray" parameters=[{type=anything}, {type=anything}, {type=Array<number>}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeApply
    v4 = Call v3, v0, v1, v2
    ReturnCall v4
# CHECK-NOT: NewArgumentList
# CHECK: v4: anything = CallList v0, v1, v2
# CHECK-NEXT: ReturnCall v4
}

function f2 name="applyWithoutList" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=FunctionPrototypeApply
    v3 = Call v2, v0, v1
    ReturnCall v3
# CHECK-NOT: NewArgumentList
# CHECK: v3: anything = Call v0, v1
# CHECK-NEXT: ReturnCall v3
}

function f3 name="applyWithNullishList" parameters=[{type=anything}, {type=anything}, {type=undefined|null}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeApply
    v4 = Call v3, v0, v1, v2
    ReturnCall v4
# CHECK-NOT: NewArgumentList
# CHECK: v4: anything = Call v0, v1
# CHECK-NEXT: ReturnCall v4
}

function f4 name="callOfFunction" parameters=[{type=function}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v4 = Builtin builtin=FunctionPrototypeCall
    v5 = Call v4, v0, v1, v2, v3
    ReturnCall v5
# CHECK: v5: anything = Call v0, v1, v2, v3
# CHECK-NEXT: ReturnCall v5
}

function f5 name="reflectApplyOfFunctionAndObject" parameters=[{type=function}, {type=anything}, {type=object}] results=[{type=anything}] {
    v3 = Builtin builtin=ReflectApply
    v4 = Call v3, -, v0, v1, v2
    ReturnCall v4
# CHECK: [[isArray5]]: boolean = TypeTest v2 testedType=Array
# CHECK-NEXT: Branch [[isArray5]] -> taken [[array5]](| 0), notTaken [[other5]](| 0)
# CHECK: [[array5]]([[asItIs5]]: Array):
# CHECK-NEXT: [[passedArray5]]: anything = CallList v0, v1, [[asItIs5]]
# CHECK-NEXT: ReturnCall [[passedArray5]]
# CHECK: [[other5]]([[arrayLike5]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[reflectedList]]: {{*}} = NewArgumentList v0, [[arrayLike5]]
# CHECK-NEXT: [[passedList5]]: anything = CallList v0, v1, [[reflectedList]]
# CHECK-NEXT: ReturnCall [[passedList5]]
}

# Reflect.apply throws for a list that is undefined or null, where apply passes no argument.
function f6 name="reflectApplyOfAnyList" parameters=[{type=function}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=ReflectApply
    v4 = Call v3, -, v0, v1, v2
    ReturnCall v4
# CHECK-NOT: NewArgumentList
# CHECK: [[isArray6]]: boolean = TypeTest v2 testedType=Array
# CHECK-NEXT: Branch [[isArray6]] -> taken [[array6]](| 0), notTaken [[other6]](| 0)
# CHECK: [[array6]]([[asItIs6]]: Array):
# CHECK-NEXT: [[passedArray6]]: anything = CallList v0, v1, [[asItIs6]]
# CHECK-NEXT: ReturnCall [[passedArray6]]
# CHECK: [[other6]]([[noArray6]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[own6]]: anything = Call v3, -, v0, v1, [[noArray6]]
# CHECK-NEXT: ReturnCall [[own6]]
}

# call throws its own TypeError for a receiver that is no function, so the call is passed on behind a test, and both arms stay tail calls.
function f7 name="callOfAnything" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeCall
    v4 = Call v3, v0, v1, v2
    ReturnCall v4
# CHECK: [[isFunction7]]: boolean = TypeTest v0 testedType=function
# CHECK-NEXT: Branch [[isFunction7]] -> taken [[function7]](| 0), notTaken [[other7]](| 0)
# CHECK: [[function7]]([[callee7]]:{{*}}):
# CHECK-NEXT: [[passed7]]: anything = Call [[callee7]], v1, v2
# CHECK-NEXT: ReturnCall [[passed7]]
# CHECK: [[other7]]([[noFunction7]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[own7]]: anything = Call v3, [[noFunction7]], v1, v2
# CHECK-NEXT: ReturnCall [[own7]]
}

# Promise.try calls its operand once with the arguments after it, as call does, and returns a promise of the result: it passes no call on. It is native and returns to its caller,
# so it takes the ordinary way: resolve-builtins-required-tail-call.ir
function f8 name="resultIsNotReturned" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=Promise
    v3 = Builtin builtin=PromiseTry
    v4 = Call v3, v2, v0, v1
    ReturnCall v4
# CHECK: v4: Promise = CallBuiltin v2, v0, v1 overload=PromiseTry/0 @0 tail
# CHECK-NEXT: Return v4
}

# A tail call that may be demoted takes the ordinary way.
function f9 name="allowedTailCall" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeApply
    v4 = Call v3, v0, v1, v2
    ReturnCall v4 requirement=Allowed
# CHECK-NOT: NewArgumentList
# CHECK: v4: anything = CallBuiltin v0, v1, v2 overload=FunctionPrototypeApply/0
# CHECK-NEXT: Return v4
}

# Reflect.apply has an error of its own for a target that is no function too.
function f10 name="reflectApplyOfAnyTarget" parameters=[{type=anything}, {type=anything}, {type=object}] results=[{type=anything}] {
    v3 = Builtin builtin=ReflectApply
    v4 = Call v3, -, v0, v1, v2
    ReturnCall v4
# CHECK: [[isFunction10]]: boolean = TypeTest v0 testedType=function
# CHECK-NEXT: Branch [[isFunction10]] -> taken [[function10]](| 0), notTaken [[other10]](| 0)
# CHECK: [[function10]]([[target10]]:{{*}}):
# CHECK-NEXT: [[isArray10]]: boolean = TypeTest v2 testedType=Array
# CHECK-NEXT: Branch [[isArray10]] -> taken [[array10]](| 0), notTaken [[arrayLike10]](| 0)
# CHECK: [[other10]]([[noFunction10]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[own10]]: anything = Call v3, -, [[noFunction10]], v1, v2
# CHECK-NEXT: ReturnCall [[own10]]
# CHECK: [[array10]]([[asItIs10]]: Array):
# CHECK-NEXT: [[passedArray10]]: anything = CallList [[target10]], v1, [[asItIs10]]
# CHECK-NEXT: ReturnCall [[passedArray10]]
# CHECK: [[arrayLike10]]([[object10]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[list10]]: {{*}} = NewArgumentList [[target10]], [[object10]]
# CHECK-NEXT: [[passed10]]: anything = CallList [[target10]], v1, [[list10]]
# CHECK-NEXT: ReturnCall [[passed10]]
}

# A target that is never a function is left to the error of the built-in.
function f11 name="reflectApplyOfNumber" parameters=[{type=number}, {type=anything}, {type=object}] results=[{type=anything}] {
    v3 = Builtin builtin=ReflectApply
    v4 = Call v3, -, v0, v1, v2
    ReturnCall v4
# CHECK-NOT: TypeTest
# CHECK: v4: anything = Call v3, -, v0, v1, v2
# CHECK-NEXT: ReturnCall v4
}

# Under any other key apply runs in a frame of its own. An array is handed on from there. Anything else is read there, so the call of apply stays.
function f12 name="applyUnderAnotherKeyWithAnyList" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeApply
    v4 = Call v3, v0, v1, v2 calleeKey="run" calleeName="o.run"
    ReturnCall v4
# CHECK: [[isArray12]]: boolean = TypeTest v2 testedType=Array
# CHECK-NEXT: Branch [[isArray12]] -> taken [[array12]](| 0), notTaken [[other12]](| 0)
# CHECK: [[array12]]([[asItIs12]]: Array):
# CHECK-NEXT: [[passedArray12]]: anything = CallList v0, v1, [[asItIs12]] calledBuiltin=FunctionPrototypeApply
# CHECK-NEXT: ReturnCall [[passedArray12]]
# CHECK: [[other12]]([[arrayLike12]]:{{*}}) frequency=Unlikely:
# CHECK-NEXT: [[own12]]: anything = Call v3, v0, v1, [[arrayLike12]] calleeKey="run" calleeName="o.run"
# CHECK-NEXT: ReturnCall [[own12]]
}
