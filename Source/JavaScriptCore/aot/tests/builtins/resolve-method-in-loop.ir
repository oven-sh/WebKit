# A call that resolves to a built-in inside a loop narrows what the loop adds its result to, in the run that resolves it; a second call that stays unknown keeps the loop parameter wide
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass ResolveBuiltins

module m0 path="main.js" displayPath="main.js"
function f0 name="sumOfCodes" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2, v2)
  b1(v4, v5):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v0 key="charCodeAt"
    v9 = Call v8, v0, v4 calleeKey="charCodeAt"
    v10 = Add v5, v9
    v11 = Add v4, v3
    Jump -> next b1(v11, v10)
  b3():
    Return v5
# CHECK: b1(v4: int|whole, v5: number):
# CHECK: v9: number = CallBuiltin v0, v4 overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: v10: number = Add v5, v9
}

function f1 name="sumOfCodesAndUnknownResults" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v3)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = PropGet v0 key="charCodeAt"
    v10 = Call v9, v0, v5 calleeKey="charCodeAt"
    v11 = Add v6, v10
    v12 = Call v2, -, v5
    v13 = Add v11, v12
    v14 = Add v5, v4
    Jump -> next b1(v14, v13)
  b3():
    Return v6
# CHECK: b1(v5: int|whole, v6: number|string|bigint):
# CHECK: = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: v11: number|string|bigint = Add v6, v10
# CHECK: v13: number|string|bigint = Add v11, v12
}

function f2 name="sumStartsFromUnknownValue" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = PropGet v0 key="charCodeAt"
    v10 = Call v9, v0, v5 calleeKey="charCodeAt"
    v11 = Add v6, v10
    v12 = Add v5, v4
    Jump -> next b1(v12, v11)
  b3():
    Return v6
# CHECK: b1(v5: int|whole, v6: anything):
# CHECK: = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0
# CHECK-NEXT: v11: number|string|bigint = Add v6, v10
}
