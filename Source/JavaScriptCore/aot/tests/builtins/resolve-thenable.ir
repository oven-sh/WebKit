# Promise.resolve of a value that cannot be a promise becomes a fresh promise and the ordinary resolve operation, which alone knows about thenables
# FORM: Prepared
# RUN: pass ResolveBuiltins SimplifyBuiltinCalls
# CHECK: outcome: Changed
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="a" declared={type=number}}] flow={baseState=None}
layout L1 kind=Instance name="Task" constructor=f0 flags=[HasHeritage] flow={baseState=BuiltinClass baseClass=Promise impossibleMutations=[ChangePrototype] addedKeysAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
function f0 name="Task" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L1

function f1 name="constant" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Promise
    v1 = PropGet v0 key="resolve"
    v2 = Integer integer=1
    v3 = Call v1, v0, v2 calleeKey="resolve"
    Return v3
}
# CHECK-LABEL: function f1 name="constant"
# CHECK-NOT: CallBuiltin
# CHECK-NOT: IsNotThenable
# CHECK: [[promise1]]: Promise = NewPromise
# CHECK-NEXT: ResolvePromise [[promise1]], v2
# CHECK-NEXT: v3: Promise<1> = Upcast [[promise1]] castType=Promise<1>
# CHECK-NOT: IsNotThenable

function f2 name="primitive" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=Promise
    v2 = PropGet v1 key="resolve"
    v3 = Call v2, v1, v0 calleeKey="resolve"
    Return v3
}
# CHECK-LABEL: function f2 name="primitive"
# CHECK-NOT: CallBuiltin
# CHECK-NOT: IsNotThenable
# CHECK: [[promise2]]: Promise = NewPromise
# CHECK-NEXT: ResolvePromise [[promise2]], v0
# CHECK-NEXT: v3: Promise<string> = Upcast [[promise2]] castType=Promise<string>
# CHECK-NOT: IsNotThenable

function f3 name="objectLiteral" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Promise
    v1 = PropGet v0 key="resolve"
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Call v1, v0, v3 calleeKey="resolve"
    Return v4
}
# CHECK-LABEL: function f3 name="objectLiteral"
# CHECK-NOT: CallBuiltin
# CHECK-NOT: IsNotThenable
# CHECK: [[promise3]]: Promise = NewPromise
# CHECK-NEXT: ResolvePromise [[promise3]], v3
