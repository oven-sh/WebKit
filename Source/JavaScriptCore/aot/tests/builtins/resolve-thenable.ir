function f6 name="pristinePromise" parameters=[{type=Promise<anything, pristine[Names]>}] results=[{type=anything}] {
  b0(v0: Promise<anything, pristine[Names]>):
    v1 = Builtin builtin=Promise
    v2 = PropGet v1 key="resolve"
    v3 = Call v2, v1, v0 calleeKey="resolve"
    Return v3
