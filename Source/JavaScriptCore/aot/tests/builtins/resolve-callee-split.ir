function f13 name="callWithoutThis" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="push"
    v3 = Call v2, -, v1 calleeKey="push"
