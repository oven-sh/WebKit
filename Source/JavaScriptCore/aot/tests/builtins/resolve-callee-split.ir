function f14 name="push" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f15 name="calleePredictedAmongOtherValues" parameters=[{type=anything}, {type=i32}] results=[{type=anything}] {
  b0(v0: anything, v1: i32):
    v2 = PropGet v0 key="slice"
    v3 = Predict v2 predicted=undefined|null|boolean|number|string|symbol|bigint|builtin(StringPrototypeSlice)|builtin(StringPrototypeTrim)
    v4 = Call v3, v0, v1 calleeKey="slice" callees=[builtin(StringPrototypeSlice), builtin(StringPrototypeTrim), ..]
    Return v4
}
# CHECK-LABEL: function f15 name="calleePredictedAmongOtherValues"
# CHECK-NOT: ArrayPrototypeSlice
# CHECK: TypeTest v3 testedType=builtin(StringPrototypeSlice)
# CHECK-NOT: ArrayPrototypeSlice
# CHECK: anything ~ string = Predict v0 predicted=string
# CHECK-NOT: TypeTest
# PLACED-LABEL: function f15 name="calleePredictedAmongOtherValues"
# PLACED: TypeTest v3 testedType=builtin(StringPrototypeSlice)
# PLACED: string = CallBuiltin {{*}} overload=StringPrototypeSlice/

function f16 name="calleePredictedToBeAnotherBuiltin" parameters=[{type=anything}, {type=i32}] results=[{type=anything}] {
  b0(v0: anything, v1: i32):
    v2 = PropGet v0 key="slice"
    v3 = Predict v2 predicted=undefined|builtin(StringPrototypeTrim)
    v4 = Call v3, v0, v1 calleeKey="slice"
    Return v4
}
# CHECK-LABEL: function f16 name="calleePredictedToBeAnotherBuiltin"
# CHECK-NOT: TypeTest
# CHECK: v4: anything = Call v3, v0, v1 calleeKey="slice"
# CHECK-NEXT: Return v4

function f17 name="calleeWithWrittenType" parameters=[{type=anything}, {type=i32}, {type=anything written=L0}] results=[{type=anything}] {
  b0(v0: anything, v1: i32, v2: anything ? L0):
    v3 = Call v2, v0, v1 calleeKey="slice"
    Return v3
}
# CHECK-LABEL: function f17 name="calleeWithWrittenType"
# CHECK-NOT: TypeTest
# CHECK: v3: anything = Call v2, v0, v1 calleeKey="slice"
# CHECK-NEXT: Return v3
