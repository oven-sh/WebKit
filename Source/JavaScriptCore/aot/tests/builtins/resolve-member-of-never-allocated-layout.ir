# RUN: pass ResolveBuiltins
# RUN(EFFECTS): effects f0 f1

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="NeverMade" constructor=f4 flags=[HasHeritage] flow={allocation=NeverAllocated baseState=BuiltinClass baseClass=Map constructorOrders=[{}] fieldCreation=OnlyAtConstruction thisLeak=DoesNotLeak impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType, LoseShape] ownAccessorsAreComplete=true} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed constructorProperty=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
