# Object.defineProperties(target, Object.getOwnPropertyDescriptors(source)) is two calls of the run time, each where its call stood: the first hands an ordinary source on, the second defines each own property of it on the target as it stands, where the call alone has the descriptors and nothing happens between the two calls.
# Somebody else who has the descriptors may change them or keep them, and what runs in between may change the source: then the two calls stay
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" declared={type=anything} initialization=Undefined
function f0 name="oneAfterTheOther" parameters=[{type=object}, {type=object}] results=[{type=object}] {
  b0(v0: object, v1: object):
    v2 = CallBuiltin -, v1 overload=ObjectGetOwnPropertyDescriptors/0
    v3 = CallBuiltin -, v0, v2 overload=ObjectDefineProperties/0
    Return v3
}
# CHECK-LABEL: function f0 name="oneAfterTheOther"
# CHECK-NOT: ObjectGetOwnPropertyDescriptors
# CHECK: v2: object = CallBuiltin -, v1 overload=CompilerHelpersDescribeUnlessOrdinary/0
# CHECK-NEXT: v3: object = CallBuiltin -, v0, v2, v2 overload=CompilerHelpersDefinePropertiesFrom/0
# CHECK-NEXT: Return v3

function f1 name="throughCastsThatTestNothing" parameters=[{type=object}, {type=object}] results=[{type=object}] {
  b0(v0: object, v1: object):
    v2 = CallBuiltin -, v1 overload=ObjectGetOwnPropertyDescriptors/0
    v3 = Upcast v2 castType=object
    v4 = Integer integer=1
    v5 = CallBuiltin -, v0, v3 overload=ObjectDefineProperties/0
    Return v5
}
# CHECK-LABEL: function f1 name="throughCastsThatTestNothing"
# CHECK-NOT: ObjectGetOwnPropertyDescriptors
# CHECK-NOT: Upcast
# CHECK: v2: object = CallBuiltin -, v1 overload=CompilerHelpersDescribeUnlessOrdinary/0
# CHECK-NOT: Upcast
# CHECK: v5: object = CallBuiltin -, v0, v2, v2 overload=CompilerHelpersDefinePropertiesFrom/0

