# A test in front of the two calls has copied what follows it, and the copies join between the calls
function f11 name="copiesJoinBetweenTheCalls" parameters=[{type=object}, {type=object}, {type=boolean}] results=[{type=object}] {
  b0(v0: object, v1: object, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallBuiltin -, v1 overload=ObjectGetOwnPropertyDescriptors/0
    Jump -> next b5(v3)
  b2():
    v4 = CallBuiltin -, v1 overload=ObjectGetOwnPropertyDescriptors/0
    Jump -> next b3()
  b3():
    v5 = TypeTest v0 testedType=object
    Branch v5 -> taken b4(), notTaken b6()
  b4():
    Jump -> next b5(v4)
  b5(v6: Object):
    v7 = CallBuiltin -, v0, v6 overload=ObjectDefineProperties/0
    Return v7
  b6():
    Unreachable
}
# CHECK-LABEL: function f11 name="copiesJoinBetweenTheCalls"
# CHECK-NOT: ObjectGetOwnPropertyDescriptors
# CHECK: v3: object = CallBuiltin -, v1 overload=CompilerHelpersDescribeUnlessOrdinary/0
# CHECK-NEXT: Jump -> next b5(v3)
# CHECK-NOT: ObjectGetOwnPropertyDescriptors
# CHECK: v4: object = CallBuiltin -, v1 overload=CompilerHelpersDescribeUnlessOrdinary/0
# CHECK: Jump -> next b5(v4)
# CHECK: b5(v6: object):
# CHECK: = CallBuiltin -, v0, v6, v6 overload=CompilerHelpersDefinePropertiesFrom/0

