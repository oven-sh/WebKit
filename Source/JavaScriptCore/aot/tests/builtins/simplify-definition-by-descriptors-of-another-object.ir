# CHECK-NEXT: = CallBuiltin -, v2, v3 overload=ObjectDefineProperties/0

function f4 name="descriptorsAreKept" parameters=[{type=object}, {type=object}] results=[{type=object}] {
  b0(v0: object, v1: object):
    v2 = CallBuiltin -, v1 overload=ObjectGetOwnPropertyDescriptors/0
    PutModuleVariable v2 variable=g0
