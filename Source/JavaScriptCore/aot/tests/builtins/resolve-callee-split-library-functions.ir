# A method written in JavaScript gets an arm of the split on the callee only where its library function is compiled: without a body behind it the arm would end in the same call as the generic path
# FORM: Prepared
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="oneOfThreeIsCompiled" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="return"
    v2 = Call v1, v0 calleeKey="return"
    Return v2
}
# CHECK-LABEL: function f0 name="oneOfThreeIsCompiled"
# CHECK: v1: anything = PropGet v0 key="return"
# CHECK-NOT: IteratorHelperPrototypeReturn
# CHECK: [[isReturn]]: boolean = TypeTest v1 testedType=builtin(WrapForValidIteratorPrototypeReturn)
# CHECK-NEXT: Branch [[isReturn]] -> taken [[arm]](| 0), notTaken [[rest]](| 0)
# CHECK-NOT: TypeTest
# CHECK: [[arm]]({{*}}: builtin(WrapForValidIteratorPrototypeReturn)):
# CHECK-NEXT: [[wrapper]]: anything ~ WrapForValidIterator = Predict v0 predicted=WrapForValidIterator
# CHECK-NEXT: anything = CallBuiltin [[wrapper]] overload=WrapForValidIteratorPrototypeReturn/0 builtinCallForm=AnyReceiver
# CHECK-NOT: TypeTest
# CHECK: [[rest]]([[other]]: anything) frequency=Unlikely:
# CHECK-NEXT: anything = Call [[other]], v0 calleeKey="return"

function f1 name="noneIsCompiled" parameters=[{type=anything}] results=[{type=anything}] {
