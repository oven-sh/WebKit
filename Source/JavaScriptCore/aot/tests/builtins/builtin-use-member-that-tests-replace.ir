# A locked member that a test run lists as replaceable is taken for what the realm was created with behind a test of its location, like a member that was never locked.
# Its neighbors stay locked, and so does a member under a name that the language reads by itself.
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
replaceablebuiltin member=MathMin
replaceablebuiltin member=ArrayPrototypeSymbolIterator
replaceablebuiltin member=StringPrototypeIndexOf
replaceablebuiltin member=StringPrototypeToString
function f0 name="functionOfNamespace" results=[{type=anything}] {
    v0 = Builtin builtin=Math
    v1 = PropGet v0 key="min"
    Return v1
}
# CHECK-LABEL: function f0 name="functionOfNamespace"
# CHECK: [[isUnchanged0]]: boolean{{*}} = IsBuiltinLocationUnchanged member=MathMin
# CHECK-NEXT: Branch [[isUnchanged0]] -> taken
# CHECK: v1: builtin(MathMin) = Builtin builtin=MathMin
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet v0 key="min"

function f1 name="methodOfPrimitive" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="indexOf"
    Return v1
}
# CHECK-LABEL: function f1 name="methodOfPrimitive"
# CHECK: [[isUnchanged1]]: boolean{{*}} = IsBuiltinLocationUnchanged member=StringPrototypeIndexOf
# CHECK: v1: builtin(StringPrototypeIndexOf) = Builtin builtin=StringPrototypeIndexOf
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet v0 key="indexOf"

function f2 name="neighborStaysLocked" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=Math
    v2 = PropGet v1 key="max"
    v3 = PropGet v0 key="lastIndexOf"
    v4 = NewArray v2, v3 contents=anything
    Return v4
}
# CHECK-LABEL: function f2 name="neighborStaysLocked"
# CHECK-NOT: IsBuiltinLocationUnchanged

function f3 name="nameThatTheLanguageReadsStaysLocked" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="toString"
    Return v1
}
# CHECK-LABEL: function f3 name="nameThatTheLanguageReadsStaysLocked"
# CHECK-NOT: IsBuiltinLocationUnchanged
