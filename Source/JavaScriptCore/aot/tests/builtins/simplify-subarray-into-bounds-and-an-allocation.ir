function f3 name="aStartThatIsNoNumber" parameters=[{type=Uint8Array<int[0, 255], pristine[Names]>}, {type=undefined}] results=[{type=Uint8Array}] {
  b0(v0: Uint8Array<int[0, 255], pristine[Names]>, v1: undefined):
    v2 = CallBuiltin v0, v1 overload=TypedArrayPrototypeSubarray/0
    Return v2
}
