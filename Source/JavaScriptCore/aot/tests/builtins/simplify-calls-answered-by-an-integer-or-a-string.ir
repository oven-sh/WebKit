# isFinite and Number.isSafeInteger of an integer are constants, as Number.isFinite and Number.isInteger are, and String of a string is the string, as Number of a number is the number
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="testsOfInt32" parameters=[{type=i32}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = CallBuiltin -, v0 overload=IsFinite/0
    v2 = CallBuiltin -, v0 overload=NumberIsSafeInteger/0
    v3 = NewArray v1, v2 contents=anything
    Return v3
}
# CHECK-LABEL: function f0 name="testsOfInt32"
# CHECK-NOT: CallBuiltin
# CHECK: v1: true = Boolean boolean=true
# CHECK-NEXT: v2: true = Boolean boolean=true

