# What a function inherits is looked up on Function.prototype for as long as the function is a closure as it was created: it has gained no property and kept its prototype.
# A receiver that is only expected to be a function is tested for being one, then for the Structure that a plain function is created with, and the read is a constant behind both tests.
# The closure of a coroutine inherits from another prototype and has no such test, and the length and the name of a function that nobody knows stay reads by name.
# A constructor function is looked up like a class object, but it inherits from no class object: its parent is where its prototype object inherits from
# FORM: Prepared
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement
# CHECK: outcome: Changed
# RUN(STATICMEMBER): member-lookup start=ClassObject layout=L0 key="make"
# STATICMEMBER: Method level=Proven holder=L0 method=F10
# RUN(NOTFROMPARENT): member-lookup start=ClassObject layout=L1 key="make"
# NOTFROMPARENT: Absent level=Expected conditions=[MemberUnchanged(L1, Static, K{{*}}), PrototypeLinkUnchanged(L1, Static)]
# RUN(FUNCTIONMEMBER): member-lookup start=ClassObject layout=L1 key="call"
# FUNCTIONMEMBER: Builtin level=Expected builtin=B{{*}} conditions=[MemberUnchanged(L1, Static, K{{*}}), PrototypeLinkUnchanged(L1, Static)]
# RUN(OWNLOOKUP): member-lookup start=ClassObject layout=L1 key="make" access=Has own
# OWNLOOKUP: Absent level=Expected conditions=[MemberUnchanged(L1, Static, K{{*}})]
# RUN(CREATEDAGAIN): member-lookup start=ClassObject layout=L2 key="call"
# CREATEDAGAIN: Builtin level=Expected builtin=B{{*}} conditions=[MemberUnchanged(L2, Static, K{{*}}), PrototypeLinkUnchanged(L2, Static), ClassEvaluatedOnce(L2)]
# RUN(PROTOTYPEOBJECT): member-lookup start=ClassObject layout=L0 key="prototype"
# PROTOTYPEOBJECT: Unknown level=Unknown cause=Unknown

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Shape" constructor=f7 flags=[IsConstructorFunction] flow={baseState=None} classFlow={evaluations=AtMostOnce namedMembers=[{key="make" side=Static function=f10 mutability=Fixed}]}
layout L1 kind=Instance name="Circle" base=L0 constructor=f8 flags=[IsConstructorFunction] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeBase=L0}
layout L2 kind=Instance name="MadeByFactory" constructor=f9 flags=[IsConstructorFunction] flow={baseState=None}

function f0 name="inheritedMember" parameters=[{type=function flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ function):
    v1 = PropGet v0 key="call"
    Return v1
}
# PLAN: function f0
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=function before v1; test IsPristine v0 builtinClass=Function aspects=[Names] before v1; uses v1;
# CHECK-LABEL: function f0 name="inheritedMember"
# CHECK: [[isFunction0]]: boolean{{*}} = TypeTest v0 testedType=function
# CHECK-NEXT: Branch [[isFunction0]] -> taken [[tested0]](| 0), notTaken
# CHECK: v1: builtin(FunctionPrototypeCall) = Builtin builtin=FunctionPrototypeCall
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet {{*}} key="call"
# CHECK: [[tested0]]([[function0]]: function):
# CHECK-NEXT: boolean = IsPristine [[function0]] builtinClass=Function aspects=[Names]

function f1 name="membersShareTheTests" parameters=[{type=function flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ function):
    v1 = PropGet v0 key="call"
    v2 = PropGet v0 key="apply"
    v3 = PropGet v0 key="constructor"
    v4 = NewArray v1, v2, v3 contents=anything
    Return v4
}
# PLAN: function f1
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=function before v1; test IsPristine v0 builtinClass=Function aspects=[Names] before v1; uses v1 v2 v3;
# CHECK-LABEL: function f1 name="membersShareTheTests"
# CHECK-COUNT-1: = TypeTest
# CHECK-NOT: = TypeTest
# CHECK: v1: builtin(FunctionPrototypeCall) = Builtin builtin=FunctionPrototypeCall
# CHECK-NEXT: v2: builtin(FunctionPrototypeApply) = Builtin builtin=FunctionPrototypeApply
# CHECK-NEXT: v3: builtin(Function) = Builtin builtin=Function
# CHECK-NOT: = TypeTest

function f2 name="oneExpectedFunction" parameters=[{type=f11 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ f11):
    v1 = PropGet v0 key="apply"
    Return v1
}
# Nothing here says what flow knows about the closures of the function, so a closure of it is tested like any other.
# PLAN: function f2
# PLAN-NEXT: stretch 0: test TypeTest v0 testedType=f11 before v1; test IsPristine v0 builtinClass=Function aspects=[Names] before v1; uses v1;
# CHECK-LABEL: function f2 name="oneExpectedFunction"
# CHECK: = TypeTest v0 testedType=f11
# CHECK: v1: builtin(FunctionPrototypeApply) = Builtin builtin=FunctionPrototypeApply
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = PropGet {{*}} key="apply"
# CHECK: ([[target2]]: f11):
# CHECK-NEXT: boolean = IsPristine [[target2]] builtinClass=Function aspects=[Names]

function f3 name="provenFunction" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = PropGet v0 key="call"
    v3 = Call v2, v0, v1 calleeKey="call"
    Return v3
}
# PLAN: function f3
# PLAN-NEXT: stretch 0: test IsPristine v0 builtinClass=Function aspects=[Names] before v2;
# CHECK-LABEL: function f3 name="provenFunction"
# CHECK-NOT: testedType=function
# CHECK: boolean = IsPristine v0 builtinClass=Function aspects=[Names]
# CHECK-NOT: testedType=function
# CHECK: = Builtin builtin=FunctionPrototypeCall
# CHECK: anything = CallBuiltin v0, v1 overload=FunctionPrototypeCall/0
# CHECK: frequency=Unlikely
# CHECK: anything = PropGet v0 key="call"
# CHECK: anything = Call {{*}}, v0, v1 calleeKey="call"

function f4 name="closureOfCoroutine" parameters=[{type=AsyncFunction}] results=[{type=anything}] {
  b0(v0: AsyncFunction):
    v1 = PropGet v0 key="call"
    Return v1
}
# PLAN: function f4
# PLAN-NEXT: function f5
# CHECK-LABEL: function f4 name="closureOfCoroutine"
# CHECK-NEXT: b0(v0: AsyncFunction):
# CHECK-NEXT: v1: anything = PropGet v0 key="call"
# CHECK-NEXT: Return v1

function f5 name="expectedClosureOfCoroutine" parameters=[{type=AsyncFunction flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ AsyncFunction):
    v1 = PropGet v0 key="call"
    Return v1
}
# PLAN-NEXT: function f6
# CHECK-LABEL: function f5 name="expectedClosureOfCoroutine"
# CHECK-NEXT: b0(v0: anything ~ AsyncFunction):
# CHECK-NEXT: v1: anything = PropGet v0 key="call"
# CHECK-NEXT: Return v1

function f6 name="ownPropertiesOfSomeFunction" parameters=[{type=function flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ function):
    v1 = PropGet v0 key="length"
    v2 = PropGet v0 key="name"
    v3 = NewArray v1, v2 contents=anything
    Return v3
}
# PLAN-NEXT: function f10
# CHECK-LABEL: function f6 name="ownPropertiesOfSomeFunction"
# CHECK-NEXT: b0(v0: anything ~ function):
# CHECK-NEXT: v1: anything = PropGet v0 key="length"
# CHECK-NEXT: v2: anything = PropGet v0 key="name"

function f7 name="Shape" flags=[HasThis] thisType={type=object} results=[{type=undefined}]
function f8 name="Circle" flags=[HasThis] thisType={type=object} results=[{type=undefined}]
function f9 name="MadeByFactory" flags=[HasThis] thisType={type=object} results=[{type=undefined}]
function f10 name="make" results=[{type=anything}] {
  b0():
    Return
}
function f11 name="target" results=[{type=anything}] {
  b0():
    Return
}
