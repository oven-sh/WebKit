# The last element of the array of a split at a literal, where nothing else uses the array, is the rest of the string behind the last separator, so no array is made. A separator that can overlap itself is searched from the left, as split does. A read in a loop whose split stands outside the loop keeps the array
# FORM: Prepared
# RUN: pass SimplifyBuiltinCalls
# RUN(SUNK): pass SimplifyBuiltinCalls EliminateDeadCode SinkAllocations

module m0 path="main.js" displayPath="main.js"
function f0 name="popped" parameters=[{type=string}] results=[{type=anything}] {
    v1 = String string="/"
    v2 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v3 = AssumeType v2 castType=Array<string, proven, pristine[Storage, Names]>
    v4 = CallBuiltin v3 overload=ArrayPrototypePop/0
    Return v4
# CHECK: [[from0]]: 2147483647 = Integer integer=2147483647
# CHECK-NEXT: [[found0]]: int[-1, 2147483647] = StringLastIndexOfLiteral v0, [[from0]] literal="/"
# CHECK-NEXT: [[width0]]: 1 = Integer integer=1
# CHECK-NEXT: [[start0]]: {{*}} = Add [[found0]], [[width0]]
# CHECK-NEXT: [[end0]]: {{*}} = GetStringLength v0
# CHECK-NEXT: v4: string = Substring v0, [[start0]], [[end0]]
# CHECK-NEXT: Return v4
# SUNK-NOT: StringPrototypeSplit
# SUNK: = Substring v0,
}

function f1 name="atMinusOne" parameters=[{type=string}] results=[{type=anything}] {
    v1 = String string=", "
    v2 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v3 = AssumeType v2 castType=Array<string, proven, pristine[Storage, Names]>
    v4 = Integer integer=-1
    v5 = CallBuiltin v3, v4 overload=ArrayPrototypeAt/0
    Return v5
# CHECK: [[found1]]: int[-1, 2147483647] = StringLastIndexOfLiteral v0, {{*}} literal=", "
# CHECK-NEXT: [[width1]]: 2 = Integer integer=2
# CHECK-NEXT: [[behind1]]: {{*}} = Add [[found1]], [[width1]]
# CHECK-NEXT: [[bits1]]: 31 = Integer integer=31
# CHECK-NEXT: [[signs1]]: {{*}} = RShift [[found1]], [[bits1]]
# CHECK-NEXT: [[mask1]]: {{*}} = BitNot [[signs1]]
# CHECK-NEXT: [[start1]]: {{*}} = BitAnd [[behind1]], [[mask1]]
# CHECK-NEXT: [[end1]]: {{*}} = GetStringLength v0
# CHECK-NEXT: v5: string = Substring v0, [[start1]], [[end1]]
# SUNK-NOT: StringPrototypeSplit
}

function f2 name="atLengthMinusOne" parameters=[{type=string}] results=[{type=anything}] {
    v1 = String string="."
    v2 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v3 = AssumeType v2 castType=Array<string, proven, pristine[Storage, Names]>
    v4 = CallBuiltin v3 overload=ArrayPrototypeLength/0
    v5 = Integer integer=1
    v6 = Sub v4, v5
    v7 = ElemGet v3, v6
    Return v7
# CHECK: = StringLastIndexOfLiteral v0, {{*}} literal="."
# CHECK-NOT: ElemGet
# CHECK: v7: string = Substring v0,
# SUNK-NOT: StringPrototypeSplit
# SUNK-NOT: ArrayPrototypeLength
# SUNK: = Substring v0,
}

function f3 name="arrayIsUsedAfterwards" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = String string="/"
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    v5 = CallBuiltin v4 overload=ArrayPrototypePop/0
    v6 = Call v1, -, v5, v4
    Return v6
# CHECK-NOT: StringLastIndexOfLiteral
# CHECK: v5:{{*}}= CallBuiltin v4 overload=ArrayPrototypePop/0
}

