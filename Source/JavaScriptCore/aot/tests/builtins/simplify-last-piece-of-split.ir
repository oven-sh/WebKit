function f17 name="poppedInInnerLoop" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = String string="/"
    Jump -> next b1()
  b1():
    LoopHint
    v4 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
