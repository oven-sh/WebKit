function f7 name="lengthIsAlsoReturned" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = String string="/"
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    v5 = CallBuiltin v4 overload=ArrayPrototypeLength/0
    v6 = Integer integer=1
    v7 = Sub v5, v6
    v8 = ElemGet v4, v7
    v9 = Call v1, -, v8, v5
    Return v9
# CHECK-NOT: StringLastIndexOfLiteral
# CHECK: v8:{{*}}= ElemGet v4, v7
}

function f8 name="lengthOfAnotherArray" parameters=[{type=string}, {type=Array<string, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = String string="/"
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    v5 = CallBuiltin v1 overload=ArrayPrototypeLength/0
    v6 = Integer integer=1
    v7 = Sub v5, v6
    v8 = ElemGet v4, v7
    Return v8
# CHECK-NOT: StringLastIndexOfLiteral
# CHECK: v8:{{*}}= ElemGet v4, v7
}

function f9 name="separatorOverlapsItself" parameters=[{type=string}] results=[{type=anything}] {
    v1 = String string="::"
    v2 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v3 = AssumeType v2 castType=Array<string, proven, pristine[Storage, Names]>
    v4 = CallBuiltin v3 overload=ArrayPrototypePop/0
    Return v4
# CHECK-NOT: StringLastIndexOfLiteral
# CHECK-NOT: ArrayPrototypePop
# CHECK: [[zero9]]: 0 = Integer
# CHECK-NEXT: Jump -> next [[header9]]([[zero9]], [[zero9]])
# CHECK: [[header9]]([[position9]]: int[0, 4294967294], [[startOfLast9]]: int[0, 2147483647]):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[length9]]: {{*}} = GetStringLength v0
# CHECK-NEXT: [[has9]]: boolean = LessEq [[position9]], [[length9]]
# CHECK-NEXT: Branch [[has9]] -> taken [[search9]](| 0), notTaken [[done9]](
# CHECK: [[search9]]([[start9]]: int[0, 2147483647]):
# CHECK-NEXT: = CallBuiltin v0, v1, [[start9]] overload=StringPrototypeIndexOf/0
# CHECK: [[done9]](
# CHECK: [[end9]]: {{*}} = GetStringLength v0
# CHECK-NEXT: [[last9]]: string = Substring v0, [[startOfLast9]], [[end9]]
# CHECK: Jump -> next [[header9]]({{*}}, [[start9]])
# SUNK-NOT: StringPrototypeSplit
# SUNK: = Substring v0,
}

