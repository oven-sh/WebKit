    Jump -> next b2()
  b2():
    LoopHint
    v7 = CallBuiltin v5 overload=ArrayPrototypePop/0
    v8 = Call v1, -, v7
    v9 = ToBoolean v8
    Branch v9 -> taken b2(), notTaken b3()
  b3():
    v10 = Call v1
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b4()
  b4():
