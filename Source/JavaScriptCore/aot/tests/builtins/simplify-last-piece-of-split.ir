function f14 name="poppedInLoop" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = String string="/"
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    Jump -> next b1()
  b1():
    LoopHint
    v6 = CallBuiltin v4 overload=ArrayPrototypePop/0
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b1(), notTaken b2()
  b2():
    Return
# CHECK-NOT: StringLastIndexOfLiteral
# CHECK: v6:{{*}}= CallBuiltin v4 overload=ArrayPrototypePop/0
}

