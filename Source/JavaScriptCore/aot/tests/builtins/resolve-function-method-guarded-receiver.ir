# call, apply and bind read from a function are constants where the function is proven to have no own member of that name, or behind the test that the closure is as it was created.
# Of a class of functions that has no such test, the method that was read is tested by identity
# FORM: Prepared
# RUN: pass ResolveBuiltins
# RUN(PLACED): pass ResolveBuiltins PlaceTypeTests
# CHECK: outcome: Changed
# PLACED: outcome: Changed
# PLACED: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="callOnPristineFunction" parameters=[{type=Function<pristine[Names]>}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="call"
    v3 = Call v2, v0, v1 calleeKey="call"
    Return v3
# CHECK: v2: builtin(FunctionPrototypeCall) = Builtin builtin=FunctionPrototypeCall
# CHECK-NEXT: v3: anything = CallBuiltin v0, v1 overload=FunctionPrototypeCall/0
# PLACED-NOT: TypeTest
}

function f1 name="callOnFunction" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="call"
    v3 = Call v2, v0, v1 calleeKey="call"
    Return v3
# CHECK: v2: anything = PropGet v0 key="call"
# CHECK-NEXT: v3: anything = Call v2, v0, v1 calleeKey="call"
# PLACED-NEXT: b0(v0: function, v1: anything):
# PLACED-NEXT: [[isAsCreated1]]: boolean = IsPristine v0 builtinClass=Function aspects=[Names]
# PLACED-NEXT: Branch [[isAsCreated1]] -> taken
# PLACED-NOT: PropGet
# PLACED: [[call1]]: builtin(FunctionPrototypeCall) = Builtin builtin=FunctionPrototypeCall
# PLACED-NEXT: true = TypeTest [[call1]] testedType=builtin(FunctionPrototypeCall)
# PLACED-NOT: PropGet
# PLACED: anything = CallBuiltin v0, v1 overload=FunctionPrototypeCall/0
# PLACED: frequency=Unlikely
# PLACED: [[read1]]: anything = PropGet v0 key="call"
# PLACED-NEXT: Jump -> next [[generic1]]([[read1]])
# PLACED-NEXT: [[generic1]]([[callee1]]: anything{{*}}) frequency=Unlikely:
# PLACED-NEXT: anything = Call [[callee1]], v0, v1 calleeKey="call"
}

function f2 name="applyOnKnownClosure" parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
    v2 = NewClosure function=f7
    v3 = PropGet v2 key="apply"
    v4 = Call v3, v2, v0, v1 calleeKey="apply"
    Return v4
# CHECK: v3: anything = PropGet v2 key="apply"
# CHECK-NEXT: v4: anything = Call v3, v2, v0, v1 calleeKey="apply"
# PLACED: [[isAsCreated2]]: boolean = IsPristine v2 builtinClass=Function aspects=[Names]
# PLACED-NEXT: Branch [[isAsCreated2]] -> taken
# PLACED-NOT: PropGet
# PLACED: [[apply2]]: builtin(FunctionPrototypeApply) = Builtin builtin=FunctionPrototypeApply
# PLACED-NEXT: true = TypeTest [[apply2]] testedType=builtin(FunctionPrototypeApply)
# PLACED-NOT: PropGet
# PLACED: anything = CallBuiltin v2, v0, v1 overload=FunctionPrototypeApply/0
# PLACED: frequency=Unlikely
# PLACED: [[read2]]: anything = PropGet v2 key="apply"
# PLACED-NEXT: Jump -> next [[generic2]]([[read2]])
# PLACED-NEXT: [[generic2]]([[callee2]]: anything{{*}}) frequency=Unlikely:
# PLACED-NEXT: anything = Call [[callee2]], v2, v0, v1 calleeKey="apply"
}

function f3 name="bindOnFunction" parameters=[{type=function}, {type=anything}, {type=number}] results=[{type=anything}] {
    v3 = PropGet v0 key="bind"
    v4 = Call v3, v0, v1, v2 calleeKey="bind"
    Return v4
# CHECK: v3: anything = PropGet v0 key="bind"
# CHECK-NEXT: v4: anything = Call v3, v0, v1, v2 calleeKey="bind"
# PLACED: [[isAsCreated3]]: boolean = IsPristine v0 builtinClass=Function aspects=[Names]
# PLACED-NEXT: Branch [[isAsCreated3]] -> taken
# PLACED-NOT: PropGet
# PLACED: [[bind3]]: builtin(FunctionPrototypeBind) = Builtin builtin=FunctionPrototypeBind
# PLACED-NEXT: true = TypeTest [[bind3]] testedType=builtin(FunctionPrototypeBind)
# PLACED-NOT: PropGet
# PLACED: function = CallBuiltin v0, v1, v2 overload=FunctionPrototypeBind/0
# PLACED: frequency=Unlikely
# PLACED: [[read3]]: anything = PropGet v0 key="bind"
# PLACED-NEXT: Jump -> next [[generic3]]([[read3]])
# PLACED-NEXT: [[generic3]]([[callee3]]: anything{{*}}) frequency=Unlikely:
# PLACED-NEXT: anything = Call [[callee3]], v0, v1, v2 calleeKey="bind"
}

function f4 name="constructorOfPristineFunction" parameters=[{type=Function<pristine[Names]>}] results=[{type=anything}] {
    v1 = PropGet v0 key="constructor"
    Return v1
# CHECK: v1: builtin(Function) = Builtin builtin=Function
}

function f5 name="readsWithoutCall" parameters=[{type=function}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    v2 = PropGet v0 key="name"
    v3 = PropGet v0 key="constructor"
    Return v3
# CHECK: v1: anything = PropGet v0 key="length"
# CHECK-NEXT: v2: anything = PropGet v0 key="name"
# CHECK-NEXT: v3: anything = PropGet v0 key="constructor"
# A function has length and name itself, and inherits constructor
# PLACED-NEXT: b0(v0: function):
# PLACED-NEXT: v1: anything = PropGet v0 key="length"
# PLACED: v2: anything = PropGet v0 key="name"
# PLACED: v3: builtin(Function) = Builtin builtin=Function
# PLACED-NEXT: Return v3
# PLACED: [[isAsCreated5]]: boolean = IsPristine v0 builtinClass=Function aspects=[Names]
# PLACED-NEXT: Branch [[isAsCreated5]] -> taken
# PLACED: frequency=Unlikely:
# PLACED-NEXT: [[read5]]: anything = PropGet v0 key="constructor"
# PLACED-NEXT: Return [[read5]]
}

function f6 name="callOnAsyncFunction" parameters=[{type=AsyncFunction}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="call"
    v3 = Call v2, v0, v1 calleeKey="call"
    Return v3
# CHECK: v2: anything = PropGet v0 key="call"
# CHECK-NEXT: v3: anything = Call v2, v0, v1 calleeKey="call"
# PLACED-NOT: IsPristine
# PLACED: v2: anything = PropGet v0 key="call"
# PLACED-NOT: IsPristine
# PLACED: anything = CallBuiltin v0, v1 overload=FunctionPrototypeCall/0
# PLACED-NOT: IsPristine
# PLACED: [[isCallOfAsync]]: boolean = TypeTest v2 testedType=builtin(FunctionPrototypeCall)
# PLACED-NEXT: Branch [[isCallOfAsync]] -> taken
# PLACED-NEXT: frequency=Unlikely
# PLACED-NEXT: anything = Call v2, v0, v1 calleeKey="call"
# PLACED-NOT: IsPristine
}

function f7 name="target" kind=Arrow results=[{type=anything}] {
    Return
}
