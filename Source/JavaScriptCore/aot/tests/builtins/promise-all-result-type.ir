# The promise of Promise.all is expected to hold an array of what the elements are fulfilled with, not of the elements: a promise counts as what it holds, a number as itself, and of an object that may be a thenable nothing is expected
# FORM: Prepared
# RUN: print

module m0 path="main.js" displayPath="main.js"
function f0 name="promises" parameters=[{type=Array<Promise<number>>}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = CallBuiltin v1, v0 overload=PromiseAll/0
    Return v2
# CHECK: v2: Promise ~ Promise<Array<number>> = CallBuiltin
}
function f1 name="promisesAndStrings" parameters=[{type=Array<string|Promise<number>>}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = CallBuiltin v1, v0 overload=PromiseAll/0
    Return v2
# CHECK: v2: Promise ~ Promise<Array<number|string>> = CallBuiltin
}
function f2 name="objects" parameters=[{type=Array<object>}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = CallBuiltin v1, v0 overload=PromiseAll/0
    Return v2
# CHECK: v2: Promise ~ Promise<Array> = CallBuiltin
}
