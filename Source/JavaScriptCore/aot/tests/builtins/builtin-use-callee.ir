# A call of a callee predicted as one built-in reports the identity test of the callee, then the tests its operands need to match an overload
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
runtimefunction id=32 function=f0
runtimefunction id=90 function=f1
function f0 name="every" role=Library flags=[HasThis] enclosingRuntimeFunction=32 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Boolean boolean=true
    Return v3
}
function f1 name="some" role=Library flags=[HasThis] enclosingRuntimeFunction=90 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    Return v2
}

function f2 name="globalFunction" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="encodeURIComponent" [isFreeName]
    v3 = Predict v2 predicted=builtin(EncodeURIComponent)
    v4 = Call v3, -, v0
    Return v4
}
# PLAN: function f2
# PLAN-NEXT: stretch 0: test TypeTest {{*}} testedType=builtin(EncodeURIComponent) before v4; uses v4;
# CHECK-LABEL: function f2 name="globalFunction"
# CHECK: [[isEncode2]]: boolean{{*}} = TypeTest v3 testedType=builtin(EncodeURIComponent)
# CHECK-NEXT: Branch [[isEncode2]] -> taken
# CHECK: v4: string = CallBuiltin -, v0 overload=EncodeURIComponent/0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call v3, -, v0

function f3 name="memberOfPredictedObject" parameters=[{type=anything predicted=builtin(Console)}, {type=string}] results=[{type=anything}] {
  b0(v0: anything ~ builtin(Console), v1: string):
    v2 = PropGet v0 key="log"
    v3 = Predict v2 predicted=builtin(ConsoleLog)
    v4 = Call v3, v0, v1 calleeKey="log"
    Return v4
}
# PLAN: function f3
# PLAN-NEXT: stretch 0: test TypeTest {{*}} testedType=builtin(ConsoleLog) before v4; uses v4;
# CHECK-LABEL: function f3 name="memberOfPredictedObject"
# CHECK-NOT: testedType=builtin(Console)
# CHECK: v2: anything = PropGet v0 key="log"
# CHECK: = TypeTest v3 testedType=builtin(ConsoleLog)
# CHECK-NOT: testedType=builtin(Console)
# CHECK: v4: undefined = CallBuiltin {{*}}v1 overload=ConsoleLog/
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call v3, v0, v1 calleeKey="log"

function f4 name="construction" parameters=[{type=anything predicted=builtin(Map)}] results=[{type=anything}] {
  b0(v0: anything ~ builtin(Map)):
    v1 = Construct v0
    Return v1
