# A construction of a built-in whose code is a constructor of the library becomes a direct call of it that passes new.target: the built-in for `new`, the class that is constructed for `super(..)`
# FORM: Prepared
# RUN: pass ResolveBuiltins ResolveBuiltins
# CHECK: outcome: Changed
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
runtimefunction id=0 function=f0
layout L0 kind=Instance name="Deferred" constructor=f3 flags=[HasHeritage]
layout L1 kind=Instance name="Mixed" constructor=f4 flags=[HasHeritage]
layout L2 kind=Instance name="Index" constructor=f5 flags=[HasHeritage]
function f0 name="Promise" kind=BaseConstructor role=Library flags=[HasNewTarget, HasExplicitName, IsNakedConstructor] length=1 enclosingRuntimeFunction=0 parameters=[{type=anything}] results=[{type=Promise}] {
    v2 = CreatePromise v0
    Return v2
}

function f1 name="constructed" parameters=[{type=function}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = Construct v1, -, v0 accessSite=3
    Return v2
# CHECK-NOT: CallBuiltin
# CHECK: v1: builtin(Promise) = Builtin builtin=Promise
# CHECK-NEXT: [[itself1]]: builtin(Promise) = Builtin builtin=Promise
# CHECK-NEXT: v2: Promise = CallDirect [[itself1]], v0 function=f0 accessSite=3 [isConstruction]
}

function f2 name="resolvedConstruction" parameters=[{type=function}] results=[{type=anything}] {
    v1 = CallBuiltin -, v0 overload=Promise/1
    Return v1
# CHECK-NOT: CallBuiltin
# CHECK: [[itself2]]: builtin(Promise) = Builtin builtin=Promise
# CHECK-NEXT: v1: Promise = CallDirect [[itself2]], v0 function=f0 [isConstruction]
}

function f3 name="Deferred" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=function}] results=[{type=object}] {
    v3 = Builtin builtin=Promise
    v4 = SuperConstruct v3, v1, v2 layout=L0 accessSite=4
    Return v4
# CHECK-NOT: SuperConstruct
# CHECK: v4: Promise = CallDirect v1, v2 function=f0 accessSite=4 [isConstruction]
}

function f4 name="parentNobodyKnows" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=function}] results=[{type=object}] {
    v3 = GetSuperBase v0
    v4 = SuperConstruct v3, v1, v2 layout=L1
    Return v4
# CHECK-NOT: CallDirect
# CHECK: = SuperConstruct v3, v1, v2 layout=L1
}

function f5 name="parentWithoutLibraryConstructor" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=object}] {
    v2 = Builtin builtin=Map
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
# A CallBuiltin constructs for the built-in itself, so it cannot stand for this
# CHECK-NOT: CallDirect
# CHECK-NOT: CallBuiltin
# CHECK: = SuperConstruct v2, v1 layout=L2
}

function f6 name="constructedForAnotherFunction" parameters=[{type=function}, {type=function}] results=[{type=anything}] {
    v2 = Builtin builtin=Promise
    v3 = Construct v2, v1, v0
    Return v3
# CHECK-NOT: CallDirect
# CHECK: = Construct v2, v1, v0
}

function f7 name="calledWithoutNew" parameters=[{type=function}] results=[{type=anything}] {
    v1 = Builtin builtin=Promise
    v2 = Call v1, -, v0
    Return v2
# CHECK-NOT: CallDirect
}
