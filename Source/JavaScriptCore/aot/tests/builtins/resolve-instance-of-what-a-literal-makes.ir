# What an object literal makes has Object.prototype above it and nothing else, so instanceof with a built-in constructor is answered, unless some such object may get another prototype
# OPTIONS: only-passes=ResolveBuiltins
# RUN: pipeline ResolveBuiltins

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Kept" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="Moved" fields=[{key="y" declared={type=number} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Builtin builtin=PromisePrototype
    v4 = Builtin builtin=ObjectSetPrototypeOf
    v5 = Call v4, -, v2, v3
    v6 = NewClosure function=f1
    v7 = Call v6, -, v1
    v8 = NewClosure function=f2
    v9 = Call v8, -, v2
    Return
}
function f1 name="kept" module=m0 parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = Builtin builtin=Promise
    v2 = InstanceOf v0, v1
    v3 = Builtin builtin=Object
    v4 = InstanceOf v0, v3
    v5 = NewArray v2, v4 contents=anything
    Return v5
}
# CHECK-LABEL: function f1 name="kept"
# CHECK-NOT: InstanceOf
# CHECK-NOT: HasInPrototypeChain
# CHECK: v2: false = Boolean
# CHECK: v4: true = Boolean boolean=true

function f2 name="moved" module=m0 parameters=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = Builtin builtin=Promise
    v2 = InstanceOf v0, v1
    Return v2
}
# CHECK-LABEL: function f2 name="moved"
# CHECK: = HasInPrototypeChain v0, {{*}}
