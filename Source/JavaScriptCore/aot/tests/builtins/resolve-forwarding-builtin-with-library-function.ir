# A built-in that only forwards a call becomes the forwarded call, not a call of its library function
# FORM: Prepared
# RUN: pass ResolveBuiltins
# RUN(BOTH): pass ResolveBuiltins ResolveCalls

module m0 path="main.js" displayPath="main.js"
runtimefunction id=FunctionPrototypeCall function=f0
runtimefunction id=ArrayPrototypeEvery function=f1
function f0 name="call" role=Library flags=[HasThis, HasArgumentCount, HasHiddenRest] enclosingRuntimeFunction=FunctionPrototypeCall thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: int[0, 4294967295], v2: anything, v3: Array):
    Return v2
}
function f1 name="every" role=Library flags=[HasThis] enclosingRuntimeFunction=ArrayPrototypeEvery thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v3 = Boolean boolean=true
    Return v3
}

function f2 name="forwards" parameters=[{type=function}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=FunctionPrototypeCall
    v4 = Call v3, v0, v1, v2 calleeKey="call" accessSite=3
    Return v4
# CHECK-NOT: CallDirect
# CHECK: v4: anything = CallBuiltin v0, v1, v2 overload=FunctionPrototypeCall/0 accessSite=3
# BOTH-NOT: CallDirect
# BOTH-NOT: CallBuiltin
# BOTH: v4: anything = Call v0, v1, v2 accessSite=3
}

function f3 name="doesMoreThanForward" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=function}, {type=anything}] results=[{type=anything}] {
    v3 = Builtin builtin=ArrayPrototypeEvery
    v4 = Call v3, v0, v1, v2 calleeKey="every" accessSite=4
    Return v4
# CHECK-NOT: CallBuiltin
# CHECK: v4: boolean = CallDirect v0, v1, v2 function=f1 accessSite=4
# BOTH: v4: boolean = CallDirect v0, v1, v2 function=f1 accessSite=4
}
