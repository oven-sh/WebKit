# FORM: Prepared optimizing
# RUN: pass SimplifyBuiltinCalls SimplifyBuiltinCalls
# CHECK: outcome: Unchanged
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="statusIsReturned" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = StepGenerator v0, v1 check=IsGenerator
    v3 = ResultAt v2 index=1
    Return v3
# CHECK: Return v3
}

function f1 name="statusIsPassedOn" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = StepGenerator v0, v1 check=IsGenerator
    v3 = ResultAt v2 index=1
    Jump -> next b1(v3)
  b1(v4: anything):
    Return v4
# CHECK: Return v4
}
