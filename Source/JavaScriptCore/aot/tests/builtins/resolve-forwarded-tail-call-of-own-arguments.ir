# CHECK-NOT: Switch
# CHECK: [[list4]]: {{*}} = NewArgumentList v0, v5
# CHECK-NEXT: v7: anything = CallList v0, v5, [[list4]]
# CHECK-NEXT: ReturnCall v7
}

# In a mapped object an element is the variable of its parameter, which may hold another value by now.
function f5 name="mappedArguments" flags=[IsSloppy, TakesCallee, HasArgumentCount, HasHiddenRest] parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: int[0, 4294967295], v2: function, v3: anything, v4: Array):
    v5 = CreateMappedArguments v0, v1, v4, v2, v3
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v2, v3, v5 calleeKey="apply" calleeName="f.apply"
    ReturnCall v7
# CHECK-NOT: Switch
# CHECK: [[list5]]: {{*}} = NewArgumentList v2, v5
# CHECK-NEXT: v7: anything = CallList v2, v3, [[list5]]
# CHECK-NEXT: ReturnCall v7
}

# What takes the object on a path that never comes to the call cannot have changed it before the call.
function f6 name="objectIsPassedOnAnotherPath" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: boolean, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    Branch v3 -> taken b1(), notTaken b2(v5)
  b1():
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5 calleeKey="apply" calleeName="f.apply"
    ReturnCall v7
  b2(v8: Arguments):
    v9 = Call v0, v1, v8
    Return v9
# CHECK: Switch v2 cases=[0, 1] -> case [[none6]](), case [[one6]](), otherwise [[more6]]()
# CHECK: [[one6]]():
# CHECK-NEXT: [[callOne6]]: anything = Call v0, v1, v3
# CHECK-NEXT: ReturnCall [[callOne6]]
}

# A loop brings the object that was passed back to the call.
function f7 name="objectIsPassedInALoop" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: anything, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    Jump -> next b1()
  b1():
    LoopHint
    v7 = Call v0, v1
    v8 = ToBoolean v7
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Call v0, v1, v5
    Jump -> next b1()
  b3():
    v10 = Builtin builtin=FunctionPrototypeApply
    v11 = Call v10, v0, v1, v5 calleeKey="apply" calleeName="f.apply"
    ReturnCall v11
# CHECK-NOT: Switch
# CHECK: [[list7]]: {{*}} = NewArgumentList v0, v5
# CHECK-NEXT: v11: anything = CallList v0, v1, [[list7]]
# CHECK-NEXT: ReturnCall v11
}

# A call that is no tail call: the arms meet behind it, and the last two are calls of the built-in: with the list of the parameters and the hidden rest list, or with the object.
function f8 name="resultIsUsed" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: anything, v4: Array):
    v5 = CreateUnmappedArguments v2, v4, v3
    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5
    v8 = Call v0, v1, v7
    Return v8
# CHECK: Switch v2 cases=[0, 1] -> case [[none8]](), case [[one8]](), otherwise [[more8]]()
# CHECK: [[one8]]():
# CHECK-NEXT: [[callOne8]]: anything = Call v0, v1, v3
# CHECK-NEXT: Jump -> next [[behind8]]([[callOne8]])
# CHECK: [[more8]]() frequency=Unlikely:
# CHECK-NEXT: = IsPristine v4 builtinClass=Array aspects=[Storage, Names]
# CHECK: [[parameters8]]: Array = NewArray v3 contents=anything
# CHECK-NEXT: AppendElements [[parameters8]], v4,
# CHECK-NEXT: [[callListed8]]: anything = CallBuiltin v0, v1, [[parameters8]] overload=FunctionPrototypeApply/0
# CHECK: frequency=Rare:
# CHECK-NEXT: [[callMore8]]: anything = CallBuiltin v0, v1, v5 overload=FunctionPrototypeApply/0
}

# What takes the object behind the call finds it as it was made.
function f9 name="objectIsPassedBehindTheCall" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: anything, v4: Array):
