    v6 = Builtin builtin=FunctionPrototypeApply
    v7 = Call v6, v0, v1, v5
    v8 = Call v0, v1, v5
    Return v8
# CHECK: Switch v2 cases=[0, 1]
# CHECK: Call v0, v1, v5
}

# Code that seldom runs stays small.
function f10 name="seldomRuns" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: boolean, v4: Array):
