# A callback that stores to a module variable and has no caller but the built-in it is passed to: the CallBuiltin that replaces the Call has no effect the Call lacks
# RUN: compile
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="seen" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f2
    v3 = GetModuleVariable variable=g0
    Return
}
function f1 name="replacer" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = String string="replacer ran"
    PutModuleVariable v3 variable=g0
    Return v2
}
function f2 name="serialize" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f1
    v2 = Builtin builtin=JSONStringify
    v3 = Call v2, -, v0, v1
    Return
}
