# A call that spreads one pristine array passes that array and builds no list, and a built-in function with a list form reads its arguments from the array it is passed
# FORM: Prepared optimizing
# RUN: pass ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="arrayProvenByType" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v4
# CHECK-NOT: IsPristine
# CHECK-NOT: NewArray
# CHECK-NOT: AppendSpread
# CHECK: v4: number = CallBuiltin -, v0 overload=MathMax/0 builtinCallForm=List
# CHECK-NOT: needsPristineReceiver
}

function f1 name="freshLiteral" parameters=[{type=number}, {type=number}] results=[{type=anything}] {
    v2 = Builtin builtin=MathMax
    v3 = NewArray v0, v1 contents=number
    v4 = NewArray contents=anything
    AppendSpread v4, v3
    v6 = CallList v2, -, v4
    Return v6
# CHECK-NOT: IsPristine
# CHECK-NOT: AppendSpread
# CHECK: v6: number = CallBuiltin -, v3 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
}

function f2 name="arrayWithoutProof" parameters=[{type=Array<number>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v4
# CHECK-NOT: TypeTest
# CHECK: [[isPristine2]]: boolean = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch [[isPristine2]] -> taken [[fast2]](| 0), notTaken [[generic2]]()
# CHECK-NOT: IsPristine
# CHECK: number = CallBuiltin -, v0 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# CHECK: [[generic2]]() frequency=Unlikely:
# CHECK-NEXT: [[list2]]: Array = NewArray contents=anything
# CHECK-NEXT: AppendSpread [[list2]], v0
# CHECK-NEXT: anything = CallList v1, -, [[list2]]
}

function f3 name="expectedArray" parameters=[{type=Array<number> flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number>):
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v4
# CHECK: [[isArray3]]: boolean{{*}} = TypeTest v0 testedType=Array<number>
# CHECK-NEXT: Branch [[isArray3]] -> taken [[tested3]](| 0), notTaken
# CHECK: [[tested3]]([[array3]]: Array<number>):
# CHECK-NEXT: [[isPristine3]]: boolean = IsPristine [[array3]] builtinClass=Array aspects=[Storage, Names]
# CHECK: frequency=Unlikely:
# CHECK: AppendSpread {{*}}, v0
# CHECK: number = CallBuiltin -, [[array3]] overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# CHECK: frequency=Unlikely:
# CHECK: AppendSpread {{*}}, v0
}

function f4 name="nullableArray" parameters=[{type=undefined|Array<number, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v4
# CHECK-NOT: IsPristine
# CHECK: [[isArray4]]: boolean = TypeTest v0 testedType=Array<number>
# CHECK-NEXT: Branch [[isArray4]] -> taken [[tested4]](| 0), notTaken
# CHECK-NOT: IsPristine
# CHECK: [[tested4]]([[array4]]: Array<number, proven, pristine[Storage, Names]>):
# CHECK-NEXT: number = CallBuiltin -, [[array4]] overload=MathMax/0 builtinCallForm=List
# CHECK: frequency=Unlikely:
# CHECK: AppendSpread {{*}}, v0
}

function f5 name="unknownIterable" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v4
# CHECK: AppendSpread v2, v0
# CHECK-NEXT: [[isPristine5]]: boolean = IsPristine v2 builtinClass=Array aspects=[Storage, Names]
# CHECK: number = CallBuiltin -, v2 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# CHECK: frequency=Unlikely:
