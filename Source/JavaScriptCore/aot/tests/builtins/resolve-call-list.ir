function f12 name="positionalArrayArgument" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = Call v1, -, v0
    Return v2
# CHECK-NOT: builtinCallForm=List
# CHECK: Return v2
}

function f13 name="hiddenRest" flags=[HasArgumentCount, HasHiddenRest] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: Array):
    v2 = Builtin builtin=MathMax
    v3 = Builtin builtin=Math
    v4 = CallList v2, v3, v1
    Return v4
# CHECK: [[isPristine13]]: boolean = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
# CHECK: number = CallBuiltin -, v1 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = CallList v2, v3, v1
}

function f14 name="listWithoutSpreadAndCalleeWithoutListForm" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=StringFromCharCode
    v2 = CallList v1, -, v0
    Return v2
# CHECK-NOT: CallBuiltin
# CHECK: v2: anything = CallList v1, -, v0
}

function f15 name="listInRareBlock" parameters=[{type=Array<number>}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = Builtin builtin=MathMax
    v3 = CallList v2, -, v0
    Return v3
  b2():
    Return v1
# CHECK-NOT: IsPristine
# CHECK: v3: anything = CallList v2, -, v0
}

function f16 name="anyCallee" parameters=[{type=anything}, {type=anything}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v3 = NewArray contents=anything
    AppendSpread v3, v2
    v5 = CallList v0, v1, v3
    Return v5
# CHECK-NOT: NewArray
# CHECK-NOT: AppendSpread
# CHECK: v5: anything = CallList v0, v1, v2
}

function f17 name="anyCalleeAndArrayWithoutProof" parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    AppendSpread v2, v1
    v4 = CallList v0, -, v2
    Return v4
# CHECK: [[isPristine17]]: boolean = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch [[isPristine17]] -> taken [[fast17]](| 0), notTaken [[generic17]]()
# CHECK: [[fast17]]({{*}}):
