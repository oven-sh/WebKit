}

function f8 name="listUsedTwice" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    v4 = CallList v1, -, v2
    Return v2
# CHECK: AppendSpread v2, v0
# CHECK: Return v2
# CHECK: number = CallBuiltin -, v2 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
}

function f9 name="callBetweenSpreadAndCall" parameters=[{type=Array<number, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=MathMax
    v3 = NewArray contents=anything
    AppendSpread v3, v0
    v5 = Call v1
    v6 = CallList v2, -, v3
    Return v6
# CHECK: AppendSpread v3, v0
# CHECK-NEXT: v5: anything = Call v1
# CHECK: number = CallBuiltin -, v3 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
}

