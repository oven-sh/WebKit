function f21 name="anyCalleeAndCallBetweenSpreadAndCall" parameters=[{type=anything}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    AppendSpread v2, v1
    v4 = Call v0
    v5 = CallList v0, -, v2
    Return v5
# CHECK: AppendSpread v2, v1
# CHECK-NEXT: v4: anything = Call v0
# CHECK-NEXT: v5: anything = CallList v0, -, v2
}

function f22 name="spreadIntoCastOfList" parameters=[{type=anything}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    v3 = AssumeType v2 provenType=Array<anything, pristine[Storage, Names]>
    AppendSpread v3, v1
    v5 = CallList v0, -, v3
    Return v5
# CHECK-NOT: NewArray
# CHECK-NOT: AppendSpread
# CHECK: v5: anything = CallList v0, -, v1
}

function f23 name="castOfListUsedTwice" parameters=[{type=anything}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    v3 = AssumeType v2 provenType=Array<anything, pristine[Storage, Names]>
    AppendSpread v3, v1
    v5 = CallList v0, v3, v3
    Return v5
# CHECK: AppendSpread v3, v1
# CHECK-NEXT: v5: anything = CallList v0, v3, v3
}
