}

function f6 name="twoSpreads" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Builtin builtin=MathMax
    v2 = NewArray contents=anything
    AppendSpread v2, v0
    AppendSpread v2, v0
    v5 = CallList v1, -, v2
    Return v5
# CHECK: AppendSpread v2, v0
# CHECK-NEXT: AppendSpread v2, v0
# CHECK: number = CallBuiltin -, v2 overload=MathMax/0 builtinCallForm=List [needsPristineReceiver]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = CallList v1, -, v2
}

function f7 name="elementBesideSpread" parameters=[{type=Array<number, pristine[Storage, Names]>}, {type=number}] results=[{type=anything}] {
    v2 = Builtin builtin=MathMax
    v3 = NewArray v1 contents=anything
    AppendSpread v3, v0
