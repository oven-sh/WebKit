# CHECK-NEXT: anything = CallList v0, -, [[list17]]
}

function f18 name="construction" parameters=[{type=anything}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    AppendSpread v2, v1
    v4 = ConstructList v0, -, v2
    Return v4
# CHECK-NOT: AppendSpread
# CHECK: v4: anything ~ object = ConstructList v0, -, v1
}

