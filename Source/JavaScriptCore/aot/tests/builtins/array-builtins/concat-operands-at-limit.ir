# A concat with as many operands as the limit allows is expanded inline
# RUN: compile
# RUN(SELECTED): pipeline Select
# OPTIONS: limit=MaxInlineConcatOperands:1 heat=EverythingIsHot
# CHECK-NOT: loss MaxInlineConcatOperands
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v0, v1
    Return v4
}
function f1 name="concatenatesArray" parameters=[{type=Array<number>}, {type=Array<number>}] results=[{type=anything}] {
    v2 = PropGet v0 key="concat"
    v3 = Call v2, v0, v1 calleeKey="concat"
    Return v3
}
# Only its entrypoint enters each function, so the body is there
# SELECTED-LABEL: name="concatenatesArray" module=m0 role=GenericEntrypoint
# SELECTED: [[array]]: Array<number> = AssumeType v2 provenType=Array<number>
# SELECTED: [[other]]: Array<number> = AssumeType v3 provenType=Array<number>
# SELECTED: TryCallInline [[array]], [[other]] inlineBuiltin=ArrayConcat overload=ArrayPrototypeConcat/
function f2 name="appendsNumber" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
    v2 = PropGet v0 key="concat"
    v3 = Call v2, v0, v1 calleeKey="concat"
    Return v3
}
# SELECTED-LABEL: name="appendsNumber" module=m0 role=GenericEntrypoint
# SELECTED: [[receiver]]: Array<number> = AssumeType v2 provenType=Array<number>
# SELECTED: [[number]]: number = AssumeType v3 provenType=number
# SELECTED: TryCallInline [[receiver]], [[number]] inlineBuiltin=ArrayConcat overload=ArrayPrototypeConcat/
