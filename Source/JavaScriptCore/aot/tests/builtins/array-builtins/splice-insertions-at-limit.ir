# A splice that inserts as many elements as the limit allows is expanded inline
# RUN: compile
# RUN(SELECTED): pipeline Select
# OPTIONS: limit=MaxInlineSpliceInsertions:1 heat=EverythingIsHot
# CHECK-NOT: loss MaxInlineSpliceInsertions
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v0, v1
    Return v4
}
function f1 name="insertsOne" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = PropGet v0 key="splice"
    v4 = Call v3, v0, v2, v2, v1 calleeKey="splice"
    Return v4
}
# Only its entrypoint enters each function, so the body is there
# SELECTED-LABEL: name="insertsOne" module=m0 role=GenericEntrypoint
# SELECTED: [[array]]: Array<number> = AssumeType v2 castType=Array<number>
# SELECTED: [[number]]: number = AssumeType v3 castType=number
# SELECTED: TryCallInline [[array]], {{*}}, [[number]] inlineBuiltin=ArraySplice overload=ArrayPrototypeSplice/
function f2 name="insertsOneWithUnknownDeleteCount" parameters=[{type=Array<number>}, {type=number}, {type=i32}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = PropGet v0 key="splice"
    v5 = Call v4, v0, v3, v2, v1 calleeKey="splice"
    Return v5
}
# SELECTED-LABEL: name="insertsOneWithUnknownDeleteCount" module=m0 role=GenericEntrypoint
# SELECTED: [[receiver]]: Array<number> = AssumeType v2 castType=Array<number>
# SELECTED: [[inserted]]: number = AssumeType v3 castType=number
# SELECTED: [[deleteCount]]: i32 = AssumeType v4 castType=i32
# SELECTED: TryCallInline [[receiver]], {{*}}, [[deleteCount]], [[inserted]] inlineBuiltin=ArraySplice overload=ArrayPrototypeSplice/
