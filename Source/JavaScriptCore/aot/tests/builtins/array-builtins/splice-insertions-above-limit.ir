# A splice that inserts more elements than the limit stays a call
# RUN: compile
# RUN(SELECTED): pipeline Select
# OPTIONS: limit=MaxInlineSpliceInsertions:1 heat=EverythingIsHot
# LOSS: MaxInlineSpliceInsertions f1
# CHECK: loss MaxInlineSpliceInsertions
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
function f1 name="insertsTwo" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = PropGet v0 key="splice"
    v4 = Call v3, v0, v2, v2, v1, v1 calleeKey="splice"
    Return v4
}
# Only its entrypoint enters the function, so the body is there
# SELECTED-LABEL: name="insertsTwo" module=m0 role=GenericEntrypoint
# SELECTED: [[array]]: Array<number> = AssumeType v2 castType=Array<number>
# SELECTED: [[number]]: number = AssumeType v3 castType=number
# SELECTED-NOT: inlineBuiltin=ArraySplice
# SELECTED: = CallBuiltin [[array]], {{*}}, [[number]], [[number]] overload=ArrayPrototypeSplice/
# SELECTED-NOT: inlineBuiltin=ArraySplice
