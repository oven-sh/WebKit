entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0
    Return v3
}
function f1 name="insertsTwo" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
