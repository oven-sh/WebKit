# SELECTED: = CallInline v0, v1 inlineBuiltin=ArrayPush overload=ArrayPrototypePush/0
function f2 name="pushesTwo" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number>, v1: number):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1, v1 calleeKey="push"
    Return v3
}
