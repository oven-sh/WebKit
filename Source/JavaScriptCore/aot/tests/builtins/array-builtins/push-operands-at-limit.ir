# RUN: compile
# RUN(SELECTED): pipeline Select
# OPTIONS: limit=MaxInlinePushOperands:2
# CHECK-NOT: loss MaxInlinePushOperands
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v0, v1
    Return v4
}
function f1 name="pushesOne" parameters=[{type=Array<number>}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number>, v1: number):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push"
    Return v3
}
