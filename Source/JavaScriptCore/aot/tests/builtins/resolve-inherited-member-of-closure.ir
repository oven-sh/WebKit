# What the closure of a plain function inherits from Function.prototype is a constant while flow sees no closure of that function get the key as a property of its own or another prototype.
# Flow answers for the closures of a function that it has entered, so each one is called
# FORM: AsRead
# OPTIONS: only-passes=ResolveBuiltins
# RUN: pipeline ResolveBuiltins

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = NewClosure function=f1
    v2 = Call v1
    v3 = PropGet v1 key="apply"
    v4 = NewClosure function=f2
    v5 = Call v4
    v6 = NewClosure function=f4
    v7 = Call v6
    PropSet v4, v6 key="apply"
    v9 = PropGet v4 key="apply"
    v10 = NewClosure function=f3
    v11 = Call v10
    v12 = Builtin builtin=ObjectSetPrototypeOf
    v13 = Null
    v14 = Call v12, -, v10, v13
    v15 = PropGet v10 key="apply"
    v16 = NewClosure function=f5
    v17 = Call v16
    v18 = PropGet v16 key="constructor"
    v19 = NewArray v3, v9, v15, v18 contents=anything
    Return v19
}
function f1 name="asCreated" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="hasOwnProperty" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="hasAnotherPrototype" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="other" results=[{type=anything}] {
  b0():
    Return
}
function f5 name="coroutine" flags=[IsAsync] results=[{type=anything}] {
  b0():
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[plain]]: f1 = NewClosure function=f1
# CHECK-NEXT: = Call [[plain]]
# CHECK-NEXT: builtin(FunctionPrototypeApply) = Builtin builtin=FunctionPrototypeApply
# CHECK: [[withOwnProperty]]: f2 = NewClosure function=f2
# CHECK: anything = PropGet [[withOwnProperty]] key="apply"
# CHECK: [[withOtherPrototype]]: f3 = NewClosure function=f3
# CHECK: anything = PropGet [[withOtherPrototype]] key="apply"
# CHECK: [[coroutine]]: f5 = NewClosure function=f5
# CHECK-NEXT: = Call [[coroutine]]
# CHECK-NEXT: anything = PropGet [[coroutine]] key="constructor"
