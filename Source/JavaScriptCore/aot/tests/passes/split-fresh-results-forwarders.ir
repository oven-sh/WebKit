# A function that returns what a result wrapper returns is split like the function behind the wrapper
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitFreshResults VerifyProgram
# STATISTIC: FreshResultsSplit = 8
# STATISTIC: ReturnCallsDemoted = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}] flow={members=[L0]}
variable g0 name="last" module=m0 declared={type=anything} initialization=Undefined

function f0 name="point" parameters=[{type=number}] results=[{type=L0}] {
    v1 = Add v0, v0
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
}
# CHECK-LABEL: function f0 name="point" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[pointWorker]] layout=L0} {

function f1 name="chain1" parameters=[{type=number}] results=[{type=L0}] {
    v1 = CallDirect v0 function=f0
    Return v1
}
# CHECK-LABEL: function f1 name="chain1" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[chain1Worker]] layout=L0} {
# CHECK: [[call1]]:{{*}}= CallDirect v0 function=[[chain1Worker]]
# CHECK: = NewObject -, {{*}} layout=L0 fields=[0, 1]

function f2 name="chain2" parameters=[{type=number}] results=[{type=L0}] {
    v1 = CallDirect v0 function=f1
    Return v1
}
# CHECK-LABEL: function f2 name="chain2" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[chain2Worker]] layout=L0} {

function f3 name="chain3" parameters=[{type=number}] results=[{type=L0}] {
    v1 = CallDirect v0 function=f2
    Return v1
}
# CHECK-LABEL: function f3 name="chain3" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[chain3Worker]] layout=L0} {

function f4 name="readsThenForwards" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    v2 = GetSlot v1 key="x" receivers=[L0] level=Proven
    v3 = CallDirect v2 function=f10
    Return v1
}
# CHECK-LABEL: function f4 name="readsThenForwards" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[readingWorker]] layout=L0} {

function f5 name="forwardsOrReturnsAnotherCall" parameters=[{type=number}] results=[{type=anything}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f0
    Return v2
  b2():
    v3 = CallDirect v0 function=f10
    Return v3
}
# CHECK-LABEL: function f5 name="forwardsOrReturnsAnotherCall" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[eitherWorker]] layout=L0} {
# CHECK: [[call5]]:{{*}}= CallDirect v0 function=[[eitherWorker]]
# CHECK-NEXT: [[tag5]]: i32 = ResultAt [[call5]]
# CHECK-NEXT: [[other5]]: anything|unspecified = ResultAt [[call5]] index=1
# CHECK: Switch [[tag5]] cases=[1] -> case [[literal5]](), otherwise [[cell5]]()
# CHECK: [[literal5]]():
# CHECK-NEXT: [[filled1]]: fact = Specified
# CHECK-NEXT: {{*}}: number = AssumeType {{*}}, [[filled1]] provenType=number
# CHECK-NEXT: {{*}}: number = AssumeType {{*}}, [[filled1]] provenType=number
# CHECK-NEXT: = NewObject
# CHECK: [[cell5]]():
# CHECK-NEXT: [[filled2]]: fact = Specified
# CHECK-NEXT: [[other5There]]: anything = AssumeType [[other5]], [[filled2]] provenType=anything
# CHECK-NEXT: Jump -> next {{*}}([[other5There]])

function f6 name="forwardsByAllowedTailCall" parameters=[{type=number}] results=[{type=L0}] {
    v1 = CallDirect v0 function=f0
    ReturnCall v1 requirement=Allowed
}
# CHECK-LABEL: function f6 name="forwardsByAllowedTailCall" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[tailWorker]] layout=L0} {
# CHECK-NOT: ReturnCall

function f7 name="forwardsByRequiredTailCall" parameters=[{type=number}] results=[{type=L0}] {
    v1 = CallDirect v0 function=f0
    ReturnCall v1
}
# CHECK-LABEL: function f7 name="forwardsByRequiredTailCall" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[requiredTailWorker]] layout=L0} {
# CHECK-NOT: ReturnCall

function f8 name="forwardsOrCallsItself" parameters=[{type=number}] results=[{type=L0}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f0
    Return v2
  b2():
    v3 = CallDirect v0 function=f8
    Return v3
}
# CHECK-LABEL: function f8 name="forwardsOrCallsItself"
# CHECK-NOT: role=
# CHECK: v2:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: Return v2

function f9 name="passesOnThenForwards" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    v2 = CallDirect v1 function=f10
    Return v1
}
# CHECK-LABEL: function f9 name="passesOnThenForwards"
# CHECK-NOT: role=
# CHECK: v1:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: = CallDirect v1 function=f10
# CHECK-NEXT: Return v1

function f10 name="remember" parameters=[{type=anything}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    Return v0
}
# CHECK-LABEL: function f10 name="remember"
# CHECK-NOT: role=
# CHECK: Return v0

# CHECK: function [[pointWorker]] name="point" module=m0 role=ResultWorker {{*}}results=[{type=number}, {type=number}]
# CHECK: function [[chain1Worker]] name="chain1" module=m0 role=ResultWorker {{*}}results=[{type=number}, {type=number}] {{*}}creator=ResultWorker{origin=f1}
# CHECK-NOT: NewObject
# CHECK: [[inner1]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: [[x1]]: number = ResultAt [[inner1]]
# CHECK-NEXT: [[y1]]: number = ResultAt [[inner1]] index=1
# CHECK-NOT: NewObject
# CHECK: = Results [[x1]], [[y1]]
# CHECK: function [[readingWorker]] name="readsThenForwards" module=m0 role=ResultWorker {{*}}results=[{type=number}, {type=number}]
# CHECK-NOT: NewObject
# CHECK: [[inner4]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: [[x4]]: number = ResultAt [[inner4]]
# CHECK-NEXT: [[y4]]: number = ResultAt [[inner4]] index=1
# CHECK-NOT: NewObject
# CHECK-NOT: GetSlot
# CHECK: [[read4]]: number = Upcast [[x4]] castType=undefined|null|number
# CHECK-NEXT: = CallDirect [[read4]] function=f10
# CHECK-NEXT: = Results [[x4]], [[y4]]
# CHECK: function [[eitherWorker]] name="forwardsOrReturnsAnotherCall" module=m0 role=ResultWorker {{*}}results=[{type=i32}, {type=anything|unspecified}, {type=number|unspecified}, {type=number|unspecified}]
# CHECK-NOT: NewObject
# CHECK: [[otherInWorker5]]: anything = CallDirect v0 function=f10
# CHECK: = Results {{*}}, [[otherInWorker5]], 
# CHECK-NOT: NewObject
# CHECK: [[inner5]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: [[x5]]: number = ResultAt [[inner5]]
# CHECK-NEXT: [[y5]]: number = ResultAt [[inner5]] index=1
# CHECK: = Results {{*}}, {{*}}, [[x5]], [[y5]]
# CHECK: function [[tailWorker]] name="forwardsByAllowedTailCall" module=m0 role=ResultWorker
# CHECK-NOT: ReturnCall
# CHECK-NOT: NewObject
# CHECK: = CallDirect v0 function=[[pointWorker]]
# CHECK-NOT: ReturnCall
# CHECK: = Results
# CHECK: function [[requiredTailWorker]] name="forwardsByRequiredTailCall" module=m0 role=ResultWorker
# CHECK-NOT: ReturnCall
# CHECK-NOT: NewObject
# CHECK: = CallDirect v0 function=[[pointWorker]]
# CHECK-NOT: ReturnCall
# CHECK: = Results
# CHECK: function [[chain2Worker]] name="chain2" module=m0 role=ResultWorker {{*}}creator=ResultWorker{origin=f2}
# CHECK-NOT: NewObject
# CHECK: = CallDirect v0 function=[[chain1Worker]]
# CHECK: function [[chain3Worker]] name="chain3" module=m0 role=ResultWorker {{*}}creator=ResultWorker{origin=f3}
# CHECK-NOT: NewObject
# CHECK: = CallDirect v0 function=[[chain2Worker]]

# Whoever calls them needs no object
function f11 name="dropsTheResults" parameters=[{type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}, {type=anything}] results=[{type=undefined}] {
# REPEAT: i = 0..10
    v%(i+11) = CallDirect v%(i) function=f%(i)
# END REPEAT
    v22 = Undefined
    Return v22
}
