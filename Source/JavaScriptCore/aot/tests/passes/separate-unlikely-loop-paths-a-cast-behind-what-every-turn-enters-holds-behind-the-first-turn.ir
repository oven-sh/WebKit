# function once() { return late.step }  for (..) sum += once(), with `once` in line. The constant `late` is there whenever `once` is entered and not sooner, so its read stands ahead of the loop and the cast that says it is there stays in the turn.
# Every turn of `often` enters `once`. The questions are asked behind the first turn, so the cast holds there, and `late.step` is asked for once. A turn of `seldom` may pass `once` by: its read stays as it is.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsEnteredByAnswers = 1

module m0 path="main.js" displayPath="main.js"
variable g0 name="late" declared={type=object} flags=[IsImmutable] flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}

function f0 name="often" parameters=[{type=i32}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = Undefined
    v3 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    Jump -> next b1(v1, v2)
  b1(v4: i32, v5: anything):
    LoopHint
    v7 = Less v4, v0
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Entered function=f2
    v9 = AssumeType v3, v8 provenType=object
    v10 = PropGet v9 key="step"
    v11 = Integer integer=1
    v12 = Add v4, v11
    v13 = BitOr v12, v1
    Jump -> next b1(v13, v10)
  b3():
    Return v5
# CHECK: b1(
# CHECK-NOT: PropGet
# CHECK: b3(
# CHECK: = GetCachedValue {{*}} key="step"
}

function f1 name="seldom" parameters=[{type=i32}, {type=boolean}] results=[{type=anything}] {
  b0(v0: i32, v1: boolean):
    v2 = Integer integer=0
    v3 = Undefined
    v4 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    Jump -> next b1(v2, v3)
  b1(v5: i32, v6: anything):
    LoopHint
    v8 = Less v5, v0
    Branch v8 -> taken b2(), notTaken b5()
  b2():
    Branch v1 -> taken b3(), notTaken b4(v6)
  b3():
    v9 = Entered function=f2
    v10 = AssumeType v4, v9 provenType=object
    v11 = PropGet v10 key="step"
    Jump -> next b4(v11)
  b4(v12: anything):
    v13 = Integer integer=1
    v14 = Add v5, v13
    v15 = BitOr v14, v2
    Jump -> next b1(v15, v12)
  b5():
    Return v6
# CHECK-NOT: GetCachedValue
}

function f2 name="once" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="step"
    Return v1
}
