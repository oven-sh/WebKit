# A test of a joined value moves onto the edges where the type of the argument makes it cheap. The constants of the test stand before it and go with it
# FORM: Prepared
# RUN: pass HoistTestsIntoPredecessors
# STATISTIC: HoistTestsIntoPredecessorsChanges = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="truthinessOfJoinedValue" parameters=[{type=boolean}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = ToBoolean v3
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: b2():
# CHECK-NEXT: [[S0]]:{{*}}= ToBoolean v1
# CHECK-NEXT: Jump -> next b3([[S0]])
# CHECK: b3(v3: boolean):
# CHECK-NEXT: Branch v3 -> taken b4(), notTaken b5()
}

function f1 name="comparisonOfJoinedValue" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = Less v3, v0
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
# CHECK: b1():
# CHECK-NEXT: [[S1]]:{{*}}= Less v0, v0
# CHECK-NEXT: Jump -> next b3([[S1]])
# CHECK: b2():
# CHECK-NEXT: [[S2]]:{{*}}= Less v1, v0
# CHECK-NEXT: Jump -> next b3([[S2]])
# CHECK: b3([[S3]]: boolean):
# CHECK-NEXT: Branch [[S3]] -> taken b4(), notTaken b5()
}

