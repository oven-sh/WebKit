# What the callee throws and does not catch reaches the handler of the block with the call
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="throwsBelowZero" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=0
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Throw v0
  b2():
    Return v0
}
function f1 name="rethrows" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b2():
    v1 = Call v0
    Return v1
  b2() role=CatchHandler:
    v2 = CatchException
    Rethrow v2
}

function f2 name="callUnderHandler" parameters=[{type=number}, {type=string}] results=[{type=anything}] {
  b0(v0: number, v1: string):
    Jump -> next b1()
  b1() handler=b2(v1):
    v2 = CallDirect v0 function=f0 [isAlwaysInlined]
    Return v2
  b2(v3) role=CatchHandler:
    v4 = CatchValue
    Return v3
}
# CHECK-LABEL: name="callUnderHandler"
# CHECK-NOT: CallDirect
# CHECK: Branch {{*}} -> taken [[throws2]](), notTaken [[returns2]]()
# CHECK: [[throws2]]() frequency=Rare handler=b2(v1):
# CHECK-NEXT: Throw v0
# CHECK: [[returns2]]() handler=b2(v1):
# CHECK-NEXT: Jump -> next

function f3 name="callWithoutHandler" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f0 [isAlwaysInlined]
    Return v1
}
# CHECK-LABEL: name="callWithoutHandler"
# CHECK-NOT: handler=
# CHECK: Throw v0
# CHECK-NOT: handler=

function f4 name="rethrowUnderHandler" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: anything, v1: string):
    Jump -> next b1()
  b1() handler=b2(v1):
    v2 = CallDirect v0 function=f1 [isAlwaysInlined]
    Return v2
  b2(v3) role=CatchHandler:
    v4 = CatchValue
    Return v3
}
# CHECK-LABEL: name="rethrowUnderHandler"
# CHECK-NOT: CallDirect
# CHECK: () handler=[[inner4]]():
# CHECK-NEXT: = Call v0
# CHECK: [[inner4]]() role=CatchHandler frequency=Rare handler=b2(v1):
# CHECK-NEXT: [[exception4]]: {{*}} = CatchException
# CHECK-NEXT: Rethrow [[exception4]]
