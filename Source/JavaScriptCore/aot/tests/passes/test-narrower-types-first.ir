# A value is tested for what is expected of it, and what has passed is tested at once for what its use needs. What passes the second test would have passed the first,
# so the second goes first. The first moves to its failing side, and from there everything goes on as before.
# FORM: Prepared
# RUN: pass TestNarrowerTypesFirst

module m0 path="main.js" displayPath="main.js"

function f0 name="widerThenNarrower" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|number
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: undefined|number):
    v3 = TypeTest v2 testedType=number
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4: number):
    Return v4
  b3(v5: undefined):
    Return v5
  b4():
    Return v0
}
# CHECK-LABEL: function f0 name="widerThenNarrower"
# CHECK: b0(v0: anything):
# CHECK-NEXT: = TypeTest v0 testedType=number
# CHECK-NEXT: Branch v1 -> taken b2(| 0), notTaken b5()
# CHECK: b1(v2: undefined|number):
# CHECK-NEXT: = TypeTest v2 testedType=number
# CHECK-NEXT: Branch v3 -> taken b2(| 0), notTaken b3(| 0)
# CHECK: b5() frequency=Unlikely:
# CHECK-NEXT: [[wider]]: boolean = TypeTest v0 testedType=undefined|number
# CHECK-NEXT: Branch [[wider]] -> taken b1(| 0), notTaken b4()

function f1 name="whatPassedTheFirstIsUsed" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|number
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: undefined|number):
    v3 = TypeTest v2 testedType=number
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4: number):
    Return v4
  b3():
    Return v2
  b4():
    Return v0
}
# CHECK-LABEL: function f1 name="whatPassedTheFirstIsUsed"
# CHECK: = TypeTest v0 testedType=undefined|number
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b4()

function f2 name="theSecondIsNoPartOfTheFirst" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|number
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: undefined|number):
    v3 = TypeTest v2 testedType=number|string
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4: number):
    Return v4
  b3(v5: undefined):
    Return v5
  b4():
    Return v0
}
# CHECK-LABEL: function f2 name="theSecondIsNoPartOfTheFirst"
# CHECK: = TypeTest v0 testedType=undefined|number
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b4()

function f3 name="somethingStandsBetween" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=undefined|number
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3: undefined|number):
    v4 = Call v1, -
    v5 = TypeTest v3 testedType=number
    Branch v5 -> taken b2(| 0), notTaken b3(| 0)
  b2(v6: number):
    Return v6
  b3(v7: undefined):
    Return v7
  b4():
    Return v0
}
# CHECK-LABEL: function f3 name="somethingStandsBetween"
# CHECK: = TypeTest v0 testedType=undefined|number
# CHECK-NEXT: Branch v2 -> taken b1(| 0), notTaken b4()

function f4 name="theSecondIsReachedFromTwoSides" parameters=[{type=anything}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: undefined|number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=undefined|number
    Branch v3 -> taken b3(| 0), notTaken b6()
  b2():
    Jump -> next b3(v1)
  b3(v4: undefined|number):
    v5 = TypeTest v4 testedType=number
    Branch v5 -> taken b4(| 0), notTaken b5(| 0)
  b4(v6: number):
    Return v6
  b5(v7: undefined):
    Return v7
  b6():
    Return v0
}
# CHECK-LABEL: function f4 name="theSecondIsReachedFromTwoSides"
# CHECK: = TypeTest v0 testedType=undefined|number
# CHECK-NEXT: Branch v3 -> taken b3(| 0), notTaken b6()

function f5 name="argumentsGoAlong" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=undefined|i32
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3: undefined|i32):
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(v1 | 0), notTaken b3(| 0)
  b2(v5: anything, v6: i32):
    v7 = Call v5, -, v6
    Return v7
  b3(v8: undefined):
    Return v8
  b4():
    Return v0
}
# CHECK-LABEL: function f5 name="argumentsGoAlong"
# CHECK: = TypeTest v0 testedType=i32
# CHECK-NEXT: Branch v2 -> taken b2(v1 | 0), notTaken b5()

# The second test asks whether there is nothing, and mostly there is something: the tests keep their order.
function f6 name="narrowerIsNothing" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|null|string
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: undefined|null|string):
    v3 = TypeTest v2 testedType=undefined|null
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4: undefined|null):
    Return v4
  b3(v5: string):
    Return v5
  b4():
    Return v0
}
# CHECK-LABEL: function f6 name="narrowerIsNothing"
# CHECK: b0(v0: anything):
# CHECK-NEXT: = TypeTest v0 testedType=undefined|null|string
# CHECK-NOT: frequency=Unlikely

# The side on which the second test passes is the rarer one: the tests keep their order.
function f7 name="narrowerIsRare" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number|string
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: number|string):
    v3 = TypeTest v2 testedType=number
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4: number) frequency=Rare:
    Return v4
  b3(v5: string):
    Return v5
  b4():
    Return v0
}
# CHECK-LABEL: function f7 name="narrowerIsRare"
# CHECK: b0(v0: anything):
# CHECK-NEXT: = TypeTest v0 testedType=number|string

# Of a family of layouts nothing says which part arrives more often: the rest is as likely as the test, not unlikely.
layout L0 name="Identifier" fields=[{key="a" declared={type=anything}}]
layout L1 name="Block" fields=[{key="b" declared={type=anything}}]
layout L2 name="Call" fields=[{key="c" declared={type=anything}}]
function f8 name="partOfAFamily" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=L0|L1|L2
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: L0|L1|L2):
    v3 = TypeTest v2 testedType=L0
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4: L0):
    Return v4
  b3(v5: L1|L2):
    Return v5
  b4():
    Return v0
}
# CHECK-LABEL: function f8 name="partOfAFamily"
# CHECK: b0(v0: anything):
# CHECK-NEXT: = TypeTest v0 testedType=L0
# CHECK-NOT: frequency=Unlikely
# CHECK: = TypeTest v0 testedType=L0|L1|L2
# CHECK-NOT: frequency=Unlikely
