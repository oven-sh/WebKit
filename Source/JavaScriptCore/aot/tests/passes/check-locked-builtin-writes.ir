# A store to a locked built-in at the top of the body of the entry module, or of a module of the program it imports, runs in every run and throws: the build reports an error for each
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteAlwaysRuns 2

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="imported.js" displayPath="imported.js" body=f1
entry module=m0
layout L0 name="Plain" fields=[{key="x" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Object" [isFreeName] @10
    v2 = PropGet v1 key="prototype" @20
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict @30
    v5 = NewObject layout=L0 fields=[]
    PropSet v5, v3 key="x" mode=Strict @40
    v7 = PropGet v0 key="Math" [isFreeName] @50
    PropSet v7, v3 key="x" mode=Strict @60
    Return
}
function f1 name="imported" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    PropSet v0, v1 key="y" mode=Strict @10
    Return
}
