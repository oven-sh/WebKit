# An iteration over what split returns for a separator that is never empty searches for the next separator at each step, and the array is never made
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 15
# STATISTIC: IterationsExpandedGenerically = 0

module m0 path="main.js" displayPath="main.js"

function f0 name="constantSeparator" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: anything):
    v2 = String string=","
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = IteratorOpen v3
    Jump -> next b1()
  b1():
    LoopHint
    v6 = IteratorResume v4
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v9 = Call v1, -, v8
    Jump -> next b1()
  b3():
    Return
}
# CHECK-LABEL: function f0 name="constantSeparator"
# CHECK-NOT: StringPrototypeSplit
# CHECK: [[zero0]]: 0 = Integer
# CHECK-NEXT: Jump -> next [[start0]]([[zero0]])
# CHECK: [[length0]]: int[0, 2147483647] = GetStringLength v0
# CHECK-NEXT: [[has0]]: boolean = LessEq [[position0]], [[length0]]
# CHECK-NEXT: Branch [[has0]] -> taken [[search0]](| 0), notTaken [[done0]](
# CHECK: [[search0]]([[from0]]: int[0, 2147483647]):
# CHECK-NEXT: [[found0]]: int[-1, 2147483647] = CallBuiltin v0, v2, [[from0]] overload=StringPrototypeIndexOf/0
# CHECK: [[isLast0]]: boolean = Less [[found0]],
# CHECK-NEXT: Branch [[isLast0]] -> taken [[last0]]({{*}}), notTaken [[inner0]](| 0)
# CHECK: [[cut0]]([[end0]]: int[0, 2147483647], [[next0]]: int[0, 4294967294]):
# CHECK-NEXT: [[substring0]]: string = Substring v0, [[from0]], [[end0]]
# CHECK: [[last0]](
# CHECK: [[past0]]: int[1, 2147483648] = Add [[length0]],
# CHECK-NEXT: Jump -> next [[cut0]]([[length0]], [[past0]])
# CHECK: [[inner0]]([[at0]]: int[0, 2147483647]):
# CHECK-NEXT: [[width0]]: {{*}} = GetStringLength v2
# CHECK-NEXT: [[behind0]]: {{*}} = Add [[at0]], [[width0]]
# CHECK-NEXT: Jump -> next [[cut0]]([[at0]], [[behind0]])
# CHECK-NOT: NewArray
# CHECK-NOT: ElemGet
# CHECK-NOT: IsPristine
# CHECK-NOT: @@iterator

