  b1() handler=b6():
    v4 = IteratorResume v3 stepIndex=0
    v5 = ResultAt v4 index=1
    v6 = NewArray contents=anything
    Jump -> next b2()
  b2() handler=b6():
    LoopHint
    v8 = IteratorResume v3 stepIndex=1
    v9 = ResultAt v8
    v10 = ResultAt v8 index=1
    Branch v9 -> taken b4(), notTaken b3()
  b3() handler=b6():
    AppendElement v6, v10
    Jump -> next b2()
  b4() handler=b6():
    Jump -> next b5()
  b5():
    IteratorClose v3
    v13 = Add v5, v6
    Return v13
  b6() role=IterationCleanup subject=v3:
    v14 = CatchException
    IteratorClose v3 completion=Throw
    Rethrow v14
}
