  b0(v0: string, v1: anything):
    v2 = String string=", "
    v3 = CallBuiltin v0, v2 overload=StringPrototypeSplit/0
    v4 = AssumeType v3 castType=Array<string, proven>
    v5 = Integer integer=1
    v6 = Predict v4 predicted=Array<string, Contiguous>
