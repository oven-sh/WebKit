function f7 name="innerBoundComputedInInnerHeader" parameters=[{type=number}, {type=int[0, 100]}] results=[{type=undefined}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(| 0), notTaken b6()
  b2(v6):
    v7 = Integer integer=0
    Jump -> next b3(v7)
  b3(v8):
    LoopHint
    v10 = Integer integer=0
    v11 = BitOr v0, v10
    v12 = Less v8, v11
    Branch v12 -> taken b4(| 0), notTaken b5()
  b4(v13):
    v14 = Increment v13
    Jump -> next b3(v14)
  b5():
    v15 = Increment v6
    Jump -> next b1(v15)
  b6():
    Return
# CHECK: Jump -> next b6()
# CHECK-NOT: LoopHint
}

# The list grows as fast as the counter
function f8 name="loopAppendsToList" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=undefined}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = GetArrayLength v0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    AppendElement v0, v6
    v8 = Increment v6
    Jump -> next b1(v8)
  b3():
    Return
# CHECK: Jump -> next b1(v1)
# CHECK: LoopHint
}

