# A bound that every iteration computes again is not known to stay the same, so the loop stays
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="lengthReadInHeader" parameters=[{type=string}] results=[{type=undefined}] {
  b0(v0: string):
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = GetStringLength v0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Integer integer=1
    v8 = Add v6, v7
    Jump -> next b1(v8)
  b3():
    Return
}
# CHECK-LABEL: function f0 name="lengthReadInHeader"
# CHECK: Jump -> next b1(v1)
# CHECK: b1(v2: int[{{*}}]):
# CHECK: LoopHint

function f1 name="lengthReadBeforeLoop" parameters=[{type=string}] results=[{type=undefined}] {
  b0(v0: string):
    v1 = Integer integer=0
    v2 = GetStringLength v0
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v2
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Integer integer=1
    v8 = Add v6, v7
    Jump -> next b1(v8)
  b3():
    Return
}
# CHECK-LABEL: function f1 name="lengthReadBeforeLoop"
# CHECK: Jump -> next b3()
# CHECK-NOT: LoopHint

