# `for (let k = 0; k < (n | 0); k++)`, `for (let i = 0; i < list.length; i++)`: every iteration computes the bound again, from operands that the loop does not change.
# A loop that is removed changes nothing at all, so the bound is the same in every iteration. A bound that is computed from the counter, or that may be Infinity, keeps the loop
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 7

module m0 path="main.js" displayPath="main.js"
function f0 name="lengthReadInHeader" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = GetStringLength v0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Integer integer=1
    v8 = Add v6, v7
    Jump -> next b1(v8)
  b3():
    Return
# CHECK: Jump -> next b3()
# CHECK-NOT: LoopHint
}

