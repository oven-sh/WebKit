# A block parameter of type guard is a guard of the object, never a join of the objects its guards are about
# FORM: Prepared optimizing
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 1
# STATISTIC: AllocationsSunk = 1
# STATISTIC: AllocationsMergedAtJoins = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Holder" fields=[{key="list" declared={type=anything} flags=[IsRequired]}]

function f0 name="guardOfCellCarriedAroundLoop" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewArray contents=anything
    v4 = AllGuards v3
    v5 = GetShapeEpoch
    v6 = Integer
    Jump -> next b1(v6, v4, v5)
  b1(v7, v8, v9):
    LoopHint
    v11 = Less v7, v1
    Branch v11 -> taken b2(), notTaken b5()
  b2():
    v12 = IsShapeEpochCurrent v9, v8
    Branch v12 -> taken b3(| 0), notTaken b4()
  b3(v13):
    v14 = GetShapeEpoch
    PutArrayElement v3, v7, v0, v13 level=Predicted [keyIsIntegral]
    v16 = Increment v7
    Jump -> next b1(v16, v13, v14)
  b4():
    ElemDefine v3, v7, v0
    Return v3
  b5():
    v18 = Call v0, -, v3, v2
    Return v18
}
