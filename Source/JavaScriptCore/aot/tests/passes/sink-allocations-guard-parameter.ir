function f1 name="guardOfVirtualObjectPassedOnTwoEdges" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = AllGuards v2
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v3)
  b3(v4):
    v5 = GetSlotOrUndefined v2, v4 key="list" receivers=[L0] level=Predicted
    Return v5
}
