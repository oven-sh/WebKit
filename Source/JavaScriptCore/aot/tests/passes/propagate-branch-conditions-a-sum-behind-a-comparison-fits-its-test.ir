# `if (size < 16) size++`: behind the comparison the integer is below 16, so its sum passes the test for the range of a field. The edge hands the integer on, and the sum is typed from that, also where a join stands in front of the sum.
# A sum that the comparison leaves outside the tested range, a sum that nobody tests and a sum behind both edges stay as they are.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass PropagateBranchConditions

module m0 path="main.js" displayPath="main.js"
function f0 name="belowALimit" parameters=[{type=i32}] results=[{type=int}] {
    v1 = Integer integer=16
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v3 = Increment v0
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    Return v0
# CHECK: Branch v2 -> taken b1(| 0), notTaken b3()
# CHECK: b1([[below]]: int[-2147483648, 15]):
# CHECK-NEXT: int[-2147483647, 16] = Increment [[below]]
}

function f1 name="onTheEdgeThatIsNotTaken" parameters=[{type=i32}] results=[{type=int}] {
    v1 = Integer integer=0
    v2 = LessEq v0, v1
    Branch v2 -> taken b3(), notTaken b1()
  b1():
    v3 = Decrement v0
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    Return v0
# CHECK: Branch v2 -> taken b3(), notTaken b1(| 0)
# CHECK: b1([[above]]: int[1, 2147483647]):
# CHECK-NEXT: int[0, 2147483646] = Decrement [[above]]
}

function f2 name="theLimitStandsOnTheLeft" parameters=[{type=i32}, {type=int[0, 100]}] results=[{type=int}] {
    v2 = Greater v1, v0
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v3 = Integer integer=7
    v4 = Add v0, v3
    v5 = TypeTest v4 testedType=i32
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    Return v6
  b3():
    Return v0
# CHECK: Branch v2 -> taken b1(| 1), notTaken b3()
# CHECK: b1([[belowLimit]]: int[-2147483648, 99]):
# CHECK: int[-2147483641, 106] = Add [[belowLimit]], v3
}

function f3 name="theSumMayStillFail" parameters=[{type=i32}] results=[{type=int}] {
    v1 = Integer integer=16
    v2 = Greater v0, v1
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v3 = Increment v0
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    Return v0
# CHECK: Branch v2 -> taken b1(), notTaken b3()
# CHECK: = Increment v0
}

function f4 name="nobodyTestsTheSum" parameters=[{type=i32}] results=[{type=int}] {
    v1 = Integer integer=16
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Increment v0
    Return v3
  b2():
    Return v0
# CHECK: Branch v2 -> taken b1(), notTaken b2()
# CHECK: = Increment v0
}

function f5 name="behindBothEdges" parameters=[{type=i32}] results=[{type=int}] {
    v1 = Integer integer=16
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b1()
  b1():
    v3 = Increment v0
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    Return v0
# CHECK: Branch v2 -> taken b1(), notTaken b1()
# CHECK: = Increment v0
}

function f6 name="theSumStandsBehindAJoin" parameters=[{type=int[-2147483643, 2147483647]}] results=[{type=int}] {
    v1 = Integer integer=16
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=5
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v0)
  b3(v4: int[-2147483643, 2147483647]):
    v5 = Decrement v4
    v6 = TypeTest v5 testedType=int[-2147483643, 2147483647]
    Branch v6 -> taken b4(| 0), notTaken b5()
  b4(v7):
    Return v7
  b5():
    Return v0
# CHECK: Branch v2 -> taken b1(), notTaken b2(| 0)
# CHECK: b2([[atLeast]]: int[16, 2147483647]):
# CHECK-NEXT: Jump -> next b3([[atLeast]])
# CHECK: b3(v4: int[5, 2147483647]):
# CHECK-NEXT: int[4, 2147483646] = Decrement v4
}

function f7 name="theOtherWayIntoTheJoinMayStillFail" parameters=[{type=int[-2147483643, 2147483647]}, {type=int[-2147483643, 2147483647]}] results=[{type=int}] {
    v2 = Integer integer=16
    v3 = Less v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v0)
  b3(v4: int[-2147483643, 2147483647]):
    v5 = Decrement v4
    v6 = TypeTest v5 testedType=int[-2147483643, 2147483647]
    Branch v6 -> taken b4(| 0), notTaken b5()
  b4(v7):
    Return v7
  b5():
    Return v0
# CHECK: Branch v3 -> taken b1(), notTaken b2()
# CHECK: Jump -> next b3(v0)
}

function f8 name="theOtherWayIntoTheJoinHandsOnWhatItsTestProved" parameters=[{type=int[-2147483643, 2147483647]}, {type=number}] results=[{type=int}] {
    v2 = Integer integer=16
    v3 = Less v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = TypeTest v1 testedType=int[-2147483643, 2147483647]
    Branch v4 -> taken b3(| 0), notTaken b5()
  b2():
    Jump -> next b3(v0)
  b3(v5: int[-2147483643, 2147483647]):
    v6 = Decrement v5
    v7 = TypeTest v6 testedType=int[-2147483643, 2147483647]
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8):
    Return v8
  b5():
    Return v0
# CHECK: Branch v3 -> taken b1(), notTaken b2()
# CHECK: Jump -> next b3(v0)
}
