# A value that may throw does not collect when it completes, so the owner stays young after it, also under a handler that reads the owner
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="store-after-value-may-throw" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject layout=L0 fields=[]
    Jump -> next b1()
  b1() handler=b2():
    v2 = RequireObjectCoercible v0 nullishAccess=Read
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v0
  b2() role=CatchHandler:
    v4 = CatchValue
    v5 = GetEnvironmentField v1 layout=L0 field=0
    Return v5
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f1 name="store-after-call" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject layout=L0 fields=[]
    Jump -> next b1()
  b1() handler=b2():
    v2 = Call v0
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v0
  b2() role=CatchHandler:
    v4 = CatchValue
    v5 = GetEnvironmentField v1 layout=L0 field=0
    Return v5
# CHECK: PutEnvironmentField v1, v0 layout=L0
# CHECK-NOT: ownerCannotBeMarked
}
