# An environment the function allocated is still unmarked in a later block when no path from the allocation can collect.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="new-owner-in-later-block" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject layout=L0 fields=[]
    Jump -> next b1()
  b1():
    Jump -> next b2()
  b2():
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return
}
# CHECK-LABEL: function f0 name="new-owner-in-later-block"
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
function f1 name="collected-in-block-between" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject layout=L0 fields=[]
    Jump -> next b1()
  b1():
    v2 = NewObject layout=L0 fields=[]
    Jump -> next b2()
  b2():
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return
}
# CHECK-LABEL: function f1 name="collected-in-block-between"
# CHECK: PutEnvironmentField v1, v0 layout=L0
# CHECK-NOT: ownerCannotBeMarked
