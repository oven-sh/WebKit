# The last store of an iteration to a loop-carried environment keeps its barrier, because the first store of the next iteration is to a different environment.
# FORM: Placed
# RUN: pass RemoveRedundantBarriers
# STATISTIC: BarriersCoveredLater = 0
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="loop-carried-owner" captures=[{type=env L0}, {type=env L0}] parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: env L0 @Cell, v1: env L0 @Cell, v2: anything @JSValue, v3: boolean @Boolean):
    Jump -> next b1(v0)
  b1(v4 @Cell):
    PutEnvironmentField v4, v2 layout=L0 field=0
    LoopHint
    PutEnvironmentField v4, v2 layout=L0 field=1
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v1)
  b3():
    PutEnvironmentField v4, v2 layout=L0 field=0
    v9 @JSValue = Undefined
    Return v9
}
# CHECK: outcome: Unchanged
# CHECK-COUNT-3: PutEnvironmentField v4, v2 layout=L0
# CHECK-NOT: PutEnvironmentField
