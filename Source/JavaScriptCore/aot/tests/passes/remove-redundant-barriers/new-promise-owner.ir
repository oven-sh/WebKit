# NewPromise allocates after its last safepoint, so a store to the promise needs no barrier unless something in between can collect
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0
function f0 name="new-promise-owner" parameters=[{type=string}] results=[{type=undefined}] {
  b0(v0: string):
    v1 = NewPromise
    FulfillFreshPromise v1, v0
    Return
}
# CHECK-LABEL: function f0 name="new-promise-owner"
# CHECK: FulfillFreshPromise v1, {{*}} [ownerCannotBeMarked]
function f1 name="allocation-since-new-promise" parameters=[{type=string}] results=[{type=undefined}] {
  b0(v0: string):
    v1 = NewPromise
    v2 = NewObject layout=L0 fields=[]
    FulfillFreshPromise v1, v0
    Return
}
# CHECK-LABEL: function f1 name="allocation-since-new-promise"
# CHECK: FulfillFreshPromise v1,
# CHECK-NOT: ownerCannotBeMarked
