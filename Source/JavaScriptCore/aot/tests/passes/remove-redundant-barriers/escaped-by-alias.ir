# An object escapes when an upcast alias of it is stored in a module variable, so a later store to it keeps its barrier.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] flow={members=[L0]}
variable g0 declared={type=anything} initialization=Undefined
function f0 name="escaped-by-alias" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = Upcast v1 castType=anything
    PutModuleVariable v2 variable=g0
    PutSlot v1, -, v0 key="x" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f0 name="escaped-by-alias"
# CHECK: PutSlot v1, -, v0 key="x"
# CHECK-NOT: ownerCannotBeMarked
function f1 name="alias-not-stored" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = Upcast v1 castType=anything
    PutModuleVariable v0 variable=g0
    PutSlot v1, -, v0 key="x" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f1 name="alias-not-stored"
# CHECK: PutSlot v1, -, v0 key="x"{{*}}[ownerCannotBeMarked]
