# A later store to the same owner runs the barrier for an earlier store when nothing in between can collect, throw, suspend or return.
# FORM: Placed
# RUN: pass RemoveRedundantBarriers
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="covered-by-later-store" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue):
    PutEnvironmentField v0, v1 layout=L0 field=0
    PutEnvironmentField v0, v1 layout=L0 field=1
    v4 @JSValue = Undefined
    Return v4
}
# CHECK: outcome: Changed
# CHECK: PutEnvironmentField v0, v1 layout=L0 [laterBarrierCovers]
# CHECK-NEXT: PutEnvironmentField v0, v1 layout=L0 field=1
# CHECK-NOT: laterBarrierCovers
# CHECK-NOT: ownerCannotBeMarked
