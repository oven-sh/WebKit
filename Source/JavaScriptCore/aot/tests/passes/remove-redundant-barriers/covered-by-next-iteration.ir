# The last store of an iteration needs no barrier of its own when the next iteration and the loop exit both start with a store to the same owner.
# FORM: Placed
# RUN: pass RemoveRedundantBarriers
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="covered-by-next-iteration" captures=[{type=env L0}] parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue, v2: boolean @Boolean):
    Jump -> next b1()
  b1():
    PutEnvironmentField v0, v1 layout=L0 field=0
    LoopHint
    PutEnvironmentField v0, v1 layout=L0 field=1
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    PutEnvironmentField v0, v1 layout=L0 field=0
    v7 @JSValue = Undefined
    Return v7
}
# CHECK: outcome: Changed
# CHECK: b1():
# CHECK-NEXT: PutEnvironmentField v0, v1 layout=L0
# CHECK-NOT: laterBarrierCovers
# CHECK: LoopHint
# CHECK-NEXT: PutEnvironmentField v0, v1 layout=L0 field=1 [laterBarrierCovers]
# CHECK: b3():
# CHECK-NEXT: PutEnvironmentField v0, v1 layout=L0
# CHECK-NOT: laterBarrierCovers
