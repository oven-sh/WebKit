# Creating the permanent cell of a string constant never collects, so a store of a literal string that is decoded for it, or one after a String, keeps the proof that its owner is unmarked. A concatenation allocates an ordinary cell and ends it.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 3
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="decode-since" parameters=[{type="a"|"b"}] results=[{type=undefined}] {
    v1 = NewObject layout=L0 fields=[]
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return
# CHECK: = NewObject layout=L0
# CHECK-NEXT: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f1 name="string-constant-since" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = String string="a"
    PutEnvironmentField v1, v2 layout=L0 field=0
    PutEnvironmentField v1, v0 layout=L0 field=1
    Return
# CHECK: = NewObject layout=L0
# CHECK-NEXT: = String string="a"
# CHECK: PutEnvironmentField v1,{{*}}layout=L0 [ownerCannotBeMarked]
# CHECK-NEXT: PutEnvironmentField v1, v0 layout=L0 field=1 [ownerCannotBeMarked]
}
function f2 name="concatenation-since" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = Add v0, v0 form=Strings
    PutEnvironmentField v1, v2 layout=L0 field=0
    Return
# CHECK: = Add v0, v0 form=Strings
# CHECK: PutEnvironmentField v1,
# CHECK-NOT: ownerCannotBeMarked
}
