# A later slot store to the same object runs the barrier for an earlier one when nothing in between can collect, throw, suspend or return.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] flow={members=[L0]}
function f0 name="covered-by-later-slot-store" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: anything):
    PutSlot v0, -, v1 key="x" receivers=[L0] level=Proven
    PutSlot v0, -, v1 key="y" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f0 name="covered-by-later-slot-store"
# CHECK: PutSlot v0, -, v1 key="x"{{*}}[laterBarrierCovers]
# CHECK-NEXT: PutSlot v0, -, v1 key="y"
# CHECK-NOT: laterBarrierCovers
function f1 name="store-to-other-object" parameters=[{type=L0}, {type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: L0, v2: anything):
    PutSlot v0, -, v2 key="x" receivers=[L0] level=Proven
    PutSlot v1, -, v2 key="y" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f1 name="store-to-other-object"
# CHECK: PutSlot v0, -, v2 key="x"
# CHECK-NOT: laterBarrierCovers
