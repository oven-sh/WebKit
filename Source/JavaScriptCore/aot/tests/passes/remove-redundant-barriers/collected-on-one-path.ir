# The store keeps its barrier when one of the paths from the owner's allocation can collect.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1
function f0 name="collected-on-one-path" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject layout=L0 fields=[]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject layout=L1 fields=[]
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    PutEnvironmentField v2, v0 layout=L0 field=0
    Return
}
# CHECK-LABEL: function f0 name="collected-on-one-path"
# CHECK: PutEnvironmentField v2, v0 layout=L0
# CHECK-NOT: ownerCannotBeMarked
function f1 name="collected-on-no-path" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject layout=L0 fields=[]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    PutEnvironmentField v2, v0 layout=L0 field=0
    Return
}
# CHECK-LABEL: function f1 name="collected-on-no-path"
# CHECK: PutEnvironmentField v2, v0 layout=L0 [ownerCannotBeMarked]
