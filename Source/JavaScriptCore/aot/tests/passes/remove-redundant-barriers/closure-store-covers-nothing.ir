# The store of a closure into a deferred closure slot emits no code and runs no barrier, so it covers no earlier store. The same store into an ordinary slot does.
# FORM: Selected
# OPTIONS: references=narrow
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: DeferredClosureSlots = 1
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Deferred" fields=[{key="other" declared={type=anything} flags=[IsRequired]}, {key="handler" declared={type=f2} flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce deferral=CapturesNothing deferredFunction=f2} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L0]}
layout L1 name="Created" fields=[{key="other" declared={type=anything} flags=[IsRequired]}, {key="handler" declared={type=f2} flags=[IsRequired]}] flow={members=[L1]}
function f0 name="deferred" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: anything):
    v2 = NewClosure function=f2
    PutSlot v0, -, v1 key="other" receivers=[L0] level=Proven
    PutSlot v0, -, v2 key="handler" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f0 name="deferred"
# CHECK: PutSlot v0, -, v1 key="other"
# CHECK-NOT: laterBarrierCovers
function f1 name="created" parameters=[{type=L1}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L1, v1: anything):
    v2 = NewClosure function=f2
    PutSlot v0, -, v1 key="other" receivers=[L1] level=Proven
    PutSlot v0, -, v2 key="handler" receivers=[L1] level=Proven
    Return
}
# CHECK-LABEL: function f1 name="created"
# CHECK: PutSlot v0, -, v1 key="other"{{*}}[laterBarrierCovers]
function f2 name="captures-nothing" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
