# The store of a closure into a deferred closure slot emits no code and runs no barrier, so it covers no earlier store. The same store into an ordinary slot does.
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses,RemoveRedundantBarriers references=narrow
# RUN: pipeline RemoveRedundantBarriers
# STATISTIC: DeferredClosureSlots = 1
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Deferred" constructor=f1 fields=[{key="other" declared={type=anything} flags=[IsRequired]}, {key="handler" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Created" constructor=f3 fields=[{key="other" declared={type=anything} flags=[IsRequired]}, {key="handler" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4, -, v1
    v6 = NewClosure function=f3
    v7 = NewClass v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8, -, v1
    Return
}
function f1 name="Deferred" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    v4 = NewClosure function=f2
    PropDefine v3, v1 key="other"
    PropDefine v3, v4 key="handler"
    Return v3
}
# CHECK-LABEL: function f1 name="Deferred"
# CHECK: PutSlot v3, -, v1 key="other"
# CHECK-NOT: laterBarrierCovers
function f2 name="captures-nothing" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
# CHECK-LABEL: function f2 name="captures-nothing"
function f3 name="Created" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1 fields=[]
    v4 = NewClosure v1 function=f4
    PropDefine v3, v1 key="other"
    PropDefine v3, v4 key="handler"
    Return v3
}
# CHECK-LABEL: function f3 name="Created"
# CHECK: PutSlot v3, -, v1 key="other"{{*}}[laterBarrierCovers]
function f4 name="captures-parameter" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
