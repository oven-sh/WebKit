# A store that can collect may do so before it writes, so it keeps its barrier even for an owner the function has just allocated. A store that makes room for its field collects nothing.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 3
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] flow={members=[L0]}
function f0 name="collecting-store" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewArray
    AppendElement v1, v0
    Return
# CHECK: AppendElement v1, v0
# CHECK-NOT: ownerCannotBeMarked
}
function f1 name="plain-store" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutSlot v1, -, v0 key="y" receivers=[L0] level=Proven
    Return
# CHECK: PutSlot v1, -, v0 key="y"{{*}}[ownerCannotBeMarked]
}
function f2 name="store-that-adds-its-field" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutSlotOrAdd v1, -, v0 key="y" receivers=[L0] level=Proven
    PutSlot v1, -, v0 key="x" receivers=[L0] level=Proven
    Return
# CHECK: PutSlotOrAdd v1, -, v0 key="y"{{*}}[ownerCannotBeMarked]
# CHECK: PutSlot v1, -, v0 key="x"{{*}}[ownerCannotBeMarked]
}
