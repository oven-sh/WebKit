# A store that can collect may do so before it writes, so it keeps its barrier even for an owner the function has just allocated.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] flow={members=[L0]}
function f0 name="collecting-store" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    PutSlotOrAdd v1, -, v0 key="y" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f0 name="collecting-store"
# CHECK: PutSlotOrAdd v1, -, v0 key="y"
# CHECK-NOT: ownerCannotBeMarked
function f1 name="plain-store" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    PutSlot v1, -, v0 key="y" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f1 name="plain-store"
# CHECK: PutSlot v1, -, v0 key="y"{{*}}[ownerCannotBeMarked]
