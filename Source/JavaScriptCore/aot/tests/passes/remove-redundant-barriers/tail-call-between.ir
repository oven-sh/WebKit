# A store keeps its barrier when one path from it leaves the function through a call in tail position
# FORM: Placed
# RUN: pass RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 0
# STATISTIC: BarriersCoveredLater = 1

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="tail-call-between" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue):
    v2 @Boolean = ToBoolean v1 form=Generic
    PutEnvironmentField v0, v1 layout=L0 field=0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v4 @JSValue = Call v1
    ReturnCall v4
  b2():
    PutEnvironmentField v0, v1 layout=L0 field=1
    Return v1
}
# CHECK-LABEL: function f0 name="tail-call-between"
# CHECK: PutEnvironmentField v0, v1 layout=L0
# CHECK: PutEnvironmentField v0, v1 layout=L0 field=1
# CHECK-NOT: laterBarrierCovers
function f1 name="store-before-tail-call" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue):
    v2 @Boolean = ToBoolean v1 form=Generic
    PutEnvironmentField v0, v1 layout=L0 field=0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    PutEnvironmentField v0, v1 layout=L0 field=1
    v5 @JSValue = Call v1
    ReturnCall v5
  b2():
    PutEnvironmentField v0, v1 layout=L0 field=1
    Return v1
}
# CHECK-LABEL: function f1 name="store-before-tail-call"
# CHECK: PutEnvironmentField v0, v1 layout=L0 [laterBarrierCovers]
# CHECK-NOT: laterBarrierCovers
