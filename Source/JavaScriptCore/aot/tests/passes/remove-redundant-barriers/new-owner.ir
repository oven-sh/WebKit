# A store to an environment the function has just allocated needs no barrier when nothing between the allocation and the store can collect.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="new-owner" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject layout=L0 fields=[]
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f1 name="captured-owner" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: env L0, v1: anything):
    PutEnvironmentField v0, v1 layout=L0 field=0
    Return
# CHECK: PutEnvironmentField v0, v1 layout=L0
# CHECK-NOT: ownerCannotBeMarked
}
