# The store of a closure needs no barrier of its own when a later store to the same owner runs one.
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] flow={members=[L0]}
function f0 name="closure-store-is-covered" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: anything):
    v2 = NewClosure function=f2
    PutSlot v0, -, v2 key="x" receivers=[L0] level=Proven
    PutSlot v0, -, v1 key="y" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f0 name="closure-store-is-covered"
# CHECK: PutSlot v0, -,{{*}}key="x"{{*}}[laterBarrierCovers]
# CHECK-NEXT: PutSlot v0, -, v1 key="y"
# CHECK-NOT: laterBarrierCovers
function f1 name="closure-store-is-last" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
  b0(v0: L0, v1: anything):
    v2 = NewClosure function=f2
    PutSlot v0, -, v2 key="x" receivers=[L0] level=Proven
    Return
}
# CHECK-LABEL: function f1 name="closure-store-is-last"
# CHECK: PutSlot v0, -,{{*}}key="x"
# CHECK-NOT: laterBarrierCovers
function f2 name="stored" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
