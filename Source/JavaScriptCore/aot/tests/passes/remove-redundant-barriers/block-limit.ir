# A function with more blocks than MaxBarrierBlocks is not analyzed, so every store in it keeps its barrier.
# FORM: Placed
# OPTIONS: limit=MaxBarrierBlocks:1
# RUN: pass RemoveRedundantBarriers
# LOSS: MaxBarrierBlocks x1 f0
# STATISTIC: BarriersCoveredLater = 1
# STATISTIC: BarriersOnUnmarkableOwners = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="two-blocks" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue):
    PutEnvironmentField v0, v1 layout=L0 field=0
    Jump -> next b1()
  b1():
    PutEnvironmentField v0, v1 layout=L0 field=1
    v4 @JSValue = Undefined
    Return v4
}
# CHECK-LABEL: function f0 name="two-blocks"
# CHECK: PutEnvironmentField v0, v1 layout=L0
# CHECK-NOT: laterBarrierCovers
function f1 name="one-block" captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: env L0 @Cell, v1: anything @JSValue):
    PutEnvironmentField v0, v1 layout=L0 field=0
    PutEnvironmentField v0, v1 layout=L0 field=1
    v4 @JSValue = Undefined
    Return v4
}
# CHECK-LABEL: function f1 name="one-block"
# CHECK: PutEnvironmentField v0, v1 layout=L0 [laterBarrierCovers]
