# A type test is never a safepoint, whatever constant it compares with, so the owner stays young across it
# FORM: Selected
# RUN: pass NumberAndEncode ChooseRepresentations RemoveRedundantBarriers
# STATISTIC: BarriersOnUnmarkableOwners = 3
# STATISTIC: BarriersCoveredLater = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="test-against-one-symbol-since" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = TypeTest v0 testedType=symbol("k")@m0:10
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v2
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f1 name="test-against-string-literals-since" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = TypeTest v0 testedType="a"|"b"
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v2
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f2 name="test-against-any-symbol-since" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = TypeTest v0 testedType=symbol
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v2
# CHECK: PutEnvironmentField v1, v0 layout=L0 [ownerCannotBeMarked]
}
function f3 name="allocation-and-test-since" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = NewObject layout=L0 fields=[]
    v3 = TypeTest v0 testedType=symbol
    PutEnvironmentField v1, v0 layout=L0 field=0
    Return v3
# CHECK: PutEnvironmentField v1, v0 layout=L0
# CHECK-NOT: ownerCannotBeMarked
}
