# A literal declares that it holds anything. Where flow has proven its contents, a read has their type, and the elements of the list have it too: the list is never made
# FORM: Prepared
# OPTIONS: report=Declines
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 6
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js"

function f0 name="pairTakenApart" parameters=[{type=int}] results=[{type=number}] {
  b0(v0: int):
    v1 = String string="x"
    v2 = NewArray v1, v0 contents=anything
    v3 = AssumeType v2 provenType=undefined|Array<undefined|int|fractional|string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v4 = Integer
    v5 = GetArrayElement v3, v4 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    v6 = Upcast v5 castType=anything
    v7 = AssumeType v6 provenType=string
    v8 = Integer integer=1
    v9 = GetArrayElement v3, v8 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    v10 = Upcast v9 castType=anything
    v11 = AssumeType v10 provenType=undefined|int|fractional
    v12 = GetStringLength v7
    v13 = Add v12, v11
    Return v13
# CHECK: b0(v0: int):
# CHECK-NOT: NewArray
# CHECK-NOT: GetArrayElement
# CHECK: v5:{{*}}= Upcast v1 castType=
# CHECK-NOT: GetArrayElement
# CHECK: v9:{{*}}= Upcast v0 castType=
}

function f1 name="elementsOfWiderTypes" parameters=[{type=anything}, {type=anything}] results=[{type=undefined|int|string}] {
  b0(v0: anything, v1: anything):
    v2 = NewArray v0, v1 contents=anything
    v3 = AssumeType v2 provenType=Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v4 = Integer integer=1
    v5 = GetArrayElement v3, v4 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v5
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK: [[second]]: undefined|int|string = AssumeType v1 provenType=undefined|int|string
# CHECK-NEXT: v5:{{*}}= Upcast [[second]] castType=
# CHECK-NEXT: Return v5
}

function f2 name="positionKnownAtRunTime" parameters=[{type=anything}, {type=anything}, {type=int[0, 1]}] results=[{type=undefined|int|string}] {
  b0(v0: anything, v1: anything, v2: int[0, 1]):
    v3 = NewArray v0, v1 contents=anything
    v4 = AssumeType v3 provenType=Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v5 = GetArrayElement v4, v2 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v5
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK: [[first]]: undefined|int|string = AssumeType v0 provenType=undefined|int|string
# CHECK-NEXT: [[last]]: undefined|int|string = AssumeType v1 provenType=undefined|int|string
# CHECK-NEXT: Switch v2 cases=[0] -> case [[read]]([[first]]), otherwise [[read]]([[last]])
# CHECK-NEXT: [[read]]([[element]]: undefined|int|string):
# CHECK-NEXT: v5:{{*}}= Upcast [[element]] castType=
}

function f3 name="carriedThroughAJoin" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=undefined|int|string}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewArray v0 contents=anything
    v4 = AssumeType v3 provenType=Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]>
    Jump -> next b3(v4)
  b2():
    v5 = NewArray v1 contents=anything
    v6 = AssumeType v5 provenType=Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]>
    Jump -> next b3(v6)
  b3(v7: Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]>):
    v8 = Integer
    v9 = GetArrayElement v7, v8 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v9
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK: b3({{*}}, [[carried]]: anything, {{*}}):
# CHECK: [[assumed]]: undefined|int|string = AssumeType [[carried]] provenType=undefined|int|string
# CHECK-NEXT: v9:{{*}}= Upcast [[assumed]] castType=
}

function f4 name="oneElementBehindACheck" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Check v0 expectedType=number|string
    v3 = NewArray v2, v1 contents=anything
    v4 = AssumeType v3 provenType=Array<int|string, proven, Contiguous, pristine[Storage, Names, Dense]> [isBehindChecks]
    v5 = Integer
    v6 = GetArrayElement v4, v5 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    v7 = Integer integer=1
    v8 = GetArrayElement v4, v7 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    v9 = Add v6, v8
    Return v9
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK: = AssumeType v2 provenType=undefined|int|string [isBehindChecks]
# CHECK-NOT: NewArray
# CHECK: = AssumeType v1 provenType=undefined|int|string
# CHECK-NEXT: v8:
}
