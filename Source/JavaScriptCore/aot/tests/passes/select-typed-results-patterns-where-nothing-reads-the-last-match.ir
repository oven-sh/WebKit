# No part of the program reads what the last match left in RegExp: patterns and formats are shared regexp literals, each at a position of its own
# FORM: AsRead
# OPTIONS: only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults
# RUN(POSITION): pipeline SelectTypedResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=string validation=[{shape=Primitive{} type=string rules=[Pattern{source="^a"}, Format{format=Uuid}]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = ToString v1
    v4 = CallDirect v3 function=f2
    Return v4
}
function f1 name="validates" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=BunBundleValidate
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
function f2 name="parses" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
# CHECK: [[pattern]]:{{*}}= SharedRegExpLiteral pattern="^a"
# CHECK-NEXT: = CallBuiltin [[pattern]], {{*}} overload=RegExpPrototypeTest/0
# CHECK: [[format]]:{{*}}= SharedRegExpLiteral pattern="^([0-9a-fA-F]{8}-
# CHECK-NEXT: = CallBuiltin [[format]], {{*}} overload=RegExpPrototypeTest/0
# CHECK-NOT: CompilerHelpersHoldsRule
# POSITION: = SharedRegExpLiteral pattern="^a" @[[positionOfFirstLiteral]]
# POSITION-NEXT: = CallBuiltin
# POSITION-NOT: = SharedRegExpLiteral pattern="^([0-9a-fA-F]{8}-{{*}} @[[positionOfFirstLiteral]]
