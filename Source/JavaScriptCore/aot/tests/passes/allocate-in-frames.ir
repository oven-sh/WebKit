# Closures, environments and objects that do not escape their activation are allocated in the machine frame
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass
# OPTIONS: only-passes=ComputeEffectSummaries,ChooseCallingConventions,AllocateInFrames
# STATISTIC: ClosuresInFrames = 6
# STATISTIC: EnvironmentsInFrames = 2
# STATISTIC: EnvironmentsMaterializedLate = 2
# STATISTIC: EnvironmentsOnHeap = 2
# STATISTIC: ObjectsInFrames = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="callbackWithEnvironment" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="environmentPassedAsCapture" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Environment name="materializedLate" fields=[{key="x" declared={type=anything}}]
layout L3 kind=Environment name="capturedByHeapClosureOnEveryPath" fields=[{key="x" declared={type=anything}}]
layout L4 name="Options" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L5 kind=Environment name="frameClosureUsedAfterCopy" fields=[{key="x" declared={type=anything}}]
layout L6 kind=Environment name="heapClosureCreatedInLoop" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    v3 = CallDirect function=f1
    v4 = CallDirect v1 function=f2
    v5 = CallDirect v1 function=f3
    v6 = CallDirect function=f4
    v7 = CallDirect v1, v2 function=f5
    v8 = CallDirect function=f6
    v9 = CallDirect function=f7
    v10 = CallDirect function=f8
    v11 = CallDirect v2 function=f9
    v12 = CallDirect function=f10
    v13 = CallDirect v1 function=f11
    v14 = CallDirect v1 function=f12
    v15 = CallDirect v1 function=f13
    v16 = CallDirect v1 function=f14
    v17 = CallDirect v1, v2 function=f15
    v18 = CallDirect v1, v2 function=f16
    v19 = CallDirect function=f36
    Return
}

# CHECK: L0 only in frames
# CHECK-NEXT: L1 only in frames
# CHECK-NEXT: L2 may be in a frame
# CHECK-NEXT: L4 may be in a frame
# CHECK-NEXT: L6 may be in a frame

function f1 name="callbackPassedDown" results=[{type=anything}] {
    v0 = NewClosure function=f20
    v1 = CallDirect v0 function=f17
    Return v1
# CHECK: NewClosure {{*}}storage=Frame
}

function f2 name="callbackWithEnvironment" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f21
    v3 = CallDirect v2 function=f17
    Return v3
# CHECK: NewObject {{*}}storage=Frame
# CHECK: NewClosure {{*}}storage=Frame
}

function f3 name="environmentPassedAsCapture" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = CallDirect v1 function=f22
    Return v2
# CHECK: NewObject {{*}}storage=Frame
}

function f4 name="closureCapturedByFrameClosure" results=[{type=anything}] {
    v0 = NewClosure function=f23
    v1 = NewClosure v0 function=f24
    v2 = CallDirect v1 function=f17
    Return v2
# CHECK: function=f23 {{*}}storage=Frame
# CHECK: function=f24 {{*}}storage=Frame
}

function f5 name="materializedLate" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L2 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewClosure v2 function=f25
    v4 = Call v0, -, v0, v0, v3
    Return v4
  b2():
    v5 = GetEnvironmentField v2 layout=L2 field=0
    Return v5
# CHECK: [[lateCell]]:{{*}}= NewObject {{*}}storage=FrameUntilMaterialized
# CHECK: b1():
# CHECK: [[heapCopy]]:{{*}}= MaterializeEnvironment [[lateCell]] layout=L2
# CHECK: NewClosure [[heapCopy]] function=f25
# CHECK-NOT: storage=Frame
# CHECK-NOT: MaterializeEnvironment
}

function f6 name="returned" results=[{type=anything}] {
    v0 = NewClosure function=f26
    Return v0
# CHECK-NOT: storage=Frame
}

function f7 name="stored" results=[{type=anything}] {
    v0 = NewClosure function=f27
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="holder" [isFreeName]
    PropSet v2, v0 key="callback" mode=Strict
    Return
# CHECK-NOT: storage=Frame
}

function f8 name="calleeRetains" results=[{type=anything}] {
    v0 = NewClosure function=f28
    v1 = CallDirect v0 function=f18
    Return v1
# CHECK-NOT: storage=Frame
}

function f9 name="liveAcrossIterations" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = NewClosure function=f29
    v5 = CallDirect v2 function=f17
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v4)
  b3():
    Return v5
# CHECK-NOT: storage=Frame
}

function f10 name="localClosureOfFunctionLeakedElsewhere" results=[{type=anything}] {
    v0 = NewClosure function=f30
    v1 = ToBoolean v0
    Return v1
# The frame is decided per site: f11 leaks another closure of the same function.
# CHECK: function=f30 {{*}}storage=Frame
}

function f11 name="sameFunctionLeaksElsewhere" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f30
    v2 = Call v0, -, v0, v0, v1
    Return v2
# CHECK-NOT: storage=Frame
}

function f12 name="capturedByHeapClosureOnEveryPath" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewClosure v1 function=f31
    v3 = Call v0, -, v0, v0, v2
    Return v3
# CHECK-NOT: storage=Frame
# CHECK-NOT: MaterializeEnvironment
}

function f13 name="recordObject" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L4 fields=[0]
    v2 = CallDirect v1 function=f19
    Return v2
# CHECK: NewObject {{*}}storage=Frame
}

function f14 name="liveAtAwait" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f32
    v2 = Await v0
    v3 = CallDirect v1 function=f17
    Return v3
}
# CHECK-LABEL: function f14 name="liveAtAwait"

function f15 name="frameClosureUsedAfterCopy" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L5 fields=[0]
    v3 = NewClosure v2 function=f33
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewClosure v2 function=f34
    v5 = Call v0, -, v0, v0, v4
    Jump -> next b2()
  b2():
    v6 = CallDirect v3 function=f17
    Return v6
# CHECK-NOT: NewObject {{*}}storage=
# CHECK: function=f33 {{*}}storage=Frame
# CHECK-NOT: MaterializeEnvironment
}

function f16 name="heapClosureCreatedInLoop" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L6 fields=[0]
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = NewClosure v2 function=f35
    v5 = Call v0, -, v0, v0, v4
    Jump -> next b1()
  b3():
    v6 = GetEnvironmentField v2 layout=L6 field=0
    Return v6
# CHECK: [[loopCell]]:{{*}}= NewObject {{*}}storage=FrameUntilMaterialized
# CHECK: Jump -> next b1([[loopCell]])
# CHECK: b1([[merged]]:
# CHECK: [[loopCopy]]:{{*}}= MaterializeEnvironment [[merged]] layout=L6
# CHECK: NewClosure [[loopCopy]] function=f35
# CHECK: Jump -> next b1([[loopCopy]])
# CHECK: GetEnvironmentField [[merged]]
}

function f17 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}

function f18 name="storesParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="holder" [isFreeName]
    PropSet v2, v0 key="callback" mode=Strict
    Return
}

function f19 name="readsOptions" parameters=[{type=L4}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}

function f20 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}

function f21 name="callback" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f22 name="callback" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}

function f23 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}

function f24 name="callback" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}

function f25 name="callback" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    Return v1
}
# REPEAT: i = 26..30

function f%(i) name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
# END REPEAT

function f31 name="callback" kind=Arrow captures=[{type=env L3}] results=[{type=anything}] {
  b0(v0: env L3):
    v1 = GetEnvironmentField v0 layout=L3 field=0
    Return v1
}

function f32 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
# REPEAT: i = 33..35; a = 5 5 6

function f%(i) name="callback" kind=Arrow captures=[{type=env L%(a)}] results=[{type=anything}] {
  b0(v0: env L%(a)):
    v1 = GetEnvironmentField v0 layout=L%(a) field=0
    Return v1
}
# END REPEAT

function f36 name="returnedByCallee" results=[{type=anything}] {
    v0 = NewClosure function=f38
    v1 = CallDirect v0 function=f37
    v2 = CallDirect v1 function=f17
    Return v2
# CHECK-NOT: storage=Frame
}

function f37 name="returnsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f38 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
# CHECK-LABEL: name="liveAtAwait" module=m0 role=CoroutineBody
# CHECK: NewClosure function=f32
# CHECK-NOT: storage=
# CHECK: AwaitBySavingFrame
