# What each kind of coroutine becomes: a ramp that keeps the id and the signature, and a body that saves its frame
# FORM: Prepared
# RUN: pass SplitCoroutines
# RUN(ABSENT): pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 3
# CHECK: outcome: Changed
# ABSENT-NOT: = Await v
# ABSENT-NOT: = Yield v
# ABSENT-NOT: InitialYield
# ABSENT-NOT: NewClosure
# ABSENT-NOT: kind=CoroutineFrame

module m0 path="main.js" displayPath="main.js"
function f0 name="awaitsOnce" kind=Arrow flags=[IsAsync] captures=[{type=number}] parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: number, v1: anything):
    v2 = Await v1 @11
    Return v2
}
# CHECK-LABEL: function f0 name="awaitsOnce"
# CHECK: kind=Arrow role=CoroutineRamp flags=[IsAsync] captures=[{type=number}] {{*}} parameters=[{type=anything}] results=[{type=Promise}]
# CHECK: creator=Coroutine{kind=AsyncFunction ramp=f0 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=2}
# CHECK-NEXT: b0(v0: number, v1: anything):
# CHECK-NEXT: [[promise]]: Promise = NewPromise
# CHECK-NEXT: [[started]]: anything = CallDirect v0, v1, [[promise]] function=f3
# CHECK-NEXT: [[returned]]: Promise = AssumeType [[started]] castType=Promise
# CHECK-NEXT: Return [[returned]]
function f1 name="yieldsOnce" flags=[IsGenerator, TakesCallee] captures=[{type=number}] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: number, v1: function, v2: anything):
    InitialYield @20
    v4 = Yield v2 @21
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    Switch v6 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v5
  b2():
    Return v5
  b3():
    Return v0
}
# CHECK-LABEL: function f1 name="yieldsOnce"
# CHECK: role=CoroutineRamp flags=[IsGenerator, TakesCallee] captures=[{type=number}] {{*}} parameters=[{type=anything}] results=[{type=Generator}]
# CHECK: creator=Coroutine{ramp=f1 body=f4 promiseParameter=3}
# CHECK-NEXT: b0(v0: number, v1: function, v2: anything):
# CHECK-NEXT: [[generator]]: Generator = NewGenerator v1 function=f1
# CHECK-NEXT: = CallDirect v0, v1, v2, [[generator]] function=f4
# CHECK-NEXT: Return [[generator]]
function f2 name="awaitsInAsyncGenerator" flags=[IsAsync, IsGenerator, TakesCallee] captures=[{type=number}] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: number, v1: function, v2: anything):
    InitialYield @30
    v4 = Await v2 @31
    Return v4
}
# CHECK-LABEL: function f2 name="awaitsInAsyncGenerator"
# CHECK: role=CoroutineRamp flags=[IsAsync, IsGenerator, TakesCallee]
# CHECK: creator=Coroutine{kind=AsyncGenerator ramp=f2 body=f5 promiseType=Promise promiseParameter=3}
# CHECK-NEXT: b0(v0: number, v1: function, v2: anything):
# CHECK-NEXT: [[asyncGenerator]]: AsyncGenerator = NewAsyncGenerator v1 function=f2
# CHECK-NEXT: = CallDirect v0, v1, v2, [[asyncGenerator]] function=f5
# CHECK-NEXT: Return [[asyncGenerator]]

# CHECK-LABEL: function f3 name="awaitsOnce"
# CHECK: kind=Arrow role=CoroutineBody flags=[IsAsync] captures=[{type=number}] {{*}} parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0 parameterMap=[{original=0}, {original=1}, {}]}
# CHECK: creator=Coroutine{kind=AsyncFunction ramp=f0 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=2}
# CHECK-NOT: capabilities=
# CHECK: b0(v0: number, v1: anything, [[driver]]: undefined|Promise):
# CHECK-NEXT: v2: anything = AwaitBySavingFrame v1, [[driver]] @11
# CHECK-NEXT: [[result]]: anything = ReturnAsyncResult [[driver]], v2
# CHECK-NEXT: Return [[result]]
# CHECK-NOT: [[result]]

# CHECK-LABEL: function f4 name="yieldsOnce"
# CHECK: role=CoroutineBody flags=[IsGenerator, TakesCallee] captures=[{type=number}] {{*}} parameters=[{type=anything}, {type=Generator}] results=[{type=anything}] derivation={source=f1 parameterMap=[{original=0}, {original=1}, {original=2}, {}]}
# CHECK: creator=Coroutine{ramp=f1 body=f4 promiseParameter=3}
# CHECK: b0(v0: number, v1: function, v2: anything, [[generatorDriver]]: Generator):
# CHECK-NEXT: [[isRunning]]: boolean = IsGeneratorRunning [[generatorDriver]] @20
# CHECK-NEXT: Branch [[isRunning]] -> taken
# CHECK: Return v5
# CHECK: Return v0
# CHECK: v4{{*}}= YieldBySavingFrame [[generatorDriver]], v2 @21
# CHECK: [[nothing]]: undefined = Undefined
# CHECK-NEXT: = YieldBySavingFrame [[generatorDriver]], [[nothing]] @20
# CHECK-NOT: ReturnAsyncResult

# CHECK-LABEL: function f5 name="awaitsInAsyncGenerator"
# CHECK: role=CoroutineBody flags=[IsAsync, IsGenerator, TakesCallee]
# CHECK: parameters=[{type=anything}, {type=AsyncGenerator}] results=[{type=anything}] derivation={source=f2
# CHECK: creator=Coroutine{kind=AsyncGenerator ramp=f2 body=f5 promiseType=Promise promiseParameter=3}
# CHECK: b0(v0: number, v1: function, v2: anything, [[asyncGeneratorDriver]]: AsyncGenerator):
# CHECK: = YieldBySavingFrame [[asyncGeneratorDriver]], {{*}} @30
# CHECK: v4: anything = AwaitBySavingFrame v2, [[asyncGeneratorDriver]] @31
# CHECK-NEXT: Return v4
# CHECK-NOT: ReturnAsyncResult
