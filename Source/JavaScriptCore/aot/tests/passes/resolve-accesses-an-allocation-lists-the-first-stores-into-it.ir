}

function f22 name="the-last-of-several-stores-under-one-name-is-listed" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject layout=L0 fields=[]
    v2 = FinishObject v1
    PropSet v2, v0 key="second"
    v4 = CallDirect v0 function=f0
    PropSet v2, v4 key="second"
    PropSet v2, v0 key="first"
    v7 = CallDirect v4 function=f0
    PropSet v2, v7 key="second"
    Return v2
# CHECK: v4: number = CallDirect v0 function=f0
# CHECK-NEXT: v7: number = CallDirect v4 function=f0
# CHECK-NEXT: v1: L0 = NewObject -, v7, v0 layout=L0 fields=[1, 0]
# CHECK-NEXT: v2: L0 = FinishObject v1
# CHECK-NEXT: Return v2
}

function f23 name="a-name-whose-earlier-store-waits-behind-the-allocation" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v2, v1 key="second"
    PropSet v2, v0 key="third"
    PropSet v2, v0 key="second"
    v6 = FinishObject v2
    Return v6
# CHECK: = NewObject -, v0, {{*}}, v0 layout=L0 fields=[0, 1, 2]
# CHECK-NEXT: PropSet v2, v1 key="second"
# CHECK-NEXT: PropSet v2, v0 key="second"
}
