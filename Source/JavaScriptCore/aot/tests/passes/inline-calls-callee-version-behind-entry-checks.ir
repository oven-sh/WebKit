# function apply(x: number, f: (x: number) => number) { .. f(x) .. }   function caller(x: any) { return apply(x, y => y + y) }
# The tests at the head of a typed function (role EntryChecks) only pass their arguments on. A caller that has not proven every argument calls the tests, and what it knows of the function behind them is lost there:
# that the typed body calls the one function that the caller passes. Such a caller takes the tests in: its call then names the typed body, which gets a copy for that function as any callee does.
# A caller that passes a function nobody knows decides as it does about any function behind tests
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: CalleeVersions = 1

module m0 path="main.ts" displayPath="main.ts"
function f0 name="double" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v0
    Return v1
}
function f1 name="apply" role=EntryChecks flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number flags=[IsExpected]}, {type=function}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] creator=EntryChecks{body=f2 fallback=f3} {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: number):
    v4 = CallDirect v3, v1 function=f2
    ReturnCall v4 requirement=Allowed
  b2() frequency=Unlikely:
    v5 = CallDirect v0, v1 function=f3
    ReturnCall v5 requirement=Allowed
}
