function f4 name="inspectedByBuiltin" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallBuiltin -, v1 overload=ArrayIsArray/0
    Return v2
}
# CHECK-LABEL: function f4
# CHECK-NEXT: v1: Heap SeenByNativeCode by v2(1)
