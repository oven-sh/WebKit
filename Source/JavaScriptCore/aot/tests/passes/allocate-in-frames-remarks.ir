function f5 name="readsObject" kind=Arrow captures=[{type=L2}] results=[{type=anything}] {
  b0(v0: L2):
    Return
}

function f6 name="returned" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
