# The remark of an allocation says why the plan leaves it on the heap, also where no use, escape or limit forced it
# FORM: Prepared
# OPTIONS: report=Allocations
# RUN: frame-plan

module m0 path="main.js" displayPath="main.js"
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L0] fieldCreation=OnlyAtConstruction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType]}
layout L1 name="FieldsCreatedLater" fields=[{key="x" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L1] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType]}
layout L2 name="DefersClosureOverObject" fields=[{key="x" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="read" declared={type=f5} flags=[IsRequired] flow={location={initialization=SetAtCreation deferral=CapturesObject deferredFunction=f5} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L2] fieldCreation=OnlyAtConstruction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType]}
layout L3 name="MayGetProperty" fields=[{key="x" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L3] fieldCreation=OnlyAtConstruction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation, StoreOfOtherType]}

function f0 name="inFrame" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = GetSlot v1 key="x" receivers=[L0] level=Proven
    Return v2
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v1: Frame
# CHECK-NEXT: remark: frame
# CHECK-NOT: cause=

function f1 name="fieldsCreatedLater" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = GetSlot v1 key="x" receivers=[L1] level=Proven
    Return v2
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v1: Heap FieldsCreatedLater
# CHECK-NEXT: remark: heap cause=FieldsCreatedLater

function f2 name="layoutDefersClosureOverObject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = GetSlot v1 key="x" receivers=[L2] level=Proven
    Return v2
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v1: Heap LayoutDefersClosures
# CHECK-NEXT: remark: heap cause=LayoutDefersClosures

function f3 name="mayGetProperty" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = GetSlot v1 key="x" receivers=[L3] level=Proven
    Return v2
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v1: Heap ChangedByUse
