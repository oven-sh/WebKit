# Two integers whose ranges do not meet are not equal. Only -0, which is a whole number, equals an integer: 0
# FORM: Prepared
# RUN: pass FoldConstants

module m0 path="main.js" displayPath="main.js"
function f0 name="outsideTheRange" parameters=[{type=int[1, 3]}] results=[{type=boolean}] {
  b0(v0: int[1, 3]):
    v1 = Integer integer=7
    v2 = StrictEq v0, v1
    Return v2
}
# CHECK-LABEL: function f0 name="outsideTheRange"
# CHECK-NOT: StrictEq
# CHECK: false = Boolean

