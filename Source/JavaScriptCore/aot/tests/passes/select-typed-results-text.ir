# JSON.parse whose result is claimed or predicted as a type with a layout opens a source and calls the parser of that type, and the original call stays on the rare path
# FORM: Prepared
# OPTIONS: report=Declines
# RUN: pass SelectTypedResults SelectTypedResults
# STATISTIC: TypedResultsSelected = 6
# STATISTIC: ParsersCreated = 2
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged
# CHECK-NEXT: decline TypedResultNotSelected f6 v2 None [0] reason=NoTarget
# CHECK-NEXT: decline TypedResultNotSelected f7 v2 None [0] reason=NoTarget
# CHECK-NEXT: decline TypedResultNotSelected f8 v3 None [0] reason=NoTarget
# CHECK-NEXT: decline TypedResultNotSelected f9 v2 None [0] reason=NoTarget
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js"
expectedresult x0 type=undefined|null|L0 layouts=[L0]
layout L0 name="User" fields=[{key="id" declared={type=number}}, {key="name" declared={type=string}}]
layout L1 name="Other" fields=[{key="z" declared={type=number}}]
variable g0 name="user" module=m0 declared={type=undefined|null|L0} initialization=Undefined

function f0 name="expectedResult" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0 expectedResult=x0
    Return v2
}
# CHECK-LABEL: function f0 name="expectedResult"
# CHECK: v1: undefined = Undefined
# CHECK-NEXT: [[open0]]: boolean = JSONSourceOpen v0
# CHECK-NEXT: Branch [[open0]] -> taken [[opened0]](| 0), notTaken
# CHECK: [[done0]](v2:{{*}}):
# CHECK-NEXT: Return v2
# CHECK: [[generic0]]() frequency=Rare:
# CHECK-NEXT: [[original0]]:{{*}}= CallBuiltin -, v0, v1 overload=JSONParse/0
# CHECK-NOT: expectedResult
# CHECK: Jump -> next [[done0]]([[original0]])
# CHECK: [[opened0]]([[source0]]: guard):
# CHECK-NEXT: [[start0]]: cursor = JSONSourceStart [[source0]]
# CHECK-NEXT: [[first0]]: cursor = JSONSkipWhitespace [[start0]]
# CHECK-NEXT: [[results0]]:{{*}}= CallDirect [[first0]] function=[[parserOfUser]]
# CHECK-NEXT: [[outcome0]]: int[0, 2] = ResultAt [[results0]]
# CHECK-NEXT: [[value0]]:{{*}}= ResultAt [[results0]] index=1
# CHECK-NEXT: [[next0]]: cursor = ResultAt [[results0]] index=2
# CHECK-NEXT: Switch [[outcome0]] cases=[1] -> case [[parsed0]](), otherwise [[abandon0]]()
# CHECK: [[parsed0]]():
# CHECK-NEXT: [[closed0]]: boolean = JSONSourceClose [[source0]], [[next0]]
# CHECK-NEXT: Branch [[closed0]] -> taken [[whole0]](), notTaken [[trailing0]]()
# CHECK: [[abandon0]]() frequency=Rare:
# CHECK-NEXT: JSONSourceAbandon [[source0]]
# CHECK-NEXT: Jump -> next [[generic0]]()
# CHECK: [[whole0]]():
# CHECK: Jump -> next [[done0]](
# CHECK: [[trailing0]]() frequency=Rare:
# CHECK-NEXT: Jump -> next [[generic0]]()

function f1 name="claimed" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Claim v2 castType=undefined|null|L0
    Return v3
}
# CHECK-LABEL: function f1 name="claimed"
# CHECK: = JSONSourceOpen v0
# CHECK: = Claim v2 castType=undefined|null|L0
# CHECK: = CallDirect {{*}} function=[[parserOfUser]]

function f2 name="storedInTypedVariable" parameters=[{type=string}] results=[{type=undefined}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Claim v2 castType=undefined|null|L0
    PutModuleVariable v3 variable=g0
    Return
}
# CHECK-LABEL: function f2 name="storedInTypedVariable"
# CHECK: = JSONSourceOpen v0
# CHECK: = CallDirect {{*}} function=[[parserOfUser]]

function f3 name="doubleCast" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Upcast v2 castType=anything
    v4 = Claim v3 castType=undefined|null|L0
    Return v4
}
# CHECK-LABEL: function f3 name="doubleCast"
# CHECK: = JSONSourceOpen v0
# CHECK: = CallDirect {{*}} function=[[parserOfUser]]

function f4 name="predicted" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Predict v2 predicted=undefined|null|L0
    Return v3
}
# CHECK-LABEL: function f4 name="predicted"
# CHECK: = JSONSourceOpen v0
# CHECK: = CallDirect {{*}} function=[[parserOfUser]]

function f5 name="claimedAsArray" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Claim v2 castType=Array<number>
    Return v3
}
# CHECK-LABEL: function f5 name="claimedAsArray"
# CHECK: = JSONSourceOpen v0
# CHECK-NOT: function=[[parserOfUser]]
# CHECK: = CallDirect {{*}} function=[[parserOfNumbers]]

function f6 name="twoDifferentClaims" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Claim v2 castType=undefined|null|L0
    v4 = Claim v2 castType=undefined|null|L1
    v5 = NewArray v3, v4 contents=anything
    Return v5
}
# CHECK-LABEL: function f6 name="twoDifferentClaims"
# CHECK: v1: undefined = Undefined
# CHECK-NEXT: v2:{{*}}= CallBuiltin -, v0, v1 overload=JSONParse/0
# CHECK-NEXT: v3:{{*}}= Claim v2 castType=undefined|null|L0

function f7 name="claimOfPrimitive" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    v3 = Claim v2 castType=string
    Return v3
}
# CHECK-LABEL: function f7 name="claimOfPrimitive"
# CHECK: v1: undefined = Undefined
# CHECK-NEXT: v2:{{*}}= CallBuiltin -, v0, v1 overload=JSONParse/0
# CHECK-NEXT: v3:{{*}}= Claim v2 castType=string

function f8 name="claimBehindBlockParameter" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string, v1: boolean):
    v2 = Undefined
    v3 = CallBuiltin -, v0, v2 overload=JSONParse/0
    Branch v1 -> taken b1(), notTaken b2(v2)
  b1():
    Jump -> next b2(v3)
  b2(v4):
    v5 = Claim v4 castType=undefined|null|L0
    Return v5
}
# CHECK-LABEL: function f8 name="claimBehindBlockParameter"
# CHECK: v2: undefined = Undefined
# CHECK-NEXT: v3:{{*}}= CallBuiltin -, v0, v2 overload=JSONParse/0
# CHECK-NEXT: Branch v1

function f9 name="noClaim" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONParse/0
    Return v2
}
# CHECK-LABEL: function f9 name="noClaim"
# CHECK: v1: undefined = Undefined
# CHECK-NEXT: v2:{{*}}= CallBuiltin -, v0, v1 overload=JSONParse/0
# CHECK-NEXT: Return v2

function f10 name="claimedInRareBlock" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string, v1: boolean):
    v2 = Undefined
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2() frequency=Rare:
    v3 = CallBuiltin -, v0, v2 overload=JSONParse/0
    v4 = Claim v3 castType=undefined|null|L0
    Return v4
}
# CHECK-LABEL: function f10 name="claimedInRareBlock"
# CHECK: b2() frequency=Rare:
# CHECK-NEXT: v3:{{*}}= CallBuiltin -, v0, v2 overload=JSONParse/0
# CHECK-NEXT: v4:{{*}}= Claim v3 castType=undefined|null|L0
# CHECK-NEXT: Return v4
# CHECK: function [[parserOfUser]] {{*}}role=Parser {{*}}parameters=[{type=cursor}] results=[{type=int[0, 2]}, {type=undefined|null|object predicted=undefined|null|L0}, {type=cursor}]
# CHECK: function [[parserOfNumbers]] {{*}}role=Parser {{*}}parameters=[{type=cursor}] results=[{type=int[0, 2]}, {type=undefined|Array<number>{{*}}}, {type=cursor}]
