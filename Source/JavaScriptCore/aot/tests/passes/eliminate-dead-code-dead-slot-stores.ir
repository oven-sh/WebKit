function f6 name="objectIsPassedToUnknownCode" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutSlot v1, -, v0 key="x" receivers=[L0] level=Proven
