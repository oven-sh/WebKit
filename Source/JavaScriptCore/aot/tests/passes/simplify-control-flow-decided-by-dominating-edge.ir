# A branch below one edge of a branch on the same condition goes the same way
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 6
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="belowTakenEdge" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b4()
  b1():
    v2 = Call v1
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    v3 = Call v1, -, v2
    Return v3
  b3():
    v4 = Call v1, -, v2, v2
    Return v4
  b4():
    Return v1
# CHECK: Branch v0 -> taken b1(), notTaken b4()
# CHECK: = Call v1
# CHECK-NEXT: = Call v1, -, v2
# CHECK-NEXT: Return v3
# CHECK-NOT: Branch
# CHECK-NOT: = Call v1, -, v2, v2
}

function f1 name="belowNotTakenEdge" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v2 = Call v1
    Branch v0 -> taken b3(), notTaken b4()
  b3():
    v3 = Call v1, -, v2
    Return v3
  b4():
    v4 = Call v1, -, v2, v2
    Return v4
# CHECK: Branch v0 -> taken b1(), notTaken b2()
# CHECK: = Call v1
# CHECK-NEXT: = Call v1, -, v2, v2
# CHECK-NEXT: Return v4
# CHECK-NOT: Branch
# CHECK-NOT: Return v3
}

function f2 name="farBelowTakenEdge" parameters=[{type=anything}, {type=boolean}, {type=function}] results=[{type=anything}] {
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(), notTaken b7()
  b1():
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = Call v2
    Jump -> next b4()
  b3():
    v5 = Call v2, -, v0
    Jump -> next b4()
  b4():
    Branch v3 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v1
  b7():
    Return v2
# CHECK: Branch v3 -> taken b1(), notTaken b7()
# CHECK: Branch v1 -> taken b2(), notTaken b3()
# CHECK: b4():
# CHECK-NEXT: Return v0
# CHECK-NOT: Branch
# CHECK-NOT: Return v1
}

function f3 name="conditionThroughNegation" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    v2 = LogicalNot v0
    Branch v2 -> taken b1(), notTaken b4()
  b1():
    v3 = Call v1
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v3
  b3():
    Return v1
  b4():
    Return v0
# CHECK: = Call v1
# CHECK-NEXT: Return v3
# CHECK-NOT: Return v1
}

function f4 name="belowBothEdges" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Call v1
    Jump -> next b3()
  b2():
    v3 = Call v1, -, v1
    Jump -> next b3()
  b3():
    Branch v0 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
# CHECK: b3():
# CHECK-NEXT: Branch v0 -> taken b4(), notTaken b5()
}

function f5 name="edgeIsOneOfTwoIntoBlock" parameters=[{type=boolean}, {type=boolean}, {type=function}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v2
    Branch v0 -> taken b3(), notTaken b6()
  b2():
    v4 = Call v2, -, v2
    Jump -> next b3()
  b3():
    Branch v0 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
  b6():
    Return v2
# CHECK: b3():
# CHECK-NEXT: Branch v0 -> taken b4(), notTaken b5()
}

function f6 name="anotherCondition" parameters=[{type=boolean}, {type=boolean}, {type=function}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b4()
  b1():
    v3 = Call v2
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Return v3
  b3():
    Return v2
  b4():
    Return v0
# CHECK: = Call v2
# CHECK-NEXT: Branch v1 -> taken b2(), notTaken b3()
}

function f7 name="equalTestComputedAgain" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b4()
  b1():
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3():
    Return v1
  b4():
    Return v1
# CHECK: Branch v2 -> taken b1(), notTaken b4()
# CHECK-NOT: Branch
# CHECK: Return v0
}

function f8 name="followedEdgeNarrows" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b4()
  b1():
    v3 = Call v1
    Branch v2 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = Negate v4
    Return v5
  b3():
    Return v3
  b4():
    Return v1
# The jump passes the value as the edge narrowed it
# CHECK: = Call v1
# CHECK-NEXT: [[here183]]: fact = Specified
# CHECK-NEXT: [[number]]: number = AssumeType v0, [[here183]] provenType=number
# CHECK: = Negate [[number]]
# CHECK-NOT: Return v3
}

function f9 name="bothEdgesIntoOneBlock" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(v1), notTaken b1(v2)
  b1(v3):
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    Return v3
  b3():
    v4 = Negate v3
    Return v4
# CHECK: Branch v0 -> taken b1(v1), notTaken b1(v2)
# CHECK-NEXT: b1(v3: number):
# CHECK-NEXT: Branch v0 -> taken b2(), notTaken b3()
}
