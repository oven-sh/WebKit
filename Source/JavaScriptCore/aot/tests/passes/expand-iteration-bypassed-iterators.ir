module m0 path="main.js" displayPath="main.js"

function f0 name="mapValues" parameters=[{type=Map<string, number>}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=MapPrototypeValues/0
    v2 = IteratorOpen v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b2(), notTaken b1()
  b2():
    Return v6
