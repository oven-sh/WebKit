# A hint in a block that no way leads back to is removed; a hint in a loop that stays stays
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="noWayBack" parameters=[{type=int[0, 100]}] results=[{type=int[0, 100]}] {
    Jump -> next b1()
  b1():
    LoopHint
    Return v0
# CHECK: b1():
# CHECK-NEXT: Return v0
}

function f1 name="behindALoopThatStays" parameters=[{type=int[0, 100]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Integer integer=1
    v5 = Add v2, v4
    v6 = Less v5, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Jump -> next b1(v7)
  b3():
    LoopHint
    Return v5
# CHECK: b1(v2
# CHECK-NEXT: LoopHint
# CHECK: b3():
# CHECK-NEXT: Return v5
}

function f2 name="onlyInALoop" parameters=[{type=int[0, 100]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Integer integer=1
    v5 = Add v2, v4
    v6 = Less v5, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Jump -> next b1(v7)
  b3():
    Return v5
# CHECK: b1(v2
# CHECK-NEXT: LoopHint
}
