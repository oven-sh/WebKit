# Of an object that nobody could follow, the names it is asked for are all there is to go by: where few allocated layouts have them, the object is expected to be one of those, and a shape test guards the slots
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 name="Fiber" fields=[{key="tag" declared={type=number} flags=[IsRequired]}, {key="lanes" declared={type=number} flags=[IsRequired]}, {key="alternate" declared={type=anything} flags=[IsRequired]}, {key="length" declared={type=number} flags=[IsRequired]}, {key="constructor" declared={type=anything} flags=[IsRequired]}, {key=@@iterator declared={type=anything} flags=[IsRequired]}]
layout L1 name="Update" fields=[{key="tag" declared={type=number} flags=[IsRequired]}, {key="lanes" declared={type=number} flags=[IsRequired]}, {key="updateQueue" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Token" fields=[{key="tag" declared={type=number} flags=[IsRequired]}, {key="tokenText" declared={type=string} flags=[IsRequired]}]
layout L3 name="Mark" fields=[{key="tag" declared={type=number} flags=[IsRequired]}]
layout L4 name="Note" fields=[{key="tag" declared={type=number} flags=[IsRequired]}]
layout L5 name="NeverMade" fields=[{key="alternate" declared={type=anything} flags=[IsRequired]}, {key="ghost" declared={type=number} flags=[IsRequired]}] flow={allocation=NeverAllocated}
layout L6 kind=Instance name="Scanner" constructor=f12 fields=[{key="pos" declared={type=number} flags=[IsRequired]}] flow={baseState=None}
layout L7 kind=Instance name="DeepScanner" predictedBase=L6 constructor=f13 flags=[HasHeritage] flow={baseState=Layout base=L6}
layout L8 kind=Instance name="WideScanner" predictedBase=L6 constructor=f14 flags=[HasHeritage] flow={baseState=Layout base=L6}
layout L9 name="Link" fields=[{key="href" declared={type=string} flags=[IsRequired]}]

function f0 name="oneLayoutHasTheName" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="updateQueue"
    Return v1
}
