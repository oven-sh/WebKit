# CHECK-NEXT: = PropGet v0 key="length"
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f1 name="in-an-unlikely-block" parameters=[{type=string|Array<number>}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string|Array<number>, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return
  b2() frequency=Unlikely:
    v2 = PropGet v0 key="length"
    Return v2
}
