# An access in a rare block is not split: generic copies live there, and a split would only add bytes
# FORM: Prepared
# RUN: pass SplitUnions
# STATISTIC: UnionsSplit = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="in-a-rare-block" parameters=[{type=string|Array<number>}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string|Array<number>, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return
  b2() frequency=Rare:
    v2 = PropGet v0 key="length"
    Return v2
}
