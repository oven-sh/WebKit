# An entrypoint takes the body of its function in where nothing else enters that body. Beside a body that a call keeps, it calls the body
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot only-passes=EstimateHeat,SummarizeForInlining,InlineCalls
# RUN: pipeline InlineCalls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = CallDirect v2 function=f1
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = PropGet v0 key="publish" [isFreeName]
    v7 = Call v6, -, v4, v5, v3
    Return
}
# The budget of code that runs once leaves the call.
# CHECK-LABEL: function f0 name="main"
# CHECK: = CallDirect v2 function=f1

function f1 name="alsoCalledByName" parameters=[{type=number}] results=[{type=number}] {
# REPEAT: i = 0..12
    v%(i+1) = Mul v%(i), v0
# END REPEAT
    Return v13
}

function f2 name="enteredThroughClosuresAlone" parameters=[{type=number}] results=[{type=number}] {
# REPEAT: i = 0..12
    v%(i+1) = Mul v%(i), v0
# END REPEAT
    Return v13
}
# CHECK-LABEL: name="alsoCalledByName" module=m0 role=GenericEntrypoint
# CHECK-NOT: = Mul
# CHECK: = CallDirect {{*}} function=f1
# CHECK-LABEL: name="enteredThroughClosuresAlone" module=m0 role=GenericEntrypoint
# CHECK-NOT: = CallDirect
# CHECK-COUNT-13: = Mul
