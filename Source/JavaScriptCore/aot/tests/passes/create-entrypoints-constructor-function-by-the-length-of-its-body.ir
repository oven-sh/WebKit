# Whether a constructor function is short enough for a second generic entrypoint goes by the operations of its body as it was written. How much text it takes, with its blanks and comments, does not count.
# FORM: Prepared
# RUN: pass CreateEntrypoints
# STATISTIC: GenericEntrypoints = 3
module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Commented" constructor=f0 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="Long" constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
variable g0 name="Commented" module=m0 declared={type=anything} initialization=Function function=f0
variable g1 name="Long" module=m0 declared={type=anything} initialization=Function function=f1
function f0 name="Commented" text={start=0 end=100000} flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
    PropSet v0, v1 key="x"
    Return v1
}
function f1 name="Long" text={start=100000 end=100010} flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
