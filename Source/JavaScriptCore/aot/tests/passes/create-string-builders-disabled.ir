# With the pass switched off a string that a loop appends to stays a string
# FORM: Prepared
# OPTIONS: disable=pass:CreateStringBuilders
# RUN: pass CreateStringBuilders
# STATISTIC: StringBuildersCreated = 0
# STATISTIC: CreateStringBuildersChanges = 0
# CHECK: outcome: Unchanged
# CHECK-NOT: StringBuilder

module m0 path="main.js" displayPath="main.js"
function f0 name="appendsInLoop" parameters=[{type=string}, {type=number}] results=[{type=string}] {
    v2 = String string=""
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v0
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    Return v4
}
# CHECK: b1(v4: string, v5:
# CHECK: v8: string = Add v4, v0
