# A generic copy stays less frequent than the code it was copied from when a failing edge and a jump from the copy enter one of its blocks, and what failed on the way in is not tested there again
# FORM: Prepared
# RUN: pass PlaceTypeTests
# RUN(FREQUENCIES): frequencies
# STATISTIC: TypeTestsPlaced = 0
# CHECK: outcome: Unchanged
# FREQUENCIES: b3 frequency: Normal
# FREQUENCIES-NEXT: b4 frequency: Unlikely
# FREQUENCIES-NEXT: b5 frequency: Unlikely

module m0 path="main.js" displayPath="main.js"
function f0 name="testedMemberCall" parameters=[{type=anything predicted=Array<number>}, {type=function}] results=[{type=anything}] {
  b0(v0: anything ~ Array<number>, v1: function):
    v2 = TypeTest v0 testedType=Array<number>
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3):
    v4 = IsPristine v3 builtinClass=Array aspects=[Names]
    Branch v4 -> taken b2(), notTaken b4()
  b2():
    v5 = Builtin builtin=ArrayPrototypeFilter
    v6 = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
    Branch v6 -> taken b3(), notTaken b5(v5)
  b3():
    v7 = CallBuiltin v3, v1 overload=ArrayPrototypeFilter/0 [needsPristineReceiver]
    Return v7
  b4() frequency=Unlikely:
    v8 = PropGet v0 key="filter"
    Jump -> next b5(v8)
  b5(v9) frequency=Unlikely:
    v10 = Call v9, v0, v1 calleeKey="filter"
    Return v10
}
