# The counter's range is widened far below what it can hold and then shrinks by one a round. After a few rounds it stays where two paths meet, so the rounds do not run out. Each typing starts from the range that the last one left, so typing every value again gets further.
# SimplifyControlFlow removes a branch ahead of the loops. The typing behind it leaves the loops as they are, and VerifyEachPass does not compare that with a typing of every value in which a range stayed.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: function-passes RetypeValues SimplifyControlFlow RetypeValues
# STATISTIC: FunctionsTypedFromNever = 1
# STATISTIC: FunctionsTypedFromChanges = 1

module m0 path="main.js" displayPath="main.js"
variable g0 name="started" module=m0 declared={type=anything} initialization=Undefined

# CHECK: f0 SimplifyControlFlow: Changed
# CHECK-NEXT: f0 RetypeValues: Changed

function f0 name="count" parameters=[{type=boolean}, {type=i32}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v4 = Integer integer=0
    v5 = Integer integer=2
    v6 = Boolean boolean=true
    Branch v6 -> taken b1(v4), notTaken b1(v1)
  b1(v7):
    v8 = Add v7, v5
    Branch v0 -> taken b2(), notTaken b8()
  b2():
    PutModuleVariable v4 variable=g0
    Jump -> next b3(v4)
  b3(v10):
    LoopHint
    v12 = Less v10, v5
    Branch v12 -> taken b4(| 0), notTaken b8()
  b4(v13):
    Jump -> next b5(v13)
  b5(v14):
    LoopHint
    Branch v2 -> taken b6(), notTaken b7(v14)
  b6():
    v16 = BitAnd v14, v1
    v17 = Decrement v16
    Branch v3 -> taken b5(v17), notTaken b7(v17)
  b7(v18):
    v19 = Increment v18
    Jump -> next b3(v19)
  b8():
    Return v8
# CHECK: v8: 2 = Add
# CHECK: b3(v10: int[-9007199254740965, 2147483647] ~ int[-9007199254740952, 2147483647]):
# CHECK: b5(v14: int[-9007199254740966, 2147483646] ~ int[-9007199254740953, 2147483646]):
# CHECK: v17: int[-2147483649, 2147483646] = Decrement v16
}
