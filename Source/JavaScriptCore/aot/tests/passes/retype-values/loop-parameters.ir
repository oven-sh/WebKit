# A loop parameter narrows when what flows into the loop does, whether the loop passes it on, swaps it with another or replaces it
# FORM: Prepared
# RUN: pass SimplifyControlFlow RetypeValues

module m0 path="main.js" displayPath="main.js"

function f0 name="replacedInLoop" parameters=[{type=i32}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v3 = Boolean boolean=false
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v4):
    LoopHint
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    v6 = Integer integer=7
    Jump -> next b3(v6)
  b5():
    Return v4
# CHECK: b3(v4: i32):
# CHECK-NEXT: LoopHint
}

function f1 name="loopCarried" parameters=[{type=i32}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v3 = Boolean boolean=false
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v4):
    LoopHint
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b3(v4)
  b5():
    Return v4
# CHECK: b3(v4: i32):
# CHECK-NEXT: LoopHint
}

function f2 name="parametersFeedEachOther" parameters=[{type=string}, {type=string}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v4 = Boolean boolean=false
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3, v3)
  b2():
    Jump -> next b3(v0, v1)
  b3(v5, v6):
    LoopHint
    Branch v2 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b3(v6, v5)
  b5():
    Return v5
# CHECK: b3(v5: string, v6: string):
# CHECK-NEXT: LoopHint
}

function f3 name="anythingStoredInLoop" parameters=[{type=i32}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v3 = Boolean boolean=false
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v4):
    LoopHint
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b3(v2)
  b5():
    Return v4
# CHECK: b3(v4: anything):
# CHECK-NEXT: LoopHint
}
