# A loop stands between the stores that fill the fields of birth: behind the last of them the run time looks
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass FinishBirths
# STATISTIC: BirthsFinished = 0
# STATISTIC: BirthsLeftToRunTime = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Reply" fields=[{key="raw" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="log" declared={type=anything} flow={occupancy=FilledAtBirth}}] flags=[IsConstructorFunction]

function f0 name="loopBetweenTheStores" flags=[HasThis] thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    v2 = Undefined
    v3 = TypeTest v0 testedType=L0
    Branch v3 -> taken b1(| 0), notTaken b7()
  b1(v4: L0):
    v5 = HasNoFieldOutsideSlot v4
    Branch v5 -> taken b2(| 0), notTaken b7()
  b2(v6):
    PutSlotOrAdd v4, v6, v1 key="raw" receivers=[L0] level=Expected
    Jump -> next b3()
  b3():
    LoopHint
    v9 = ToBoolean v1
    Branch v9 -> taken b3(), notTaken b4()
  b4():
    v10 = HasNoFieldOutsideSlot v4
    Branch v10 -> taken b5(| 0), notTaken b6()
  b5(v11):
    PutSlotOrAdd v4, v11, v1 key="log" receivers=[L0] level=Expected
    Return v2
  b6():
    PropSet v0, v1 key="log"
    Return v2
  b7():
    PropSet v0, v1 key="raw"
    PropSet v0, v1 key="log"
    Return v2
}
# CHECK-LABEL: name="loopBetweenTheStores"
# CHECK: PutSlotOrAdd v4, v11, v1 key="log"
# CHECK-NEXT: TryFinishBirth v4
# CHECK-NEXT: Return v2

function f1 name="objectMadeInFrontOfALoop" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b1()
  b1():
    LoopHint
    v3 = ToBoolean v0
    Branch v3 -> taken b1(), notTaken b2()
  b2():
    PutSlot v1, v1, v0 key="log" receivers=[L0] level=Expected
    Return v1
}
# CHECK-LABEL: name="objectMadeInFrontOfALoop"
# CHECK: PutSlot v1, v1, v0 key="log"
# CHECK-NEXT: TryFinishBirth v1
# CHECK-NEXT: Return v1
