# Every step of a for..in gets its position: zero behind the open, one past where the last step found its key
# FORM: Prepared
# RUN: pass ExpandIteration
# RUN(TWICE): pass ExpandIteration ExpandIteration
# CHECK: outcome: Changed
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="loop" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    v8 = Undefined
    Return v8
}
# CHECK-LABEL: function f0 name="loop"
# CHECK: v2: enumerator = ForInOpen v0
# CHECK-NEXT: [[zero0]]: 0 = Integer
# CHECK-NEXT: Jump -> next b1([[zero0]])
# CHECK-NEXT: b1([[position0]]: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: v4{{*}} = ForInStep v2, v0 position=[[position0]]
# CHECK-NEXT: [[found0]]: {{*}} = ResultAt v4 index=2
# CHECK-NEXT: [[one0]]: 1 = Integer integer=1
# CHECK-NEXT: [[next0]]: {{*}} = Add [[found0]], [[one0]]
# CHECK: Jump -> next b1([[next0]])

function f1 name="nested" parameters=[{type=object}, {type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: object, v2: anything):
    v3 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = ForInStep v3, v0
    v6 = ResultAt v5 index=0
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b5(), notTaken b2()
  b2():
    v8 = ForInOpen v1
    Jump -> next b3()
  b3():
    LoopHint
    v10 = ForInStep v8, v1
    v11 = ResultAt v10 index=0
    v12 = ResultAt v10 index=1
    Branch v11 -> taken b1(), notTaken b4()
  b4():
    v13 = Call v2, -, v7, v12
    Jump -> next b3()
  b5():
    v14 = Undefined
    Return v14
}
