function f6 name="stepsWithoutLoop" parameters=[{type=object}, {type=object}] results=[{type=undefined}] {
  b0(v0: object, v1: object):
    v2 = ForInOpen v0
    v3 = ForInOpen v1
    Jump -> next b2()
  b1():
    v4 = ResultAt v7 index=1
    v5 = ForInStep v3, v1
    v6 = ResultAt v5 index=0
    Jump -> next b3()
  b2():
    v7 = ForInStep v2, v0
    v8 = ResultAt v7 index=0
    Branch v8 -> taken b3(), notTaken b1()
  b3():
    v9 = ResultAt v7 index=1
    v10 = ForInStep v3, v1
    v11 = Undefined
    Return v11
}
# CHECK-LABEL: function f6 name="stepsWithoutLoop"
# CHECK: v2: enumerator = ForInOpen v0
# CHECK-NEXT: [[firstZero]]: 0 = Integer
# CHECK-NEXT: v3: enumerator = ForInOpen v1
# CHECK-NEXT: [[secondZero]]: 0 = Integer
# CHECK: v5{{*}} = ForInStep v3, v1 position=[[secondZero]]
# CHECK: [[afterStep]]: {{*}} = Add
# CHECK: Jump -> next b3([[afterStep]])
# CHECK: v7{{*}} = ForInStep v2, v0 position=[[firstZero]]
# CHECK: Branch v8 -> taken b3([[secondZero]]), notTaken b1()
# CHECK: b3([[merged]]: {{*}}):
# CHECK: v10{{*}} = ForInStep v3, v1 position=[[merged]]
