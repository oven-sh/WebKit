# CHECK: = ForInStep v3, v0 position=[[outerPosition]]
# CHECK-NEXT: [[outerFound]]: {{*}} = ResultAt v5 index=2
# CHECK: [[outerNext]]: {{*}} = Add [[outerFound]],
# CHECK: v8: enumerator = ForInOpen v1
# CHECK-NEXT: [[innerZero]]: 0 = Integer
# CHECK-NEXT: Jump -> next b3([[innerZero]])
# CHECK-NEXT: b3([[innerPosition]]: {{*}}):
# CHECK: = ForInStep v8, v1 position=[[innerPosition]]
# CHECK-NEXT: [[innerFound]]: {{*}} = ResultAt v10 index=2
# CHECK: [[innerNext]]: {{*}} = Add [[innerFound]],
# CHECK: Branch v11 -> taken b1([[outerNext]]), notTaken b4()
# CHECK: Jump -> next b3([[innerNext]])

function f2 name="stepInTwoBlocks" parameters=[{type=object}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: object, v1: boolean):
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    Branch v5 -> taken b4(), notTaken b1()
  b3():
    v6 = ForInStep v2, v0
    v7 = ResultAt v6 index=0
    Branch v7 -> taken b4(), notTaken b1()
  b4():
    v8 = Undefined
    Return v8
}
