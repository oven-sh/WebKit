function f3 name="continueInBody" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: anything):
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b4(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b1(), notTaken b3()
  b3():
    v9 = Call v1, -, v6
    Jump -> next b1()
  b4():
    v10 = Undefined
    Return v10
}
