# CHECK: b1([[position3]]: {{*}}):
# CHECK: = ForInStep v2, v0 position=[[position3]]
# CHECK: [[next3]]: {{*}} = Add
# CHECK: Branch v8 -> taken b1([[next3]]), notTaken b3()
# CHECK: Jump -> next b1([[next3]])

function f4 name="underHandler" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: anything) handler=b4():
    v2 = ForInOpen v0
    Jump -> next b1()
  b1() handler=b4():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    Jump -> next b1()
