# `let all = {}; all = { ...all, [key]: value }`: a dictionary that never gets a property has none to copy, so the copy is a new dictionary and the first one is dead.
# FORM: Prepared optimizing
# RUN: pass ExpandOwnKeys EliminateDeadCode

module m0 path="main.js" displayPath="main.js"

function f0 name="neverFilled" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewDictionary
    v2 = CopyObject v1
    PropDefine v2, v0 key="a"
    Return v2
# CHECK: b0(
# CHECK-NEXT: v2: object = NewDictionary
# CHECK-NEXT: PropDefine v2, v0 key="a"
# CHECK-NOT: CopyObject
}

