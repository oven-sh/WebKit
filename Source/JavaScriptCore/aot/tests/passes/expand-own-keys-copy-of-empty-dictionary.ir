  b0(v0: anything):
    v1 = NewDictionary
    PropDefine v1, v0 key="a"
    v3 = CopyObject v1
    Return v3
# CHECK: v3: object = CopyObject v1
}

function f2 name="filledAfterTheCopy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewDictionary
    v2 = CopyObject v1
    PropDefine v1, v0 key="a"
    v4 = CopyObject v1
