# A field that every receiver of the read stores at most once, at creation, has the same value on both sides of unknown code
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Config" fields=[{key="rate" declared={type=number} flags=[IsRequired] flow={location={stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled}}] flow={impossibleMutations=[DeleteField, RedefineProperty]}
layout L1 name="Meter" fields=[{key="rate" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={impossibleMutations=[DeleteField, RedefineProperty]}
layout L2 name="Preset" fields=[{key="rate" declared={type=number} flags=[IsRequired] flow={location={stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled}}] flow={impossibleMutations=[DeleteField, RedefineProperty]}

function f0 name="storedAtCreationOnly" parameters=[{type=L0}, {type=anything}] results=[{type=number}] {
  b0(v0: L0, v1: anything):
    v2 = GetSlot v0 key="rate" receivers=[L0] level=Proven
    v3 = Call v1
    v4 = GetSlot v0 key="rate" receivers=[L0] level=Proven
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f0 name="storedAtCreationOnly"
# CHECK: = Call v1
# CHECK-NEXT: v4: undefined|null|number ~ number = Upcast v2
# CHECK-NOT: GetSlot

function f1 name="storedAgain" parameters=[{type=L1}, {type=anything}] results=[{type=number}] {
  b0(v0: L1, v1: anything):
    v2 = GetSlot v0 key="rate" receivers=[L1] level=Proven
    v3 = Call v1
    v4 = GetSlot v0 key="rate" receivers=[L1] level=Proven
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f1 name="storedAgain"
# CHECK: = Call v1
# CHECK-NEXT: v4: undefined|null|number ~ number = GetSlot v0

function f2 name="everyReceiverIsStable" parameters=[{type=L0|L2}, {type=anything}] results=[{type=number}] {
  b0(v0: L0|L2, v1: anything):
    v2 = GetSlot v0 key="rate" receivers=[L0, L2] level=Proven
    v3 = Call v1
    v4 = GetSlot v0 key="rate" receivers=[L0, L2] level=Proven
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f2 name="everyReceiverIsStable"
# CHECK: = Call v1
# CHECK-NEXT: v4: undefined|null|number ~ number = Upcast v2

function f3 name="oneReceiverIsStoredAgain" parameters=[{type=L0|L1}, {type=anything}] results=[{type=number}] {
  b0(v0: L0|L1, v1: anything):
    v2 = GetSlot v0 key="rate" receivers=[L0, L1] level=Proven
    v3 = Call v1
    v4 = GetSlot v0 key="rate" receivers=[L0, L1] level=Proven
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f3 name="oneReceiverIsStoredAgain"
# CHECK: = Call v1
# CHECK-NEXT: v4: undefined|null|number ~ number = GetSlot v0

function f4 name="oneObjectReadAsEitherReceiver" parameters=[{type=L0|L1}, {type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0|L1, v1: anything, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Check v0 castType=L0
    v4 = GetSlot v3 key="rate" receivers=[L0] level=Proven
    v5 = Call v1
    v6 = GetSlot v3 key="rate" receivers=[L0] level=Proven
    v7 = Add v4, v6
    Return v7
  b2():
    v8 = Check v0 castType=L1
    v9 = GetSlot v8 key="rate" receivers=[L1] level=Proven
    v10 = Call v1
    v11 = GetSlot v8 key="rate" receivers=[L1] level=Proven
    v12 = Add v9, v11
    Return v12
}
# CHECK-LABEL: function f4 name="oneObjectReadAsEitherReceiver"
# CHECK: v5: anything = Call v1
# CHECK-NEXT: v6: undefined|null|number ~ number = Upcast v4
# CHECK: v10: anything = Call v1
# CHECK-NEXT: v11: undefined|null|number ~ number = GetSlot v8

function f5 name="storesRate" parameters=[{type=L1}, {type=number}] results=[{type=undefined}] {
  b0(v0: L1, v1: number):
    PutSlot v0, -, v1 key="rate" receivers=[L1] level=Proven
    Return
}
# CHECK-LABEL: function f5 name="storesRate"
