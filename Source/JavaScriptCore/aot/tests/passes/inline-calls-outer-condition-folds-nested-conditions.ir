# A constant argument that decides an outer condition also folds the code under the conditions nested inside it
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# LOSS: MaxInlineHeadBytes
# STATISTIC: InlineDecisionInline = 3
# STATISTIC: InlineDecisionCostExceedsBenefit = 1

module m0 path="main.js" displayPath="main.js"

function f0 name="nested" parameters=[{type=number}, {type=boolean}, {type=boolean}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b4()
  b1():
    v3 = Mul v0, v0
    Branch v2 -> taken b2(), notTaken b3()
  b2():
# REPEAT: i = 3..34
    v%(i+1) = Mul v%(i), v0
# END REPEAT
    Return v35
  b3():
    Return v3
  b4():
    Return v0
}

function f1 name="outerIsFalse" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
    v2 = Boolean
    v3 = CallDirect v0, v2, v1 function=f0
    Return v3
}
# CHECK-LABEL: function f1 name="outerIsFalse"
# CHECK-NOT: CallDirect

function f2 name="nothingIsKnown" parameters=[{type=number}, {type=boolean}, {type=boolean}] results=[{type=number}] {
    v3 = CallDirect v0, v1, v2 function=f0
    Return v3
}
# CHECK-LABEL: function f2 name="nothingIsKnown"
# CHECK: = CallDirect

function f3 name="innerIsFalse" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
    v2 = Boolean
    v3 = CallDirect v0, v1, v2 function=f0
    Return v3
}
# CHECK-LABEL: function f3 name="innerIsFalse"
# CHECK-NOT: CallDirect

function f4 name="bothAreFalse" parameters=[{type=number}] results=[{type=number}] {
    v1 = Boolean
    v2 = CallDirect v0, v1, v1 function=f0
    Return v2
}
# CHECK-LABEL: function f4 name="bothAreFalse"
# CHECK-NOT: CallDirect
