# FORM: AsRead
# OPTIONS: report=Declines only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults
# STATISTIC: TypedResultsSelected = 3

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/library.ts" displayPath="/$bun/js/library.ts" flags=[IsLibrary]
entry module=m0
layout L0 module=m1 position=10 fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=string} flags=[IsRequired]}]
layout L1 module=m1 position=20 fields=[{key="name" declared={type=string} flags=[IsRequired]}, {key="size" declared={type=number} flags=[IsRequired]}]
layout L2 module=m0 position=30 fields=[{key="id" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=string} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = CallDirect v2 function=f1
    v4 = CallDirect v2 function=f2
    v5 = CallDirect v2 function=f3
    v6 = CallDirect v2 function=f4
    Return
}

function f1 name="everyTypeIsTheLibrarys" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L0|L1 flags=[IsExpected]}
    v4 = PropGet v3 key="name"
    Return v4
# CHECK-NOT: = CallDirect
# CHECK: overload=JSONParse/0
}

function f2 name="oneTypeIsTheApplications" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L0|L2 flags=[IsExpected]}
    v4 = PropGet v3 key="name"
    Return v4
# CHECK: = CallDirect
}

function f3 name="inACheckedFile" flags=[IsChecked] parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L0|L1 flags=[IsExpected]}
    v4 = PropGet v3 key="name"
    Return v4
# CHECK: = CallDirect
}

function f4 name="askedByTheLibrary" module=m1 parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L0|L1 flags=[IsExpected]}
    v4 = PropGet v3 key="name"
    Return v4
# CHECK: = CallDirect
}
