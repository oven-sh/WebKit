# CHECK: b1(v5: int[0, 9007199254740991]
# CHECK: b2(v6: int[0, 9007199254740991]
# CHECK: Branch v8 -> taken b3(| 0), notTaken b9(v6)
# CHECK-NEXT: b3([[typed]]: int[0, 4294967294]):
# CHECK: v9: int[1, 4294967295] = Increment [[typed]]
# CHECK: b5(v10: int[0, 9007199254740991]
# CHECK: Branch v12 -> taken b6(| 0), notTaken b9(v10)
# CHECK-NEXT: b6([[copied]]: int[0, 9007199254740990]
# CHECK: b7(v13: int[0, 9007199254740990]
# CHECK-NEXT: v14: int[1, 9007199254740991]
