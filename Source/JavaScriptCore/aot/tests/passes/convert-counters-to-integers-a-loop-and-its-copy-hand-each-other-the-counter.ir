# The shape of Array.prototype.some: a typed loop and the copy of its failed tests, which has a loop of its own. A failed test hands the counter to the middle of the copy's loop, and the way back hands it to the front of the typed one.
# Neither loop starts from an integer then, and the copy's loop, which is entered in two places, is no natural loop. Each compares the counter with an integer before it steps: the compared value goes on over the taken edge,
# and from never on all four joins hold integers. The join between the comparison with a length (at most 2 ** 53 - 1) and the step is widened to 2 ** 53 - 1, from where one step is still exact.
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="handed" parameters=[{type=int[0, 4294967295]}, {type=int[0, 9007199254740991]}, {type=boolean}, {type=boolean}] results=[{type=number}] {
  b0(v0: int[0, 4294967295], v1: int[0, 9007199254740991], v2: boolean, v3: boolean):
    v4 = Integer integer=0
    Branch v2 -> taken b1(v4), notTaken b5(v4)
  b1(v5):
    Jump -> next b2(v5)
  b2(v6):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(), notTaken b9(v6)
  b3():
    Branch v3 -> taken b4(), notTaken b7(v6)
  b4():
    v9 = Increment v6
    Jump -> next b2(v9)
  b5(v10) frequency=Unlikely:
    LoopHint
    v12 = Less v10, v1
    Branch v12 -> taken b6(), notTaken b9(v10)
  b6() frequency=Unlikely:
    Jump -> next b7(v10)
  b7(v13) frequency=Unlikely:
    v14 = Increment v13
    Branch v2 -> taken b8(), notTaken b5(v14)
  b8() frequency=Unlikely:
    Jump -> next b1(v14)
  b9(v15):
    Return v15
}
