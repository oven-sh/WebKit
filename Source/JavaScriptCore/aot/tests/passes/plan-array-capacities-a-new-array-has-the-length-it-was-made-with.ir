function f7 name="aSecondArrayMadeLikeTheFirst" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=number}] results=[{type=anything}] {
    v3 = NewArrayLike v0, v1
    v4 = Integer integer=0
    v5 = TryPutByValDirect v3, v4, v2
    v6 = CallBuiltin v3 overload=ArrayPrototypeLength/0
    v7 = NewArrayLike v6, v3
    v8 = IsPristine v3 builtinClass=Array aspects=[Storage]
    Branch v8 -> taken b1(| 0), notTaken b3()
  b1(v9):
    v10 = HasArrayStorage v3 arrayStorage=Double
    Branch v10 -> taken b2(| 0), notTaken b3()
  b2(v11):
    v12 = AllGuards v9, v11
    v13 = HasArrayElement v3, v4, v12 arrayStorage=Double level=Expected [keyIsIntegral]
    v14 = TryPutByValDirect v7, v4, v2
    Return v13
  b3() frequency=Unlikely:
    Return v7
}
# CHECK-LABEL: function f7
# CHECK: v6: {{*}} = Upcast v0
# CHECK: v13: {{*}} = HasArrayElement v3, v4, v12, v0 arrayStorage=Double
# CHECK: v14: {{*}} = TryPutByValDirect v7, v4, v2 length=v6 arrayStorage=Double

function f8 name="aStoreThatIsNotTakenIsMadeByKeyAndTheLoopGoesOn" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=number}, {type=int[0, 100]}] results=[{type=anything}] {
    v4 = NewArrayLike v0, v1
    v5 = Integer integer=0
    Jump -> next b1(v5)
  b1(v6: int[0, 100]):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b2(), notTaken b4()
  b2():
    v9 = TryPutByValDirect v4, v6, v2
    Branch v9 -> taken b1(v3), notTaken b3()
  b3() frequency=Rare:
    ElemSet v4, v6, v2 [keyIsIntegral]
    Jump -> next b1(v3)
  b4():
    Return v4
}
# CHECK-LABEL: function f8
# CHECK: v9: {{*}} = TryPutByValDirect v4, v6, v2 length=v0 arrayStorage=Double

