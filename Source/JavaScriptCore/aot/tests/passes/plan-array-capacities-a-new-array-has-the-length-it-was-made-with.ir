    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v5 = NewArrayLike v1, v3
    Jump -> next b3(v5)
  b2():
    v6 = NewArrayLike v2, v3
    Jump -> next b3(v6)
  b3(v7):
    v8 = Integer integer=0
    v9 = TryPutByValDirect v7, v8, v4
