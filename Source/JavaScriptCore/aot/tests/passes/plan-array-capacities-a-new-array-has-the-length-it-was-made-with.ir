# A new array has the length it was made with until somebody else has had it
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="filledInALoopAndMeasuredBehindIt" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=number}, {type=int[0, 100]}] results=[{type=anything}] {
    v4 = NewArrayLike v0, v1
    v5 = Integer integer=0
    Jump -> next b1(v5)
  b1(v6: int[0, 100]):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = TryPutByValDirect v4, v6, v2
    Jump -> next b1(v3)
  b3():
    v10 = CallBuiltin v4 overload=ArrayPrototypeLength/0
    v11 = Call v1, -, v10
    Return v4
}
# CHECK-LABEL: function f0
# CHECK: v9: {{*}} = TryPutByValDirect v4, v6, v2 length=v0 arrayStorage=Double
# CHECK: v10: {{*}} = Upcast v0
# CHECK-NOT: ArrayPrototypeLength

