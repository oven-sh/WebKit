function f3 name="storedInFrontOfTheCallAndMeasuredBehindIt" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=number}, {type=anything}] results=[{type=anything}] {
    v4 = NewArrayLike v0, v1
    v5 = Integer integer=0
    v6 = TryPutByValDirect v4, v5, v2
    v7 = CallBuiltin v4 overload=ArrayPrototypeLength/0
    v8 = Call v3, -, v4
    v9 = CallBuiltin v4 overload=ArrayPrototypeLength/0
    v10 = Add v7, v9
    Return v10
}
