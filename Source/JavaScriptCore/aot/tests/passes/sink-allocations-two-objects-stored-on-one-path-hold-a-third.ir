# Two objects that are stored in a holder on one path alone hold a third: neither is reached through the holder alone, so they are not built in the arms of the switch on its tag
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="Holder" fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}, {key="c" declared={type=anything}}]
layout L1 name="Middle" fields=[{key="inner" declared={type=anything}}]
layout L2 name="Inner" fields=[{key="x" declared={type=anything}}]

function f0 name="holderBuiltBehindTheMerge" parameters=[{type=anything}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewObject -, v0 layout=L2 fields=[0]
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = NewObject -, v4 layout=L1 fields=[0]
    PutSlotOrAdd v3, v3, v5 key="b" receivers=[L0] level=Proven
    PutSlotOrAdd v3, v3, v6 key="c" receivers=[L0] level=Proven
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    Branch v2 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5() frequency=Rare:
    Return v3
# CHECK: b1():
# CHECK-NEXT: v4: L2 = NewObject -, v0 layout=L2 fields=[0]
# CHECK-NEXT: v5: L1 = NewObject -, v4 layout=L1 fields=[0]
# CHECK-NEXT: v6: L1 = NewObject -, v4 layout=L1 fields=[0]
# CHECK: Switch {{*}} cases=[1]
# CHECK: L0 = NewObject -, {{*}} layout=L0 fields=[0]
# CHECK: L0 = NewObject -, {{*}}, {{*}}, {{*}} layout=L0 fields=[0, 1, 2]
}
