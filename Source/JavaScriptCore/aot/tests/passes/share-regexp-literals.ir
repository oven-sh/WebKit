# A literal whose object nobody can observe becomes one shared object
# FORM: Prepared
# RUN: pass ShareRegExpLiterals
# STATISTIC: ShareRegExpLiteralsChanges = 6

module m0 path="main.js" displayPath="main.js"
function f0 name="test" parameters=[{type=string}] results=[{type=boolean}] {
    v1 = NewRegExp pattern="a"
    v2 = CallBuiltin v1, v0 overload=RegExpPrototypeTest/0
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f1 name="globalReplace" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a" regExpFlags=[Global]
    v2 = String string="b"
    v3 = CallBuiltin v0, v1, v2 overload=StringPrototypeReplace/0
    Return v3
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f2 name="split" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a"
    v2 = CallBuiltin v0, v1 overload=StringPrototypeSplit/2
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f3 name="globalMatch" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a" regExpFlags=[Global]
    v2 = CallBuiltin v0, v1 overload=StringPrototypeMatch/0
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f4 name="replacerFunction" parameters=[{type=string}, {type=function}] results=[{type=anything}] {
    v2 = NewRegExp pattern="a" regExpFlags=[Global]
    v3 = CallBuiltin v0, v2, v1 overload=StringPrototypeReplace/0
    Return v3
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f5 name="inspectedOnly" parameters=[{type=string}] results=[{type=boolean}] {
    v1 = NewRegExp pattern="a"
    v2 = TypeTest v1 testedType=RegExp
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f6 name="globalExec" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a" regExpFlags=[Global]
    v2 = CallBuiltin v1, v0 overload=RegExpPrototypeExec/0
    Return v2
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f7 name="stickyTest" parameters=[{type=string}] results=[{type=boolean}] {
    v1 = NewRegExp pattern="a" regExpFlags=[Sticky]
    v2 = CallBuiltin v1, v0 overload=RegExpPrototypeTest/0
    Return v2
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f8 name="storedInField" parameters=[{type=string}, {type=object}] results=[{type=undefined}] {
    v2 = NewRegExp pattern="a"
    PropSet v1, v2 key="re" mode=Strict
    Return
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f9 name="returned" parameters=[{type=string}] results=[{type=RegExp}] {
    v1 = NewRegExp pattern="a"
    Return v1
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f10 name="passedToCall" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = NewRegExp pattern="a"
    v3 = Call v1, -, v2
    Return v3
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f11 name="lastIndexRead" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a"
    v2 = CallBuiltin v1 overload=RegExpPrototypeLastIndex/0
    Return v2
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f12 name="lastIndexWritten" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = NewRegExp pattern="a"
    v2 = Integer integer=0
    v3 = CallBuiltin v1, v2 overload=RegExpPrototypeLastIndex/1
    Return
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f13 name="carriedAroundLoop" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = Null
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = NewRegExp pattern="a"
    v5 = StrictEq v2, v4
    Branch v5 -> taken b2(), notTaken b1(v4)
  b2():
    Return
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f14 name="fallbackStillReachable" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a"
    v2 = IsPristine v1 builtinClass=RegExp aspects=[Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallBuiltin v1, v0 overload=RegExpPrototypeTest/0
    Jump -> next b3(v4)
  b2() frequency=Unlikely:
    v5 = PropGet v1 key="test"
    v6 = Call v5, v1, v0 calleeKey="test"
    Jump -> next b3(v6)
  b3(v7):
    Return v7
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f15 name="matchAll" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a"
    v2 = PropGet v0 key="matchAll"
    v3 = Call v2, v0, v1 calleeKey="matchAll"
    Return v3
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}
