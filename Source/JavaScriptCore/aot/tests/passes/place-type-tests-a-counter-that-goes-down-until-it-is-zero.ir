# `while (i--)`: a counter that goes down by one until it is zero starts at zero or above, or the loop does not end. It is asked for that and not for any int32: then that it is not zero says that it is above zero, which bounds it.
# FORM: Prepared
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
function f0 name="downByOneUntilZero" parameters=[{type=i32 flags=[IsExpected]}] results=[{type=i32}] {
  b0(v0: anything ~ i32):
    v1 = Integer integer=0
    Jump -> next b1(v1, v0)
  b1(v2: i32, v3: anything ~ i32):
    LoopHint
    v5: number|bigint ~ i32 = ToNumeric v3
    v6: number|bigint ~ int[-2147483649, 2147483646] = Decrement v5
    v7 = ToBoolean v5
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Integer integer=1
    v9: i32 = BitXor v2, v8
    Jump -> next b1(v9, v6)
  b3():
    Return v2
# CHECK: TypeTest {{*}} testedType=int[0, 2147483647]
}

