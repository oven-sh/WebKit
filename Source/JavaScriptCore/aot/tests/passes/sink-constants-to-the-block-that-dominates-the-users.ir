function f6 name="handlerOfTheDominatingBlockIsAUser" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
  b0(v0: boolean, v1: function):
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1() handler=b3():
    v3 = Call v1, -, v2
    Return v3
  b2():
    Return v1
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = Call v1, -, v2, v4
    Return v5
}
