# CHECK-NEXT: = Call v1, -, [[moved3]]
# CHECK: b3():
# CHECK-NEXT: = Call v1, -, [[moved3]]

function f4 name="createdInACycle" parameters=[{type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: boolean, v1: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewClosure function=f0
    Branch v0 -> taken b2(), notTaken b4()
  b2():
    v4 = Call v1, -, v3
    Branch v0 -> taken b3(), notTaken b4()
  b3():
    v5 = Call v1, -, v3
    Jump -> next b4()
  b4():
    v6 = ToBoolean v1
    Branch v6 -> taken b1(), notTaken b5()
  b5():
    v7 = Undefined
    Return v7
}
# CHECK-LABEL: function f4
# CHECK: b1():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = NewClosure
# CHECK: b2():
# CHECK-NOT: NewClosure

function f5 name="usersInBothArms" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything):
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1, -, v2
    Jump -> next b2()
  b2():
    v4 = Call v1, -, v2
    Return v4
}
