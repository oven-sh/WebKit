# CHECK: b0(
# CHECK-NEXT: = NewClosure
# CHECK: b1(
# CHECK-NOT: NewClosure

function f7 name="handlerBehindTheDominatingBlockIsAUser" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
  b0(v0: boolean, v1: function):
    v2 = NewClosure function=f0
