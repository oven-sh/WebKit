# A result that was only expected is proven once every way out of the body returns a value of the type. A caller then has nothing left to test, the arm for a result of another type goes, and its own result is proven in turn.
# Where numbers, booleans, undefined and null are all that a body returns, and a register holds those in another form than the declared type, the result takes the type of what is returned.
# FORM: Prepared
# RUN: pass ProveResults
# STATISTIC: ResultsProvenByReturns = 9
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="returnsNumbersOnly" parameters=[{type=number}, {type=boolean}] results=[{type=number flags=[IsExpected]}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Add v0, v0
    Return v2
  b2():
    Return v0
}
# CHECK-LABEL: function f0 name="returnsNumbersOnly"{{*}}results=[{type=number}] 

function f1 name="testsWhatItIsAnswered" parameters=[{type=number}, {type=boolean}] results=[{type=number flags=[IsExpected]}] {
    v2 = CallDirect v0, v1 function=f0
    v3 = TypeTest v2 testedType=number
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = Mul v4, v4
    Return v5
  b2(v6):
    Return v6
}
# CHECK-LABEL: function f1 name="testsWhatItIsAnswered"{{*}}results=[{type=number}] 
# CHECK-NEXT: b0(
# CHECK-NEXT: [[answer]]: number = CallDirect v0, v1 function=f0
# CHECK-NOT: Branch
# CHECK: = Mul
# CHECK-NOT: Branch
# CHECK: Return

function f2 name="mayReturnUndefined" parameters=[{type=number}, {type=boolean}] results=[{type=number flags=[IsExpected]}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v2 = Undefined
    Return v2
}
# CHECK-LABEL: function f2 name="mayReturnUndefined"{{*}}results=[{type=undefined|number}] 

function f3 name="handsOnWhatNobodyKnows" parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] {
    v1 = Call v0, -
    ReturnCall v1 requirement=Allowed
}
# CHECK-LABEL: function f3 name="handsOnWhatNobodyKnows"{{*}}results=[{type=number flags=[IsExpected]}] 

function f4 name="callsAValueThatCanOnlyBeOneFunction" parameters=[{type=f0}, {type=number}, {type=boolean}] results=[{type=anything}] {
    v3 = Call v0, -, v1, v2
    Return v3
}
# CHECK-LABEL: function f4 name="callsAValueThatCanOnlyBeOneFunction"{{*}}results=[{type=number}] 
# CHECK: : number = Call v0, -, v1, v2

function f5 name="returnsIntegersWhereNumbersAreDeclared" parameters=[{type=i32}, {type=i32}] results=[{type=number}] {
    v2 = BitAnd v0, v1
    Return v2
}
# CHECK-LABEL: function f5 name="returnsIntegersWhereNumbersAreDeclared"{{*}}results=[{type=i32}] 

function f6 name="handsOnAnInteger" parameters=[{type=i32}] results=[{type=number}] {
    v1 = CallDirect v0, v0 function=f5
    ReturnCall v1 requirement=Required
}
# CHECK-LABEL: function f6 name="handsOnAnInteger"{{*}}results=[{type=i32}] 
# CHECK: : i32 = CallDirect v0, v0 function=f5

function f7 name="countsDownAndCallsItself" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    v3 = Integer integer=1
    v4 = BitXor v0, v3
    v5 = CallDirect v4 function=f7
    ReturnCall v5 requirement=Required
}
# CHECK-LABEL: function f7 name="countsDownAndCallsItself"{{*}}results=[{type=0}] 

# A tail call that is a jump stays one. The caller also returns a fraction, so its result stays a double, and so does the result of the function that it enters by a jump.
function f8 name="isEnteredByAJumpFromANumber" parameters=[{type=i32}] results=[{type=number}] {
    v1 = BitNot v0
    Return v1
}
# CHECK-LABEL: function f8 name="isEnteredByAJumpFromANumber"{{*}}results=[{type=number}] 

function f9 name="returnsAFractionOrJumps" parameters=[{type=i32}, {type=boolean}, {type=number}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2():
    v3 = CallDirect v0 function=f8
    ReturnCall v3 requirement=Required
}
# CHECK-LABEL: function f9 name="returnsAFractionOrJumps"{{*}}results=[{type=number}] 

# A number has the same bits where undefined may come in its place: this jump stays one.
function f10 name="returnsANumber" parameters=[{type=number}] results=[{type=number}] {
    v1 = Add v0, v0
    Return v1
}
# CHECK-LABEL: function f10 name="returnsANumber"{{*}}results=[{type=number}] 

function f11 name="returnsUndefinedOrJumps" parameters=[{type=number}, {type=boolean}] results=[{type=number flags=[IsExpected]}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Undefined
    Return v2
  b2():
    v3 = CallDirect v0 function=f10
    ReturnCall v3 requirement=Required
}
# CHECK-LABEL: function f11 name="returnsUndefinedOrJumps"{{*}}results=[{type=undefined|number}] 
# CHECK: ReturnCall

function f12 name="returnsATextToo" parameters=[{type=number}, {type=boolean}, {type=string}] results=[{type=number flags=[IsExpected]}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return v2
}
# CHECK-LABEL: function f12 name="returnsATextToo"{{*}}results=[{type=number flags=[IsExpected]}] 

function f13 name="returnsTrueOrFalseWhereAnythingIsDeclared" parameters=[{type=number}] results=[{type=anything}] {
    v1 = Less v0, v0
    Return v1
}
# CHECK-LABEL: function f13 name="returnsTrueOrFalseWhereAnythingIsDeclared"{{*}}results=[{type=boolean}] 
