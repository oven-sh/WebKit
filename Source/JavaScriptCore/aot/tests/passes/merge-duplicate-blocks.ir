# Blocks that only create equal constants and jump to one target with them become one block
# FORM: Prepared
# RUN: pass MergeDuplicateBlocks
# STATISTIC: MergeDuplicateBlocksChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="equalBooleans" parameters=[{type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = Boolean boolean=true
    Jump -> next b3(v1)
  b2():
    v2 = Boolean boolean=true
    Jump -> next b3(v2)
  b3(v3):
    Return v3
}
# CHECK-LABEL: function f0 name="equalBooleans"
# CHECK: Branch v0 -> taken b1(), notTaken b1()

function f1 name="equalStringsAndIntegers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v1 = String string="a"
    v2 = Integer integer=7
    Jump -> next b4(v1, v2)
  b2():
    v3 = String string="b"
    v4 = Integer integer=7
    Jump -> next b4(v3, v4)
  b3():
    v5 = String string="a"
    v6 = Integer integer=7
    Jump -> next b4(v5, v6)
  b4(v7, v8):
    v9 = Strcat v7, v8
    Return v9
}
# CHECK-LABEL: function f1 name="equalStringsAndIntegers"
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b1()

function f2 name="differentConstants" parameters=[{type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = Boolean boolean=true
    Jump -> next b3(v1)
  b2():
    v2 = Boolean boolean=false
    Jump -> next b3(v2)
  b3(v3):
    Return v3
}
# CHECK-LABEL: function f2 name="differentConstants"
# CHECK: Branch v0 -> taken b1(), notTaken b2()

function f3 name="differentTargets" parameters=[{type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = Boolean boolean=true
    Jump -> next b3(v1)
  b2():
    v2 = Boolean boolean=true
    Jump -> next b4(v2)
  b3(v3):
    Return v3
  b4(v4):
    v5 = LogicalNot v4
    Return v5
}
# CHECK-LABEL: function f3 name="differentTargets"
# CHECK: Branch v0 -> taken b1(), notTaken b2()

function f4 name="blockWithCall" parameters=[{type=boolean}, {type=anything}] results=[{type=boolean}] {
  b0(v0: boolean, v1: anything):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Call v1
    v3 = Boolean boolean=true
    Jump -> next b3(v3)
  b2():
    v4 = Call v1
    v5 = Boolean boolean=true
    Jump -> next b3(v5)
  b3(v6):
    Return v6
}
# CHECK-LABEL: function f4 name="blockWithCall"
# CHECK: Branch v0 -> taken b1(), notTaken b2()

function f5 name="argumentFromOutside" parameters=[{type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = Boolean boolean=true
    Jump -> next b3(v1)
  b2():
    v2 = Boolean boolean=true
