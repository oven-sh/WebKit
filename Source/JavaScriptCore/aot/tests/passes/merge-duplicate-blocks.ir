function f7 name="preheaderEqualsLatch" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b4()
  b1(v1):
    LoopHint
    v3 = Call v0, -, v1, v7
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Boolean boolean=false
    Jump -> next b1(v5)
  b3():
    Return v3
  b4():
    v6 = Boolean boolean=false
    v7 = Integer integer=10
    Jump -> next b1(v6)
}
# CHECK-LABEL: function f7 name="preheaderEqualsLatch"
# CHECK: b0(
# CHECK-NEXT: Jump -> next b4()
# CHECK: Branch v4 -> taken b2(), notTaken b3()

function f8 name="preheaderBelowCoveredBlock" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b6():
    v1 = Call v0
    Jump -> next b2()
  b2():
    v2 = Boolean boolean=false
    Jump -> next b3(v2)
  b3(v3):
    LoopHint
    v5 = Call v0, -, v1, v3
    v6 = ToBoolean v5
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    v7 = Boolean boolean=false
    Jump -> next b3(v7)
  b5():
    Return v5
  b6() role=CatchHandler:
    v8 = CatchValue
    Return v8
}
# CHECK-LABEL: function f8 name="preheaderBelowCoveredBlock"
# CHECK: Jump -> next b2()
# CHECK: Branch v6 -> taken b4(), notTaken b5()
