function f6 name="blockWithParameter" parameters=[{type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(v0), notTaken b2(v0)
  b1(v1):
    v2 = Boolean boolean=true
    Jump -> next b3(v2)
  b2(v3):
    v4 = Boolean boolean=true
    Jump -> next b3(v4)
  b3(v5):
    Return v5
}
# CHECK-LABEL: function f6 name="blockWithParameter"
