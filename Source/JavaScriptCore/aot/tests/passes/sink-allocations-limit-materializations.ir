# An allocation is built at no more places than the limit
# FORM: Prepared
# OPTIONS: limit=MaxMaterializations:1
# RUN: pass SinkAllocations
# LOSS: MaxMaterializations f0 v2
# STATISTIC: AllocationsSunk = 1
# STATISTIC: AllocationsRemoved = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="neededInTwoBranches" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = NewObject -, v1, v0 layout=L0 fields=[0, 1]
    Switch v1 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v4 = Call v0, -, v2
    Return v4
  b2():
    v5 = Call v1, -, v2
    Return v5
  b3():
    v6 = PropGet v3 key="x" receivers=[L0]
    Return v6
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= NewObject -, v0, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: Switch v1
# CHECK: b1():
# CHECK-NEXT: = Call v0, -, v2
# CHECK: b2():
# CHECK-NEXT: = Call v1, -, v2
# CHECK: b3():
# CHECK-NEXT: v6: anything = Upcast v1 castType=anything
}

function f1 name="neededInOneBranch" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Switch v1 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v3 = Call v0, -, v2
    Return v3
  b2():
    Return v0
  b3():
    Return v1
# CHECK: b0(
# CHECK-NEXT: Switch v1
# CHECK: b1():
# CHECK-NEXT: [[cell1]]:{{*}}= NewObject -, v0, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[cell1]]
# CHECK-NOT: NewObject
}
