# CHECK-NEXT: Branch [[isPresent2]] -> taken [[presentBlock2]](| 0), notTaken
# CHECK: [[presentBlock2]]([[present2]]: guard):
# CHECK: v2: number = GetArrayElement v0, v1, [[present2]] arrayStorage=Double level=Proven [isPresent]
# CHECK-NEXT: Return v2
# CHECK: frequency=Unlikely:
# CHECK-NEXT: [[generic2]]: undefined|number = GetArrayElement v0, v1 arrayStorage=Double level=Proven
# CHECK-NEXT: Return [[generic2]]
# NONE-LABEL: function f2 name="provenArray"
# NONE-NOT: HasArrayStorage
# NONE-NOT: IsPristine
# SIMPLE-LABEL: function f2 name="provenArray"

# A position inside the length of an array without holes holds an element
function f3 name="provenArrayWithoutHoles" parameters=[{type=Array<number, proven, Double, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}] results=[{type=anything}] {
    v2 = GetArrayElement v0, v1 arrayStorage=Double level=Proven [keyIsIntegral]
    Return v2
}
# PLAN-LABEL: function f3
