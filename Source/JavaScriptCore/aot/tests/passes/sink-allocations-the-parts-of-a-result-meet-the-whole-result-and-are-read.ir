# A callee hands over the parts of its result on most of its ways and the object itself on one. Where the two meet the caller reads fields: the edge of the object gets a copy of what follows, and the parts are not put together
# FORM: Prepared
# RUN: pass SinkAllocations SinkAllocations
# STATISTIC: TailsDuplicatedForSinking = 2

module m0 path="main.js" displayPath="main.js"
layout L0 module=m0 fields=[{key="high" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation} occupancy=FilledAtBirth stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="low" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation} occupancy=FilledAtBirth stability=[IsNeverDeleted, IsNeverRedefined]}}] declaredOrder=[1, 0] ownFieldCount=2 flow={baseState=None constructorOrders=[{fields=[1, 0]}] fieldCreation=OnlyAtConstruction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreAfterCreation] keys=NeverEnumerated addedKeysAreComplete=true}

function f0 name="worker" parameters=[{type=L0}, {type=int}] results=[{type=i32}, {type=L0}, {type=int}, {type=int}] {
  b0(v0: L0, v1: int):
    v2 = Integer integer=1
    v3 = Results v2, v0, v1, v1
    Return v3
}

function f1 name="readBySlotOrByName" parameters=[{type=L0}, {type=int}] results=[{type=anything}] {
  b0(v0: L0, v1: int):
    v2 = CallDirect v0, v1 function=f0
    v3 = ResultAt v2
    v4 = ResultAt v2 index=1
    v5 = ResultAt v2 index=2
    v6 = ResultAt v2 index=3
    Switch v3 cases=[1] -> case b2(v4), otherwise b1()
  b1():
    v7 = NewObject -, v5, v6 layout=L0 fields=[1, 0]
    Jump -> next b2(v7)
  b2(v8: L0):
    v9 = IsSlotFilled v8 key="high" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10: guard):
    v11 = GetSlot v8, v10 key="high" receivers=[L0] level=Expected [holdsDeclaredType]
    Return v11
  b4() frequency=Rare:
    v12 = PropGet v8 key="high" receivers=[L0]
    Return v12
}
# CHECK-LABEL: function f1 name="readBySlotOrByName"
# CHECK: Switch v3 cases=[1] -> case [[copy]](v4), otherwise
# CHECK-NOT: NewObject
# CHECK: = Upcast v6 castType=int
# CHECK-NOT: NewObject
# CHECK: [[copy]]([[cell]]: L0):
# CHECK-NEXT: = IsSlotFilled [[cell]] key="high"

function f2 name="readBySlotAlone" parameters=[{type=L0}, {type=int}] results=[{type=anything}] {
  b0(v0: L0, v1: int):
    v2 = CallDirect v0, v1 function=f0
    v3 = ResultAt v2
    v4 = ResultAt v2 index=1
    v5 = ResultAt v2 index=2
    v6 = ResultAt v2 index=3
    Switch v3 cases=[1] -> case b2(v4), otherwise b1()
  b1():
    v7 = NewObject -, v5, v6 layout=L0 fields=[1, 0]
    Jump -> next b2(v7)
  b2(v8: L0):
    v9 = IsSlotFilled v8 key="low" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10: guard):
    v11 = GetSlot v8, v10 key="low" receivers=[L0] level=Expected [holdsDeclaredType]
    Return v11
  b4() frequency=Rare:
    v12 = Undefined
    Return v12
}
# CHECK-LABEL: function f2 name="readBySlotAlone"
# CHECK-NOT: NewObject
# CHECK: = Upcast v5 castType=int
# CHECK-NOT: NewObject
