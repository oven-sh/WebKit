# What the array holds is only expected, so the read by key may give anything and a check stands between it and the sum: a check tells undefined from NaN
function f6 name="contentsOnlyExpected" parameters=[{type=Array<number>}, {type=int[0, 1000]}] results=[{type=number}] {
  b0(v0: Array<number>, v1: int[0, 1000]):
    v2 = Integer integer=0
    v3 = Double number=0.5
    Jump -> next b1(v2, v3)
  b1(v4: int[0, 1000], v5: number):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = ElemGet v0, v8
    v10 = Check v9 castType=number
    v11 = Add v5, v10
    v12 = Integer integer=1
    v13 = Add v8, v12
    Jump -> next b1(v13, v11)
  b3():
    Return v5
}
