# Undefined converts to NaN, and the hole of Double storage is a NaN. So where every use of an element converts it to a number, a read in a loop from an array that the loop does not change tests the bounds alone and takes a hole for NaN. That a hole reads as undefined is a fact about the prototypes: their test and the test of the kind stand on the edge that enters the loop, and a turn has the test of the bounds. Each function behind the first three differs from them in the one thing that costs the form: its read tests that the element is there
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement
# RUN(READ): pass PlaceTypeTests
# RUN(ONCE): pass PlaceTypeTests
# RUN(NONE): pass PlaceTypeTests
# STATISTIC: ElementPresenceTestsPlaced = 10

module m0 path="main.js" displayPath="main.js"

# sum += l[j], with sum: number
function f0 name="sum" parameters=[{type=Array<number, proven>}, {type=int[0, 1000]}] results=[{type=number}] {
  b0(v0: Array<number, proven>, v1: int[0, 1000]):
    v2 = Integer integer=0
    v3 = Double number=0.5
    Jump -> next b1(v2, v3)
  b1(v4: int[0, 1000], v5: number):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = ElemGet v0, v8
    v10 = Add v5, v9
    v11 = Integer integer=1
    v12 = Add v8, v11
    Jump -> next b1(v12, v10)
  b3():
    Return v5
}
