# The inline frames of the callee follow the frame of the call, with parents and origins shifted by the number of that frame
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 4
# LOSS: MaxInlineHeadBytes f3

module m0 path="main.js" displayPath="main.js"
function f0 name="first" parameters=[{type=number}] results=[{type=number}]
function f1 name="second" parameters=[{type=number}] results=[{type=number}]
function f2 name="third" parameters=[{type=number}] results=[{type=number}]

function f3 name="treeOfFrames" parameters=[{type=number}, {type=boolean}] results=[{type=number}] inlineFrames=[{}, {callee=f0 callPosition=5 module=m0}, {callee=f1 callPosition=6 parent=1 module=m0}, {callee=f2 callPosition=7 module=m0}, {callee=f0 callPosition=8 parent=3 module=m0}] {
  b0(v0: number, v1: boolean):
    v2 = Add v0, v0 @10
    v3 = Sub v2, v0 @11:1
    v4 = Mul v3, v0 @12:2
    Branch v1 -> taken b1(), notTaken b2() @13:2
  b1():
    v5 = Div v4, v0 @14:3
    Return v5 @15:3
  b2():
    v6 = Mod v4, v0 @16:4
    Return v6 @17
}

function f4 name="callerWithoutFrames" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: number, v1: boolean):
    v2 = CallDirect v0, v1 function=f3 [isAlwaysInlined] @30
    Return v2 @31
}
# CHECK-LABEL: function f4 name="callerWithoutFrames"
# CHECK: inlineFrames=[{}, {callee=f3 callPosition=30 module=m0}, {callee=f0 callPosition=5 parent=1 module=m0}, {callee=f1 callPosition=6 parent=2 module=m0}, {callee=f2 callPosition=7 parent=1 module=m0}, {callee=f0 callPosition=8 parent=4 module=m0}] {
# CHECK-NOT: CallDirect
# CHECK: Return v2 @31
# CHECK: = Add v0, v0 @10:1
# CHECK-NEXT: = Sub {{*}} @11:2
# CHECK-NEXT: = Mul {{*}} @12:3
# CHECK-NEXT: Branch v1 -> {{*}} @13:3
# CHECK: = Div {{*}} @14:4
# CHECK: = Mod {{*}} @16:5

function f5 name="siteInsideSecondFrame" parameters=[{type=number}, {type=boolean}] results=[{type=number}] inlineFrames=[{}, {callee=f1 callPosition=20 module=m0}, {callee=f2 callPosition=21 parent=1 module=m0}] {
  b0(v0: number, v1: boolean):
    v2 = Negate v0 @22:1
    v3 = CallDirect v2, v1 function=f3 [isAlwaysInlined] @30:2
    Return v3 @31
}
# CHECK-LABEL: function f5 name="siteInsideSecondFrame"
# CHECK: inlineFrames=[{}, {callee=f1 callPosition=20 module=m0}, {callee=f2 callPosition=21 parent=1 module=m0}, {callee=f3 callPosition=30 parent=2 module=m0}, {callee=f0 callPosition=5 parent=3 module=m0}, {callee=f1 callPosition=6 parent=4 module=m0}, {callee=f2 callPosition=7 parent=3 module=m0}, {callee=f0 callPosition=8 parent=6 module=m0}] {
# CHECK-NOT: CallDirect
# CHECK: v2: number = Negate v0 @22:1
# CHECK: Return v3 @31
# CHECK: = Add v2, v2 @10:3
# CHECK-NEXT: = Sub {{*}} @11:4
# CHECK-NEXT: = Mul {{*}} @12:5
# CHECK-NEXT: Branch v1 -> {{*}} @13:5
# CHECK: = Div {{*}} @14:6
# CHECK: = Mod {{*}} @16:7

function f6 name="twoSites" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: number, v1: boolean):
    v2 = CallDirect v0, v1 function=f3 [isAlwaysInlined] @40
    v3 = CallDirect v2, v1 function=f3 [isAlwaysInlined] @41
    Return v3
}
# CHECK-LABEL: function f6 name="twoSites"
# CHECK: inlineFrames=[{}, {callee=f3 callPosition=41 module=m0}, {callee=f0 callPosition=5 parent=1 module=m0}, {callee=f1 callPosition=6 parent=2 module=m0}, {callee=f2 callPosition=7 parent=1 module=m0}, {callee=f0 callPosition=8 parent=4 module=m0}, {callee=f3 callPosition=40 module=m0}, {callee=f0 callPosition=5 parent=6 module=m0}, {callee=f1 callPosition=6 parent=7 module=m0}, {callee=f2 callPosition=7 parent=6 module=m0}, {callee=f0 callPosition=8 parent=9 module=m0}] {
# CHECK-NOT: CallDirect
# CHECK: = Add v2, v2 @10:1
# CHECK: = Mod {{*}} @16:5
# CHECK: = Add v0, v0 @10:6
# CHECK-NEXT: = Sub {{*}} @11:7
# CHECK-NEXT: = Mul {{*}} @12:8
# CHECK: = Div {{*}} @14:9
# CHECK: = Mod {{*}} @16:10

function f7 name="callThatStays" parameters=[{type=number}, {type=boolean}] results=[{type=number}] inlineFrames=[{}, {callee=f1 callPosition=20 module=m0}] {
  b0(v0: number, v1: boolean):
    v2 = CallDirect v0, v1 function=f3 [isNeverInlined] @30:1
    Return v2
}
# CHECK-LABEL: function f7 name="callThatStays"
# CHECK: inlineFrames=[{}, {callee=f1 callPosition=20 module=m0}] {
# CHECK: = CallDirect v0, v1 function=f3 [isNeverInlined] @30:1
