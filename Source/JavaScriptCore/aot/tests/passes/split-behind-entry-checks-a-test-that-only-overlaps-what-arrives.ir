# The test at the entrance is for the declared type, i32. Flow knows what arrives: 1 and 2147483648. Neither type holds the other, so what is left behind the test, int[1, 2147483647],
# says more than the test does. The body behind the tests has a parameter of the tested type, which whoever holds an i32 may hand it, and ASSUMES what is left. It once kept the
# narrower type on an Upcast of that parameter, which no rule gives: typed again by a later pass, the value was an i32 and was returned outside the declared result
# FORM: AsRead
# RUN: pipeline SplitBehindEntryChecks
# OPTIONS: check=VerifyEachPass
# STATISTIC: FunctionsSplitBehindEntryChecks = 1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter
typesite w1 module=m0 position=25 kind=Variable
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Call v0, -, v1
    v3 = Integer integer=2147483648
    v4 = Convert v3 declared={type=number site=w1}
    v5 = Call v0, -, v4
    Return
}
function f1 name="probe" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=i32 site=w0}] results=[{type=anything}] {
    Return v0
}
# CHECK-LABEL: function f1 name="probe" module=m0 position=5 role=EntryChecks
# CHECK: = TypeTest v0 testedType=i32
# CHECK: name="probe" module=m0 position=5 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=i32 site=w0}]
# CHECK: : int[1, 2147483647] = AssumeType v0 provenType=int[1, 2147483647]
