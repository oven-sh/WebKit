# A field that flow saw read only as a callee goes when every call is direct and no read is left
# FORM: Prepared
# RUN: pass RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="SetAtCreation" fields=[{key="run" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=OnlyCalled}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="StoredLater" fields=[{key="run" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=OnlyCalled}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L2 name="OneCallByValue" fields=[{key="run" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=OnlyCalled} occupancy=AlwaysFilled}}, {key="n" declared={type=anything} flags=[IsRequired]}]
# CHECK: layout L0 name="SetAtCreation" fields=[{key="run"{{*}}flow={location={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n"
# CHECK: layout L1 name="StoredLater" fields=[{key="run"{{*}}flow={location={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n"
# CHECK: layout L2 name="OneCallByValue" fields=[{key="run"{{*}}flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=OnlyCalled}

function f0 name="setAtCreation" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f3
    v2 = NewObject -, v1, v0 layout=L0 fields=[0, 1]
    v3 = CallDirect function=f3
    Return v2
# CHECK-NOT: NewClosure
# CHECK: = NewObject -, v0 layout=L0 fields=[1]
# CHECK-NEXT: = CallDirect function=f3
}

function f1 name="storedLater" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v2 = NewClosure function=f3
    PutSlot v1, v1, v2 key="run" receivers=[L1] level=Proven
    v4 = CallDirect function=f3
    Return v1
# CHECK: = NewObject -, v0 layout=L1 fields=[1]
# CHECK-NEXT: = CallDirect function=f3
}

function f2 name="oneCallByValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f3
    v2 = NewObject -, v1, v0 layout=L2 fields=[0, 1]
    v3 = CallDirect function=f3
    v4 = GetSlot v2, v2 key="run" receivers=[L2] level=Proven
    v5 = Call v4, v2
    Return v2
# CHECK: = NewClosure function=f3
# CHECK-NEXT: = NewObject -, v1, v0 layout=L2 fields=[0, 1]
}

function f3 name="callback" kind=Arrow results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="log" [isFreeName]
    v2 = Call v1
    Return
}
