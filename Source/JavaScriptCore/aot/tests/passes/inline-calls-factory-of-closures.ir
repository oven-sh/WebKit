# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls SimplifyControlFlow EliminateDeadCode SinkAllocations SimplifyCasts EliminateDeadCode SinkAllocations SimplifyCasts EliminateDeadCode

module m0 path="main.js" displayPath="main.js"
layout L0 name="Api" fields=[{key="m0" declared={type=f6} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m1" declared={type=f7} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m2" declared={type=f8} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m3" declared={type=f9} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m4" declared={type=f10} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m5" declared={type=f11} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m6" declared={type=f12} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="m7" declared={type=f13} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}]
