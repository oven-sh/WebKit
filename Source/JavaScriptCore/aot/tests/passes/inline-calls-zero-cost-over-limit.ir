# A copy that is no larger than its call is made in a caller that is already over the limit on its size
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot limit=MaxInlinedCallerBytes:100
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 1
# STATISTIC: InlineDecisionCallerSizeLimit = 1
# LOSS: MaxInlinedCallerBytes x1 f3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled}}]

function f0 name="getter" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="x" receivers=[L0] level=Proven
    Return v1
}

function f1 name="getterAndOneOperation" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="x" receivers=[L0] level=Proven
    v2 = Mul v1, v1
    Return v2
}

function f2 name="largeCallerOfGetter" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = CallDirect v0 function=f0
    v2 = Mul v1, v1
    v3 = Mul v2, v1
    v4 = Mul v3, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    v12 = Mul v11, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    Return v14
}
# CHECK-LABEL: name="largeCallerOfGetter"
# CHECK-NOT: CallDirect
# CHECK: = GetSlot v0 key="x"
# CHECK-NOT: CallDirect

function f3 name="largeCallerOfLargerCallee" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = CallDirect v0 function=f1
    v2 = Mul v1, v1
    v3 = Mul v2, v1
    v4 = Mul v3, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    v12 = Mul v11, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    Return v14
}
# CHECK-LABEL: name="largeCallerOfLargerCallee"
# CHECK-NOT: GetSlot
# CHECK: v1: number = CallDirect v0 function=f1
# CHECK-NOT: GetSlot
