# The limit is on what inlining adds to a caller, so a caller that is larger than the limit by itself takes in a callee like any other.
# Once as much has been added as the limit allows, a copy that is no larger than its call is still made, and a larger one is not
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot limit=MaxInlinedCallerBytes:100
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 4
# STATISTIC: InlineDecisionCallerSizeLimit = 1
# LOSS: MaxInlinedCallerBytes x1 f5
# LOSS: MaxInlineHeadBytes f2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverStoredWithOtherType]}}]

function f0 name="getter" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="x" receivers=[L0] level=Proven
    Return v1
}

function f1 name="getterAndOneOperation" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="x" receivers=[L0] level=Proven
    v2 = Mul v1, v1
    Return v2
}

function f2 name="thirteenOperations" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
# REPEAT: i = 0..12
    v%(i+1) = Mul v%(i), v0
# END REPEAT
    Return v13
}

function f3 name="largeCallerOfLargerCallee" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = CallDirect v0 function=f1
# REPEAT: i = 1..13
    v%(i+1) = Mul v%(i), v1
# END REPEAT
    Return v14
}
# CHECK-LABEL: name="largeCallerOfLargerCallee"
# CHECK-NOT: CallDirect
# CHECK: = GetSlot v0 key="x"
# CHECK-NOT: CallDirect

function f4 name="getterBehindAllThatTheLimitAllows" parameters=[{type=L0}, {type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0, v1: number, v2: boolean):
    v3 = CallDirect v0 function=f0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = CallDirect v1 function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    v6 = Mul v3, v5
    Return v6
}
# CHECK-LABEL: name="getterBehindAllThatTheLimitAllows"
# CHECK-NOT: CallDirect
# CHECK: = GetSlot v0 key="x"
# CHECK-NOT: CallDirect

function f5 name="largerCalleeBehindAllThatTheLimitAllows" parameters=[{type=L0}, {type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0, v1: number, v2: boolean):
    v3 = CallDirect v0 function=f1
    Jump -> next b1()
  b1():
    LoopHint
    v5 = CallDirect v1 function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    v6 = Mul v3, v5
    Return v6
}
# CHECK-LABEL: name="largerCalleeBehindAllThatTheLimitAllows"
# CHECK-NOT: GetSlot
# CHECK: v3: number = CallDirect v0 function=f1
# CHECK-NOT: GetSlot
# CHECK-NOT: CallDirect
