  b0(v0: string, v1: string, v2: anything):
    v3 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = ElemGet v3, v4
    v7 = ElemGet v3, v5
