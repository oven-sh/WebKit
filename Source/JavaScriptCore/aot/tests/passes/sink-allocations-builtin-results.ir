# The array a built-in returns is never built when only its length, its first elements and the properties its entry lists are read: the call delivers them as results, and "no match" is a bit of a tag.
# The pieces of a split and the groups of an exec are delivered as bounds in the string, and a string is made of them only where one is needed
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 16
# STATISTIC: AllocationsSunk = 0
# LOSS: MaxVirtualArrayLength x1 f17 v2

module m0 path="main.js" displayPath="main.js"

