# CHECK: b1() frequency=Rare:
# CHECK-NEXT: Throw v5
# CHECK-NEXT: b2() frequency=Rare:
# CHECK-NEXT: ValidateType v5 validatedType=undefined|int
# CHECK-NEXT: [[returned0]]: undefined|int = AssumeType v5 castType=undefined|int
