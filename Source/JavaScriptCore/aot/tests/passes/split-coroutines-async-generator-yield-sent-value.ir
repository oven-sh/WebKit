# What the await that is merged into a yield rejects with arrives at the yield as a value that is sent in to be thrown. What flow proves of the values that `next`, `throw` and `return` send in
# stands in front of the switch on the mode: it goes into the arms that do not throw, with its validation, and the arm that throws takes the value as it came.
# It stays where somebody reads the proven value in front of the switch or where two arms meet, and where no await was merged
# FORM: Prepared
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="proofOfSentValue" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: function, v1: anything):
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    ValidateType v5 validatedType=undefined|int
    v7 = AssumeType v5 castType=undefined|int
    v8 = ResultAt v4 index=1
    Switch v8 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v7
  b2():
    Return v7
  b3():
    Jump -> next b4()
  b4():
    Return v7
}
function f1 name="readWhereArmsMeet" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: function, v1: anything):
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 castType=undefined|int
    v7 = ResultAt v4 index=1
    Switch v7 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v6
  b2():
    Jump -> next b4()
  b3():
    Jump -> next b4()
  b4():
    Return v6
}
function f2 name="noAwaitInFront" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: function, v1: anything):
    InitialYield @10
    v3 = Yield v1 @12
    v4 = ResultAt v3 index=0
    v5 = AssumeType v4 castType=undefined|int
    v6 = ResultAt v3 index=1
    Switch v6 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v5
  b2():
    Return v5
  b3():
    Return v5
}
function f3 name="castOfProof" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: function, v1: anything):
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 castType=undefined|int
    v7 = Upcast v6 castType=undefined|number
    v8 = ResultAt v4 index=1
    Switch v8 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v7
  b2():
    Return v6
  b3():
    Return v7
}

# The initial yield splits the first block, so the arms are printed in front of the yield.
