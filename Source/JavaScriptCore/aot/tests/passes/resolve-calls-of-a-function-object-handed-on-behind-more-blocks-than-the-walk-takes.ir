# Whether a use of the caller's own function object and a call of it lie on one way is told by a walk against the edges, from one of them as far as the blocks that stand in front of the other. The walk takes a fixed number of blocks. Past that the two count as lying on one way, and the call stays by value.
# FORM: Prepared
# RUN: pass ResolveCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="renamed" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, RecordsCallee] {
    Return v0
}
function f1 name="fewTestsFailIntoOneAnother" parameters=[{type=boolean}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b6()
  b1():
    Branch v0 -> taken b2(), notTaken b7()
  b2():
    Branch v0 -> taken b3(), notTaken b8()
  b3():
    Branch v0 -> taken b4(), notTaken b9()
  b4():
    Branch v0 -> taken b5(), notTaken b10()
  b5():
    v4 = Call v3, -, v1
    Return v4
  b6() frequency=Rare:
    Jump -> next b7()
  b7() frequency=Rare:
    Jump -> next b8()
  b8() frequency=Rare:
    Jump -> next b9()
  b9() frequency=Rare:
    Jump -> next b10()
  b10() frequency=Rare:
    v5 = Call v2, -, v3
    Return v5
# CHECK: = CallDirect v1 function=f0 [callsOwnFunctionObject, calleeIsPredicted]
# CHECK: = Call v2, -, v3
}

