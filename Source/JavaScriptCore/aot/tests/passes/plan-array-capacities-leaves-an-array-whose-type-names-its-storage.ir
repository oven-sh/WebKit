# An array whose type names its kind of storage keeps that kind: the failing edge of a test for Double storage leads where it led. Beside it: an array of which the type says no kind is converted there.
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# STATISTIC: IntegerArrayConversionsPlaced = 1
# CHECK-LABEL: name="wholeNumbers"
# CHECK-NOT: ConvertToDoubleStorage
# CHECK-LABEL: name="numbers"
# CHECK: ConvertToDoubleStorage v0

module m0 path="main.js" displayPath="main.js"

function f0 name="wholeNumbers" parameters=[{type=Array<int[5, 9], proven, Int32>}, {type=int[0, 1000]}] results=[{type=anything}] {
    v2 = HasArrayStorage v0 arrayStorage=Double
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = IsElementPresent v0, v1, v3 arrayStorage=Double [keyIsIntegral]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = AllGuards v3, v5
    v7 = GetArrayElement v0, v1, v6 arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
    Return v7
  b3() frequency=Unlikely:
    v8 = ElemGet v0, v1
    Return v8
}

function f1 name="numbers" parameters=[{type=Array<number>}, {type=int[0, 1000]}] results=[{type=anything}] {
    v2 = HasArrayStorage v0 arrayStorage=Double
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = IsElementPresent v0, v1, v3 arrayStorage=Double [keyIsIntegral]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = AllGuards v3, v5
    v7 = GetArrayElement v0, v1, v6 arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
    Return v7
  b3() frequency=Unlikely:
    v8 = ElemGet v0, v1
    Return v8
}
