# With the pass switched off an access on a proven union stays one operation
# FORM: Prepared
# OPTIONS: disable=pass:SplitUnions
# RUN: pass SplitUnions
# STATISTIC: UnionsSplit = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}
layout L1 name="Empty" flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}
function f0 name="field-and-absent" parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f0 name="field-and-absent"
# CHECK-NEXT: b0(v0: L0|L1):
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
function f1 name="layout-or-string" parameters=[{type=string|L0}] results=[{type=anything}] {
  b0(v0: string|L0):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f1 name="layout-or-string"
# CHECK-NEXT: b0(v0: string|L0):
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
