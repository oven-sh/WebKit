# function choose(kind) { let note = ""; if (kind) note = "set; "; return (x) => note + x }        choose(true); choose(false)
# SplitFreshResults lets the worker of such a function hand back the parts of the closure: which function it is, and the environment. The worker has done with the environment there and the caller has not.
# Released behind its last use in the worker, the cell would be taken by the next call, and the closure of the first call would read the variable of the second.
# FORM: Prepared
# RUN: pass ReuseEnvironments
# OPTIONS: disable=pass:AllocateInFrames
# CHECK-LABEL: function f0 name="worker"
# CHECK-NOT: ReleaseEnvironment

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="choose" fields=[{key="note" declared={type=anything}}]

function f0 name="worker" parameters=[{type=boolean}, {type=anything}] results=[{type=i32}, {type=env L0}] {
  b0(v0: boolean, v1: anything):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    PutEnvironmentField v2, v0 layout=L0 field=0
    Jump -> next b2()
  b2():
    v4 = Integer integer=1
    v5 = Results v4, v2
    Return v5
}
