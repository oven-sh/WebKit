# Two reads of the shape epoch are one read unless something between them may move the epoch
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Bag" fields=[{key="x" declared={type=anything}}] flow={impossibleMutations=[DeleteField, RedefineProperty, ChangeIntegrity]}

function f0 name="nothingBetween" results=[{type=boolean}] {
  b0():
    v0 = GetShapeEpoch
    v1 = GetShapeEpoch
    v2 = StrictEq v0, v1
    Return v2
}
# CHECK-LABEL: function f0 name="nothingBetween"
# CHECK: v0:{{*}}= GetShapeEpoch
# CHECK-NEXT: v1:{{*}}= Upcast v0
# CHECK-NOT: GetShapeEpoch

function f1 name="slotIsFilledBetween" parameters=[{type=L0}, {type=anything}] results=[{type=boolean}] {
  b0(v0: L0, v1: anything):
    v2 = GetShapeEpoch
    PutSlotOrAdd v0, -, v1 key="x" receivers=[L0] level=Proven
    v4 = GetShapeEpoch
    v5 = StrictEq v2, v4
    Return v5
}
# CHECK-LABEL: function f1 name="slotIsFilledBetween"
# CHECK: PutSlotOrAdd v0
# CHECK-NEXT: v4:{{*}}= Upcast v2
# CHECK-NOT: GetShapeEpoch

function f2 name="prototypeIsSetBetween" parameters=[{type=object}, {type=anything}] results=[{type=boolean}] {
  b0(v0: object, v1: anything):
    v2 = GetShapeEpoch
    SetLiteralPrototype v0, v1
    v4 = GetShapeEpoch
    v5 = StrictEq v2, v4
    Return v5
}
# CHECK-LABEL: function f2 name="prototypeIsSetBetween"
# CHECK: SetLiteralPrototype v0, v1
# CHECK-NEXT: v4:{{*}}= GetShapeEpoch

function f3 name="getterIsDefinedBetween" parameters=[{type=object}, {type=function}] results=[{type=boolean}] {
  b0(v0: object, v1: function):
    v2 = GetShapeEpoch
    DefineGetter v0, v1 key="x"
    v4 = GetShapeEpoch
    v5 = StrictEq v2, v4
    Return v5
}
# CHECK-LABEL: function f3 name="getterIsDefinedBetween"
# CHECK: DefineGetter v0, v1
# CHECK-NEXT: v4:{{*}}= GetShapeEpoch

function f4 name="unknownCallBetween" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = GetShapeEpoch
    v2 = Call v0
    v3 = GetShapeEpoch
    v4 = StrictEq v1, v3
    Return v4
}
# CHECK-LABEL: function f4 name="unknownCallBetween"
# CHECK: = Call v0
# CHECK-NEXT: v3:{{*}}= GetShapeEpoch
