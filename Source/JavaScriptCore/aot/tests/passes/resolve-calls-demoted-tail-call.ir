# A direct call made from a demoted tail call keeps its mark, and one that stays a tail call or was never one has none. The conversion of an argument stands in front of the call, so it ends no tail call
# FORM: Prepared
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 6
# STATISTIC: ReturnCallsDemoted = 0
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
typesite w0 module=m0 position=9 kind=Parameter text="number"
layout L0 kind=Instance name="Point" constructor=f11 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="m" function=f4 mutability=Fixed}]}
function f0 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number site=w0}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: number):
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    Return v1
}
function f1 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: number, v1: undefined|Promise):
    Return
}
function f2 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="second" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="m" kind=Method flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}

function f5 name="marked-call" parameters=[{type=f2}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2, v1: anything):
    v2 = Call v0, -, v1 [isDemotedTailCall]
    Return v2
}
# CHECK-LABEL: function f5 name="marked-call"
# CHECK: anything = CallDirect v1 function=f2 [isDemotedTailCall]

function f6 name="ordinary-call" parameters=[{type=f2}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f6 name="ordinary-call"
# CHECK-NOT: isDemotedTailCall
# CHECK: anything = CallDirect v1 function=f2
# CHECK-NOT: isDemotedTailCall

function f7 name="marked-call-of-two-callees" parameters=[{type=f2|f3}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2|f3, v1: anything):
    v2 = Call v0, -, v1 [isDemotedTailCall]
    Return v2
}
# CHECK-LABEL: function f7 name="marked-call-of-two-callees"
# CHECK: anything = CallDirect v1 function=f2 [isDemotedTailCall]
# CHECK: anything = CallDirect v1 function=f3 [isDemotedTailCall]

function f8 name="tail-call-stays" parameters=[{type=f2}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2, v1: anything):
    v2 = Call v0, -, v1
    ReturnCall v2
}
# CHECK-LABEL: function f8 name="tail-call-stays"
# CHECK-NOT: isDemotedTailCall
# CHECK: [[tail8]]: anything = CallDirect v1 function=f2
# CHECK-NOT: isDemotedTailCall
# CHECK: ReturnCall [[tail8]]

function f9 name="tail-call-behind-a-converted-argument" parameters=[{type=f0}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0, v1: anything):
    v2 = Call v0, -, v1 @40
    ReturnCall v2
}
# CHECK-LABEL: function f9 name="tail-call-behind-a-converted-argument"
# CHECK-NOT: isDemotedTailCall
# CHECK: [[argument9]]: number = AssumeType v1 castType=number
# CHECK-NEXT: [[call9]]: Promise = CallDirect [[argument9]] function=f0 @40
# CHECK-NEXT: ReturnCall [[call9]]
# CHECK-NOT: isDemotedTailCall

function f10 name="marked-method-call" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0, v1 calleeKey="m" [isDemotedTailCall]
    Return v3
}
# CHECK-LABEL: function f10 name="marked-method-call"
# CHECK: anything = CallDirect v0, v1 function=f4 [isDemotedTailCall]
function f11 name="Point" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
