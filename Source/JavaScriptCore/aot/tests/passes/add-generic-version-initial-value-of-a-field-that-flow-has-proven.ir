# Flow says of a field that nothing outside its type is ever stored there. Behind a guard an assumed type that rested on the check says nothing, so the array is an array like any other.
# What flow has seen holds all the same: the type of the field is assumed again in front of the allocation.
# The slot is written without a test, so nothing is assumed for the field that flow does not answer for: its value is stored behind the allocation
# FORM: Prepared
# RUN: pass AddGenericVersion VerifyProgram
# STATISTIC: InitialValuesStoredBehindAllocations = 1
# CHECK: [[array]]: Array = NewArray
# CHECK: [[proven]]: Array<anything, proven, pristine[Storage, Names]> = AssumeType {{*}} provenType=Array<anything, proven, pristine[Storage, Names]>
# CHECK: [[links]]: L0 = NewObject -, [[proven]], {{*}} layout=L0 fields=[0, 1]
# CHECK-NEXT: PropSet [[links]], {{*}} key="count"

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Links" fields=[{key="chain" declared={type=Array<anything, proven, pristine[Storage, Names]>} flags=[IsRequired, IsEnforced] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="count" declared={type=undefined|number} flags=[IsRequired, IsEnforced]}]

function f0 name="make" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = Check v0 expectedType=number
    v2 = NewArray v1 contents=anything
    v3 = AssumeType v2 provenType=Array<anything, proven, pristine[Storage, Names]>
    v4 = NewObject -, v3, v1 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    Return v5
}
