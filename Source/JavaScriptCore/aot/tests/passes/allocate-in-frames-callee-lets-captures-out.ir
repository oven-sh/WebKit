# A callee that borrows a closure and lets out what it reads through it takes the closure from the caller's frame: only what the closure holds is on the heap
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass
# OPTIONS: only-passes=ComputeEffectSummaries,ResolveCalls,ChooseCallingConventions,AllocateInFrames

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="letOut" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="onlyRead" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Environment name="underInnerClosure" fields=[{key="x" declared={type=anything}}]
layout L3 kind=Environment name="underKeptClosure" fields=[{key="x" declared={type=anything}}]
layout L4 kind=Environment name="behindJoin" fields=[{key="x" declared={type=anything}}]
layout L5 kind=Environment name="alsoPublished" fields=[{key="x" declared={type=anything}}]
layout L6 kind=Environment name="letOutOnOnePath" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    v3 = CallDirect v1 function=f1
    v4 = CallDirect v1 function=f2
    v5 = CallDirect v1 function=f3
    v6 = CallDirect v1 function=f4
    v7 = CallDirect v1, v2 function=f5
    v8 = CallDirect v1, v2 function=f6
    v9 = PropGet v0 key="print" [isFreeName]
    v10 = CallDirect v1, v2, v2 function=f23
    v11 = Call v9, -, v3, v4, v5, v6, v7, v8, v10
    Return
}

function f1 name="environmentIsLetOut" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f7
    v3 = CallDirect v2 function=f15
    Return v3
# CHECK-NOT: layout=L0 {{*}}storage=
# CHECK: = NewClosure v1 function=f7 {{*}}storage=Frame
}

function f2 name="environmentIsOnlyRead" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure v1 function=f8
    v3 = CallDirect v2 function=f16
    Return v3
# CHECK: = NewObject {{*}}layout=L1 {{*}}storage=Frame
# CHECK: = NewClosure v1 function=f8 {{*}}storage=Frame
}

function f3 name="innerClosureIsLetOut" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f9
    v3 = NewClosure v2 function=f10
    v4 = CallDirect v3 function=f17
    Return v4
# CHECK-NOT: layout=L2 {{*}}storage=
# CHECK-NOT: function=f9 {{*}}storage=
# CHECK: = NewClosure v2 function=f10 {{*}}storage=Frame
}

function f4 name="closureItselfIsKept" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewClosure v1 function=f11
    v3 = CallDirect v2 function=f18
    Return v3
# CHECK-NOT: storage=
# CHECK: Return
}

function f5 name="closureComesOverJoin" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L4 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewClosure v2 function=f12
    Jump -> next b3(v3)
  b2():
    v4 = NewClosure v2 function=f12
    Jump -> next b3(v4)
  b3(v5):
    v6 = CallDirect v5 function=f19
    Return v6
# CHECK-NOT: storage=
# CHECK: Return
}

function f6 name="environmentIsPublishedOnOnePath" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L5 fields=[0]
    v3 = NewClosure v2 function=f13
    v4 = CallDirect v3 function=f20
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = NewClosure v2 function=f14
    Return v5
  b2():
    Return v4
# CHECK-NOT: layout=L5 {{*}}storage=
# CHECK: = NewClosure v2 function=f13 {{*}}storage=Frame
# CHECK-NOT: MaterializeEnvironment
# CHECK: Return
}

function f7 name="givesReaderBack" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = NewClosure v0 function=f21
    Return v1
}
function f8 name="testsVariable" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = ToBoolean v1
    Return v2
}
function f9 name="inner" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    v2 = ToBoolean v1
    Return v2
}
function f10 name="givesInnerBack" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f11 name="testsVariable" kind=Arrow captures=[{type=env L3}] results=[{type=anything}] {
  b0(v0: env L3):
    v1 = GetEnvironmentField v0 layout=L3 field=0
    v2 = ToBoolean v1
    Return v2
}
function f12 name="givesReaderBack" kind=Arrow captures=[{type=env L4}] results=[{type=anything}] {
  b0(v0: env L4):
    v1 = NewClosure v0 function=f22
    Return v1
}
function f13 name="givesReaderBack" kind=Arrow captures=[{type=env L5}] results=[{type=anything}] {
  b0(v0: env L5):
    v1 = NewClosure v0 function=f14
    Return v1
}
function f14 name="reader" kind=Arrow captures=[{type=env L5}] results=[{type=anything}] {
  b0(v0: env L5):
    v1 = GetEnvironmentField v0 layout=L5 field=0
    Return v1
}

function f15 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
# CHECK: [[environment]]: env L0 = GetCapture v0 function=f7
# CHECK-NEXT: = CallDirect [[environment]] function=f7
}
function f16 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
function f17 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
function f18 name="givesParameterBack" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v0
}
function f19 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
function f20 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
function f21 name="reader" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f22 name="reader" kind=Arrow captures=[{type=env L4}] results=[{type=anything}] {
  b0(v0: env L4):
    v1 = GetEnvironmentField v0 layout=L4 field=0
    Return v1
}

function f23 name="environmentIsLetOutOnSomePaths" parameters=[{type=anything}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject -, v0 layout=L6 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewClosure v3 function=f24
    v5 = CallDirect v4 function=f26
    Return v5
  b2():
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v6 = NewClosure v3 function=f25
    Return v6
  b4():
    v7 = GetEnvironmentField v3 layout=L6 field=0
    Return v7
# CHECK: = NewObject {{*}}layout=L6 {{*}}storage=FrameUntilMaterialized
# CHECK: [[copy]]: env L6 = MaterializeEnvironment v3
# CHECK-NEXT: = NewClosure [[copy]] function=f24 {{*}}storage=Frame
# CHECK: [[other]]: env L6 = MaterializeEnvironment v3
# CHECK-NEXT: = NewClosure [[other]] function=f25
# CHECK: = GetEnvironmentField v3 layout=L6
}

function f24 name="givesReaderBack" kind=Arrow captures=[{type=env L6}] results=[{type=anything}] {
  b0(v0: env L6):
    v1 = NewClosure v0 function=f25
    Return v1
}
function f25 name="reader" kind=Arrow captures=[{type=env L6}] results=[{type=anything}] {
  b0(v0: env L6):
    v1 = GetEnvironmentField v0 layout=L6 field=0
    Return v1
}
function f26 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
