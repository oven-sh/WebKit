# A check behind a test of a tag goes where NarrowByField has proven the layout. Where the tag may be stored with another type the layout is only expected, and the check stays.
# A NarrowByField that takes nothing away from its holder goes too: it would keep the read alive for nothing
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Circle" fields=[{key="kind" declared={type=1} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="radius" declared={type=number} flags=[IsRequired]}]
layout L1 name="Square" fields=[{key="kind" declared={type=2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="side" declared={type=number} flags=[IsRequired]}]
layout L2 name="LooseCircle" fields=[{key="kind" declared={type=1} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="radius" declared={type=number} flags=[IsRequired]}]
layout L3 name="LooseSquare" fields=[{key="kind" declared={type=2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="side" declared={type=number} flags=[IsRequired]}]
layout L4 name="Shape" fields=[{key="kind" declared={type=number} flags=[IsRequired]}] flow={allocation=NeverAllocated}
layout L5 name="Small" fields=[{key="kind" declared={type=number} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="size" declared={type=number} flags=[IsRequired]}]
layout L6 name="Large" fields=[{key="kind" declared={type=number} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="size" declared={type=number} flags=[IsRequired]}]

function f0 name="checkBehindATagTest" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = Check v5 castType=L0
    v7 = PropGet v6 key="radius"
    Return v7
  b2(v8):
    v9 = NarrowByField v0, v8 key="kind"
    v10 = Check v9 castType=L1
    v11 = PropGet v10 key="side"
    Return v11
# CHECK: Branch v3 -> taken b1(| 0), notTaken b2(| 0)
# CHECK-NEXT: b1(v4: 1):
# CHECK-NEXT: v5: L0 = NarrowByField v0, v4 key="kind"
# CHECK-NEXT: = PropGet v5 key="radius"
# CHECK-NEXT: Return v7
# CHECK-NEXT: b2(v8: 2):
# CHECK-NEXT: v9: L1 = NarrowByField v0, v8 key="kind"
# CHECK-NEXT: = PropGet v9 key="side"
# CHECK-NEXT: Return v11
}

function f1 name="tagMayBeStoredWithAnotherType" parameters=[{type=L2|L3}] results=[{type=anything}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = Check v5 castType=L2
    v7 = PropGet v6 key="radius"
    Return v7
  b2():
    Return
# CHECK: v1: anything ~ int[1, 2] = PropGet v0 key="kind"
# CHECK: b1(v4: 1):
# CHECK-NEXT: v5: L2|L3 ~ L2 = NarrowByField v0, v4 key="kind"
# CHECK-NEXT: v6: L2 = Check v5 castType=L2
# CHECK-NEXT: = PropGet v6 key="radius"
# CHECK-NEXT: Return v7
}

# The family of a declared type lists the type itself. Nothing allocates it, so it does not stand between the narrowed holder and the check
function f2 name="memberThatNothingAllocates" parameters=[{type=L0|L1|L4}] results=[{type=anything}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = Check v5 castType=L0
    v7 = PropGet v6 key="radius"
    Return v7
  b2():
    Return
# CHECK: b1(v4: 1):
# CHECK-NEXT: v5: L0 = NarrowByField v0, v4 key="kind"
# CHECK-NEXT: = PropGet v5 key="radius"
# CHECK-NEXT: Return v7
}

function f3 name="narrowingTakesNothingAway" parameters=[{type=L5|L6}] results=[{type=anything}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = PropGet v5 key="size"
    Return v6
  b2():
    Return
# CHECK: b1(v4: 1):
# CHECK-NEXT: = PropGet v0 key="size"
# CHECK-NEXT: Return v6
}

function f4 name="narrowingTakesUndefinedAway" parameters=[{type=undefined|L5|L6}] results=[{type=anything}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = PropGet v5 key="size"
    Return v6
  b2():
    Return
# CHECK: b1(v4: 1):
# CHECK-NEXT: v5: L5|L6 = NarrowByField v0, v4 key="kind"
# CHECK-NEXT: = PropGet v5 key="size"
# CHECK-NEXT: Return v6
}
