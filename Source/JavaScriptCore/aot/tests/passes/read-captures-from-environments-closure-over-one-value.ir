# A closure that captures one value and lies in no field of an environment stands for that value: where it only goes into calls and other closures to be taken apart there, or to be asked whether it is there, it is not made and what it captures goes in its place. A parameter that may also get undefined gets the absent value for that, and the question becomes whether the value is there. Where one function that gets it hands it out, everything stays.
# FORM: Prepared
# RUN: pass ReadCapturesFromEnvironments RemoveUnreadFields

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="count" declared={type=number}}, {key="uses" declared={type=f6}}]
layout L1 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 kind=Environment name="handsOut" fields=[{key="count" declared={type=number}}]

function f0 name="scope" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f1
    v3 = CallDirect v2, v0 function=f2
    v4 = CallDirect v2, v0 function=f3
    v5 = Undefined
    v6 = CallDirect v5, v0 function=f3
    v7 = CallDirect v2, v0 function=f5
    v8 = NewClosure v1, v2 function=f6
    PutEnvironmentField v1, v8 layout=L0 field=1
    v10 = CallDirect v1 function=f7
    v11 = Add v3, v4
    v12 = Add v6, v7
    v13 = Add v11, v12
    v14 = Add v13, v10
    Return v14
# CHECK-NOT: NewClosure
# CHECK: [[scope]]: env L0 = NewObject -, v0 layout=L0
# CHECK-NEXT: = CallDirect [[scope]], v0 function=f2
# CHECK-NEXT: = CallDirect [[scope]], v0 function=f3
# CHECK: [[nothing]]: absent = Absent
# CHECK-NEXT: = CallDirect [[nothing]], v0 function=f3
# CHECK-NEXT: = CallDirect [[scope]], v0 function=f5
# CHECK-NOT: PutEnvironmentField
# CHECK: = CallDirect [[scope]] function=f7
}

function f1 name="reads" captures=[{type=env L0}] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: env L0, v1: number):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = Add v1, v2
    Return v3
}

function f2 name="callsWhatItIsGiven" parameters=[{type=f1}, {type=number}] results=[{type=anything}] {
  b0(v0: f1, v1: number):
    v2 = GetCapture v0 function=f1
    v3 = CallDirect v2, v1 function=f1
    Return v3
# CHECK-NOT: GetCapture
# CHECK: b0(v0: env L0, v1: number):
# CHECK-NEXT: = CallDirect v0, v1 function=f1
}

function f3 name="callsIfGiven" parameters=[{type=undefined|f1}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|f1, v1: number):
    v2 = ToBoolean v0
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: f1):
    v4 = GetCapture v3 function=f1
    v5 = CallDirect v4, v1 function=f1
    Return v5
  b2():
    v6 = CallDirect v0, v1 function=f4
    Return v6
# CHECK-NOT: GetCapture
# CHECK: b0(v0: absent|env L0, v1: number):
# CHECK-NEXT: [[isThere]]: boolean = TypeTest v0 testedType=env L0
# CHECK-NEXT: Branch [[isThere]] -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1([[there]]: env L0):
# CHECK-NEXT: = CallDirect [[there]], v1 function=f1
# CHECK: = CallDirect v0, v1 function=f4
}

function f4 name="asksWhetherNothingCame" parameters=[{type=undefined|f1}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|f1, v1: number):
    v2 = TypeTest v0 testedType=undefined|null
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    Return v1
  b2(v3: f1):
    v4 = GetCapture v3 function=f1
    v5 = CallDirect v4, v1 function=f1
    Return v5
# CHECK-NOT: GetCapture
# CHECK: b0(v0: absent|env L0, v1: number):
# CHECK-NEXT: [[isMissing]]: boolean = TypeTest v0 testedType=absent
# CHECK-NEXT: Branch [[isMissing]] -> taken b1(), notTaken b2(| 0)
# CHECK: b2([[given]]: env L0):
# CHECK-NEXT: = CallDirect [[given]], v1 function=f1
}

function f5 name="asksWhetherItIsAFunction" parameters=[{type=undefined|f1}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|f1, v1: number):
    v2 = TypeTest v0 testedType=function
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: f1):
    v4 = GetCapture v3 function=f1
    v5 = CallDirect v4, v1 function=f1
    Return v5
  b2():
    Return v1
# CHECK-NOT: GetCapture
# CHECK: b0(v0: absent|env L0, v1: number):
# CHECK-NEXT: = TypeTest v0 testedType=env L0
}

function f6 name="uses" captures=[{type=env L0}, {type=f1}] results=[{type=anything}] {
  b0(v0: env L0, v1: f1):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = CallDirect v1, v2 function=f3
    Return v3
# CHECK: b0(v0: env L0, v1: env L0):
# CHECK: = CallDirect v1, {{*}} function=f3
}

function f7 name="callsUses" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=1
    v2 = GetCapture v1 function=f6
    v3 = GetCapture v1 function=f6 index=1
    v4 = CallDirect v2, v3 function=f6
    Return v4
# CHECK-NOT: GetCapture
# CHECK-NOT: GetEnvironmentField
# CHECK: = CallDirect v0, v0 function=f6
}

function f8 name="overAnObject" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = NewClosure v0 function=f9
    v2 = CallDirect v1 function=f10
    v3 = Undefined
    v4 = CallDirect v3 function=f10
    v5 = Add v2, v4
    Return v5
# CHECK-NOT: NewClosure
# CHECK: = CallDirect v0 function=f10
# CHECK: [[noObject]]: absent = Absent
# CHECK-NEXT: = CallDirect [[noObject]] function=f10
}

function f9 name="readsObject" captures=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = PropGet v0 key="x"
    Return v1
}

function f10 name="callsIfGivenOverAnObject" parameters=[{type=undefined|f9}] results=[{type=anything}] {
  b0(v0: undefined|f9):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: f9):
    v3 = GetCapture v2 function=f9
    v4 = CallDirect v3 function=f9
    Return v4
  b2():
    v5 = Integer integer=0
    Return v5
# CHECK-NOT: GetCapture
# CHECK: b0(v0: absent|L1):
# CHECK-NEXT: = TypeTest v0 testedType=anything
# CHECK: b1([[object]]: L1):
# CHECK-NEXT: = CallDirect [[object]] function=f9
}

function f11 name="handsOut" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f12
    v3 = CallDirect v2 function=f13
    v4 = CallDirect v2 function=f14
    v5 = Add v3, v4
    Return v5
# CHECK: [[kept]]: f12 = NewClosure {{*}} function=f12
# CHECK-NEXT: = CallDirect [[kept]] function=f13
# CHECK-NEXT: = CallDirect [[kept]] function=f14
}

function f12 name="readsOther" captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    Return v1
}

function f13 name="callsOther" parameters=[{type=undefined|f12}] results=[{type=anything}] {
  b0(v0: undefined|f12):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: f12):
    v3 = CallDirect v2 function=f14
    Return v3
  b2():
    Return v0
# CHECK: b0(v0: undefined|f12):
# CHECK-NEXT: = ToBoolean v0
}

function f14 name="handsOutWhatItIsGiven" parameters=[{type=f12}] results=[{type=anything}] {
  b0(v0: f12):
    Return v0
# CHECK: b0(v0: f12):
}
