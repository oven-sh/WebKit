# A loop that is not expected to run gets no tests: the number that it carries and takes the remainder of stays a number.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=EverythingIsCold
# RUN: pass ConvertCountersToIntegers

module m0 path="main.js" displayPath="main.js"
function f0 name="dividedWhileNothingRemains" parameters=[{type=number}, {type=int[2, 100]}] results=[{type=number}] {
    Jump -> next b1(v0)
  b1(v2: number):
    LoopHint
    v4 = Mod v2, v1
    v5 = Integer
    v6 = StrictEq v4, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Div v2, v1
    Jump -> next b1(v7)
  b3():
    Return v2
# CHECK-NOT: Upcast
}
