# What the flow analysis writes into the records of classes, layouts and sites is what the dispatch relies on
# FORM: AsRead
# OPTIONS: only-passes=ResolveCalls
# RUN: pipeline ResolveCalls
# CHECK: layout L0 {{*}}namedMembers=[{key="run" function=f2 mutability=Fixed closureUse=CalledOnly isWritableData=true}, {key="stop" function=f3 closureUse=CalledOnly isWritableData=true}, {key="stop" function=f10 closureUse=CalledOnly isWritableData=true}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Task" constructor=f1
layout L1 kind=Instance name="Job" constructor=f4
layout L2 kind=Instance name="Leaked" constructor=f6
layout L3 kind=Instance name="Panel" constructor=f8 fields=[{key="handler" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="run"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 index=1 key="stop"
    v6 = FinishClass v1 layout=L0
    v7 = NewClosure function=f4
    v8 = NewClass v7 layout=L1
    v9 = NewClosure function=f5
    DefineMethod v8, v9 layout=L1 key="run"
    v11 = FinishClass v8 layout=L1
    v12 = NewClosure function=f6
    v13 = NewClass v12 layout=L2
    v14 = NewClosure function=f7
    DefineMethod v13, v14 layout=L2 key="run"
    v16 = FinishClass v13 layout=L2
    v17 = NewClosure function=f8
    v18 = NewClass v17 layout=L3
    v19 = FinishClass v18 layout=L3
    v20 = PropGet v6 key="prototype"
    v21 = NewClosure function=f10
    PropSet v20, v21 key="stop"
    v23 = Construct v6
    v24 = Construct v11
    v25 = Construct v16
    v26 = Construct v19
    v27 = Builtin builtin=GlobalThis
    v28 = PropGet v27 key="text" [isFreeName]
    v29 = Builtin builtin=Function
    v30 = Construct v29, -, v28
    v31 = Call v30, -, v25
    v32 = CallDirect v23 function=f11
    v33 = CallDirect v24 function=f11
    v34 = CallDirect v23 function=f12
    v35 = CallDirect v25 function=f13
    v36 = CallDirect v26 function=f14
    Return
}
function f1 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L0}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="run" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0):
    Return
}
function f3 name="stop" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0):
    Return
}
function f4 name="Job" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L1}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f5 name="run" kind=Method flags=[HasThis] thisType={type=L1} results=[{type=anything}] {
  b0(v0):
    Return
}
function f6 name="Leaked" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L2}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f7 name="run" kind=Method flags=[HasThis] thisType={type=L2} results=[{type=anything}] {
