# CHECK-NOT: CallDirect
# CHECK: = PropGet v0 key="run"
# CHECK: , v0 calleeKey="run"
# CHECK-NOT: CallDirect
function f14 name="closure-over-its-own-object" parameters=[{type=anything}] results=[{type=anything}] {
