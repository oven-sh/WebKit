function f9 name="handler" kind=Arrow captures=[{type=L3}] results=[{type=anything}] {
  b0(v0):
    Return
}
function f10 name="replacement" results=[{type=anything}] {
  b0():
    Return
}

function f11 name="two-classes" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
}
# CHECK-LABEL: function f11 name="two-classes"
# CHECK: b0(v0: L0|L1):
# CHECK: = TypeTest v0 testedType=L0
# CHECK: = CallDirect {{*}} function=f2
# CHECK: = CallDirect {{*}} function=f5
# CHECK-NOT: = Call v
function f12 name="replaced-method-and-its-neighbor" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="stop"
    v2 = Call v1, v0 calleeKey="stop"
    v3 = PropGet v0 key="run"
    v4 = Call v3, v0 calleeKey="run"
    Return v4
}
