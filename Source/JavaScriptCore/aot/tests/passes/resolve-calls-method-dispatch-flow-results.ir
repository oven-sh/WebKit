}
function f8 name="Panel" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L3}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    v3 = NewClosure v2 function=f9
    PropDefine v2, v3 key="handler"
    Return v2
