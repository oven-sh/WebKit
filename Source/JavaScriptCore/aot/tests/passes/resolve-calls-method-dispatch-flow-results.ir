# What the flow analysis writes into the records of classes, layouts and sites is what the dispatch relies on
# FORM: AsRead
# OPTIONS: only-passes=ResolveCalls
# RUN: pipeline ResolveCalls
# CHECK: layout L0 {{*}}namedMembers=[{key="run" function=f2 mutability=Fixed closureUse=CalledOnly isWritableData=true}, {key="stop" function=f3 closureUse=CalledOnly isWritableData=true}, {key="stop" function=f8 isWritableData=true}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Task" constructor=f1
layout L1 kind=Instance name="Job" constructor=f4
layout L2 kind=Instance name="Leaked" constructor=f6
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="run"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 index=1 key="stop"
    v6 = FinishClass v1 layout=L0
    v7 = NewClosure function=f4
    v8 = NewClass v7 layout=L1
    v9 = NewClosure function=f5
    DefineMethod v8, v9 layout=L1 key="run"
    v11 = FinishClass v8 layout=L1
    v12 = NewClosure function=f6
    v13 = NewClass v12 layout=L2
    v14 = NewClosure function=f7
    DefineMethod v13, v14 layout=L2 key="run"
    v16 = FinishClass v13 layout=L2
    v17 = PropGet v6 key="prototype"
    v18 = NewClosure function=f8
    PropSet v17, v18 key="stop"
    v20 = Construct v6
    v21 = Construct v11
    v22 = Construct v16
    v23 = Builtin builtin=GlobalThis
    v24 = PropGet v23 key="text" [isFreeName]
    v25 = Builtin builtin=Function
    v26 = Construct v25, -, v24
    v27 = Call v26, -, v22
    v28 = CallDirect v20 function=f9
    v29 = CallDirect v21 function=f9
    v30 = CallDirect v20 function=f10
    v31 = CallDirect v22 function=f11
    Return
}
function f1 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="run" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0):
    Return
}
function f3 name="stop" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0):
    Return
}
function f4 name="Job" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f5 name="run" kind=Method flags=[HasThis] thisType={type=L1} results=[{type=anything}] {
  b0(v0):
    Return
}
function f6 name="Leaked" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f7 name="run" kind=Method flags=[HasThis] thisType={type=L2} results=[{type=anything}] {
  b0(v0):
    Return
}
function f8 name="replacement" results=[{type=anything}] {
    Return
}

function f9 name="two-classes" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
# CHECK: b0(v0: L0|L1):
# CHECK: = TypeTest {{*}} testedType=L0
# CHECK: = CallDirect {{*}} function=f2
# CHECK: = CallDirect {{*}} function=f5
# CHECK-NOT: = Call v
}
function f10 name="replaced-method-and-its-neighbor" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="stop"
    v2 = Call v1, v0 calleeKey="stop"
    v3 = PropGet v0 key="run"
    v4 = Call v3, v0 calleeKey="run"
    Return v4
# CHECK: b0(v0: L0):
# CHECK: = AreMembersUnchanged conditions=[{layout=L0 key="stop"}]
# CHECK-NOT: key="run"
# CHECK: = CallDirect v0 function=f2
# CHECK-NOT: key="run"
# CHECK: = CallDirect v0 function=f3
# CHECK: = PropGet v0 key="stop"
# CHECK: calleeKey="stop"{{*}}callees=[f3, f8]
}
function f11 name="object-reached-unknown-javascript" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
# CHECK: b0(v0: object):
# CHECK-NOT: CallDirect
# CHECK: = PropGet [[leaked]] key="run"
# CHECK: , [[leaked]] calleeKey="run"
# CHECK-NOT: CallDirect
# CHECK: Return
}
