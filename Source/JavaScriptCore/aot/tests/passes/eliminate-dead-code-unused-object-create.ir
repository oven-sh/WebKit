# An ordinary object that nobody uses is not created: a built-in that only allocates, uses the run time and may resolve ropes leaves nothing behind. With a map of descriptors Object.create runs code of the program
# An object of the program that is handed to Object.create is a prototype from then on, so that call stays. A prototype object of the language is one from the start
# FORM: Prepared
# RUN: pass EliminateDeadCode

module m0 path="main.js" displayPath="main.js"
layout L0 name="Holder" fields=[{key="a" declared={type=anything}}]
function f0 name="underObjectPrototype" results=[{type=undefined}] {
    v0 = Builtin builtin=ObjectPrototype
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    v2 = AssumeType v1 provenType=object
    Return
# CHECK-NOT: ObjectCreate
}

function f1 name="underNull" results=[{type=undefined}] {
    v0 = Null
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    Return
# CHECK-NOT: ObjectCreate
}

function f2 name="underAnotherObject" parameters=[{type=L0}] results=[{type=undefined}] {
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    Return
# CHECK: = CallBuiltin -, v0 overload=ObjectCreate/0
}

function f3 name="used" results=[{type=anything}] {
    v0 = Builtin builtin=ObjectPrototype
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    Return v1
# CHECK: = CallBuiltin -, v0 overload=ObjectCreate/0
}

function f4 name="withDescriptors" parameters=[{type=L0}] results=[{type=undefined}] {
    v1 = Null
    v2 = CallBuiltin -, v1, v0 overload=ObjectCreate/1
    Return
# CHECK: = CallBuiltin -, v1, v0 overload=ObjectCreate/1
}

function f5 name="underAnObjectOrNull" parameters=[{type=null|object}] results=[{type=undefined}] {
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    Return
# CHECK: = CallBuiltin -, v0 overload=ObjectCreate/0
}
