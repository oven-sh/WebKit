# A variable stored at most once keeps the value a check has seen on both sides of unknown code
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="settled" module=m0 declared={type=anything|absent} flow={writers=AllKnown stores=AtMostOnce}
variable g1 name="storedTwice" module=m0 declared={type=anything|absent} flow={writers=AllKnown}
variable g2 name="unknownWriters" module=m0 declared={type=anything|absent} flow={stores=AtMostOnce}

function f0 name="checkedBeforeCall" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="settled"
    v3 = Call v0
    v4 = GetModuleVariable variable=g0
    v5 = CheckInitialized v4 name="settled"
    Return v5
# CHECK: v2: anything = CheckInitialized v1
# CHECK-NEXT: = Call v0
# CHECK-NEXT: v4: anything = Upcast v2
# CHECK-NOT: GetModuleVariable
}

function f1 name="storedBeforeCall" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PutModuleVariable v1 variable=g0
    v3 = Call v0
    v4 = GetModuleVariable variable=g0
    v5 = CheckInitialized v4 name="settled"
    Return v5
# CHECK: = Call v0
# CHECK-NEXT: v4: anything = Upcast v1
# CHECK-NOT: GetModuleVariable
}

function f2 name="readWithoutCheck" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = Call v0
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="settled"
    Return v4
# CHECK: = Call v0
# CHECK-NEXT: v3: anything|absent = GetModuleVariable variable=g0
}

function f3 name="storedTwice" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g1
    v2 = CheckInitialized v1 name="storedTwice"
    v3 = Call v0
    v4 = GetModuleVariable variable=g1
    v5 = CheckInitialized v4 name="storedTwice"
    Return v5
# CHECK: = Call v0
# CHECK-NEXT: v4: anything|absent = GetModuleVariable variable=g1
}

function f4 name="unknownWriters" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g2
    v2 = CheckInitialized v1 name="unknownWriters"
    v3 = Call v0
    v4 = GetModuleVariable variable=g2
    v5 = CheckInitialized v4 name="unknownWriters"
    Return v5
# CHECK: = Call v0
# CHECK-NEXT: v4: anything|absent = GetModuleVariable variable=g2
}

function f5 name="storesTwice" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
    PutModuleVariable v0 variable=g1
    PutModuleVariable v1 variable=g1
    Return
}
# CHECK-LABEL: function f5 name="storesTwice"

function f6 name="checkedOnOnePath" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = CheckInitialized v1 name="settled"
    Jump -> next b2()
  b2():
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="settled"
    Return v4
# CHECK: b2():
# CHECK-NEXT: v3: anything|absent = GetModuleVariable variable=g0
}

function f7 name="checkedUnderHandler" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1() handler=b3():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="settled"
    v3 = Call v0
    Jump -> next b2()
  b2():
    v4 = GetModuleVariable variable=g0
    v5 = CheckInitialized v4 name="settled"
    Return v5
  b3() role=CatchHandler:
    v6 = CatchValue
    v7 = GetModuleVariable variable=g0
    v8 = CheckInitialized v7 name="settled"
    Return v8
# CHECK: b2():
# CHECK-NEXT: v4: anything = Upcast v2
# CHECK: = CatchValue
# CHECK-NEXT: v7: anything|absent = GetModuleVariable variable=g0
}
