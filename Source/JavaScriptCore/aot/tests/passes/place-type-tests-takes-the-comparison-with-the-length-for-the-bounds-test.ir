# function squares(count: number): number[] { const list = new Array<number>(count); for (let k = 0; k < count; k++) list[k] = k * k; return list; }
# function measured(count: number): number[] { const list = new Array<number>(count); for (let k = 0; k < list.length; k++) list[k] = k; return list; }
# function shrinks(count: number): number[] { const list = new Array<number>(count); for (let k = 0; k < count; k++) { list.pop(); list[k] = 7; } return list; }
# function others(list: number[]): number[] { for (let k = 0; k < list.length; k++) list[k] = k; return list; }
# declare const input: any;
# (globalThis as any).answer = [squares(input | 0), measured(input | 0), shrinks(input | 0), others([input | 0])];
# A list made with a length and filled up to it, compared with that length or with its own: the test that the position is inside stands behind the comparison and the access relies on it. Where the list may have got shorter the access asks again, and other lists are left alone.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline FinishBirths
# CHECK-LABEL: name="squares"
# CHECK: = IsInBounds {{*}} [isFromProgram]
# CHECK-LABEL: name="measured"
# CHECK: = IsInBounds {{*}} [isFromProgram]
# CHECK-LABEL: name="shrinks"
# CHECK-NOT: [isFromProgram]
# CHECK: PutArrayElement {{*}} isInBounds
# CHECK-LABEL: name="others"
# CHECK-NOT: [isFromProgram]
# CHECK: PutArrayElement {{*}} isInBounds

