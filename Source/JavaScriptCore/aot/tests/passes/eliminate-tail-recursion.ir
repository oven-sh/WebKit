# A direct tail call of the function itself becomes a loop
# FORM: Prepared
# RUN: pass EliminateTailRecursion
# STATISTIC: TailRecursionsEliminated = 3

module m0 path="main.js" displayPath="main.js"
typesite w0 kind=Assertion

function f0 name="sum" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = ToBoolean v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v1, v0 function=f0
    ReturnCall v3
  b2():
    Return v1
}
# CHECK-LABEL: function f0 name="sum"
# CHECK-NOT: CallDirect
# CHECK: Jump -> next [[sum0]](v0, v1)
# CHECK: Jump -> next [[sum0]]([[second0]], [[first0]])
# CHECK: [[sum0]]([[first0]]: number, [[second0]]: number)
# CHECK-NEXT: LoopHint
# CHECK-NOT: CallDirect

function f1 name="resultPassedToReturningBlock" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f1
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    Return v3
}
# CHECK-LABEL: function f1 name="resultPassedToReturningBlock"
# CHECK-NOT: LoopHint
# CHECK: = CallDirect
# CHECK-NOT: LoopHint

function f2 name="siteInEntryBlock" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f2
    ReturnCall v1
}
# CHECK-LABEL: function f2 name="siteInEntryBlock"
# CHECK: b0(v0: number)
# CHECK-NEXT: Jump -> next [[entry2]](v0)
# CHECK: [[entry2]]([[carried2]]: number)
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Jump -> next [[entry2]]([[carried2]])

function f3 name="method" kind=Method flags=[HasThis] captures=[{type=number}] thisType={type=anything} parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number, v1: anything, v2: number):
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = CallDirect v0, v1, v2 function=f3
    ReturnCall v4
  b2():
    Return v0
}
# CHECK-LABEL: function f3 name="method"
# CHECK-NOT: CallDirect
# CHECK: Jump -> next [[method3]](v0, v1, v2)
# CHECK: [[method3]]({{*}}: number, {{*}}: anything, {{*}}: number)
# CHECK-NOT: CallDirect

function f4 name="underHandler" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b3():
    v1 = CallDirect v0 function=f4
    Jump -> next b2()
  b2():
    Return v1
  b3() role=CatchHandler:
    v2 = CatchValue
    Return v0
}
# CHECK-LABEL: function f4 name="underHandler"
# CHECK-NOT: LoopHint
# CHECK: = CallDirect
# CHECK-NOT: LoopHint

function f5 name="checked" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f5
    v2 = Check v1 castType=i32 site=w0
    Return v2
}
# CHECK-LABEL: function f5 name="checked"
# CHECK-NOT: LoopHint
# CHECK: = CallDirect
# CHECK-NOT: LoopHint

function f6 name="ordinaryCall" flags=[IsSloppy] parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f6
    Return v1
}
# CHECK-LABEL: function f6 name="ordinaryCall"
# CHECK-NOT: LoopHint
# CHECK: = CallDirect
# CHECK-NOT: LoopHint

function f7 name="otherFunction" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f0
    ReturnCall v1
}
# CHECK-LABEL: function f7 name="otherFunction"
# CHECK-NOT: LoopHint
# CHECK: = CallDirect
# CHECK-NOT: LoopHint
