# The mark that a validating build puts on a read which leaves a block of the loop is for its checks at run time. No pass reads it: the loop is split on a test in front of it, as in any other build
# FORM: Prepared
# OPTIONS: validate
# RUN: pass HoistLoopInvariantReads SplitUnions

module m0 path="main.js" displayPath="main.js"
variable g0 name="elements" declared={type=Array<number>|Uint8Array} flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}

function f0 name="readInBody" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    Branch v0 -> taken b2(), notTaken b4()
  b2():
    v6 = GetModuleVariable variable=g0
    v7 = PropGet v6 key="length"
    v8 = Less v4, v7
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    v9 = ElemGet v6, v4
    v10 = Add v3, v9
    v11 = Increment v4
    Jump -> next b1(v10, v11)
  b4():
    Return v3
}
# CHECK: b0(
# CHECK: v6: Array<number>|Uint8Array = GetModuleVariable variable=g0 [isValidatedWhereLookedAt]
# CHECK-NEXT: Jump -> next [[tests]]()
# CHECK: [[tests]]():
# CHECK-NEXT: = TypeTest v6 testedType=Uint8Array
# CHECK-NEXT: Branch
