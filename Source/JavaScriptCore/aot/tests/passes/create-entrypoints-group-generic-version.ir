function f10 name="passesNumber" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    Return v2
}
function f11 name="passesString" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="text"
    v2 = Call v0, -, v1
    Return v2
}
function f12 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
