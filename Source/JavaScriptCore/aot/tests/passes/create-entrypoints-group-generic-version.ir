# A member with a generic version, in a group whose types are wider than its proven parameters: its group entrypoint enters the generic version, which takes anything
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# OPTIONS: check=VerifyEachPass only-passes=GroupCallsByValue,ChooseCallingConventions
# STATISTIC: FlowGenericVersions = 1
# STATISTIC: GroupEntrypoints = 9

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = NewClosure function=f7
    v7 = NewClosure function=f8
    v8 = NewClosure function=f9
    v9 = CallDirect v0 function=f10
    v10 = CallDirect v1 function=f10
    v11 = CallDirect v2 function=f10
    v12 = CallDirect v3 function=f10
    v13 = CallDirect v4 function=f10
    v14 = CallDirect v4 function=f11
    v15 = CallDirect v5 function=f11
    v16 = CallDirect v6 function=f11
    v17 = CallDirect v7 function=f11
    v18 = CallDirect v8 function=f11
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="register" [isFreeName]
    v21 = Call v20, -, v0
    v22 = CallDirect function=f12
    Return
}
function f1 name="versioned" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Mul v0, v0
    v2 = Add v1, v0
    Return v2
}
