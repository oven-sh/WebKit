# A literal that reaches unknown code answers at run time, and a literal that stays in its function still folds
# FORM: AsRead
# RUN: pipeline FoldConstantRegExps
# OPTIONS: only-passes=FoldConstantRegExps

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}

function f1 name="staysInFunction" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" @10
    v1 = PropGet v0 key="source" @11
    Return v1
}
# CHECK-LABEL: function f1 name="staysInFunction"
# CHECK: v1: "a+" = String string="a+"

function f2 name="reachesUnknownCode" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="b" @20
    v1 = Builtin builtin=GlobalThis @21
    v2 = PropGet v1 key="sink" [isFreeName] @22
    v3 = Call v2, -, v0 @23
    v4 = PropGet v0 key="source" @24
    Return v4
}
# CHECK-LABEL: function f2 name="reachesUnknownCode"
# CHECK-NOT: = String
