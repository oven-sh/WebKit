# An iteration over undefined or null throws, so an expectation of nothing else says nothing about what is iterated:
# the value is tested for an array, like an iterable that nobody knows anything about.
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 2
# STATISTIC: IterationsExpandedGenerically = 1

module m0 path="main.js" displayPath="main.js"

function f0 name="expectedToBeUndefined" parameters=[{type=undefined flags=[IsExpected]}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything ~ undefined, v1: anything):
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
# CHECK: = TypeTest v0 testedType=Array
}

function f1 name="expectedToBeUndefinedOrNull" parameters=[{type=undefined|null flags=[IsExpected]}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything ~ undefined|null, v1: anything):
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
# CHECK: = TypeTest v0 testedType=Array
}

function f2 name="expectedToBeANumber" parameters=[{type=number flags=[IsExpected]}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything ~ number, v1: anything):
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
# CHECK-NOT: testedType=Array
}
