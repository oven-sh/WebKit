# With the pass off a chain of three comparisons of one integer with constants stays a chain of branches
# FORM: Prepared
# OPTIONS: disable=pass:InferSwitches
# RUN: pass InferSwitches
# STATISTIC: InferSwitchesChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="threeTests" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=1
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Integer integer=2
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f0 name="threeTests"
# CHECK-NEXT: b0(v0: i32):
# CHECK-NEXT: v1: 0 = Integer
# CHECK-NEXT: v2: boolean = StrictEq v0, v1
# CHECK-NEXT: Branch v2 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
# CHECK-NEXT: b2():
# CHECK-NEXT: v3: 1 = Integer integer=1
# CHECK-NEXT: v4: boolean = StrictEq v0, v3
# CHECK-NEXT: Branch v4 -> taken b3(), notTaken b4()
# CHECK-NEXT: b3():
# CHECK-NEXT: Return v0
# CHECK-NEXT: b4():
# CHECK-NEXT: v5: 2 = Integer integer=2
# CHECK-NEXT: v6: boolean = StrictEq v0, v5
