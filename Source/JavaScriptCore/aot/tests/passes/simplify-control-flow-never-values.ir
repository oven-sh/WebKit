# A block that ends at a value that never completes stays as it is, with its handler
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="underHandler" results=[{type=anything}] {
  b0() handler=b1():
    v0 = CallDirect function=f2
    Unreachable
  b1() role=CatchHandler:
    v1 = CatchValue
    Return v1
}
# CHECK-LABEL: function f0 name="underHandler"
# CHECK: b0() handler=b1():
# CHECK-NEXT: = CallDirect
# CHECK-NEXT: Unreachable
# CHECK: = CatchValue

function f1 name="lastValue" results=[{type=undefined}] {
  b0():
    v0 = CallDirect function=f2
    Unreachable
}
# CHECK-LABEL: function f1 name="lastValue"
# CHECK: = CallDirect
# CHECK-NEXT: Unreachable

function f2 name="alwaysThrows" results=[{type=never}] {
  b0():
    v0 = Undefined
    Throw v0
}
# CHECK-LABEL: function f2 name="alwaysThrows"
# CHECK: Throw v0
