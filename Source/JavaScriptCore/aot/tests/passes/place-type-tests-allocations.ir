# The type of a fresh object names its layout for good. The allocation is the proof of what lasts for a stretch only: the slots it fills, no extra properties, not frozen,
# the pristine state and the kind of storage of an array. So a use of a fresh object needs no test, until something may have changed the object
# FORM: Prepared
# RUN(PLAN): test-placement
# RUN(IR): pass PlaceTypeTests
# RUN(F9): test-placement function=f9 site=v2:v3
# RUN(F10): test-placement function=f10 site=v2:v3
# RUN(F11): test-placement function=f11 site=v2:v3,v4,v5
# RUN(F12): test-placement function=f12 site=v2:v6,v3 site=v5:v6,v3
# RUN(F13): test-placement function=f13 site=v3:v4
# RUN(F14): test-placement function=f14 site=v1:v2
# RUN(F17): test-placement function=f17 site=v3:v4
# RUN(F18): test-placement function=f18 site=v2:v3
# RUN(F19): test-placement function=f19 site=v3:v4

module m0 path="main.js" displayPath="main.js"
# A field that is not always filled may be redefined here, so it may lie outside its slot: a read tests that the slot is filled.
layout L0 name="Filled" fields=[{key="a" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Other" fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}]
layout L2 name="Sparse" fields=[{key="a" declared={type=string} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}, {key="b" declared={type=string} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 kind=Instance name="Shape" constructor=f15 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="area" kind=Method function=f16 mutability=Fixed}]}

