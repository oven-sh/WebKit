# A small function is never compact: without its tests it saves few bytes, and the small ones are what is entered most. The size of a function is the number of its values and one for the end of each block
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f1 Cold 10 1
# CHECK-NEXT: f2 Compact 10 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return
}

function f1 name="small" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    v2 = ToBoolean v0
    v3 = ToBoolean v0
    v4 = ToBoolean v0
    v5 = ToBoolean v0
    v6 = ToBoolean v0
    v7 = ToBoolean v0
    v8 = ToBoolean v0
    v9 = ToBoolean v0
    v10 = ToBoolean v0
    v11 = ToBoolean v0
    v12 = ToBoolean v0
    v13 = ToBoolean v0
    v14 = ToBoolean v0
    v15 = ToBoolean v0
    v16 = ToBoolean v0
    v17 = ToBoolean v0
    v18 = ToBoolean v0
    v19 = ToBoolean v0
    v20 = ToBoolean v0
    v21 = ToBoolean v0
    v22 = ToBoolean v0
    v23 = ToBoolean v0
    v24 = ToBoolean v0
    v25 = ToBoolean v0
    v26 = ToBoolean v0
    v27 = ToBoolean v0
    v28 = ToBoolean v0
    v29 = ToBoolean v0
    v30 = ToBoolean v0
    v31 = ToBoolean v0
    Return v0
}

function f2 name="oneValueMore" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    v2 = ToBoolean v0
    v3 = ToBoolean v0
    v4 = ToBoolean v0
    v5 = ToBoolean v0
    v6 = ToBoolean v0
    v7 = ToBoolean v0
    v8 = ToBoolean v0
    v9 = ToBoolean v0
    v10 = ToBoolean v0
    v11 = ToBoolean v0
    v12 = ToBoolean v0
    v13 = ToBoolean v0
    v14 = ToBoolean v0
    v15 = ToBoolean v0
    v16 = ToBoolean v0
    v17 = ToBoolean v0
    v18 = ToBoolean v0
    v19 = ToBoolean v0
    v20 = ToBoolean v0
    v21 = ToBoolean v0
    v22 = ToBoolean v0
    v23 = ToBoolean v0
    v24 = ToBoolean v0
    v25 = ToBoolean v0
    v26 = ToBoolean v0
    v27 = ToBoolean v0
    v28 = ToBoolean v0
    v29 = ToBoolean v0
