# Six closures held in an array are called by value in a loop that reads the array. They leave the array alone, so its test stands in front of the loop, and it still holds once the functions that nothing enters have lost their bodies: the callees keep theirs beside the copies in their entrypoints
# FORM: AsRead
# RUN: pipeline RemoveUnreachableFunctions
# OPTIONS: check=VerifyEachPass

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = NewArray v0, v1, v2, v3, v4, v5 contents=anything
    v7 = NewClosure function=f7
    v8 = Call v7, -, v6 [isNeverInlined]
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="sink" [isFreeName]
    v11 = Call v10, -, v8
    Return
}
function f1 name="first" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=1.5
    v2 = Add v0, v1
    Return v2
}
function f2 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=2.5
    v2 = Add v0, v1
    Return v2
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=3.5
    v2 = Add v0, v1
    Return v2
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=4.5
    v2 = Add v0, v1
    Return v2
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=5.5
    v2 = Add v0, v1
    Return v2
}
function f6 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Double number=6.5
    v2 = Add v0, v1
    Return v2
}
function f7 name="callByIndex" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Double number=0.5
    Jump -> next b1(v1, v2)
  b1(v3: anything, v4: anything):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v3, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v3
    v9 = Double number=1.5
    v10 = Call v8, -, v9
    v11 = Add v4, v10
    v12 = Integer integer=1
    v13 = Add v3, v12
    Jump -> next b1(v13, v11)
  b3():
    Return v4
# CHECK: LoopHint
# CHECK-NOT: = HasArrayStorage
# CHECK-NOT: = IsPristine
# CHECK: = GetArrayElement
# CHECK-NOT: = HasArrayStorage
# CHECK-NOT: = IsPristine
# CHECK: = Call{{*}}callees=[
}
