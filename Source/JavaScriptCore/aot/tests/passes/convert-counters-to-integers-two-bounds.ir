# `if (i + 1 > n) break; if (i >= length) break; i = i + 1;`: the step stands behind a test of the counter itself and has its bound from there. It is the number that the first
# test has let through, so that is what the turn hands on; of a bound of any size the test says nothing, and the step keeps what it knew. The counter got wider than the result that was declared by it.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass ConvertCountersToIntegers
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="boundOfAnySize" parameters=[{type=int[0, 4294967295]}, {type=int}] results=[{type=int[0, 4294967295]}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
# CHECK: b1(v3: int[0, 4294967295]):
  b1(v3):
    LoopHint
    v5 = Integer integer=1
    v6 = Add v3, v5
    v7 = LessEq v6, v1
    Branch v7 -> taken b2(), notTaken b4()
# CHECK: b2([[tested0]]: int[1, 4294967296]):
  b2():
    v8 = GreaterEq v3, v0
    Branch v8 -> taken b4(), notTaken b3(| 0)
  b3(v9):
    v10 = Integer integer=1
    v11 = Add v9, v10
# CHECK: v11: int[1, 4294967295] = AssumeType [[tested0]] provenType=int[1, 4294967295]
# CHECK-NEXT: Jump -> next b1(v11)
    Jump -> next b1(v11)
  b4():
    Return v3
}

# Below an int32 the first test says more than the second, and the counter takes both.
function f1 name="boundIsAnInt32" parameters=[{type=int[0, 4294967295]}, {type=i32}] results=[{type=int[0, 4294967295]}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
# CHECK: b1(v3: int[0, 2147483647]):
  b1(v3):
    LoopHint
    v5 = Integer integer=1
    v6 = Add v3, v5
    v7 = LessEq v6, v1
    Branch v7 -> taken b2(), notTaken b4()
  b2():
    v8 = GreaterEq v3, v0
    Branch v8 -> taken b4(), notTaken b3(| 0)
  b3(v9):
    v10 = Integer integer=1
    v11 = Add v9, v10
    Jump -> next b1(v11)
  b4():
    Return v3
}
