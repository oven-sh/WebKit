# A cast of what an earlier cast has let through asks only for what that one left open, so it reads the earlier cast. Not where nothing is left open:
# a check that nothing passes is typed by its cast type, as behind a check that passed, and that is more than the check let through of the wider operand.
# Its type and the types behind it would be out of date, so it goes on reading the value it read
# FORM: Prepared
# RUN: pass SimplifyCasts VerifyProgram
# CHECK: v1: L0|L1 = Check v0 castType=L0|L1
# CHECK-NEXT: v2: L2 = Check v0 castType=undefined|L2

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="A"
layout L1 name="B"
layout L2 name="C"
function f0 name="twoChecks" parameters=[{type=L0|L1|L2}] results=[{type=anything}] {
    v1 = Check v0 castType=L0|L1
    v2 = Check v0 castType=undefined|L2
    v3 = NewArray v1, v2 contents=anything
    Return v3
}
