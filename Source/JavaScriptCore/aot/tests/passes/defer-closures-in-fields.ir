# A field defers the closures of one function, over nothing, over the object or over the one environment that the members of the object share. Where nothing else can see the object before the store,
# the allocation lists the closure, which is made on demand, and the reads of the field make it. Any other store of such a closure stays a store (defer-closures-in-fields-at-stores.ir).
# The shared environment is listed in a hidden field, so a closure over an environment is deferred only where every allocation of the layout lists it and nothing else comes into the field
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass DeferClosuresInFields
# STATISTIC: FieldsDeferringClosures = 21
# STATISTIC: ClosuresDeferredInFields = 22
# STATISTIC: StoresListedByAllocations = 11
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance name="StoredBehindTheAllocation" constructor=f1 fields=[{key="count" declared={type=anything}}, {key="onData" declared={type=function}}, {key="onEnd" declared={type=function} flow={stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="onError" declared={type=function}}]
layout L1 name="ListedAsUndefinedFirst" fields=[{key="id" declared={type=anything}}, {key="read" declared={type=undefined|object} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="last" declared={type=anything}}]
layout L2 name="ListedByTheAllocation" fields=[{key="run" declared={type=object} flow={stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L3 name="OtherStoresBetween" fields=[{key="first" declared={type=anything}}, {key="name" declared={type=anything}}, {key="items" declared={type=anything}}, {key="second" declared={type=anything}}]
layout L4 name="TwoAllocations" fields=[{key="run" declared={type=object} flow={stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L5 name="ClosureUsedTwice" fields=[{key="run" declared={type=anything}}]
layout L6 name="StoredBehindCall" fields=[{key="run" declared={type=anything}}]
layout L7 name="StoredBehindRead" fields=[{key="id" declared={type=anything}}, {key="run" declared={type=anything}}]
layout L8 name="TwoFunctions" fields=[{key="run" declared={type=anything}}]
layout L9 name="OneAllocationGivesNothing" fields=[{key="run" declared={type=anything}}]
layout L10 name="StoredElsewhere" fields=[{key="run" declared={type=anything}}]
layout L11 kind=Instance name="HasSubclass" constructor=f2 fields=[{key="run" declared={type=anything}}]
layout L12 kind=Instance name="Subclass" base=L11 constructor=f3 fields=[{key="own" declared={type=anything}}, {key="run" declared={type=anything} flags=[IsInherited] originLayout=L11 originField=0}] flags=[HasHeritage] ownFieldCount=1 flow={baseState=Layout base=L11}
layout L13 name="BehindStoreThatStays" fields=[{key="self" declared={type=object}}, {key="run" declared={type=anything}}]
