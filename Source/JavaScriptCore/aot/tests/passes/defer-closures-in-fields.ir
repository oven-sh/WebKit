function f5 name="fieldsThatKeepTheirClosures" module=m0 parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewClosure function=f9
    v3 = NewObject -, v2 layout=L5 fields=[0]
    PutModuleVariable v2 variable=g0
    v5 = NewObject layout=L6 fields=[]
    v6 = Call v0
    v7 = NewClosure v5 function=f7
    PutSlotOrAdd v5, v5, v7 key="run" receivers=[L6] level=Proven
    v9 = NewObject -, v0 layout=L7 fields=[0]
    v10 = GetSlotOrUndefined v9, v9 key="id" receivers=[L7] level=Proven
    v11 = NewClosure v9 function=f7
    PutSlotOrAdd v9, v9, v11 key="run" receivers=[L7] level=Proven
    v13 = NewClosure function=f9
    v14 = NewObject -, v13 layout=L8 fields=[0]
    v15 = NewClosure function=f10
    v16 = NewObject -, v15 layout=L8 fields=[0]
    v17 = NewClosure function=f9
    v18 = NewObject -, v17 layout=L9 fields=[0]
    v19 = NewObject layout=L9 fields=[]
    v20 = NewClosure function=f9
    v21 = NewObject -, v20 layout=L10 fields=[0]
    PutModuleVariable v21 variable=g0
    PutSlot v21, v21, v0 key="run" receivers=[L10] level=Proven
    v24 = NewObject layout=L13 fields=[]
    PutSlotOrAdd v24, v24, v24 key="self" receivers=[L13] level=Proven
    v26 = NewClosure v24 function=f7
    PutSlotOrAdd v24, v24, v26 key="run" receivers=[L13] level=Proven
    v28 = NewObject -, v0 layout=L16 fields=[0]
    v29 = NewClosure v28 function=f11
    v30 = NewObject -, v29 layout=L15 fields=[0]
    v31 = NewClosure function=f9
    Jump -> next b1()
  b1():
    LoopHint
    v33 = NewObject -, v31 layout=L14 fields=[0]
    PutModuleVariable v33 variable=g0
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v10
}
