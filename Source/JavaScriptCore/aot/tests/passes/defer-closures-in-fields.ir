# CHECK-NEXT: layout L15 {{*}}{key="run" {{*}}deferral=CapturesEnvironment deferredFunction=f11}{{*}}IsHidden{{*}}closureEnvironmentField=1
# CHECK: layout L17 name="ReadWithFieldThatMayBeEmpty" fields=[{key="shared" declared={type=anything} flow={location={initialization=SetAtCreation deferral=CapturesNothing deferredFunction=f9}}}]
