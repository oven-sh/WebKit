# A field defers its closure where every allocation of its layout gives it a closure of one function, over nothing or over the object, before anything else can see the object.
# The allocation lists the closure, which is made on demand, and the reads of the field make it
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass DeferClosuresInFields
# STATISTIC: FieldsDeferringClosures = 10
# STATISTIC: ClosuresDeferredInFields = 11
# STATISTIC: StoresListedByAllocations = 10
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance name="StoredBehindTheAllocation" constructor=f1 fields=[{key="count" declared={type=anything}}, {key="onData" declared={type=function}}, {key="onEnd" declared={type=function}}, {key="onError" declared={type=function}}]
layout L1 name="ListedAsUndefinedFirst" fields=[{key="id" declared={type=anything}}, {key="read" declared={type=anything}}, {key="last" declared={type=anything}}]
layout L2 name="ListedByTheAllocation" fields=[{key="run" declared={type=anything}}]
layout L3 name="OtherStoresBetween" fields=[{key="first" declared={type=anything}}, {key="name" declared={type=anything}}, {key="items" declared={type=anything}}, {key="second" declared={type=anything}}]
layout L4 name="TwoAllocations" fields=[{key="run" declared={type=anything}}]
layout L5 name="ClosureUsedTwice" fields=[{key="run" declared={type=anything}}]
layout L6 name="StoredBehindCall" fields=[{key="run" declared={type=anything}}]
layout L7 name="StoredBehindRead" fields=[{key="id" declared={type=anything}}, {key="run" declared={type=anything}}]
layout L8 name="TwoFunctions" fields=[{key="run" declared={type=anything}}]
layout L9 name="OneAllocationGivesNothing" fields=[{key="run" declared={type=anything}}]
layout L10 name="StoredElsewhere" fields=[{key="run" declared={type=anything}}]
layout L11 kind=Instance name="HasSubclass" constructor=f2 fields=[{key="run" declared={type=anything}}]
layout L12 kind=Instance name="Subclass" predictedBase=L11 constructor=f3 fields=[{key="own" declared={type=anything}}, {key="run" declared={type=anything} flags=[IsInherited] originLayout=L11 originField=0}] flags=[HasHeritage] ownFieldCount=1 flow={baseState=Layout base=L11}
layout L13 name="BehindStoreThatStays" fields=[{key="self" declared={type=anything}}, {key="run" declared={type=anything}}]
layout L14 name="ClosureOfAnotherBlock" fields=[{key="run" declared={type=anything}}]
layout L15 name="CapturesEnvironment" fields=[{key="run" declared={type=anything}}]
layout L16 kind=Environment name="scope" fields=[{key="count" declared={type=anything}}]
layout L17 name="ReadWithFieldThatMayBeEmpty" fields=[{key="shared" declared={type=anything}}]
layout L18 name="MayBeEmpty" fields=[{key="shared" declared={type=anything} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L19 kind=Instance name="PrototypeMaySelectAnotherClass" constructor=f4 fields=[{key="run" declared={type=anything}}]
layout L20 name="StoredTwice" fields=[{key="run" declared={type=anything}}]
layout L21 name="ClosureMadeBeforeCall" fields=[{key="run" declared={type=anything}}]

# CHECK: layout L0 {{*}}{key="count" declared={type=anything}}, {key="onData" declared={type=function} flow={location={initialization=SetAtCreation deferral=CapturesObject deferredFunction=f7} occupancy=AlwaysFilled}}, {key="onEnd" declared={type=function} flow={location={initialization=SetAtCreation deferral=CapturesObject deferredFunction=f8} occupancy=AlwaysFilled}}, {key="onError" declared={type=function} flow={location={initialization=SetAtCreation deferral=CapturesNothing deferredFunction=f9} occupancy=AlwaysFilled}}]
# CHECK: layout L1 {{*}}{key="read" declared={type=anything} flow={location={initialization=SetAtCreation deferral=CapturesObject deferredFunction=f7} occupancy=AlwaysFilled}}, {key="last" declared={type=anything}}]
# CHECK: layout L2 {{*}}deferral=CapturesNothing deferredFunction=f9}
# CHECK: layout L3 {{*}}{key="first" {{*}}deferredFunction=f7} occupancy=AlwaysFilled}}, {key="name" declared={type=anything}}, {key="items" declared={type=anything}}, {key="second" {{*}}deferredFunction=f8} occupancy=AlwaysFilled}}]
# CHECK: layout L4 {{*}}deferral=CapturesNothing deferredFunction=f9}
# CHECK: layout L5 name="ClosureUsedTwice" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L6 name="StoredBehindCall" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L7 name="StoredBehindRead" fields=[{key="id" declared={type=anything}}, {key="run" declared={type=anything}}]
# CHECK-NEXT: layout L8 name="TwoFunctions" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L9 name="OneAllocationGivesNothing" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L10 name="StoredElsewhere" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L11 kind=Instance name="HasSubclass" constructor=f2 fields=[{key="run" declared={type=anything}}]
# CHECK: layout L13 name="BehindStoreThatStays" fields=[{key="self" declared={type=anything}}, {key="run" declared={type=anything}}]
# CHECK-NEXT: layout L14 name="ClosureOfAnotherBlock" fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L15 name="CapturesEnvironment" fields=[{key="run" declared={type=anything}}]
# CHECK: layout L17 name="ReadWithFieldThatMayBeEmpty" fields=[{key="shared" declared={type=anything}}]
# CHECK: layout L19 kind=Instance name="PrototypeMaySelectAnotherClass" constructor=f4 fields=[{key="run" declared={type=anything}}]
# CHECK-NEXT: layout L20 {{*}}deferral=CapturesNothing deferredFunction=f10}
# CHECK-NEXT: layout L21 {{*}}deferral=CapturesNothing deferredFunction=f9}

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Undefined
    v2 = NewObject -, v0, v1, v0 layout=L1 fields=[0, 1, 2]
    v3 = NewClosure v2 function=f7
    PutSlotOrAdd v2, v2, v3 key="read" receivers=[L1] level=Proven
    PutModuleVariable v2 variable=g0
    v6 = NewClosure function=f9
    v7 = Upcast v6 castType=anything
    v8 = NewObject -, v7 layout=L2 fields=[0]
    PutModuleVariable v8 variable=g0
    v10 = NewObject layout=L3 fields=[]
    v11 = Upcast v10 castType=object
    v12 = NewClosure v11 function=f7
    PutSlotOrAdd v10, v10, v12 key="first" receivers=[L3] level=Proven
    v14 = String string="name"
    PutSlotOrAdd v10, v10, v14 key="name" receivers=[L3] level=Proven
    v16 = NewArray v14 contents=anything holes=[]
    PutSlotOrAdd v10, v10, v16 key="items" receivers=[L3] level=Proven
    v18 = NewClosure v10 function=f8
    v19 = Upcast v18 castType=anything
    PutSlotOrAdd v10, v10, v19 key="second" receivers=[L3] level=Proven
    PutModuleVariable v10 variable=g0
    v22 = NewClosure function=f9
    v23 = NewObject -, v22 layout=L4 fields=[0]
    PutModuleVariable v23 variable=g0
    v25 = NewObject layout=L4 fields=[]
    v26 = NewClosure function=f9
    PutSlotOrAdd v25, v25, v26 key="run" receivers=[L4] level=Proven
    PutModuleVariable v25 variable=g0
    v29 = NewClosure function=f9
    v30 = NewObject -, v29 layout=L20 fields=[0]
    v31 = NewClosure function=f10
    PutSlot v30, v30, v31 key="run" receivers=[L20] level=Proven
    PutModuleVariable v30 variable=g0
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[read]]: f7 = NewClosure function=f7 [isMadeOnDemand]
# CHECK-NEXT: [[literal]]:{{*}}= NewObject -, v0, [[read]], v0 layout=L1 fields=[0, 1, 2]
# CHECK-NEXT: PutModuleVariable [[literal]] variable=g0
# CHECK-NEXT: [[run]]: f9 = NewClosure function=f9 [isMadeOnDemand]
# CHECK-NEXT: [[cast]]:{{*}}= Upcast [[run]] castType=anything
# CHECK-NEXT: = NewObject -, [[cast]] layout=L2 fields=[0]
# CHECK: [[first]]: f7 = NewClosure function=f7 [isMadeOnDemand]
# CHECK-NEXT: [[name]]:{{*}}= String string="name"
# CHECK-NEXT: [[items]]:{{*}}= NewArray [[name]]
# CHECK-NEXT: [[second]]: f8 = NewClosure function=f8 [isMadeOnDemand]
# CHECK-NEXT: [[secondCast]]:{{*}}= Upcast [[second]] castType=anything
# CHECK-NEXT: [[object]]:{{*}}= NewObject -, [[first]], [[name]], [[items]], [[secondCast]] layout=L3 fields=[0, 1, 2, 3]
# CHECK-NEXT: = Upcast [[object]] castType=object
# CHECK-NEXT: PutModuleVariable [[object]] variable=g0
# CHECK-NEXT: [[listed]]: f9 = NewClosure function=f9 [isMadeOnDemand]
# CHECK-NEXT: = NewObject -, [[listed]] layout=L4 fields=[0]
# CHECK: [[stored]]: f9 = NewClosure function=f9 [isMadeOnDemand]
# CHECK-NEXT: = NewObject -, [[stored]] layout=L4 fields=[0]
# CHECK-NEXT: PutModuleVariable
# CHECK-NEXT: = NewClosure function=f9
# CHECK-NEXT: [[later]]: f10 = NewClosure function=f10 [isMadeOnDemand]
# CHECK-NEXT: = NewObject -, [[later]] layout=L20 fields=[0]
# CHECK-NEXT: PutModuleVariable
# CHECK-NEXT: Return

function f1 name="StoredBehindTheAllocation" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = NewClosure function=f9
    v3 = NewObject -, v1 layout=L0 fields=[0] [keepsShape]
    v4 = NewClosure v3 function=f8
    v5 = NewClosure v3 function=f7
    PutSlotOrAdd v3, -, v5 key="onData" receivers=[L0] level=Proven
    PutSlotOrAdd v3, -, v4 key="onEnd" receivers=[L0] level=Proven
    PutSlotOrAdd v3, -, v2 key="onError" receivers=[L0] level=Proven
