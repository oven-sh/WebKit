function f6 name="reads" module=m0 parameters=[{type=L0}, {type=L1}, {type=L17|L18}, {type=L2|L4}] results=[{type=anything}] {
  b0(v0: L0, v1: L1, v2: L17|L18, v3: L2|L4):
    v4 = IsSlotFilled v0 key="onData" receivers=[L0] level=Proven
