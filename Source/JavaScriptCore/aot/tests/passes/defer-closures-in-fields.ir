# CHECK: PutSlotOrAdd v9, v9, v11 key="run"
# CHECK: PutSlot v21, v21, v0 key="run"
# CHECK: PutSlotOrAdd v24, v24, v24 key="self"
# CHECK: PutSlotOrAdd v24, v24, v26 key="run"
