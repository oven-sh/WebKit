# The sum of two integers is the same however often it is computed: the second sum of the same two goes, in either order of the operands, and a constant counts by its value. A sum with another value stays, and one that stands on one way only. The sum of values that may be objects stays too: it may run code of the program.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
function f0 name="behindACall" parameters=[{type=int}, {type=int}, {type=anything}] results=[{type=anything}] {
    v3 = Add v0, v1
    v4 = Call v2, v3
    v5 = Add v0, v1
    v6 = Add v1, v0
    v7 = Call v2, v5, v6
    Return v7
# CHECK: = Add v0, v1
# CHECK-NEXT: = Call v2, v3
# CHECK-NEXT: = Call v2, v3, v3
# CHECK-NEXT: Return
}

function f1 name="constantsOfOneValue" parameters=[{type=int}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = Add v0, v2
    v4 = Integer integer=1
    v5 = Add v0, v4
    v6 = Call v1, v3, v5
    Return v6
# CHECK: = Call v1, v3, v3
}

function f2 name="constantsOfTwoValues" parameters=[{type=int}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = Add v0, v2
    v4 = Integer integer=2
    v5 = Add v0, v4
    v6 = Call v1, v3, v5
    Return v6
# CHECK: = Call v1, v3, v5
}

function f3 name="behindAJoin" parameters=[{type=int}, {type=int}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v4 = Add v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v3, v4
    Jump -> next b2()
  b2():
    v6 = Add v0, v1
    Return v6
# CHECK: b2():
# CHECK-NEXT: Return v4
}

function f4 name="onOneWay" parameters=[{type=int}, {type=int}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v4 = Add v0, v1
    v5 = Call v3, v4
    Jump -> next b2()
  b2():
    v6 = Add v0, v1
    Return v6
# CHECK: b2():
# CHECK-NEXT: = Add v0, v1
}

function f5 name="valuesThatMayBeObjects" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = Add v0, v1
    v4 = Add v0, v1
    v5 = Call v2, v3, v4
    Return v5
# CHECK: = Add v0, v1
# CHECK-NEXT: = Add v0, v1
# CHECK-NEXT: = Call v2, v3, v4
}

function f6 name="oneOperandMayBeAString" parameters=[{type=int}, {type=int|string}, {type=anything}] results=[{type=anything}] {
    v3 = Add v0, v1
    v4 = Add v0, v1
    v5 = Call v2, v3, v4
    Return v5
# CHECK: = Call v2, v3, v4
}
