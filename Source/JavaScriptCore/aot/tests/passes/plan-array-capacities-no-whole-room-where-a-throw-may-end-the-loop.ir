# A list that a counted loop pushes to once in every turn is filled to the bound only if every turn comes. Where something in the loop may throw the list is still told its length, but it is not said to be filled
# FORM: Prepared
# RUN: pass PlanArrayCapacities

module m0 path="main.js" displayPath="main.js"
function f0 name="callsWhatMayThrow" parameters=[{type=int[0, 1000000]}] results=[{type=Array<anything>}] {
    v1 = NewArray contents=anything
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = CallDirect v6 function=f2
    v8 = CallBuiltin v1, v7 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v9 = Integer integer=1
    v10 = Add v6, v9
    Jump -> next b1(v10)
  b3():
    Return v1
# CHECK: = NewArray {{*}}capacity=
# CHECK-NOT: isFilledToCapacity
# CHECK: AppendElement v1, v7, v3, v3, v0
}

function f1 name="callsWhatCannotThrow" parameters=[{type=int[0, 1000000]}] results=[{type=Array<anything>}] {
    v1 = NewArray contents=anything
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = CallDirect v6 function=f3
    v8 = CallBuiltin v1, v7 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v9 = Integer integer=1
    v10 = Add v6, v9
    Jump -> next b1(v10)
  b3():
    Return v1
# CHECK: = NewArray {{*}}capacity={{*}} [isFilledToCapacity]
# CHECK: AppendElement v1, v7, v3, v3, v0
}

function f2 name="throwsAtSome" parameters=[{type=int[0, 1000000]}] results=[{type=int[0, 1000000]}] {
    v1 = Integer integer=5
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Throw v0
}

function f3 name="neverThrows" parameters=[{type=int[0, 1000000]}] results=[{type=int[0, 1000000]}] {
    Return v0
}
