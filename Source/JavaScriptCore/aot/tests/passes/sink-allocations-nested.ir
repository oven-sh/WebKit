# CHECK: Jump -> next b4()
# CHECK: b4():
# CHECK-NEXT: v9: anything = Upcast v0 castType=anything
# CHECK-NOT: NewClosure
# CHECK-NOT: NewObject

function f7 name="liveRangeIsLoop" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    v4 = NewObject -, v3, v1 layout=L1 fields=[0, 1] [keepsShape]
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v5 = Call v0, -, v4
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    LoopHint
    v7 = PropGet v4 key="size" receivers=[L1]
    v8 = PropGet v7 key="w" receivers=[L0]
    v9 = Call v8
    v10 = ToBoolean v9
    Branch v10 -> taken b3(), notTaken b4()
  b4():
    Return v9
}
# CHECK-LABEL: function f7 name="liveRangeIsLoop"
# CHECK: b0(
# CHECK-NEXT: v3:{{*}}= NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: v4:{{*}}= NewObject -, v3, v1 layout=L1 fields=[0, 1]
# CHECK: LoopHint
# CHECK-NOT: LoopHint

function f8 name="cycleBuiltFromNode" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject layout=L2
    v3 = NewObject -, v2 layout=L3 fields=[0]
    PropDefine v2, v3 key="next" receivers=[L2]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v0, -, v2
    Return v5
  b2():
    Return v0
}
# The allocation lists "owner" and undefined is no object, so "owner" stays listed and the node is built first. "next" takes any value, so undefined holds its place.
# CHECK-LABEL: function f8 name="cycleBuiltFromNode"
# CHECK: b0(
# CHECK-NEXT: Branch v1
# CHECK: b1():
# CHECK-NEXT: [[placeholder8]]: undefined = Undefined
# CHECK-NEXT: [[node8]]:{{*}}= NewObject -, [[placeholder8]] layout=L2 fields=[0]
# CHECK-NEXT: [[owned8]]:{{*}}= NewObject -, [[node8]] layout=L3 fields=[0]
# CHECK-NEXT: PutSlotOrAdd [[node8]], [[node8]], [[owned8]] key="next" receivers=[L2] level=Proven
# CHECK-NEXT: = Call v0, -, [[node8]]

