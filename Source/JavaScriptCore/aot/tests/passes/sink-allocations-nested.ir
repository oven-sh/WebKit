# Virtual objects in fields of virtual objects: reads through two levels, a copied live range after a rare use, cycles
# FORM: Prepared
# RUN: pass SinkAllocations SinkAllocations
# RUN(ONCE): pass SinkAllocations
# STATISTIC: TailsDuplicatedForSinking = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Size" fields=[{key="w" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}] flow={members=[L0]}
layout L1 name="Rectangle" fields=[{key="size" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="name" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined]}}] flow={members=[L1]}
layout L2 name="Node" fields=[{key="next" declared={type=anything}}]
layout L3 name="Owned" fields=[{key="owner" declared={type=object}}]
layout L4 kind=Environment name="scope" fields=[{key="value" declared={type=anything}}, {key="self" declared={type=anything}}]
layout L5 name="Three" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}, {key="z" declared={type=anything}}]

function f0 name="readThroughTwoLevels" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v2, v1 layout=L1 fields=[0, 1]
    v4 = PropGet v3 key="size" receivers=[L1]
    v5 = PropGet v4 key="w" receivers=[L0]
    Return v5
}
