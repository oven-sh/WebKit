function f17 name="hardEdgeWouldCloseCycle" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewClosure v0 function=f12
    v3 = NewArray v2 contents=anything
    v4 = NewArray v3 contents=anything
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = Integer integer=0
    ElemSet v3, v5, v4 mode=Strict
    Return v0
  b2():
    Return v0
}
# An element is listed by its array, so the store that would close the cycle builds what it stores.
# CHECK-LABEL: function f17 name="hardEdgeWouldCloseCycle"
# CHECK: b1():
# CHECK: [[inner17]]:{{*}}= NewArray {{*}} contents=anything
# CHECK-NEXT: [[outer17]]:{{*}}= NewArray [[inner17]] contents=anything
# CHECK: ElemSet [[inner17]], {{*}}, [[outer17]]
# CHECK: b2():
# CHECK-NOT: NewArray
