function f6 name="closureInFieldAfterRareUse" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = NewClosure v0 function=f12
    v4 = NewObject -, v3, v1 layout=L1 fields=[0, 1] [keepsShape]
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v5 = Call v0, -, v4
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    v6 = PropGet v4 key="size" receivers=[L1]
    v7 = IsClosureOf v6 function=f12
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8):
    v9 = GetCapture v8 function=f12 index=0
    Return v9
  b5():
    Return v1
}
# CHECK-LABEL: function f6 name="closureInFieldAfterRareUse"
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1() frequency=Rare:
# CHECK-NEXT: [[inner6]]:{{*}}= NewClosure v0 function=f12
# CHECK-NEXT: [[outer6]]:{{*}}= NewObject -, [[inner6]], v1 layout=L1 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[outer6]]
