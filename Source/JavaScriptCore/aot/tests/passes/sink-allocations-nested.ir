function f16 name="heldInDifferentFieldsOfTwoHolders" parameters=[{type=anything}, {type=boolean}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean, v2: boolean, v3: anything):
    v4 = NewObject layout=L5 [keepsShape]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v0, -, v4
    Jump -> next b2()
  b2():
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v6 = NewObject -, v4, v3 layout=L5 fields=[0, 1] [keepsShape]
    Jump -> next b5(v6)
  b4():
    v7 = NewObject -, v3, v4 layout=L5 fields=[2, 1] [keepsShape]
    Jump -> next b5(v7)
  b5(v8):
    v9 = GetSlotOrUndefined v8 key="z" receivers=[L5] level=Proven
    v10 = Call v0, -, v9
    Return
}
# CHECK-LABEL: function f16 name="heldInDifferentFieldsOfTwoHolders"
# CHECK: b0(
# CHECK-NOT: NewObject
# CHECK: b1():
