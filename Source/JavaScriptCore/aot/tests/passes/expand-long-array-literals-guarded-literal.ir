# A guard on a long array literal that lasts across unknown code, because nothing else holds the array, lasts as well once the literal is allocated first and filled
# FORM: Prepared
# RUN: pass ExpandLongArrayLiterals
# LOSS: MaxArrayLiteralBatch x1 f0 v35
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="readsAroundUnknownCode" parameters=[{type=anything}, {type=object}] results=[{type=anything}] {
# REPEAT: i = 2..34
    v%(i) = Call v0
# END REPEAT
    v35 = NewArray v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34 contents=anything
    v36 = IsPristine v35 builtinClass=Array aspects=[Storage]
    Branch v36 -> taken b1(| 0), notTaken b2()
  b1(v37):
    v38 = Integer integer=1
    v39 = GetArrayElement v35, v38, v37 level=Expected [keyIsIntegral]
    PropSet v1, v39 key="first"
    v41 = GetArrayElement v35, v38, v37 level=Expected [keyIsIntegral]
    Return v41
  b2():
    Return
}
# CHECK: [[filled]]: Array = NewContiguousArray
# CHECK: v35: Array = TruncateNewArray [[filled]],
# CHECK: PropSet v1, v39 key="first"
# CHECK-NEXT: v41: anything = GetArrayElement v35, v38, v37 level=Expected
