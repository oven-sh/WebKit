  b1():
    Return v0
  b2():
    Return v0
  b3():
    v1 = Integer integer=2
    v2 = StrictEq v0, v1
    Branch v2 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v0
}
# CHECK-LABEL: function f1 name="switchExtendedByTest"
# CHECK: Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b4(), otherwise b5()

