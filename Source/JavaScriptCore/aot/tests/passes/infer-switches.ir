# A chain of branches on strict equality of one integer with constants becomes a switch
# FORM: Prepared
# RUN: pass InferSwitches
# STATISTIC: InferSwitchesChanges = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="threeTests" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=1
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Integer integer=2
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f0 name="threeTests"
# CHECK: Switch v0 cases=[0, 1, 2] -> case b1(), case b3(), case b5(), otherwise b6()

function f1 name="switchExtendedByTest" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
