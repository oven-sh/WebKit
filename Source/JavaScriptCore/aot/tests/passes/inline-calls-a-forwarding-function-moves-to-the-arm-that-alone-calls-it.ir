    Return v2
}
function f1 name="forwardsForTwoArms" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="operand"
    v2 = CallDirect v1 function=f3 [isNeverInlined]
    Return v2
}
function f2 name="doesMore" parameters=[{type=anything}] results=[{type=anything}] {
