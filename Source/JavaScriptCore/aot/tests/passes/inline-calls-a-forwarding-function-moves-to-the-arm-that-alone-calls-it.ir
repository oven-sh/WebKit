  b7():
    Branch v7 -> taken b1(), notTaken b8()
  b8():
    Branch v8 -> taken b1(), notTaken b9()
  b9():
    Switch v9 cases=[0, 1, 2] -> case b10(), case b11(), case b12(), otherwise b13()
  b10():
