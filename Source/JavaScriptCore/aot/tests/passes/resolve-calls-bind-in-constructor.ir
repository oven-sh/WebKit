# A method bound to this in a constructor makes a closure of a bound function over the object, and that function calls the method directly. The method captures nothing and its closures stay as they were created, so the bound function does not hold the closure of the method. A call of what the field holds tests for no closure of the method: the callee is none. It tests for a closure of the bound function, which flow saw arrive there, and enters that function directly. Where the prototype may hold another function under the name, a guard of the member stands in front, and behind its failing side bind stays a call
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=InsertObjectCoercibleChecks,ResolveCalls,PlaceTypeTests,ChooseCallingConventions heat=EverythingIsHot
# STATISTIC: BoundFunctions = 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Worker" constructor=f1 fields=[{key="count" declared={type=anything}}]
layout L1 kind=Instance name="Patched" constructor=f3 fields=[{key="count" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="run"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="bound"
    v7 = Call v6
    v8 = NewClosure function=f3
    v9 = NewClass v8 layout=L1
    v10 = NewClosure function=f4
    DefineMethod v9, v10 layout=L1 key="run"
    v12 = FinishClass v9 layout=L1
    v13 = PropGet v12 key="prototype"
    v14 = NewClosure function=f5
    PropSet v13, v14 key="run" mode=Strict
    v16 = Construct v12
    v17 = PropGet v16 key="bound"
    v18 = Call v17
    Return
# CHECK-NOT: IsClosureOf {{*}} function=f2
# CHECK: [[callee]]: function = PropGet {{*}} key="bound"
# CHECK-NEXT: = IsClosureOf [[callee]] function=[[boundRun]]
# CHECK: = CallDirect {{*}} function=[[boundRun]]
# CHECK-NOT: IsClosureOf
}
function f1 name="Worker" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = PropGet v2 key="run"
    v4 = PropGet v3 key="bind"
    v5 = Call v4, v3, v2 calleeKey="bind"
    PropSet v2, v5 key="bound" mode=Strict
    v7 = Integer integer=1
    PropSet v2, v7 key="count" mode=Strict
    Return v2
# CHECK: [[allocated]]: L0 = NewObject
# CHECK: [[object]]: L0 = AssumeType [[allocated]] provenType=L0
# CHECK: = NewClosure [[object]] function=[[bound]]
# CHECK-NOT: CallBuiltin
}
function f2 name="run" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
}
function f3 name="Patched" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    v3 = PropGet v2 key="run"
    v4 = PropGet v3 key="bind"
    v5 = Call v4, v3, v2 calleeKey="bind"
    PropSet v2, v5 key="bound" mode=Strict
    v7 = Integer integer=1
    PropSet v2, v7 key="count" mode=Strict
    Return v2
# CHECK: = AreMembersUnchanged conditions=[{layout=L1 key="run"}
# CHECK: = NewClosure function=f4 [isHeldByClosureTable]
# CHECK: frequency=Unlikely:
# CHECK: = PropGet {{*}} key="run"
# CHECK: = CallBuiltin {{*}} overload=FunctionPrototypeBind/0
# CHECK-NOT: NewClosure
}
function f4 name="run" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
}
function f5 name="patch" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
# CHECK: function [[bound]] name="run"{{*}}role=BoundFunction captures=[{type=L0}]
# CHECK: = CallDirect {{*}} function=f2
}
