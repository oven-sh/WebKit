# An environment with more fields than the limit is on the heap, the environment of a smaller layout beside it is in the frame
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# RUN(PLAN): frame-plan flow
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames limit=MaxFrameEnvironmentFields:1
# LOSS: MaxFrameEnvironmentFields x1 f1 v1
# CHECK-NOT: L0 may be in a frame
# CHECK-NOT: L0 only in frames
# CHECK: L1 only in frames
# CHECK-NEXT: layout L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="twoFields" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 kind=Environment name="oneField" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    Return
}
# CHECK-LABEL: function f0 name="main"
function f1 name="overTheLimit" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1 function=f3
    Return v2
}
# CHECK-LABEL: function f1 name="overTheLimit"
# CHECK: = NewObject {{*}}layout=L0
# CHECK-NOT: storage=
# PLAN-LABEL: function f1
# PLAN-NEXT: v1: Heap ExceedsLimit limit=MaxFrameEnvironmentFields
function f2 name="atTheLimit" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = CallDirect v1 function=f4
    Return v2
}
# CHECK-LABEL: function f2 name="atTheLimit"
# CHECK: = NewObject {{*}}layout=L1 {{*}}storage=Frame
# PLAN-LABEL: function f2
# PLAN-NEXT: v1: Frame
function f3 name="readsTwoFields" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=1
    v2 = ToBoolean v1
    Return v2
}
# CHECK-LABEL: function f3 name="readsTwoFields"
# PLAN-LABEL: function f3
function f4 name="readsOneField" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = ToBoolean v1
    Return v2
}
