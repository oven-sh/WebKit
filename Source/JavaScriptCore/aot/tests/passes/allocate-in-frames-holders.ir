# The result names exactly the captures in which a frame cell holds a pointer to a frame cell, and no field: a closure held by an environment field is on the heap
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# RUN(PLAN): frame-plan flow
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames
# CHECK: L0 only in frames
# CHECK-NEXT: L1 only in frames
# CHECK-NEXT: L2 may be in a frame
# CHECK-NEXT: L3 may be in a frame
# CHECK-NEXT: f10 only in frames
# CHECK-NEXT: f10 capture 1 holds frame pointers
# CHECK-NEXT: layout L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="holdsClosure" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}, {key="callback" declared={type=anything}}]
layout L1 kind=Environment name="heldByClosure" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Environment name="frameSiteAndHeapSite" fields=[{key="options" declared={type=anything}}]
layout L3 name="Options" fields=[{key="callback" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect v1 function=f4
    v6 = CallDirect function=f5
    Return
}
# CHECK-LABEL: function f0 name="main"

function f1 name="closureInThirdField" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f8
    v2 = NewObject -, v0, v0, v1 layout=L0 fields=[0, 1, 2]
    v3 = CallDirect v2 function=f7
    Return v3
}
# CHECK-LABEL: function f1 name="closureInThirdField"
# CHECK: = NewClosure function=f8
# CHECK-NOT: storage=
# CHECK: = NewObject {{*}}layout=L0 {{*}}storage=Frame
# PLAN-LABEL: function f1
# PLAN-NEXT: v1: Heap HeldByHeapCell by v2(3)
# PLAN-NEXT: v2: Frame

function f2 name="environmentInSecondCapture" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure v0, v1 function=f10
    v3 = CallDirect v2 function=f6
    Return v3
}
# CHECK-LABEL: function f2 name="environmentInSecondCapture"
# CHECK: = NewObject {{*}}layout=L1 {{*}}storage=Frame
# CHECK: = NewClosure {{*}}function=f10 {{*}}storage=Frame
# PLAN-LABEL: function f2
# PLAN-NEXT: v1: Frame
# PLAN-NEXT: v2: Frame

function f3 name="frameSite" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = CallDirect v1 function=f11
    Return v2
}
# CHECK-LABEL: function f3 name="frameSite"
# CHECK: = NewObject {{*}}layout=L2 {{*}}storage=Frame
# PLAN-LABEL: function f3
# PLAN-NEXT: v1: Frame

function f4 name="heapSite" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f11
    v3 = Call v0, -, v0, v0, v2
    Return v3
}
# CHECK-LABEL: function f4 name="heapSite"
# CHECK-NOT: storage=
# PLAN-LABEL: function f4
# PLAN-NEXT: v1: Heap MaterializationDoesNotPay
# PLAN-NEXT: v2: Heap Escapes by v3(4)

function f5 name="closureIsInitialValueOfRecord" results=[{type=anything}] {
    v0 = NewClosure function=f9
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = CallDirect v1 function=f12
    Return v2
}
# CHECK-LABEL: function f5 name="closureIsInitialValueOfRecord"
# CHECK: = NewClosure function=f9
# CHECK-NOT: storage=
# CHECK: = NewObject {{*}}layout=L3 {{*}}storage=Frame
# PLAN-LABEL: function f5
# PLAN-NEXT: v0: Heap HeldByHeapCell by v1(1)
# PLAN-NEXT: v1: Frame

function f6 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
# CHECK-LABEL: function f6 name="callsParameter"
# PLAN-LABEL: function f6

function f7 name="callsThirdField" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=2
    v2 = Call v1
    Return v2
}
function f8 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
function f9 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
function f10 name="readsSecondCapture" kind=Arrow captures=[{type=anything}, {type=env L1}] results=[{type=anything}] {
  b0(v0: anything, v1: env L1):
    v2 = GetEnvironmentField v1 layout=L1 field=0
    v3 = ToBoolean v2
    Return v3
}
function f11 name="testsOptions" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    v2 = ToBoolean v1
    Return v2
}
function f12 name="testsCallback" parameters=[{type=L3}] results=[{type=anything}] {
    v1 = PropGet v0 key="callback"
    v2 = ToBoolean v1
    Return v2
}
