# Each site that creates a regular expression has its own answer: what happens to the objects of one site costs another site with the same text nothing
# FORM: AsRead
# RUN: pipeline FoldConstantRegExps
# OPTIONS: only-passes=FoldConstantRegExps

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = CallDirect function=f3
    v3 = CallDirect function=f4
    Return
}

function f1 name="staysAsCreated" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" @10
    v1 = PropGet v0 key="source" @11
    Return v1
}
# CHECK-LABEL: function f1 name="staysAsCreated"
# CHECK: v1: "a+" = String string="a+"

function f2 name="compiledAgain" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" @20
    v1 = String string="b" @21
    v2 = PropGet v0 key="compile" @22
    v3 = Call v2, v0, v1 calleeKey="compile" @23
    v4 = PropGet v0 key="source" @24
    Return v4
}
# CHECK-LABEL: function f2 name="compiledAgain"
# CHECK-NOT: = String string="a+"

function f3 name="reachesUnknownCode" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" @30
    v1 = Builtin builtin=GlobalThis @31
    v2 = PropGet v1 key="sink" [isFreeName] @32
    v3 = Call v2, -, v0 @33
    v4 = PropGet v0 key="source" @34
    Return v4
}
# CHECK-LABEL: function f3 name="reachesUnknownCode"
# CHECK-NOT: = String string="a+"

function f4 name="createdFromSameText" results=[{type=anything}] {
  b0():
    v0 = String string="a+" @40
    v1 = Builtin builtin=RegExp @41
    v2 = Construct v1, -, v0 @42
    Return v2
}
# CHECK-LABEL: function f4 name="createdFromSameText"
# CHECK: v2: RegExp<"a+"[]> = NewRegExp pattern="a+"
# CHECK-NOT: CallBuiltin
