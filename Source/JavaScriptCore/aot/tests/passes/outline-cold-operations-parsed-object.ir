# The allocation of an object that JSONObjectFinish takes stays in the function that finishes the object: the key order is recorded for an object that this function allocated
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# STATISTIC: ColdSitesOutlined = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]

function f0 name="finishedByParser" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 1..6
  b%(i)() frequency=Rare:
    v%(i*4-2) = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    v%(i*4-1) = JSONObjectBegin layout=L0
    v%(i*4) = Undefined
    v%(i*4+1) = JSONObjectFinish v%(i*4-1), v%(i*4-2), v%(i*4) layout=L0
    Return v%(i*4-2)
# END REPEAT
  b7():
    Return v1
}
# CHECK-LABEL: function f0
# CHECK-NOT: CallDirect
# CHECK-COUNT-6: = NewObject -, v1, v1 layout=L0
# CHECK-NOT: CallDirect

function f1 name="notFinished" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 2..7
  b%(i-1)() frequency=Rare:
    v%(i) = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    Return v%(i)
# END REPEAT
  b7():
    Return v1
}
# CHECK-LABEL: function f1
# CHECK-NOT: NewObject
# CHECK-COUNT-6: = CallDirect v1 function=f2
# CHECK-NOT: NewObject

# CHECK-LABEL: function f2 {{*}}role=OutlinedBody
# CHECK: [[object]]:{{*}}= NewObject -, v0, v0 layout=L0 fields=[0, 1]
# CHECK-NEXT: Return [[object]]
