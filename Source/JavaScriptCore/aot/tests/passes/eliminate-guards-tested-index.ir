# A bounds test whose index was narrowed by a type test is about its array alone, like one with a proven index.
# FORM: Prepared
# RUN: pass EliminateGuards

module m0 path="main.js" displayPath="main.js"

function f0 name="testedIndex" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number, proven, pristine[Storage, Names]>, v1: anything, v2: number):
    v3 = NewArray contents=number
    v4 = TypeTest v1 testedType=int[0, 100]
    Branch v4 -> taken b1(| 0), notTaken b4()
  b1(v5: int[0, 100]):
    v6 = IsInBounds v0, v5
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7):
    AppendElement v3, v2
    v9 = IsInBounds v0, v5
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10):
    Return v2
  b4():
    Return
}
# CHECK-LABEL: name="testedIndex"
# CHECK-COUNT-1: = IsInBounds
# CHECK: AppendElement
# CHECK-NOT: IsInBounds

function f1 name="appendToTestedArray" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number, proven, pristine[Storage, Names]>, v1: anything, v2: number):
    v3 = TypeTest v1 testedType=int[0, 100]
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4: int[0, 100]):
    v5 = IsInBounds v0, v4
    Branch v5 -> taken b2(| 0), notTaken b4()
  b2(v6):
    AppendElement v0, v2
    v8 = IsInBounds v0, v4
    Branch v8 -> taken b3(| 0), notTaken b4()
  b3(v9):
    Return v2
  b4():
    Return
}
# CHECK-LABEL: name="appendToTestedArray"
# CHECK-COUNT-2: = IsInBounds
