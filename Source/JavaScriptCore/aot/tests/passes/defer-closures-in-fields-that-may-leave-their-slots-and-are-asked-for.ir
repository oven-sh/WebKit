# Object.hasOwn(object, "run"), resolved to a look at the slot without a test: the type of the field is only expected, so its slot took every value, and the property lay in the slot or nowhere.
# A slot that defers its closure holds objects alone: a number that somebody stores lies outside the slot from then on, and the look at the slot would say that the property is gone.
# A read asks the object in that case (defer-closures-in-fields-that-may-leave-their-slots.ir); this test answers by itself, so the field does not defer.
# A test that stands in front of a read has no site of its own. Where its empty arm reads by name, or asks whether a field lies outside its slot, it keeps nothing from deferring.
# Where the empty arm answers by itself, the field does not defer
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass DeferClosuresInFields
# STATISTIC: FieldsDeferringClosures = 3
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="keptToo" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="keptAsWell" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="keptLast" module=m0 declared={type=anything} initialization=Undefined
variable g4 name="keptBesides" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="IsAskedFor" fields=[{key="run" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
layout L1 name="IsOnlyRead" fields=[{key="walk" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
layout L2 name="IsAnsweredWhereEmpty" fields=[{key="jump" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
layout L3 name="IsAskedWhereEmpty" fields=[{key="swim" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
layout L4 name="IsStoredByNameWhereEmpty" fields=[{key="dive" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
# CHECK: layout L0 name="IsAskedFor"
# CHECK-NOT: deferral=
# CHECK: layout L1 name="IsOnlyRead"{{*}}deferral=CapturesNothing
# CHECK: layout L2 name="IsAnsweredWhereEmpty"
# CHECK-NOT: deferral=
# CHECK: layout L3 name="IsAskedWhereEmpty"{{*}}deferral=CapturesNothing
# CHECK: layout L4 name="IsStoredByNameWhereEmpty"{{*}}deferral=CapturesNothing
