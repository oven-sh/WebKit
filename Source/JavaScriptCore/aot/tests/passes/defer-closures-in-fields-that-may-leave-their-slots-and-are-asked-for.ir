# Object.hasOwn(object, "run"), resolved to a look at the slot without a test: the type of the field is only expected, so its slot took every value, and the property lay in the slot or nowhere.
# A slot that defers its closure holds objects alone: a number that somebody stores lies outside the slot from then on, and the look at the slot would say that the property is gone.
# A read asks the object in that case (defer-closures-in-fields-that-may-leave-their-slots.ir); this test answers by itself, so the field does not defer.
# A test that stands in front of a read has no site of its own, and its empty arm reads by name: it keeps nothing from deferring
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass DeferClosuresInFields
# STATISTIC: FieldsDeferringClosures = 1
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="keptToo" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="IsAskedFor" fields=[{key="run" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
layout L1 name="IsOnlyRead" fields=[{key="walk" declared={type=function flags=[IsExpected]} flow={stability=[IsNeverRedefined]}}]
# CHECK: layout L0 name="IsAskedFor"
# CHECK-NOT: deferral=
# CHECK: layout L1 name="IsOnlyRead"{{*}}deferral=CapturesNothing
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f4
    v4 = NewObject -, v3 layout=L1 fields=[0]
    PutModuleVariable v4 variable=g1
    Return
}
function f1 name="asks" module=m0 parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = IsSlotFilled v0 key="run" receivers=[L0] level=Proven accessSite=0
    Return v1
}
function f2 name="testsInFrontOfNothing" module=m0 parameters=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = IsSlotFilled v0 key="walk" receivers=[L1] level=Proven
    Return v1
}
function f3 name="run" module=m0 kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f4 name="walk" module=m0 kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
