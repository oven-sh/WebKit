# A read of a location that cannot change while the function runs moves in front of the loop past unknown code of the header
# FORM: Prepared
# RUN: pass HoistLoopInvariantReads
# STATISTIC: HoistLoopInvariantReadsChanges = 2

module m0 path="main.js" displayPath="main.js"
variable g0 name="neverStored" declared={type=number} flow={writers=AllKnown stores=Never initialization=SetAtCreation isUnchangedDuringActivation=true}
variable g1 name="storedOnce" declared={type=number} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g2 name="unknown" declared={type=number}
layout L0 kind=Environment name="scope" fields=[{key="fixed" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation isUnchangedDuringActivation=true}}}, {key="storedLater" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}}}]

function f0 name="neverStoredVariable" parameters=[{type=number}, {type=anything}] results=[{type=number}] {
  b0(v0: number, v1: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v1
    v4 = GetModuleVariable variable=g0
    v5 = Less v0, v4
    Branch v5 -> taken b1(), notTaken b2()
  b2():
    Return v4
}
