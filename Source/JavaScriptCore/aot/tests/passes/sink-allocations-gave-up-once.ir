# A function on which the pass has spent its work is left alone by the later runs of the same schedule, until it has lost a quarter of its blocks
# FORM: Prepared
# OPTIONS: limit=MaxSinkingWork:30
# RUN: function-passes SinkAllocations SinkAllocations SimplifyControlFlow SinkAllocations
# LOSS: MaxSinkingWork x2 f0
# STATISTIC: AllocationsSunk = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

# CHECK: f0 SinkAllocations: Unchanged
# CHECK-NEXT: f0 SinkAllocations: Unchanged
# CHECK-NEXT: f0 SimplifyControlFlow: Unchanged
# CHECK-NEXT: f0 SinkAllocations: Unchanged
# CHECK-NEXT: f1 SinkAllocations: Unchanged
# CHECK-NEXT: f1 SinkAllocations: Unchanged
# CHECK-NEXT: f1 SimplifyControlFlow: Changed
# CHECK-NEXT: f1 SinkAllocations: Changed

function f0 name="staysAsLargeAsItWas" parameters=[{type=anything}, {type=anything}, {type=boolean}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean, v3: boolean, v4: boolean):
    v5 = NewObject -, v0 layout=L0 fields=[0]
    PropDefine v5, v1 key="y" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v7 = Call v0
    Jump -> next b3()
  b2():
    v8 = Call v1
    Jump -> next b3()
  b3():
    Branch v3 -> taken b4(), notTaken b5()
  b4():
    v9 = Call v0, -, v0
    Jump -> next b6()
  b5():
    v10 = Call v1, -, v1
    Jump -> next b6()
  b6():
    Branch v4 -> taken b7(), notTaken b8()
  b7():
    v11 = Call v0, -, v5
    Return v11
  b8():
    Return v1
}
# CHECK-LABEL: function f0 name="staysAsLargeAsItWas"
# CHECK: b0(
# CHECK-NEXT: v5:{{*}}= NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: PropDefine v5, v1 key="y"

function f1 name="losesMostOfItsBlocks" parameters=[{type=anything}, {type=anything}, {type=boolean}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean, v3: boolean, v4: boolean):
    v5 = NewObject -, v0 layout=L0 fields=[0]
    PropDefine v5, v1 key="y" receivers=[L0]
    v7 = Boolean
    Branch v7 -> taken b1(), notTaken b9()
  b1():
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v8 = Call v0
    Jump -> next b4()
  b3():
    v9 = Call v1
    Jump -> next b4()
  b4():
    Branch v3 -> taken b5(), notTaken b6()
  b5():
    v10 = Call v0, -, v0
    Jump -> next b7()
  b6():
    v11 = Call v1, -, v1
    Jump -> next b7()
  b7():
    v12 = Call v0, -, v5
    Jump -> next b8()
  b8():
    v13 = Call v1, -, v5
    Return v13
  b9():
    Branch v4 -> taken b10(), notTaken b11()
  b10():
    v14 = Call v0, -, v5
    Return v14
  b11():
    Return v1
}
# CHECK-LABEL: function f1 name="losesMostOfItsBlocks"
# CHECK: b0(
# CHECK-NOT: NewObject
# CHECK: [[cell]]:{{*}}= NewObject -, v0, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[cell]]
