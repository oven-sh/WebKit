# STATISTIC: CallsResolved = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
typesite w0 module=m0 position=9 kind=Parameter text="number"
function f0 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number site=w0}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: number):
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    Return v1
}
function f1 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: number, v1: undefined|Promise):
    Return
}
function f2 name="generator" role=CoroutineRamp flags=[IsGenerator, TakesCallee] parameters=[{type=number}] results=[{type=anything}] creator=Coroutine{kind=Generator ramp=f2 body=f3} {
  b0(v0: function, v1: number):
    Return
}
function f3 name="generator" role=CoroutineBody results=[{type=anything}] creator=Coroutine{kind=Generator ramp=f2 body=f3}
function f4 name="synchronous" parameters=[{type=number site=w0}, {type=string}] results=[{type=anything}] {
  b0(v0: number, v1: string):
    Return
}

function f5 name="written-parameter" parameters=[{type=f4}, {type=anything}, {type=number|string}] results=[{type=anything}] {
  b0(v0: f4, v1: anything, v2: number|string):
    v3 = Call v0, -, v1, v2
    Return v3
}
