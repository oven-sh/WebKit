# Every argument of a direct call is inside the type its callee declares. What the types of the caller do not show is assumed: nothing is tested in front of the call, so nothing throws there and no promise is rejected
# FORM: Prepared
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
typesite w0 module=m0 position=9 kind=Parameter text="number"
function f0 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number site=w0}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    Return v1
}
function f1 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
    Return
}
function f2 name="generator" role=CoroutineRamp flags=[IsGenerator, TakesCallee] parameters=[{type=number}] results=[{type=anything}] creator=Coroutine{kind=Generator ramp=f2 body=f3} {
    Return
}
function f3 name="generator" role=CoroutineBody results=[{type=anything}] creator=Coroutine{kind=Generator ramp=f2 body=f3}
function f4 name="synchronous" parameters=[{type=number site=w0}, {type=string}] results=[{type=anything}] {
    Return
}

function f5 name="typed-parameter" parameters=[{type=f4}, {type=anything}, {type=number|string}] results=[{type=anything}] {
    v3 = Call v0, -, v1, v2
    Return v3
# CHECK-NEXT: b0(v0: f4, v1: anything, v2: number|string):
# CHECK-NEXT: [[unknownArgument]]: number = AssumeType v1 provenType=number
# CHECK-NEXT: [[unionArgument]]: string = AssumeType v2 provenType=string
# CHECK-NEXT: = CallDirect [[unknownArgument]], [[unionArgument]] function=f4
}
function f6 name="argument-of-a-wider-type" parameters=[{type=f4}, {type=number|string}, {type=string}] results=[{type=anything}] {
    v3 = Call v0, -, v1, v2
    Return v3
# CHECK-NEXT: b0(v0: f4, v1: number|string, v2: string):
# CHECK-NEXT: [[narrowedArgument]]: number = AssumeType v1 provenType=number
# CHECK-NEXT: = CallDirect [[narrowedArgument]], v2 function=f4
}
function f7 name="arguments-inside" parameters=[{type=f4}, {type=i32}, {type="a"}] results=[{type=anything}] {
    v3 = Call v0, -, v1, v2
    Return v3
# CHECK-NEXT: b0(v0: f4, v1: i32, v2: "a"):
# CHECK-NEXT: = CallDirect v1, v2 function=f4
# CHECK-NOT: AssumeType
}

function f8 name="async-callee-under-handler" parameters=[{type=f0}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0, v1: anything) handler=b2():
    v2 = Call v0, -, v1
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# CHECK-NEXT: b0(v0: f0, v1: anything) handler=b2():
# CHECK-NEXT: [[asyncArgument]]: number = AssumeType v1 provenType=number
# CHECK-NEXT: : Promise = CallDirect [[asyncArgument]] function=f0
# CHECK-NOT: RejectPromise
}
function f9 name="async-callee-arguments-inside" parameters=[{type=f0}, {type=number}] results=[{type=anything}] {
    v2 = Call v0, -, v1
    Return v2
# CHECK-NEXT: b0(v0: f0, v1: number):
# CHECK-NEXT: : Promise = CallDirect v1 function=f0
# CHECK-NOT: CatchValue
}
function f10 name="generator-callee" parameters=[{type=f2}, {type=anything}] results=[{type=anything}] {
    v2 = Call v0, -, v1
    Return v2
# CHECK-NEXT: b0(v0: f2, v1: anything):
# CHECK-NEXT: [[generatorArgument]]: number = AssumeType v1 provenType=number
# CHECK-NEXT: = CallDirect v0, [[generatorArgument]] function=f2
# CHECK-NOT: CatchValue
}
