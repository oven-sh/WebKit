# That a variable is stored before it is read holds where a function that reads it is entered. The copy of such a function in another one names a fact that says where that is. A variable goes around a loop
# whether or not the fact is defined ahead of it: the read ahead of the loop that cannot name the fact says that the word may be anything, and only the cast that names the fact takes that away
# FORM: Prepared
# RUN: pass SeparateUnlikelyLoopPaths

module m0 path="main.js" displayPath="main.js"
variable g0 name="text" declared={type=string} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
variable g1 name="textOrUndefined" declared={type=undefined|string} initialization=Undefined flow={writers=AllKnown storeNaming=EveryStoreNamesLocation}

function f0 name="readBehindTest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = IsClosureOf v0 function=f4
    Branch v2 -> taken b2(), notTaken b4()
  b2():
    v3 = Entered function=f4
    v4 = GetModuleVariable fact=v3 variable=g0
    v5 = String string="n"
    v6 = Add v4, v5
    PutModuleVariable v6 variable=g0
    v8 = GetStringLength v6
    v9 = Integer integer=9
    v10 = Less v8, v9
    Branch v10 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v11 = Undefined
    Return v11
# CHECK: b0(
# CHECK-NEXT: [[first0]]: string|unspecified = GetModuleVariable variable=g0 [mayPrecedeItsStore]
# CHECK-NEXT: Jump -> next b1([[first0]])
# CHECK-NEXT: b1([[carried0]]: string|unspecified):
# CHECK: b2():
# CHECK-NEXT: [[entered0]]: fact = Entered function=f4
# CHECK-NEXT: [[text0]]: string = AssumeType [[carried0]], [[entered0]] provenType=string
# CHECK-NOT: GetModuleVariable
# CHECK: = Add [[text0]],
# CHECK: b3():
}

# Nothing leaves the first turn in front of the read, so whoever enters the loop gets to the fact: it holds ahead of the loop too
function f1 name="readAtOnce" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = Entered function=f4
    v3 = GetModuleVariable fact=v2 variable=g0
    v4 = IsClosureOf v0 function=f4
    Branch v4 -> taken b2(), notTaken b4()
  b2():
    v5 = String string="n"
    v6 = Add v3, v5
    PutModuleVariable v6 variable=g0
    v8 = GetStringLength v6
    v9 = Integer integer=9
    v10 = Less v8, v9
    Branch v10 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v11 = Undefined
    Return v11
# CHECK: b0(
# CHECK-NEXT: [[entered1]]: fact = Entered function=f4
# CHECK-NEXT: [[first1]]: string = GetModuleVariable fact=[[entered1]] variable=g0
# CHECK-NOT: mayPrecedeItsStore
# CHECK: Jump -> next b1([[first1]])
}

# An operation that may throw leaves it as a test does
function f2 name="readBehindOperationThatMayThrow" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = RequireObject v0 runtimeError=IteratorIsNotAnObject
    v3 = Entered function=f4
    v4 = GetModuleVariable fact=v3 variable=g0
    v5 = String string="n"
    v6 = Add v4, v5
    PutModuleVariable v6 variable=g0
    v8 = GetStringLength v6
    v9 = Integer integer=9
    v10 = Less v8, v9
    Branch v10 -> taken b1(), notTaken b2()
  b2():
    Return v0
# CHECK: b0(
# CHECK-NEXT: = GetModuleVariable variable=g0 [mayPrecedeItsStore]
}

# What the variable holds from the start is of its type
function f3 name="variableThatStartsAsUndefined" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = IsClosureOf v0 function=f4
    Branch v2 -> taken b2(), notTaken b4()
  b2():
    v3 = GetModuleVariable variable=g1
    v4 = String string="n"
    v5 = Add v3, v4
    PutModuleVariable v5 variable=g1
    v7 = GetStringLength v5
    v8 = Integer integer=9
    v9 = Less v7, v8
    Branch v9 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v10 = Undefined
    Return v10
# CHECK: b0(
# CHECK-NEXT: = GetModuleVariable variable=g1
# CHECK-NOT: mayPrecedeItsStore
# CHECK: b1(
}

function f4 name="callee" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}

# In the body of the function that reads, the variable has been stored from the entry on
function f5 name="readOfTheFunctionItselfBehindTest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = IsClosureOf v0 function=f4
    Branch v2 -> taken b2(), notTaken b4()
  b2():
    v3 = GetModuleVariable variable=g0
    v4 = String string="n"
    v5 = Add v3, v4
    PutModuleVariable v5 variable=g0
    v7 = GetStringLength v5
    v8 = Integer integer=9
    v9 = Less v7, v8
    Branch v9 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v10 = Undefined
    Return v10
# CHECK: b0(
# CHECK-NEXT: [[first5]]: string = GetModuleVariable variable=g0
# CHECK-NEXT: Jump -> next b1([[first5]])
# CHECK-NOT: AssumeType
# CHECK: b3():
}

# A fact that is defined ahead of the loop goes with the read
function f6 name="factAheadOfLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Entered function=f4
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IsClosureOf v0 function=f4
    Branch v3 -> taken b2(), notTaken b4()
  b2():
    v4 = GetModuleVariable fact=v1 variable=g0
    v5 = String string="n"
    v6 = Add v4, v5
    PutModuleVariable v6 variable=g0
    v8 = GetStringLength v6
    v9 = Integer integer=9
    v10 = Less v8, v9
    Branch v10 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v11 = Undefined
    Return v11
# CHECK: b0(
# CHECK-NEXT: [[entered6]]: fact = Entered function=f4
# CHECK-NEXT: [[first6]]: string = GetModuleVariable fact=[[entered6]] variable=g0
# CHECK-NEXT: Jump -> next b1([[first6]])
# CHECK-NOT: AssumeType
# CHECK: b3():
}
