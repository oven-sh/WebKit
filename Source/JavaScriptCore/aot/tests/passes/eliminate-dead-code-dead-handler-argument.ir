# A parameter of a handler block that nobody reads goes, with its argument at every block that names the handler and with what was computed for it alone
# FORM: Prepared
# RUN: pass EliminateDeadCode
# STATISTIC: EliminateDeadCodeChanges = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="unusedHandlerParameter" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
    v2 = Add v1, v1
    Jump -> next b1()
  b1() handler=b3(v2):
    v3 = Call v0
    Jump -> next b2()
  b2() handler=b3(v1):
    v4 = Call v0
    Return v4
  b3(v5) role=CatchHandler:
    v6 = CatchValue
    Return v6
# CHECK-NEXT: b0(v0: anything, v1: number):
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b3():
# CHECK: b2() handler=b3():
# CHECK: b3() role=CatchHandler:
# CHECK-NEXT: v6: anything = CatchValue
# CHECK-NEXT: Return v6
}

function f1 name="oneOfTwoIsRead" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
