# The test of a proof about an object does not make the object a cell: it goes while the object is virtual, and the cell that is built gets it back beside its cast
# FORM: Prepared
# OPTIONS: validate
# RUN: pass SinkAllocations
# STATISTIC: AllocationsSunk = 1
# STATISTIC: AllocationsRemoved = 1

module m0 path="main.js" displayPath="main.js"

function f0 name="returnedInOneBranch" parameters=[{type=anything}, {type=Array<anything, pristine[Storage]>}, {type=boolean}] results=[{type=Array<anything, pristine[Storage]>}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage]>, v2: boolean):
    v3 = NewArray v0 contents=anything
    ValidateType v3 validatedType=Array<anything, Contiguous, pristine[Storage]>
    v5 = AssumeType v3 castType=Array<anything, Contiguous, pristine[Storage]>
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v5
  b2():
    Return v1
}
# CHECK-LABEL: function f0 name="returnedInOneBranch"
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK-NOT: ValidateType
# CHECK: b1():
# CHECK-NEXT: [[cell]]: Array = NewArray v0 contents=anything
# CHECK-NEXT: ValidateType [[cell]] validatedType=Array<anything, pristine[Storage]>
# CHECK-NEXT: = AssumeType [[cell]] castType=Array<anything, pristine[Storage]>
# CHECK: b2():
# CHECK-NEXT: Return v1

function f1 name="neverBuilt" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray v0 contents=anything
    ValidateType v1 validatedType=Array<anything, Contiguous, pristine[Storage]>
    v3 = AssumeType v1 castType=Array<anything, Contiguous, pristine[Storage]>
    v4 = Integer integer=0
    v5 = ElemGet v3, v4
    Return v5
}
# CHECK-LABEL: function f1 name="neverBuilt"
# CHECK-NOT: NewArray
# CHECK-NOT: ValidateType
