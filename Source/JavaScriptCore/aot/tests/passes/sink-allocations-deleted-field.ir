# `delete o.name` of a plain field of an object that is not built yet takes the field out of what the object holds and answers true. An object that is built later is born without the field, its other keys in their order.
# FORM: Prepared
# RUN: pass SinkAllocations

layout L0 name="Message" fields=[{key="id" declared={type=number} flags=[IsEnforced]}, {key="draft" declared={type=anything} flags=[IsEnforced]}, {key="text" declared={type=anything} flags=[IsEnforced]}, {key="fixed" declared={type=anything} flags=[IsEnforced] form=[IsNotConfigurable]}]
module m0 path="main.js" displayPath="main.js"

function f0 name="neverBuilt" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = PropDelete v2 key="draft" mode=Strict
    v4 = IsSlotFilled v2 key="draft" receivers=[L0] level=Proven
    v5 = NewArray v3, v4
    Return v5
# CHECK-NOT: NewObject
# CHECK-NOT: PropDelete
# CHECK-NOT: IsSlotFilled
}

function f1 name="builtBehindTheDeletion" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewObject -, v0, v1, v2 layout=L0 fields=[0, 1, 2]
    v4 = PropDelete v3 key="draft" mode=Strict
    Return v3
# CHECK-NOT: PropDelete
# CHECK: = NewObject -, v0, v2 layout=L0 fields=[0, 2]
# CHECK-NOT: PropDelete
}

function f2 name="storedAgain" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewObject -, v0, v1, v2 layout=L0 fields=[0, 1, 2]
    v4 = PropDelete v3 key="draft" mode=Strict
    PutSlotOrAdd v3, -, v1 key="draft" receivers=[L0] level=Proven
    Return v3
# CHECK-NOT: PropDelete
# CHECK: = NewObject -, v0, v2, v1 layout=L0 fields=[0, 2, 1]
}

function f3 name="aFieldThatCannotBeDeleted" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 3]
    v3 = PropDelete v2 key="fixed" mode=Sloppy
    Return v3
# CHECK: = NewObject
# CHECK: = PropDelete
}

function f4 name="aNameThatIsNoField" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = PropDelete v1 key="other" mode=Sloppy
    Return v2
# CHECK: = NewObject
# CHECK: = PropDelete
}
