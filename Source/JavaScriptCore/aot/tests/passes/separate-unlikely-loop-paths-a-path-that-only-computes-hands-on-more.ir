# An unlikely path that only computes leaves the loop too where a parameter that the loop reckons with is wider for it alone: the sum stays an integer in the loop
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=undefined|int[0, 9]}, {type=number}] results=[{type=i32}] {
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b6()
  b2():
    v8 = TypeTest v0 testedType=number
    Branch v8 -> taken b3(| 0), notTaken b4()
  b3(v9):
    v10 = Add v4, v9
    Jump -> next b5(v10)
  b4() frequency=Unlikely:
    v11 = Add v4, v0
    Jump -> next b5(v11)
  b5(v12):
    v13 = Integer integer=0
    v14 = BitOr v12, v13
    v15 = Increment v5
    Jump -> next b1(v14, v15)
  b6():
    Return v4
# CHECK: Branch v8 -> taken b3(| 0), notTaken [[missing]]()
# CHECK: v10: int[-2147483648, 2147483656] = Add v4, v9
# CHECK: b5(v12: int[-2147483648, 2147483656]):
