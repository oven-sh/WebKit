# const made = new Proxy({ alpha: +input }, { deleteProperty(target, key) { return key === "alpha"; } });
# globalThis.answer = delete made.alpha;
#
# The trap is read off the handler and called as the program would call it. In strict code a trap that says no makes the deletion throw. A trap that says yes is held against the target only where the target may have something that cannot be deleted.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline ResolveAccesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=24 fields=[{key="alpha" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 position=44 fields=[{key="deleteProperty" declared={type=function flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject layout=L0
    PropDefine v3, v2 key="alpha"
    v5 = FinishObject v3
    v6 = NewClosure function=f1
    v7 = NewObject layout=L1
    PropDefine v7, v6 key="deleteProperty"
    v9 = FinishObject v7
    v10 = Builtin builtin=Proxy
    v11 = Construct v10, -, v5, v9 calleeName="Proxy"
    v12 = PropDelete v11 key="alpha"
    PropSet v0, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="deleteProperty" module=m0 position=63 kind=Method flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="alpha"
    v3 = StrictEq v1, v2
    Return v3
}

# CHECK-LABEL: function f0
# CHECK: [[target]]: L0 = FinishObject
# CHECK: [[handler]]: L1 = FinishObject
# CHECK: [[name]]: "alpha" = String string="alpha"
# CHECK: [[answer]]: {{*}} = Call {{*}}, [[handler]], [[target]], [[name]] callees=[f1
# CHECK-NEXT: [[saysYes]]: boolean = ToBoolean [[answer]]
# CHECK: = MayBindAnswersOfHasTraps [[target]]
# CHECK: ThrowNewError errorKind=TypeError message="Unable to delete property."
# CHECK: frequency=Rare:
# CHECK-NEXT: ValidateConsentOfDeleteTrap [[target]], [[name]]
# CHECK-NOT: PropDelete {{*}} key="alpha" {{*}}accessSite
# CHECK-LABEL: function f1
