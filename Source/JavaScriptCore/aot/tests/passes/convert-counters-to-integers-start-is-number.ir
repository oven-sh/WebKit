# A counter that starts at a number that may have a fraction or be infinite stays a number
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 0
# STATISTIC: ConvertCountersToIntegersChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="startIsNumber" parameters=[{type=number}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: number):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: number = Add v3, v2
}

function f1 name="startIsWholeNumber" parameters=[{type=int|whole}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int|whole):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: int|whole = Add v3, v2
}

function f2 name="startIsQuotient" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Div v0, v2
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v4, v1
    Jump -> next b1(v7)
  b3():
    Return
# CHECK: v3: number = Div v0, v2
# CHECK: b1(v4: number):
# CHECK: Branch v6 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v7: number = Add v4, v1
}

function f3 name="decreasingFromNumber" parameters=[{type=number}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: number):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: number = Sub v3, v2
}
