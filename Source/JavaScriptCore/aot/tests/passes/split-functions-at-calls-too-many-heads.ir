# A function with more heads than the limit is cut once, at the common dominator of the blocks that need a frame
# FORM: Selected
# OPTIONS: limit=MaxContinuationsPerFunction:1
# RUN: pass SplitFunctionsAtCalls
# LOSS: MaxContinuationsPerFunction x2 f0
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="threeHeads" parameters=[{type=anything}, {type=i32}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: i32, v2: function):
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Switch v1 cases=[0, 1] -> case b3(), case b4(), otherwise b5()
  b3():
    v4 = Call v2, -, v0
    Return v4
  b4():
    v5 = Call v2, -, v1
    Return v5
  b5():
    v6 = Call v2
    Return v6
}
# CHECK-LABEL: function f0 name="threeHeads"
# CHECK-NOT: Switch
# CHECK: [[rest0]]: anything = CallDirect v0, v1, v2 function=f3
# CHECK-NEXT: ReturnCall [[rest0]]
# CHECK-NOT: CallDirect

function f1 name="oneHead" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Call v1, -, v0
    Return v4
  b4():
    Return v1
}
# CHECK-LABEL: function f1 name="oneHead"
# CHECK: TypeTest v0 testedType=string
# CHECK: [[rest1]]: anything = CallDirect v0, v1 function=f4
# CHECK-NEXT: ReturnCall [[rest1]]

function f2 name="headsMeetOnlyInEntryBlock" parameters=[{type=anything}, {type=i32}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: i32, v2: function):
    Switch v1 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    Return v0
  b2():
    v3 = Call v2, -, v0
    Return v3
  b3():
    v4 = Call v2
    Return v4
}
# CHECK-LABEL: function f2 name="headsMeetOnlyInEntryBlock"
# CHECK-NOT: CallDirect
# CHECK-COUNT-2: = Call v2
# CHECK-NOT: CallDirect

# CHECK-LABEL: function f3 name="threeHeads" module=m0 role=Continuation{{*}}derivation={source=f0{{*}}} creator=Continuation{origin=f0}
# CHECK: Switch
# CHECK-COUNT-3: = Call
# CHECK-LABEL: function f4 name="oneHead" module=m0 role=Continuation{{*}}derivation={source=f1{{*}}} creator=Continuation{origin=f1}
# CHECK-NOT: testedType=string
# CHECK: = Call
# CHECK-NOT: function f5
