# Only the first InitializeBuiltin of a member does anything. Where every turn of a hot loop runs one, the first turn stands in front of the loop with it, and the loop has none.
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass UnrollShortLoops

module m0 path="main.js" displayPath="main.js"
function f0 name="everyTurn" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    InitializeBuiltin builtin=DateNow
    v8 = Add v3, v0
    v9 = Increment v4
    Jump -> next b1(v8, v9)
  b3():
    Return v3
# CHECK: Jump -> next [[first]](v1, v2)
# CHECK: b1(v3: int|whole, v4: int|whole):
# CHECK-NEXT: LoopHint
# CHECK: b2():
# CHECK-NOT: InitializeBuiltin
# CHECK: Jump -> next b1(
# CHECK: [[body]]():
# CHECK-NEXT: InitializeBuiltin builtin=DateNow
# CHECK: Jump -> next b1(
# CHECK: [[first]]({{*}}):
# CHECK-NOT: LoopHint
# CHECK: Branch {{*}} -> taken [[body]](), notTaken b3(
}

function f1 name="onlySomeTurns" parameters=[{type=i32}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(), notTaken b5()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    InitializeBuiltin builtin=DateNow
    Jump -> next b4()
  b4():
    v9 = Add v4, v0
    v10 = Increment v5
    Jump -> next b1(v9, v10)
  b5():
    Return v4
# CHECK: Jump -> next b1(v2, v3)
# CHECK: b3():
# CHECK-NEXT: InitializeBuiltin builtin=DateNow
}

function f2 name="oneOfTwoInEveryTurn" parameters=[{type=i32}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    InitializeBuiltin builtin=DateUTC
    v8 = Less v5, v0
    Branch v8 -> taken b2(), notTaken b5()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    InitializeBuiltin builtin=DateNow
    Jump -> next b4()
  b4():
    v10 = Add v4, v0
    v11 = Increment v5
    Jump -> next b1(v10, v11)
  b5():
    Return v4
# CHECK: Jump -> next [[firstOfTwo]](v2, v3)
# CHECK: b1(v4: int|whole, v5: int|whole):
# CHECK-NEXT: LoopHint
# CHECK-NOT: InitializeBuiltin builtin=DateUTC
# CHECK: b3():
# CHECK-NEXT: InitializeBuiltin builtin=DateNow
# CHECK: [[firstOfTwo]]({{*}}):
# CHECK-NEXT: InitializeBuiltin builtin=DateUTC
}

# A call of code that nobody knows stands in every turn: a copy of the turn would buy nothing.
function f3 name="besideACall" parameters=[{type=i32}, {type=anything}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    InitializeBuiltin builtin=DateNow
    v9 = Call v1, -, v0
    v10 = Add v4, v0
    v11 = Increment v5
    Jump -> next b1(v10, v11)
  b3():
    Return v4
# CHECK: Jump -> next b1(v2, v3)
# CHECK: b2():
# CHECK-NEXT: InitializeBuiltin builtin=DateNow
}

# The wider cycle has no mark of its own. It leaves the first turn and comes round to it again without a step into the loop, so the turn keeps the mark.
function f4 name="insideACycleWithoutAMarkOfItsOwn" parameters=[{type=i32}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    Jump -> next b2(v4, v5)
  b2(v6, v7):
    LoopHint
    v9 = Less v7, v0
    Branch v9 -> taken b3(), notTaken b6()
  b3():
    InitializeBuiltin builtin=DateNow
    v11 = Add v6, v0
    v12 = Increment v7
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b2(v11, v12)
  b5():
    Jump -> next b1(v11, v12)
  b6():
    Return v6
# CHECK: b1({{*}}):
# CHECK-NEXT: Jump -> next [[turnInCycle]](
# CHECK: b3():
# CHECK-NOT: InitializeBuiltin
# CHECK: Branch v1
# CHECK: [[turnInCycle]]({{*}}):
# CHECK-NEXT: LoopHint
}
