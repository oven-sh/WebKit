# An allocation that is given its prototype is no birth that can be flattened, whatever it lists: no field of its layout loses its object. The first field that it lists is given a fresh object,
# the second one a parameter: whoever looked at the first value for both fields took the parameter for an allocation.
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass FlattenInnerObjects
# STATISTIC: FieldsHoldingFlattenedObjects = 0
# CHECK: outcome: Unchanged

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Segment" fields=[{key="a" declared={type=L1} flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=OnlyAccessed} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=L1} flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=OnlyAccessed} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, ChangeIntegrity] keys=NeverEnumerated}
layout L1 name="Point" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Double number=0.5
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = CallDirect v3 function=f2
    Return
}

function f1 name="makeSegment" parameters=[{type=number}, {type=L1}, {type=object}] results=[{type=L0}] {
  b0(v0: number, v1: L1, v2: object):
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = NewObject v2, v3, v1 layout=L0 fields=[0, 1]
    Return v4
}

function f2 name="readSegment" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="a" receivers=[L0] level=Proven
    v2 = GetSlot v1 key="d" receivers=[L1] level=Proven
    v3 = GetSlot v0 key="b" receivers=[L0] level=Proven
    v4 = GetSlot v3 key="d" receivers=[L1] level=Proven
    v5 = Add v2, v4
    Return v5
}
