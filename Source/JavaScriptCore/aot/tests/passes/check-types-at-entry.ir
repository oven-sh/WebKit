# Whoever calls a function by value passes anything, so a parameter with a type from the source, and `this` of a method, is only expected to hold that type.
# The function starts with a check of each, in the order of the entry parameters, and its body goes on with what the checks prove. It stays one function: nothing is copied and nothing throws.
# At the end: what gets no check, and callers as read
# FORM: AsRead
# RUN: pass CheckTypesAtEntry TypeValues VerifyProgram
# STATISTIC: FunctionsWithTypesCheckedAtEntry = 3
# STATISTIC: TypesCheckedAtEntry = 5
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Parameter
typesite w2 module=m0 position=30 kind=Result
typesite w3 module=m0 position=40 kind=Variable
typesite w4 module=m0 position=60 kind=This
typesite w5 module=m0 position=65 kind=Parameter
typesite w6 module=m0 position=70 kind=Result
typesite w7 module=m0 position=50 kind=Field
typesite w8 module=m0 position=85 kind=Parameter
typesite w9 module=m0 position=125 kind=Result
layout L0 kind=Instance name="Meter" fields=[{key="total" declared={type=undefined|null|number site=w7}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    Return
}

function f1 name="describe" module=m0 position=5 flags=[IsChecked] length=3 parameters=[{type=undefined|null|string site=w0}, {type=anything}, {type=undefined|null|number site=w1}] results=[{type=undefined|null|string site=w2}] {
    v3 = PropGet v0 key="length"
    v4 = Convert v3 declared={type=undefined|null|number site=w3}
    v5 = Add v4, v2
    v6 = Add v0, v5
    v7 = Convert v6 declared={type=undefined|null|string site=w2}
    Return v7
}
# CHECK-LABEL: function f1 name="describe" module=m0 position=5 flags=[IsChecked] length=3 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[IsExpected]}, {type=anything}, {type=undefined|null|number site=w1 flags=[IsExpected]}] results=[{type=undefined|null|string site=w2}]
# CHECK-NOT: derivation=
# CHECK: b0(v0: anything ~ undefined|null|string, v1: anything, v2: anything ~ undefined|null|number):
# CHECK-NEXT: [[text]]: undefined|null|string = Check v0 castType=undefined|null|string site=w0 @10
# CHECK-NEXT: [[count]]: undefined|null|number = Check v2 castType=undefined|null|number site=w1 @20
# CHECK-NEXT: = PropGet [[text]] key="length"
# CHECK: = Add {{*}}, [[count]]
# CHECK-NEXT: = Add [[text]],

# `this` of a method is checked like a parameter, and first
function f2 name="add" module=m0 position=60 kind=Method flags=[HasThis, IsChecked] length=1 thisType={type=L0 site=w4} parameters=[{type=undefined|null|number site=w5}] results=[{type=undefined|null|number site=w6}] {
    v2 = PropGet v0 key="total"
    v3 = Add v2, v1
    v4 = Convert v3 declared={type=undefined|null|number site=w7}
    PropSet v0, v4 key="total"
    v6 = Convert v4 declared={type=undefined|null|number site=w6}
    Return v6
}
# CHECK-LABEL: function f2 name="add" module=m0 position=60 kind=Method flags=[HasThis, IsChecked] length=1 thisType={type=L0 site=w4 flags=[IsExpected]} parameters=[{type=undefined|null|number site=w5 flags=[IsExpected]}]
# CHECK: b0(v0: anything ~ L0, v1: anything ~ undefined|null|number):
# CHECK-NEXT: [[meter]]: L0 = Check v0 castType=L0 site=w4 @60
# CHECK-NEXT: [[amount]]: undefined|null|number = Check v1 castType=undefined|null|number site=w5 @65
# CHECK-NEXT: = PropGet [[meter]] key="total"
# CHECK: PropSet [[meter]],

# A position that is only expected to hold its type promises nothing, so no check stands for it
function f3 name="scale" module=m0 position=80 kind=Method flags=[HasThis, IsChecked] length=1 thisType={type=function flags=[IsExpected]} parameters=[{type=undefined|null|number site=w8}] results=[{type=anything}] {
    v2 = Mul v1, v1
    Return v2
# CHECK: b0(v0: anything ~ function, v1: anything ~ undefined|null|number):
# CHECK-NEXT: [[factor]]: undefined|null|number = Check v1 castType=undefined|null|number site=w8 @85
# CHECK-NEXT: = Mul [[factor]], [[factor]]
}

function f4 name="untyped" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
# CHECK-NOT: Check
}

# The front end gives every position that it wants checked a place in the source. A type without one only types a value of a test
function f5 name="typedWithoutSite" flags=[IsChecked] parameters=[{type=undefined|null|number}] results=[{type=anything}] {
    Return v0
}
# CHECK-LABEL: function f5 name="typedWithoutSite" {{*}}parameters=[{type=undefined|null|number}]
# CHECK: b0(v0: undefined|null|number):
# CHECK-NOT: Check

function f6 name="onlyExpected" parameters=[{type=undefined|null|number flags=[IsExpected]}] results=[{type=anything}] {
    Return v0
# CHECK: b0(v0: anything ~ undefined|null|number):
# CHECK-NOT: Check
}

# The compiler calls an initializer itself, with the object it has just allocated
function f7 name="fields" kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=anything}] {
    v1 = Undefined
    Return v1
}
# CHECK-LABEL: function f7 name="fields" {{*}}thisType={type=L0 flags=[IsFromCompiler]}
# CHECK: b0(v0: L0):
# CHECK-NOT: Check

# A caller names the same function as before and passes what it passed
function f8 name="calls" module=m0 position=100 flags=[IsChecked] results=[{type=anything}] {
    v0 = String string="a"
    v1 = Undefined
    v2 = Integer integer=1
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = CallDirect v1, v2 function=f3
    v5 = Add v3, v4
    Return v5
# CHECK: [[described]]: undefined|null|string = CallDirect v0, v1, v2 function=f1
# CHECK-NEXT: [[scaled]]: anything = CallDirect v1, v2 function=f3
# CHECK-NEXT: = Add [[described]], [[scaled]]
}

function f9 name="tailCalls" module=m0 position=120 flags=[IsChecked] results=[{type=undefined|null|string site=w9}] {
    v0 = String string="a"
    v1 = Undefined
    v2 = Integer integer=1
    v3 = CallDirect v0, v1, v2 function=f1
    ReturnCall v3
# CHECK: = CallDirect v0, v1, v2 function=f1
# CHECK-NEXT: ReturnCall
# CHECK-NOT: function f10
}
