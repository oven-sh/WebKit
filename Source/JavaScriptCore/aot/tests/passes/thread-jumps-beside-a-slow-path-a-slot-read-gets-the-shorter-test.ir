    Jump -> next b3(v0)
  b2() frequency=Rare:
    Jump -> next b3(v1)
  b3(v3):
    v4 = Integer integer=0
    v5 = TypeTest v3 testedType=Array<number>
    Branch v5 -> taken b4(| 0), notTaken b5(v4)
  b4(v6):
    Return v6
  b5(v7):
    Return v7
# CHECK: b1():
