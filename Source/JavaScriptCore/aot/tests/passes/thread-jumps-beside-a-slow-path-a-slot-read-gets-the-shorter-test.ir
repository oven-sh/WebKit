module m0 path="main.js" displayPath="main.js"

function f0 name="slotReadIsTestedApart" parameters=[{type=undefined|null|Array<number>}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
