# A test of the class in front of the loop also runs where no turn gets to an access. A variable that was read in front of the test that says whether it has been stored may still be empty there
# FORM: Prepared
# RUN: pass SplitUnions

module m0 path="main.js" displayPath="main.js"
variable g0 name="elements" declared={type=Array<number>|Uint8Array} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

function f0 name="mayStillBeEmpty" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    v3 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    Jump -> next b1(v1, v2)
  b1(v4, v5):
    LoopHint
    Branch v0 -> taken b2(), notTaken b4()
  b2():
    v7 = Entered function=f1
    v8 = AssumeType v3, v7 provenType=Array<number>|Uint8Array
    v9 = PropGet v8 key="length"
    v10 = Less v5, v9
    Branch v10 -> taken b3(), notTaken b4()
  b3():
    v11 = ElemGet v8, v5
    v12 = Add v4, v11
    v13 = Increment v5
    Jump -> next b1(v12, v13)
  b4():
    Return v4
}
# CHECK-LABEL: name="mayStillBeEmpty"
# CHECK: = GetModuleVariable variable=g0 [mayPrecedeItsStore]
# CHECK-NEXT: Jump -> next b1(v1, v2)
# CHECK-NEXT: b1(
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Branch v0 -> taken b2(), notTaken b4()

function f1 name="isThere" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    v3 = GetModuleVariable variable=g0
    Jump -> next b1(v1, v2)
  b1(v4, v5):
    LoopHint
    Branch v0 -> taken b2(), notTaken b4()
  b2():
    v7 = PropGet v3 key="length"
    v8 = Less v5, v7
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    v9 = ElemGet v3, v5
    v10 = Add v4, v9
    v11 = Increment v5
    Jump -> next b1(v10, v11)
  b4():
    Return v4
}
# CHECK-LABEL: name="isThere"
# CHECK: = TypeTest v3 testedType=Uint8Array
# CHECK-NEXT: Branch
