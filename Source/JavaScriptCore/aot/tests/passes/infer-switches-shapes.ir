function f0 name="threeTests" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlotOrUndefined v0, v2 key="x" receivers=[L0] level=Proven
    Return v3
  b2():
    v4 = ShapeTest v0 layouts=[L1, L2]
    Branch v4 -> taken b3(| 0), notTaken b4()
  b3(v5):
    v6 = GetSlotOrUndefined v0, v5 key="x" receivers=[L1, L2] level=Proven
    Return v6
  b4():
    v7 = ShapeTest v0 layouts=[L3]
    Branch v7 -> taken b5(| 0), notTaken b6()
  b5(v8):
    v9 = GetSlotOrUndefined v0, v8 key="x" receivers=[L3] level=Proven
    Return v9
  b6():
    v10 = PropGet v0 key="x"
    Return v10
}
# CHECK-LABEL: function f0 name="threeTests"
# CHECK-NEXT: b0(v0: object):
# CHECK-NEXT: SwitchOnShape v0 layoutSets=[{{*}}[L0], [L1, L2], [L3]] -> case b1(| 0), case b3(| 0), case b5(| 0), otherwise b6()
# CHECK-NEXT: b1(v2: guard):
# CHECK-NEXT: = GetSlotOrUndefined v0, v2 key="x" receivers=[L0] level=Proven
# CHECK-NOT: ShapeTest
# CHECK: b3(v5: guard):
# CHECK-NEXT: = GetSlotOrUndefined v0, v5 key="x" receivers=[L1, L2] level=Proven
# CHECK-NOT: ShapeTest
# CHECK: b5(v8: guard):
# CHECK-NEXT: = GetSlotOrUndefined v0, v8 key="x" receivers=[L3] level=Proven
# CHECK-NOT: Branch

