# A loop over Object.entries(object) that alone has the list asks the run time for the keys and values one behind the other in one list, at the moment the call stood for
# Each step makes its pair in compiled code. Somebody else who has the list, or something that runs between the call and the loop, keeps the list of pairs
# FORM: Prepared optimizing
# RUN: pass ExpandIteration

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" declared={type=anything} initialization=Undefined

function f0 name="theLoopAloneHasTheList" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin -, v0 overload=ObjectEntries/0
    v3 = IteratorOpen v2
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b3(), notTaken b2()
  b2():
    v8 = Call v1, -, v7
    Jump -> next b1()
  b3():
    Return
# CHECK-NOT: ObjectEntries
# CHECK-NOT: AssumeType
# CHECK: [[list0]]: Array = CallBuiltin -, v0 overload=CompilerHelpersOwnEntriesFlat/0
# CHECK: [[length0]]: {{*}} = ToLength
# CHECK-NEXT: [[has0]]: boolean = Less [[position0]], [[length0]]
# CHECK-NEXT: Branch [[has0]] -> taken [[step0]](| 0), notTaken
# CHECK: [[step0]]([[index0]]: {{*}}):
# CHECK-NEXT: [[key0]]: {{*}} = ElemGet [[list0]], [[index0]] [keyIsIntegral]
# CHECK: [[behind0]]: {{*}} = Add [[index0]],
# CHECK-NEXT: [[value0]]: {{*}} = ElemGet [[list0]], [[behind0]] [keyIsIntegral]
# CHECK: = NewArray [[key0]], [[value0]]
# CHECK-NOT: IteratorResume
}

function f1 name="throughACastThatTestsNothing" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin -, v0 overload=ObjectEntries/0
    v3 = AssumeType v2 provenType=Array<object>
    v4 = IteratorOpen v3
