# CHECK: [[list1]]: Array = CallBuiltin -, v0 overload=CompilerHelpersOwnEntriesFlat/0
# CHECK: [[length1]]: {{*}} = ToLength
# CHECK-NEXT: [[has1]]: boolean = Less [[position1]], [[length1]]
# CHECK-NEXT: Branch [[has1]] -> taken [[step1]](| 0), notTaken
# CHECK: [[step1]]([[index1]]: {{*}}):
# CHECK-NEXT: [[key1]]: {{*}} = ElemGet [[list1]], [[index1]] [keyIsIntegral]
# CHECK: [[behind1]]: {{*}} = Add [[index1]],
# CHECK-NEXT: [[value1]]: {{*}} = ElemGet [[list1]], [[behind1]] [keyIsIntegral]
# CHECK: = NewArray [[key1]], [[value1]]
# CHECK-NOT: IteratorResume
}

# Nobody has resolved the call yet: its callee is the function itself
function f2 name="theCallIsNotResolved" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Builtin builtin=Object
    v3 = Builtin builtin=ObjectEntries
    v4 = Call v3, v2, v0 calleeName="entries"
    v5 = IteratorOpen v4
    Jump -> next b1()
  b1():
    LoopHint
    v7 = IteratorResume v5
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    v10 = Call v1, -, v9
    Jump -> next b1()
  b3():
    Return
# CHECK-NOT: = Call v3
# CHECK-NOT: AssumeType
# CHECK: [[list2]]: Array = CallBuiltin -, v0 overload=CompilerHelpersOwnEntriesFlat/0
# CHECK: [[length2]]: {{*}} = ToLength
# CHECK-NEXT: [[has2]]: boolean = Less [[position2]], [[length2]]
# CHECK-NEXT: Branch [[has2]] -> taken [[step2]](| 0), notTaken
# CHECK: [[step2]]([[index2]]: {{*}}):
# CHECK-NEXT: [[key2]]: {{*}} = ElemGet [[list2]], [[index2]] [keyIsIntegral]
# CHECK: [[behind2]]: {{*}} = Add [[index2]],
# CHECK-NEXT: [[value2]]: {{*}} = ElemGet [[list2]], [[behind2]] [keyIsIntegral]
# CHECK: = NewArray [[key2]], [[value2]]
# CHECK-NOT: IteratorResume
}

