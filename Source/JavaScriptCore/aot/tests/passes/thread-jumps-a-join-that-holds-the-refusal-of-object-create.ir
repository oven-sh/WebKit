# A join that holds nothing but the test of its parameter is copied for the ways that arrive often, beside a way that is seldom taken and does not decide the test.
# The test that stands for the refusal of Object.create is charged nothing, as the link was that refused before it: a join is copied with that test in it as it was copied without it.
# A test with another error is charged, and the same join stays one block.
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN: function-passes behind-rounds ThreadJumps
# LOSS: MaxInlineHeadBytes
# CHECK: f0 ThreadJumps: Changed
# CHECK-NEXT: f1 ThreadJumps: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="theRefusalOfObjectCreate" parameters=[{type=undefined|null|string}, {type=anything}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2() frequency=Rare:
    Jump -> next b3(v1)
  b3(v4):
    v5 = RequireType v3 requiredType=null|object runtimeError=PrototypeIsNeitherObjectNorNull calledBuiltin=ObjectCreate
    v6 = RequireObjectCoercible v4 name="length"
    v7 = TypeTest v6 testedType=string
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8):
    Return v8
  b5():
    Return v2
# CHECK: b1():
# CHECK-NEXT: Jump -> next b6(v0)
# CHECK-NEXT: b2() frequency=Rare:
# CHECK-NEXT: Jump -> next b3(v1)
# CHECK-NEXT: b3(v4: anything ~ undefined|null|string) frequency=Rare:
# CHECK-NEXT: = RequireType v3 requiredType=null|object runtimeError=PrototypeIsNeitherObjectNorNull calledBuiltin=ObjectCreate
# CHECK: b6(v9: anything ~ undefined|null|string):
# CHECK-NEXT: = RequireType v3 requiredType=null|object runtimeError=PrototypeIsNeitherObjectNorNull calledBuiltin=ObjectCreate
}

function f1 name="aTestWithAnotherError" parameters=[{type=undefined|null|string}, {type=anything}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2() frequency=Rare:
    Jump -> next b3(v1)
  b3(v4):
    v5 = RequireType v3 requiredType=null|object runtimeError=IteratorResultNotObject
    v6 = RequireObjectCoercible v4 name="length"
    v7 = TypeTest v6 testedType=string
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8):
    Return v8
  b5():
    Return v2
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK-NOT: b6
}
