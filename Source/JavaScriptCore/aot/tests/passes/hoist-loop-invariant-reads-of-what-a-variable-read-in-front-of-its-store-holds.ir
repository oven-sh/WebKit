# A read that names a fact stays behind it, and so does what reads through it
# FORM: Prepared
# RUN: pass HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="limit" declared={type=number} flags=[IsImmutable] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation isUnchangedDuringActivation=true}}}]
variable g0 name="scope" declared={type=env L0} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

function f0 name="throughReadBehindFact" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Entered function=f1
    v4 = GetModuleVariable fact=v3 variable=g0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v5 = GetEnvironmentField v4 layout=L0 field=0
    v6 = ToBoolean v5
    Branch v6 -> taken b1(), notTaken b3()
  b3():
    Return v0
# CHECK: b0(
# CHECK-NEXT: Jump
# CHECK: = Entered function=f1
# CHECK-NEXT: = GetModuleVariable fact=v3 variable=g0
# CHECK: b2():
# CHECK-NEXT: = GetEnvironmentField v4
}

function f1 name="throughWhatIsThere" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = GetModuleVariable variable=g0
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = GetEnvironmentField v2 layout=L0 field=0
    v5 = ToBoolean v4
    Branch v5 -> taken b1(), notTaken b3()
  b3():
    Return v0
# CHECK: b0(
# CHECK-NEXT: GetModuleVariable variable=g0
# CHECK-NEXT: = GetEnvironmentField v2
}
