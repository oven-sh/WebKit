# An object that may lose its shape later is the guard of its own shape, slots and integrity right after its allocation, so an access there needs no test
# FORM: Prepared
# RUN: pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Unrelated"
layout L1 name="Scanner" fields=[{key="pos" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="late" declared={type=number}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Freezable" fields=[{key="pos" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype]}

function f0 name="store" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v1, v0 key="pos"
    Return v1
}
# CHECK-LABEL: function f0 name="store"
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: v1: object ~ L1 = NewObject -, v0 layout=L1 fields=[0]
# CHECK-NEXT: PutSlot v1, v1, v0 key="pos" receivers=[L1] level=Predicted
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
function f1 name="store-and-read" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v1, v0 key="pos"
    v3 = PropGet v1 key="pos"
    Return v3
}
# CHECK-LABEL: function f1 name="store-and-read"
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: = NewObject
# CHECK-NEXT: PutSlot v1, v1, v0 key="pos" receivers=[L1] level=Predicted
# CHECK-NEXT: v3: number = GetSlot v1, v1 key="pos" receivers=[L1] level=Predicted
# CHECK-NEXT: Return v3
# CHECK-NEXT: }
function f2 name="through-upcast" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = Upcast v1 castType=anything
    PropSet v2, v0 key="pos"
    Return v2
}
# CHECK-LABEL: function f2 name="through-upcast"
# CHECK: = Upcast v1
# CHECK-NEXT: PutSlot v2, v1, v0 key="pos" receivers=[L1] level=Predicted
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f3 name="fresh-object-is-not-frozen" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    PropSet v1, v0 key="pos"
    Return v1
}
# CHECK-LABEL: function f3 name="fresh-object-is-not-frozen"
# CHECK-NOT: ShapeTest
# CHECK-NOT: IsNotFrozen
# CHECK-NOT: Branch
# CHECK: PutSlot v1, [[guards3]], v0 key="pos" receivers=[L2] level=Predicted
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
function f4 name="slot-filled-at-creation" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v2 = PropGet v1 key="late"
    Return v2
}
# CHECK-LABEL: function f4 name="slot-filled-at-creation"
# CHECK-NOT: ShapeTest
# CHECK-NOT: IsSlotFilled
# CHECK-NOT: Branch
# CHECK: v2: number = GetSlot v1, [[guards4]] key="late" receivers=[L1] level=Predicted
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f5 name="slot-empty-at-creation" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = PropGet v1 key="late"
    Return v2
}
# CHECK-LABEL: function f5 name="slot-empty-at-creation"
# CHECK-NOT: ShapeTest
# CHECK: [[filled5]]: boolean = IsSlotFilled v1, v1 key="late" receivers=[L1] level=Predicted
# CHECK-NEXT: Branch [[filled5]] -> taken
# CHECK-NOT: ShapeTest
# CHECK: = GetSlot v1, [[guards5]] key="late" receivers=[L1] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v1 key="late"
function f6 name="call-gets-the-object" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Call v1, -, v2
    PropSet v2, v0 key="pos"
    Return v2
}
# CHECK-LABEL: function f6 name="call-gets-the-object"
# CHECK: = Call v1, -, v2
# CHECK-NEXT: [[test6]]: boolean =
# CHECK-NEXT: Branch [[test6]] -> taken
# CHECK-NOT: PutSlot v2, v2,
# CHECK: PutSlot v2, [[guard6]], v0 key="pos" receivers=[L1] level=Predicted
# CHECK-NOT: PutSlot v2, v2,
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v2, v0 key="pos"
function f7 name="one-of-two-allocations" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewObject -, v0 layout=L1 fields=[0]
    Jump -> next b3(v2)
  b2():
    v3 = NewObject -, v0 layout=L1 fields=[0]
    Jump -> next b3(v3)
  b3(v4):
    PropSet v4, v0 key="pos"
    Return v4
}
# CHECK-LABEL: function f7 name="one-of-two-allocations"
# CHECK: [[test7]]: boolean = ShapeTest v4 layouts=[L1]
# CHECK-NEXT: Branch [[test7]] -> taken
# CHECK: PutSlot v4, [[guard7]], v0 key="pos" receivers=[L1] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v4, v0 key="pos"
function f8 name="object-keeps-its-shape" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0] [keepsShape]
    PropSet v1, v0 key="pos"
    Return v1
}
# CHECK-LABEL: function f8 name="object-keeps-its-shape"
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: v1: L1 = NewObject
# CHECK-NEXT: PropSet v1, v0 key="pos"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
