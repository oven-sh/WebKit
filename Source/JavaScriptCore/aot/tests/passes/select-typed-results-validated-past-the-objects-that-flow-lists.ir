# Outer reaches three objects and flow lists two at the most, so it allocated nothing at the two calls. No object with a layout comes out of either: there is no parser and no validator,
# and validateByPlan, which makes ordinary objects, does the whole validation. Each call reports one loss
# FORM: AsRead
# OPTIONS: limit=MaxObjectsOfTypedResult:2 report=Declines only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults
# LOSS: MaxObjectsOfTypedResult x2
# STATISTIC: TypedResultsSelected = 2
# STATISTIC: ParsersCreated = 0
# STATISTIC: ValidatorsCreated = 0
# CHECK: decline TypedResultNotSelected f1 v{{*}} None [0] reason=TargetIsNotModeledByFlow
# CHECK: decline TypedResultNotSelected f2 v{{*}} None [0] reason=TargetIsNotModeledByFlow

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0, L1] validation=[{shape=Object{layout=L0 members=[{key="id" node=1 field=0}, {key="inner" node=2 field=1}]} type=L0}, {shape=Primitive{primitive=Number} type=number}, {shape=Object{layout=L1 members=[{key="x" node=1 field=0}]} type=L1}]
layout L0 name="Outer" fields=[{key="id" declared={type=number}}, {key="inner" declared={type=L1}}]
layout L1 name="Inner" fields=[{key="x" declared={type=number}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="sink" [isFreeName]
    v3 = CallDirect v1 function=f1
    v4 = Call v2, -, v3
    v5 = ToString v1
    v6 = CallDirect v5 function=f2
    v7 = Call v2, -, v6
    Return
}
function f1 name="validates" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=BunBundleValidate
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
function f2 name="parses" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
# CHECK-LABEL: function f1 name="validates"
# CHECK-NOT: CallDirect
# CHECK-NOT: BunBundleValidate/0
# CHECK: = CallBuiltin -, v0, {{*}} overload=CompilerHelpersValidateByPlan/0
# CHECK-NOT: CallDirect
# CHECK-LABEL: function f2 name="parses"
# CHECK-NOT: JSONSourceOpen
# CHECK: [[parsed]]{{*}} = CallBuiltin {{*}} overload=JSONParse/{{*}}
# CHECK-NOT: expectedResult
# CHECK: = CallBuiltin -, [[parsed]], {{*}} overload=CompilerHelpersValidateByPlan/0
# CHECK-NOT: role=ValidatingParser
# CHECK-NOT: role=Validator
