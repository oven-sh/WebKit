# Allocations that meet in a block parameter stay in their function when a guard on the parameter lasts across unknown code: it lasts only while the function sees that nothing else holds any of them
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# STATISTIC: ColdSitesOutlined = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="guardOnEitherArray" parameters=[{type=number}, {type=anything}, {type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: anything, v2: object, v3: boolean):
    Switch v0 cases=[0, 1, 2] -> case b1(), case b7(), case b13(), otherwise b19()
  b1() frequency=Rare:
    Branch v3 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v4 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b4(v4)
  b3() frequency=Rare:
    v5 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b4(v5)
  b4(v6: Array) frequency=Rare:
    v7 = IsPristine v6 builtinClass=Array aspects=[Storage]
    TestAndBranch v7 -> taken b5(| 0), notTaken b6()
  b5(v8) frequency=Rare:
    v9 = Integer integer=1
    PropSet v2, v1 key="seen"
    v11 = GetArrayElement v6, v9, v8 level=Predicted [keyIsIntegral]
    Return v11
  b6() frequency=Rare:
    Return
  b7() frequency=Rare:
    Branch v3 -> taken b8(), notTaken b9()
  b8() frequency=Rare:
    v12 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b10(v12)
  b9() frequency=Rare:
    v13 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b10(v13)
  b10(v14: Array) frequency=Rare:
    v15 = IsPristine v14 builtinClass=Array aspects=[Storage]
    TestAndBranch v15 -> taken b11(| 0), notTaken b12()
  b11(v16) frequency=Rare:
    v17 = Integer integer=1
    PropSet v2, v1 key="seen"
    v19 = GetArrayElement v14, v17, v16 level=Predicted [keyIsIntegral]
    Return v19
  b12() frequency=Rare:
    Return
  b13() frequency=Rare:
    Branch v3 -> taken b14(), notTaken b15()
  b14() frequency=Rare:
    v20 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b16(v20)
  b15() frequency=Rare:
    v21 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b16(v21)
  b16(v22: Array) frequency=Rare:
    v23 = IsPristine v22 builtinClass=Array aspects=[Storage]
    TestAndBranch v23 -> taken b17(| 0), notTaken b18()
  b17(v24) frequency=Rare:
    v25 = Integer integer=1
    PropSet v2, v1 key="seen"
    v27 = GetArrayElement v22, v25, v24 level=Predicted [keyIsIntegral]
    Return v27
  b18() frequency=Rare:
    Return
  b19():
    Return v1
}
# CHECK-LABEL: function f0
# CHECK-NOT: CallDirect
# CHECK-COUNT-6: = NewArray v1, v1, v1, v1 contents=anything
# CHECK-NOT: CallDirect

function f1 name="eitherArrayWithoutGuard" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: anything, v2: boolean):
    Switch v0 cases=[0, 1, 2] -> case b1(), case b5(), case b9(), otherwise b13()
  b1() frequency=Rare:
    Branch v2 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v3 = NewArray v1, v1, v1, v1 contents=anything
