  b3() frequency=Rare:
    v4 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b4(v4)
  b4(v5: Array) frequency=Rare:
    Return v5
  b5() frequency=Rare:
    Branch v2 -> taken b6(), notTaken b7()
  b6() frequency=Rare:
    v6 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b8(v6)
  b7() frequency=Rare:
    v7 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b8(v7)
  b8(v8: Array) frequency=Rare:
    Return v8
  b9() frequency=Rare:
    Branch v2 -> taken b10(), notTaken b11()
  b10() frequency=Rare:
    v9 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b12(v9)
  b11() frequency=Rare:
    v10 = NewArray v1, v1, v1, v1 contents=anything
    Jump -> next b12(v10)
  b12(v11: Array) frequency=Rare:
    Return v11
  b13():
    Return v1
}
