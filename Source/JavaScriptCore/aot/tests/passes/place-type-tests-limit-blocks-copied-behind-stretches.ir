# The copy behind a failed test goes on behind the stretch only while that takes at most MaxBlocksCopiedBehindStretches blocks. Over it the stretch alone is copied, and the copy joins the tested code right behind it.
# A long copy keeps the rest of the function slow once a test has failed.
# FORM: Prepared
# RUN: pass PlaceTypeTests
# STATISTIC: StretchesNotClonable = 0
# STATISTIC: StretchCopiesToEndOfFunction = 1
# LOSS: MaxBlocksCopiedBehindStretches x1 f1

module m0 path="main.js" displayPath="main.js"

