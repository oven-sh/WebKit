# A spread into a new literal that has no property yet, from an object that is expected to have the literal's own layout, copies the slots and the key order at once: one operation that tests the source itself, so that no proof has to outlive what lies between a test and the copy, and no arm per key order. A literal that has a property, excluded keys, another layout, or a field whose slot is more than its bits is copied field by field
# FORM: Prepared optimizing
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass ExpandOwnKeys

module m0 path="main.js" displayPath="main.js"
layout L0 name="State" fields=[{key="a" declared={type=number}}, {key="b" declared={type=string}}, {key="c" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1, 2]}, {fields=[2, 0]}]}
layout L1 name="Other" fields=[{key="a" declared={type=number}}, {key="b" declared={type=string}}, {key="c" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1, 2]}]}
layout L2 name="WithMethod" fields=[{key="run" declared={type=function} flow={location={deferral=CapturesObject deferredFunction=f7}}}] flow={constructorOrders=[{fields=[0]}]}
layout L3 name="StoredOnce" fields=[{key="a" declared={type=number} flow={location={stores=AtMostOnce}}}] flow={constructorOrders=[{fields=[0]}]}

function f0 name="sameLayout" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    v2 = NewObject layout=L0
    CopyDataProperties v2, v0
    PropDefine v2, v1 key="a"
    v5 = FinishObject v2
    Return v5
}
# CHECK-LABEL: function f0 name="sameLayout"
# CHECK: v2:{{*}}= NewObject layout=L0
# CHECK-NEXT: [[copied0]]: boolean = TryCopyFields v2, v0 layout=L0
# CHECK-NEXT: Branch [[copied0]]
# CHECK-NOT: ShapeTest
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: GetSlot
# CHECK: frequency=Rare:
# CHECK-NEXT: CopyDataProperties v2, v0

function f1 name="provenSameLayout" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = NewObject layout=L0
    CopyDataProperties v1, v0
    v3 = FinishObject v1
    Return v3
}
# CHECK-LABEL: function f1 name="provenSameLayout"
# CHECK: v1:{{*}}= NewObject layout=L0
# CHECK-NEXT: [[copied1]]: boolean = TryCopyFields v1, v0 layout=L0
# CHECK-NOT: ShapeTest
# CHECK: CopyDataProperties v1, v0

function f2 name="literalHasProperty" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    v2 = NewObject -, v1 layout=L0 fields=[0]
    CopyDataProperties v2, v0
    v4 = FinishObject v2
    Return v4
}
# CHECK-LABEL: function f2 name="literalHasProperty"
# CHECK-NOT: TryCopyFields
# CHECK: = HasKeyOrder v0, {{*}} layout=L0 fields=[0, 1, 2]

function f3 name="propertyDefinedFirst" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    v2 = NewObject layout=L0
    PropDefine v2, v1 key="a"
    CopyDataProperties v2, v0
    v5 = FinishObject v2
    Return v5
}
# CHECK-LABEL: function f3 name="propertyDefinedFirst"
# CHECK-NOT: TryCopyFields
# CHECK: = HasKeyOrder v0, {{*}} layout=L0 fields=[0, 1, 2]

function f4 name="excludedKey" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = NewObject layout=L0
    CopyDataProperties v1, v0 excludedKeys=["a"]
    v3 = FinishObject v1
    Return v3
}
# CHECK-LABEL: function f4 name="excludedKey"
# CHECK-NOT: TryCopyFields
# CHECK: = HasKeyOrder v0, {{*}} layout=L0 fields=[0, 1, 2]

function f5 name="otherLayout" parameters=[{type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: object ~ L1):
    v1 = NewObject layout=L0
    CopyDataProperties v1, v0
    v3 = FinishObject v1
    Return v3
}
# CHECK-LABEL: function f5 name="otherLayout"
# CHECK-NOT: TryCopyFields
# CHECK: = HasKeyOrder v0, {{*}} layout=L1 fields=[0, 1, 2]

function f6 name="slotsThatAreMoreThanBits" parameters=[{type=object predicted=L2}, {type=object predicted=L3}] results=[{type=anything}] {
  b0(v0: object ~ L2, v1: object ~ L3):
    v2 = NewObject layout=L2
    CopyDataProperties v2, v0
    v4 = FinishObject v2
    v5 = NewObject layout=L3
    CopyDataProperties v5, v1
    v7 = FinishObject v5
    Return v7
}
# CHECK-LABEL: function f6 name="slotsThatAreMoreThanBits"
# CHECK-NOT: TryCopyFields
# CHECK: Return

function f7 name="run" results=[{type=anything}] {
  b0():
    Return
}
