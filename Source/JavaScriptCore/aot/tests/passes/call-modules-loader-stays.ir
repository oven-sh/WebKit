# The run time's own algorithm evaluates a module that awaits, a module with a deferred import and whatever imports one of them. What they import beside that evaluates itself where that saves the loader a module
# FORM: Prepared
# RUN: pass CallModules
# STATISTIC: ModulesWithState = 1
# STATISTIC: ModulesWithoutState = 1
# CHECK: outcome: Changed

variable g0 name="a" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}, {target=m6 completes=true}]
module m1 path="/plain.js" displayPath="plain.js" body=f1 requests=[{target=m5 completes=true}] exports=[{name="a" variable=g0}]
module m2 path="/between.js" displayPath="between.js" body=f2 requests=[{target=m3 completes=true}, {target=m1 completes=true}]
module m3 path="/awaits.js" displayPath="awaits.js" flags=[HasTopLevelAwait] body=f3
module m4 path="/defers.js" displayPath="defers.js" body=f4 requests=[{target=m1 phase=Defer}]
module m5 path="/below.js" displayPath="below.js" body=f5
module m6 path="/alone.js" displayPath="alone.js" body=f6
entry module=m0
entry module=m4
# CHECK: module m0 path="/main.js" displayPath="main.js" body=f0
# CHECK: module m1 {{*}}flags=[EvaluatesItself] body=f1
# CHECK: module m2 path="/between.js" displayPath="between.js" body=f2
# CHECK: module m3 {{*}}flags=[HasTopLevelAwait] body=f3
# CHECK: module m4 path="/defers.js" displayPath="defers.js" body=f4
# CHECK: module m5 path="/below.js" displayPath="below.js" namespaceLayout=
# CHECK: module m6 path="/alone.js" displayPath="alone.js" body=f6

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    PutModuleVariable v0 variable=g0
    Return
# CHECK-NOT: ModuleEvaluation
# CHECK-NOT: CallDirect
}
function f1 name="plain" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
# CHECK: = BeginModuleEvaluation module=m1
# CHECK: = CallDirect function=f5
# CHECK-NEXT: = CallDirect function=f7
# CHECK-NEXT: FinishModuleEvaluation module=m1
}
function f2 name="between" module=m2 kind=Module results=[{type=anything}] {
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g0
    Return
# CHECK-NOT: ModuleEvaluation
# CHECK-NOT: CallDirect
}
function f3 name="awaits" module=m3 kind=Module flags=[IsAsync] results=[{type=anything}] {
    v0 = Integer integer=3
    v1 = Await v0
    Return
# CHECK-NOT: ModuleEvaluation
}
function f4 name="defers" module=m4 kind=Module results=[{type=anything}] {
    v0 = Integer integer=4
    PutModuleVariable v0 variable=g0
    Return
# CHECK-NOT: ModuleEvaluation
}
function f5 name="below" module=m5 kind=Module results=[{type=anything}] {
    v0 = Integer integer=5
    PutModuleVariable v0 variable=g0
    Return
# Only the walk of plain.js comes to it.
# CHECK-NOT: ModuleEvaluation
# CHECK-NOT: CallDirect
}

# The loader calls it whatever its form is, and it calls nothing: there is no call to save.
function f6 name="alone" module=m6 kind=Module results=[{type=anything}] {
    v0 = Integer integer=6
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-LABEL: function f6 name="alone"
# CHECK-NOT: ModuleEvaluation
# CHECK-LABEL: function f7 name="plain"{{*}}derivation={source=f1}
# CHECK-NOT: function f8
