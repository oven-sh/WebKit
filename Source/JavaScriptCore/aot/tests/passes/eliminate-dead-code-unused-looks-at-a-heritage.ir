# The look at what a class extends throws unless that is null or a constructor whose prototype property holds an object or null.
# A look that nobody uses goes where the type of the heritage leaves only classes, built-in constructors with a prototype object, and null.
# A type that is owed to a check does not count: the generic version of the function has no such check.
# FORM: Prepared
# RUN: pass EliminateDeadCode

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Plain" module=m0 constructor=f10 flow={baseState=None} classFlow={evaluations=AtMostOnce}
function f0 name="builtInConstructor" results=[{type=undefined}] {
    v0 = Builtin builtin=Error
    v1 = ResolveHeritage v0
    Return
# CHECK-NOT: ResolveHeritage
}

function f1 name="null" results=[{type=undefined}] {
    v0 = Null
    v1 = ResolveHeritage v0
    Return
# CHECK-NOT: ResolveHeritage
}

function f2 name="class" parameters=[{type=f10}] results=[{type=undefined}] {
    v1 = ResolveHeritage v0
    Return
# CHECK-NOT: ResolveHeritage
}

function f3 name="classOrNull" parameters=[{type=null|f10}] results=[{type=undefined}] {
    v1 = ResolveHeritage v0
    Return
# CHECK-NOT: ResolveHeritage
}

function f4 name="classOrUndefined" parameters=[{type=undefined|f10}] results=[{type=undefined}] {
    v1 = ResolveHeritage v0
    Return
# CHECK: = ResolveHeritage v0
}

function f5 name="constructorWithoutPrototype" results=[{type=undefined}] {
    v0 = Builtin builtin=Proxy
    v1 = ResolveHeritage v0
    Return
# CHECK: = ResolveHeritage v0
}

function f6 name="namespace" results=[{type=undefined}] {
    v0 = Builtin builtin=Math
    v1 = ResolveHeritage v0
    Return
# CHECK: = ResolveHeritage v0
}

function f7 name="ordinaryFunction" parameters=[{type=f11}] results=[{type=undefined}] {
    v1 = ResolveHeritage v0
    Return
# CHECK: = ResolveHeritage v0
}

function f8 name="anything" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = ResolveHeritage v0
    Return
# CHECK: = ResolveHeritage v0
}

function f9 name="classBehindACheck" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Check v0 expectedType=f10
    v2 = ResolveHeritage v1
    Return
# CHECK: = ResolveHeritage v1
}

function f10 name="Plain" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}

function f11 name="ordinary" results=[{type=undefined}] {
    Return
}

function f12 name="used" results=[{type=anything}] {
    v0 = Builtin builtin=Error
    v1 = ResolveHeritage v0
