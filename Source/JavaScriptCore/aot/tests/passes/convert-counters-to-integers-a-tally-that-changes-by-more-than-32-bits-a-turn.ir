# The bounds of a tally are its start and what a turn changes times the number of turns. The constants of one turn add up to more than 32 bits here. Where the product with the turns of a counter over a length has more than 64, the tally stays a number.
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# CHECK: outcome: Changed
# LOSS: MaxCounterStep x4 f0

module m0 path="main.js" displayPath="main.js"

function f0 name="goesUpByFourTimesTheGreatestInt32" parameters=[{type=int[0, 4294967295]}] results=[{type=number}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v2, v1)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=2147483647
    v8 = Add v3, v7
    v9 = Add v8, v7
    v10 = Add v9, v7
    v11 = Add v10, v7
    v12 = Increment v4
    Jump -> next b1(v11, v12)
  b3():
    Return v3
# CHECK: b1(v3: int|whole, v4: int[0, 4294967295]):
# CHECK-NOT: AssumeType
# CHECK: Jump -> next b1(v11,
# CHECK: Return v3
}

