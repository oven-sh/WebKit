# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Node" fields=[{key=#"#"@L0 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}, {key=#"#inner"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}, {key=#"#other"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]

function f0 name="sideBySide" parameters=[{type=anything}, {type=classtoken}] results=[{type=anything}] {
    v2 = PrivateGet v0, v1 layout=L0 field=1
    v3 = PrivateGet v0, v1 layout=L0 field=1
    Return v3
# CHECK: v2: anything = PrivateGet v0, v1 layout=L0 field=1
# CHECK-NEXT: Return v2
}

function f1 name="behindATestOfWhatWasRead" parameters=[{type=anything}, {type=classtoken}] results=[{type=anything}] {
    v2 = PrivateGet v0, v1 layout=L0 field=1
    v3 = TypeTest v2 testedType=undefined|null
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Undefined
    Return v4
  b2():
    v5 = PrivateGet v0, v1 layout=L0 field=1
    Return v5
# CHECK: b2():
# CHECK-NEXT: Return v2
}

function f2 name="behindAStore" parameters=[{type=anything}, {type=classtoken}, {type=anything}] results=[{type=anything}] {
    v3 = PrivateGet v0, v1 layout=L0 field=1
    PrivateSet v0, v1, v2 layout=L0 field=1
    v5 = PrivateGet v0, v1 layout=L0 field=1
    Return v5
# CHECK: PrivateSet
# CHECK-NEXT: = PrivateGet v0, v1 layout=L0 field=1
}

function f3 name="behindACall" parameters=[{type=anything}, {type=classtoken}, {type=anything}] results=[{type=anything}] {
    v3 = PrivateGet v0, v1 layout=L0 field=1
    v4 = Call v2
    v5 = PrivateGet v0, v1 layout=L0 field=1
    Return v5
# CHECK: = Call v2
# CHECK-NEXT: = PrivateGet v0, v1 layout=L0 field=1
}

function f4 name="whereTwoWaysJoin" parameters=[{type=anything}, {type=classtoken}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PrivateGet v0, v1 layout=L0 field=1
    Jump -> next b2()
  b2():
    v4 = PrivateGet v0, v1 layout=L0 field=1
    Return v4
# CHECK: b2():
# CHECK-NEXT: = PrivateGet v0, v1 layout=L0 field=1
}

function f5 name="others" parameters=[{type=anything}, {type=classtoken}, {type=anything}, {type=classtoken}] results=[{type=anything}] {
    v4 = PrivateGet v0, v1 layout=L0 field=1
    v5 = PrivateGet v2, v1 layout=L0 field=1
    v6 = PrivateGet v0, v3 layout=L0 field=1
    v7 = PrivateGet v0, v1 layout=L0 field=2
    v8 = NewArray v4, v5, v6, v7 contents=anything holes=[]
    Return v8
# CHECK: = PrivateGet v0, v1 layout=L0 field=1
# CHECK-NEXT: = PrivateGet v2, v1 layout=L0 field=1
# CHECK-NEXT: = PrivateGet v0, v3 layout=L0 field=1
# CHECK-NEXT: = PrivateGet v0, v1 layout=L0 field=2
}
