# All that a poll throws to a handler is the error that an allocation has left to it. Where the likely turns of a loop allocate nothing, the poll of the loop has no handler.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveRedundantHandlers

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]

function f0 name="nothingAllocates" parameters=[{type=int[0, 100]}] results=[{type=anything}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2) handler=b4():
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5) handler=b4():
    v6 = Integer integer=1
    v7 = Add v5, v6
    Jump -> next b1(v7)
  b3():
    Return v2
  b4() role=CatchHandler:
    v8 = CatchValue
    Return v8
# CHECK-NOT: handler=
# CHECK-NOT: CatchValue
# CHECK: LoopHint
# CHECK-NOT: LoopHint
}

function f1 name="allocatesInFrontOfTheLoop" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 100], v1: anything) handler=b4():
    v2 = Call v1
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4) handler=b4():
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7) handler=b4():
    v8 = Integer integer=1
    v9 = Add v7, v8
    Jump -> next b1(v9)
  b3():
    Return v2
  b4() role=CatchHandler:
    v10 = CatchValue
    Return v10
# CHECK: handler=b4():
# CHECK-NEXT: = Call v1
# CHECK: Jump -> next b1(
# CHECK-NEXT: b1(v4: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK-NOT: LoopHint
# CHECK-NOT: handler=
# CHECK: role=CatchHandler
}

function f2 name="likelyTurnsAllocate" parameters=[{type=int[0, 100]}] results=[{type=anything}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2) handler=b4():
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5) handler=b4():
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = Integer integer=1
    v8 = Add v5, v7
    Jump -> next b1(v8)
  b3():
    Return v2
  b4() role=CatchHandler:
    v9 = CatchValue
    Return v9
# CHECK: b1(v2: {{*}}) handler=b4():
# CHECK-NEXT: LoopHint
# CHECK: b2(v5: {{*}}) handler=b4():
# CHECK-NOT: LoopHint
# CHECK: role=CatchHandler
}

function f3 name="rarePathAllocates" parameters=[{type=int[0, 100]}, {type=boolean}] results=[{type=anything}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3) handler=b6():
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b5()
  b2(v6) handler=b6():
    Branch v1 -> taken b3(), notTaken b4()
  b3() frequency=Rare handler=b6():
    v7 = NewObject -, v6 layout=L0 fields=[0]
    Jump -> next b4()
  b4() handler=b6():
    v8 = Integer integer=1
    v9 = Add v6, v8
    Jump -> next b1(v9)
  b5():
    Return v3
  b6() role=CatchHandler:
    v10 = CatchValue
    Return v10
# CHECK: b1(v3: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK: b3() frequency=Rare handler=b6():
# CHECK-NEXT: = NewObject
# CHECK-NEXT: Jump -> next b4()
# CHECK-NEXT: b4():
# CHECK-NOT: LoopHint
# CHECK: role=CatchHandler
}

function f4 name="rarePathComesBackToWhatMayThrow" parameters=[{type=int[0, 100]}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4) handler=b6():
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b5()
  b2(v7) handler=b6():
    Branch v1 -> taken b3(), notTaken b4()
  b3() frequency=Rare handler=b6():
    v8 = NewObject -, v7 layout=L0 fields=[0]
    Jump -> next b4()
  b4() handler=b6():
    v9 = RequireObjectCoercible v2
    v10 = Integer integer=1
    v11 = Add v7, v10
    Jump -> next b1(v11)
  b5():
    Return v4
  b6() role=CatchHandler:
    v12 = CatchValue
    Return v12
# CHECK: b1(v4: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK: b3() frequency=Rare handler=b6():
# CHECK-NEXT: = NewObject
# CHECK-NEXT: Jump -> next b4()
# CHECK-NEXT: b4() handler=b6():
# CHECK-NEXT: = RequireObjectCoercible
# CHECK-NOT: LoopHint
# CHECK: role=CatchHandler
}

function f5 name="blockOfThePollMayThrow" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3) handler=b4():
    LoopHint
    v5 = RequireObjectCoercible v1
    v6 = Less v3, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7) handler=b4():
    v8 = Integer integer=1
    v9 = Add v7, v8
    Jump -> next b1(v9)
  b3():
    Return v3
  b4() role=CatchHandler:
    v10 = CatchValue
    Return v10
# CHECK: b1(v3: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Jump -> next [[rest]]()
# CHECK: [[rest]]() handler=b4():
# CHECK-NEXT: = RequireObjectCoercible
}

function f6 name="innerOfTwoHandlers" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 100], v1: anything) handler=b6():
    v2 = Call v1
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4) handler=b5():
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7) handler=b5():
    v8 = Integer integer=1
    v9 = Add v7, v8
    Jump -> next b1(v9)
  b3() handler=b6():
    v10 = Call v1
    Jump -> next b4(v10)
  b4(v11):
    Return v11
  b5() role=CatchHandler handler=b6():
    v12 = CatchValue
    v13 = Call v1
    Jump -> next b4(v13)
  b6() role=CatchHandler:
    v14 = CatchValue
    Return v14
# CHECK: handler=b6():
# CHECK-NEXT: = Call v1
# CHECK: Jump -> next b1(
# CHECK-NEXT: b1(v4: {{*}}):
# CHECK-NEXT: LoopHint
# CHECK-NOT: handler=b5()
}
