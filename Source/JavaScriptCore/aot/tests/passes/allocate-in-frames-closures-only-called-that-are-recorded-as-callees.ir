# A closure without captures that is only called need not be made, also where its function records its callee: the entrypoint writes the closure that the closure table holds into the list.
# Nothing else of these functions has a form for the frame, and what the uses of the closure say still counts.
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# RUN(PLAN): frame-plan flow
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect function=f4
    PropSet v5, v1 key="displayName" mode=Strict
    Return
}

function f1 name="callsIt" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f5
    v2 = Call v1, -, v0
    Return v2
}
# CHECK-LABEL: function f1 name="callsIt"
# CHECK: = NewClosure function=f5 {{*}}[isHeldByClosureTable]
# PLAN-LABEL: function f1
# PLAN: v1: Heap ClosureIsNotOnlyCalled

function f2 name="callsItWithAList" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray v0, v0 contents=anything
    v2 = NewClosure function=f5
    v3 = Call v2, -, v1
    Return v3
}
# CHECK-LABEL: function f2 name="callsItWithAList"
# CHECK: = NewClosure function=f5 {{*}}[isHeldByClosureTable]

function f3 name="makesItForNobody" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f5
    Return v0
}
# CHECK-LABEL: function f3 name="makesItForNobody"
# CHECK: = NewClosure function=f5 {{*}}[isHeldByClosureTable]

function f4 name="givesItBack" results=[{type=anything}] {
    v0 = NewClosure function=f5
    Return v0
}
# CHECK-LABEL: function f4 name="givesItBack"
# CHECK-NOT: isHeldByClosureTable
# CHECK-NOT: storage=
# CHECK-LABEL: function f5

function f5 name="returnsItem" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, RecordsCallee] {
    Return v0
}
