# function size(shape) { if (shape.kind === "circle") return shape.radius + shape.radius; return shape.side; }, called in one loop with literals and in another with what JSON.parse made.
# Inlined there, its reads carry what flow saw at them in the function: the layouts of the literals. A test for those would turn away every element, so the reads are asked of the tables, as they are where only parsed objects have the names, and the sum is tested for numbers.
# radiiOfParsed: nothing with a layout is seen to arrive, though a layout has the name.
# -- source: main.js
# function size(shape) {
#   if (shape.kind === "circle") return shape.radius + shape.radius;
#   return shape.side;
# }
# const shapes = [];
# for (let i = 0; i < 8; i++) shapes.push(i % 3 ? { kind: "circle", radius: i + 0.5 } : { kind: "square", side: i + 0.25 });
# const parsed = JSON.parse(JSON.stringify(shapes));
# function sizesOfLiterals() {
#   let sum = 0;
#   for (let i = 0; i < 8; i++) sum += size(shapes[i]);
#   return sum;
# }
# function sizesOfParsed() {
#   let sum = 0;
#   for (let i = 0; i < 8; i++) sum += size(parsed[i]);
#   return sum;
# }
# function radiusOfParsed(shape) {
#   return shape.radius;
# }
# function radiiOfParsed() {
#   let sum = 0;
#   for (let i = 0; i < 8; i++) sum += radiusOfParsed(parsed[i]) || 0;
#   return sum;
# }
# globalThis.answer = sizesOfLiterals() + sizesOfParsed() + radiiOfParsed();
# -- end of source
# FORM: AsRead
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pipeline SeparateUnlikelyLoopPaths
# CHECK-LABEL: name="sizesOfLiterals"
# CHECK: = GetSlot {{*}} key="kind"
# CHECK-LABEL: name="sizesOfParsed"
# CHECK-NOT: testedType=L
# CHECK: = PropGet {{*}} key="kind" {{*}} [asksOnlyTables]
# CHECK-NOT: testedType=L
# CHECK: = PropGet {{*}} key="radius" {{*}} [asksOnlyTables]
# CHECK-NOT: testedType=L
# CHECK-LABEL: name="radiiOfParsed"
# CHECK: = PropGet {{*}} key="radius" {{*}} [asksOnlyTables]

