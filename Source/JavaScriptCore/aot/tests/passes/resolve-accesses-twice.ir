# What the pass has rewritten or marked it does not touch again: the second run changes nothing
# FORM: Prepared
# RUN: pass ResolveAccesses ResolveAccesses
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="one-site-of-each-form" parameters=[{type=L0}, {type=number}, {type=anything}, {type=int}, {type=Uint8Array}, {type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0, v1: number, v2: anything, v3: int, v4: Uint8Array, v5: anything ~ L0):
    v6 = PropGet v0 key="x"
    PropSet v0, v1 key="x"
    v8 = PropHas v0 key="x"
    v9 = PropGet v0 key="missing"
    v10 = PropGet v0 key="hasOwnProperty"
    v11 = ElemGet v4, v3
    v12 = ElemGet v2, v3
    v13 = PropGet v0 key="y"
    v14 = PropGet v5 key="x"
    v15 = NewArray v6, v8, v9, v10, v11, v12, v13, v14 contents=anything
    Return v15
# CHECK-NEXT: b0(v0: L0, v1: number, v2: anything, v3: int, v4: Uint8Array, v5: anything ~ L0):
# CHECK-NEXT: v6: number = GetSlot v0 key="x" receivers=[L0] level=Proven
# CHECK-NEXT: PutSlot v0, -, v1 key="x" receivers=[L0] level=Proven
# CHECK-NEXT: v8: true = Boolean boolean=true
# CHECK-NEXT: v9: undefined = Undefined
# CHECK-NEXT: v10: builtin(ObjectPrototypeHasOwnProperty) = Builtin builtin=ObjectPrototypeHasOwnProperty
# CHECK-NEXT: = GetTypedArrayElement v4, v3 typedArrayType=2 level=Proven [keyIsIntegral]
# CHECK-NEXT: = ElemGet v2, v3 [keyIsIntegral]
# CHECK-NEXT: = PropGet v0 key="y"
# CHECK-NEXT: = PropGet v5 key="x"
# CHECK-NEXT: = NewArray v6, v8, v9, v10, v11, v12, v13, v14 contents=anything
# CHECK-NEXT: Return v15
# CHECK-NEXT: }
}
function f1 name="key-may-have-a-fraction" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(v0: anything, v1: number):
# CHECK-NEXT: v2: anything = ElemGet v0, v1
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
}
