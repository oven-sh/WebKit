# A position that by its type lies inside a list without holes finds an element: the test for bounds is answered, and the read chooses among the elements also where its type leaves out undefined
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 2

module m0 path="main.js" displayPath="main.js"

function f0 name="liesInside" parameters=[{type=number}, {type=number}, {type=int[0, 1]}] results=[{type=number}] {
    v3 = NewArray v0, v1 contents=number
    v4 = AssumeType v3 provenType=Array<number, proven, pristine[Storage, Names, Dense]>
    v5 = HasArrayStorage v4 arrayStorage=Double
    Branch v5 -> taken b1(| 0), notTaken b3()
  b1(v6):
    v7 = IsInBounds v4, v2
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = AllGuards v6, v8
    v10 = GetArrayElement v4, v2, v9 arrayStorage=Double level=Expected [keyIsIntegral, isInBounds]
    Return v10
  b3():
    Return v0
# CHECK-NOT: NewArray
# CHECK-NOT: GetArrayElement
# CHECK: Switch v2 cases=[0] -> case [[join]](v0), otherwise [[join]](v1)
# CHECK: [[join]]([[element]]: number):
}

function f1 name="mayLieBehindTheEnd" parameters=[{type=number}, {type=number}, {type=int[0, 2]}] results=[{type=number}] {
    v3 = NewArray v0, v1 contents=number
    v4 = AssumeType v3 provenType=Array<number, proven, pristine[Storage, Names, Dense]>
    v5 = HasArrayStorage v4 arrayStorage=Double
    Branch v5 -> taken b1(| 0), notTaken b3()
  b1(v6):
    v7 = IsInBounds v4, v2
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = AllGuards v6, v8
    v10 = GetArrayElement v4, v2, v9 arrayStorage=Double level=Expected [keyIsIntegral, isInBounds]
    Return v10
  b3():
    Return v0
# CHECK: v3:{{*}}= NewArray v0, v1 contents=number
# CHECK: v7: boolean = IsInBounds v4, v2
# CHECK: v10: number = GetArrayElement v4, v2, v9
}

function f2 name="liesBehindTheEnd" parameters=[{type=number}, {type=number}, {type=int[2, 5]}] results=[{type=number}] {
    v3 = NewArray v0, v1 contents=number
    v4 = IsInBounds v3, v2
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return v1
# CHECK-NOT: NewArray
# CHECK-NOT: IsInBounds
# CHECK: Jump -> next b2()
}
