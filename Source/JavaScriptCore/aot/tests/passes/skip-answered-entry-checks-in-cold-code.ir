# A shorter entrance is a function more, and pays where the call is expected to run: cold code enters as before.
# The program of skip-answered-entry-checks.ir with every function cold.
# FORM: Prepared
# OPTIONS: heat=EverythingIsCold
# RUN: pass SkipAnsweredEntryChecks VerifyProgram
# STATISTIC: ShorterEntrancesCreated = 0
# CHECK: outcome: Unchanged

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="answersTheFirst" module=m0 parameters=[{type=number}, {type=anything}] results=[{type=number}] {
  b0(v0: number, v1: anything):
    v2 = CallDirect v0, v1 function=f6 [isNeverInlined]
    Return v2
}
function f2 name="answersTheFirstToo" module=m0 parameters=[{type=number}, {type=anything}] results=[{type=number}] {
  b0(v0: number, v1: anything):
    v2 = CallDirect v0, v1 function=f6 [isNeverInlined]
    Return v2
}
function f3 name="answersBoth" module=m0 parameters=[{type=number}, {type=string}] results=[{type=number}] {
  b0(v0: number, v1: string):
    v2 = CallDirect v0, v1 function=f6 [isNeverInlined]
    Return v2
}
function f4 name="answersNone" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=number}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v0, v1 function=f6 [isNeverInlined]
    Return v2
}
function f5 name="answersInAnArmThatIsUnlikely" module=m0 parameters=[{type=number}, {type=anything}] results=[{type=number}] {
  b0(v0: number, v1: anything):
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() frequency=Unlikely:
    v3 = CallDirect v0, v1 function=f6 [isNeverInlined]
    Return v3
}
function f6 name="shared" module=m0 role=EntryChecks flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number flags=[IsExpected]}, {type=string flags=[IsExpected]}] results=[{type=number}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=EntryChecks{body=f7 fallback=f8} {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: number):
    v4 = TypeTest v1 testedType=string
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: string):
    v6 = CallDirect v3, v5 function=f7 [isNeverInlined]
    ReturnCall v6 requirement=Allowed
  b3() frequency=Unlikely:
    v7 = CallDirect v0, v1 function=f8 [isNeverInlined]
    ReturnCall v7 requirement=Allowed
}
function f7 name="shared" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=string}] results=[{type=number}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f6} {
  b0(v0: number, v1: string):
    v2 = Mul v0, v0
    Return v2
}
function f8 name="shared" module=m0 role=GenericVersion flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number flags=[IsExpected]}, {type=string flags=[IsExpected]}] results=[{type=number}] capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f6} creator=Version{provenVersion=f7} {
  b0(v0: anything, v1: anything):
    v2 = ToNumber v0
    Return v2
}
# A shorter entrance has the parameters of the entrance, one for one, and says so: what flow knows of them is found through it
