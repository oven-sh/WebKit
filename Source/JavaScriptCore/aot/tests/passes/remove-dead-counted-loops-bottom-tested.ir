# A loop that steps its counter first and tests the stepped value at the bottom is removed like one that tests at the top
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="testInHeader" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Integer integer=1
    v5 = Add v2, v4
    v6 = Less v5, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Jump -> next b1(v7)
  b3():
    Return
}
# CHECK-LABEL: function f0 name="testInHeader"
# CHECK: b0(
# CHECK-NEXT: Integer
# CHECK-NEXT: Jump -> next b3()
# CHECK-NOT: LoopHint

function f1 name="decreasing" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=100
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Integer integer=1
    v5 = Sub v2, v4
    v6 = GreaterEq v5, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    Jump -> next b1(v7)
  b3():
    Return
}
# CHECK-LABEL: function f1 name="decreasing"
# CHECK: b0(
# CHECK-NEXT: Integer
# CHECK-NEXT: Jump -> next b3()
# CHECK-NOT: LoopHint

function f2 name="testBelowHeader" parameters=[{type=int[0, 100]}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: int[0, 100], v1: boolean):
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b4()
  b3():
    Jump -> next b4()
  b4():
    v5 = Integer integer=1
    v6 = Add v3, v5
    v7 = Less v6, v0
    Branch v7 -> taken b5(| 0), notTaken b6()
  b5(v8):
    Jump -> next b1(v8)
  b6():
    Return
}
# CHECK-LABEL: function f2 name="testBelowHeader"
# CHECK: b0(
# CHECK-NEXT: Integer
# CHECK-NEXT: Jump -> next b6()
# CHECK-NOT: LoopHint

