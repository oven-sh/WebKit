# The arguments a block passes to its handler are read when the block is entered, so a check inside the block does not replace them
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass InsertObjectCoercibleChecks
# STATISTIC: InsertObjectCoercibleChecksChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]

function f0 name="checkInSameBlock" parameters=[{type=undefined|L0}] results=[{type=undefined|L0}] {
  b0(v0: undefined|L0):
    Jump -> next b1()
  b1() handler=b3(v0):
    v1 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b2()
  b2():
    Return v0
  b3(v2) role=CatchHandler:
    v3 = CatchValue
    Return v2
}
# CHECK-LABEL: function f0
# CHECK: b1() handler=b3(v0):
# CHECK-NEXT: [[check0]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK-NEXT: = PropGet [[check0]] key="x"
# CHECK: b2():
# CHECK-NEXT: Return [[check0]]
# CHECK: b3(v2: undefined|L0) role=CatchHandler:

function f1 name="checkInEarlierBlock" parameters=[{type=undefined|L0}, {type=anything}] results=[{type=undefined|L0}] {
  b0(v0: undefined|L0, v1: anything):
    v2 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b1()
  b1() handler=b3(v0):
    v3 = Call v1
    Jump -> next b2()
  b2():
    Return v0
  b3(v4) role=CatchHandler:
    v5 = CatchValue
    Return v4
}
# CHECK-LABEL: function f1
# CHECK: [[check1]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK-NEXT: = PropGet [[check1]] key="x"
# CHECK: b1() handler=b3([[check1]]):
# CHECK: b2():
# CHECK-NEXT: Return [[check1]]
# CHECK: b3(v4: L0) role=CatchHandler:
