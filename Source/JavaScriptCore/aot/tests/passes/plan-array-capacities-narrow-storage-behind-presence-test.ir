# const counts = new Array(256); counts.fill(0); counts[k & 255] = 1; return counts[7] + 1
# PlaceTypeTests has put the test for a present element in front of a read that nothing asks for `undefined`. Every position of a filled array inside its length holds an element: the test goes with the others,
# and the array of small integers becomes a typed array
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# STATISTIC: ArraysNarrowed = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="readBehindPresenceTest" parameters=[{type=i32}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = Integer integer=256
    v2 = CallBuiltin -, v1 overload=Array/2
    v3 = AssumeType v2 castType=Array<int[0, 255]|undefined, proven>
    v4 = Integer integer=0
    v5 = CallBuiltin v3, v4 overload=ArrayPrototypeFill/0
    v6 = Integer integer=255
    v7 = BitAnd v0, v6
    v8 = Integer integer=1
    PutArrayElement v3, v7, v8, v2 level=Proven [keyIsIntegral]
    v10 = Integer integer=7
    v11 = HasArrayStorage v3 arrayStorage=Int32
    Branch v11 -> taken b1(| 0), notTaken b3()
  b1(v12: guard):
    v13 = IsElementPresent v3, v10, v12 arrayStorage=Int32 [keyIsIntegral]
    Branch v13 -> taken b2(| 0), notTaken b3()
  b2(v14: guard):
    v15 = AllGuards v12, v14
    v16 = GetArrayElement v3, v10, v15 arrayStorage=Int32 level=Expected [keyIsIntegral, isPresent]
    v17 = Add v16, v8
    Return v17
  b3() frequency=Rare:
    v18 = ElemGet v3, v10 [keyIsIntegral]
    v19 = Add v18, v8
    Return v19
}
# CHECK-LABEL: function f0 name="readBehindPresenceTest"
# CHECK: v2: Uint8Array = CallBuiltin -, v1 overload=Uint8Array/
# CHECK-NOT: HasArrayStorage
# CHECK-NOT: IsElementPresent
# CHECK: PutTypedArrayElement v2, v7, v8 typedArrayType=2
# CHECK: = GetTypedArrayElement v2, v10 typedArrayType=2
