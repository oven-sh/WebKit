# ExpandProvenIterations runs in front of ResolveBuiltins. An array that only the iteration uses and that a call on a string makes is never built once the call is known to be a split,
# so that iteration waits for ExpandIteration. The result of a call on anything else, and an array that somebody else uses too, have nothing to wait for
# FORM: Prepared optimizing
# RUN: pass ExpandProvenIterations
# RUN(LATER): pass ExpandProvenIterations ResolveBuiltins ExpandIteration

module m0 path="main.js" displayPath="main.js"

function f0 name="callOnString" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = String string=","
    v2 = PropGet v0 key="split"
    v3 = Call v2, v0, v1 calleeKey="split"
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    v5 = IteratorOpen v4
    v6 = Integer integer=0
    Jump -> next b1(v6)
  b1(v7):
    LoopHint
    v9 = IteratorResume v5
    v10 = ResultAt v9
    v11 = ResultAt v9 index=1
    Branch v10 -> taken b3(), notTaken b2()
  b2():
    v12 = Add v7, v11
    Jump -> next b1(v12)
  b3():
    Return v7
}
# CHECK-LABEL: function f0 name="callOnString"
# CHECK: = IteratorOpen v4
# CHECK: = IteratorResume v5
# LATER-LABEL: function f0 name="callOnString"
# LATER-NOT: overload=StringPrototypeSplit
# LATER-NOT: IteratorOpen
# LATER: = CallBuiltin {{*}} overload=StringPrototypeIndexOf/
# LATER: = Substring

function f1 name="callOnAnObject" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = PropGet v0 key="items"
    v2 = Call v1, v0 calleeKey="items"
    v3 = AssumeType v2 castType=Array<string, proven, pristine[Storage, Names]>
    v4 = IteratorOpen v3
    v5 = Integer integer=0
    Jump -> next b1(v5)
  b1(v6):
    LoopHint
    v8 = IteratorResume v4
    v9 = ResultAt v8
    v10 = ResultAt v8 index=1
    Branch v9 -> taken b3(), notTaken b2()
  b2():
    v11 = Add v6, v10
    Jump -> next b1(v11)
  b3():
    Return v6
}
# CHECK-LABEL: function f1 name="callOnAnObject"
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume

function f2 name="arrayIsUsedAgain" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = String string=","
    v2 = PropGet v0 key="split"
    v3 = Call v2, v0, v1 calleeKey="split"
    v4 = AssumeType v3 castType=Array<string, proven, pristine[Storage, Names]>
    v5 = IteratorOpen v4
    Jump -> next b1()
  b1():
    LoopHint
    v7 = IteratorResume v5
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    Jump -> next b1()
  b3():
    Return v4
}
# CHECK-LABEL: function f2 name="arrayIsUsedAgain"
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume
