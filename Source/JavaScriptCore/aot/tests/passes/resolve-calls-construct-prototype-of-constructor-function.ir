    Return
}
function f3 name="Replaced" flags=[HasThis] thisType={type=object written=L3} results=[{type=undefined}] {
  b0(v0: object ? L3):
    Return
}

function f4 name="evaluated-once" parameters=[{type=f0}] results=[{type=anything}] {
