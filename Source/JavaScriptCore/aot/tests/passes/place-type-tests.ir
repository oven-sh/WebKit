# One test covers a stretch of uses of a predicted receiver, the uses take their fast form under its proof, and a failing test enters one generic copy
# FORM: Prepared
# RUN: pass PlaceTypeTests
# STATISTIC: StretchesGuarded = 16
# STATISTIC: TypeTestsPlaced = 23
# STATISTIC: StretchesNotClonable = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Losable" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Permanent" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}
layout L2 kind=Instance name="Shape" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="area" kind=Method function=f1 mutability=Fixed}]}

function f0 name="Shape" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="area" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=number}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}

function f2 name="twoReads" parameters=[{type=object predicted=L0}, {type=function}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: function):
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="y"
    v4 = Call v1, -, v2, v3
    Return v4
}
