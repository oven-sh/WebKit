function f4 name="readsUnderHandler" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0) handler=b2():
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
