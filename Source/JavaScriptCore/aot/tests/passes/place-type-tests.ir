# CHECK: [[test2]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[test2]] -> taken [[passed2]](| 0), notTaken [[failed2]]()
# CHECK-NEXT: [[fast2]]():
# CHECK-NEXT: v2: number = GetSlot v0, [[guard2]] key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: v3: number = GetSlot v0, [[guard2]] key="y" receivers=[L0] level=Predicted
# CHECK-NEXT: Jump -> next [[join2]](v2, v3)
# CHECK-NEXT: [[join2]]([[x2]]: anything{{*}}, [[y2]]: anything{{*}}):
# CHECK-NEXT: v4: anything = Call v1, -, [[x2]], [[y2]]
# CHECK-NEXT: Return v4
# CHECK-NEXT: [[copy2]]() frequency=Unlikely:
# CHECK-NEXT: [[genericX2]]:{{*}}= PropGet v0 key="x"
# CHECK-NEXT: [[genericY2]]:{{*}}= PropGet v0 key="y"
# CHECK-NEXT: Jump -> next [[join2]]([[genericX2]], [[genericY2]])
# CHECK-NEXT: [[passed2]]([[guard2]]: guard):
# CHECK-NEXT: Jump -> next [[fast2]]()
# CHECK-NEXT: [[failed2]]() frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[copy2]]()
# CHECK-NEXT: }

