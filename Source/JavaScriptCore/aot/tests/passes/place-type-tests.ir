function f9 name="gapOfTwoCalls" flags=[IsChecked] parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: function):
    v2 = PropGet v0 key="x"
    v3 = Call v1
    v4 = Call v1
    v5 = PropGet v0 key="y"
    Return v5
}
# The layout of an object and the instance it belongs to outlast any call, so the tests in front of the first read serve both reads however many calls lie between them.
# CHECK-LABEL: function f9 name="gapOfTwoCalls"
# CHECK: = TypeTest v0 testedType=L0
# CHECK-NOT: = TypeTest
# CHECK: v2: number = GetSlot [[narrowed9]], [[own9]] key="x" receivers=[L0] level=Expected
# CHECK-NEXT: v3: anything = Call v1
# CHECK-NEXT: v4: anything = Call v1
# CHECK-NEXT: v5: number = GetSlot [[narrowed9]], [[own9]] key="y" receivers=[L0] level=Expected
# CHECK: frequency=Rare:
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: = Call v1
# CHECK-NEXT: = Call v1
# CHECK-NEXT: = PropGet v0 key="y"
# CHECK-NOT: = TypeTest
# CHECK: = BelongsToInstance [[narrowed9]]
# CHECK-NOT: = BelongsToInstance

function f10 name="alreadyTested" flags=[IsChecked] parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = TypeTest v0 testedType=L0
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v2 key="x" receivers=[L0] level=Expected
    Jump -> next b3(v3)
  b2() frequency=Unlikely:
    v4 = PropGet v0 key="x"
    Jump -> next b3(v4)
  b3(v5):
    Return v5
}
# CHECK-LABEL: function f10 name="alreadyTested"
# CHECK: v1:{{*}}= TypeTest v0 testedType=L0
# CHECK-NOT: = TypeTest
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: v4:{{*}}= PropGet v0 key="x"
# CHECK-NEXT: Jump -> next b3(v4)
# CHECK-NOT: = TypeTest

