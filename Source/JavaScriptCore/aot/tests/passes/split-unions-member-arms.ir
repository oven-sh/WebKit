function f14 name="nullable-receiver" parameters=[{type=undefined|L0|L1}] results=[{type=anything}] {
  b0(v0: undefined|L0|L1):
    v1 = PropGet v0 key="x"
    Return v1
}
# Undefined and null stop no split. The access throws for them, which is what the copy by name in the unlikely rest does.
# CHECK-LABEL: function f14 name="nullable-receiver"
# CHECK-NEXT: b0(v0: undefined|L0|L1):
# CHECK-NEXT: [[isPoint14]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: Branch [[isPoint14]] -> taken [[pointArm14]](| 0), notTaken [[others14]](| 0)
# CHECK-NEXT: [[join14]](v1{{*}}):
# CHECK-NEXT: Return v1
# CHECK-NEXT: [[pointArm14]]([[point14]]: L0):
# CHECK-NEXT: [[fromPoint14]]:{{*}}= PropGet [[point14]] key="x" receivers=[L0]
# CHECK-NEXT: Jump -> next [[join14]]([[fromPoint14]])
# CHECK-NEXT: [[others14]]([[other14]]: undefined|L1):
# CHECK-NEXT: [[isEmpty14]]: boolean = TypeTest [[other14]] testedType=L1
# CHECK-NEXT: Branch [[isEmpty14]] -> taken [[emptyArm14]](| 0), notTaken [[rest14]](| 0)
# CHECK-NEXT: [[emptyArm14]]([[empty14]]: L1):
# CHECK-NEXT: [[fromEmpty14]]:{{*}}= PropGet [[empty14]] key="x" receivers=[L1]
# CHECK-NEXT: Jump -> next [[join14]]([[fromEmpty14]])
# CHECK-NEXT: [[rest14]]([[nullish14]]: undefined) frequency=Unlikely:
# CHECK-NEXT: {{*}}: never = PropGet [[nullish14]] key="x"
# CHECK-NEXT: Unreachable
# CHECK-NEXT: }
# BOTH-LABEL: function f14 name="nullable-receiver"
# BOTH: : number = GetSlot {{*}} key="x" receivers=[L0] level=Proven
