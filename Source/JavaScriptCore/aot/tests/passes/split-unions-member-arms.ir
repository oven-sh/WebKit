# An access on a proven union of layouts whose lookups differ gets one copy per arm behind type tests, and each copy is resolved by its own rule
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitUnions
# RUN(BOTH): pass SplitUnions ResolveAccesses
# STATISTIC: UnionsSplit = 8
# CHECK: outcome: Changed
# CHECK-NOT: SwitchOnShape

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Empty" flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Label" fields=[{key="x" declared={type=string} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 kind=Instance name="Computed" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="x" kind=Getter function=f1 mutability=Fixed}]}
layout L4 kind=Instance name="Callable" constructor=f2 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="x" function=f3 mutability=Fixed}]}
layout L5 kind=Instance name="Plugin" constructor=f4 flags=[HasHeritage] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
function f0 name="Computed" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="x" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="Callable" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f3 name="x" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="Plugin" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]

function f5 name="field-and-absent" parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f5 name="field-and-absent"
# CHECK-NEXT: b0(v0: L0|L1):
# CHECK-NEXT: [[isPoint]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: Branch [[isPoint]] -> taken [[pointArm]](| 0), notTaken [[emptyArm]](| 0)
# CHECK-NEXT: [[join]](v1{{*}}):
# CHECK-NEXT: Return v1
# CHECK-NEXT: [[pointArm]]([[point]]: L0):
# CHECK-NEXT: [[fromPoint]]:{{*}}= PropGet [[point]] key="x" receivers=[L0]
# CHECK-NEXT: Jump -> next [[join]]([[fromPoint]])
# CHECK-NEXT: [[emptyArm]]([[empty]]: L1):
# CHECK-NEXT: [[fromEmpty]]:{{*}}= PropGet [[empty]] key="x" receivers=[L1]
# CHECK-NEXT: Jump -> next [[join]]([[fromEmpty]])
# CHECK-NEXT: }
# BOTH-LABEL: function f5 name="field-and-absent"
# BOTH: : number = GetSlot {{*}} key="x" receivers=[L0] level=Proven
# BOTH: : undefined = Undefined
# BOTH-NOT: PropGet
