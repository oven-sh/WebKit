# What a function may return is a list of variants: literals, constants, an ordinary value. A tag with one bit per variant says which
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitFreshResults VerifyProgram
# RUN(SHAPE): fresh-results

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
layout L1 name="Named" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=string} flags=[IsRequired]}]
layout L2 name="Text" fields=[{key="x" declared={type=string} flags=[IsRequired]}]
variable g0 name="cached" module=m0 declared={type=anything} initialization=Undefined

function f0 name="oneLiteral" parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
}
# SHAPE-LABEL: function f0
# SHAPE-NEXT: fresh variants=[L0{k0:p0 k1:p1}] parts=[number, number]
# CHECK-LABEL: function f0 name="oneLiteral" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker0]] layout=L0} {
# CHECK-NOT: Switch

function f1 name="sameLiteralOnTwoPaths" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = NewObject -, v1, v0 layout=L0 fields=[0, 1]
    Return v4
}
# SHAPE-LABEL: function f1
# SHAPE-NEXT: fresh variants=[L0{k0:p0 k1:p1}] parts=[number, number]
# CHECK-LABEL: function f1 name="sameLiteralOnTwoPaths" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker1]] layout=L0} {
# CHECK-NOT: Switch

function f2 name="literalOrNull" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = Null
    Return v4
}
# SHAPE-LABEL: function f2
# SHAPE-NEXT: fresh tag variants=[L0{k0:p0 k1:p1}, null] parts=[number, number]
# CHECK-LABEL: function f2 name="literalOrNull" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker2]] nullish=Null layout=L0} {
# CHECK: [[call2]]:{{*}}= CallDirect v0, v1, v2 function=[[worker2]]
# CHECK-NEXT: [[tag2]]: i32 = ResultAt [[call2]]
# CHECK-NEXT: [[x2]]: number = ResultAt [[call2]] index=1
# CHECK-NEXT: [[y2]]: number = ResultAt [[call2]] index=2
# CHECK-NEXT: Switch [[tag2]] cases=[1] -> case [[literal2]](), otherwise [[null2]]()
# CHECK: [[literal2]]():
# CHECK-NEXT: [[cell2]]:{{*}}= NewObject -, [[x2]], [[y2]] layout=L0 fields=[0, 1]
# CHECK-NEXT: Jump -> next [[merge2]]([[cell2]])
# CHECK: [[null2]]():
# CHECK-NEXT: [[constant2]]: null = Null
# CHECK-NEXT: Jump -> next [[merge2]]([[constant2]])
# CHECK: [[merge2]]([[result2]]: null|L0):

function f3 name="literalOrNullOrCached" parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
  b2():
    v3 = Null
    Return v3
  b3():
    v4 = GetModuleVariable variable=g0
    Return v4
}
# SHAPE-LABEL: function f3
# SHAPE-NEXT: fresh tag variants=[L0{k0:p1 k1:p2}, null, cell] parts=[anything, number, number]
# CHECK-LABEL: function f3 name="literalOrNullOrCached" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker3]] nullish=Null layout=L0} {
# CHECK: [[call3]]:{{*}}= CallDirect v0, v1 function=[[worker3]]
# CHECK-NEXT: [[tag3]]: i32 = ResultAt [[call3]]
# CHECK-NEXT: [[cached3]]: anything = ResultAt [[call3]] index=1
# CHECK-NEXT: [[x3]]: number = ResultAt [[call3]] index=2
# CHECK-NEXT: [[y3]]: number = ResultAt [[call3]] index=3
# CHECK-NEXT: Switch [[tag3]] cases=[1, 2] -> case [[literal3]](), case [[null3]](), otherwise [[cell3]]()
# CHECK: [[literal3]]():
# CHECK-NEXT: = NewObject -, [[x3]], [[y3]] layout=L0 fields=[0, 1]
# CHECK: [[null3]]():
# CHECK-NEXT: = Null
# CHECK: [[cell3]]():
# CHECK-NEXT: Jump -> next {{*}}([[cached3]])

function f4 name="twoLayouts" parameters=[{type=number}, {type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: string, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = NewObject -, v0, v1 layout=L1 fields=[0, 1]
    Return v4
}
# SHAPE-LABEL: function f4
# SHAPE-NEXT: fresh tag variants=[L0{k0:p0 k1:p1}, L1{k0:p0 k2:p2}] parts=[number, number, string]
# CHECK-LABEL: function f4 name="twoLayouts" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker4]]} {
# CHECK: [[call4]]:{{*}}= CallDirect v0, v1, v2 function=[[worker4]]
# CHECK-NEXT: [[tag4]]: i32 = ResultAt [[call4]]
# CHECK-NEXT: [[x4]]: number = ResultAt [[call4]] index=1
# CHECK-NEXT: [[y4]]: number = ResultAt [[call4]] index=2
# CHECK-NEXT: [[name4]]: string = ResultAt [[call4]] index=3
# CHECK-NEXT: Switch [[tag4]] cases=[1] -> case
# CHECK: = NewObject -, [[x4]], [[y4]] layout=L0 fields=[0, 1]
# CHECK: = NewObject -, [[x4]], [[name4]] layout=L1 fields=[0, 1]

function f5 name="oneKeyWithTwoTypes" parameters=[{type=number}, {type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: string, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = NewObject -, v1 layout=L2 fields=[0]
    Return v4
}
# SHAPE-LABEL: function f5
# SHAPE-NEXT: fresh tag variants=[L0{k0:p0 k1:p1}, L2{k0:p2}] parts=[number, number, string]
# CHECK-LABEL: function f5 name="oneKeyWithTwoTypes" module=m0 role=ResultWrapper

function f6 name="twoArrayLengths" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=Array<number>}] {
  b0(v0: number, v1: number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewArray v0 contents=number
    Return v3
  b2():
    v4 = NewArray v1, v0 contents=number
    Return v4
}
# SHAPE-LABEL: function f6
# SHAPE-NEXT: fresh tag variants=[Array[1]{element(0):p0}, Array[2]{element(0):p0 element(1):p1}] parts=[number, number]
# CHECK-LABEL: function f6 name="twoArrayLengths" module=m0 role=ResultWrapper
# CHECK: [[call6]]:{{*}}= CallDirect v0, v1, v2 function=[[worker6]]
# CHECK-NEXT: [[tag6]]: i32 = ResultAt [[call6]]
# CHECK-NEXT: [[first6]]: number = ResultAt [[call6]] index=1
# CHECK-NEXT: [[second6]]: number = ResultAt [[call6]] index=2
# CHECK-NEXT: Switch [[tag6]] cases=[1] -> case
# CHECK: = NewArray [[first6]] contents=number
# CHECK: = NewArray [[first6]], [[second6]] contents=number

function f7 name="variantsMeetBeforeOneReturn" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Jump -> next b3(v3)
  b2():
    v4 = Undefined
    Jump -> next b3(v4)
  b3(v5):
    Return v5
}
# SHAPE-LABEL: function f7
# SHAPE-NEXT: fresh tag variants=[L0{k0:p0 k1:p1}, undefined] parts=[number, number]
# CHECK-LABEL: function f7 name="variantsMeetBeforeOneReturn" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[worker7]] nullish=Undefined layout=L0} {

function f8 name="nullOrCached" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    v1 = NewObject layout=L0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Null
    Return v2
  b2():
    v3 = GetModuleVariable variable=g0
    Return v3
}
# SHAPE-LABEL: function f8
# SHAPE-NEXT: not fresh
# CHECK-LABEL: function f8 name="nullOrCached"
# CHECK-NOT: role=
# CHECK: Return v2
# CHECK: Return v3

# CHECK: function [[worker0]] name="oneLiteral" module=m0 role=ResultWorker {{*}}results=[{type=number}, {type=number}]
# CHECK: = Results v0, v1
# CHECK: function [[worker1]] name="sameLiteralOnTwoPaths" module=m0 role=ResultWorker {{*}}results=[{type=number}, {type=number}]
# CHECK: = Results v0, v1
# CHECK: = Results v1, v0
# CHECK: function [[worker2]] name="literalOrNull" module=m0 role=ResultWorker {{*}}results=[{type=i32}, {type=number}, {type=number}]
