# CHECK-NEXT: = Results [[literalTag3]], [[noCell3]], v0, v1
# CHECK: b2():
# CHECK: [[nullTag3]]: 2 = Integer integer=2
# CHECK-COUNT-3: = Unspecified
# CHECK: = Results [[nullTag3]], 
# CHECK: b3():
# CHECK-NEXT: [[cachedInWorker3]]: anything = GetModuleVariable variable=g0
# CHECK-NEXT: [[cellTag3]]: 4 = Integer integer=4
# CHECK-COUNT-2: = Unspecified valueType=number
# CHECK: = Results [[cellTag3]], [[cachedInWorker3]], 
# CHECK: function [[worker4]] name="twoLayouts" module=m0 role=ResultWorker {{*}}results=[{type=i32}, {type=number}, {type=number}, {type=string}]
# CHECK: b1():
# CHECK: [[noName4]]: string = Unspecified valueType=string
# CHECK-NEXT: = Results {{*}}, v0, v0, [[noName4]]
# CHECK: b2():
# CHECK: [[noY4]]: number = Unspecified valueType=number
# CHECK-NEXT: = Results {{*}}, v0, [[noY4]], v1
# CHECK: name="oneKeyWithTwoTypes" module=m0 role=ResultWorker {{*}}results=[{type=i32}, {type=number}, {type=number}, {type=string}]
# CHECK: function [[worker6]] name="twoArrayLengths" module=m0 role=ResultWorker {{*}}results=[{type=i32}, {type=number}, {type=number}]
