# A function that a pass derives while its caller is optimized has no summary in the table: the inliner computes one and decides by it
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot only-passes=ResolveCalls,EstimateHeat,SummarizeForInlining,InlineCalls
# RUN: pipeline InlineCalls
# STATISTIC: ConstructsResolved = 2
# STATISTIC: InlineDecisionInline >= 1
# STATISTIC: InlineDecisionCostExceedsBenefit >= 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Point" module=m0 constructor=f3 fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Instance name="Large" module=m0 constructor=f4 fields=[{key="x" declared={type=number} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewClosure function=f3
    v4 = NewClass v3 layout=L0
    v5 = FinishClass v4 layout=L0
    v6 = NewClosure function=f4
    v7 = NewClass v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = CallDirect v5, v2 function=f1 [isNeverInlined]
    v10 = CallDirect v8, v2 function=f2 [isNeverInlined]
    v11 = PropGet v0 key="publish" [isFreeName]
    v12 = Call v11, -, v9, v10
    Return
}
function f1 name="makesPoint" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = Construct v0, -, v1
    v3 = PropGet v2 key="x"
    Return v3
}
# CHECK-LABEL: function f1 name="makesPoint"
# CHECK: inlineFrames=[{}, {callee=[[pointVersion]] {{*}}isConstruction=true module=m0}] {
# CHECK-NOT: = Construct
# CHECK: [[point]]: L0 = NewObject layout=L0
# CHECK-NOT: CallDirect
# CHECK: PropSet [[point]], v1 key="x" {{*}}@0:1
# CHECK-NOT: CallDirect
function f2 name="makesLarge" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = Construct v0, -, v1
    v3 = PropGet v2 key="x"
    Return v3
}
# CHECK-LABEL: function f2 name="makesLarge"
# CHECK-NOT: inlineFrames=
# CHECK: [[large]]: L1 = NewObject layout=L1
# CHECK-NEXT: = CallDirect [[large]], v0, v1 function=[[largeVersion]] {{*}}[isConstruction]
# CHECK-NOT: = Mul
function f3 name="Point" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
# CHECK-LABEL: function f3 name="Point"
function f4 name="Large" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=L1}] {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    v4 = Mul v1, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    v12 = Mul v11, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    v15 = Mul v14, v1
    v16 = Mul v15, v1
    v17 = Mul v16, v1
    v18 = Mul v17, v1
    v19 = Mul v18, v1
    v20 = Mul v19, v1
    v21 = Mul v20, v1
    v22 = Mul v21, v1
    v23 = Mul v22, v1
    v24 = Mul v23, v1
    v25 = Mul v24, v1
    v26 = Mul v25, v1
    v27 = Mul v26, v1
    v28 = Mul v27, v1
    v29 = Mul v28, v1
    v30 = Mul v29, v1
    v31 = Mul v30, v1
    v32 = Mul v31, v1
    v33 = Mul v32, v1
    PropSet v3, v33 key="x"
    Return v3
}
# CHECK-LABEL: function f4 name="Large"
# CHECK: function [[pointVersion]] name="Point" {{*}}role=AllocatedThisVersion
# CHECK: function [[largeVersion]] name="Large" {{*}}role=AllocatedThisVersion
