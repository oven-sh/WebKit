# The instances of a class that is evaluated twice have proven slots, and a method that captures nothing is called without a read. What one evaluation owns is not taken from the class: instanceof stays, and an allocation names the prototype of the class object at hand unless the class was evaluated once so far
# FORM: AsRead
# RUN: pipeline Select

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="InFunction" constructor=f2 fields=[{key="x" declared={type=anything}}]
variable g0 name="second" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="FirstClass" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f1
    PutModuleVariable v0 variable=g1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="input" [isFreeName]
    v5 = Construct v1, -, v4
    PutModuleVariable v5 variable=g0
    v7 = NewClosure function=f4
    v8 = NewClosure function=f5
    v9 = NewClosure function=f6
    v10 = NewClosure function=f7
    v11 = PropGet v3 key="publish" [isFreeName]
    v12 = Call v11, -, v7, v8, v9, v10
    Return
}
function f1 name="makeClass" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f3
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    Return v4
}
function f2 name="InFunction" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    PropSet v3, v1 key="x" mode=Strict
    Return v3
}
function f3 name="m" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f4 name="readField" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f4 name="readField"
# CHECK: [[object]]: L0 = GetModuleVariable variable=g0
# CHECK-NOT: ShapeTest
# CHECK: = GetSlot [[object]] key="x" receivers=[L0] level=Proven
# CHECK-NOT: PropGet
function f5 name="callMethod" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0
    Return v2
}
# CHECK-LABEL: function f5 name="callMethod"
# CHECK-NOT: PropGet
# CHECK-NOT: = Call
# CHECK: = GetSlot {{*}}key="x" receivers=[L0] level=Proven
# CHECK-NOT: PropGet
function f6 name="testInstance" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = InstanceOf v0, v1
    Return v2
}
# CHECK-LABEL: function f6 name="testInstance"
# CHECK: boolean = InstanceOf v0, v1
function f7 name="construct" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = Construct v1, -, v0
    Return v2
}
# CHECK-LABEL: function f7 name="construct"
# CHECK: = IsClassEvaluatedOnce layout=L0
# CHECK: L0 = NewObject layout=L0 {{*}}[keepsShape]
# CHECK: [[prototype]]: object = GetConstructPrototype
# CHECK-NEXT: L0 = NewObject [[prototype]] layout=L0 {{*}}[keepsShape]
