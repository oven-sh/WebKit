# A read of an element behind a read of the same element on a straight way takes what the first found. A store of an element or a call between them keeps it, and so does a way that joins another, another position or another list.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
function f0 name="behindABranch" parameters=[{type=Array<int, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int}, {type=boolean}, {type=anything}] results=[{type=anything}] {
    v4 = IsElementPresent v0, v1 arrayStorage=Int32 [keyIsIntegral]
    Branch v4 -> taken b1(| 0), notTaken b4()
  b1(v5: guard):
    v6 = GetArrayElement v0, v1, v5 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v7 = GetArrayElement v0, v1, v5 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    Return v7
  b3():
    Return v6
  b4():
    Return v3
# CHECK: b2():
# CHECK-NEXT: Return v6
}

function f1 name="behindAStore" parameters=[{type=Array<int, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int}, {type=anything}] results=[{type=anything}] {
    v3 = IsElementPresent v0, v1 arrayStorage=Int32 [keyIsIntegral]
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4: guard):
    v5 = GetArrayElement v0, v1, v4 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    PutArrayElement v0, v1, v5, v4 arrayStorage=Int32 level=Proven [keyIsIntegral, isInBounds]
    v7 = IsElementPresent v0, v1 arrayStorage=Int32 [keyIsIntegral]
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8: guard):
    v9 = GetArrayElement v0, v1, v8 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    Return v9
  b3():
    Return v2
# CHECK: b2(
# CHECK: = GetArrayElement v0, v1
}

function f2 name="behindACall" parameters=[{type=Array<int, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int}, {type=anything}] results=[{type=anything}] {
    v3 = IsElementPresent v0, v1 arrayStorage=Int32 [keyIsIntegral]
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4: guard):
    v5 = GetArrayElement v0, v1, v4 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    v6 = Call v2, v5
    v7 = IsElementPresent v0, v1 arrayStorage=Int32 [keyIsIntegral]
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8: guard):
    v9 = GetArrayElement v0, v1, v8 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    Return v9
  b3():
    Return v2
# CHECK: b2(
# CHECK: = GetArrayElement v0, v1
}

function f3 name="anotherPositionAndAnotherList" parameters=[{type=Array<int, proven, Int32, pristine[Storage, Names, Dense]>}, {type=Array<int, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int}, {type=int}, {type=anything}] results=[{type=anything}] {
    v5 = IsElementPresent v0, v2 arrayStorage=Int32 [keyIsIntegral]
    Branch v5 -> taken b1(| 0), notTaken b4()
  b1(v6: guard):
    v7 = IsElementPresent v0, v3 arrayStorage=Int32 [keyIsIntegral]
    Branch v7 -> taken b2(| 0), notTaken b4()
  b2(v8: guard):
    v9 = IsElementPresent v1, v2 arrayStorage=Int32 [keyIsIntegral]
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10: guard):
    v11 = GetArrayElement v0, v2, v6 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    v12 = GetArrayElement v0, v3, v8 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    v13 = GetArrayElement v1, v2, v10 arrayStorage=Int32 level=Proven [keyIsIntegral, isPresent]
    v14 = Call v4, v11, v12, v13
    Return v14
  b4():
    Return v4
# CHECK: = Call v4, v11, v12, v13
}
