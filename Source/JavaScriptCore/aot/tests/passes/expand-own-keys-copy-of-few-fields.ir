# An arm of `{ ...source }` loads and stores field by field, about 25 instructions and 330 bytes a field, and the operation copies a record by its words in about 280 instructions whatever its size:
# from twelve fields on the arm is the slower of the two. An order of more than eight fields has no arm. Each copy stands in a loop of its own function: outside of loops a copy has no arms at all.
# FORM: Prepared optimizing
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 1

module m0 path="main.js" displayPath="main.js" body=f2
entry module=m0
layout L0 name="Eight" fields=[{key="f0" declared={type=number}}, {key="f1" declared={type=number}}, {key="f2" declared={type=number}}, {key="f3" declared={type=number}}, {key="f4" declared={type=number}}, {key="f5" declared={type=number}}, {key="f6" declared={type=number}}, {key="f7" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2, 3, 4, 5, 6, 7]}]}
layout L1 name="Nine" fields=[{key="f0" declared={type=number}}, {key="f1" declared={type=number}}, {key="f2" declared={type=number}}, {key="f3" declared={type=number}}, {key="f4" declared={type=number}}, {key="f5" declared={type=number}}, {key="f6" declared={type=number}}, {key="f7" declared={type=number}}, {key="f8" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2, 3, 4, 5, 6, 7, 8]}]}

function f0 name="copyOfEightFields" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CopyObject v0
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v3
# CHECK: = NewObject {{*}} layout=L0 fields=[0, 1, 2, 3, 4, 5, 6, 7]
}

function f1 name="copyOfNineFields" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ L1):
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CopyObject v0
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v3
# CHECK-NOT: NewObject
# CHECK: v3: object = CopyObject v0
# CHECK-NOT: NewObject
}

function f2 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = CallDirect v1 function=f0
    v5 = CallDirect v1 function=f1
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return
}
