# Instances of built-in classes have a method under the name. A read whose value is called behind a join asks for the method, as a read that is called at once does, so no layout with a field of that name is expected.
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="TreeNode" constructor=f1 fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="return" declared={type=anything} flags=[IsRequired]}] flow={baseState=None}

function f0 name="callBehindJoin" parameters=[{type=object flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ object, v1: boolean):
    v2 = PropGet v0 key="return"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v2)
  b3(v3: anything):
    v4 = Call v3, v0 calleeKey="return"
    Return v4
# CHECK-NOT: testedType=L0
}

function f1 name="TreeNode" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
