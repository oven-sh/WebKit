  b2():
    v6 = Add v4, v3
    Jump -> next b1(v6)
  b3():
    v7 = Less v4, v0
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b5():
    Return
# CHECK: b1(v4: int|whole):
# CHECK: v6: int|whole = Add v4, v3
# CHECK: Branch v7 -> taken b4(), notTaken b5()
# CHECK-NEXT: b4():
# CHECK-NEXT: v8: int|whole = Add v4, v3
}

