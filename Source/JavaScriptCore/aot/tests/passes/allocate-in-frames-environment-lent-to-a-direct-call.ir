# An environment that goes nowhere but into the capture of a function that is called directly, and only borrows it, lies in the frame. The verifier behind the pass asks the same table
# as the pass whether the callee keeps its capture, also where the pass runs alone and the analysis of flow has not run.
# FORM: Prepared
# RUN: pass AllocateInFrames
# CHECK: L0 only in frames
# CHECK-NEXT: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="copiedPerIteration" fields=[{key="x" declared={type=anything}}]

function f0 name="lendsItsEnvironment" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = Absent
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = CallDirect v3 function=f1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v6)
  b3():
    Return v5
}

function f1 name="onlyBorrows" kind=Arrow captures=[{type=absent|env L0}] results=[{type=anything}] {
  b0(v0: absent|env L0):
    Return
}
