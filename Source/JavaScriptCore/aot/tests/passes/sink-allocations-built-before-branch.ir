# An object that several paths need as a cell is built once, in front of the branch that parts them, and the stores until there fold into the allocation. A second run changes nothing
# FORM: Prepared
# RUN: pass SinkAllocations SinkAllocations
# STATISTIC: AllocationsSunk = 4
# STATISTIC: StoresFoldedIntoAllocations = 6

module m0 path="main.js" displayPath="main.js"
layout L0 name="Context" fields=[{key="env" declared={type=anything}}, {key="text" declared={type=anything}}, {key="done" declared={type=anything}}]

function f0 name="text" kind=Arrow captures=[{type=object}] results=[{type=anything}] {
    Return v0
}

function f1 name="neededOnBothPaths" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject layout=L0
    PropDefine v3, v1 key="env" receivers=[L0]
    Jump -> next b1()
  b1():
    PropDefine v3, v1 key="done" receivers=[L0]
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v6 = Call v0, -, v3
    Return v6
  b3():
    v7 = Call v1, -, v3
    Return v7
# CHECK-NOT: PropDefine
# CHECK: b1():
# CHECK-NEXT: [[both]]:{{*}}= NewObject -, v1, v1 layout=L0 fields=[0, 2]
# CHECK-NEXT: Branch v2
# CHECK: = Call v0, -, [[both]]
# CHECK: = Call v1, -, [[both]]
}

function f2 name="withClosureOverItself" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject layout=L0
    PropDefine v3, v1 key="env" receivers=[L0]
    v5 = NewClosure v3 function=f0
    PropDefine v3, v5 key="text" receivers=[L0]
    PropDefine v3, v1 key="done" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v8 = Call v0, -, v3
    Return v8
  b2():
    v9 = Call v1, -, v3
    Return v9
# CHECK-NOT: PropDefine
# CHECK: [[holder]]:{{*}}= NewObject -, v1, {{*}}, v1 layout=L0 fields=[0, 1, 2]
# CHECK-NEXT: [[closure]]:{{*}}= NewClosure [[holder]] function=f0
# CHECK-NEXT: PutSlotOrAdd [[holder]], [[holder]], [[closure]] key="text"
# CHECK-NEXT: Branch v2
}

function f3 name="neededOnOnePath" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject layout=L0
    PropDefine v3, v1 key="env" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v0, -, v3
    Return v5
  b2():
    Return v1
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: = NewObject -, v1 layout=L0 fields=[0]
}

function f4 name="nothingToFold" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = Call v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v0, -, v3
    Return v5
  b2():
    v6 = Call v1, -, v3
    Return v6
# CHECK: b0(
# CHECK-NEXT: = NewObject -, v1 layout=L0 fields=[0]
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Branch v2
}
