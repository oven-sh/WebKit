# A read of a field that always holds one number is that number where the receiver is proven to be an object. `null.half` throws: a read whose receiver may be null or undefined stays a read, whether or not a check stands in front of it.
# FORM: Prepared
# RUN: pass NarrowConstantVariables
# CHECK: outcome: Changed
# CHECK: function f1 name="readsFromAnObject"
# CHECK: v1: fractional = Double number=1.5
# CHECK: function f2 name="readsFromWhatMayBeNull"
# CHECK: = PropGet v0 key="half"
# CHECK: function f3 name="readsFromWhatMayBeUndefined"
# CHECK: = PropGet v0 key="half"

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="oneAllocation" fields=[{key="half" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Double number=1.5
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return
}
function f1 name="readsFromAnObject" module=m0 parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="half"
    Return v1
}
function f2 name="readsFromWhatMayBeNull" module=m0 parameters=[{type=null|L0}] results=[{type=anything}] {
  b0(v0: null|L0):
    v1 = PropGet v0 key="half"
    Return v1
}
function f3 name="readsFromWhatMayBeUndefined" module=m0 parameters=[{type=undefined|L0}] results=[{type=anything}] {
  b0(v0: undefined|L0):
    v1 = PropGet v0 key="half"
    Return v1
}
