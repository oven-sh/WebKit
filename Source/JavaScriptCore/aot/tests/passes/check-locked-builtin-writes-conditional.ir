# A store to a locked built-in that some run may skip, or whose error the program may catch, is a warning, and one in an unreached function is nothing
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteMayRun 4
# CHECK: key="underIf"
# CHECK: key="underHandler"
# CHECK: key="inFunction"
# CHECK: key="inImportedModule"
# CHECK-NOT: key="unreached"

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="lazy.js" displayPath="lazy.js" body=f2
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="flag" [isFreeName] @10
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    PropSet v0, v1 key="underIf" mode=Strict @20
    Jump -> next b2()
  b2():
    Jump -> next b3()
  b3() handler=b4():
    PropSet v0, v1 key="underHandler" mode=Strict @30
    Jump -> next b5()
  b4() role=CatchHandler:
    v7 = CatchValue
    Jump -> next b5()
  b5():
    v8 = CallDirect function=f1 @40
    v9 = ImportModule module=m1 referrer=m0 @50
    Return
}
function f1 name="inFunction" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    PropSet v0, v1 key="inFunction" mode=Strict @60
    Return
}
function f2 name="lazy" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    PropSet v0, v1 key="inImportedModule" mode=Strict @10
    Return
}
function f3 name="unreached" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    PropSet v0, v1 key="unreached" mode=Strict @70
    Return
}
