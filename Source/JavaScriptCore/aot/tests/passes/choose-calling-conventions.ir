# A function that is only jumped to, from callers that return a boxed value, returns its result boxed, so the jumps stay
# FORM: Prepared
# RUN: pass ChooseCallingConventions
# RUN(COUNTED): pass ChooseCallingConventions
# STATISTIC: ResultsBoxedForTailCalls = 3
# STATISTIC: ReturnCallsDemoted = 1
# CHECK: f0 Direct ({{*}}:Double) -> ({{*}}:JSValue) boxed-result
# CHECK: f2 Direct ({{*}}:Double) -> ({{*}}:Double)
# CHECK: f4 Direct ({{*}}:Double) -> ({{*}}:Double)
# CHECK-NEXT: f5 Direct ({{*}}:Double) -> ({{*}}:JSValue) boxed-result
# CHECK-NEXT: f6 Direct ({{*}}:Double) -> ({{*}}:JSValue) boxed-result
# CHECK: outcome: Changed
# COUNTED-COUNT-3: boxed-result
# COUNTED-NOT: boxed-result

module m0 path="main.js" displayPath="main.js"
function f0 name="onlyByValue" parameters=[{type=number}] results=[{type=number}] {
    Return v0
}
# CHECK-LABEL: function f1 name="onlyByValue"
# CHECK: ReturnCall v4 requirement=Allowed
function f1 name="onlyByValue" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0 arguments=Registers} {
    v3 = AssumeType v2 provenType=number
    v4 = CallDirect v3 function=f0
    ReturnCall v4 requirement=Allowed
}
function f2 name="alsoCalledDirectly" parameters=[{type=number}] results=[{type=number}] {
    Return v0
}
# CHECK-LABEL: function f3 name="alsoCalledDirectly"
# CHECK: Return v4
function f3 name="alsoCalledDirectly" role=GenericEntrypoint flags=[HasThis] captures=[{type=f2}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] derivation={source=f2} creator=Entrypoint{target=f2 arguments=Registers} {
    v3 = AssumeType v2 provenType=number
    v4 = CallDirect v3 function=f2
    ReturnCall v4 requirement=Allowed
}
function f4 name="usesResult" parameters=[{type=number}] results=[{type=number}] {
    v1 = CallDirect v0 function=f2
    v2 = Add v1, v1
    Return v2
}
# CHECK-LABEL: function f5 name="headOfChain"
# CHECK: ReturnCall v1 requirement=Allowed
function f5 name="headOfChain" parameters=[{type=number}] results=[{type=number}] {
    v1 = CallDirect v0 function=f6
    ReturnCall v1 requirement=Allowed
}
function f6 name="endOfChain" parameters=[{type=number}] results=[{type=number}] {
    Return v0
}
# CHECK-LABEL: function f7 name="headOfChain"
# CHECK: ReturnCall v4 requirement=Allowed
function f7 name="headOfChain" role=GenericEntrypoint flags=[HasThis] captures=[{type=f5}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] derivation={source=f5} creator=Entrypoint{target=f5 arguments=Registers} {
    v3 = AssumeType v2 provenType=number
    v4 = CallDirect v3 function=f5
    ReturnCall v4 requirement=Allowed
}
