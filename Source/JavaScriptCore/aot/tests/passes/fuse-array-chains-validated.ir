# A validating build looks at the array between two methods. The chain is one traversal all the same, and the look goes with the array
# FORM: Prepared
# OPTIONS: validate heat=EverythingIsHot
# RUN: pass FuseArrayChains
# STATISTIC: ArrayChainsFused = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
runtimefunction id=ArrayPrototypeFilter function=f1
runtimefunction id=ArrayPrototypeMap function=f2
runtimefunction id=ArrayTraversalTraverseArray function=f0
function f0 name="traverseArray" role=Library enclosingRuntimeFunction=ArrayTraversalTraverseArray parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v6 = Undefined
    Return v6
}
function f1 name="filter" role=Library flags=[HasThis, HasHiddenRest] enclosingRuntimeFunction=ArrayPrototypeFilter thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: Array<anything>):
    v3 = Integer integer=0
    v4 = ElemGet v0, v3
    v5 = Call v1, -, v4, v3, v0
    Return v5
}
function f2 name="map" role=Library flags=[HasThis, HasHiddenRest] enclosingRuntimeFunction=ArrayPrototypeMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: Array<anything>):
    v3 = Integer integer=0
    v4 = ElemGet v0, v3
    v5 = Call v1, -, v4, v3, v0
    Return v5
}

function f3 name="isPositive" kind=Arrow parameters=[{type=number}] results=[{type=boolean}] {
    v1 = Integer integer=0
    v2 = Less v1, v0
    Return v2
}

function f4 name="double" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
    v1 = Add v0, v0
    Return v1
}

function f5 name="chain" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = NewClosure function=f3
    v2 = NewArray contents=anything
    v3 = CallDirect v0, v1, v2 function=f1
    ValidateType v3 validatedType=Array<number>
    v5 = AssumeType v3 provenType=Array<number>
    ValidateType v5 validatedType=Array<number>
    v7 = NewClosure function=f4
    v8 = NewArray contents=anything
    v9 = CallDirect v5, v7, v8 function=f2
    v10 = AssumeType v9 provenType=Array<number>
    Return v10
# CHECK-NOT: function=f1
# CHECK-NOT: ValidateType
# CHECK-NOT: function=f2
# CHECK: = CallDirect {{*}} function=[[step]]
# CHECK: function [[step]] name="traverseArray"{{*}}role=ChainStep
}
