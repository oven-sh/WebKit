function f3 name="coroutine" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|null|Array<number>}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f2} creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b5(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b4():
    v7 = AwaitBySavingFrame v6, v1
    Jump -> next b1()
  b4() role=IterationCleanup subject=v2:
    v8 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v8
  b5():
    v10 = Undefined
    v11 = ReturnAsyncResult v1, v10
    Return v11
# The form, the array, the iterator and the index are values like any other across the suspension.
# CHECK: b1([[index3]]: int[0, 9007199254740991]|unspecified):
