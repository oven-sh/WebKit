# A region that costs more than the limit to copy stays one copy, and each operation of the iteration switches on the form
# FORM: Prepared optimizing
# OPTIONS: limit=MaxVersionedIterationBytes:0
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(SELECTED): pass ExpandIteration Select
# RUN(LEFT): pass ExpandIteration
# LOSS: MaxVersionedIterationBytes x2 f0 v2
# STATISTIC: IterationsExpandedByClass = 3

module m0 path="main.js" displayPath="main.js"

function f0 name="smallLoop" parameters=[{type=undefined|null|Array<number>}, {type=anything}] results=[{type=anything}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b7(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b6():
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b4(), notTaken b1()
  b4():
    IteratorClose v2
    Jump -> next b5()
  b5():
    Return v7
  b6() role=IterationCleanup subject=v2:
    v10 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v10
  b7():
    Return v1
# CHECK: b1([[index0]]: int[0, 9007199254740991]|unspecified):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Switch [[form0]] cases=[0] -> case [[arrayStep0]](), otherwise [[protocolStep0]]()
# CHECK: b3() handler=b6():
# CHECK-NEXT: v7: anything = Call v1, -, v6
# CHECK: b4():
# CHECK-NEXT: Switch [[form0]] cases=[0] -> case [[arrayClose0]](), otherwise [[protocolClose0]]()
# CHECK: b6() role=CleanupHandler:
# CHECK-NEXT: v10: exception = CatchException
# CHECK-NEXT: Switch [[form0]] cases=[0] -> case [[arrayLanding0]](), otherwise [[protocolLanding0]]()
# CHECK: [[open0]]: undefined = CallDirect {{*}} function=f4 [isNeverInlined]
# CHECK-NEXT: [[opened0]]: object = ResultAt [[open0]]
# CHECK-NEXT: [[method0]]: anything = ResultAt [[open0]] index=1
# CHECK-NEXT: [[isProtocolForm0]]: 1 = Integer integer=1
# CHECK-NEXT: [[noArray0]]: unspecified|Array<number> = Unspecified valueType=Array<number>
# CHECK-NEXT: [[noIndex0]]: int[0, 9007199254740991]|unspecified = Unspecified valueType=int[0, 9007199254740991]
# CHECK-NEXT: Jump -> next [[join0]]([[isProtocolForm0]], [[noArray0]], [[opened0]], [[method0]], [[noIndex0]])
# CHECK: ([[first0]]: int[0, 9007199254740991]):
# CHECK-NEXT: [[isArrayForm0]]: 0 = Integer
# CHECK-NEXT: [[noIterator0]]: object|unspecified = Unspecified valueType=object
# CHECK-NEXT: [[noNext0]]: anything|unspecified = Unspecified valueType=anything
# CHECK-NEXT: Jump -> next [[join0]]([[isArrayForm0]], [[subject0]], [[noIterator0]], [[noNext0]], [[first0]])
# CHECK: [[join0]]([[form0]]: int[0, 1], [[array0]]: unspecified|Array<number>, [[iterator0]]: object|unspecified, [[next0]]: anything|unspecified, {{*}}: int[0, 9007199254740991]|unspecified):
# CHECK: [[arrayLanding0]]():
# CHECK-NEXT: Jump
# Each arm of a switch on the form begins with the fact that the values of its form are there.
# CHECK: [[protocolLanding0]]() frequency=Unlikely:
# CHECK-NEXT: [[isProtocolAtLanding0]]: fact = Specified
# CHECK-NEXT: [[iteratorAtLanding0]]: object = AssumeType [[iterator0]], [[isProtocolAtLanding0]] provenType=object
# CHECK-NEXT: = CallDirect [[iteratorAtLanding0]] function=f6 [isNeverInlined]
# CHECK: [[arrayClose0]]():
# CHECK-NEXT: Jump
# CHECK: [[protocolClose0]]() frequency=Unlikely:
# CHECK-NEXT: [[isProtocolAtClose0]]: fact = Specified
# CHECK-NEXT: [[iteratorAtClose0]]: object = AssumeType [[iterator0]], [[isProtocolAtClose0]] provenType=object
# CHECK-NEXT: = CallDirect [[iteratorAtClose0]] function=f5 [isNeverInlined]
# CHECK: [[arrayStep0]]():
# CHECK-NEXT: [[isArrayAtStep0]]: fact = Specified
# CHECK-NEXT: [[arrayAtStep0]]: Array<number> = AssumeType [[array0]], [[isArrayAtStep0]] provenType=Array<number>
# CHECK-NEXT: = PropGet [[arrayAtStep0]] key="length"
# CHECK: = AssumeType [[index0]], [[isArrayAtStep0]] provenType=int[0, 9007199254740991]
# CHECK: [[protocolStep0]]() frequency=Unlikely:
# CHECK-NEXT: [[isProtocolAtStep0]]: fact = Specified
# CHECK-NEXT: [[nextAtStep0]]: anything = AssumeType [[next0]], [[isProtocolAtStep0]] provenType=anything
# CHECK-NEXT: [[iteratorAtStep0]]: object = AssumeType [[iterator0]], [[isProtocolAtStep0]] provenType=object
# CHECK-NEXT: = Call [[nextAtStep0]], [[iteratorAtStep0]]
# CHECK: = ElemGet [[arrayAtStep0]], {{*}} [keyIsIntegral]
# On the edge of the array form next is a value nobody reads, so selection resolves no call target from it in front of the loop, where both forms pass.
# SELECTED: ({{*}}: int[0, 1], {{*}}: unspecified|Array<number>, [[selectedIterator0]]: object|unspecified, [[selectedNext0]]: anything|unspecified,
# SELECTED-NOT: ResolveCallTarget [[selectedNext0]]
# SELECTED: = ResolveCallTarget v1 argumentCount=1
# SELECTED-NOT: ResolveCallTarget [[selectedNext0]]
# SELECTED: [[selectedNextAtStep0]]: anything = AssumeType [[selectedNext0]],
# SELECTED-NEXT: [[selectedIteratorAtStep0]]: object = AssumeType [[selectedIterator0]],
# SELECTED-NOT: ResolveCallTarget
# SELECTED: = Call [[selectedNextAtStep0]], [[selectedIteratorAtStep0]]
# SELECTED-NOT: ResolveCallTarget [[selectedNext0]]
# ABSENT-NOT: role=IterationCleanup
# ABSENT-NOT: subject=
# ABSENT-COUNT-1: LoopHint
# ABSENT-NOT: LoopHint
# ABSENT-COUNT-1: = Call v1, -,
# ABSENT-NOT: = Call v1, -,
}

function f1 name="oneForm" parameters=[{type=Array<number, pristine[Names]>}, {type=anything}] results=[{type=anything}] {
    v2 = IteratorOpen v0
