function f9 name="emptyLiteral" results=[{type=Set<string>}] {
  b0():
    v0 = NewArray contents=string
    v1 = CallBuiltin -, v0 overload=Set/2 builtinCallForm=Whole
    Return v1
}
# CHECK-LABEL: function f9
# CHECK-NOT: FromData
# CHECK: = CallBuiltin

function f10 name="underHandler" results=[{type=anything}] {
  b0():
    Jump -> next b1()
  b1() handler=b3():
    v0 = String string="h"
    v1 = Integer integer=1
    v2 = NewArray v0, v1 contents=anything
    v3 = NewArray v2 contents=Array<anything>
    v4 = CallBuiltin -, v3 overload=Map/2 builtinCallForm=Whole
    Jump -> next b2()
  b2():
    Return v4
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v5
}
# CHECK-LABEL: function f10
# CHECK: b1() handler=b3():
# CHECK-NOT: NewArray
# CHECK: = NewMapFromData data=d5
# CHECK-NEXT: Jump -> next b2()

function f11 name="literalWithHole" results=[{type=Set<string>}] {
  b0():
    v0 = String string="a"
    v1 = String string="b"
    v2 = NewArray v0, v1 contents=string holes=[1]
    v3 = CallBuiltin -, v2 overload=Set/2 builtinCallForm=Whole
    Return v3
}
# CHECK-LABEL: function f11
# CHECK-NOT: FromData
# CHECK: = CallBuiltin

function f12 name="pairWithoutValue" results=[{type=Map<string, anything>}] {
  b0():
    v0 = String string="k"
    v1 = NewArray v0 contents=anything
    v2 = NewArray v1 contents=Array<anything>
