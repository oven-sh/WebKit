# class Plain {}   let base = undefined or Plain   class Derived extends base {}   class Rooted extends (null or Plain) {}   class Held extends (given as typeof Plain) {}
# The look at the heritage throws a TypeError for undefined. The record of a class names the class above and says nothing of that:
# the definition of Derived goes, and its look stays where it was and throws what it throws.
# The look at null throws nothing, but then the class above is not known: Rooted keeps its definition.
# The heritage of Held is a class only behind a Check. The generic version of the function has no such check, so the look of Held stays too.
# FORM: Prepared
# RUN: pass DeferDefinitions
# STATISTIC: ClassesDeferredInVariables = 3
# CHECK: outcome: Changed
# CHECK: variable g0 name="Plain" module=m0 declared={type=f1} initialization=Function function=f1
# CHECK: variable g1 name="Derived" module=m0 declared={type=f2} initialization=Function function=f2
# CHECK: variable g5 name="Held" module=m0 declared={type=f4} initialization=Function function=f4
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: layout=L0
# CHECK: [[base]]: undefined|f1 = GetModuleVariable variable=g3
# CHECK-NEXT: = ResolveHeritage [[base]]
# CHECK-NOT: layout=L1
# CHECK: = ResolveHeritage
# CHECK: = NewClass {{*}}layout=L2
# CHECK: [[checked]]: f1 = Check
# CHECK-NEXT: = ResolveHeritage [[checked]]
# CHECK-NOT: layout=L3
# CHECK: Return

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Instance name="Plain" module=m0 constructor=f1 flow={baseState=None} classFlow={evaluations=AtMostOnce}
layout L1 kind=Instance name="Derived" module=m0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0} classFlow={evaluations=AtMostOnce}
layout L2 kind=Instance name="Rooted" module=m0 constructor=f3 flags=[HasHeritage] flow={baseState=Unknown} classFlow={evaluations=AtMostOnce}
layout L3 kind=Instance name="Held" module=m0 constructor=f4 flags=[HasHeritage] flow={baseState=Layout base=L0} classFlow={evaluations=AtMostOnce}
variable g0 name="Plain" module=m0 declared={type=f1} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g1 name="Derived" module=m0 declared={type=f2} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g2 name="Rooted" module=m0 declared={type=f3} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g3 name="base" module=m0 declared={type=undefined|f1} flow={writers=AllKnown}
variable g4 name="root" module=m0 declared={type=null|f1} flow={writers=AllKnown}
variable g5 name="Held" module=m0 declared={type=f4} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g6 name="given" module=m0 declared={type=anything} flow={writers=AllKnown}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    PutModuleVariable v2 variable=g0
    v4 = GetModuleVariable variable=g3
    v5 = ResolveHeritage v4
    v6 = AssumeType v5 provenType=object
    v7 = NewClosure function=f2
    v8 = NewClass v7, v4, v6 layout=L1
    v9 = FinishClass v8 layout=L1
    PutModuleVariable v9 variable=g1
    v11 = GetModuleVariable variable=g4
    v12 = ResolveHeritage v11
    v13 = NewClosure function=f3
    v14 = NewClass v13, v11, v12 layout=L2
    v15 = FinishClass v14 layout=L2
    PutModuleVariable v15 variable=g2
    v17 = GetModuleVariable variable=g6
    v18 = Check v17 expectedType=f1
    v19 = ResolveHeritage v18
    v20 = AssumeType v19 provenType=object
    v21 = NewClosure function=f4
    v22 = NewClass v21, v18, v20 layout=L3
    v23 = FinishClass v22 layout=L3
    PutModuleVariable v23 variable=g5
    Return
}
function f1 name="Plain" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Derived" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Rooted" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f4 name="Held" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L3
    Return v3
}
