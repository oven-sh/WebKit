# A generator that no loop is fused with, and that nobody looks at between its creation and its first step, is not started at its creation: the first step marks it as running and calls the body,
# which then does not suspend at its start. Behind a failed test for an unmodified generator anything may look at it, so there it is started as at its creation.
# A step that stands behind another step is never the first and stays as it is.
# A step at the head of a loop is the first one when the loop is entered: the entering edges start the body, so its arguments are not live in the loop. A loop that may be entered again asks in the loop, or, where the function saves its frame, leaves the generator started at its creation.
# It stays as it is where the head of the body has an effect, where something reads the generator in front of the first step, and where a handler could see it after the body has thrown
# FORM: Prepared
# RUN: pass StartGeneratorsAtFirstStep
# STATISTIC: GeneratorsStartedAtFirstStep = 6

module m0 path="main.js" displayPath="main.js"
variable g0 name="stored" module=m0 declared={type=anything} initialization=Undefined
function f0 name="first" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f6
    v2 = NewGenerator v1 function=f6 @100
    v3 = CallDirect v1, v0, v2 function=f8 @100
    v4 = IsUnmodifiedGenerator v2
    Branch v4 -> taken b1(), notTaken b6()
  b1():
    v5 = Undefined
    v6 = StepGenerator v2, v5 check=None @90
    v7 = ResultAt v6 index=0
    v8 = ResultAt v6 index=1
    v9 = Integer integer=1
    v10 = StrictEq v8, v9
    Branch v10 -> taken b5(), notTaken b2()
  b2():
    v11 = Undefined
    v12 = StepGenerator v2, v11 resumeMode=Return check=IsUnmodified @91
    v13 = ResultAt v12 index=1
    v14 = Integer integer=2
    v15 = StrictEq v13, v14
    Branch v15 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v16 = PropGet v2 key="return"
    v17 = Call v16, v2
    Jump -> next b4()
  b4():
    Return v7
  b5():
    v18 = Undefined
    Return v18
  b6() frequency=Unlikely:
    v19 = PropGet v2 key=@@iterator
    v20 = Call v19, v2
    Return v20
# CHECK: b0(v0: anything):
# CHECK-NOT: CallDirect
# CHECK: Branch v4 -> taken b1(), notTaken [[started0]]()
# CHECK: b1():
# CHECK-NOT: StepGenerator
# CHECK-NOT: IsGeneratorUnstarted
# CHECK: MarkGeneratorRunning v2
# CHECK-NEXT: [[value0]]: anything = CallDirect v1, v0, v2 function=f8
# CHECK-NEXT: [[status0]]: int[0, 2] = TakeGeneratorStepStatus v2
# CHECK-NEXT: Jump -> next {{*}}([[value0]], [[status0]])
# CHECK: = StepGenerator v2, v11 resumeMode=Return check=IsUnmodified
# CHECK: [[started0]]() frequency=Unlikely:
# CHECK-NEXT: = CallDirect v1, v0, v2 function=f8
# CHECK-NEXT: Jump -> next b6()
}

