# A loop that takes the elements of one object gets a copy for one class of the object, and the class is tested once, in front of the loop.
# FORM: Prepared
# RUN: pass SplitUnions
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="array-or-bytes" parameters=[{type=Array<number>|Uint8Array}] results=[{type=anything}] {
  b0(v0: Array<number>|Uint8Array):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Add v3, v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f0 name="array-or-bytes"
# CHECK-NOT: TypeTest
# CHECK: [[isBytes]]: boolean = TypeTest v0 testedType=Uint8Array
# CHECK-NEXT: Branch [[isBytes]] -> taken [[front]](| 0), notTaken [[rest]](| 0)
# CHECK-NOT: TypeTest

function f1 name="nobody-knows-what" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Mul v3, v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f1 name="nobody-knows-what"
# CHECK: = ElemGet v0,
# CHECK: [[isBytes]]: boolean = TypeTest v0 testedType=Uint8Array
# CHECK-NEXT: Branch [[isBytes]] -> taken
# CHECK: ([[bytes]]: Uint8Array):
# CHECK: = GetTypedArrayElement [[bytes]],

function f2 name="asked-for-what-bytes-lack" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="size"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Mul v3, v8
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f2 name="asked-for-what-bytes-lack"
# CHECK-NOT: TypeTest

function f3 name="another-object-each-turn" parameters=[{type=Array<anything>}] results=[{type=anything}] {
  b0(v0: Array<anything>):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = ElemGet v8, v4
    v10 = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f3 name="another-object-each-turn"
# CHECK-NOT: testedType=Uint8Array

function f4 name="elements-that-nothing-takes-for-numbers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Increment v4
    Jump -> next b1(v8, v9)
  b3():
    Return v3
}
# CHECK-LABEL: function f4 name="elements-that-nothing-takes-for-numbers"
# CHECK-NOT: TypeTest
