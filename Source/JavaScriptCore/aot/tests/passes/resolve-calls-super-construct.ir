}
function f19 name="parent-is-only-expected" parameters=[{type=f0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0, v1: anything):
    v2 = SuperConstruct v0, v1 layout=L1
    Return v2
# CHECK-NEXT: b0(v0: anything ~ f0, v1: anything):
