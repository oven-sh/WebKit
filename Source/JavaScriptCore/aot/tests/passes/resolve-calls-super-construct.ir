}
function f15 name="list-with-a-hole" parameters=[{type=f0}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewArray v2 contents=anything holes=[0]
    v4 = SuperConstructList v0, v1, v3 layout=L1
    Return v4
# CHECK-NEXT: b0(v0: f0, v1: anything, v2: anything):
# CHECK-NEXT: = NewArray v2 contents=anything holes=[0]
