}
function f16 name="parent-is-a-built-in" parameters=[{type=builtin(Error)}, {type=anything}] results=[{type=anything}] {
    v2 = SuperConstruct v0, v1 layout=L1
    Return v2
# CHECK-NEXT: b0(v0: builtin(Error), v1: anything):
# CHECK-NEXT: = SuperConstruct v0, v1 layout=L1
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
}
function f17 name="two-parents" parameters=[{type=f0|f5}, {type=anything}] results=[{type=anything}] {
    v2 = SuperConstruct v0, v1 layout=L1
    Return v2
# CHECK-NEXT: b0(v0: f0|f5, v1: anything):
# CHECK-NEXT: [[isShape]]: boolean = TypeTest v0 testedType=f0
# CHECK-NEXT: Branch [[isShape]] -> taken [[shapeArm]](| 0), notTaken [[countedArm]](| 0)
# CHECK: [[shapeArm]]({{*}}: f0):
# CHECK: = CallDirect v1, {{*}} function=f0 [isConstruction]
# CHECK-NOT: TypeTest
# CHECK: [[countedArm]]([[counted]]: f5)
# CHECK-NEXT: [[countOfArm]]: number = GetCapture [[counted]] function=f5
# CHECK-NEXT: = CallDirect [[countOfArm]], v1 function=f5 [isConstruction]
# CHECK-NOT: SuperConstruct
}
function f18 name="parent-may-be-null" parameters=[{type=null|f0}, {type=anything}] results=[{type=anything}] {
    v2 = SuperConstruct v0, v1 layout=L1
    Return v2
# CHECK-NEXT: b0(v0: null|f0, v1: anything):
# CHECK-NEXT: = TypeTest v0 testedType=f0
# CHECK: = CallDirect v1, {{*}} function=f0 [isConstruction]
# CHECK: ([[noParent]]: null)
