function f17 name="twoHalves" role=ResultWorker parameters=[{type=number}, {type=number}] results=[{type=number}, {type=number}] derivation={source=f0} creator=ResultWorker{origin=f0} {
  b0(v0: number, v1: number):
    v2 = Mul v0, v0
    v3 = Add v2, v0
    v4 = Mul v3, v0
    v5 = Add v4, v0
    v6 = Mul v5, v0
    v7 = Add v6, v0
