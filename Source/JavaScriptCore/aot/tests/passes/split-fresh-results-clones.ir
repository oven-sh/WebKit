    v11 = Add v10, v1
    v12 = Mul v11, v1
    v13 = Add v12, v1
    v14 = Mul v13, v1
    v15 = Add v14, v1
    v16 = Mul v15, v1
    v17 = Add v16, v1
    v18 = Results v9, v17
