function f6 name="readsInBlockPrintedEarlier" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b2()
  b1():
    v1 = ResultAt v2 index=1
    Return v1
  b2():
    v2 = CallDirect v0, v0 function=f17
    Jump -> next b1()
}
