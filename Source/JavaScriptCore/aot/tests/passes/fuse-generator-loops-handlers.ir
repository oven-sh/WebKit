    v3 = NewGenerator v2 function=f4 @40
    v4 = CallDirect v2, v0, v3 function=f7 @40
    Jump -> next b1()
  b1() handler=b3():
    v5 = StepGenerator v3, v1 check=None @50
    v6 = ResultAt v5 index=0
