# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: = NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: [[short]]:{{*}}= NewObject -, v1 layout=L0 fields=[0]
# CHECK-NEXT: = Call v0, -, [[short]]
}
