# `const E = {}; E.a = 1;` is read as 1 where every store under `a` is a store or a definition of the same constant. The operations that are held against the constant come out of the schema:
# whatever names the key, is neither a read nor a question, and may write a property. Of `super.a = 2` the pass knows the name alone, so no field of that name keeps its constant.
# A definition of another value takes it from the layouts that it names. A read through super takes it too: its row in the schema does not call it a read.
# FORM: Prepared
# RUN: pass NarrowConstantVariables
# CHECK: outcome: Changed
# CHECK-LABEL: name="reads"
# CHECK: v4: {{*}} = PropGet v0 key="a"
# CHECK-NEXT: v5: {{*}} = PropGet v1 key="b"
# CHECK-NEXT: v6: 1 = Integer integer=1
# CHECK-NEXT: v7: {{*}} = PropGet v3 key="d"

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="storedThroughSuper" module=m0 declared={type=L0}
variable g1 name="definedAgain" module=m0 declared={type=L1}
variable g2 name="definedAgainWithTheSameConstant" module=m0 declared={type=L2}
variable g3 name="readThroughSuper" module=m0 declared={type=L3}
layout L0 name="storedThroughSuper" fields=[{key="a" declared={type=number} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[RedefineProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="definedAgain" fields=[{key="b" declared={type=number} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[RedefineProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="definedAgainWithTheSameConstant" fields=[{key="c" declared={type=number} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[RedefineProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="readThroughSuper" fields=[{key="d" declared={type=number} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[RedefineProperty, ChangeIntegrity, ChangePrototype]}
data d0 root=Object{layout=L0} module=m0
data d1 root=Object{layout=L1} module=m0
data d2 root=Object{layout=L2} module=m0
data d3 root=Object{layout=L3} module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Data data=d0
    PutModuleVariable v4 variable=g0
    PropSet v4, v0 key="a" receivers=[L0]
    v7 = Data data=d1
    PutModuleVariable v7 variable=g1
    PropSet v7, v0 key="b" receivers=[L1]
    v10 = Data data=d2
    PutModuleVariable v10 variable=g2
    PropSet v10, v0 key="c" receivers=[L2]
    v13 = Data data=d3
    PutModuleVariable v13 variable=g3
    PropSet v13, v0 key="d" receivers=[L3]
    PropDefine v7, v1 key="b" receivers=[L1]
    PropDefine v10, v0 key="c" receivers=[L2]
    v18 = Undefined
    Return v18
}
function f1 name="reads" module=m0 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = GetModuleVariable variable=g2
    v3 = GetModuleVariable variable=g3
    v4 = PropGet v0 key="a" receivers=[L0]
    v5 = PropGet v1 key="b" receivers=[L1]
    v6 = PropGet v2 key="c" receivers=[L2]
    v7 = PropGet v3 key="d" receivers=[L3]
    Return v7
}
function f2 name="throughSuper" module=m0 length=2 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=2
    SuperSet v0, v1, v2 key="a"
    v4 = SuperGet v0, v1 key="d"
    Return v4
}
