# Allocations that pay only for a reason a coarse look misses are still sunk
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 0
# STATISTIC: AllocationsSunk = 5
# STATISTIC: StoresFoldedIntoAllocations = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 name="Holder" fields=[{key="item" declared={type=anything}}]
layout L2 kind=Environment name="scope" fields=[{key="value" declared={type=anything}}]

function f0 name="heldByAnObjectThatIsBuiltInsideALoop" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject layout=L2
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    PutEnvironmentField v3, v1 layout=L2 field=0
    Jump -> next b3()
  b3():
    LoopHint
    v6 = Call v0
    v7 = ToBoolean v6
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    v8 = NewClosure v3 function=f4
    v9 = NewObject -, v8 layout=L1 fields=[0]
    v10 = Call v0, -, v9
    Jump -> next b3()
  b5():
    v11 = NewClosure v3 function=f4
    v12 = NewObject -, v11 layout=L1 fields=[0]
    v13 = Call v1, -, v12
    Return v13
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b2():
# CHECK-NEXT: [[scope0]]: env L2 = NewObject -, v1 layout=L2 fields=[0]
# CHECK-NEXT: Jump -> next b3([[scope0]])
}

function f1 name="appendedToFromARealArrayOnOneOfTwoWays" parameters=[{type=anything}, {type=Array<anything>}, {type=int[0, 2]}] results=[{type=anything}] {
    v3 = NewArray contents=anything
    Switch v2 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v4 = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
    Branch v4 -> taken b5(| 0), notTaken b3()
  b2():
    v5 = Call v0, -, v3
    Jump -> next b4()
  b3():
    Return v0
  b4():
    AppendElement v3, v0
    v7 = Call v0, -, v3
    Return v7
  b5(v8: guard):
    AppendElements v3, v1, v8
    Jump -> next b4()
# CHECK: b0(
# CHECK-NOT: NewArray
# CHECK: b2():
# CHECK-NEXT: = NewArray contents=anything
# CHECK: b3():
# CHECK-NEXT: Return v0
# CHECK: b5(v8
# CHECK-NEXT: = NewArray contents=anything
}

function f2 name="storedIntoThroughAValueReadOutOfAVirtualArray" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    v3 = Integer integer=0
    v4 = ElemGet v2, v3
    PropSet v4, v2 key="y" mode=Sloppy receivers=[L0]
    Return v2
# CHECK-NOT: ElemGet
# CHECK-NOT: PropSet
# CHECK: [[point2]]: L0 = NewObject -, v0, {{*}} layout=L0 fields=[0, 1]
# CHECK-NEXT: [[list2]]: Array = NewArray [[point2]] contents=anything
# CHECK-NEXT: PutSlotOrAdd [[point2]], [[point2]], [[list2]] key="y"
}

function f3 name="heldByOneOfTwoObjectsThatMeet" parameters=[{type=anything}, {type=anything}, {type=int[0, 2]}] results=[{type=anything}] {
    v3 = NewClosure function=f5
    Switch v2 cases=[0, 1] -> case b1(), case b2(), otherwise b6()
  b1():
    v4 = NewObject -, v3 layout=L1 fields=[0]
    v5 = Call v0, -, v4
    Jump -> next b3(v4)
  b2() frequency=Unlikely:
    v6 = NewObject -, v3 layout=L1 fields=[0]
    Jump -> next b3(v6)
  b3(v7: L1):
    v8 = ToBoolean v1
    Branch v8 -> taken b4(), notTaken b5()
  b4():
    v9 = Call v0, -, v7
    Return v9
  b5():
    v10 = Call v1, -, v7
    Return v10
  b6():
    Return v0
# CHECK: b0(
# CHECK-NEXT: Switch v2
# CHECK: b1():
# CHECK-NEXT: = NewClosure function=f5
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: = NewClosure function=f5
# CHECK: b6():
# CHECK-NEXT: Return v0
}

function f4 name="capturesScope" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    Return v1
}

function f5 name="capturesNothing" kind=Arrow results=[{type=anything}] {
    v0 = Undefined
    Return v0
}
