# A store to a locked built-in that flow saw before the function passed the work limit is reported like any other
# OPTIONS: limit=MaxFlowWorkPerFunction:120
# LOSS: MaxFlowWorkPerFunction f1
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteMayRun 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="BusyBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
