# A callee is looked for on every value of its cast chain, and the value with the strongest type is the one tested and read
# FORM: Prepared optimizing
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 7
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Point" constructor=f3 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f4 mutability=Fixed}]}
function f0 name="plain" results=[{type=anything}] {
