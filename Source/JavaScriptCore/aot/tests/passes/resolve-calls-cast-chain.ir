    v2 = NewObject v1 layout=L0
    Return v2
}
function f4 name="run" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: L0):
    Return
}

function f5 name="proven-under-upcast" parameters=[{type=f1}] results=[{type=anything}] {
