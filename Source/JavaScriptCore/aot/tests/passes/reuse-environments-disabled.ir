# A layout that needs an escape mark in a function that may not change is not reused
# FORM: Prepared
# OPTIONS: disable=pass:ReuseEnvironments disable-in=1:1
# RUN: pass ReuseEnvironments
# CHECK: reused environments: []
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="markedInCallee" fields=[{key="x" declared={type=anything}}]

function f0 name="markedInCallee" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = CallDirect v3, v0 function=f1
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v4
}

function f1 name="capturesInHeapClosure" kind=Arrow captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    v2 = NewClosure v0 function=f2
    v3 = Call v1, -, v2
    Return v3
}

function f2 name="callback" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
