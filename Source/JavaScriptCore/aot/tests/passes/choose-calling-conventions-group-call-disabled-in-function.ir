# A call in a function where ChooseCallingConventions is off stays a call by value, and an equal call elsewhere becomes the call of a group
# FORM: Prepared
# OPTIONS: disable=pass:ChooseCallingConventions disable-in=0:1
# RUN: pass GroupCallsByValue CreateEntrypoints ChooseCallingConventions
# STATISTIC: GroupCalls = 1
# STATISTIC: GroupEntrypoints = 5
# CHECK: group g0 members=[f7, f8, f9, f10, f11] sites=[a1] this

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="inRange"
# CHECK: = Call v0, -, v1 accessSite=0
function f0 name="inRange" parameters=[{type=f2|f3|f4|f5|f6}, {type=number}] results=[{type=anything}] {
  b0(v0: f2|f3|f4|f5|f6, v1: number):
    v2 = Call v0, -, v1 accessSite=0 callees=[f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f1 name="outsideRange"
# CHECK: = CallGroup v0, v1 function=
function f1 name="outsideRange" parameters=[{type=f7|f8|f9|f10|f11}, {type=number}] results=[{type=anything}] {
  b0(v0: f7|f8|f9|f10|f11, v1: number):
    v2 = Call v0, -, v1 accessSite=1 callees=[f7, f8, f9, f10, f11]
    Return v2
}
