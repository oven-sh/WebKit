# The copy a failed test enters is one class rarer, is open to tests of other conditions, and never repeats the test that failed on the way in
# FORM: Prepared
# RUN: pass PlaceTypeTests
# RUN(AGAIN): pass PlaceTypeTests PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 name="Losable" fields=[{key="a" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Sparse" fields=[{key="a" declared={type=number} flow={stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Filler" fields=[{key="z" declared={type=number}}]

# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

function f0 name="oneTestNotRepeated" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="a"
    Return v1
}
# CHECK-LABEL: function f0 name="oneTestNotRepeated"
# CHECK-NOT: key="a" [
# CHECK: [[test0]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[test0]] -> taken [[passed0]](| 0), notTaken [[failed0]]()
# CHECK-NEXT: [[fast0]]():
# CHECK-NEXT: v1: number = GetSlot v0, [[guard0]] key="a" receivers=[L0] level=Predicted
# CHECK-NEXT: Return v1
# CHECK-NEXT: [[copy0]]() frequency=Unlikely:
# CHECK-NEXT: [[generic0]]: anything ~ undefined|number = PropGet v0 key="a"
# CHECK-NEXT: Return [[generic0]]
# CHECK-NEXT: [[passed0]]([[guard0]]: guard):
# CHECK-NEXT: Jump -> next [[fast0]]()
# CHECK-NEXT: [[failed0]]() frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[copy0]]()
# CHECK-NEXT: }
# AGAIN-LABEL: function f0 name="oneTestNotRepeated"
# AGAIN: = ShapeTest v0 layouts=[L0]
# AGAIN-NOT: ShapeTest
# AGAIN: frequency=Unlikely:
# AGAIN-NEXT: = PropGet v0 key="a"
# AGAIN-NOT: ShapeTest
# AGAIN-NOT: frequency=Rare

function f1 name="twoTestsNotRepeated" parameters=[{type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: object ~ L1):
    v1 = PropGet v0 key="a"
    Return v1
}
# CHECK-LABEL: function f1 name="twoTestsNotRepeated"
# CHECK: [[shape1]]: boolean = ShapeTest v0 layouts=[L1]
# CHECK-NEXT: Branch [[shape1]] -> taken [[shapePassed1]](| 0), notTaken [[shapeFailed1]]()
# CHECK: [[copy1]]() frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="a"
# CHECK: [[shapePassed1]]([[shapeGuard1]]: guard):
# CHECK-NEXT: [[filled1]]: boolean = IsSlotFilled v0, [[shapeGuard1]] key="a" receivers=[L1] level=Predicted
# CHECK-NEXT: Branch [[filled1]] -> taken {{*}}(| 0), notTaken [[filledFailed1]]()
# CHECK-NEXT: [[shapeFailed1]]() frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[copy1]]()
# CHECK: [[filledFailed1]]() frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[copy1]]()
# AGAIN-LABEL: function f1 name="twoTestsNotRepeated"
# AGAIN: = ShapeTest v0 layouts=[L1]
# AGAIN-NOT: ShapeTest
# AGAIN: = IsSlotFilled v0,
# AGAIN-NOT: ShapeTest
# AGAIN-NOT: IsSlotFilled
# AGAIN-NOT: frequency=Rare
# AGAIN-LABEL: function f2 name="otherPredictionInCopy"

function f2 name="otherPredictionInCopy" parameters=[{type=anything predicted=i32}] results=[{type=anything}] {
  b0(v0: anything ~ i32):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Mul v2, v2
    Return v3
  b2(v4 ~ number) frequency=Unlikely:
    v5 = Mul v4, v4
    Return v5
}
# CHECK-LABEL: function f2 name="otherPredictionInCopy"
# CHECK: b2(v4: anything ~ number) frequency=Unlikely:
# CHECK-NEXT: [[test2]]:{{*}}= TypeTest v4 testedType=number
# CHECK-NEXT: Branch [[test2]] -> taken [[passed2]](| 0), notTaken [[failed2]](| 0)
# CHECK-NEXT: [[fast2]]() frequency=Unlikely:
# CHECK-NEXT: v5: number = Mul [[number2]], [[number2]]
# CHECK-NEXT: Return v5
# CHECK-NEXT: [[copy2]]() frequency=Rare:
# CHECK-NEXT: [[generic2]]:{{*}}= Mul [[rest2]], [[rest2]]
# CHECK-NEXT: Return [[generic2]]
# CHECK-NEXT: [[passed2]]([[number2]]: number) frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[fast2]]()
# CHECK-NEXT: [[failed2]]([[rest2]]: undefined|null|boolean|string|symbol|bigint|object) frequency=Rare:
# CHECK-NEXT: Jump -> next [[copy2]]()
# CHECK-NEXT: }

function f3 name="rareCopyIsLeftAlone" parameters=[{type=anything predicted=i32}] results=[{type=anything}] {
  b0(v0: anything ~ i32):
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Mul v2, v2
    Return v3
  b2(v4 ~ number) frequency=Rare:
    v5 = Mul v4, v4
    Return v5
}
# CHECK-LABEL: function f3 name="rareCopyIsLeftAlone"
# CHECK: b2(v4: anything ~ number) frequency=Rare:
# CHECK-NEXT: v5:{{*}}= Mul v4, v4
# CHECK-NEXT: Return v5
# CHECK-NEXT: }

function f4 name="backInNormalCode" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v0, v2 key="a" receivers=[L0] level=Predicted
    Jump -> next b3(v3)
  b2() frequency=Unlikely:
    v4 = PropGet v0 key="a"
    Jump -> next b3(v4)
  b3(v5):
    v6 = NewObject layout=L2
    v7 = PropGet v0 key="b"
    Return v7
}
# CHECK-LABEL: function f4 name="backInNormalCode"
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: v4:{{*}}= PropGet v0 key="a"
# CHECK-NEXT: Jump -> next b3(v4)
# CHECK-NEXT: b3(v5:{{*}}):
# CHECK-NEXT: v6:{{*}}= NewObject layout=L2
# CHECK-NEXT: [[test4]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[test4]] -> taken [[passed4]](| 0), notTaken
# CHECK: v7: number = GetSlot v0, [[guard4]] key="b" receivers=[L0] level=Predicted
# CHECK: [[passed4]]([[guard4]]: guard):

function f5 name="failedValue" parameters=[{type=anything predicted=number}] results=[{type=anything}] {
  b0(v0: anything ~ number):
    v1 = Mul v0, v0
    Return v1
}
# CHECK-LABEL: function f5 name="failedValue"
# CHECK: [[test5]]:{{*}}= TypeTest v0 testedType=number
# CHECK-NEXT: Branch [[test5]] -> taken [[passed5]](| 0), notTaken [[failed5]](| 0)
# CHECK: v1: number = Mul [[number5]], [[number5]]
# CHECK: [[copy5]]() frequency=Unlikely:
# CHECK-NEXT: = Mul [[rest5]], [[rest5]]
# CHECK: [[passed5]]([[number5]]: number):
# CHECK: [[failed5]]([[rest5]]: undefined|null|boolean|string|symbol|bigint|object) frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[copy5]]()
