# A claim at the head of a merge block moves to the one edge whose value needs the test, and the parameter gets the claimed type
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="claimMovesToEdge" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = Claim v3 castType=number
    Return v4
}
# CHECK-LABEL: function f0 name="claimMovesToEdge"
# CHECK: b1():
# CHECK-NEXT: v2: 1 = Integer integer=1
# CHECK-NEXT: Jump -> next b3(v2)
# CHECK-NEXT: b2():
# CHECK-NEXT: [[onEdge]]: number = Claim v0 castType=number
# CHECK-NEXT: Jump -> next b3([[onEdge]])
# CHECK-NEXT: b3(v3: number):
# CHECK-NEXT: Return v3

function f1 name="sameHandlerOnEdgeAndMerge" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v2)
  b2() handler=b4(v1):
    Jump -> next b3(v0)
  b3(v3) handler=b4(v1):
    v4 = Claim v3 castType=number
    Return v4
  b4(v5) role=CatchHandler:
    v6 = CatchValue
    v7 = Integer integer=0
    Return v7
}
# CHECK-LABEL: function f1 name="sameHandlerOnEdgeAndMerge"
# CHECK: b2() handler=b4(v1):
# CHECK-NEXT: [[covered]]: number = Claim v0 castType=number
# CHECK-NEXT: Jump -> next b3([[covered]])
# CHECK-NEXT: b3(v3: number) handler=b4(v1):
# CHECK-NEXT: Return v3

function f2 name="secondParameterIsClaimed" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v0, v2)
  b2():
    Jump -> next b3(v0, v0)
  b3(v3, v4):
    v5 = Claim v4 castType=number
    v6 = TypeOf v3
    Return v5
}
# CHECK-LABEL: function f2 name="secondParameterIsClaimed"
# CHECK: b2():
# CHECK-NEXT: [[second]]: number = Claim v0 castType=number
# CHECK-NEXT: Jump -> next b3(v0, [[second]])
# CHECK-NEXT: b3(v3: anything, v4: number):
# CHECK-NOT: Claim
# CHECK: Return v4

function f3 name="twoEdgesNeedIt" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=number}] {
  b0(v0: anything, v1: anything, v2: anything):
    Switch v2 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    v3 = Integer integer=1
    Jump -> next b4(v3)
  b2():
    Jump -> next b4(v0)
  b3():
    Jump -> next b4(v1)
  b4(v4):
    v5 = Claim v4 castType=number
    Return v5
}
# CHECK-LABEL: function f3 name="twoEdgesNeedIt"
# CHECK: b2():
# CHECK-NEXT: Jump -> next b4(v0)
# CHECK-NEXT: b3():
# CHECK-NEXT: Jump -> next b4(v1)
# CHECK-NEXT: b4(v4: anything):
# CHECK-NEXT: v5: number = Claim v4 castType=number
# CHECK-NEXT: Return v5

function f4 name="claimIsNotFirstValue" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = Call v0
    v5 = Claim v3 castType=number
    Return v5
}
# CHECK-LABEL: function f4 name="claimIsNotFirstValue"
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK-NEXT: b3(v3: anything):
# CHECK-NEXT: = Call v0
# CHECK-NEXT: v5: number = Claim v3 castType=number
# CHECK-NEXT: Return v5

function f5 name="everyEdgeNeedsIt" parameters=[{type=anything}] results=[{type=number}] {
  b0(v0: anything):
    Jump -> next b1(v0)
  b1(v1):
    v2 = Claim v1 castType=number
    Return v2
}
# CHECK-LABEL: function f5 name="everyEdgeNeedsIt"
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: Jump -> next b1(v0)
# CHECK-NEXT: b1(v1: anything):
# CHECK-NEXT: v2: number = Claim v1 castType=number
# CHECK-NEXT: Return v2
