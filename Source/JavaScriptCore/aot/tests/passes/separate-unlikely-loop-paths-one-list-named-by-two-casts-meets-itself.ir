# `for (..) { const list = make(); if (rarely) log(); sum ^= list.length }`, where the likely path and the rare one each say by a cast of their own what the list is.
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 1

module m0 path="main.js" displayPath="main.js"

# Where the two meet, the likely path reads the list through a parameter. The rare path leaves with a copy of the loop, so only the cast in front of the read comes to it.
function f0 name="oneListOnEveryEdge" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=i32}] {
    v3 = Integer integer=0
    Jump -> next b1(v0, v3)
  b1(v4: number, v5: i32):
    LoopHint
    v7 = Greater v4, v3
    Branch v7 -> taken b2(), notTaken b6()
  b2():
    v8 = NewArray contents=anything
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v9 = Specified
    v10 = AssumeType v8, v9 provenType=Array<i32>
    Jump -> next b5(v10)
  b4() frequency=Rare:
    v11 = Call v1, -, v5
    v12 = Specified
    v13 = AssumeType v8, v12 provenType=Array<i32>
    Jump -> next b5(v13)
  b5(v14: Array<i32>):
    v15 = CallBuiltin v14 overload=ArrayPrototypeLength/0
    v16 = BitXor v5, v15
    v17 = Call v1, -, v16
    v18 = ToNumber v17
    Jump -> next b1(v18, v16)
  b6():
    Return v5
# CHECK: Branch v2 -> taken b3(), notTaken [[rare]]()
# CHECK: [[joinOfCopy]]([[listInCopy]]: Array<i32>) frequency=Unlikely:
# CHECK: [[rare]]() frequency=Rare:
# CHECK: [[castInCopy]]: Array<i32> = AssumeType v8,
# CHECK-NEXT: Jump -> next [[joinOfCopy]]([[castInCopy]])
}

# The rare path brings a list of its own. A copy of the loop would leave the likely path what it has, a list that it knows no more about.
function f1 name="anotherListOnTheRareEdge" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=i32}] {
    v3 = Integer integer=0
    Jump -> next b1(v0, v3)
  b1(v4: number, v5: i32):
    LoopHint
    v7 = Greater v4, v3
    Branch v7 -> taken b2(), notTaken b6()
  b2():
    v8 = NewArray contents=anything
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v9 = Specified
    v10 = AssumeType v8, v9 provenType=Array<i32>
    Jump -> next b5(v10)
  b4() frequency=Rare:
    v11 = Call v1, -, v5
    v12 = Specified
    v13 = AssumeType v11, v12 provenType=Array<i32>
    Jump -> next b5(v13)
  b5(v14: Array<i32>):
    v15 = CallBuiltin v14 overload=ArrayPrototypeLength/0
    v16 = BitXor v5, v15
    v17 = Call v1, -, v16
    v18 = ToNumber v17
    Jump -> next b1(v18, v16)
  b6():
    Return v5
# CHECK: Branch v2 -> taken b3(), notTaken b4()
# CHECK-NOT: frequency=Unlikely
}
