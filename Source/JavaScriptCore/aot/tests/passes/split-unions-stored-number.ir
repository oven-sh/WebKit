# A store into a view of numbers of a value that is a number, undefined, null or a boolean is copied once for the number, which is stored as it is. What else the value may be becomes a number
# without running code, so that copy is a store of an element too, in a block that is unlikely, or rare where a number is expected
# FORM: Prepared
# RUN: pass SplitUnions
# RUN(RESOLVED): pass SplitUnions ResolveAccesses
# STATISTIC: UnionsSplit = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="optional" parameters=[{type=Float64Array}, {type=int[0, 9]}, {type=undefined|number}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK: = TypeTest v2 testedType=number
# CHECK: ([[number0]]: number):
# CHECK-NEXT: ElemSet v0, v1, [[number0]]
# CHECK: ([[other0]]: undefined) frequency=Unlikely:
# CHECK-NEXT: ElemSet v0, v1, [[other0]]
# RESOLVED: ([[number0]]: number):
# RESOLVED-NEXT: PutTypedArrayElement v0, v1, [[number0]] typedArrayType=
# RESOLVED: ([[other0]]: undefined) frequency=Unlikely:
# RESOLVED-NEXT: [[converted0]]: number = ToNumber [[other0]]
# RESOLVED-NEXT: PutTypedArrayElement v0, v1, [[converted0]] typedArrayType=
# RESOLVED-NOT: ElemSet
}

function f1 name="expectedNumber" parameters=[{type=Uint8Array}, {type=int[0, 9]}, {type=undefined|null|number}] results=[{type=undefined}] {
  b0(v0: Uint8Array, v1: int[0, 9], v2: undefined|null|number ~ number):
    ElemSet v0, v1, v2
    Return
# CHECK: = TypeTest v2 testedType=number
# CHECK: ([[other1]]: undefined|null) frequency=Rare:
# CHECK-NEXT: ElemSet v0, v1, [[other1]]
# RESOLVED: ([[other1]]: undefined|null) frequency=Rare:
# RESOLVED-NEXT: [[converted1]]: number = ToNumber [[other1]]
# RESOLVED-NEXT: PutTypedArrayElement v0, v1, [[converted1]] typedArrayType=
# RESOLVED-NOT: ElemSet
}

function f2 name="flagOrInteger" parameters=[{type=Int32Array}, {type=int[0, 9]}, {type=boolean|int[0, 255]}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK: = TypeTest v2 testedType=int[0, 255]
