}

function f3 name="noNumberAtAll" parameters=[{type=Float32Array}, {type=int[0, 9]}, {type=undefined}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# Nothing is left to ask.
# CHECK-NOT: TypeTest
# RESOLVED: [[converted3]]: number = ToNumber v2
# RESOLVED-NEXT: PutTypedArrayElement v0, v1, [[converted3]] typedArrayType=
}

function f4 name="conversionsThatRunCode" parameters=[{type=Float64Array}, {type=int[0, 9]}, {type=number|string}, {type=number|object}, {type=number|bigint}, {type=number|symbol}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    ElemSet v0, v1, v3
    ElemSet v0, v1, v4
    ElemSet v0, v1, v5
    Return
# A text is read, an object is asked, and a BigInt or a symbol throws.
