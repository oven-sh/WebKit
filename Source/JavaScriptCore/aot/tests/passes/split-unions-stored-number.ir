}

function f6 name="inARareBlock" parameters=[{type=Float64Array}, {type=int[0, 9]}, {type=undefined|number}, {type=boolean}] results=[{type=undefined}] {
    Branch v3 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    ElemSet v0, v1, v2
    Jump -> next b2()
  b2():
    Return
# CHECK-NOT: TypeTest
}

