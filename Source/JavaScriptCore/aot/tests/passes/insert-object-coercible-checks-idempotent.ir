# The pass does nothing on its own output
# FORM: Prepared
# STATISTIC: InsertObjectCoercibleChecksChanges = 0
# RUN: pass InsertObjectCoercibleChecks
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]

function f0 name="allocate" parameters=[{type=number}] results=[{type=L0}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}

function f1 name="checked" parameters=[{type=undefined|L0}, {type=boolean}] results=[{type=anything}] {
    v2 = RequireObjectCoercible v0 name="x"
    v3 = PropGet v2 key="x" receivers=[L0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = PropGet v2 key="x" receivers=[L0]
    Return v4
  b2():
    Return v3
}
