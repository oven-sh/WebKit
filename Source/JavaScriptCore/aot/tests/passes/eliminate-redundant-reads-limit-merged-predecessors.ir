# A read is merged into a block parameter only when its block has at most as many incoming edges as the limit
# FORM: Prepared
# OPTIONS: limit=MaxMergedReadPredecessors:2
# RUN: pass EliminateRedundantReads
# LOSS: MaxMergedReadPredecessors x1 f1 v8
# STATISTIC: EliminateRedundantReadsChanges = 1

module m0 path="main.js" displayPath="main.js"
variable g0 name="n" module=m0 declared={type=undefined|number} initialization=Undefined

function f0 name="atTheLimit" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v0 variable=g0
    Jump -> next b3()
  b2():
    PutModuleVariable v1 variable=g0
    Jump -> next b3()
  b3():
    v5 = GetModuleVariable variable=g0
    Return v5
# CHECK: Jump -> next b3(v0)
# CHECK: Jump -> next b3(v1)
# CHECK: b3([[merged]]:
# CHECK-NEXT: v5:{{*}}= Upcast [[merged]]
}

function f1 name="overTheLimit" parameters=[{type=number}, {type=number}, {type=number}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v0 variable=g0
    Jump -> next b5()
  b2():
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    PutModuleVariable v1 variable=g0
    Jump -> next b5()
  b4():
    PutModuleVariable v2 variable=g0
    Jump -> next b5()
  b5():
    v8 = GetModuleVariable variable=g0
    Return v8
# CHECK-COUNT-3: Jump -> next b5()
# CHECK: b5():
# CHECK-NEXT: v8: undefined|number = GetModuleVariable variable=g0
}
