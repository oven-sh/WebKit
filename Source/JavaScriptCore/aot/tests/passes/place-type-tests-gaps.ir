function f5 name="gapOnOnePath" parameters=[{type=object}, {type=boolean}, {type=number}] results=[{type=anything}] {
  b0(v0: object, v1: boolean, v2: number):
    v3 = PropGet v0 key="x"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = Add v2, v2
    Jump -> next b3()
  b2():
    v5 = Add v2, v2
    v6 = Add v5, v2
    v7 = Add v6, v2
    v8 = Add v7, v2
    v9 = Add v8, v2
    Jump -> next b3()
  b3():
    v10 = PropGet v0 key="y"
    v11 = ShapeTest v0 layouts=[L0]
    Return v10
}
