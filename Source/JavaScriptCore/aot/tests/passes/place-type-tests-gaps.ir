function f0 name="narrowGap" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
  b0(v0: object, v1: number):
    v2 = PropGet v0 key="x"
    v3 = Add v1, v1
    v4 = Add v3, v1
    v5 = PropGet v0 key="y"
    v6 = Add v4, v1
    v7 = Add v6, v1
    v8 = Add v7, v1
    v9 = Add v8, v1
    v10 = Add v9, v1
    v11 = PropGet v0 key="x"
    v12 = ShapeTest v0 layouts=[L0]
