# The object of a construction is a literal with a prototype operand: the read of the prototype stays, the object goes or sinks
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 1
# STATISTIC: AllocationsSunk = 4
# STATISTIC: StoresFoldedIntoAllocations = 3

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="F" constructor=f4 fields=[{key="x" declared={type=anything}}] flow={baseState=None}

function f0 name="constructorInlined" parameters=[{type=f4}, {type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropDefine v3, v1 key="x" receivers=[L0]
    v5 = PropGet v3 key="x" receivers=[L0]
    Return v5
# CHECK: b0(
# CHECK-NEXT: = GetConstructPrototype v0 layout=L0
# CHECK-NEXT: v5: anything = Upcast v1 castType=anything
# CHECK-NEXT: Return v5
}

function f1 name="builtInOneBranch" parameters=[{type=f4}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = GetConstructPrototype v0 layout=L0
    v4 = NewObject v3 layout=L0
    PropDefine v4, v1 key="x" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v6 = Call v1, -, v4
    Return v6
  b2():
    Return v1
# CHECK: b0(
# CHECK-NEXT: v3:{{*}}= GetConstructPrototype v0 layout=L0
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: [[cell1]]:{{*}}= NewObject v3, v1 layout=L0 fields=[0]
# CHECK-NEXT: = Call v1, -, [[cell1]]
# CHECK: b2():
# CHECK-NOT: NewObject
}

function f2 name="newTargetStaysAllocated" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f4
    v3 = GetConstructPrototype v2 layout=L0
    v4 = NewObject v3 layout=L0
    PropDefine v4, v0 key="x" receivers=[L0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v6 = Call v0, -, v4
    Return v6
  b2():
    Return v0
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= NewClosure
# CHECK-NEXT: v3:{{*}}= GetConstructPrototype v2 layout=L0
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: = NewObject v3, v0 layout=L0 fields=[0]
}

function f3 name="sunkPastCall" parameters=[{type=f4}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = GetConstructPrototype v0 layout=L0
    v4 = NewObject v3 layout=L0
    v5 = Call v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v6 = Call v1, -, v4
    Return v6
  b2():
    Return v5
# CHECK: b0(
# CHECK-NEXT: v3:{{*}}= GetConstructPrototype v0 layout=L0
# CHECK-NEXT: = Call v1
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: [[cell3]]:{{*}}= NewObject v3 layout=L0
# CHECK-NEXT: = Call v1, -, [[cell3]]
}

function f4 name="F" flags=[HasThis] thisType={type=L0} parameters=[{type=anything}] results=[{type=anything}] {
    PropDefine v0, v1 key="x" receivers=[L0]
    Return
}
# CHECK-LABEL: function f4 name="F"

function f5 name="F" role=AllocatedThisVersion flags=[HasThis] thisType={type=L0} parameters=[{type=anything}] results=[{type=anything}] derivation={source=f4 parameterMap=[{}, {original=1}]} creator=Version{provenVersion=f4} {
    PropDefine v0, v1 key="x" receivers=[L0]
    Return
}
# CHECK-LABEL: function f5 name="F"

function f6 name="constructorNotInlined" parameters=[{type=f4}, {type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = CallDirect v3, v1 function=f5
    v5 = PropGet v3 key="x" receivers=[L0]
    Return v5
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= GetConstructPrototype v0 layout=L0
# CHECK-NEXT: v3:{{*}}= NewObject v2 layout=L0
# CHECK-NEXT: = CallDirect v3, v1 function=f5
# CHECK-NEXT: = PropGet v3 key="x"
}

function f7 name="storeBecomesInitialValue" parameters=[{type=f4}, {type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropDefine v3, v1 key="x" receivers=[L0]
    v5 = Call v1, -, v3
    Return v5
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= GetConstructPrototype v0 layout=L0
# CHECK-NEXT: [[cell7]]:{{*}}= NewObject v2, v1 layout=L0 fields=[0]
# CHECK-NEXT: = Call v1, -, [[cell7]]
}

function f8 name="wouldOnlyMove" parameters=[{type=f4}, {type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = ToBoolean v1
    v5 = Call v1, -, v3, v4
    Return v5
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= GetConstructPrototype v0 layout=L0
# CHECK-NEXT: v3:{{*}}= NewObject v2 layout=L0
# CHECK-NEXT: = ToBoolean v1
# CHECK-NEXT: = Call v1, -, v3, v4
}
