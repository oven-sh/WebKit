# A method that needs its closure cannot be called without the read, so the value that is called gets the method as its prediction
# FORM: Prepared
# RUN: pass ResolveCalls ResolveCalls
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Task" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype, LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f1 mutability=Fixed}, {key="stop" function=f2 mutability=Fixed}]}
function f0 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L0}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 [keepsShape]
    Return v2
}
function f1 name="run" kind=Method flags=[HasThis] captures=[{type=number}] thisType={type=object written=L0} results=[{type=anything}] {
  b0(v0: number, v1: object ? L0):
    Return
}
function f2 name="stop" kind=Method flags=[HasThis] captures=[{type=number}] thisType={type=object written=L0} results=[{type=anything}]

function f3 name="proven-receiver" parameters=[{type=L0}] results=[{type=anything}] {
