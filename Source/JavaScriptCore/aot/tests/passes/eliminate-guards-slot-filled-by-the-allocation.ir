# A test that a slot is filled, of an object that this function allocated with the slot filled and that nothing has changed since, always passes
# TODO: eliminate-guards: an allocation never stands for a test that a slot is filled: what ends its proof (shape words) is compared by heap with what ends the proof of the test (the field)
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=string}}]

function f0 name="slotFilledAtCreation" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = IsSlotFilled v1 key="x" receivers=[L0] level=Expected
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = GetSlot v1, v3 key="x" receivers=[L0] level=Expected
    Return v4
  b2() frequency=Unlikely:
    v5 = PropGet v1 key="x"
    Return v5
}
# CHECK-LABEL: function f0 name="slotFilledAtCreation"
# CHECK-NOT: IsSlotFilled
