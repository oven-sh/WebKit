function f3 name="seldom" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = NewClosure function=f1
    v3 = CallDirect v1, v0, v0 function=f2
    v4 = CallDirect v2, v0, v0 function=f2
    Return v4
}
# CHECK-LABEL: function f3 name="seldom"
# CHECK: v3{{*}}= CallDirect v1, v0, v0 function=[[forAnyFunction]]
# CHECK-NEXT: v4{{*}}= CallDirect v2, v0, v0 function=[[forAnyFunction]]

function f4 name="often" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = NewClosure function=f1
    v3 = CallDirect v1, v0, v0 function=f2
    v4 = CallDirect v2, v0, v0 function=f2
    Return v4
}
# CHECK-LABEL: function f4 name="often"
# CHECK: = CallDirect v2, v0, v0 function=[[forNegate]]
# CHECK: = CallDirect v1, v0, v0 function=[[forDouble]]

function f5 name="drive" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = CallDirect v0 function=f3 [isNeverInlined]
    v3 = Integer integer=1
    v4 = CallDirect v3 function=f7 [isNeverInlined]
    v5 = CallDirect v3 function=f7 [isNeverInlined]
    v6 = CallDirect v3 function=f7 [isNeverInlined]
    Jump -> next b1()
  b1():
    LoopHint
    v8 = CallDirect v0 function=f4 [isNeverInlined]
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v8
}
# CHECK-LABEL: function f5 name="drive"
function f6 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Boolean boolean=true
    v2 = CallDirect v0, v1 function=f5 [isNeverInlined]
    Return v2
}
# Most of the program's size runs more often than `seldom` and less often than `often`
