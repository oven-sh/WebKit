# In the colder part of the program, by how often a function is taken to run for its size, a call that passes one known function to a function of the application goes to one copy
# for whatever function is passed. In the hotter part each function that is passed gets a copy of its own: `seldom` and `often` have the same body, and `often` is called in a loop
# FORM: Prepared
# RUN: pass InlineCalls
# STATISTIC: CalleeVersions = 3
# LOSS: MaxInlineHeadBytes
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js" body=f6
entry module=m0
function f0 name="double" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v0
    Return v1
}
function f1 name="negate" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Negate v0
    Return v1
}
