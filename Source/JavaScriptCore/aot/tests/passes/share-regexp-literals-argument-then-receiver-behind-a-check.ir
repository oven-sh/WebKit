# A literal that is first an argument of a String method and then the receiver of test is shared, unless a flag makes the second use advance lastIndex,
# also where the type of the string comes from an annotation and the check at the head stays: an activation that the check turns away never comes back into the typed code
# TODO: flow-termination: a RegExp literal that is an argument first and a receiver behind a check is made anew each time instead of shared
# FORM: AsRead
# RUN: pipeline ShareRegExpLiterals

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=5 kind=Parameter
typesite w1 module=m0 position=15 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    Return
}
function f1 name="argumentThenReceiver" parameters=[{type=string site=w0}] results=[{type=anything}] {
  b0(v0: string):
    v1 = NewRegExp pattern="a" @10
    v2 = String string="b"
    v3 = PropGet v0 key="replace"
    v4 = Call v3, v0, v1, v2 calleeKey="replace"
    v5 = PropGet v1 key="test"
    v6 = Call v5, v1, v4 calleeKey="test"
    Return v6
}
# CHECK-LABEL: function f1 name="argumentThenReceiver"
# CHECK: [[shared]]:{{*}}= SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
# CHECK: CallBuiltin {{*}}overload=StringPrototypeReplace/0
# CHECK: CallBuiltin {{*}}overload=RegExpPrototypeTest/0
function f2 name="globalArgumentThenReceiver" parameters=[{type=string site=w1}] results=[{type=anything}] {
  b0(v0: string):
    v1 = NewRegExp pattern="a" regExpFlags=[Global] @20
    v2 = String string="b"
    v3 = PropGet v0 key="replace"
    v4 = Call v3, v0, v1, v2 calleeKey="replace"
    v5 = PropGet v1 key="test"
    v6 = Call v5, v1, v4 calleeKey="test"
    Return v6
}
# CHECK-LABEL: function f2 name="globalArgumentThenReceiver"
# CHECK: = NewRegExp pattern="a" regExpFlags=[Global]
# CHECK-NOT: SharedRegExpLiteral
# CHECK-LABEL: function f3
