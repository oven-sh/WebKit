# A value that is Unspecified on some path stays in the function that knows the state which tells: in a part that is cut off it would be a parameter like any other, which validation tests and code generation reads through wherever it likes
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=anything}}]
function f0 name="unspecifiedOnOnePath" parameters=[{type=boolean}, {type=L0}, {type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: L0, v2: function, v3: anything):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    v4 = Unspecified valueType=L0
    Jump -> next b3(v4)
  b3(v5: L0):
    v6 = TypeTest v3 testedType=number
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    Return v3
  b5():
    v7 = Call v2, -, v0, v5
    Return v7
}
# CHECK-LABEL: function f0 name="unspecifiedOnOnePath"
# CHECK-NOT: CallDirect
# CHECK: anything = Call v2, -, v0, v5

function f1 name="unspecifiedThroughCast" parameters=[{type=boolean}, {type=L0}, {type=function}, {type=anything}] results=[{type=anything}] {
