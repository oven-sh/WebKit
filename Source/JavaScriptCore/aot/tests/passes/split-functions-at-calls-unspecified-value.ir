    Branch v7 -> taken b4(), notTaken b5()
  b4():
    Return v3
  b5():
    v8 = Call v2, -, v0, v6
    Return v8
}
# CHECK-LABEL: function f1 name="unspecifiedThroughCast"
# CHECK-NOT: CallDirect
# CHECK: anything = Call v2, -, v0, v6

function f2 name="specifiedOnBothPaths" parameters=[{type=boolean}, {type=L0}, {type=function}, {type=anything}, {type=L0}] results=[{type=anything}] {
  b0(v0: boolean, v1: L0, v2: function, v3: anything, v4: L0):
