# Two objects that are born together get one cell: the operation of the inner object, which comes first, allocates it (outerLayout=), and the operation of the outer object takes it.
# Each time the inner object is made, at most one operation may take its cell.
# FORM: AsRead
# RUN: pipeline AllocateInnerObjects
# OPTIONS: check=VerifyEachPass only-passes=EstimateHeat,AllocateInnerObjects
# STATISTIC: InnerObjectsAllocated = 3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Outer" fields=[{key="b" declared={type=number} flags=[IsRequired]}, {key="c" declared={type=L1} flags=[IsRequired]}]
layout L1 name="Inner" fields=[{key="d" declared={type=number} flags=[IsRequired]}, {key="e" declared={type=number} flags=[IsRequired]}]
layout L2 name="HeldTwice" fields=[{key="c" declared={type=L3} flags=[IsRequired]}]
layout L3 name="InnerOfHeldTwice" fields=[{key="d" declared={type=number} flags=[IsRequired]}]
layout L4 name="MadeInLoop" fields=[{key="c" declared={type=L5} flags=[IsRequired]}]
layout L5 name="MadeInFrontOfLoop" fields=[{key="d" declared={type=number} flags=[IsRequired]}]
layout L6 name="OuterOfResult" fields=[{key="c" declared={type=L7} flags=[IsRequired]}]
layout L7 name="Result" fields=[{key="d" declared={type=number} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Double number=0.5
    v1 = Boolean boolean=true
    v2 = CallDirect v0 function=f1
    v3 = CallDirect v0, v1 function=f2
    v4 = CallDirect v0 function=f3
    v5 = CallDirect v0 function=f4
    v6 = CallDirect v0 function=f6
    v7 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v8 = CallDirect v0, v7 function=f7
    Return
}

function f1 name="literalInLiteral" parameters=[{type=number}] results=[{type=L0}] {
    v1 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
# CHECK: [[inner]]:{{*}}= NewObject -, v0, v0 layout=L1 {{*}}outerLayout=L0
# CHECK-NEXT: = NewObject -, v0, [[inner]] layout=L0 {{*}}[takesCellOfInnerObject]
}

function f2 name="outerObjectInEitherArm" parameters=[{type=number}, {type=boolean}] results=[{type=L0}] {
    v2 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v2 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = NewObject -, v0, v2 layout=L0 fields=[0, 1]
    Return v4
# CHECK: = NewObject -, v0, v0 layout=L1 {{*}}outerLayout=L0
# CHECK: b1():
# CHECK-NEXT: layout=L0 {{*}}[takesCellOfInnerObject]
# CHECK: b2():
# CHECK-NEXT: layout=L0 {{*}}[takesCellOfInnerObject]
}

function f3 name="twoObjectsListOne" parameters=[{type=number}] results=[{type=L2}] {
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = NewObject -, v1 layout=L2 fields=[0]
    v3 = NewObject -, v1 layout=L2 fields=[0]
    Return v3
# CHECK-NOT: outerLayout
# CHECK-NOT: takesCellOfInnerObject
}

function f4 name="outerObjectsInLoop" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L5 fields=[0]
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Integer integer=10
    v6 = Less v3, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = NewObject -, v1 layout=L4 fields=[0]
    v8 = Integer integer=1
    v9 = Add v3, v8
    Jump -> next b1(v9)
  b3():
    Return
# CHECK-NOT: outerLayout
# CHECK-NOT: takesCellOfInnerObject
}

function f5 name="makesResult" parameters=[{type=number}] results=[{type=L7}] {
    v1 = NewObject -, v0 layout=L7 fields=[0]
    Return v1
# CHECK: = NewObject -, v0 layout=L7 {{*}}outerLayout=L6
}

function f6 name="listsFreshResult" parameters=[{type=number}] results=[{type=L6}] {
    v1 = CallDirect v0 function=f5
    v2 = NewObject -, v1 layout=L6 fields=[0]
    Return v2
# CHECK: layout=L6 {{*}}[takesCellOfInnerObject]
}

# An allocation that lists an object from elsewhere asks for a cell of its own, without the room.
function f7 name="listsObjectFromElsewhere" parameters=[{type=number}, {type=L1}] results=[{type=L0}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
# CHECK-NOT: takesCellOfInnerObject
}
