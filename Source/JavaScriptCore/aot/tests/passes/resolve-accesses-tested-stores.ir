# A store that holds only under tests: after the shape come the tests that the name is nowhere but in the slot, the test for a frozen object and the test of the stored value, and the slot store names the guard and the narrowed value
# FORM: Prepared
# RUN: pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Loose" fields=[{key="x" declared={type=number}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="late" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="fixed" declared={type=number} flags=[IsImmutable] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Sealed" fields=[{key="x" declared={type=number}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}
layout L2 name="Unlisted" fields=[{key="late" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype, LoseShape] keys=NeverEnumerated}
layout L3 name="Holder" fields=[{key="list" declared={type=Array<number, proven>} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="either" declared={type=number|Array<number, proven>} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="plain" declared={type=Array} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="loose" declared={type=L0} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="sealed" declared={type=L1} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}

function f0 name="every-test" parameters=[{type=object predicted=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    PropSet v0, v1 key="x"
    Return
}
# CHECK-LABEL: function f0 name="every-test"
# CHECK-NEXT: b0(v0: object ~ L0, v1: anything):
# CHECK-NEXT: [[hasShape]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[hasShape]] -> taken [[shaped]](| 0), notTaken {{*}}()
# CHECK: PutSlotOrAdd v0, [[guard]], [[number]] key="x" receivers=[L0] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, v1 key="x"
# CHECK: [[shaped]]([[shapeGuard]]: guard):
# CHECK-NEXT: [[hasPrototype]]: boolean = HasLayoutPrototype v0, [[shapeGuard]]
# CHECK-NEXT: Branch [[hasPrototype]] -> taken [[inherits]](| 0), notTaken {{*}}()
# CHECK: [[inherits]]({{*}}: guard):
# CHECK: [[hasNoOthers]]: boolean = HasNoExtraProperties v0, {{*}}
# CHECK-NEXT: Branch [[hasNoOthers]] -> taken [[plain]](| 0), notTaken {{*}}()
# CHECK: [[plain]]({{*}}: guard):
# CHECK: [[isNotFrozen]]: boolean = IsNotFrozen v0, {{*}}
# CHECK-NEXT: Branch [[isNotFrozen]] -> taken [[notFrozen]](| 0), notTaken {{*}}()
# CHECK: [[notFrozen]]({{*}}: guard):
# CHECK-NEXT: [[fits]]: boolean = TypeTest v1 testedType=number
# CHECK-NEXT: Branch [[fits]] -> taken [[fitting]](| 0), notTaken {{*}}(| 0)
# CHECK: [[fitting]]([[number]]: number):
function f1 name="slot-is-always-filled" parameters=[{type=object predicted=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    PropSet v0, v1 key="y"
    Return
}
# CHECK-LABEL: function f1 name="slot-is-always-filled"
# CHECK-NOT: IsSlotFilled
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK-NOT: IsSlotFilled
# CHECK: PutSlot v0, {{*}}, [[filledNumber]] key="y" receivers=[L0] level=Predicted
# CHECK-NOT: IsSlotFilled
# CHECK: = IsNotFrozen v0,
# CHECK-NOT: IsSlotFilled
# CHECK: = TypeTest v1 testedType=number
# CHECK-NOT: IsSlotFilled
# CHECK: ([[filledNumber]]: number):
function f2 name="value-fits" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    PropSet v0, v1 key="x"
    Return
}
# CHECK-LABEL: function f2 name="value-fits"
# CHECK-NOT: TypeTest
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK: PutSlotOrAdd v0, {{*}}, v1 key="x" receivers=[L0] level=Predicted
# CHECK: = HasNoExtraProperties v0,
# CHECK: = IsNotFrozen v0,
# CHECK-NOT: TypeTest
function f3 name="object-is-never-frozen" parameters=[{type=L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: L1, v1: anything):
    PropSet v0, v1 key="x"
    Return
}
# CHECK-LABEL: function f3 name="object-is-never-frozen"
# CHECK-NEXT: b0(v0: L1, v1: anything):
# CHECK-NEXT: [[sealedHasNoOthers]]: boolean = HasNoExtraProperties v0
# CHECK-NEXT: Branch [[sealedHasNoOthers]] -> taken [[sealedPlain]](| 0), notTaken {{*}}()
# CHECK-NOT: IsNotFrozen
# CHECK: PutSlotOrAdd v0, [[sealedGuard]], [[sealedNumber]] key="x" receivers=[L1] level=Predicted
# CHECK: [[sealedPlain]]([[sealedGuard]]: guard):
# CHECK-NEXT: = TypeTest v1 testedType=number
# CHECK-NOT: IsNotFrozen
# CHECK: ([[sealedNumber]]: number):
function f4 name="store-may-create-the-property" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    PropSet v0, v1 key="late"
    Return
}
# CHECK-LABEL: function f4 name="store-may-create-the-property"
# CHECK-NOT: IsSlotFilled
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK: PutSlotOrAdd v0, {{*}}, v1 key="late" receivers=[L0] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, v1 key="late"
# CHECK: = IsNotFrozen v0,
# CHECK-NOT: IsSlotFilled
function f5 name="store-may-create-a-property-nobody-enumerates" parameters=[{type=L2}, {type=number}] results=[{type=anything}] {
  b0(v0: L2, v1: number):
    PropSet v0, v1 key="late"
    Return
}
# CHECK-LABEL: function f5 name="store-may-create-a-property-nobody-enumerates"
# CHECK-NEXT: b0(v0: L2, v1: number):
# CHECK-NEXT: = IsNotFrozen v0
# CHECK-NOT: PutSlotOrAdd
# CHECK: PutSlot v0, {{*}}, v1 key="late" receivers=[L2] level=Predicted
# CHECK-NOT: PutSlotOrAdd
function f6 name="definition" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number):
    PropDefine v0, v1 key="y"
    Return
}
# CHECK-LABEL: function f6 name="definition"
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK: PutSlot v0, {{*}}, v1 key="y" receivers=[L0] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropDefine v0, v1 key="y"
# CHECK: = IsNotFrozen v0,
function f7 name="part-of-the-field-type-can-be-tested" parameters=[{type=L3}, {type=anything}] results=[{type=anything}] {
  b0(v0: L3, v1: anything):
    PropSet v0, v1 key="either"
    Return
}
# CHECK-LABEL: function f7 name="part-of-the-field-type-can-be-tested"
# CHECK-NEXT: b0(v0: L3, v1: anything):
# CHECK-NEXT: [[isNumber]]: boolean = TypeTest v1 testedType=number
# CHECK-NEXT: Branch [[isNumber]] -> taken [[numbers]](| 0), notTaken {{*}}(| 0)
# CHECK-NOT: TypeTest
# CHECK: PutSlot v0, -, [[testedNumber]] key="either" receivers=[L3] level=Predicted
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, {{*}} key="either"
# CHECK: [[numbers]]([[testedNumber]]: number):
# CHECK-NOT: TypeTest
function f8 name="class-of-the-field-type-can-be-tested" parameters=[{type=L3}, {type=anything}] results=[{type=anything}] {
  b0(v0: L3, v1: anything):
    PropSet v0, v1 key="plain"
    Return
}
# CHECK-LABEL: function f8 name="class-of-the-field-type-can-be-tested"
# CHECK-NEXT: b0(v0: L3, v1: anything):
# CHECK-NEXT: = TypeTest v1 testedType=Array
# CHECK: PutSlot v0, -, [[testedArray]] key="plain" receivers=[L3] level=Predicted
# CHECK: ([[testedArray]]: Array):
function f9 name="layout-keeping-its-shape-can-be-tested" parameters=[{type=L3}, {type=L1|L2}] results=[{type=anything}] {
  b0(v0: L3, v1: L1|L2):
    PropSet v0, v1 key="sealed"
    Return
}
# CHECK-LABEL: function f9 name="layout-keeping-its-shape-can-be-tested"
# CHECK-NEXT: b0(v0: L3, v1: L1|L2):
# CHECK-NEXT: = TypeTest v1 testedType=L1
# CHECK: PutSlot v0, -, [[testedObject]] key="sealed" receivers=[L3] level=Predicted
# CHECK: ([[testedObject]]: L1):
function f10 name="proven-contents-cannot-be-tested" parameters=[{type=L3}, {type=anything}] results=[{type=anything}] {
  b0(v0: L3, v1: anything):
