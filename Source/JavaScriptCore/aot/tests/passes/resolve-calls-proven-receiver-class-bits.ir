# What a member call, a getter and a setter cost on a receiver whose layout is proven. A closed class: no test. Otherwise one test of one bit, whatever is open: the objects (they may get a property of the name
# or another prototype), the member (it may be redefined), or both, for one class or for a family that shares the method. No test asks the object. The operations as they were stand on the failing side.
# FORM: Prepared
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 7
# CHECK: outcome: Changed
# CHECK-NOT: HasLayoutPrototype
# CHECK-NOT: HasNoExtraProperties

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Closed" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="run" function=f1 mutability=Fixed}] namedMembers=[{key="run" function=f1 mutability=Fixed}]}
