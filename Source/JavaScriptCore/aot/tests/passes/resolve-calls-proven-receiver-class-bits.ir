function f18 name="effects-between-the-read-and-the-call" parameters=[{type=L1}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Call v1, -
    v4 = Call v2, v0, v3 calleeKey="run"
    Return v4
# CHECK-NOT: AreMembersUnchanged
# CHECK: [[read18]]: anything = PropGet v0 key="run"
# CHECK: = Call [[read18]], v0, {{*}} calleeKey="run"
}

function f19 name="behind-a-cleared-bit" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = AreMembersUnchanged conditions=[{kind=MemberNotHidden layout=L1 key="run"}]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    v2 = PropGet v0 key="run"
    v3 = Call v2, v0 calleeKey="run"
    Return v3
# CHECK: b2():
# CHECK-NEXT: [[read19]]: anything = PropGet v0 key="run"
# CHECK-NEXT: = Call [[read19]], v0 calleeKey="run"
# CHECK-NEXT: Return
}
