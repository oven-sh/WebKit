layout L2 kind=Instance name="OpenMember" constructor=f6 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed staticNamesAreComplete=true members=[{key="run" function=f7}] namedMembers=[{key="run" function=f7}]}
