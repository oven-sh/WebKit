function f6 name="handlerReadsValueOfPredecessor" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    v2 = Negate v1
    Jump -> next b1()
  b1() handler=b2():
    v3 = Call v0
    Return v3
  b2() role=CatchHandler:
