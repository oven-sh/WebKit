function f7 name="handlerArgumentBecomesValueOfPredecessor" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    v2 = Negate v1
    Jump -> next b1(v2)
  b1(v3):
    v4 = Negate v3
    Jump -> next b2()
  b2() handler=b3(v3):
    v5 = Call v0, -, v4
    Return v5
  b3(v6) role=CatchHandler:
