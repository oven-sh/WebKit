# A covered block merges into a predecessor without a handler in which nothing may throw, and the result takes the handler
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 4
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="predecessorIsEmpty" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function):
    Jump -> next b1()
  b1() handler=b2():
    v1 = Call v0
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
# CHECK-LABEL: function f0 name="predecessorIsEmpty"
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Return v1

function f1 name="predecessorComputesNumbers" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    v2 = Negate v1
    Jump -> next b1()
  b1() handler=b2():
    v3 = Call v0, -, v2
    Return v3
  b2() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
# CHECK-LABEL: function f1 name="predecessorComputesNumbers"
# CHECK: b0(v0: function, v1: number) handler=b2():
# CHECK-NEXT: = Negate v1
# CHECK-NEXT: = Call v0, -, v2
# CHECK-NEXT: Return v3

function f2 name="handlerArgumentIsParameterOfPredecessor" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    v2 = Negate v1
    Jump -> next b1()
  b1() handler=b2(v1):
    v3 = Call v0, -, v2
    Return v3
  b2(v4) role=CatchHandler:
    v5 = CatchValue
    Return v4
}
# CHECK-LABEL: function f2 name="handlerArgumentIsParameterOfPredecessor"
# CHECK: b0(v0: function, v1: number) handler=b2(v1):
# CHECK-NEXT: = Negate v1
# CHECK-NEXT: = Call v0, -, v2
# CHECK-NEXT: Return v3

function f3 name="predecessorCalls" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function):
    v1 = Call v0
    Jump -> next b1()
  b1() handler=b2():
    v2 = Call v0, -, v1
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f3 name="predecessorCalls"
# CHECK: b0(v0: function):
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b2():

function f4 name="handlerArgumentIsValueOfPredecessor" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    v2 = Negate v1
    Jump -> next b1()
  b1() handler=b2(v2):
    v3 = Call v0
    Return v3
  b2(v4) role=CatchHandler:
    v5 = CatchValue
    Return v4
}
# CHECK-LABEL: function f4 name="handlerArgumentIsValueOfPredecessor"
# CHECK: b0(v0: function, v1: number):
# CHECK-NEXT: = Negate v1
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b2(v2):

function f5 name="handlerArgumentIsParameterOfSuccessor" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number):
    Jump -> next b1(v1)
  b1(v2) handler=b2(v2):
    v3 = Call v0
    Return v3
  b2(v4) role=CatchHandler:
    v5 = CatchValue
    Return v4
}
# CHECK-LABEL: function f5 name="handlerArgumentIsParameterOfSuccessor"
# CHECK: b0(v0: function, v1: number):
# CHECK-NEXT: Jump -> next b1(v1)
