# The ramp and the body of a coroutine that is a generic version stay marked as split off one: a call goes on in them only once a test at the entrance has failed, so they are cold and get no type test
# FORM: Prepared
# RUN: pass SplitCoroutines PlaceTypeTests
# STATISTIC: CoroutinesSplit = 2
# STATISTIC: TypeTestsPlaced = 1

module m0 path="main.ts" displayPath="main.ts"
function f0 name="awaitsAndSquares" module=m0 flags=[IsAsync] parameters=[{type=number flags=[IsExpected]}] results=[{type=Promise}] {
  b0(v0: anything ~ number):
    v1 = Await v0 @10
    v2 = Mul v0, v0
    Return v2
}
function f1 name="awaitsAndSquares" module=m0 role=GenericVersion flags=[IsAsync] parameters=[{type=number flags=[IsExpected]}] results=[{type=Promise}] capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f0} creator=Version{provenVersion=f0} {
  b0(v0: anything ~ number):
    v1 = Await v0 @10
    v2 = Mul v0, v0
    Return v2
}

# CHECK-LABEL: function f0 name="awaitsAndSquares"
# CHECK-NOT: IsSplitOffGenericVersion
# CHECK-LABEL: function f1 name="awaitsAndSquares" {{*}}role=CoroutineRamp flags=[{{*}}IsSplitOffGenericVersion
# CHECK-LABEL: function f2 name="awaitsAndSquares" {{*}}role=CoroutineBody
# CHECK: = TypeTest
# CHECK-LABEL: function f3 name="awaitsAndSquares" {{*}}role=CoroutineBody flags=[{{*}}IsSplitOffGenericVersion
# CHECK-NOT: TypeTest
