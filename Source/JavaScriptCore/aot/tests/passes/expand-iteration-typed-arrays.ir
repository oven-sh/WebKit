# CHECK-NEXT: Jump -> next [[protocol2]](v0)
# CHECK: = GetTypedArrayElement v0, {{*}} typedArrayType=6 [keyIsIntegral]
# ABSENT-LABEL: function f2 name="int32ArrayNotProven"

function f3 name="dataView" parameters=[{type=DataView}] results=[{type=anything}] {
