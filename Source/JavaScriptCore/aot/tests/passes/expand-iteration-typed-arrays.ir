# CHECK: b0(v0: Int32Array<number>):
# CHECK-NEXT: [[isPristine2]]: boolean = IsPristine v0 builtinClass=Int32Array aspects=[Names]
# CHECK-NEXT: Branch [[isPristine2]] -> taken [[pristine2]](| 0), notTaken [[changed2]]()
# CHECK: [[protocol2]]([[iterable2]]: Int32Array<number>) frequency=Unlikely:
