# A field of a literal that every object gets where it is made and nothing stores to afterwards gets the type of the one primitive constant that every allocation and every piece of data lists for it, if an access may find it and only the bodies of files make the literal
# FORM: Prepared
# RUN: pass NarrowConstantVariables
# CHECK: outcome: Changed
# CHECK: layout L0 name="oneAllocation" fields=[{key="port" declared={type=80} {{*}}, {key="name" declared={type="x"} {{*}}, {key="nested" declared={type=L1} {{*}}]
# CHECK-NEXT: layout L1 name="sameConstantInTwoPlaces" fields=[{key="deep" declared={type=7} {{*}}]
# CHECK-NEXT: layout L2 name="twoConstants" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L3 name="unknownValue" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L4 name="storedAfterwards" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown initialization=SetAtCreation} {{*}}]
# CHECK-NEXT: layout L5 name="unknownWriters" fields=[{key="port" declared={type=number} flow={location={stores=AtMostOnce initialization=SetAtCreation} {{*}}]
# CHECK-NEXT: layout L6 name="notListedEverywhere" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L7 name="mayBeDeleted" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L8 name="sameConstantInData" fields=[{key="port" declared={type=80} {{*}}]
# CHECK-NEXT: layout L9 name="otherConstantInData" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L10 kind=Instance name="instance" fields=[{key="port" declared={type=number} {{*}}]
# CHECK-NEXT: layout L11 name="fraction" fields=[{key="half" declared={type=number} {{*}}]
# CHECK-NEXT: layout L12 name="nobodyReads" fields=[{key="hidden" declared={type=number} {{*}}]
# CHECK-NEXT: layout L13 name="madeByAFunction" fields=[{key="port" declared={type=number} {{*}}]

module m0 path="/main.ts" displayPath="main.ts" body=f0
module m1 path="/other.ts" displayPath="other.ts" body=f1
entry module=m0
variable g0 name="unknown" module=m1 declared={type=number}
layout L0 name="oneAllocation" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="name" declared={type=string} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="nested" declared={type=L1} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L1 name="sameConstantInTwoPlaces" fields=[{key="deep" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L2 name="twoConstants" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L3 name="unknownValue" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L4 name="storedAfterwards" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L5 name="unknownWriters" fields=[{key="port" declared={type=number} flow={location={stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L6 name="notListedEverywhere" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L7 name="mayBeDeleted" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L8 name="sameConstantInData" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L9 name="otherConstantInData" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L10 kind=Instance name="instance" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L11 name="fraction" fields=[{key="half" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
