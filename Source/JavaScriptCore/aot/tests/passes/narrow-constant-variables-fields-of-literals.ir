layout L13 name="madeByAFunction" fields=[{key="port" declared={type=number} flow={location={writers=AllKnown stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
data d0 root=Object{layout=L8 members=[{key="port" value=Number{value=80}}]} module=m0
data d1 root=Object{layout=L9 members=[{key="port" value=Number{value=81}}]} module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Integer integer=80
    v1 = String string="x"
    v2 = Integer integer=7
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = NewObject -, v0, v1, v3 layout=L0 fields=[0, 1, 2]
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = NewObject -, v0 layout=L4 fields=[0]
    v7 = NewObject -, v0 layout=L5 fields=[0]
    v8 = NewObject -, v0 layout=L6 fields=[0]
    v9 = NewObject -, v0 layout=L7 fields=[0]
    v10 = NewObject -, v0 layout=L8 fields=[0]
    v11 = NewObject -, v0 layout=L9 fields=[0]
    v12 = NewObject -, v0 layout=L10 fields=[0]
    v13 = Double number=1.5
    v14 = NewObject -, v13 layout=L11 fields=[0]
    v15 = NewObject -, v0 layout=L12 fields=[0]
    v16 = PropGet v4 key="port"
    v17 = PropGet v4 key="name"
    v18 = PropGet v4 key="nested"
    v19 = PropGet v3 key="deep"
    v20 = PropGet v5 key="port"
    v21 = PropGet v6 key="port"
    v22 = PropGet v7 key="port"
    v23 = PropGet v8 key="port"
    v24 = PropGet v9 key="port"
    v25 = PropGet v10 key="port"
    v26 = PropGet v11 key="port"
    v27 = PropGet v12 key="port"
    v28 = PropGet v14 key="half"
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=7
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = Integer integer=81
    v4 = NewObject -, v3 layout=L2 fields=[0]
    v5 = NewObject -, v0 layout=L3 fields=[0]
    v6 = NewObject layout=L6
    v7 = PropGet v5 key="port"
    Return
}
function f2 name="makes" module=m0 results=[{type=anything}] {
    v0 = Integer integer=80
    v1 = NewObject -, v0 layout=L13 fields=[0]
    v2 = PropGet v1 key="port"
    Return
}
