    v2 = Integer
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b6()
  b2():
    v7 = TypeTest v1 testedType=undefined|null
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    v8 = Integer
    Jump -> next b5(v8)
  b4():
    v9 = Integer integer=1
    v10 = Add v4, v9
    Jump -> next b5(v10)
  b5(v11):
    v12 = Add v3, v11
    v13 = Increment v4
    Jump -> next b1(v12, v13)
  b6():
    Return v3
# CHECK: LoopHint
# CHECK: v7: boolean = TypeTest v1 testedType=undefined|null
}

