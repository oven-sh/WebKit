# for (let i = 0; i < n; i++) sum += callback == null ? 0 : i + 1: the test of `callback` comes out the same in every round, and both answers occur among the calls.
# In front of the loop it would send the calls on which it fails through the copy of the failed tests, where nothing else is tested either: `i < n` would compare doubles there.
# So the test stays in the loop for as long as `n` is not tested. Once nothing else in the loop asks for a test, one test in front decides for all the rounds, and the copy runs as often as the loop.
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"

