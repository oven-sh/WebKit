# Below an edge of a branch its condition is a constant
# FORM: Prepared
# RUN: pass PropagateBranchConditions
# STATISTIC: PropagateBranchConditionsChanges = 5

module m0 path="main.js" displayPath="main.js"
function f0 name="branchedOnAgainOnTrueEdge" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Branch v0 -> taken b3(), notTaken b4()
  b2():
    Return v1
  b3():
    Return v1
  b4():
    Return v2
# CHECK: b1():
# CHECK-NEXT: [[T0]]:{{*}}= Boolean boolean=true
# CHECK-NEXT: Branch [[T0]] -> taken b3(), notTaken b4()
}

function f1 name="branchedOnAgainOnFalseEdge" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Return v1
  b2():
    Branch v0 -> taken b3(), notTaken b4()
  b3():
    Return v1
  b4():
    Return v2
# CHECK: b2():
# CHECK-NEXT: [[T1]]: false = Boolean
# CHECK-NEXT: Branch [[T1]] -> taken b3(), notTaken b4()
}

function f2 name="useTwoBlocksBelow" parameters=[{type=boolean}] results=[{type=boolean}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    Return v0
  b3():
    Return v0
# CHECK: b1():
# CHECK-NEXT: [[T2]]:{{*}}= Boolean boolean=true
# CHECK: b2():
# CHECK-NEXT: [[T3]]: false = Boolean
# CHECK-NEXT: Return [[T3]]
# CHECK: b3():
# CHECK-NEXT: Return [[T2]]
}

function f3 name="edgeArgument" parameters=[{type=boolean}] results=[{type=boolean}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v0)
  b3(v1):
    Return v1
# CHECK: b1():
# CHECK-NEXT: [[T4]]:{{*}}= Boolean boolean=true
# CHECK-NEXT: Jump -> next b3([[T4]])
# CHECK: b2():
# CHECK-NEXT: [[T5]]: false = Boolean
# CHECK-NEXT: Jump -> next b3([[T5]])
}

function f4 name="successorWithTwoIncomingEdges" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b2(), notTaken b1()
  b1():
    Jump -> next b2()
  b2():
    Branch v0 -> taken b3(), notTaken b4()
  b3():
    Return v1
  b4():
    Return v2
# CHECK-NOT: = Boolean
# CHECK: Branch v0 -> taken b3(), notTaken b4()
}

function f5 name="useBelowEdgeWithProof" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return v1
  b2():
    Return v0
# CHECK: Branch v1 -> taken b1(| 0), notTaken b2()
# CHECK: b1(v2: number):
# CHECK-NEXT: [[T6]]:{{*}}= Boolean boolean=true
# CHECK-NEXT: Return [[T6]]
}

function f6 name="branchWithProofBelowFalseEdge" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Branch v1 -> taken b3(| 0), notTaken b4()
  b3(v2):
    Return v2
  b4():
    Return v0
# CHECK-NOT: = Boolean
# CHECK: b2():
# CHECK-NEXT: Branch v1 -> taken b3(| 0), notTaken b4()
}

function f7 name="branchWithProofBelowTrueEdge" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Branch v1 -> taken b3(| 0), notTaken b4()
  b2():
    Return v0
  b3(v2):
    Return v2
  b4():
    Return v0
# CHECK-NOT: = Boolean
# CHECK: b1():
# CHECK-NEXT: Branch v1 -> taken b3(| 0), notTaken b4()
}
