# The likely path calls a function in every turn, so the test of the list may get another answer in the next turn: nothing is won by a copy, and the loop stays as it is
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 0

module m0 path="main.js" displayPath="main.js"
function f0 name="lastOf" parameters=[{type=Array}, {type=int[0, 100]}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Undefined
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(| 0), notTaken b6()
  b2(v9):
    v10 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    Branch v10 -> taken b3(| 0), notTaken b4()
  b3(v11):
    v12 = GetArrayElement v0, v9, v11 level=Expected [keyIsIntegral]
    Jump -> next b5(v12)
  b4() frequency=Unlikely:
    v13 = ElemGet v0, v9 [keyIsIntegral]
    Jump -> next b5(v13)
  b5(v14):
    v15 = Call v2, v4, v14
    v16 = Increment v9
    Jump -> next b1(v16, v15)
  b6():
    Return v6
# CHECK: Branch v10 -> taken b3(| 0), notTaken b4()
# CHECK: b4() frequency=Unlikely:
# CHECK-NEXT: v13: anything = ElemGet v0, v9 [keyIsIntegral]
# CHECK-NEXT: Jump -> next b5(v13)
}
