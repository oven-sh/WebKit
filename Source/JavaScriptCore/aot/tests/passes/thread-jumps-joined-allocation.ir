# `B.prototype = Object.create(A.prototype); .. new B(i).area()`: where the guard of B.prototype fails the object is made with the prototype that is found, and joined with the object of the likely way,
# which is then made in every turn. The join ends in the next test of that class. It asks about no value and its failing side relies on nothing, so the unlikely way gets the block for itself and goes on there.
# FORM: Prepared
# RUN: function-passes ThreadJumps RemoveTrivialParameters

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="B" constructor=f0 fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}] flags=[IsConstructorFunction] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed}
layout L1 kind=Instance name="C" constructor=f1 fields=[{key="a" declared={type=anything}}] flags=[IsConstructorFunction] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed}
function f0 name="B" flags=[HasThis] thisType={type=L0} results=[{type=undefined}] {
    Return
}
function f1 name="C" flags=[HasThis] thisType={type=L1} results=[{type=undefined}] {
    Return
}
function f2 name="the-join-ends-in-a-test-of-the-class" parameters=[{type=i32}, {type=object}] results=[{type=anything}] {
    v2 = AreMembersUnchanged conditions=[{layout=L0 side=Static key="prototype"}]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v3)
  b2() frequency=Unlikely:
    v4 = NewObject v1, v0 layout=L0 fields=[0]
    Jump -> next b3(v4)
  b3(v5: L0):
    PropSet v5, v0 key="b" mode=Sloppy
    v7 = AreMembersUnchanged conditions=[{layout=L0 key="area"}]
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    v8 = PropGet v5 key="a"
    Return v8
  b5() frequency=Unlikely:
    v9 = PropGet v5 key="area"
    Return v9
# CHECK: b1():
# CHECK-NEXT: v3: L0 = NewObject -, v0
# CHECK-NEXT: Jump -> next b3()
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: v4: L0 = NewObject v1, v0
# CHECK-NEXT: Jump -> next [[copy]](
# CHECK: b3():
# CHECK-NEXT: PropSet v3, v0 key="b"
# CHECK: b4():
# CHECK-NEXT: PropGet v3 key="a"
# CHECK: [[copy]]({{*}}) frequency=Unlikely:
# CHECK-NEXT: PropSet {{*}}, v0 key="b"
# CHECK: Jump -> next b5(
}
function f3 name="the-join-ends-in-a-test-of-another-class" parameters=[{type=i32}, {type=object}] results=[{type=anything}] {
    v2 = AreMembersUnchanged conditions=[{layout=L0 side=Static key="prototype"}]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v3)
  b2() frequency=Unlikely:
    v4 = NewObject v1, v0 layout=L0 fields=[0]
    Jump -> next b3(v4)
  b3(v5: L0):
    v6 = AreMembersUnchanged conditions=[{layout=L1 side=Static key="prototype"}]
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    v7 = PropGet v5 key="a"
    Return v7
  b5() frequency=Unlikely:
    v8 = PropGet v5 key="area"
    Return v8
# CHECK: Jump -> next b3(v3)
# CHECK: Jump -> next b3(v4)
# CHECK: b3(v5: L0):
}
function f4 name="both-ways-are-likely" parameters=[{type=i32}, {type=object}] results=[{type=anything}] {
    v2 = AreMembersUnchanged conditions=[{layout=L0 side=Static key="prototype"}]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v3)
  b2():
    v4 = NewObject v1, v0 layout=L0 fields=[0]
    Jump -> next b3(v4)
  b3(v5: L0):
    v6 = AreMembersUnchanged conditions=[{layout=L0 key="area"}]
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    v7 = PropGet v5 key="a"
    Return v7
  b5() frequency=Unlikely:
    v8 = PropGet v5 key="area"
    Return v8
# CHECK: Jump -> next b3(v3)
# CHECK: Jump -> next b3(v4)
# CHECK: b3(v5: L0):
}
