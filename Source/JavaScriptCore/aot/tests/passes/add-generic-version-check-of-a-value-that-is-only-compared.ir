# `node === cursor.current`: beside an object, undefined or null the bits are compared whatever the other side holds. The check of a value that is used for nothing else buys a test
# and a copy of the code behind it for nothing: it goes. It stays where the other side may be a number or a string, where that side is itself only known by a check, and where something else uses the value
# FORM: Prepared
# OPTIONS: heat=NothingIsHottest
# RUN: pass AddGenericVersion

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="next" declared={type=anything}}]

function f0 name="comparedWithAnObject" parameters=[{type=null|L0}, {type=anything}] results=[{type=boolean}] {
  b0(v0: null|L0, v1: anything):
    v2 = PropGet v1 key="current"
    v3 = Check v2 castType=null|L0
    v4 = StrictEq v0, v3
    Return v4
}
# CHECK-LABEL: function f0 name="comparedWithAnObject"
# CHECK-NOT: TypeTest
# CHECK: = StrictEq v0,
# CHECK-NOT: TypeTest

function f1 name="comparedWithWhatMayBeANumber" parameters=[{type=number|L0}, {type=anything}] results=[{type=boolean}] {
  b0(v0: number|L0, v1: anything):
    v2 = PropGet v1 key="current"
    v3 = Check v2 castType=null|L0
    v4 = StrictEq v0, v3
    Return v4
}
# CHECK-LABEL: function f1 name="comparedWithWhatMayBeANumber"
# CHECK: = TypeTest v2 testedType=null|L0

function f2 name="bothSidesChecked" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="current"
    v3 = Check v2 castType=null|L0
    v4 = PropGet v1 key="current"
    v5 = Check v4 castType=null|L0
    v6 = StrictEq v3, v5
    Return v6
}
# CHECK-LABEL: function f2 name="bothSidesChecked"
# CHECK: = TypeTest v2 testedType=null|L0
# CHECK: = TypeTest v4 testedType=null|L0

function f3 name="alsoRead" parameters=[{type=null|L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: null|L0, v1: anything):
    v2 = PropGet v1 key="current"
    v3 = Check v2 castType=L0
    v4 = StrictEq v0, v3
    v5 = PropGet v3 key="next"
    Return v5
}
# CHECK-LABEL: function f3 name="alsoRead"
# CHECK: = TypeTest v2 testedType=L0
