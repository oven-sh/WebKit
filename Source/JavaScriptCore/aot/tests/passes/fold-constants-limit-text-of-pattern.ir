# A text that does nothing but become the pattern of a RegExp is folded past the limit for folded strings: the literal that the call becomes spells it once
# FORM: Prepared
# OPTIONS: limit=MaxFoldedStringBytes:8
# RUN: pass FoldConstants
# LOSS: MaxFoldedStringBytes x2 f2 v2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="patternOnly" results=[{type=RegExp}] {
    v0 = String string="abcde"
    v1 = String string="fghij"
    v2 = Add v0, v1
    v3 = CallBuiltin -, v2 overload=RegExp/4
    Return v3
# CHECK: v2: "abcdefghij" = String string="abcdefghij"
}

function f1 name="partOfTextThatIsPatternOnly" results=[{type=RegExp}] {
    v0 = String string="abcde"
    v1 = String string="fghij"
    v2 = Add v0, v1
    v3 = String string="k"
    v4 = Strcat v2, v3
    v5 = CallBuiltin -, v4 overload=RegExp/4
    Return v5
# CHECK: v2: "abcdefghij" = String string="abcdefghij"
# CHECK: v4: "abcdefghijk" = String string="abcdefghijk"
}

function f2 name="usedOtherwiseToo" results=[{type=string}] {
    v0 = String string="abcde"
    v1 = String string="fghij"
    v2 = Add v0, v1
    v3 = CallBuiltin -, v2 overload=RegExp/4
    v4 = Add v1, v0
    v5 = String string="a"
    v6 = CallBuiltin -, v5, v4 overload=RegExp/4
    Return v2
# CHECK: v2: string = Add v0, v1
# CHECK: v4: string = Add v1, v0
}
