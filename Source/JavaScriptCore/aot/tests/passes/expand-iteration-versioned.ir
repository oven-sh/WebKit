# A small region in which an iteration is live is copied once per form, and each copy is expanded for one form
# FORM: Prepared optimizing
# OPTIONS: limit=MaxVersionedIterationBytes:200
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(LEFT): pass ExpandIteration
# LOSS: MaxVersionedIterationBytes x1 f3
# STATISTIC: IterationsExpandedByClass = 5

module m0 path="main.js" displayPath="main.js"

function f0 name="smallLoop" parameters=[{type=undefined|null|Array<number>}, {type=anything}] results=[{type=anything}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b7(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b6():
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b4(), notTaken b1()
  b4():
    IteratorClose v2
    Jump -> next b5()
  b5():
    Return v7
  b6() role=IterationCleanup subject=v2:
    v10 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v10
  b7():
    Return v1
# The array copy is the text as written, without its handler. The protocol copy is unlikely and keeps the landing block.
# CHECK: b1({{*}}: int[0, 9007199254740991]):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = PropGet [[array0]] key="length"
# CHECK: b3():
# CHECK-NEXT: v7: anything = Call v1, -, v6
# CHECK: b5([[result0]]: anything):
# CHECK-NEXT: Return [[result0]]
# CHECK-NEXT: b6():
# CHECK-NEXT: Unreachable
# CHECK: Jump -> next [[header0]]()
# CHECK-NEXT: [[header0]]() frequency=Unlikely:
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = CallDirect [[iterator0]], [[next0]] function={{*}} [isNeverInlined]
# CHECK: [[body0]]() frequency=Unlikely handler=[[landing0]]():
# CHECK-NEXT: [[called0]]: anything = Call v1, -, [[value0]]
# CHECK: = CallDirect [[iterator0]] function=[[closeIterator]] [isNeverInlined]
# CHECK: [[landing0]]() role=CleanupHandler frequency=Unlikely:
# CHECK-NEXT: [[exception0]]: exception = CatchException
# CHECK-NEXT: = CallDirect [[iterator0]] function=[[closeIteratorAfterThrow]] [isNeverInlined]
# CHECK: [[open0]]: undefined = CallDirect {{*}} function=[[openIterator]] [isNeverInlined]
# CHECK-NEXT: [[iterator0]]: object = ResultAt [[open0]]
# CHECK-NEXT: [[next0]]: anything = ResultAt [[open0]] index=1
# CHECK: Rethrow [[exception0]]
# CHECK: Jump -> next b5([[called0]])
# CHECK: Jump -> next b5(v7)
# ABSENT-NOT: ) handler=
# ABSENT-NOT: role=IterationCleanup
# ABSENT-NOT: role=CleanupHandler:
# ABSENT-NOT: role=CleanupHandler handler=
# ABSENT-NOT: subject=
# ABSENT-NOT: Switch
# ABSENT-NOT: Unspecified
# ABSENT-COUNT-2: = Call v1, -,
# ABSENT-NOT: = Call v1, -,
}

function f1 name="pattern" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b4():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = IteratorResume v1 stepIndex=1
    v5 = ResultAt v4 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    Jump -> next b3()
  b3():
    v7 = Add v3, v5
    Return v7
  b4() role=IterationCleanup subject=v1:
    v8 = CatchException
    IteratorClose v1 completion=Throw
    Rethrow v8
# CHECK: b3([[first1]]: anything, [[second1]]: anything):
# CHECK-NEXT: = Add [[first1]], [[second1]]
# ABSENT-NOT: ) handler=
# ABSENT-NOT: Switch
# ABSENT-COUNT-2: = ElemGet
# ABSENT-NOT: = ElemGet
}

function f2 name="codeAfterPattern" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b3():
    v3 = IteratorResume v2 stepIndex=0
    v4 = ResultAt v3 index=1
    v5 = IteratorResume v2 stepIndex=1
    v6 = ResultAt v5 index=1
    Jump -> next b2()
  b2():
    IteratorClose v2
    v8 = Call v1, -, v4
    v9 = Call v1, -, v6
    v10 = Call v1, -, v8, v9
    v11 = Call v1, -, v10, v4
    v12 = Call v1, -, v11, v6
    v13 = Call v1, -, v12, v8
    Return v13
  b3() role=IterationCleanup subject=v2:
    v14 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v14
# What follows the last close in its block belongs to no copy and does not count for the limit.
# CHECK: b0(v0: anything, v1: anything):
# CHECK: [[shared2]]([[first2]]: anything, [[second2]]: anything):
# CHECK-NEXT: v8: anything = Call v1, -, [[first2]]
# CHECK-NEXT: v9: anything = Call v1, -, [[second2]]
# CHECK: Return v13
# CHECK: [[read2]]: undefined = DestructureIterable {{*}} count=2
# CHECK: Jump -> next [[shared2]](
# CHECK: Jump -> next [[shared2]](
# ABSENT-NOT: Switch
# ABSENT-COUNT-1: = ElemGet
# ABSENT-COUNT-6: = Call v1, -,
# ABSENT-NOT: = Call v1, -,
# ABSENT-COUNT-1: = ElemGet
# ABSENT-NOT: = ElemGet
}

function f3 name="codeBeforeClose" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b3():
    v3 = IteratorResume v2 stepIndex=0
    v4 = ResultAt v3 index=1
    v5 = IteratorResume v2 stepIndex=1
    v6 = ResultAt v5 index=1
    v7 = Call v1, -, v4
    v8 = Call v1, -, v6
    v9 = Call v1, -, v7, v8
    v10 = Call v1, -, v9, v4
    v11 = Call v1, -, v10, v6
    v12 = Call v1, -, v11, v7
    Jump -> next b2()
  b2():
    IteratorClose v2
    Return v12
  b3() role=IterationCleanup subject=v2:
    v14 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v14
# The same calls in front of the close are in the region: it has one copy, and each operation asks for the form.
# CHECK: Switch
# ABSENT-COUNT-6: = Call v1, -,
# ABSENT-NOT: = Call v1, -,
}

function f4 name="coroutine" role=CoroutineRamp flags=[IsAsync] parameters=[{type=undefined|null|Array<number>}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=1}
# CHECK-LABEL: function f4 name="coroutine"
# ABSENT-LABEL: function f4 name="coroutine"

function f5 name="coroutine" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|null|Array<number>}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f4} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=1} {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b5(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b4():
    v7 = AwaitBySavingFrame v6, v1
    Jump -> next b1()
  b4() role=IterationCleanup subject=v2:
    v8 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v8
  b5():
    v10 = Undefined
    v11 = ReturnAsyncResult v1, v10
    Return v11
# A region with a suspension is copied like any other: a loop in an async function gets the array copy as well.
# CHECK: b3():
# CHECK-NEXT: v7: anything = AwaitBySavingFrame v6, v1
# CHECK: frequency=Unlikely handler=[[landing5]]():
# CHECK-NEXT: = AwaitBySavingFrame {{*}}, v1
# CHECK: [[landing5]]() role=CleanupHandler frequency=Unlikely:
# ABSENT-NOT: Switch
# ABSENT-NOT: ) handler=
# ABSENT-COUNT-2: = AwaitBySavingFrame
# ABSENT-NOT: = AwaitBySavingFrame
}

# LEFT-NOT: IteratorOpen
# LEFT-NOT: IteratorResume
# LEFT-NOT: IteratorClose v
# LEFT-NOT: AppendSpread
