# An element read from an arguments object with proven contents keeps its type when the object goes away and the read goes to a parameter or to the rest list
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="Options"

function f0 name="keyBesideParameters" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=L0}, {type=i32}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: L0, v2: i32, v3: Array):
    v4 = CreateUnmappedArguments v0, v3, v1, v2
    v5 = AssumeType v4 provenType=Arguments<undefined|i32|L0, proven>
    v6 = ElemGet v5, v2
    Return v6
# CHECK-NOT: CreateUnmappedArguments
# CHECK: Switch v2 cases=[0, 1]
# CHECK: anything = ElemGet v3,
# CHECK: undefined|i32|L0 = AssumeType {{*}} provenType=undefined|i32|L0
}

function f1 name="surplusArgument" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: L0, v2: Array):
    v3 = CreateUnmappedArguments v0, v2, v1
    v4 = AssumeType v3 provenType=Arguments<undefined|L0, proven>
    v5 = Integer integer=2
    v6 = ElemGet v4, v5
    Return v6
# CHECK-NOT: CreateUnmappedArguments
# CHECK: [[element1]]: anything = ElemGet v2,
# CHECK-NEXT: undefined|L0 = AssumeType [[element1]] provenType=undefined|L0
}

function f2 name="objectIsStored" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=L0}, {type=i32}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: L0, v2: i32, v3: Array):
    v4 = CreateUnmappedArguments v0, v3, v1, v2
    v5 = AssumeType v4 provenType=Arguments<undefined|i32|L0, proven>
    v6 = ElemGet v5, v2
    Return v5
# CHECK: v4: Arguments = CreateUnmappedArguments v0, v3, v1, v2
}
