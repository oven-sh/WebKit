# In a stack trace the call of an outlined body stands for every operation of its site, so a site holds operations of one inline frame only
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="inlined" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f1 name="runInOneFrame" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] inlineFrames=[{}, {callee=f0 callPosition=5 module=m0}] {
  b0(v0: number, v1: anything, v2: anything):
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
  b1() frequency=Rare:
    v3 = Call v1, -, v2, v2, v2, v2 @9:1
    v4 = Add v3, v2 form=Generic @9:1
    Return v4
  b2() frequency=Rare:
    v5 = Call v1, -, v2, v2, v2, v2 @9:1
    v6 = Add v5, v2 form=Generic @9:1
    Return v6
  b3() frequency=Rare:
    v7 = Call v1, -, v2, v2, v2, v2 @9:1
    v8 = Add v7, v2 form=Generic @9:1
    Return v8
  b4() frequency=Rare:
    v9 = Call v1, -, v2, v2, v2, v2 @9:1
    v10 = Add v9, v2 form=Generic @9:1
    Return v10
  b5() frequency=Rare:
    v11 = Call v1, -, v2, v2, v2, v2 @9:1
    v12 = Add v11, v2 form=Generic @9:1
    Return v12
  b6() frequency=Rare:
    v13 = Call v1, -, v2, v2, v2, v2 @9:1
    v14 = Add v13, v2 form=Generic @9:1
    Return v14
  b7():
    Return v2
}
# CHECK-LABEL: function f1 name="runInOneFrame"
# CHECK-NOT: = Call v1
# CHECK-NOT: = Add
# CHECK: b1() frequency=Rare:
# CHECK-NEXT: [[whole1]]:{{*}}= CallDirect v1, v2 function=[[wholeRun]] @9:1
# CHECK-NEXT: Return [[whole1]]
# CHECK-NOT: = Call v1
# CHECK-NOT: = Add

