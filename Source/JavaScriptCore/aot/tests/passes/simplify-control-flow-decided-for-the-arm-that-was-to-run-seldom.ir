# RUN: pass SimplifyControlFlow

module m0 path="main.js" displayPath="main.js"
function f0 name="callee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f1 name="alwaysTheOtherArm" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string, v1: boolean):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() frequency=Unlikely:
    v3 = CallDirect v0 function=f0
