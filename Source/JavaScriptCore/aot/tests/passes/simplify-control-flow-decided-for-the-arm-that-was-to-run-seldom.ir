# A test that is decided against what was expected: the arm that was to run seldom, and what only that arm leads to, runs as often as the test. What is rarer still inside it stays so, and so does what other ways lead to, unless all of them are rare.
# FORM: Prepared
# RUN: pass SimplifyControlFlow

module m0 path="main.js" displayPath="main.js"
function f0 name="callee" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f1 name="alwaysTheOtherArm" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() frequency=Unlikely:
    v3 = CallDirect v0 function=f0
    Branch v1 -> taken b3(), notTaken b4()
  b3() frequency=Unlikely:
    v4 = CallDirect v3 function=f0
    Return v4
  b4() frequency=Rare:
    v5 = CallDirect v1 function=f0
    Return v5
# CHECK: b0(v0: string, v1: boolean):
# CHECK: = CallDirect v0 function=f0
# CHECK: b{{*}}():
# CHECK: = CallDirect v3 function=f0
# CHECK: b{{*}}() frequency=Rare:
# CHECK-NOT: frequency=Unlikely
}

function f2 name="armThatAnotherWayLeadsTo" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b3()
  b1():
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3() frequency=Unlikely:
    v3 = CallDirect v0 function=f0
    Return v3
# CHECK: b{{*}}() frequency=Unlikely:
# CHECK: = CallDirect v0 function=f0
}

function f3 name="armThatOnlyARareWayLeadsToAsWell" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b4()
  b1():
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3() frequency=Unlikely:
    v3 = CallDirect v0 function=f0
    Return v3
  b4() frequency=Rare:
    v4 = CallDirect v1 function=f0
    Jump -> next b3()
# CHECK: b3():
# CHECK-NEXT: = CallDirect v0 function=f0
# CHECK: b4() frequency=Rare:
}

function f4 name="armThatAlwaysGoesOnToWhatIsRarerStill" parameters=[{type=string}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b5()
  b1():
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3() frequency=Unlikely:
    v3 = CallDirect v0 function=f0
    Jump -> next b4()
  b4() frequency=Rare:
    v4 = CallDirect v0 function=f0
    Branch v1 -> taken b6(), notTaken b7()
  b5() frequency=Rare:
    v5 = CallDirect v1 function=f0
    Jump -> next b4()
  b6() frequency=Rare:
    Return v4
  b7() frequency=Rare:
    Return v0
# CHECK: b3():
# CHECK: b4():
# CHECK-NEXT: = CallDirect v0 function=f0
# CHECK: b5() frequency=Rare:
# CHECK: b6() frequency=Rare:
# CHECK: b7() frequency=Rare:
}
