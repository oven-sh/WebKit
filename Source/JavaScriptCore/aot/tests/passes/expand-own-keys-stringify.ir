# JSON.stringify writes into a string builder, calls the serializer of each planned layout, and discards the builder for the original call where there is no text. A value that holds no object stays a call: the stub of the call writes a string, a number, a boolean or null for a third of what a builder costs
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 3
# STATISTIC: SerializersCreated = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}, {key="y" declared={type=string}}] flow={constructorOrders=[{fields=[0, 1]}]}
layout L1 name="Other" fields=[{key="z" declared={type=number}}, {key="w" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}

function f0 name="expectedLayout" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: [[builder0]]: stringbuilder = StringBuilderBegin
# CHECK: [[shape0]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[shape0]] -> taken [[call0]](| 0), notTaken
# CHECK: [[done0]](v2: undefined|string):
# CHECK-NEXT: Return v2
# CHECK: [[generic0]]() frequency=Rare:
# CHECK-NEXT: [[original0]]: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Jump -> next [[done0]]([[original0]])
# CHECK: frequency=Rare:
# CHECK-NEXT: StringBuilderDiscard [[builder0]]
# CHECK-NEXT: Jump -> next [[generic0]]()
# CHECK: [[call0]]({{*}}: guard):
# CHECK-NEXT: [[outcome0]]: int[0, 2] = CallDirect v0, [[builder0]] function=[[serializerOfPoint]]
# CHECK-NEXT: Switch [[outcome0]] cases=[1] -> case
# CHECK: [[text0]]: string = StringBuilderFinish [[builder0]]
# CHECK-NEXT: Jump -> next [[done0]]([[text0]])
}

function f1 name="number" parameters=[{type=number}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: number):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f2 name="string" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: string):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f3 name="nullOrNumber" parameters=[{type=null|number}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: null|number):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f4 name="undefinedOrNumber" parameters=[{type=undefined|number}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: undefined|number):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f5 name="arrayOfLayout" parameters=[{type=Array<object>}] results=[{type=anything}] {
  b0(v0: Array<object> ~ Array<L0>):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: [[builder5]]: stringbuilder = StringBuilderBegin
# CHECK: = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
# CHECK: = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK: StringBuilderDiscard [[builder5]]
# CHECK: = JSONAppendToken [[builder5]], {{*}} jsonToken=OpenArray
# CHECK: LoopHint
# CHECK: = ShapeTest [[element5]] layouts=[L0]
# CHECK: = CallDirect [[element5]], [[builder5]] function=[[serializerOfPoint]]
# CHECK: = JSONAppendToken [[builder5]], {{*}} jsonToken=CloseArray
# CHECK: = StringBuilderFinish [[builder5]]
}

function f6 name="unionOfTwoLayouts" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0|L1):
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: [[builder6]]: stringbuilder = StringBuilderBegin
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK: = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK: StringBuilderDiscard [[builder6]]
# CHECK: = ShapeTest v0 layouts=[L1]
# CHECK: = CallDirect v0, [[builder6]] function=[[serializerOfPoint]]
# CHECK: = CallDirect v0, [[builder6]] function=[[serializerOfOther]]
# CHECK: = StringBuilderFinish [[builder6]]
}

function f7 name="oneArgument" parameters=[{type=number}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: number):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f8 name="nothingKnown" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
    Return v2
# CHECK: b0(v0: anything):
# CHECK-NEXT: v1: undefined = Undefined
# CHECK-NEXT: v2: undefined|string = CallBuiltin -, v0, v1, v1 overload=JSONStringify/0
# CHECK-NEXT: Return v2
}

function f9 name="testsOfUnchangedAllocation" parameters=[{type=number}] results=[{type=undefined|null|number}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = HasKeyOrder v1, v1 layout=L1 fields=[0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = HasNoExtraProperties v1, v1
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = AllGuards v1, v3, v5
    v7 = GetSlot v1, v6 key="z" receivers=[L1] level=Expected
    Return v7
  b3():
    Return v0
# CHECK: v1:{{*}}= NewObject -, v0 layout=L1 fields=[0]
# CHECK-NEXT: v2: true = Boolean boolean=true
# CHECK: v4: true = Boolean boolean=true
# CHECK-NOT: HasKeyOrder
# CHECK-NOT: HasNoExtraProperties
}

function f10 name="testOfAnotherOrder" parameters=[{type=number}] results=[{type=undefined|null|number}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = HasKeyOrder v1, v1 layout=L1 fields=[0, 1]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = AllGuards v1, v3
    v5 = GetSlot v1, v4 key="w" receivers=[L1] level=Expected
    Return v5
  b2():
    Return v0
# CHECK: v1:{{*}}= NewObject -, v0 layout=L1 fields=[0]
# CHECK-NEXT: v2: false = Boolean
# CHECK-NOT: HasKeyOrder
}

function f11 name="fieldAddedBetweenAllocationAndTest" parameters=[{type=number}] results=[{type=undefined|null|number}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    PutSlotOrAdd v1, v1, v0 key="w" receivers=[L1] level=Expected
    v3 = HasKeyOrder v1, v1 layout=L1 fields=[0]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = AllGuards v1, v4
    v6 = GetSlot v1, v5 key="z" receivers=[L1] level=Expected
    Return v6
  b2():
    Return v0
# CHECK: PutSlotOrAdd v1, v1, v0 key="w" receivers=[L1] level=Expected
# CHECK-NEXT: v3: boolean = HasKeyOrder v1, v1 layout=L1 fields=[0]
# CHECK-NEXT: Branch v3 -> taken b1(| 0), notTaken b2()
}

function f12 name="allocationPassedToCallBeforeTest" parameters=[{type=number}, {type=anything}] results=[{type=undefined|null|number}] {
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = Call v1, -, v2
    v4 = ShapeTest v2 layouts=[L1]
    Branch v4 -> taken b1(| 0), notTaken b4()
  b1(v5):
    v6 = HasKeyOrder v2, v5 layout=L1 fields=[0]
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7):
    v8 = HasNoExtraProperties v2, v5
    Branch v8 -> taken b3(| 0), notTaken b4()
  b3(v9):
    v10 = AllGuards v5, v7, v9
    v11 = GetSlot v2, v10 key="z" receivers=[L1] level=Expected
    Return v11
  b4():
    Return v0
# CHECK: v6: boolean = HasKeyOrder v2, v5 layout=L1 fields=[0]
# CHECK: v8: boolean = HasNoExtraProperties v2, v5
}

# CHECK-LABEL: role=Serializer
# CHECK-LABEL: role=Serializer
