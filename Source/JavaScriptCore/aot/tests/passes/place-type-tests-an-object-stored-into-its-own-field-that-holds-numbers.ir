# An unknown value is stored into its own field. It is expected to be the one layout that has such a field, and that field holds numbers: no value passes both tests, so the store gets no tests and stays by name
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Table" fields=[{key="self" declared={type=number} flags=[IsRequired]}, {key="n" declared={type=number} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Integer integer=5
    v3 = NewObject -, v2, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    v5 = CallDirect v1 function=f1
    v6 = PropGet v4 key="self"
    v7 = Call v1, -, v5, v6
    Return v7
}
function f1 name="mark" parameters=[{type=anything}] results=[{type=anything}] {
    PropSet v0, v0 key="self"
    Return v0
# CHECK-NOT: = TypeTest
# CHECK: PropSet v0, v0 key="self"
# CHECK-NOT: PutSlot
}
