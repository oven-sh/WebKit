# An unknown value is stored into its own field. It is expected to be the one layout that has such a field, and that field holds numbers: no value passes both tests, so the store behind them stands in a block that nothing enters, with a receiver of type never
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Table" fields=[{key="self" declared={type=number} flags=[IsRequired]}, {key="n" declared={type=number} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Integer integer=5
    v3 = NewObject -, v2, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    v5 = CallDirect v1 function=f1
    v6 = PropGet v4 key="self"
    v7 = Call v1, -, v5, v6
    Return v7
}
function f1 name="mark" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PropSet v0, v0 key="self"
    Return v0
}
# CHECK-LABEL: function f1 name="mark"
# CHECK: = TypeTest v0 testedType=L0
# CHECK: ([[nothing]]: never):
# CHECK-NEXT: PutSlot [[nothing]], -, [[nothing]] key="self" receivers=[L0] level=Expected
# CHECK: PropSet v0, v0 key="self"
# CHECK: ([[table]]: L0):
# CHECK-NEXT: : false = TypeTest [[table]] testedType=int
