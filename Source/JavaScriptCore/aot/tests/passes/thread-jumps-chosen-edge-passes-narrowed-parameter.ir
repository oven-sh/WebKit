# Where the chosen edge passes the narrowed parameter of the merge block the threaded edge passes the constant of the predecessor
# FORM: Prepared
# RUN: pass ThreadJumps
# STATISTIC: ThreadJumpsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="takenEdgeNarrows" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Undefined
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = TypeTest v3 testedType=undefined
    Branch v4 -> taken b4(| 0), notTaken b5(| 0)
  b4(v5):
    Return v5
  b5(v6):
    Return v6
# CHECK: b1():
# CHECK-NEXT: v2: undefined = Undefined
# CHECK-NEXT: Jump -> next b4(v2)
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: Branch v4 -> taken b4(| 0), notTaken b5(| 0)
# CHECK-NEXT: b4(v5: undefined):
}

function f1 name="argumentsComeFirst" parameters=[{type=anything}, {type=boolean}, {type=number}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=7
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v0)
  b3(v4):
    v5 = TypeTest v4 testedType=string
    Branch v5 -> taken b4(), notTaken b5(v2 | 0)
  b4():
    Return v2
  b5(v6, v7):
    v8 = StrictEq v6, v7
    Return v8
# CHECK: b1():
# CHECK-NEXT: v3: 7 = Integer integer=7
# CHECK-NEXT: Jump -> next b5(v2, v3)
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: Branch v5 -> taken b4(), notTaken b5(v2 | 0)
}

function f2 name="edgeNarrowsValueOfMergeBlock" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Undefined
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = Upcast v3 castType=anything
    v5 = TypeTest v4 testedType=undefined
    Branch v5 -> taken b4(| 0), notTaken b5()
  b4(v6):
    Return v6
  b5():
    Return v0
# CHECK: b1():
# CHECK: Jump -> next b3(v2)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v0)
}
