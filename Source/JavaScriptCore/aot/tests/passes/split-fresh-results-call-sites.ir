# A call of a result wrapper becomes a call of the worker where the rebuilt aggregate is then removed or sunk
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitFreshResults VerifyProgram
# STATISTIC: FreshResultsSplit = 2
# STATISTIC: ResultsReturnedInRegisters = 6

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
variable g0 name="last" module=m0 declared={type=anything} initialization=Undefined

function f0 name="point" parameters=[{type=number}] results=[{type=L0}] {
    v1 = Add v0, v0
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
}
# CHECK-LABEL: function f0 name="point" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[pointWorker]] layout=L0} {

function f1 name="maybePoint" parameters=[{type=number}] results=[{type=null|L0}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Return v2
  b2():
    v3 = Null
    Return v3
}
# CHECK-LABEL: function f1 name="maybePoint" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=[[maybeWorker]] nullish=Null layout=L0} {

function f2 name="splitEarlier" role=ResultWrapper parameters=[{type=number}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f11} {
    v1 = CallDirect v0 function=f11
    v2 = ResultAt v1 index=0
    v3 = ResultAt v1 index=1
    v4 = NewArray v2, v3 contents=number
    Return v4
}
# CHECK-LABEL: function f2 name="splitEarlier" module=m0 role=ResultWrapper
# CHECK: creator=ResultWrapper{worker=f11} {

function f3 name="readsTwoFields" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    v2 = PropGet v1 key="x" receivers=[L0]
    v3 = PropGet v1 key="y" receivers=[L0]
    v4 = Add v2, v3
    Return v4
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK: [[call3]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: [[x3]]: number = ResultAt [[call3]]
# CHECK-NEXT: [[y3]]: number = ResultAt [[call3]] index=1
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK: Return
}

function f4 name="storesResult" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    PutModuleVariable v1 variable=g0
    Return v0
# CHECK: b0(
# CHECK-NEXT: v1:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: PutModuleVariable v1 variable=g0
}

function f5 name="oneSiteOfEachKind" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    PutModuleVariable v1 variable=g0
    v3 = CallDirect v0 function=f0
    v4 = PropGet v3 key="y" receivers=[L0]
    Return v4
# CHECK: b0(
# CHECK-NEXT: v1:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: PutModuleVariable v1 variable=g0
# CHECK-NEXT: [[call5]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: = ResultAt [[call5]] index=1
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
}

function f6 name="testsThenReads" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = ToBoolean v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = PropGet v3 key="x" receivers=[L0]
    Return v4
  b2():
    Return v0
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK: [[call6]]:{{*}}= CallDirect v0 function=[[maybeWorker]]
# CHECK-NEXT: [[tag6]]: i32 = ResultAt [[call6]]
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK-NOT: = Null
# CHECK: Return v0
}

function f7 name="storesOnOnePath" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    v2 = ToBoolean v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v1 variable=g0
    Return v0
  b2():
    v4 = PropGet v1 key="x" receivers=[L0]
    Return v4
# CHECK: b0(
# CHECK-NEXT: [[call7]]:{{*}}= CallDirect v0 function=[[pointWorker]]
# CHECK-NEXT: [[x7]]: number = ResultAt [[call7]]
# CHECK-NEXT: [[y7]]: number = ResultAt [[call7]] index=1
# CHECK-NOT: NewObject
# CHECK: b1():
# CHECK-NEXT: [[cell7]]:{{*}}= NewObject -, [[x7]], [[y7]] layout=L0 fields=[0, 1]
# CHECK-NEXT: PutModuleVariable [[cell7]] variable=g0
# CHECK: b2():
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
}

function f8 name="siteMarkedWhenItsCalleeWasTheWholeFunction" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0 [isNeverInlined]
    v2 = PropGet v1 key="x" receivers=[L0]
    Return v2
# CHECK: b0(
# CHECK-NOT: function=f0
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK: Return
}

function f9 name="readsResultSplitEarlier" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f2
    v2 = Integer integer=1
    v3 = ElemGet v1, v2
    Return v3
# CHECK-NOT: NewArray
# CHECK-NOT: ElemGet
# CHECK: [[call9]]:{{*}}= CallDirect v0 function=f11
# CHECK-NEXT: = ResultAt [[call9]] index=1
# CHECK-NOT: NewArray
# CHECK-NOT: ElemGet
}

function f10 name="returnsResultSplitEarlier" flags=[HasRestParameter] parameters=[{type=number}, {type=Array}] results=[{type=anything}] {
    v2 = CallDirect v0 function=f2
    Return v2
# CHECK: b0(
# CHECK-NEXT: v2:{{*}}= CallDirect v0 function=f2
# CHECK-NEXT: Return v2
}

function f11 name="splitEarlier" role=ResultWorker parameters=[{type=number}] results=[{type=number}, {type=number}] derivation={source=f2} creator=ResultWorker{origin=f2} {
    v1 = Add v0, v0
    v2 = Results v0, v1
    Return v2
}
# CHECK-LABEL: function f11 name="splitEarlier" module=m0 role=ResultWorker
# CHECK: function [[pointWorker]] name="point" module=m0 role=ResultWorker
# CHECK: function [[maybeWorker]] name="maybePoint" module=m0 role=ResultWorker
