function f0 name="useInHandler" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object) handler=b1():
    v1 = PropGet v0 key="a"
    Return v1
  b1() role=CatchHandler:
    v2 = CatchValue
    v3 = PropGet v0 key="b"
    v4 = ShapeTest v0 layouts=[L0]
    Return v3
}
