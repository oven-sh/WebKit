    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="b"
    v3 = ShapeTest v0 layouts=[L0]
    Return v2
}
# F1: stretch 0: test ShapeTest v0 layouts=[L0] before v1; uses v1 v2; cloned 4
# F1-NOT: stretch

function f2 name="stretchUnderHandler" parameters=[{type=object predicted=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: number) handler=b2(v1):
    v2 = PropGet v0 key="a"
    Jump -> next b1()
  b1() handler=b2(v1):
    v3 = PropGet v0 key="b"
    Return v3
  b2(v4) role=CatchHandler:
    v5 = CatchValue
    Return v4
}
