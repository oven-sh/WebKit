# A constant that only other blocks use is created in the blocks that use it
# FORM: Prepared
# RUN: pass SinkConstants
# STATISTIC: SinkConstantsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="callback" results=[{type=undefined}] {
  b0():
    v0 = Undefined
    Return v0
}

function f1 name="exclusiveUsers" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything):
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1, -, v2
    Return v3
  b2():
    v4 = Call v1, -, v2, v2
    Return v4
}
# CHECK-LABEL: function f1
# CHECK: b0(
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: [[copyInB1]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[copyInB1]]
# CHECK: b2():
# CHECK-NEXT: [[copyInB2]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[copyInB2]], [[copyInB2]]

function f2 name="oneUserBlock" parameters=[{type=boolean}, {type=string}] results=[{type=string}] {
  b0(v0: boolean, v1: string):
    v2 = String string="cold"
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Strcat v1, v2
    Return v3
  b2():
    Return v1
}
# CHECK-LABEL: function f2
# CHECK: b0(
