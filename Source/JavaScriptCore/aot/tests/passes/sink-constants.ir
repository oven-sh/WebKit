# A constant that only other blocks use is created in the blocks that use it
# FORM: Prepared
# RUN: pass SinkConstants
# STATISTIC: SinkConstantsChanges = 7
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="callback" results=[{type=undefined}] {
  b0():
    v0 = Undefined
    Return v0
}

function f1 name="exclusiveUsers" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything):
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1, -, v2
    Return v3
  b2():
    v4 = Call v1, -, v2, v2
    Return v4
}
# CHECK-LABEL: function f1
# CHECK: b0(
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: [[copyInB1]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[copyInB1]]
# CHECK: b2():
# CHECK-NEXT: [[copyInB2]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[copyInB2]], [[copyInB2]]

function f2 name="oneUserBlock" parameters=[{type=boolean}, {type=string}] results=[{type=string}] {
  b0(v0: boolean, v1: string):
    v2 = String string="cold"
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Strcat v1, v2
    Return v3
  b2():
    Return v1
}
# CHECK-LABEL: function f2
# CHECK: b0(
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: String string="cold"

function f3 name="userInCycle" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v0, -, v1
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    v5 = Undefined
    Return v5
}
# CHECK-LABEL: function f3
# CHECK: b0(
# CHECK-NEXT: = NewClosure
# CHECK: b1(
# CHECK-NOT: NewClosure

function f4 name="blockArgument" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    v1 = NewClosure function=f0
    Branch v0 -> taken b1(v1), notTaken b2()
  b1(v2):
    Return v2
  b2():
    v3 = Undefined
    Return v3
}
# CHECK-LABEL: function f4
# CHECK: b0(
# CHECK-NEXT: Branch v0 -> taken [[edgeOfF4]](), notTaken b2()
# CHECK: [[edgeOfF4]]():
# CHECK-NEXT: [[closure]]: f0 = NewClosure function=f0
# CHECK-NEXT: Jump -> next b1([[closure]])

function f5 name="userReachesOtherUser" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything):
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1, -, v2
    Jump -> next b2()
  b2():
    v4 = Call v1, -, v2
    Return v4
}
# CHECK-LABEL: function f5
# CHECK: b0(
# CHECK-NEXT: = NewClosure
# CHECK: b1(
