function f6 name="usedInOwnBlock" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything):
    v2 = NewClosure function=f0
    v3 = Call v1, -, v2
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v4 = Call v1, -, v2
