function f7 name="stringInTwoBlocks" parameters=[{type=boolean}, {type=string}] results=[{type=string}] {
  b0(v0: boolean, v1: string):
    v2 = String string="both"
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Strcat v1, v2
