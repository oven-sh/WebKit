# An enumerated key that reaches its use through a merge of equal values, an environment field or a variable is still answered from the enumerator
# FORM: Prepared
# RUN: pass EliminateRedundantReads ExpandIteration PlaceTypeTests
# STATISTIC: EnumeratedKeyUsesResolved = 3

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="fixedScope" fields=[{key="k" declared={type=anything} flags=[IsImmutable] flow={location={initialization=StoredBeforeEveryRead}}}]
layout L1 kind=Environment name="scope" fields=[{key="k" declared={type=anything}}]
variable g0 name="key" module=m0 declared={type=anything} initialization=Undefined

function f0 name="mergeOfEqualValues" parameters=[{type=object}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: boolean, v2: anything):
    v3 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = ForInStep v3, v0
    v6 = ResultAt v5 index=0
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b3(), notTaken b2()
  b2():
    Branch v1 -> taken b4(), notTaken b5(v7)
  b3():
    v8 = Undefined
    Return v8
  b4():
    v9 = Call v2
    Jump -> next b5(v7)
  b5(v10):
    v11 = ElemGet v0, v10
    Jump -> next b1()
}
# CHECK-LABEL: function f0 name="mergeOfEqualValues"
# CHECK: [[position0]]: {{*}} = ResultAt v5 index=2
# CHECK: = IsEnumeratorCurrent v3, v0, [[position0]]
# CHECK: = EnumeratorGetByVal v0, v10, v3, [[position0]],

function f1 name="immutableEnvironmentField" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: anything):
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = NewClosure v7 function=f4
    v9 = Call v1, -, v8
    v10 = GetEnvironmentField v7 layout=L0 field=0
    v11 = ElemGet v0, v10
    Jump -> next b1()
  b3():
    v12 = Undefined
    Return v12
}
# CHECK-LABEL: function f1 name="immutableEnvironmentField"
# CHECK: [[position1]]: {{*}} = ResultAt v4 index=2
# CHECK: = IsEnumeratorCurrent v2, v0, [[position1]]
# CHECK: = EnumeratorGetByVal v0, v10, v2, [[position1]],

function f2 name="environmentFieldStoredByCallee" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: anything):
    v2 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v0
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = NewClosure v7 function=f5
    v9 = Call v1, -, v8
    v10 = GetEnvironmentField v7 layout=L1 field=0
    v11 = ElemGet v0, v10
    Jump -> next b1()
  b3():
    v12 = Undefined
    Return v12
}
# CHECK-LABEL: function f2 name="environmentFieldStoredByCallee"
# CHECK-NOT: IsEnumeratorCurrent
# CHECK: v11: anything = ElemGet v0, v10
# CHECK-NOT: IsEnumeratorCurrent

function f3 name="moduleVariable" parameters=[{type=object}] results=[{type=undefined}] {
  b0(v0: object):
    v1 = ForInOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = ForInStep v1, v0
    v4 = ResultAt v3 index=0
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b3(), notTaken b2()
  b2():
    PutModuleVariable v5 variable=g0
    v7 = GetModuleVariable variable=g0
    v8 = ElemHas v0, v7
    Jump -> next b1()
  b3():
    v9 = Undefined
    Return v9
}
# CHECK-LABEL: function f3 name="moduleVariable"
# CHECK: [[position3]]: {{*}} = ResultAt v3 index=2
# CHECK: = IsEnumeratorCurrent v1, v0, [[position3]]
# CHECK: true = Boolean boolean=true

function f4 name="reader" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f5 name="writer" captures=[{type=env L1}] results=[{type=undefined}] {
  b0(v0: env L1):
    v1 = Undefined
    PutEnvironmentField v0, v1 layout=L1 field=0
    Return v1
}
