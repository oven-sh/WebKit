# CHECK-NEXT: v2: anything = Call v1
# CHECK: = YieldBySavingFrame [[started]], {{*}} @30
# CHECK: Switch {{*}} cases=[1, 2] -> case [[throwArm]](), case [[returnArm]](), otherwise [[continuation]]()
# CHECK: [[continuation]]() handler=b1(v1):
