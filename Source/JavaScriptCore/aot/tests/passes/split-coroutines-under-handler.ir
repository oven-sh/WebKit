# The successor of a suspension stands in a block with the handler and the handler arguments of the suspension
# FORM: Prepared
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="awaitsUnderHandler" flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: anything) handler=b2(v0):
    v1 = Await v0 @10
    Jump -> next b1()
  b1():
    v2 = Await v1 @11
    Return v2
  b2(v3) role=CatchHandler:
    v4 = CatchValue
    Return v3
}
function f1 name="yieldsUnderHandler" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    InitialYield @20
    Jump -> next b1()
  b1() handler=b6(v1):
    v3 = Yield v1 @21
    v4 = ResultAt v3 index=0
    v5 = ResultAt v3 index=1
    Switch v5 cases=[1, 2] -> case b2(), case b3(), otherwise b4()
  b2() handler=b6(v1):
    Throw v4
  b3():
    Return v4
  b4():
    v6 = Yield v4 @22
    v7 = ResultAt v6 index=0
    Jump -> next b5()
  b5():
    Return v7
  b6(v8) role=CatchHandler:
    v9 = CatchValue
    Return v8
}
function f2 name="startsUnderHandler" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything) handler=b1(v1):
    v2 = Call v1
    InitialYield @30
    v4 = Call v1
    Return v4
  b1(v5) role=CatchHandler:
    v6 = CatchValue
    Return v5
}

# CHECK-LABEL: function f3 name="awaitsUnderHandler"
# CHECK: b0(v0: anything, [[promise]]: undefined|Promise) handler=b2(v0):
