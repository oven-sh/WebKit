# The call of a tail call stays with its terminator, and a demoted one in the frame of its function: neither is moved into a shared body
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# STATISTIC: ColdSitesOutlined = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="tailCalls" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 1..6
  b%(i)() frequency=Rare:
    v%(i*2+1) = String string="fatal"
    v%(i*2+2) = Call v1, -, v%(i*2+1), v%(i*2+1), v%(i*2+1), v%(i*2+1), v2
    ReturnCall v%(i*2+2)
# END REPEAT
  b7():
    Return v2
}
# CHECK-LABEL: function f0
# CHECK-NOT: CallDirect
# CHECK: [[call]]: anything = Call v1, -,
# CHECK-NEXT: ReturnCall [[call]]
# CHECK-COUNT-5: = Call v1, -,
# CHECK-NOT: CallDirect

function f1 name="returnsResults" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 1..6
  b%(i)() frequency=Rare:
    v%(i*2+1) = String string="fatal"
    v%(i*2+2) = Call v1, -, v%(i*2+1), v%(i*2+1), v%(i*2+1), v%(i*2+1), v2
    Return v%(i*2+2)
# END REPEAT
  b7():
    Return v2
}
# CHECK-LABEL: function f1
# CHECK-NOT: = Call v1
# CHECK-COUNT-6: anything = CallDirect v1, v2 function=f3
# CHECK-NOT: = Call v1

function f2 name="demotedTailCalls" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 1..6
  b%(i)() frequency=Rare:
    v%(i*2+1) = String string="fatal"
    v%(i*2+2) = Call v1, -, v%(i*2+1), v%(i*2+1), v%(i*2+1), v%(i*2+1), v2 @0 tail
    Return v%(i*2+2)
# END REPEAT
  b7():
    Return v2
}
# CHECK-LABEL: function f2
# CHECK-NOT: CallDirect
# CHECK-COUNT-6: = Call v1, -,
# CHECK-NOT: CallDirect

# CHECK-LABEL: function f3 {{*}}role=OutlinedBody
# CHECK: [[result]]: anything = Call v0, -,
# CHECK-NEXT: Return [[result]]
