# Six closures held in an array and called in a loop, over the values or by index: an element may be a hole, so each turn tests for undefined once and then makes one group call
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass
# STATISTIC: GroupEntrypoints = 6
# STATISTIC: GroupCalls = 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = NewArray v0, v1, v2, v3, v4, v5 contents=anything
    v7 = NewClosure function=f7
    v8 = Call v7, -, v6 [isNeverInlined]
    v9 = NewClosure function=f8
    v10 = Call v9, -, v6 [isNeverInlined]
    Return
}
function f1 name="first" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = Add v0, v1
    Return v2
}
function f2 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=2.5
    v2 = Add v0, v1
    Return v2
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=3.5
    v2 = Add v0, v1
    Return v2
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=4.5
    v2 = Add v0, v1
    Return v2
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=5.5
    v2 = Add v0, v1
    Return v2
}
function f6 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=6.5
    v2 = Add v0, v1
    Return v2
}
function f7 name="callEach" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3
    v6 = ResultAt v5
    v7 = ResultAt v5 index=1
    Branch v6 -> taken b4(), notTaken b2()
  b2() handler=b3():
    v8 = Double number=1.5
    v9 = Call v7, -, v8 calleeName="listener"
    v10 = Call v2, -, v9
    Jump -> next b1()
  b3() role=IterationCleanup subject=v3:
    v11 = CatchException
    IteratorClose v3 completion=Throw
    Rethrow v11
  b4():
    Return
}
# CHECK-LABEL: function f7 name="callEach"
# CHECK: ([[element]]: undefined|f1|f2|f3|f4|f5|f6 ~ f1|f2|f3|f4|f5|f6):
# CHECK: [[isHole]]: boolean ~ false = TypeTest [[element]] testedType=undefined
# CHECK-NEXT: Branch [[isHole]] -> taken [[throws]](| 0), notTaken [[calls]](| 0)
# CHECK-NOT: TypeTest
# CHECK: [[throws]]([[hole]]: undefined) frequency=Rare:
# CHECK: = Call [[hole]], -, {{*}} calleeName="listener"
# CHECK-NEXT: Unreachable
# CHECK-NOT: TypeTest
# CHECK: [[calls]]([[listener]]: f1|f2|f3|f4|f5|f6):
# CHECK: : number = CallGroup [[listener]], {{*}} function=
# CHECK-NOT: TypeTest
function f8 name="callByIndex" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4: anything):
    LoopHint
    v6 = PropGet v0 key="length"
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v4
    v9 = Double number=1.5
    v10 = Call v8, -, v9
    v11 = Call v2, -, v10
    v12 = Integer integer=1
    v13 = Add v4, v12
    Jump -> next b1(v13)
  b3():
    Return
}
# CHECK-LABEL: function f8 name="callByIndex"
# CHECK: [[isHoleAtIndex]]: boolean = TypeTest {{*}} testedType=undefined
# CHECK-NOT: TypeTest
# CHECK: ([[holeAtIndex]]: undefined) frequency=Rare:
# CHECK: = Call [[holeAtIndex]], -,
# CHECK-NEXT: Unreachable
# CHECK-NOT: TypeTest
# CHECK: ([[listenerAtIndex]]: f1|f2|f3|f4|f5|f6):
# CHECK: : number = CallGroup [[listenerAtIndex]], {{*}} function=
# CHECK-NOT: TypeTest
# CHECK-LABEL: function f9
