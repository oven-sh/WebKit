# A test for a class lets a built-in object that the tested type does not name pass as any member of the class, so what it proves is not inside the type of the variable. Such a test stays in the loop.
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="value" declared={type=builtin(MathMax)|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]>}}, {key="plain" declared={type=undefined|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]>}}]

function f0 name="builtinObjectOrRegExp" parameters=[{type=env L0}, {type=anything}, {type=i32}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: i32):
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = GetEnvironmentField v0 layout=L0 field=0
    v7 = TypeTest v6 testedType=RegExp
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    Jump -> next b4()
  b3() frequency=Unlikely:
    v9 = Call v1, -
    Jump -> next b4()
  b4():
    v10 = Increment v4
    v11 = Less v10, v2
    Branch v11 -> taken b1(v10), notTaken b5()
  b5():
    v12 = Undefined
    Return v12
# CHECK: b1(v4: int|whole, [[carried0]]: builtin(MathMax)|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]>):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: v6: builtin(MathMax)|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]> = Upcast [[carried0]]
# CHECK-NEXT: v7: boolean = TypeTest v6 testedType=RegExp
# CHECK: Branch v11 -> taken b1(v10, [[carried0]]), notTaken b5()
# CHECK: ({{*}}: int|whole ~ 1):
# CHECK-NEXT: [[entering0]]: builtin(MathMax)|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]> = GetEnvironmentField v0 layout=L0
# CHECK-NEXT: Jump -> next b1({{*}}, [[entering0]])
}

# What this test proves is inside the type of the variable: it stands on the way into the loop
function f1 name="undefinedOrRegExp" parameters=[{type=env L0}, {type=anything}, {type=i32}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: i32):
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = GetEnvironmentField v0 layout=L0 field=1
    v7 = TypeTest v6 testedType=RegExp
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    Jump -> next b4()
  b3() frequency=Unlikely:
    v9 = Call v1, -
    Jump -> next b4()
  b4():
    v10 = Increment v4
    v11 = Less v10, v2
    Branch v11 -> taken b1(v10), notTaken b5()
  b5():
    v12 = Undefined
    Return v12
# CHECK: b6(v15: int|whole):
# CHECK-NEXT: v16: undefined|RegExp<"a"[Global], pristine[Storage, Names, AsCreated]> = GetEnvironmentField v0 layout=L0 field=1
# CHECK: v17: boolean = TypeTest v16 testedType=RegExp
# CHECK: b8(v18: RegExp<"a"[Global], pristine[Storage, Names, AsCreated]>):
# CHECK-NEXT: Jump -> next b9(v15, v18)
# CHECK-NEXT: b9(v19: int|whole, v20: RegExp<"a"[Global], pristine[Storage, Names, AsCreated]>):
# CHECK-NEXT: LoopHint
}
