# That a variable has been stored holds where a function that reads it is entered. In the body of that function a read names nothing. The copy of the body in a caller begins with a fact, and the read names it: whoever
# moves the read, or what looks at the value, stays behind where the call stood. A variable that has been stored before every caller is entered needs none
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls VerifyProgram

module m0 path="main.js" displayPath="main.js"
variable g0 name="text" declared={type=string} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
variable g1 name="storedOnce" declared={type=string} flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}

function f0 name="reads" results=[{type=number}] {
    v0 = GetModuleVariable variable=g0
    v1 = GetStringLength v0
    Return v1
}
function f1 name="readsWhatWasStoredBeforeCallers" results=[{type=number}] {
    v0 = GetModuleVariable variable=g1
    v1 = GetStringLength v0
    Return v1
}
function f2 name="calls" parameters=[{type=boolean}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = CallDirect function=f0 [isAlwaysInlined]
    Return v1
  b2():
    Return
}
# CHECK-LABEL: name="calls"
# CHECK: b1():
# CHECK-NEXT: [[entered]]: fact = Entered function=f0
# CHECK: = GetModuleVariable fact=[[entered]] variable=g0

function f3 name="callsReaderOfWhatWasStoredBeforeCallers" parameters=[{type=boolean}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = CallDirect function=f1 [isAlwaysInlined]
    Return v1
  b2():
    Return
}
# CHECK-LABEL: name="callsReaderOfWhatWasStoredBeforeCallers"
# CHECK-NOT: Entered
# CHECK: = GetModuleVariable variable=g1
