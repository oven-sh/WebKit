# A spread of a string or a number, behind a test of that value for a string that failed, does not test it again: there is nothing to walk, and it throws where it stands
# FORM: Prepared optimizing
# OPTIONS: validate
# RUN: pass ExpandIteration
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="spreadsWhatFailedTheTest" parameters=[{type=string|number}] results=[{type=anything}] {
  b0(v0: string|number):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2: string):
    Return v2
  b2(v3: number):
    v4 = NewArray contents=anything
    AppendSpread v4, v0
    Return v4
# CHECK: Jump -> next [[entry]](v0)
# CHECK: [[entry]]([[operand]]: number|string):
# CHECK-NEXT: never = ThrowNotIterable [[operand]] [isSpread]
# CHECK-NEXT: Unreachable
# CHECK-NOT: CallDirect
}

function f1 name="namesTheKey" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key=@@iterator
    Return v1
}
