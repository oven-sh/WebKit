# function make(kind) { function Made(held) { this.held = held }   Made.prototype = { kind };   return held => new Made(held) }   const a = make(1), b = make(2);   a(1);   b(2)
# `new` enters a version of Made that allocates the object itself and reads the prototype object off new.target, which is a closure of the function that is constructed.
# For a copy of Made that is the copy, not the function it was copied from: no closure is one of both.
# FORM: AsRead
# RUN: pipeline ResolveCalls
# CHECK-LABEL: function f14 name="Made" {{*}}role=ConstructBody {{*}}results=[{type=L2}] {{*}}derivation={source=f5
# CHECK: v4: f5 = AssumeType v3 provenType=f5
# CHECK-NEXT: GetConstructPrototype v4 layout=L2
# CHECK-LABEL: function f19 name="Made" {{*}}role=ConstructBody {{*}}results=[{type=L3}] {{*}}derivation={source=f8
# CHECK: v4: f8 = AssumeType v3 provenType=f8
# CHECK-NEXT: GetConstructPrototype v4 layout=L3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Made" module=m0 constructor=f2 fields=[{key="held" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Record module=m0 fields=[{key="kind" declared={type=anything}}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Call v0, -, v1
    v3 = Integer integer=2
    v4 = Call v0, -, v3
    v5 = Call v2, -, v1
    v6 = Call v4, -, v3
    Return
}
function f1 name="make" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v1, v2 key="prototype" mode=Strict
    v4 = NewClosure v1 function=f3
    Return v4
}
function f2 name="Made" module=m0 flags=[HasThis] thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f3 name="construct" module=m0 kind=Arrow captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Construct v0, -, v1
    Return v2
}
