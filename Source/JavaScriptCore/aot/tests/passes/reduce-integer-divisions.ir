# RUN: pass ReduceIntegerDivisions
# STATISTIC: IntegerDivisionsReduced = 11

module m0 path="main.js" displayPath="main.js"
function f0 name="floorOfNonNegative" parameters=[{type=int[0, 100]}, {type=int[1, 8]}] results=[{type=number}] {
