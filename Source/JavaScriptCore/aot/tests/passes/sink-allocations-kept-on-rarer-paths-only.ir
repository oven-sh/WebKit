# An allocation that escapes only on rarer paths is built once per path, so the copy on the frequent path can be allocated in the frame
# FORM: Prepared
# RUN: pass SinkAllocations
# RUN(TWICE): pass SinkAllocations SinkAllocations
# STATISTIC: AllocationsSunk = 6
# STATISTIC: AllocationsBuiltApartOnRarerPaths = 6
# TWICE: outcome: Changed
# TWICE: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Environment name="scope" fields=[{key="total" declared={type=number}}]
layout L1 name="Options" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L1] fieldCreation=OnlyAtConstruction impossibleMutations=[DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType]}
layout L2 name="Handlers" fields=[{key="run" declared={type=f17} flags=[IsRequired] flow={location={stores=AtMostOnce initialization=SetAtCreation deferral=CapturesNothing deferredFunction=f17} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L2] fieldCreation=OnlyAtConstruction impossibleMutations=[DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType]}
layout L3 name="OpenOptions" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L3] fieldCreation=OnlyAtConstruction impossibleMutations=[DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType]}

function f0 name="closure" parameters=[{type=anything}, {type=anything}, {type=number}] results=[{type=anything}] {
    v3 = NewClosure v2 function=f14
    v4 = TypeTest v0 testedType=Array
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = CallDirect v0, v3 function=f10
    Return v5
  b2() frequency=Unlikely:
    v6 = Call v1, v0, v3
    Return v6
# CHECK: b0(
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK: b1():
# CHECK-NEXT: [[borrowed0]]:{{*}}= NewClosure v2 function=f14
# CHECK-NEXT: = CallDirect v0, [[borrowed0]] function=f10
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: [[kept0]]:{{*}}= NewClosure v2 function=f14
# CHECK-NEXT: = Call v1, v0, [[kept0]]
}

function f1 name="closureOverEnvironment" parameters=[{type=anything}, {type=anything}, {type=number}] results=[{type=anything}] {
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure v3 function=f15
    v5 = TypeTest v0 testedType=Array
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    v6 = CallDirect v0, v4 function=f10
    v7 = GetEnvironmentField v3 layout=L0 field=0
    Return v7
  b2() frequency=Unlikely:
    v8 = Call v1, v0, v4
    v9 = GetEnvironmentField v3 layout=L0 field=0
    Return v9
# CHECK: b0(
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK: b1():
# CHECK-NEXT: [[borrowedScope1]]:{{*}}= NewObject -, v2 layout=L0 fields=[0]
# CHECK-NEXT: [[borrowed1]]:{{*}}= NewClosure [[borrowedScope1]] function=f15
# CHECK-NEXT: = CallDirect v0, [[borrowed1]] function=f10
# CHECK-NEXT: = GetEnvironmentField [[borrowedScope1]] layout=L0
# CHECK: b2() frequency=Unlikely:
