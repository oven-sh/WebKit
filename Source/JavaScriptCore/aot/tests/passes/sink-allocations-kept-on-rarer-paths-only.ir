# CHECK-NEXT: = Call v1, v0, [[kept2]]
# CHECK-NEXT: Jump -> next b3([[keptScope2]])
# CHECK: b3([[scope2]]: env L0):
# CHECK-NEXT: = GetEnvironmentField [[scope2]] layout=L0
}

function f3 name="objectReadByCallee" parameters=[{type=boolean}, {type=number}] results=[{type=anything}] {
