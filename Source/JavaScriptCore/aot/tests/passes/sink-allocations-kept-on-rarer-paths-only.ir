# CHECK-NEXT: = Call v1, v0, [[kept1]]
# CHECK-NEXT: = GetEnvironmentField [[keptScope1]] layout=L0
}

function f2 name="environmentReadAfterMerge" parameters=[{type=anything}, {type=anything}, {type=number}] results=[{type=anything}] {
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure v3 function=f15
    v5 = TypeTest v0 testedType=Array
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    v6 = CallDirect v0, v4 function=f10
    Jump -> next b3()
  b2() frequency=Unlikely:
    v7 = Call v1, v0, v4
    Jump -> next b3()
  b3():
    v8 = GetEnvironmentField v3 layout=L0 field=0
    Return v8
# CHECK: b0(
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK: b1():
# CHECK-NEXT: [[borrowedScope2]]:{{*}}= NewObject -, v2 layout=L0 fields=[0]
# CHECK-NEXT: [[borrowed2]]:{{*}}= NewClosure [[borrowedScope2]] function=f15
# CHECK-NEXT: = CallDirect v0, [[borrowed2]] function=f10
# CHECK-NEXT: Jump -> next b3([[borrowedScope2]])
