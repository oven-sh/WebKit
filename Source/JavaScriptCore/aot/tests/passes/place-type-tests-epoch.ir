# CHECK-NEXT: [[rest0]]():
# CHECK-NEXT: v3: number = GetSlot v0, [[newGuard0]] key="b" receivers=[L0] level=Predicted
# CHECK-NEXT: Return v3
# CHECK-NEXT: [[copy0]]() frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="a"
