# A test hoisted in front of a loop holds its proof over all of the loop, so the whole body becomes one stretch. Where that is more than a copy may hold, the tests stay at their uses in the loop and the stretches stay short.
# FORM: Prepared
# OPTIONS: limit=MaxBlocksCopiedBehindStretches:1
# RUN: test-placement

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="a" declared={type=number} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}]

function f0 name="readsAllOverALoop" flags=[IsChecked] parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v1
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = PropGet v0 key="a"
    v6 = Call v1, -, v5
    Jump -> next b4()
  b3():
    v7 = PropGet v0 key="b"
    v8 = Call v1, -, v7
    Jump -> next b4()
  b4():
    v9 = PropGet v0 key="a"
    v10 = Call v1, -, v9
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b5()
  b5():
    Return v10
}
# CHECK-LABEL: function f0
# CHECK-NOT: on b0.0
# CHECK: test TypeTest v0 testedType=L0 before v5
