# STATISTIC: IterationsExpandedGenerically = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Source" fields=[{key="x" declared={type=number}}]

function f0 name="noSuspension" parameters=[{type=Array<number, pristine[Names]>}, {type=anything}] results=[{type=undefined}] {
  b0(v0: Array<number, pristine[Names]>, v1: anything):
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b5(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b4():
    v7 = Add v6, v6
    Jump -> next b1()
  b4() role=IterationCleanup subject=v2:
    v8 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v8
  b5():
    Return
}
