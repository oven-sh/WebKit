# Where the copies of the body for all arms of a for-in loop are too much code, the arms that fit are expanded, and the objects of the others take the loop as written
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass limit=MaxVersionedIterationBytes:400
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 1
# LOSS: MaxVersionedIterationBytes f0 v2

module m0 path="main.js" displayPath="main.js"
layout L0 name="One" fields=[{key="only" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L1 name="Many" fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}, {key="c" declared={type=number}}, {key="d" declared={type=number}}, {key="e" declared={type=number}}, {key="f" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2, 3, 4, 5]}]}

function f0 name="copies" parameters=[{type=object}, {type=object}] results=[{type=undefined}] {
  b0(v0: object ~ L0|L1, v1: object):
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4: int[0, 8589934591]):
    LoopHint
    v6 = ForInStep v2, v0 position=v4
    v7 = ResultAt v6 index=0
    v8 = ResultAt v6 index=1
    v9 = ResultAt v6 index=2
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v10 = ElemGet v0, v8
    ElemSet v1, v8, v10
    v12 = Integer integer=1
    v13 = Add v9, v12
    Jump -> next b1(v13)
  b3():
    Return
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK-NOT: layouts=[L1]
# CHECK: = String string="only"
# CHECK-NOT: = String string="a"
}
