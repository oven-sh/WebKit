# The code at a call by value does not grow with the number of its callees: 24 proven callees are one group call in the caller, through the whole build
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# RUN(BUILD): compile GroupCalls GroupEntrypoints
# LOSS: MaxDispatchCases
# BUILD: image not empty
# BUILD: statistic GroupCalls 1
# BUILD: statistic GroupEntrypoints 24

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
