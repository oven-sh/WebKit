# A hint that no loop of its own is left around is removed where every way back to it passes the hint of a wider loop. The hint at the head of a loop stays, and so does the only hint on a way round
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="insideAWiderLoop" parameters=[{type=int[0, 100]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    LoopHint
    PutModuleVariable v5 variable=g0
    v8 = Integer integer=1
    v9 = Add v5, v8
    Jump -> next b1(v9)
  b3():
    Return v2
# CHECK: b1(v2
# CHECK-NEXT: LoopHint
# CHECK: b2(v5
# CHECK-NEXT: PutModuleVariable v5 variable=g0
}

function f1 name="theOnlyHintOnTheWayRound" parameters=[{type=int[0, 100]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    v3 = Less v2, v0
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4):
    LoopHint
    PutModuleVariable v4 variable=g0
    v7 = Integer integer=1
    v8 = Add v4, v7
    Jump -> next b1(v8)
  b3():
    Return v2
# CHECK: b2(v4
# CHECK-NEXT: LoopHint
}

function f2 name="oneWayRoundPassesNoOtherHint" parameters=[{type=int[0, 100]}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    v4 = Less v3, v0
    Branch v4 -> taken b2(| 0), notTaken b5()
  b2(v5):
    LoopHint
    v7 = Integer integer=1
    v8 = Add v5, v7
    PutModuleVariable v8 variable=g0
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    LoopHint
    Jump -> next b1(v8)
  b4():
    Jump -> next b1(v8)
  b5():
    Return v3
# CHECK: b2(v5
# CHECK-NEXT: LoopHint
# CHECK: b3():
# CHECK-NEXT: Jump -> next b1(v8)
}
