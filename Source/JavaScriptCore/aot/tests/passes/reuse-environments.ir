function f8 name="calleeWithoutBody" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L6 fields=[0]
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = CallDirect v3 function=f13
    v5 = Call v0, -, v4
    Jump -> next b3()
  b3():
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Return v0
}
# CHECK-LABEL: function f8 name="calleeWithoutBody"
# CHECK-NOT: ReleaseEnvironment
# CHECK-NOT: MarkEnvironmentEscaped

function f9 name="captureParameterDies" captures=[{type=env L7}] parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: env L7, v1: anything, v2: boolean):
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = GetEnvironmentField v3 layout=L7 field=0
    v6 = NewObject -, v5 layout=L7 fields=[0]
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v6)
  b3():
    Return v5
}
# CHECK-LABEL: function f9 name="captureParameterDies"
# CHECK-NOT: ReleaseEnvironment
# CHECK-NOT: MarkEnvironmentEscaped
# CHECK: b3():
# CHECK-NEXT: ReleaseEnvironment v6
# CHECK-NOT: ReleaseEnvironment
# REPEAT: i = 10..12; a = 0 2 5

function f%(i) name="callback" kind=Arrow captures=[{type=env L%(a)}] results=[{type=anything}] {
  b0(v0: env L%(a)):
    v1 = GetEnvironmentField v0 layout=L%(a) field=0
    Return v1
}
# END REPEAT

function f13 name="withoutBody" kind=Arrow captures=[{type=env L6}] results=[{type=anything}]
