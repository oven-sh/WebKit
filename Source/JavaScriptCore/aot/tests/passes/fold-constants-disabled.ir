# With the pass switched off operations on constants stay
# FORM: Prepared
# OPTIONS: disable=pass:FoldConstants
# RUN: pass FoldConstants
# STATISTIC: FoldConstantsChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="knownOperands" results=[{type=number}] {
  b0():
    v0 = Integer integer=2
    v1 = Integer integer=3
    v2 = Add v0, v1
    v3 = Less v0, v1
    v4 = StrictEq v0, v1
    v5 = LogicalNot v3
    v6 = ToBoolean v0
    Return v2
}
