# What each allocating operation is to the sinker: its kind as a virtual object, or why it has none
# FORM: Prepared
# OPTIONS: limit=MaxVirtualArrayLength:2
# RUN: virtual-objects

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Vector" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]

function f0 name="objects" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = NewObject -, v0, v1 layout=L(IteratorResult) fields=[0, 1]
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v2: Supported Object L0
# CHECK-NEXT: v3: Supported Object L1
# CHECK-NEXT: v4: Supported Object L
# CHECK-NEXT: v2: Removed
# CHECK-NEXT: v3: Removed
# CHECK-NEXT: v4: Removed

function f1 name="environment" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v1: Supported Environment L2
# CHECK-NEXT: v1: Removed

function f2 name="closure" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewClosure v0 function=f3
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v1: Supported Closure f3
# CHECK-NEXT: v1: Removed

function f3 name="callback" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
# CHECK-LABEL: function f3

function f4 name="arrays" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewArray v0, v0 contents=anything
    v2 = NewArray v0 contents=anything holes=[0]
    v3 = NewArray v0, v0, v0 contents=anything
    v4 = NewArray v0, v0 contents=anything holes=[1]
    Return
}
# CHECK-LABEL: function f4
# CHECK-NEXT: v1: Supported Array
# CHECK-NEXT: v2: Supported Array
# CHECK-NEXT: v3: ExceedsLimit limit=MaxVirtualArrayLength
# CHECK-NEXT: v4: ExceedsLimit limit=MaxVirtualArrayLength
# CHECK-NEXT: v1: Removed
# CHECK-NEXT: v2: Removed
# CHECK-NEXT: v3: NotACandidate
# CHECK-NEXT: v4: NotACandidate

function f5 name="argumentsObjects" flags=[IsSloppy, TakesCallee, HasArgumentCount, HasHiddenRest] parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: function, v1: int[0, 4294967295], v2: anything, v3: anything, v4: anything, v5: Array):
    v6 = CreateUnmappedArguments v1, v5, v2, v3
    v7 = CreateMappedArguments v0, v1, v5, v2, v3
    v8 = CreateUnmappedArguments v1, v5, v2, v3, v4
    Return
}
# CHECK-LABEL: function f5
# CHECK-NEXT: v6: Supported Arguments
# CHECK-NEXT: v7: Supported Arguments
# CHECK-NEXT: v8: ExceedsLimit limit=MaxVirtualArrayLength
# CHECK-NEXT: v6: Removed
# CHECK-NEXT: v7: Removed
# CHECK-NEXT: v8: NotACandidate

function f6 name="stringRange" parameters=[{type=string}, {type=int[0, 100]}, {type=int[0, 100]}] results=[{type=undefined}] {
    v3 = Substring v0, v1, v2
    Return
}
# CHECK-LABEL: function f6
# CHECK-NEXT: v3: Supported StringRange
# CHECK-NEXT: v3: Removed

function f7 name="prefixesOfBuiltinResults" parameters=[{type=RegExp}, {type=string}] results=[{type=undefined}] {
    v2 = CallBuiltin v0, v1 overload=RegExpPrototypeExec/0
    v3 = CallBuiltin v1, v1 overload=StringPrototypeSplit/0
    Return
}
# CHECK-LABEL: function f7
# CHECK-NEXT: v2: Supported BuiltinPrefix
# CHECK-NEXT: v3: Supported BuiltinPrefix

function f8 name="opaque" results=[{type=undefined}] {
    v0 = NewRegExp pattern="a"
    v1 = NewPromise
    Return
}
# CHECK-LABEL: function f8
# CHECK-NEXT: v0: Supported Opaque
# CHECK-NEXT: v1: Supported Opaque
# CHECK-NEXT: v0: Removed
# CHECK-NEXT: v1: Removed

function f9 name="storageIsChosen" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = NewObject -, v0 layout=L2 fields=[0] storage=Frame
    v2 = NewObject -, v0 layout=L2 fields=[0] storage=FrameUntilMaterialized
    v3 = NewClosure v0 function=f3 storage=Frame
    Return
}
# CHECK-LABEL: function f9
# CHECK-NEXT: v1: HasChosenStorage
# CHECK-NEXT: v2: HasChosenStorage
# CHECK-NEXT: v3: HasChosenStorage
# CHECK-NEXT: v1: NotACandidate
# CHECK-NEXT: v2: NotACandidate
# CHECK-NEXT: v3: NotACandidate

function f10 name="effectsWhereItStands" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
    v2 = Data data=d0
    v3 = IsPlainDataObject v0
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = CloneAs v0, v4, v1 layout=L0 fields=[0]
    Return
  b2():
    Return
}
# CHECK-LABEL: function f10
# CHECK-NEXT: v2: HasEffectsAtAllocation
# CHECK-NEXT: v5: HasEffectsAtAllocation
# CHECK-NEXT: v2: NotACandidate
# CHECK-NEXT: v5: NotACandidate

function f11 name="builtinResultsWithoutParts" parameters=[{type=object}] results=[{type=undefined}] {
    v1 = CallBuiltin -, v0 overload=ObjectFreeze/0
    v2 = CallBuiltin -, v0 overload=ObjectKeys/0
    Return
}
# CHECK-LABEL: function f11
# CHECK-NEXT: v1: NotFresh
# CHECK-NEXT: v2: HasNoPartsForm
# CHECK-NEXT: v1: NotACandidate
# CHECK-NEXT: v2: NotACandidate

function f12 name="generator" role=CoroutineRamp flags=[IsGenerator, TakesCallee] results=[{type=undefined}] creator=Coroutine{ramp=f12 body=f14} {
    v1 = NewGenerator v0 function=f12
    Return
}
# CHECK-LABEL: function f12
# CHECK-NEXT: v1: HasEffectsAtAllocation
# CHECK-NEXT: v1: NotACandidate

function f13 name="restArray" role=GenericEntrypoint flags=[HasThis] captures=[{type=f3}] results=[{type=anything}] derivation={source=f3} creator=Entrypoint{target=f3} {
    v2 = CreateRest firstArgument=1
    Return
}
# CHECK-LABEL: function f13
# CHECK-NEXT: v2: Supported ArgumentList
# CHECK-NEXT: v2: Removed

function f14 name="generator" role=CoroutineBody parameters=[{type=object}, {type=anything}] results=[{type=anything}] derivation={source=f12} creator=Coroutine{ramp=f12 body=f14} {
    Return v1
}
# CHECK-LABEL: function f14
data d0 root=Array{contents=anything}
