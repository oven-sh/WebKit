# What somebody can tell the time of stays where it is: random numbers, the stack that an error notes, a read from an object that changes later, a callee that stores to a variable. A callee that only makes and fills its own objects is followed.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 1
# CHECK: variable g0 name="random" module=m0 declared={type=Array
# CHECK-NEXT: variable g1 name="failure" module=m0 declared={type=Error
# CHECK-NEXT: variable g2 name="table" module=m0 declared={type=L0}
# CHECK-NEXT: variable g3 name="keys" module=m0 declared={type=Array
# CHECK-NEXT: variable g4 name="counted" module=m0 declared={type=L0}
# CHECK-NEXT: variable g5 name="made" module=m0 declared={type=absent|L0}
# CHECK-NEXT: variable g6 name="counter" module=m0
# CHECK-LABEL: function f0 name="main"
# CHECK: = CallBuiltin overload=MathRandom/0
# CHECK: = CallBuiltin overload=Error/1
# CHECK: = CallBuiltin -, {{*}} overload=ObjectKeys/0
# CHECK: = Call {{*}} callees=[f2]
# CHECK-NOT: callees=[f3]
# CHECK: Return
# CHECK: function {{*}} name="" {{*}}role=OutlinedBody
# CHECK: [[made]]: L0 = Call {{*}} callees=[f3]
# CHECK: PutModuleVariable {{*}} variable=g5

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="a" declared={type=number} flags=[IsRequired]}]
variable g0 name="random" module=m0 declared={type=anything}
variable g1 name="failure" module=m0 declared={type=anything}
variable g2 name="table" module=m0 declared={type=L0}
variable g3 name="keys" module=m0 declared={type=anything}
variable g4 name="counted" module=m0 declared={type=L0}
variable g5 name="made" module=m0 declared={type=L0}
variable g6 name="counter" module=m0 declared={type=number} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0, -
    v2 = NewArray v1 contents=anything holes=[]
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=Error
    v5 = Construct v4, v4
    PutModuleVariable v5 variable=g1
    v7 = Double number=1.5
    v8 = NewObject -, v7 layout=L0 fields=[0]
    PutModuleVariable v8 variable=g2
    v10 = Builtin builtin=ObjectKeys
    v11 = Call v10, -, v8
    PutModuleVariable v11 variable=g3
    PutModuleVariable v7 variable=g6
    v14 = NewClosure function=f2
    v15 = Call v14, -, v7
    PutModuleVariable v15 variable=g4
    v17 = NewClosure function=f3
    v18 = Call v17, -, v7
    PutModuleVariable v18 variable=g5
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="publish" [isFreeName]
    v22 = NewClosure function=f1
    v23 = Call v21, -, v22
    Return
}
function f1 name="reader" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    v3 = GetModuleVariable variable=g2
    v4 = Double number=9.5
    PropSet v3, v4 key="a" mode=Strict
    v6 = GetModuleVariable variable=g3
    v7 = GetModuleVariable variable=g4
    v8 = GetModuleVariable variable=g5
    v9 = GetModuleVariable variable=g6
    v10 = Call v0, -, v1, v2, v3, v6, v7, v8, v9
    Return v10
}
function f2 name="countsItsCalls" module=m0 parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: number):
    v1 = GetModuleVariable variable=g6
    v2 = Add v1, v0
    v3 = Convert v2 declared={type=number}
    PutModuleVariable v3 variable=g6
    v5 = NewObject -, v0 layout=L0 fields=[0]
    Return v5
}
function f3 name="onlyMakes" module=m0 parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Add v0, v0
    v3 = Convert v2 declared={type=number}
    PropSet v1, v3 key="a" mode=Strict
    Return v1
}
