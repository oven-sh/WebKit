# Math.trunc of a quotient whose dividend may be negative can be -0, so the division stays
# FORM: Prepared
# RUN: pass ReduceIntegerDivisions
# STATISTIC: IntegerDivisionsReduced = 0
# CHECK: outcome: Unchanged
# CHECK-NOT: DivideIntegers

module m0 path="main.js" displayPath="main.js"
function f0 name="eitherSign" parameters=[{type=int[-100, 100]}, {type=int[1, 8]}] results=[{type=number}] {
  b0(v0: int[-100, 100], v1: int[1, 8]):
    v2 = Div v0, v1
    v3 = CallBuiltin -, v2 overload=MathTrunc/0 builtinCallForm=Whole
    Return v3
}
