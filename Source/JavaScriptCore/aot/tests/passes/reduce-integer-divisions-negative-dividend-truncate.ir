  b0(v0: int[-100, 100]):
    v1 = Integer integer=2
    v2 = Div v0, v1
    v3 = CallBuiltin -, v2 overload=MathTrunc/0 builtinCallForm=Whole
    Return v3
}
function f4 name="constantDividend" parameters=[{type=int[1, 8]}] results=[{type=number}] {
  b0(v0: int[1, 8]):
    v1 = Integer integer=-1
    v2 = Div v1, v0
