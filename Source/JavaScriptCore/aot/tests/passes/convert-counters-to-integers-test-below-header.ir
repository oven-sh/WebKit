# The test that bounds a counter may stand in any block of the loop, as long as every step lies below its staying edge
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 3
# STATISTIC: ConvertCountersToIntegersChanges = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="bodyRunsBeforeTheTest" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Call v1, -, v4
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Call v1, -, v4
    Jump -> next b3()
  b3():
    v9 = Less v4, v0
    Branch v9 -> taken b4(), notTaken b5()
  b4():
    v10 = Add v4, v3
    Jump -> next b1(v10)
  b5():
    Return
# CHECK: b1(v4: int[0, 100]):
# CHECK: = Call v1, -, v4
# CHECK: b2():
# CHECK-NEXT: = Call v1, -, v4
# CHECK: b3():
# CHECK-NEXT: v9: boolean = Less v4, v0
# CHECK-NEXT: Branch v9 -> taken b4(| 0), notTaken b5()
# CHECK-NEXT: b4([[bottom0]]: int[0, 99]):
# CHECK-NEXT: v10: int[1, 100] = Add [[bottom0]], v3
}

function f1 name="testInTheOnlySuccessorOfTheHeader" parameters=[{type=i32}, {type=anything}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    Jump -> next b2()
  b2():
    v6 = Less v4, v0
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Call v1, -, v4
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b4():
    Return
# CHECK: b1(v4: int[0, 2147483647]):
# CHECK: Branch v6 -> taken b3(| 0), notTaken b4()
# CHECK-NEXT: b3([[bottom1]]: int[0, 2147483646]):
# CHECK-NEXT: = Call v1, -, [[bottom1]]
# CHECK-NEXT: v8: int[1, 2147483647] = Add [[bottom1]], v3
}

function f2 name="testInHeaderHasNumberBound" parameters=[{type=number}, {type=int[0, 100]}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    v7 = Less v4, v1
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b4():
    Return
# CHECK: b1(v4: int[0, 100]):
# CHECK: Branch v6 -> taken b2(), notTaken b4()
# CHECK-NEXT: b2():
# CHECK-NEXT: v7: boolean = Less v4, v1
# CHECK-NEXT: Branch v7 -> taken b3(| 0), notTaken b4()
# CHECK-NEXT: b3([[bottom2]]: int[0, 99]):
# CHECK-NEXT: v8: int[1, 100] = Add [[bottom2]], v3
}

function f3 name="testOnOnePathOnly" parameters=[{type=int[0, 100]}, {type=boolean}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    Branch v1 -> taken b2(), notTaken b4()
  b2():
    v6 = Less v4, v0
    Branch v6 -> taken b3(), notTaken b6()
  b3():
    Jump -> next b5()
  b4():
    Jump -> next b5()
  b5():
    v7 = Add v4, v3
    Jump -> next b1(v7)
  b6():
    Return
# CHECK: b1(v4: int|whole):
# CHECK: Branch v6 -> taken b3(), notTaken b6()
# CHECK-NEXT: b3():
# CHECK: v7: int|whole = Add v4, v3
}
