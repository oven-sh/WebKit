# Flow lost sight of the closures of f0, so once one is renamed a frame of f0 is named by the closure that runs in it. A caller that creates such a closure and lets it escape around the call keeps the closure in a word of its own frame and calls directly, also behind a failed test of the names.
# A call of a closure that nobody else has seen says that it enters the caller's own function object: its frame shows the name that the closure was made with, whatever another closure of f0 was called meanwhile
# FORM: Prepared
# RUN: pass ResolveCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="escapes" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, RecordsCalleeOnceRenamed, MakesNoTailCall] {
    Return v0
}

function f1 name="onlyCalls" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f0
    v2 = Call v1, -, v0
    Return v2
# CHECK-NOT: AreFunctionNamesUnchanged
# CHECK: = CallDirect v0 function=f0 [callsOwnFunctionObject,
}

function f2 name="escapesBeforeTheCall" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = Call v0, -, v2
    v4 = Call v2, -, v1
    Return v4
# CHECK: [[escapedBefore]]: f0 = NewClosure function=f0
# CHECK-NOT: AreFunctionNamesUnchanged
# CHECK: KeepCalleeInFrame [[escapedBefore]]
# CHECK-NEXT: = CallDirect v1 function=f0 [calleeIsKeptInFrame
# CHECK-NOT: = Call [[escapedBefore]], -, v1
}

function f3 name="isConvertedBeforeTheCall" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = Add v0, v2
    v4 = Call v2, -, v1
    Return v4
# CHECK: [[converted]]: f0 = NewClosure function=f0
# CHECK-NOT: AreFunctionNamesUnchanged
# CHECK: KeepCalleeInFrame [[converted]]
# CHECK-NEXT: = CallDirect v1 function=f0 [calleeIsKeptInFrame
# CHECK-NOT: = Call [[converted]], -, v1
}

function f4 name="escapesAfterTheCall" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = Call v2, -, v1
    v4 = Call v0, -, v2
    Return v3
# CHECK: [[escapedAfter]]: f0 = NewClosure function=f0
# CHECK-NOT: AreFunctionNamesUnchanged
# CHECK: KeepCalleeInFrame [[escapedAfter]]
# CHECK-NEXT: = CallDirect v1 function=f0 [calleeIsKeptInFrame
# CHECK-NOT: = Call [[escapedAfter]], -, v1
}

function f5 name="escapesInRareCode" parameters=[{type=boolean}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v3 = NewClosure function=f0
    v4 = Call v1, -, v3
    v5 = Call v3, -, v2
    Return v5
  b2():
    Return v2
# CHECK: [[escapedInRareCode]]: f0 = NewClosure function=f0
# Code that seldom runs keeps the call by value, which takes fewer bytes.
# CHECK: = Call v1, -, [[escapedInRareCode]]
# CHECK-NEXT: = Call [[escapedInRareCode]], -, v2
}

function f6 name="escapesOnTheOtherSide" parameters=[{type=boolean}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v4 = Call v3, -, v2
    Return v4
  b2():
    v5 = Call v1, -, v3
    Return v5
# CHECK-NOT: KeepCalleeInFrame
# CHECK: = CallDirect v2 function=f0 [callsOwnFunctionObject
# CHECK: = Call v1, -, v3
}

function f7 name="callsBehindAFailedTest" parameters=[{type=boolean}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = AreFunctionNamesUnchanged
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2() frequency=Unlikely:
    Branch v0 -> taken b3(), notTaken b4()
  b3():
    v4 = NewClosure function=f0
    v5 = Call v1, -, v4
    Jump -> next b5(v4)
  b4():
    v6 = NewClosure function=f0
    Jump -> next b5(v6)
  b5(v7: f0):
    v8 = Call v7, -, v2
    Return v8
# CHECK: b5([[eitherClosure]]: f0)
# CHECK-NEXT: = Call [[eitherClosure]], -, v2
}

# A function that can leave by a tail call may have another of its closures run above the call. A stack that is taken before the first closure is renamed and read behind it would name that frame after the closure in the caller's frame: the call stays a call of the value.
function f8 name="leavesByATailCall" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, RecordsCalleeOnceRenamed] {
    v1 = Call v0
    ReturnCall v1
}

function f9 name="callsWhatCanLeaveByATailCall" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f8
    v3 = Call v0, -, v2
    v4 = Call v2, -, v1
    Return v4
# CHECK: [[leaves]]: f8 = NewClosure function=f8
# CHECK-NOT: KeepCalleeInFrame
# CHECK: = Call [[leaves]], -, v1
}
