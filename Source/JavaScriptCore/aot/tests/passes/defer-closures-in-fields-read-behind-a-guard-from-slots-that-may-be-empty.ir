# A read that gives undefined for an empty slot stands behind a test of what its object is. It becomes the read that makes the closure and still gives undefined for an empty slot,
# and it keeps its guard: no test of the slot stands in front of it
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass DeferClosuresInFields
# STATISTIC: FieldsDeferringClosures = 1
# STATISTIC: ClosuresDeferredInFields = 1
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Filled" fields=[{key="run" declared={type=anything}}]
layout L1 name="MayBeEmpty" fields=[{key="run" declared={type=object} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}]
# CHECK: layout L0 {{*}}deferral=CapturesNothing deferredFunction=f3}

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}

function f1 name="makes" module=m0 results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject layout=L1 fields=[]
    Return v1
}
# CHECK-LABEL: function f1 name="makes"
# CHECK: v0: f3 = NewClosure function=f3 [isMadeOnDemand]

function f2 name="readsBehindTest" module=m0 parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1):
    v1 = HasNoFieldOutsideSlot v0
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: guard):
    v3 = GetSlotOrUndefined v0, v2 key="run" receivers=[L0, L1] level=Expected
    Return v3
  b2():
    Return
}
# CHECK-LABEL: function f2 name="readsBehindTest"
# CHECK: b1(v2: guard):
# CHECK-NEXT: = GetDeferredClosureSlotOrUndefined v0, v2 key="run" receivers=[L0, L1] level=Expected
# CHECK-NEXT: Return

function f3 name="overNothing" module=m0 kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
