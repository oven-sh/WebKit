# A region does not take a branch away from the block that its edge passes a proof to
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 2
# STATISTIC: ColdSitesOutlined = 6

module m0 path="main.js" displayPath="main.js"
function f0 name="edgePassesProof" parameters=[{type=boolean}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: anything, v2: anything):
    Branch v0 -> taken b1(), notTaken b6()
  b1() frequency=Rare:
    v3 = TypeTest v1 testedType=undefined|null
    Branch v3 -> taken b2(), notTaken b5(| 0)
  b2():
    v4 = PropGet v2 key="return"
    v5 = TypeTest v4 testedType=object
    TestAndBranch v5 -> taken b3(), notTaken b4()
  b3():
    v6 = NewRuntimeError runtimeError=IteratorResultNotObject
    Throw v6
  b4():
    v7 = NewRuntimeError runtimeError=IteratorWithoutThrowMethod
    Throw v7
  b5(v8):
    Return v8
  b6():
    Return v2
}
