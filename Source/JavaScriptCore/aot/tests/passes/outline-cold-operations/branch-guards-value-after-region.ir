# CHECK: [[test0]]: boolean = TypeTest v1 testedType=undefined|null
# CHECK-NEXT: Branch [[test0]] -> taken b2(), notTaken [[exit0]](| 0)
# CHECK: = CallDirect v2 function=f6
# CHECK: [[exit0]]([[narrowed0]]:
# CHECK-NEXT: Return [[narrowed0]]

