function f2 name="copiesHoldLoopThatIsRead" parameters=[{type=int[0, 100]}, {type=int[1, 100]}] results=[{type=int|whole}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b4()
  b2(v6):
    v7 = Integer integer=50
    v8 = Greater v6, v7
    Branch v8 -> taken b8(), notTaken b3()
  b3():
    v9 = Increment v6
    Jump -> next b1(v9)
  b4():
    v10 = Integer integer=0
    v11 = Integer integer=0
    v12 = Upcast v10 castType=int|whole
    Jump -> next b5(v12, v11)
  b5(v13: int|whole, v14: int[0, 100]):
    LoopHint
    v16 = Less v14, v1
    Branch v16 -> taken b6(| 0), notTaken b7()
  b6(v17):
    v18 = Add v13, v17
    v19 = Increment v17
    Jump -> next b5(v18, v19)
  b7():
    Return v13
  b8() frequency=Rare:
    v20 = Integer integer=0
    v21 = Integer integer=0
    Jump -> next b9(v20, v21)
  b9(v22: int|whole, v23: int[0, 100]) frequency=Rare:
    LoopHint
    v25 = Less v23, v1
    Branch v25 -> taken b10(| 0), notTaken b11()
  b10(v26) frequency=Rare:
    v27 = Add v22, v26
    v28 = Increment v26
    Jump -> next b9(v27, v28)
  b11() frequency=Rare:
    Return v22
# CHECK: b0(
# CHECK: Jump -> next b4()
# CHECK-COUNT-1: LoopHint
# CHECK-NOT: LoopHint
}

