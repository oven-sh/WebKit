# A loop that does nothing but turn and end may leave for several blocks. All it decides is which, so it goes where they do the same, and stays where they differ
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 4

module m0 path="main.js" displayPath="main.js"
function f0 name="leavesForCopies" parameters=[{type=int[0, 100]}, {type=number}] results=[{type=number}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b4()
  b2(v6):
    v7 = Integer integer=50
    v8 = Greater v6, v7
    Branch v8 -> taken b5(), notTaken b3()
  b3():
    v9 = Increment v6
    Jump -> next b1(v9)
  b4():
    v10 = Integer integer=1
    v11 = Add v1, v10
    Return v11
  b5() frequency=Rare:
    v12 = Integer integer=1
    v13 = Add v1, v12
    Return v13
# CHECK: b0(
# CHECK: Jump -> next b4()
# CHECK-NOT: LoopHint
}

