# The loop around comes by b1 or by its copy b6. Behind b6, b7 returns what an earlier turn got in b1.
function f7 name="oneCopyIsReadWhereTheyMeet" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v1
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b7()
  b2():
    v5 = Integer integer=0
    Jump -> next b3(v5)
  b3(v6):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b4(| 0), notTaken b1()
  b4(v9):
    v10 = Integer integer=50
    v11 = Greater v9, v10
    Branch v11 -> taken b6(), notTaken b5()
  b5():
    v12 = Increment v9
    Jump -> next b3(v12)
  b6():
    LoopHint
    v14 = Call v1
    v15 = ToBoolean v14
    Branch v15 -> taken b2(), notTaken b7()
  b7():
    Return v3
# CHECK: b1():
# CHECK-NEXT: LoopHint
# CHECK: Jump -> next b3(v5)
# CHECK-COUNT-2: LoopHint
}

# What else leads into the copy has not come by its first block.
function f8 name="anotherWayLeadsIntoCopy" parameters=[{type=int[0, 100]}, {type=number}, {type=boolean}] results=[{type=number}] {
    v3 = Integer integer=0
    Branch v2 -> taken b1(v3), notTaken b8()
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7):
    v8 = Integer integer=50
    v9 = Greater v7, v8
    Branch v9 -> taken b6(), notTaken b3()
  b3():
    v10 = Increment v7
    Jump -> next b1(v10)
  b4():
    Jump -> next b5()
  b5():
    v11 = Integer integer=1
    v12 = Add v1, v11
    Return v12
  b6() frequency=Rare:
    Jump -> next b7()
  b7() frequency=Rare:
    v13 = Integer integer=1
    v14 = Add v1, v13
    Return v14
  b8():
    Jump -> next b7()
# CHECK: b0(
# CHECK: taken b1(v3)
# CHECK: LoopHint
}
