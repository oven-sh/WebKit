# No test finds import.meta, which each module has one of: among other objects a test for it refuses it, and where the value may be no other object the test asks for an object. The refusal of the first kind decides a test like itself and none of the second kind.
# FORM: Prepared
# RUN: pass SimplifyControlFlow

module m0 path="main.js" displayPath="main.js"

function f0 name="onlyObjectBehindTheRefusalAmongAllObjects" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v1 -> taken b4(), notTaken b1()
  b1():
    v2 = AssumeType v0 provenType=number|builtin(ImportMeta)
    v3 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4):
    Return v4
  b3(v5):
    v6 = Negate v5
    Return v6
  b4():
    Return v0
# CHECK: Branch v1 -> taken b4(), notTaken b1()
# CHECK: Branch v3 -> taken b2(| 0), notTaken b3(| 0)
}

function f1 name="onlyObjectBehindTheRefusalAmongTwoObjects" parameters=[{type=number|builtin(GlobalThis)|builtin(ImportMeta)}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v1 -> taken b4(), notTaken b1()
  b1():
    v2 = AssumeType v0 provenType=number|builtin(ImportMeta)
    v3 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4):
    Return v4
  b3(v5):
    v6 = Negate v5
    Return v6
  b4():
    Return v0
# CHECK: Branch v1 -> taken b4(), notTaken b1()
# CHECK: Branch v3 -> taken b2(| 0), notTaken b3(| 0)
}

function f2 name="amongAllObjectsBehindTheRefusalAmongAllObjects" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v2 -> taken b4(), notTaken b1()
  b1():
    v3 = Call v1
    v4 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    v6 = Call v1, -, v0
    Return v6
  b4():
    Return v0
# CHECK: Branch v2 -> taken b4(), notTaken b1()
# CHECK-NOT: Branch
# CHECK: = Call v1, -, v0
}

function f3 name="amongAllObjectsBehindTheRefusalOfTheOnlyObject" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = AssumeType v0 provenType=number|builtin(ImportMeta)
    v3 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v3 -> taken b4(), notTaken b1()
  b1():
    v4 = Call v1
    v5 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    Return v6
  b3():
    v7 = Call v1, -, v0
    Return v7
  b4():
    Return v0
# CHECK: Branch v3 -> taken b4(), notTaken b1()
# CHECK-NOT: Branch
# CHECK: = Call v1, -, v0
}

function f4 name="amongAllObjectsBehindTheOnlyObjectThatPassed" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = AssumeType v0 provenType=number|builtin(ImportMeta)
    v3 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v3 -> taken b1(), notTaken b4()
  b1():
    v4 = Call v1
    v5 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    Return v6
  b3():
    v7 = Call v1, -, v0
    Return v7
  b4():
    Return v0
# CHECK: Branch v3 -> taken b1(), notTaken b4()
# CHECK-NOT: Branch
# CHECK-NOT: = Call v1, -, v0
}

function f5 name="listedFunctionsBehindARefusalOfBothKinds" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=f7|builtin(ImportMeta)
    Branch v1 -> taken b4(), notTaken b1()
  b1():
    v2 = AssumeType v0 provenType=f7|f8|builtin(ImportMeta)
    v3 = TypeTest v2 testedType=f7|builtin(ImportMeta)
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4):
    v5 = TypeOf v4
    Return v5
  b3(v6):
    v7 = Call v6
    Return v7
  b4():
    Return v0
# CHECK: Branch v1 -> taken b4(), notTaken b1()
# CHECK: Branch v3 -> taken b2(| 0), notTaken b3(| 0)
}

function f6 name="manyTestsOfOneValue" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = AssumeType v0 provenType=number|builtin(ImportMeta)
    v3 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v3 -> taken b11(), notTaken b1()
  b1():
    v4 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v4 -> taken b11(), notTaken b2()
  b2():
    v5 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v5 -> taken b11(), notTaken b3()
  b3():
    v6 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v6 -> taken b11(), notTaken b4()
  b4():
    v7 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v7 -> taken b11(), notTaken b5()
  b5():
    v8 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v8 -> taken b11(), notTaken b6()
  b6():
    v9 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v9 -> taken b11(), notTaken b7()
  b7():
    v10 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v10 -> taken b11(), notTaken b8()
  b8():
    v11 = TypeTest v2 testedType=builtin(ImportMeta)
    Branch v11 -> taken b11(), notTaken b9()
  b9():
    v12 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v12 -> taken b11(), notTaken b10()
  b10():
    v13 = Call v1
    Return v13
  b11():
    Return v1
# CHECK: Branch v3 -> taken
# CHECK: Branch v4 -> taken
# CHECK-NOT: Branch
# CHECK: = Call v1
}

