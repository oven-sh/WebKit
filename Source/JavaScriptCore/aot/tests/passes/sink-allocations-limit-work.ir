# The analysis counts its steps. A function that needs more of them than the limit keeps its allocations where they are; a smaller one beside it is still worked on
# FORM: Prepared
# OPTIONS: limit=MaxSinkingWork:30
# RUN: pass SinkAllocations
# LOSS: MaxSinkingWork x1 f0
# STATISTIC: AllocationsSunk = 1
# STATISTIC: StoresFoldedIntoAllocations = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="needsMoreStepsThanTheLimit" parameters=[{type=anything}, {type=anything}, {type=boolean}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    v5 = NewObject -, v0 layout=L0 fields=[0]
    PropDefine v5, v1 key="y" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v7 = Call v0
    Jump -> next b3()
  b2():
    v8 = Call v1
    Jump -> next b3()
  b3():
    Branch v3 -> taken b4(), notTaken b5()
  b4():
    v9 = Call v0, -, v0
    Jump -> next b6()
  b5():
    v10 = Call v1, -, v1
    Jump -> next b6()
  b6():
    Branch v4 -> taken b7(), notTaken b8()
  b7():
    v11 = Call v0, -, v5
    Return v11
  b8():
    Return v1
# CHECK: b0(
# CHECK-NEXT: v5:{{*}}= NewObject -, v0 layout=L0 fields=[0]
# CHECK-NEXT: PropDefine v5, v1 key="y"
# CHECK-NOT: NewObject
# CHECK: = Call v0, -, v5
}

function f1 name="needsFewerSteps" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3 = NewObject -, v0 layout=L0 fields=[0]
    PropDefine v3, v1 key="y" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = Call v0, -, v3
    Return v5
  b2():
    Return v1
# CHECK: b0(
# CHECK-NEXT: Branch v2
# CHECK: b1():
# CHECK-NEXT: [[cell]]:{{*}}= NewObject -, v0, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[cell]]
}
