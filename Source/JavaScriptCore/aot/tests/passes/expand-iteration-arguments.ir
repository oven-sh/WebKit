# An arguments object that stays in its function and is only read and walked is walked by index: it still holds its length and, under @@iterator, Array.prototype.values. A spread appends what the object was made of, without a loop, where the list of the arguments behind the parameters is known to be an ordinary one. No iterator is made, and where nothing else needs the object it is never built. An object that is kept, stored into, read under a key that may name something above it, or made by a caller follows the protocol
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# RUN(SUNK): pass ExpandIteration ResolveAccesses SinkAllocations
# STATISTIC: IterationsExpandedByClass = 5

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="spread" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: Array):
    v3 = CreateUnmappedArguments v0, v2, v1
    v4 = NewArray contents=anything
    AppendSpread v4, v3
    Return v4
# CHECK-NOT: CallDirect
# CHECK: LoopHint
# CHECK-NEXT: [[length0]]: anything = PropGet [[walked0]] key="length"
# CHECK-NEXT: = ToLength [[length0]]
# CHECK: AppendElement v4, [[element0]]
# CHECK: anything = ElemGet [[walked0]], {{*}} [keyIsIntegral]
# CHECK-NOT: @@iterator
# SUNK-NOT: CreateUnmappedArguments
}

function f1 name="loop" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: Array):
    v3 = CreateUnmappedArguments v0, v2, v1
    v4 = IteratorOpen v3 iteratorKind=Sync
    Jump -> next b1()
  b1():
    LoopHint
    v6 = IteratorResume v4 iteratorKind=Sync resumeMode=Next
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    Return v1
  b3():
    PutModuleVariable v8 variable=g0
    Jump -> next b1()
# CHECK: [[length1]]: anything = PropGet v3 key="length"
# CHECK-NEXT: = ToLength [[length1]]
# CHECK: anything = ElemGet v3, {{*}} [keyIsIntegral]
# CHECK-NOT: @@iterator
# SUNK-NOT: CreateUnmappedArguments
}

