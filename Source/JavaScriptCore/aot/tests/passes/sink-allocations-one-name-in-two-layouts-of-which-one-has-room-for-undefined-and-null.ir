# Two layouts both have a field "z". The slot of one has room for undefined and null beside integers, the slot of the other holds integers alone. One value cannot carry "z" for both, so an object that is of either layout is made ahead of the join, and each is given what its own slot takes
# FORM: Prepared optimizing
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="IntegersAlone" module=m0 fields=[{key="a" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={constructorOrders=[{}, {fields=[0, 1]}]}
layout L1 name="One" module=m0 fields=[{key="z" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown initialization=SetAtCreation} stability=[IsNeverDeleted, IsNeverRedefined]}}] flow={constructorOrders=[{}, {fields=[0]}]}
layout L2 name="WithRoom" module=m0 fields=[{key="a" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=int} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown initialization=SetAtCreation} stability=[IsNeverDeleted, IsNeverRedefined]}}] flow={constructorOrders=[{}, {fields=[0, 1]}]}

function f0 name="oneSlotHoldsIntegersAlone" parameters=[{type=L0}, {type=L1}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: L0, v1: L1, v2: boolean, v3: boolean):
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v4 = HasKeyOrder v0 layout=L0 fields=[0, 1]
    Branch v4 -> taken b2(| 0), notTaken b7()
  b2(v5: guard):
    v6 = GetSlot v0, v5 key="a" receivers=[L0] level=Expected
    v7 = GetSlot v0, v5 key="z" receivers=[L0] level=Expected
    v8 = NewObject -, v6, v7 layout=L0 fields=[0, 1]
    Jump -> next b5(v8)
  b3():
    v9 = HasKeyOrder v1 layout=L1 fields=[0]
    Branch v9 -> taken b4(| 0), notTaken b7()
  b4(v10: guard):
    v11 = GetSlot v1, v10 key="z" receivers=[L1] level=Expected
    v12 = NewObject -, v11 layout=L1 fields=[0]
    Jump -> next b5(v12)
  b5(v13: L0|L1):
    Branch v3 -> taken b6(), notTaken b7()
  b6():
    Return v13
  b7():
    v14 = Integer integer=0
    Return v14
# CHECK: [[integer]]: int = GetSlot v0, v5 key="z"
# CHECK-NEXT: [[two]]: L0 = NewObject -, v6, [[integer]] layout=L0 fields=[0, 1]
# CHECK-NEXT: Jump -> next b5([[two]])
# CHECK: [[either]]: undefined|null|int ~ int = GetSlot v1, v10 key="z"
# CHECK-NEXT: [[one]]: L1 = NewObject -, [[either]] layout=L1 fields=[0]
# CHECK-NEXT: Jump -> next b5([[one]])
# CHECK-NOT: NewObject
}

function f1 name="bothSlotsHaveRoom" parameters=[{type=L2}, {type=L1}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: L2, v1: L1, v2: boolean, v3: boolean):
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v4 = HasKeyOrder v0 layout=L2 fields=[0, 1]
    Branch v4 -> taken b2(| 0), notTaken b7()
  b2(v5: guard):
    v6 = GetSlot v0, v5 key="a" receivers=[L2] level=Expected
    v7 = GetSlot v0, v5 key="z" receivers=[L2] level=Expected
    v8 = NewObject -, v6, v7 layout=L2 fields=[0, 1]
    Jump -> next b5(v8)
  b3():
    v9 = HasKeyOrder v1 layout=L1 fields=[0]
    Branch v9 -> taken b4(| 0), notTaken b7()
  b4(v10: guard):
    v11 = GetSlot v1, v10 key="z" receivers=[L1] level=Expected
    v12 = NewObject -, v11 layout=L1 fields=[0]
    Jump -> next b5(v12)
  b5(v13: L2|L1):
    Branch v3 -> taken b6(), notTaken b7()
  b6():
    Return v13
  b7():
    v14 = Integer integer=0
    Return v14
# CHECK: b5({{*}}: i32, {{*}}: int|unspecified, [[z]]: undefined|null|int):
# CHECK-NOT: AssumeType [[z]]
# CHECK: = NewObject -, {{*}}, [[z]] layout=L2 fields=[0, 1]
# CHECK-NOT: AssumeType
# CHECK: = NewObject -, [[z]] layout=L1 fields=[0]
}

function f2 name="integersAloneAreCarriedThroughMerge" parameters=[{type=L0}, {type=L1}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: L0, v1: L1, v2: boolean, v3: boolean):
    Branch v2 -> taken b1(), notTaken b3()
  b1():
    v4 = HasKeyOrder v0 layout=L0 fields=[0, 1]
    Branch v4 -> taken b2(| 0), notTaken b7()
  b2(v5: guard):
    v6 = GetSlot v0, v5 key="a" receivers=[L0] level=Expected
    v7 = GetSlot v0, v5 key="z" receivers=[L0] level=Expected
    v8 = NewObject -, v6, v7 layout=L0 fields=[0, 1]
    Branch v3 -> taken b8(), notTaken b9()
  b3():
    v9 = HasKeyOrder v1 layout=L1 fields=[0]
    Branch v9 -> taken b4(| 0), notTaken b7()
  b4(v10: guard):
    v11 = GetSlot v1, v10 key="z" receivers=[L1] level=Expected
    v12 = NewObject -, v11 layout=L1 fields=[0]
    Jump -> next b5(v12)
  b5(v13: L0|L1):
    Branch v3 -> taken b6(), notTaken b7()
  b6():
    Return v13
  b7():
    v14 = Integer integer=0
    Return v14
  b8():
    Jump -> next b10()
  b9():
    Jump -> next b10()
  b10():
    Branch v2 -> taken b11(), notTaken b7()
  b11():
    Jump -> next b5(v8)
# CHECK: b10({{*}}: int, [[carried]]: int):
# CHECK: b11():
# CHECK-NEXT: [[made]]: L0 = NewObject -, {{*}}, [[carried]] layout=L0 fields=[0, 1]
# CHECK-NEXT: Jump -> next b5([[made]])
}
