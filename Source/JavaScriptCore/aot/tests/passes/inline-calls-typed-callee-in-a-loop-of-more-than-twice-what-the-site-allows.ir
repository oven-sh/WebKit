# In a loop of the caller a function with declared types is judged by the code that is expected to run. What is copied is the whole body: a body of more than twice what the site allows stays a call
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot limit=InlineBudgetHotBytes:200
# RUN: pass InlineCalls

module m0 path="main.ts" displayPath="main.ts"
function f0 name="typedWithManyTests" flags=[IsChecked] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="first"
    v2 = TypeTest v1 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b7()
  b1(v3):
    v4 = PropGet v0 key="second"
    v5 = TypeTest v4 testedType=number
    Branch v5 -> taken b2(| 0), notTaken b7()
  b2(v6):
    v7 = PropGet v0 key="third"
    v8 = TypeTest v7 testedType=number
    Branch v8 -> taken b3(| 0), notTaken b7()
  b3(v9):
    v10 = PropGet v0 key="fourth"
    v11 = TypeTest v10 testedType=number
    Branch v11 -> taken b4(| 0), notTaken b7()
  b4(v12):
    v13 = PropGet v0 key="fifth"
    v14 = TypeTest v13 testedType=number
    Branch v14 -> taken b5(| 0), notTaken b7()
  b5(v15):
    v16 = PropGet v0 key="sixth"
    v17 = TypeTest v16 testedType=number
    Branch v17 -> taken b6(| 0), notTaken b7()
  b6(v18):
    v19 = Add v3, v6
    v20 = Add v19, v9
    v21 = Add v20, v12
    v22 = Add v21, v15
    v23 = Add v22, v18
    Return v23
  b7() frequency=Unlikely:
    v24 = PropGet v0 key="a"
    v25 = PropGet v24 key="b"
    v26 = PropGet v25 key="c"
    v27 = PropGet v26 key="d"
    v28 = PropGet v27 key="e"
    v29 = PropGet v28 key="f"
    v30 = PropGet v29 key="g"
    v31 = PropGet v30 key="h"
    v32 = PropGet v31 key="i"
    Return v32
}
function f1 name="callsItInALoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = PropGet v0 key="more"
    v3 = ToBoolean v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    v4 = CallDirect v0 function=f0
    PropSet v0, v4 key="last" mode=Strict
    Jump -> next b1()
  b3():
    Return v2
}
# CHECK-LABEL: function f1 name="callsItInALoop"
# CHECK: = CallDirect v0 function=f0
# CHECK-LABEL: function f2 name="callsItOnce"

function f2 name="callsItOnce" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f0
    Return v1
}
