# A loop that paths have to leave so that it can carry a variable is entered through its copy, which is likely code then: the first turn runs there, with every turn of a loop inside.
# A turn that runs a loop of its own does not wait for one read, so a variable that such a loop only reads stays where it is. One that it stores as well goes around as before
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="position" declared={type=anything}}]

function f0 name="onlyReads" parameters=[{type=env L0}, {type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: string):
    v3 = Integer
    Jump -> next b1(v3)
  b1(v4: i32):
    LoopHint
    v6 = GetEnvironmentField v0 layout=L0 field=0
    v7 = TypeTest v6 testedType=number
    Branch v7 -> taken b2(| 0), notTaken b11()
  b2(v8):
    v9 = Less v4, v8
    Branch v9 -> taken b3(), notTaken b10()
  b3():
    v10 = Integer
    Jump -> next b4(v10)
  b4(v11: i32):
    LoopHint
    v13 = GetStringLength v2
    v14 = Less v11, v13
    Branch v14 -> taken b5(), notTaken b6()
  b5():
    v15 = Increment v11
    v16 = BitOr v15, v15
    Jump -> next b4(v16)
  b6():
    v17 = TypeTest v1 testedType=i32
    Branch v17 -> taken b7(| 0), notTaken b8()
  b7(v18):
    Jump -> next b9()
  b8() frequency=Unlikely:
    v19 = Call v1, -
    Jump -> next b9()
  b9():
    v20 = Increment v4
    v21 = BitOr v20, v20
    Jump -> next b1(v21)
  b10():
    Return v4
  b11() frequency=Unlikely:
    v22 = Undefined
    Return v22
# There is one outer loop and one inner loop, and every turn reads the variable.
# CHECK: b0(
# CHECK: Jump -> next b1(v3)
# CHECK-NEXT: b1(v4: i32):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = GetEnvironmentField v0 layout=L0
# CHECK: LoopHint
# CHECK-NOT: LoopHint
}

function f1 name="readsAndStores" parameters=[{type=env L0}, {type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: string):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = GetEnvironmentField v0 layout=L0 field=0
    v5 = TypeTest v4 testedType=number
    Branch v5 -> taken b2(| 0), notTaken b11()
  b2(v6):
    v7 = GetStringLength v2
    v8 = Less v6, v7
    Branch v8 -> taken b3(), notTaken b10()
  b3():
    v9 = Integer
    Jump -> next b4(v9)
  b4(v10: i32):
    LoopHint
    v12 = Less v10, v7
    Branch v12 -> taken b5(), notTaken b6()
  b5():
    v13 = Increment v10
    v14 = BitOr v13, v13
    Jump -> next b4(v14)
  b6():
    v15 = TypeTest v6 testedType=i32
    Branch v15 -> taken b7(| 0), notTaken b8()
  b7(v16):
    v17 = BitOr v16, v16
    Jump -> next b9()
  b8() frequency=Unlikely:
    v18 = Call v1, -
    Jump -> next b9()
  b9():
    v19 = Increment v6
    PutEnvironmentField v0, v19 layout=L0 field=0
    Jump -> next b1()
  b10():
    Return v6
  b11() frequency=Unlikely:
    v21 = Undefined
    Return v21
# The loop has the variable as an integer and stores it on the edges that leave. It is entered through the copy, which reads it.
# CHECK: b0(
# CHECK-NEXT: Jump -> next [[copy]]()
# CHECK-NEXT: b1({{*}}: i32):
# CHECK-NOT: GetEnvironmentField
# CHECK: [[copy]]():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = GetEnvironmentField v0 layout=L0
}
