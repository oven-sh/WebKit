# Only an environment with storage FrameUntilMaterialized is copied to the heap: a cell with storage Frame may hold frame pointers
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: FramePointerRetained 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="callback" declared={type=anything}}]

function f0 name="copiesFrameEnvironment" results=[{type=anything}] {
    v0 = NewClosure function=f4 storage=Frame
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = MaterializeEnvironment v1 layout=L0
    v3 = NewClosure v2 function=f3
    Return v3
}

function f1 name="copiesMergedFrameEnvironment" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    Jump -> next b3(v2)
  b2():
    v3 = NewObject -, v0 layout=L0 fields=[0] storage=FrameUntilMaterialized
    Jump -> next b3(v3)
  b3(v4):
    v5 = MaterializeEnvironment v4 layout=L0
    v6 = NewClosure v5 function=f3
    Return v6
}

function f2 name="copiesLateEnvironmentBesideFrameEnvironment" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f4 storage=Frame
    v2 = NewObject -, v1 layout=L0 fields=[0] storage=Frame
    v3 = NewObject -, v0 layout=L0 fields=[0] storage=FrameUntilMaterialized
    v4 = MaterializeEnvironment v3 layout=L0
    v5 = NewClosure v4 function=f3
    Return v5
}

function f3 name="readsCallback" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f4 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
