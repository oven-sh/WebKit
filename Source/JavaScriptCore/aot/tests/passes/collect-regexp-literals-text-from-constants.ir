# The text of a pattern that the program puts together from constants counts like a literal: what the only store to a variable stores, concatenations of such texts, and the result of a function called with them.
# So does a parameter of the function that creates the expression, with the arguments of its direct callers, where nothing but direct calls names the function: the walk has seen every text.
# A text and a warning too, because the walk left something out: a variable that is stored twice, once with a text nobody knows; such a parameter of a function that is handed out as a value
# too, which whoever holds it may call with anything. Several texts are candidates. No text, and a warning: a parameter whose only caller passes what nobody knows; two parameters with two callers each, put together:
# alternatives of one operand are an enumeration, alternatives of two, multiplied, are mostly texts that nobody makes. An arm of a condition that the known value never takes gives no text.
# FORM: AsRead
# RUN: pipeline CollectRegExpLiterals
# OPTIONS: only-passes=AnalyzeFlow
# DIAGNOSTIC: RegExpWithoutCode 4
# CHECK: regexp requests: 15
# CHECK-NEXT: literal "[0-9]+" flags=- sites=f11:v0
# CHECK-NEXT: literal "_" flags=- sites=f10:v1
# CHECK-NEXT: evaluated "a+" flags=- sites=f6:v2
# CHECK-NEXT: evaluated "e+" flags=- sites=f14:v3
# CHECK-NEXT: evaluated "[0-9]+\\.[0-9]+" flags=- sites=f1:v2
# CHECK-NEXT: evaluated "^[0-9]+\\.[0-9]+|[a-z]+$" flags=- sites=f2:v7
# CHECK-NEXT: evaluated "(?:[a-z]+)?" flags=i sites=f3:v4
# CHECK-NEXT: evaluated "(?:(?:[a-z]+)?)?x" flags=- sites=f4:v2
# CHECK-NEXT: evaluated "(?:[0-9]+)?" flags=- sites=f8:v3
# CHECK-NEXT: evaluated "c+[0-9]+" flags=- sites=f9:v4
# CHECK-NEXT: evaluated "c+[a-z]+" flags=- sites=f9:v4
# CHECK-NEXT: evaluated "[a-z]+-[0-9]+" flags=- sites=f10:v8
# CHECK-NEXT: evaluated "[0-9]+|d" flags=- sites=f11:v7
# CHECK-NEXT: candidate "h+[0-9]+" flags=- sites=f15:v4
# CHECK-NEXT: candidate "h+[a-z]+" flags=- sites=f15:v4
# CHECK-NEXT: variable g0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="digits" module=m0 declared={type=anything}
variable g1 name="number" module=m0 declared={type=anything}
variable g2 name="word" module=m0 declared={type=anything}
variable g3 name="nested" module=m0 declared={type=anything}
variable g4 name="storedTwice" module=m0 declared={type=anything}

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToString v1
    v3 = String string="[0-9]+"
    PutModuleVariable v3 variable=g0
    v5 = GetModuleVariable variable=g0
    v6 = String string="\\."
    v7 = Strcat v5, v6, v5
    PutModuleVariable v7 variable=g1
    v9 = String string="[a-z]+"
    PutModuleVariable v9 variable=g2
    v11 = GetModuleVariable variable=g2
    v12 = CallDirect v11 function=f5
    v13 = CallDirect v12 function=f5
    v14 = String string="x"
    v15 = Strcat v13, v14
    PutModuleVariable v15 variable=g3
    v17 = String string="a+"
    PutModuleVariable v17 variable=g4
    v19 = Strcat v17, v2
    PutModuleVariable v19 variable=g4
    v21 = CallDirect function=f1
    v22 = CallDirect function=f2
    v23 = CallDirect function=f3
    v24 = CallDirect function=f4
    v25 = CallDirect function=f6
    v26 = CallDirect v2 function=f7
    v27 = CallDirect function=f8
    v28 = GetModuleVariable variable=g0
    v29 = CallDirect v28 function=f9
    v30 = CallDirect v11 function=f9
    v31 = CallDirect function=f10
    v32 = CallDirect function=f11
    v33 = CallDirect v28, v11 function=f12
    v34 = CallDirect v11, v28 function=f12
    v35 = CallDirect function=f14
    v36 = CallDirect v28 function=f15
    v37 = CallDirect v11 function=f15
    v38 = NewClosure function=f15
    PropSet v0, v38 key="handedOut" mode=Strict
    Return
}

function f1 name="variableOfConcatenation" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = Builtin builtin=RegExp
    v2 = Construct v1, -, v0 @10
    Return v2
}

function f2 name="concatenationOfVariables" results=[{type=anything}] {
    v0 = String string="^"
    v1 = GetModuleVariable variable=g1
    v2 = String string="|"
    v3 = GetModuleVariable variable=g2
    v4 = String string="$"
    v5 = Strcat v0, v1, v2, v3, v4
    v6 = Builtin builtin=RegExp
    v7 = Construct v6, -, v5 @20
    Return v7
}

function f3 name="resultOfFunction" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = CallDirect v0 function=f5
    v2 = String string="i"
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v1, v2 @30
    Return v4
}

function f4 name="variableOfResults" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g3
    v1 = Builtin builtin=RegExp
    v2 = Construct v1, -, v0 @40
    Return v2
}

function f5 name="optional" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="(?:"
    v2 = String string=")?"
    v3 = Strcat v1, v0, v2
    Return v3
}

function f6 name="variableStoredTwice" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g4
    v1 = Builtin builtin=RegExp
    v2 = Construct v1, -, v0 @60
    Return v2
}

function f7 name="ownParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="b+"
    v2 = Strcat v1, v0
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v2 @70
    Return v4
}

function f8 name="secondCallOfFunction" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CallDirect v0 function=f5
    v2 = Builtin builtin=RegExp
    v3 = Construct v2, -, v1 @80
    Return v3
}

function f9 name="parameterWithTwoCallers" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="c+"
    v2 = Strcat v1, v0
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v2 @90
    Return v4
}

function f10 name="functionOfTheEngineOnKnownOperands" results=[{type=anything}] {
    v0 = String string="[a-z]+_[0-9]+"
    v1 = NewRegExp pattern="_" regExpFlags=[]
    v2 = String string="-"
    v3 = PropGet v0 key="replace"
    v4 = Call v3, v0, v1, v2
    v5 = String string="g"
    v6 = Builtin builtin=RegExp
    v7 = Upcast v4 castType=anything
    v8 = Construct v6, -, v7, v5 @100
    Return v8
}

function f11 name="sourceOfLiteralInVariable" results=[{type=anything}] {
    v0 = NewRegExp pattern="[0-9]+" regExpFlags=[Global]
    v1 = PropGet v0 key="source"
    v2 = String string="|d"
    v3 = Strcat v1, v2
    v4 = Builtin builtin=RegExp
    v5 = Undefined
    v6 = Upcast v3 castType=anything
    v7 = Construct v4, -, v6, v5 @110
    Return v7
}

function f12 name="twoParametersWithTwoCallersEach" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Strcat v0, v1
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v2 @120
    Return v4
}

function f13 name="orDefault" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=undefined
    Branch v1 -> taken b1(), notTaken b2(v0)
  b1():
    v2 = String string="z+"
    Jump -> next b2(v2)
  b2(v3: anything):
    Return v3
}

function f14 name="armThatTheKnownValueNeverTakes" results=[{type=anything}] {
    v0 = String string="e+"
    v1 = CallDirect v0 function=f13
    v2 = Builtin builtin=RegExp
    v3 = Construct v2, -, v1 @130
    Return v3
}

function f15 name="parameterOfFunctionThatIsHandedOut" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="h+"
    v2 = Strcat v1, v0
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v2 @140
    Return v4
}
