# The entry of a function that checks its parameter: behind the test the argument has another name.
function f9 name="ownFrameBehindTest" role=GenericEntrypoint flags=[HasThis] captures=[{type=f8}] results=[{type=anything}] derivation={source=f8} creator=Entrypoint{target=f8} {
  b0(v0: f8, v1: anything):
    v2 = GetRestLength
    v3 = GetArgument
    v4 = TypeTest v3 testedType=string
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5: string):
    v6 = CreateRest firstArgument=1
    v7 = CreateUnmappedArguments v2, v6, v5
    v8 = CallBuiltin v0, v1, v7 overload=FunctionPrototypeApply/0
    Return v8
  b2():
    Return v3
}
# CHECK-LABEL: function f9 name="ownFrameBehindTest"
# CHECK-NOT: CreateRest
# CHECK-NOT: CreateUnmappedArguments
# CHECK: v8: anything = CallForwardVarargs v0, v1
