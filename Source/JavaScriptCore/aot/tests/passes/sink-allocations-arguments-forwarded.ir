# f.apply(t, arguments) passes on the arguments without the object: the frame, the rest list, or the values by name
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"

function f0 name="restListIsEveryArgument" flags=[HasThis, HasArgumentCount, HasHiddenRest] captures=[{type=function}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: int[0, 4294967295], v3: Array):
    v4 = CreateUnmappedArguments v2, v3
    v5 = CallBuiltin v0, v1, v4 overload=FunctionPrototypeApply/0
    Return v5
}
# CHECK-LABEL: function f0 name="restListIsEveryArgument"
# CHECK-NOT: CreateUnmappedArguments
# CHECK-NOT: CallBuiltin
# CHECK: v5: anything = CallList v0, v1, v3

function f1 name="valuesAreNamed" parameters=[{type=function}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
