# Calls in the body of the entry module are inlined like any others, with the budget of code that runs once
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot only-passes=EstimateHeat,SummarizeForInlining,InlineCalls
# RUN: pipeline InlineCalls
# STATISTIC: InlineDecisionInline >= 3
# STATISTIC: InlineDecisionCostExceedsBenefit = 1
# STATISTIC: InlineDecisionBarrier = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = CallDirect v2 function=f1
    v4 = CallDirect v3 function=f2
    v5 = NewClosure function=f3
    v6 = PropGet v0 key="publish" [isFreeName]
    v7 = Call v6, -, v5, v4
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: inlineFrames=[{}, {callee=f1 {{*}}module=m0}] {
# CHECK-NOT: function=f1
# CHECK: [[square]]: number = CallDirect v3 function=f2
# CHECK-NOT: function=f1
# CHECK: = Mul v2, v2 @0:1
# CHECK-LABEL: function f1 name="oneOperation"

function f1 name="oneOperation" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Mul v0, v0
    Return v1
}

function f2 name="thirteenOperations" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Mul v0, v0
    v2 = Mul v1, v0
    v3 = Mul v2, v0
    v4 = Mul v3, v0
    v5 = Mul v4, v0
    v6 = Mul v5, v0
    v7 = Mul v6, v0
    v8 = Mul v7, v0
    v9 = Mul v8, v0
    v10 = Mul v9, v0
    v11 = Mul v10, v0
    v12 = Mul v11, v0
    v13 = Mul v12, v0
    Return v13
}

function f3 name="calledAnyNumberOfTimes" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v1 function=f2
    Return v2
}
# CHECK-LABEL: function f3 name="calledAnyNumberOfTimes"
# CHECK-NOT: CallDirect
# CHECK-COUNT-14: = Mul
# CHECK-NOT: CallDirect
# CHECK-LABEL: role=Library
# CHECK-LABEL: name="main" module=m0 kind=Module role=GenericEntrypoint
# CHECK: = CallDirect function=f0
