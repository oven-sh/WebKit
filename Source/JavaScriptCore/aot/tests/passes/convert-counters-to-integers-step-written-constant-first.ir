module m0 path="main.js" displayPath="main.js"
function f0 name="twoPlusCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v2, v3
    Jump -> next b1(v6)
  b3():
    Return
}
