# A step is a step whichever side of the sum the constant is written on
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 5
# STATISTIC: ConvertCountersToIntegersChanges = 5

module m0 path="main.js" displayPath="main.js"
function f0 name="twoPlusCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v2, v3
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[0, 101]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[first0]]: int[0, 99]):
# CHECK-NEXT: v6: int[2, 101] = Add v2, [[first0]]
}

function f1 name="counterPlusTwo" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[0, 101]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[last1]]: int[0, 99]):
# CHECK-NEXT: v6: int[2, 101] = Add [[last1]], v2
}

function f2 name="minusOnePlusCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=-1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v2, v3
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[0, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[first2]]: int[1, 100]):
# CHECK-NEXT: v6: int[0, 99] = Add v2, [[first2]]
}

function f3 name="twoPlusConvertedCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = ToNumeric v3
    v7 = Add v2, v6
    Jump -> next b1(v7)
  b3():
    Return
# CHECK: b1(v3: int[0, 101]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[first3]]: int[0, 99]):
# CHECK-NEXT: v6: int[0, 99] = ToNumeric [[first3]]
# CHECK-NEXT: v7: int[2, 101] = Add v2, v6
}

function f4 name="twoMinusCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v2, v3
    Jump -> next b1(v6)
  b3():
    Return
# It is no step. What is compared with an integer goes on along the staying edge all the same.
# CHECK: b1(v3: int[-97, 99]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[compared4]]: int[-97, 99]):
# CHECK-NEXT: v6: int[-97, 99] = Sub v2, [[compared4]]
}
