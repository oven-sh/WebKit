# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
