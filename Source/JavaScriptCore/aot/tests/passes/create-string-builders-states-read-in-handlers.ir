# A handler that reads the string as it was before the append, without taking it as an argument, goes on with the same builder
# FORM: Prepared
# RUN: pass CreateStringBuilders
# STATISTIC: StringBuildersCreated = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="appendsInTryAndCatch" parameters=[{type=string}, {type=number}] results=[{type=string}] {
    v2 = String string=""
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b5()
  b2() handler=b3():
    v8 = Add v4, v0
    Jump -> next b4(v8)
  b3() role=CatchHandler:
    v9 = String string="T"
    v10 = Add v4, v9
    Jump -> next b4(v10)
  b4(v11):
    v12 = Integer integer=1
    v13 = Add v5, v12
    Jump -> next b1(v11, v13)
  b5():
    Return v4
}
# CHECK-LABEL: name="appendsInTryAndCatch"
# CHECK: [[h0]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: Jump -> next b1([[h0]], v3)
# CHECK: b1(v4: stringbuilder, v5: int|whole):
# CHECK: b2() handler=b3():
# CHECK-NEXT: StringBuilderAppend v4, v0
# CHECK-NEXT: Jump -> next b4(v4)
# CHECK: b3() role=CatchHandler:
# CHECK-NEXT: v9: "T" = String string="T"
# CHECK-NEXT: StringBuilderAppend v4, v9
# CHECK-NEXT: Jump -> next b4(v4)
# CHECK: b4(v11: stringbuilder):
# CHECK: [[r0]]: string = StringBuilderFinish v4
# CHECK-NEXT: Return [[r0]]
# CHECK-NOT: StringBuilderBegin
# CHECK-NOT: StringBuilderToString

