function f3 name="throwsBehindTheAppend" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=string}] {
    v3 = String string=""
    v4 = Integer integer=0
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v6, v1
    Branch v8 -> taken b2(), notTaken b5()
  b2() handler=b3():
    v9 = Add v5, v0
    v10 = Call v2, -
    Jump -> next b4(v9)
  b3() role=CatchHandler:
    v11 = String string="T"
    v12 = Add v5, v11
    Jump -> next b4(v12)
  b4(v13):
    v14 = Integer integer=1
    v15 = Add v6, v14
    Jump -> next b1(v13, v15)
  b5():
    Return v5
}
# The call may throw when the append is done, and then the handler wants the text without it.
# CHECK-LABEL: name="throwsBehindTheAppend"
# CHECK-NOT: StringBuilder
# CHECK: v9: string = Add v5, v0
# CHECK: v12: string = Add v5, v11
# CHECK-NOT: StringBuilder

