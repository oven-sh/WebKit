    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b7()
  b2() handler=b3():
    v8 = Add v4, v0
    v9 = Integer integer=0
    v10 = Undefined
    Jump -> next b4(v9, v10, v8)
  b3() role=CleanupHandler:
    v11 = CatchValue
    v12 = Integer integer=1
    Jump -> next b4(v12, v11, v4)
  b4(v13, v14, v15):
    v16 = String string="F"
    v17 = Add v15, v16
    Switch v13 cases=[0] -> case b5(), otherwise b6()
  b5():
    v18 = Integer integer=1
