# A locked built-in that a function past the work limit only holds and reads is not written, so the build reports nothing, though the object counts as reaching unknown JavaScript
# OPTIONS: limit=MaxFlowWorkPerFunction:120
# LOSS: MaxFlowWorkPerFunction f1
# RUN: pipeline CheckLockedBuiltinWrites
# RUN(FLOW): flow
# FLOW: unseen-code LimitReached f1
# FLOW-NOT: builtin-location ObjectPrototype.{{*}}written at

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="BusyBox" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="busy" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = PropGet v0 key="x"
