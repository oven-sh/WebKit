# The dump of an inlining summary lists the switches on parameters
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SummarizeForInlining
# LOSS: MaxInlineHeadBytes

module m0 path="main.js" displayPath="main.js"

function f0 name="byNumber" parameters=[{type=int}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 7] -> case b1(), case b2(), otherwise b3()
  b1():
    v2 = Mul v1, v1
    Return v2
  b2():
    v3 = Mul v1, v1
    v4 = Mul v3, v1
    Return v4
  b3():
    Return v1
}
# CHECK: f0: barrier=None{{*}} switch(p0 0=12 7=20 otherwise=4)
