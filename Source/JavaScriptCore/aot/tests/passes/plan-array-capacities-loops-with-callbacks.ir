# The helper that every program has: `result = []; for (i = 0; i < array.length; i++) result.push(f(array[i]))`. The literal is made with room for array.length elements:
# a callback is predicted not to change the array that is walked for it, the loop that only unlikely paths close is predicted not to go round,
# and the test for null in front of the first `array.length` is made in front of the literal where nothing that anybody could tell lies in between
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# STATISTIC: ArrayCapacitiesPlanned = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="callbackInLoop" parameters=[{type=Array<anything>}, {type=anything}] results=[{type=Array<anything>}] {
  b0(v0: Array<anything>, v1: anything):
    v2 = NewArray contents=anything
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = CallBuiltin v0 overload=ArrayPrototypeLength/0 builtinCallForm=Whole
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = Call v1, -, v8
    v10 = CallBuiltin v2, v9 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v11 = Integer integer=1
    v12 = Add v8, v11
    Jump -> next b1(v12)
  b3():
    Return v2
}
