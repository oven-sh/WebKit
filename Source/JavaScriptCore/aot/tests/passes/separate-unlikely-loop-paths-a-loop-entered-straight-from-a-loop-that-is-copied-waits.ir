# for (..) last = table.step; for (..) last = table.size, where the first loop leaves straight into the head of the second: the one edge that enters the second starts in a block of the first.
# All the loops of a function are planned and then copied together. Copied beside the second, the first would leave from its copies into the head of the second, past the questions that are asked
# on that one edge, and the second would read answers that were never asked for. So the two are not copied in one round: the second goes first, and the first waits until the edge leads to the questions.
# In `apart` a block stands between the loops, and both are copied in one round. In each function both loops are entered by answers.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsEnteredByAnswers = 4

module m0 path="main.js" displayPath="main.js"

function f0 name="straight" parameters=[{type=object}, {type=i32}] results=[{type=anything}] {
  b0(v0: object, v1: i32):
    v2 = Integer integer=0
    v3 = Undefined
    Jump -> next b1(v2, v3)
  b1(v4: i32, v5: anything):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(), notTaken b3(v2, v5)
  b2():
    v8 = PropGet v0 key="step"
    v9 = Integer integer=1
    v10 = Add v4, v9
    v11 = BitOr v10, v2
    Jump -> next b1(v11, v8)
  b3(v12: i32, v13: anything):
    LoopHint
    v15 = Less v12, v1
    Branch v15 -> taken b4(), notTaken b5()
  b4():
    v16 = PropGet v0 key="size"
    v17 = Integer integer=1
    v18 = Add v12, v17
    v19 = BitOr v18, v2
    Jump -> next b3(v19, v16)
  b5():
    Return v13
# CHECK: = GetCachedValue {{*}} key="size"
# CHECK: = GetCachedValue {{*}} key="step"
}

function f1 name="apart" parameters=[{type=object}, {type=i32}] results=[{type=anything}] {
  b0(v0: object, v1: i32):
    v2 = Integer integer=0
    v3 = Undefined
    Jump -> next b1(v2, v3)
  b1(v4: i32, v5: anything):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = PropGet v0 key="step"
    v9 = Integer integer=1
    v10 = Add v4, v9
    v11 = BitOr v10, v2
    Jump -> next b1(v11, v8)
  b3():
    Jump -> next b4(v2, v5)
  b4(v12: i32, v13: anything):
    LoopHint
    v15 = Less v12, v1
    Branch v15 -> taken b5(), notTaken b6()
  b5():
    v16 = PropGet v0 key="size"
    v17 = Integer integer=1
    v18 = Add v12, v17
    v19 = BitOr v18, v2
    Jump -> next b4(v19, v16)
  b6():
    Return v13
# CHECK: = GetCachedValue {{*}} key="size"
# CHECK: = GetCachedValue {{*}} key="step"
}
