# A call with a list of arguments becomes a call with arguments where no callee can count them: each parameter gets its element of the list. A list too long to be passed keeps the call that throws
# FORM: Prepared
# RUN: pass ResolveCalls
# RUN(TWICE): pass ResolveCalls ResolveCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Shape" constructor=f4 flow={baseState=None members=[L0, L1]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
layout L1 kind=Instance name="Circle" base=L0 constructor=f5 flags=[HasHeritage] flow={baseState=Layout base=L0 members=[L1]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed}
function f0 name="two" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
function f1 name="one" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f2 name="usesArguments" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: Array<anything>):
    Return v0
}
function f3 name="collects" flags=[HasRestParameter] parameters=[{type=Array<anything>}] results=[{type=anything}] {
    Return v0
}
function f4 name="Shape" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}, {type=anything}] results=[{type=L0|L1}] {
    v3 = GetConstructPrototype v0 layout=L0
    v4 = NewObject v3 layout=L0
    v5 = AssumeType v4 castType=L0|L1
    Return v5
}
function f5 name="Circle" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]

function f6 name="oneCallee" parameters=[{type=f0}, {type=anything}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v3 = CallList v0, v1, v2
    Return v3
# CHECK: [[length6]]: {{*}} = PropGet v2 key="length"
# CHECK-NEXT: [[count6]]: {{*}} = ToLength [[length6]]
# CHECK-NEXT: [[limit6]]: 65535 = Integer integer=65535
# CHECK-NEXT: [[fits6]]: boolean = LessEq [[count6]], [[limit6]]
# CHECK-NEXT: Branch [[fits6]] ->
# CHECK: [[zero6]]: 0 = Integer
# CHECK-NEXT: [[first6]]: anything = ElemGet v2, [[zero6]] [keyIsIntegral]
# CHECK-NEXT: [[one6]]: 1 = Integer integer=1
# CHECK-NEXT: [[second6]]: anything = ElemGet v2, [[one6]] [keyIsIntegral]
# CHECK-NEXT: anything = Call v0, v1, [[first6]], [[second6]]
# CHECK: frequency=Rare:
# CHECK-NEXT: anything = CallList v0, v1, v2
# TWICE: = CallDirect {{*}} function=f0
# TWICE: frequency=Rare:
# TWICE-NEXT: = CallList v0, v1, v2
# TWICE-NOT: CallList
}

function f7 name="longestParameterListCounts" parameters=[{type=f0|f1}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
}
# CHECK-LABEL: function f7 name="longestParameterListCounts"
# TWICE-LABEL: function f7 name="longestParameterListCounts"
# CHECK-COUNT-2: = ElemGet v1,
# CHECK-NEXT: anything = Call v0, -, {{*}}, {{*}}

function f8 name="superCallForwardsList" parameters=[{type=f4}, {type=anything}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v3 = SuperConstructList v0, v1, v2 layout=L1
    Return v3
# CHECK-COUNT-2: = ElemGet v2,
# CHECK-NEXT: = SuperConstruct v0, v1, {{*}}, {{*}} layout=L1
# CHECK: frequency=Rare:
# CHECK-NEXT: = SuperConstructList v0, v1, v2 layout=L1
# TWICE: = CallDirect v1, {{*}}, {{*}} function=f4 [isConstruction]
# TWICE-NOT: = SuperConstruct v0
}

function f9 name="constructsWithList" parameters=[{type=f4}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = ConstructList v0, -, v1
    Return v2
# CHECK-COUNT-2: = ElemGet v1,
# CHECK-NEXT: anything ~ object = Construct v0, -, {{*}}, {{*}}
# CHECK: frequency=Rare:
# CHECK-NEXT: = ConstructList v0, -, v1
}

function f10 name="calleeUsesArguments" parameters=[{type=f2}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f11 name="calleeCollectsRest" parameters=[{type=f3}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f12 name="oneOfTwoCalleesCounts" parameters=[{type=f0|f2}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f13 name="listMayHaveAccessors" parameters=[{type=f0}, {type=Array<anything, pristine[Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f14 name="listMayBeOfSubclass" parameters=[{type=f0}, {type=Array<anything, pristine[Storage]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f15 name="unknownCallee" parameters=[{type=function}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f16 name="calleeMayBeBuiltin" parameters=[{type=f0|builtin(MathMax)}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
}

function f17 name="mustLeaveByTheCall" parameters=[{type=f0}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    ReturnCall v2 requirement=Required
# CHECK-NOT: ElemGet
# CHECK: v2: anything = CallList v0, -, v1
# CHECK-NEXT: ReturnCall v2
}

function f18 name="mayLeaveByTheCall" parameters=[{type=f0}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = CallList v0, -, v1
    ReturnCall v2 requirement=Allowed
# CHECK-COUNT-2: = ElemGet v1,
# CHECK-NEXT: [[returned18]]: anything = Call v0, -, {{*}}, {{*}} [isDemotedTailCall]
# CHECK-NEXT: Return [[returned18]]
# CHECK: frequency=Rare:
# CHECK-NEXT: [[left18]]: anything = CallList v0, -, v1
# CHECK-NEXT: ReturnCall [[left18]] requirement=Allowed
}

function f19 name="inRareBlock" parameters=[{type=f0}, {type=Array<anything, pristine[Storage, Names]>}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v3 = CallList v0, -, v1
    Return v3
  b2():
    Return v2
# CHECK-NOT: ElemGet
# CHECK: v3: anything = CallList v0, -, v1
}
