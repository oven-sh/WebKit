# What an overload does with an operand comes from the table, so an overload that is a host call shares a literal like an inline one
# FORM: Prepared
# RUN: pass ShareRegExpLiterals
# STATISTIC: ShareRegExpLiteralsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="copiedByConstructor" results=[{type=RegExp}] {
    v0 = NewRegExp pattern="a"
    v1 = String string="g"
    v2 = CallBuiltin -, v0, v1 overload=RegExp/5
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f1 name="mayBeReturnedByCall" results=[{type=RegExp}] {
    v0 = NewRegExp pattern="a"
    v1 = String string="g"
    v2 = CallBuiltin -, v0, v1 overload=RegExp/1
    Return v2
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f2 name="globalCopiedByConstructor" results=[{type=RegExp}] {
    v0 = NewRegExp pattern="a" regExpFlags=[Global]
    v1 = CallBuiltin -, v0 overload=RegExp/5
    Return v1
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f3 name="hostCallReadsLastIndex" parameters=[{type=string}] results=[{type=anything}] {
    v1 = NewRegExp pattern="a"
    v2 = CallBuiltin v0, v1 overload=StringPrototypeMatchAll/0
    Return v2
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}
