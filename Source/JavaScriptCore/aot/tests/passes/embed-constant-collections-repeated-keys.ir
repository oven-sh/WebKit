# A repeated key keeps its first position and, in a Map, takes its last value, and keys are compared as the constructor compares them
# FORM: Prepared
# RUN: pass EmbedConstantCollections
# STATISTIC: ConstantCollectionsEmbedded = 14
# CHECK: table 0 keys: [String("x") String("y")]
# CHECK-NEXT: table 1 keys: [Number(0)]
# CHECK-NEXT: table 2 keys: [Number(0) Number(1)]
# CHECK-NEXT: table 2 values: [String("last") String("one")]
# CHECK-NEXT: table 3 keys: [String("k")]
# CHECK-NEXT: table 3 values: [Number(-0)]
# CHECK-NEXT: table 4 keys: [String("k")]
# CHECK-NEXT: table 4 values: [Number(0)]
# CHECK-NEXT: table 5 keys: [String("k") String("j")]
# CHECK-NEXT: table 5 values: [Number(3) Number(2)]
# CHECK-NEXT: table 6 keys: [Number(NaN) Number(1)]
# CHECK-NEXT: table 7 keys: [Undefined() Null() Boolean(true) BigInt("7") Boolean(false)]
# CHECK-NEXT: table 8 keys: [Number(0) String("0") String("-0") String("a") String("A")]
# CHECK-NEXT: table 9 keys: [String("k") String("j")]
# CHECK-NEXT: table 9 values: [Number(1) Number(1)]
# CHECK-NEXT: table 10 keys: [String("a") String("b")]
# CHECK-NEXT: table 11 keys: [Number(5) Number(4294967296)]
# CHECK-NEXT: outcome: Changed
# RUN(AGAIN): pass EmbedConstantCollections EmbedConstantCollections
# AGAIN: outcome: Changed
# AGAIN: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
data d0 root=Array{contents=string elements=[String{value="x"}, String{value="y"}]} module=m0
data d1 root=Array{contents=string elements=[String{value="a"}, String{value="b"}, String{value="a"}]} module=m0
function f0 name="negativeZeroThenZero" results=[{type=Set<number>}] {
  b0():
    v0 = Double number=-0
    v1 = Integer integer=0
    v2 = NewArray v0, v1 contents=number
    v3 = CallBuiltin -, v2 overload=Set/2 builtinCallForm=Whole
    Return v3
}
