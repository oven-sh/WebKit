# `{ c: { d: 1 } }` makes one object. Where nobody ever holds the inner object its fields become private fields of the outer layout and the field goes away.
# Anywhere else the field stays and its slot defers the inner object: the allocation of the inner object stays as the list of what goes into the room of the outer one (isMadeOnDemand),
# what only reads and stores slots borrows the outer object (GetFlattenedSlot), and whatever wants the object itself reads the slot with the operation that makes it.
# TODO: flatten: the form that keeps the slot is off since 10-21 00:45, until every folder of test programs is right with it taken wherever it is legal
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass FlattenInnerObjects
# STATISTIC: FieldsHoldingFlattenedObjects = 1
# STATISTIC: FieldsDeferringFlattenedObjects = 4
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="NeverHeld" fields=[{key="c" declared={type=L1} flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=OnlyAccessed} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, ChangeIntegrity] keys=NeverEnumerated}
layout L1 name="InnerOfNeverHeld" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L2 name="HeldNowAndThen" fields=[{key="c" declared={type=L3} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L3 name="InnerOfHeldNowAndThen" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L4 name="StoredAgain" fields=[{key="c" declared={type=L5} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L5 name="InnerOfStoredAgain" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L6 name="ReadByNameSomewhere" fields=[{key="n" declared={type=L7} flags=[IsRequired] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=OnlyAccessed} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, ChangeIntegrity] keys=NeverEnumerated}
layout L7 name="InnerOfReadByNameSomewhere" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L8 name="SharesItsInnerObject" fields=[{key="s" declared={type=L9} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L9 name="Shared" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L10 name="HeldAsOftenAsBorn" fields=[{key="h" declared={type=L11} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L11 name="InnerOfHeldAsOftenAsBorn" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L12 name="TestedBehindAHolder" fields=[{key="t" declared={type=L13} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L13 name="InnerOfTestedBehindAHolder" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}

# CHECK: layout L0 name="NeverHeld" {{*}}key=#"c.d"@L0
# CHECK: layout L2 name="HeldNowAndThen" {{*}}deferral=FlattenedObject{{*}}flattenedObjects=[{layout=L3 fields=[0]}]
# CHECK: layout L4 name="StoredAgain" {{*}}deferral=FlattenedObject
# CHECK: layout L6 name="ReadByNameSomewhere" {{*}}deferral=FlattenedObject
# CHECK: layout L8 name="SharesItsInnerObject"
# CHECK-NOT: deferral
# CHECK: layout L10 name="HeldAsOftenAsBorn"
# CHECK-NOT: deferral
# CHECK: layout L12 name="TestedBehindAHolder" {{*}}deferral=FlattenedObject
# CHECK: function f0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Double number=0.5
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v1 function=f2
    v3 = CallDirect v0 function=f3
    v4 = CallDirect v3 function=f4
    v5 = CallDirect v3 function=f5
    v6 = CallDirect v3 function=f6
    v7 = CallDirect v0 function=f7
    v8 = CallDirect v7, v0 function=f8
    v9 = CallDirect v0 function=f9
    v10 = CallDirect v9 function=f10
    v11 = CallDirect v0 function=f11
    v12 = CallDirect v0 function=f3
    v13 = CallDirect v0 function=f3
    v14 = CallDirect v0 function=f3
    v15 = CallDirect v0 function=f12
    v16 = CallDirect v15 function=f13
    v17 = CallDirect v0 function=f15
    v18 = CallDirect v17 function=f14
    v19 = CallDirect v0 function=f15
    v20 = CallDirect v0 function=f15
    v21 = CallDirect v0 function=f15
    Return
}

function f1 name="makeNeverHeld" parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    Return v2
}
# CHECK-LABEL: function f1 name="makeNeverHeld"
# CHECK-NOT: layout=L1
# CHECK: = NewObject -, v0 layout=L0 fields=[1]

function f2 name="readNeverHeld" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="c" receivers=[L0] level=Proven
    v2 = GetSlot v1 key="d" receivers=[L1] level=Proven
    Return v2
}
# CHECK-LABEL: function f2 name="readNeverHeld"
# CHECK: = GetSlot v0 key=#"c.d"@L0 receivers=[L0]

function f3 name="makeHeldNowAndThen" parameters=[{type=number}] results=[{type=L2}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L3 fields=[0]
    v2 = Add v0, v0
    v3 = NewObject -, v1 layout=L2 fields=[0]
    Return v3
}
# The list stands right in front of the allocation that takes it.
# CHECK-LABEL: function f3 name="makeHeldNowAndThen"
# CHECK: = Add v0, v0
# CHECK-NEXT: [[innerOf3]]:{{*}}= NewObject -, v0 layout=L3 fields=[0] {{*}}[isMadeOnDemand]
# CHECK-NEXT: = NewObject -, [[innerOf3]] layout=L2 fields=[0]

function f4 name="borrows" parameters=[{type=L2}] results=[{type=number}] {
  b0(v0: L2):
    v1 = GetSlot v0 key="c" receivers=[L2] level=Proven
    v2 = GetSlot v1 key="d" receivers=[L3] level=Proven
    PutSlot v1, -, v2 key="d" receivers=[L3] level=Proven
    Return v2
}
# CHECK-LABEL: function f4 name="borrows"
# CHECK: [[innerOf4]]:{{*}}= GetFlattenedSlot v0 key="c" receivers=[L2]
# CHECK-NEXT: = GetSlot [[innerOf4]] key="d" receivers=[L3]
# CHECK-NEXT: PutSlot [[innerOf4]], -,
# CHECK-NOT: GetDeferredClosureSlot

function f5 name="holdsOnOnePath" parameters=[{type=L2}] results=[{type=number}] {
  b0(v0: L2):
    v1 = GetSlot v0 key="c" receivers=[L2] level=Proven
    v2 = GetSlot v1 key="d" receivers=[L3] level=Proven
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v1 variable=g0
    Jump -> next b2()
  b2():
    v5 = GetSlot v1 key="d" receivers=[L3] level=Proven
    Return v5
}
# Whoever holds the object makes it where he stands. What borrows it behind that reads the slot again.
# CHECK-LABEL: function f5 name="holdsOnOnePath"
# CHECK: b0(
# CHECK: [[innerOf5]]:{{*}}= GetFlattenedSlot v0 key="c"
# CHECK-NEXT: = GetSlot [[innerOf5]] key="d"
# CHECK: b1():
# CHECK-NEXT: [[madeOf5]]:{{*}}= GetDeferredClosureSlot v0 key="c"
# CHECK-NEXT: PutModuleVariable [[madeOf5]]
# CHECK: b2():
# CHECK-NEXT: [[againOf5]]:{{*}}= GetFlattenedSlot v0 key="c"
# CHECK-NEXT: = GetSlot [[againOf5]] key="d"

function f6 name="usesBehindUnknownCode" parameters=[{type=L2}] results=[{type=number}] {
  b0(v0: L2):
    v1 = GetSlot v0 key="c" receivers=[L2] level=Proven
    v2 = GetModuleVariable variable=g0
    v3 = Call v2
    v4 = GetSlot v1 key="d" receivers=[L3] level=Proven
    Return v4
}
# The call may store another object to the field, and the name stands for the one that was read.
# CHECK-LABEL: function f6 name="usesBehindUnknownCode"
# CHECK: [[madeOf6]]:{{*}}= GetDeferredClosureSlot v0 key="c"
# CHECK: = GetSlot [[madeOf6]] key="d"
# CHECK-NOT: GetFlattenedSlot

function f7 name="makeStoredAgain" parameters=[{type=number}] results=[{type=L4}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L5 fields=[0]
    v2 = NewObject -, v1 layout=L4 fields=[0]
    Return v2
}

function f8 name="storesFreshObject" parameters=[{type=L4}, {type=number}] results=[{type=undefined}] {
  b0(v0: L4, v1: number):
    v2 = NewObject -, v1 layout=L5 fields=[0]
    PutSlot v0, -, v2 key="c" receivers=[L4] level=Proven
    v4 = Undefined
    Return v4
}
# CHECK-LABEL: function f8 name="storesFreshObject"
# CHECK: [[innerOf8]]:{{*}}= NewObject -, v1 layout=L5 fields=[0] {{*}}[isMadeOnDemand]
# CHECK-NEXT: PutSlot v0, -, [[innerOf8]] key="c"

function f9 name="makeReadByNameSomewhere" parameters=[{type=number}] results=[{type=L6}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L7 fields=[0]
    v2 = NewObject -, v1 layout=L6 fields=[0]
    Return v2
}

function f10 name="readsByName" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="n"
    Return v1
}
# An operation that goes by the name alone may meet the object, so the field does not go away.
# CHECK-LABEL: function f10 name="readsByName"
# CHECK: = PropGet v0 key="n"

function f11 name="twoObjectsListOne" parameters=[{type=number}] results=[{type=L8}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L9 fields=[0]
    v2 = NewObject -, v1 layout=L8 fields=[0]
    v3 = NewObject -, v1 layout=L8 fields=[0]
    Return v3
}
# CHECK-LABEL: function f11 name="twoObjectsListOne"
# CHECK-NOT: isMadeOnDemand

function f12 name="makeHeldAsOftenAsBorn" parameters=[{type=number}] results=[{type=L10}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L11 fields=[0]
    v2 = NewObject -, v1 layout=L10 fields=[0]
    Return v2
}
# An object that is made after all has left its slots in the outer object for nothing.
# CHECK-LABEL: function f12 name="makeHeldAsOftenAsBorn"
# CHECK-NOT: isMadeOnDemand

function f13 name="holds" parameters=[{type=L10}] results=[{type=undefined}] {
  b0(v0: L10):
    v1 = GetSlot v0 key="h" receivers=[L10] level=Proven
    PutModuleVariable v1 variable=g0
    v3 = Undefined
    Return v3
}
# CHECK-LABEL: function f13 name="holds"
# CHECK: = GetSlot v0 key="h"

function f14 name="testsBehindAHolder" parameters=[{type=L12}] results=[{type=number}] {
  b0(v0: L12):
    v1 = GetSlot v0 key="t" receivers=[L12] level=Proven
    PutModuleVariable v1 variable=g0
    v3 = IsSlotFilled v1 key="d" receivers=[L13] level=Expected
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: guard):
    v5 = GetSlot v1, v4 key="d" receivers=[L13] level=Expected
    Return v5
  b2():
    v6 = Double number=0.5
    Return v6
}
# The test and the read that relies on it each read the slot again, and still name one object: ReadAgain is a cast of the first name.
# CHECK-LABEL: function f14 name="testsBehindAHolder"
# CHECK: [[firstOf14]]:{{*}}= GetFlattenedSlot v0 key="t"
# CHECK: [[madeOf14]]:{{*}}= GetDeferredClosureSlot v0 key="t"
# CHECK-NEXT: PutModuleVariable [[madeOf14]]
# CHECK-NEXT: [[secondOf14]]:{{*}}= GetFlattenedSlot v0 key="t"
# CHECK-NEXT: [[testedOf14]]:{{*}}= ReadAgain [[firstOf14]], [[secondOf14]]
# CHECK-NEXT: = IsSlotFilled [[testedOf14]] key="d"
# CHECK: b1(v4: guard):
# CHECK-NEXT: [[thirdOf14]]:{{*}}= GetFlattenedSlot v0 key="t"
# CHECK-NEXT: [[readOf14]]:{{*}}= ReadAgain [[firstOf14]], [[thirdOf14]]
# CHECK-NEXT: = GetSlot [[readOf14]], v4 key="d"

function f15 name="makeTestedBehindAHolder" parameters=[{type=number}] results=[{type=L12}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L13 fields=[0]
    v2 = NewObject -, v1 layout=L12 fields=[0]
    Return v2
}
