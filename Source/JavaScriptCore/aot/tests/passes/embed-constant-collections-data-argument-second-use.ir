# An array from a data record with a use besides the constructor is created, and the constructor iterates it
# FORM: Prepared
# RUN: pass EmbedConstantCollections
# STATISTIC: ConstantCollectionsEmbedded = 2
# CHECK: table 0 keys: [String("a") String("b")]
# CHECK-NEXT: outcome: Changed

module m0 path="main.js" displayPath="main.js"
data d0 root=Array{contents=string elements=[String{value="a"}, String{value="b"}]} module=m0

function f0 name="oneArrayForEachSet" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Data data=d0
    v2 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    v3 = Data data=d0
    v4 = CallBuiltin -, v3 overload=Set/2 builtinCallForm=Whole
    v5 = Call v0, -, v2, v4
    Return v5
# CHECK-NOT: = Data
# CHECK: [[first]]:{{*}}= NewSetFromData data=d0
# CHECK-NEXT: [[second]]:{{*}}= NewSetFromData data=d0
# CHECK-NEXT: = Call v0, -, [[first]], [[second]]
}

function f1 name="oneArrayForTwoSets" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Data data=d0
    v2 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    v3 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    v4 = Call v0, -, v2, v3
    Return v4
# CHECK-NOT: FromData
# CHECK: v1:{{*}}= Data data=d0
# CHECK-NEXT: = CallBuiltin -, v1 overload=Set/2
# CHECK-NEXT: = CallBuiltin -, v1 overload=Set/2
# CHECK-NOT: FromData
}

function f2 name="passedToCallFirst" parameters=[{type=anything}] results=[{type=Set<string>}] {
    v1 = Data data=d0
    v2 = Call v0, -, v1
    v3 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    Return v3
# CHECK-NOT: FromData
# CHECK: v1:{{*}}= Data data=d0
# CHECK: = CallBuiltin -, v1 overload=Set/2
# CHECK-NOT: FromData
}

function f3 name="returnedAfterwards" results=[{type=Array<string>}] {
    v0 = Data data=d0
    v1 = CallBuiltin -, v0 overload=Set/2 builtinCallForm=Whole
    Return v0
# CHECK-NOT: FromData
# CHECK: v0:{{*}}= Data data=d0
# CHECK-NEXT: = CallBuiltin -, v0 overload=Set/2
# CHECK-NEXT: Return v0
}

function f4 name="castIsUsedAgain" results=[{type=anything}] {
    v0 = Data data=d0
    v1 = Upcast v0 castType=anything
    v2 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    Return v1
# CHECK-NOT: FromData
# CHECK: v0:{{*}}= Data data=d0
# CHECK-NEXT: = Upcast v0
# CHECK-NEXT: = CallBuiltin -, v1 overload=Set/2
# CHECK-NEXT: Return v1
}

function f5 name="passedAlongAnEdge" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = Data data=d0
    v2 = CallBuiltin -, v1 overload=Set/2 builtinCallForm=Whole
    Branch v0 -> taken b1(v1), notTaken b1(v2)
  b1(v3):
    Return v3
# CHECK-NOT: FromData
# CHECK: v1:{{*}}= Data data=d0
# CHECK-NEXT: = CallBuiltin -, v1 overload=Set/2
# CHECK-NOT: FromData
# CHECK: data d0
# CHECK-NOT: data d1
}
