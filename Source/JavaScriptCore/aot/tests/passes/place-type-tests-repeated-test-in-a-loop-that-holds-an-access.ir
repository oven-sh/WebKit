# for (..) { sink = typeof mode === "string" ? mode.length : mode | 0; sink = item.weight }: the test of `mode` comes out the same in every round, and both answers occur among the calls.
# In front of the loop it would send every round of the calls on which it fails through the copy of the failed tests, where nothing else is tested either: the read of `item.weight` would go by name there.
# So the test stays in the loop, where it is one comparison a round. The same loop without the read loses nothing in the copy: there one test in front decides for all the rounds.
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
variable g0 name="sink" declared={type=anything} initialization=Undefined
layout L0 name="Item" fields=[{key="weight" declared={type=number} flags=[IsRequired]}]

function f0 name="loopHoldsRead" parameters=[{type=number|string}, {type=boolean}, {type=L0 flags=[IsExpected]}] results=[{type=undefined}] {
  b0(v0: number|string, v1: boolean, v2: anything ~ L0):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = TypeTest v0 testedType=string
    Branch v4 -> taken b2(| 0), notTaken b3(| 0)
  b2(v5):
    v6 = GetStringLength v5
    Jump -> next b4(v6)
  b3(v7):
    v8 = ToInt32 v7
    Jump -> next b4(v8)
  b4(v9):
    PutModuleVariable v9 variable=g0
    v11 = PropGet v2 key="weight"
    PutModuleVariable v11 variable=g0
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return
}
# CHECK-LABEL: function f0 name="loopHoldsRead"
# CHECK-NOT: TypeTest v0
# CHECK: LoopHint
# CHECK: = TypeTest v0 testedType=string

function f1 name="loopHoldsNone" parameters=[{type=number|string}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: number|string, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4):
    v5 = GetStringLength v4
    Jump -> next b4(v5)
  b3(v6):
    v7 = ToInt32 v6
    Jump -> next b4(v7)
  b4(v8):
    PutModuleVariable v8 variable=g0
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return
}
# CHECK-LABEL: function f1 name="loopHoldsNone"
# CHECK: b0(v0: number|string, v1: boolean):
# CHECK: = TypeTest v0 testedType=string
# CHECK: LoopHint
