# A block without a handler in which nothing may throw merges into its covered predecessor, and the result keeps the handler. An allocation that fails throws where it stands.
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 4
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="callee" results=[{type=number}] {
    v0 = Integer integer=1
    Return v0
}

function f1 name="successorOnlyReturns" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Return v1
}

function f2 name="successorComputesNumbers" parameters=[{type=function}, {type=number}] results=[{type=anything}] {
  b0(v0: function, v1: number) handler=b2(v1):
    v2 = Call v0
    Jump -> next b1()
  b1():
    v3 = Add v1, v1
    v4 = Negate v3
    Return v4
  b2(v5) role=CatchHandler:
    v6 = CatchValue
    Return v5
# CHECK: b0(v0: function, v1: number) handler=b2(v1):
# CHECK-NEXT: = Call v0
# CHECK-NEXT: = Add v1, v1
# CHECK-NEXT: = Negate v3
# CHECK-NEXT: Return v4
}

function f3 name="parameterTakesItsArgument" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1(v1)
  b1(v2):
    v3 = TypeTest v2 testedType=number
    Return v3
  b2() role=CatchHandler:
    v4 = CatchValue
    Return v4
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: = TypeTest v1 testedType=number
# CHECK-NEXT: Return v3
}

function f4 name="successorCalls" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    v2 = Call v0, -, v1
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: = Call v0, -, v1
}

function f5 name="successorThrows" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Throw v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: Throw v1
}

function f6 name="successorHasCastThatMayThrow" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    v2 = RequireObjectCoercible v1 nullishAccess=Read name="x"
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# CHECK: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: = RequireObjectCoercible v1
}

function f7 name="successorEndsInTailCall" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    v2 = CallDirect function=f0
    ReturnCall v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# CHECK: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: = CallDirect function=f0
# CHECK-NEXT: ReturnCall v2
}

function f8 name="successorChecks" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    v2 = Check v1 expectedType=number
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# A check that fails throws nothing.
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: = Check v1 expectedType=number
# CHECK-NEXT: Return v2
}

function f9 name="successorAllocates" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    v2 = NewClosure function=f0
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
# CHECK: b0(v0: function) handler=b2():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: = NewClosure function=f0
}
