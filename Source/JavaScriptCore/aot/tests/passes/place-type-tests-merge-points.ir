# The generic copy comes back, without a test, where the tested code knows nothing more than the copy: f3 and f4 follow that rule.
# Proofs of one condition that reach a use over two paths merge in a block parameter, and so do values defined in a copied stretch where the copy comes back
# FORM: Prepared
# RUN(PLAN): test-placement
# RUN(IR): pass PlaceTypeTests
# STATISTIC: StretchesNotClonable = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="a" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="testsOnBothArms" parameters=[{type=L0 flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = PropGet v0 key="a"
    Jump -> next b3()
  b2():
    v3 = PropGet v0 key="b"
    Jump -> next b3()
  b3():
    v4 = PropGet v0 key="a"
    Return v4
}
