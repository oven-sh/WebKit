# A hot loop that counts from a constant to a constant a few steps away is fully unrolled: no back edge is left
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass UnrollShortLoops
# LOSS: MaxInlineHeadBytes

module m0 path="main.js" displayPath="main.js"
function f0 name="twoTurns" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Integer integer=2
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v3, v0
    v9 = Increment v4
    Jump -> next b1(v8, v9)
  b3():
    Return v3
# CHECK: Jump -> next [[first]](v1, v2)
# CHECK: b1(v3: int|whole, v4: int|whole):
# CHECK-NOT: LoopHint
# CHECK: Branch v7 -> taken b2(), notTaken b3(v3)
# CHECK: b2():
# CHECK: Jump -> next [[never]]()
# CHECK: b3([[sum]]: int|whole):
# CHECK-NEXT: Return [[sum]]
# CHECK: [[body1]]():
# CHECK: Jump -> next [[second]](
# CHECK: [[first]]([[sum1]]: int|whole, [[counter1]]: int|whole):
# CHECK-NOT: LoopHint
# CHECK: Branch {{*}} -> taken [[body1]](), notTaken b3([[sum1]])
# CHECK: [[body2]]():
# CHECK: Jump -> next b1(
# CHECK: [[second]]([[sum2]]: int|whole, [[counter2]]: int|whole):
# CHECK-NOT: LoopHint
# CHECK: Branch {{*}} -> taken [[body2]](), notTaken b3([[sum2]])
# CHECK: [[never]]() frequency=Rare:
# CHECK-NEXT: Unreachable
}

function f1 name="boundIsNoConstant" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v3, v0
    v8 = Increment v4
    Jump -> next b1(v7, v8)
  b3():
    Return v3
# CHECK: Jump -> next b1(v1, v2)
}

function f2 name="manyTurns" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Integer integer=100
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v3, v0
    v9 = Increment v4
    Jump -> next b1(v8, v9)
  b3():
    Return v3
# CHECK: Jump -> next b1(v1, v2)
}

function f3 name="startsAtOneOfTwoNumbers" parameters=[{type=i32}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Jump -> next b3(v2, v3)
  b2():
    v4 = Integer integer=0
    Jump -> next b3(v2, v4)
  b3(v5, v6):
    LoopHint
    v8 = Integer integer=2
    v9 = Less v6, v8
    Branch v9 -> taken b4(), notTaken b5()
  b4():
    v10 = Add v5, v0
    v11 = Increment v6
    Jump -> next b3(v10, v11)
  b5():
    Return v5
# CHECK: Jump -> next b3(v2, v3)
# CHECK: Jump -> next b3(v2, v4)
}
