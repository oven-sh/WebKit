    v25 = Mul v24, v0
    v26 = Mul v25, v0
    v27 = Mul v26, v0
    v28 = Mul v27, v0
    v29 = Mul v28, v0
    v30 = Mul v29, v0
    v31 = Mul v30, v0
    v32 = Mul v31, v0
    v33 = Mul v32, v0
    v34 = Mul v33, v0
    v35 = Mul v34, v0
    v36 = Mul v35, v0
    v37 = Mul v36, v0
    v38 = Mul v37, v0
    Return v38
  b6():
    Return v0
  b7() frequency=Rare:
    v39 = Call v1, -, v0
    Return v39
}

