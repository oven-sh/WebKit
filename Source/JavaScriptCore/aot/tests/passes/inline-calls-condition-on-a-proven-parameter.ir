function f6 name="testedFlagBehindAMerge" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = TypeTest v1 testedType=boolean
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: boolean):
    Jump -> next b4(v3)
  b2() frequency=Rare:
    v4 = TypeTest v1 testedType=boolean
    Branch v4 -> taken b3(| 0), notTaken b7()
  b3(v5: boolean) frequency=Rare:
