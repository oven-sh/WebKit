# A branch or a switch on the value that a passed test of a parameter proves is decided by a constant argument, as it is on the parameter itself
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# LOSS: MaxInlineHeadBytes
# STATISTIC: InlineDecisionInline = 3
# STATISTIC: InlineDecisionCostExceedsBenefit = 2

module m0 path="main.js" displayPath="main.js"

function f0 name="testedFlag" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = TypeTest v1 testedType=boolean
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3: boolean):
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    v4 = Mul v0, v0
    v5 = Mul v4, v0
    v6 = Mul v5, v0
    v7 = Mul v6, v0
    v8 = Mul v7, v0
    v9 = Mul v8, v0
    v10 = Mul v9, v0
    v11 = Mul v10, v0
    v12 = Mul v11, v0
    v13 = Mul v12, v0
    v14 = Mul v13, v0
    v15 = Mul v14, v0
    v16 = Mul v15, v0
    v17 = Mul v16, v0
    v18 = Mul v17, v0
    v19 = Mul v18, v0
    v20 = Mul v19, v0
    v21 = Mul v20, v0
    v22 = Mul v21, v0
    v23 = Mul v22, v0
    v24 = Mul v23, v0
    v25 = Mul v24, v0
    v26 = Mul v25, v0
    v27 = Mul v26, v0
    v28 = Mul v27, v0
    v29 = Mul v28, v0
    v30 = Mul v29, v0
    v31 = Mul v30, v0
    v32 = Mul v31, v0
    v33 = Mul v32, v0
    v34 = Mul v33, v0
    v35 = Mul v34, v0
    Return v35
  b3():
    Return v0
  b4() frequency=Rare:
    v36 = Call v1, -, v0
    Return v36
}

function f1 name="testedKind" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = TypeTest v1 testedType=i32
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3: i32):
    Switch v3 cases=[0, 1] -> case b2(), case b3(), otherwise b4()
  b2():
    v4 = Mul v0, v0
    v5 = Mul v4, v0
    v6 = Mul v5, v0
    v7 = Mul v6, v0
    v8 = Mul v7, v0
    v9 = Mul v8, v0
    Return v9
  b3():
    v10 = Mul v0, v0
    v11 = Mul v10, v0
    v12 = Mul v11, v0
    v13 = Mul v12, v0
    v14 = Mul v13, v0
    v15 = Mul v14, v0
    Return v15
  b4():
    v16 = Mul v0, v0
    v17 = Mul v16, v0
    v18 = Mul v17, v0
    v19 = Mul v18, v0
    v20 = Mul v19, v0
    v21 = Mul v20, v0
    Return v21
  b5() frequency=Rare:
    v22 = Call v1, -, v0
    Return v22
}

function f2 name="passesFalse" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Boolean
    v2 = CallDirect v0, v1 function=f0
    Return v2
}
