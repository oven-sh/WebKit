# A string that becomes a part of a string in a builder stays a string of its own where writing it into the builder early could be seen or would need the text twice
# FORM: Prepared
# OPTIONS: report=Declines
# RUN: pass CreateStringBuilders
# STATISTIC: StringBuildersJoined = 0
# CHECK: outcome: Changed
# CHECK: decline StringBuildersNotJoined f1 v
# CHECK: decline StringBuildersNotJoined f4 v
# CHECK: decline StringBuildersNotJoined f6 v
# CHECK: decline StringBuildersNotJoined f7 v
# CHECK: decline StringBuildersNotJoined f8 v
# CHECK: decline StringBuildersNotJoined f10 v
# CHECK: decline StringBuildersNotJoined f11 v
# CHECK: decline StringBuildersNotJoined f12 v
# CHECK: decline StringBuildersNotJoined f13 v

module m0 path="main.js" displayPath="main.js"
function f0 name="conditionalStringInLoop" parameters=[{type=string}, {type=number}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: string, v1: number, v2: boolean, v3: anything):
    v4 = Integer integer=0
    Jump -> next b1(v4)
  b1(v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b6()
  b2():
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v8 = String string="a "
    v9 = Add v8, v0
    Jump -> next b5(v9)
  b4():
    v10 = String string="off"
    Jump -> next b5(v10)
  b5(v11):
    v12 = Call v3, -, v11
    v13 = Integer integer=1
    v14 = Add v5, v13
    Jump -> next b1(v14)
  b6():
    Return
}
# CHECK-LABEL: name="conditionalStringInLoop"
# CHECK-NOT: StringBuilder

