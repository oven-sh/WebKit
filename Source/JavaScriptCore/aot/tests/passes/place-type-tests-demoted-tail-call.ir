# Under the test of an expected callee the direct call keeps the mark of a demoted tail call, and so does the call by value on the other side
# FORM: Prepared
# RUN: pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="plain" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f1 name="marked-call" parameters=[{type=f0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0, v1: anything):
    v2 = Call v0, -, v1 [isDemotedTailCall]
    Return v2
}
# CHECK-LABEL: function f1 name="marked-call"
# CHECK: = IsClosureOf v0 function=f0
# CHECK: anything = CallDirect v1 function=f0 [isDemotedTailCall]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: anything = Call {{*}}, -, v1 [isDemotedTailCall]
function f2 name="ordinary-call" parameters=[{type=f0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f2 name="ordinary-call"
# CHECK-NOT: isDemotedTailCall
# CHECK: anything = CallDirect v1 function=f0
# CHECK-NOT: isDemotedTailCall
