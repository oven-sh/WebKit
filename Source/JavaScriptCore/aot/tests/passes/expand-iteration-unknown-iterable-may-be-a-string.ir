# STATISTIC: IterationsExpandedGenerically = 1

module m0 path="main.js" displayPath="main.js"

function f0 name="unknown" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
