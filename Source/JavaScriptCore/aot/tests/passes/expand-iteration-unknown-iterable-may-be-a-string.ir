  b2():
    Return v5
# An array is tested for first, and its copy of the loop knows nothing of strings.
# CHECK: b0(v0: anything):
# CHECK-NEXT: [[isArray0]]: boolean = TypeTest v0 testedType=Array
# CHECK-NEXT: Branch [[isArray0]] -> taken [[array0]](| 0), notTaken [[rest0]](| 0)
# CHECK-NEXT: b1({{*}}: int[0, 9007199254740991]):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = PropGet [[elements0]] key="length"
# CHECK-NOT: testedType=string
# The unlikely copy. A step asks what the subject is.
# CHECK: [[entry0]]() frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[header0]]([[start0]])
# CHECK-NEXT: [[header0]]([[position0]]: int[0, 2147483648]) frequency=Unlikely:
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[isStringAtStep0]]: boolean = TypeTest [[subject0]] testedType=string
# CHECK-NEXT: Branch [[isStringAtStep0]] -> taken [[stringStep0]](| 0), notTaken [[iteratorStep0]](| 0)
# The open. The position is made in front of the test, so it reaches both sides.
# CHECK-NEXT: [[protocol0]]([[iterable0]]: anything) frequency=Unlikely:
# CHECK-NEXT: [[zero0]]: 0 = Integer
# CHECK-NEXT: Jump -> next [[open0]]([[zero0]])
# CHECK: [[array0]]([[elements0]]: Array):
# CHECK-NEXT: = IsPristine [[elements0]] builtinClass=Array aspects=[Names]
# CHECK: [[rest0]]([[notArray0]]: anything) frequency=Unlikely:
# CHECK-NEXT: Jump -> next [[protocol0]]([[notArray0]])
# CHECK: [[open0]]([[start0]]: int[0, 2147483648]) frequency=Unlikely:
# CHECK-NEXT: [[opened0]]: undefined = CallDirect [[iterable0]] function=[[openStringOrIterator]] [isNeverInlined]
# CHECK-NEXT: [[subject0]]: string|object = ResultAt [[opened0]]
# CHECK-NEXT: [[next0]]: anything = ResultAt [[opened0]] index=1
# CHECK-NEXT: Jump -> next [[entry0]]()
# The two sides of a step meet where the step of one form ends. The side of the iterator carries the position on as it is.
# CHECK-NEXT: [[after0]]([[done0]]: boolean, [[value0]]: anything, [[carried0]]: int[0, 2147483648]) frequency=Unlikely:
# CHECK: Branch [[done0]] -> taken b2([[value0]]), notTaken [[header0]]([[carried0]])
# CHECK-NEXT: [[stringStep0]]([[walked0]]: string) frequency=Unlikely:
# CHECK-NEXT: [[step0]]: undefined = CallDirect [[walked0]], [[position0]] function=[[stepString]] [isNeverInlined]
# CHECK-NEXT: [[doneOfString0]]: boolean = ResultAt [[step0]]
# CHECK-NEXT: [[character0]]: anything = ResultAt [[step0]] index=1
# CHECK-NEXT: [[stop0]]: int[0, 2147483648] = ResultAt [[step0]] index=2
# CHECK-NEXT: Jump -> next [[after0]]([[doneOfString0]], [[character0]], [[stop0]])
# CHECK-NEXT: [[iteratorStep0]]([[stepped0]]: object) frequency=Unlikely:
# CHECK-NEXT: = CallDirect [[stepped0]], [[next0]] function={{*}} [isNeverInlined]
# The string gets no copy of the loop for itself.
# ABSENT-COUNT-2: LoopHint
# ABSENT-NOT: LoopHint
# TESTS-COUNT-1: testedType=string
# TESTS-NOT: testedType=string
}

