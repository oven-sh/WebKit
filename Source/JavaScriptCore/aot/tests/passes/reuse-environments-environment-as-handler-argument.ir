# An environment that a covered block hands to its handler is live in the whole block: it is released behind the block and in the handler
# FORM: Prepared
# RUN: pass ReuseEnvironments
# OPTIONS: disable=pass:AllocateInFrames
# STATISTIC: EnvironmentsReused = 3
# CHECK: reused environments: [L0 L1 L2]

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="handlerReadsIt" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="handlerIgnoresIt" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Environment name="handlerLeavesTheLoop" fields=[{key="x" declared={type=anything}}]

function f0 name="handlerReadsIt" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b2()
  b2() handler=b3(v3):
    v4 = GetEnvironmentField v3 layout=L0 field=0
    v5 = Call v0, -, v4
    Jump -> next b4()
  b3(v6) role=CatchHandler:
    v7 = CatchValue
    v8 = GetEnvironmentField v6 layout=L0 field=0
    v9 = Call v0, -, v8
    Jump -> next b4()
  b4():
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return v0
}
# CHECK-LABEL: function f0 name="handlerReadsIt"
# CHECK-NOT: ReleaseEnvironment
# CHECK: b2() handler=b3(v3):
# CHECK-NEXT: = GetEnvironmentField v3
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next [[behindCovered]]()
# CHECK-NEXT: b3(v6: env L0) role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NEXT: = GetEnvironmentField v6
# CHECK-NEXT: ReleaseEnvironment v6
# CHECK-NOT: ReleaseEnvironment
# CHECK: [[behindCovered]]():
# CHECK-NEXT: ReleaseEnvironment v3
# CHECK-NEXT: Jump -> next b4()
# CHECK-NOT: ReleaseEnvironment

function f1 name="handlerIgnoresIt" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L1 fields=[0]
    Jump -> next b2()
  b2() handler=b3():
    v4 = GetEnvironmentField v3 layout=L1 field=0
    v5 = Call v0, -, v4
    Jump -> next b4()
  b3() role=CatchHandler:
    v6 = CatchValue
    v7 = Call v0, -, v6
    Jump -> next b4()
  b4():
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return v0
}
# CHECK-LABEL: function f1 name="handlerIgnoresIt"
# CHECK-NOT: ReleaseEnvironment
# CHECK: b2() handler=b3():
# CHECK-NEXT: = GetEnvironmentField v3
# CHECK-NEXT: ReleaseEnvironment v3
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b4()
# CHECK-NOT: ReleaseEnvironment

function f2 name="handlerLeavesTheLoop" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L2 fields=[0]
    Jump -> next b2()
  b2() handler=b3(v3):
    v4 = GetEnvironmentField v3 layout=L2 field=0
    v5 = Call v0, -, v4
    Jump -> next b4()
  b3(v6) role=CatchHandler:
    v7 = CatchValue
    v8 = GetEnvironmentField v6 layout=L2 field=0
    Return v8
  b4():
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return v0
}
# CHECK-LABEL: function f2 name="handlerLeavesTheLoop"
# CHECK-NOT: ReleaseEnvironment
# CHECK: b2() handler=b3(v3):
# CHECK-NEXT: = GetEnvironmentField v3
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next [[behindLeaving]]()
# CHECK-NEXT: b3(v6: env L2) role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NEXT: [[read]]: anything = GetEnvironmentField v6
# CHECK-NEXT: ReleaseEnvironment v6
# CHECK-NEXT: Return [[read]]
# CHECK-NOT: ReleaseEnvironment
# CHECK: [[behindLeaving]]():
# CHECK-NEXT: ReleaseEnvironment v3
# CHECK-NOT: ReleaseEnvironment
