    v10 = RequireObjectCoercible v9
    v11 = Integer integer=1
    ElemSet v10, v11, v1
    v13 = ElemGet v2, v8
    v14 = RequireObjectCoercible v13
    v15 = ElemGet v14, v11
    PutModuleVariable v15 variable=g0
    v17 = Increment v8
    Jump -> next b1(v17)
