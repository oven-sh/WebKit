function f9 name="aPositionThatMayBeAFraction" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin -, v0 overload=ObjectEntries/0
    v3 = Integer
    Jump -> next b1(v3)
  b1(v4: number):
    LoopHint
    v6 = CallBuiltin v2 overload=ArrayPrototypeLength/0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8: number):
    v9 = ElemGet v2, v8
    v10 = RequireObjectCoercible v9
    v11 = Integer
    v12 = ElemGet v10, v11
    v13 = Call v1, -, v12
    v14 = Double number=0.5
    v15 = Add v8, v14
    Jump -> next b1(v15)
  b3():
