# A read is not reused across a call whose callee passes the object on to a function that stores by name, where the store may run a setter of another receiver:
# nothing else holds the object, so only the memory that the summary lists under the parameter ends the read
#   let stores = function (o) { o.a = 50 }; function callsStores(o) { stores(o); .. }  function around(o) { const before = o.a; callsStores(o); return before * 1000 + o.a }  around({ a: i })
#   stores({ set a(v) {}, get a() { return 3 } })
# Without the inliner the call stays a call: inlined, the object is never built and no read is left
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline CheckPlacement
# CHECK-LABEL: name="around"
# CHECK: GetSlot {{*}}key="a" receivers=[L1]
# CHECK: CallDirect {{*}}function=f2
# CHECK: GetSlot {{*}}key="a" receivers=[L1]

layout L0 module=m0 position=686 fields=[{key="a" declared={type=number flags=[IsExpected]} flags=[IsRequired]}]
layout L1 module=m0 position=554 fields=[{key="a" declared={type=number flags=[IsExpected]} flags=[IsRequired]}]
variable g0 name="pad" module=m0 declared={type=function} initialization=Function function=f1 flags=[IsImmutable]
