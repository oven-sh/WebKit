# A constant record of at most MaxExpandedDataNodes nodes expands, a larger one stays Data without a loss, and so does one whose layout is never allocated.
# Members that are no fields do not decide: the read-only encoding lists them behind the fields. A larger record expands only where that order is not the order of creation, or a key is `__proto__`
# FORM: Prepared
# RUN: pass ExpandData

module m0 path="main.js" displayPath="main.js"
layout L0 name="Status" fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}]
layout L1 name="NeverMade" fields=[{key="a" declared={type=number}}] flow={allocation=NeverAllocated}
layout L2 name="Dictionary"
data d0 root=Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}, Number{value=5}, Number{value=6}, Number{value=7}, Number{value=8}, Number{value=9}, Number{value=10}, Number{value=11}, Number{value=12}, Number{value=13}, Number{value=14}, Number{value=15}]}
data d1 root=Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}, Number{value=5}, Number{value=6}, Number{value=7}, Number{value=8}, Number{value=9}, Number{value=10}, Number{value=11}, Number{value=12}, Number{value=13}, Number{value=14}, Number{value=15}, Number{value=16}]}
data d2 root=Array{contents=anything elements=[Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}]}, Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}]}, Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Hole]}]}
data d3 root=Array{contents=anything elements=[Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}]}, Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}]}, Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}, Number{value=4}, Hole]}]}
data d4 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}, {key="404" value=Number{value=2}}, {key="b" value=Number{value=3}}]}
data d5 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}, {key="-1" value=Number{value=2}}, {key="b" value=Number{value=3}}]}
data d6 root=Object{layout=L1 members=[{key="a" value=Number{value=1}}]}
data d7 root=Array{contents=anything elements=[Number{value=1}, Object{layout=L1 members=[{key="a" value=Number{value=1}}]}]}
data d8 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}, {key="b" value=Number{value=3}}]}
data d9 root=Object{layout=L2 members=[{key="k0" value=Number{value=1}}, {key="k1" value=Number{value=2}}, {key="k2" value=Number{value=3}}, {key="k3" value=Number{value=4}}, {key="k4" value=Number{value=5}}, {key="k5" value=Number{value=6}}, {key="k6" value=Number{value=7}}, {key="k7" value=Number{value=8}}, {key="k8" value=Number{value=9}}, {key="k9" value=Number{value=10}}, {key="k10" value=Number{value=11}}, {key="k11" value=Number{value=12}}, {key="k12" value=Number{value=13}}, {key="k13" value=Number{value=14}}, {key="k14" value=Number{value=15}}, {key="k15" value=Number{value=16}}, {key="k16" value=Number{value=17}}]}
data d10 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}, {key="7" value=Number{value=2}}, {key="b" value=Number{value=3}}, {key="k0" value=Number{value=4}}, {key="k1" value=Number{value=5}}, {key="k2" value=Number{value=6}}, {key="k3" value=Number{value=7}}, {key="k4" value=Number{value=8}}, {key="k5" value=Number{value=9}}, {key="k6" value=Number{value=10}}, {key="k7" value=Number{value=11}}, {key="k8" value=Number{value=12}}, {key="k9" value=Number{value=13}}, {key="k10" value=Number{value=14}}, {key="k11" value=Number{value=15}}, {key="k12" value=Number{value=16}}, {key="k13" value=Number{value=17}}, {key="k14" value=Number{value=18}}, {key="k15" value=Number{value=19}}, {key="k16" value=Number{value=20}}]}
data d11 root=Object{layout=L0 members=[{key="a" value=Number{value=1}}, {key="k0" value=Number{value=2}}, {key="k1" value=Number{value=3}}, {key="k2" value=Number{value=4}}, {key="k3" value=Number{value=5}}, {key="k4" value=Number{value=6}}, {key="k5" value=Number{value=7}}, {key="k6" value=Number{value=8}}, {key="k7" value=Number{value=9}}, {key="k8" value=Number{value=10}}, {key="k9" value=Number{value=11}}, {key="k10" value=Number{value=12}}, {key="k11" value=Number{value=13}}, {key="k12" value=Number{value=14}}, {key="k13" value=Number{value=15}}, {key="k14" value=Number{value=16}}, {key="k15" value=Number{value=17}}, {key="k16" value=Number{value=18}}, {key="b" value=Number{value=3}}]}
data d12 root=Object{layout=L2 members=[{key="k0" value=Number{value=1}}, {key="k1" value=Number{value=2}}, {key="k2" value=Number{value=3}}, {key="k3" value=Number{value=4}}, {key="k4" value=Number{value=5}}, {key="k5" value=Number{value=6}}, {key="k6" value=Number{value=7}}, {key="k7" value=Number{value=8}}, {key="k8" value=Number{value=9}}, {key="k9" value=Number{value=10}}, {key="k10" value=Number{value=11}}, {key="k11" value=Number{value=12}}, {key="k12" value=Number{value=13}}, {key="k13" value=Number{value=14}}, {key="k14" value=Number{value=15}}, {key="k15" value=Number{value=16}}, {key="k16" value=Number{value=17}}, {key="__proto__" value=Null}]}

function f0 name="sixteenNodes" results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    Return v0
}
# CHECK-LABEL: function f0 name="sixteenNodes"
# CHECK-COUNT-15: = Integer integer=
# CHECK: v0:{{*}}= NewArray
# CHECK-NOT: Data

