# A `catch` that only throws the value again counts toward the size of no callee. One that does anything else counts
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SummarizeForInlining

module m0 path="main.js" displayPath="main.js"

function f0 name="callsWithoutTry" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
# CHECK: f0: barrier=None bytes=[[call]]

function f1 name="throwsCaughtValueAgain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Return v1
  b1() role=CatchHandler:
    v2 = CatchValue
    Throw v2
}
# CHECK: f1: barrier=None bytes=[[call]]

function f2 name="throwsAnotherValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Return v1
  b1() role=CatchHandler:
    v2 = CatchValue
    Throw v0
}
# CHECK-NOT: f2: barrier=None bytes=[[call]]
# CHECK: f2: barrier=None

function f3 name="callsAndThrowsCaughtValueAgain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Return v1
  b1() role=CatchHandler:
    v2 = CatchValue
    v3 = Call v0, -, v2
    Throw v2
}
# CHECK-NOT: f3: barrier=None bytes=[[call]]
# CHECK: f3: barrier=None
# CHECK: outcome: Unchanged
