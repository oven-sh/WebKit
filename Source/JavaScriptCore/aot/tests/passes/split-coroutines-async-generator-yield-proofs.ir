# What flow proves or the checker expects of an awaited value tests nothing, so it does not keep the await apart from the yield right after it. A test does
# FORM: Prepared
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="proofBetween" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=number}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = AssumeType v3 provenType=int[0, 9]
    v5 = Yield v4 @12
    v6 = ResultAt v5 index=0
    Return v6
}
function f1 name="expectedTypeAndProofBetween" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 ~ number = Upcast v3 castType=anything
    v5 = AssumeType v4 provenType=number|string
    v6 = Upcast v5 castType=anything
    v7 = Yield v6 @12
    v8 = ResultAt v7 index=0
    Return v8
}
function f2 name="proofHasSecondUse" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=number}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = AssumeType v3 provenType=int[0, 9]
    v5 = Yield v4 @12
    v6 = ResultAt v5 index=0
    Return v4
}
function f3 name="testBehindProof" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = AssumeType v3 provenType=number|string
    v5 = Check v4 expectedType=number cause=AddedByPass
    v6 = Yield v5 @12
    v7 = ResultAt v6 index=0
    Return v7
}

# CHECK-LABEL: function f4 name="proofBetween"
# CHECK: = YieldBySavingFrame [[driver0]], {{*}} @10
# CHECK-NOT: BySavingFrame
# CHECK-NOT: AssumeType
# CHECK: v5{{*}}= AsyncGeneratorYield [[driver0]], v1, v0 @12
# CHECK-NEXT: v6: anything = ResultAt v5
# CHECK-NOT: BySavingFrame
# CHECK-NOT: AssumeType

# CHECK-LABEL: function f5 name="expectedTypeAndProofBetween"
# CHECK: = YieldBySavingFrame [[driver1]], {{*}} @10
# CHECK-NOT: BySavingFrame
# CHECK-NOT: Upcast
# CHECK: v7{{*}}= AsyncGeneratorYield [[driver1]], v1, v0 @12
# CHECK-NEXT: v8: anything = ResultAt v7
# CHECK-NOT: BySavingFrame
# CHECK-NOT: AssumeType

# CHECK-LABEL: function f6 name="proofHasSecondUse"
# CHECK-NOT: AsyncGeneratorYield
# CHECK: v3{{*}}= AwaitBySavingFrame v1, [[driver2]] @11
# CHECK-NEXT: v4{{*}}= AssumeType v3 provenType=int[0, 9]
# CHECK-NEXT: v5{{*}}= YieldBySavingFrame [[driver2]], v4, v0 @12
# CHECK: Return v4
# CHECK-NOT: AsyncGeneratorYield

# CHECK-LABEL: function f7 name="testBehindProof"
# CHECK-NOT: AsyncGeneratorYield
# CHECK: v3{{*}}= AwaitBySavingFrame v1, [[driver3]] @11
# CHECK-NEXT: v4{{*}}= AssumeType v3 provenType=number|string
# CHECK-NEXT: v5: number = Check v4 expectedType=number cause=AddedByPass
# CHECK-NEXT: v6{{*}}= YieldBySavingFrame [[driver3]], v5, v0 @12
# CHECK-NOT: AsyncGeneratorYield
