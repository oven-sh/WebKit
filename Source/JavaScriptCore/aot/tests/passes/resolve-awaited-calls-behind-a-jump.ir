# A pass that cuts a block behind a call leaves a jump between the call and the await of its result. Nothing else enters the block behind the jump, so the awaited call enters the callee without a promise all the same.
# FORM: Prepared
# RUN: pass ResolveAwaitedCalls
# STATISTIC: AwaitedCallsResolved = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="count" module=m0 declared={type=anything} initialization=Undefined
function f0 name="callee" role=CoroutineRamp flags=[IsAsync] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=0} {
    v0 = NewPromise
    v1 = CallDirect v0 function=f1
    v2 = AssumeType v1 provenType=Promise
    Return v2
}
function f1 name="callee" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|Promise}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=0} {
    v1 = Undefined
    v2 = ReturnAsyncResult v0, v1
    Return v2
}

function f2 name="castsBehindTheJump" role=CoroutineRamp flags=[IsAsync] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=0} {
    v0 = NewPromise
    v1 = CallDirect v0 function=f3
    v2 = AssumeType v1 provenType=Promise
    Return v2
}
function f3 name="castsBehindTheJump" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|Promise}] results=[{type=anything}] derivation={source=f2} creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=0} {
    v1 = CallDirect function=f0
    Jump -> next b1()
  b1():
    v2 = Upcast v1 castType=anything
    v3 = AwaitBySavingFrame v2, v0
    v4 = ReturnAsyncResult v0, v3
    Return v4
# CHECK-NOT: CallDirect
# CHECK-NOT: Upcast
# CHECK: v3: anything{{*}} = AwaitCallBySavingFrame v0 function=f1
# CHECK-NOT: AwaitBySavingFrame
}

function f4 name="twoJumpsAndAnEarlierAwait" role=CoroutineRamp flags=[IsAsync] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=0} {
    v0 = NewPromise
    v1 = CallDirect v0 function=f5
    v2 = AssumeType v1 provenType=Promise
    Return v2
}
function f5 name="twoJumpsAndAnEarlierAwait" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|Promise}] results=[{type=anything}] derivation={source=f4} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=0} {
    v1 = CallDirect function=f0
    v2 = AwaitBySavingFrame v1, v0
    v3 = CallDirect function=f0
    v4 = Upcast v3 castType=anything
    Jump -> next b1()
  b1():
    v5 = Integer integer=1
    Jump -> next b2()
  b2():
    v6 = AwaitBySavingFrame v4, v0
    v7 = ReturnAsyncResult v0, v5
    Return v7
# CHECK-NOT: CallDirect
# CHECK: v2: anything{{*}} = AwaitCallBySavingFrame v0 function=f1
# CHECK-NOT: CallDirect
# CHECK: v6: anything{{*}} = AwaitCallBySavingFrame v0 function=f1
# CHECK-NOT: AwaitBySavingFrame
}

# Between the call and the await the variable is written, and the callee may read it.
function f6 name="storeBehindTheJump" role=CoroutineRamp flags=[IsAsync] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f6 body=f7 entryWithoutPromise=f7 promiseType=Promise promiseParameter=0} {
    v0 = NewPromise
    v1 = CallDirect v0 function=f7
    v2 = AssumeType v1 provenType=Promise
    Return v2
}
function f7 name="storeBehindTheJump" role=CoroutineBody flags=[IsAsync] parameters=[{type=undefined|Promise}] results=[{type=anything}] derivation={source=f6} creator=Coroutine{kind=AsyncFunction ramp=f6 body=f7 entryWithoutPromise=f7 promiseType=Promise promiseParameter=0} {
    v1 = CallDirect function=f0
    Jump -> next b1()
  b1():
    v2 = Integer integer=1
    PutModuleVariable v2 variable=g0
    v4 = AwaitBySavingFrame v1, v0
    v5 = ReturnAsyncResult v0, v4
    Return v5
# CHECK: = CallDirect function=f0
# CHECK: = AwaitBySavingFrame v1, v0
}

# Another way leads into the block of the await, on which the call has not run.
function f8 name="blockEnteredTwice" role=CoroutineRamp flags=[IsAsync] parameters=[{type=boolean}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f8 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f9
    v3 = AssumeType v2 provenType=Promise
    Return v3
}
function f9 name="blockEnteredTwice" role=CoroutineBody flags=[IsAsync] parameters=[{type=boolean}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f8 parameterMap=[{original=0}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f8 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1} {
    v2 = CallDirect function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2():
    v3 = AwaitBySavingFrame v2, v1
    v4 = ReturnAsyncResult v1, v3
    Return v4
# CHECK: = CallDirect function=f0
# CHECK: = AwaitBySavingFrame v2, v1
}
