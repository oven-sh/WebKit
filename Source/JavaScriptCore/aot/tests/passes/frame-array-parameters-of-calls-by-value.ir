# A call by value enters a function through its generic entrypoint. The entrypoint has a body of its own, so an array that lies in a frame may be handed to such a call only where the entrypoint, and whatever it calls, reads the array where it lies too
# FORM: Prepared
# RUN: frame-array-parameters

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="callers" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray v0 contents=anything
    v2 = Call v0, -, v1 callees=[f1, f4]
    v3 = Call v0, -, v1 callees=[f7]
    v4 = CallDirect v1 function=f7
    v5 = Call v0, -, v1, v0 callees=[f10]
    v6 = Call v0, -, v1, v0 callees=[f12]
    v7 = CallDirect v1, v0 function=f14
    v8 = CallDirect v1, v0 function=f15
    v9 = CallDirect v1 function=f16
    v10 = Call v0, v1 callees=[f18]
    Return v0
}
# CHECK: f0: []

function f1 name="readsWhatItsWorkerRead" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f1: [0], by value [0]

function f2 name="readsWhatItsWorkerRead" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f2: [0]

function f3 name="readsWhatItsWorkerRead" role=GenericEntrypoint flags=[HasThis] captures=[{type=f1}] parameters=[{type=anything}] results=[{type=anything}] derivation={source=f1} creator=Entrypoint{target=f1 arguments=Registers} {
    v3 = AssumeType v2 provenType=Array
    v4 = CallDirect v3 function=f2
    Return v4
}
# CHECK-NEXT: f3: [2]

function f4 name="isCalledByItsEntrypoint" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f4: [0], by value [0]

function f5 name="isCalledByItsEntrypoint" role=GenericEntrypoint flags=[HasThis] captures=[{type=f4}] parameters=[{type=anything}] results=[{type=anything}] derivation={source=f4} creator=Entrypoint{target=f4 arguments=Registers} {
    v3 = AssumeType v2 provenType=Array
    v4 = CallDirect v3 function=f4
    ReturnCall v4
}
# CHECK-NEXT: f5: [2]

function f6 name="keeps" parameters=[{type=Array}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-NEXT: f6: []

function f7 name="readsWhereItsEntrypointKeeps" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f7: [0]

function f8 name="readsWhereItsEntrypointKeeps" role=GenericEntrypoint flags=[HasThis] captures=[{type=f7}] parameters=[{type=anything}] results=[{type=anything}] derivation={source=f7} creator=Entrypoint{target=f7 arguments=Registers} {
    v3 = AssumeType v2 provenType=Array
    v4 = CallDirect v3 function=f6
    Return v4
}
# CHECK-NEXT: f8: []

function f9 name="unused" results=[{type=anything}] {
    Return
}
# CHECK-NEXT: f9: []

function f10 name="takesOthersToo" flags=[HasRestParameter] parameters=[{type=Array}, {type=Array}] results=[{type=anything}] {
    v2 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v2
}
# CHECK-NEXT: f10: [0, 1], by value [0]

function f11 name="takesOthersToo" role=GenericEntrypoint flags=[HasThis] captures=[{type=f10}] results=[{type=anything}] derivation={source=f10} creator=Entrypoint{target=f10} {
    v2 = GetArgument
    v3 = AssumeType v2 provenType=Array
    v4 = CreateRest firstArgument=1
    v5 = CallDirect v3, v4 function=f10
    ReturnCall v5
}
# CHECK-NEXT: f11: []

function f12 name="itsEntrypointListsAllArguments" flags=[HasRestParameter] parameters=[{type=Array}, {type=Array}] results=[{type=anything}] {
    v2 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v2
}
# CHECK-NEXT: f12: [0, 1]

function f13 name="itsEntrypointListsAllArguments" role=GenericEntrypoint flags=[HasThis] captures=[{type=f12}] results=[{type=anything}] derivation={source=f12} creator=Entrypoint{target=f12} {
    v2 = GetArgument
    v3 = AssumeType v2 provenType=Array
    v4 = CreateRest
    v5 = CallDirect v3, v4 function=f12
    ReturnCall v5
}
# CHECK-NEXT: f13: []

function f14 name="handsOnByValue" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = Call v1, -, v0 callees=[f1, f4]
    Return v2
}
# CHECK-NEXT: f14: [0]

function f15 name="handsOnByValueToAnEntrypointThatKeeps" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = Call v1, -, v0 callees=[f4, f7]
    Return v2
}
# CHECK-NEXT: f15: []

function f16 name="isOnlyNamed" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f16: [0]

function f17 name="isOnlyNamed" role=GenericEntrypoint flags=[HasThis] captures=[{type=f16}] parameters=[{type=anything}] results=[{type=anything}] derivation={source=f16} creator=Entrypoint{target=f16 arguments=Registers} {
    v3 = AssumeType v2 provenType=Array
    v4 = CallDirect v3 function=f16
    ReturnCall v4
}
# CHECK-NEXT: f17: []

function f18 name="takesItAsThis" flags=[HasThis] thisType={type=Array} results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f18: [0], by value [0]

function f19 name="takesItAsThis" role=GenericEntrypoint flags=[HasThis] captures=[{type=f18}] results=[{type=anything}] derivation={source=f18} creator=Entrypoint{target=f18 arguments=Registers} {
    v2 = AssumeType v1 provenType=Array
    v3 = CallDirect v2 function=f18
    ReturnCall v3
}
# CHECK-NEXT: f19: [1]
