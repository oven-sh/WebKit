    v5 = Add v2, v4
    v6 = Greater v0, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=2
    v8 = Add v7, v2
    Jump -> next b1(v8)
  b3():
    Return v2
# CHECK: b1(v2: int[0, 999]):
# CHECK: Branch v6 -> taken b2(| 1), notTaken b3()
}

