# `for (i = 0; i + 4 <= n; i += 4)`: the sum that the test compares is the value that the step computes again. What the test says of it holds for the next counter
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers

module m0 path="main.js" displayPath="main.js"
function f0 name="nextValueAtMostBound" parameters=[{type=int[0, 4294967296]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Integer integer=4
    v5 = Add v2, v4
    v6 = LessEq v5, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=4
    v8 = Add v2, v7
    Jump -> next b1(v8)
  b3():
    Return v2
# CHECK: b1(v2: int[0, 4294967296]):
# CHECK: Branch v6 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[next0]]: int[4, 4294967296]):
# CHECK: Jump -> next b1([[next0]])
}

