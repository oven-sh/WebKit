function f5 name="oneStepAmongTwoIsAnother" parameters=[{type=int[0, 1000]}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Integer integer=4
    v6 = Add v3, v5
    v7 = LessEq v6, v0
    Branch v7 -> taken b2(), notTaken b5()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
