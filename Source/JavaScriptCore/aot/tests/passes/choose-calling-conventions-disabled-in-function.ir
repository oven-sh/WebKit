# A function in the range of the switch returns its result boxed, and an equal function outside the range does not
# FORM: Prepared
# OPTIONS: disable=pass:ChooseCallingConventions disable-in=0:1
# RUN: pass ChooseCallingConventions
# STATISTIC: ResultsBoxedForTailCalls = 0
# CHECK: f0 Direct ({{*}}:Double) -> ({{*}}:JSValue) boxed-result
# CHECK-NEXT: f1 Direct ({{*}}:Double) -> ({{*}}:Double)
# CHECK-NEXT: f2 Direct

module m0 path="main.js" displayPath="main.js"
function f0 name="returnsNumber" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f1 name="alsoReturnsNumber" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f2 name="returnsTwo" parameters=[{type=number}] results=[{type=number}, {type=number}] {
  b0(v0: number):
    v1 = Results v0, v0
    Return v1
}
