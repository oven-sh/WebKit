function f6 name="copiesWithinCopies" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
    v2 = CallDirect v0, v1 function=f5
    Return v0
# CHECK-NOT: function=f5
# CHECK-NOT: function=f4
# CHECK-NOT: function=f3
# CHECK: = CallDirect {{*}} function=f0
}

# A body with one call site moves into its caller and is no copy.
function f7 name="callsThemToo" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
    v2 = CallDirect v0, v1 function=f3
    v3 = CallDirect v0, v1 function=f4
    v4 = CallDirect v0, v1 function=f5
    Return v4
}
