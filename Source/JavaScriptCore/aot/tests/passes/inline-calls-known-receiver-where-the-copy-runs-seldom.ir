function f5 name="first" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
    PropSet v0, v1 key="a"
    PropSet v0, v1 key="b"
    PropSet v0, v1 key="c"
    PropSet v0, v1 key="d"
    PropSet v0, v1 key="e"
    PropSet v0, v1 key="f"
