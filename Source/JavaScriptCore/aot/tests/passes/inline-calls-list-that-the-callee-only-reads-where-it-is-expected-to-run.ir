# function count(...args) { .. args[k] .. }  for (..) count(i, 1, 2): the caller builds a list for each call, and the callee only reads it. One general read in the rare code of the callee may hand the list
# to a getter, so the summary of the callee says that it keeps the list. Its body says more: all that its likely code does with the list is answered without a list. In a copy of the callee the
# allocation goes away there and sinks into the rare code, which is worth a copy where a loop repeats the call. Not outside a loop, not where the likely code of the callee stores the list,
# and not for a list that the program itself makes and hands to an ordinary parameter.
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineBenefitSunkAllocation = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="reads" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array<number>}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<number>):
    v2 = CallBuiltin v1 overload=ArrayPrototypeLength/0
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = PropGet v0 key="a"
    v5 = PropGet v4 key="b"
    v6 = PropGet v5 key="c"
    v7 = PropGet v6 key="d"
    v8 = Add v2, v7
    Return v8
  b2() frequency=Rare:
    v9 = ElemGet v1, v2
    Return v9
}
function f1 name="inALoop" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = PropGet v1 key="more"
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = NewArray v0, v0, v0 contents=number
    v6 = CallDirect v1, v5 function=f0
    PropSet v1, v6 key="last" mode=Strict
    Jump -> next b1()
  b3():
    Return v3
}
# CHECK-LABEL: function f1 name="inALoop"
# CHECK-NOT: function=f0

function f2 name="outsideALoop" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = NewArray v0, v0, v0 contents=number
    v3 = CallDirect v1, v2 function=f0
    Return v3
}
# CHECK-LABEL: function f2 name="outsideALoop"
# CHECK: = CallDirect {{*}} function=f0

function f3 name="keeps" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array<number>}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<number>):
    PropSet v0, v1 key="list" mode=Strict
    v3 = PropGet v0 key="a"
    v4 = PropGet v3 key="b"
    v5 = PropGet v4 key="c"
    v6 = PropGet v5 key="d"
    v7 = PropGet v6 key="e"
    Return v7
}
function f4 name="theCalleeKeepsTheList" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = PropGet v1 key="more"
    v4 = ToBoolean v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = NewArray v0, v0, v0 contents=number
    v6 = CallDirect v1, v5 function=f3
    PropSet v1, v6 key="last" mode=Strict
    Jump -> next b1()
  b3():
    Return v3
}
# CHECK-LABEL: function f4 name="theCalleeKeepsTheList"
