  b1():
    v4 = PropGet v0 key="a"
    v5 = PropGet v4 key="b"
    v6 = PropGet v5 key="c"
    v7 = PropGet v6 key="d"
    v8 = Add v2, v7
    Return v8
  b2() frequency=Rare:
