# What flow proves of the values that are sent in goes behind the switch on the mode also where an arm that does not throw is entered from elsewhere, or takes the proven value as an argument:
# the copies stand in a block of their own on the edge, and so does the argument.
# What stands in front of the yield is not asked, whatever it passes on. An await that reads the proven value and is merged into the next yield hands that yield the copy of its arm.
# The await stays apart from the yield where the arm that throws does more with the proven value than throw it, where that arm takes it as an argument, and where no arm is for the mode that throws
# FORM: Prepared
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 7
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Named" fields=[{key="count" declared={type=number} flags=[IsRequired]}]
function f0 name="armEnteredFromElsewhere" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    ValidateType v5 validatedType=undefined|int
    v7 = AssumeType v5 provenType=undefined|int
    v8 = ResultAt v4 index=1
    Switch v8 cases=[1, 2] -> case b1(), case b3(v7), otherwise b2()
  b1():
    Throw v7
  b2():
    v9 = String string="early"
    Jump -> next b3(v9)
  b3(v10):
    Return v10
}
function f1 name="twoYieldsShareAnArm" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 provenType=undefined|int
    v7 = ResultAt v4 index=1
    Switch v7 cases=[1, 2] -> case b1(), case b4(v6, v6), otherwise b2()
  b1():
    Throw v6
  b2():
    v8 = Await v1 @13
    v9 = Yield v8 @14
    v10 = ResultAt v9 index=0
    v11 = AssumeType v10 provenType=undefined|int
    v12 = ResultAt v9 index=1
    Switch v12 cases=[1, 2] -> case b3(), case b4(v6, v11), otherwise b4(v11, v6)
  b3():
    Throw v11
  b4(v13, v14):
    v15 = Add v13, v14
    Return v15
}
function f2 name="armThatThrowsReadsTheValue" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 provenType=undefined|int
    v7 = ResultAt v4 index=1
    Switch v7 cases=[1, 2] -> case b1(), case b2(), otherwise b2()
  b1():
    v8 = TypeOf v6
    Throw v8
  b2():
    Return v1
}
function f3 name="armThatThrowsTakesAnArgument" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 provenType=undefined|int
    v7 = ResultAt v4 index=1
    Switch v7 cases=[1, 2] -> case b1(v6), case b2(), otherwise b2()
  b1(v8):
    Throw v8
  b2():
    Return v1
}
function f4 name="noArmForTheModeThatThrows" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 provenType=undefined|int
    v7 = ResultAt v4 index=1
    Switch v7 cases=[2] -> case b1(), otherwise b2()
  b1():
    Return v6
  b2():
    Return v6
}
function f5 name="objectFinishedInFront" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=number}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = NewObject -, v1 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Await v4 @11
    v6 = Yield v5 @12
    v7 = ResultAt v6 index=0
    v8 = AssumeType v7 provenType=undefined|int
    v9 = ResultAt v6 index=1
    Switch v9 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v8
  b2():
    Return v8
  b3():
    Return v8
}
function f6 name="answerIsYieldedAgain" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
    InitialYield @10
    v3 = Await v1 @11
    v4 = Yield v3 @12
    v5 = ResultAt v4 index=0
    v6 = AssumeType v5 provenType=undefined|int
    v7 = ResultAt v4 index=1
