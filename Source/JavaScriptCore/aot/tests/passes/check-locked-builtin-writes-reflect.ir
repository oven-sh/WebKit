# Reflect.set and Reflect.defineProperty answer false where a locked built-in refuses, and throw nothing: the build warns that the write does nothing, also where every run reaches it
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteIsIgnored 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Descriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = String string="y"
    v4 = Builtin builtin=Reflect
    v5 = Builtin builtin=ReflectSet
    v6 = Call v5, v4, v0, v3, v1 @10
    v7 = Builtin builtin=ReflectDefineProperty
    v8 = String string="z"
    v9 = Call v7, v4, v0, v8, v2 @20
    Return
}
