# A call by value with more callees than a dispatch has arms enters a generic entrypoint, and that the generic version, which reads the method by name: the field of the object it passes stays
# RUN: pipeline RemoveUnreadFields
# STATISTIC: FlowGenericVersions = 5
# STATISTIC: UnreadFieldsRemoved = 0
# CHECK: layout L0 name="Holder" fields=[{key="m"{{*}}reads=OnlyCalled
# CHECK-LABEL: function f0 name="main"
# CHECK: [[method]]: f6 = NewClosure function=f6
# CHECK: [[holder]]: L0 = NewObject -, [[method]] layout=L0 fields=[0]
# CHECK: = Call {{*}}, -, [[holder]]
# CHECK-LABEL: name="member1" {{*}}role=GenericVersion
# CHECK: key="m" {{*}}receivers=[L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewArray v0, v1, v2, v3, v4 contents=anything
    v6 = NewClosure function=f6
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="index"
    v10 = Integer integer=7
    v11 = BitAnd v9, v10
    v12 = ElemGet v5, v11
    v13 = Call v12, -, v7
    v14 = PropGet v8 key="outside"
    v15 = Call v12, -, v14
    v16 = PropGet v8 key="print" [isFreeName]
    v17 = Call v16, -, v13, v15
    v18 = CallDirect function=f7
    Return
}
function f1 name="member1" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
function f2 name="member2" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
function f3 name="member3" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
function f4 name="member4" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
function f5 name="member5" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0 calleeKey="m"
    Return v3
}
function f6 name="m" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="count" [isFreeName]
    Return v1
}
function f7 name="padding" results=[{type=anything}] {
