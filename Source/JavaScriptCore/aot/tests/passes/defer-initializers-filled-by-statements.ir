# The statements that fill what a variable holds go with what makes it: one function makes the object, fills it and stores it. An object that several initializers take, and that no variable holds, gets a variable of its own.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 3
# STATISTIC: VariablesFilledByInitializers = 3
# STATISTIC: VariablesAddedForInitializers = 1
# CHECK: variable g0 name="first" module=m0 declared={type=absent|L0}
# CHECK-NEXT: variable g1 name="second" module=m0 declared={type=absent|L0}
# CHECK-NEXT: variable g2 module=m0 declared={type=absent|Array}
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: NewObject
# CHECK-NOT: NewArray
# CHECK-NOT: PropSet
# CHECK-NOT: ElemSet
# CHECK: Return
# CHECK: function [[makesList]] name="" {{*}}role=OutlinedBody
# CHECK: [[list]]: Array = NewArray
# CHECK: ElemSet [[list]],
# CHECK: ElemSet [[list]],
# CHECK: PutModuleVariable [[list]] variable=g2
# CHECK-NEXT: Return [[list]]
# CHECK: function {{*}} name="" {{*}}role=OutlinedBody
# CHECK: = GetModuleVariable variable=g2
# CHECK: [[first]]: L0 = NewObject
# CHECK-NEXT: PutModuleVariable [[first]] variable=g0
# CHECK-NEXT: = Double number=2.5
# CHECK-NEXT: PropSet [[first]], {{*}} key="n"
# CHECK-NEXT: PropSet [[first]], {{*}} key="n"
# CHECK-NEXT: Return [[first]]
# CHECK: = CallDirect function=[[makesList]]
# CHECK: function {{*}} name="" {{*}}role=OutlinedBody
# CHECK: = GetModuleVariable variable=g2
# CHECK: [[second]]: L0 = NewObject
# CHECK-NEXT: = Double number=1.5
# CHECK-NEXT: PropSet [[second]], {{*}} key="n"
# CHECK-NEXT: PropSet [[second]], {{*}} key="n"
# CHECK-NEXT: PutModuleVariable [[second]] variable=g1
# CHECK-NEXT: Return [[second]]

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="list" declared={type=anything} flags=[IsRequired]}, {key="n" declared={type=number} flags=[IsRequired]}]
variable g0 name="first" module=m0 declared={type=L0}
variable g1 name="second" module=m0 declared={type=L0}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Double number=1.5
    v1 = NewArray v0 contents=anything holes=[]
    ElemSet v1, v0, v0 mode=Strict
    ElemSet v1, v0, v0 mode=Strict
    v4 = NewObject -, v1, v0 layout=L0 fields=[0, 1]
    PutModuleVariable v4 variable=g0
    v6 = Double number=2.5
    PropSet v4, v6 key="n" mode=Strict
    PropSet v4, v0 key="n" mode=Strict
    v9 = NewObject -, v1, v6 layout=L0 fields=[0, 1]
    PropSet v9, v0 key="n" mode=Strict
    PropSet v9, v6 key="n" mode=Strict
    PutModuleVariable v9 variable=g1
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="publish" [isFreeName]
    v15 = NewClosure function=f1
    v16 = Call v14, -, v15
    Return
}
function f1 name="reader" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    v3 = Call v0, -, v1, v2
    Return v3
}
