# An upcast that carries an expected type goes where it expects no more than its operand is expected to be, and stays where it narrows
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="operandHasSameExpectedType" parameters=[{type=number flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ number):
    v1: anything ~ number = Upcast v0 castType=anything
    Return v1
# CHECK-NEXT: b0(v0: anything ~ number):
# CHECK-NEXT: Return v0
}

function f1 name="expectedTwice" parameters=[{type=anything}] results=[{type=anything}] {
    v1: anything ~ number = Upcast v0 castType=anything
    v2: anything ~ number = Upcast v1 castType=anything
    Return v2
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: v1: anything ~ number = Upcast v0 castType=anything
# CHECK-NEXT: Return v1
}

function f2 name="narrowsType" parameters=[{type=anything}] results=[{type=anything}] {
    v1: anything ~ number = Upcast v0 castType=anything
    Return v1
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: v1: anything ~ number = Upcast v0 castType=anything
# CHECK-NEXT: Return v1
}

function f3 name="narrowsExpectedType" parameters=[{type=number flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ number):
    v1: anything ~ i32 = Upcast v0 castType=anything
    Return v1
# CHECK-NEXT: b0(v0: anything ~ number):
# CHECK-NEXT: v1: anything ~ i32 = Upcast v0 castType=anything
# CHECK-NEXT: Return v1
}
