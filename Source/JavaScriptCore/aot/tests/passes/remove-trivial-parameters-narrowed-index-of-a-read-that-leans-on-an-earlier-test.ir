# A test finds an index inside the view. Behind it a comparison narrows the index to one number on an edge, and the read there takes the narrowed parameter and leans on the guard of that test.
# The parameter stays: the guard speaks of the index, and a constant in the parameter's place would be another value
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveTrivialParameters

module m0 path="main.js" displayPath="main.js"
function f0 name="readBehindComparison" parameters=[{type=Uint8Array}, {type=int[2, 3]}] results=[{type=anything}] {
    v2 = IsInsideView v0, v1 typedArrayType=2 [keyIsIntegral]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = Integer integer=3
    v5 = Less v1, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = GetTypedArrayElement v0, v6, v3 typedArrayType=2 level=Proven [keyIsIntegral, isInsideView]
    Return v7
  b3():
    v8 = Undefined
    Return v8
# CHECK: b2(v6: 2):
# CHECK-NEXT: = GetTypedArrayElement v0, v6, v3 typedArrayType=2
}
