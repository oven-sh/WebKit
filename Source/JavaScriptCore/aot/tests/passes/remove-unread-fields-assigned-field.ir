# From the flow analysis to the removal: Object.assign stores to a field through a target whose type names no layout, so no scan finds the store and the field stays. The same field stored by name on the object goes
# FORM: AsRead
# RUN: pipeline RemoveUnreadFields
# OPTIONS: only-passes=ComputeEffectSummaries,ResolveAccesses,EliminateDeadCode,RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="assigned" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="stored" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Assigned" fields=[{key="id" declared={type=anything}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Stored" fields=[{key="id" declared={type=anything}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Source" fields=[{key="id" declared={type=anything} flags=[IsRequired]}]
# CHECK: layout L0 name="Assigned" fields=[{key="id"{{*}}location={writers=AllKnown reads=NeverRead
# CHECK: layout L1 name="Stored" fields=[{key="id"{{*}}stores=Never storeNaming=EveryStoreNamesLocation reads=NeverRead

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[1]
    PutModuleVariable v2 variable=g0
    PutModuleVariable v1 variable=g0
    PutModuleVariable v2 variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = Integer integer=1
    v8 = NewObject -, v7 layout=L2 fields=[0]
    v9 = Builtin builtin=ObjectAssign
    v10 = Call v9, -, v6, v8
    v11 = PropGet v6 key="n"
    v12 = NewObject -, v1 layout=L1 fields=[1]
    PropSet v12, v7 key="id" mode=Strict
    PutModuleVariable v12 variable=g1
    v15 = GetModuleVariable variable=g1
    v16 = PropGet v15 key="n"
    v17 = PropGet v0 key="print" [isFreeName]
    v18 = Call v17, -, v11, v16
    Return
# CHECK: = Call {{*}}
# CHECK-NOT: key="id"
}
