# A block that cannot throw loses its handler, and a handler that only throws what it caught again is skipped
# FORM: Prepared
# RUN: pass RemoveRedundantHandlers
# STATISTIC: RemoveRedundantHandlersChanges = 13

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]

function f0 name="pureValues" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number) handler=b2():
    v1 = Add v0, v0
    Jump -> next b1()
  b1():
    Return v0
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
# CHECK-LABEL: function f0 name="pureValues"
# CHECK: b0(v0: number):
# CHECK-NOT: CatchValue

function f1 name="unknownCall" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v0
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
# CHECK-LABEL: function f1 name="unknownCall"
# CHECK: b0(v0: anything) handler=b2():
# CHECK: = CatchValue

function f2 name="slotStore" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PutSlot v1, v1, v0 key="x" receivers=[L0] level=Proven
    Jump -> next b1()
  b1():
    Return v0
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f2 name="slotStore"
# CHECK: b0(v0: anything):
# CHECK: PutSlot
# CHECK-NOT: CatchValue

function f3 name="storeByName" parameters=[{type=anything}, {type=object}] results=[{type=anything}] {
  b0(v0: anything, v1: object) handler=b2():
    PropSet v1, v0 key="x" mode=Strict
    Jump -> next b1()
  b1():
    Return v0
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f3 name="storeByName"
# CHECK: b0(v0: anything, v1: object) handler=b2():
# CHECK: = CatchValue

function f4 name="calleeCannotThrow" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number) handler=b2():
    v1 = CallDirect v0 function=f21
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
# CHECK-LABEL: function f4 name="calleeCannotThrow"
# CHECK: b0(v0: number):
# CHECK-NEXT: = CallDirect
# CHECK-NOT: CatchValue

function f5 name="calleeMayThrow" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = CallDirect v0 function=f22
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
# CHECK-LABEL: function f5 name="calleeMayThrow"
# CHECK: b0(v0: anything) handler=b2():
# CHECK: = CatchValue

function f6 name="rethrowsException" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchException
    Rethrow v2
}
# CHECK-LABEL: function f6 name="rethrowsException"
# CHECK: b0(v0: anything):
# CHECK-NOT: CatchException

function f7 name="throwsCaughtValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Throw v2
}
# CHECK-LABEL: function f7 name="throwsCaughtValue"
# CHECK: b0(v0: anything):
# CHECK-NOT: CatchValue

function f8 name="forwardsToOuterHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler handler=b3():
    v2 = CatchException
    Rethrow v2
  b3() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f8 name="forwardsToOuterHandler"
# CHECK: b0(v0: anything) handler=b3():
# CHECK-NOT: CatchException
# CHECK: = CatchValue

function f9 name="outerHandlerTakesArgument" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler handler=b3(v0):
    v2 = CatchException
    Rethrow v2
  b3(v3) role=CatchHandler:
    Return v3
}
# CHECK-LABEL: function f9 name="outerHandlerTakesArgument"
# CHECK: b0(v0: anything) handler=b3(v0):
# CHECK-NOT: CatchException

function f10 name="throwIntoRethrowingHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    Throw v0
  b1() role=CatchHandler:
    v1 = CatchException
    Rethrow v1
}
# CHECK-LABEL: function f10 name="throwIntoRethrowingHandler"
# CHECK: b0(v0: anything):
# CHECK-NEXT: Throw v0
# CHECK-NOT: CatchException

function f11 name="pureValueBeforeRethrow" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b2():
    v2 = Call v0
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v3 = CatchException
    v4 = Add v1, v1
    Rethrow v3
}
# CHECK-LABEL: function f11 name="pureValueBeforeRethrow"
# CHECK: b0(v0: anything, v1: number):
# CHECK-NOT: CatchException

function f12 name="cleanupOnlyRethrows" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CleanupHandler:
    v2 = CatchException
    Rethrow v2
}
# CHECK-LABEL: function f12 name="cleanupOnlyRethrows"
# CHECK: b0(v0: anything):
# CHECK-NOT: CatchException

function f13 name="handlerCallsBeforeRethrow" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    v3 = Call v0, -, v2
    Throw v2
}
# CHECK-LABEL: function f13 name="handlerCallsBeforeRethrow"
# CHECK: b0(v0: anything) handler=b2():

function f14 name="throwsOtherValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Throw v0
}
# CHECK-LABEL: function f14 name="throwsOtherValue"
# CHECK: b0(v0: anything) handler=b2():

function f15 name="catchesExceptionAndThrowsValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchException
    v3 = CatchValue
    Throw v3
}
# CHECK-LABEL: function f15 name="catchesExceptionAndThrowsValue"
# CHECK: b0(v0: anything) handler=b2():

function f16 name="handlerWithParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2(v0):
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2(v2) role=CatchHandler:
    v3 = CatchException
    Rethrow v3
}
# CHECK-LABEL: function f16 name="handlerWithParameter"
# CHECK: b0(v0: anything) handler=b2(v0):

function f17 name="chainInnerHandlerFirst" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler handler=b3():
    v2 = CatchException
    Rethrow v2
  b3() role=CatchHandler:
    v3 = CatchException
    Rethrow v3
}
# CHECK-LABEL: function f17 name="chainInnerHandlerFirst"
# CHECK: b0(v0: anything):
# CHECK-NOT: CatchException

function f18 name="twoCoveredBlocks" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b3():
    v1 = Call v0
    Jump -> next b1()
  b1() handler=b3():
    v2 = Call v1
    Jump -> next b2()
  b2():
    Return v2
  b3() role=CatchHandler:
    v3 = CatchException
    Rethrow v3
}
# CHECK-LABEL: function f18 name="twoCoveredBlocks"
# CHECK: b0(v0: anything):
# CHECK: b1():
# CHECK-NOT: CatchException

function f19 name="valueNeverCompletes" results=[{type=undefined}] {
  b0() handler=b1():
    v0 = CallDirect function=f20
    Unreachable
  b1() role=CatchHandler:
    v1 = CatchException
    Rethrow v1
}
# CHECK-LABEL: function f19 name="valueNeverCompletes"
# CHECK: b0():
# CHECK-NEXT: = CallDirect
# CHECK-NEXT: Unreachable
# CHECK-NOT: CatchException

function f20 name="alwaysThrows" results=[{type=never}] {
  b0():
    v0 = Undefined
    Throw v0
}
function f21 name="doubles" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v0
    Return v1
}
function f22 name="callsItsArgument" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
