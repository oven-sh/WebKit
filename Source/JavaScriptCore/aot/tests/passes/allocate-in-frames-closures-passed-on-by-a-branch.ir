# A branch on a test of a closure passes the closure on as a parameter of the block it enters. The test counts as a use that lets the closure out: the closure is made on the heap, or made again in front of the test.
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass only-passes=BuildCallGraph,EstimateHeat,ComputeEffectSummaries,AllocateInFrames heat=EverythingIsHot

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = CallDirect v1, v2 function=f1
    v5 = CallDirect v1, v2 function=f2
    v6 = CallDirect v1, v2 function=f3
    v7 = CallDirect v1, v2 function=f4
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="testedWhereItIsMadeAndReturned" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f6
    v3 = TypeTest v2 testedType=object
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: anything):
    Jump -> next b3(v4)
  b2():
    Return
  b3(v5: anything):
    Return v5
# CHECK: NewClosure function=f6
# CHECK-NOT: storage=
}

function f2 name="borrowedWhereItIsMadeThenTestedAndReturned" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f6
    v3 = CallDirect v2 function=f5
    v4 = TypeTest v2 testedType=object
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5: anything):
    Return v5
  b2():
    Return v3
# CHECK: NewClosure function=f6
# CHECK-NOT: storage=
}

function f3 name="borrowedOnOnePathTestedAndReturnedOnTheOther" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f6
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v2 function=f5
    Return v3
  b2():
    v4 = TypeTest v2 testedType=object
    Branch v4 -> taken b3(| 0), notTaken b4()
  b3(v5: anything):
    Return v5
  b4():
    Return
# CHECK: v2: f6 = NewClosure function=f6 {{*}}storage=Frame
# CHECK: [[again]]: f6 = NewClosure function=f6
# CHECK-NOT: storage=
# CHECK: TypeTest [[again]] testedType=object
}

function f4 name="testedWithoutBeingPassedOn" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f6
    v3 = TypeTest v2 testedType=object
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = CallDirect v2 function=f5
    Return v4
  b2():
    PutModuleVariable v2 variable=g0
    Return
# CHECK: v2: f6 = NewClosure function=f6 {{*}}storage=Frame
# CHECK: TypeTest v2 testedType=object
# CHECK: [[stored]]: f6 = NewClosure function=f6
# CHECK-NOT: storage=
# CHECK: PutModuleVariable [[stored]] variable=g0
}

function f5 name="borrows" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}

function f6 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
