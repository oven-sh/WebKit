# A constant with an identity gets no copy in two blocks when one of them reaches the other: one path would make two objects
# FORM: Prepared
# RUN: pass SinkConstants
# STATISTIC: SinkConstantsChanges = 1
# CHECK: outcome: Changed
# RUN(AGAIN): pass SinkConstants SinkConstants
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="callback" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}

function f1 name="throughIrreducibleCycle" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v3 = Call v1, -, v2
    Jump -> next b2()
  b2():
    LoopHint
    v5 = Call v1
    v6 = ToBoolean v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Call v1, -, v1
    v8 = ToBoolean v7
    Branch v8 -> taken b2(), notTaken b4()
  b4():
    v9 = Call v1, -, v2
    Jump -> next b5()
  b5():
    Return v9
# CHECK: b0(v0: boolean, v1: function):
# CHECK-NEXT: v2: f0 = NewClosure function=f0
# CHECK: b1():
# CHECK-NEXT: = Call v1, -, v2
# CHECK: b4():
# CHECK-NEXT: = Call v1, -, v2
# CHECK-NOT: NewClosure
}

function f2 name="leavesCycleAtItsOtherEntry" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v3 = Call v1, -, v2
    Jump -> next b2()
  b2():
    LoopHint
    v5 = Call v1
    Jump -> next b3()
  b3():
    v6 = Call v1, -, v1
    v7 = ToBoolean v6
    Branch v7 -> taken b2(), notTaken b4()
  b4():
    v8 = Call v1, -, v2
    Return v8
# CHECK: b0(v0: boolean, v1: function):
# CHECK-NEXT: v2: f0 = NewClosure function=f0
# CHECK: b4():
# CHECK-NEXT: = Call v1, -, v2
# CHECK-NOT: NewClosure
}

function f3 name="throughHandlerEdge" parameters=[{type=boolean}, {type=function}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1() handler=b3():
    v3 = Call v1, -, v2
    Return v3
  b2():
    Return v1
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = Call v1, -, v2, v4
    Return v5
# CHECK: b0(v0: boolean, v1: function):
# CHECK-NEXT: v2: f0 = NewClosure function=f0
# CHECK: = Call v1, -, v2
# CHECK: = Call v1, -, v2, v4
# CHECK-NOT: NewClosure
}

function f4 name="cycleLeadsToNoUser" parameters=[{type=i32}, {type=function}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    Switch v0 cases=[0, 1] -> case b1(), case b3(), otherwise b5()
  b1():
    v3 = Call v1, -, v2
    Jump -> next b2()
  b2():
    LoopHint
    v5 = Call v1
    v6 = ToBoolean v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Call v1, -, v1
    v8 = ToBoolean v7
    Branch v8 -> taken b2(), notTaken b4()
  b4():
    Return v1
  b5():
    v9 = Call v1, -, v2
    Return v9
# CHECK: b0(v0: i32, v1: function):
# CHECK-NEXT: Switch v0
# CHECK-NEXT: b1():
# CHECK-NEXT: [[first]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[first]]
# CHECK: b5():
# CHECK-NEXT: [[second]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call v1, -, [[second]]
}
