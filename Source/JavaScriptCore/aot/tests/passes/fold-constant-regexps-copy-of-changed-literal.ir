# A copy of a literal that may have changed stays a call of RegExp, and the call writes to no built-in
# FORM: AsRead
# RUN: pipeline FoldConstantRegExps
# OPTIONS: only-passes=FoldConstantRegExps

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}

function f1 name="copiedAfterAddedProperty" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a" @10
    v1 = Integer integer=1 @11
    PropSet v0, v1 key="extra" @12
    v3 = String string="g" @13
    v4 = Builtin builtin=RegExp @14
    v5 = Construct v4, -, v0, v3 @15
    Return v5
}
# CHECK-LABEL: function f1 name="copiedAfterAddedProperty"
# CHECK-COUNT-1: NewRegExp
# CHECK-NOT: NewRegExp

function f2 name="copiedAfterUnknownCode" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="b" @20
    v1 = Builtin builtin=GlobalThis @21
    v2 = PropGet v1 key="sink" [isFreeName] @22
    v3 = Call v2, -, v0 @23
    v4 = String string="g" @24
    v5 = Builtin builtin=RegExp @25
    v6 = Construct v5, -, v0, v4 @26
    Return v6
}
# CHECK-LABEL: function f2 name="copiedAfterUnknownCode"
# CHECK-COUNT-1: NewRegExp
# CHECK-NOT: NewRegExp
