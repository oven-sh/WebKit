# A field has the same value on both sides of an InstanceOf that runs no code of the program
# FORM: Prepared
# RUN: pass ResolveAccesses EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Cache" constructor=f2 flow={baseState=None impossibleMutations=[RedefineProperty, AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L1 name="Box" fields=[{key="k" declared={type=number} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L1] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="provenChain" parameters=[{type=L1}, {type=L0}, {type=f2}] results=[{type=number}] {
    v3 = PropGet v0 key="k"
    v4 = InstanceOf v1, v2
    v5 = PropGet v0 key="k"
    v6 = Add v3, v5
    Return v6
# CHECK: [[first]]: number = GetSlot v0 key="k"
# CHECK-NEXT: = InstanceOf v1, v2
# CHECK-NEXT: = Upcast [[first]]
# CHECK-NOT: GetSlot
}

function f1 name="valueOfAnyClass" parameters=[{type=L1}, {type=object}, {type=f2}] results=[{type=number}] {
    v3 = PropGet v0 key="k"
    v4 = InstanceOf v1, v2
    v5 = PropGet v0 key="k"
    v6 = Add v3, v5
    Return v6
# CHECK: = GetSlot v0 key="k"
# CHECK-NEXT: = InstanceOf v1, v2
# CHECK-NEXT: = GetSlot v0 key="k"
}
function f2 name="Cache" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
