# A text that nobody reads is not made where the types of its parts say that they fit in one string: joins and conversions of primitives that are no symbols run no code, and such a one throws for lack of memory alone.
# Parts that together may be longer than a string may be are joined all the same (a RangeError). A symbol has no text (a TypeError), and an object runs its conversion
# FORM: Prepared
# RUN: pass EliminateDeadCode
# RUN(EFFECTS): effects f2 f3 f5

module m0 path="main.js" displayPath="main.js"
function f0 name="numbers" parameters=[{type=number}] results=[{type=number}] {
    v1 = String string="p"
    v2 = Strcat v1, v0
    Return v0
}
function f1 name="whole" parameters=[{type=int|whole}] results=[{type=int|whole}] {
    v1 = String string="p"
    v2 = String string=":"
    v3 = Integer integer=1
    v4 = Add v0, v3
    v5 = Strcat v1, v0, v2, v4
    Return v0
}
function f2 name="strings" parameters=[{type=string}, {type=string}, {type="a"|"bc"}] results=[{type=string}] {
    v3 = Strcat v0, v1
    v4 = Strcat v2, v0
    Return v0
}
function f3 name="added" parameters=[{type=string}, {type=number}, {type="a"|"bc"}, {type=bigint}] results=[{type=string}] {
    v4 = Add v0, v1
    v5 = ToString v1
    v6 = Add v0, v0
    v7 = Add v2, v0
    v8 = Add v2, v3
    Return v0
}
function f4 name="symbols" parameters=[{type=string}, {type=symbol}, {type=anything}, {type=object}] results=[{type=string}] {
    v4 = Strcat v0, v1
    v5 = Strcat v0, v2
    v6 = Strcat v0, v3
    Return v0
}
function f5 name="short" parameters=[{type=string}, {type=number}, {type="a"|"bc"}, {type=undefined|boolean}] results=[{type=string}] {
    v4 = String string=""
    v5 = Add v0, v4
    v6 = Add v2, v1
    v7 = Add v2, v2
    v8 = Strcat v2, v1, v3, v2
    v9 = Strcat v4, v0
    v10 = ToString v0
    Return v0
}
