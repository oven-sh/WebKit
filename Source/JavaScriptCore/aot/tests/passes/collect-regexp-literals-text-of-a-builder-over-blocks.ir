# A string builder that goes on in another block arrives there as a parameter: it holds what it held at the end of the blocks it comes from. The arm that the known value never takes
# gives no text, so one text is left. A builder that two arms fill with two texts gives both.
# FORM: Selected
# RUN: pass CollectRegExpLiterals
# CHECK: regexp requests: 3
# CHECK-NEXT: 0 evaluated "^(?:[0-9]+:){2}[0-9]+$" flags=- sites=f0:v15
# CHECK-NEXT: 1 evaluated "a+c" flags=- sites=f1:v8
# CHECK-NEXT: 2 evaluated "b+c" flags=- sites=f1:v8

module m0 path="main.js" displayPath="main.js"
function f0 name="oneArmIsNeverTaken" results=[{type=anything}] {
  b0():
    v0 = String string="[0-9]+"
    v1 = TypeTest v0 testedType=string
    TestAndBranch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = StringBuilderBegin
    StringBuilderAppendConstant v2 string="^(?:"
    StringBuilderAppendString v2, v0
    Jump -> next b3(v2, v0)
  b2():
    v5 = ToString v0
    v6 = StringBuilderBegin
    StringBuilderAppendConstant v6 string="never"
    StringBuilderAppendString v6, v5
    Jump -> next b3(v6, v5)
  b3(v9: stringbuilder, v10: string):
    StringBuilderAppendConstant v9 string=":){2}"
    StringBuilderAppendString v9, v10
    StringBuilderAppendConstant v9 string="$"
    v14 = StringBuilderFinish v9
    v15 = CallInline -, v14 inlineBuiltin=NewRegExp overload=RegExp/4 @10
    Return v15
}

function f1 name="twoArmsFillIt" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = StringBuilderBegin
    StringBuilderAppendConstant v1 string="a+"
    Jump -> next b3(v1)
  b2():
    v3 = StringBuilderBegin
    StringBuilderAppendConstant v3 string="b+"
    Jump -> next b3(v3)
  b3(v5: stringbuilder):
    StringBuilderAppendConstant v5 string="c"
    v7 = StringBuilderFinish v5
    v8 = CallInline -, v7 inlineBuiltin=NewRegExp overload=RegExp/4 @20
    Return v8
}
