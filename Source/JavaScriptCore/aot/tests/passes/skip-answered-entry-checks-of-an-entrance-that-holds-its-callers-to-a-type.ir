# The parameters of an entrance may have a type of their own: all that arrives in the program. Its tests ask for the types of the typed body, which are neither wider nor narrower.
#   f1 answersTheFirst: it enters a shorter entrance, whose first parameter has what the entrance and the test say together
# The typed body takes such a value, and so does the generic version, which has the parameters of the entrance, where the test that is left fails.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SkipAnsweredEntryChecks VerifyProgram
# STATISTIC: ShorterEntrancesCreated = 1
# STATISTIC: CallsThatSkipAnsweredEntryChecks = 1
# CHECK: outcome: Changed

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="answersTheFirst" module=m0 parameters=[{type=string}, {type=number|string}] results=[{type=boolean}] {
    v2 = CallDirect v0, v1 function=f2 [isNeverInlined]
    Return v2
# CHECK: = CallDirect v0, v1 function=f5
}
function f2 name="shared" module=m0 role=EntryChecks flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number|string}, {type=number|string}] results=[{type=boolean}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=EntryChecks{body=f3 fallback=f4} {
  b0(v0: number|string, v1: number|string):
    v2 = TypeTest v0 testedType=undefined|string
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: string):
    v4 = TypeTest v1 testedType=undefined|string
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: string):
    v6 = CallDirect v3, v5 function=f3 [isNeverInlined]
    ReturnCall v6 requirement=Allowed
  b3() frequency=Unlikely:
    v7 = CallDirect v0, v1 function=f4 [isNeverInlined]
    ReturnCall v7 requirement=Allowed
}
function f3 name="shared" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=undefined|string}, {type=undefined|string}] results=[{type=boolean}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f2} {
    v2 = StrictEq v0, v1
    Return v2
}
function f4 name="shared" module=m0 role=GenericVersion flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number|string}, {type=number|string}] results=[{type=boolean}] capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f2} creator=Version{provenVersion=f3} {
    v2 = StrictEq v0, v1
    Return v2
}
# CHECK-LABEL: function f5 name="shared" module=m0 role=CallSiteVersion
# CHECK: b0(v0: string, v1: number|string):
# CHECK: = TypeTest v1 testedType=undefined|string
# CHECK-NOT: TypeTest
# CHECK: = CallDirect v0, {{*}} function=f3
# CHECK: = CallDirect v0, v1 function=f4
