# Copies of one call have one access site, so a copy that cannot join a group keeps every copy out
# FORM: Prepared
# RUN: pass GroupCallsByValue
# CHECK-NOT: group

module m0 path="main.js" displayPath="main.js"
function f0 name="provenCopy" parameters=[{type=f1|f2|f3|f4|f5}] results=[{type=anything}] {
  b0(v0: f1|f2|f3|f4|f5):
    v1 = Call v0 accessSite=0 callees=[f1, f2, f3, f4, f5]
    Return v1
}
