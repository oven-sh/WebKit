  b0():
    Return
}
function f3 name="third" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f4 name="fourth" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f5 name="fifth" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f6 name="unprovenCopy" parameters=[{type=function}] results=[{type=anything}] {
  b0(v0: function):
    v1 = Call v0 accessSite=0 callees=[f1, f2, f3, f4, f5]
    Return v1
}
