# An access that holds only while a test holds: the planner places the tests the access plan asks for, the slot operation names the guard, and the access by name stays in the rarer copy
# FORM: Prepared
# OPTIONS: limit=MaxDeclarationsPredictedFromNames:0
# RUN: pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Sparse" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=number}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Extensible" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[ChangeIntegrity, ChangePrototype]}
layout L3 name="Freezable" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype]}

function f0 name="object-with-an-expected-layout" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: object ~ L0):
# CHECK-NEXT: [[isPair]]: boolean{{*}}= TypeTest v0 testedType=L0
# CHECK-NEXT: Branch [[isPair]] -> taken [[pairs]](| 0), notTaken {{*}}
# CHECK-NOT: ShapeTest
# CHECK: v1: number = GetSlot [[pair]]{{*}} key="x" receivers=[L0] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NOT: ShapeTest
# CHECK: [[pairs]]([[pair]]: L0):
# CHECK-NEXT: = BelongsToInstance [[pair]]
# CHECK-NOT: ShapeTest
}
function f1 name="expected-parameter" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: anything ~ L0):
# CHECK-NEXT: [[isExpected]]: boolean{{*}}= TypeTest v0 testedType=L0
# CHECK-NEXT: Branch [[isExpected]] -> taken [[expectedObjects]](| 0), notTaken {{*}}
# CHECK-NOT: TypeTest
# CHECK: v1: number = GetSlot [[expectedObject]]{{*}} key="x" receivers=[L0] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NOT: TypeTest
# CHECK: [[expectedObjects]]([[expectedObject]]: L0):
# CHECK-NEXT: = BelongsToInstance [[expectedObject]]
# CHECK-NOT: TypeTest
}
function f2 name="proven-receiver-may-be-undefined" parameters=[{type=undefined|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: undefined|L1):
# CHECK-NEXT: [[isObject]]: boolean{{*}}= TypeTest v0 testedType=object
# CHECK-NEXT: Branch [[isObject]] -> taken [[objects]](| 0), notTaken {{*}}(| 0)
# CHECK-NOT: BelongsToInstance
# CHECK: [[objects]]([[object]]: L1):
# CHECK-NOT: BelongsToInstance
# CHECK: : number = GetSlot [[object]] key="x" receivers=[L1] level=Expected
# CHECK-NOT: BelongsToInstance
# CHECK: : never = PropGet {{*}} key="x"
# CHECK-NEXT: Unreachable
}
function f3 name="proven-receiver-slot-may-be-empty" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="z"
    Return v1
# CHECK-NEXT: b0(v0: L1):
# CHECK-NEXT: [[isFilled]]: boolean = IsSlotFilled v0 key="z" receivers=[L1] level=Expected [holdsDeclaredType]
# CHECK-NEXT: Branch [[isFilled]] -> taken [[filled]](| 0), notTaken {{*}}()
# CHECK-NOT: Test
# CHECK: [[filled]]([[filledGuard]]: guard):
# CHECK-NOT: Test
# CHECK: v1: number = GetSlot v0, [[filledGuard]] key="z" receivers=[L1] level=Expected [holdsDeclaredType]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="z"
}
function f4 name="two-reads-in-a-row" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    Return v2
# CHECK: = TypeTest v0 testedType=L0
# CHECK-NOT: TypeTest
# CHECK: = GetSlot [[shared]], [[sharedGuard]] key="x" receivers=[L0] level=Expected
# CHECK-NEXT: = GetSlot [[shared]], [[sharedGuard]] key="y" receivers=[L0] level=Expected
# CHECK-NOT: TypeTest
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: = PropGet v0 key="y"
}
function f5 name="absent-member-of-an-extensible-object" parameters=[{type=L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="missing"
    Return v1
# CHECK-NEXT: b0(v0: L2):
# CHECK-NEXT: [[hasNoExtra]]: boolean = HasNoExtraProperties v0
# CHECK-NEXT: Branch [[hasNoExtra]] -> taken {{*}}(| 0), notTaken {{*}}()
# CHECK: v1: undefined = Undefined
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="missing"
}
function f6 name="nothing-expected" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: object):
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
}
function f7 name="no-object-in-the-type" parameters=[{type=string}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: string):
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
}
function f8 name="rare-block" parameters=[{type=L0 flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ L0, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = PropGet v0 key="x"
    Return v2
  b2():
    Return
# CHECK-NOT: TypeTest
# CHECK: frequency=Rare:
# CHECK-NEXT: = PropGet v0 key="x"
# CHECK-NEXT: Return v2
# CHECK-NOT: TypeTest
}
function f9 name="store-to-possibly-frozen-object" parameters=[{type=L3}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="x"
    Return
# CHECK-NEXT: b0(v0: L3, v1: number):
# CHECK-NEXT: [[isNotFrozen]]: boolean = IsNotFrozen v0
# CHECK-NEXT: Branch [[isNotFrozen]] -> taken [[notFrozen]](| 0), notTaken {{*}}()
# CHECK: [[notFrozen]]([[notFrozenGuard]]: guard):
# CHECK: PutSlot v0, [[notFrozenGuard]], v1 key="x" receivers=[L3] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, v1 key="x"
}
function f10 name="stored-value-may-not-fit" parameters=[{type=L1}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="x"
    Return
# CHECK-NEXT: b0(v0: L1, v1: anything):
# CHECK-NEXT: [[fits]]: boolean = TypeTest v1 testedType=number
# CHECK-NEXT: Branch [[fits]] -> taken [[fitting]](| 0), notTaken {{*}}(| 0)
# CHECK: [[fitting]]([[number]]: number):
# CHECK: PutSlot v0, -, [[number]] key="x" receivers=[L1] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, {{*}} key="x"
}
function f11 name="store-to-possibly-moved-out-slot" parameters=[{type=L1}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="z"
    Return
# CHECK-NEXT: b0(v0: L1, v1: number):
# CHECK-NEXT: [[hasNoOthers]]: boolean = HasNoFieldOutsideSlot v0
# CHECK: ([[hasNoOthersGuard]]: guard):
# CHECK: PutSlotOrAdd v0, [[hasNoOthersGuard]], v1 key="z" receivers=[L1] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, v1 key="z"
}
function f12 name="stored-value-never-fits" parameters=[{type=L1}, {type=string}] results=[{type=anything}] {
    PropSet v0, v1 key="x"
    Return
# CHECK-NEXT: b0(v0: L1, v1: string):
# CHECK-NEXT: PropSet v0, v1 key="x"
# CHECK-NEXT: Return
# CHECK-NEXT: }
}
