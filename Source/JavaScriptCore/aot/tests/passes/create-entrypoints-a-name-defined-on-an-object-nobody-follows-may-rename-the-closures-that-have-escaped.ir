# function make() { return function written() {} }  function alone() {}  input(make()); input(make()); alone(); alone();  Object.defineProperty(input.kept, "name", { value: "given" })
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# CHECK: function f2 name="written"{{*}}ClosuresAreReadWithoutCode, RecordsCallee, RecordsCalleeOnceRenamed]
# CHECK: function f4 name="alone"{{*}}ClosuresAreReadWithoutCode]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="value" declared={type=anything}}]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v2
    v4 = Call v1, -, v3
    v5 = Call v2
    v6 = Call v1, -, v5
    v7 = NewClosure function=f3
    v8 = Call v7
    v9 = Call v8
    v10 = Call v7
    v11 = Call v10
    v12 = PropGet v1 key="kept"
    v13 = Builtin builtin=Object
    v14 = Builtin builtin=ObjectDefineProperty
    v15 = String string="name"
    v16 = String string="given"
    v17 = NewObject -, v16 layout=L0 fields=[0]
    v18 = FinishObject v17
    v19 = Call v14, v13, v12, v15, v18
    Return
}
function f1 name="make" module=m0 results=[{type=anything}] {
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="written" module=m0 results=[{type=anything}] {
    Return
}
function f3 name="makeAlone" module=m0 results=[{type=anything}] {
    v0 = NewClosure function=f4
    Return v0
}
function f4 name="alone" module=m0 results=[{type=anything}] {
