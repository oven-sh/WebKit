# Object.defineProperty with a locked built-in and one name, at the top of the body of the entry module, throws in every run: the build reports an error
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteAlwaysRuns 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Descriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectPrototype
    v1 = Integer integer=1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = String string="y"
    v4 = Builtin builtin=ObjectDefineProperty
    v5 = Builtin builtin=Object
    v6 = Call v4, v5, v0, v3, v2 @10
    Return
}
