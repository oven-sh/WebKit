# A closure without captures whose function has closures that are only called, wherever they go, and never compared with each other need not be made: the program runs with the closure
# that the closure table holds for the function. It may be kept in a variable, be a member of an object or come back as a result.
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="earlier" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f1
    v2 = CallDirect function=f2
    v3 = CallDirect function=f2
    v4 = CallDirect function=f3
    v5 = Call v4, -
    v6 = NewClosure function=f13
    v7 = Call v6, -
    PutModuleVariable v6 variable=g0
    Return
}
# The code of a module runs once: the closure of the table would be no closure less.
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: isHeldByClosureTable

function f1 name="keepsOneInAVariable" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f10
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -
    Return v3
}
# CHECK-LABEL: function f1 name="keepsOneInAVariable"
# CHECK: = NewClosure function=f10 {{*}}[isHeldByClosureTable]

function f2 name="comparesItWithTheOneBefore" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f11
    v1 = GetModuleVariable variable=g1
    v2 = StrictEq v0, v1
    PutModuleVariable v0 variable=g1
    v4 = Call v0, -
    Return v2
}
# CHECK-LABEL: function f2 name="comparesItWithTheOneBefore"
# CHECK-NOT: isHeldByClosureTable

function f3 name="givesOneBack" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f12
    Return v0
}
# CHECK-LABEL: function f3 name="givesOneBack"
# CHECK: = NewClosure function=f12 {{*}}[isHeldByClosureTable]

# REPEAT: i = 4..9
function f%(i) name="unused%(i)" results=[{type=anything}] {
  b0():
    Return
}
# END REPEAT
function f10 name="kept" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f11 name="compared" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f12 name="givenBack" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f13 name="madeByTheModule" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
