# await f(x), where the test of x stands in the caller. Each arm enters the body of its version, and the block behind the merge takes what the awaits give
function f25 name="twoArmsWithCalls" role=CoroutineBody flags=[IsAsync] parameters=[{type=boolean}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f4} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f25 entryWithoutPromise=f25 promiseType=Promise promiseParameter=2} {
    v3 = TypeTest v1 testedType=number
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = CallDirect v4 function=f0 @10
    Jump -> next b3(v5)
  b2():
    v6 = CallDirect v1 function=f1 @10
    Jump -> next b3(v6)
  b3(v7):
    v8 = AwaitBySavingFrame v7, v2 @11
    v9 = ReturnAsyncResult v2, v8
    Return v9
# CHECK-NOT: CallDirect
# CHECK-NOT: AwaitBySavingFrame
# CHECK: b1(v4: number):
# CHECK-NEXT: [[typed25]]: anything = AwaitCallBySavingFrame v2, v4 function=f22 @10
# CHECK-NEXT: Jump -> next b3([[typed25]])
# CHECK-NEXT: b2():
# CHECK-NEXT: [[untyped25]]: anything = AwaitCallBySavingFrame v2, v1 function=f23 @10
# CHECK-NEXT: Jump -> next b3([[untyped25]])
# CHECK-NEXT: b3(v7: anything):
# CHECK-NEXT: v8: anything = Upcast v7 castType=anything @11
# CHECK-NEXT: v9: anything = ReturnAsyncResult v2, v8
# CHECK-NOT: CallDirect
# CHECK-NOT: AwaitBySavingFrame
}

