# response.emit === ownEmit, where the receiver is one of several classes with different methods of the name: each class gets a copy of the read behind a type test.
# A method that is read for another use keeps the one read by name.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitUnions
# STATISTIC: UnionsSplit = 1
# CHECK: outcome: Changed

module m0 path="message.js" displayPath="message.js"
module m1 path="response.js" displayPath="response.js"
layout L0 kind=Instance name="Message" module=m0 constructor=f0 flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed members=[{key="emit" function=f1}] namedMembers=[{key="emit" function=f1}]}
layout L1 kind=Instance name="Request" module=m0 constructor=f2 flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed members=[{key="emit" function=f1}] namedMembers=[{key="emit" function=f1}]}
layout L2 kind=Instance name="Response" module=m1 constructor=f3 flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed members=[{key="emit" function=f4}] namedMembers=[{key="emit" function=f4}]}
function f0 name="Message" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="emit" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f2 name="Request" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f3 name="Response" module=m1 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f4 name="emit" module=m1 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}

function f5 name="compared" module=m1 parameters=[{type=L0|L1|L2}, {type=anything}] results=[{type=boolean}] {
    v2 = PropGet v0 key="emit"
    v3 = StrictEq v2, v1
    Return v3
# CHECK: b0(v0: L0|L1|L2, v1: anything):
# CHECK-NEXT: [[isResponse]]: boolean = TypeTest v0 testedType=L2
# CHECK-NEXT: Branch [[isResponse]] -> taken [[responseArm]](| 0), notTaken [[otherArm]](| 0)
# CHECK: [[responseArm]]([[response]]: L2):
# CHECK-NEXT: = PropGet [[response]] key="emit" receivers=[L2]
# CHECK: [[otherArm]]([[other]]: L0|L1){{*}}:
# CHECK-NEXT: = PropGet [[other]] key="emit" receivers=[L0, L1]
}
function f6 name="returned" module=m1 parameters=[{type=L0|L1|L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="emit"
    Return v1
# CHECK: b0(v0: L0|L1|L2):
# CHECK-NEXT: = PropGet v0 key="emit"
# CHECK-NEXT: Return
}
