# A suspended function holds what its suspension lists. Where a listed object is never built, the suspension lists each member that may be an object in its place.
# A member that is no object is not listed.
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="held" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation}}}, {key="n" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation}}}]

function f0 name="readBehindAwait" role=CoroutineRamp flags=[IsAsync] parameters=[{type=object}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f1
    Return v3
}

function f1 name="readBehindAwait" role=CoroutineBody flags=[IsAsync] parameters=[{type=object}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v4 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = AwaitBySavingFrame v2, v3, v5
    v7 = PropGet v5 key="n" receivers=[L0]
    Return v7
# CHECK-NOT: NewObject
# CHECK: AwaitBySavingFrame v2, v3, v0
}

function f2 name="holdsOnlyNumbers" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f3
    Return v3
}

function f3 name="holdsOnlyNumbers" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=3} {
    v4 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = AwaitBySavingFrame v2, v3, v5
    v7 = PropGet v5 key="n" receivers=[L0]
    Return v7
# CHECK-NOT: NewObject
# CHECK-NOT: AwaitBySavingFrame v2, v3,
# CHECK: AwaitBySavingFrame v2, v3
}
