module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="inner" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="outer" fields=[{key="inner" declared={type=env L0}}]

function f0 name="returned" results=[{type=anything}] {
