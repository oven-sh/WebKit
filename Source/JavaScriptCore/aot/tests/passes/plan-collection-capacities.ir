    v6 = Less v4, v1
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallBuiltin v0, v2 overload=SetPrototypeAdd/0
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10)
  b3():
    Return
# CHECK: [[size1]]:{{*}}= CallBuiltin v0 overload=SetPrototypeSize/0
# CHECK: = IsCollectionTableFull v0
# CHECK: = CallBuiltin v0, v2 overload=SetPrototypeAdd/0
