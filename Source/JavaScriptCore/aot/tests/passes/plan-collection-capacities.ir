# A Map or a Set that a counted loop adds to grows once when its table is full: the run time is told how many additions are left, how many the loop has come by and how large the collection was in front
# of the loop, and makes room for as many of those that are left as have added an entry so far. So an iteration may skip the addition, and keys may repeat. The second addition of one key counts for nothing.
# Nothing is planned for a collection that changes in the loop, for a loop without a counter, in rare code, or outside of loops
# Nor for a loop that is not known to turn some tens of times: the test in front of every addition costs more than a small table's growth
# FORM: Prepared
# RUN: pass PlanCollectionCapacities
# RUN(TWICE): pass PlanCollectionCapacities PlanCollectionCapacities
# STATISTIC: CollectionGrowthsPlanned = 7
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Holder" fields=[{key="map" declared={type=Map<anything, anything>} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
function f0 name="setInMap" parameters=[{type=Map<anything, anything>}, {type=int[100, 1000000]}, {type=anything}, {type=anything}] results=[{type=undefined}] {
    v4 = Integer integer=0
    Jump -> next b1(v4)
  b1(v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = CallBuiltin v0, v2, v3 overload=MapPrototypeSet/0
    v10 = Integer integer=1
    v11 = Add v8, v10
    Jump -> next b1(v11)
  b3():
    Return
# CHECK: b0(
# CHECK-NEXT: v4: 0 = Integer
# CHECK-NEXT: [[size0]]:{{*}}= CallBuiltin v0 overload=MapPrototypeSize/0
# CHECK-NEXT: Jump -> next b1(v4)
# CHECK: b2(v8{{*}}):
# CHECK-NEXT: [[full0]]: boolean = IsCollectionTableFull v0
# CHECK-NEXT: Branch [[full0]] -> taken [[grows0]](), notTaken [[adds0]]()
# CHECK: [[adds0]]():
# CHECK-NEXT: = CallBuiltin v0, v2, v3 overload=MapPrototypeSet/0
# CHECK: [[grows0]]() frequency=Unlikely:
# CHECK-NEXT: [[left0]]:{{*}}= Sub v1, v5
# CHECK-NEXT: [[start0]]: 0 = Integer
# CHECK-NEXT: [[done0]]:{{*}}= Sub v5, [[start0]]
# CHECK-NEXT: ReserveCollectionCapacity v0, [[left0]], [[done0]], [[size0]]
# CHECK-NEXT: Jump -> next [[adds0]]()
}

