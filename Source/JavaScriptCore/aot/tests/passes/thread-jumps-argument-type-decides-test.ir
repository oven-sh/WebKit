# The type of what an edge passes may decide a test of a parameter that the parameter's own type leaves open, a type test or a test for the closure of one function: the edge goes straight to the side it decides, whatever is expected of the parameter. A cast in front of the test keeps the edge. A use of the parameter behind the test does not: the edge passes on what it passed for the parameter
# FORM: Prepared optimizing
# RUN: pass ThreadJumps

module m0 path="main.js" displayPath="main.js"
function f0 name="parameterHasExpectedType" parameters=[{type=string}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3: anything ~ string):
    v4 = TypeTest v3 testedType=string
    Branch v4 -> taken b4(| 0), notTaken b5(| 0)
  b4(v5):
    v6 = GetStringLength v5
    Return v6
  b5(v7):
    Return v7
# CHECK: b1():
# CHECK-NEXT: Jump -> next b4(v0)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v1)
}

function f1 name="parameterIsUsedBehindTheTest" parameters=[{type=string}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = TypeTest v3 testedType=string
    Branch v4 -> taken b4(| 0), notTaken b5(| 0)
  b4(v5):
    v6 = GetStringLength v5
    v7 = Add v6, v3
    Return v7
  b5(v8):
    Return v8
# CHECK: b1():
# CHECK-NEXT: Jump -> next [[skipping]](v0)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v1)
# CHECK: [[skipping]]([[text]]: string):
# CHECK-NEXT: Jump -> next b4([[text]], [[text]])
}

function f2 name="castInFrontOfTest" parameters=[{type=string}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = AssumeType v3 castType=undefined|string|object
    v5 = TypeTest v4 testedType=string
    Branch v5 -> taken b4(| 0), notTaken b5(| 0)
  b4(v6):
    v7 = GetStringLength v6
    Return v7
  b5(v8):
    Return v8
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v0)
}

function f3 name="bothSidesDecided" parameters=[{type=string}, {type=number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = TypeTest v3 testedType=string
    Branch v4 -> taken b4(| 0), notTaken b5(| 0)
  b4(v5):
    v6 = GetStringLength v5
    Return v6
  b5(v7):
    Return v7
# CHECK: b1():
# CHECK-NEXT: Jump -> next b4(v0)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b5(v1)
}

function f4 name="typeDecidesNothing" parameters=[{type=number|string}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = TypeTest v3 testedType=string
    Branch v4 -> taken b4(| 0), notTaken b5(| 0)
  b4(v5):
    v6 = GetStringLength v5
    Return v6
  b5(v7):
    Return v7
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v1)
}

function f5 name="tested" results=[{type=anything}] {
    Return
}
function f6 name="other" results=[{type=anything}] {
    Return
}

function f7 name="closureOfTestedFunction" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f5
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = IsClosureOf v3 function=f5
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    v5 = CallDirect function=f5
    Return v5
  b5():
    v6 = Call v3
    Return v6
# CHECK: b1():
# CHECK: Jump -> next b4()
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v0)
}

function f8 name="closureOfOtherFunction" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f6
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3):
    v4 = IsClosureOf v3 function=f5
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    v5 = CallDirect function=f5
    Return v5
  b5():
    Return
# CHECK: b1():
# CHECK: Jump -> next b5()
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v0)
}

function f9 name="closureOfEitherFunction" parameters=[{type=f5|f6}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = IsClosureOf v3 function=f5
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    v5 = CallDirect function=f5
    Return v5
  b5():
    Return
# CHECK: b1():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v1)
}
