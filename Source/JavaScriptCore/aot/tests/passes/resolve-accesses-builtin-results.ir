# A field of a record that a built-in's own code makes is read by name, without a test for a shape that the record never has. A field of the record that a library function allocates is a slot
# RUN: pipeline Select
# CHECK-LABEL: function f0 name="main"
# CHECK: [[stepOfMap]]: object = CallBuiltin {{*}}overload=MapIteratorPrototypeNext/0
# CHECK: [[stepOfArray]]: L(IteratorResult) = AssumeType
# CHECK: [[counts]]: object = CallBuiltin {{*}}overload=Uint8ArrayPrototypeSetFromBase64/0
# CHECK: = PropGetPair [[stepOfMap]] key="value" secondKey="done"
# CHECK: = GetSlot [[stepOfArray]] key="value" receivers=[L(IteratorResult)] level=Proven
# CHECK-NEXT: = GetSlot [[stepOfArray]] key="done" receivers=[L(IteratorResult)] level=Proven
# CHECK: [[counts]] key="read"
# RUN(UNTESTED): pipeline Select
# UNTESTED-LABEL: function f0 name="main"
# UNTESTED-NOT: TypeTest
# UNTESTED-NOT: ShapeTest
# UNTESTED-NOT: level=Predicted
# UNTESTED-LABEL: function f1 name="next"

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
entry module=m0
runtimefunction id=70 function=f1
variable g0 name="stepOfMap" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="stepOfArray" module=m0 declared={type=anything} initialization=Uninitialized
variable g2 name="counts" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Map
    v1 = Construct v0
    v2 = PropGet v1 key="keys"
    v3 = Call v2, v1 calleeKey="keys"
    v4 = PropGet v3 key="next"
    v5 = Call v4, v3 calleeKey="next"
    PutModuleVariable v5 variable=g0
    v7 = Integer integer=1
    v8 = NewArray v7 contents=anything
    v9 = PropGet v8 key="values"
    v10 = Call v9, v8 calleeKey="values"
    v11 = PropGet v10 key="next"
    v12 = Call v11, v10 calleeKey="next"
    PutModuleVariable v12 variable=g1
    v14 = Builtin builtin=Uint8Array
    v15 = Integer integer=8
    v16 = Construct v14, -, v15
    v17 = PropGet v16 key="setFromBase64"
    v18 = String string="AQID"
    v19 = Call v17, v16, v18 calleeKey="setFromBase64"
    PutModuleVariable v19 variable=g2
    v21 = CallDirect function=f2
    Return
}
function f1 name="next" module=m1 role=Library flags=[HasThis] enclosingRuntimeFunction=70 results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=MathRandom
    v2 = Call v1
    v3 = ToNumber v2
    v4 = ToBoolean v3
    v5 = CreateIteratorResult v3, v4
    Return v5
}
function f2 name="read" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = PropGet v2 key="value"
    v4 = PropGet v2 key="done"
    v5 = GetModuleVariable variable=g1
    v6 = PropGet v5 key="value"
    v7 = PropGet v5 key="done"
    v8 = GetModuleVariable variable=g2
    v9 = PropGet v8 key="read"
    v10 = PropGet v8 key="written"
    v11 = Call v1, -, v3, v4, v6, v7, v9, v10
    Return
}
