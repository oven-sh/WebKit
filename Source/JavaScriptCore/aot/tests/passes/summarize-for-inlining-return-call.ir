# A block that ends in a tail call may return, unless the callee never returns
# OPTIONS: only-passes=SummarizeForInlining heat=OnlyLoopsAreHot
# RUN: pipeline SummarizeForInlining
# RUN(PASS): pass SummarizeForInlining

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return
}
function f1 name="endsInTailCall" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f4
    ReturnCall v1
}
# CHECK: f1: barrier=None
# CHECK-NOT: head=
# CHECK-NOT: noReturn
# CHECK-NOT: neverReturns
# PASS: f1: barrier=None
# PASS-NOT: head=
# PASS-NOT: noReturn
# PASS-NOT: neverReturns

function f2 name="tailCallOnOnePath" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f4
    ReturnCall v2
  b2():
    Throw v0
}
# CHECK: f2: barrier=None {{*}} noReturn=[b2]
# CHECK-NOT: neverReturns
# PASS: f2: barrier=None {{*}} noReturn=[b2]
# PASS-NOT: neverReturns

function f3 name="tailCallOfFunctionWithoutReturn" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f5
    ReturnCall v1
}
# CHECK: f3: barrier=None {{*}} noReturn=[b0] neverReturns
# PASS: f3: barrier=None {{*}} noReturn=[b0] neverReturns

function f4 name="callsAndReturns" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
# CHECK: f4: barrier=None
# CHECK-NOT: neverReturns
# PASS: f4: barrier=None
# PASS-NOT: neverReturns

function f5 name="fails" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Throw v0
}
# CHECK: f5: barrier=None {{*}} noReturn=[b0] neverReturns
# PASS: f5: barrier=None {{*}} noReturn=[b0] neverReturns
# PASS: outcome: Unchanged

# CHECK-LABEL: function f1 name="endsInTailCall"
# CHECK: ReturnCall v1
# PASS-LABEL: function f3 name="tailCallOfFunctionWithoutReturn"
# PASS: ReturnCall v1
