# A second run finds nothing: a converted counter is no number, and an edge that passes the counter on is not asked to again
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers ConvertCountersToIntegers
# STATISTIC: CountersConverted = 1
# STATISTIC: ConvertCountersToIntegersChanges = 2
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="converted" parameters=[{type=i32}] results=[{type=undefined}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
}
# CHECK-LABEL: function f0 name="converted"
# CHECK: b1(v3: int[0, 2147483647]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[once0]]: int[0, 2147483646]):
# CHECK-NEXT: v6: int[1, 2147483647] = Add [[once0]], v2

function f1 name="passedOnAndStillNumber" parameters=[{type=int}] results=[{type=undefined}] {
  b0(v0: int):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = LessEq v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
}
# CHECK-LABEL: function f1 name="passedOnAndStillNumber"
# CHECK: b1(v3: int|whole):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[once1]]: int|whole):
# CHECK-NEXT: v6: int|whole = Add [[once1]], v2

function f2 name="neverPassedOn" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
}
# CHECK-LABEL: function f2 name="neverPassedOn"
# CHECK: b1(v3: int|whole):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: int|whole = Add v3, v2
