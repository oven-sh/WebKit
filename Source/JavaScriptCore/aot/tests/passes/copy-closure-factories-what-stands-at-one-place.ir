# The array of a tagged template is one object however many closures run the template, and a function that is handed its own closure can tell which closure was called.
# FORM: AsRead
# RUN: pass CopyClosureFactories
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = Call v0
    v3 = NewClosure function=f3
    v4 = Call v3
    v5 = Call v3
    Return
}
function f1 name="tagged" module=m0 position=10 kind=Arrow results=[{type=anything}] {
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="strings" module=m0 position=20 kind=Arrow results=[{type=anything}] {
    v0 = NewTemplateObject templateStrings=[{cooked="a" raw="a"}]
    Return v0
}
function f3 name="self" module=m0 position=30 flags=[TakesCallee] results=[{type=anything}] {
    v1 = NewClosure v0 function=f4
    Return v1
}
function f4 name="callee" module=m0 position=40 kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
