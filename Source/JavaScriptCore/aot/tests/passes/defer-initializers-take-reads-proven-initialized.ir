# What is put off takes a binding of another module, which a reader over there may find empty. The read in this body comes behind the only store, which flow has proven: whenever it is repeated it finds the same
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 1
# CHECK: variable g0 name="given" module=m1 declared={type={{*}}absent
# CHECK-NEXT: variable g1 name="table" module=m0 declared={type=absent|L0}
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: NewObject
# CHECK: Return

module m0 path="/main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/imported.ts" displayPath="imported.ts" body=f1
entry module=m0
layout L0 fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
variable g0 name="given" module=m1 declared={type=anything|absent}
variable g1 name="table" module=m0 declared={type=L0}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="given"
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v2, v1 key="held"
    PropSet v2, v1 key="held"
    PutModuleVariable v2 variable=g1
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="publish" [isFreeName]
    v8 = NewClosure function=f3
    v9 = Call v7, -, v8
    Return
}
function f1 name="imported" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f2
    v3 = Call v1, -, v2
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="early" module=m1 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="given"
    Return v1
}
function f3 name="reader" module=m0 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = PropGet v0 key="held"
    Return v1
}
