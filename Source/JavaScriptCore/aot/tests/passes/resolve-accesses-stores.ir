# RUN: pass ResolveAccesses
# STATISTIC: ResolveAccessesChanges = 14
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="filled" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="optional" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="inheritable" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="movable" declared={type=number} flow={prototypeName=AbsentOnPrototypes}}, {key="constant" declared={type=number} flags=[IsImmutable] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Freezable" fields=[{key="filled" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="optional" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype]}
layout L2 name="NeverEnumerated" fields=[{key="filled" declared={type=number|string} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="optional" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="inheritable" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype] keys=NeverEnumerated}
layout L3 kind=Instance name="Gauge" constructor=f0 fields=[{key="level" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed prototypeNamesAreComplete=true namedMembers=[{key="reset" function=f1 mutability=Fixed}, {key="peak" kind=Setter function=f2 mutability=Fixed}]}

function f0 name="Gauge" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] constructedClass=L3 {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L3
    v3 = NewObject v2 layout=L3
    Jump -> next b1()
  b1():
    PropDefine v3, v1 key="level"
    Return v3
}
# The allocation lists what is stored behind it in its own block, so the definition stands in another.
