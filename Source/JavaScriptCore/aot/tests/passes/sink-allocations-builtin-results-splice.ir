# The array of removed elements that splice returns is never built where nothing, its length or its first elements are all that is used of it
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 4
# STATISTIC: ListsOfBuiltinsNeverBuilt = 4

module m0 path="main.js" displayPath="main.js"

function f0 name="resultUnused" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    Return
# CHECK: v3:{{*}}= CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0 builtinCallForm=Prefix prefixLength=0
}

function f1 name="firstRemovedElementRead" parameters=[{type=Array<string, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    v4 = Integer integer=0
    v5 = ElemGet v3, v4
    Return v5
# CHECK: v3:{{*}}= CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0 builtinCallForm=Prefix prefixLength=1
# CHECK: [[first1]]:{{*}}= ResultAt v3 index=1
# CHECK-NOT: ElemGet
# CHECK: v5:{{*}}= Upcast [[first1]]
}

function f2 name="numberOfRemovedElementsRead" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=i32}, {type=i32}, {type=anything}] results=[{type=anything}] {
    v4 = CallBuiltin v0, v1, v2, v3 overload=ArrayPrototypeSplice/0
    v5 = PropGet v4 key="length"
    Return v5
# CHECK: v4:{{*}}= CallBuiltin v0, v1, v2, v3 overload=ArrayPrototypeSplice/0 builtinCallForm=Prefix prefixLength=0
# CHECK-NEXT: [[length2]]:{{*}}= ResultAt v4
# CHECK-NEXT: v5:{{*}}= Upcast [[length2]]
}

function f3 name="resultReturned" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    Return v3
# CHECK-NOT: builtinCallForm=
# CHECK: v3:{{*}}= CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
}

function f4 name="presenceOfRemovedElementTested" parameters=[{type=Array<anything, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    v4 = Integer integer=0
    v5 = ElemHas v3, v4
    Return v5
# CHECK-NOT: builtinCallForm=
# CHECK: v5:{{*}}= ElemHas v3, v4
}

function f5 name="receiverThatMayHaveSpecies" parameters=[{type=object}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/1
    Return
# CHECK-NOT: builtinCallForm=
# CHECK: v3:{{*}}= CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/1
}

function f6 name="elementReadAfterStorageTest" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    v4 = Integer integer=0
    v5 = AssumeType v3 provenType=Array<number, proven, pristine[Storage, Names]>
    v6 = HasArrayStorage v5 arrayStorage=Double
    Branch v6 -> taken b1(| 0), notTaken b2()
  b1(v7):
    v8 = GetArrayElement v5, v4, v7 arrayStorage=Double level=Expected [keyIsIntegral]
    Jump -> next b3(v8)
  b2():
    v9 = ElemGet v5, v4
    Jump -> next b3(v9)
  b3(v10):
    Return v10
# CHECK: v3:{{*}}= CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0 builtinCallForm=Prefix prefixLength=1
# CHECK-NOT: HasArrayStorage
# CHECK-NOT: GetArrayElement
# CHECK-NOT: ElemGet
# CHECK: Return
}

function f7 name="storageTestOfResultThatIsReturned" parameters=[{type=Array<number, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    v4 = HasArrayStorage v3 arrayStorage=Double
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v3
  b2():
    Return v1
# CHECK-NOT: builtinCallForm=
# CHECK: = HasArrayStorage v3 arrayStorage=Double
}

function f8 name="storageTestOfLiteralThatIsReturned" parameters=[{type=number}, {type=i32}] results=[{type=anything}] {
    v2 = NewArray v0 contents=number
    v3 = HasArrayStorage v2 arrayStorage=Double
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2():
    Return v1
# CHECK: = HasArrayStorage {{*}} arrayStorage=Double
}

function f9 name="storageTestNarrowsElementType" parameters=[{type=Array<number|null, proven, pristine[Storage, Names]>}, {type=i32}] results=[{type=anything}] {
    v2 = Integer integer=1
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSplice/0
    v4 = Integer integer=0
    v5 = AssumeType v3 provenType=Array<number|null, proven, pristine[Storage, Names]>
    v6 = HasArrayStorage v5 arrayStorage=Double
    Branch v6 -> taken b1(| 0), notTaken b2()
  b1(v7):
    v8 = GetArrayElement v5, v4, v7 arrayStorage=Double level=Expected [keyIsIntegral]
    Jump -> next b3(v8)
  b2():
    v9 = ElemGet v5, v4
    Jump -> next b3(v9)
  b3(v10):
    Return v10
# CHECK-NOT: builtinCallForm=
# CHECK: = HasArrayStorage v5 arrayStorage=Double
# CHECK: v8: undefined|number = GetArrayElement v5, v4
}
