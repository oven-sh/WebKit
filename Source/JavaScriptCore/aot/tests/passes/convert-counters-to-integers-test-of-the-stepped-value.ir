# `do .. while (++i < n)`, `while (--n >= 0)`: the test looks at what the turn has counted up. What it says goes on to the next turn.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass ConvertCountersToIntegers
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="testedAtTheEnd" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Increment v2
    v5 = Less v4, v0
    Branch v5 -> taken b1(v4), notTaken b2()
  b2():
    Return v4
# CHECK: b1(v2: int[0, 2147483646]):
# CHECK: v4: int[1, 2147483647] = Increment v2
# CHECK: Return v4
}

function f1 name="countsDownToZero" parameters=[{type=i32}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v0, v1)
  b1(v2, v3):
    LoopHint
    v5 = Decrement v2
    v6 = GreaterEq v5, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Increment v3
    Jump -> next b1(v5, v7)
  b3():
    Return v3
# CHECK: b1(v2: i32, v3: int[0, 4294967295]):
# CHECK: Branch v6 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[left]]: int[0, 2147483646]):
# CHECK: Jump -> next b1([[left]],
}

function f2 name="theCopyTestsWhatItHasCountedUp" parameters=[{type=i32}, {type=boolean}, {type=boolean}] results=[{type=number}] {
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b7(v4)
  b2():
    Branch v1 -> taken b3(v4), notTaken b4(v4)
  b3(v7):
    v8 = Increment v7
    Jump -> next b1(v8)
  b4(v9) frequency=Unlikely:
    Branch v2 -> taken b3(v9), notTaken b5()
  b5() frequency=Unlikely:
    LoopHint
    v11 = Increment v9
    v12 = Less v11, v0
    Branch v12 -> taken b6(), notTaken b7(v11)
  b6() frequency=Unlikely:
    Jump -> next b4(v11)
  b7(v13):
    Return v13
# CHECK: b1(v4: int[0, 2147483647]):
# CHECK: b3(v7: int[0, 2147483646]):
# CHECK: b4(v9: int[0, 2147483646])
}
