# The thresholds are heats of blocks: the hot one is that of the coldest blocks that reach into the hottest fifth of the application's code, the cold one that of the coldest blocks above the coldest quarter, and never above what runs once. A function has the class of its entry block
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat
# RUN: pipeline EstimateHeat
# CHECK: f0 RunsOnce 39 1
# CHECK-NEXT: f1 Hot 97 100
# CHECK-NEXT: f2 Hot 83 10
# CHECK-NEXT: f3 Warm 27 2
# CHECK-NEXT: f4 Cold 0 1
# CHECK-NEXT: f5 RunsOnce 0 1
# CHECK: hottest: f1 f2 f0 f3 f4 f5
# CHECK-NEXT: thresholds: cold=1 hot=10

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    v2 = CallDirect v0 function=f5
    v3 = CallDirect v0 function=f3
    v4 = CallDirect v0 function=f3
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = CallDirect v0 function=f4
    v6 = CallDirect v0 function=f4
    Jump -> next b2()
  b2():
    LoopHint
    v8 = CallDirect v0 function=f2
    Jump -> next b3()
  b3():
    LoopHint
    v10 = CallDirect v0 function=f1
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b3()
  b5():
    Branch v1 -> taken b6(), notTaken b7()
  b6():
    Jump -> next b2()
  b7():
    Return
}

function f1 name="calledInInnerLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f2 name="loopCalledInOuterLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return v0
}

function f3 name="branchCalledTwice" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = LogicalNot v1
    Jump -> next b2()
  b2():
    Return v0
}

function f4 name="calledTwiceOnOneSideOfBranch" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    v2 = LogicalNot v1
    v3 = LogicalNot v2
    v4 = LogicalNot v3
    v5 = LogicalNot v4
    Return v5
}

function f5 name="calledOnce" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    v2 = LogicalNot v1
    v3 = LogicalNot v2
    v4 = LogicalNot v3
    v5 = LogicalNot v4
    Return v5
}
