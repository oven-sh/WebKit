    v1 = NewClosure function=f4
    v2 = NewArray contents=anything
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = AssumeType v3 provenType=Array<anything>
    v5 = NewClosure function=f5
    v6 = NewArray contents=anything
    v7 = CallDirect v4, v5, v6 function=f3
    v8 = AssumeType v7 provenType=Array<anything>
    Jump -> next b1()
  b1():
    Return v8
  b2() role=CatchHandler:
    v9 = CatchValue
    Return v9
# CHECK: b0(v0: {{*}}) handler=b2():
# CHECK: [[after8]](v7: anything) handler=b2():
# CHECK: [[asWritten8]]() role=CatchHandler frequency=Rare handler=b2():
# CHECK: = CallDirect v0, v1, {{*}} function=f1
# CHECK: = CallDirect {{*}}, v5, {{*}} function=f3
# CHECK: () handler=[[asWritten8]]():
# CHECK-NEXT: = CallDirect v0, {{*}}, v1, {{*}}, v5, {{*}} function=[[filterMapToArray]] [isAlwaysInlined]
}

