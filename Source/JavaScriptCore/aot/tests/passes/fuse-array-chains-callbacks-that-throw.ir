    v4 = AssumeType v3 provenType=Array<anything>
    v5 = NewClosure function=f14
    v6 = NewArray contents=anything
    v7 = CallDirect v4, v5, v6 function=f2
    Return v7
# CHECK-NOT: role=CatchHandler
# CHECK: = CallDirect v0, {{*}}, v1, {{*}}, v5, {{*}} function=[[mapToFind]] [isAlwaysInlined]
}

# Find is 6, a map in front 1 << 4, a filter 2 << 4, and 1 << 12 says that the links run on every element.
