function f7 name="filterThenMap" parameters=[{type=Array<anything, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = NewClosure function=f4
    v2 = NewArray contents=anything
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = AssumeType v3 provenType=Array<anything>
    v5 = NewClosure function=f5
    v6 = NewArray contents=anything
    v7 = CallDirect v4, v5, v6 function=f3
    v8 = AssumeType v7 provenType=Array<anything>
    Return v8
# CHECK: v1: f4 = NewClosure function=f4
# CHECK-NEXT: v5: f5 = NewClosure function=f5
# CHECK-NOT: function=f1
# CHECK: Jump -> next [[traversal7]]()
# CHECK: [[after7]](v7: anything):
# CHECK-NEXT: v8: Array = AssumeType v7 provenType=Array
# CHECK: [[asWritten7]]() role=CatchHandler frequency=Rare:
# CHECK-NEXT: = CatchValue
# CHECK: [[filtered7]]: anything = CallDirect v0, v1, {{*}} function=f1
# CHECK-NEXT: [[list7]]: {{*}} = AssumeType [[filtered7]] provenType=Array
# CHECK: [[mapped7]]: anything = CallDirect [[list7]], v5, {{*}} function=f3
# CHECK-NEXT: Jump -> next [[after7]]([[mapped7]])
# CHECK: [[traversal7]]() handler=[[asWritten7]]():
# CHECK-NEXT: [[fused7]]: anything = CallDirect v0, {{*}}, v1, {{*}}, v5, {{*}} function=[[filterMapToArray]] [isAlwaysInlined]
# CHECK-NEXT: Jump -> next [[after7]]([[fused7]])
}

function f8 name="insideTry" parameters=[{type=Array<anything, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
