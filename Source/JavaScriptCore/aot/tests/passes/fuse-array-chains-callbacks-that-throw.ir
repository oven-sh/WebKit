function f15 name="mapIsSeenBehindWhatFindTakes" parameters=[{type=Array<anything, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = NewClosure function=f13
    v2 = NewArray contents=anything
    v3 = CallDirect v0, v1, v2 function=f3
    v4 = AssumeType v3 provenType=Array<anything>
    v5 = NewClosure function=f14
    v6 = NewArray contents=anything
    v7 = CallDirect v4, v5, v6 function=f2
    Return v7
# Any call may find the stack full. Where the one behind does, the one in front has been seen on every element, and nothing that was seen can start over.
# CHECK: v3: anything = CallDirect v0, v1, {{*}} function=f3
# CHECK: v7: anything = CallDirect v4, v5, {{*}} function=f2
# CHECK-NOT: role=CatchHandler
}
