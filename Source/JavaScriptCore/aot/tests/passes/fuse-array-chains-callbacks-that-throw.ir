function f12 name="filterThrowsBehindWhatFindTakes" parameters=[{type=Array<anything, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = NewClosure function=f4
    v2 = NewArray contents=anything
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = AssumeType v3 provenType=Array<anything>
    v5 = NewClosure function=f4
    v6 = NewArray contents=anything
    v7 = CallDirect v4, v5, v6 function=f2
    Return v7
# The callback of `filter` still runs on the elements behind the one that `find` takes.
# CHECK: role=CatchHandler frequency=Rare:
# CHECK: = CallDirect v0, v1, {{*}} function=f1
# CHECK: = CallDirect {{*}}, v5, {{*}} function=f2
# CHECK: = CallDirect v0, {{*}}, v1, {{*}}, v5, {{*}} function=[[filterToFindOnEveryElement]] [isAlwaysInlined]
}

