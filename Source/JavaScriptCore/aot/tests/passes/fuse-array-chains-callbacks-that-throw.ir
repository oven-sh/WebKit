# DECLINES: decline ArrayChainNotFused f11 v7 None [0] reason=CallbacksInterfere
# DECLINES: decline ArrayChainNotFused f15 v7 None [0] reason=SkippedCallIsObservable
# DECLINES-NOT: decline

