# const state = new WeakMap();   const make = () => class { constructor(v) { state.set(this, v); } };   const C = make();
# The entries of the collection are a field of the class, and the token for the field is created next to the collection. A copy of the class would be accessed with the token of the original.
# FORM: AsRead
# RUN: pass CopyClosureFactories
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="C" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="token" module=m0 declared={type=anything} initialization=Undefined
layout L0 kind=Instance module=m0 position=20 constructor=f2 fields=[{key=#"state"@L0 declared={type=anything} flags=[IsPrivate, IsHidden]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClassToken layout=L0
    PutModuleVariable v0 variable=g1
    v2 = NewClosure function=f1
    v3 = Call v2
    PutModuleVariable v3 variable=g0
    Return
}
function f1 name="make" module=m0 position=10 kind=Arrow results=[{type=anything}] {
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    Return v2
}
function f2 name="constructor" module=m0 position=20 kind=BaseConstructor flags=[HasNewTarget] length=1 parameters=[{type=anything}] results=[{type=object}] constructedClass=L0 {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = GetModuleVariable variable=g1
    PrivateDefine v3, v4, v1 layout=L0
    Return v3
}
