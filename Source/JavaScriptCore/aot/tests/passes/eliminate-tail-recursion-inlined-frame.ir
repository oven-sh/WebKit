# A tail call that is left in the frame of an inlined callee stood in tail position there and at the call that was inlined, so a call of the function itself becomes a loop
# FORM: Prepared
# RUN: pass EliminateTailRecursion
# STATISTIC: TailRecursionsEliminated = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="outer" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f1 callPosition=10 isTailCall=true module=m0}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f0 @20:1
    ReturnCall v2 @20:1
  b2():
    Return v0
# CHECK-NOT: CallDirect
# CHECK: Jump -> next [[header]](v0)
# CHECK: Jump -> next [[header]]([[carried]]) @20:1
# CHECK: [[header]]([[carried]]: number):
# CHECK-NEXT: LoopHint
# CHECK-NOT: CallDirect
}

function f1 name="inlined" parameters=[{type=number}] results=[{type=number}] {
    v1 = CallDirect v0 function=f0 @20
    ReturnCall v1 @20
# CHECK-NOT: LoopHint
# CHECK: v1: number = CallDirect v0 function=f0 @20
# CHECK-NEXT: ReturnCall v1 @20
}
