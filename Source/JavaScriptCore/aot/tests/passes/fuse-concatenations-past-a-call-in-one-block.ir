# FORM: Prepared
# RUN: pass FuseConcatenations

module m0 path="main.js" displayPath="main.js"
function f0 name="callBetweenShortParts" parameters=[{type=number}, {type=function}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: function, v2: boolean):
    v3 = String string=":"
    v4 = Add v0, v3
    v5 = Call v1
    v6 = Add v4, v2
    Return v6
}
# CHECK-LABEL: function f0 name="callBetweenShortParts"
# CHECK-NOT: = Add
# CHECK: string = Strcat v0, v3, v2

