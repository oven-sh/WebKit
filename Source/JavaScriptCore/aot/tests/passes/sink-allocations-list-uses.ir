# A use that lists a virtual array or copies a virtual object takes the values one by one, so the cell is never built
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 20
# STATISTIC: AllocationsSunk = 4

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 kind=Instance name="Base" constructor=f24 flow={baseState=None}
layout L2 kind=Instance name="Derived" predictedBase=L1 constructor=f25 flags=[HasHeritage] flow={baseState=Layout base=L1}
layout L3 name="Sized" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=number}}]
layout L4 name="Many" fields=[{key="k0" declared={type=anything}}, {key="k1" declared={type=anything}}, {key="k2" declared={type=anything}}, {key="k3" declared={type=anything}}, {key="k4" declared={type=anything}}, {key="k5" declared={type=anything}}, {key="k6" declared={type=anything}}, {key="k7" declared={type=anything}}, {key="k8" declared={type=anything}}]
layout L5 name="WithMethod" fields=[{key="x" declared={type=anything}}, {key="m" declared={type=anything} flags=[IsMethod]}]
layout L6 kind=Instance name="Secret" fields=[{key="x" declared={type=anything}}, {key=#"s"@L6 declared={type=anything} flags=[IsPrivate]}] flow={baseState=None}

function f0 name="appendElementsIntoVirtualArray" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
