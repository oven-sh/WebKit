# CHECK-NEXT: Unreachable
# CHECK-NOT: TypeTest
# CHECK-NOT: LoopHint
# CHECK-NOT: = Call v1,
# CHECK: = ElemGet [[subject0]],
# CHECK-NOT: TypeTest
