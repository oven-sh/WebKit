# When only undefined and null are left beside a proven class, the failing edge of the one test throws and there is no protocol
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(LEFT): pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 2
# STATISTIC: IterationsExpandedGenerically = 0

module m0 path="main.js" displayPath="main.js"

function f0 name="arrayOrNullish" parameters=[{type=undefined|null|Array<number, pristine[Names]>}, {type=anything}] results=[{type=undefined}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
