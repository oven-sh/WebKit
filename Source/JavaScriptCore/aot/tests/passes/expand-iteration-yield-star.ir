# The three resumptions of yield* are steps of one iteration: a generator is stepped in place, an array has neither return nor throw
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(LEFT): pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 4
# STATISTIC: IterationsExpandedGenerically = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Bag" fields=[{key="x" declared={type=number}}]

function f0 name="overGenerator" flags=[IsGenerator, TakesCallee] parameters=[{type=Generator<anything, pristine[Names]>}] results=[{type=anything}] {
  b0(v0: function, v1: Generator<anything, pristine[Names]>):
    InitialYield
    v3 = IteratorOpen v1
    v4 = Undefined
    Jump -> next b1(v4)
  b1(v5):
    v6 = IteratorResume v3, v5 [readsValueWhenDone]
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Branch v7 -> taken b6(v8), notTaken b2(v8)
  b2(v9):
    LoopHint
    v11 = Yield v9
    v12 = ResultAt v11
    v13 = ResultAt v11 index=1
    Switch v13 cases=[1, 2] -> case b3(v12), case b4(v12), otherwise b1(v12)
  b3(v14):
    v15 = IteratorResume v3, v14 resumeMode=Throw [readsValueWhenDone]
    v16 = ResultAt v15
    v17 = ResultAt v15 index=1
    Branch v16 -> taken b6(v17), notTaken b2(v17)
  b4(v18):
    v19 = IteratorResume v3, v18 resumeMode=Return [readsValueWhenDone]
    v20 = ResultAt v19
    v21 = ResultAt v19 index=1
    Branch v20 -> taken b5(v21), notTaken b2(v21)
  b5(v22):
    Return v22
  b6(v23):
    Return v23
}
# CHECK-LABEL: function f0 name="overGenerator"
# CHECK: b1(v5: anything):
# CHECK-NEXT: [[next0]]: undefined = StepGenerator v1, v5 check=None
# CHECK-NEXT: [[nextValue0]]: anything = ResultAt [[next0]]
# CHECK-NEXT: [[nextStatus0]]: int[0, 2] = ResultAt [[next0]] index=1
# CHECK-NEXT: [[notStepped0]]: 2 = Integer integer=2
# CHECK-NEXT: [[wasNotStepped0]]: boolean = StrictEq [[nextStatus0]], [[notStepped0]]
# CHECK-NEXT: Branch [[wasNotStepped0]] -> taken [[call0]](), notTaken [[stepped0]]()
# CHECK: b3(v14: anything):
# CHECK-NEXT: = StepGenerator v1, v14 resumeMode=Throw check=None
# CHECK: b4(v18: anything):
# CHECK-NEXT: = StepGenerator v1, v18 resumeMode=Return check=None
# CHECK: [[after0]](v7: boolean, v8: anything):
# CHECK: [[call0]]() frequency=Rare:
# CHECK-NEXT: [[method0]]: builtin(GeneratorPrototypeNext) = Builtin builtin=GeneratorPrototypeNext
# CHECK-NEXT: = Call [[method0]], v1, v5
# CHECK: [[stepped0]]():
# CHECK-NEXT: [[completed0]]: 1 = Integer integer=1
# CHECK-NEXT: [[done0]]: boolean = StrictEq [[nextStatus0]], [[completed0]]
# CHECK-NEXT: Jump -> next [[after0]]([[done0]], [[nextValue0]])
# ABSENT-LABEL: function f0 name="overGenerator"
# ABSENT-NOT: IsUnmodifiedGenerator
# ABSENT-NOT: check=IsUnmodified
# ABSENT-NOT: @@iterator
# ABSENT-NOT: [isNeverInlined]
# ABSENT-NOT: key="next"
# ABSENT-COUNT-3: = StepGenerator
# ABSENT-NOT: = StepGenerator

