# Of the shapes that may reach a JSON.stringify only so many get a test and a serializer (MaxJSONLayoutSetMembers). Which ones, and in which order they are tested, goes by what they are:
# what the program makes before what the library makes, members that all have a text before members without one, few members before many.
# (An instance of a class comes behind the records. Here nothing says that its prototype has no toJSON, so it gets no serializer whatever its place.)
# Never by their numbers: the same six shapes stand here twice, numbered in two orders, and the same four are chosen in the same order.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot limit=MaxJSONLayoutSetMembers:4
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 3
# STATISTIC: MaxJSONLayoutSetMembersHits = 4
# LOSS: MaxJSONLayoutSetMembers x4 f0

module m0 path="main.js" displayPath="main.js"
module m1 path="library.js" displayPath="library.js" flags=[IsLibrary]
layout L0 name="Internal" module=m1 position=5 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L1 kind=Instance name="Made" module=m0 position=50 constructor=f3 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L2 name="Marked" module=m0 position=40 fields=[{key="a" declared={type=number}}, {key="mark" declared={type=symbol}}] flow={constructorOrders=[{fields=[0, 1]}]}
layout L3 name="Five" module=m0 position=30 fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}, {key="c" declared={type=number}}, {key="d" declared={type=number}}, {key="e" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2, 3, 4]}]}
layout L4 name="Two" module=m0 position=20 fields=[{key="a" declared={type=number}}, {key="b" declared={type=string}}] flow={constructorOrders=[{fields=[0, 1]}]}
layout L5 name="One" module=m0 position=10 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L6 name="Two" module=m0 position=20 fields=[{key="a" declared={type=number}}, {key="b" declared={type=string}}] flow={constructorOrders=[{fields=[0, 1]}]}
layout L7 name="Internal" module=m1 position=5 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L8 name="One" module=m0 position=10 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L9 kind=Instance name="Made" module=m0 position=50 constructor=f4 fields=[{key="a" declared={type=number}}] flow={constructorOrders=[{fields=[0]}]}
layout L10 name="Five" module=m0 position=30 fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}, {key="c" declared={type=number}}, {key="d" declared={type=number}}, {key="e" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1, 2, 3, 4]}]}
layout L11 name="Marked" module=m0 position=40 fields=[{key="a" declared={type=number}}, {key="mark" declared={type=symbol}}] flow={constructorOrders=[{fields=[0, 1]}]}

function f0 name="numberedOneWay" parameters=[{type=L0|L1|L2|L3|L4|L5}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONStringify/0
    Return v2
# CHECK: = StringBuilderBegin
# CHECK-NOT: layouts=[L1]
# CHECK-NOT: layouts=[L0]
# CHECK: = ShapeTest {{*}} layouts=[L5]
# CHECK: = ShapeTest {{*}} layouts=[L4]
# CHECK: = ShapeTest {{*}} layouts=[L3]
# CHECK: = ShapeTest {{*}} layouts=[L2]
}

function f1 name="numberedAnotherWay" parameters=[{type=L6|L7|L8|L9|L10|L11}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONStringify/0
    Return v2
# CHECK: = StringBuilderBegin
# CHECK-NOT: layouts=[L9]
# CHECK-NOT: layouts=[L7]
# CHECK: = ShapeTest {{*}} layouts=[L8]
# CHECK: = ShapeTest {{*}} layouts=[L6]
# CHECK: = ShapeTest {{*}} layouts=[L10]
# CHECK: = ShapeTest {{*}} layouts=[L11]
}

# Where all of them get a test the order is the same.
function f2 name="fewEnough" parameters=[{type=L0|L1|L5}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallBuiltin -, v0, v1 overload=JSONStringify/0
    Return v2
# CHECK: = StringBuilderBegin
# CHECK: = ShapeTest {{*}} layouts=[L5]
# CHECK: = ShapeTest {{*}} layouts=[L0]
}

function f3 name="Made" module=m0 position=50 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="Made" module=m0 position=50 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L9
    v2 = NewObject v1 layout=L9 fields=[]
    Return v2
}
