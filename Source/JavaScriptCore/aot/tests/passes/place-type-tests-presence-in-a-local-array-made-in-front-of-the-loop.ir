# An array that the function allocates in front of a loop lasts through the turns of the loop, so a read in the loop gets the test for a present element as a read of any other array does; a read beside the allocation gets none
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# STATISTIC: ElementPresenceTestsPlaced = 1

module m0 path="main.js" displayPath="main.js"
variable g0 name="first" module=m0 declared={type=anything} initialization=Undefined

function f0 name="sumOfLiteral" parameters=[{type=i32}, {type=i32}, {type=i32}] results=[{type=i32}] {
    v3 = NewArray v0, v1 contents=i32
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = ElemGet v3, v4
    PutModuleVariable v6 variable=g0
    Jump -> next b1(v4, v4)
  b1(v8, v9):
    LoopHint
    v11 = Less v8, v2
    Branch v11 -> taken b2(), notTaken b3()
  b2():
    v12 = BitAnd v8, v5
    v13 = ElemGet v3, v12
    ElemSet v3, v12, v9
    v15 = Add v9, v13
    v16 = BitOr v15, v4
    v17 = Increment v8
    Jump -> next b1(v17, v16)
  b3():
    Return v9
}
# CHECK-LABEL: function f0 name="sumOfLiteral"
# CHECK-NOT: IsElementPresent
# CHECK: : undefined|i32 = GetArrayElement {{*}}[keyIsIntegral]
# CHECK-NEXT: PutModuleVariable
# CHECK: = IsElementPresent {{*}}arrayStorage=Int32 [keyIsIntegral]
# CHECK: : i32 = GetArrayElement {{*}}[keyIsIntegral, isPresent]
