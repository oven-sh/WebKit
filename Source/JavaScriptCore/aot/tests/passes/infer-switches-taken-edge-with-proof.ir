function f6 name="casesShareOneTarget" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Return v3
  b2():
    v4 = Integer integer=1
    v5 = StrictEq v0, v4
    Branch v5 -> taken b1(| 0), notTaken b3()
  b3():
    v6 = Integer integer=2
    v7 = StrictEq v0, v6
    Branch v7 -> taken b1(v0), notTaken b4()
  b4():
    Return v0
}
# CHECK-LABEL: function f6 name="casesShareOneTarget"
# CHECK: Switch v0 cases=[0, 1, 2] -> case [[sharedZero]](| 0), case [[sharedOne]](| 0), case b1(v0), otherwise b4()
# CHECK: [[sharedZero]]([[zeroValue]]: 0):
# CHECK-NEXT: Jump -> next b1([[zeroValue]])
# CHECK: [[sharedOne]]([[oneValue]]: 1):
# CHECK-NEXT: Jump -> next b1([[oneValue]])
