    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f2 name="proofAboutTheConstant"
# CHECK-NOT: Switch
# CHECK: Branch v4 -> taken b3(| 1), notTaken b4()
# CHECK-NOT: Switch

function f3 name="chainBehindProofAboutTheConstant" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 1), notTaken b2()
  b1(v3):
    Return v3
  b2():
    v4 = Integer integer=1
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(| 0), notTaken b4()
  b3(v6):
    Return v6
  b4():
    v7 = Integer integer=2
    v8 = StrictEq v0, v7
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v9 = Integer integer=3
    v10 = StrictEq v0, v9
    Branch v10 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}
# CHECK-LABEL: function f3 name="chainBehindProofAboutTheConstant"
# CHECK: Branch v2 -> taken b1(| 1), notTaken b2()
# CHECK: b2():
# CHECK: Switch v0 cases=[1, 2, 3] -> case [[stubBehind]](| 0), case b5(), case b7(), otherwise b8()
# CHECK: [[stubBehind]]([[narrowed]]: 1):
# CHECK-NEXT: Jump -> next b3([[narrowed]])

function f4 name="proofsOnBothEdges" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return v3
  b2(v4):
    v5 = Integer integer=1
    v6 = StrictEq v4, v5
    Branch v6 -> taken b3(| 0), notTaken b4(| 0)
  b3(v7):
    Return v7
  b4(v8):
    v9 = Integer integer=2
    v10 = StrictEq v8, v9
    Branch v10 -> taken b5(| 0), notTaken b6(| 0)
  b5(v11):
    Return v11
  b6(v12):
    Return v12
}
# CHECK-LABEL: function f4 name="proofsOnBothEdges"
# CHECK: Switch v0 cases=[0, 1, 2] -> case [[zeroStub]](| 0), case [[oneStub]](| 0), case [[twoStub]](| 0), otherwise b6()
# CHECK: b1(v3: 0):
# CHECK: b3(v7: 1):
# CHECK: b5(v11: 2):
# CHECK: b6():
# CHECK-NEXT: Return v0
# CHECK: [[zeroStub]]([[isZero]]: 0):
# CHECK-NEXT: Jump -> next b1([[isZero]])
# CHECK: [[oneStub]]([[isOne]]: 1):
# CHECK-NEXT: Jump -> next b3([[isOne]])
# CHECK: [[twoStub]]([[isTwo]]: 2):
# CHECK-NEXT: Jump -> next b5([[isTwo]])

