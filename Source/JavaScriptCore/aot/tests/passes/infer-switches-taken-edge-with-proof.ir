# What a comparison proves about the subject on its taken edge is proven by the case of the switch
# FORM: Prepared
# RUN: pass InferSwitches
# STATISTIC: InferSwitchesChanges = 5

module m0 path="main.js" displayPath="main.js"
function f0 name="oneTakenEdgeWithProof" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=1
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(| 0), notTaken b4()
  b3(v5):
    Return v5
  b4():
    v6 = Integer integer=2
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f0 name="oneTakenEdgeWithProof"
# CHECK: Switch v0 cases=[0, 1, 2] -> case b1(), case [[stub]](| 0), case b5(), otherwise b6()
# CHECK: b3(v5: 1):
# CHECK-NEXT: Return v5
# CHECK: [[stub]]([[one]]: 1):
# CHECK-NEXT: Jump -> next b3([[one]])

function f1 name="argumentsInFrontOfTheProof" parameters=[{type=i32}, {type=string}] results=[{type=anything}] {
  b0(v0: i32, v1: string):
    v2 = Integer integer=7
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(v1 | 0), notTaken b2()
  b1(v4, v5):
    v6 = Add v4, v5
    Return v6
  b2():
    v7 = Integer integer=8
    v8 = StrictEq v7, v0
    Branch v8 -> taken b3(v1 | 1), notTaken b4()
  b3(v9, v10):
    v11 = Add v9, v10
    Return v11
  b4():
    v12 = Integer integer=9
    v13 = StrictEq v0, v12
    Branch v13 -> taken b5(| 0, 0), notTaken b6()
  b5(v14, v15):
    v16 = Add v14, v15
    Return v16
  b6():
    Return v0
}
# CHECK-LABEL: function f1 name="argumentsInFrontOfTheProof"
# CHECK: Switch v0 cases=[7, 8, 9] -> case [[stub7]](| 0), case [[stub8]](| 0), case [[stub9]](| 0, 0), otherwise b6()
# CHECK: b1(v4: string, v5: 7):
# CHECK: b3(v9: string, v10: 8):
# CHECK: b5(v14: 9, v15: 9):
# CHECK: [[stub7]]([[seven]]: 7):
# CHECK-NEXT: Jump -> next b1(v1, [[seven]])
# CHECK: [[stub8]]([[eight]]: 8):
# CHECK-NEXT: Jump -> next b3(v1, [[eight]])
# CHECK: [[stub9]]([[nine]]: 9, [[nineAgain]]: 9):
# CHECK-NEXT: Jump -> next b5([[nine]], [[nineAgain]])

function f2 name="proofAboutTheConstant" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = Integer integer=0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=1
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(| 1), notTaken b4()
  b3(v5):
    Return v5
  b4():
    v6 = Integer integer=2
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
