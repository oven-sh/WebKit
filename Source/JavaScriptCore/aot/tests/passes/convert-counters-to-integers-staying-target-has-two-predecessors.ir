# A staying edge into a block with another incoming edge is split, and the block in the middle receives the counter
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 2
# STATISTIC: ConvertCountersToIntegersChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="stayingTargetIsHeaderOfInnerLoop" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    LoopHint
    v8 = Call v1, -, v4
    v9 = ToBoolean v8
    Branch v9 -> taken b2(), notTaken b3()
  b3():
    v10 = Add v4, v3
    Jump -> next b1(v10)
  b4():
    Return
# CHECK: b1(v4: int[0, 100]):
# CHECK: v6: boolean = Less v4, v0
# CHECK-NEXT: Branch v6 -> taken [[middle0]](| 0), notTaken b4()
# CHECK-NEXT: b2():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = Call v1, -, [[counter0]]
# CHECK: Branch v9 -> taken b2(), notTaken b3()
# CHECK-NEXT: b3():
# CHECK-NEXT: v10: int[1, 100] = Add [[counter0]], v3
# CHECK: [[middle0]]([[counter0]]: int[0, 99]):
# CHECK-NEXT: Jump -> next b2()
}

function f1 name="stayingTargetHasOnePredecessor" parameters=[{type=int[0, 100]}, {type=anything}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b5()
  b2():
    Jump -> next b3()
  b3():
    LoopHint
    v8 = Call v1, -, v4
    v9 = ToBoolean v8
    Branch v9 -> taken b3(), notTaken b4()
  b4():
    v10 = Add v4, v3
    Jump -> next b1(v10)
  b5():
    Return
# CHECK: Branch v6 -> taken b2(| 0), notTaken b5()
# CHECK-NEXT: b2([[counter1]]: int[0, 99]):
# CHECK-NEXT: Jump -> next b3()
# CHECK: = Call v1, -, [[counter1]]
# CHECK: v10: int[1, 100] = Add [[counter1]], v3
# CHECK: b5():
# CHECK-NEXT: Return
# CHECK-NEXT: }
}

function f2 name="otherPredecessorSkipsTheTest" parameters=[{type=int[0, 100]}, {type=boolean}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v6 = Less v4, v0
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Add v4, v3
    Jump -> next b1(v7)
  b4():
    Return
# CHECK: b1(v4: int|whole):
# CHECK: Branch v6 -> taken b3(), notTaken b4()
# CHECK-NEXT: b3():
# CHECK-NEXT: v7: int|whole = Add v4, v3
# CHECK: b4():
# CHECK-NEXT: Return
# CHECK-NEXT: }
}
