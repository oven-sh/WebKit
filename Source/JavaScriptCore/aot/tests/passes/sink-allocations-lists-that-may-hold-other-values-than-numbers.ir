    v3 = AssumeType v2 castType=Array<undefined|i32, proven, pristine[Storage, Names, Dense]>
    v4 = Integer integer=1
    v5 = HasArrayStorage v3 arrayStorage=Int32
    Branch v5 -> taken b1(| 0), notTaken b3()
  b1(v6):
    v7 = IsInBounds v3, v4
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = AllGuards v6, v8
    v10 = GetArrayElement v3, v4, v9 arrayStorage=Int32 level=Expected [keyIsIntegral, isInBounds]
    Return v10
  b3() frequency=Rare:
    v11 = ElemGet v3, v4 [keyIsIntegral]
    Return v11
