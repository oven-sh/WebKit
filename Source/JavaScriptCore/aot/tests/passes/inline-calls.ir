    v3 = CallDirect v2 function=f0
    Return v3
  b2():
    Return v0
}
# CHECK-LABEL: name="rareCalls"
# CHECK: = CallDirect v0 function=f1
# CHECK-NEXT: = CallDirect v2 function=f0
