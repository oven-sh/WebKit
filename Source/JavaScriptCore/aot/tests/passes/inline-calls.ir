# Each decision and each benefit of the inlining model
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 15
# STATISTIC: InlineDecisionInlineHead = 1
# STATISTIC: InlineDecisionCostExceedsBenefit = 11
# STATISTIC: InlineDecisionBarrier = 6
# STATISTIC: InlineDecisionClosesCycle = 2
# STATISTIC: InlineDecisionDepthLimit = 1
# STATISTIC: InlineDecisionSignatureMismatch = 0
# STATISTIC: InlineDecisionCallerSizeLimit = 0
# STATISTIC: InlineBenefitWrapper = 2
# STATISTIC: InlineBenefitFoldedCode = 1
# STATISTIC: InlineBenefitKnownCalleeArgument = 1
# STATISTIC: InlineBenefitSunkAllocation = 2
# STATISTIC: InlineBenefitOnlyCallSite = 2
# LOSS: MaxInlineDepth x1 f22 v1
# LOSS: MaxOnlyCallSiteBytes x1 f32 v1
# LOSS: MaxInlineHeadBytes x7 f1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="a" declared={type=number} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}, {key="b" declared={type=number} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}]
evalscope e0 mode=Strict

