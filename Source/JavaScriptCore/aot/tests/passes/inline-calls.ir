}

function f10 name="hasNoBody" parameters=[{type=number}] results=[{type=number}]

function f11 name="awaits" flags=[IsAsync] parameters=[{type=number}] results=[{type=anything}] {
    v1 = Await v0
    Return v1
}

function f12 name="evaluatesText" parameters=[{type=number}] results=[{type=number}] {
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return v0
}

function f13 name="recursive" parameters=[{type=number}] results=[{type=number}] {
    v1 = CallDirect v0 function=f13
    v2 = CallDirect v1 function=f0
    Return v2
}
# CHECK-LABEL: name="recursive"
