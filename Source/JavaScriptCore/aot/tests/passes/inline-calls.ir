function f4 name="callsParameterInLoop" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
  b0(v0: anything, v1: number):
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Call v0, -, v3
    v7 = Integer integer=1
    v8 = Add v3, v7
