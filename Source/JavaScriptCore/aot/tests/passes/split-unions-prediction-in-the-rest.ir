# The rest of a split is unlikely where an arm takes what is expected. Where the expected type lies in the rest, the rest keeps the frequency of the block: one side of a test is always as likely as the test
# A part that no test tells from the others is left to the rest, where the access resolves on it behind their tests: it is expected as much as they are
# FORM: Prepared
# RUN: pass SplitUnions
# STATISTIC: UnionsSplit = 5

module m0 path="main.js" displayPath="main.js"

function f0 name="expectedPartHasNoArm" parameters=[{type=string|function}] results=[{type=anything}] {
  b0(v0: string|function ~ function):
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: = TypeTest v0 testedType=string
# CHECK: ([[text0]]: string) frequency=Unlikely:
# CHECK-NEXT: = PropGet [[text0]] key="length"
# CHECK: ([[handler0]]: function):
# CHECK-NEXT: = PropGet [[handler0]] key="length"
}

function f1 name="expectedPartHasAnArm" parameters=[{type=string|function}] results=[{type=anything}] {
  b0(v0: string|function ~ string):
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: = TypeTest v0 testedType=string
# CHECK: ([[text1]]: string):
# CHECK-NEXT: = PropGet [[text1]] key="length"
# CHECK: ([[handler1]]: function) frequency=Unlikely:
# CHECK-NEXT: = PropGet [[handler1]] key="length"
}

function f2 name="nothingIsExpected" parameters=[{type=string|function}] results=[{type=anything}] {
    v1 = PropGet v0 key="length"
    Return v1
# CHECK: ([[text2]]: string):
# CHECK: ([[handler2]]: function) frequency=Unlikely:
}

function f3 name="partWithoutTestIsExpectedAsMuchAsTheArms" parameters=[{type=string|Array<number>|ArrayIterator}] results=[{type=anything}] {
    v1 = PropGet v0 key="toString"
    Return v1
# CHECK: ([[text3]]: string):
# CHECK: ([[iterator3]]: ArrayIterator):
# CHECK-NEXT: = PropGet [[iterator3]] key="toString"
}

function f4 name="partWithoutTestBesideAnExpectedArm" parameters=[{type=string|Array<number>|ArrayIterator}] results=[{type=anything}] {
  b0(v0: string|Array<number>|ArrayIterator ~ string):
    v1 = PropGet v0 key="toString"
    Return v1
# CHECK: ([[text4]]: string):
# CHECK: ([[iterator4]]: ArrayIterator) frequency=Unlikely:
# CHECK-NEXT: = PropGet [[iterator4]] key="toString"
}
