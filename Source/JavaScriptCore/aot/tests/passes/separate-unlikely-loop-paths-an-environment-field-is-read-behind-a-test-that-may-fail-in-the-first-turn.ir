# The copy of a function reads a variable of an enclosing function: the read gives a word that may be anything, and the cast behind it names the fact that says where the copy begins. The variable goes around the
# loop as such a word. Nobody looks at it ahead of the loop, and the cast stays where the fact is
# FORM: Prepared
# RUN: pass SeparateUnlikelyLoopPaths VerifyProgram

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="text" declared={type=string} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}}}]

function f0 name="readBehindTest" parameters=[{type=anything}, {type=env L0}] results=[{type=anything}] inlineFrames=[{}, {callee=f1 module=m0}] {
  b0(v0: anything, v1: env L0):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IsClosureOf v0 function=f1
    Branch v3 -> taken b2(), notTaken b4()
  b2():
    v4 = Entered function=f1
    v5 = GetEnvironmentField v1 layout=L0 field=0 [mayPrecedeItsStore] @0:1
    v6 = AssumeType v5, v4 provenType=string
    v7 = String string="n"
    v8 = Add v6, v7
    PutEnvironmentField v1, v8 layout=L0 field=0
    v10 = GetStringLength v8
    v11 = Integer integer=9
    v12 = Less v10, v11
    Branch v12 -> taken b1(), notTaken b3()
  b3():
    Return v0
  b4() frequency=Unlikely:
    v13 = Undefined
    Return v13
# CHECK: b0(
# CHECK-NEXT: [[first]]: string|unspecified = GetEnvironmentField v1 layout=L0 [mayPrecedeItsStore]
# CHECK-NEXT: Jump -> next b1([[first]])
# CHECK-NEXT: b1([[carried]]: string|unspecified):
# CHECK: b2():
# CHECK-NEXT: [[entered]]: fact = Entered function=f1
# CHECK-NOT: GetEnvironmentField
# CHECK: [[text]]: string = AssumeType {{*}}, [[entered]] provenType=string
# CHECK: = Add [[text]],
# CHECK: b3():
}
function f1 name="callee" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}
