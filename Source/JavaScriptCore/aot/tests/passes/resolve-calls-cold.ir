# Heat picks no form: a cold function resolves its calls exactly as a hot one
# FORM: Prepared
# OPTIONS: heat=EverythingIsCold
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Task" constructor=f2 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f3 mutability=Fixed}]}
function f0 name="first" results=[{type=anything}] {
    Return
}
function f1 name="second" results=[{type=anything}] {
    Return
}
function f2 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L0}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f3 name="run" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
    Return
}

function f4 name="two-functions" parameters=[{type=f0|f1}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
# CHECK: TypeTest v0 testedType=f0
# CHECK: = CallDirect function=f0
# CHECK: = CallDirect function=f1
# CHECK-NOT: = Call v
}
function f5 name="method" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
# CHECK: = CallDirect v0 function=f3
# CHECK-NOT: = Call v
}
function f6 name="construct" parameters=[{type=f2}] results=[{type=anything}] {
    v1 = Construct v0
    Return v1
# CHECK: = CallDirect {{*}} [isConstruction]
# CHECK-NOT: = Construct
}
function f7 name="expected-receiver" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
# CHECK-NEXT: b0(v0: anything ~ L0):
# CHECK-NEXT: = PropGet v0 key="run"
# CHECK-NEXT: = Call v1, v0 calleeKey="run"
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
}
