# A call leads on from a function that runs often or that a loop calls if it has a weight of a hundredth or more there. A call behind two unlikely branches has less: what it calls is compact. A call behind one has more
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f1 Cold 10 1
# CHECK-NEXT: f2 Compact 10 1
# CHECK-NEXT: f3 Cold 10 1
# CHECK-NEXT: f4 Compact 10 1
# CHECK-NEXT: f5 Cold 10 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v0, v0 function=f1
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}

