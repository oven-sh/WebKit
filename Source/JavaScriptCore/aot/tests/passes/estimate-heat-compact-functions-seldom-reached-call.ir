    v73 = ToBoolean v1
    Branch v72 -> taken b1(), notTaken b3()
  b1() frequency=Unlikely:
    Branch v73 -> taken b2(), notTaken b5()
  b2() frequency=Unlikely:
    v74 = CallDirect v0 function=f2
    Return v74
  b3():
    Branch v73 -> taken b4(), notTaken b5()
  b4() frequency=Unlikely:
    v75 = CallDirect v0 function=f3
    Return v75
  b5():
    Return v0
}

