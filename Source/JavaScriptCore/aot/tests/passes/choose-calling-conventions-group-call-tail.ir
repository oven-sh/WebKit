# A tail call of a group stays a jump where caller and group return in the same representation
# FORM: Prepared
# RUN: pass GroupCallsByValue CreateEntrypoints ChooseCallingConventions
# STATISTIC: GroupCalls = 2
# STATISTIC: ReturnCallsDemoted = 6

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="returnsNumber"
# CHECK: v2: number = CallGroup v0, v1 function=
# CHECK-NEXT: ReturnCall v2 {{*}}requirement=Allowed
function f0 name="returnsNumber" parameters=[{type=f2|f3|f4|f5|f6}, {type=number}] results=[{type=number}] {
  b0(v0: f2|f3|f4|f5|f6, v1: number):
    v2 = Call v0, -, v1 accessSite=0 callees=[f2, f3, f4, f5, f6]
    ReturnCall v2 casts=[{declared={type=number} resolution=Assume}] requirement=Allowed
}
# CHECK-LABEL: function f1 name="returnsAnything"
# CHECK: v2: number = CallGroup v0, v1 function=
# CHECK-NEXT: Return v2
function f1 name="returnsAnything" parameters=[{type=f2|f3|f4|f5|f6}, {type=number}] results=[{type=anything}] {
  b0(v0: f2|f3|f4|f5|f6, v1: number):
    v2 = Call v0, -, v1 accessSite=1 callees=[f2, f3, f4, f5, f6]
    ReturnCall v2 requirement=Allowed
}
function f2 name="first" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f3 name="second" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f4 name="third" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f5 name="fourth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f6 name="fifth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
