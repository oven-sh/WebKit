  b0(v0: anything ~ undefined|null|Array<number>):
    v1 = Integer integer=0
    v2 = Integer integer=-1
    Jump -> next b1(v1, v2)
  b1(v3: i32, v4: int|whole ~ int[-1, 2147483647]):
    LoopHint
    v6: int|whole ~ int[0, 2147483648] = Increment v4
    v7 = PropGet v0 key="length"
    v8: anything ~ number = Upcast v7 castType=anything
    v9 = Less v6, v8
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = ElemGet v0, v6 [keyIsIntegral]
    v11: anything ~ number = Upcast v10 castType=anything
