# `++i < n`, `i++ < n`, `do .. while (++i < n)`: every turn compares the counter with an integer beyond int32, so what the loop hands on is an integer wherever the step stands, which ConvertCountersToIntegers finds out. No operator in the loop gets a test of the counter, or of what is a constant away from it.
# FORM: Prepared
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
function f0 name="whatTheTurnHasCountedUpIsCompared" parameters=[{type=int[0, 4294967296]}] results=[{type=i32}] {
    v1 = Integer integer=0
    v2 = Integer integer=-1
    Jump -> next b1(v1, v2)
  b1(v3: i32, v4: int|whole ~ int[-1, 2147483647]):
    LoopHint
    v6: int|whole ~ int[0, 2147483648] = Increment v4
    v7 = Less v6, v0
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Integer integer=127
    v9: int[0, 127] = BitAnd v6, v8
    v10: i32 = BitXor v3, v9
    Jump -> next b1(v10, v6)
  b3():
    Return v3
# CHECK-NOT: TypeTest
}

