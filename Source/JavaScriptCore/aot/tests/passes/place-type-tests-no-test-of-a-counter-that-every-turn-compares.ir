    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Integer integer=1
    v10: int|whole ~ int[0, 2147483647] = Sub v7, v9
    v11 = Integer integer=127
    v12: int[0, 127] = BitAnd v10, v11
    v13: i32 = BitXor v3, v12
    Jump -> next b1(v13, v7)
  b3():
