function f7 name="theOneCallOutsideALoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f2
    Return v1
}
# CHECK-LABEL: function f7 name="theOneCallOutsideALoop"
# CHECK: = CallDirect {{*}} function=f2

function f8 name="theOneCallOfFarMoreInALoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = PropGet v0 key="more"
    v3 = ToBoolean v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    v4 = CallDirect v0 function=f3
    PropSet v0, v4 key="last" mode=Strict
    Jump -> next b1()
  b3():
    Return v2
}
