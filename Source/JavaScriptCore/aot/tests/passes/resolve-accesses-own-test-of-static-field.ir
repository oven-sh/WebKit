# A static field is an own property of its class from its own definition on. The calls of Object.hasOwn and hasOwnProperty test the key, so flow counts them among the accesses to the field:
# "b" is asked for in front of its definition and has no proof of its initialization, and none of the tests of it is answered. "z" is asked for behind its definition only, and the test is true.
#   class S2 { static a = Object.hasOwn(S2, "b"); static c = S2.hasOwnProperty("b"); static b = 1; static e = Object.hasOwn(S2, "b"); static z = 2; static y = Object.hasOwn(S2, "z") }
#   print(S2.a, S2.c, S2.e, Object.hasOwn(S2, "b"), Object.hasOwn(S2, "missing"), S2.y)
# RUN: pipeline CheckPlacement
# CHECK: variable g4 {{*}}flow={writers=AllKnown stores=AtMostOnce}
# CHECK: variable g6 {{*}}initialization=StoredBeforeEveryRead
# CHECK-LABEL: function f6 module=m0 position=6 kind=Initializer
# CHECK: [[first]]: boolean = PropHasOwn {{*}}key="b"
# CHECK: PutModuleVariable [[first]] variable=g2
# CHECK: [[second]]: boolean = PropHasOwn {{*}}key="b"
# CHECK: PutModuleVariable [[second]] variable=g3
# CHECK: [[third]]: boolean = PropHasOwn {{*}}key="b"
# CHECK: PutModuleVariable [[third]] variable=g5
# CHECK-NOT: PropHasOwn {{*}}key="z"
# CHECK: [[known]]: true = Boolean boolean=true
# CHECK: PutModuleVariable [[known]] variable=g7

layout L0 kind=Instance name="S2" module=m0 position=6 constructor=f1 staticFields=[{key="a" variable=g2}, {key="c" variable=g3}, {key="b" variable=g4}, {key="e" variable=g5}, {key="z" variable=g6}, {key="y" variable=g7}]
