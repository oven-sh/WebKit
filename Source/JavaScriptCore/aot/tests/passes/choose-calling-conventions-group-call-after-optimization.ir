# With every pass on, a call by value with six proven callees ends as one group call without a test, one with four as tests and direct calls, and one that an unknown value reaches stays one generic call
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass
# STATISTIC: GroupEntrypoints = 6
# STATISTIC: GroupCalls = 1

