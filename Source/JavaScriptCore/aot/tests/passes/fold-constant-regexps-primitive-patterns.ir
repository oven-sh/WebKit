# A pattern that is a known primitive has a known text, and a pattern that is left out or undefined is the empty text
# FORM: Prepared
# RUN: pass FoldConstantRegExps
# STATISTIC: FoldConstantRegExpsChanges = 5

module m0 path="main.js" displayPath="main.js"
function f0 name="integerPattern" results=[{type=RegExp}] {
    v0 = Integer integer=12
    v1 = CallBuiltin -, v0 overload=RegExp/6
    Return v1
# CHECK-NOT: CallBuiltin
# CHECK: v1: RegExp<"12"[]> = NewRegExp pattern="12"
}

function f1 name="noPattern" results=[{type=RegExp}] {
    v0 = CallBuiltin overload=RegExp/6
    Return v0
# CHECK-NOT: CallBuiltin
# CHECK: v0: RegExp<""[]> = NewRegExp pattern=""
}

function f2 name="undefinedPatternWithFlags" results=[{type=RegExp}] {
    v0 = Undefined
    v1 = String string="g"
    v2 = CallBuiltin -, v0, v1 overload=RegExp/6
    Return v2
# CHECK: v2: RegExp<""[Global]> = NewRegExp pattern="" regExpFlags=[Global]
}

function f3 name="nullPattern" results=[{type=RegExp}] {
    v0 = Null
    v1 = CallBuiltin -, v0 overload=RegExp/6
    Return v1
# CHECK: = NewRegExp pattern="null"
}

function f4 name="booleanPatternCalledWithoutNew" results=[{type=RegExp}] {
    v0 = Boolean boolean=true
    v1 = CallBuiltin -, v0 overload=RegExp/2
    Return v1
# CHECK: = NewRegExp pattern="true"
}

function f5 name="unknownNumber" parameters=[{type=number}] results=[{type=RegExp}] {
    v1 = CallBuiltin -, v0 overload=RegExp/6
    Return v1
# CHECK-NOT: NewRegExp
# CHECK: = CallBuiltin -, v0 overload=RegExp/6
}

function f6 name="mayBeUndefined" parameters=[{type=undefined|number}] results=[{type=RegExp}] {
    v1 = CallBuiltin -, v0 overload=RegExp/6
    Return v1
# CHECK-NOT: NewRegExp
# CHECK: = CallBuiltin -, v0 overload=RegExp/6
}
