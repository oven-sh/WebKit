function f2 name="readInLoopWithoutIteration" parameters=[{type=boolean}, {type=object}] results=[{type=anything}] {
  b0(v0: boolean, v1: object ~ L0):
    v2 = Undefined
    Jump -> next b1(v2)
  b1(v3: anything):
    LoopHint
    Branch v0 -> taken b3(), notTaken b2()
  b2():
    v5 = PropGet v1 key="k"
    Jump -> next b1(v5)
  b3():
