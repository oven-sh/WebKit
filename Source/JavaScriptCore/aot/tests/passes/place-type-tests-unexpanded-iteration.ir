# A use in a cycle with an iteration operation that is not expanded yet is planned in the round after the expansion, when its test can stand on the entry of the loop
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# RUN(LATER): pass PlaceTypeTests ExpandIteration ResolveBuiltins PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 name="Scale" fields=[{key="k" declared={type=number} flags=[IsRequired]}]

function f0 name="readInIteration" parameters=[{type=Array<number, proven, Double, pristine[Storage, Names]>}, {type=object}] results=[{type=anything}] {
  b0(v0: Array<number, proven, Double, pristine[Storage, Names]>, v1: object ~ L0):
    v2 = Undefined
    v3 = IteratorOpen v0
    Jump -> next b1(v2)
  b1(v4: anything):
    LoopHint
    v6 = IteratorResume v3
    v7 = ResultAt v6
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v8 = PropGet v1 key="k"
    Jump -> next b1(v8)
  b3():
    Return v4
}
