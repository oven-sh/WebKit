function f1 name="readInFrontOfIteration" parameters=[{type=Array<number, proven, Double, pristine[Storage, Names]>}, {type=object}] results=[{type=anything}] {
  b0(v0: Array<number, proven, Double, pristine[Storage, Names]>, v1: object ~ L0):
    v2 = PropGet v1 key="k"
    v3 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3
    v6 = ResultAt v5
    Branch v6 -> taken b2(), notTaken b1()
  b2():
    Return v2
}
