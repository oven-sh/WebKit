# const held = { count: +input, get alpha() { return this.count; } };
# const made = new Proxy(held, {});
# globalThis.answer = made.alpha;
#
# The handler has no get trap, so the target is asked for the proxy. The getter lies in the target's own slot: it is read out of the slot and called with the proxy for `this`.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline ResolveAccesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=13 fields=[{key="alpha" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="count" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
layout L1 module=m0 position=90 ownFieldCount=0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Convert v2 declared={type=number flags=[IsExpected]}
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="count"
    v6 = NewClosure function=f1
    DefineGetter v4, v6 key="alpha"
    v8 = FinishObject v4
    v9 = Convert v8 declared={type=undefined|null|L0 flags=[IsExpected]}
    v10 = Builtin builtin=Proxy
    v11 = NewObject layout=L1
    v12 = FinishObject v11
    v13 = Construct v10, -, v9, v12 calleeName="Proxy"
    v14 = Convert v13 declared={type=undefined|null|L0 flags=[IsExpected]}
    v15 = PropGet v14 key="alpha"
    PropSet v0, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="alpha" module=m0 position=30 kind=Getter flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=number flags=[IsExpected]}] {
  b0(v0: anything):
    v1 = Convert v0 declared={type=undefined|null|L0 flags=[IsExpected]}
    v2 = PropGet v1 key="count"
    v3 = Convert v2 declared={type=number flags=[IsExpected]}
    Return v3
}

# CHECK-LABEL: function f0
# CHECK: [[made]]: Proxy = CallBuiltin
# CHECK-NEXT: [[proxy]]: Proxy = AssumeType [[made]] provenType=Proxy
# CHECK: [[filled]]: boolean = IsSlotFilled [[target]] key="alpha"
# What has moved the getter out of its slot leaves the read as it was.
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = SuperGet [[target]], [[proxy]] key="alpha"
# CHECK: [[getter]]: f1 = GetSlotGetter [[target]], {{*}} key="alpha"
# CHECK-NEXT: = Call [[getter]], [[proxy]] callees=[f1]
# CHECK-LABEL: function f1
