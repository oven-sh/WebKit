# What a frame record holds may leave the frame as long as it is no frame pointer: the record itself stays. What a record may hold is known by layout and key, not by cell
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: FramePointerRetained 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Options" fields=[{key="callback" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] addedKeysAreComplete=true}
layout L1 name="Copy"

function f0 name="holdsNoFramePointer" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = NewObject layout=L1
    CopyDataProperties v2, v1
    Return v2
}

function f1 name="holdsFrameClosure" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3 storage=Frame
    v2 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    PutSlot v2, v2, v1 key="callback" receivers=[L0] level=Proven
    v4 = NewObject layout=L1
    CopyDataProperties v4, v2
    Return v4
}

function f2 name="otherRecordOfLayoutHoldsFrameClosure" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3 storage=Frame
    v2 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    PutSlot v2, v2, v1 key="callback" receivers=[L0] level=Proven
    v4 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v5 = NewObject layout=L1
    CopyDataProperties v5, v4
    Return v5
}

function f3 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
