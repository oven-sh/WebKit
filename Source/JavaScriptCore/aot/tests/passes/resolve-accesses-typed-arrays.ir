# An element access on a value proven to be one kind of typed array needs no test, an access on an array always does
# FORM: Prepared
# RUN: pass ResolveAccesses
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="read" parameters=[{type=Uint8Array}, {type=int}] results=[{type=anything}] {
    v2 = ElemGet v0, v1 accessSite=2
    Return v2
# CHECK: = GetTypedArrayElement v0, v1 typedArrayType=2 level=Proven accessSite=2 [keyIsIntegral]
}
function f1 name="read-under-any-number" parameters=[{type=Float64Array}, {type=number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK: = GetTypedArrayElement v0, v1 typedArrayType=10 level=Proven
# CHECK-NOT: keyIsIntegral
}
function f2 name="clamped-read" parameters=[{type=Uint8ClampedArray}, {type=int}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK: = GetTypedArrayElement v0, v1 typedArrayType=3 level=Proven [keyIsIntegral]
}
function f3 name="bigint-read" parameters=[{type=BigInt64Array}, {type=int}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK: = GetTypedArrayElement v0, v1 typedArrayType=11 level=Proven [keyIsIntegral]
}
function f4 name="store" parameters=[{type=Float64Array}, {type=int}, {type=number}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK: PutTypedArrayElement v0, v1, v2 typedArrayType=10 level=Proven [keyIsIntegral]
}
function f5 name="bigint-store" parameters=[{type=BigInt64Array}, {type=int}, {type=bigint}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK: PutTypedArrayElement v0, v1, v2 typedArrayType=11 level=Proven [keyIsIntegral]
}

function f6 name="store-of-a-converted-value" parameters=[{type=Float64Array}, {type=number}, {type=anything}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK-NEXT: b0(
# CHECK-NEXT: ElemSet v0, v1, v2
# CHECK-NEXT: Return
}
function f7 name="store-of-a-number-into-bigints" parameters=[{type=BigInt64Array}, {type=number}, {type=number}] results=[{type=undefined}] {
    ElemSet v0, v1, v2
    Return
# CHECK-NEXT: b0(
# CHECK-NEXT: ElemSet v0, v1, v2
# CHECK-NEXT: Return
}
function f8 name="test-and-definition" parameters=[{type=Uint8Array}, {type=number}, {type=number}] results=[{type=anything}] {
    v3 = ElemHas v0, v1
    ElemDefine v0, v1, v2
    Return v3
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemHas v0, v1
# CHECK-NEXT: ElemDefine v0, v1, v2
# CHECK-NEXT: Return v3
}
function f9 name="nullable-view" parameters=[{type=undefined|Uint8Array}, {type=number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Return v2
}
function f10 name="expected-view" parameters=[{type=Uint8Array flags=[IsExpected]}, {type=number}] results=[{type=anything}] {
  b0(v0: anything ~ Uint8Array, v1: number):
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Return v2
}
function f11 name="key-may-be-undefined" parameters=[{type=Uint8Array}, {type=undefined|number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Return v2
}
function f12 name="expected-key" parameters=[{type=Uint8Array}, {type=number flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: Uint8Array, v1: anything ~ number):
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Return v2
}
function f13 name="two-kinds-of-views" parameters=[{type=Uint8Array|Float64Array}, {type=number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Return v2
}
function f14 name="array" parameters=[{type=Array<number, proven>}, {type=number}, {type=number}] results=[{type=anything}] {
    v3 = ElemGet v0, v1
    ElemSet v0, v1, v2
    v5 = ElemHas v0, v1
    Return v3
# CHECK-NEXT: b0(
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: ElemSet v0, v1, v2
# CHECK-NEXT: = ElemHas v0, v1
# CHECK-NEXT: Return v3
}
function f15 name="string" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
