# Every instance of a program numbers its shapes alike, so a shape test alone does not say whose method to call
# OPTIONS: only-passes=PlaceTypeTests disable=flow:ProvenLayoutSets
# RUN: pass PlaceTypeTests
# RUN(ONE): pipeline PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Task" constructor=f1 fields=[{key="count" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f2 mutability=Fixed}]}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="run"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = CallDirect v5 function=f3
    v7 = CallDirect v5 function=f4
    Return
}
function f1 name="Task" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object written=L0}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropDefine v2, v3 key="count"
    Return v2
}
function f2 name="run" kind=Method flags=[HasThis] thisType={type=object written=L0} results=[{type=anything}] {
  b0(v0: object ? L0):
    Return
}

function f3 name="method-of-predicted-receiver" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="run"
    v2 = Call v1, v0 calleeKey="run"
    Return v2
}
# CHECK-LABEL: function f3 name="method-of-predicted-receiver"
# CHECK: = ShapeTest v0 layouts=[L0]
# CHECK: = CallDirect v0 function=f2
# CHECK: = BelongsToInstance v0
