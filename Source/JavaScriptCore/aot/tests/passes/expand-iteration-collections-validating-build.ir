# On the edge that has an entry, a result of a step of a Set or a Map gets the type of the contents. A validating build tests the result in front of the cast that says so
# FORM: Prepared optimizing
# OPTIONS: validate
# RUN: pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="setOfNumbers" parameters=[{type=Set<number, proven, pristine[Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b1()
  b2():
    Return v5
# CHECK: [[step0]]: undefined = SetNext v0,
# CHECK: [[element0]]: undefined|number = ResultAt [[step0]] index=2
# CHECK: Branch {{*}} -> taken [[found0]](), notTaken {{*}}()
# CHECK: [[found0]]():
# CHECK-NEXT: ValidateType [[element0]] validatedType=number
# CHECK-NEXT: [[number0]]: number = AssumeType [[element0]] castType=number
# CHECK-NEXT: = CollectionTable v0
}

function f1 name="mapOfNumbers" parameters=[{type=Map<number, number, proven, pristine[Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b1()
  b2():
    Return v5
# CHECK: [[step1]]: undefined = MapNext v0,
# CHECK: [[key1]]: undefined|number = ResultAt [[step1]] index=2
# CHECK-NEXT: [[value1]]: undefined|number = ResultAt [[step1]] index=3
# CHECK: Branch {{*}} -> taken [[found1]](), notTaken {{*}}()
# CHECK: [[found1]]():
# CHECK-NEXT: ValidateType [[key1]] validatedType=number
# CHECK-NEXT: = AssumeType [[key1]] castType=number
# CHECK-NEXT: ValidateType [[value1]] validatedType=number
# CHECK-NEXT: = AssumeType [[value1]] castType=number
# CHECK-NEXT: = CollectionTable v0
}

function f2 name="contentsNotProven" parameters=[{type=Set<number, pristine[Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b1()
  b2():
    Return v5
# Nothing is said about contents that are only expected, so there is nothing to test.
# CHECK: = SetNext v0,
# CHECK-NOT: ValidateType
# CHECK-NOT: AssumeType
}
