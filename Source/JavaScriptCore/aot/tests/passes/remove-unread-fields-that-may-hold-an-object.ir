# A field, a field of an environment and a variable that nothing reads keep a store of what may be an object or a symbol: an object lives as long as a place that holds it.
# The store goes where nobody can tell: a built-in function, a closure or a record that only the store has seen and that holds no object itself, a closure that captures only the environment it is stored in
# FORM: Prepared
# RUN: pass RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 4

module m0 path="main.js" displayPath="main.js"
layout L0 name="HoldsObject" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="HoldsSymbol" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L2 name="HoldsBuiltin" fields=[{key="gone" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L3 name="HoldsNewClosure" fields=[{key="gone" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L4 name="HoldsClosureOverObject" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L5 name="HoldsClosureSeenElsewhere" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L6 name="HoldsRecordOfNumbers" fields=[{key="gone" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L7 name="HoldsRecordOfObject" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]
layout L8 name="Pair" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L9 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}, {key="gone" declared={type=anything} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="kept" declared={type=anything} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}]
layout L10 name="HoldsLaterObject" fields=[{key="kept" declared={type=anything} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation reads=NeverRead}}}, {key="n" declared={type=anything} flags=[IsRequired]}]

function f0 name="holdsObject" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
# CHECK: = NewObject -, v0, v1 layout=L0 fields=[0, 1]
}

function f1 name="holdsSymbol" parameters=[{type=symbol}, {type=number}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L1 fields=[0, 1]
    Return v2
# CHECK: = NewObject -, v0, v1 layout=L1 fields=[0, 1]
}

function f2 name="holdsBuiltin" parameters=[{type=number}] results=[{type=anything}] {
    v1 = Builtin builtin=ObjectKeys
    v2 = NewObject -, v1, v0 layout=L2 fields=[0, 1]
    Return v2
# CHECK: = NewObject -, v0 layout=L2 fields=[1]
}

function f3 name="holdsNewClosure" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewClosure function=f10
    v2 = NewObject -, v1, v0 layout=L3 fields=[0, 1]
    Return v2
# CHECK-NOT: NewClosure
# CHECK: = NewObject -, v0 layout=L3 fields=[1]
}

function f4 name="holdsClosureOverObject" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
    v2 = NewClosure v0 function=f11
    v3 = NewObject -, v2, v1 layout=L4 fields=[0, 1]
    Return v3
# CHECK: = NewObject -, v2, v1 layout=L4 fields=[0, 1]
}

function f5 name="holdsClosureSeenElsewhere" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
    v2 = NewClosure function=f10
    v3 = Call v0, -, v2
    v4 = NewObject -, v2, v1 layout=L5 fields=[0, 1]
    Return v4
# CHECK: = NewObject -, v2, v1 layout=L5 fields=[0, 1]
}

function f6 name="holdsRecordOfNumbers" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0, v0 layout=L8 fields=[0, 1]
    v2 = NewObject -, v1, v0 layout=L6 fields=[0, 1]
    Return v2
# CHECK-NOT: layout=L8
# CHECK: = NewObject -, v0 layout=L6 fields=[1]
}

function f7 name="holdsRecordOfObject" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
    v2 = NewObject -, v0, v1 layout=L8 fields=[0, 1]
    v3 = NewObject -, v2, v1 layout=L7 fields=[0, 1]
    Return v3
# CHECK: = NewObject -, v2, v1 layout=L7 fields=[0, 1]
}

function f8 name="storesInScope" parameters=[{type=object}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L9 fields=[0]
    v2 = NewClosure v1 function=f12
    PutEnvironmentField v1, v2 layout=L9 field=1
    PutEnvironmentField v1, v0 layout=L9 field=2
    v5 = NewClosure v1 function=f12
    Return v5
# CHECK: = NewObject -, v0 layout=L9 fields=[0]
# CHECK-NEXT: PutEnvironmentField v1, v0 layout=L9 field=2
# CHECK-NEXT: = NewClosure v1 function=f12
}

function f9 name="storesLater" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
    v2 = NewObject -, v1, v1 layout=L10 fields=[0, 1]
    PutSlot v2, v2, v0 key="kept" receivers=[L10] level=Proven
    Return v2
# CHECK: = NewObject -, v1, v1 layout=L10 fields=[0, 1]
# CHECK-NEXT: PutSlot v2, v2, v0 key="kept"
}

function f10 name="capturesNothing" kind=Arrow results=[{type=anything}] {
    Return
}
function f11 name="capturesObject" kind=Arrow captures=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    Return v0
}
function f12 name="readsScope" kind=Arrow captures=[{type=env L9}] results=[{type=anything}] {
  b0(v0: env L9):
    v1 = GetEnvironmentField v0 layout=L9 field=0
    Return v1
}
