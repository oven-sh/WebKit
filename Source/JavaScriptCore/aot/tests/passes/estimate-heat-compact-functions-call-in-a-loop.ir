# What a loop calls behind a branch or two may run, whoever has the loop: the call weighs less than one that makes its callee hot, and more than two calls in a row.
# A loop in code that runs once gives no such reason
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f1 Cold 10 1
# CHECK-NEXT: f2 Cold 10 1
# CHECK-NEXT: f3 Cold 10 1
# CHECK-NEXT: f4 Compact 10 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    v2 = CallDirect v0 function=f1
    v3 = CallDirect v0 function=f1
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b4()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    v5 = CallDirect v0 function=f4
    Jump -> next b4()
  b4():
    Branch v1 -> taken b1(), notTaken b5()
  b5():
    Return
}

