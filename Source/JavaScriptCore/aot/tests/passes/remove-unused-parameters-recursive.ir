# A parameter that is only passed to the recursive call goes; one that the recursive call passes to a parameter in use stays
# FORM: Prepared
# RUN: pass RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="passesSecondToItself" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Add v0, v0
    v4 = CallDirect v3, v1 function=f0
    Return v4
}
# CHECK-LABEL: function f0 name="passesSecondToItself"{{*}}parameters=[{type=number}, {type=number}]
# CHECK-NEXT: b0(v0: number, v1: number):
# CHECK-NEXT: [[forwarded]]: number = CallDirect v0 function=f3
# CHECK-NEXT: ReturnCall [[forwarded]]
# CHECK-NEXT: }

function f1 name="swapsInRecursiveCall" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = CallDirect v1, v0 function=f1
    Return v3
}
# CHECK-LABEL: function f1 name="swapsInRecursiveCall"{{*}}parameters=[{type=number}, {type=number}]
# CHECK-NEXT: b0(v0: number, v1: number):
# CHECK-NEXT: = TypeTest v0
# CHECK: = CallDirect v1, v0 function=f1

function f2 name="caller" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = CallDirect v0, v1 function=f0
    v3 = CallDirect v2, v1 function=f1
    Return v3
}
# CHECK-LABEL: function f2 name="caller"
# CHECK: [[first]]: number = CallDirect v0 function=f3
# CHECK-NEXT: = CallDirect [[first]], v1 function=f1

# CHECK-LABEL: function f3 name="passesSecondToItself"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f0 parameterMap=[{original=0}]}
# CHECK-NEXT: b0(v0: number):
# CHECK: [[doubled]]: number = Add v0, v0
