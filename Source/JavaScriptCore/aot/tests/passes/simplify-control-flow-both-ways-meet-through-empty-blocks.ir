# Both ways of a test come to one block with the same arguments, through blocks that hold nothing and only hand on what they are given, one of them unlikely and with a second way in. The test decides nothing.
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="theSecondTestDecidesNothing" parameters=[{type=boolean}, {type=boolean}] results=[{type=i32}] {
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v2 = Integer integer=3
    Branch v1 -> taken b2(), notTaken b4(v2)
  b2():
    Jump -> next b5(v2)
  b3() frequency=Unlikely:
    v3 = Integer integer=3
    Jump -> next b4(v3)
  b4(v4: i32) frequency=Unlikely:
    Jump -> next b5(v4)
  b5(v5: i32):
    Return v5
# CHECK: Branch v0
# CHECK-NOT: Branch
# CHECK: Return
}

function f1 name="otherArgumentsDecide" parameters=[{type=i32}, {type=boolean}] results=[{type=i32}] {
    v2 = Integer integer=1
    Branch v1 -> taken b1(), notTaken b2(v2)
  b1():
    Jump -> next b3(v0)
  b2(v3: i32) frequency=Unlikely:
    Jump -> next b3(v3)
  b3(v4: i32):
    Return v4
# CHECK: Branch v1
}

function f2 name="whatBothWaysPassWithOtherArgumentsDominatesWhatFollows" parameters=[{type=i32}, {type=boolean}] results=[{type=i32}] {
    v2 = Integer integer=1
    Branch v1 -> taken b1(v0), notTaken b1(v2)
  b1(v3: i32):
    Jump -> next b2()
  b2():
    Return v3
# CHECK: Branch v1
}

function f3 name="whereBothWaysMeetRunsAsOftenAsTheTest" parameters=[{type=i32}, {type=boolean}] results=[{type=i32}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2() frequency=Rare:
    v2 = Integer integer=5
    Jump -> next b3(v2)
  b3(v3: i32) frequency=Unlikely:
    Return v3
# CHECK-NOT: Branch
# CHECK-NOT: frequency=
# CHECK: Return
}

function f4 name="aTestOfAValueMayYetProveSomethingOfIt" parameters=[{type=boolean}, {type=anything}] results=[{type=i32}] {
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v2 = Integer integer=3
    v3 = TypeTest v1 testedType=i32
    Branch v3 -> taken b2(), notTaken b4(v2)
  b2():
    Jump -> next b5(v2)
  b3() frequency=Unlikely:
    v4 = Integer integer=3
    Jump -> next b4(v4)
  b4(v5: i32) frequency=Unlikely:
    Jump -> next b5(v5)
  b5(v6: i32):
    Return v6
# CHECK: Branch v0
# CHECK: Branch v3
}
