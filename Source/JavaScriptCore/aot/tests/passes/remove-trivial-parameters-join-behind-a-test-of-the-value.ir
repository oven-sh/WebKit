# A typed parameter arrives as anything and is tested at the head of the function, so every later copy of it goes back to a value whose own type says nothing.
# A join of such copies is the narrowest value that all of its edges go back to, if the join knows no more than that value's type
# FORM: Prepared optimizing
# RUN: pass RemoveTrivialParameters EliminateDeadCode
# STATISTIC: RemoveTrivialParametersChanges = 4

module m0 path="main.js" displayPath="main.js"

function f0 name="narrowedOnOneEdge" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=undefined|null|string
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2):
    v3 = String string="get"
    v4 = StrictEq v2, v3
    Branch v4 -> taken b2(| 0), notTaken b3(v2)
  b2(v5):
    Jump -> next b3(v5)
  b3(v6):
    Return v6
  b4():
    Return v0
# CHECK: b1(v2: undefined|null|string):
# CHECK: Branch v4 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3()
# CHECK-NEXT: b3():
# CHECK-NEXT: Return v2
}

function f1 name="chainOfJoins" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=undefined|null|string
    Branch v1 -> taken b1(| 0), notTaken b6()
  b1(v2):
    v3 = String string="get"
    v4 = StrictEq v2, v3
    Branch v4 -> taken b2(| 0), notTaken b3(v2)
  b2(v5):
    Jump -> next b3(v5)
  b3(v6):
    v7 = String string="put"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b4(| 0), notTaken b5(v6)
  b4(v9):
    Jump -> next b5(v9)
  b5(v10):
    Return v10
  b6():
    Return v0
# CHECK: = StrictEq v2, v3
# CHECK: = StrictEq v2, v7
# CHECK-NEXT: Branch v8 -> taken b4(), notTaken b5()
# CHECK: b5():
# CHECK-NEXT: Return v2
}

function f2 name="narrowedTwiceOnBothEdges" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=undefined|number|string
    Branch v1 -> taken b1(| 0), notTaken b6()
  b1(v2):
    v3 = TypeTest v2 testedType=undefined|string
    Branch v3 -> taken b2(| 0), notTaken b6()
  b2(v4):
    v5 = TypeTest v4 testedType=string
    Branch v5 -> taken b3(| 0), notTaken b4(| 0)
  b3(v6):
    Jump -> next b5(v6)
  b4(v7):
    Jump -> next b5(v7)
  b5(v8):
    Return v8
  b6():
    Return v0
# CHECK: b2(v4: undefined|string):
# CHECK: Branch v5 -> taken b3(), notTaken b4()
# CHECK: b5():
# CHECK-NEXT: Return v4
}

function f3 name="carriedAroundALoop" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=undefined|null|string
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3):
    Jump -> next b2(v3)
  b2(v4):
    LoopHint
    v6 = String string="get"
    v7 = StrictEq v4, v6
    Branch v7 -> taken b3(| 0), notTaken b4()
  b3(v8):
    Jump -> next b2(v8)
  b4():
    Return v4
  b5():
    Return v0
# CHECK: b2():
# CHECK: = StrictEq v3, v6
# CHECK: b4():
# CHECK-NEXT: Return v3
}

function f4 name="joinKnowsMoreThanWhatTheEdgesShare" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=undefined|number|string
    Branch v1 -> taken b1(| 0), notTaken b6()
  b1(v2):
    v3 = TypeTest v2 testedType=string
    Branch v3 -> taken b2(| 0), notTaken b3(| 0)
  b2(v4):
    Jump -> next b5(v4)
  b3(v5):
    v6 = TypeTest v5 testedType=number
    Branch v6 -> taken b4(| 0), notTaken b6()
  b4(v7):
    Jump -> next b5(v7)
  b5(v8):
    Return v8
  b6():
    Return v0
# CHECK: Jump -> next b5(v4)
# CHECK: Jump -> next b5(v7)
# CHECK-NEXT: b5(v8: number|string):
# CHECK-NEXT: Return v8
}

function f5 name="joinWithAnotherValue" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3):
    v4 = TypeTest v1 testedType=string
    Branch v4 -> taken b2(| 0), notTaken b5()
  b2(v5):
    v6 = String string="get"
    v7 = StrictEq v3, v6
    Branch v7 -> taken b3(| 0), notTaken b4(v5)
  b3(v8):
    Jump -> next b4(v8)
  b4(v9):
    Return v9
  b5():
    Return v0
# CHECK: Branch v7 -> taken b3(| 0), notTaken b4(v5)
# CHECK: Jump -> next b4(v8)
# CHECK-NEXT: b4(v9: string):
# CHECK-NEXT: Return v9
}
