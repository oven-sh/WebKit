# require.cache of a test run lists a CommonJS file from when it begins. A file that runs as a part of another keeps no state for that, as in an executable:
# whoever calls its body stores in front of the call that it begins, and behind the call that it has run.
# FORM: Prepared
# RUN: pass CallModules
# STATISTIC: ModulesWithState = 1
# STATISTIC: ModulesWithoutState = 1
# CHECK: outcome: Changed

variable g0 name="a" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="b" module=m2 declared={type=anything} initialization=Undefined
module m0 path="/one.test.cjs" displayPath="one.test.cjs" kind=CommonJs flags=[KeepsError, IsListedInCache] requireResult=ModuleExports body=f0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/a.cjs" displayPath="a.cjs" kind=CommonJs flags=[KeepsError, IsListedInCache] requireResult=ModuleExports body=f1 requests=[{target=m2 kind=Require completes=true}]
module m2 path="/b.cjs" displayPath="b.cjs" kind=CommonJs flags=[KeepsError, IsListedInCache] requireResult=ModuleExports body=f2
entry module=m0
# The loader calls the entry point, so what that requires first has a state.
# CHECK: module m1 {{*}}flags=[KeepsError, IsListedInCache, EvaluatesItself]
# CHECK: module m2 path="/b.cjs" displayPath="b.cjs" kind=CommonJs flags=[KeepsError, IsListedInCache] requireResult=ModuleExports

function f0 name="test" module=m0 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    v1 = GetModuleVariable variable=g0
    Return v1
# CHECK: b0():
# CHECK-NEXT: = CallDirect function=f1
# CHECK-NEXT: = GetModuleVariable variable=g0
}
function f1 name="a" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    EvaluateModule module=m2 referrer=m1 [isBare]
    v1 = GetModuleVariable variable=g1
    PutModuleVariable v1 variable=g0
    Return
# CHECK: = BeginModuleEvaluation module=m1
# CHECK: = BeginModuleEvaluation module=m2
# CHECK-NEXT: = CallDirect function=f2
# CHECK-NEXT: = BeginModuleEvaluation module=m2
# CHECK-NEXT: FinishModuleEvaluation module=m2
# CHECK-NEXT: = GetModuleVariable variable=g1
}
function f2 name="b" module=m2 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
