# An object is born with the mark that the fields which every constructor fills are not all stored. The pass takes the mark off behind the store by slot that fills the last of them,
# where no other code has run since somebody else could reach the object. Otherwise the run time looks at the slots: there, before other code may see the object, and where the object leaves
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass FinishBirths
# STATISTIC: BirthsFinished = 7
# STATISTIC: BirthsLeftToRunTime = 8
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Point" fields=[{key="x" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="y" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="late" declared={type=anything}}]
layout L1 kind=Instance name="Plain" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Instance name="Wider" fields=[{key="x" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="y" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="z" declared={type=anything} flow={occupancy=FilledAtBirth}}]

function f0 name="everyStoreBySlot" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject layout=L0
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    PutSlotOrAdd v1, v1, v0 key="y" receivers=[L0] level=Proven
    PutSlotOrAdd v1, v1, v0 key="late" receivers=[L0] level=Proven
    Return v1
}
# CHECK-LABEL: name="everyStoreBySlot"
# CHECK: PutSlotOrAdd v1, v1, v0 key="y"
# CHECK-NEXT: FinishBirth v1
# CHECK-NEXT: PutSlotOrAdd v1, v1, v0 key="late"
# CHECK-NOT: FinishBirth

function f1 name="theAllocationListsOneOfThem" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject -, v0 layout=L0 fields=[1]
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    Return v1
}
# CHECK-LABEL: name="theAllocationListsOneOfThem"
# CHECK: PutSlotOrAdd v1, v1, v0 key="x"
# CHECK-NEXT: FinishBirth v1

function f2 name="theAllocationListsBoth" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Return v1
}
# CHECK-LABEL: name="theAllocationListsBoth"
# CHECK-NOT: FinishBirth

function f3 name="noSuchField" parameters=[{type=anything}] results=[{type=L1}] {
    v1 = NewObject layout=L1
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L1] level=Proven
    Return v1
}
# CHECK-LABEL: name="noSuchField"
# CHECK-NOT: FinishBirth

function f4 name="somebodyHasSeenTheObject" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject layout=L0
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    v3 = Call v0, -, v1
    PutSlotOrAdd v1, v1, v0 key="y" receivers=[L0] level=Proven
    Return v1
}
# CHECK-LABEL: name="somebodyHasSeenTheObject"
# CHECK: TryFinishBirth v1
# CHECK-NEXT: = Call v0, -, v1
# CHECK-NEXT: PutSlotOrAdd v1, v1, v0 key="y"
# CHECK-NEXT: TryFinishBirth v1
# CHECK-NEXT: Return v1

function f5 name="oneStoreByName" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject layout=L0
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    PropSet v1, v0 key="y" mode=Strict
    Return v1
}
# CHECK-LABEL: name="oneStoreByName"
# CHECK: PropSet v1, v0 key="y"
# CHECK-NEXT: TryFinishBirth v1
# CHECK-NEXT: Return v1

function f6 name="theWaysMeet" parameters=[{type=anything}, {type=boolean}] results=[{type=L0}] {
    v2 = NewObject layout=L0
    PutSlotOrAdd v2, v2, v0 key="x" receivers=[L0] level=Proven
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    PutSlotOrAdd v2, v2, v0 key="y" receivers=[L0] level=Proven
    Jump -> next b3(v2)
  b2():
    PropSet v2, v0 key="y" mode=Strict
    Jump -> next b3(v2)
  b3(v6: L0):
    Return v6
}
# CHECK-LABEL: name="theWaysMeet"
# CHECK: PutSlotOrAdd v2, v2, v0 key="y"
# CHECK-NEXT: FinishBirth v2
# CHECK: PropSet v2, v0 key="y"
# CHECK-NEXT: TryFinishBirth v2
# CHECK: (v6: L0):
# CHECK-NEXT: Return v6

function f7 name="theStoreNamesTheLayoutsOfItsReceiver" parameters=[{type=anything}, {type=object}] results=[{type=L0}] {
    v2 = NewObject v1 layout=L0
    PutSlotOrAdd v2, v2, v0 key="x" receivers=[L0] level=Proven
    PutSlotOrAdd v2, v2, v0 key="y" receivers=[L0] level=Proven
    Return v2
}
# CHECK-LABEL: name="theStoreNamesTheLayoutsOfItsReceiver"
# CHECK: PutSlotOrAdd v2, v2, v0 key="y"
# CHECK-NEXT: FinishBirth v2
# CHECK-NEXT: Return v2

function f8 name="oneOfTheLayoutsHasAnotherSuchField" parameters=[{type=anything}, {type=object}] results=[{type=L0|L2}] {
    v2 = NewObject v1 layout=L0
    PutSlotOrAdd v2, v2, v0 key="x" receivers=[L0, L2] level=Proven
    PutSlotOrAdd v2, v2, v0 key="y" receivers=[L0, L2] level=Proven
    Return v2
}
# CHECK-LABEL: name="oneOfTheLayoutsHasAnotherSuchField"
# CHECK: PutSlotOrAdd v2, v2, v0 key="y"
# CHECK-NEXT: TryFinishBirth v2
# CHECK-NEXT: Return v2

function f9 name="anotherObjectHoldsItBeforeTheLastStore" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject layout=L0
    v2 = NewObject layout=L1
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    PutSlotOrAdd v2, v2, v1 key="x" receivers=[L1] level=Proven
    PutSlotOrAdd v1, v1, v2 key="y" receivers=[L0] level=Proven
    Return v1
}
# CHECK-LABEL: name="anotherObjectHoldsItBeforeTheLastStore"
# CHECK: PutSlotOrAdd v1, v1, v2 key="y"
# CHECK-NEXT: FinishBirth v1
# CHECK-NEXT: Return v1

function f10 name="theLastStoreNamesItThroughACast" parameters=[{type=anything}] results=[{type=object}] {
    v1 = NewObject layout=L0
    PutSlotOrAdd v1, v1, v0 key="x" receivers=[L0] level=Proven
    v3 = Upcast v1 castType=object
    PutSlotOrAdd v3, v1, v0 key="y" receivers=[L0] level=Proven
    Return v3
}
# CHECK-LABEL: name="theLastStoreNamesItThroughACast"
# CHECK: PutSlotOrAdd v3, v1, v0 key="y"
# CHECK-NEXT: FinishBirth v3
# CHECK-NEXT: Return v3

function f11 name="aTestOfTheUnfinishedObjectAsksTheOrderWord" parameters=[{type=anything}] results=[{type=L0}] {
    v1 = NewObject layout=L0
    v2 = HasNoFieldOutsideSlot v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    PutSlotOrAdd v1, v3, v0 key="x" receivers=[L0] level=Proven
    PutSlotOrAdd v1, v3, v0 key="y" receivers=[L0] level=Proven
    v6 = HasNoFieldOutsideSlot v1
    Branch v6 -> taken b3(| 0), notTaken b2()
  b2():
    Return v1
  b3(v7):
    Return v1
}
# CHECK-LABEL: name="aTestOfTheUnfinishedObjectAsksTheOrderWord"
# CHECK: = HasNoFieldOutsideSlot v1 [mayMeetUnfinishedObject]
# CHECK: FinishBirth v1
# CHECK-NEXT: = HasNoFieldOutsideSlot v1
# CHECK-NEXT: Branch
