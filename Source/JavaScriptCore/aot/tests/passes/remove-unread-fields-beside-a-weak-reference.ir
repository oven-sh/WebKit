# From the flow analysis to the removal: a field, an export and a variable that nothing reads keep the store of an object, here the target of a weak reference and an object that refers to it:
# an object lives as long as a place that holds it. The same places lose the store of a number
# FORM: AsRead
# RUN: pipeline RemoveUnreadFields
# OPTIONS: only-passes=ComputeEffectSummaries,ResolveCalls,ResolveAccesses,RemoveUnreadExports,RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 2
# STATISTIC: UnreadVariableStoresRemoved = 2

module m0 path="/main.js" displayPath="main.js" body=f0 exports=[{name="heldExport" variable=g0}, {name="numberExport" variable=g1}]
module m1 path="/entry.js" displayPath="entry.js" body=f1 requests=[{target=m0 completes=true}]
entry module=m1
variable g0 name="heldExport" module=m0 declared={type=anything}
variable g1 name="numberExport" module=m0 declared={type=anything}
variable g2 name="heldVariable" module=m0 declared={type=anything}
variable g3 name="numberVariable" module=m0 declared={type=anything}
layout L0 name="Target" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="HoldsTarget" fields=[{key="keep" declared={type=anything} flags=[IsRequired]}, {key="read" declared={type=anything} flags=[IsRequired]}]
layout L2 name="HoldsNumber" fields=[{key="keep" declared={type=anything} flags=[IsRequired]}, {key="read" declared={type=anything} flags=[IsRequired]}]
layout L3 name="RefersToTarget" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=WeakRef
    v3 = Construct v2, -, v1
    v4 = NewObject -, v1, v0 layout=L1 fields=[0, 1]
    v5 = PropGet v4 key="read"
    v6 = NewObject -, v0, v0 layout=L2 fields=[0, 1]
    v7 = PropGet v6 key="read"
    v8 = NewObject -, v1 layout=L3 fields=[0]
    PutModuleVariable v8 variable=g0
    PutModuleVariable v0 variable=g1
    PutModuleVariable v1 variable=g2
    PutModuleVariable v0 variable=g3
    Return
# CHECK: = CallBuiltin -, v1 overload=WeakRef/1
# CHECK: = NewObject -, v1, v0 layout=L1 fields=[0, 1]
# CHECK: = NewObject -, v0 layout=L2 fields=[1]
# CHECK: [[holder]]: L3 = NewObject -, v1 layout=L3 fields=[0]
# CHECK-NEXT: PutModuleVariable [[holder]] variable=g0
# CHECK-NEXT: PutModuleVariable v1 variable=g2
# CHECK-NEXT: Return
}

function f1 name="entry" module=m1 kind=Module results=[{type=anything}] {
    Return
}
