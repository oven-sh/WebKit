# The group entrypoints of a group reserve the same words, because a call of the group reserves by the first of them
# FORM: Prepared
# RUN: pass GroupCallsByValue CreateEntrypoints ChooseCallingConventions
# STATISTIC: GroupCalls = 1
# CHECK: f1 Direct ({{*}}stack0:JSValue, stack1:JSValue) -> ({{*}}:JSValue) boxed-result reserved=2
# CHECK-NEXT: f2 Direct () -> ({{*}}:JSValue) boxed-result
# CHECK-COUNT-5: Direct ({{*}}:Cell) -> (none:JSValue) reserved=2 closures=
# CHECK-NOT: closures=

module m0 path="main.js" displayPath="main.js"
function f0 name="caller" parameters=[{type=f1|f2|f3|f4|f5}] results=[{type=anything}] {
  b0(v0: f1|f2|f3|f4|f5):
    v1 = Call v0 accessSite=0 callees=[f1, f2, f3, f4, f5]
    Return v1
}
function f1 name="capturesTen" kind=Arrow captures=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything, v6: anything, v7: anything, v8: anything, v9: anything):
    v10 = Call v0
    Return
}
function f2 name="second" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f3 name="third" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f4 name="fourth" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f5 name="fifth" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
