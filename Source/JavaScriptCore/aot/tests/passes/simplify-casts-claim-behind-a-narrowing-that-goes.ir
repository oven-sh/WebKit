# NarrowByField stands behind the checks in front of the read that it names, and its holder need not. Where it takes nothing away from the holder it goes,
# and what is made from the holder stands behind those checks no longer: a claim that holds in every version says no more than the type then and goes in the same run,
# and a claim that held behind checks holds in every version. Where the checked value itself goes into what is made, both stay as they are
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass SimplifyCasts VerifyProgram
# CHECK: outcome: Changed

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Assertion
function f0 name="madeFromTheHolderAlone" parameters=[{type=Array}] results=[{type=Array}] {
    v1 = PropGet v0 key="length"
    v2 = Check v1 expectedType=number site=w0
    v3 = Integer
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    Return v0
  b2(v6):
    v7 = NarrowByField v0, v6 key="length"
    v8 = ElemGet v7, v3
    v9 = PropGet v7 key="length"
    v10 = AssumeType v9 provenType=number [isBehindChecks]
    v11 = NewArray v8, v10 contents=anything
    v12 = AssumeType v11 provenType=Array
    Return v12
# CHECK: b2(v6: number):
# CHECK-NEXT: = ElemGet v0, v3
# CHECK-NEXT: = PropGet v0 key="length"
# CHECK-NEXT: v10: number = AssumeType v9 provenType=number
# CHECK-NEXT: v11: Array = NewArray v8, v10 contents=anything
# CHECK-NEXT: Return v11
}
function f1 name="madeFromTheCheckedValueToo" parameters=[{type=Array}] results=[{type=Array}] {
    v1 = PropGet v0 key="length"
    v2 = Check v1 expectedType=number site=w0
    v3 = Integer
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    Return v0
  b2(v6):
    v7 = NarrowByField v0, v6 key="length"
    v8 = ElemGet v7, v2
    v9 = AssumeType v8 provenType=number [isBehindChecks]
    v10 = NewArray v9 contents=anything
    v11 = AssumeType v10 provenType=Array
    Return v11
# CHECK: b2(v6: number):
# CHECK-NEXT: = ElemGet v0, v2
# CHECK-NEXT: v9: number = AssumeType v8 provenType=number [isBehindChecks]
# CHECK-NEXT: v10: Array = NewArray v9 contents=anything
# CHECK-NEXT: v11: Array = AssumeType v10 provenType=Array
# CHECK-NEXT: Return v11
}
