# `for (let i = first; i < n; i++) s += 3`, n: number, first beyond int32: both are tested for int32 once, in front of a copy of the loop.
# RUN: pipeline Select
# OPTIONS: check=VerifyEachPass disable=pass:RemoveUnusedParameters

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="count" [isFreeName]
    v2 = ToNumber v1
    v3 = PropGet v0 key="sink" [isFreeName]
    v4 = Integer integer=0
    v5 = BitOr v2, v4
    v6 = CallDirect v2, v5 function=f1
    v7 = Call v3, -, v6
    v8 = CallDirect v2, v5 function=f2
    v9 = Call v3, -, v8
    v10 = CallDirect v2, v5, v3 function=f3
    v11 = Call v3, -, v10
    v12 = CallDirect v2, v5 function=f4
    v13 = Call v3, -, v12
    Return
}

function f1 name="onlySteppedAndCompared" parameters=[{type=number}, {type=i32}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=3
    v4 = Integer integer=2147483647
    v5 = Add v1, v4
    Jump -> next b1(v5, v2)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v0
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = Add v7, v3
    v11 = Increment v6
    Jump -> next b1(v11, v10)
  b3():
    Return v7
# CHECK: = TypeTest v0 testedType=i32
# CHECK-NEXT: TestAndBranch
# CHECK: = TypeTest {{*}}testedType=i32
# CHECK-NEXT: TestAndBranch
