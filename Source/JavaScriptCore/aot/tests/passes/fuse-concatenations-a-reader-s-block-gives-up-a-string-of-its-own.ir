# b2 lies beside the way on which b3 absorbs the first string, and reads that string: it gets a copy at its head. It also starts a string of its own, which b4 absorbs.
# The copy moves all that lies in b2, so what b2 gives up is looked for where it lies then: the constant in front of it was erased in its place.
# FORM: Prepared
# RUN: pass FuseConcatenations

module m0 path="main.js" displayPath="main.js"
function f0 name="readsOneAndGivesUpAnother" parameters=[{type=number}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: boolean, v2: boolean):
    v3 = String string=":"
    v4 = Add v0, v3
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Branch v2 -> taken b3(), notTaken b2()
  b2():
    v5 = Add v4, v0
    v6 = String string="-"
    v7 = Add v0, v6
    Branch v2 -> taken b4(), notTaken b5()
  b3():
    v8 = Add v4, v0
    Return v8
  b4():
    v9 = Add v7, v0
    Return v9
  b5():
    Return v5
}
# CHECK-LABEL: function f0 name="readsOneAndGivesUpAnother"
# CHECK: b2():
# CHECK-NEXT: [[copy]]: string = Add v0, v3
# CHECK-NEXT: string = Add [[copy]], v0
# CHECK-NEXT: [[dash]]: "-" = String string="-"
# CHECK-NEXT: Branch
# CHECK: b3():
# CHECK-NEXT: string = Strcat v0, v3, v0
# CHECK: b4():
# CHECK-NEXT: string = Strcat v0, [[dash]], v0
