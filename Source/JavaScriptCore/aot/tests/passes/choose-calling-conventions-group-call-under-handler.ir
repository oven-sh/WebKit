# A handler belongs to the block: a call of a group under a handler is converted like any other, and a test of its result stays where it is
# FORM: Prepared
# RUN: pass GroupCallsByValue CreateEntrypoints ChooseCallingConventions
# STATISTIC: GroupCalls = 2

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=CallResult
# CHECK-LABEL: function f0 name="callUnderHandler"
# CHECK: b0(v0: f1|f2|f3|f4|f5, v1: number) handler=[[handler]]():
# CHECK-NEXT: v2: number = CallGroup v0, v1 function=
# CHECK: [[handler]]() role=CatchHandler:
function f0 name="callUnderHandler" parameters=[{type=f1|f2|f3|f4|f5}, {type=number}] results=[{type=anything}] {
  b0(v0: f1|f2|f3|f4|f5, v1: number) handler=b2():
    v2 = Call v0, -, v1 accessSite=0 callees=[f1, f2, f3, f4, f5]
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
function f1 name="first" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v0
}
function f2 name="second" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v0
}
function f3 name="third" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v0
}
function f4 name="fourth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v0
}
function f5 name="fifth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0
    Return v0
}
# CHECK-LABEL: function f6 name="testUnderHandler"
# CHECK: b0(v0: f1|f2|f3|f4|f5, v1: number):
# CHECK-NEXT: v2: number = CallGroup v0, v1 function=
# CHECK: handler=[[testHandler]]():
# CHECK-NEXT: i32 = Claim v2 castType=i32 site=w0
# CHECK: [[testHandler]]() role=CatchHandler:
function f6 name="testUnderHandler" parameters=[{type=f1|f2|f3|f4|f5}, {type=number}] results=[{type=anything}] {
  b0(v0: f1|f2|f3|f4|f5, v1: number):
    v2 = Call v0, -, v1 accessSite=1 callees=[f1, f2, f3, f4, f5]
    Jump -> next b1()
  b1() handler=b3():
    v3 = Claim v2 castType=i32 site=w0
    Jump -> next b2()
  b2():
    Return v3
  b3() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
