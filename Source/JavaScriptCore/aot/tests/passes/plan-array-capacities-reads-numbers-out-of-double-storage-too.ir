# A loop sums a list of numbers and expects storage for any value. A list in Double storage is read in a copy of the reads, which comes back in front of the test for a number.
# A list of texts alone gets no such copy
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# STATISTIC: ReadsCopiedForOtherStorage = 1
# STATISTIC: CopiesOfReadsTakenBack = 0

module m0 path="main.js" displayPath="main.js"

function f0 name="sum" parameters=[{type=Array<number>}] results=[{type=anything}] {
    v1 = Integer
    v2 = Double number=0.5
    Jump -> next b1(v2, v1)
  b1(v3: number, v4: int[0, 4294967295]):
    LoopHint
    v6 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b7()
  b2(v8):
    v9 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v9 -> taken b3(| 0), notTaken b6()
  b3(v10):
    v11 = IsElementPresent v0, v8, v10 arrayStorage=Contiguous [keyIsIntegral]
    Branch v11 -> taken b4(| 0), notTaken b6()
  b4(v12):
    v13 = AllGuards v10, v12
    v14 = GetArrayElement v0, v8, v13 arrayStorage=Contiguous level=Expected [keyIsIntegral, isPresent]
    v15 = TypeTest v14 testedType=number
    Branch v15 -> taken b5(| 0), notTaken b6()
  b5(v16):
    v17 = Add v3, v16
    v18 = Increment v8
    Jump -> next b1(v17, v18)
  b6() frequency=Rare:
    v19 = ElemGet v0, v8 [keyIsIntegral]
    Return v19
  b7():
    Return v3
# CHECK: HasArrayStorage v0 arrayStorage=Double
# CHECK: IsElementPresent v0, v8, {{*}} arrayStorage=Double [keyIsIntegral]
# CHECK: number = GetArrayElement v0, v8, {{*}} arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
# CHECK-NOT: ConvertToDoubleStorage
}

function f1 name="last" parameters=[{type=Array<string>}] results=[{type=anything}] {
    v1 = Integer
    v2 = Undefined
    Jump -> next b1(v2, v1)
  b1(v3: anything, v4: int[0, 4294967295]):
    LoopHint
    v6 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b6()
  b2(v8):
    v9 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v9 -> taken b3(| 0), notTaken b5()
  b3(v10):
    v11 = IsElementPresent v0, v8, v10 arrayStorage=Contiguous [keyIsIntegral]
    Branch v11 -> taken b4(| 0), notTaken b5()
  b4(v12):
    v13 = AllGuards v10, v12
    v14 = GetArrayElement v0, v8, v13 arrayStorage=Contiguous level=Expected [keyIsIntegral, isPresent]
    v15 = Increment v8
    Jump -> next b1(v14, v15)
  b5() frequency=Rare:
    v16 = ElemGet v0, v8 [keyIsIntegral]
    Return v16
  b6():
    Return v3
# CHECK-NOT: arrayStorage=Double
}
