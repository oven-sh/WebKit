# const holey: number[] = [1, 2, , 4] as number[];
# function copy(i: number): number { const b = [...holey]; return (b[i & 3] ?? 0) + b.length; }
# declare const input: any;
# (globalThis as any).answer = copy(input | 0);
# A spread reads a hole as undefined, so the copy of a list of numbers with a hole is made with storage for any value, and nobody tests its storage.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: pipeline FinishBirths
# CHECK-LABEL: name="copy"
# CHECK: = NewArray {{*}} arrayStorage=Contiguous
# CHECK-NOT: HasArrayStorage
# CHECK: = GetArrayElement {{*}} arrayStorage=Contiguous level=Proven

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=6 kind=Variable
typesite w1 module=m0 position=63 kind=Parameter function=f1
typesite w2 module=m0 position=49 kind=Result
typesite w3 module=m0 position=39 kind=Assertion
typesite w4 module=m0 position=198 kind=CallResult
typesite w5 module=m0 position=90 kind=Variable
typesite w6 module=m0 position=114 kind=Element
typesite w7 module=m0 position=131 kind=PropertyRead
variable g0 name="holey" module=m0 declared={type=undefined|null|absent|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Integer integer=1
    v3 = Integer integer=2
    v4 = Integer integer=4
    v5 = NewArray v2, v3, v4 contents=number holes=[2]
    v6 = Convert v5 declared={type=undefined|null|Array<number> site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=Assertion
    PutModuleVariable v6 variable=g0
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="globalThis" [isFreeName]
    v10 = Convert v9 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v11 = Convert v10 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=i32 flags=[IsExpected]}
    v15 = Integer
    v16 = BitOr v14, v15
    v17 = Call v1, -, v16 calleeName="copy"
    v18 = Convert v17 declared={type=number site=w4}
    PropSet v11, v18 key="answer"
    v20 = Undefined
    Return v20
}
function f1 name="copy" module=m0 position=49 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = NewArray contents=number
    v2 = GetModuleVariable variable=g0
    v3 = CheckInitialized v2 name="holey"
    AppendSpread v1, v3
    v5 = Convert v1 declared={type=undefined|null|Array<number> site=w5 flags=[OmitsNull, OmitsUndefined]}
    v6 = Integer integer=3
    v7 = BitAnd v0, v6
    v8 = ElemGet v5, v7
    v9 = Convert v8 declared={type=number site=w6} illTypedCause=ContainerWriterUnseen
    v10 = TypeTest v9 testedType=undefined|null
    Branch v10 -> taken b2(| 0), notTaken b4(| 0)
  b2(v11):
    Jump -> next b3()
  b3():
    v12 = Integer
    Jump -> next b5(v12)
  b4(v13):
    Jump -> next b5(v13)
  b5(v14):
    v15 = PropGet v5 key="length"
    v16 = Convert v15 declared={type=number site=w7} illTypedCause=Assertion
    v17 = Add v14, v16
    v18 = Convert v17 declared={type=number site=w2}
    Return v18
}
