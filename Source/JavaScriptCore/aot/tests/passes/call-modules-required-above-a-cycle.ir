# A `require` begins an evaluation of its own, and a module of a cycle of imports waits only for the members of its own evaluation. The run time gives each evaluation that it begins
# a mark, and a start that code calls where the `require` stands has the mark of whatever runs around it. So a `require` of a module that leads to a cycle of imports asks the run time.
# One that leads to no cycle calls the start where it stands, as before.
# FORM: Prepared
# RUN: pass CallModules
# STATISTIC: RequireSitesBound = 1
# CHECK: outcome: Changed

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] requireResult=ModuleExports body=f0 requests=[{target=m1 kind=Require completes=true}, {target=m2 kind=Require completes=true}]
module m1 path="/plain.mjs" displayPath="plain.mjs" body=f1 exports=[{name="kept" variable=g1}]
module m2 path="/above.mjs" displayPath="above.mjs" body=f2 requests=[{target=m3 completes=true}]
module m3 path="/first.mjs" displayPath="first.mjs" body=f3 requests=[{target=m4 completes=true}]
module m4 path="/second.mjs" displayPath="second.mjs" body=f4 requests=[{target=m3 completes=true}]
entry module=m0

function f0 name="main" module=m0 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    EvaluateModule module=m2 referrer=m0 [isBare]
    v2 = GetModuleVariable variable=g1
    PutModuleVariable v2 variable=g0
    Return
# CHECK-NEXT: b0():
# CHECK-NEXT: = CallDirect function=f1
# CHECK-NEXT: EvaluateRequiredModule module=m2
# CHECK-NEXT: = GetModuleVariable variable=g1
}
function f1 name="plain" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
# CHECK-NOT: ModuleEvaluation
}
# The run time calls the start of above.js, and the cycle below it has one status: first.mjs begins in front of second.mjs and ends behind it.
function f2 name="above" module=m2 kind=Module results=[{type=anything}] {
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g1
    Return
}
# CHECK-LABEL: function f2 name="above"
# CHECK: = BeginModuleEvaluation module=m2
# CHECK: FinishModuleEvaluation module=m2
function f3 name="first" module=m3 kind=Module results=[{type=anything}] {
    v0 = Integer integer=3
    PutModuleVariable v0 variable=g1
    Return
}
function f4 name="second" module=m4 kind=Module results=[{type=anything}] {
    v0 = Integer integer=4
    PutModuleVariable v0 variable=g1
    Return
}
# CHECK-NOT: FinishCycleMemberEvaluation
