# An access behind one permanent test of layouts that the program wrote at the position the receiver comes from has the level Written. The same access on a receiver whose layouts are only predicted stays Predicted
# RUN: pipeline PlaceTypeTests
# CHECK-LABEL: function f1 name="written"
# CHECK: = TypeTest v0 testedType=L0
# CHECK: = GetSlot [[narrowed]] key="x" receivers=[L0] level=Written
# CHECK-NEXT: = GetSlot [[narrowed]] key="y" receivers=[L0] level=Written
# CHECK-LABEL: function f2 name="predicted"
# CHECK: = TypeTest v0 testedType=L0
# CHECK: = GetSlot [[tested]] key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: = GetSlot [[tested]] key="y" receivers=[L0] level=Predicted

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0
    v4 = NewClosure function=f2
    v5 = Call v2, -, v4
    v6 = Integer integer=1
    v7 = NewObject -, v6, v6 layout=L0 fields=[0, 1]
    v8 = FinishObject v7
    v9 = CallDirect v8 function=f1
    v10 = CallDirect v8 function=f2
    Return
}
function f1 name="written" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: object ? L0):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    Return v3
}
function f2 name="predicted" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    Return v3
}
