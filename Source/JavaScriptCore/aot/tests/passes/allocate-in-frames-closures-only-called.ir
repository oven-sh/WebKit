# A closure without captures that goes through a join and is only called there need not be made: nothing tells it from the closure that the closure table holds for its function.
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    v3 = CallDirect v1, v2 function=f1
    v4 = CallDirect v1, v2 function=f2
    v5 = CallDirect v1, v2 function=f3
    v6 = CallDirect v1, v2 function=f4
    v7 = CallDirect v1, v2 function=f5
    Return
}

function f1 name="calledBehindAJoin" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f6
    Jump -> next b3(v2)
  b2():
    v3 = PropGet v0 key="method"
    Jump -> next b3(v3)
  b3(v4: anything):
    v5 = Call v4, v0, v0
    Return v5
}
# CHECK-LABEL: function f1 name="calledBehindAJoin"
# CHECK: = NewClosure function=f6 {{*}}[isHeldByClosureTable]

function f2 name="comparedBehindTheJoin" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f6
    Jump -> next b3(v2)
  b2():
    v3 = PropGet v0 key="method"
    Jump -> next b3(v3)
  b3(v4: anything):
    v5 = StrictEq v4, v0
    v6 = Call v4, v0, v5
    Return v6
}
# CHECK-LABEL: function f2 name="comparedBehindTheJoin"
# CHECK-NOT: isHeldByClosureTable

function f3 name="handedOnBehindTheJoin" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f6
    Jump -> next b3(v2)
  b2():
    v3 = PropGet v0 key="method"
    Jump -> next b3(v3)
  b3(v4: anything):
    v5 = Call v0, -, v0, v0, v4
    Return v5
}
# CHECK-LABEL: function f3 name="handedOnBehindTheJoin"
# CHECK-NOT: isHeldByClosureTable

function f4 name="isItsOwnReceiver" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure function=f6
    Jump -> next b3(v2)
  b2():
    v3 = PropGet v0 key="method"
    Jump -> next b3(v3)
  b3(v4: anything):
    v5 = Call v4, v4
    Return v5
}
# CHECK-LABEL: function f4 name="isItsOwnReceiver"
# CHECK-NOT: isHeldByClosureTable

function f5 name="hasACapture" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewClosure v0 function=f7
    Jump -> next b3(v2)
  b2():
    v3 = PropGet v0 key="method"
    Jump -> next b3(v3)
  b3(v4: anything):
    v5 = Call v4, v0
    Return v5
}
# CHECK-LABEL: function f5 name="hasACapture"
# CHECK-NOT: isHeldByClosureTable

function f6 name="method" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f7 name="arrow" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
