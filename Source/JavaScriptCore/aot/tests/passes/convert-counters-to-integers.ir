    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b6()
  b2():
    Jump -> next b3(v1)
  b3(v6):
    LoopHint
    v8 = Less v6, v3
    Branch v8 -> taken b4(), notTaken b5()
  b4():
    v9 = Add v6, v2
    Jump -> next b3(v9)
  b5():
    v10 = Add v3, v2
    Jump -> next b1(v10)
  b6():
    Return
# CHECK: b1(v3: int[0, 100]):
# CHECK: b2([[outer16]]: int[0, 99]):
# CHECK: b3(v6: int[0, 99]):
# CHECK: v8: boolean = Less v6, [[outer16]]
# CHECK-NEXT: Branch v8 -> taken b4(| 0), notTaken b5()
# CHECK-NEXT: b4([[inner16]]: int[0, 98]):
# CHECK-NEXT: Add [[inner16]], v2
# CHECK: Add [[outer16]], v2
}

