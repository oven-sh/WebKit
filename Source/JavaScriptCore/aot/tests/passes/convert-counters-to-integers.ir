module m0 path="main.js" displayPath="main.js"
function f0 name="countsUpBelowBound" parameters=[{type=i32}] results=[{type=undefined}] {
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Integer integer=1
    v6 = Add v2, v5
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v2: int[0, 2147483647]):
# CHECK: Branch v4 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[up0]]: int[0, 2147483646]):
# CHECK: v6: int[1, 2147483647] = Add [[up0]], v5
}

