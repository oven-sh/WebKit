# The call of a group passes undefined for an argument it leaves out and drops an argument that no member has a parameter for
# FORM: Prepared
# RUN: pass GroupCallsByValue CreateEntrypoints ChooseCallingConventions
# STATISTIC: GroupCalls = 2

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="passesOne"
# CHECK: [[undefined]]: undefined = Undefined
# CHECK: = CallGroup v0, v1, [[undefined]] function=
function f0 name="passesOne" parameters=[{type=f2|f3|f4|f5|f6}, {type=number}] results=[{type=anything}] {
  b0(v0: f2|f3|f4|f5|f6, v1: number):
    v2 = Call v0, -, v1 accessSite=0 callees=[f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f1 name="passesThree"
# CHECK: [[surplus]]: anything = Call v2
# CHECK-NEXT: = CallGroup v0, v1, v1 function=
function f1 name="passesThree" parameters=[{type=f2|f3|f4|f5|f6}, {type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2|f3|f4|f5|f6, v1: number, v2: anything):
    v3 = Call v2
    v4 = Call v0, -, v1, v1, v3 accessSite=1 callees=[f2, f3, f4, f5, f6]
    Return v4
}
function f2 name="first" kind=Arrow parameters=[{type=number}, {type=undefined|number}] results=[{type=number}] {
  b0(v0: number, v1: undefined|number):
    Return v0
}
