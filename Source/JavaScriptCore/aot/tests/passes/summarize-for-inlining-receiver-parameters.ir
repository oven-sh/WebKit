# A parameter counts the accesses by name that have it as their receiver and know no layout of it
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SummarizeForInlining

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="definesTwoReadsOne" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything):
    PropDefine v0, v1 key="x"
    PropDefine v0, v1 key="y"
    v4 = PropGet v0 key="x"
    Return v4
}
# CHECK: f0: barrier=None bytes=64 receiver(p0 accesses=3)

function f1 name="receiverBehindCast" parameters=[{type=anything}, {type=object}] results=[{type=anything}] {
  b0(v0: anything, v1: object):
    v2 = Predict v1 predicted=L0
    PropSet v2, v0 key="x"
    Return v0
}
# CHECK: f1: barrier=None bytes=24 receiver(p1 accesses=1)

function f2 name="layoutIsProven" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK: f2: barrier=None
# CHECK-NOT: receiver(

function f3 name="layoutIsClaimed" parameters=[{type=object written=L0}] results=[{type=anything}] {
  b0(v0: object ? L0):
    v1 = Claim v0 castType=L0
    v2 = PropGet v1 key="x"
    Return v2
}
# CHECK: f3: barrier=None
# CHECK-NOT: receiver(

function f4 name="parameterIsStored" parameters=[{type=object}, {type=L0}] results=[{type=anything}] {
  b0(v0: object, v1: L0):
    PropSet v1, v0 key="x"
    Return v0
}
# CHECK: f4: barrier=None
# CHECK-NOT: receiver(
# CHECK: outcome: Unchanged
