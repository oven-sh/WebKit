# The outer loop is copied for the call at the end of its turn, and the sum of the inner loop is an integer without it. The unlikely path of the inner loop passes a zero, which the likely path may pass too, so it stays: a turn that takes it goes on in the inner loop
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="sum" parameters=[{type=undefined|int[0, 9]}, {type=number}, {type=function}] results=[{type=anything}] {
    v3 = Integer integer=0
    Jump -> next b1(v3, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b11()
  b2():
    Jump -> next b3(v4, v3)
  b3(v8, v9):
    LoopHint
    v11 = Less v9, v1
    Branch v11 -> taken b4(), notTaken b8()
  b4():
    v12 = TypeTest v0 testedType=number
    Branch v12 -> taken b5(| 0), notTaken b6()
  b5(v13):
    v14 = BitOr v8, v13
    Jump -> next b7(v14)
  b6() frequency=Unlikely:
    v15 = Integer integer=0
    Jump -> next b7(v15)
  b7(v16):
    v17 = Add v8, v16
    v18 = BitOr v17, v3
    v19 = Increment v9
    Jump -> next b3(v18, v19)
  b8():
    v20 = Increment v5
    v21 = Less v20, v1
    Branch v21 -> taken b9(), notTaken b10()
  b9():
    Jump -> next b1(v8, v20)
  b10() frequency=Rare:
    v22 = Call v2, -, v8
    Jump -> next b1(v22, v20)
  b11():
    Return v4
# CHECK: b1(v4: i32, v5
# CHECK: b3(v8: i32, v9
# CHECK: Branch v12 -> taken b5(| 0), notTaken b6()
# CHECK: v14: i32 = BitOr v8, v13
# CHECK: b6() frequency=Rare:
# CHECK: Jump -> next b7(v15)
# CHECK: b7(v16: i32):
# CHECK: Branch v21 -> taken b9(), notTaken [[calls]](
}
