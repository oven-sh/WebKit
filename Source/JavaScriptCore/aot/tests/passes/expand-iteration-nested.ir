  b10() role=IterationCleanup subject=v7 handler=b11():
    v16 = CatchException
    IteratorClose v7 completion=Throw
    Rethrow v16
  b11() role=IterationCleanup subject=v2:
    v18 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v18
  b12():
    Return
}
