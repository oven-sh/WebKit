  b10() role=IterationCleanup subject=v8 handler=b11():
    v17 = CatchException
    IteratorClose v8 completion=Throw
    Rethrow v17
  b11() role=IterationCleanup subject=v2:
    v19 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v19
  b12():
    Return
