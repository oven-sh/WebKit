# A dead zone test of a value goes below a test of the same value that dominates it, and stays for another value, behind a merge and in a handler
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="x" declared={type=anything|absent}}, {key="y" declared={type=anything|absent}}]
variable g0 name="counter" module=m0 declared={type=number|absent} initialization=Uninitialized

function f0 name="checkBelowCheck" results=[{type=number}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="counter"
    v2 = CheckInitialized v0 name="counter"
    v3 = Add v1, v2
    Return v3
# CHECK: v1: number = CheckInitialized v0 name="counter"
# CHECK-NEXT: = Add v1, v1
}

function f1 name="checkInDominatedBlock" parameters=[{type=boolean}] results=[{type=number}] {
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="counter"
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = CheckInitialized v1 name="counter"
    Return v3
  b2():
    Return v2
# CHECK: v2: number = CheckInitialized v1 name="counter"
# CHECK: b1():
# CHECK-NEXT: Return v2
}

function f2 name="fieldCheckBelowCheck" captures=[{type=env L0}] results=[{type=boolean}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=1
    v2 = CheckInitialized v1 name="y"
    v3 = CheckInitialized v1 name="y"
    v4 = StrictEq v2, v3
    Return v4
# CHECK: v2: anything = CheckInitialized v1 name="y"
# CHECK-NEXT: = StrictEq v2, v2
}

function f3 name="afterMerge" parameters=[{type=boolean}] results=[{type=number}] {
    v1 = GetModuleVariable variable=g0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = CheckInitialized v1 name="counter"
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    v3 = CheckInitialized v1 name="counter"
    Return v3
# CHECK: b1():
# CHECK-NEXT: v2: number = CheckInitialized v1 name="counter"
# CHECK: b3():
# CHECK-NEXT: v3: number = CheckInitialized v1 name="counter"
# CHECK-NEXT: Return v3
}

function f4 name="otherEnvironmentAndOtherField" captures=[{type=env L0}, {type=env L0}] results=[{type=anything}] {
  b0(v0: env L0, v1: env L0):
    v2 = GetEnvironmentField v0 layout=L0 field=1
    v3 = CheckInitialized v2 name="y"
    v4 = GetEnvironmentField v1 layout=L0 field=1
    v5 = CheckInitialized v4 name="y"
    v6 = GetEnvironmentField v0 layout=L0 field=0
    v7 = CheckInitialized v6 name="x"
    Return v7
# CHECK: = CheckInitialized v2 name="y"
# CHECK: = CheckInitialized v4 name="y"
# CHECK: = CheckInitialized v6 name="x"
}

function f5 name="checkInCoveredBlock" results=[{type=number}] {
    v0 = GetModuleVariable variable=g0
    Jump -> next b1()
  b1() handler=b3():
    v1 = CheckInitialized v0 name="counter"
    Jump -> next b2()
  b2():
    v2 = CheckInitialized v0 name="counter"
    Return v2
  b3() role=CatchHandler:
    v3 = CatchValue
    v4 = CheckInitialized v0 name="counter"
    Return v4
# CHECK: b1() handler=b3():
# CHECK-NEXT: v1: number = CheckInitialized v0 name="counter"
# CHECK: b2():
# CHECK-NEXT: Return v1
# CHECK: b3() role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NEXT: v4: number = CheckInitialized v0 name="counter"
# CHECK-NEXT: Return v4
}
