    v19 = Construct v12 calleeName="Sub" @154
    v20 = Predict v19 predicted=L1 @150
    v21 = PropGet v20 key="seen" @150
    v22 = Call v18, -, v21 calleeName="print" @144
    v23 = Undefined @144
    Return v23 @144
}
