# function read(o) { return o.z }  class Base { constructor() { this.seen = read(this) } }  class Sub extends Base { }  Sub.prototype.z = "proto";  print(new Sub().seen)
# The allocation of a base constructor takes its prototype from new.target, so its object may be of a subclass. Once read is inlined the object could be virtual, and a lookup on the layout the allocation names
# would find the name absent on the chain of Base. Such an allocation is an opaque virtual object: the read stays a read by name.
# RUN: pipeline SinkAllocations
# CHECK-LABEL: function f2 name="Base"
# CHECK: key="z"

layout L0 kind=Instance name="Base" module=m0 position=39 constructor=f2 fields=[{key="seen" declared={type=anything}}]
layout L1 kind=Instance name="Sub" module=m0 position=96 predictedBase=L0 constructor=f3 supertypes=[L0] flags=[HasHeritage]
variable g0 name="read" module=m0 declared={type=function} initialization=Function function=f1 flags=[IsImmutable]
