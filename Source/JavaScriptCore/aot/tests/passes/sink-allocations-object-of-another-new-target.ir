    PutModuleVariable v8 variable=g2 @90
    v10 = FinishClass v8 layout=L1 @90
    v11 = ClaimDeclared v10 declared={type=anything predicted=function} @90
    v12 = ClaimDeclared v10 declared={type=anything predicted=function} @90
    v13 = PropGet v12 key="prototype" @117
    v14 = Predict v13 predicted=L1 @117
    v15 = String string="proto" @135
    PropSet v14, v15 key="z" @117
    v17 = Builtin builtin=GlobalThis @144
