# One test, two branches: `c === a` in the head of a loop and `a === c` in its body. The one that passes a proof stands in another block than the test.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js"
function f0 name="behindATestThatMayFailAtOnce" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    Branch v2 -> taken b2(), notTaken b6()
  b2():
    v4 = StrictEq v0, v1
    Branch v4 -> taken b3(), notTaken b6()
  b3():
    Branch v4 -> taken b4(| 0), notTaken b5()
  b4(v5: anything):
    Jump -> next b5()
  b5():
    Jump -> next b1()
  b6():
    Return v0
# CHECK: b2():
# CHECK-NEXT: v4: boolean = StrictEq v0, v1
# CHECK-NEXT: Branch v4 -> taken b3(), notTaken b6()
# CHECK: b3():
# CHECK-NEXT: Branch v4 -> taken b4(| 0), notTaken b5()
}

function f1 name="inTheHeader" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = StrictEq v0, v1
    Branch v3 -> taken b2(), notTaken b5()
  b2():
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4: anything):
    Jump -> next b4()
  b4():
    Jump -> next b1()
  b5():
    Return v0
# CHECK: b1():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: v3: boolean = StrictEq v0, v1
# CHECK: b2():
# CHECK-NEXT: Branch v3 -> taken b3(| 0), notTaken b4()
}
