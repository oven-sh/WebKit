# A function that returns the list of a call on one path hands on a list it does not build, so it keeps every result
# FORM: Prepared
# RUN: pass RemoveUnusedResults
# STATISTIC: UnusedResultsRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="endsInReturnOfCall" role=ResultWorker parameters=[{type=int}, {type=boolean}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f1} {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Add v0, v0
    v3 = Mul v0, v0
    v4 = Results v2, v3
    Return v4
  b2():
    v5 = CallDirect v0 function=f2
    Return v5
}
# CHECK-LABEL: function f0 name="endsInReturnOfCall"{{*}}results=[{type=number}, {type=number}] 
# CHECK: [[sum]]:{{*}}= Add v0, v0
# CHECK-NEXT: [[product]]:{{*}}= Mul v0, v0
# CHECK-NEXT: [[list]]:{{*}}= Results [[sum]], [[product]]
# CHECK-NEXT: Return [[list]]
# CHECK: [[tail]]:{{*}}= CallDirect v0 function=f2
# CHECK-NEXT: Return [[tail]]

function f1 name="endsInReturnOfCall" role=ResultWrapper parameters=[{type=int}, {type=boolean}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f0}

function f2 name="pair" role=ResultWorker parameters=[{type=int}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f3} {
    v1 = Sub v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f2 name="pair"{{*}}results=[{type=number}, {type=number}] 

function f3 name="pair" role=ResultWrapper parameters=[{type=int}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f2}

function f4 name="endsInReturnOfResults" role=ResultWorker parameters=[{type=int}, {type=boolean}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f5} {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Add v0, v0
    v3 = Mul v0, v0
    v4 = Results v2, v3
    Return v4
  b2():
    v5 = Sub v0, v0
    v6 = Mul v0, v0
    v7 = Results v5, v6
    Return v7
}
# CHECK-LABEL: function f4 name="endsInReturnOfResults"{{*}}results=[{type=number}] 
# CHECK-NOT: = Mul
# CHECK-NOT: = Results

function f5 name="endsInReturnOfResults" role=ResultWrapper parameters=[{type=int}, {type=boolean}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f4}

function f6 name="readsFirstOfEach" parameters=[{type=int}, {type=boolean}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f0
    v3 = ResultAt v2 index=0
    v4 = CallDirect v0, v1 function=f4
    v5 = ResultAt v4 index=0
    v6 = Add v3, v5
    Return v6
# CHECK: [[both]]:{{*}}= CallDirect v0, v1 function=f0
# CHECK-NEXT: [[first]]: number = ResultAt [[both]]
# CHECK-NEXT: [[single]]: number = CallDirect v0, v1 function=f4
# CHECK-NEXT: = Add [[first]], [[single]]
}
