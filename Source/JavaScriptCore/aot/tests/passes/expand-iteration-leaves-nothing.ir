# No operation of an iteration is left behind the pass, wherever it stands and however few uses its open has
# FORM: Prepared optimizing
# RUN: pass ExpandIteration VerifyProgram
# RUN(LEFT): pass ExpandIteration
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="openInUnreachableBlock" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
  b1():
    v1 = IteratorOpen v0
    v2 = IteratorResume v1
    v3 = ResultAt v2 index=1
    IteratorClose v1
    Return
}
# CHECK-LABEL: function f0 name="openInUnreachableBlock"
# CHECK: b0(v0: anything):
# CHECK-NEXT: Return
# CHECK-NEXT: b1():
# CHECK-NEXT: Unreachable
# CHECK-NEXT: }

function f1 name="stepInUnreachableBlock" parameters=[{type=Array<number, pristine[Names]>}] results=[{type=undefined}] {
  b0(v0: Array<number, pristine[Names]>):
    v1 = IteratorOpen v0
    Return
  b1():
    v2 = IteratorResume v1
    v3 = ResultAt v2 index=1
    IteratorClose v1
    Return
}
# CHECK-LABEL: function f1 name="stepInUnreachableBlock"
# CHECK-NOT: ElemGet
# CHECK: b1():
# CHECK-NEXT: Unreachable
# CHECK-NOT: ElemGet

function f2 name="spreadInUnreachableBlock" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
  b1():
    v1 = NewArray contents=anything
    AppendSpread v1, v0
    Return
}
# CHECK-LABEL: function f2 name="spreadInUnreachableBlock"
# CHECK: b1():
# CHECK-NEXT: Unreachable
# CHECK-NEXT: }

function f3 name="openWithoutStepOrClose" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = IteratorOpen v0
    Return
}
# What the open does by itself stays: the tests, and on the failing edges the reads and the call of the protocol.
# CHECK-LABEL: function f3 name="openWithoutStepOrClose"
# CHECK: = TypeTest v0 testedType=Array
# CHECK: key=@@iterator
# CHECK: key="next"

function f4 name="closeOnlyInLandingBlock" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1() handler=b3():
    v3 = Call v1
    Jump -> next b2()
  b2():
    Return
  b3() role=IterationCleanup subject=v2:
    v4 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v4
}
# CHECK-LABEL: function f4 name="closeOnlyInLandingBlock"
# CHECK: role=CleanupHandler
# CHECK: key="return"

# LEFT-NOT: IteratorOpen
# LEFT-NOT: IteratorResume
# LEFT-NOT: IteratorClose
# LEFT-NOT: AppendSpread
# LEFT-NOT: role=IterationCleanup
