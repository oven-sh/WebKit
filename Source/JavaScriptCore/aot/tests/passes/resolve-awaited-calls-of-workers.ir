    v2 = CallDirect v0 function=f0 @40
    v3 = AwaitBySavingFrame v2, v1 @41
    v4 = ReturnAsyncResult v1, v3
    Return v4
  b1(v5) role=CatchHandler:
    v6 = CatchValue
    v7 = ReturnAsyncResult v1, v5
    Return v7
}
