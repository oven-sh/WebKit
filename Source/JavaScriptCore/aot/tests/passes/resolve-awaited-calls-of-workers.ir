# The call takes no driver and has a handler of its own. A result that is no thenable is awaited as it is, which takes as many turns of the job queue as the await of a promise fulfilled with it
function f18 name="awaitsWorker" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f4} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f18 entryWithoutPromise=f18 promiseType=Promise promiseParameter=1} {
  b0(v0: anything, v1: undefined|Promise):
    v2 = CallDirect v0 function=f0 @10
    v3 = AwaitBySavingFrame v2, v1 @11
    v4 = ReturnAsyncResult v1, v3
    Return v4
}
# CHECK-LABEL: function f18 name="awaitsWorker"
# CHECK-NOT: AwaitCallBySavingFrame
# CHECK: b0(v0: anything, v1: undefined|Promise):
# CHECK-NEXT: Jump -> next [[calling18]]()
# CHECK-NEXT: [[rest18]](v3: anything):
# CHECK-NEXT: v4: anything = ReturnAsyncResult v1, v3
# CHECK: [[rejection18]]() role=CatchHandler frequency=Rare:
# CHECK-NEXT: [[error18]]: anything = CatchValue
# CHECK-NEXT: [[rejected18]]: Promise = NewPromise
# CHECK-NEXT: RejectPromise [[rejected18]], [[error18]]
# CHECK-NEXT: Jump -> next [[awaiting18]]([[rejected18]])
# CHECK-NEXT: [[awaiting18]]([[awaited18]]: anything):
# CHECK-NEXT: [[result18]]: anything = AwaitBySavingFrame [[awaited18]], v1 @11
# CHECK-NEXT: Jump -> next [[rest18]]([[result18]])
# CHECK-NEXT: [[calling18]]() handler=[[rejection18]]():
# CHECK-NEXT: [[returned18]]: anything = CallDirect v0 function=f14 @10
# CHECK-NEXT: [[isValue18]]: boolean = IsNotThenable [[returned18]]
# CHECK-NEXT: Branch [[isValue18]] -> taken [[awaiting18]]([[returned18]]), notTaken [[resolving18]]()
# CHECK-NEXT: [[resolving18]]() frequency=Unlikely:
# CHECK-NEXT: [[resolved18]]: Promise = NewPromise
# CHECK-NEXT: ResolvePromise [[resolved18]], [[returned18]]
# CHECK-NEXT: Jump -> next [[awaiting18]]([[resolved18]])
# CHECK-NOT: AwaitCallBySavingFrame

