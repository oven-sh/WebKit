    v5 = AwaitBySavingFrame v4, v1 @73
    v6 = CallDirect v5 function=f0 @74
    v7 = AwaitBySavingFrame v6, v1 @75
    v8 = ReturnAsyncResult v1, v7
    Return v8
}
