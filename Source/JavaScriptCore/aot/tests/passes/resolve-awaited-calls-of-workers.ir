# CHECK-NEXT: [[result19]]: anything ~ number = AwaitBySavingFrame [[awaited19]], v1 @21
# CHECK-NEXT: Jump -> next [[rest19]]([[result19]])
# CHECK-NEXT: [[calling19]]() handler=[[rejection19]]():
# CHECK-NEXT: [[returned19]]: number = CallDirect v0 function=f15 @20
# CHECK-NEXT: Jump -> next [[awaiting19]]([[returned19]])
# CHECK-NOT: IsNotThenable
# CHECK-NOT: ResolvePromise

# The worker always throws, so nothing stands behind the call and only the rejected promise is awaited
