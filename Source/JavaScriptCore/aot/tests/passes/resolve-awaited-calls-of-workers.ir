# The typed and the untyped version of a function that never suspends, called in two arms: the await moves into the arms first, and then each arm calls its worker
function f23 name="behindAMerge" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f9} creator=Coroutine{kind=AsyncFunction ramp=f9 body=f23 entryWithoutPromise=f23 promiseType=Promise promiseParameter=1} {
  b0(v0: anything, v1: undefined|Promise):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallDirect v3 function=f1 @60
    Jump -> next b3(v4)
  b2():
    v5 = CallDirect v0 function=f0 @60
    Jump -> next b3(v5)
  b3(v6):
    v7 = AwaitBySavingFrame v6, v1 @61
    v8 = ReturnAsyncResult v1, v7
    Return v8
}
# CHECK-LABEL: function f23 name="behindAMerge"
# CHECK: b1(v3: number):
# CHECK-NEXT: Jump -> next [[typedCall23]]()
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next [[untypedCall23]]()
# CHECK-NEXT: b3(v6: anything):
# CHECK-NEXT: v7: anything = Upcast v6 castType=anything @61
# CHECK: : anything = AwaitBySavingFrame {{*}}, v1 @61
# CHECK: [[untypedCall23]]() handler=
# CHECK-NEXT: [[untyped23]]: anything = CallDirect v0 function=f14 @60
# CHECK-NEXT: = IsNotThenable [[untyped23]]
# CHECK: : anything ~ number = AwaitBySavingFrame {{*}}, v1 @61
# CHECK: [[typedCall23]]() handler=
# CHECK-NEXT: [[typed23]]: number = CallDirect v3 function=f15 @60
# CHECK-NEXT: Jump -> next

