# Every caller has taken the wrapper in. Its own call still reads all results, but neither the wrapper nor the version that it calls gets code, so that version does not count against the others
# FORM: Prepared
# RUN: pass SplitFreshResults VerifyProgram
# STATISTIC: ResultClonesCreated = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="twoHalves" role=ResultWrapper parameters=[{type=number}, {type=number}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f3} {
  b0(v0: number, v1: number):
    v2 = CallDirect v0, v1 function=f3
    v3 = ResultAt v2 index=0
    v4 = ResultAt v2 index=1
    v5 = NewArray v3, v4 contents=number
    Return v5
}

function f1 name="readsFirst" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f3
    v2 = ResultAt v1 index=0
    Return v2
}
# CHECK-LABEL: function f1 name="readsFirst"
# CHECK: v1: number = CallDirect v0, v0 function=[[first]]
# CHECK-NOT: ResultAt

function f2 name="readsSecond" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f3
    v2 = ResultAt v1 index=1
    Return v2
}
# CHECK-LABEL: function f2 name="readsSecond"
# CHECK: v1: number = CallDirect v0, v0 function=[[second]]
# CHECK-NOT: ResultAt

function f3 name="twoHalves" role=ResultWorker parameters=[{type=number}, {type=number}] results=[{type=number}, {type=number}] derivation={source=f0} creator=ResultWorker{origin=f0} {
  b0(v0: number, v1: number):
    v2 = Mul v0, v0
    v3 = Add v2, v0
    v4 = Mul v3, v0
    v5 = Add v4, v0
    v6 = Mul v5, v0
    v7 = Add v6, v0
    v8 = Mul v7, v0
    v9 = Add v8, v0
    v10 = Mul v1, v1
    v11 = Add v10, v1
    v12 = Mul v11, v1
    v13 = Add v12, v1
    v14 = Mul v13, v1
    v15 = Add v14, v1
    v16 = Mul v15, v1
    v17 = Add v16, v1
    v18 = Results v9, v17
    Return v18
}
# CHECK-LABEL: function f3 name="twoHalves" module=m0 role=ResultWorker
# CHECK: results=[{type=number}, {type=number}] 
# CHECK: function [[first]] name="twoHalves" module=m0 role=ResultWorker {{*}}results=[{type=number}] 
# CHECK: = Mul v0, v0
# CHECK-NOT: = Mul v1, v1
# CHECK: function [[second]] name="twoHalves" module=m0 role=ResultWorker {{*}}results=[{type=number}] 
# CHECK-NOT: = Mul v0, v0
# CHECK: = Mul v1, v1
