# An array that a counted loop appends to once per iteration reserves room for the iterations that are left when its vector is full
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# RUN(TWICE): pass PlanArrayCapacities PlanArrayCapacities
# STATISTIC: ArrayGrowthsPlanned = 7
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Bag" fields=[{key="items" declared={type=Array<anything>} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
function f0 name="pushToParameter" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int[0, 1000000]}, {type=anything}] results=[{type=undefined}] {
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallBuiltin v0, v2 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10)
  b3():
    Return
# CHECK: [[room0]]: boolean = HasSpareArrayCapacity v0
# CHECK-NEXT: Branch [[room0]] -> taken [[fast0]](), notTaken [[full0]]()
# CHECK: [[fast0]]():
# CHECK-NEXT: = CallBuiltin v0, v2 overload=ArrayPrototypePush/0
# CHECK: [[full0]]() frequency=Rare:
# CHECK-NEXT: [[left0]]:{{*}}= Sub v1, v4
# CHECK-NEXT: ReserveArrayCapacity v0, [[left0]]
# CHECK-NEXT: = CallBuiltin v0, v2 overload=ArrayPrototypePush/0
}

function f1 name="appendElementToParameter" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int[0, 1000000]}, {type=anything}] results=[{type=undefined}] {
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    AppendElement v0, v2
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10)
  b3():
    Return
# CHECK: = HasSpareArrayCapacity v0
# CHECK: AppendElement v0, v2
# CHECK: ReserveArrayCapacity v0,
# CHECK-NEXT: AppendElement v0, v2
}

