function f8 name="conditionalPush" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int[0, 1000000]}, {type=anything}, {type=boolean}] results=[{type=undefined}] {
    v4 = Integer integer=0
    Jump -> next b1(v4)
  b1(v5):
