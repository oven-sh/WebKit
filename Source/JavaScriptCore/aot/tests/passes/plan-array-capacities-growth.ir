function f6 name="literalMayExceedPlannedCapacity" parameters=[{type=int[0, 1000000]}, {type=anything}] results=[{type=Array<anything>}] {
    v2 = NewArray contents=anything
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallBuiltin v2, v1 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10)
  b3():
    Return v2
# The loop runs nobody's code and ends nowhere but at its test, so it is going to append all of it: the literal gets the room, however much, and each append is told the length, the counter and the bound.
# CHECK: = NewArray {{*}}capacity={{*}} [isFilledToCapacity]
# CHECK-NOT: HasSpareArrayCapacity
# CHECK: AppendElement v2, v1, v4, v4, v0
# CHECK-NOT: ReserveArrayCapacity
}

