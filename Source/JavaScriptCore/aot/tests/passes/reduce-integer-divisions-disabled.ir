module m0 path="main.js" displayPath="main.js"
function f0 name="floorOfNonNegative" parameters=[{type=int[0, 100]}, {type=int[1, 8]}] results=[{type=number}] {
  b0(v0: int[0, 100], v1: int[1, 8]):
    v2 = Div v0, v1
    v3 = CallBuiltin -, v2 overload=MathFloor/0 builtinCallForm=Whole
    Return v3
}
