# A guard that entered a block with its subject is about the parameter: it does not stand for a test of the object that one edge passed, nor such a test for it
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="epochTestOfGuardOfParameter" parameters=[{type=object}, {type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: object, v2: boolean):
    v3 = GetShapeEpoch
    v4 = ShapeTest v0 layouts=[L0]
    Branch v4 -> taken b1(| 0), notTaken b6()
  b1(v5):
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b4(v0, v5)
  b3():
    v6 = ShapeTest v1 layouts=[L0]
    Branch v6 -> taken b4(v1 | 0), notTaken b6()
  b4(v7, v8):
    v9 = IsShapeEpochCurrent v3, v8
    Branch v9 -> taken b5(| 0), notTaken b6()
  b5(v10):
    v11 = GetSlot v7, v10 key="x" receivers=[L0] level=Predicted
    Return v11
  b6():
    Return v0
}
