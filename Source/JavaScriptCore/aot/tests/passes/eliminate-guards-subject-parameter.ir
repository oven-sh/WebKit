# CHECK: b4(v7: object, v8: guard):
# CHECK-NEXT: v9: boolean = IsShapeEpochCurrent v3, v8
# CHECK-NEXT: Branch v9 -> taken b5(| 0), notTaken b6()
# CHECK-NEXT: b5(v10: guard):
# CHECK-NEXT: v11: number = GetSlot v7, v10 key="x" receivers=[L0] level=Predicted

