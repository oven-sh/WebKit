# An access by name takes as its receiver the narrowest cast of the same object that dominates it, and a later cast of the object takes it as its operand
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 6
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyCasts SimplifyCasts
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]

function f0 name="everyAccessWithReceiver" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v0 expectedType=L0
    v3 = PropGet v0 key="x"
    PropSet v0, v1 key="x"
    v5 = PropHas v0 key="x"
    v6 = ElemGet v0, v1
    ElemSet v0, v1, v1
    Return v3
# CHECK: = Check v0 expectedType=L0
# CHECK-NEXT: = PropGet v2 key="x"
# CHECK-NEXT: PropSet v2, v1 key="x"
# CHECK-NEXT: = PropHas v2 key="x"
# CHECK-NEXT: = ElemGet v2, v1
# CHECK-NEXT: ElemSet v2, v1, v1
}

function f1 name="narrowerCastComesSecond" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = RequireObjectCoercible v0 nullishAccess=Read name="x"
    v2 = Check v0 expectedType=L0
    v3 = PropGet v0 key="x"
    Return v3
# CHECK: = Check v1 expectedType=L0
# CHECK-NEXT: = PropGet v2 key="x"
}

function f2 name="widerCastComesSecond" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=L0
    v2 = RequireObjectCoercible v0 nullishAccess=Read name="x"
    v3 = PropGet v0 key="x"
    Return v3
# The wider cast takes the check as its operand. It is a test of the language: it stays while the check stands, which answers it in the typed version alone.
# CHECK: = Check v0 expectedType=L0
# CHECK-NEXT: = RequireObjectCoercible v1 name="x"
# CHECK-NEXT: = PropGet v1 key="x"
}

function f3 name="receiverIsWiderCast" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = RequireObjectCoercible v0 nullishAccess=Read name="x"
    v2 = Check v1 expectedType=L0
    v3 = PropGet v1 key="x"
    Return v3
# CHECK: = PropGet v2 key="x"
}

function f4 name="underShapeGuard" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Check v0 expectedType=L0
    v4 = PropGet v0 key="x"
    Return v4
  b2():
    v5 = Undefined
    Return v5
# CHECK: = PropGet v3 key="x"
}

function f5 name="castInCoveredBlock" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Check v0 expectedType=L0
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="x"
    Return v2
  b2() role=CatchHandler:
    v3 = CatchValue
    v4 = PropGet v0 key="x"
    Return v4
# CHECK: b1():
# CHECK-NEXT: = PropGet v1 key="x"
# CHECK: b2() role=CatchHandler:
# CHECK: = PropGet v0 key="x"
}

function f6 name="receiverIsNarrowestCast" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = RequireObjectCoercible v0 nullishAccess=Read name="x"
    v2 = Check v1 expectedType=L0
    v3 = PropGet v2 key="x"
    Return v3
# CHECK: = PropGet v2 key="x"
}

function f7 name="castFollowsAccess" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = Check v0 expectedType=L0
    Return v1
# CHECK: = PropGet v0 key="x"
}

function f8 name="castOfAnotherValue" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v1 expectedType=L0
    v3 = PropGet v0 key="x"
    Return v3
# CHECK: = PropGet v0 key="x"
}

function f9 name="castOnOnePathToAccess" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Check v0 expectedType=L0
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    v3 = PropGet v0 key="x"
    Return v3
# CHECK: b3():
# CHECK-NEXT: = PropGet v0 key="x"
}

function f10 name="accessReachedThroughHandlerAsWell" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = Check v0 expectedType=L0
    Jump -> next b1()
  b1():
    Jump -> next b3()
  b2() role=CatchHandler:
    v2 = CatchValue
    Jump -> next b3()
  b3():
    v3 = PropGet v0 key="x"
    Return v3
# CHECK: b3():
# CHECK-NEXT: = PropGet v0 key="x"
}
