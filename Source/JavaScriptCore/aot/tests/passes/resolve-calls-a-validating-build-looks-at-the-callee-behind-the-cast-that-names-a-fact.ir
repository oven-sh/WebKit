# A variable that holds a closure was read ahead of the fact which says that it has been stored: the word may be anything, and only the cast that names the fact takes that away. A validating build compares
# the callee of a call that a type made direct with that type. It looks at the cast, not at the word in front of it
# FORM: Prepared
# OPTIONS: validate
# RUN: pass ResolveCalls VerifyProgram

module m0 path="main.js" displayPath="main.js"
variable g0 name="callback" declared={type=f1} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

function f0 name="callsWhatWasReadEarly" parameters=[{type=boolean}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Entered function=f2
    v3 = AssumeType v1, v2 provenType=f1
    v4 = Upcast v3 castType=f1
    v5 = Call v4, -
    Return v5
  b2():
    Return
}
# CHECK-LABEL: name="callsWhatWasReadEarly"
# CHECK: [[word]]: unspecified|f1 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
# CHECK: [[callee]]: f1 = AssumeType [[word]], {{*}} provenType=f1
# CHECK: ValidateCallee [[callee]] validatedType=f1
# CHECK: = CallDirect function=f1

function f1 name="callee" flags=[IsHiddenInStackTraces] results=[{type=anything}] {
    v0 = Undefined
    Return v0
}
function f2 name="reader" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}
