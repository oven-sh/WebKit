# The header of the loop has a handler and holds, before the step, a value that other blocks read. A turn keeps that value in its header and tests the enumerator in the block below, with the turn's own arguments for the handler.
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 3

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Record" fields=[{key="alpha" declared={type=number}}, {key="bravo" declared={type=number}}] flow={constructorOrders=[{fields=[0, 1]}]}

function f0 name="readsTheCastAfterTheLoop" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v1, v3)
  b1(v4: anything, v5: int[0, 8589934591]) handler=b4(v4):
    v6 = AssumeType v4 castType=string
    LoopHint
    v8 = ForInStep v2, v0 position=v5
    v9 = ResultAt v8 index=0
    v10 = ResultAt v8 index=1
    v11 = ResultAt v8 index=2
    v12 = Integer integer=1
    v13 = Add v11, v12
    Branch v9 -> taken b3(), notTaken b2()
  b2() handler=b4(v10):
    v14 = ElemGet v0, v10
    Jump -> next b1(v10, v13)
  b3():
    Return v6
  b4(v15: anything) role=CatchHandler:
    Return v15
# CHECK: b6(v17: anything, v18: int[0, 8589934591]) handler=b4(v17):
# CHECK-NEXT: = AssumeType v17 castType=string
# CHECK-NEXT: Jump -> next b19()
# CHECK: b16() handler=b4(v4):
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = ForInStep v2, v0 position=v5
# CHECK-NOT: LoopHint
# CHECK: b19() handler=b4(v17):
# CHECK-NEXT: : 1 = Integer integer=1
# CHECK-NEXT: = IsEnumeratorCurrent v2, v0,
# CHECK: b22() handler=b4(v28):
# CHECK-NEXT: : 0 = Integer
# CHECK-NEXT: = IsEnumeratorCurrent v2, v0,
# CHECK: b27() frequency=Unlikely handler=b4(v17):
# CHECK-NEXT: Jump -> next b1(v17, v18)
}

function f1 name="hasTheLoopHintFirst" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v1, v3)
  b1(v4: anything, v5: int[0, 8589934591]) handler=b4(v4):
    LoopHint
    v7 = AssumeType v4 castType=string
    v8 = ForInStep v2, v0 position=v5
    v9 = ResultAt v8 index=0
    v10 = ResultAt v8 index=1
    v11 = ResultAt v8 index=2
    v12 = Integer integer=1
    v13 = Add v11, v12
    Branch v9 -> taken b3(), notTaken b2()
  b2() handler=b4(v10):
    v14 = ElemGet v0, v10
    Jump -> next b1(v10, v13)
  b3():
    Return v7
  b4(v15: anything) role=CatchHandler:
    Return v15
# CHECK: b1(v4: anything, v5: int[0, 8589934591]) handler=b4(v4):
# CHECK-NEXT: LoopHint
# CHECK-NOT: LoopHint
# CHECK: b6(v17: anything, v18: int[0, 8589934591]) handler=b4(v17):
# CHECK-NEXT: = AssumeType v17 castType=string
# CHECK-NEXT: Jump -> next b19()
# CHECK-NOT: LoopHint
# CHECK: b19() handler=b4(v17):
# CHECK-NEXT: : 1 = Integer integer=1
# CHECK-NEXT: = IsEnumeratorCurrent v2, v0,
}

function f2 name="readsTheTestInTheHandler" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: anything):
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v1, v3)
  b1(v4: anything, v5: int[0, 8589934591]) handler=b4(v4):
    v6 = TypeTest v4 testedType=string
    LoopHint
    v8 = ForInStep v2, v0 position=v5
    v9 = ResultAt v8 index=0
    v10 = ResultAt v8 index=1
    v11 = ResultAt v8 index=2
    v12 = Integer integer=1
    v13 = Add v11, v12
    Branch v9 -> taken b3(), notTaken b2()
  b2() handler=b4(v6):
    v14 = ElemGet v0, v10
    Jump -> next b1(v10, v13)
  b3():
    Return v4
  b4(v15: anything) role=CatchHandler:
    Return v15
# CHECK: b5() handler=b4(v19):
# CHECK: b6(v17: anything, v18: int[0, 8589934591]) handler=b4(v17):
# CHECK-NEXT: v19: boolean = TypeTest v17 testedType=string
# CHECK-NEXT: Jump -> next b19()
# CHECK: b7() handler=b4(v30):
# CHECK: b8(v28: anything, v29: int[0, 8589934591]) handler=b4(v28):
# CHECK-NEXT: v30: boolean = TypeTest v28 testedType=string
# CHECK-NEXT: Jump -> next b22()
# CHECK: b19() handler=b4(v17):
# CHECK-NEXT: : 1 = Integer integer=1
# CHECK-NEXT: = IsEnumeratorCurrent v2, v0,
}
