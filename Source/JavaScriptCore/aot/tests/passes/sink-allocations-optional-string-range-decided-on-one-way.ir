# A substring that may be undefined, decided by a test on one way into a merge and undecided on the other. On the way where it is undefined its bounds are no longer carried, so behind the merge the value is built by its tag, not from the bounds
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"

function f0 name="undefinedOnOneWay" parameters=[{type=anything}, {type=string}, {type=int[-1, 100]}, {type=int[-1, 100]}, {type=boolean}] results=[{type=anything}] {
    v5 = SubstringOrUndefined v1, v2, v3
    Branch v4 -> taken b1(), notTaken b3()
  b1():
    v6 = TypeTest v5 testedType=undefined
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    Jump -> next b3()
  b3():
    v7 = Call v0, -, v5
    Return v7
  b4():
    Return v1
# CHECK-NOT: SubstringOrUndefined
# CHECK: = Undefined
# CHECK: = Substring
}
