# Results that no call site reads are dropped and ResultAt is renumbered
# FORM: Prepared
# RUN: pass RemoveUnusedResults
# STATISTIC: UnusedResultsRemoved = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="triple" role=ResultWorker parameters=[{type=i32}] results=[{type=number}, {type=number}, {type=number}] creator=ResultWorker{origin=f1} {
  b0(v0: i32):
    v1 = Add v0, v0
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v3, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = Add v4, v7
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10, v8)
  b3():
    v11 = Sub v0, v0
    v12 = Results v1, v4, v11
    Return v12
}
# CHECK-LABEL: function f0 name="triple"{{*}}results=[{type=number}, {type=number}] 
# CHECK-NOT: LoopHint
# CHECK: Results [[first]], [[third]]

function f1 name="triple" role=ResultWrapper parameters=[{type=i32}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f0}

function f2 name="readsFirst" parameters=[{type=i32}] results=[{type=number}] {
  b0(v0: i32):
    v1 = CallDirect v0 function=f0
    v2 = ResultAt v1 index=0
    Return v2
}
# CHECK-LABEL: function f2
# CHECK: ResultAt [[callInF2]]
# CHECK-NOT: index=

