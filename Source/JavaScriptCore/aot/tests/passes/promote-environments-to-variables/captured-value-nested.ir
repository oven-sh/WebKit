# A closure that copies what its creator has copied reads the same variable, however often it is created. What belongs to one call of the creator stays a capture
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: CapturesPromotedToVariables = 2
# CHECK: variable g0 module=m0
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = NewClosure v2 function=f1
    v4 = PropGet v0 key="publish" [isFreeName]
    v5 = Call v4, -, v3
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: PutModuleVariable v2 variable=g0
# CHECK-NEXT: = NewClosure function=f1

function f1 name="outer" kind=Arrow captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewClosure v0, v1 function=f2
    Return v2
}
# CHECK-LABEL: function f1 name="outer"
# CHECK-NOT: captures=
# CHECK: b0([[offset]]: anything):
# CHECK: = NewClosure [[offset]] function=f2

function f2 name="inner" kind=Arrow captures=[{type=anything}, {type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Add v2, v1
    v4 = Less v3, v0
    Return v4
}
# CHECK-LABEL: function f2 name="inner"{{*}}captures=[{type=anything}] thisType
# CHECK: b0([[captured]]: anything, [[x]]: anything):
# CHECK-NEXT: [[limit]]: anything = GetModuleVariable variable=g0
# CHECK-NEXT: [[sum]]:{{*}}= Add [[x]], [[captured]]
# CHECK-NEXT: = Less [[sum]], [[limit]]
