# The environment of a function that runs at most once becomes variables, and no function captures it. A function that is called twice keeps its environment
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 1
# STATISTIC: CapturesPromotedToVariables = 0
# CHECK: layout L0 kind=Environment name="once"{{*}}flow={allocation=NeverAllocated
# CHECK: variable g0 name="counter.0" module=m0 declared={type=int|whole} flow={writers=AllKnown initialization=StoredBeforeEveryRead}
# CHECK: variable g1 name="bump.1" module=m0 declared={type=f2{{*}}flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead reads=OnlyCalled}
# CHECK-NOT: variable g2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="once" fields=[{key=@"counter.0" declared={type=anything|absent}}, {key=@"bump.1" declared={type=anything}}]
layout L1 kind=Environment name="twice" fields=[{key=@"counter.0" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f4
    v3 = Call v2
    v4 = Call v2
    Return
}

function f1 name="once" results=[{type=anything}] {
    v0 = Absent
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f2
    PutEnvironmentField v1, v2 layout=L0 field=1
    v4 = Integer integer=0
    PutEnvironmentField v1, v4 layout=L0 field=0
    v6 = GetEnvironmentField v1 layout=L0 field=1
    v7 = Call v6
    v8 = NewClosure v1 function=f3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = Call v10, -, v8
    Return
# CHECK-NOT: NewObject
# Every read of counter comes behind a store, so its type has no `absent` and the dead zone is not stored either
# CHECK-NOT: PutModuleVariable v0
# CHECK: [[bump]]: f2 = NewClosure function=f2
# CHECK-NEXT: PutModuleVariable [[bump]] variable=g1
# CHECK-NEXT: [[zero]]: 0 = Integer
# CHECK-NEXT: PutModuleVariable [[zero]] variable=g0
# CHECK-NEXT: [[callee]]: f2 = GetModuleVariable variable=g1
# CHECK-NEXT: = Call [[callee]]
# CHECK-NEXT: = NewClosure function=f3
# CHECK-NOT: EnvironmentField
}

function f2 name="bump" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = CheckInitialized v1 name="counter"
    v3 = Integer integer=1
    v4 = Add v2, v3
    PutEnvironmentField v0, v4 layout=L0 field=0
    Return v4
# CHECK-NOT: captures=
# CHECK: b0():
# CHECK-NEXT: [[counter]]:{{*}}= GetModuleVariable variable=g0
# CHECK-NEXT: = CheckInitialized [[counter]] name="counter"
# CHECK: PutModuleVariable [[sum]] variable=g0
}

function f3 name="published" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=1
    v2 = Call v1
    Return v2
# CHECK-NOT: captures=
# CHECK: b0():
# CHECK-NEXT: = GetModuleVariable variable=g1
}

function f4 name="twice" results=[{type=anything}] {
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure v1 function=f5
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = Call v4, -, v2
    Return
# CHECK: [[scope]]: env L1 = NewObject -, v0 layout=L1 fields=[0]
# CHECK-NEXT: = NewClosure [[scope]] function=f5
}

function f5 name="readsCounter" captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
# CHECK-LABEL: function f5 name="readsCounter"{{*}}captures=[{type=env L1}]
# CHECK: = GetEnvironmentField v0 layout=L1
