# An environment that a call takes as an ordinary argument stays an object. One that calls and closures take only as a capture becomes variables
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: variable g0 name="x"
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="passedAsArgument" fields=[{key=@"x.0" declared={type=anything} variableName="x"}]
layout L1 kind=Environment name="onlyCaptured" fields=[{key=@"x.0" declared={type=anything} variableName="x"}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0] @10
    v3 = CallDirect v2 function=f1
    v4 = NewObject -, v1 layout=L1 fields=[0] @20
    v5 = CallDirect v4 function=f2
    Return
# CHECK: [[passed]]: env L0 = NewObject -, v1 layout=L0
# CHECK-NEXT: = CallDirect [[passed]] function=f1
# CHECK-NEXT: PutModuleVariable v1 variable=g0
# CHECK-NEXT: = CallDirect function=f2
}

function f1 name="takesParameter" parameters=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
# CHECK-LABEL: function f1 name="takesParameter"{{*}}parameters=[{type=env L0}]
# CHECK: = GetEnvironmentField v0 layout=L0

function f2 name="takesCapture" captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g0
}
