# An environment in which evaluated text finds bindings stays an object. The environment beside it, which no eval scope names, becomes variables
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: variable g0 name="y"
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="seenByEval" fields=[{key=@"x.0" declared={type=anything} variableName="x"}]
layout L1 kind=Environment name="notSeenByEval" fields=[{key=@"y.0" declared={type=anything} variableName="y"}]
evalscope e0 bindings=[{name="x" layout=L0 field=0 operand=0}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0] @10
    v3 = NewClosure v2 function=f1
    v4 = NewObject -, v1 layout=L1 fields=[0] @20
    v5 = NewClosure v4 function=f2
    v6 = Undefined
    v7 = DirectEval v1, v6, -, v2 evalScope=e0
    v8 = PropGet v0 key="publish" [isFreeName]
    v9 = Call v8, -, v3, v5
    Return
# CHECK: [[seen]]: env L0 = NewObject -, v1 layout=L0
# CHECK-NEXT: = NewClosure [[seen]] function=f1
# CHECK-NEXT: PutModuleVariable v1 variable=g0
# CHECK-NEXT: = NewClosure function=f2
# CHECK: = DirectEval v1, v6, -, [[seen]] evalScope=e0
}

function f1 name="readsSeen" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
# CHECK-LABEL: function f1 name="readsSeen"{{*}}captures=[{type=env L0}]
# CHECK: = GetEnvironmentField v0 layout=L0

function f2 name="readsOther" captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g0
}
