# A captured value whose type rests on a check: where the check fails, the generic version of the function stores what the check has turned away. The capture is only expected for that,
# and so is the variable that takes its place: declared with the type of the value alone it would get the representation of a number, which the stranger does not fit
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# CHECK: variable g1 module=m0 declared={type=number flags=[IsExpected]}

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="sink" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="given" [isFreeName]
    v2 = Convert v1 declared={type=number}
    v3 = NewClosure v2 function=f1
    PutModuleVariable v3 variable=g0
    v5 = PropGet v0 key="keep" [isFreeName]
    v6 = Call v5, -, v3
    Return
# CHECK: v2: number = Check v1 expectedType=number
# CHECK-NEXT: PutModuleVariable v2 variable=g1
# CHECK-NEXT: = NewClosure function=f1
}
function f1 name="readsCapture" kind=Arrow captures=[{type=number}] results=[{type=anything}] {
    v1 = Add v0, v0
    Return v1
# CHECK: [[read]]: anything ~ number = GetModuleVariable variable=g1
# CHECK-NEXT: [[checked]]: number = Check [[read]] expectedType=number cause=AddedByPass
# CHECK-NEXT: = Add [[checked]], [[checked]]
}
