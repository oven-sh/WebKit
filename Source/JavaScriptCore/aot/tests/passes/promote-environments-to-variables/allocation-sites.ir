# Only an environment that exists once becomes variables: one allocation, outside every loop of a function that runs at most once
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: variable g0 name="total"
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="function" fields=[{key=@"total.0" declared={type=anything} variableName="total"}]
layout L1 kind=Environment name="loopBody" fields=[{key=@"item.0" declared={type=anything} variableName="item"}]
layout L2 kind=Environment name="loopHead" fields=[{key=@"index.0" declared={type=anything} variableName="index"}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Integer integer=0
    v3 = NewObject -, v2 layout=L0 fields=[0] @10
    v4 = NewClosure v3 function=f1
    v5 = Call v1, -, v4
    v6 = NewObject -, v2 layout=L2 fields=[0] @20
    Jump -> next b1(v6)
  b1(v7: env L2):
    LoopHint
    v9 = GetEnvironmentField v7 layout=L2 field=0
    v10 = NewObject -, v9 layout=L1 fields=[0] @30
    v11 = NewClosure v10 function=f2
    v12 = NewClosure v7 function=f3
    v13 = Call v1, -, v11, v12
    v14 = NewObject -, v9 layout=L2 fields=[0] @40
    v15 = ToBoolean v13
    Branch v15 -> taken b1(v14), notTaken b2()
  b2():
    Return
# CHECK: PutModuleVariable v2 variable=g0
# CHECK-NEXT: = NewClosure function=f1
# CHECK: [[first]]: env L2 = NewObject -, v2 layout=L2
# CHECK: b1([[head]]: env L2):
# CHECK: [[body]]: env L1 = NewObject -, {{*}} layout=L1
# CHECK-NEXT: = NewClosure [[body]] function=f2
# CHECK-NEXT: = NewClosure [[head]] function=f3
}

function f1 name="readsTotal" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g0
}

function f2 name="readsItem" captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
# CHECK-LABEL: function f2 name="readsItem"{{*}}captures=[{type=env L1}]

function f3 name="readsIndex" captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    Return v1
}
# CHECK-LABEL: function f3 name="readsIndex"{{*}}captures=[{type=env L2}]
