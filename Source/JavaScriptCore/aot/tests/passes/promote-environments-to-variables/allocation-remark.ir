# The report of allocations says that a promoted environment is removed
# FORM: AsRead
# RUN: allocation-remarks
# OPTIONS: report=Allocations
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: main.js:2: removed
# CHECK-NEXT: main.js:3: heap: Call cause=Escapes
# CHECK-NOT: :

module m0 path="main.js" displayPath="main.js" body=f0 positions={lineStarts=[0, 10, 20, 30]}
entry module=m0
layout L0 kind=Environment name="scope" fields=[{key=@"x.0" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0] @10
    v3 = NewClosure v2 function=f1 @20
    v4 = Call v1, -, v1, v1, v3
    Return
}
function f1 name="reads" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
