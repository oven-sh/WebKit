# Both versions of a function lose the captures, and the generic version's parameters still map to those of the proven one
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: FlowGenericVersions = 1
# STATISTIC: EnvironmentsPromotedToVariables = 1
# STATISTIC: CapturesPromotedToVariables = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="scope" fields=[{key=@"base.0" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = PropGet v0 key="input" [isFreeName]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure v3, v2 function=f1
    v5 = Double number=1.5
    v6 = Call v4, -, v5
    v7 = Call v1, -, v4
    v8 = CallDirect function=f2
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = NewClosure function=f1

function f1 name="versioned" kind=Arrow captures=[{type=env L0}, {type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything, v2: anything):
    v3 = GetEnvironmentField v0 layout=L0 field=0
    v4 = Mul v2, v2
    v5 = Add v4, v2
    v6 = Add v5, v3
    v7 = Add v6, v1
    Return v7
}
# CHECK-LABEL: function f1 name="versioned"
# CHECK-NOT: captures=
# CHECK: b0([[proven]]: fractional):
# CHECK-NEXT: = GetModuleVariable variable=g1
# CHECK-NEXT: = GetModuleVariable variable=g0

function f2 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
