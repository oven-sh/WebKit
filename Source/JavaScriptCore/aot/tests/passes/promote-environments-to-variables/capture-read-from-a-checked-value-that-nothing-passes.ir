# The check lets only undefined through, and an element of undefined is never read: the read has no result there. A function that runs once gets no generic version, its check goes, and
# the read then gives what it finds in the list that arrives. The store of the captured value and what stands behind it stay
# FORM: AsRead
# RUN: pipeline AddGenericVersion

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="given" [isFreeName]
    v2 = Convert v1 declared={type=undefined}
    v3 = Integer integer=1
    v4 = ElemGet v2, v3
    v5 = NewClosure v4 function=f1
    v6 = PropGet v0 key="keep" [isFreeName]
    v7 = Call v6, -, v5
    Return
# CHECK-NOT: Unreachable
# CHECK: [[element]]: anything = ElemGet
# CHECK-NEXT: PutModuleVariable [[element]] variable=g0
# CHECK: Return
}
function f1 name="readsCapture" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
