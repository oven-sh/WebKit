# Closures that copy one value share its variable, which is stored once, where the value is computed. How often a closure is created does not matter, how often the value is computed does
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: CapturesPromotedToVariables = 3
# CHECK: variable g0 module=m0
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="publish" [isFreeName]
    v3 = Call v1
    v4 = NewClosure v3 function=f1
    v5 = NewClosure v3 function=f2
    v6 = Call v2, -, v4, v5
    Jump -> next b1()
  b1():
    LoopHint
    v8 = Call v1
    v9 = NewClosure v3, v8 function=f3
    v10 = Call v2, -, v9
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[shared]]: anything = Call v1
# CHECK-NEXT: PutModuleVariable [[shared]] variable=g0
# CHECK-NEXT: = NewClosure function=f1
# CHECK-NEXT: = NewClosure function=f2
# CHECK-NOT: PutModuleVariable
# CHECK: [[perIteration]]: anything = Call v1
# CHECK-NEXT: = NewClosure [[perIteration]] function=f3
# CHECK-NOT: PutModuleVariable

function f1 name="first" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK-LABEL: function f1 name="first"
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g0

function f2 name="second" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK-LABEL: function f2 name="second"
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g0

function f3 name="createdInLoop" kind=Arrow captures=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    Return v2
}
# CHECK-LABEL: function f3 name="createdInLoop"{{*}}captures=[{type=anything}] thisType
# CHECK: b0([[capture]]: anything):
# CHECK-NEXT: [[variable]]: anything = GetModuleVariable variable=g0
# CHECK-NEXT: = Add [[variable]], [[capture]]
