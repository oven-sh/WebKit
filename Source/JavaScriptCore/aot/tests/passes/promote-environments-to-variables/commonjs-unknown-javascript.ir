# A module of the image runs at most once whatever text the program evaluates at run time, so the body of a CommonJS module gives up its environment like the body of the ES module beside it
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 2
# CHECK: variable g0 name="count.0" module=m0
# CHECK: variable g1 name="count.0" module=m1
# CHECK-NOT: variable g2

module m0 path="main.js" displayPath="main.js" flags=[KeepsError] body=f0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="required.cjs" displayPath="required.cjs" kind=CommonJs flags=[KeepsError] body=f2
entry module=m0
layout L0 kind=Environment name="main" module=m0 fields=[{key=@"count.0" declared={type=anything}}]
layout L1 kind=Environment name="required" module=m1 fields=[{key=@"count.0" declared={type=anything}}]
evalscope e0 bindings=[]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure v3 function=f1
    v5 = PropGet v1 key="publish" [isFreeName]
    v6 = Call v5, -, v4
    v7 = Undefined
    v8 = DirectEval v2, v7 evalScope=e0
    Return
# CHECK-NOT: NewObject
# CHECK: PutModuleVariable v2 variable=g0
# CHECK-NEXT: = NewClosure function=f1
}

function f1 name="readsMain" module=m0 captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f2 name="required" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure v1 function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = Call v4, -, v2
    Return
# CHECK-NOT: NewObject
# CHECK: PutModuleVariable v0 variable=g1
# CHECK-NEXT: = NewClosure function=f3
}

function f3 name="readsRequired" module=m1 captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
# CHECK-NOT: captures=
# CHECK: = GetModuleVariable variable=g1
}
