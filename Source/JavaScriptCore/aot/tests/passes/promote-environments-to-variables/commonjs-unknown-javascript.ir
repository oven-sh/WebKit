# Code that an option lets in can remove any cache entry, so the body of a CommonJS module may run again and keeps its environment. The body of the ES module beside it runs once whatever that code does
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass admit=RuntimeCode
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: variable g0 name="count.0" module=m0
# CHECK-NOT: variable g1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="required.cjs" displayPath="required.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f2
entry module=m0
layout L0 kind=Environment name="main" module=m0 fields=[{key=@"count.0" declared={type=anything}}]
layout L1 kind=Environment name="required" module=m1 fields=[{key=@"count.0" declared={type=anything}}]
evalscope e0 bindings=[]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName]
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure v3 function=f1
    v5 = PropGet v1 key="publish" [isFreeName]
    v6 = Call v5, -, v4
    v7 = Undefined
    v8 = DirectEval v2, v7 evalScope=e0
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: NewObject
# CHECK: PutModuleVariable v2 variable=g0
# CHECK-NEXT: = NewClosure function=f1

function f1 name="readsMain" module=m0 captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f2 name="required" module=m1 kind=CommonJsModule flags=[HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = Integer integer=0
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = NewClosure v7 function=f3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = Call v10, -, v8
    Return
}
# CHECK-LABEL: function f2 name="required"
# CHECK: [[scope]]: env L1 = NewObject -, v6 layout=L1 fields=[0]
# CHECK-NEXT: = NewClosure [[scope]] function=f3

function f3 name="readsRequired" module=m1 captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
# CHECK-LABEL: function f3 name="readsRequired"{{*}}captures=[{type=env L1}]
