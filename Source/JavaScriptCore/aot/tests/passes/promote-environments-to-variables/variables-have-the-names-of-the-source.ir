# A variable that takes the place of a field of an environment, or of what closures copy, has the name that the source gives the variable, not the key of the field, and none where the source gives none
# FORM: AsRead
# RUN: pipeline PromoteEnvironmentsToVariables
# OPTIONS: only-passes=PromoteEnvironmentsToVariables check=VerifyEachPass
# STATISTIC: EnvironmentsPromotedToVariables = 1
# CHECK: variable g0 name="count" module=m0
# CHECK: variable g1 module=m0
# CHECK: variable g2 name="limit" module=m0
# CHECK-NOT: variable g3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="main" module=m0 fields=[{key=@"binding.0" declared={type=anything} variableName="count"}, {key=@"newTarget.1" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = NewObject -, v2, v2 layout=L0 fields=[0, 1]
    v4 = NewClosure v3, v2 function=f1
    v5 = PropGet v0 key="publish" [isFreeName]
    v6 = Call v5, -, v4
    Return
}

function f1 name="reads" kind=Arrow captures=[{type=env L0}, {type=anything variableName="limit"}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = Add v2, v3
    v5 = Add v4, v1
    Return v5
}
