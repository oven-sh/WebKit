# A caller that is too large to inline into calls the generic version of its callee, which reads the method by name: the field stays
# OPTIONS: limit=MaxInlinedCallerBytes:0 disable=flow:CalleeSets
# RUN: pipeline RemoveUnreadFields
# LOSS: MaxInlinedCallerBytes
# STATISTIC: FlowGenericVersions = 1
# STATISTIC: UnreadFieldsRemoved = 1
# CHECK: layout L0 name="EntersGenericVersion" fields=[{key="m"{{*}}reads=OnlyCalled
# CHECK: layout L1 name="EntersOneVersion" fields=[{key="m"{{*}}stores=Never{{*}}reads=NeverRead
# CHECK-LABEL: function f0 name="main"
# CHECK: [[method]]: f3 = NewClosure function=f3
# CHECK: = NewObject -, [[method]] layout=L0 fields=[0]
# CHECK: = NewObject layout=L1
# CHECK-LABEL: name="calledWithUnknownToo" {{*}}role=GenericVersion
# CHECK: key="m" {{*}}receivers=[L0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="EntersGenericVersion" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
layout L1 name="EntersOneVersion" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f3
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="outside"
    v6 = Call v2, -, v5
    v7 = NewClosure function=f3
    v8 = NewObject -, v7 layout=L1 fields=[0]
    v9 = NewClosure function=f2
    v10 = Call v9, -, v8
    v11 = PropGet v4 key="print" [isFreeName]
    v12 = Call v11, -, v3, v6, v10
    v13 = CallDirect function=f4
    Return
}
function f1 name="calledWithUnknownToo" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
function f2 name="calledWithKnownOnly" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
function f3 name="m" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="count" [isFreeName]
    Return v1
}
function f4 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    v40 = Undefined
    v41 = Undefined
    v42 = Undefined
    v43 = Undefined
    v44 = Undefined
    v45 = Undefined
    v46 = Undefined
    v47 = Undefined
    v48 = Undefined
    v49 = Undefined
    v50 = Undefined
    v51 = Undefined
    v52 = Undefined
    v53 = Undefined
    v54 = Undefined
    v55 = Undefined
    v56 = Undefined
    v57 = Undefined
    v58 = Undefined
    v59 = Undefined
    Return
}
