# An inline frame holds a copy of the body, so it names the reduced function: stack traces hide the forwarder that stays under the old id
# FORM: Prepared
# RUN: pass RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="ignoresSecond" position=10 parameters=[{type=number}, {type=anything}] results=[{type=number}] {
    v2 = Add v0, v0 @20
    Return v2 @20
# CHECK: IsHiddenInStackTraces
# CHECK: = CallDirect v0 function=f4
}

function f1 name="usesBoth" position=30 parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = Add v0, v1 @40
    Return v2 @40
}

function f2 name="callsAndHoldsCopies" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f0 callPosition=50 module=m0}, {callee=f1 callPosition=60 module=m0}, {callee=f0 callPosition=45 parent=2 isTailCall=true module=m0}] {
    v1 = Add v0, v0 @20:1
    v2 = Add v1, v0 @40:2
    v3 = Add v2, v2 @20:3
    v4 = CallDirect v3, v0 function=f0 @70
    Return v4 @70
# CHECK: inlineFrames=[{}, {callee=f4 callPosition=50 module=m0}, {callee=f1 callPosition=60 module=m0}, {callee=f4 callPosition=45 parent=2 isTailCall=true module=m0}] {
# CHECK: = CallDirect {{*}}function=f4 @70
}

function f3 name="holdsCopyAndCallsNothing" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f0 callPosition=80 module=m0}] {
    v1 = Add v0, v0 @20:1
    Return v1 @90
# CHECK: inlineFrames=[{}, {callee=f4 callPosition=80 module=m0}] {
}

# CHECK-LABEL: function f4 name="ignoresSecond"
# CHECK: derivation={source=f0 parameterMap=[{original=0}]}
# CHECK-NOT: IsHiddenInStackTraces
# CHECK: = Add v0, v0 @20
