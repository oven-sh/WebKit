# The closure in a field of an environment is made as before where the field is stored again with another value, where the place that stores it lies in a loop that keeps the environment, and where the environment comes from outside the function: what the closure captures may differ from one store to the next.
# FORM: Prepared
# RUN: pass ReadCapturesFromEnvironments RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 0

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="storedAgain" fields=[{key="inner" declared={type=f1}}]
layout L1 kind=Environment name="filledInALoop" fields=[{key="inner" declared={type=f3}}]
layout L2 kind=Environment name="filledFromOutside" fields=[{key="inner" declared={type=f5}}]
# CHECK: layout L0 kind=Environment name="storedAgain" fields=[{key="inner" declared={type=f1}}]
# CHECK: layout L1 kind=Environment name="filledInALoop" fields=[{key="inner" declared={type=f3}}]
# CHECK: layout L2 kind=Environment name="filledFromOutside" fields=[{key="inner" declared={type=f5}}]

function f0 name="storedAgain" parameters=[{type=f1}] results=[{type=anything}] {
  b0(v0: f1):
    v1 = NewObject layout=L0
    v2 = NewClosure v1 function=f1
    PutEnvironmentField v1, v2 layout=L0 field=0
    PutEnvironmentField v1, v0 layout=L0 field=0
    v5 = GetEnvironmentField v1 layout=L0 field=0
    v6 = GetCapture v5 function=f1
    v7 = CallDirect v6 function=f1
    Return v7
}
# CHECK-LABEL: function f0 name="storedAgain"
# CHECK: = NewClosure {{*}} function=f1
# CHECK: = GetCapture

function f1 name="inner" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    Return
}

function f2 name="filledInALoop" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject layout=L1
    Jump -> next b1(v0)
  b1(v2: number):
    LoopHint
    v4 = NewClosure v1, v2 function=f3
    PutEnvironmentField v1, v4 layout=L1 field=0
    v6 = CallDirect v1, v2 function=f3
    v7 = Add v2, v2
    v8 = Integer integer=100
    v9 = Less v7, v8
    Branch v9 -> taken b1(v7), notTaken b2()
  b2():
    Return v6
}
# CHECK-LABEL: function f2 name="filledInALoop"
# CHECK: = NewClosure {{*}} function=f3

function f3 name="inner" captures=[{type=env L1}, {type=number}] results=[{type=anything}] {
  b0(v0: env L1, v1: number):
    v2 = GetEnvironmentField v0 layout=L1 field=0
    v3 = GetCapture v2 function=f3 index=1
    v4 = Add v1, v3
    Return v4
}
# CHECK-LABEL: function f3 name="inner"
# CHECK: = GetCapture

function f4 name="filledFromOutside" captures=[{type=env L2}] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: env L2, v1: number):
    v2 = NewClosure v0, v1 function=f5
    PutEnvironmentField v0, v2 layout=L2 field=0
    v4 = CallDirect v0, v1 function=f5
    Return v4
}
# CHECK-LABEL: function f4 name="filledFromOutside"
# CHECK: = NewClosure {{*}} function=f5

function f5 name="inner" captures=[{type=env L2}, {type=number}] results=[{type=anything}] {
  b0(v0: env L2, v1: number):
    v2 = GetEnvironmentField v0 layout=L2 field=0
    v3 = GetCapture v2 function=f5 index=1
    v4 = Add v1, v3
    Return v4
}
# CHECK-LABEL: function f5 name="inner"
# CHECK: = GetCapture

function f6 name="makesTheEnvironment" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject layout=L2
    v2 = CallDirect v1, v0 function=f4
    v3 = Add v0, v0
    v4 = CallDirect v1, v3 function=f4
    Return v4
}
