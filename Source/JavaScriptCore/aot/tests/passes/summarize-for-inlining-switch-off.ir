# With the switch of the analysis off every function keeps the unknown summary, and nothing is inlined
# OPTIONS: disable=pass:SummarizeForInlining heat=OnlyLoopsAreHot
# RUN: pipeline SummarizeForInlining
# RUN(PASS): pass SummarizeForInlining
# RUN(INLINE): pipeline InlineCalls
# STATISTIC: InlineDecisionInline = 0
# STATISTIC: InlineDecisionInlineHead = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
# CHECK: f0: barrier=Unknown bytes=0
# PASS: f0: barrier=Unknown bytes=0

function f1 name="callsSmallFunctions" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f2
    v2 = CallDirect v1 function=f3
    Return v2
}
# CHECK-NEXT: f1: barrier=Unknown bytes=0
# PASS-NEXT: f1: barrier=Unknown bytes=0

function f2 name="returnsParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK-NEXT: f2: barrier=Unknown bytes=0
# PASS-NEXT: f2: barrier=Unknown bytes=0

function f3 name="fails" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Throw v0
}
# CHECK-NEXT: f3: barrier=Unknown bytes=0
# CHECK-NOT: barrier=None
# CHECK-NOT: barrier=NotInlinable
# CHECK-NOT: head=
# CHECK-NOT: noReturn
# PASS-NEXT: f3: barrier=Unknown bytes=0
# PASS-NEXT: outcome: Unchanged

# INLINE-LABEL: function f1 name="callsSmallFunctions"
# INLINE: = CallDirect v0 function=f2
