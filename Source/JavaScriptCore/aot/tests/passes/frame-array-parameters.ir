# Which entry parameters may be handed an array that lies in a frame of the caller: those that are only read where the array lies. A path that such an array never takes does not count
# FORM: Prepared
# RUN: frame-array-parameters

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="callers" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray v0 contents=anything
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1, v0 function=f3
    v5 = CallDirect v1 function=f4
    v6 = CallDirect v1, v3 function=f5
    v7 = CallDirect v1, v0 function=f6
    v8 = CallDirect v1, v0 function=f7
    v9 = CallDirect v1 function=f8
    v10 = CallDirect v1 function=f9
    v11 = CallDirect v1 function=f10
    v12 = CallDirect v1 function=f11
    v13 = CallDirect v1, v0 function=f12
    v14 = CallDirect v1, v0 function=f13
    v15 = CallDirect v1, v0 function=f14
    v16 = CallDirect v1, v0 function=f15
    v17 = CallDirect v1 function=f16
    v18 = CallDirect v1 function=f17
    v19 = CallDirect v1 function=f18
    v20 = CallDirect v1, v1, v0 function=f19
    v21 = CallDirect v1, v0 function=f20
    v22 = CallDirect v1, v0 function=f21
    v23 = CallDirect v1, v0 function=f22
    v24 = CallDirect v1 function=f23
    v25 = CallDirect v1, v0 function=f24
    v26 = CallDirect v1 function=f25
    v27 = Integer integer=1
    v28 = CallDirect v27, v1 function=f26
    v29 = CallDirect v1, v0 function=f28
    v30 = CallDirect v1, v0 function=f29
    Return v0
}
# CHECK: f0: []

function f1 name="readsLengthAndElement" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: guard):
    v4 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: guard):
    v6 = AllGuards v3, v5
    v7 = GetArrayLength v0, v6
    v8 = GetArrayElement v0, v1, v6 arrayStorage=Contiguous level=Expected [keyIsIntegral]
    v9 = IsInBounds v0, v7
    Return v8
  b3():
    Return v1
}
# CHECK-NEXT: f1: [0]

function f2 name="lengthByBuiltin" parameters=[{type=Array}] results=[{type=number}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f2: [0]

function f3 name="handedToUnknownCode" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = Call v1, -, v0
    Return v2
}
# CHECK-NEXT: f3: []

function f4 name="unknownCodeBehindFailedPristineTest" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = Integer integer=0
    v2 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    v4 = GetArrayElement v0, v1, v3 level=Expected [keyIsIntegral]
    Return v4
  b2():
    v5 = PropGet v0 key="first"
    PutModuleVariable v0 variable=g0
    Return v5
}
# CHECK-NEXT: f4: [0]

function f5 name="elementByNumber" parameters=[{type=Array}, {type=number}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-NEXT: f5: [0]

function f6 name="elementByAnyKey" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-NEXT: f6: []

function f7 name="stores" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=0
    ElemSet v0, v2, v1
    Return v1
}
# CHECK-NEXT: f7: []

function f8 name="keeps" parameters=[{type=Array}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-NEXT: f8: []

function f9 name="returns" parameters=[{type=Array}] results=[{type=anything}] {
    Return v0
}
# CHECK-NEXT: f9: []

function f10 name="throws" parameters=[{type=Array}] results=[{type=anything}] {
    Throw v0
}
# CHECK-NEXT: f10: []

function f11 name="handsOnToReader" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = Upcast v0 castType=anything
    v2 = AssumeType v1 provenType=Array
    v3 = CallDirect v2 function=f1
    Return v3
}
# CHECK-NEXT: f11: [0]

function f12 name="handsOnToUnknownCode" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = CallDirect v0, v1 function=f3
    Return v2
}
# CHECK-NEXT: f12: []

function f13 name="handsOnToItself" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Null
    v4 = CallDirect v0, v3 function=f13
    Return v4
  b2():
    v5 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v5
}
# CHECK-NEXT: f13: [0]

function f14 name="isTheListOfACall" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = CallList v1, -, v0
    Return v2
}
# CHECK-NEXT: f14: [0]

function f15 name="isThisOfACall" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = NewArray contents=anything
    v3 = CallList v1, v0, v2
    Return v3
}
# CHECK-NEXT: f15: []

function f16 name="isAppendedToAnother" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = NewArray contents=anything
    v2 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    AppendElements v1, v0, v3
    Return v1
  b2():
    PutModuleVariable v0 variable=g0
    Return v1
}
# CHECK-NEXT: f16: [0]

function f17 name="isAppendedTo" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = NewArray contents=anything
    v2 = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    AppendElements v0, v1, v3
    Return
  b2():
    Return
}
# CHECK-NEXT: f17: []

function f18 name="isCaptured" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = NewClosure v0 function=f27
    v2 = Call v1, -
    Return v2
}
# CHECK-NEXT: f18: []

# The test says nothing about the other parameter.
function f19 name="anotherValueIsTested" parameters=[{type=Array}, {type=Array}, {type=anything}] results=[{type=anything}] {
    v3 = IsPristine v0 builtinClass=Array aspects=[Storage]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: guard):
    Return v2
  b2():
    v5 = Call v2, -, v0
    v6 = Call v2, -, v1
    Return v6
}
# CHECK-NEXT: f19: [0]

function f20 name="storageOfIntegersIsNeverFound" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = HasArrayStorage v0 arrayStorage=Int32
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    v4 = Call v1, -, v0
    Return v4
  b2():
    v5 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v5 -> taken b3(| 0), notTaken b4()
  b3(v6: guard):
    Return v1
  b4():
    v7 = Call v1, -, v0
    Return v7
}
# CHECK-NEXT: f20: [0]

function f21 name="typeTests" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=undefined|null
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3: undefined|null):
    v4 = Call v1, -, v0
    Return v4
  b2(v5: boolean|number|string|symbol|bigint|object):
    v6 = TypeTest v5 testedType=Array
    Branch v6 -> taken b3(| 0), notTaken b4(| 0)
  b3(v7: Array):
    v8 = CallBuiltin v7 overload=ArrayPrototypeLength/0
    Return v8
  b4(v9: boolean|number|string|symbol|bigint|object):
    v10 = Call v1, -, v9
    Return v10
}
# CHECK-NEXT: f21: [0]

# What is tested may be another array than the parameter.
function f22 name="mergedValueIsTested" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    v3 = GetModuleVariable variable=g0
    v4 = AssumeType v3 provenType=Array
    Jump -> next b3(v4)
  b3(v5: Array):
    v6 = IsPristine v5 builtinClass=Array aspects=[Storage]
    Branch v6 -> taken b4(| 0), notTaken b5()
  b4(v7: guard):
    Return v1
  b5():
    v8 = Call v1, -, v0
    Return v8
}
# CHECK-NEXT: f22: []

function f23 name="isAsync" flags=[IsAsync] parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f23: []

function f24 name="isCompared" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = StrictEq v0, v1
    Return v2
}
# CHECK-NEXT: f24: [0]

function f25 name="otherBuiltin" parameters=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeSlice/0
    Return v1
}
# CHECK-NEXT: f25: []

function f26 name="becomesArgumentsObject" flags=[HasArgumentCount, HasHiddenRest] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: Array):
    v2 = CreateUnmappedArguments v0, v1
    Return v2
}
# CHECK-NEXT: f26: [1]

function f27 name="closure" kind=Arrow captures=[{type=Array}] results=[{type=anything}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}
# CHECK-NEXT: f27: []

# f.apply(thisValue, list) copies the elements to where arguments go, like a call with a list.
function f28 name="isTheListOfApply" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin v1, v1, v0 overload=FunctionPrototypeApply/0
    Return v2
}
# CHECK-NEXT: f28: [0]

function f29 name="isThisOfApply" parameters=[{type=Array}, {type=anything}] results=[{type=anything}] {
    v2 = CallBuiltin v1, v0, v1 overload=FunctionPrototypeApply/0
    Return v2
}
# CHECK-NEXT: f29: []
