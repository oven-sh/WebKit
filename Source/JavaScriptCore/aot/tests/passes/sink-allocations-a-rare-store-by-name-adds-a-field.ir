# The rare arm of a store puts a value that the slot may not admit under the key of a field that the object does not have yet. An object that is never built holds it, and a read by name finds it or nothing
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="error" declared={type=string flags=[OmitsNull]} flags=[IsEnforced] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="ok" declared={type=boolean} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation isUnchangedDuringActivation=true} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="value" declared={type=int[-2147483643, 2147483647]} flags=[IsEnforced] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined]}}] declaredOrder=[1, 0, 2] ownFieldCount=3 flow={baseState=None allocationClasses=[0] constructorOrders=[{fields=[1]}] impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype] keys=NeverEnumerated addedKeysAreComplete=true}

function f0 name="neverBuilt" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
    v2 = NewObject -, v1 layout=L0 fields=[1]
    v3 = FinishObject v2
    Branch v1 -> taken b1(), notTaken b4()
  b1():
    v4 = TypeTest v0 testedType=int[-2147483643, 2147483647]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: int[-2147483643, 2147483647]):
    PutSlot v3, v2, v5 key="value" receivers=[L0] level=Expected
    Jump -> next b5()
  b3() frequency=Rare:
    PropSet v3, v0 key="value" mode=Strict receivers=[L0]
    Jump -> next b5()
  b4():
    v8 = String string="odd"
    PutSlot v3, -, v8 key="error" receivers=[L0] level=Proven
    Jump -> next b5()
  b5():
    v10 = IsSlotFilled v3 key="value" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v10 -> taken b6(| 0), notTaken b7()
  b6(v11: guard):
    v12 = GetSlot v3, v11 key="value" receivers=[L0] level=Expected [holdsDeclaredType]
    Return v12
  b7() frequency=Rare:
    v13 = PropGet v3 key="value" receivers=[L0]
    Return v13
# CHECK-NOT: NewObject
# CHECK-NOT: PropSet
# CHECK-NOT: PutSlot
# CHECK-NOT: IsSlotFilled
# CHECK-NOT: PropGet
# CHECK: Return
}

function f1 name="builtWhereItLeaves" parameters=[{type=number}, {type=boolean}, {type=anything}, {type=L0}] results=[{type=anything}] {
    v4 = IsSlotFilled v3 key="value" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v4 -> taken b4(), notTaken b1()
  b1() frequency=Rare:
    v5 = NewObject -, v1 layout=L0 fields=[1]
    v6 = FinishObject v5
    PropSet v6, v0 key="value" mode=Strict receivers=[L0]
    Branch v1 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v8 = Call v2, -, v6
    Return v8
  b3() frequency=Rare:
    Return v0
  b4():
    Return v0
# CHECK: b1() frequency=Rare:
# CHECK-NOT: NewObject
# CHECK: b2() frequency=Rare:
# CHECK: [[object1]]: L0 = NewObject
# CHECK: PropSet {{*}}v0 key="value"
# CHECK: = Call v2, -,
}
