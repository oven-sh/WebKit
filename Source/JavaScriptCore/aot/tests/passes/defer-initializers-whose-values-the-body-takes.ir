# What a body takes of a value that it stores keeps the operations that make the value in the body: the return of a block without operations, an argument of a handler, the subject of a cleanup block, a handler of the block that returns. A value that only the store takes is made at the first read.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 1
# CHECK: variable g0 name="returned" module=m0 declared={type=L0}
# CHECK-NEXT: variable g1 name="handedToHandler" module=m0 declared={type=L0}
# CHECK-NEXT: variable g2 name="handedToHandlerLater" module=m0 declared={type=L0}
# CHECK-NEXT: variable g3 name="cleanedUp" module=m0 declared={type=L0}
# CHECK-NEXT: variable g4 name="takenWhereTheLastBlockThrows" module=m0 declared={type=L0}
# CHECK-NEXT: variable g5 name="onlyStored" module=m0 declared={type=absent|L0}
# CHECK-LABEL: function f1 name="returnsItBehindATry"
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g0
# CHECK: Return [[made]]
# CHECK-LABEL: function f2 name="handsItToAHandler"
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g1
# CHECK: handler=b3([[made]]):
# CHECK-LABEL: function f3 name="handsItToAHandlerLater"
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g2
# CHECK: handler=b3([[made]]):
# CHECK-LABEL: function f4 name="cleansItUp"
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g3
# CHECK: role=DisposalCleanup subject=[[made]]:
# CHECK-LABEL: function f5 name="takesItWhereTheLastBlockThrows"
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g4
# CHECK: role=CatchHandler:
# CHECK: = Call {{*}}, -, [[made]]
# CHECK-LABEL: function f6 name="onlyStoresIt"
# CHECK-NOT: callees=[f8]
# CHECK: Return
# CHECK: function {{*}} name="" {{*}}role=OutlinedBody
# CHECK: [[made]]: L0 = Call {{*}} callees=[f8]
# CHECK: PutModuleVariable [[made]] variable=g5

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="a" declared={type=number} flags=[IsRequired]}]
variable g0 name="returned" module=m0 declared={type=L0}
variable g1 name="handedToHandler" module=m0 declared={type=L0}
variable g2 name="handedToHandlerLater" module=m0 declared={type=L0}
variable g3 name="cleanedUp" module=m0 declared={type=L0}
variable g4 name="takenWhereTheLastBlockThrows" module=m0 declared={type=L0}
variable g5 name="onlyStored" module=m0 declared={type=L0}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Call v0, -
    v2 = NewClosure function=f2
    v3 = Call v2, -
    v4 = NewClosure function=f3
    v5 = Call v4, -
    v6 = NewClosure function=f4
    v7 = Call v6, -
    v8 = NewClosure function=f5
    v9 = Call v8, -
    v10 = NewClosure function=f6
    v11 = Call v10, -
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="publish" [isFreeName]
    v14 = NewClosure function=f7
    v15 = Call v13, -, v14, v1
    Return
}
function f1 name="returnsItBehindATry" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g0
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b2():
    v6 = Call v5, -
    Jump -> next b3()
  b2() role=CatchHandler:
    Jump -> next b3()
  b3():
    Return v2
}
function f2 name="handsItToAHandler" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b3(v2):
    v6 = Call v5, -
    Jump -> next b2()
  b2() handler=b3(v5):
    v7 = Call v5, -
    Jump -> next b4(v7)
  b3(v8) role=CatchHandler:
    Jump -> next b4(v8)
  b4(v9):
    v10 = Call v5, -, v9
    Return
}
function f3 name="handsItToAHandlerLater" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b3(v5):
    v6 = Call v5, -
    Jump -> next b2()
  b2() handler=b3(v2):
    v7 = Call v5, -
    Jump -> next b4(v7)
  b3(v8) role=CatchHandler:
    Jump -> next b4(v8)
  b4(v9):
    v10 = Call v5, -, v9
    Return
}
function f4 name="cleansItUp" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g3
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b2():
    v6 = Call v5, -
    Jump -> next b3()
  b2() role=DisposalCleanup subject=v2:
    v7 = CatchValue
    v8 = Call v5, -, v7
    Throw v7
  b3():
    v9 = Call v5, -
    Return
}
function f5 name="takesItWhereTheLastBlockThrows" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g4
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b2():
    v6 = Call v5, -
    Return
  b2() role=CatchHandler:
    v7 = CatchValue
    v8 = Call v5, -, v2
    Throw v7
}
function f6 name="onlyStoresIt" module=m0 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f8
    v2 = Call v1, -, v0
    PutModuleVariable v2 variable=g5
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    Jump -> next b1()
  b1() handler=b2():
    v6 = Call v5, -
    Jump -> next b3()
  b2() role=CatchHandler:
    Jump -> next b3()
  b3():
    Return
}
function f7 name="reader" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    v3 = GetModuleVariable variable=g2
    v4 = GetModuleVariable variable=g3
    v5 = GetModuleVariable variable=g4
    v6 = GetModuleVariable variable=g5
    v7 = Call v0, -, v1, v2, v3, v4, v5, v6
    Return v7
}
function f8 name="onlyMakes" module=m0 parameters=[{type=number}] results=[{type=L0}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
