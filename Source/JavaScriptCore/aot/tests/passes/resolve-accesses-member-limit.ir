# MaxAccessPlanMembers does not bound the PROVEN members of an access. Over the limit (2):
# v0: all three members hold `x` at one place: read and store are as proven as within the limit;
# v1: one member lacks `x`: the ordinary split. Alone, this pass leaves the access by name; behind SplitUnions (SPLIT) a test for the two members that hold it leads to proven slot
# accesses; for the member that lacks it the read is `undefined` with no operation at all, and the store stays by name in an unlikely block. It used to be "no plan": by name for all three.
# v2: within the limit: as ever. Nothing is lost, so no limit is reported.
# FORM: Prepared
# OPTIONS: limit=MaxAccessPlanMembers:2
# RUN: pass ResolveAccesses
# RUN(SPLIT): pass SplitUnions ResolveAccesses
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="First" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Second" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Third" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="Fourth" fields=[{key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
function f0 name="reads-and-stores" parameters=[{type=L0|L1|L2}, {type=L0|L1|L3}, {type=L0|L1}, {type=number}] results=[{type=anything}] {
  b0(v0: L0|L1|L2, v1: L0|L1|L3, v2: L0|L1, v3: number):
    v4 = PropGet v0 key="x"
    v5 = PropGet v1 key="x"
    v6 = PropGet v2 key="x"
    PropSet v0, v3 key="x"
    PropSet v1, v3 key="x"
    PropSet v2, v3 key="x"
    Return v4
}
# CHECK-LABEL: function f0 name="reads-and-stores"
# CHECK-NEXT: b0(
# CHECK-NEXT: v4: number = GetSlot v0 key="x" receivers=[L0, L1, L2] level=Proven
# CHECK-NEXT: = PropGet v1 key="x"
# CHECK-NEXT: v6: number = GetSlot v2 key="x" receivers=[L0, L1] level=Proven
# CHECK-NEXT: PutSlot v0, -, v3 key="x" receivers=[L0, L1, L2] level=Proven
# CHECK-NEXT: PropSet v1, v3 key="x"
# CHECK-NEXT: PutSlot v2, -, v3 key="x" receivers=[L0, L1] level=Proven
# CHECK-NEXT: Return v4
# SPLIT-LABEL: function f0 name="reads-and-stores"
# SPLIT: = GetSlot v0 key="x" receivers=[L0, L1, L2] level=Proven
# SPLIT-NEXT: = TypeTest v1 testedType=L0|L1
# SPLIT: ([[holds]]: L0|L1):
# SPLIT-NEXT: PutSlot [[holds]], -, v3 key="x" receivers=[L0, L1] level=Proven
# SPLIT: ([[lacks]]: L3) frequency=Unlikely:
# SPLIT-NEXT: PropSet [[lacks]], v3 key="x" receivers=[L3]
# SPLIT: ([[read]]: L0|L1):
# SPLIT-NEXT: = GetSlot [[read]] key="x" receivers=[L0, L1] level=Proven
# SPLIT: (v{{*}}: L3):
# SPLIT-NEXT: : undefined = Undefined
# SPLIT-NOT: PropGet
