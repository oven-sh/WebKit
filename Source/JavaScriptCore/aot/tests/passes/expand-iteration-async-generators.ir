function f3 name="closesByTheProtocol" flags=[IsAsync] parameters=[{type=AsyncGenerator<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: AsyncGenerator<anything, pristine[Storage, Names]>, v1: anything):
    v2 = IteratorOpen v0 iteratorKind=Async
    v3 = IteratorResume v2 iteratorKind=Async
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b1()
  b1():
    IteratorClose v2 iteratorKind=Async
    Return v5
