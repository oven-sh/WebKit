# An async iteration over an async generator steps it with StepAsyncGenerator: no lookup of next, no promise, no result object, and no await behind the step, which suspends the function by itself where it has to wait.
# Where the engine did not make the iterator result itself, the step hands it over and it is read by the protocol. Everything else is the protocol
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(STEPS): pass ExpandIteration
# RUN(THROWS): pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 7
# STATISTIC: IterationsExpandedGenerically = 2
# ABSENT-NOT: IteratorOpen
# ABSENT-NOT: IteratorResume
# ABSENT-NOT: IteratorClose

module m0 path="main.js" displayPath="main.js"

function f0 name="provenUnmodified" flags=[IsAsync] parameters=[{type=AsyncGenerator<anything, pristine[Storage, Names]>}, {type=anything}] results=[{type=anything}] {
  b0(v0: AsyncGenerator<anything, pristine[Storage, Names]>, v1: anything):
    v2 = IteratorOpen v0 iteratorKind=Async
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2 iteratorKind=Async
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = PropGet v6 key="x"
    Jump -> next b1()
  b3():
    Return v1
}
# CHECK-LABEL: function f0 name="provenUnmodified"
# CHECK-NOT: TypeTest
# CHECK-NOT: IsUnmodifiedAsyncGenerator
# CHECK-NOT: @@asyncIterator
# CHECK-NOT: key="next"
# CHECK: LoopHint
# CHECK-NEXT: [[nothing0]]: undefined = Undefined
# The split puts the driver of the body in the place of the third operand.
# CHECK: [[step0]]{{*}} = StepAsyncGenerator v0, [[nothing0]], [[noDriver0]]
# CHECK-NEXT: [[value0]]: anything = ResultAt [[step0]]
# CHECK-NEXT: [[status0]]: int[0, 2] = ResultAt [[step0]] index=1
# CHECK-NEXT: [[result0]]: 0 = Integer
# CHECK-NEXT: [[isResult0]]: boolean = StrictEq [[status0]], [[result0]]
# CHECK-NEXT: Branch [[isResult0]] -> taken [[reads0]](), notTaken [[ended0]]()
# CHECK: [[rest0]](v5: boolean, v6: anything):
# CHECK: Branch v5 -> taken b3(), notTaken b2()
# CHECK: [[reads0]]() frequency=Rare:
# CHECK-NEXT: [[object0]]: object = RequireObject [[value0]] runtimeError=IteratorResultNotObject
# CHECK-NEXT: = PropGet [[object0]] key="done"
# CHECK: [[ended0]]():
# CHECK-NEXT: [[completed0]]: 2 = Integer integer=2
# CHECK-NEXT: [[done0]]: boolean = StrictEq [[status0]], [[completed0]]
# CHECK-NEXT: Branch [[done0]] -> taken [[atEnd0]](), notTaken [[yielded0]]()
# CHECK: [[yielded0]]():
# CHECK-NEXT: [[false0]]: false = Boolean
# CHECK-NEXT: Jump -> next [[rest0]]([[false0]], [[value0]])
# STEPS-LABEL: function f0 name="provenUnmodified"
# STEPS-NOT: Await

