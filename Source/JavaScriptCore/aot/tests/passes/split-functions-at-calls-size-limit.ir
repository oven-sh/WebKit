# Continuations that together exceed the size limit give way to one cut at the common dominator
# FORM: Selected
# OPTIONS: limit=MaxContinuationSizePercent:100
# RUN: pass SplitFunctionsAtCalls
# LOSS: MaxContinuationSizePercent x1 f0
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="copiedTailExceedsLimit" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Call v1, -, v0
    Jump -> next b5(v4)
  b4():
    v5 = Call v1
    Jump -> next b5(v5)
  b5(v6):
    v7 = TypeTest v6 testedType=number
    v8 = TypeTest v6 testedType=string
    v9 = TypeTest v6 testedType=boolean
    v10 = TypeTest v6 testedType=symbol
    v11 = TypeTest v6 testedType=bigint
    Return v6
}
# CHECK-LABEL: function f0 name="copiedTailExceedsLimit"
# CHECK-NOT: testedType=string
# CHECK: [[rest0]]: anything = CallDirect v0, v1 function=f2
# CHECK-NEXT: ReturnCall [[rest0]]
# CHECK-NOT: CallDirect

function f1 name="copiedTailReachesLimit" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Call v1, -, v0
    Jump -> next b5(v4)
  b4():
    v5 = Call v1
    Jump -> next b5(v5)
  b5(v6):
    v7 = TypeTest v6 testedType=number
    v8 = TypeTest v6 testedType=string
    v9 = TypeTest v6 testedType=boolean
    v10 = TypeTest v6 testedType=symbol
    Return v6
}
# CHECK-LABEL: function f1 name="copiedTailReachesLimit"
# CHECK: TypeTest v0 testedType=string
# CHECK: [[rest1]]: anything = CallDirect {{*}}function=f3
# CHECK-NEXT: ReturnCall [[rest1]]
# CHECK: [[rest2]]: anything = CallDirect {{*}}function=f4
# CHECK-NEXT: ReturnCall [[rest2]]

# CHECK-LABEL: function f2 name="copiedTailExceedsLimit" module=m0 role=Continuation{{*}}derivation={source=f0{{*}}} creator=Continuation{origin=f0}
# CHECK: testedType=string
# CHECK-COUNT-2: = Call
# CHECK-COUNT-1: testedType=bigint
# CHECK-NOT: testedType=bigint
# CHECK-LABEL: function f3 name="copiedTailReachesLimit" module=m0 role=Continuation{{*}}derivation={source=f1{{*}}} creator=Continuation{origin=f1}
# CHECK-COUNT-1: = Call
# CHECK-NOT: = Call
# CHECK: testedType=symbol
# CHECK-LABEL: function f4 name="copiedTailReachesLimit" module=m0 role=Continuation{{*}}derivation={source=f1{{*}}} creator=Continuation{origin=f1 index=1}
# CHECK-COUNT-1: = Call
# CHECK-NOT: = Call
# CHECK: testedType=symbol
# CHECK-NOT: function f5
