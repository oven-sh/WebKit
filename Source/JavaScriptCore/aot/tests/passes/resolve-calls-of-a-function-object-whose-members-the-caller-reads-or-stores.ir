# The frames of some functions are named by their function objects, so such a function is called by value. The caller's own function object is called directly while nobody else can have it and nothing is stored in it. A read or a store of a member may run an accessor or a trap that gets the function object as its receiver, a conversion may run a method of it, its `prototype` leads back to it, and a store may be its displayName: behind each of those the call stays by value. A test of its type is only a look, and so is a read of a name on a function whose function objects are read without code.
# FORM: Prepared
# RUN: pass ResolveCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="renamed" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, RecordsCallee] {
    Return v0
}
function f1 name="renamedAndReadWithoutCode" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, RecordsCallee, ClosuresAreReadWithoutCode] {
    Return v0
}

function f2 name="readsMember" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f0
    v2 = PropGet v1 key="member"
    v3 = Call v1, -, v0
    Return v3
# CHECK: [[closureOfReadsMember]]: f0 = NewClosure function=f0
# CHECK: = PropGet [[closureOfReadsMember]] key="member"
# CHECK-NEXT: = Call [[closureOfReadsMember]], -, v0
}

function f3 name="storesMember" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    PropSet v2, v1 key="displayName" mode=Strict
    v4 = Call v2, -, v0
    Return v4
# CHECK: [[closureOfStoresMember]]: f0 = NewClosure function=f0
# CHECK: PropSet [[closureOfStoresMember]], v1 key="displayName"
# CHECK-NEXT: = Call [[closureOfStoresMember]], -, v0
}

function f4 name="storesMemberOfOneThatIsReadWithoutCode" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
    v2 = NewClosure function=f1
    PropSet v2, v1 key="displayName" mode=Strict
    v4 = Call v2, -, v0
    Return v4
# CHECK: [[closureOfStoresMemberOfOneThatIsReadWithoutCode]]: f1 = NewClosure function=f1
# CHECK: PropSet [[closureOfStoresMemberOfOneThatIsReadWithoutCode]], v1 key="displayName"
# CHECK-NEXT: = Call [[closureOfStoresMemberOfOneThatIsReadWithoutCode]], -, v0
}

function f5 name="readsUnderKey" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = ElemGet v2, v1
    v4 = Call v2, -, v0
    Return v4
# CHECK: [[closureOfReadsUnderKey]]: f0 = NewClosure function=f0
# CHECK: = ElemGet [[closureOfReadsUnderKey]], v1
# CHECK-NEXT: = Call [[closureOfReadsUnderKey]], -, v0
}

function f6 name="asksForMember" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f0
    v2 = PropHas v1 key="member"
    v3 = Call v1, -, v0
    Return v3
# CHECK: [[closureOfAsksForMember]]: f0 = NewClosure function=f0
# CHECK: = PropHas [[closureOfAsksForMember]] key="member"
# CHECK-NEXT: = Call [[closureOfAsksForMember]], -, v0
}

function f7 name="converts" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = Add v1, v2
    v4 = Call v2, -, v0
    Return v4
# CHECK: [[closureOfConverts]]: f0 = NewClosure function=f0
# CHECK: = Add v1, [[closureOfConverts]]
# CHECK-NEXT: = Call [[closureOfConverts]], -, v0
}

function f8 name="readsPrototype" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f1
    v2 = PropGet v1 key="prototype"
    v3 = Call v1, -, v0
    Return v3
# CHECK: [[closureOfReadsPrototype]]: f1 = NewClosure function=f1
# CHECK: = PropGet [[closureOfReadsPrototype]] key="prototype"
# CHECK-NEXT: = Call [[closureOfReadsPrototype]], -, v0
}

function f9 name="readsOnTheOtherSide" parameters=[{type=boolean}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v2, -, v1
    Return v3
  b2() frequency=Rare:
    v4 = PropGet v2 key="member"
    Return v4
# CHECK: = CallDirect v1 function=f0 [callsOwnFunctionObject, calleeIsPredicted]
# CHECK: = PropGet {{*}} key="member"
}

function f10 name="onlyTests" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f0
    v2 = TypeOf v1
    v3 = StrictEq v1, v0
    v4 = Call v1, -, v0
    Return v4
# CHECK: = CallDirect v0 function=f0 [callsOwnFunctionObject, calleeIsPredicted]
}

function f11 name="readsMemberOfOneThatIsReadWithoutCode" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f1
    v2 = PropGet v1 key="member"
    v3 = Call v1, -, v0
    Return v3
# CHECK: = PropGet {{*}} key="member"
# CHECK-NEXT: = CallDirect v0 function=f1 [callsOwnFunctionObject, calleeIsPredicted]
}

function f12 name="storesMemberBehindTheCall" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
    v2 = NewClosure function=f0
    v3 = Call v2, -, v0
    PropSet v2, v1 key="displayName" mode=Strict
    Return v3
# CHECK: [[closureOfStoresMemberBehindTheCall]]: f0 = NewClosure function=f0
# CHECK-NEXT: = Call [[closureOfStoresMemberBehindTheCall]], -, v0
}
