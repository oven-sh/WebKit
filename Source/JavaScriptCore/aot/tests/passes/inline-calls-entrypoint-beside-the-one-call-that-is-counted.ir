# The call graph counts one call of the function, in main, and has seen every use of its closure. The call in the entrypoint, which was made since, comes on top of that one:
# the body stays for main, so the entrypoint calls it and holds no second copy
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot only-passes=EstimateHeat,SummarizeForInlining,InlineCalls
# RUN: pipeline InlineCalls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    Return v3
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call {{*}}callees=[f1]

function f1 name="calledAtOnePlace" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToNumber v0
    v2 = Mul v1, v1
    v3 = Mul v2, v1
    v4 = Mul v3, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    v12 = Mul v11, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    v15 = Mul v14, v1
    v16 = Mul v15, v1
    v17 = Mul v16, v1
    v18 = Mul v17, v1
    v19 = Mul v18, v1
    v20 = Mul v19, v1
    v21 = Mul v20, v1
    v22 = Mul v21, v1
    Return v22
}
# CHECK-LABEL: name="calledAtOnePlace" module=m0 role=GenericEntrypoint
# CHECK-NOT: = Mul
# CHECK: = CallDirect {{*}}function=f1
# CHECK-NOT: = Mul
