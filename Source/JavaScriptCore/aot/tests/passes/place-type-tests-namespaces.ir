# A receiver that is expected to be the namespace object of a module is tested for the layout of that namespace, the reads under the test become reads of variables, and a failing test enters the generic copy
# FORM: Prepared
# RUN: pass PlaceTypeTests
# STATISTIC: StretchesGuarded = 1

variable g0 name="a" module=m1 declared={type=number} initialization=Undefined
variable g1 name="b" module=m1 declared={type=string} initialization=Undefined
module m0 path="main.js" displayPath="main.js" requests=[{target=m1 completes=true}]
module m1 path="library.js" displayPath="library.js" exports=[{name="a" variable=g0}, {name="b" variable=g1}]

function f0 name="twoReads" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object ~ L(m1), v1: function):
    v2 = PropGet v0 key="a"
    v3 = PropGet v0 key="b"
    v4 = Call v1, -, v2, v3
    Return v4
}
# CHECK-LABEL: function f0 name="twoReads"
# CHECK: [[test]]: boolean{{*}} = TypeTest v0 testedType=L(m1)
# CHECK-NEXT: Branch [[test]] -> taken [[passed]](| 0), notTaken
# CHECK-NOT: = TypeTest
# CHECK: v2: number = GetModuleVariable variable=g0
# CHECK-NEXT: v3: string = GetModuleVariable variable=g1
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="a"
# CHECK-NEXT: = PropGet v0 key="b"
# CHECK: [[passed]]([[namespace]]: L(m1)):
# CHECK-NEXT: = BelongsToInstance [[namespace]]
function f1 name="nothingExpected" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = PropGet v0 key="a"
    v3 = Call v1, -, v2
    Return v3
}
# CHECK-LABEL: function f1 name="nothingExpected"
# CHECK-NOT: TypeTest
# CHECK: = PropGet v0 key="a"
