# A tail call of the function itself becomes a jump to the head of a loop. After the first such jump the parameters of the entry block are those of an earlier call,
# so a test that fails in or behind that loop keeps its own generic code. A test that fails in a loop that the program wrote still begins the call again.
# FORM: Prepared
# RUN: pass EliminateTailRecursion RestartInGenericVersion VerifyProgram
# STATISTIC: TailRecursionsEliminated = 1
# STATISTIC: RestartsInGenericVersion = 1

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Record name="Point" fields=[{key="x" declared={type=number}}]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    Return
}

function f1 name="countDown" module=m0 role=EntryChecks flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] creator=EntryChecks{body=f2 fallback=f3} {
  b0(v0: anything, v1: number):
    v2 = TypeTest v0 testedType=L0
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: L0):
    v4 = CallDirect v3, v1 function=f2
    ReturnCall v4 requirement=Allowed
  b2() frequency=Unlikely:
    v5 = CallDirect v0, v1 function=f3
    ReturnCall v5 requirement=Allowed
}

function f2 name="countDown" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0}, {type=number}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f1} {
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    v4 = Sub v1, v3
    v5 = CallDirect v0, v4 function=f2
    ReturnCall v5
  b2():
    v6 = IsSlotFilled v0 key="x" receivers=[L0] level=Expected
    Branch v6 -> taken b3(| 0), notTaken b4()
  b3(v7: guard):
    v8 = GetSlot v0, v7 key="x" receivers=[L0] level=Expected
    Return v8
  b4() frequency=Rare:
    v9 = PropGet v0 key="x"
    Return v9
# CHECK: LoopHint [replacesTailCalls]
# CHECK-NOT: function=f3
# CHECK: PropGet
# CHECK-NOT: function=f3
}

function f3 name="countDown" module=m0 role=GenericVersion flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f1} creator=Version{provenVersion=f2} {
  b0(v0: anything, v1: number) frequency=Unlikely:
    v2 = PropGet v0 key="x"
    Return v2
}

function f4 name="spin" module=m0 role=EntryChecks flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] creator=EntryChecks{body=f5 fallback=f6} {
  b0(v0: anything, v1: number):
    v2 = TypeTest v0 testedType=L0
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: L0):
    v4 = CallDirect v3, v1 function=f5
    ReturnCall v4 requirement=Allowed
  b2() frequency=Unlikely:
    v5 = CallDirect v0, v1 function=f6
    ReturnCall v5 requirement=Allowed
}

function f5 name="spin" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0}, {type=number}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f4} {
    Jump -> next b1(v1)
  b1(v2: number):
    LoopHint
    v4 = ToBoolean v2
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Integer integer=1
    v6 = Sub v2, v5
    Jump -> next b1(v6)
  b3():
    v7 = IsSlotFilled v0 key="x" receivers=[L0] level=Expected
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8: guard):
    v9 = GetSlot v0, v8 key="x" receivers=[L0] level=Expected
    Return v9
  b5() frequency=Rare:
    v10 = PropGet v0 key="x"
    Return v10
# CHECK-NOT: PropGet
# CHECK: [[result]]: anything = CallDirect v0, v1 function=f6 [isNeverInlined]
# CHECK-NEXT: ReturnCall [[result]]
}

function f6 name="spin" module=m0 role=GenericVersion flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=L0 flags=[IsExpected]}, {type=number}] results=[{type=anything}] capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f4} creator=Version{provenVersion=f5} {
  b0(v0: anything, v1: number) frequency=Unlikely:
    v2 = PropGet v0 key="x"
    Return v2
}
