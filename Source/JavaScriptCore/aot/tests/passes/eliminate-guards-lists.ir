# A list of guards is flattened, loses its repeats, and a list of one is replaced by its member wherever the member may stand
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="listOfLists" parameters=[{type=object}, {type=object}, {type=object}] results=[{type=anything}] {
  b0(v0: object, v1: object, v2: object):
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4):
    v5 = ShapeTest v1 layouts=[L0]
    Branch v5 -> taken b2(| 0), notTaken b4()
  b2(v6):
    v7 = ShapeTest v2 layouts=[L0]
    Branch v7 -> taken b3(| 0), notTaken b4()
  b3(v8):
    v9 = AllGuards v4, v6
    v10 = AllGuards v9, v8
    v11 = GetSlot v2, v10 key="x" receivers=[L0] level=Predicted
    Return v11
  b4():
    Return v0
}
# CHECK-LABEL: function f0 name="listOfLists"
# CHECK: b3(v8: guard):
# CHECK: v10: guard = AllGuards v4, v6, v8
# CHECK-NEXT: v11: number = GetSlot v2, v10 key="x" receivers=[L0] level=Predicted

function f1 name="repeatedGuards" parameters=[{type=object}, {type=object}] results=[{type=anything}] {
  b0(v0: object, v1: object):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = ShapeTest v1 layouts=[L0]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = AllGuards v3, v5, v3
    v7 = GetSlot v0, v6 key="x" receivers=[L0] level=Predicted
    v8 = AllGuards v5, v3
    v9 = AllGuards v8, v3, v5
    v10 = GetSlot v1, v9 key="x" receivers=[L0] level=Predicted
    Return v10
  b3():
    Return v0
}
# CHECK-LABEL: function f1 name="repeatedGuards"
# CHECK: v6: guard = AllGuards v3, v5
# CHECK-NEXT: v7: number = GetSlot v0, v6 key="x" receivers=[L0] level=Predicted
# CHECK: v9: guard = AllGuards v5, v3
# CHECK-NEXT: v10: number = GetSlot v1, v9 key="x" receivers=[L0] level=Predicted

function f2 name="twoGuardsStay" parameters=[{type=object}, {type=object}] results=[{type=anything}] {
  b0(v0: object, v1: object):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = ShapeTest v1 layouts=[L0]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = AllGuards v3, v5
    v7 = GetSlot v0, v6 key="x" receivers=[L0] level=Predicted
    Return v7
  b3():
    Return v0
}
# CHECK-LABEL: function f2 name="twoGuardsStay"
# CHECK: b2(v5: guard):
# CHECK-NEXT: v6: guard = AllGuards v3, v5
# CHECK-NEXT: v7: number = GetSlot v0, v6 key="x" receivers=[L0] level=Predicted

function f3 name="listOfOneGuard" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = AllGuards v2
    v4 = GetSlot v0, v3 key="x" receivers=[L0] level=Predicted
    Jump -> next b2(v3)
  b2(v5):
    v6 = GetSlot v0, v5 key="x" receivers=[L0] level=Predicted
    Return v6
  b3():
    Return v0
}
# CHECK-LABEL: function f3 name="listOfOneGuard"
# CHECK: b1(v2: guard):
# CHECK-NOT: AllGuards
# CHECK: v4: number = GetSlot v0, v2 key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: Jump -> next b2(v2)
# CHECK-NOT: AllGuards

function f4 name="listOfOneRepeatedGuard" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = AllGuards v2
    v4 = AllGuards v3, v2
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Return v5
  b2():
    Return v0
}
# CHECK-LABEL: function f4 name="listOfOneRepeatedGuard"
# CHECK-NOT: AllGuards
# CHECK: v5: number = GetSlot v0, v2 key="x" receivers=[L0] level=Predicted
# CHECK-NOT: AllGuards

function f5 name="listOfOneAllocation" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = AllGuards v1
    v3 = GetSlot v1, v2 key="x" receivers=[L0] level=Predicted
    Return v3
}
# CHECK-LABEL: function f5 name="listOfOneAllocation"
# CHECK-NOT: AllGuards
# CHECK: v3: number = GetSlot v1, v1 key="x" receivers=[L0] level=Predicted
# CHECK-NOT: AllGuards

function f6 name="listOfOneAllocationOnEdge" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = AllGuards v1
    v3 = GetSlot v1, v2 key="x" receivers=[L0] level=Predicted
    Jump -> next b1(v2)
  b1(v4):
    v5 = GetSlot v1, v4 key="x" receivers=[L0] level=Predicted
    Return v5
}
# CHECK-LABEL: function f6 name="listOfOneAllocationOnEdge"
# CHECK: v2: guard = AllGuards v1
# CHECK-NEXT: v3: number = GetSlot v1, {{*}} key="x" receivers=[L0] level=Predicted
