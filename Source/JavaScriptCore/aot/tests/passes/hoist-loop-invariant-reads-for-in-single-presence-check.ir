# Each step of a for-in loop asks whether the enumerator still says which keys the object has. Where nothing in the loop but the step itself can change the keys of any object, the step is marked:
# it asks once, and again only behind a turn that the run time took.
# FORM: Prepared optimizing
# OPTIONS: check=VerifyEachPass heat=EverythingIsHot
# RUN: pass HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js"

function f0 name="comparesKeys" parameters=[{type=anything}, {type=string}] results=[{type=boolean}] {
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4: int[0, 8589934591]):
    LoopHint
    v6 = ForInStep v2, v0 position=v4
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    v9 = ResultAt v6 index=2
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v10 = StrictEq v8, v1
    v11 = Integer integer=1
    v12 = Add v9, v11
    Branch v10 -> taken b1(v12), notTaken b4()
  b3():
    v13 = Boolean boolean=true
    Return v13
  b4():
    v14 = Boolean
    Return v14
# CHECK: = ForInStep v2, v0 position=v4 [keysChangeOnlyInSteps]
}
function f1 name="storesUnderKeys" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v2 = ForInOpen v0
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4: int[0, 8589934591]):
    LoopHint
    v6 = ForInStep v2, v0 position=v4
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    v9 = ResultAt v6 index=2
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    ElemSet v1, v8, v8
    v11 = Integer integer=1
    v12 = Add v9, v11
    Jump -> next b1(v12)
  b3():
    v13 = Boolean boolean=true
    Return v13
# A store under a key may give any object another key.
# CHECK: = ForInStep v2, v0 position=v4
# CHECK-NOT: keysChangeOnlyInSteps
}
function f2 name="storesBetweenOpeningAndLoop" parameters=[{type=anything}, {type=string}] results=[{type=boolean}] {
    v2 = ForInOpen v0
    PropSet v0, v1 key="late"
    v4 = Integer integer=0
    Jump -> next b1(v4)
  b1(v5: int[0, 8589934591]):
    LoopHint
    v7 = ForInStep v2, v0 position=v5
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    v10 = ResultAt v7 index=2
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    v11 = StrictEq v9, v1
    v12 = Integer integer=1
    v13 = Add v10, v12
    Branch v11 -> taken b1(v13), notTaken b3()
  b3():
    v14 = Boolean boolean=true
    Return v14
# CHECK: = ForInStep v2, v0 position=v5
# CHECK-NOT: keysChangeOnlyInSteps
}
