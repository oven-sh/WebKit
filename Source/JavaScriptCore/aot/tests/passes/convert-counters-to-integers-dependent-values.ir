# CHECK: b2([[counter5]]: int[0, 99]):
# CHECK-NEXT: v8: boolean = Less [[counter5]], v4
# CHECK-NEXT: Branch v8 -> taken b3(| 0), notTaken b4()
# CHECK-NEXT: b3(v9: int[0, 9]):
# CHECK-NEXT: v10: int[0, 18] = Mul v9, v3
}

