    v2 = Integer integer=1
    v3 = Integer integer=2
    v4 = Integer integer=10
    Jump -> next b1(v1)
  b1(v5):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(), notTaken b5()
  b2():
    v8 = Less v5, v4
    Branch v8 -> taken b3(| 0), notTaken b4()
  b3(v9):
    v10 = Mul v9, v3
    Jump -> next b4()
  b4():
    v11 = Add v5, v2
    Jump -> next b1(v11)
  b5():
