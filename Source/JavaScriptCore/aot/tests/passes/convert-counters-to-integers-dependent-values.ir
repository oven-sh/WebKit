}

function f3 name="throughToNumeric" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = Integer integer=2
    Jump -> next b1(v1)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = ToNumeric v4
    v8 = Mul v7, v3
    v9 = Add v4, v2
    Jump -> next b1(v9)
  b3():
    Return
# CHECK: b2([[counter3]]: int[0, 99]):
# CHECK-NEXT: v7: int[0, 99] = ToNumeric [[counter3]]
# CHECK-NEXT: v8: int[0, 198] = Mul v7, v3
}

