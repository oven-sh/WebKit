# A value computed from a converted counter becomes an integer, and a loop that starts or ends at one is converted in the next round
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 9

module m0 path="main.js" displayPath="main.js"
function f0 name="arithmeticOnCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = Integer integer=2
    Jump -> next b1(v1)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v4, v3
    v8 = Mul v4, v3
    v9 = Sub v8, v7
    v10 = Add v4, v2
    Jump -> next b1(v10)
  b3():
    Return
# CHECK: b1(v4: int[0, 100]):
# CHECK: b2([[counter0]]: int[0, 99]):
# CHECK-NEXT: v7: int[2, 101] = Add [[counter0]], v3
# CHECK-NEXT: v8: int[0, 198] = Mul [[counter0]], v3
# CHECK-NEXT: v9: int[-101, 196] = Sub v8, v7
}

function f1 name="innerStartIsSum" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b6()
  b2():
    v6 = Add v3, v2
    Jump -> next b3(v6)
  b3(v7):
    LoopHint
    v9 = Less v7, v0
    Branch v9 -> taken b4(), notTaken b5()
  b4():
    v10 = Add v7, v2
    Jump -> next b3(v10)
  b5():
    v11 = Add v3, v2
    Jump -> next b1(v11)
  b6():
    Return
# CHECK: b1(v3: int[0, 100]):
# CHECK: b2([[outer1]]: int[0, 99]):
# CHECK-NEXT: v6: int[1, 100] = Add [[outer1]], v2
# CHECK: b3(v7: int[1, {{*}}]):
# CHECK: Branch v9 -> taken b4(| 0), notTaken b5()
# CHECK-NEXT: b4([[inner1]]: int[1, 99]):
# CHECK-NEXT: v10: int[2, 100] = Add [[inner1]], v2
}

