# The entrypoints of a member whose callers test its written result test it, and those of its neighbor jump
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# OPTIONS: check=VerifyEachPass only-passes=GroupCallsByValue,ChooseCallingConventions
# STATISTIC: GroupEntrypoints = 6

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = CallDirect v0 function=f7
    v7 = CallDirect v1 function=f7
    v8 = CallDirect v2 function=f7
    v9 = CallDirect v3 function=f7
    v10 = CallDirect v4 function=f7
    v11 = CallDirect v5 function=f7
    Return
}
function f1 name="testedByCallers" kind=Arrow flags=[IsChecked] parameters=[{type=anything}] results=[{type=number site=w0}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f8
    ReturnCall v1 casts=[{declared={type=number site=w0}}]
}
function f2 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f6 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f7 name="apply" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    Return v2
}
function f8 name="jumpsBack" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName]
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = CallDirect v2 function=f1
    ReturnCall v4
  b2():
    Return v2
}
# CHECK: name="testedByCallers"{{*}}role=GroupEntrypoint{{*}}results=[{type=number}]
# CHECK: [[unchecked]]: anything ? number = CallDirect {{*}} function=f1 resultCheck=ByCallers
# CHECK-NEXT: [[checked]]: number = Claim [[unchecked]] castType=number site=w0
# CHECK-NEXT: Return [[checked]]
# CHECK: name="second"{{*}}role=GroupEntrypoint{{*}}results=[{type=number}]
# CHECK: [[result]]: fractional = CallDirect {{*}} function=f2
# CHECK-NEXT: ReturnCall [[result]] requirement=Allowed
