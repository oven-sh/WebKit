function f3 name="cursorEntersBlock" parameters=[{type=string}, {type=number}, {type=boolean}] results=[{type=string}] {
  b0(v0: string, v1: number, v2: boolean):
    v3 = String string=""
    v4 = Integer integer=0
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v6, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Add v5, v0
    v10 = Integer integer=1
    v11 = Add v6, v10
    Jump -> next b1(v9, v11)
  b3():
    v12 = StringBuilderBegin
