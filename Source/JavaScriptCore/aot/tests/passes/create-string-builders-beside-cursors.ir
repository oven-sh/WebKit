# A builder operation between the definition of a builder cursor and its use makes the cursor stale: a state that is read there is made a string in front of the cursor, and nothing else of a web happens there
# FORM: Prepared
# RUN: pass CreateStringBuilders
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="stateReadAfterReservation" parameters=[{type=string}, {type=number}] results=[{type=string}] {
  b0(v0: string, v1: number):
    v2 = String string=""
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v0
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    v11 = StringBuilderBegin
    v12 = StringBuilderReserve v11 size=128
    v13 = JSONAppendString v11, v12, v4
    StringBuilderCommit v11, v13
    v15 = StringBuilderFinish v11
    Return v15
}
# CHECK-LABEL: name="stateReadAfterReservation"
# CHECK: b1(v4: stringbuilder, v5: int|whole):
# CHECK: [[text0]]: string = StringBuilderFinish v4
# CHECK-NEXT: v12: buildercursor = StringBuilderReserve v11 size=128
# CHECK-NEXT: v13: buildercursor = JSONAppendString v11, v12, [[text0]]

