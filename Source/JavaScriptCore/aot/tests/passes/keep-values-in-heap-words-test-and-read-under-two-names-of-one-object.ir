# A value kept in a heap word is read back as a value of its own. One object may go by several names, and a test may look at one of them while the read that names its guard reads another.
# In the first function the names are the object and the parameter of the edge that narrows it. In the second they are the object and the parameter of a block that two narrowing edges in two stretches lead to.
# In the third no operation reads the other name under the guard: an edge hands the guard on beside it, to a block that is handed another object with its own guard on the other way in.
# In the fourth that edge is the one on which the test makes the guard.
# None of these objects goes into a word. The other object of each function crosses the same suspensions, is tested and read under one name or not at all, and is kept.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass limit=MaxSuspensionsCrossedOnStack:0
# RUN: pass KeepValuesInHeapWords
# STATISTIC: ValuesKeptInHeapWords = 4

module m0 path="main.js" displayPath="main.js"
variable g0 declared={type=anything} initialization=Undefined
layout L0 name="Box" fields=[{key="w" declared={type=number}}]
layout L1 name="Other" fields=[{key="w" declared={type=number}}]

function f0 name="testsTheNarrowedName" role=CoroutineBody flags=[IsAsync] parameters=[{type=boolean}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f0 promiseType=Promise promiseParameter=2} {
  b0(v0: boolean, v1: anything, v2: undefined|Promise):
    v3 = PropGet v1 key="box"
    v4 = NewObject layout=L1 fields=[]
    v5 = TypeTest v3 testedType=L0
    Branch v5 -> taken b1(| 0), notTaken b3()
  b1(v6):
    v7 = AwaitBySavingFrame v0, v2, v3, v4, v6
# CHECK: IsSlotFilled v6 key="w"
    v8 = IsSlotFilled v6 key="w" receivers=[L0] level=Expected
    Branch v8 -> taken b2(| 0), notTaken b3()
  b2(v9):
# CHECK: AssumeType v3 provenType=L0
    v10 = AssumeType v3 provenType=L0
    v11 = GetSlot v10, v9 key="w" receivers=[L0] level=Expected
    PutModuleVariable v4 variable=g0
    Return v11
  b3() frequency=Unlikely:
    v13 = Undefined
    Return v13
}
