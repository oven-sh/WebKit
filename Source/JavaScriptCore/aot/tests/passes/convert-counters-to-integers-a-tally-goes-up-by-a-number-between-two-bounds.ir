    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v1, v3
    v8 = Increment v4
    Jump -> next b1(v7, v8)
  b3():
    Return v3
# CHECK: b1(v3: int[0, 40], v4: int[0, 10]):
# CHECK: = AssumeType v7, {{*}} provenType=int[0, 40]
# CHECK: Return v3
}

