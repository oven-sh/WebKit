# `count += isSet ? 1 : 0`, `count += word & 7`: what a turn adds to a tally need not be a constant. Its type says between which integers it lies, and an integer counter takes each value of its range at most once: the tally is an integer within the bounds that follow.
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="goesUpByOneOrByNothing" parameters=[{type=int[0, 2147483647]}, {type=boolean}] results=[{type=number}] {
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b6()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    v7 = Integer integer=1
    Jump -> next b5(v7)
  b4():
    v8 = Integer integer=0
    Jump -> next b5(v8)
  b5(v9):
    v10 = Add v3, v9
    v11 = Increment v4
    Jump -> next b1(v10, v11)
  b6():
    Return v3
# CHECK: b1(v3: int[0, 2147483647], v4: int[0, 2147483647]):
# CHECK: = AssumeType v10, {{*}} provenType=int[0, 2147483647]
# CHECK: Return v3
}

function f1 name="goesUpByTheLowBitsOfTheCounter" parameters=[{type=int[0, 1000]}] results=[{type=number}] {
    v1 = Integer integer=0
    Jump -> next b1(v1, v1)
  b1(v2, v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Integer integer=7
    v7 = BitAnd v3, v6
    v8 = Add v2, v7
    v9 = Increment v3
    Jump -> next b1(v8, v9)
  b3():
    Return v2
# CHECK: b1(v2: int[0, 7000], v3: int[0, 1000]):
# CHECK: = AssumeType v8, {{*}} provenType=int[0, 7000]
# CHECK: Return v2
}

function f2 name="goesDownByANumberOfEitherSign" parameters=[{type=int[0, 10]}, {type=int[-2, 3]}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=5
    Jump -> next b1(v3, v2)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Sub v4, v1
    v9 = Increment v5
    Jump -> next b1(v8, v9)
  b3():
    Return v4
# CHECK: b1(v4: int[-25, 25], v5: int[0, 10]):
# CHECK: = AssumeType v8, {{*}} provenType=int[-25, 25]
# CHECK: Return v4
}

