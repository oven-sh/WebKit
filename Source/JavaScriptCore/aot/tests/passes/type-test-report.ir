# The report has one record for each source position and kind of failure of a type test that runs, with the number of its copies
# FORM: Prepared
# RUN: type-test-report

module m0 path="main.js" displayPath="main.js"
module m1 path="lib.js" displayPath="lib.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]

function f0 name="caller" parameters=[{type=anything}, {type=object}] results=[{type=anything}] inlineFrames=[{}, {callee=f1 callPosition=50 module=m1}] {
  b0(v0: anything, v1: object):
    v2 = Claim v0 castType=number @30
    v3 = TypeTest v0 testedType=number @30
    v4 = ShapeTest v1 layouts=[L0] @20:1
    v5 = TypeTest v0 testedType=string
    v6 = TypeTest v0 testedType=string @10
    v7 = Add v2, v2 @60
    SwitchOnShape v1 layoutSets=[[L0]] -> case b1(), otherwise b2() @40
  b1():
    Return v0
  b2():
    Return v1
}
function f1 name="callee" module=m1 parameters=[{type=object}] results=[{type=boolean}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0] @20
    Return v1
}
function f2 name="load" module=m1 role=ResultWrapper parameters=[{type=anything}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f3}
function f3 name="load" module=m1 role=ResultWorker parameters=[{type=anything}] results=[{type=number}, {type=number}] derivation={source=f2} creator=ResultWorker{origin=f2} {
  b0(v0: anything):
    v1 = Claim v0 castType=number @70
    v2 = Results v1, v1
    Return v2
}
# CHECK: m0:10 f0 TakesGenericPath copies=1
# CHECK-NEXT: m0:30 f0 TakesGenericPath copies=1
# CHECK-NEXT: m0:30 f0 Throws copies=1
# CHECK-NEXT: m0:40 f0 TakesGenericPath copies=1
# CHECK-NEXT: m1:20 f1 TakesGenericPath copies=2
# CHECK-NEXT: m1:70 f2 Throws copies=1
# CHECK-NOT: copies=
