# A rest array whose elements are only read or forwarded is never allocated: its elements are the arguments in the frame
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 7
# STATISTIC: AllocationsSunk = 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Base" constructor=f1 flow={baseState=None}
layout L1 kind=Instance name="Derived" base=L0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0}

function f0 name="target" flags=[HasRestParameter] parameters=[{type=Array}] results=[{type=anything}] {
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget] parameters=[{type=function}] results=[{type=anything}] {
    v2 = SuperConstruct v1, v0 layout=L1
    Return v2
}

function f3 name="constantIndex" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = CreateRest firstArgument=1
    v3 = Integer integer=2
    v4 = ElemGet v2, v3
    Return v4
# CHECK-NOT: CreateRest
# CHECK-NOT: ElemGet
# CHECK: [[argument3]]: anything = GetArgument argumentIndex=3
# CHECK-NEXT: v4: anything = Upcast [[argument3]] castType=anything
}

function f4 name="length" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = CreateRest firstArgument=1
    v3 = PropGet v2 key="length"
    Return v3
# CHECK-NOT: CreateRest
# CHECK-NOT: PropGet
# CHECK: [[length4]]:{{*}}= GetRestLength firstArgument=1
# CHECK-NEXT: v3: anything = Upcast [[length4]] castType=anything
}

function f5 name="integerIndex" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = Check v2 expectedType=i32
    v4 = CreateRest firstArgument=1
    v5 = ElemGet v4, v3
    Return v5
# CHECK-NOT: CreateRest
# CHECK-NOT: ElemGet
# CHECK: [[argument5]]: anything = GetMyArgumentByVal v3 firstArgument=1
# CHECK-NEXT: v5: anything = Upcast [[argument5]] castType=anything
}

function f6 name="untypedIndex" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    v4 = ElemGet v3, v2
    Return v4
# CHECK: v3: Array = CreateRest firstArgument=1
# CHECK-NEXT: = ElemGet v3, v2
}

function f7 name="forwardedCall" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = GetArgument argumentIndex=1
    v4 = CreateRest firstArgument=2
    v5 = CallList v2, v3, v4
    Return v5
# CHECK-NOT: CreateRest
# CHECK: v5: anything = CallForwardVarargs v2, v3 firstArgument=2
}

function f8 name="forwardedCallWithoutThis" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    v4 = CallList v2, -, v3
    Return v4
# CHECK-NOT: CreateRest
# CHECK: [[this8]]: undefined = Undefined
# CHECK-NEXT: v4: anything = CallForwardVarargs v2, [[this8]] firstArgument=1
}

function f9 name="forwardedSuperConstruct" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = Check v2 expectedType=function
    v4 = CreateRest firstArgument=1
    v5 = SuperConstructList v3, v2, v4 layout=L1
    Return v5
# CHECK-NOT: CreateRest
# CHECK: v5:{{*}}= ConstructSuperForwardVarargs v3, v2 layout=L1 firstArgument=1
}

function f10 name="constructionHasNoForwardingForm" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    v4 = ConstructList v2, -, v3
    Return v4
# CHECK: v3: Array = CreateRest firstArgument=1
# CHECK-NEXT: = ConstructList v2, -, v3
}

function f11 name="destructured" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = CreateRest firstArgument=1
    v3 = DestructureIterable v2 count=2
    v4 = ResultAt v3 index=0
    v5 = ResultAt v3 index=1
    v6 = StrictEq v4, v5
    Return v6
# CHECK-NOT: CreateRest
# CHECK-NOT: DestructureIterable
# CHECK: [[first11]]: anything = GetArgument argumentIndex=1
# CHECK-NEXT: v4: anything = Upcast [[first11]] castType=anything
# CHECK-NEXT: [[second11]]: anything = GetArgument argumentIndex=2
# CHECK-NEXT: v5: anything = Upcast [[second11]] castType=anything
}

function f12 name="passedOnInOneBranch" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    v4 = PropGet v3 key="length"
    v5 = ToBoolean v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    v6 = Call v2, -, v3
    Return v6
  b2():
    Return v4
# CHECK: b0(
# CHECK-NOT: CreateRest
# CHECK: = GetRestLength firstArgument=1
# CHECK-NOT: CreateRest
# CHECK: b1():
# CHECK-NEXT: [[rest12]]: Array = CreateRest firstArgument=1
# CHECK-NEXT: = Call v2, -, [[rest12]]
# CHECK-NOT: CreateRest
}

function f13 name="usedTwiceInOneBranch" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    v4 = ToBoolean v2
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = ConstructList v2, -, v3
    v6 = ConstructList v2, -, v3
    Return v6
  b2():
    Return v2
# CHECK: b0(
# CHECK-NOT: CreateRest
# CHECK: b1():
# CHECK-NEXT: [[rest13]]: Array = CreateRest firstArgument=1
# CHECK-NEXT: = ConstructList v2, -, [[rest13]]
# CHECK-NEXT: = ConstructList v2, -, [[rest13]]
# CHECK-NOT: CreateRest
}

function f14 name="storeBuildsTheArrayFirst" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=0
    v4 = Integer integer=0
    ElemSet v3, v4, v2 mode=Strict
    v6 = ElemGet v3, v4
    Return v6
# CHECK: v3: Array = CreateRest
# CHECK: ElemSet v3, v4, v2
# CHECK-NEXT: = ElemGet v3, v4
}

function f15 name="returned" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = CreateRest firstArgument=0
    v3 = PropGet v2 key="length"
    Return v2
# CHECK: v2: Array = CreateRest
# CHECK-NEXT: = PropGet v2 key="length"
# CHECK-NEXT: Return v2
}

function f16 name="spreadIntoArray" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = CreateRest firstArgument=0
    v3 = NewArray contents=anything
    AppendElements v3, v2, v2
    Return v3
# CHECK: v2: Array = CreateRest
# CHECK: AppendElements {{*}}, v2, v2
}

function f17 name="usedInsideLoop" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = CreateRest firstArgument=1
    Jump -> next b1()
  b1():
    LoopHint
    v5 = ConstructList v2, -, v3
    v6 = TypeTest v5 testedType=function
    Branch v6 -> taken b1(), notTaken b2()
  b2():
    Return v5
# CHECK: b0(
# CHECK: = CreateRest firstArgument=1
# CHECK-NEXT: Jump -> next b1(
# CHECK-NOT: CreateRest
}
