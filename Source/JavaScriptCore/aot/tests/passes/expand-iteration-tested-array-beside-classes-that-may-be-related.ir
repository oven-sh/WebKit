# [...letters], for (const letter of letters): `letters` is a text, an array whose contents and names are proven, or an instance of three other classes.
# What a passed test for an array leaves of that type lies outside it: beside a class that may be related to Array the part loses what it proves.
# So where the names of the tested array are not as created, the walk by the protocol gets the value that was tested, whose type its parameter has. The IR is verified behind the pass.
# FORM: Prepared optimizing
# RUN: pass ExpandIteration ExpandIteration
# OPTIONS: check=VerifyEachPass

module m0 path="main.js" displayPath="main.js"

function f0 name="spreadOut" parameters=[{type=string|Array<string, proven, pristine[Storage, Names, Dense]>|Generator<anything, pristine[Storage, Names]>|Set<undefined|string, proven, pristine[Storage, Names]>|String}] results=[{type=anything}] {
  b0(v0: string|Array<string, proven, pristine[Storage, Names, Dense]>|Generator<anything, pristine[Storage, Names]>|Set<undefined|string, proven, pristine[Storage, Names]>|String):
    v1 = NewArray contents=anything
    AppendSpread v1, v0
    Return v1
}
# CHECK-LABEL: function f0 name="spreadOut"
# CHECK: b0([[letters]]:
# CHECK: = TypeTest [[letters]] testedType=Array
# CHECK: = IsPristine
# CHECK: Jump -> next {{*}}([[letters]])

function f1 name="each" parameters=[{type=string|Array<string, proven, pristine[Storage, Names, Dense]>|Generator<anything, pristine[Storage, Names]>|Set<undefined|string, proven, pristine[Storage, Names]>|String}] results=[{type=anything}] {
  b0(v0: string|Array<string, proven, pristine[Storage, Names, Dense]>|Generator<anything, pristine[Storage, Names]>|Set<undefined|string, proven, pristine[Storage, Names]>|String):
    v1 = NewArray contents=anything
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    Return v1
  b3():
    AppendElement v1, v6
    Jump -> next b1()
}
# CHECK-LABEL: function f1 name="each"
# CHECK-NOT: IteratorOpen v0
