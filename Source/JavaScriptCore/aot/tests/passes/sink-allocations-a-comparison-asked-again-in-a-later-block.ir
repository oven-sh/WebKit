# `alias === object` decides two branches, and nobody but the comparison uses `alias`. At the second branch the comparison is asked again, and `alias` is still the object.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="first" declared={type=i32} flags=[IsRequired]}, {key="second" declared={type=i32} flags=[IsRequired]}]

function f0 name="equalAtBothBranches" parameters=[{type=i32}] results=[{type=L0}] {
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = Upcast v1 castType=anything
    v3 = StrictEq v2, v1
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Integer integer=1
    Jump -> next b3(v4)
  b2():
    v5 = Integer integer=2
    Jump -> next b3(v5)
  b3(v6: i32):
    PutSlot v1, -, v6 key="first" receivers=[L0] level=Proven
    Branch v3 -> taken b4(), notTaken b5()
  b4():
    v8 = Integer integer=3
    Jump -> next b6(v8)
  b5():
    v9 = Integer integer=4
    Jump -> next b6(v9)
  b6(v10: i32):
    PutSlot v1, -, v10 key="second" receivers=[L0] level=Proven
    Return v1
}
# CHECK-LABEL: name="equalAtBothBranches"
# CHECK: Jump -> next b1()
# CHECK: b3(v6: i32
# CHECK-NEXT: Jump -> next b4()
# CHECK: b5():
# CHECK-NEXT: Unreachable
