# A decided test leaves a cast behind a fact where it stood. Such a cast of a value from above a merge block has no code and is made again where it is used, so that an edge
# whose argument decides the test of the block skips the block: `k = text.charCodeAt(k); k = text.charCodeAt(k)`, where k is NaN past the end.
# FORM: Prepared
# RUN: pass ThreadJumps
# CHECK: outcome: Changed
# RUN(AGAIN): pass ThreadJumps ThreadJumps
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="castOfValueFromAbove" parameters=[{type=anything}, {type=i32}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    v3 = Double number=NaN
    Jump -> next b3(v3)
  b3(v4: number):
    v5 = Specified
    v6 = AssumeType v0, v5 provenType=string
    v7 = TypeTest v4 testedType=i32
    Branch v7 -> taken b4(| 0), notTaken b5()
  b4(v8):
    v9 = GetStringLength v6
    v10 = Add v8, v9
    Return v10
  b5():
    Return v6
# CHECK: b1():
# CHECK-NEXT: Jump -> next b4(v1)
# CHECK: b2():
# CHECK: Jump -> next b5()
# CHECK: b4(v8: i32):
# CHECK-NEXT: [[fact]]: fact = Specified
# CHECK-NEXT: [[text]]: string = AssumeType v0, [[fact]] provenType=string
# CHECK-NEXT: = GetStringLength [[text]]
}

# The cast says something about the parameter of the block, and an edge that skips the block has no such value.
function f1 name="castOfTheParameter" parameters=[{type=anything}, {type=i32}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1, v0)
  b2():
    v3 = Double number=NaN
    Jump -> next b3(v3, v0)
  b3(v4: number, v5: anything):
    v6 = Specified
    v7 = AssumeType v5, v6 provenType=string
    v8 = TypeTest v4 testedType=i32
    Branch v8 -> taken b4(| 0), notTaken b5()
  b4(v9):
    v10 = GetStringLength v7
    v11 = Add v9, v10
    Return v11
  b5():
    Return v7
# CHECK: b3(v4: number, v5: anything):
# CHECK-NEXT: v6: fact = Specified
# CHECK-NEXT: v7: string = AssumeType v5, v6 provenType=string
}
