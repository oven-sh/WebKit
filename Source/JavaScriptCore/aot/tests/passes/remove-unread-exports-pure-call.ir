# A call annotated as pure goes with the store of its answer into a variable nobody reads, and so does the annotated call that made its argument. The conversions to an expected type that the front end puts between a call and its store go with them.
# The same call without the annotation stays with the store of its answer, which may be an object: the variable holds it for as long as the module lives. So does an annotated call whose answer has another use
# FORM: AsRead
# RUN: pipeline RemoveUnreadExports
# OPTIONS: only-passes=RemoveUnreadExports
# STATISTIC: UnreadVariableStoresRemoved = 1

module m0 path="/main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/maps.ts" displayPath="maps.ts" body=f1 exports=[{name="annotated" variable=g0}, {name="plain" variable=g1}, {name="used" variable=g2}]
entry module=m0
variable g0 name="annotated" module=m1 declared={type=anything}
variable g1 name="plain" module=m1 declared={type=anything}
variable g2 name="used" module=m1 declared={type=anything}

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = Builtin builtin=WeakRef
    v2 = Construct v1, -, v0
    Return
}

function f1 name="maps" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="make" [isFreeName]
    v2 = Call v1, - [isAnnotatedPure]
    v3 = Convert v2 declared={type=object flags=[IsExpected]}
    v4 = Construct v1, -, v3 [isAnnotatedPure]
    v5 = Convert v4 declared={type=Map flags=[IsExpected]}
    PutModuleVariable v5 variable=g0
    v7 = Call v1, -
    PutModuleVariable v7 variable=g1
    v9 = Call v1, - [isAnnotatedPure]
    PutModuleVariable v9 variable=g2
    v11 = Call v1, -, v9
    Return
# CHECK-NOT: variable=g0
# CHECK-NOT: Upcast
# CHECK: v7: anything = Call v1 accessSite
# CHECK-NEXT: PutModuleVariable v7 variable=g1
# CHECK-NEXT: v9: anything = Call v1 {{*}}[isAnnotatedPure]
# CHECK-NEXT: PutModuleVariable v9 variable=g2
}
