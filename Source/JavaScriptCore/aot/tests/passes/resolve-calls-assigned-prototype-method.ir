# CHECK-NOT: PropGet
# CHECK: CallDirect {{*}} function=f2
function f4 name="Early" flags=[HasThis] thisType={type=L1 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x" mode=Strict
    Return
}
function f5 name="usesEarly" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = Integer integer=2
    v2 = Construct v0, -, v1
    v3 = PropGet v2 key="double"
    v4 = TypeOf v3
    Return v4
}
