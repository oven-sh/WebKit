# The cast ahead of the entry check is retyped from the tested parameter. Its expected type is dropped when it no longer says more than the new type. The second check stays in the body, so nothing retypes the body afterwards
# FORM: Prepared
# RUN: pass SplitBehindEntryChecks VerifyProgram
# STATISTIC: FunctionsSplitBehindEntryChecks = 1
# CHECK: outcome: Changed

module m0 path="main.ts" displayPath="main.ts" body=f0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Parameter

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    Return
}
function f1 name="add" module=m0 position=100 flags=[IsChecked] length=2 parameters=[{type=number site=w0 flags=[IsExpected]}, {type=int[0, 19] site=w1}] results=[{type=anything}] {
  b0(v0: anything ~ number, v1: int[0, 19]):
    v2: undefined|int ~ int = AssumeType v0 provenType=undefined|int
    v3 = Check v1 expectedType=i32 site=w1
    v4 = Check v2 expectedType=number site=w0
    v5 = Add v4, v3
    Return v5
}
# CHECK: b0(v0: number, v1: int[0, 19]):
# CHECK-NEXT: v2: int = AssumeType v0 provenType=undefined|int
