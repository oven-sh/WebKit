# `result.then(..)` in a program where more layouts have a field `then` than a test has room for: Promise is the one class of the language with the method, so a Promise is expected
# FORM: Prepared optimizing
# OPTIONS: heat=NothingIsHottest
# RUN: pass ResolveBuiltins PlaceTypeTests ResolveBuiltins ResolveCalls ResolveAccesses SplitUnions ResolveBuiltins ResolveAccesses

module m0 path="main.js" displayPath="main.js"
layout L0 name="First" fields=[{key="then" declared={type=anything}}]
layout L1 name="Second" fields=[{key="then" declared={type=anything}}]
layout L2 name="Third" fields=[{key="then" declared={type=anything}}]
layout L3 name="Fourth" fields=[{key="then" declared={type=anything}}]
layout L4 name="Fifth" fields=[{key="then" declared={type=anything}}]

function f0 name="askedAndCalled" parameters=[{type=object}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything, v2: anything):
    v3 = PropGet v0 key="then"
    v4 = TypeTest v3 testedType=function
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = PropGet v0 key="then"
    v6 = Call v5, v0, v1, v2 calleeKey="then"
    Return v6
  b2():
    v7 = Undefined
    Return v7
}
# CHECK-LABEL: function f0 name="askedAndCalled"
# CHECK-NEXT: b0(v0: object ~ Promise,
# CHECK: = TypeTest v0 testedType=Promise
# CHECK: CallBuiltin {{*}} overload=PromisePrototypeThen/0
