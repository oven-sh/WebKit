    v24: L1 = NewObject -, v12, v23 layout=L1 fields=[0, 1]
    PropSet v24, v7 key="at"
    v26: L1 = FinishObject v24
    Return v26
  b10(v27: anything):
    v28: boolean|number|string|symbol|bigint|object = RequireObjectCoercible v27 name="at"
    v29: anything = PropGet v28 key="at"
    v30: Array<anything, Contiguous> = NewArray contents=anything arrayStorage=Contiguous [contentsAreProven]
    v31: Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]> = AssumeType v30 provenType=Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>
    AppendElements v31, v12
    v33: anything = PropGet v28 key="item"
    AppendElement v31, v33
    Jump -> next b12(v29, v31)
  b11():
    Unreachable
  b12(v35: anything ~ undefined|number, v36: undefined|Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>):
    LoopHint [replacesTailCalls]
    v38: boolean = TypeTest v35 testedType=undefined
