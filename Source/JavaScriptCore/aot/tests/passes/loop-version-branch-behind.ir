# The branch that hands on what the test narrowed stands behind the loop, the test inside it. With three copies of the loop the condition would be a parameter, which proves nothing:
# such a loop gets no version. Only the blocks of the loop are searched for branches whose condition has to stay a test, and that rests on this.
# FORM: Prepared
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsEnteredByAnswers = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Source" fields=[{key="take" declared={type=undefined|null|function|f1|f2 flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired] flow={occupancy=FilledAtBirth}}]
layout L1 fields=[{key="done" declared={type=Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]> flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired, IsEnforced]}, {key="at" declared={type=number} flags=[IsRequired, IsEnforced]}]
layout L2 fields=[{key="item" declared={type=anything flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired, IsEnforced] flow={occupancy=FilledAtBirth}}, {key="at" declared={type=number} flags=[IsRequired, IsEnforced] flow={occupancy=FilledAtBirth}}]

