  b0(v0: anything ~ undefined|null|Buffer, v1: anything ~ undefined|null|L0, v2: anything ~ number, v3: anything ~ undefined|number, v4: undefined|Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>):
    Jump -> next b12(v3, v4)
  b1():
    v5: 0 = Integer
    Jump -> next b3(v5)
  b2(v6: null|boolean|number|string|symbol|bigint|object ~ number):
    Jump -> next b3(v6)
  b3(v7: null|boolean|number|string|symbol|bigint|object ~ number):
    v8: boolean = TypeTest v36 testedType=undefined
    Branch v8 -> taken b4(), notTaken b5(| 0)
  b4():
    v9: Array<anything, Contiguous> = NewArray contents=anything arrayStorage=Contiguous [contentsAreProven]
    v10: Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]> = AssumeType v9 provenType=Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>
    Jump -> next b6(v10)
  b5(v11: Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>):
    Jump -> next b6(v11)
  b6(v12: Array<anything, proven, Contiguous, pristine[Storage, Names, Dense]>):
    v13: int[0, 4294967295] = CallBuiltin v12 overload=ArrayPrototypeLength/0
    v14: boolean = StrictEq v13, v2
    Branch v14 -> taken b7(), notTaken b8()
  b7():
    v15: 0 = Integer
    v16: L1 = NewObject -, v12, v15 layout=L1 fields=[0, 1]
    PropSet v16, v7 key="at"
    v18: L1 = FinishObject v16
    Return v18
  b8():
    v19: boolean|number|string|symbol|bigint|object ~ L0 = RequireObjectCoercible v1 name="take"
    v20: anything ~ undefined|null|function|f1|f2 = PropGet v19 key="take"
    v21: boolean = TypeTest v20 testedType=f2
    v22: boolean = StrictEq v13, v7
    Branch v22 -> taken b16(), notTaken b13()
  b9():
