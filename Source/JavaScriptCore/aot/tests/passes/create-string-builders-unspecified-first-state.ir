# A first state that is Unspecified is never read, so the builder begins empty; the same shape with a string parameter appends it
# FORM: Prepared
# RUN: pass CreateStringBuilders
# STATISTIC: StringBuildersCreated = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="firstStateIsUnspecified" parameters=[{type=string}, {type=number}] results=[{type=string}] {
    v2 = Unspecified valueType=string
    v3 = Integer integer=0
    Jump -> next b1(v2, v3, v3)
  b1(v4, v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    Switch v6 cases=[0] -> case b4(), otherwise b5()
  b3():
    Switch v6 cases=[0] -> case b7(), otherwise b8()
  b4():
    Jump -> next b6(v0)
  b5():
    v9 = Specified
    v10 = AssumeType v4, v9 provenType=string
    v11 = Add v10, v0
    Jump -> next b6(v11)
  b6(v12):
    v13 = Integer integer=1
    v14 = Add v5, v13
    Jump -> next b1(v12, v14, v13)
  b7():
    Return v0
  b8():
    v15 = Specified
    v16 = AssumeType v4, v15 provenType=string
    v17 = Add v16, v0
    Return v17
}
# CHECK-LABEL: name="firstStateIsUnspecified"
# CHECK: [[h0]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: Jump -> next b1([[h0]], v3, v3)
# CHECK: b1(v4: stringbuilder, v5: int|whole, v6: {{*}}):

function f1 name="firstStateIsGiven" parameters=[{type=string}, {type=number}, {type=string}] results=[{type=string}] {
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v0
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    v11 = Add v4, v0
    Return v11
}
