# A switch on a parameter costs the one arm that stays where the site passes a constant: an integer, or a string. Where the site passes anything else every arm is charged
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# LOSS: MaxInlineHeadBytes
# STATISTIC: InlineDecisionInline = 3
# STATISTIC: InlineDecisionCostExceedsBenefit = 2
# STATISTIC: InlineBenefitFoldedCode = 3

module m0 path="main.js" displayPath="main.js"

function f0 name="byNumber" parameters=[{type=int}, {type=number}] results=[{type=number}] {
  b0(v0: int, v1: number):
    Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b4()
# REPEAT: i = 1..4
  b%(i)():
    v%(i*8-6) = Mul v1, v1
    v%(i*8-5) = Mul v%(i*8-6), v1
    v%(i*8-4) = Mul v%(i*8-5), v1
    v%(i*8-3) = Mul v%(i*8-4), v1
    v%(i*8-2) = Mul v%(i*8-3), v1
    v%(i*8-1) = Mul v%(i*8-2), v1
    v%(i*8) = Mul v%(i*8-1), v1
    v%(i*8+1) = Mul v%(i*8), v1
    Return v%(i*8+1)
# END REPEAT
}

function f1 name="byString" parameters=[{type=string}, {type=number}] results=[{type=number}] {
  b0(v0: string, v1: number):
    SwitchString v0 strings=["sum", "product", "larger"] -> case b1(), case b2(), case b3(), otherwise b4()
# REPEAT: i = 1..4
  b%(i)():
    v%(i*8-6) = Mul v1, v1
    v%(i*8-5) = Mul v%(i*8-6), v1
    v%(i*8-4) = Mul v%(i*8-5), v1
    v%(i*8-3) = Mul v%(i*8-4), v1
    v%(i*8-2) = Mul v%(i*8-3), v1
    v%(i*8-1) = Mul v%(i*8-2), v1
    v%(i*8) = Mul v%(i*8-1), v1
    v%(i*8+1) = Mul v%(i*8), v1
    Return v%(i*8+1)
# END REPEAT
}

function f2 name="passesOne" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=1
    v2 = CallDirect v1, v0 function=f0
    Return v2
}
# CHECK-LABEL: function f2 name="passesOne"
# CHECK-NOT: CallDirect

function f3 name="passesWhatNoCaseLists" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=7
    v2 = CallDirect v1, v0 function=f0
    Return v2
}
# CHECK-LABEL: function f3 name="passesWhatNoCaseLists"
# CHECK-NOT: CallDirect

function f4 name="passesSomeNumber" parameters=[{type=int}, {type=number}] results=[{type=number}] {
  b0(v0: int, v1: number):
    v2 = CallDirect v0, v1 function=f0
    Return v2
}
# CHECK-LABEL: function f4 name="passesSomeNumber"
# CHECK: = CallDirect v0, v1 function=f0

function f5 name="passesProduct" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = String string="product"
    v2 = CallDirect v1, v0 function=f1
    Return v2
}
# CHECK-LABEL: function f5 name="passesProduct"
# CHECK-NOT: CallDirect

function f6 name="passesSomeString" parameters=[{type=string}, {type=number}] results=[{type=number}] {
  b0(v0: string, v1: number):
    v2 = CallDirect v0, v1 function=f1
    Return v2
}
# CHECK-LABEL: function f6 name="passesSomeString"
# CHECK: = CallDirect v0, v1 function=f1
