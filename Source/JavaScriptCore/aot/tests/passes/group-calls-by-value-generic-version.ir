# A call whose arguments are outside the proven parameter types of a callee enters its generic version, which is no member, so the call joins no group
# FORM: AsRead
# RUN: pipeline GroupCallsByValue
# OPTIONS: check=VerifyEachPass only-passes=GroupCallsByValue,ChooseCallingConventions
# STATISTIC: FlowGenericVersions = 1
# CHECK: group g0 members=[f1, f2, f3, f4, f5, f6] sites=[{{*}}] this=[omitted] arguments=[{{*}}[fractional]]
# CHECK-NOT: group
# CHECK-NOT: generic callers none

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = CallDirect v0 function=f7
    v7 = CallDirect v1 function=f7
    v8 = CallDirect v2 function=f7
    v9 = CallDirect v3 function=f7
    v10 = CallDirect v4 function=f7
    v11 = CallDirect v5 function=f7
    v12 = CallDirect v0 function=f8
    v13 = CallDirect v1 function=f8
    v14 = CallDirect v2 function=f8
    v15 = CallDirect v3 function=f8
    v16 = CallDirect v4 function=f8
    v17 = CallDirect v5 function=f8
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="register" [isFreeName]
    v20 = Call v19, -, v5
    v21 = CallDirect function=f9
    Return
}
function f1 name="first" kind=Arrow parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f2 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f6 name="versioned" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Mul v0, v0
    v2 = Add v1, v0
    Return v2
}
# CHECK-LABEL: function f7 name="passesNumber"
# CHECK: = Call v0, -, v1 accessSite={{*}} callees=[f1, f2, f3, f4, f5, f6]
function f7 name="passesNumber" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f8 name="passesUnknownValue"
# CHECK: = Call v0, -, v2 accessSite={{*}} callees=[f1, f2, f3, f4, f5, [[generic]]]
function f8 name="passesUnknownValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName]
    v3 = Call v0, -, v2
    Return v3
}
function f9 name="padding" results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = Undefined
    v2 = Undefined
    v3 = Undefined
    v4 = Undefined
    v5 = Undefined
    v6 = Undefined
    v7 = Undefined
    v8 = Undefined
    v9 = Undefined
    v10 = Undefined
    v11 = Undefined
    v12 = Undefined
    v13 = Undefined
    v14 = Undefined
    v15 = Undefined
    v16 = Undefined
    v17 = Undefined
    v18 = Undefined
    v19 = Undefined
    v20 = Undefined
    v21 = Undefined
    v22 = Undefined
    v23 = Undefined
    v24 = Undefined
    v25 = Undefined
    v26 = Undefined
    v27 = Undefined
    v28 = Undefined
    v29 = Undefined
    v30 = Undefined
    v31 = Undefined
    v32 = Undefined
    v33 = Undefined
    v34 = Undefined
    v35 = Undefined
    v36 = Undefined
    v37 = Undefined
    v38 = Undefined
    v39 = Undefined
    Return
}
# CHECK: function [[generic]] name="versioned"{{*}}role=GenericVersion
