# A variable of a CommonJS module that is stored at most once belongs to a body that runs at most once, so it can be born as a function like a variable of an ES module. A cast between the closure and the store goes with them
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass DeferDefinitions
# STATISTIC: ClosuresDeferredInVariables = 2
# CHECK: outcome: Changed
# CHECK: variable g0 name="helper" module=m0 declared={type=f1} initialization=Function function=f1 flow={writers=AllKnown stores=Never initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g1 name="widened" module=m0 declared={type=function} initialization=Function function=f2 flow={writers=AllKnown stores=Never initialization=StoredBeforeEveryRead}
# CHECK-NEXT: variable g2 name="storedAgain" module=m0 declared={type=f3} flow={writers=AllKnown}
# CHECK-LABEL: function f0
# CHECK-NOT: function=f1
# CHECK-NOT: function=f2
# CHECK-NOT: Upcast
# CHECK: = NewClosure function=f3
# CHECK: Return

module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0
entry module=m0
variable g0 name="helper" module=m0 declared={type=f1} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g1 name="widened" module=m0 declared={type=function} flow={writers=AllKnown stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g2 name="storedAgain" module=m0 declared={type=f3} flow={writers=AllKnown}
function f0 module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    v3 = Upcast v2 castType=function
    PutModuleVariable v3 variable=g1
    v5 = NewClosure function=f3
    PutModuleVariable v5 variable=g2
    Return
}
function f1 name="helper" module=m0 results=[{type=anything}] {
    Return
}
function f2 name="widened" module=m0 results=[{type=anything}] {
    Return
}
function f3 name="storedAgain" module=m0 results=[{type=anything}] {
    Return
}
