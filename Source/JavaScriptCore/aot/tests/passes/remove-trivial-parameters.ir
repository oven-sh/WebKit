function f4 name="parameterChain" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v0)
  b3(v2):
    Jump -> next b4(v2)
  b4(v3):
    Return v3
# CHECK: b3():
# CHECK-NEXT: Jump -> next b4()
# CHECK: Return v0
}

function f5 name="opaqueParameter" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean) handler=b2():
    v2 = Call v0
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v3 = CatchException
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b5(v3)
  b4():
    Jump -> next b5(v3)
  b5(v4):
    Rethrow v4
# CHECK: b5():
# CHECK-NEXT: Rethrow v3
}

