  b1(v2):
    LoopHint
    Branch v1 -> taken b1(v2), notTaken b2()
  b2():
    Return v2
# CHECK: b1():
# CHECK: Branch v1 -> taken b1(), notTaken b2()
# CHECK: Return v0
}

