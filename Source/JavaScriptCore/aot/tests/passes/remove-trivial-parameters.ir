# A block parameter that only ever receives one value, or itself, is that value
# FORM: Prepared optimizing
# RUN: pass RemoveTrivialParameters
# STATISTIC: RemoveTrivialParametersChanges = 8

module m0 path="main.js" displayPath="main.js"
function f0 name="sameValueOnBothEdges" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v0)
  b3(v2):
    Return v2
# CHECK: Jump -> next b3()
# CHECK: b3():
# CHECK-NEXT: Return v0
}

function f1 name="itselfOverBackEdge" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
