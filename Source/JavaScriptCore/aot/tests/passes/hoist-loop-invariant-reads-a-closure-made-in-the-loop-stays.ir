# A closure is no constant: each NewClosure makes another object, so a closure compared with itself is true, and a comparison that copies its operands in front of the loop would make two objects and answer false. What the loop makes is compared in the loop.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js"
function f0 name="made" results=[{type=number}] {
    v0 = Integer integer=1
    Return v0
}

function f1 name="comparedWithItself" parameters=[{type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    v2 = NewClosure function=f0
    v3 = StrictEq v2, v2
    Branch v3 -> taken b1(), notTaken b3()
  b3():
    Return v0
# CHECK: b2():
# CHECK-NEXT: = NewClosure function=f0
# CHECK-NEXT: = StrictEq
}
