# The closure of an async function fails the test for a closure as created at run time, so the test stays
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"

function f0 name="later" flags=[IsAsync] captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f1 name="asksTheClosureOfACoroutine" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure v0 function=f0
    v3 = IsPristine v2 builtinClass=Function aspects=[Names]
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    Return v1
  b2() frequency=Unlikely:
    v5 = PropGet v2 key="call"
    v6 = Call v5, v2, v1 calleeKey="call"
    Return v6
# CHECK: = NewClosure v0 function=f0
# CHECK: = IsPristine
}
