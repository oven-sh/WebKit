# In a very large program a function that a call is only expected to reach may run, and is not compact: what a loop is expected to call, and what several functions are expected to call.
# Such callers make nothing hot
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f1 Cold 10 1
# CHECK-NEXT: f2 Cold 10 1
# CHECK-NEXT: f3 Cold 10 1
# CHECK-NEXT: f4 Compact 10 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
# REPEAT: i = 2..9
    v%(i) = NewClosure function=f%(i-1)
# END REPEAT
    v10 = Call v1, -, v2, v3, v4, v5, v6, v7, v8, v9
    Return
}

function f1 name="hasLoop" parameters=[{type=f2 flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ f2, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v0, -, v1
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v3
}

# REPEAT: f = 2..4 ; name = expectedInLoop expectedByFourFunctions expectedByNobody
function f%(f) name="%(name)" parameters=[{type=anything}] results=[{type=anything}] {
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    Return v0
}
# END REPEAT

# REPEAT: f = 5..8
function f%(f) name="caller%(f)" parameters=[{type=f3 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ f3):
    v1 = Call v0, -, v0
    Return v1
}
# END REPEAT
