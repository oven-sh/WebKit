# A slow path that comes back into a stretch without the proofs of the stretch goes on in the generic copy, so the test in front of the stretch serves the uses behind the join
# The functions are checked functions of the program, where the copy goes on behind the stretch. Behind layouts that nobody has checked it holds the stretch alone: place-type-tests-copies-in-checked-functions-are-rare.ir
# FORM: Prepared
# RUN(PLAN): test-placement
# RUN(IR): pass PlaceTypeTests
# STATISTIC: StretchesNotClonable = 0

module m0 path="main.js" displayPath="main.js"
# The type of an object and the instance it belongs to outlast unknown code. Whether a slot is filled does not.
# A field that is not always filled may be redefined here, so it may lie outside its slot: a read tests that the slot is filled.
layout L0 name="Pair" fields=[{key="a" declared={type=number} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flow={stability=[IsNeverDeleted, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="slowPathRunsUnknownCode" flags=[IsChecked] parameters=[{type=object}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: boolean, v2: anything):
    v3 = PropGet v0 key="a"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3)
  b2() frequency=Unlikely:
    v4 = Call v2
    Jump -> next b3(v4)
  b3(v5: anything):
    v6 = PropGet v0 key="a"
    v7 = Call v2, -, v5, v6
    Return v7
}
