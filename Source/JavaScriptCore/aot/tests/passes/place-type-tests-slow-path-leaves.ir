# The estimate of the branch calls the side where a reference is null unlikely. That is a guess about ordinary code: no test has failed on it, so it stays with the tests.
function f6 name="sideThatOnlyTheEstimateCallsUnlikely" flags=[IsChecked] parameters=[{type=object}, {type=null|L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: null|L0, v2: anything):
    v3 = PropGet v0 key="a"
    v4 = Null
    v5 = StrictEq v1, v4
    Branch v5 -> taken b2(), notTaken b1()
  b1():
    Jump -> next b3(v3)
  b2():
    v6 = Call v2
    Jump -> next b3(v6)
  b3(v7: anything):
    v8 = PropGet v0 key="a"
    v9 = Call v2, -, v7, v8
    Return v9
}
