# main.mjs: require("./running.mjs")        running.mjs: import "./imported.mjs"; eval(text)        built with two entry points, main.mjs and running.mjs
# No import() of the program is compiled, so a require() of an ES module would be a call of its start. But a text that the build has not read may call import() with the name of an entry point
# while the require() evaluates that entry point. The run time settles the promise of such an import() where the evaluation of the module ends, so this require() asks the run time.
# running.mjs keeps its start: the run time calls it. call-modules-where-no-text-imports-a-required-entry-point.ir and call-modules-where-text-finds-no-name-for-a-required-module.ir are the twins
# FORM: AsRead
# RUN: pipeline CallModules
# STATISTIC: ModulesWithState = 1
# STATISTIC: RequireSitesBound = 0
# CHECK: module m1 {{*}}flags=[EvaluatesItself] body=f1

module m0 path="/main.mjs" displayPath="main.mjs" body=f0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/running.mjs" displayPath="running.mjs" body=f1 requests=[{target=m2 completes=true}]
module m2 path="/imported.mjs" displayPath="imported.mjs" body=f2
entry module=m0
entry module=m1
evalscope e0
function f0 name="main" kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    Return
# CHECK-NEXT: b0():
# CHECK-NEXT: EvaluateRequiredModule module=m1 referrer=m0 specifier="/running.mjs"
# CHECK-NEXT: Return
}
function f1 name="running" module=m1 kind=Module results=[{type=anything}] {
    v0 = String string="text"
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return
}
function f2 name="imported" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
