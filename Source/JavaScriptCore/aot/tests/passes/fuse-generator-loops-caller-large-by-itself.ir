function f3 name="yieldsOnce" position=10 role=CoroutineRamp flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] creator=Coroutine{ramp=f3 body=f4 promiseParameter=2} {
  b0(v0: function, v1: anything):
    v2 = NewGenerator v0 function=f3 @10
    v3 = CallDirect v0, v1, v2 function=f4 @10
    Return v2 @10
}
function f4 name="yieldsOnce" position=10 role=CoroutineBody flags=[IsGenerator, TakesCallee] parameters=[{type=anything}, {type=Generator}] results=[{type=anything}] derivation={source=f3} creator=Coroutine{ramp=f3 body=f4 promiseParameter=2} {
  b0(v0: function, v1: anything, v2: Generator):
    v3 = Undefined @10
    v4 = YieldBySavingFrame v2, v3 @10
    v5 = ResultAt v4 index=0 @10
    v6 = ResultAt v4 index=1 @10
    Switch v6 cases=[1, 2] -> case b1(), case b2(), otherwise b3() @10
  b1() frequency=Rare:
    Throw v5 @10
  b2() frequency=Rare:
    Return v5 @10
  b3():
    v7 = YieldBySavingFrame v2, v1 @12
    v8 = ResultAt v7 index=0
    v9 = ResultAt v7 index=1
    Switch v9 cases=[1, 2] -> case b4(), case b5(), otherwise b6()
  b4() frequency=Rare:
    Throw v8
  b5() frequency=Rare:
    Return v8
  b6():
    v10 = Undefined
    Return v10
}
