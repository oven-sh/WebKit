# Flow saw one layout arrive at a read and lost track of the rest. The names that the function asks the object for say which layouts have them. Both are expected:
# a stamp that is not complete joins what the names say and does not stand for it, so the other reads of the object keep their prediction.
# Beside it: a complete stamp is all that arrives, and the names add nothing
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Element" constructor=f2 fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="props" declared={type=anything} flags=[IsRequired]}] flow={baseState=None}
layout L1 kind=Instance name="Portal" constructor=f3 fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="children" declared={type=anything} flags=[IsRequired]}] flow={baseState=None}

function f0 name="openStamp" parameters=[{type=object flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ object):
    v1 = PropGet v0 key="kind" receivers=[L1, ..]
    v2 = PropGet v0 key="props"
    Return v2
# CHECK-NEXT: b0(v0: anything ~ L0):
# CHECK: = TypeTest v0 testedType=L0|L1
# CHECK: = GetSlot {{*}} key="kind" receivers=[L0, L1] level=Expected
# CHECK: = GetSlot {{*}} key="props" receivers=[L0] level=Expected
}

function f1 name="completeStamp" parameters=[{type=object flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ object):
    v1 = PropGet v0 key="kind" receivers=[L1]
    v2 = PropGet v0 key="props"
    Return v2
# CHECK-NEXT: b0(v0: anything ~ object):
# CHECK: = TypeTest v0 testedType=L1
# CHECK: = GetSlot {{*}} key="kind" receivers=[L1] level=Expected
# CHECK-NOT: GetSlot
}

function f2 name="Element" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f3 name="Portal" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L1
