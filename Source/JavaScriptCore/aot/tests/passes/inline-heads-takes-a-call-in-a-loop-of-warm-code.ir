# The calls stand in a loop, on a way that every second turn takes: by the estimate they are warm. A loop multiplies whatever the estimate missed, so a head is copied there too,
# if only an edge that is not expected to be taken leads out of it. A head that is left as often as not would run twice
# FORM: Selected
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineHeads
# STATISTIC: SelectedHeadsFound = 2
# STATISTIC: SelectedHeadsInlined = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="caller" parameters=[{type=anything}, {type=function}, {type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v4 = CallDirect v0, v1 function=f1
    v5 = Call v1, -, v4
    v6 = CallDirect v0, v1 function=f2
    v7 = Call v1, -, v6
    Jump -> next b3()
  b3():
    v8 = Call v1
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b4()
  b4():
    Return
}
function f1 name="early" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() frequency=Unlikely:
    v3 = Call v1, -, v0
    Return v3
}
function f2 name="earlyOrNot" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Call v1, -, v0
    Return v3
}
# CHECK-LABEL: function f0 name="caller"
# CHECK: = CallDirect v0, v1 function=f1 [isAfterInlinedHead]
# CHECK: = TypeTest v0 testedType=i32
# CHECK-NOT: testedType=string
# CHECK-LABEL: function f1
