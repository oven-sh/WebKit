# function f(kind, x) { if (kind === "error") { .. } .. }: the comparison of a parameter with a text is decided where the site passes a text, as the comparison with a number is: the side that
# goes is not charged. Two texts are compared without a conversion, so all that may go wrong is a lack of memory
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 2
# STATISTIC: InlineDecisionCostExceedsBenefit = 1
# STATISTIC: InlineBenefitFoldedCode = 2

module m0 path="main.js" displayPath="main.js"

function f0 name="byText" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = String string="error"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Mul v1, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    Return v11
  b2():
    v12 = Mul v1, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    v15 = Mul v14, v1
    v16 = Mul v15, v1
    v17 = Mul v16, v1
    v18 = Mul v17, v1
    v19 = Mul v18, v1
    Return v19
}

function f1 name="passesTheText" parameters=[{type=number}] results=[{type=number}] {
    v1 = String string="error"
    v2 = CallDirect v1, v0 function=f0
    Return v2
# CHECK-NOT: CallDirect
}

function f2 name="passesAnotherText" parameters=[{type=number}] results=[{type=number}] {
    v1 = String string="data"
    v2 = CallDirect v1, v0 function=f0
    Return v2
# CHECK-NOT: CallDirect
}

function f3 name="passesSomeText" parameters=[{type=string}, {type=number}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f0
    Return v2
# CHECK: = CallDirect v0, v1 function=f0
}
