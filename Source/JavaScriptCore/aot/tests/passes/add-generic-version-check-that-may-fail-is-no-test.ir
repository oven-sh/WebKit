# Flow has seen an ordinary object arrive at the first check, one that the program only calls by the type. A test for the type would fail in ordinary runs.
# So the first value goes on as one that has no type, without an expected type. Of the second the type is still expected
# FORM: Prepared optimizing
# RUN: pass AddGenericVersion
# STATISTIC: ChecksReplacedByGuards = 2

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Rule" fields=[{key="limit" declared={type=number} flags=[IsRequired]}]
layout L1 name="Payload" fields=[{key="value" declared={type=number} flags=[IsRequired]}]

function f0 name="run" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v0 expectedType=L0 cause=MayFail
    v3 = Check v1 expectedType=L1
    v4 = PropGet v2 key="limit"
    v5 = PropGet v3 key="value"
    v6 = Less v5, v4
    Return v6
# CHECK-NOT: TypeTest
# CHECK: v2: anything = Expect v0 expectedType=anything|absent
# CHECK-NEXT: v3: anything ~ L1 = Expect v1 expectedType=L1
# CHECK-NOT: TypeTest
}
