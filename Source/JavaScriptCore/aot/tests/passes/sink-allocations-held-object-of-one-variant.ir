# What only one of two variants holds is built in the arm of that variant: in front of the switch on the tag its parts are unspecified on the other way
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="Split" fields=[{key="name" declared={type=anything}}, {key="place" declared={type=anything}}]

function f0 name="sliceOfOneVariant" parameters=[{type=string}, {type=boolean}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: boolean, v2: boolean, v3: anything):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v4)
  b2():
    v5 = Integer integer=1
    v6 = Integer integer=3
    v7 = Substring v0, v5, v6
    v8 = NewObject -, v0, v7 layout=L0 fields=[0, 1]
    Jump -> next b3(v8)
  b3(v9):
    Branch v2 -> taken b4(), notTaken b5()
  b4() frequency=Rare:
    v10 = Call v3, -, v9
    Return v10
  b5():
    Return v0
}
# CHECK-LABEL: function f0 name="sliceOfOneVariant"
# CHECK: b4() frequency=Rare:
# CHECK-NEXT: Switch [[tag]] cases=[1] -> case [[without]](), otherwise [[with]]()
# CHECK: [[without]]() frequency=Rare:
# CHECK-NEXT: = NewObject -, [[name]] layout=L0 fields=[0]
# CHECK: [[with]]() frequency=Rare:
# CHECK-NEXT: [[slice]]: string = Substring
# CHECK-NEXT: = NewObject -, [[name]], [[slice]] layout=L0 fields=[0, 1]

function f1 name="sliceMadeOnEveryWayAndNamedBehind" parameters=[{type=string}, {type=boolean}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: boolean, v2: boolean, v3: anything):
    v4 = Integer integer=1
    v5 = Integer integer=3
    v6 = Substring v0, v4, v5
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v7 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v7)
  b2():
    v8 = NewObject -, v0, v6 layout=L0 fields=[0, 1]
    Jump -> next b3(v8)
  b3(v9):
    Branch v2 -> taken b4(), notTaken b5()
  b4() frequency=Rare:
    v10 = Call v3, -, v9
    v11 = Call v3, -, v6
    Return v11
  b5():
    Return v0
}
# CHECK-LABEL: function f1 name="sliceMadeOnEveryWayAndNamedBehind"
# CHECK: b4() frequency=Rare:
# CHECK-NEXT: [[slice1]]: string = Substring
# CHECK-NEXT: Switch [[tag1]] cases=[1] -> case [[without1]](), otherwise [[with1]]()
# CHECK: = Call v3, -, [[slice1]]
# CHECK: [[with1]]() frequency=Rare:
# CHECK-NEXT: = NewObject -, [[name1]], [[slice1]] layout=L0 fields=[0, 1]
