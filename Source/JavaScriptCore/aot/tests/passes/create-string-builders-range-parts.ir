# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass CreateStringBuilders
# RUN(SELECTED): pass CreateStringBuilders Select

module m0 path="main.js" displayPath="main.js"
function f0 name="appendsSlice" parameters=[{type=string}, {type=number}] results=[{type=string}] {
  b0(v0: string, v1: number):
    v2 = String string=""
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Integer integer=1
    v9 = Add v5, v8
    v10 = CallBuiltin v0, v5, v9 overload=StringPrototypeSlice/0
    v11 = Add v4, v10
    Jump -> next b1(v11, v9)
  b3():
    Return v4
}
# CHECK-LABEL: name="appendsSlice"
# CHECK-NOT: CallBuiltin
