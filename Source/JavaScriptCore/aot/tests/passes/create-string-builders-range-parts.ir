# CHECK-NEXT: v10: string = Substring v0, [[start0]], [[end0]]
# CHECK-NEXT: StringBuilderAppend v4, v10
# CHECK-NOT: CallBuiltin
# SELECTED-LABEL: name="appendsSlice"
# SELECTED-NOT: = Substring
# SELECTED-NOT: StringPrototypeSlice
# SELECTED: StringBuilderAppendStringRange
# SELECTED-NOT: = Substring
# SELECTED-NOT: StringPrototypeSlice

