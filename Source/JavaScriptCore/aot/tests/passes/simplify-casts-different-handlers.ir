  b1():
    v2 = Integer integer=1
    Jump -> next b4(v2)
  b2() handler=b3():
    v3 = Call v0
    Jump -> next b4(v3)
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = Integer integer=0
    Return v5
  b4(v6):
    v7 = Check v6 castType=number
    Return v7
# CHECK: b2() handler=b3():
# CHECK-NEXT: v3: anything = Call v0
# CHECK-NEXT: Jump -> next b4(v3)
# CHECK: b4(v6: anything):
# CHECK-NEXT: v7: number = Check v6 castType=number
# CHECK-NEXT: Return v7
}

function f2 name="sameHandlerOtherArguments" parameters=[{type=anything}, {type=boolean}, {type=boolean}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b2()
