# A claim stays at the head of its merge block when the edge that needs it lies under another handler: the TypeError must arrive where it did
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="onlyMergeIsCovered" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3) handler=b4():
    v4 = Claim v3 castType=number
    Return v4
  b4() role=CatchHandler:
    v5 = CatchValue
    v6 = Integer integer=0
    Return v6
}
