# A check stays at the head of its merge block when the edge that needs it lies under another handler: the generic code behind a failed check runs under the handler of the block the check stands in
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="onlyMergeIsCovered" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v0)
  b3(v3) handler=b4():
    v4 = Check v3 castType=number
    Return v4
  b4() role=CatchHandler:
    v5 = CatchValue
    v6 = Integer integer=0
    Return v6
# CHECK: b2():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK-NEXT: b3(v3: anything) handler=b4():
# CHECK-NEXT: v4: number = Check v3 castType=number
# CHECK-NEXT: Return v4
}

function f1 name="onlyPredecessorIsCovered" parameters=[{type=anything}, {type=boolean}] results=[{type=number}] {
