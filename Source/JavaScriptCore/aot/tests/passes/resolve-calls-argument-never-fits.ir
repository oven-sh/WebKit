  b0(v0: string, v1: number):
    Return
}
function f1 name="takesNumberAndNumber" parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    Return
}
function f2 name="asynchronous" role=CoroutineRamp flags=[IsAsync] parameters=[{type=number site=w0}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
  b0(v0: number):
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f3
    Return v1
}
function f3 name="asynchronous" role=CoroutineBody flags=[IsAsync] parameters=[{type=number}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
  b0(v0: number, v1: undefined|Promise):
    Return
}

