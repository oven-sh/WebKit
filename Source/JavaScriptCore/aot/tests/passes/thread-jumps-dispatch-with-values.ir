# The dispatch of a state machine is skipped by every edge that passes a constant state, also where the block holds values without code: each state gets a copy of them
# FORM: Prepared
# RUN: pass ThreadJumps
# RUN(SIMPLE): pass ThreadJumps SimplifyControlFlow RemoveTrivialParameters EliminateDeadCode CompactBlocks

module m0 path="main.js" displayPath="main.js"
function f0 name="dispatchInLoopHeader" parameters=[{type=number}, {type=anything}] results=[{type=number}] {
    v2 = Integer integer=1
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    Switch v4 cases=[1, 2] -> case b2(), case b3(), otherwise b6()
  b2():
    v7 = Integer integer=0
    Jump -> next b4(v7)
  b3():
    v8 = Integer integer=1
    v9 = Add v5, v8
    Jump -> next b4(v9)
  b4(v10):
    v11 = Less v10, v0
    Branch v11 -> taken b5(), notTaken b6()
  b5():
    v12 = Call v1, -, v10
    v13 = Integer integer=2
    Jump -> next b1(v13, v10)
  b6():
    Return v0
# CHECK: Jump -> next [[first0]](v2, v3)
# CHECK: Jump -> next [[later0]](v13, v10)
# CHECK: [[first0]](
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Jump -> next b2()
# CHECK: [[later0]](
# CHECK-NEXT: LoopHint
# CHECK-NEXT: Jump -> next b3()
# SIMPLE-NOT: Switch
# SIMPLE: LoopHint
# SIMPLE-NOT: Switch
# SIMPLE: = Less
# SIMPLE-NOT: Switch
# SIMPLE: LoopHint
# SIMPLE-NOT: Switch
}

