# A check in a covered block is not seen by the handler of that block, which may be entered before the check or by it
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass InsertObjectCoercibleChecks
# STATISTIC: InsertObjectCoercibleChecksChanges = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]

function f0 name="handlerReturnsReceiver" parameters=[{type=undefined|L0}] results=[{type=undefined|L0}] {
  b0(v0: undefined|L0):
    Jump -> next b1()
  b1() handler=b3():
    v1 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b2()
  b2():
    Return v0
  b3() role=CatchHandler:
    v2 = CatchValue
    Return v0
}
# CHECK-LABEL: function f0
# CHECK: b1() handler=b3():
# CHECK-NEXT: [[check0]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK-NEXT: = PropGet [[check0]] key="x"
# CHECK: b2():
# CHECK-NEXT: Return [[check0]]
# CHECK: = CatchValue
# CHECK-NEXT: Return v0

function f1 name="handlerAccessesReceiver" parameters=[{type=undefined|L0}] results=[{type=anything}] {
  b0(v0: undefined|L0):
    Jump -> next b1()
  b1() handler=b3():
    v1 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b2()
  b2():
    Return v1
  b3() role=CatchHandler:
    v2 = CatchValue
    v3 = PropGet v0 key="x" receivers=[L0]
    Return v3
}
# CHECK-LABEL: function f1
# CHECK: b1() handler=b3():
# CHECK-NEXT: [[check1]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK-NEXT: = PropGet [[check1]] key="x"
# CHECK: = CatchValue
# CHECK-NEXT: [[again1]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK-NEXT: = PropGet [[again1]] key="x"

function f2 name="blockBelowHandler" parameters=[{type=undefined|L0}, {type=boolean}] results=[{type=undefined|L0}] {
  b0(v0: undefined|L0, v1: boolean):
    Jump -> next b1()
  b1() handler=b3():
    v2 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b2()
  b2():
    Return v0
  b3() role=CatchHandler:
    v3 = CatchValue
    Branch v1 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return
}
# CHECK-LABEL: function f2
# CHECK: [[check2]]: L0 = RequireObjectCoercible v0 name="x"
# CHECK: b2():
# CHECK-NEXT: Return [[check2]]
# CHECK: b4():
# CHECK-NEXT: Return v0

function f3 name="pathsMergeBelowHandler" parameters=[{type=undefined|L0}] results=[{type=undefined|L0}] {
  b0(v0: undefined|L0):
    Jump -> next b1()
  b1() handler=b2():
    v1 = PropGet v0 key="x" receivers=[L0]
    Jump -> next b3()
  b2() role=CatchHandler:
    v2 = CatchValue
    Jump -> next b3()
  b3():
    Return v0
}
