# A call under a handler is no tail call: the call of the function itself and the return of its result stay
# FORM: Prepared
# RUN: pass EliminateTailRecursion
# STATISTIC: TailRecursionsEliminated = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="returnsInCoveredBlock" parameters=[{type=number}] results=[{type=number}] {
    Jump -> next b1()
  b1() handler=b2():
    v1 = CallDirect v0 function=f0
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v0
# CHECK-NOT: LoopHint
# CHECK: b1() handler=b2():
# CHECK-NEXT: v1: number = CallDirect v0 function=f0
# CHECK-NEXT: Return v1
# CHECK-NOT: LoopHint
}

function f1 name="returnsBehindCoveredBlock" parameters=[{type=number}] results=[{type=number}] {
    Jump -> next b1()
  b1() handler=b3():
    v1 = CallDirect v0 function=f1
    Jump -> next b2()
  b2():
    Return v1
  b3() role=CatchHandler:
    v2 = CatchValue
    Return v0
# CHECK-NOT: LoopHint
# CHECK: b1() handler=b3():
# CHECK-NEXT: v1: number = CallDirect v0 function=f1
# CHECK-NEXT: Jump -> next b2()
# CHECK-NEXT: b2():
# CHECK-NEXT: Return v1
# CHECK-NOT: LoopHint
}

function f2 name="handlerThrowsAgain" parameters=[{type=number}] results=[{type=number}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1() handler=b3():
    v2 = CallDirect v0 function=f2
    Return v2
  b2():
    Return v0
  b3() role=CatchHandler:
    v3 = CatchException
    Rethrow v3
# CHECK-NOT: LoopHint
# CHECK: b1() handler=b3():
# CHECK-NEXT: v2: number = CallDirect v0 function=f2
# CHECK-NEXT: Return v2
# CHECK-NOT: LoopHint
}
