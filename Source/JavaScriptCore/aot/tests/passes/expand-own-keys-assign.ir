# Object.assign to an unchanged literal reads every slot of the source, then stores by name
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Empty"
layout L1 name="Options" fields=[{key=@@iterator declared={type=anything}}, {key="a" declared={type=number}}, {key=#"p"@L1 declared={type=number} flags=[IsPrivate]}, {key="b" declared={type=string}}] flow={constructorOrders=[{fields=[0, 1, 2, 3]}]}
layout L2 name="WithProto" fields=[{key="a" declared={type=number}}, {key="__proto__" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1]}]}

function f0 name="unchangedLiteral" parameters=[{type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: object ~ L1):
    v1 = NewObject layout=L0 fields=[]
    v2 = CallBuiltin -, v1, v0 overload=ObjectAssign/0
    Return v2
}
# CHECK-LABEL: function f0 name="unchangedLiteral"
# CHECK: v1:{{*}}= NewObject layout=L0
# CHECK-NEXT: = ShapeTest v0 layouts=[L1]
# CHECK: [[done0]](v2:{{*}}):
# CHECK-NEXT: Return v2
# CHECK: frequency=Rare:
# CHECK-NEXT: [[call0]]:{{*}}= CallBuiltin -, v1, v0 overload=ObjectAssign/0
# CHECK-NEXT: Jump -> next [[done0]]([[call0]])
# CHECK: = HasKeyOrder v0, {{*}} layout=L1 fields=[0, 1, 2, 3]
# CHECK: = HasNoExtraProperties v0,
# CHECK-NOT: PropSet
# CHECK: [[all0]]: guard = AllGuards
# CHECK-NEXT: [[a0]]: number = GetSlot v0, [[all0]] key="a" receivers=[L1] level=Predicted
# CHECK-NEXT: [[b0]]: string = GetSlot v0, [[all0]] key="b" receivers=[L1] level=Predicted
# CHECK-NEXT: [[iterator0]]: anything = GetSlot v0, [[all0]] key=@@iterator receivers=[L1] level=Predicted
# CHECK-NEXT: PropSet v1, [[a0]] key="a"
# CHECK-NEXT: PropSet v1, [[b0]] key="b"
# CHECK-NEXT: PropSet v1, [[iterator0]] key=@@iterator
# CHECK-NEXT: Jump -> next [[done0]](v1)
# CHECK-NOT: GetSlot
# CHECK-NOT: PropSet

function f1 name="threeSourcesFirstKnown" parameters=[{type=object predicted=L1}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L1, v1: anything, v2: anything):
    v3 = NewObject layout=L0 fields=[]
    v4 = CallBuiltin -, v3, v0, v1, v2 overload=ObjectAssign/0
    Return v4
}
# CHECK-LABEL: function f1 name="threeSourcesFirstKnown"
# CHECK: v3:{{*}}= NewObject layout=L0
# CHECK-NEXT: = ShapeTest v0 layouts=[L1]
# CHECK: Return v4
# CHECK: = CallBuiltin -, v3, v1, v2 overload=ObjectAssign/0
# CHECK: frequency=Rare:
# CHECK-NEXT: = CallBuiltin -, v3, v0, v1, v2 overload=ObjectAssign/0
# CHECK-NOT: CallBuiltin
# CHECK: PropSet v3, {{*}} key="a"
# CHECK-NOT: CallBuiltin

function f2 name="threeSourcesFirstUnknown" parameters=[{type=anything}, {type=object predicted=L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: object ~ L1, v2: anything):
    v3 = NewObject layout=L0 fields=[]
    v4 = CallBuiltin -, v3, v0, v1, v2 overload=ObjectAssign/0
    Return v4
}
# CHECK-LABEL: function f2 name="threeSourcesFirstUnknown"
# CHECK: b0(v0: anything, v1: object ~ L1, v2: anything):
# CHECK-NEXT: v3:{{*}}= NewObject layout=L0
# CHECK-NEXT: v4:{{*}}= CallBuiltin -, v3, v0, v1, v2 overload=ObjectAssign/0
# CHECK-NEXT: Return v4

function f3 name="sourceIsUnchangedAllocation" parameters=[{type=number}, {type=string}] results=[{type=anything}] {
  b0(v0: number, v1: string):
    v2 = NewObject -, v1, v0 layout=L1 fields=[3, 1]
    v3 = NewObject layout=L0 fields=[]
    v4 = CallBuiltin -, v3, v2 overload=ObjectAssign/0
    Return v4
}
# CHECK-LABEL: function f3 name="sourceIsUnchangedAllocation"
# CHECK: v3:{{*}}= NewObject layout=L0
# CHECK-NEXT: [[b3]]: string = GetSlot v2, v2 key="b" receivers=[L1] level=Predicted
# CHECK-NEXT: [[a3]]: number = GetSlot v2, v2 key="a" receivers=[L1] level=Predicted
# CHECK-NEXT: PropSet v3, [[b3]] key="b"
# CHECK-NEXT: PropSet v3, [[a3]] key="a"
# CHECK-NEXT: Jump -> next [[done3]](v3)
# CHECK-NOT: CallBuiltin

function f4 name="targetIsParameter" parameters=[{type=object predicted=L0}, {type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: object ~ L0, v1: object ~ L1):
    v2 = CallBuiltin -, v0, v1 overload=ObjectAssign/0
    Return v2
}
# CHECK-LABEL: function f4 name="targetIsParameter"
# CHECK: b0(v0: object ~ L0, v1: object ~ L1):
# CHECK-NEXT: v2:{{*}}= CallBuiltin -, v0, v1 overload=ObjectAssign/0
# CHECK-NEXT: Return v2

function f5 name="targetPassedToCallBefore" parameters=[{type=object predicted=L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L1, v1: anything):
    v2 = NewObject layout=L0 fields=[]
    v3 = Call v1, -, v2
    v4 = CallBuiltin -, v2, v0 overload=ObjectAssign/0
    Return v4
}
# CHECK-LABEL: function f5 name="targetPassedToCallBefore"
# CHECK: v3:{{*}}= Call v1, -, v2
# CHECK-NEXT: v4:{{*}}= CallBuiltin -, v2, v0 overload=ObjectAssign/0
# CHECK-NEXT: Return v4

function f6 name="targetPassedToCallBeforeSeveralSources" parameters=[{type=object predicted=L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: object ~ L1, v1: anything):
    v2 = NewObject layout=L0 fields=[]
    v3 = Call v1, -, v2
    v4 = CallBuiltin -, v2, v0, v1 overload=ObjectAssign/0
    Return v4
}
# CHECK-LABEL: function f6 name="targetPassedToCallBeforeSeveralSources"
# CHECK: v3:{{*}}= Call v1, -, v2
# CHECK-NEXT: v4:{{*}}= CallBuiltin -, v2, v0, v1 overload=ObjectAssign/0
# CHECK-NEXT: Return v4

function f7 name="targetIsPrimitive" parameters=[{type=string}, {type=object predicted=L1}, {type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: string, v1: object ~ L1, v2: object ~ L1):
    v3 = CallBuiltin -, v0, v1, v2 overload=ObjectAssign/3
    Return v3
}
# CHECK-LABEL: function f7 name="targetIsPrimitive"
# CHECK: b0(v0: string, v1: object ~ L1, v2: object ~ L1):
# CHECK-NEXT: v3:{{*}}= CallBuiltin -, v0, v1, v2 overload=ObjectAssign/3
# CHECK-NEXT: Return v3

function f8 name="targetHasPrototypeOperand" parameters=[{type=object predicted=L1}, {type=object}] results=[{type=anything}] {
  b0(v0: object ~ L1, v1: object):
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = CallBuiltin -, v2, v0 overload=ObjectAssign/0
    Return v3
}
# CHECK-LABEL: function f8 name="targetHasPrototypeOperand"
# CHECK: v2:{{*}}= NewObject v1 layout=L0
# CHECK-NEXT: v3:{{*}}= CallBuiltin -, v2, v0 overload=ObjectAssign/0
# CHECK-NEXT: Return v3

function f9 name="sourceHasFieldNamedProto" parameters=[{type=object predicted=L2}] results=[{type=anything}] {
  b0(v0: object ~ L2):
    v1 = NewObject layout=L0 fields=[]
    v2 = CallBuiltin -, v1, v0 overload=ObjectAssign/0
    Return v2
}
# CHECK-LABEL: function f9 name="sourceHasFieldNamedProto"
# CHECK: v1:{{*}}= NewObject layout=L0
# CHECK-NEXT: v2:{{*}}= CallBuiltin -, v1, v0 overload=ObjectAssign/0
# CHECK-NEXT: Return v2
