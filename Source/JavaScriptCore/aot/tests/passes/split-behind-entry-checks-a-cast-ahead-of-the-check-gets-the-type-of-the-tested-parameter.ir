# A cast may stand between a parameter and the check at the entrance: what is known of every value that arrives. Behind the tests the parameter has the tested type, and the cast has what is left of that.
# FORM: Prepared
# RUN: pass SplitBehindEntryChecks VerifyProgram
# STATISTIC: FunctionsSplitBehindEntryChecks = 1
# CHECK: outcome: Changed

module m0 path="main.ts" displayPath="main.ts" body=f0
typesite w0 module=m0 position=10 kind=Parameter

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    Return
}
function f1 name="lengthOf" module=m0 position=100 flags=[IsChecked] length=1 parameters=[{type=undefined|null|Uint16Array site=w0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ undefined|null|Uint16Array):
    v1 = AssumeType v0 provenType=TypedArray
    v2 = Check v1 expectedType=undefined|null|Uint16Array site=w0
    v3 = PropGet v2 key="length"
    Return v3
}
# CHECK: b0(v0: undefined|null|Uint16Array):
# CHECK-NEXT: v1: Uint16Array = AssumeType v0 provenType=TypedArray
# CHECK-NEXT: v2: Uint16Array = AssumeType v1 provenType=Uint16Array
