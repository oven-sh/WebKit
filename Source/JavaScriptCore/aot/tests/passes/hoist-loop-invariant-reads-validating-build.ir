# In a validating build a copy of a hoisted read stays in the header of the loop and is compared with the hoisted read in every round
# FORM: AsRead
# RUN: pipeline HoistLoopInvariantReads
# OPTIONS: only-passes=HoistLoopInvariantReads validate

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="limit" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    PutModuleVariable v1 variable=g0
    v4 = CallDirect v1, v2 function=f1
    v5 = CallDirect v1, v2 function=f1
    Return
}

function f1 name="storedOnce" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = Call v0
    Jump -> next b1()
  b3():
    Return v3
}
# CHECK-LABEL: function f1 name="storedOnce"
# CHECK: b0(
# CHECK-NEXT: v3: anything = GetModuleVariable variable=g0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[kept]]: anything = GetModuleVariable variable=g0
# CHECK-NEXT: ValidateSameValue [[kept]], v3
# CHECK-NEXT: Branch v1
