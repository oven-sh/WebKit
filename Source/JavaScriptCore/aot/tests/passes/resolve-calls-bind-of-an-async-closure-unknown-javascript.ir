# The closures of an async function inherit from another prototype than those of a plain function. Where uncompiled JavaScript can reach such a closure, the bind asks whether it is as the closures of async functions are created, and the engine binds what is not.
# FORM: AsRead
# RUN: pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=ResolveCalls,ChooseCallingConventions
# STATISTIC: BoundFunctions = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Function
    v1 = String string="return 1"
    v2 = Construct v0, -, v1
    v3 = CallDirect v2 function=f1
    Return
}
function f1 name="reaches-uncompiled-code" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1
    v3 = Undefined
    v4 = Builtin builtin=FunctionPrototypeBind
    v5 = Call v4, v1, v3
    v6 = Call v5
    Return v6
# CHECK: v1: f2 = NewClosure function=f2
# CHECK: [[isAsCreated]]: boolean = IsPristine v1 builtinClass=AsyncFunction aspects=[Names]
# CHECK-NEXT: Branch [[isAsCreated]] -> taken
# CHECK: = NewClosure v1 function=
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = CallBuiltin v1, v3 overload=FunctionPrototypeBind/0
}
function f2 name="handed-over" kind=Arrow flags=[IsAsync] results=[{type=Promise}] {
    Return
}
