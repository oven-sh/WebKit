# Two tests that each stand behind the failing edge of the other are folded together, or not at all
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="bothFresh" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    v2 = NewArray contents=anything
    v3 = NewArray contents=anything
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IsPristine v2 builtinClass=Array aspects=[Storage, Names]
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = CallBuiltin v2, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b4()
  b3() frequency=Unlikely:
    v8 = PropGet v2 key="push"
    v9 = Call v8, v2, v3 calleeKey="push"
    Jump -> next b4()
  b4():
    v10 = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
    Branch v10 -> taken b5(| 0), notTaken b6()
  b5(v11):
    v12 = CallBuiltin v3, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b7()
  b6() frequency=Unlikely:
    v13 = PropGet v3 key="push"
    v14 = Call v13, v3, v2 calleeKey="push"
    Jump -> next b7()
  b7():
    Branch v1 -> taken b1(), notTaken b8()
  b8():
    Return
}
# CHECK-LABEL: function f0 name="bothFresh"
# CHECK-NOT: IsPristine
# CHECK: b3():
# CHECK-NEXT: Unreachable
# CHECK-NOT: IsPristine
# CHECK: b6():
# CHECK-NEXT: Unreachable
# CHECK-NOT: IsPristine

function f1 name="oneFromParameter" parameters=[{type=anything}, {type=boolean}, {type=Array<anything>}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: Array<anything>):
    v3 = NewArray contents=anything
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = CallBuiltin v3, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b4()
  b3() frequency=Unlikely:
    v8 = PropGet v3 key="push"
    v9 = Call v8, v3, v2 calleeKey="push"
    Jump -> next b4()
  b4():
    v10 = IsPristine v2 builtinClass=Array aspects=[Storage, Names]
    Branch v10 -> taken b5(| 0), notTaken b6()
  b5(v11):
    v12 = CallBuiltin v2, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b7()
  b6() frequency=Unlikely:
    v13 = PropGet v2 key="push"
    v14 = Call v13, v2, v3 calleeKey="push"
    Jump -> next b7()
  b7():
    Branch v1 -> taken b1(), notTaken b8()
  b8():
    Return
}
# CHECK-LABEL: function f1 name="oneFromParameter"
# CHECK: v5: boolean = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK: v10: boolean = IsPristine v2 builtinClass=Array aspects=[Storage, Names]
# CHECK-NEXT: Branch v10 -> taken b5(| 0), notTaken b6()

function f2 name="testBehindFoldedFailingEdge" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray contents=anything
    v2 = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = CallBuiltin v1, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b6(v4)
  b2() frequency=Unlikely:
    v5 = IsPristine v1 builtinClass=Array aspects=[Storage, Names]
    Branch v5 -> taken b3(| 0), notTaken b4()
  b3(v6):
    v7 = CallBuiltin v1, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b5(v7)
  b4() frequency=Unlikely:
    v8 = PropGet v1 key="push"
    v9 = Call v8, v1, v0 calleeKey="push"
    Jump -> next b5(v9)
  b5(v10):
    Jump -> next b6(v10)
  b6(v11):
    Return v11
}
# CHECK-LABEL: function f2 name="testBehindFoldedFailingEdge"
# CHECK: [[guard2]]: guard = AllGuards v1
# CHECK-NEXT: Jump -> next b1([[guard2]])
# CHECK-NOT: IsPristine
# CHECK: b2():
# CHECK-NEXT: Unreachable
# CHECK-NOT: IsPristine
