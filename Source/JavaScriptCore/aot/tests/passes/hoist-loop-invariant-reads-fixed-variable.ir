# A variable that is stored once before every read is not clobbered by unknown code
# FORM: AsRead
# RUN: pipeline HoistLoopInvariantReads
# OPTIONS: only-passes=HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="limit" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="changing" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="bound" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g3 name="late" module=m0 declared={type=anything|absent} initialization=Uninitialized

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    PutModuleVariable v1 variable=g0
    PutModuleVariable v1 variable=g1
    v5 = CallDirect v1, v2 function=f1
    v6 = CallDirect v1, v2 function=f2
    v7 = CallDirect v1, v2 function=f3
    PutModuleVariable v5 variable=g1
    PutModuleVariable v1 variable=g2
    v10 = CallDirect v1, v2 function=f4
    v11 = CallDirect v1, v2 function=f5
    PutModuleVariable v1 variable=g3
    Return
}

function f1 name="storedOnce" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = Call v0
    Jump -> next b1()
  b3():
    Return v3
# CHECK: b0(
# CHECK-NEXT: GetModuleVariable variable=g0
# CHECK: b1():
# CHECK-NOT: GetModuleVariable
}

function f2 name="storedTwice" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g1
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = Call v0
    Jump -> next b1()
  b3():
    Return v3
# CHECK: b0(
# CHECK-NEXT: Jump -> next b1()
}

function f3 name="callBeforeRead" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Call v0
    v4 = GetModuleVariable variable=g0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return v4
# The one store stands outside every cycle, so the call in the loop is not what stores.
# CHECK: b0(
# CHECK-NEXT: GetModuleVariable variable=g0
# CHECK: b1():
# CHECK-NOT: GetModuleVariable
}

function f4 name="initializedBeforeCall" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g2
    v4 = CheckInitialized v3 name="bound"
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v5 = Call v0
    Jump -> next b1()
  b3():
    Return v4
# CHECK: b0(
# CHECK-NEXT: [[bound]]:{{*}}= GetModuleVariable variable=g2
# CHECK: b1():
# CHECK-NOT: GetModuleVariable
# CHECK: = CheckInitialized [[bound]] name="bound"
# CHECK-NOT: GetModuleVariable
}

function f5 name="initializedAfterCall" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g3
    v4 = CheckInitialized v3 name="late"
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v5 = Call v0
    Jump -> next b1()
  b3():
    Return v4
# CHECK: b0(
# CHECK-NEXT: Jump -> next b1()
# CHECK: [[late]]:{{*}}= GetModuleVariable variable=g3
# CHECK-NEXT: = CheckInitialized [[late]] name="late"
}
