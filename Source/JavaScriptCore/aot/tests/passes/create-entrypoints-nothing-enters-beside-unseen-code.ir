# Beside code that nobody has seen, the generic entrypoint that no seen code enters throws: of a member that only its group calls, and of a function that lost its body
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# OPTIONS: check=VerifyEachPass only-passes=GroupCallsByValue,ChooseCallingConventions

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = CallDirect v0 function=f7
    v7 = CallDirect v1 function=f7
    v8 = CallDirect v2 function=f7
    v9 = CallDirect v3 function=f7
    v10 = CallDirect v4 function=f7
    v11 = CallDirect v5 function=f7
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="eval" [isFreeName]
    v14 = PropGet v12 key="text" [isFreeName]
    v15 = Call v13, -, v14
    Return
}
function f1 name="calledByGroupOnly" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f6 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f7 name="apply" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=1.5
    v2 = Call v0, -, v1
    Return v2
}
# CHECK: name="calledByGroupOnly"{{*}}role=GenericEntrypoint{{*}}parameters=[{type=anything}]
# CHECK-NEXT: b0([[closure]]: f1, [[this]]: anything, [[argument]]: anything):
# CHECK-NEXT: = ThrowNewError message="Cannot call this function: nothing in the program calls it
# CHECK-NEXT: Unreachable
