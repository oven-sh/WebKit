# An entry parameter that nothing uses goes: the body moves to a function without it, direct calls go there, and the function forwards
# FORM: Prepared
# RUN: pass RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="ignoresSecond" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    Return v0
}
# CHECK-LABEL: function f0 name="ignoresSecond"
# CHECK: b0(v0: number, v1: number):
# CHECK-NEXT: [[forwarded]]: number = CallDirect v0 function=f9
# CHECK-NEXT: ReturnCall [[forwarded]] requirement=Allowed

function f1 name="ping" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = CallDirect v0, v1 function=f2
    Return v2
}
# CHECK-LABEL: function f1 name="ping"
# CHECK: = CallDirect v0 function=f10
# CHECK-NEXT: ReturnCall

function f2 name="pong" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = CallDirect v0, v1 function=f1
    ReturnCall v3
}
# CHECK-LABEL: function f2 name="pong"
# CHECK: = CallDirect v0 function=f11
# CHECK-NEXT: ReturnCall

function f3 name="forwardsToUsed" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f0
    Return v1
}
# CHECK-LABEL: function f3 name="forwardsToUsed"
# CHECK: b0(v0: number):
# CHECK-NEXT: = CallDirect v0 function=f9

function f4 name="edgeArgument" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1(v0)
  b1(v1):
    Return v1
}
# CHECK-LABEL: function f4 name="edgeArgument"
# CHECK: Jump -> next b1(v0)

function f5 name="unusedCapture" captures=[{type=number}] parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    Return v1
}
# CHECK-LABEL: function f5 name="unusedCapture"
# CHECK: = CallDirect v1 function=f12
# CHECK-NEXT: ReturnCall

function f6 name="forwardsToBodyless" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f7
    Return v1
}
# CHECK-LABEL: function f6 name="forwardsToBodyless"
# CHECK: = CallDirect v0 function=f7

function f7 name="withoutBody" parameters=[{type=number}] results=[{type=number}]

function f8 name="callsEach" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = CallDirect v0, v1 function=f1
    v3 = CallDirect v0 function=f3
    v4 = CallDirect v0 function=f4
    v5 = CallDirect v1, v0 function=f5
    v6 = CallDirect v0 function=f6
    v7 = Add v2, v3
    v8 = Add v7, v4
    v9 = Add v8, v5
    v10 = Add v9, v6
    Return v10
}
# CHECK-LABEL: function f8 name="callsEach"
# CHECK: = CallDirect v0 function=f10
# CHECK-NEXT: = CallDirect v0 function=f3
# CHECK-NEXT: = CallDirect v0 function=f4
# CHECK-NEXT: = CallDirect v0 function=f12
# CHECK-NEXT: = CallDirect v0 function=f6

# CHECK-LABEL: function f9 name="ignoresSecond"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}HasOnlyDirectCallers{{*}}derivation={source=f0 parameterMap=[{original=0}]}
# CHECK: b0(v0: number):
# CHECK-NEXT: Return v0
# CHECK-LABEL: function f10 name="ping"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f1 parameterMap=[{original=0}]}
# CHECK: b0(v0: number):
# CHECK-NEXT: = CallDirect v0 function=f11
# CHECK-LABEL: function f11 name="pong"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f2 parameterMap=[{original=0}]}
# CHECK: b0(v0: number):
# CHECK: = CallDirect v0 function=f10
# CHECK-NEXT: ReturnCall
# CHECK-LABEL: function f12 name="unusedCapture" module=m0 thisType={type=anything} parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f5 parameterMap=[{original=1}]}
# CHECK: b0([[kept]]: number):
# CHECK-NEXT: Return [[kept]]
