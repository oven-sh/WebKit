# The pass runs behind AddGenericVersion, so a typed function whose fields are checked reaches it with its generic copy in place
# TODO: nobody: with a check between two reads of the bag, the generic copy reads the bag too and the function is not promoted
# FORM: Prepared
# OPTIONS: heat=NothingIsHottest
# RUN: pass AddGenericVersion PromoteAggregateParameters
# STATISTIC: GenericVersionsCreated = 2
# STATISTIC: AggregateParametersPromoted = 2

module m0 path="main.ts" displayPath="main.ts"
typesite w0 kind=PropertyRead
typesite w1 kind=PropertyRead
layout L0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]

function f0 name="oneFieldIsChecked" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = PropGet v0 key="a" receivers=[L0]
    v3 = PropGet v0 key="b" receivers=[L0]
    v4 = Check v3 castType=number site=w0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v2, v4, v1
    Return v7
}
# CHECK-LABEL: function f0 name="oneFieldIsChecked"
# CHECK: role=ParameterWrapper

function f1 name="bothFieldsAreChecked" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    v2 = PropGet v0 key="a" receivers=[L0]
    v3 = Check v2 castType=number site=w0
    v4 = PropGet v0 key="b" receivers=[L0]
    v5 = Check v4 castType=number site=w1
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="sink" [isFreeName]
    v8 = Call v7, -, v3, v5, v1
    Return v8
}
# CHECK-LABEL: function f1 name="bothFieldsAreChecked"
# CHECK: role=ParameterWrapper

function f2 name="passesLiterals" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1, v0 function=f0
    v3 = CallDirect v1, v0 function=f1
    Return v3
}
