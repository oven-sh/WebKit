# The copy of a serializer in its caller appends to the caller's builder itself: a parameter of an opaque kind is bound to the argument without a cast, so the cursors of the copy and of the caller have one base
# OPTIONS: heat=EverythingIsHot check=VerifyEachPass
# RUN: compile
# CHECK: image not empty
# RUN(COPY): pipeline InlineCalls
# COPY-LABEL: function f0 name="main"
# COPY: [[builder]]: stringbuilder = StringBuilderBegin
# COPY-NOT: castType=stringbuilder
# COPY: = JSONAppendKey [[builder]], {{*}} string="a"
# COPY-NOT: castType=stringbuilder
# COPY: function f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Named" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    PropSet v3, v2 key="b" mode=Strict
    v5 = PropGet v0 key="JSON" [isFreeName]
    v6 = PropGet v5 key="stringify"
    v7 = Call v6, v5, v3 calleeKey="stringify"
    v8 = Call v1, -, v7
    Return
}
