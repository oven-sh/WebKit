# A reference that only the handler would read behind a call under it is read again in the handler, not kept in the frame across the call
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined flow={writers=AllKnown}

function f0 name="onlyTheHandlerReads" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PutModuleVariable v1 variable=g0
    Jump -> next b1()
  b1() handler=b3():
    v3 = CallDirect v0 function=f3
    Jump -> next b2()
  b2():
    Return v0
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = GetModuleVariable variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = StrictEq v5, v6
    Return v7
# CHECK: = CatchValue
# CHECK-NEXT: v5: anything = GetModuleVariable variable=g0
# CHECK-NEXT: v6: anything = Upcast v5
}

function f1 name="readBehindTheCallToo" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PutModuleVariable v1 variable=g0
    Jump -> next b1()
  b1() handler=b3():
    v3 = CallDirect v0 function=f3
    Jump -> next b2()
  b2():
    Return v1
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = GetModuleVariable variable=g0
    Return v5
# CHECK: = CatchValue
# CHECK-NEXT: v5: anything = Upcast v1
}

function f2 name="nothingUnderTheHandlerCalls" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PutModuleVariable v1 variable=g0
    Jump -> next b1()
  b1() handler=b3():
    v3 = RequireObjectCoercible v0
    Jump -> next b2()
  b2():
    Return v0
  b3() role=CatchHandler:
    v4 = CatchValue
    v5 = GetModuleVariable variable=g0
    Return v5
# CHECK: = CatchValue
# CHECK-NEXT: v5: anything = Upcast v1
}

function f3 name="throwsAndWritesNothing" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Throw v0
  b2():
    Return
}
# CHECK-LABEL: function f3 name="throwsAndWritesNothing"
