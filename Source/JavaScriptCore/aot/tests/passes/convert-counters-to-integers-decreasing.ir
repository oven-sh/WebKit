# A counter that steps down is bounded by a test that keeps it above an integer, and by no test that keeps it below one
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 5
# STATISTIC: ConvertCountersToIntegersChanges = 5

module m0 path="main.js" displayPath="main.js"
function f0 name="aboveVariableBound" parameters=[{type=int[0, 100]}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[-2147483648, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[down0]]: int[-2147483647, 100]):
# CHECK-NEXT: v6: int[-2147483648, 99] = Sub [[down0]], v2
}

function f1 name="addsNegativeConstant" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=-1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[0, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[down1]]: int[1, 100]):
# CHECK-NEXT: v6: int[0, 99] = Add [[down1]], v2
}

function f2 name="stepsDownByTwo" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=2
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[-1, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[down2]]: int[1, 100]):
# CHECK-NEXT: v6: int[-1, 98] = Sub [[down2]], v2
}

function f3 name="boundOnLeft" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = LessEq v1, v3
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int[-1, 100]):
# CHECK: Branch v5 -> taken b2(| 1), notTaken b3()
# CHECK-NEXT: b2([[down3]]: int[0, 100]):
# CHECK-NEXT: v6: int[-1, 99] = Sub [[down3]], v2
}

function f4 name="indexFromLastToFirst" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = GetStringLength v0
    v4 = Sub v3, v2
    Jump -> next b1(v4)
  b1(v5):
    LoopHint
    v7 = GreaterEq v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = ElemGet v0, v5
    v9 = Sub v5, v2
    Jump -> next b1(v9)
  b3():
    Return
# CHECK: v4: int[-1, 2147483646] = Sub v3, v2
# CHECK: b1(v5: int[-1, 2147483646]):
# CHECK: Branch v7 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[down4]]: int[0, 2147483646]):
# CHECK-NEXT: ElemGet v0, [[down4]]
# CHECK-NEXT: v9: int[-1, 2147483645] = Sub [[down4]], v2
}

function f5 name="testKeepsItBelow" parameters=[{type=int[0, 100]}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int|whole):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: int|whole = Sub v3, v2
}

function f6 name="increasingAboveBound" parameters=[{type=int[0, 100]}, {type=i32}] results=[{type=undefined}] {
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
# CHECK: b1(v3: int|whole):
# CHECK: Branch v5 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: v6: int|whole = Add v3, v2
}
