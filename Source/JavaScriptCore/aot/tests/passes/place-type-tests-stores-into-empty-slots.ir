# A store outside a constructor expects its slot to be filled. Where that test fails the store creates the field under the tests that the object inherits nothing of the name, and only behind those does it go by name
# FORM: AsRead
# RUN: pipeline ConvertCountersToIntegers

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Request" constructor=f1 fields=[{key="url" declared={type=anything}}]
layout L1 name="Extended" fields=[{key="extra" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="handle"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 index=1 key="redirect"
    v6 = FinishClass v1 layout=L0
    v7 = Integer integer=1
    v8 = Construct v6, v6, v7
    v9 = PropGet v8 key="handle"
    v10 = Call v9, v8, v7
    v11 = PropGet v8 key="redirect"
    v12 = Call v11, v8, v7
    v13 = NewObject -, v7 layout=L1 fields=[0]
    v14 = Builtin builtin=ObjectSetPrototypeOf
    v15 = Call v14, -, v8, v13
    v16 = PropGet v8 key="route"
    Return v16
}
function f1 name="Request" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="url" mode=Strict
    Return v3
}
function f2 name="handle" kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="route" mode=Strict
    Return
}
# CHECK-LABEL: function f2 name="handle"
# CHECK: [[isFilled]]: boolean = IsSlotFilled v0 key="route" receivers=[L0] level=Predicted
# CHECK-NEXT: Branch [[isFilled]] -> taken [[filled]](| 0), notTaken [[empty]]()
# CHECK-NEXT: [[empty]]() frequency=Unlikely:
# CHECK-NEXT: [[inherits]]: boolean = HasLayoutPrototype v0
# CHECK-NEXT: Branch [[inherits]] -> taken [[creates]](| 0), notTaken [[byName]]()
# CHECK-NEXT: [[filled]]([[filledGuard]]: guard):
# CHECK-NEXT: PutSlot v0, [[filledGuard]], v1 key="route" receivers=[L0] level=Predicted
# CHECK: [[byName]]() frequency=Rare:
# CHECK-NEXT: PropSet v0, v1 key="route"
# CHECK: [[creates]]([[guard]]: guard) frequency=Unlikely:
# CHECK-NEXT: PutSlot v0, [[guard]], v1 key="route" receivers=[L0] level=Predicted
# CHECK-NOT: HasLayoutPrototype

# The constructor fills the slot of every object, so there is nothing to test.
function f3 name="redirect" kind=Method flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="url" mode=Strict
    Return
}
# CHECK-LABEL: function f3 name="redirect"
# CHECK-NOT: IsSlotFilled
# CHECK-NOT: HasLayoutPrototype
# CHECK: PutSlot v0, -, v1 key="url" receivers=[L0] level=Proven
