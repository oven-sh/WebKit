# A try block that cannot throw loses its landing block, and then the finalizer's selector, the switch on it and the path that throws again go
# RUN: pass RemoveRedundantHandlers FoldConstants SimplifyControlFlow RemoveTrivialParameters PropagateBranchConditions HoistTestsIntoPredecessors ThreadJumps EliminateDeadCode FoldConstants SimplifyControlFlow RemoveTrivialParameters PropagateBranchConditions HoistTestsIntoPredecessors ThreadJumps EliminateDeadCode EliminateRedundantReads CompactBlocks
# RUN(SCHEDULE): pipeline CompactBlocks

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return
}

function f1 name="emptyTry" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1() handler=b3():
    Jump -> next b2()
  b2():
    v1 = Integer integer=0
    v2 = Undefined
    Jump -> next b4(v1, v2)
  b3() role=CleanupHandler:
    v3 = CatchValue
    v4 = Integer integer=1
    Jump -> next b4(v4, v3)
  b4(v5, v6):
    v7 = Call v0
    Switch v5 cases=[0] -> case b5(), otherwise b6()
  b5():
    v8 = Integer integer=2
    Return v8
  b6():
    Throw v6
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: = Call v0
# CHECK-NEXT: [[two]]: 2 = Integer integer=2
# CHECK-NEXT: Return [[two]]
# CHECK-NEXT: }
# SCHEDULE-NEXT: b0(v0: anything):
# SCHEDULE-NEXT: = Call v0
# SCHEDULE-NEXT: [[two]]: 2 = Integer integer=2
# SCHEDULE-NEXT: Return [[two]]
# SCHEDULE-NEXT: }
}

function f2 name="tryMayThrow" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1() handler=b3():
    v1 = Call v0, -, v0
    Jump -> next b2()
  b2():
    v2 = Integer integer=0
    v3 = Undefined
    Jump -> next b4(v2, v3)
  b3() role=CleanupHandler:
    v4 = CatchValue
    v5 = Integer integer=1
    Jump -> next b4(v5, v4)
  b4(v6, v7):
    v8 = Call v0
    Switch v6 cases=[0] -> case b5(), otherwise b6()
  b5():
    v9 = Integer integer=2
    Return v9
  b6():
    Throw v7
# CHECK: handler=[[landing]]():
# CHECK: = Call v0, -, v0
# CHECK: [[landing]]() role=CleanupHandler:
# CHECK-NEXT: [[caught]]: anything = CatchValue
# CHECK: Jump -> next [[finalizer]]({{*}}, [[caught]])
# CHECK: [[finalizer]]([[selector]]: int[0, 1], [[thrown]]: anything):
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Switch [[selector]] cases=[0] -> case
# CHECK: Throw [[thrown]]
# SCHEDULE: handler=[[landing]]():
# SCHEDULE: = Call v0, -, v0
# SCHEDULE: [[landing]]() role=CleanupHandler:
# SCHEDULE-NEXT: = CatchValue
# SCHEDULE: Jump -> next [[finalizer]](
# SCHEDULE: [[finalizer]]([[selector]]: int[0, 1], [[thrown]]: anything
# SCHEDULE-NEXT: = Call v0
# SCHEDULE-NEXT: Switch [[selector]] cases=[0] -> case
# SCHEDULE: Throw [[thrown]]
}

function f3 name="tryOnlyReturns" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1() handler=b3():
    v1 = Integer integer=1
    Jump -> next b2(v1)
  b2(v2):
    v3 = Integer integer=0
    v4 = Undefined
    Jump -> next b4(v3, v2, v4)
  b3() role=CleanupHandler:
    v5 = CatchValue
    v6 = Integer integer=1
    v7 = Undefined
    Jump -> next b4(v6, v7, v5)
  b4(v8, v9, v10):
    v11 = Call v0
    Switch v8 cases=[0] -> case b5(), otherwise b6()
  b5():
    Return v9
  b6():
    Throw v10
# CHECK-NEXT: b0(v0: anything):
# CHECK-NOT: Jump
# CHECK: = Call v0
