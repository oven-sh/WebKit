# In a validating build a test that a proof stands for is made again and its answer is compared. The copy of the reads for Double storage asks there for Double storage,
# also where the test is made again behind the last read
# FORM: Prepared
# OPTIONS: validate
# RUN: pass PlanArrayCapacities

module m0 path="main.js" displayPath="main.js"

function f0 name="sum" parameters=[{type=Array<number>}] results=[{type=anything}] {
    v1 = Integer
    v2 = Double number=0.5
    Jump -> next b1(v2, v1)
  b1(v3: number, v4: int[0, 4294967295]):
    LoopHint
    v6 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b7()
  b2(v8):
    v9 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v9 -> taken b3(| 0), notTaken b6()
  b3(v10):
    v11 = IsElementPresent v0, v8, v10 arrayStorage=Contiguous [keyIsIntegral]
    Branch v11 -> taken b4(| 0), notTaken b6()
  b4(v12):
    v13 = AllGuards v10, v12
    v14 = HasArrayStorage v0 arrayStorage=Contiguous
    v15 = Boolean boolean=true
    ValidateSameValue v14, v15
    v17 = GetArrayElement v0, v8, v13 arrayStorage=Contiguous level=Expected [keyIsIntegral, isPresent]
    v18 = TypeTest v17 testedType=number
    Branch v18 -> taken b5(| 0), notTaken b6()
  b5(v19):
    v20 = Add v3, v19
    v21 = Increment v8
    Jump -> next b1(v20, v21)
  b6() frequency=Rare:
    v22 = ElemGet v0, v8 [keyIsIntegral]
    Return v22
  b7():
    Return v3
# CHECK: HasArrayStorage v0 arrayStorage=Double
# CHECK: AllGuards
# CHECK-NEXT: HasArrayStorage v0 arrayStorage=Double
# CHECK-NEXT: Boolean boolean=true
# CHECK-NEXT: ValidateSameValue
# CHECK-NEXT: number = GetArrayElement v0, v8, {{*}} arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
}

function f1 name="sumAndAskAgain" parameters=[{type=Array<number>}] results=[{type=anything}] {
    v1 = Integer
    v2 = Double number=0.5
    Jump -> next b1(v2, v1)
  b1(v3: number, v4: int[0, 4294967295]):
    LoopHint
    v6 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b7()
  b2(v8):
    v9 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v9 -> taken b3(| 0), notTaken b6()
  b3(v10):
    v11 = IsElementPresent v0, v8, v10 arrayStorage=Contiguous [keyIsIntegral]
    Branch v11 -> taken b4(| 0), notTaken b6()
  b4(v12):
    v13 = AllGuards v10, v12
    v14 = GetArrayElement v0, v8, v13 arrayStorage=Contiguous level=Expected [keyIsIntegral, isPresent]
    v15 = TypeTest v14 testedType=number
    Branch v15 -> taken b5(| 0), notTaken b6()
  b5(v16):
    v17 = Add v3, v16
    v18 = HasArrayStorage v0 arrayStorage=Contiguous
    v19 = Boolean boolean=true
    ValidateSameValue v18, v19
    v21 = Increment v8
    Jump -> next b1(v17, v21)
  b6() frequency=Rare:
    v22 = ElemGet v0, v8 [keyIsIntegral]
    Return v22
  b7():
    Return v3
# CHECK: HasArrayStorage v0 arrayStorage=Double
# CHECK: Add v3
# CHECK-NEXT: HasArrayStorage v0 arrayStorage=Double
# CHECK-NEXT: Boolean boolean=true
# CHECK-NEXT: ValidateSameValue
}
