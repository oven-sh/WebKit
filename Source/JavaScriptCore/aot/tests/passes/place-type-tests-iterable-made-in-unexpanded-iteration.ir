# The call that makes what an iteration operation iterates is tested at once, also in a cycle whose other uses wait for the expansion: the expansion goes by the tests of that call
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 name="Scale" fields=[{key="k" declared={type=number} flags=[IsRequired]}]

function f0 name="iterableMadeInIteration" parameters=[{type=Array<anything, proven, pristine[Storage, Names]>}, {type=Map<string, number>}, {type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: Array<anything, proven, pristine[Storage, Names]>, v1: Map<string, number>, v2: anything ~ L0):
    v3 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v5 = IteratorResume v3
    v6 = ResultAt v5
    Branch v6 -> taken b4(), notTaken b2()
  b2():
    v7 = PropGet v2 key="k"
    v8 = PropGet v1 key="values"
    v9 = Call v8, v1 calleeKey="values"
    v10 = IteratorOpen v9
    Jump -> next b3()
  b3():
    LoopHint
    v12 = IteratorResume v10
    v13 = ResultAt v12
    Branch v13 -> taken b1(), notTaken b3()
  b4():
    Return
}
# CHECK-LABEL: function f0 name="iterableMadeInIteration"
# CHECK-NOT: testedType=L0
# CHECK: = PropGet v2 key="k"
# CHECK: : MapIterator = CallBuiltin v1 overload=MapPrototypeValues/0
# CHECK: = TypeTest {{*}} testedType=builtin(MapPrototypeValues)
# CHECK-NOT: testedType=L0
