# A variable of a loop holds one of two literal strings on the likely path and whatever a call answers on the unlikely one. A test for literal strings reads the characters of a string that is none of the program's own, so the way back out of the copy tests for a string, and the variable of the loop is a string.
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths

module m0 path="main.js" displayPath="main.js"

function f0 name="lastLabel" parameters=[{type=anything}, {type=boolean}, {type=i32}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean, v2: i32):
    v3 = Integer integer=0
    v4 = String string=""
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v8 = String string="its own"
    Jump -> next b4(v8)
  b3() frequency=Unlikely:
    v9 = Call v0, -
    Jump -> next b4(v9)
  b4(v10):
    v11 = Increment v5
    v12 = Less v11, v2
    Branch v12 -> taken b1(v11, v10), notTaken b5()
  b5():
    Return v10
# CHECK: = TypeTest {{*}} testedType=string
# CHECK-NOT: testedType=""|"its own"
}
