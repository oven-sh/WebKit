# A field of an environment that is allocated at most once is one place. Where it is stored once, with a closure that captures nothing, it becomes a variable that is born as the function: the body neither makes the closure nor stores it
# FORM: AsRead
# OPTIONS: disable=pass:PromoteEnvironmentsToVariables check=VerifyEachPass
# RUN: pipeline DeferDefinitions
# STATISTIC: ClosuresDeferredInEnvironmentFields = 1
# CHECK: variable g0 name="helper.0" module=m0 {{*}}initialization=Function function=f2 flow={writers=AllKnown stores=Never initialization=StoredBeforeEveryRead

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="wrapper" fields=[{key=@"helper.0" declared={type=anything}}, {key=@"count.1" declared={type=anything}}]
layout L1 kind=Environment name="factory" fields=[{key=@"helper.0" declared={type=anything}}, {key=@"count.1" declared={type=anything}}]

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f4
    v3 = Call v2
    v4 = Call v2
    Return
}

function f1 name="wrapper" module=m0 results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L0 fields=[1]
    v2 = NewClosure function=f2
    PutEnvironmentField v1, v2 layout=L0 field=0
    v4 = NewClosure v1 function=f3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="publish" [isFreeName]
    v7 = Call v6, -, v4
    Return
}
# CHECK-LABEL: function f1 name="wrapper"
# CHECK-NOT: function=f2
# CHECK-NOT: PutEnvironmentField
# CHECK: Return

function f2 name="helper" module=m0 results=[{type=anything}] {
  b0():
    Return
}

function f3 name="user" module=m0 captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    v2 = Call v1
    v3 = GetEnvironmentField v0 layout=L0 field=1
    Return v3
}
# CHECK-LABEL: function f3 name="user"
# CHECK: = GetModuleVariable variable=g0
# CHECK: = GetEnvironmentField v0 layout=L0 field=1

# Each call has an environment and a closure of its own
function f4 name="factory" module=m0 results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    v1 = NewObject -, v0 layout=L1 fields=[1]
    v2 = NewClosure function=f5
    PutEnvironmentField v1, v2 layout=L1 field=0
    v4 = NewClosure v1 function=f6
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="publish" [isFreeName]
    v7 = Call v6, -, v4
    Return
}
# CHECK-LABEL: function f4 name="factory"
# CHECK: = NewClosure function=f5
# CHECK-NEXT: PutEnvironmentField

function f5 name="helper" module=m0 results=[{type=anything}] {
  b0():
    Return
}

function f6 name="user" module=m0 captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = Call v1
    Return v2
}
# CHECK-LABEL: function f6 name="user"
# CHECK: : f5 = GetEnvironmentField v0 layout=L1
