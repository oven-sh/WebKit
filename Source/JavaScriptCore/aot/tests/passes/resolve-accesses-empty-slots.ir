# A field that cannot move out of its slot is in the slot or the object has no such property, so a read that finds the slot empty goes on at the prototype of the object
# FORM: Prepared
# RUN: pass ResolveAccesses

module m0 path="main.js" displayPath="main.js"
layout L0 name="Stable" fields=[{key="stays" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="other" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="moves" declared={type=number} flow={stability=[IsNeverRedefined]}}, {key="redefined" declared={type=number} flow={stability=[IsNeverStoredWithOtherType]}}, {key="filled" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="alone" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]}
layout L1 name="Loose" fields=[{key="stays" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="slotOrPrototype" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="stays"
    Return v1
}
# CHECK-LABEL: function f0 name="slotOrPrototype"
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: [[isFilled0]]: boolean = IsSlotFilled v0 key="stays" receivers=[L0]
# CHECK-NEXT: Branch [[isFilled0]] -> taken [[filled0]](| 0), notTaken [[empty0]]()
# CHECK-NOT: PropGet
# CHECK: [[filled0]]([[guard0]]: guard):
# CHECK-NEXT: [[own0]]: number = GetSlot v0, [[guard0]] key="stays" receivers=[L0]
# CHECK-NEXT: Jump -> next [[join0]]([[own0]])
# CHECK: [[empty0]]():
# CHECK-NEXT: [[prototype0]]: null|object = GetSuperBase v0
# CHECK-NEXT: [[hasPrototype0]]: boolean = TypeTest [[prototype0]] testedType=object
# CHECK-NEXT: Branch [[hasPrototype0]] -> taken [[chain0]](| 0), notTaken [[end0]](| 0)
# CHECK: [[chain0]]([[holder0]]: object):
# CHECK-NEXT: [[inherited0]]: anything = SuperGet [[holder0]], v0 key="stays"
# CHECK-NEXT: Jump -> next [[join0]]([[inherited0]])
# CHECK: [[end0]]({{*}}: null) frequency=Unlikely:
# CHECK-NEXT: [[nothing0]]: undefined = Undefined
# CHECK-NEXT: Jump -> next [[join0]]([[nothing0]])

function f1 name="twoReadsInOneBlock" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="stays"
    v2 = PropGet v0 key="filled"
    v3 = PropGet v0 key="other"
    v4 = Add v1, v3
    v5 = Add v4, v2
    Return v5
}
# CHECK-LABEL: function f1 name="twoReadsInOneBlock"
# CHECK-NOT: PropGet
# CHECK: = IsSlotFilled v0 key="stays"
# CHECK: = SuperGet {{*}}, v0 key="other"
# CHECK: = GetSlot v0 key="filled"
# CHECK-NEXT: = IsSlotFilled v0 key="other"
# CHECK: = SuperGet {{*}}, v0 key="stays"

function f2 name="valueOfAnotherTypeMovesTheFieldOut" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="moves"
    Return v1
}
# CHECK-LABEL: function f2 name="valueOfAnotherTypeMovesTheFieldOut"
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: v1:{{*}}= PropGet v0 key="moves"
# CHECK-NEXT: Return v1

function f3 name="redefinitionMovesTheFieldOut" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="redefined"
    Return v1
}
# CHECK-LABEL: function f3 name="redefinitionMovesTheFieldOut"
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: v1:{{*}}= PropGet v0 key="redefined"
# CHECK-NEXT: Return v1

function f4 name="prototypesHaveNothingUnderTheName" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="alone"
    Return v1
}
# CHECK-LABEL: function f4 name="prototypesHaveNothingUnderTheName"
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: v1:{{*}}= GetSlotOrUndefined v0 key="alone"
# CHECK-NEXT: Return v1

function f5 name="receiverIsPredicted" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="stays"
    Return v1
}
# CHECK-LABEL: function f5 name="receiverIsPredicted"
# CHECK-NEXT: b0(v0: object ~ L0):
# CHECK-NEXT: v1:{{*}}= PropGet v0 key="stays"
# CHECK-NEXT: Return v1

function f6 name="shapeMayBeLost" parameters=[{type=object predicted=L1}] results=[{type=anything}] {
  b0(v0: object ~ L1):
    v1 = PropGet v0 key="stays"
    Return v1
}
# CHECK-LABEL: function f6 name="shapeMayBeLost"
# CHECK-NEXT: b0(v0: object ~ L1):
# CHECK-NEXT: v1:{{*}}= PropGet v0 key="stays"
# CHECK-NEXT: Return v1
