# Tests of the parts stand between the concatenations of one expression. The outer concatenation absorbs the inner one of an earlier block where one edge alone leads into every block between them,
# and an edge that leaves with the inner string makes it itself, as does a block beside the way that reads it. A string that may be too long is not made later than an effect,
# a handler keeps what it covers, and a string with another reader on the way stays
# FORM: Prepared
# RUN: pass FuseConcatenations
# STATISTIC: ConcatenationsFused = 6

module m0 path="main.js" displayPath="main.js"
function f0 name="testBetween" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    v4 = TypeTest v1 testedType=number
    Branch v4 -> taken b1(| 0), notTaken b2(v3)
  b1(v5: number):
    v6 = Add v3, v5
    Return v6
  b2(v7: string) frequency=Unlikely:
    v8 = Add v7, v1
    Return v8
# CHECK: b0(v0: number, v1: anything):
# CHECK-NOT: = Add
# CHECK: Branch v4 -> taken b1(| 0), notTaken [[edge0]]()
# CHECK: b1(v5: number):
# CHECK-NEXT: string = Strcat v0, v2, v5
# CHECK: [[edge0]]() frequency=Unlikely:
# CHECK-NEXT: [[copy0]]: string = Add v0, v2
# CHECK-NEXT: Jump -> next b2([[copy0]])
}

function f1 name="callBetweenShortParts" parameters=[{type=number}, {type=function}, {type=boolean}] results=[{type=anything}] {
    v3 = String string=":"
    v4 = Add v0, v3
    v5 = Call v1
    Jump -> next b1()
  b1():
    v6 = Add v4, v2
    Return v6
# CHECK-NOT: = Add
# CHECK: string = Strcat v0, v3, v2
}

function f2 name="callBetweenLongParts" parameters=[{type=string}, {type=function}, {type=string}] results=[{type=anything}] {
    v3 = Add v0, v2
    v4 = Call v1
    Jump -> next b1()
  b1():
    v5 = Add v3, v2
    Return v5
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f3 name="threeBlocks" parameters=[{type=number}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = String string=","
    v4 = Add v0, v3
    v5 = TypeTest v1 testedType=number
    Branch v5 -> taken b1(| 0), notTaken b3(v4)
  b1(v6: number):
    v7 = Add v4, v6
    v8 = TypeTest v2 testedType=number
    Branch v8 -> taken b2(| 0), notTaken b3(v7)
  b2(v9: number):
    v10 = Add v7, v9
    Return v10
  b3(v11: string) frequency=Unlikely:
    Return v11
# CHECK: b2(v9: number):
# CHECK-NEXT: string = Strcat v0, v3, v6, v9
# CHECK: [[first3]]: string = Add v0, v3
# CHECK-NEXT: Jump -> next b3([[first3]])
# CHECK: [[second3]]: string = Strcat v0, v3, v6
# CHECK-NEXT: Jump -> next b3([[second3]])
}

function f4 name="joinBetween" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b2()
  b2():
    v4 = Add v3, v0
    Return v4
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f5 name="readOnTheWay" parameters=[{type=number}, {type=function}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    Jump -> next b1()
  b1():
    v4 = Call v1, -, v3
    v5 = Add v3, v0
    Return v5
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f6 name="passedAlongTheWay" parameters=[{type=number}] results=[{type=anything}] {
    v1 = String string=","
    v2 = Add v0, v1
    Jump -> next b1(v2)
  b1(v3: string):
    v4 = Add v2, v0
    v5 = Add v4, v3
    Return v5
# CHECK: b0(v0: number):
# CHECK: = Add v0, v1
# CHECK: b1(v3: string):
# CHECK-NEXT: string = Strcat v2, v0, v3
}

function f7 name="underHandler" parameters=[{type=number}, {type=function}] results=[{type=anything}] {
  b0(v0: number, v1: function) handler=b2():
    v2 = String string=","
    v3 = Add v0, v2
    Jump -> next b1()
  b1() handler=b2():
    v4 = Add v3, v0
    Return v4
  b2() role=CatchHandler:
    v5 = CatchValue
    Return v5
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f8 name="inLoop" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    Jump -> next b1()
  b1():
    LoopHint
    v5 = Add v3, v0
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v5
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f9 name="leavesBehindTheOuter" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    Jump -> next b1()
  b1():
    v4 = Add v3, v0
    Branch v1 -> taken b2(v3), notTaken b2(v4)
  b2(v5: string):
    Return v5
# CHECK-COUNT-2: = Add
# CHECK-NOT: Strcat
}

function f10 name="readBesideTheWay" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = String string=","
    v3 = Add v0, v2
    v4 = TypeTest v1 testedType=number
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5: number):
    v6 = Add v3, v5
    Return v6
  b2() frequency=Unlikely:
    v7 = Add v3, v1
    v8 = Add v7, v3
    Return v8
# CHECK: b0(v0: number, v1: anything):
# CHECK-NOT: = Add
# CHECK: b1(v5: number):
# CHECK-NEXT: string = Strcat v0, v2, v5
# CHECK: b2() frequency=Unlikely:
# CHECK-NEXT: [[copy10]]: string = Add v0, v2
# CHECK-NEXT: = Add [[copy10]], v1
# CHECK-NEXT: = Add v7, [[copy10]]
}

function f11 name="longPartsReadBesideTheWay" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
    v2 = Add v0, v0
    v3 = TypeTest v1 testedType=number
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: number):
    v5 = Add v2, v4
    Return v5
  b2() frequency=Unlikely:
    v6 = Add v2, v1
    Return v6
# CHECK: b0(v0: string, v1: anything):
# CHECK-NEXT: string = Add v0, v0
# CHECK-NOT: Strcat
}
