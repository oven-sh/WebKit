function f7 name="emptyBlockInCycle" parameters=[{type=function}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    v2 = Call v0
    v3 = ToBoolean v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return
# CHECK: Branch v3 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b1()
}

function f8 name="parameterFilledByEdge" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Jump -> next b3(v3)
  b2():
    v4 = Negate v1
    Jump -> next b3(v4)
  b3(v5):
    Return v5
# CHECK: Branch v2 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v3: number):
# CHECK-NEXT: Jump -> next b3(v3)
}

function f9 name="parameterFilledByArgument" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(v1), notTaken b2()
  b1(v2):
    Jump -> next b3(v2)
  b2():
    v3 = Negate v1
    Jump -> next b3(v3)
  b3(v4):
    Return v4
# CHECK: Branch v0 -> taken b1(v1), notTaken b2()
# CHECK-NEXT: b1(v2: number):
# CHECK-NEXT: Jump -> next b3(v2)
}
