# An edge of a branch or a switch into a block that only jumps goes straight to the target of the jump, with the arguments of the jump
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 5
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="branchIntoEmptyBlock" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    v3 = Negate v2
    Jump -> next b3(v3)
  b3(v4):
    Return v4
# CHECK: Branch v0 -> taken b3(v1), notTaken b2()
# CHECK-NOT: Jump -> next b3(v1)
# CHECK: = Negate v2
# CHECK-NEXT: Jump -> next b3(v3)
# CHECK: b3(v4: number):
# CHECK-NEXT: Return v4
}

function f1 name="bothEdgesIntoEmptyBlocks" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    Jump -> next b3(v2)
  b3(v3):
    Return v3
# CHECK: Branch v0 -> taken b3(v1), notTaken b3(v2)
# CHECK-NOT: Jump
}

function f2 name="switchIntoEmptyBlocks" parameters=[{type=i32}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    Jump -> next b4(v1)
  b2():
    v3 = Negate v2
    Jump -> next b4(v3)
  b3():
    Jump -> next b4(v2)
  b4(v4):
    Return v4
# CHECK: Switch v0 cases=[0, 1] -> case b4(v1), case b2(), otherwise b4(v2)
}

function f3 name="rareBlockBeforeRareTarget" parameters=[{type=boolean}, {type=number}, {type=number}] results=[{type=number}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    Jump -> next b3(v1)
  b2() frequency=Rare:
    v3 = Negate v2
    Jump -> next b3(v3)
  b3(v4) frequency=Rare:
    Return v4
# CHECK: Branch v0 -> taken b3(v1), notTaken b2()
}

