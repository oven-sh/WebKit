# The depth limit bounds what each level of inlining adds to the caller: a body that costs no more than its call is copied in at any depth
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: InlineDecisionInline = 5
# STATISTIC: InlineDecisionDepthLimit = 3
# LOSS: MaxInlineDepth x3 f5 v2
# LOSS: MaxInlineHeadBytes x1 f2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Box" fields=[{key="value" declared={type=number} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled}}]

function f0 name="accessor" kind=Getter flags=[HasThis] thisType={type=L0} results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="value" receivers=[L0]
    Return v1
}
function f1 name="forwarder" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = CallDirect v1, v0 function=f2
    Return v2
}
function f2 name="manyOperations" parameters=[{type=number}, {type=number}] results=[{type=number}] {
  b0(v0: number, v1: number):
    v2 = Mul v0, v1
    v3 = Mul v2, v1
    v4 = Mul v3, v1
    v5 = Mul v4, v1
    v6 = Mul v5, v1
    v7 = Mul v6, v1
    v8 = Mul v7, v1
    v9 = Mul v8, v1
    v10 = Mul v9, v1
    v11 = Mul v10, v1
    v12 = Mul v11, v1
    v13 = Mul v12, v1
    v14 = Mul v13, v1
    v15 = Mul v14, v1
    v16 = Mul v15, v1
    v17 = Mul v16, v1
    v18 = Mul v17, v1
    v19 = Mul v18, v1
    v20 = Mul v19, v1
    Return v20
}
function f3 name="fourOperations" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Mul v0, v0
    v2 = Mul v1, v0
    v3 = Mul v2, v0
    v4 = Mul v3, v0
    Return v4
}

function f4 name="accessorAtDepthFour" parameters=[{type=L0}] results=[{type=anything}] inlineFrames=[{}, {callee=f2 module=m0}, {callee=f2 parent=1 module=m0}, {callee=f2 parent=2 module=m0}, {callee=f2 parent=3 module=m0}] {
  b0(v0: L0):
    v1 = CallDirect v0 function=f0 @0:4
    Return v1
}
# CHECK-LABEL: name="accessorAtDepthFour"
# CHECK-NOT: CallDirect
# CHECK: = PropGet v0 key="value"

function f5 name="forwarderAtDepthFour" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f3 module=m0}, {callee=f3 parent=1 module=m0}, {callee=f3 parent=2 module=m0}, {callee=f3 parent=3 module=m0}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f1 @0:4
    Return v1
}
# CHECK-LABEL: name="forwarderAtDepthFour"
# CHECK-NOT: function=f1
# CHECK: = CallDirect {{*}} function=f2

function f6 name="fourOperationsAtDepthThree" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f2 module=m0}, {callee=f2 parent=1 module=m0}, {callee=f2 parent=2 module=m0}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f3 @0:3
    Return v1
}
# CHECK-LABEL: name="fourOperationsAtDepthThree"
# CHECK-NOT: CallDirect

function f7 name="fourOperationsAtDepthFour" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f2 module=m0}, {callee=f2 parent=1 module=m0}, {callee=f2 parent=2 module=m0}, {callee=f2 parent=3 module=m0}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f3 @0:4
    Return v1
}
# CHECK-LABEL: name="fourOperationsAtDepthFour"
# CHECK: = CallDirect {{*}} function=f3
# CHECK-NEXT: Return

function f8 name="secondCallOfManyOperations" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0, v0 function=f2
    Return v1
}

# A body with one call site moves into its caller and is no level
function f9 name="calledOnce" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Mul v0, v0
    Return v1
}
function f10 name="onlyCallerOfCalledOnce" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f9
    Return v1
}
function f11 name="fourOperationsInsideFourMovedBodies" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f9 module=m0}, {callee=f9 parent=1 module=m0}, {callee=f9 parent=2 module=m0}, {callee=f9 parent=3 module=m0}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f3 @0:4
    Return v1
}
# CHECK-LABEL: name="fourOperationsInsideFourMovedBodies"
# CHECK-NOT: CallDirect

# A moved body inside a copy is part of the copy
function f12 name="fourOperationsInsideMovedBodiesOfCopy" parameters=[{type=number}] results=[{type=number}] inlineFrames=[{}, {callee=f2 module=m0}, {callee=f9 parent=1 module=m0}, {callee=f9 parent=2 module=m0}, {callee=f9 parent=3 module=m0}] {
  b0(v0: number):
    v1 = CallDirect v0 function=f3 @0:4
    Return v1
}
# CHECK-LABEL: name="fourOperationsInsideMovedBodiesOfCopy"
# CHECK: = CallDirect {{*}} function=f3
# CHECK-NEXT: Return
