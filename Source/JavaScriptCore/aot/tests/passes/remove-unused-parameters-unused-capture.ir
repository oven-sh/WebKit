# A capture that nothing reads goes from the reduced function and from direct calls, and a closure keeps naming the function with all its captures
# FORM: Prepared
# RUN: pass RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]

function f0 name="ignoresFirstCapture" kind=Arrow captures=[{type=env L0}, {type=number}] parameters=[{type=number}] results=[{type=number}] {
  b0(v0: env L0, v1: number, v2: number):
    v3 = Add v1, v2
    Return v3
}
# CHECK-LABEL: function f0 name="ignoresFirstCapture"{{*}}captures=[{type=env L0}, {type=number}] thisType={type=anything} parameters=[{type=number}]
# CHECK: b0(v0: env L0, v1: number, v2: number):
# CHECK-NEXT: [[forwarded]]: number = CallDirect v1, v2 function=f3
# CHECK-NEXT: ReturnCall [[forwarded]] requirement=Allowed

function f1 name="readsCapture" kind=Arrow captures=[{type=env L0}] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: env L0, v1: number):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = Add v2, v1
    Return v3
}
# CHECK-LABEL: function f1 name="readsCapture"{{*}}captures=[{type=env L0}]
# CHECK: b0(v0: env L0, v1: number):
# CHECK-NEXT: = GetEnvironmentField v0

function f2 name="callsAndCloses" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v1 layout=L0 fields=[0] @10
    v3 = CallDirect v2, v0, v0 function=f0
    v4 = NewObject -, v1 layout=L0 fields=[0] @20
    v5 = CallDirect v4, v3 function=f1
    v6 = NewObject -, v5 layout=L0 fields=[0] @30
    v7 = NewClosure v6, v0 function=f0
    Return v7
# CHECK-NEXT: b0(v0: number, v1: anything):
# CHECK-NEXT: [[sum]]: number = CallDirect v0, v0 function=f3
# CHECK-NEXT: [[read]]: env L0 = NewObject -, v1 layout=L0
# CHECK-NEXT: [[result]]: anything = CallDirect [[read]], [[sum]] function=f1
# CHECK-NEXT: [[closedOver]]: env L0 = NewObject -, [[result]] layout=L0
# CHECK-NEXT: = NewClosure [[closedOver]], v0 function=f0
}

# CHECK-LABEL: function f3 name="ignoresFirstCapture"{{*}}captures=[{type=number}] thisType={type=anything} parameters=[{type=number}] results=[{type=number}]{{*}}HasOnlyDirectCallers{{*}}derivation={source=f0 parameterMap=[{original=1}, {original=2}]}
# CHECK: b0([[capture]]: number, [[parameter]]: number):
# CHECK-NEXT: = Add [[capture]], [[parameter]]
