# A second run finds nothing: a reduced function uses all it takes, and a function that only forwards is left alone
# FORM: Prepared
# OPTIONS: disable=pass:RemoveUnusedParameters disable-in=3:1
# RUN: pass RemoveUnusedParameters RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 2
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="ignoresSecond" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    Return v0
# CHECK: b0(v0: number, v1: number):
# CHECK-NEXT: [[forwarded]]: number = CallDirect v0 function=f4
# CHECK-NEXT: ReturnCall [[forwarded]]
}

function f1 name="passesSecondToItself" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = TypeTest v0 testedType=i32
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = CallDirect v0, v1 function=f1
    Return v3
# CHECK: b0(v0: number, v1: number):
# CHECK-NEXT: = CallDirect v0 function=f5
# CHECK-NEXT: ReturnCall
}

function f2 name="caller" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f0
    v3 = CallDirect v2, v1 function=f1
    Return v3
# CHECK: [[first]]: number = CallDirect v0 function=f4
# CHECK-NEXT: = CallDirect [[first]] function=f5
}

function f3 name="callerThatMayNotChange" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f0
    Return v2
# CHECK: = CallDirect v0, v1 function=f0
}

# CHECK-LABEL: function f4 name="ignoresSecond"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f0 parameterMap=[{original=0}]}
# CHECK: b0(v0: number):
# CHECK-NEXT: Return v0
# CHECK-LABEL: function f5 name="passesSecondToItself"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f1 parameterMap=[{original=0}]}
# CHECK: b0(v0: number):
# CHECK: = CallDirect v0 function=f5
# CHECK-NOT: function f6
