  b3(v8):
    Jump -> next b4(v2, v4)
  b4(v9, v10):
    LoopHint
    v12 = Less v9, v8
    Branch v12 -> taken b5(), notTaken b11()
  b5():
    Jump -> next b6(v9, v10)
  b6(v13, v14):
    LoopHint
    v16 = Greater v13, v2
    Branch v16 -> taken b7(), notTaken b8()
  b7():
    v17 = Integer integer=1
    v18 = RShift v13, v17
    v19 = BitXor v14, v18
    Jump -> next b6(v18, v19)
  b8():
    v20 = StrictEq v14, v8
    Branch v20 -> taken b9(), notTaken b10()
  b9() frequency=Rare:
    v21 = Call v1, -, v14
    Jump -> next b10()
  b10():
    v22 = Increment v9
    Jump -> next b4(v22, v14)
  b11():
    Jump -> next b16(v10)
  b12() frequency=Rare:
    Jump -> next b13(v2, v4)
  b13(v23, v24) frequency=Rare:
    LoopHint
    v26 = Less v23, v3
    Branch v26 -> taken b14(), notTaken b15()
  b14() frequency=Rare:
    v27 = BitXor v24, v23
    v28 = Increment v23
    Jump -> next b13(v28, v27)
  b15() frequency=Rare:
    Jump -> next b16(v24)
  b16(v29):
    v30 = Call v1, -, v29
    v31 = ToNumber v30
    Jump -> next b1(v31, v29)
  b17():
    Return v4
}

