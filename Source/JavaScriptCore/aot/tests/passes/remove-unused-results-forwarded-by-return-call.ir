# A call whose whole list is returned hands every result to callers this function does not see, so each counts as read
# FORM: Prepared
# RUN: pass RemoveUnusedResults
# STATISTIC: UnusedResultsRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="forwardedWhole" role=ResultWorker parameters=[{type=int}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f1} {
  b0(v0: int):
    v1 = Add v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f0 name="forwardedWhole"{{*}}results=[{type=number}, {type=number}] 
# CHECK: [[sum]]:{{*}}= Add v0, v0
# CHECK-NEXT: [[product]]:{{*}}= Mul v0, v0
# CHECK-NEXT: = Results [[sum]], [[product]]

function f1 name="forwardedWhole" role=ResultWrapper parameters=[{type=int}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f0}

function f2 name="readOneByOne" role=ResultWorker parameters=[{type=int}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f3} {
  b0(v0: int):
    v1 = Add v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f2 name="readOneByOne"{{*}}results=[{type=number}] 
# CHECK-NOT: = Mul
# CHECK-NOT: = Results

function f3 name="readOneByOne" role=ResultWrapper parameters=[{type=int}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f2}

function f4 name="returnsTheCall" role=ResultWorker parameters=[{type=int}] results=[{type=number}, {type=number}] creator=ResultWorker{origin=f5} {
  b0(v0: int):
    v1 = CallDirect v0 function=f0
    Return v1
}
# CHECK-LABEL: function f4 name="returnsTheCall"{{*}}results=[{type=number}, {type=number}] 
# CHECK: [[whole]]:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: Return [[whole]]

function f5 name="returnsTheCall" role=ResultWrapper parameters=[{type=int}] results=[{type=Array<number>}] creator=ResultWrapper{worker=f4}

function f6 name="readsFirstOfEach" parameters=[{type=int}] results=[{type=number}] {
  b0(v0: int):
    v1 = CallDirect v0 function=f4
    v2 = ResultAt v1 index=0
    v3 = CallDirect v0 function=f2
    v4 = ResultAt v3 index=0
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f6 name="readsFirstOfEach"
# CHECK: [[both]]:{{*}}= CallDirect v0 function=f4
# CHECK-NEXT: [[first]]: number = ResultAt [[both]]
# CHECK-NEXT: [[single]]: number = CallDirect v0 function=f2
# CHECK-NEXT: = Add [[first]], [[single]]
