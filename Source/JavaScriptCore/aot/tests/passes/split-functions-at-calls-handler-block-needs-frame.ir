# A block that names a handler needs a frame, whatever it holds
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="coveredBlockHoldsOnlyTest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() handler=b4():
    v2 = TypeTest v0 testedType=string
    Jump -> next b3()
  b3():
    Return v2
  b4() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
# CHECK-LABEL: function f0 name="coveredBlockHoldsOnlyTest"
# CHECK-NOT: handler=
# CHECK: Branch v1 -> taken b1(), notTaken [[leaving]]()
# CHECK: [[leaving]]():
# CHECK-NEXT: [[rest]]: anything = CallDirect v0 function=f3
# CHECK-NEXT: ReturnCall [[rest]]
# CHECK-NOT: requirement=Allowed
# CHECK-NOT: handler=

function f1 name="sameBlockWithoutHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v2 = TypeTest v0 testedType=string
    Jump -> next b3()
  b3():
    Return v2
}
# CHECK-LABEL: function f1 name="sameBlockWithoutHandler"
# CHECK-NOT: CallDirect
# CHECK: TypeTest v0 testedType=string
# CHECK-NOT: CallDirect

function f2 name="entryBlockNamesHandler" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function) handler=b3():
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Call v1, -, v0
    Return v3
  b3() role=CatchHandler:
    v4 = CatchValue
    Return v4
}
# CHECK-LABEL: function f2 name="entryBlockNamesHandler"
# CHECK-NOT: CallDirect
# CHECK: = Call v1, -, v0
# CHECK-NOT: CallDirect

# CHECK-LABEL: function f3 name="coveredBlockHoldsOnlyTest" module=m0 role=Continuation{{*}}parameters=[{type=anything}] results=[{type=anything}]{{*}}derivation={source=f0{{*}}} creator=Continuation{origin=f0}
# CHECK: handler=[[handler]]():
# CHECK-NEXT: TypeTest {{*}}testedType=string
# CHECK: [[handler]]() role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NOT: function f4
