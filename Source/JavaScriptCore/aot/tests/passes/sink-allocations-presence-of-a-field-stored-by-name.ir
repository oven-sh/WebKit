# A field that never leaves its slot is present in an object that is never built once a value was stored under its key by name
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="StaysInSlot" fields=[{key="n" declared={type=undefined|null|boolean|number|string|object} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="MayLeaveSlot" fields=[{key="n" declared={type=undefined|null|boolean|number|string|object} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined]}}]

function f0 name="storedOnBothPaths" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: number):
    PutSlotOrAdd v1, -, v3 key="n" receivers=[L0] level=Proven
    Jump -> next b3()
  b2() frequency=Rare:
    PropSet v1, v0 key="n" mode=Strict receivers=[L0]
    Jump -> next b3()
  b3():
    v6 = IsSlotFilled v1 key="n" receivers=[L0] level=Proven
    Return v6
# CHECK-NOT: NewObject
# CHECK: b2() frequency=Rare:
# CHECK-NEXT: [[stored0]]: undefined|null|boolean|number|string|object = AssumeType v0 provenType=undefined|null|boolean|number|string|object
# CHECK-NEXT: Jump -> next b3([[stored0]])
# CHECK-NOT: BitAnd
# CHECK: [[present0]]: true = Boolean boolean=true
# CHECK-NEXT: v6: boolean = Upcast [[present0]]
# CHECK-NEXT: Return v6
}

function f1 name="storedOnTheRarePathAlone" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewObject layout=L0
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b2(), notTaken b1()
  b1() frequency=Rare:
    PropSet v1, v0 key="n" mode=Strict receivers=[L0]
    v4 = IsSlotFilled v1 key="n" receivers=[L0] level=Proven
    Return v4
  b2():
    v5 = IsSlotFilled v1 key="n" receivers=[L0] level=Proven
    Return v5
# CHECK-NOT: NewObject
# CHECK: b1() frequency=Rare:
# CHECK: [[present1]]: true = Boolean boolean=true
# CHECK-NEXT: v4: boolean = Upcast [[present1]]
# CHECK: b2():
# CHECK-NEXT: [[absent1]]: false = Boolean
# CHECK-NEXT: v5: boolean = Upcast [[absent1]]
}

function f2 name="askedWhetherTheFieldLeftItsSlot" parameters=[{type=anything}, {type=boolean}] results=[{type=boolean}] {
    Branch v1 -> taken b4(), notTaken b1()
  b1() frequency=Rare:
    v2 = NewObject layout=L1
    PropSet v2, v0 key="n" mode=Strict receivers=[L1]
    v4 = HasNoFieldOutsideSlot v2
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: guard) frequency=Rare:
    v6 = IsSlotFilled v2, v5 key="n" receivers=[L1] level=Proven
    Return v6
  b3() frequency=Rare:
    v7 = PropHas v2 key="n" receivers=[L1]
    Return v7
  b4():
    Return v1
# CHECK-NOT: NewObject
# CHECK: b1() frequency=Rare:
# CHECK-NEXT: [[inSlots2]]: false = Boolean
# CHECK: b3() frequency=Rare:
# CHECK-NEXT: [[present2]]: true = Boolean boolean=true
# CHECK-NEXT: v7: boolean = Upcast [[present2]]
}

function f3 name="readBySlotBehindTheTest" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b3(), notTaken b1()
  b1() frequency=Rare:
    v2 = NewObject layout=L0
    PropSet v2, v0 key="n" mode=Strict receivers=[L0]
    v4 = IsSlotFilled v2 key="n" receivers=[L0] level=Proven
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: guard) frequency=Rare:
    v6 = GetSlot v2, v5 key="n" receivers=[L0] level=Proven
    Return v6
  b3():
    Return v1
# CHECK-NOT: NewObject
# CHECK: b1() frequency=Rare:
# CHECK-NEXT: [[stored3]]: undefined|null|boolean|number|string|object = AssumeType v0 provenType=undefined|null|boolean|number|string|object
# CHECK-NOT: GetSlot
# CHECK: v6: undefined|null|boolean|number|string|object = Upcast [[stored3]]
# CHECK-NEXT: Return v6
}
