function f10 name="nothing-is-expected" parameters=[{type=anything}, {type=f0}] results=[{type=anything}] {
  b0(v0: anything, v1: f0):
    v2 = InstanceOf v0, v1
    Return v2
}
# CHECK-LABEL: function f10 name="nothing-is-expected"
# CHECK-NEXT: b0(v0: anything, v1: f0):
# CHECK-NEXT: = AreMembersUnchanged conditions=[{{*}}layout=L0 side=Static key=@@hasInstance}, {kind=PrototypeLinkUnchanged layout=L0 side=Static}]
# CHECK: [[prototype10]]:{{*}}= GetClassPrototype v1 layout=L0
# CHECK-NEXT: v2: boolean = HasInPrototypeChain v0, [[prototype10]]
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = InstanceOf v0, v1
function f11 name="prototype-object-may-be-shared" parameters=[{type=L3 flags=[IsExpected]}, {type=f0}] results=[{type=anything}] {
  b0(v0: anything ~ L3, v1: f0):
    v2 = InstanceOf v0, v1
    Return v2
}
# CHECK-LABEL: function f11 name="prototype-object-may-be-shared"
# CHECK-NOT: = TypeTest
# CHECK: = HasInPrototypeChain v0,
# CHECK-NOT: = TypeTest
function f12 name="Other" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f13 name="unrelated-constructor-function" parameters=[{type=L2 flags=[IsExpected]}, {type=f0}] results=[{type=anything}] {
  b0(v0: anything ~ L2, v1: f0):
    v2 = InstanceOf v0, v1
    Return v2
}
