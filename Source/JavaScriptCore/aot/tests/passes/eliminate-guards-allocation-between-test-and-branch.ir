# An allocation that stands between a test and its branch becomes a proof: under a handler the block is cut behind it, and the guard of the test lasts across the cut
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Kept" fields=[{key="a" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="underHandler" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
  b0(v0: object, v1: number):
    Jump -> next b1()
  b1() handler=b7():
    v2 = ShapeTest v0 layouts=[L0]
    v3 = NewObject -, v1 layout=L1 fields=[0]
    Branch v2 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Jump -> next b3()
  b3():
    LoopHint
    v7 = ShapeTest v3 layouts=[L1]
    Branch v7 -> taken b4(| 0), notTaken b6()
  b4(v8):
    v9 = GetSlot v3, v8 key="a" receivers=[L1] level=Predicted
    v10 = ToBoolean v9
    Branch v10 -> taken b3(), notTaken b5()
  b5():
    Return v9
  b6():
    Return v0
  b7() role=CatchHandler:
    v11 = CatchValue
    Return v11
}
# CHECK-LABEL: function f0 name="underHandler"
# CHECK: b1() handler=b7():
# CHECK-NEXT: v2: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: v3:{{*}}= NewObject -, v1 layout=L1 fields=[0]
# CHECK-NEXT: [[proof0]]: guard = AllGuards v3
# CHECK-NEXT: Jump -> next [[rest0]]()
# CHECK-NEXT: b2(v4: guard):
# CHECK-NEXT: v5: number = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
# CHECK-NOT: ShapeTest
# CHECK: [[rest0]]() handler=b7():
# CHECK-NEXT: Branch v2 -> taken b2(| 0), notTaken b3([[proof0]])

function f1 name="withoutHandler" parameters=[{type=object}, {type=number}] results=[{type=anything}] {
  b0(v0: object, v1: number):
    Jump -> next b1()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    v3 = NewObject -, v1 layout=L1 fields=[0]
    Branch v2 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Jump -> next b3()
  b3():
    LoopHint
    v7 = ShapeTest v3 layouts=[L1]
    Branch v7 -> taken b4(| 0), notTaken b6()
  b4(v8):
    v9 = GetSlot v3, v8 key="a" receivers=[L1] level=Predicted
    v10 = ToBoolean v9
    Branch v10 -> taken b3(), notTaken b5()
  b5():
    Return v9
  b6():
    Return v0
}
# CHECK-LABEL: function f1 name="withoutHandler"
# CHECK: b1():
# CHECK-NEXT: v2: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: v3:{{*}}= NewObject -, v1 layout=L1 fields=[0]
# CHECK-NEXT: [[proof1]]: guard = AllGuards v3
# CHECK-NEXT: Branch v2 -> taken b2(| 0), notTaken b3([[proof1]])
# CHECK-NOT: ShapeTest
