# In a very large program the callers of a function are counted at the entry that the engine has put in front of it. The body behind that entry has one caller and runs as often as the entry;
# what the body calls in its turn is judged by its own callers, and the body behind an entry that few call stays cold. So does the body of an async function, which waits between its steps.
# FORM: Prepared
# OPTIONS: limit=MaxWarmCodeValues:1
# RUN: pass EstimateHeat
# CHECK: f1 Hot 90 100
# CHECK-NEXT: f2 Hot 90 100
# CHECK-NEXT: f3 Cold 10 1
# CHECK-NEXT: f4 Cold 10 1
# CHECK-NEXT: f5 Cold 10 1
# CHECK: f10 Hot 90 100
# CHECK-NEXT: f11 Cold 10 1
# CHECK: thresholds: cold=4 hot=50

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v0 function=f6
    v4 = CallDirect v0 function=f7
    v5 = CallDirect v0 function=f8
    v6 = CallDirect v0 function=f9
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="entryCalledByFourFunctions" role=ParameterWrapper parameters=[{type=anything}] results=[{type=anything}] creator=ParameterWrapper{body=f2 parameter=0} {
  b0(v0: anything):
    v1 = CallDirect v0 function=f2
    Return v1
}

function f2 name="bodyBehindThatEntry" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f3
    Return v1
}

function f3 name="calledByTheBodyAlone" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f4 name="entryCalledByOneFunction" role=ParameterWrapper parameters=[{type=anything}] results=[{type=anything}] creator=ParameterWrapper{body=f5 parameter=0} {
  b0(v0: anything):
    v1 = CallDirect v0 function=f5
    Return v1
}

function f5 name="bodyBehindTheOtherEntry" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f6 name="firstCaller" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f4
    v3 = CallDirect v0 function=f10
    Return v0
}

function f7 name="secondCaller" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f10
    Return v0
}

function f8 name="thirdCaller" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f10
    Return v0
}

function f9 name="fourthCaller" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f10
    Return v0
}

function f10 name="entryOfAnAsyncFunction" role=ParameterWrapper parameters=[{type=anything}] results=[{type=anything}] creator=ParameterWrapper{body=f11 parameter=0} {
  b0(v0: anything):
    v1 = CallDirect v0 function=f11
    Return v1
}

function f11 name="asyncBody" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
