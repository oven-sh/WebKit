# An array under construction and the direct stores into it get one storage kind, from the types of what is stored
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# RUN(TWICE): pass PlanArrayCapacities PlanArrayCapacities
# CHECK: outcome: Changed
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="int32Stores" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=i32}] results=[{type=Array<anything>}] {
  b0(v0: int[0, 100], v1: Array<anything>, v2: i32):
    v3 = NewArrayLike v0, v1
    v4 = Integer integer=0
    v5 = TryPutByValDirect v3, v4, v2
    v6 = Integer integer=1
    v7 = TryPutByValDirect v3, v6, v2
    Return v3
}
# CHECK-LABEL: function f0
# CHECK: v3: {{*}} = NewArrayLike v0, v1 arrayStorage=Int32
# CHECK: v5: {{*}} = TryPutByValDirect v3, v4, v2 arrayStorage=Int32
# CHECK: v7: {{*}} = TryPutByValDirect v3, v6, v2 arrayStorage=Int32
# TWICE-LABEL: function f0
# TWICE: v3: {{*}} = NewArrayLike v0, v1 arrayStorage=Int32
# TWICE: v5: {{*}} = TryPutByValDirect v3, v4, v2 arrayStorage=Int32
# TWICE: v7: {{*}} = TryPutByValDirect v3, v6, v2 arrayStorage=Int32

function f1 name="numberStores" parameters=[{type=int[0, 100]}, {type=i32}, {type=number}] results=[{type=Array<anything>}] {
  b0(v0: int[0, 100], v1: i32, v2: number):
    v3 = NewArrayWithCapacity v0
    v4 = Integer integer=0
    v5 = TryPutByValDirect v3, v4, v1
    v6 = Integer integer=1
    v7 = TryPutByValDirect v3, v6, v2
    Return v3
}
# CHECK-LABEL: function f1
# CHECK: v3: {{*}} = NewArrayWithCapacity v0 arrayStorage=Double
# CHECK: v5: {{*}} = TryPutByValDirect v3, v4, v1 arrayStorage=Double
# CHECK: v7: {{*}} = TryPutByValDirect v3, v6, v2 arrayStorage=Double

function f2 name="mixedStores" parameters=[{type=int[0, 100]}, {type=i32}, {type=string}] results=[{type=Array<anything>}] {
  b0(v0: int[0, 100], v1: i32, v2: string):
    v3 = NewArrayWithCapacity v0
