# CHECK-NOT: arrayStorage=

function f3 name="noStores" parameters=[{type=int[0, 100]}] results=[{type=Array<anything>}] {
  b0(v0: int[0, 100]):
    v1 = NewArrayWithCapacity v0
    Return v1
}
# CHECK-LABEL: function f3
# CHECK-NOT: arrayStorage=

function f4 name="storeThroughCasts" parameters=[{type=int[0, 100]}, {type=Array<anything>}, {type=number}] results=[{type=Array<anything>}] {
  b0(v0: int[0, 100], v1: Array<anything>, v2: number):
    v3 = NewArrayLike v0, v1
    v4 = Upcast v3 castType=anything
    v5 = Claim v4 castType=Array<anything>
    v6 = Integer integer=0
    v7 = TryPutByValDirect v5, v6, v2
    Return v3
}
# CHECK-LABEL: function f4
# CHECK: v3: {{*}} = NewArrayLike v0, v1 arrayStorage=Double
# CHECK: v7: {{*}} = TryPutByValDirect v5, v6, v2 arrayStorage=Double

function f5 name="storeThroughBlockParameter" parameters=[{type=boolean}, {type=int[0, 100]}, {type=i32}, {type=string}] results=[{type=Array<anything>}] {
  b0(v0: boolean, v1: int[0, 100], v2: i32, v3: string):
    v4 = NewArrayWithCapacity v1
    v5 = Integer integer=0
    v6 = TryPutByValDirect v4, v5, v2
    Branch v0 -> taken b1(), notTaken b2(v4)
  b1():
    v7 = NewArrayWithCapacity v1
    Jump -> next b2(v7)
  b2(v8):
    v9 = Integer integer=1
    v10 = TryPutByValDirect v8, v9, v3
    Return v8
}
# CHECK-LABEL: function f5
# CHECK: v4: {{*}} = NewArrayWithCapacity v1 arrayStorage=Int32
# CHECK: v6: {{*}} = TryPutByValDirect v4, v5, v2 arrayStorage=Int32
