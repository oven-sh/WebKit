# function keeps() { kept = async () => 1 }   show(typeof kept): nobody calls the async function, so it has no body, is never split, and its closure has no form in the frame: keeps() needs no plan of what lies where.
# The closure has no captures and is never compared with another of its function: the program runs with the closure that the closure table holds, as it does where the planner runs.
# With VerifyEachPass the plan that is made without the planner is compared with the planner's.
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass disable=pass:InlineCalls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0, -
    v2 = Call v0, -
    v3 = GetModuleVariable variable=g0
    v4 = TypeOf v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="show" [isFreeName]
    v7 = Call v6, -, v4
    Return
}

function f1 name="keeps" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-LABEL: function f1 name="keeps"
# CHECK: = NewClosure function=f2 {{*}}[isHeldByClosureTable]

function f2 name="kept" kind=Arrow flags=[IsAsync] results=[{type=Promise}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
