# What a parameter wrapper does itself lies in a frame of the body, so that a stack captured by a getter shows the function
# FORM: Prepared
# RUN: pass PromoteAggregateParameters
# STATISTIC: AggregateParametersPromoted = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 fields=[{key="a" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}, {key="b" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={impossibleMutations=[DeleteField, RedefineProperty]}

function f0 name="readsByName" position=10 parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="a" receivers=[L0] @20
    v2 = PropGet v0 key="b" receivers=[L0] @30
    v3 = Builtin builtin=GlobalThis @40
    v4 = PropGet v3 key="sink" [isFreeName] @40
    v5 = Call v4, -, v1, v2 @40
    Return v5 @40
}
# CHECK-LABEL: function f0 name="readsByName"
# CHECK: role=ParameterWrapper {{*}}inlineFrames=[{}, {callee=[[namedBody]] callPosition=10 module=m0}]
# CHECK: = PropGet v0 key="a" {{*}}@20:1
# CHECK: = PropGet v0 key="b" {{*}}@30:1
# CHECK: = CallDirect {{*}}function=[[namedBody]] @20
# CHECK-NEXT: ReturnCall {{*}}@20

function f1 name="readsSlots" position=50 parameters=[{type=L1}] results=[{type=anything}] {
  b0(v0: L1):
    v1 = GetSlot v0 key="a" receivers=[L1] level=Proven @60
    v2 = GetSlot v0 key="b" receivers=[L1] level=Proven @70
    v3 = Builtin builtin=GlobalThis @80
    v4 = PropGet v3 key="sink" [isFreeName] @80
    v5 = Call v4, -, v1, v2 @80
    Return v5 @80
}
# CHECK-LABEL: function f1 name="readsSlots"
# CHECK: role=ParameterWrapper
# CHECK-NOT: inlineFrames
# CHECK: = GetSlot v0 key="a" {{*}}@60
# CHECK-NEXT: = GetSlot v0 key="b" {{*}}@70

function f2 name="passesLiterals" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = CallDirect v1 function=f0
    v3 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v4 = FinishObject v3
    v5 = CallDirect v4 function=f1
    Return v5
}
