# The initial yield becomes a suspension like any other, followed by a switch on the mode, and the arms of every mode but Next are rare
# FORM: Prepared
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="suspendsAtOnce" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    InitialYield @10
    v3 = Call v1 @11
    Return v3
}
function f1 name="callsFirst" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    v2 = Call v1 @20
    InitialYield @21
    v4 = Call v2 @22
    Return v4
}
function f2 name="asyncGenerator" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] {
  b0(v0: function, v1: anything):
    InitialYield @30
    v3 = Call v1 @31
    Return v3
}
function f3 name="yieldsWithModeArms" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    InitialYield @40
    v3 = Yield v1 @41
    v4 = ResultAt v3 index=0
    v5 = ResultAt v3 index=1
    Switch v5 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v4
  b2():
    Return v4
  b3():
    v6 = Yield v4 @42
    v7 = ResultAt v6 index=0
    v8 = ResultAt v6 index=1
    Switch v8 cases=[1, 2] -> case b4(), case b5(), otherwise b5()
  b4():
    Throw v7
  b5():
    Switch v7 cases=[1, 2] -> case b6(), case b7(), otherwise b8()
  b6():
    Return v1
  b7():
    Return v7
  b8():
    Return v4
}
function f4 name="throwsBeforeItsInitialYield" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    Throw v1
}
function f5 name="suspendsInLaterBlock" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] {
  b0(v0: function, v1: anything):
    v2 = TypeTest v1 testedType=undefined
    Branch v2 -> taken b1(), notTaken b2(v1)
  b1():
    v3 = Call v0 @50
    Jump -> next b2(v3)
  b2(v4):
    InitialYield @51
    Return v4
}

