# A direct call that is not inlined and passes one known function for a parameter that the callee calls goes to a copy of the callee for that function.
# In the copy the parameter has that function as its type. Two calls that pass the same function share a copy
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# STATISTIC: CalleeVersions = 3
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="double" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v0
    Return v1
}
function f1 name="negate" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Negate v0
    Return v1
}
function f2 name="apply" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = Call v0, -, v1
    v3 = Add v2, v1
    v4 = Add v3, v1
    v5 = Add v4, v1
    v6 = Add v5, v1
    v7 = Add v6, v1
    v8 = Add v7, v1
    v9 = Add v8, v1
    v10 = Add v9, v1
    v11 = Add v10, v1
    v12 = Add v11, v1
    v13 = Add v12, v1
    v14 = Add v13, v1
    Return v14
}
function f3 name="keep" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = Add v1, v1
    v3 = Add v2, v1
    v4 = Add v3, v1
    v5 = Add v4, v1
    v6 = Add v5, v1
    v7 = Add v6, v1
    v8 = Add v7, v1
    v9 = Add v8, v1
    v10 = Add v9, v1
    v11 = Add v10, v1
    v12 = Add v11, v1
    v13 = Add v12, v1
    Return v0
}
function f4 name="applyInFewOperations" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
function f5 name="applyDouble" parameters=[{type=f0}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0, v1: anything):
    v2 = Call v0, -, v1
    v3 = Add v2, v1
    v4 = Add v3, v1
    v5 = Add v4, v1
    v6 = Add v5, v1
    v7 = Add v6, v1
    v8 = Add v7, v1
    v9 = Add v8, v1
    v10 = Add v9, v1
    v11 = Add v10, v1
    v12 = Add v11, v1
    v13 = Add v12, v1
    v14 = Add v13, v1
    Return v14
}
function f6 name="repeat" parameters=[{type=function}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: boolean):
    v3 = Call v0, -, v1
    v4 = Add v3, v1
    v5 = Add v4, v1
    v6 = Add v5, v1
    v7 = Add v6, v1
    v8 = Add v7, v1
    v9 = Add v8, v1
    v10 = Add v9, v1
    v11 = Add v10, v1
    v12 = Add v11, v1
    v13 = Add v12, v1
    v14 = Add v13, v1
    v15 = Add v14, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v16 = CallDirect v0, v15, v2 function=f6
    Return v16
  b2():
    Return v15
}

function f7 name="passesKnownFunctions" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = NewClosure function=f1
    v3 = CallDirect v1, v0 function=f2
    v4 = CallDirect v2, v0 function=f2
    v5 = CallDirect v1, v0 function=f2
    Return v5
}
# CHECK-LABEL: function f7 name="passesKnownFunctions"
# CHECK: v3{{*}}= CallDirect v1, v0 function=[[forDouble]]
# CHECK-NEXT: v4{{*}}= CallDirect v2, v0 function=[[forNegate]]
# CHECK-NEXT: v5{{*}}= CallDirect v1, v0 function=[[forDouble]]

function f8 name="passesUnknownFunction" parameters=[{type=function}, {type=anything}] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = CallDirect v0, v1 function=f2
    Return v2
}
# CHECK-LABEL: function f8 name="passesUnknownFunction"
# CHECK: = CallDirect v0, v1 function=f2

function f9 name="passesOneOfTwoFunctions" parameters=[{type=f0|f1}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1, v1: anything):
    v2 = CallDirect v0, v1 function=f2
    Return v2
}
# CHECK-LABEL: function f9 name="passesOneOfTwoFunctions"
# CHECK: = CallDirect v0, v1 function=f2

function f10 name="calleeDoesNotCallTheParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = CallDirect v1, v0 function=f3
    v3 = CallDirect v1, v0 function=f3
    Return v3
}
# CHECK-LABEL: function f10 name="calleeDoesNotCallTheParameter"
# CHECK: = CallDirect v1, v0 function=f3
# CHECK-NEXT: = CallDirect v1, v0 function=f3

function f11 name="callIsInlined" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = CallDirect v1, v0 function=f4
    Return v2
}
# CHECK-LABEL: function f11 name="callIsInlined"
# CHECK-NOT: CallDirect

function f12 name="parameterHasThatFunctionAsItsType" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f0
    v2 = CallDirect v1, v0 function=f5
    v3 = CallDirect v1, v0 function=f5
    Return v3
}
# CHECK-LABEL: function f12 name="parameterHasThatFunctionAsItsType"
# CHECK: = CallDirect v1, v0 function=f5
# CHECK-NEXT: = CallDirect v1, v0 function=f5

function f13 name="calleeCallsItself" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewClosure function=f0
    v3 = CallDirect v2, v0, v1 function=f6
    Return v3
}
# CHECK-LABEL: function f13 name="calleeCallsItself"
# CHECK: = CallDirect v2, v0, v1 function=[[repeatForDouble]]
# CHECK: function [[forDouble]] name="apply" {{*}}role=CalleeVersion {{*}}parameters=[{type=f0}, {type=anything}] {{*}}derivation={source=f2{{*}}creator=Version{provenVersion=f2}
# CHECK-NEXT: b0(v0: f0, v1: anything):
# CHECK-NEXT: = Call v0, -, v1
# CHECK: function [[forNegate]] name="apply" {{*}}role=CalleeVersion {{*}}parameters=[{type=f1}, {type=anything}] {{*}}derivation={source=f2 {{*}}node=1 {{*}}creator=Version{provenVersion=f2}
# CHECK-NEXT: b0(v0: f1, v1: anything):
# CHECK-NEXT: = Call v0, -, v1
# CHECK: function [[repeatForDouble]] name="repeat" {{*}}role=CalleeVersion {{*}}parameters=[{type=f0}, {type=anything}, {type=boolean}] {{*}}derivation={source=f6{{*}}creator=Version{provenVersion=f6}
# CHECK-NEXT: b0(v0: f0, v1: anything, v2: boolean):
# CHECK: = CallDirect v0, v15, v2 function=f6
# CHECK-NOT: role=CalleeVersion
