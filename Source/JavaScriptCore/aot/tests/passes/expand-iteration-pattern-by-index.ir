# A pattern over an array whose elements are proven to be plain data, with nothing between its steps that could change the array, reads element i at step i: no position, no state that says the iterator is done. Without the proof, or with a call between the steps, each step tests the state and the length
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 10

module m0 path="main.js" displayPath="main.js"
variable g0 name="target" module=m0 declared={type=anything} initialization=Undefined

function f0 name="plainData" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b4():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = IteratorResume v1 stepIndex=1
    v5 = ResultAt v4 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    Jump -> next b3()
  b3():
    v7 = Add v3, v5
    Return v7
  b4() role=IterationCleanup subject=v1:
    v8 = CatchException
    IteratorClose v1 completion=Throw
    Rethrow v8
# CHECK-NOT: Branch
# CHECK: [[zero0]]: 0 = Integer
# CHECK: = ElemGet v0, [[zero0]] [keyIsIntegral]
# CHECK-NOT: Branch
# CHECK: [[one0]]: 1 = Integer integer=1
# CHECK: = ElemGet v0, [[one0]] [keyIsIntegral]
# CHECK-NOT: Branch
}

function f1 name="doneIsRead" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=1 [isDestructuring]
    Jump -> next b1()
  b1():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2
    Jump -> next b2()
  b2():
    IteratorClose v1
    Return v3
# CHECK: [[inRange1]]: boolean = Less {{*}},
# CHECK-NEXT: [[done1]]: boolean = LogicalNot [[inRange1]]
# CHECK: Jump -> next [[after1]]([[done1]],
# CHECK: Return [[result1]]
# CHECK: [[after1]]([[result1]]: boolean,
}

function f2 name="elementsMayBeAccessors" parameters=[{type=Array<number, pristine[Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = IteratorResume v1 stepIndex=1
    v5 = ResultAt v4 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    v7 = Add v3, v5
    Return v7
# CHECK: [[inRange2]]: boolean = Less
# CHECK-NEXT: Branch [[inRange2]]
}

function f3 name="callBetweenTheSteps" parameters=[{type=Array<number, pristine[Storage, Names]>}, {type=function}] results=[{type=anything}] {
    v2 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v3 = IteratorResume v2 stepIndex=0
    v4 = ResultAt v3 index=1
    v5 = Call v1
    v6 = IteratorResume v2 stepIndex=1
    v7 = ResultAt v6 index=1
    Jump -> next b2()
  b2():
    IteratorClose v2
    v9 = Add v4, v7
    Return v9
# CHECK: [[inRange3]]: boolean = Less
# CHECK-NEXT: Branch [[inRange3]]
}

function f4 name="testedArray" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = IteratorResume v1 stepIndex=1
    v5 = ResultAt v4 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    v7 = Add v3, v5
    Return v7
# The elements are tested with the names, on the edge that leads to the copy for any iterable
# CHECK: = TypeTest v0 testedType=Array
# CHECK: = ElemGet [[array4]], {{*}} [keyIsIntegral]
# CHECK: = DestructureIterable
# CHECK: ([[array4]]: Array):
# CHECK-NEXT: = IsPristine [[array4]] builtinClass=Array aspects=[Storage, Names]
# CHECK: = ElemGet [[array4]], {{*}} [keyIsIntegral]
}

function f5 name="testsBetweenTheSteps" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b4():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = RequireObjectCoercible v3 nullishAccess=Read
    v5 = IteratorResume v1 stepIndex=1
    v6 = ResultAt v5 index=1
    v7 = RequireObjectCoercible v6 nullishAccess=Read
    Jump -> next b2()
  b2():
    IteratorClose v1
    Jump -> next b3()
  b3():
    v9 = Add v4, v7
    Return v9
  b4() role=IterationCleanup subject=v1:
    v10 = CatchException
    IteratorClose v1 completion=Throw
    Rethrow v10
# A test that throws changes no array, and closing the iterator of an array does nothing
# CHECK-NOT: Branch
# CHECK-NOT: handler=
# CHECK: = ElemGet v0, {{*}} [keyIsIntegral]
# CHECK-NOT: Branch
# CHECK: v4: {{*}} = RequireObjectCoercible v3
# CHECK-NOT: Branch
# CHECK: = ElemGet v0, {{*}} [keyIsIntegral]
# CHECK-NOT: Branch
}

function f6 name="storeElsewhereBetweenTheSteps" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    PutModuleVariable v3 variable=g0
    v5 = IteratorResume v1 stepIndex=1
    v6 = ResultAt v5 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    Return v6
# CHECK-NOT: Branch
# CHECK: = ElemGet v0, {{*}} [keyIsIntegral]
# CHECK-NOT: Branch
# CHECK: PutModuleVariable v3 variable=g0
# CHECK-NOT: Branch
# CHECK: = ElemGet v0, {{*}} [keyIsIntegral]
# CHECK-NOT: Branch
}

function f7 name="lengthStoredBetweenTheSteps" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    PropSet v0, v3 key="length" mode=Strict
    v5 = IteratorResume v1 stepIndex=1
    v6 = ResultAt v5 index=1
    Jump -> next b2()
  b2():
    IteratorClose v1
    Return v6
# CHECK: [[inRange7]]: boolean = Less
# CHECK-NEXT: Branch [[inRange7]]
}

function f8 name="elementStoredThroughAnotherNameBetweenTheSteps" parameters=[{type=Array<number, pristine[Storage, Names]>}, {type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v2 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1():
    v3 = IteratorResume v2 stepIndex=0
    v4 = ResultAt v3 index=1
    v5 = Integer integer=7
    ElemSet v1, v5, v4 mode=Strict
    v7 = IteratorResume v2 stepIndex=1
    v8 = ResultAt v7 index=1
    Jump -> next b2()
  b2():
    IteratorClose v2
    Return v8
# The two names may be one array, and a store past the end makes it longer
# CHECK: [[inRange8]]: boolean = Less
# CHECK-NEXT: Branch [[inRange8]]
}

function f9 name="testedArrayWithTestsBetweenTheSteps" parameters=[{type=Array<number>}] results=[{type=anything}] {
    v1 = IteratorOpen v0 elementCount=2 [isDestructuring]
    Jump -> next b1()
  b1() handler=b4():
    v2 = IteratorResume v1 stepIndex=0
    v3 = ResultAt v2 index=1
    v4 = RequireObjectCoercible v3 nullishAccess=Read
    v5 = IteratorResume v1 stepIndex=1
    v6 = ResultAt v5 index=1
    v7 = RequireObjectCoercible v6 nullishAccess=Read
    Jump -> next b2()
  b2():
    IteratorClose v1
    Jump -> next b3()
  b3():
    v9 = Add v4, v7
    Return v9
  b4() role=IterationCleanup subject=v1:
    v10 = CatchException
    IteratorClose v1 completion=Throw
    Rethrow v10
# The copy for arrays reads by index. In the copy for any iterable a step would move across a test that throws, so it keeps its steps
# CHECK: = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
# CHECK-NOT: DestructureIterable
# CHECK-COUNT-2: = ElemGet v0, {{*}} [keyIsIntegral]
# CHECK-NOT: DestructureIterable
}
