# A virtual array has at most as many elements as the limit: a longer literal stays an allocation, and so does an array that an append would take past the limit
# FORM: Prepared
# OPTIONS: limit=MaxVirtualArrayLength:2
# RUN: pass SinkAllocations
# LOSS: MaxVirtualArrayLength x2 f0 v3
# STATISTIC: AllocationsRemoved = 2
# STATISTIC: AllocationsSunk = 0

module m0 path="main.js" displayPath="main.js"

function f0 name="literalOfThree" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewArray v0, v1, v2 contents=anything
    v4 = Integer integer=0
    v5 = ElemGet v3, v4
    Return v5
}
# CHECK-LABEL: function f0 name="literalOfThree"
# CHECK: v3:{{*}}= NewArray v0, v1, v2 contents=anything
# CHECK: v5:{{*}}= ElemGet v3, v4

function f1 name="literalOfTwo" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewArray v0, v1 contents=anything
    v3 = Integer integer=1
    v4 = ElemGet v2, v3
    Return v4
}
# CHECK-LABEL: function f1 name="literalOfTwo"
# CHECK-NOT: NewArray
# CHECK-NOT: ElemGet
# CHECK: v4: anything = Upcast v1 castType=anything
# CHECK-NEXT: Return v4

function f2 name="appendReachesThree" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewArray v0, v1 contents=anything
    AppendElement v3, v2
    v5 = Integer integer=2
    v6 = ElemGet v3, v5
    Return v6
}
# CHECK-LABEL: function f2 name="appendReachesThree"
# CHECK: v3:{{*}}= NewArray v0, v1 contents=anything
# CHECK-NEXT: AppendElement v3, v2
# CHECK: v6:{{*}}= ElemGet v3, v5

function f3 name="appendReachesTwo" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewArray v0 contents=anything
    AppendElement v2, v1
    v4 = Integer integer=1
    v5 = ElemGet v2, v4
    Return v5
}
# CHECK-LABEL: function f3 name="appendReachesTwo"
# CHECK-NOT: NewArray
# CHECK-NOT: AppendElement
# CHECK-NOT: ElemGet
# CHECK: v5: anything = Upcast v1 castType=anything
# CHECK-NEXT: Return v5
