    v40 = ToBoolean v0
    v41 = CallDirect v0 function=f2
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v42 = CallDirect v0 function=f3
    Return v42
  b2():
    Return v41
}

