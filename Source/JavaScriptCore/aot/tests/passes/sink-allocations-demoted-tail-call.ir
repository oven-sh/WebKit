# A call with a list that becomes a call with arguments, or one that forwards the arguments of its frame, keeps the mark of a demoted tail call
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 4

module m0 path="main.js" displayPath="main.js"
function f0 name="target" flags=[HasRestParameter] parameters=[{type=Array}] results=[{type=anything}] {
    Return
}
function f1 name="markedCallList" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewArray v1, v0 contents=anything
    v3 = CallList v0, v1, v2 @0 tail
    Return v3
# CHECK-NOT: NewArray
# CHECK: v3: anything = Call v0, v1, v1, v0 @0 tail
}

function f2 name="callList" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewArray v1, v0 contents=anything
    v3 = CallList v0, v1, v2
    Return v3
# CHECK-NOT: @{{*}} tail
# CHECK: v3: anything = Call v0, v1, v1, v0
# CHECK-NOT: @{{*}} tail
}

function f3 name="markedForwardedCall" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = GetArgument argumentIndex=1
    v4 = CreateRest firstArgument=2
    v5 = CallList v2, v3, v4 @0 tail
    Return v5
# CHECK-NOT: CreateRest
# CHECK: v5: anything = CallForwardVarargs v2, v3 firstArgument=2 @0 tail
}

function f4 name="forwardedCall" role=GenericEntrypoint flags=[HasThis] captures=[{type=f0}] results=[{type=anything}] derivation={source=f0} creator=Entrypoint{target=f0} {
    v2 = GetArgument argumentIndex=0
    v3 = GetArgument argumentIndex=1
    v4 = CreateRest firstArgument=2
    v5 = CallList v2, v3, v4
    Return v5
# CHECK-NOT: @{{*}} tail
# CHECK: v5: anything = CallForwardVarargs v2, v3 firstArgument=2
# CHECK-NOT: @{{*}} tail
}
