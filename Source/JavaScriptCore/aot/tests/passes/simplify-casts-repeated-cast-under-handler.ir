# A cast repeated in its covered block goes, and the same cast stays where control may arrive before the first one ran: in the handler and behind it
# FORM: Prepared
# RUN: pass SimplifyCasts
# STATISTIC: SimplifyCastsChanges = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="repeatedInCoveredBlockAndInHandler" parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] {
  b0(v0: anything) handler=b1():
    v1 = Check v0 expectedType=number
    v2 = Check v0 expectedType=number
    v3 = Add v1, v2
    Return v3
  b1() role=CatchHandler:
    v4 = CatchValue
    v5 = Check v0 expectedType=number
    Return v5
# CHECK-NEXT: b0(v0: anything) handler=b1():
# CHECK-NEXT: v1: number = Check v0 expectedType=number
# CHECK-NEXT: = Add v1, v1
# CHECK: b1() role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NEXT: v5: number = Check v0 expectedType=number
# CHECK-NEXT: Return v5
}

function f1 name="repeatedBehindHandler" parameters=[{type=anything}, {type=anything}] results=[{type=number flags=[IsExpected]}] {
  b0(v0: anything, v1: anything) handler=b1():
    v2 = Call v1
    v3 = Check v0 expectedType=number
    v4 = Check v0 expectedType=number
    v5 = Add v3, v4
    Jump -> next b2()
  b1() role=CatchHandler:
    v6 = CatchValue
    Jump -> next b2()
  b2():
    v7 = Check v0 expectedType=number
    Return v7
# CHECK: v3: number = Check v0 expectedType=number
# CHECK-NEXT: = Add v3, v3
# CHECK: b2():
# CHECK-NEXT: v7: number = Check v0 expectedType=number
# CHECK-NEXT: Return v7
}

function f2 name="onlyInHandler" parameters=[{type=anything}, {type=anything}] results=[{type=number flags=[IsExpected]}] {
  b0(v0: anything, v1: anything) handler=b1():
    v2 = Call v1
    v3 = Check v0 expectedType=number
    Return v3
  b1() role=CatchHandler:
    v4 = CatchValue
    v5 = Check v0 expectedType=number
    Return v5
# CHECK: v3: number = Check v0 expectedType=number
# CHECK: b1() role=CatchHandler:
# CHECK-NEXT: = CatchValue
# CHECK-NEXT: v5: number = Check v0 expectedType=number
# CHECK-NEXT: Return v5
}
