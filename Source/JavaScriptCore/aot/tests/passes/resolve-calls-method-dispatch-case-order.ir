# The arms of a dispatch are tested by weight: expected members first, then the arm with more members, then the smaller layout
# FORM: Prepared
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Animal" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="speak" function=f1 mutability=Fixed}]}
layout L1 kind=Instance name="Dog" base=L0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0 impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="speak" function=f3 mutability=Fixed}]}
layout L2 kind=Instance name="Cat" base=L0 constructor=f4 flags=[HasHeritage] flow={baseState=Layout base=L0 impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L3 kind=Instance name="Puppy" base=L1 constructor=f5 flags=[HasHeritage] flow={baseState=Layout base=L1 impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="speak" function=f6 mutability=Fixed}]}
layout L4 kind=Instance name="Hound" base=L1 constructor=f7 flags=[HasHeritage] flow={baseState=Layout base=L1 impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
function f0 name="Animal" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="speak" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f2 name="Dog" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f3 name="speak" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f4 name="Cat" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f5 name="Puppy" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f6 name="speak" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f7 name="Hound" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]

function f8 name="more-members-first" parameters=[{type=L0|L1|L2|L3|L4}] results=[{type=anything}] {
    v1 = PropGet v0 key="speak"
    v2 = Call v1, v0 calleeKey="speak"
    Return v2
# CHECK: = TypeTest v0 testedType=L0|L2
# CHECK: ({{*}}: L0|L2):
# CHECK-NEXT: = CallDirect {{*}} function=f1
# CHECK: ([[dogs]]: L1|L3|L4):
# CHECK-NEXT: = TypeTest [[dogs]] testedType=L1|L4
# CHECK: ({{*}}: L1|L4):
# CHECK-NEXT: = CallDirect {{*}} function=f3
# CHECK: ({{*}}: L3):
# CHECK-NEXT: = CallDirect {{*}} function=f6
# CHECK-NOT: frequency=Unlikely
}
function f9 name="expected-member-first" parameters=[{type=L0|L1|L2|L3|L4}] results=[{type=anything}] {
  b0(v0: L0|L1|L2|L3|L4 ~ L3):
    v1 = PropGet v0 key="speak"
    v2 = Call v1, v0 calleeKey="speak"
    Return v2
# CHECK: = TypeTest v0 testedType=L3
# CHECK: ({{*}}: L3):
# CHECK-NEXT: = CallDirect {{*}} function=f6
# CHECK: ([[notPuppy]]: L0|L1|L2|L4) frequency=Unlikely:
# CHECK-NEXT: = TypeTest [[notPuppy]] testedType=L0|L2
# CHECK: ({{*}}: L0|L2) frequency=Unlikely:
# CHECK-NEXT: = CallDirect {{*}} function=f1
# CHECK: ({{*}}: L1|L4) frequency=Unlikely:
# CHECK-NEXT: = CallDirect {{*}} function=f3
}
function f10 name="two-expected-arms" parameters=[{type=L0|L1|L2|L3|L4}] results=[{type=anything}] {
  b0(v0: L0|L1|L2|L3|L4 ~ L3|L4):
    v1 = PropGet v0 key="speak"
    v2 = Call v1, v0 calleeKey="speak"
    Return v2
# CHECK: = TypeTest v0 testedType=L1|L4
# CHECK: ({{*}}: L1|L4{{*}}):
# CHECK-NEXT: = CallDirect {{*}} function=f3
# CHECK: ([[notDog]]: L0|L2|L3{{*}}):
# CHECK-NEXT: = TypeTest [[notDog]] testedType=L3
# CHECK: ({{*}}: L3):
# CHECK-NEXT: = CallDirect {{*}} function=f6
# CHECK: ({{*}}: L0|L2) frequency=Unlikely:
# CHECK-NEXT: = CallDirect {{*}} function=f1
}
function f11 name="smaller-layout-first" parameters=[{type=L1|L3}] results=[{type=anything}] {
    v1 = PropGet v0 key="speak"
    v2 = Call v1, v0 calleeKey="speak"
    Return v2
# CHECK: = TypeTest v0 testedType=L1
# CHECK-NOT: TypeTest
# CHECK: = CallDirect {{*}} function=f3
# CHECK: = CallDirect {{*}} function=f6
}
