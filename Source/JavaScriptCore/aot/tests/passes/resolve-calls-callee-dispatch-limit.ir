function f10 name="more-expected-callees-than-the-limit" parameters=[{type=f0|f1|f2|f3|f4|f5|f6}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4|f5|f6 ~ f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1 accessSite=3 callees=[f0, f1, f2, f3, f4, f5, f6]
    Return v2
}
