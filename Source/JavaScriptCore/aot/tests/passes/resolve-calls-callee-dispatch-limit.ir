# A call by value with more proven callees than the limit tests only for predicted callees and stays one call, however often the pass runs
# FORM: Prepared
# OPTIONS: report=Declines heat=EverythingIsHot
# RUN: pass ResolveCalls
# RUN(TWICE): pass ResolveCalls ResolveCalls
# LOSS: MaxDispatchCases
# STATISTIC: CallsResolved = 3
# CHECK: outcome: Changed
# CHECK-NEXT: decline HotCallNotResolved f8 v2 MaxDispatchCases [0] reason=TooManyCallees
# CHECK-NEXT: decline HotCallNotResolved f10 v2 MaxDispatchCases [0] reason=TooManyCallees
# CHECK-NEXT: decline HotCallNotResolved f13 v2 None [0] reason=UnknownCallee
# CHECK-NOT: decline
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="first" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f1 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f6 name="seventh" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f7 name="as-many-callees-as-the-limit" parameters=[{type=f0|f1|f2|f3}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3, v1: anything):
    v2 = Call v0, -, v1 accessSite=0 callees=[f0, f1, f2, f3]
    Return v2
}
# CHECK-LABEL: function f7 name="as-many-callees-as-the-limit"
# CHECK-COUNT-3: = TypeTest
# CHECK-NOT: TypeTest
# CHECK-NOT: = Call v
# CHECK-LABEL: function f8
function f8 name="one-callee-more" parameters=[{type=f0|f1|f2|f3|f4}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1 accessSite=1 callees=[f0, f1, f2, f3, f4]
    Return v2
}
# CHECK-NEXT: b0(v0: f0|f1|f2|f3|f4, v1: anything):
# CHECK-NEXT: v2: anything = Call v0, -, v1 accessSite=1 callees=[f0, f1, f2, f3, f4]
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f9 name="one-predicted-callee" parameters=[{type=f0|f1|f2|f3|f4|f5|f6 predicted=f5}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4|f5|f6 ~ f5, v1: anything):
    v2 = Call v0, -, v1 accessSite=2 callees=[f0, f1, f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f9 name="one-predicted-callee"
# CHECK: = TypeTest v0 testedType=f5
# CHECK-NOT: TypeTest
# CHECK: = CallDirect v1 function=f5
# CHECK-NOT: CallDirect
# CHECK: ([[others]]: f0|f1|f2|f3|f4|f6) frequency=Unlikely:
# CHECK-NEXT: = Call [[others]], -, v1 accessSite=2 callees=[f0, f1, f2, f3, f4, f6]
# CHECK-NOT: CallDirect
# TWICE-LABEL: function f9 name="one-predicted-callee"
# TWICE: = TypeTest v0 testedType=f5
# TWICE-NOT: TypeTest
# TWICE: = Call {{*}}, -, v1 accessSite=2 callees=[f0, f1, f2, f3, f4, f6]
# TWICE-NOT: TypeTest
# TWICE-LABEL: function f10
function f10 name="more-predicted-callees-than-the-limit" parameters=[{type=f0|f1|f2|f3|f4|f5|f6 predicted=f0|f1|f2|f3|f4}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4|f5|f6 ~ f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1 accessSite=3 callees=[f0, f1, f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f10 name="more-predicted-callees-than-the-limit"
# CHECK-NEXT: b0(
# CHECK-NEXT: v2: anything = Call v0, -, v1 accessSite=3 callees=[f0, f1, f2, f3, f4, f5, f6]
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f11 name="narrowed-copy-of-a-site-past-the-limit" parameters=[{type=f2|f6}, {type=anything}] results=[{type=anything}] {
  b0(v0: f2|f6, v1: anything):
    v2 = Call v0, -, v1 accessSite=3 callees=[f0, f1, f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f11 name="narrowed-copy-of-a-site-past-the-limit"
# CHECK: = TypeTest v0 testedType=f2
# CHECK-NOT: TypeTest
# CHECK: = CallDirect v1 function=f2
# CHECK: = CallDirect v1 function=f6
# CHECK-NOT: = Call v
# CHECK-LABEL: function f12
function f12 name="unproven-with-as-many-predicted-callees-as-the-limit" parameters=[{type=anything predicted=f0|f1|f2|f3}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0|f1|f2|f3, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
function f13 name="unproven-with-one-predicted-callee-more" parameters=[{type=anything predicted=f0|f1|f2|f3|f4}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
