    Return v0
}
function f4 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f6 name="seventh" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f7 name="as-many-callees-as-the-limit" parameters=[{type=f0|f1|f2|f3}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3, v1: anything):
    v2 = Call v0, -, v1 accessSite=0 callees=[f0, f1, f2, f3]
    Return v2
}
# CHECK-LABEL: function f7 name="as-many-callees-as-the-limit"
# CHECK-COUNT-3: = TypeTest
# CHECK-NOT: TypeTest
# CHECK-NOT: = Call v
# CHECK-LABEL: function f8
function f8 name="one-callee-more" parameters=[{type=f0|f1|f2|f3|f4}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1 accessSite=1 callees=[f0, f1, f2, f3, f4]
    Return v2
}
# CHECK-NEXT: b0(v0: f0|f1|f2|f3|f4, v1: anything):
# CHECK-NEXT: v2: anything = Call v0, -, v1 accessSite=1 callees=[f0, f1, f2, f3, f4]
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f9 name="one-expected-callee" parameters=[{type=f0|f1|f2|f3|f4|f5|f6}, {type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1|f2|f3|f4|f5|f6 ~ f5, v1: anything):
    v2 = Call v0, -, v1 accessSite=2 callees=[f0, f1, f2, f3, f4, f5, f6]
    Return v2
}
# CHECK-LABEL: function f9 name="one-expected-callee"
# CHECK-NEXT: b0(v0: f0|f1|f2|f3|f4|f5|f6 ~ f5, v1: anything):
