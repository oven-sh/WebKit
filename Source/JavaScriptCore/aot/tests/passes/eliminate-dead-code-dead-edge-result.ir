# A parameter that an edge fills with what its test proves goes when nobody reads it: the edge passes one proof less, the test and the branch stay
# FORM: Prepared
# RUN: pass EliminateDeadCode
# STATISTIC: EliminateDeadCodeChanges = 7

module m0 path="main.js" displayPath="main.js"
function f0 name="unusedNarrowedParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return v0
  b2():
    Return
# CHECK: v1: boolean = TypeTest v0 testedType=number
# CHECK-NEXT: Branch v1 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
}

function f1 name="usedOnOneSideOnly" parameters=[{type=undefined|number}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    Return
# CHECK: v1: boolean = TypeTest v0 testedType=number
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v2: number):
# CHECK-NEXT: Return v2
# CHECK-NEXT: b2():
}

function f2 name="firstOfTwoProofs" parameters=[{type=i32}, {type=int[0, 10]}] results=[{type=number}] {
    v2 = Less v0, v1
    Branch v2 -> taken b1(| 0, 1), notTaken b2()
  b1(v3, v4):
    Return v4
  b2():
    Return v0
# CHECK: v2: boolean = Less v0, v1
# CHECK-NEXT: Branch v2 -> taken b1(| 1), notTaken b2()
# CHECK-NEXT: b1(v4: int[0, 10]):
# CHECK-NEXT: Return v4
}

function f3 name="proofBehindUsedArgument" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(v1 | 0), notTaken b2()
  b1(v3, v4):
    Return v3
  b2():
    Return v1
# CHECK: Branch v2 -> taken b1(v1), notTaken b2()
# CHECK-NEXT: b1(v3: number):
# CHECK-NEXT: Return v3
}

function f4 name="usedProofBehindUnusedArgument" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = Add v1, v1
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(v2 | 0), notTaken b2()
  b1(v4, v5):
    Return v5
  b2():
    Return v1
# CHECK-NEXT: b0(v0: anything, v1: number):
# CHECK-NEXT: v3: boolean = TypeTest v0 testedType=number
# CHECK-NEXT: Branch v3 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v5: number):
# CHECK-NEXT: Return v5
}

function f5 name="proofOnOneEdgeArgumentOnTheOther" parameters=[{type=anything}, {type=boolean}, {type=number}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b3(| 0), notTaken b4()
  b2():
    v4 = Add v2, v2
    Jump -> next b3(v4)
  b3(v5):
    Return v0
  b4():
    Return
# CHECK: v3: boolean = TypeTest v0 testedType=number
# CHECK-NEXT: Branch v3 -> taken b3(), notTaken b4()
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3()
# CHECK-NEXT: b3():
# CHECK-NEXT: Return v0
}

function f6 name="caseOfSwitch" parameters=[{type=number}] results=[{type=number}] {
    Switch v0 cases=[1, 2] -> case b1(| 0), case b2(| 0), otherwise b3()
  b1(v1):
    Return v0
  b2(v2):
    Return v2
  b3():
    Return v0
# CHECK: Switch v0 cases=[1, 2] -> case b1(), case b2(| 0), otherwise b3()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
# CHECK-NEXT: b2(v2: 2):
# CHECK-NEXT: Return v2
}

function f7 name="everyProofIsRead" parameters=[{type=i32}, {type=int[0, 10]}] results=[{type=number}] {
    v2 = Less v0, v1
    Branch v2 -> taken b1(| 0, 1), notTaken b2(| 0)
  b1(v3, v4):
    v5 = Add v3, v4
    Return v5
  b2(v6):
    Return v6
# CHECK: Branch v2 -> taken b1(| 0, 1), notTaken b2(| 0)
# CHECK-NEXT: b1(v3: int[-2147483648, 9], v4: int[0, 10]):
# CHECK: b2(v6: int[0, 2147483647]):
}
