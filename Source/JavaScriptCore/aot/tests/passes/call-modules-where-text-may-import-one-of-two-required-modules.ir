# main.mjs: require("./running.mjs"); require("./neighbor.mjs")        running.mjs: import "./imported.mjs"; eval(text)        built with two entry points, main.mjs and running.mjs
# A text may import running.mjs, an entry point, while the require() evaluates it: that site asks the run time. No name finds neighbor.mjs: the site beside it calls what the module runs.
# FORM: AsRead
# RUN: pipeline CallModules
# STATISTIC: RequireSitesBound = 1

module m0 path="/main.mjs" displayPath="main.mjs" body=f0 requests=[{target=m1 kind=Require completes=true}, {target=m3 kind=Require completes=true}]
module m1 path="/running.mjs" displayPath="running.mjs" body=f1 requests=[{target=m2 completes=true}]
module m2 path="/imported.mjs" displayPath="imported.mjs" body=f2
module m3 path="/neighbor.mjs" displayPath="neighbor.mjs" body=f3
entry module=m0
entry module=m1
evalscope e0
function f0 name="main" kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    EvaluateModule module=m3 referrer=m0 [isBare]
    Return
# CHECK-NEXT: b0():
# CHECK-NEXT: EvaluateRequiredModule module=m1 referrer=m0 specifier="/running.mjs"
# CHECK-NEXT: = CallDirect function=f3
# CHECK-NEXT: Return
}
function f1 name="running" module=m1 kind=Module results=[{type=anything}] {
    v0 = String string="text"
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return
}
function f2 name="imported" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
function f3 name="neighbor" module=m3 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
