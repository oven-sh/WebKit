# FORM: Prepared
# OPTIONS: limit=MaxTestedTypesPerFunction:2
# RUN: test-placement
# LOSS: MaxTestedTypesPerFunction x1 f0 v6

module m0 path="main.js" displayPath="main.js"
function f0 name="threeOperands" parameters=[{type=anything predicted=number}, {type=anything predicted=number}, {type=anything predicted=number}, {type=number}] results=[{type=anything}] {
  b0(v0: anything ~ number, v1: anything ~ number, v2: anything ~ number, v3: number):
    v4 = Mul v0, v3
    v5 = Mul v0, v3
    v6 = Mul v1, v3
    v7 = Integer integer=0
    Jump -> next b1(v7)
  b1(v8):
    LoopHint
    v10 = Mul v2, v3
    v11 = Integer integer=1
    v12 = Add v8, v11
    v13 = Less v12, v3
    Branch v13 -> taken b1(v12), notTaken b2()
  b2():
    Return v10
}
