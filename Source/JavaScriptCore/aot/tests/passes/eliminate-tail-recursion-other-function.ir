# A tail call that is no direct call of the function it stands in stays a call
# FORM: Prepared
# RUN: pass EliminateTailRecursion
# STATISTIC: TailRecursionsEliminated = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="isEven" parameters=[{type=number}] results=[{type=boolean}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    v3 = Sub v0, v2
    v4 = CallDirect v3 function=f1
    ReturnCall v4
  b2():
    v5 = Boolean boolean=true
    Return v5
# CHECK-NOT: LoopHint
# CHECK: v4: boolean = CallDirect v3 function=f1
# CHECK-NEXT: ReturnCall v4
# CHECK-NOT: LoopHint
}

function f1 name="isOdd" parameters=[{type=number}] results=[{type=boolean}] {
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    v3 = Sub v0, v2
    v4 = CallDirect v3 function=f0
    ReturnCall v4
  b2():
    v5 = Boolean boolean=false
    Return v5
# CHECK-NOT: LoopHint
# CHECK: v4: boolean = CallDirect v3 function=f0
# CHECK-NEXT: ReturnCall v4
# CHECK-NOT: LoopHint
}

function f2 name="unknownCallee" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0, -, v0
    ReturnCall v1
# CHECK-NOT: LoopHint
# CHECK: v1: anything = Call v0, -, v0
# CHECK-NEXT: ReturnCall v1
}

function f3 name="ownClosureCalledByValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f3
    v2 = Call v1, -, v0
    ReturnCall v2
# CHECK-NOT: LoopHint
# CHECK: = Call v1, -, v0
# CHECK-NEXT: ReturnCall v2
}
