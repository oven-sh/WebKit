# A generator that is stepped at several places is merged once: each place says where to come back to, and the code that leaves the generator switches on it
# FORM: Prepared
# OPTIONS: report=Declines
# RUN: pass FuseGeneratorLoops
# RUN(ABSENT): pass FuseGeneratorLoops
# STATISTIC: GeneratorLoopsFused = 2
# CHECK: outcome: Changed
# CHECK-NEXT: decline GeneratorLoopNotFused f2 v3 None [0] reason=MayEscapeBeforeStep
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js"

function f0 name="loopWithBreak" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f3
    v3 = NewGenerator v2 function=f3 @40
    v4 = CallDirect v2, v0, v3 function=f4 @40
    Jump -> next b1()
  b1():
    LoopHint
    v6 = Undefined
    v7 = StepGenerator v3, v6 check=None @50
    v8 = ResultAt v7 index=0
    v9 = ResultAt v7 index=1
    v10 = Integer integer=1
    v11 = StrictEq v9, v10
    Branch v11 -> taken b4(), notTaken b2()
  b2():
    v12 = Call v1, -, v8 @51
    v13 = ToBoolean v12
    Branch v13 -> taken b3(), notTaken b1()
  b3():
    v14 = Undefined
    v15 = StepGenerator v3, v14 resumeMode=Return check=None @52
    Return v12
  b4():
    v16 = Undefined
    Return v16
# The call that starts the body is place 0, the step of the loop place 1, the step that closes at the break place 2.
# The initial yield goes on behind the start without asking for the place.
# CHECK: v3: Generator = NewGenerator v2 function=f3 @40
# CHECK: LoopHint @40
# CHECK-NEXT: [[startPlace2]]: 0 = Integer @40
# CHECK-NEXT: Jump -> next [[start2]]() @40
# CHECK-NEXT: b1(
# CHECK: [[stepPlace2]]: 1 = Integer integer=1 @50
# CHECK-NEXT: [[next2]]: 0 = Integer @50
# CHECK-NEXT: Jump -> next [[enter2]](v6, [[next2]], {{*}}, [[stepPlace2]]
# CHECK: b3():
# CHECK: [[closePlace2]]: 2 = Integer integer=2 @52
# CHECK-NEXT: [[return2]]: 2 = Integer integer=2 @52
# CHECK-NEXT: Jump -> next [[enter2]](v14, [[return2]], {{*}}, [[closePlace2]]
# CHECK: [[enter2]]([[sent2]]: anything, [[mode2]]: int[0, 2], [[resumePoint2]]: int[-1, 2], [[place2]]: int[0, 2]
# CHECK-NEXT: Switch [[resumePoint2]] cases=[1, 2] -> case [[afterInitialYield2]]([[sent2]], [[mode2]]), case [[afterYield2]]([[sent2]], [[mode2]]), otherwise [[finished2]]()
# CHECK-NEXT: [[leave2]]([[value2]]: anything, [[status2]]: int[0, 1], {{*}}: int[-1, 2]):
# CHECK-NEXT: Switch [[place2]] cases=[1] -> case [[afterStep2]]([[value2]], [[status2]]), otherwise [[afterClose2]]([[value2]], [[status2]])
# CHECK-NEXT: [[afterClose2]](
# CHECK: Return
# CHECK-NEXT: [[afterStep2]](v8: anything, v9: int[0, 2]):
# CHECK: = StrictEq v9, v10
# CHECK: [[afterStart2]](v4: anything):
# CHECK-NEXT: Jump -> next b1(
# A yield hands on the place it was entered from.
# CHECK: Jump -> next [[afterStart2]](
# CHECK: Jump -> next [[leave2]](v0, {{*}})
# ABSENT-NOT: StepGenerator
# ABSENT-NOT: YieldBySavingFrame
# ABSENT-NOT: function=f4
}

function f1 name="patternWithTwoSteps" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Undefined
    v2 = NewClosure function=f3
    v3 = NewGenerator v2 function=f3 @41
    v4 = CallDirect v2, v0, v3 function=f4 @41
    v5 = StepGenerator v3, v1 check=None @60
    v6 = ResultAt v5 index=0
    v7 = StepGenerator v3, v1 check=None @60
    v8 = ResultAt v7 index=0
    v9 = StepGenerator v3, v1 resumeMode=Return check=None @62
    v10 = Add v6, v8
    Return v10
# Three steps in one block and the start: four places, and the value of the first step is carried through the second.
# CHECK: LoopHint @41
# CHECK-NEXT: [[startPlace3]]: 0 = Integer @41
# CHECK-NEXT: Jump -> next [[start3]]() @41
# CHECK: [[enter3]]([[sent3]]: anything, [[mode3]]: int[0, 2], {{*}}: int[-1, 2], [[place3]]: int[0, 3], [[carriedFirst3]]: anything, [[carriedSecond3]]: anything):
# CHECK-NEXT: Switch {{*}} cases=[1, 2] ->
# CHECK-NEXT: [[leave3]]([[value3]]: anything, [[status3]]: int[0, 1], {{*}}: int[-1, 2]):
# CHECK-NEXT: Switch [[place3]] cases=[1, 2] -> case [[afterFirst3]]([[value3]], [[status3]]), case [[afterSecond3]]([[value3]], [[status3]]), otherwise [[afterClose3]]([[value3]], [[status3]])
# CHECK: [[afterClose3]](
# CHECK: = Add [[carriedFirst3]], [[carriedSecond3]]
# CHECK: [[afterSecond3]](v8: anything,
# CHECK: : 3 = Integer integer=3 @62
# CHECK-NEXT: [[return3]]: 2 = Integer integer=2 @62
# CHECK-NEXT: Jump -> next [[enter3]](v1, [[return3]], {{*}}, [[carriedFirst3]], v8)
# CHECK: [[afterFirst3]](v6: anything,
# CHECK: : 2 = Integer integer=2 @60
# CHECK-NEXT: [[secondNext3]]: 0 = Integer @60
# CHECK-NEXT: Jump -> next [[enter3]](v1, [[secondNext3]], {{*}}, v6, [[carriedSecond3]])
# CHECK: [[afterStart3]](v4: anything):
# CHECK: : 1 = Integer integer=1 @60
# CHECK-NEXT: [[firstNext3]]: 0 = Integer @60
# CHECK-NEXT: Jump -> next [[enter3]](v1, [[firstNext3]],
# ABSENT-NOT: StepGenerator
# ABSENT-NOT: YieldBySavingFrame
# ABSENT-NOT: function=f4
}

function f2 name="oneStepLooksItsMethodUp" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f3
    v3 = NewGenerator v2 function=f3 @42
    v4 = CallDirect v2, v0, v3 function=f4 @42
    Jump -> next b1()
  b1():
    LoopHint
    v6 = Undefined
    v7 = StepGenerator v3, v6 check=None @50
    v8 = ResultAt v7 index=0
    v9 = ResultAt v7 index=1
    v10 = Integer integer=1
    v11 = StrictEq v9, v10
    Branch v11 -> taken b4(), notTaken b2()
  b2():
    v12 = Call v1, -, v8 @51
    v13 = ToBoolean v12
    Branch v13 -> taken b3(), notTaken b1()
  b3():
    v14 = Undefined
    v15 = StepGenerator v3, v14 resumeMode=Return check=IsUnmodified @52
    Return v12
  b4():
    v16 = Undefined
    Return v16
}
# Where the check of one step fails the real object goes to code of the program, so no step of this generator is merged.
# CHECK-LABEL: function f2 name="oneStepLooksItsMethodUp"
# CHECK: v4: anything = CallDirect v2, v0, v3 function=f4 @42
# CHECK: v7: undefined = StepGenerator v3, v6 check=None @50
# CHECK: v15: undefined = StepGenerator v3, v14 resumeMode=Return check=IsUnmodified @52
# ABSENT-LABEL: function f2 name="oneStepLooksItsMethodUp"
# ABSENT-NOT: Switch
# ABSENT-NOT: inlineFrames=
# CHECK-LABEL: function f3 name="repeats"
# ABSENT-LABEL: function f3 name="repeats"

function f3 name="repeats" position=10 role=CoroutineRamp flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] creator=Coroutine{ramp=f3 body=f4 promiseParameter=2} {
    v2 = NewGenerator v0 function=f3 @10
    v3 = CallDirect v0, v1, v2 function=f4 @10
    Return v2 @10
}
function f4 name="repeats" position=10 role=CoroutineBody flags=[IsGenerator, TakesCallee] parameters=[{type=anything}, {type=Generator}] results=[{type=anything}] derivation={source=f3} creator=Coroutine{ramp=f3 body=f4 promiseParameter=2} {
    v3 = Undefined @10
    v4 = YieldBySavingFrame v2, v3 @10
    v5 = ResultAt v4 index=0 @10
    v6 = ResultAt v4 index=1 @10
    Switch v6 cases=[1, 2] -> case b1(), case b2(), otherwise b3() @10
  b1() frequency=Rare:
    Throw v5 @10
  b2() frequency=Rare:
    Return v5 @10
  b3():
    Jump -> next b4()
  b4():
    LoopHint
    v8 = YieldBySavingFrame v2, v1 @12
    v9 = ResultAt v8 index=0
    v10 = ResultAt v8 index=1
    Switch v10 cases=[1, 2] -> case b5(), case b6(), otherwise b4()
  b5() frequency=Rare:
    Throw v9
  b6() frequency=Rare:
    Return v9
}
