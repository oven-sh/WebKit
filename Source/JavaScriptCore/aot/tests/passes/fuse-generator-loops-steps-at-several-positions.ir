# const steps = repeats(x); steps.next(); steps.next()
# In a stack trace the caller of a generator's body stands at the next() that runs it. The copy of the body that a merge puts into the caller has one frame, and a frame has one position of its call:
# where the steps that run the body stand at several positions the generator is not merged. A step that only ends the generator, as a loop or a pattern makes one when it is left, decides nothing.
# Only a body that throws or runs other code has its callers listed: one that does neither is merged wherever its steps stand.
# FORM: Prepared
# OPTIONS: report=Declines
# RUN: pass FuseGeneratorLoops
# STATISTIC: GeneratorLoopsFused = 2
# CHECK: outcome: Changed
# CHECK-NEXT: decline GeneratorLoopNotFused f0 v3 None [0] reason=Unknown
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js"

function f0 name="nextAtTwoPositions" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = NewClosure function=f3
    v3 = NewGenerator v2 function=f3 @41
    v4 = CallDirect v2, v0, v3 function=f4 @41
    v5 = StepGenerator v3, v1 check=None @60
    v6 = ResultAt v5 index=0
    v7 = StepGenerator v3, v1 check=None @61
    v8 = ResultAt v7 index=0
    v9 = Add v6, v8
    Return v9
}
