# `while (b)`: behind the test b is neither zero nor NaN. Of a number without a fraction that says nothing, so no earlier pass kept it; of an integer it says that a remainder by b is an integer
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers

module m0 path="main.js" displayPath="main.js"
function f0 name="greatestCommonDivisor" parameters=[{type=int[1, 1024]}] results=[{type=number}] {
    v1 = Integer integer=360
    Jump -> next b1(v0, v1)
  b1(v2: int|whole, v3: int|whole):
    LoopHint
    v5 = ToBoolean v3
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Mod v2, v3
    Jump -> next b1(v3, v6)
  b3():
    Return v2
# CHECK: b1(v2: int[1, 1024], v3: int[0, 360]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[divisor]]: int[1, 360]):
# CHECK-NEXT: v6: int[0, 359] = Mod v2, [[divisor]]
}

function f1 name="halvesThatHaveFractions" parameters=[{type=int[1, 1024]}] results=[{type=number}] {
    v1 = Integer integer=2
    Jump -> next b1(v0)
  b1(v2: number):
    LoopHint
    v4 = ToBoolean v2
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Div v2, v1
    Jump -> next b1(v5)
  b3():
    Return v2
# CHECK: b1(v2: number):
# CHECK: Branch v4 -> taken b2(), notTaken b3()
}
