# `outer` was resolved while what `inner` answers was a failure or a success, told apart by the field `success`. With the body of `inner` taken in, it is a success and nothing else:
# no member is left for the arm of the failure, whose read is resolved for the layout of failures alone. NarrowByField keeps the type of its holder there (ir/result-types/
# narrow-by-field-drops-members-that-cannot-hold-the-value.ir says why), which that read does not fit. The function waits for no generic version, so the arm is cut at the narrowing.
# FORM: Prepared
# RUN: pass InlineCalls VerifyProgram
# LOSS: MaxInlineHeadBytes x1 f1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js" body=f0
layout L0 name="Failure" fields=[{key="success" declared={type=false} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="remainder" declared={type=string} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Success" fields=[{key="success" declared={type=true} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="remainder" declared={type=string} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f2
    Return
}
function f1 name="inner" parameters=[{type=string}] results=[{type=L0|L1}] capabilities=[MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] {
    v1 = Boolean boolean=true
    v2 = NewObject -, v1, v0 layout=L1 fields=[0, 1]
    Return v2
}
function f2 name="outer" parameters=[{type=string}] results=[{type=string}] {
    v1 = CallDirect v0 function=f1
    v2 = GetSlot v1 key="success" receivers=[L0, L1] level=Proven
    v3 = Boolean
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    v6 = NarrowByField v1, v5 key="success"
    v7 = GetSlot v6 key="remainder" receivers=[L0] level=Proven
    Return v7
  b2(v8):
    v9 = NarrowByField v1, v8 key="success"
    v10 = GetSlot v9 key="remainder" receivers=[L1] level=Proven
    Return v10
# CHECK-NOT: receivers=[L0] level=Proven
# CHECK: receivers=[L1] level=Proven
}
