function f4 name="guardFromOutside" parameters=[{type=boolean}, {type=object}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: object, v2: boolean, v3: anything):
    v4 = ShapeTest v1 layouts=[L0]
    Branch v4 -> taken b1(| 0), notTaken b7()
  b1(v5):
    Branch v0 -> taken b2(), notTaken b6()
  b2() frequency=Rare:
    Branch v2 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v6 = GetSlot v1, v5 key="x" receivers=[L0] level=Predicted
    v7 = CallMethod v3, v6 key="wide"
    Jump -> next b5(v7)
  b4() frequency=Rare:
    v8 = GetSlot v1, v5 key="y" receivers=[L0] level=Predicted
    v9 = CallMethod v3, v8 key="tall"
    Jump -> next b5(v9)
  b5(v10):
    Return v10
  b6():
    Return v3
  b7():
    Return v3
}
# CHECK-LABEL: function f4
# CHECK-NOT: CallDirect
# CHECK: Branch v2 -> taken b3(), notTaken b4()
# CHECK: = GetSlot v1, v5 key="x"
# CHECK: = GetSlot v1, v5 key="y"
# CHECK-NOT: CallDirect

