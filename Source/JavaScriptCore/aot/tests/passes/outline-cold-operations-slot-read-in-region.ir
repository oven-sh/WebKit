# A slot read on a receiver whose type proves the layout moves with the cold region around it
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# STATISTIC: ColdSitesOutlined = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="provenReceiver" parameters=[{type=boolean}, {type=L0}, {type=boolean}, {type=anything}] results=[{type=anything}] {
  b0(v0: boolean, v1: L0, v2: boolean, v3: anything):
    Branch v0 -> taken b1(), notTaken b5()
  b1() frequency=Rare:
    Branch v2 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v4 = GetSlot v1 key="x" receivers=[L0] level=Proven
    v5 = CallMethod v3, v4 key="wide"
    Jump -> next b4(v5)
  b3() frequency=Rare:
    v6 = GetSlot v1 key="y" receivers=[L0] level=Proven
    v7 = CallMethod v3, v6 key="tall"
    Jump -> next b4(v7)
  b4(v8):
    Return v8
  b5():
    Return v3
}
# CHECK-LABEL: function f0
# CHECK-NOT: GetSlot
# CHECK: b1() frequency=Rare:
# CHECK-NEXT: [[result]]: anything = CallDirect v2, v1, v3 function=f8
# CHECK-NEXT: Jump -> next [[join]]([[result]])
# CHECK-NOT: GetSlot

