# Twelve coroutines split on eight threads: the ids of the bodies follow the order of the ids of the ramps, and every run prints the same program
# FORM: Prepared
# OPTIONS: threads=8
# RUN: pass SplitCoroutines
# RUN: pass SplitCoroutines
# RUN: pass SplitCoroutines
# STATISTIC: CoroutinesSplit = 12
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="async0" flags=[IsAsync] parameters=[{type=int[0, 1]}] results=[{type=anything}] {
  b0(v0: int[0, 1]):
    v1 = Await v0 @0
    Return v1
}
# CHECK-LABEL: function f0 name="async0"
# CHECK: role=CoroutineRamp {{*}} parameters=[{type=int[0, 1]}] results=[{type=Promise written=anything}]
# CHECK: creator=Coroutine{kind=AsyncFunction ramp=f0 body=f14 entryWithoutPromise=f14 promiseType=Promise promiseParameter=1}
# CHECK: = CallDirect v0, {{*}} function=f14
function f1 name="generator0" flags=[IsGenerator, TakesCallee] parameters=[{type=int[0, 2]}] results=[{type=anything}] {
  b0(v0: function, v1: int[0, 2]):
    InitialYield @1
    Return v1
}
# CHECK-LABEL: function f1 name="generator0"
# CHECK: role=CoroutineRamp {{*}} parameters=[{type=int[0, 2]}] results=[{type=Generator written=anything}]
# CHECK: creator=Coroutine{ramp=f1 body=f15 promiseParameter=2}
# CHECK: = CallDirect v0, v1, {{*}} function=f15
function f2 name="callsRamps" parameters=[{type=function}, {type=0}] results=[{type=anything}] {
  b0(v0: function, v1: 0):
    v2 = CallDirect v1 function=f0
    v3 = CallDirect v0, v1 function=f1
    v4 = CallDirect v0, v1 function=f13
    Return v2
}
# CHECK-LABEL: function f2 name="callsRamps"
# CHECK-NOT: role=
# CHECK: v2: Promise = CallDirect v1 function=f0
# CHECK-NEXT: v3: Generator = CallDirect v0, v1 function=f1
# CHECK-NEXT: v4: AsyncGenerator = CallDirect v0, v1 function=f13
function f3 name="asyncGenerator0" flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=int[0, 4]}] results=[{type=anything}] {
  b0(v0: function, v1: int[0, 4]):
    InitialYield @3
    Return v1
}
