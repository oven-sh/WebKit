function f14 name="mergePointWithTwoIncomingEdges" parameters=[{type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: number, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Negate v0
    Jump -> next b3(v2)
  b2():
    v3 = Add v0, v0
    Jump -> next b3(v3)
  b3(v4):
    Return v4
}
# CHECK-LABEL: function f14 name="mergePointWithTwoIncomingEdges"
# CHECK: Branch v1 -> taken b1(), notTaken b2()
# CHECK: Jump -> next b3(v2)
# CHECK: Jump -> next b3(v3)
# CHECK: b3(v4: number):
# CHECK-NEXT: Return v4

