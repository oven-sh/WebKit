function f17 name="rethrowToHandlerWithoutCaughtValue" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
  b0(v0: anything, v1: number) handler=b2():
    v2 = Call v0
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler handler=b3():
    v3 = CatchException
    Rethrow v3
  b3() role=CatchHandler:
    Return v1
}
# CHECK-LABEL: function f17 name="rethrowToHandlerWithoutCaughtValue"
# CHECK: b2() role=CatchHandler
# CHECK-NEXT: Jump -> next [[outerBody]]()
# CHECK: b3() role=CatchHandler:
# CHECK-NEXT: Jump -> next [[outerBody]]()
# CHECK: [[outerBody]]():
# CHECK-NEXT: Return v1
# CHECK-NOT: Rethrow

