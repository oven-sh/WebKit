# A function that has a closure is also entered through its generic entrypoint, so it stays a library function
# FORM: Prepared
# RUN: pass ChooseCallingConventions
# CHECK: function f2 name="fastPath"{{*}}role=Library
# CHECK-NOT: role=StubBody

module m0 path="main.js" displayPath="main.js"
function f0 name="firstCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0, v0, v0 function=f2
    Return v1
}
function f1 name="secondCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0, v0, v0 function=f2
    Return v1
}
function f2 name="fastPath" role=Library enclosingRuntimeFunction=ArraySearchIncludes parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Return v0
}
function f3 name="makesClosure" results=[{type=anything}] {
    v0 = NewClosure function=f2
    Return v0
}
function f4 name="fastPath" role=GenericEntrypoint flags=[HasThis] enclosingRuntimeFunction=ArraySearchIncludes captures=[{type=f2}] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] derivation={source=f2} creator=Entrypoint{target=f2 arguments=Registers} {
    v5 = CallDirect v2, v3, v4 function=f2
    Return v5
}
runtimefunction id=ArraySearchIncludes function=f2
