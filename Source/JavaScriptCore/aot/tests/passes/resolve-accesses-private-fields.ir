}
function f12 name="checked-receiver" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClassToken layout=L0
    v2 = Check v0 expectedType=L0
    v3 = PrivateGet v2, v1 layout=L0 field=0
    Return v3
# CHECK: v3: number = GetSlot v2 key=#"x"@L0 receivers=[L0] level=Proven
}

