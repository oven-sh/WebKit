# Helper.prototype.define = function (name) { var target = this.target, enumerable = true; target[name] = function () { return enumerable; }; return this; };
# The test of what was read stands in front of its first use: values that use nothing are stepped over.
# FORM: AsRead
# RUN: pass CopyClosureFactories
# CHECK: outcome: Changed
# CHECK-LABEL: function f5 name="define"
# CHECK: [[read]]{{*}} = PropGet {{*}} key="target"
# CHECK-NEXT: Boolean boolean=true
# CHECK-NEXT: [[plain]]{{*}} = NewClosure function=f
# CHECK: [[same]]{{*}} = StrictEq [[read]], [[object]]
# CHECK-NEXT: Branch [[same]]
# CHECK: ElemSet [[read]], v1, [[plain]]
# CHECK: ElemSet [[object]], v1, [[plain]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f2
    PropSet v1, v2 key="define" mode=Sloppy
    v4 = NewObject layout=L0
    v5 = FinishObject v4
    v6 = Undefined
    v7 = Construct v0, -, v5
    v8 = PropGet v7 key="define"
    v9 = String string="a"
    v10 = Call v8, v7, v9
    Return
}
function f1 name="Helper" module=m0 position=10 flags=[IsSloppy, HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
    v2 = ToThis v0
    PropSet v2, v1 key="target" mode=Sloppy
    Return
}
function f2 name="define" module=m0 position=20 flags=[IsSloppy, HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
    v2 = ToThis v0
    v3 = PropGet v2 key="target"
    v4 = Boolean boolean=true
    v5 = NewClosure function=f3
    ElemSet v3, v1, v5 mode=Sloppy
    Return v2
}
function f3 name="member" module=m0 position=30 results=[{type=anything}] {
    v0 = Undefined
    Return v0
}
