# With the pass disabled a function that no root reaches keeps its body
# FORM: Selected
# OPTIONS: disable=pass:RemoveUnreachableFunctions
# RUN: pass RemoveUnreachableFunctions
# STATISTIC: RemoveUnreachableFunctionsChanges = 0
# STATISTIC: UnreachableFunctionsRemoved = 0
# CHECK: outcome: Unchanged

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
# CHECK-LABEL: function f0
# CHECK-NEXT: b0():

function f1 name="deadLeaf" results=[{type=undefined}] {
  b0():
    v0 = Undefined
    Return v0
}
# CHECK-LABEL: function f1 name="deadLeaf"
# CHECK-NEXT: b0():
# CHECK-NEXT: v0: undefined = Undefined
# CHECK-NEXT: Return v0
# CHECK-NEXT: }
