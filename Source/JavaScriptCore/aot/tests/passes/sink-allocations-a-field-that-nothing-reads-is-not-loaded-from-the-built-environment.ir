# An environment is built on one path and stays virtual on the other. Where the paths meet, a field that is recorded as never read is not loaded from the cell: the load would be its first read
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass SinkAllocations
# STATISTIC: AllocationsSunk = 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="unread" fields=[{key="n" declared={type=number} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead}}}]
layout L1 kind=Environment name="read" fields=[{key="n" declared={type=number}}]

function f0 name="unread" parameters=[{type=number}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewClosure v3 function=f2
    v5 = Call v2, -, v4
    Jump -> next b2()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    v6 = Integer integer=3
    PutEnvironmentField v3, v6 layout=L0
    Jump -> next b4()
  b4():
    v8 = Undefined
    Return v8
}
# CHECK-LABEL: function f0 name="unread"
# CHECK-NOT: GetEnvironmentField
# CHECK: = Unspecified valueType=number
# CHECK-NOT: GetEnvironmentField

function f1 name="read" parameters=[{type=number}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
    v3 = NewObject -, v0 layout=L1 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = NewClosure v3 function=f3
    v5 = Call v2, -, v4
    Jump -> next b2()
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    v6 = Integer integer=3
    PutEnvironmentField v3, v6 layout=L1
    Jump -> next b4()
  b4():
    v8 = Undefined
    Return v8
}
# CHECK-LABEL: function f1 name="read"
# CHECK: = GetEnvironmentField {{*}} layout=L1

function f2 name="overUnread" kind=Arrow captures=[{type=env L0}] results=[{type=undefined}] {
    v1 = Undefined
    Return v1
}
function f3 name="overRead" kind=Arrow captures=[{type=env L1}] results=[{type=number}] {
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
