# A field of type undefined|number has held only undefined, and a built-in stores a null into it. The slot keeps the null, so the serializer reads the slot and writes the member.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot only-passes=AnalyzeFlow,ApplyFlowResults,ResolveBuiltins,ResolveCalls,ExpandOwnKeys
# RUN: pipeline ExpandOwnKeys

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Reading" fields=[{key="id" declared={type=number} flags=[IsRequired]}, {key="level" declared={type=undefined|number} flags=[IsRequired]}]
layout L1 fields=[{key="level" declared={type=null flags=[IsExpected]} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=0
    Jump -> next b1(v0)
  b1(v1):
    LoopHint
    v3 = Integer integer=2
    v4 = Less v1, v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Integer integer=1
    v8 = Undefined
    v9 = NewObject -, v7, v8 layout=L0 fields=[0, 1]
    v10 = Null
    v11 = NewObject -, v10 layout=L1 fields=[0]
    v12 = Builtin builtin=ObjectAssign
    v13 = Call v12, -, v9, v11
    v14 = Builtin builtin=JSONStringify
    v15 = Call v14, -, v9
    v16 = Call v6, -, v15
    v17 = Increment v1
    Jump -> next b1(v17)
  b3():
    Return
}

# CHECK: layout L0 {{*}}{key="level" declared={type=undefined}
# CHECK: function {{*}}creator=Serializer{layout=L0}
# CHECK: [[level]]: undefined|null ~ undefined = GetSlot v0, {{*}} key="level" receivers=[L0]
# CHECK: [[isUndefined]]: boolean ~ true = TypeTest [[level]] testedType=undefined
# CHECK-NEXT: Branch [[isUndefined]] -> taken {{*}}, notTaken [[null]](| 0)
# CHECK: [[null]]({{*}}: null):
# CHECK-NEXT: [[key]]: buildercursor = JSONAppendKey v1, {{*}} string="level"
# CHECK-NEXT: = JSONAppendToken v1, [[key]] jsonToken=Null
