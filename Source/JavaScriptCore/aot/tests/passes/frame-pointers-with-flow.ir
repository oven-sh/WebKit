# What a callee does with a parameter or a capture decides whether a frame pointer may be passed to it
# FORM: AsRead
# RUN: frame-pointers flow
# DIAGNOSTIC: CalleeRetainsFramePointer 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect function=f1
    v3 = CallDirect function=f2
    v4 = CallDirect v1 function=f7
    v5 = CallDirect v1 function=f8
    Return
}

function f1 name="calleeOnlyCalls" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f5 storage=Frame
    v1 = CallDirect v0 function=f3
    Return v1
}
# CHECK: function f1
# CHECK-NEXT: allocations: [v0]
# CHECK: v0 v1(0) may leak: no

function f2 name="calleeStores" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f6 storage=Frame
    v1 = CallDirect v0 function=f4
    Return v1
}
# CHECK: function f2
# CHECK-NEXT: allocations: [v0]
# CHECK: v0 v1(0) may leak: yes

function f3 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}

function f4 name="storesParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="holder" [isFreeName]
    PropSet v2, v0 key="callback" mode=Strict
    Return
}

function f5 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}

function f6 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}

function f7 name="captureOnlyRead" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = NewClosure v1 function=f9 storage=Frame
    v3 = CallDirect v2 function=f3
    Return v3
}
# CHECK: function f7
# CHECK-NEXT: allocations: [v1 v2]
# CHECK-NEXT: frame pointers: [v1 v2]
# CHECK: captures: [f9.0]
# CHECK: v2 v3(0) may leak: no

function f8 name="captureStored" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = NewClosure v1 function=f10 storage=Frame
    v3 = CallDirect v2 function=f3
    Return v3
}
# CHECK: function f8
# CHECK-NEXT: allocations: [v1 v2]
# CHECK: captures: [f10.0]

function f9 name="readsCapture" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f10 name="storesClosureOverCapture" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = NewClosure v0 function=f9
    v2 = CallDirect v1 function=f4
    Return
}
