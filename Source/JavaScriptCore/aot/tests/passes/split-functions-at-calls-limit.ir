# More heads than the limit give one cut at their common dominator
# FORM: Selected
# OPTIONS: limit=MaxContinuationsPerFunction:1
# RUN: pass SplitFunctionsAtCalls
# LOSS: MaxContinuationsPerFunction f0
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="twoSlowPaths" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Call v1, -, v0
    Return v4
  b4():
    v5 = Call v1
    Return v5
}
# CHECK-LABEL: function f0 name="twoSlowPaths"
# CHECK: [[rest]]: anything = CallDirect v0, v1 function=f1
# CHECK-NEXT: ReturnCall [[rest]]
# CHECK-NOT: CallDirect
# CHECK-LABEL: function f1 name="twoSlowPaths" module=m0 role=Continuation{{*}}derivation={source=f0{{*}}} creator=Continuation{origin=f0}
# CHECK-COUNT-2: = Call
# CHECK-NOT: function f2
