# A member of a constant record that can never be what its field declares: the conversion always throws, it has the type never, and its block ends there
# FORM: Prepared
# RUN: pass ExpandData
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="x" declared={type=string}}, {key="y" declared={type=number}}]
layout L1 name="Outer" fields=[{key="pair" declared={type=L0}}, {key="z" declared={type=number}}]
data d0 root=Object{layout=L0 members=[{key="x" value=Number{value=3}}, {key="y" value=Number{value=4}}]}
data d1 root=Object{layout=L1 members=[{key="pair" value=Object{layout=L0 members=[{key="x" value=String{value="s"}}, {key="y" value=String{value="t"}}]}}, {key="z" value=Number{value=4}}]}
data d2 root=Object{layout=L0 members=[{key="x" value=String{value="s"}}, {key="y" value=Number{value=4}}]}

function f0 name="firstMemberNeverFits" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Data data=d0
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f0 name="firstMemberNeverFits"
# CHECK: [[three]]: 3 = Integer integer=3
# CHECK: : never = Claim [[three]] castType=string cause=AddedByPass
# CHECK-NEXT: Unreachable
# CHECK-NOT: NewObject
# CHECK-NOT: Call

function f1 name="nestedMemberNeverFits" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Data data=d1
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f1 name="nestedMemberNeverFits"
# CHECK: [[text]]: "t" = String string="t"
# CHECK: : never = Claim [[text]] castType=number cause=AddedByPass
# CHECK-NEXT: Unreachable
# CHECK-NOT: NewObject
# CHECK-NOT: Call

function f2 name="neverFitsOnOnePath" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Data data=d0
    Return v2
  b2():
    v3 = Data data=d2
    Return v3
}
# CHECK-LABEL: function f2 name="neverFitsOnOnePath"
# CHECK: : never = Claim {{*}} castType=string cause=AddedByPass
# CHECK-NEXT: Unreachable
# CHECK: [[pair]]:{{*}}= NewObject -, {{*}} layout=L0 fields=[0, 1]
# CHECK-NEXT: Return [[pair]]

function f3 name="membersFit" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Data data=d2
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f3 name="membersFit"
# CHECK: [[fitting]]:{{*}}= NewObject -, {{*}} layout=L0 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[fitting]]
# CHECK-NOT: Claim
