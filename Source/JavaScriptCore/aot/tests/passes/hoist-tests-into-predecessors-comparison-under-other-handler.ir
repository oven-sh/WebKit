# A comparison that may throw moves only into predecessors that have the handler of the merge block
# FORM: Prepared
# RUN: pass HoistTestsIntoPredecessors
# STATISTIC: HoistTestsIntoPredecessorsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="sameHandler" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: anything, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1() handler=b6(v0):
    Jump -> next b3(v0)
  b2() handler=b6(v0):
    Jump -> next b3(v1)
  b3(v3) handler=b6(v0):
    v4 = Less v3, v0
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
  b6(v5) role=CatchHandler:
    v6 = CatchValue
    Return v5
}
