# Why a string is not built in a string builder: the decline names the reason, and its count is the number of appends. What is left of a string that was cut is a string of its own
# FORM: Prepared
# OPTIONS: report=Declines limit=MaxStringWebsPerFunction:2
# RUN: pass CreateStringBuilders
# LOSS: MaxStringWebsPerFunction x1 f4
# CHECK: outcome: Changed
# CHECK-NEXT: decline StringBuilderNotCreated f1 v{{*}} MinAppendsForStringBuilder [3] reason=TooFewAppends
# CHECK-NEXT: decline StringBuilderNotCreated f2 v{{*}} MinAppendsForStringBuilder [3] reason=TooFewAppends
# CHECK-NEXT: decline StringBuilderNotCreated f2 v{{*}} None [0] reason=TwoStatesLive
# CHECK-NEXT: decline StringBuilderNotCreated f3 v{{*}} None [0] reason=StateIsNotFirstOperand
# CHECK-NEXT: decline StringBuilderNotCreated f4 v{{*}} MaxStringWebsPerFunction [0] reason=WebLimit
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js"
function f0 name="appendsInLoop" parameters=[{type=string}, {type=number}] results=[{type=string}] {
  b0(v0: string, v1: number):
    v2 = String string=""
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v0
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    Return v4
}
