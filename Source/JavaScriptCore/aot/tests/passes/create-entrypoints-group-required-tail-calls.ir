# Six functions call one another by value in tail position, and two of them have a written result that flow cannot prove, so their callers test it. An entrypoint that stayed behind for that test would be a frame per call:
# the group entrypoints return with a tail call that has to reuse the frame, and whoever receives the result of the chain makes the test. A site that is no tail call needs the test of the member it enters, so it stays a call by value, and the generic entrypoint makes it, unless the frame it returns to already waits to test a result
# FORM: AsRead
# RUN: pipeline CreateEntrypoints
# RUN(LATER): pipeline ChooseCallingConventions
# OPTIONS: check=VerifyEachPass only-passes=GroupCallsByValue,ChooseCallingConventions
# STATISTIC: GroupEntrypoints = 6

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Result
variable g0 name="next" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f1
    PutModuleVariable v2 variable=g0
    v4 = CallDirect v1 function=f7
    v5 = NewClosure function=f2
    PutModuleVariable v5 variable=g0
    v7 = CallDirect v1 function=f7
    v8 = NewClosure function=f3
    PutModuleVariable v8 variable=g0
    v10 = CallDirect v1 function=f7
    v11 = NewClosure function=f4
    PutModuleVariable v11 variable=g0
    v13 = CallDirect v1 function=f7
    v14 = NewClosure function=f5
    PutModuleVariable v14 variable=g0
    v16 = CallDirect v1 function=f7
    v17 = NewClosure function=f6
    PutModuleVariable v17 variable=g0
    v19 = CallDirect v1 function=f7
    Return
}
function f1 name="givesNumber" kind=Arrow flags=[IsChecked] parameters=[{type=anything}] results=[{type=number site=w0}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3 casts=[{declared={type=number site=w0}}]
  b2():
    v4 = Double number=1.5
    Return v4
}
function f2 name="givesText" kind=Arrow flags=[IsChecked] parameters=[{type=anything}] results=[{type=string site=w1}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3 casts=[{declared={type=string site=w1}}]
  b2():
    v4 = String string="text"
    Return v4
}
function f3 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3
  b2():
    v4 = Undefined
    Return v4
}
function f4 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3
  b2():
    v4 = Undefined
    Return v4
}
function f5 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3
  b2():
    v4 = Undefined
    Return v4
}
function f6 name="sixth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    ReturnCall v3
  b2():
    v4 = Undefined
    Return v4
}
function f7 name="start" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0
    Return v2
}
# CHECK-LABEL: function f1 name="givesNumber"
# CHECK: ReturnCall
# CHECK-NOT: requirement=Allowed
# CHECK-LABEL: function f2 name="givesText"
# CHECK: name="givesNumber"{{*}}role=GroupEntrypoint
# CHECK-NOT: Claim
# CHECK: [[result]]: {{*}} = CallDirect {{*}} function=f1 resultCheck=ByCallers
# CHECK-NEXT: ReturnCall [[result]]
# CHECK-NOT: requirement=Allowed
# CHECK: name="givesNumber"{{*}}role=GenericEntrypoint
# CHECK: [[isTested]]: boolean = ReturnsToResultTest
# CHECK-NEXT: Branch [[isTested]] -> taken [[goesOn]](), notTaken [[waits]]()
# CHECK: [[goesOn]]():
# CHECK-NEXT: [[passedOn]]: {{*}} = CallDirect {{*}} function=f1 resultCheck=ByCallers
# CHECK-NEXT: ReturnCall [[passedOn]]
# CHECK-NOT: requirement=Allowed
# CHECK: [[waits]]():
# CHECK-NEXT: [[unchecked]]: {{*}} = CallDirect {{*}} function=f1 resultCheck=ByCallers
# CHECK-NEXT: [[checked]]: {{*}} = Claim [[unchecked]] castType=number site=w0
# CHECK-NEXT: Return [[checked]]
# LATER-LABEL: function f1 name="givesNumber"
# LATER: [[next]]: {{*}} = CallGroup
# LATER-NEXT: ReturnCall [[next]]
# LATER-LABEL: function f7 name="start"
# LATER-NOT: CallGroup
# LATER: = Call v{{*}}, -, v0
