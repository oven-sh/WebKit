# An entry fills in registers only, so a function that takes a boxed argument on the stack gets none
# FORM: Prepared
# RUN: pass ChooseCallingConventions
# STATISTIC: SecondaryEntries = 0
# CHECK: f0 Direct ({{*}}stack0:JSValue) -> ({{*}}:JSValue) reserved=1
# CHECK-NOT: entries=

module m0 path="main.js" displayPath="main.js"
function f0 name="nineParameters" parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    Return v0
}
function f1 name="caller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Undefined
    v2 = CallDirect v0, v0, v0, v0, v0, v0, v0, v1, v1 function=f0
    Return v2
}
