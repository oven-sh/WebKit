# A callee is measured by the code it becomes: a test whose own type says how it ends, the branch on it, the side that the branch never takes and a check for undefined and null of a value that is neither count nothing
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SummarizeForInlining

module m0 path="main.js" displayPath="main.js"

function f0 name="lengthOfText" parameters=[{type=string}] results=[{type=number}] {
    v1 = GetStringLength v0
    Return v1
}
# CHECK: f0: barrier=None bytes=[[plain]]

function f1 name="lengthOfTextBehindTestThatAlwaysPasses" parameters=[{type=string}] results=[{type=number}] {
    v1 = TypeTest v0 testedType=undefined|null|string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = RequireObjectCoercible v2 name="length"
    v4 = GetStringLength v3
    Return v4
  b2():
    v5 = CallDirect v0 function=f4
    v6 = CallDirect v5 function=f4
    Return v6
}
# CHECK: f1: barrier=None bytes=[[plain]] head=[b0 b1] headBytes=[[plain]]
# CHECK-NOT: condition(

function f2 name="lengthOfTextBehindTestThatNeverPasses" parameters=[{type=string}] results=[{type=number}] {
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f4
    Jump -> next b3(v2)
  b2():
    v3 = GetStringLength v0
    Return v3
  b3(v4):
    v5 = CallDirect v4 function=f4
    Return v5
}
# CHECK: f2: barrier=None bytes=[[plain]] head=[b0 b2] headBytes=[[plain]]
# CHECK-NOT: condition(

function f3 name="lengthOfTextThatMayBeMissing" parameters=[{type=undefined|string}] results=[{type=number}] {
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetStringLength v2
    Return v3
  b2():
    v4 = CallDirect v0 function=f4
    Return v4
}
# CHECK: f3: barrier=None
# CHECK-NOT: bytes=[[plain]]

function f4 name="measure" parameters=[{type=anything}] results=[{type=number}] {
    v1 = ToNumber v0
    Return v1
}
# CHECK: f4: barrier=None

function f5 name="checkOfValueThatMayBeMissing" parameters=[{type=undefined|string}] results=[{type=number}] {
    v1 = RequireObjectCoercible v0 name="length"
    v2 = GetStringLength v1
    Return v2
}
# CHECK: f5: barrier=None
# CHECK-NOT: bytes=[[plain]]
