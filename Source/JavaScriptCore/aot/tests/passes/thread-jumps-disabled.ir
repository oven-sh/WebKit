# With the switch of the pass off an edge whose argument decides the branch keeps its target
# FORM: Prepared
# OPTIONS: disable=pass:ThreadJumps
# RUN: pass ThreadJumps
# STATISTIC: ThreadJumpsChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="strictEquality" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=number}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Null
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v0)
  b3(v4):
    v5 = Null
    v6 = StrictEq v4, v5
    Branch v6 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
# CHECK-NEXT: b0(v0: number, v1: number, v2: boolean):
# CHECK-NEXT: Branch v2 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: v3: null = Null
# CHECK-NEXT: Jump -> next b3(v3)
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK-NEXT: b3(v4: null|number):
# CHECK-NEXT: v5: null = Null
# CHECK-NEXT: v6: boolean = StrictEq v4, v5
# CHECK-NEXT: Branch v6 -> taken b4(), notTaken b5()
# CHECK-NEXT: b4():
# CHECK-NEXT: Return v0
# CHECK-NEXT: b5():
# CHECK-NEXT: Return v1
}
