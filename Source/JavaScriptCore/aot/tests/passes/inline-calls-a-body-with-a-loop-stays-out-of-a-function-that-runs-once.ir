# A function that runs once is compiled as one. A loop runs more often wherever it stands: a body with a loop is not copied into a function that runs once, and stays a function that is compiled for what its loop does.
# A body without a loop is copied as anywhere.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline InlineCalls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Integer integer=0
    v6 = Greater v3, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = CallDirect v3 function=f1
    v8 = CallDirect v7 function=f2
    Jump -> next b1(v8)
  b3():
    Return v3
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = CallDirect {{*}}function=f1
# CHECK-NOT: function=f2

function f1 name="withALoop" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=0
    Jump -> next b1(v1, v1)
  b1(v2, v3):
    LoopHint
    v5 = Less v2, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    v7 = Increment v2
    Jump -> next b1(v7, v6)
  b3():
    Return v3
}
function f2 name="withoutALoop" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=3
    v2 = Sub v0, v1
    Return v2
}
