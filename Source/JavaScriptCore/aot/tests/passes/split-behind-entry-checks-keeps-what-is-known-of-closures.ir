# The function that tests stands under the id of the function that is split, and closures go on naming that id. What is known of reads on those closures stays with it. No closure names the typed body or the fallback.
# FORM: Prepared
# RUN: pass SplitBehindEntryChecks VerifyProgram
# STATISTIC: FunctionsSplitBehindEntryChecks = 1
# CHECK: outcome: Changed

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v0 function=f1
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="checked" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=number site=w0 flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, ClosuresAreReadWithoutCode] {
  b0(v0: anything ~ number):
    v1 = Check v0 castType=number site=w0
    v2 = Add v1, v1
    Return v2
}
# CHECK: function f1 name="checked" module=m0 position=5 role=EntryChecks{{*}} capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, ClosuresAreReadWithoutCode] creator=EntryChecks{body=f2 fallback=f3}
# CHECK: function f2 name="checked"{{*}} capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost]
# CHECK: function f3 name="checked"{{*}} role=GenericVersion{{*}} capabilities=[MayBeCloned, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost]
