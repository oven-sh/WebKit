    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3: i32, v4: int|whole ~ int[0, 2147483647]):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=127
    v8: int[0, 127] = BitAnd v4, v7
    v9: i32 = BitXor v3, v8
    v10: int|whole ~ int[1, 2147483648] = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f1 name="belowAnyNumber"
# CHECK: TypeTest {{*}} testedType=i32

function f2 name="anotherOperandIsTestedAllTheSame" parameters=[{type=int[0, 4294967296]}, {type=number}] results=[{type=i32}] {
  b0(v0: int[0, 4294967296], v1: number ~ i32):
    v2 = Integer integer=0
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4: i32, v5: int|whole ~ int[0, 2147483647]):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8: i32 = BitAnd v1, v5
    v9: i32 = BitXor v4, v8
    v10: int|whole ~ int[1, 2147483648] = Increment v5
    Jump -> next b1(v9, v10)
  b3():
    Return v4
}
# CHECK-LABEL: function f2 name="anotherOperandIsTestedAllTheSame"
