function f3 name="behindTheLoopItIsNoLongerBelow" parameters=[{type=int[0, 4294967296]}] results=[{type=i32}] {
  b0(v0: int[0, 4294967296]):
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2: int|whole ~ int[0, 2147483647]):
    LoopHint
    v4 = Less v2, v0
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Increment v2
    Jump -> next b1(v5)
  b3():
    Jump -> next b4(v1)
  b4(v6: i32):
    LoopHint
    v8 = Integer integer=127
    v9: int[0, 127] = BitAnd v2, v8
    v10: i32 = BitXor v6, v9
    v11 = Less v10, v8
    Branch v11 -> taken b4(v10), notTaken b5()
  b5():
    Return v6
}
# CHECK-LABEL: function f3 name="behindTheLoopItIsNoLongerBelow"
# CHECK: TypeTest v2 testedType=i32

function f4 name="bitsOfAnIntegerOfAnyRange" parameters=[{type=int[0, 4294967296]}, {type=int[0, 4294967296]}, {type=boolean}, {type=number}] results=[{type=i32}] {
  b0(v0: int[0, 4294967296], v1: int[0, 4294967296], v2: boolean, v3: number):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v4: int[0, 4294967296] ~ int[0, 2147483647]):
    v5 = Integer integer=0
    Jump -> next b4(v5)
  b4(v6: i32):
    LoopHint
    v8: i32 = BitAnd v4, v6
    v9: int[-2147483647, 2147483648] = Increment v8
    v10: i32 = BitOr v9, v5
    v11 = Less v10, v3
    Branch v11 -> taken b4(v10), notTaken b5()
  b5():
    Return v6
}
# CHECK-LABEL: function f4 name="bitsOfAnIntegerOfAnyRange"
# CHECK-NOT: TypeTest

function f5 name="aCounterThatIsReturnedBehindTheLoopIsMadeAValueOnce" parameters=[{type=int[0, 4294967296]}, {type=boolean}] results=[{type=number}] {
  b0(v0: int[0, 4294967296], v1: boolean):
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3: int|whole ~ int[0, 2147483647]):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b4()
  b2():
    Branch v1 -> taken b3(), notTaken b5()
  b3():
    v6: int|whole ~ int[1, 2147483648] = Increment v3
    Jump -> next b1(v6)
  b4():
    Return v2
  b5():
    Return v3
}
# CHECK-LABEL: function f5 name="aCounterThatIsReturnedBehindTheLoopIsMadeAValueOnce"
# CHECK-NOT: TypeTest

