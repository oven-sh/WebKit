# A counter that a comparison keeps below an integer beyond int32 is an integer there, which ConvertCountersToIntegers finds out: no operator in the loop gets a test of it, unless something in the loop wants it as a value or as the index of an array
# FORM: Prepared
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
function f0 name="belowTheLengthOfAView" parameters=[{type=int[0, 4294967296]}] results=[{type=i32}] {
  b0(v0: int[0, 4294967296]):
    v1 = Integer integer=0
    v2 = Integer integer=0
    Jump -> next b1(v1, v2)
  b1(v3: i32, v4: int|whole ~ int[0, 2147483647]):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=127
    v8: int[0, 127] = BitAnd v4, v7
    v9: i32 = BitXor v3, v8
    v10: int|whole ~ int[1, 2147483648] = Increment v4
    Jump -> next b1(v9, v10)
  b3():
    Return v3
}
# CHECK-LABEL: function f0 name="belowTheLengthOfAView"
# CHECK-NOT: TypeTest

