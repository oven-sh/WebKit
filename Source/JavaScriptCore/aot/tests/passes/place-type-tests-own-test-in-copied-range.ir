}
# CHECK-LABEL: function f6 name="ownTestOfOtherType"
# CHECK: b1():
# CHECK: v4: anything = GetSlot [[proven6]],
# CHECK: v2: anything = GetSlot [[proven6]],
# CHECK: Branch v3 -> taken b2(v2), notTaken b1()
# CHECK: ([[proven6]]: L0):

function f7 name="ownTestBehindLastUse" flags=[IsChecked] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1: anything ~ undefined|L0 = Upcast v0 castType=anything
    v2 = PropGet v1 key="y" receivers=[L0, ..]
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v2
    v6 = TypeTest v1 testedType=L0
    Branch v6 -> taken b1(), notTaken b2()
  b1():
    Return v2
  b2():
    Return v5
}
# CHECK-LABEL: function f7 name="ownTestBehindLastUse"
# CHECK: b1():
# CHECK: v6: boolean = TypeTest v1 testedType=L0
# CHECK-NEXT: Branch v6 -> taken b1(), notTaken b2()

function f8 name="ownTestInCoveredLoop" flags=[IsChecked] parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2: anything ~ undefined|L0 = Upcast v0 castType=anything
    Jump -> next b1()
  b1() handler=b7():
    LoopHint
    Branch v1 -> taken b2(), notTaken b6()
  b2() handler=b7():
    v4 = PropGet v2 key="y" receivers=[L0, ..]
    v5 = TypeTest v2 testedType=L0
    Branch v5 -> taken b3(), notTaken b4()
  b3() handler=b7():
    Jump -> next b5()
  b4() handler=b7():
    Jump -> next b5()
  b5() handler=b7():
    v6 = PropGet v2 key="y" receivers=[L0, ..]
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="sink" [isFreeName]
    v9 = Call v8, -, v6
    Jump -> next b1()
  b6():
    Return v0
  b7() role=CatchHandler:
    v10 = CatchValue
    v11 = PropGet v2 key="y" receivers=[L0, ..]
    Return v11
}
# CHECK-LABEL: function f8 name="ownTestInCoveredLoop"
# CHECK: b1([[header8]]: L0) handler=b7():
# CHECK-NOT: BelongsToInstance
# CHECK: b3([[adopted8]]: L0) handler=b7():
# CHECK-NEXT: Jump -> next b5([[adopted8]])
# CHECK-NEXT: b4() handler=b7():
# CHECK-NEXT: Jump -> next b5([[header8]])
# CHECK-NEXT: b5([[joined8]]: L0) handler=b7():
# CHECK: v6: anything = GetSlot [[joined8]],
# CHECK: Jump -> next b1([[joined8]])
# CHECK: v11: anything = PropGet v2 key="y"
# CHECK: v4: anything = GetSlot [[header8]],
# No call ends the proof that the object belongs to this instance, so it is tested once, in front of the loop.
# CHECK: ([[entered8]]: L0):
# CHECK-NEXT: = BelongsToInstance [[entered8]]
# CHECK: Jump -> next b1([[entered8]])
