# In the body of a coroutine a cell that is dead at every suspension is in the frame, a cell that is live across one is on the heap
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# RUN(PLAN): frame-plan flow
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,AllocateInFrames

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="deadBeforeAwait" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="closureLiveAcrossAwait" fields=[{key="x" declared={type=anything}}]
layout L2 kind=Environment name="environmentLiveAcrossAwait" fields=[{key="x" declared={type=anything}}]
layout L3 kind=Environment name="createdAfterAwait" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect v1 function=f4
    Return
}

function f1 name="deadBeforeAwait" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f6
    v3 = CallDirect v2 function=f5
    v4 = Await v0
    Return v4
}
# PLAN-LABEL: function f1
# PLAN-NEXT: v1: Frame
# PLAN-NEXT: v2: Frame

function f2 name="closureLiveAcrossAwait" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure v1 function=f7
    v3 = Await v0
    v4 = CallDirect v2 function=f5
    Return v4
}
# PLAN-LABEL: function f2
# PLAN-NEXT: v1: Heap HeldByHeapCell by v2(0)
# PLAN-NEXT: v2: Heap LiveAcrossSuspension by v3(0)

function f3 name="environmentLiveAcrossAwait" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f8
    v3 = CallDirect v2 function=f5
    v4 = Await v0
    v5 = GetEnvironmentField v1 layout=L2 field=0
    Return v5
}
# PLAN-LABEL: function f3
# PLAN-NEXT: v1: Heap LiveAcrossSuspension by v4(0)
# PLAN-NEXT: v2: Frame

function f4 name="createdAfterAwait" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    v2 = NewObject -, v1 layout=L3 fields=[0]
    v3 = NewClosure v2 function=f9
    v4 = CallDirect v3 function=f5
    Return v4
}
# PLAN-LABEL: function f4
# PLAN-NEXT: v2: Frame
# PLAN-NEXT: v3: Frame

function f5 name="callsParameter" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
# PLAN-LABEL: function f5

# REPEAT: i = 0..3
function f%(i+6) name="callback" kind=Arrow captures=[{type=env L%(i)}] results=[{type=anything}] {
  b0(v0: env L%(i)):
    v1 = GetEnvironmentField v0 layout=L%(i) field=0
    v2 = ToBoolean v1
    Return v2
}
# END REPEAT
# CHECK-LABEL: name="deadBeforeAwait" module=m0 role=CoroutineBody
# CHECK: = NewObject {{*}}layout=L0 {{*}}storage=Frame
# CHECK: = NewClosure {{*}}function=f6 {{*}}storage=Frame
# CHECK: AwaitBySavingFrame
# CHECK-LABEL: name="closureLiveAcrossAwait" module=m0 role=CoroutineBody
# CHECK-NOT: storage=
# CHECK: AwaitBySavingFrame
# CHECK-NOT: storage=
# CHECK-LABEL: name="environmentLiveAcrossAwait" module=m0 role=CoroutineBody
# CHECK: = NewObject {{*}}layout=L2
# CHECK-NOT: storage=
# CHECK: = NewClosure {{*}}function=f8 {{*}}storage=Frame
# CHECK: AwaitBySavingFrame
# CHECK-LABEL: name="createdAfterAwait" module=m0 role=CoroutineBody
# CHECK: AwaitBySavingFrame
# CHECK: = NewObject {{*}}layout=L3 {{*}}storage=Frame
# CHECK: = NewClosure {{*}}function=f9 {{*}}storage=Frame
