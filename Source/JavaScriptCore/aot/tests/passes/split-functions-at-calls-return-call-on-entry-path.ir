# An entry path that ends in a tail call leaves the function without a frame, so it counts as an exit
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="entryPathEndsInTailCall" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v0 function=f3
    ReturnCall v3
  b2():
    v4 = Call v1, -, v0
    v5 = TypeTest v4 testedType=number
    Return v5
}
# CHECK-LABEL: function f0 name="entryPathEndsInTailCall"
# CHECK-NOT: = Call v1
# CHECK: Branch v2 -> taken b1(), notTaken [[leaving0]]()
# CHECK-NEXT: b1():
# CHECK-NEXT: v3: anything = CallDirect v0 function=f3
# CHECK-NEXT: ReturnCall v3
# CHECK-NEXT: [[leaving0]]():
# CHECK-NEXT: [[rest0]]: anything = CallDirect v0, v1 function=f4
# CHECK-NEXT: ReturnCall [[rest0]]
# CHECK-NOT: = Call v1

function f1 name="entryPathEndsInTailCallByValue" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1
    ReturnCall v3
  b2():
    v4 = Call v1, -, v0
    v5 = TypeTest v4 testedType=number
    Return v5
}
# CHECK-LABEL: function f1 name="entryPathEndsInTailCallByValue"
# CHECK-NOT: = Call v1, -, v0
# CHECK: Branch v2 -> taken b1(), notTaken [[leaving1]]()
# CHECK-NEXT: b1():
# CHECK-NEXT: v3: anything = Call v1
# CHECK-NEXT: ReturnCall v3
# CHECK-NEXT: [[leaving1]]():
# CHECK-NEXT: [[rest1]]: anything = CallDirect v0, v1 function=f5
# CHECK-NEXT: ReturnCall [[rest1]]
# CHECK-NOT: = Call v1, -, v0

function f2 name="entryPathEndsInCallAndReturn" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v0 function=f3
    Return v3
  b2():
    v4 = Call v1, -, v0
    v5 = TypeTest v4 testedType=number
    Return v5
}
# CHECK-LABEL: function f2 name="entryPathEndsInCallAndReturn"
# CHECK-NOT: ReturnCall
# CHECK: = Call v1, -, v0
# CHECK-NOT: ReturnCall

function f3 name="callee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK-LABEL: function f3 name="callee"
# CHECK-LABEL: function f4 name="entryPathEndsInTailCall" module=m0 role=Continuation{{*}}parameters=[{type=anything}, {type=function}] results=[{type=anything}]{{*}}derivation={source=f0{{*}}} creator=Continuation{origin=f0}
# CHECK: = Call
# CHECK-LABEL: function f5 name="entryPathEndsInTailCallByValue" module=m0 role=Continuation{{*}}derivation={source=f1{{*}}} creator=Continuation{origin=f1}
# CHECK: = Call
# CHECK-NOT: function f6
