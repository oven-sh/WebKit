# A part of a fresh result may be a value that the slot of its field does not admit: the worker returns it as it is, and a rare arm of the wrapper stores it by name behind the allocation
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass SplitFreshResults VerifyProgram
# STATISTIC: FreshResultsSplit = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Sized" fields=[{key="n" declared={type=number} flags=[IsRequired]}, {key="label" declared={type=string} flags=[IsRequired]}]

function f0 name="sized" parameters=[{type=anything}, {type=string}] results=[{type=L0}] {
  b0(v0: anything, v1: string):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: number):
    v4 = NewObject -, v3, v1 layout=L0 fields=[0, 1]
    Jump -> next b3(v4)
  b2() frequency=Rare:
    v5 = Integer integer=0
    v6 = NewObject -, v5, v1 layout=L0 fields=[0, 1]
    PropSet v6, v0 key="n" mode=Strict receivers=[L0]
    v8 = FinishObject v6
    Jump -> next b3(v8)
  b3(v9: L0):
    v10 = IsSlotFilled v9 key="label" receivers=[L0] level=Expected
    Return v9
}
# CHECK-LABEL: function f0 name="sized" module=m0 role=ResultWrapper
# CHECK: [[call]]:{{*}}= CallDirect v0, v1 function=[[worker]]
# CHECK: Switch
# CHECK: frequency=Rare:
# CHECK-NEXT: [[filler]]:{{*}}= Integer
# CHECK-NEXT: [[object]]:{{*}}= NewObject -, [[filler]], {{*}} layout=L0 fields=[0, 1]
# CHECK-NEXT: PropSet [[object]], {{*}} key="n"

function f1 name="twoPlacesOneValue" parameters=[{type=number}, {type=string}, {type=boolean}] results=[{type=L0}] {
  b0(v0: number, v1: string, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0, v1 layout=L0 fields=[0, 1] allocationSite=1
    Return v3
  b2():
    v4 = Add v0, v0
    v5 = NewObject -, v4, v1 layout=L0 fields=[0, 1] allocationSite=2
    Return v5
}
# CHECK-LABEL: function f1 name="twoPlacesOneValue" module=m0 role=ResultWrapper
# CHECK-NOT: Switch
# CHECK: = NewObject -, {{*}} layout=L0 fields=[0, 1]
# CHECK-NOT: NewObject

function f2 name="caller" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: anything, v1: string):
    v2 = CallDirect v0, v1 function=f0 [isNeverInlined]
    v3 = IsSlotFilled v2 key="n" receivers=[L0] level=Expected
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: guard):
    v5 = GetSlot v2, v4 key="n" receivers=[L0] level=Expected
    Return v5
  b2() frequency=Rare:
    v6 = PropGet v2 key="n" receivers=[L0]
    Return v6
}
# CHECK-LABEL: function f2 name="caller"
# CHECK-NOT: NewObject
# CHECK-NOT: PropSet
# CHECK: [[parts]]:{{*}}= CallDirect v0, v1 function=[[worker]]
# CHECK-NOT: PropGet
# CHECK: Return

function f3 name="otherCaller" parameters=[{type=number}, {type=string}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: string, v2: boolean):
    v3 = CallDirect v0, v1, v2 function=f1
    v4 = PropGet v3 key="label" receivers=[L0]
    Return v4
}
# CHECK-LABEL: function f3 name="otherCaller"
# CHECK-NOT: NewObject
# CHECK-NOT: Switch
# CHECK: Return
