# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="appendsInLoop" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=string}] {
    v3 = String string=""
    v4 = Integer integer=0
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v6, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = Add v5, v0
    v10 = Integer integer=1
    v11 = Add v6, v10
    Jump -> next b1(v9, v11)
  b3():
    Return v5
}
# CHECK-LABEL: name="appendsInLoop"
