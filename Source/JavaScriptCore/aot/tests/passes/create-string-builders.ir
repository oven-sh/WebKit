function f2 name="appendsOnBranches" parameters=[{type=boolean}, {type=string}] results=[{type=string}] {
    v2 = String string="a"
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Add v2, v1
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v2)
  b3(v4):
    v5 = Add v4, v1
    Branch v0 -> taken b4(), notTaken b5()
  b4():
    v6 = Add v5, v1
    Jump -> next b6(v6)
  b5():
    Jump -> next b6(v5)
  b6(v7):
    v8 = Add v7, v1
    Return v8
}
# CHECK-LABEL: name="appendsOnBranches"
# CHECK: [[a2]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: StringBuilderAppend [[a2]], v2, v1
# CHECK-NEXT: Jump -> next b3([[a2]])
# CHECK: [[b2]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: StringBuilderAppend [[b2]], v2
# CHECK-NEXT: Jump -> next b3([[b2]])
# CHECK: b3(v4: stringbuilder):
# CHECK-NEXT: StringBuilderAppend v4, v1
# CHECK: StringBuilderAppend v4, v1
# CHECK-NEXT: Jump -> next b6(v4)
# CHECK: Jump -> next b6(v4)
# CHECK: b6(v7: stringbuilder):
# CHECK-NEXT: StringBuilderAppend v7, v1
# CHECK: [[r2]]: string = StringBuilderFinish v7
# CHECK-NEXT: Return [[r2]]

