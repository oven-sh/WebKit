# A handler on the loop header does not keep a read in the loop: the read cannot throw
# FORM: Prepared
# RUN: pass HoistLoopInvariantReads
# STATISTIC: HoistLoopInvariantReadsChanges = 3

module m0 path="main.js" displayPath="main.js"
variable g0 name="limit" declared={type=number}
variable g1 name="late" declared={type=number|absent}

function f0 name="throwsBelowZero" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=0
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Throw v0
  b2():
    Return v0
}

function f1 name="handlerBehindTheLoop" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b3():
    LoopHint
    v2 = GetModuleVariable variable=g0
    v3 = CallDirect v2 function=f0
    v4 = Less v0, v3
    Branch v4 -> taken b2(), notTaken b4()
  b2() handler=b3():
    Jump -> next b1()
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v0
  b4():
    Return v2
}
# CHECK-LABEL: function f1 name="handlerBehindTheLoop"
# CHECK: b0(
# CHECK-NEXT: v2: number = GetModuleVariable variable=g0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b3():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = CallDirect v2 function=f0

function f2 name="handlerInTheLoop" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b2():
    LoopHint
    v2 = GetModuleVariable variable=g0
    v3 = CallDirect v2 function=f0
    v4 = Less v0, v3
    Branch v4 -> taken b1(), notTaken b3()
  b2() role=CatchHandler:
    v5 = CatchValue
    Jump -> next b1()
  b3():
    Return v2
}
# CHECK-LABEL: function f2 name="handlerInTheLoop"
# CHECK: b0(
# CHECK-NEXT: v2: number = GetModuleVariable variable=g0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NOT: GetModuleVariable

function f3 name="handlerInTheLoopStores" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b2():
    LoopHint
    v2 = GetModuleVariable variable=g0
    v3 = CallDirect v2 function=f0
    v4 = Less v0, v3
    Branch v4 -> taken b1(), notTaken b3()
  b2() role=CatchHandler:
    v5 = CatchValue
    PutModuleVariable v0 variable=g0
    Jump -> next b1()
  b3():
    Return v2
}
# CHECK-LABEL: function f3 name="handlerInTheLoopStores"
# CHECK: b0(
# CHECK-NEXT: Jump -> next b1()
# CHECK: LoopHint
# CHECK-NEXT: v2: number = GetModuleVariable variable=g0

function f4 name="checkStaysUnderTheHandler" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b3():
    LoopHint
    v2 = GetModuleVariable variable=g1
    v3 = CheckInitialized v2 name="late"
    v4 = Less v0, v3
    Branch v4 -> taken b2(), notTaken b4()
  b2() handler=b3():
    Jump -> next b1()
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v0
  b4():
    Return v3
}
# CHECK-LABEL: function f4 name="checkStaysUnderTheHandler"
# CHECK: b0(
# CHECK-NEXT: v2: number|absent = GetModuleVariable variable=g1
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1() handler=b3():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: v3: number = CheckInitialized v2 name="late"

function f5 name="headerIsTheHandler" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1()
  b1() handler=b2():
    v1 = CallDirect v0 function=f0
    Jump -> next b4(v1)
  b2() role=CatchHandler:
    v2 = CatchValue
    v3 = GetModuleVariable variable=g0
    Jump -> next b3()
  b3() handler=b2():
    LoopHint
    v5 = CallDirect v3 function=f0
    Jump -> next b4(v5)
  b4(v6):
    Return v6
}
# CHECK-LABEL: function f5 name="headerIsTheHandler"
# CHECK: = CallDirect v0 function=f0
# CHECK-NEXT: Jump -> next b4(v1)
# CHECK: = CatchValue
# CHECK-NEXT: v3: number = GetModuleVariable variable=g0
