# A value that may be absent is never the operand of a release
# FORM: Prepared
# RUN: pass ReuseEnvironments
# CHECK: reused environments: []
# CHECK-NEXT: outcome: Unchanged
# CHECK: b1(v3: absent|env L0):
# CHECK-NOT: ReleaseEnvironment

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="copiedPerIteration" fields=[{key="x" declared={type=anything}}]

function f0 name="parameterMayBeAbsent" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = Absent
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = CallDirect v3 function=f1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v6)
  b3():
    Return v5
}

function f1 name="captureMayBeAbsent" kind=Arrow captures=[{type=absent|env L0}] results=[{type=anything}] {
  b0(v0: absent|env L0):
    Return
}
