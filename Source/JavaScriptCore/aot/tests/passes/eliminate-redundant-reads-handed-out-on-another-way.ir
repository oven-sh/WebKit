# A block that hands an object out and never comes back says nothing about the other ways: unknown code there cannot have written to the object
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired] flow={occupancy=AlwaysFilled}}] flow={impossibleMutations=[DeleteField, RedefineProperty]}

function f0 name="handedOutInBlocksThatLeave" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = TypeTest v1 testedType=number
    Branch v3 -> taken b1(), notTaken b3()
  b1():
    v4 = Call v1
    v5 = TypeTest v4 testedType=number
    Branch v5 -> taken b2(), notTaken b4()
  b2():
    v6 = Call v1
    v7 = GetSlot v2 key="x" receivers=[L0] level=Proven
    Return v7
  b3() frequency=Rare:
    v8 = Integer integer=1
    v9 = CallDirect v8, v0, v1, v2 function=f2
    ReturnCall v9
  b4() frequency=Rare:
    v10 = Integer integer=2
    v11 = CallDirect v10, v0, v4, v2 function=f2
    ReturnCall v11
# CHECK: b2():
# CHECK-NEXT: = Call v1
# CHECK-NEXT: v7: anything = Upcast v0
}

function f1 name="handedOutInABlockThatComesBack" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = TypeTest v1 testedType=number
    Branch v3 -> taken b2(), notTaken b1()
  b1() frequency=Rare:
    v4 = Integer integer=1
    v5 = CallDirect v4, v0, v1, v2 function=f2
    Jump -> next b2()
  b2():
    v6 = Call v1
    v7 = GetSlot v2 key="x" receivers=[L0] level=Proven
    Return v7
# CHECK: b2():
# CHECK-NEXT: = Call v1
# CHECK-NEXT: v7: anything = GetSlot v2
}

function f2 name="takesWhatIsAlive" parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v4 = Call v1, -, v0, v2, v3
    Return v4
}
