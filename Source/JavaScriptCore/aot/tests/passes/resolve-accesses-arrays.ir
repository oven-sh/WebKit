# An access by key on an array that is proven pristine, with a proven kind of storage, becomes an element operation without a test, and keeps the level and the source access of the access it replaces
# FORM: Prepared
# RUN: pass ResolveAccesses

module m0 path="main.js" displayPath="main.js"
function f0 name="read" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage, Names]>}, {type=int[0, 1000]}] results=[{type=anything}] {
    v2 = ElemGet v0, v1 accessSite=1
    Return v2
# CHECK: = GetArrayElement v0, v1 arrayStorage=Contiguous level=Proven accessSite=1 [keyIsIntegral]
}
function f1 name="test" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage, Names]>}, {type=int[0, 1000]}] results=[{type=boolean}] {
    v2 = ElemHas v0, v1 accessSite=2
    Return v2
# CHECK: = HasArrayElement v0, v1 arrayStorage=Contiguous level=Proven accessSite=2 [keyIsIntegral]
}
function f2 name="store" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage, Names]>}, {type=int[0, 1000]}, {type=anything}] results=[{type=undefined}] {
    ElemSet v0, v1, v2 mode=Sloppy accessSite=3
    Return
# CHECK: PutArrayElement v0, v1, v2 arrayStorage=Contiguous mode=Sloppy level=Proven accessSite=3 [keyIsIntegral]
}
function f3 name="testAtAnyNumber" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage, Names]>}, {type=number}] results=[{type=boolean}] {
    v2 = ElemHas v0, v1 accessSite=4
    Return v2
# CHECK: = HasArrayElement v0, v1 arrayStorage=Contiguous level=Proven accessSite=4
# CHECK-NOT: keyIsIntegral
}

# An accessor may answer to the name of -1 or 1.5 on an array whose names are not proven
function f4 name="namesNotProven" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage]>}, {type=number}] results=[{type=boolean}] {
    v2 = ElemHas v0, v1 accessSite=5
    Return v2
# CHECK-NOT: HasArrayElement
# CHECK: = ElemHas v0, v1 accessSite=5
# CHECK-NOT: HasArrayElement
}
function f5 name="notPristine" parameters=[{type=Array<anything>}, {type=int[0, 1000]}] results=[{type=boolean}] {
    v2 = ElemHas v0, v1 accessSite=6
    Return v2
# CHECK-NOT: HasArrayElement
# CHECK: = ElemHas v0, v1 accessSite=6
# CHECK-NOT: HasArrayElement
}
