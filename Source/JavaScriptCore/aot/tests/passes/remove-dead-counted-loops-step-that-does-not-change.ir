function f3 name="stepIsTakenAway" parameters=[{type=int[0, 100]}, {type=int[1, 5]}] results=[{type=undefined}] {
    v2 = Integer integer=100
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
