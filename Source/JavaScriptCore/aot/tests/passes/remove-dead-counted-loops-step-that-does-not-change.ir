# A step that is no constant and does not change in the loop ends the loop too, if it is never zero and leads towards the bound
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass RemoveDeadCountedLoops
# STATISTIC: RemoveDeadCountedLoopsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="stepIsAboveZero" parameters=[{type=int[0, 100]}, {type=int[1, 5]}] results=[{type=undefined}] {
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Add v6, v1
    Jump -> next b1(v7)
  b3():
    Return
# CHECK: Jump -> next b3()
# CHECK-NOT: LoopHint
}

