# The reads and calls of the protocol on an iterable class of the program are resolved to direct calls and slot reads
# TODO: resolve-calls: the calls of @@iterator and next that an expanded loop makes on a class of the program are no longer direct calls
# FORM: Prepared optimizing
# RUN: pass ExpandIteration ResolveCalls RetypeValues ResolveCalls RetypeValues ResolveAccesses CompactBlocks
# RUN(LEFT): pass ExpandIteration
# STATISTIC: IterationsExpandedGenerically = 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Range" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key=@@iterator function=f1 mutability=Fixed}]}
layout L1 kind=Instance name="RangeIterator" constructor=f2 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="next" function=f3 mutability=Fixed}]}
layout L2 name="Step" fields=[{key="value" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="done" declared={type=boolean} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype]}
layout L3 kind=Instance name="OpenRange" constructor=f6 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key=@@iterator function=f1}] namedMembers=[{key=@@iterator function=f1}]}
function f0 name="Range" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="iterator" kind=Method flags=[HasThis] thisType={type=L0} results=[{type=L1}] {
    v1 = NewObject layout=L1
    Return v1
}
function f2 name="RangeIterator" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f3 name="next" kind=Method flags=[HasThis] thisType={type=L1} results=[{type=L2}] {
    v1 = Integer integer=1
    v2 = Boolean boolean=false
    v3 = NewObject -, v1, v2 layout=L2 fields=[0, 1]
    Return v3
}

function f4 name="protocolByHand" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key=@@iterator
    v3 = Call v2, v0 calleeKey=@@iterator
    v4 = PropGet v3 key="next"
    v5 = Call v4, v3 calleeKey="next"
    v6 = PropGet v5 key="done"
    v7 = PropGet v5 key="value"
    v8 = Call v1, -, v6, v7
    Return v8
# CHECK: = CallDirect v0 function=f1
# CHECK: = CallDirect {{*}} function=f3
# CHECK: = GetSlot {{*}} key="done" receivers=[L2] level=Proven
# CHECK: = GetSlot {{*}} key="value" receivers=[L2] level=Proven
}

function f5 name="userIterator" parameters=[{type=L0}, {type=anything}] results=[{type=undefined}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
# The reads and calls of the expansion are resolved like the ones a program writes by hand.
# CHECK: = CallDirect v0 function=f1
# CHECK: LoopHint
# CHECK: = CallDirect {{*}} function=f3
# CHECK: = GetSlot {{*}} key="done" receivers=[L2] level=Proven
# CHECK: = GetSlot {{*}} key="value" receivers=[L2] level=Proven
}

function f6 name="OpenRange" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f7 name="methodMayChange" parameters=[{type=L3}, {type=anything}] results=[{type=undefined}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b3(), notTaken b2()
  b2():
    v7 = Call v1, -, v6
    Jump -> next b1()
  b3():
    Return
# Nothing says that the method of this class stays what the class body defined, so the read and the calls stay.
# CHECK-NOT: CallDirect
# CHECK: = PropGet v0 key=@@iterator
# CHECK-NOT: CallDirect
# CHECK: key="next"
# CHECK-NOT: CallDirect
}

# LEFT-NOT: IteratorOpen
# LEFT-NOT: IteratorResume
# LEFT-NOT: IteratorClose
# LEFT-NOT: AppendSpread
