# An export that is read only as the variable it is may stay empty until its first read, also where the namespace object that lists it is made as `this` of a call. An export that is read out of that object is filled at the start: the run time takes an empty one to be in its dead zone.
#   import * as all from "./made.js"; all.look(); later(() => all.direct)
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 1
# STATISTIC: VariablesFilledByInitializers = 1

# CHECK: variable g0 name="direct" module=m1 declared={type=absent|L0}
# CHECK-NEXT: variable g1 name="looked" module=m1 declared={type=L0}
# CHECK-LABEL: function f1 name="made"
# CHECK-NOT: variable=g0
# CHECK: PutModuleVariable {{*}} variable=g1
# CHECK-NOT: variable=g0
# CHECK: Return

module m0 path="/main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/made.ts" displayPath="made.ts" body=f1 exports=[{name="direct" variable=g0}, {name="look" variable=g2}, {name="looked" variable=g1}]
entry module=m0
layout L0 fields=[{key="a" declared={type=number} flags=[IsRequired]}]
variable g0 name="direct" module=m1 declared={type=L0}
variable g1 name="looked" module=m1 declared={type=L0}
variable g2 name="look" module=m1 declared={type=function} initialization=Function function=f2 flags=[IsImmutable]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = ModuleNamespace module=m1
    v2 = Call v0, v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="publish" [isFreeName]
    v5 = NewClosure function=f3
    v6 = Call v4, -, v2, v5
    Return
}
function f1 name="made" module=m1 kind=Module results=[{type=anything}] {
    v0 = Double number=1.5
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v1, v0 key="a" mode=Strict
    PropSet v1, v0 key="a" mode=Strict
    PutModuleVariable v1 variable=g0
    v5 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v5, v0 key="a" mode=Strict
    PropSet v5, v0 key="a" mode=Strict
    PutModuleVariable v5 variable=g1
    Return
}
function f2 name="look" module=m1 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="looked"
    Return v1
}
function f3 name="reader" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    Return v0
}
