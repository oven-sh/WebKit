# A join of one value with copies of it that a test or a cast gave a stronger type is that value, unless the join still knows more than the value's own type
# FORM: Prepared optimizing
# RUN: pass RemoveTrivialParameters EliminateDeadCode
# STATISTIC: RemoveTrivialParametersChanges = 4

module m0 path="main.js" displayPath="main.js"

function f0 name="narrowedOnOneEdge" parameters=[{type=string}] results=[{type=string}] {
    v1 = String string="get"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(v0)
  b1(v3):
    Jump -> next b2(v3)
  b2(v4):
    Return v4
# CHECK: Branch v2 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Jump -> next b2()
# CHECK-NEXT: b2():
# CHECK-NEXT: Return v0
}

function f1 name="narrowedOnBothEdges" parameters=[{type=undefined|string}] results=[{type=undefined|string}] {
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Jump -> next b3(v2)
  b2(v3):
    Jump -> next b3(v3)
  b3(v4):
    Return v4
# CHECK: Branch v1 -> taken b1(), notTaken b2()
# CHECK: b3():
# CHECK-NEXT: Return v0
}

function f2 name="chainOfJoins" parameters=[{type=string}] results=[{type=string}] {
    v1 = String string="get"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(v0)
  b1(v3):
    Jump -> next b2(v3)
  b2(v4):
    v5 = String string="put"
    v6 = StrictEq v4, v5
    Branch v6 -> taken b3(| 0), notTaken b4(v4)
  b3(v7):
    Jump -> next b4(v7)
  b4(v8):
    Return v8
# CHECK: = StrictEq v0, v1
# CHECK: = StrictEq v0, v5
# CHECK-NEXT: Branch v6 -> taken b3(), notTaken b4()
# CHECK: b4():
# CHECK-NEXT: Return v0
}

function f3 name="narrowedCopyIsUsed" parameters=[{type=undefined|string}] results=[{type=undefined|string}] {
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2(v0)
  b1(v2):
    v3 = GetStringLength v2
    v4 = Builtin builtin=GlobalThis
    PropSet v4, v3 key="seen"
    Jump -> next b2(v2)
  b2(v6):
    Return v6
# CHECK: Branch v1 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v2: string):
# CHECK-NEXT: = GetStringLength v2
# CHECK: b2():
# CHECK-NEXT: Return v0
}

function f4 name="joinKnowsMoreThanTheValue" parameters=[{type=undefined|number|string}] results=[{type=undefined|number|string}] {
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Jump -> next b4(v2)
  b2(v3):
    v4 = TypeTest v3 testedType=number
    Branch v4 -> taken b3(| 0), notTaken b5()
  b3(v5):
    Jump -> next b4(v5)
  b4(v6):
    Return v6
  b5():
    Return
# CHECK: Jump -> next b4(v2)
# CHECK: Jump -> next b4(v5)
# CHECK-NEXT: b4(v6: number|string):
# CHECK-NEXT: Return v6
}

function f5 name="joinWithAnotherValue" parameters=[{type=string}, {type=string}] results=[{type=string}] {
    v2 = String string="get"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(| 0), notTaken b2(v1)
  b1(v4):
    Jump -> next b2(v4)
  b2(v5):
    Return v5
# CHECK: Branch v3 -> taken b1(| 0), notTaken b2(v1)
# CHECK: Jump -> next b2(v4)
# CHECK-NEXT: b2(v5: string):
# CHECK-NEXT: Return v5
}
