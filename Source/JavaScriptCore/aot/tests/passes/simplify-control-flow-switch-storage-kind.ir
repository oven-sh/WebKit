function f4 name="comparisons" role=Library enclosingRuntimeFunction=4 parameters=[{type=Array<string, proven>}] results=[{type=anything}] {
  b0(v0: Array<string, proven>):
    v1 = ArrayStorageKind v0
    v2 = Integer integer=2
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Integer integer=10
    Return v4
  b2():
    v5 = Integer integer=3
    v6 = StrictEq v1, v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    v7 = Integer integer=20
    Return v7
  b4():
    v8 = Integer integer=1
    v9 = StrictEq v1, v8
