# A switch over the storage kind of an array that holds no numbers loses its case for doubles, like the comparison it was inferred from
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# RUN(INFERRED): pass InferSwitches SimplifyControlFlow

module m0 path="main.js" displayPath="main.js"
runtimefunction id=0 function=f0
runtimefunction id=1 function=f1
runtimefunction id=2 function=f2
runtimefunction id=3 function=f3
runtimefunction id=4 function=f4

function f0 name="provenStrings" role=Library enclosingRuntimeFunction=0 parameters=[{type=Array<string, proven>}] results=[{type=anything}] {
  b0(v0: Array<string, proven>):
    v1 = ArrayStorageKind v0
    Switch v1 cases=[2, 3, 1] -> case b1(), case b2(), case b2(), otherwise b3()
  b1():
    v2 = Integer integer=10
    Return v2
  b2():
    v3 = Integer integer=20
    Return v3
  b3():
    v4 = Integer integer=30
    Return v4
}
# CHECK-LABEL: function f0 name="provenStrings"
# CHECK: Switch v1 cases=[3, 1] -> case b2(), case b2(), otherwise b3()
# CHECK-NOT: integer=10

