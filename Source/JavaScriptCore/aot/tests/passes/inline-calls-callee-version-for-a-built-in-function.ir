function f3 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = CallDirect v0 function=f1 [isNeverInlined]
    v2 = CallDirect v0 function=f2 [isNeverInlined]
    Return v2
}
