    v66 = Add v65, v1
    Return v66
  b2():
    Return v1
}

function f1 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Boolean
    v2 = Builtin builtin=MathAbs
    v3 = Builtin builtin=Math
    v4 = CallDirect v1, v0, v0 function=f0
    v5 = CallDirect v2, v0, v0 function=f0
    v6 = CallDirect v3, v0, v0 function=f0
    Return v6
}
# CHECK-LABEL: function f1 name="first"
# CHECK: v4{{*}}= CallDirect v1, v0, v0 function=[[forBoolean]]
# CHECK-NEXT: v5{{*}}= CallDirect v2, v0, v0 function=[[forAbs]]
# CHECK-NEXT: v6{{*}}= CallDirect v3, v0, v0 function=f0

function f2 name="second" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Boolean
    v2 = CallDirect v1, v0, v0 function=f0
    Return v2
}
# CHECK-LABEL: function f2 name="second"
