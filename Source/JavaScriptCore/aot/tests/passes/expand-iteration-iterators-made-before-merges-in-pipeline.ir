# What the passes in front of ExpandIteration leave of `m.values()` on a parameter of a function that unknown code calls is a loop over the map. The generic copy behind the failed test iterates over whatever the call returns, and the two do not merge
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline ExpandIteration

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    Return
}
function f1 name="mapValues" parameters=[{type=Map<string, number>}] results=[{type=anything}] {
  b0(v0: Map<string, number>):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = PropGet v0 key="values"
    v4 = Call v3, v0 calleeKey="values"
    v5 = IteratorOpen v4
    Jump -> next b1()
  b1():
    LoopHint
    v7 = IteratorResume v5
    v8 = ResultAt v7 index=0
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    v9 = ResultAt v7 index=1
    v10 = Call v2, -, v9
    Jump -> next b1()
  b3():
    Return
}
# The loop is printed in front of the block that makes the iterator. In front of that block the checks name what would take an iterator; behind it they name the iterator.
# CHECK-LABEL: function f1 name="mapValues"
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume
# CHECK-NOT: MapIterator
# CHECK-NOT: calleeKey="next"
# CHECK-NOT: Switch
# CHECK: LoopHint
# CHECK-NEXT: = MapNext v0,
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume
# CHECK-NOT: MapIterator
# CHECK-NOT: calleeKey="next"
# CHECK-NOT: Switch
# CHECK: = TypeTest {{*}} testedType=builtin(MapPrototypeValues)
# CHECK: [[iterator1]]: MapIterator = CallBuiltin v0 overload=MapPrototypeValues/0
# CHECK-NOT: [[iterator1]]
# CHECK-NOT: Switch
# CHECK: [[isPristine1]]: boolean = IsPristine v0 builtinClass=Map aspects=[Names]
# CHECK-NEXT: Branch [[isPristine1]] -> taken {{*}}(| 0), notTaken [[changed1]]()
# CHECK-NOT: [[iterator1]]
# CHECK-NOT: Switch
# CHECK: [[changed1]]() frequency=Unlikely:
# CHECK-NOT: [[iterator1]]
# CHECK-NOT: Switch
# CHECK: = PropGet v0 key="values"
# CHECK: [[returned1]]: anything = Call {{*}}, v0 calleeKey="values"
# CHECK: = TypeTest [[returned1]] testedType=Array
# CHECK-NOT: [[iterator1]]
# CHECK-NOT: Switch
# CHECK: = CallDirect {{*}} function=[[openIterator]] [isNeverInlined]
# CHECK-NOT: [[iterator1]]
# CHECK-NOT: Switch
function f2 name="arrayEntries" parameters=[{type=Array<number>}] results=[{type=anything}] {
  b0(v0: Array<number>):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = PropGet v0 key="entries"
    v4 = Call v3, v0 calleeKey="entries"
    v5 = IteratorOpen v4
    Jump -> next b1()
  b1():
    LoopHint
    v7 = IteratorResume v5
    v8 = ResultAt v7 index=0
    Branch v8 -> taken b3(), notTaken b2()
  b2():
    v9 = ResultAt v7 index=1
    v10 = Call v2, -, v9
    Jump -> next b1()
  b3():
    Return
}
# CHECK-LABEL: function f2 name="arrayEntries"
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume
# CHECK-NOT: ArrayIterator
# CHECK-NOT: calleeKey="next"
# CHECK-NOT: Switch
# CHECK: LoopHint
# CHECK-NEXT: = PropGet v0 key="length"
# CHECK-NOT: IteratorOpen
# CHECK-NOT: IteratorResume
# CHECK-NOT: ArrayIterator
# CHECK-NOT: calleeKey="next"
# CHECK-NOT: Switch
# CHECK: [[iterator2]]: ArrayIterator = CallBuiltin v0 overload=ArrayPrototypeEntries/0
# CHECK-NOT: [[iterator2]]
# CHECK-NOT: Switch
# CHECK: [[isPristine2]]: boolean = IsPristine v0 builtinClass=Array aspects=[Names]
# CHECK-NEXT: Branch [[isPristine2]] -> taken {{*}}(| 0), notTaken [[changed2]]()
# CHECK-NOT: [[iterator2]]
# CHECK-NOT: Switch
# CHECK: [[changed2]]() frequency=Unlikely:
# CHECK-NOT: [[iterator2]]
# CHECK-NOT: Switch
# CHECK: = PropGet v0 key="entries"
# CHECK: [[returned2]]: anything = Call {{*}}, v0 calleeKey="entries"
# CHECK: = TypeTest [[returned2]] testedType=Array
# CHECK-NOT: [[iterator2]]
# CHECK-NOT: Switch
# CHECK: = CallDirect {{*}} function=[[openIterator]] [isNeverInlined]
# CHECK-NOT: [[iterator2]]
# CHECK-NOT: Switch
# CHECK: = ElemGet v0,
