# Before a pass takes anything out of a loop, each cast that stands apart from its value gets a fact where it stands. The value is at hand in front of the loop. What the cast says of it holds in the loop, behind
# the test there. A cast right behind the definition of its value gets none, and neither does any cast of a function without a loop
# FORM: Prepared optimizing
# OPTIONS: check=VerifyEachPass
# RUN: pass HoistLoopInvariantReads

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flow={occupancy=AlwaysFilled}}]
variable g0 name="count" declared={type=number} flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}

function f0 name="castBehindTestInLoop" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = GetModuleVariable variable=g0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = AssumeType v0 provenType=L0
    v5 = GetSlot v4 key="x" receivers=[L0] level=Proven
    v6 = ToBoolean v5
    Branch v6 -> taken b1(), notTaken b3()
  b3():
    Return v3
# CHECK: b0(v0: anything, v1: boolean):
# CHECK-NEXT: v3: number = GetModuleVariable variable=g0
# CHECK: LoopHint
# CHECK-NEXT: Branch v1
# CHECK: [[here]]: fact = Specified
# CHECK-NEXT: v4: L0 = AssumeType v0, [[here]] provenType=L0
# CHECK-NEXT: = GetSlot v4 key="x"
}
function f1 name="castBehindDefinitionInLoop" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1(v0)
  b1(v2: anything):
    v3 = AssumeType v2 provenType=L0
    LoopHint
    v5 = GetModuleVariable variable=g0
    v6 = GetSlot v3 key="x" receivers=[L0] level=Proven
    Branch v1 -> taken b1(v2), notTaken b2()
  b2():
    Return v6
# CHECK-NOT: Specified
# CHECK: v3: L0 = AssumeType v2 provenType=L0
# CHECK-NOT: Specified
}
# The second cast stands as far behind its value as a cast without a fact may. The fact that ties the first one comes to stand between them, and does not count.
function f2 name="tyingOneCastPartsNoOther" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    v2 = NewArray v0 contents=anything
    v3 = Integer integer=0
    v4 = NewArray v0 contents=anything
    v5 = Integer integer=1
    v6 = Integer integer=2
    v7 = Integer integer=3
    v8 = Integer integer=4
    v9 = Integer integer=5
    v10 = Integer integer=6
    v11 = Integer integer=7
    v12 = Integer integer=8
    v13 = Integer integer=9
    v14 = Integer integer=10
    v15 = Integer integer=11
    v16 = Integer integer=12
    v17 = Integer integer=13
    v18 = Integer integer=14
    v19 = AssumeType v2 provenType=Array
    v20 = AssumeType v4 provenType=Array
    Jump -> next b1()
  b1():
    LoopHint
    v22 = GetModuleVariable variable=g0
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v20
# CHECK: [[farther]]: fact = Specified
# CHECK-NEXT: v19: {{*}} = AssumeType v2, [[farther]] provenType=Array
# CHECK-NEXT: v20: {{*}} = AssumeType v4 provenType=Array
}
