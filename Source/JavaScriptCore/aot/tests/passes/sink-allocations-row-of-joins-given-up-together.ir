# An object that a row of merge blocks only hands on, up to a call that takes it as a cell: no parameter of the row pays once the one behind it is given up.
# All of them are given up in the judgement that gives up the last one, so the search for the allocation that does pay fits into this limit.
# One full analysis for each parameter of the row spends it, and then nothing is sunk.
# FORM: Prepared
# OPTIONS: limit=MaxSinkingWork:1000
# RUN: pass SinkAllocations
# STATISTIC: AllocationsSunk = 1
# STATISTIC: AllocationsMergedAtJoins = 0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]

function f0 name="aRowOfMergeBlocksHandsTheObjectOn" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = NewObject -, v1 layout=L0 fields=[0]
    PropDefine v3, v0 key="y" receivers=[L0]
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = NewObject -, v0 layout=L0 fields=[0]
    v6 = Call v0, -, v3
    Jump -> next b3(v5)
  b2():
    v7 = NewObject -, v1 layout=L0 fields=[0]
    Jump -> next b3(v7)
  b3(v8: L0):
    Branch v2 -> taken b4(), notTaken b5()
  b4():
    v9 = Call v0
    Jump -> next b6(v8)
  b5():
    Jump -> next b6(v8)
  b6(v10: L0):
    Branch v2 -> taken b7(), notTaken b8()
  b7():
    v11 = Call v0
    Jump -> next b9(v10)
  b8():
    Jump -> next b9(v10)
  b9(v12: L0):
    Branch v2 -> taken b10(), notTaken b11()
  b10():
    v13 = Call v0
    Jump -> next b12(v12)
  b11():
    Jump -> next b12(v12)
  b12(v14: L0):
    Branch v2 -> taken b13(), notTaken b14()
  b13():
    v15 = Call v0
    Jump -> next b15(v14)
  b14():
    Jump -> next b15(v14)
  b15(v16: L0):
    Branch v2 -> taken b16(), notTaken b17()
  b16():
    v17 = Call v0
    Jump -> next b18(v16)
  b17():
    Jump -> next b18(v16)
  b18(v18: L0):
    Branch v2 -> taken b19(), notTaken b20()
  b19():
    v19 = Call v0
    Jump -> next b21(v18)
  b20():
    Jump -> next b21(v18)
  b21(v20: L0):
    Branch v2 -> taken b22(), notTaken b23()
  b22():
    v21 = Call v0
    Jump -> next b24(v20)
  b23():
    Jump -> next b24(v20)
  b24(v22: L0):
    Branch v2 -> taken b25(), notTaken b26()
  b25():
    v23 = Call v0
    Jump -> next b27(v22)
  b26():
    Jump -> next b27(v22)
  b27(v24: L0):
    Branch v2 -> taken b28(), notTaken b29()
  b28():
    v25 = Call v0
    Jump -> next b30(v24)
  b29():
    Jump -> next b30(v24)
  b30(v26: L0):
    Branch v2 -> taken b31(), notTaken b32()
  b31():
    v27 = Call v0
    Jump -> next b33(v26)
  b32():
    Jump -> next b33(v26)
  b33(v28: L0):
    Branch v2 -> taken b34(), notTaken b35()
  b34():
    v29 = Call v0
    Jump -> next b36(v28)
  b35():
    Jump -> next b36(v28)
  b36(v30: L0):
    v31 = Call v1, -, v30
    Return v31
}
