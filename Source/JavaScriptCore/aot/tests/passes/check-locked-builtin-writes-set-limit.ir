# any = first or second or Object.prototype; any.hasOwnProperty
# The variable holds more than the analysis follows in one set, so the locked built-in is no longer followed and the untracked object stands for it.
# That it is given up writes nothing, and neither does a read through the untracked object: the build reports nothing, and no code runs that the build has not seen
# OPTIONS: limit=MaxValueFlowSetMembers:2
# STATISTIC: MaxValueFlowSetMembersHits >= 1
# RUN: pipeline CheckLockedBuiltinWrites
# RUN(FLOW): flow
# FLOW-NOT: unseen-code
# FLOW-NOT: builtin-location ObjectPrototype.{{*}}written at

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First"
layout L1 name="Second"
variable g0 name="any" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0 fields=[]
    v1 = NewObject layout=L1 fields=[]
    v2 = Builtin builtin=ObjectPrototype
    PutModuleVariable v0 variable=g0
    PutModuleVariable v1 variable=g0
    PutModuleVariable v2 variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = PropGet v6 key="hasOwnProperty" @10
    Return
}
