# const descriptor = { enumerable: false }; if (unknown) descriptor.value = replacement; Object.defineProperty(Date.prototype, "getTime", descriptor)
# A descriptor that may have got a value behind its literal may change the member: a warning, also at the top of the entry module, because a descriptor without it changes nothing.
# A descriptor that never has a value, a getter or a setter leaves the member as it is, and the build says nothing.
# RUN: pipeline CheckLockedBuiltinWrites
# DIAGNOSTIC: LockedBuiltinWriteMayRun 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Filled" fields=[{key="enumerable" declared={type=anything} flags=[IsRequired]}, {key="value" declared={type=anything}}]
layout L1 name="Bare" fields=[{key="enumerable" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=DatePrototype
    v1 = Boolean boolean=false
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="unknown" [isFreeName] @5
    v5 = ToBoolean v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    v6 = NewClosure function=f1
    PropSet v2, v6 key="value" mode=Strict @10
    Jump -> next b2()
  b2():
    v8 = String string="getTime"
    v9 = Builtin builtin=ObjectDefineProperty
    v10 = Builtin builtin=Object
    v11 = Call v9, v10, v0, v8, v2 @20
    v12 = NewObject -, v1 layout=L1 fields=[0]
    v13 = Call v9, v10, v0, v8, v12 @30
    Return
}
function f1 name="replacement" results=[{type=anything}] {
    Return
}
