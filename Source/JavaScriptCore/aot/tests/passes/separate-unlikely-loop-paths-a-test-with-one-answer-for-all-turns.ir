# Every turn asks the same of a list that was there ahead of the loop, and only the path behind a failure runs other code: that path leaves, so the loop that is left writes nothing
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass SeparateUnlikelyLoopPaths
# STATISTIC: LoopsSeparatedFromUnlikelyPaths = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="lastOf" parameters=[{type=Array}, {type=int[0, 100]}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = Undefined
    Jump -> next b1(v2, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v4, v1
    Branch v7 -> taken b2(| 0), notTaken b6()
  b2(v8):
    v9 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10):
    v11 = GetArrayElement v0, v8, v10 level=Expected [keyIsIntegral]
    Jump -> next b5(v11)
  b4() frequency=Unlikely:
    v12 = ElemGet v0, v8 [keyIsIntegral]
    Jump -> next b5(v12)
  b5(v13):
    v14 = Increment v8
    Jump -> next b1(v14, v13)
  b6():
    Return v5
# CHECK: Branch v9 -> taken b3(| 0), notTaken [[failed]]()
# CHECK: b5(v13: anything):
# CHECK-NEXT: v14: int[1, 100] = Increment v8
# CHECK-NEXT: Jump -> next b1(v14, v13)
# CHECK: [[failed]]() frequency=Rare:
# CHECK-NEXT: [[read]]: anything = ElemGet v0, v8 [keyIsIntegral]
}
