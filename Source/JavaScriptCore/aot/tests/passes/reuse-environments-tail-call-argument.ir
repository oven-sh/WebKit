# An environment passed to a tail call is judged like the argument of any direct call, and nothing is put between the call and its terminator
# FORM: Prepared
# RUN: pass ReuseEnvironments
# OPTIONS: disable=pass:AllocateInFrames
# STATISTIC: EnvironmentsReused = 1
# CHECK: reused environments: [L0]

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="calleeDeclaresIt" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="calleeWithoutBody" fields=[{key="x" declared={type=anything}}]

function f0 name="calleeDeclaresIt" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L0 fields=[0]
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = GetEnvironmentField v3 layout=L0 field=0
    v5 = Call v0, -, v4
    Jump -> next b1()
  b3():
    v6 = CallDirect v3, v0 function=f2
    ReturnCall v6
# CHECK-NOT: ReleaseEnvironment
# CHECK-NOT: MarkEnvironmentEscaped
# CHECK: = GetEnvironmentField v3
# CHECK-NEXT: ReleaseEnvironment v3
# CHECK-NEXT: = Call v0
# CHECK: b3():
# CHECK-NEXT: [[tail]]: anything = CallDirect v3, v0 function=f2
# CHECK-NEXT: ReturnCall [[tail]]
# CHECK-NEXT: }
}

function f1 name="calleeWithoutBody" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewObject -, v0 layout=L1 fields=[0]
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v4 = GetEnvironmentField v3 layout=L1 field=0
    v5 = Call v0, -, v4
    Jump -> next b1()
  b3():
    v6 = CallDirect v3, v0 function=f3
    ReturnCall v6
# CHECK-NOT: ReleaseEnvironment
# CHECK-NOT: MarkEnvironmentEscaped
}

function f2 name="readsCapture" kind=Arrow captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = Call v1, -, v2
    Return v3
# CHECK-NOT: ReleaseEnvironment
# CHECK-NOT: MarkEnvironmentEscaped
}

function f3 name="withoutBody" kind=Arrow captures=[{type=env L1}] parameters=[{type=anything}] results=[{type=anything}]
