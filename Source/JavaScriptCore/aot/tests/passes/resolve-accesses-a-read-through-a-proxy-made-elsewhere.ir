#   constructor() {
#     this.reads = 0;
#   }
#   get(target, key) {
#     this.reads++;
#     return target[key];
#   }
# }
# function make(value) {
#   return new Proxy({ alpha: value, beta: 2 }, new Counting());
# }
# function read(pair) {
#   return pair.alpha;
# }
