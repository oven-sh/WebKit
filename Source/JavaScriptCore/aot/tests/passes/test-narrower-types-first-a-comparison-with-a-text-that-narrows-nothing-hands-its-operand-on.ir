# FORM: Prepared
# RUN: pass TestNarrowerTypesFirst
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"

function f0 name="a-text-or-nothing" parameters=[{type=undefined|null|string}] results=[{type=i32}] {
    v1 = String string="low"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    v3 = Integer integer=1
    Return v3
  b2(v4):
    v5 = String string="mid"
    v6 = StrictEq v4, v5
    Branch v6 -> taken b1(), notTaken b3()
  b3():
    v7 = Integer integer=3
    Return v7
# CHECK: Branch v2 -> taken b1(), notTaken b2(v0)
}

function f1 name="one-of-three-texts" parameters=[{type="high"|"low"|"mid"}] results=[{type=i32}] {
    v1 = String string="low"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    v3 = Integer integer=1
    Return v3
  b2(v4):
    v5 = String string="mid"
    v6 = StrictEq v4, v5
    Branch v6 -> taken b1(), notTaken b3()
  b3():
    v7 = Integer integer=3
    Return v7
# CHECK: Branch v2 -> taken b1(), notTaken b2(| 0)
}
