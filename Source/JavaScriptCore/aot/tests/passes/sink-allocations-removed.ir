# An allocation that no path needs as a cell is removed with the stores to it
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 5
# STATISTIC: AllocationsSunk = 1
# STATISTIC: StoresFoldedIntoAllocations = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything}}]
layout L1 kind=Environment name="scope" fields=[{key="value" declared={type=anything} flags=[IsImmutable]}, {key="self" declared={type=anything}}]
data d0 root=Array{contents=anything}

function f0 name="onlyWritten" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v2, v1 key="x" receivers=[L0]
    PropDefine v2, v1 key="y" receivers=[L0]
    Return v0
}
# CHECK-LABEL: function f0 name="onlyWritten"
# CHECK: b0(
# CHECK-NEXT: Return v0

function f1 name="writtenAndPassedOn" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v2, v1 key="x" receivers=[L0]
    PropDefine v2, v1 key="y" receivers=[L0]
    v5 = Call v0, -, v2
    Return v5
}
# CHECK-LABEL: function f1 name="writtenAndPassedOn"
# CHECK: b0(
# CHECK-NEXT: [[cell1]]:{{*}}= NewObject -, v1, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: = Call v0, -, [[cell1]]

function f2 name="environmentDies" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = GetEnvironmentField v1 layout=L1 field=0
    Return v2
}
# CHECK-LABEL: function f2 name="environmentDies"
# CHECK-NOT: NewObject
# CHECK-NOT: GetEnvironmentField

function f3 name="arrayDies" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewArray v0, v1 contents=anything
    v3 = AssumeType v2 castType=Array<anything, proven>
    v4 = Integer integer=1
    v5 = ElemGet v3, v4
    Return v5
}
# CHECK-LABEL: function f3 name="arrayDies"
# CHECK-NOT: NewArray
# CHECK-NOT: ElemGet
# CHECK: v5: anything = Upcast v1 castType=anything

function f4 name="unusedRegExpAndPromise" results=[{type=undefined}] {
  b0():
    v0 = NewRegExp pattern="a+"
    v1 = NewPromise
    Return
}
# CHECK-LABEL: function f4 name="unusedRegExpAndPromise"
# CHECK: b0(
# CHECK-NEXT: Return

function f5 name="regExpAndPromisePassedOn" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewRegExp pattern="a+"
    v2 = NewPromise
    v3 = ToBoolean v0
    v4 = Call v0, -, v1, v2, v3
    Return v4
}
# CHECK-LABEL: function f5 name="regExpAndPromisePassedOn"
# CHECK: b0(
# CHECK-NEXT: v1:{{*}}= NewRegExp pattern="a+"
# CHECK-NEXT: v2:{{*}}= NewPromise
# CHECK-NEXT: = ToBoolean v0
# CHECK-NEXT: = Call v0, -, v1, v2, v3

function f6 name="unusedDataMayThrow" results=[{type=undefined}] {
  b0():
    v0 = Data data=d0
    Return
}
# CHECK-LABEL: function f6 name="unusedDataMayThrow"
# CHECK: b0(
# CHECK-NEXT: = Data data=d0

function f7 name="unusedGeneratorReadsItsPrototype" role=CoroutineRamp flags=[IsGenerator, TakesCallee] results=[{type=undefined}] creator=Coroutine{ramp=f7 body=f8} {
  b0(v0: function):
    v1 = NewGenerator v0 function=f7
    Return
}
# CHECK-LABEL: function f7 name="unusedGeneratorReadsItsPrototype"
# CHECK: b0(
# CHECK-NEXT: = NewGenerator v0 function=f7

function f8 name="unusedGeneratorReadsItsPrototype" role=CoroutineBody parameters=[{type=object}, {type=anything}] results=[{type=anything}] derivation={source=f7} creator=Coroutine{ramp=f7 body=f8} {
  b0(v0: object, v1: anything):
    Return v1
}
