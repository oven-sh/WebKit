# RUN(REPORT): type-test-report function=f0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="only" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = StrictEq v1, v1
    v3 = ShapeTest v0 layouts=[L0]
    Return v1
}
