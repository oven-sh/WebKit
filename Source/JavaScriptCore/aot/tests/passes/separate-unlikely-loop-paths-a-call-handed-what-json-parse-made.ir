# `for (const shape of parsed) sum += size(shape)`, where another caller hands size literals. The element has no site of its own, but the call has, and flow says that of the objects among its arguments all come from outside.
# So the copy of size in that loop keeps no layouts at its reads, and they are asked of the tables. The copy in the loop over the literals tests for them. An integer beside the object changes nothing.
# -- source: main.js
# function size(shape) {
#   if (shape.kind === "circle") return shape.radius + shape.radius;
#   return shape.side;
# }
# const shapes = [];
# for (let i = 0; i < 8; i++) shapes.push(i % 3 ? { kind: "circle", radius: i + 0.5 } : { kind: "square", side: i + 0.25 });
# const parsed = JSON.parse(JSON.stringify(shapes));
# const lines = [];
# for (let i = 0; i < 8; i++) lines.push(JSON.stringify(shapes[i]));
# function sizesOfLiterals() {
#   let sum = 0;
#   for (const shape of shapes) sum += size(shape);
#   return sum;
# }
# function sizesOfParsed() {
#   let sum = 0;
#   for (const shape of parsed) sum += size(shape);
#   return sum;
# }
# function sizesOfLines() {
#   let sum = 0;
#   for (let i = 0; i < 8; i++) sum += size(JSON.parse(lines[i]));
#   return sum;
# }
# function radiusOfTwo(shape, scale) {
#   return shape.radius * scale;
# }
# function radiiWithAnInteger() {
#   let sum = 0;
#   for (const shape of parsed) sum += radiusOfTwo(shape, 2) || 0;
#   return sum;
# }
# globalThis.answer = sizesOfLiterals() + sizesOfParsed() + sizesOfLines() + radiiWithAnInteger() + radiusOfTwo({ radius: 3 }, 1);
# -- end of source
# FORM: AsRead
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pipeline SeparateUnlikelyLoopPaths
# CHECK-LABEL: name="sizesOfLiterals"
# CHECK: = GetSlot {{*}} key="kind"
# CHECK-LABEL: name="sizesOfParsed"
# CHECK-NOT: testedType=L
# CHECK: = PropGet {{*}} key="kind" {{*}} [asksOnlyTables]
# CHECK-NOT: testedType=L
# CHECK-LABEL: name="sizesOfLines"
# CHECK-NOT: testedType=L
# CHECK: = PropGet {{*}} key="kind" {{*}} [asksOnlyTables]
# CHECK-LABEL: name="radiiWithAnInteger"
# CHECK-NOT: testedType=L
# CHECK: = PropGet {{*}} key="radius" {{*}} [asksOnlyTables]

