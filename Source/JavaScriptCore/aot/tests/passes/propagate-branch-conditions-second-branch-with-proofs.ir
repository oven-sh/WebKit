# A constant proves nothing, so a second branch whose edges pass proofs keeps its condition, and SimplifyControlFlow decides it
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass PropagateBranchConditions
# RUN(DECIDED): pass PropagateBranchConditions SimplifyControlFlow
# STATISTIC: PropagateBranchConditionsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="edgeNeverTakenPassesProof" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Branch v1 -> taken b3(| 0), notTaken b4()
  b3(v2):
    Return v2
  b4():
    Return v0
# CHECK-NOT: = Boolean
# CHECK: b2():
# CHECK-NEXT: Branch v1 -> taken b3(| 0), notTaken b4()
# CHECK-NOT: = Boolean
# DECIDED: Branch v1 -> taken b1(), notTaken b4()
# DECIDED-NOT: Branch
# DECIDED-NOT: Return v2
}

function f1 name="edgeTakenPassesValueOfSameType" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Branch v2 -> taken b3(| 0), notTaken b4()
  b2():
    Return v1
  b3(v3):
    Return v3
  b4():
    Return v1
# CHECK-NOT: = Boolean
# CHECK: b1():
# CHECK-NEXT: Branch v2 -> taken b3(| 0), notTaken b4()
# CHECK-NOT: = Boolean
# DECIDED: Branch v2 -> taken b3(v0), notTaken b2()
# DECIDED-NOT: Branch
# DECIDED: b3(v3: number):
# DECIDED-NEXT: Return v3
}

function f2 name="edgeTakenNarrows" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Branch v1 -> taken b3(| 0), notTaken b4()
  b2():
    Return v0
  b3(v2):
    Return v2
  b4():
    Return v0
# CHECK-NOT: = Boolean
# CHECK: b1():
# CHECK-NEXT: Branch v1 -> taken b3(| 0), notTaken b4()
# CHECK-NOT: = Boolean
}

function f3 name="noProofs" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Branch v1 -> taken b3(), notTaken b4()
  b2():
    Return v0
  b3():
    Return v0
  b4():
    Return v0
# CHECK: b1():
# CHECK-NEXT: [[known3]]: true = Boolean boolean=true
# CHECK-NEXT: Branch [[known3]] -> taken b3(), notTaken b4()
}

function f4 name="argumentBesideProof" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Branch v1 -> taken b3(v1 | 0), notTaken b4()
  b2():
    Return v0
  b3(v2, v3):
    Return v2
  b4():
    Return v0
# CHECK: b1():
# CHECK-NEXT: [[known4]]: true = Boolean boolean=true
# CHECK-NEXT: Branch v1 -> taken b3([[known4]] | 0), notTaken b4()
}
