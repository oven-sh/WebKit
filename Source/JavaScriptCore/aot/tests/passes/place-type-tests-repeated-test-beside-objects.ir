module m0 path="main.js" displayPath="main.js"
variable g0 name="sink" declared={type=anything} initialization=Undefined

function f0 name="arrayBesideObjects" parameters=[{type=undefined|string|Array<number, proven, pristine[Storage, Names]>|Object}, {type=boolean}] results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = RequireObjectCoercible v0 name="length"
    v4 = TypeTest v3 testedType=Array
    Branch v4 -> taken b2(| 0), notTaken b3(| 0)
  b2(v5):
    v6 = CallBuiltin v5 overload=ArrayPrototypeLength/0
    PutModuleVariable v6 variable=g0
    Branch v1 -> taken b1(), notTaken b4()
  b3(v8):
    PutModuleVariable v8 variable=g0
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Return
