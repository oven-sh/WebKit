# A very large program has a third class of function. A cold function is compact if nothing in the structure of the program says that it may run: no chain of known calls leads to it from a function that runs often or that a loop calls,
# at most one function calls it, and it has no heavy loop of its own. The dump names the class in place of Cold, and says how much of the program it holds
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat limit=MaxWarmCodeValues:1
# RUN: pipeline EstimateHeat
# CHECK: f0 RunsOnce
# CHECK-NEXT: f1 Cold 10 1
# CHECK-NEXT: f2 Cold 10 1
# CHECK-NEXT: f3 Compact 10 1
# CHECK-NEXT: f4 Cold 10 1
# CHECK-NEXT: f5 Cold 10 1
# CHECK-NEXT: f6 Compact 10 1
# CHECK-NEXT: f7 Compact 10 1
# CHECK: thresholds: cold=4 hot=50
# CHECK-NEXT: compact: {{*}} of {{*}} values

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    v2 = CallDirect v0 function=f7
    v3 = CallDirect v0 function=f7
    Jump -> next b1()
  b1():
    LoopHint
    v5 = CallDirect v0 function=f1
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="calledInLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    v71 = CallDirect v0 function=f2
    Return v71
}

function f2 name="calledByOneThatALoopCalls" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    Return v0
}

function f3 name="calledByCompactFunction" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    v71 = CallDirect v0 function=f4
    v72 = CallDirect v0 function=f6
    Return v0
}

function f4 name="calledByTwo" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    Return v0
}

function f5 name="hasLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
# REPEAT: i = 3..75
    v%(i) = ToBoolean v0
# END REPEAT
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return v0
}

function f6 name="calledAtTheEndOfSuchAChain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    Return v0
}

function f7 name="calledTwiceByCodeThatRunsOnce" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
# REPEAT: i = 1..70
    v%(i) = ToBoolean v0
# END REPEAT
    v71 = CallDirect v0 function=f3
    v72 = CallDirect v0 function=f4
    v73 = CallDirect v0 function=f5
    Return v0
}
