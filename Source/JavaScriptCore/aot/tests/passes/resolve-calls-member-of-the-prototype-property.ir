}
function f2 name="sound" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f3 name="Plant" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f4 name="Often" flags=[HasThis] thisType={type=L2 flags=[IsExpected]} results=[{type=undefined}] {
  b0(v0: anything ~ L2):
    Return
}

