# function Animal() {}  Animal.prototype.walk = function () { .. }  Animal.prototype.walk.call(other, 1)
# The lookup starts at the prototype object of the class of Animal, whatever `this` is. One test of the class asks that the property still holds that object and that the member is as it was assigned;
# both reads go to the side where it fails. The guards of a function that has made no object begin there: the run time is told as long as the guard of the property does not hold. A class keeps its property, so only the member is asked for.
# FORM: Prepared
# RUN: pass ResolveCalls
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Animal" constructor=f0 flags=[IsConstructorFunction] flow={baseState=None} classFlow={evaluations=AtMostOnce members=[{key="walk" function=f1}] namedMembers=[{key="walk" function=f1}, {key="walk"}, {key="sound" function=f1}, {key="sound" function=f2}, {key="sound"}]}
layout L1 kind=Instance name="Plant" constructor=f3 flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed members=[{key="grow" function=f2}] namedMembers=[{key="grow" function=f2}, {key="grow"}]}
layout L2 kind=Instance name="Often" constructor=f4 flags=[IsConstructorFunction] flow={baseState=None} classFlow={members=[{key="walk" function=f1}] namedMembers=[{key="walk" function=f1}, {key="walk"}]}
function f0 name="Animal" flags=[HasThis] thisType={type=L0 flags=[IsExpected]} results=[{type=undefined}] {
  b0(v0: anything ~ L0):
    Return
}
