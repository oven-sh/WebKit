# PlaceTypeTests cuts blocks where its generic copy may come back, also between a call and the await of its result, and the copy hands its own promise on to the await. ResolveAwaitedCalls, which runs behind it, still finds each call: both arms enter the callee without a promise.
# The functions are checked functions of the program, where the copy goes on behind the stretch. Behind layouts that nobody has checked it holds the stretch alone: place-type-tests-copies-in-checked-functions-are-rare.ir
# FORM: Prepared
# RUN: pass PlaceTypeTests ResolveAwaitedCalls
# STATISTIC: AwaitedCallsResolved = 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="a" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
function f0 name="callee" role=CoroutineRamp flags=[IsAsync, IsChecked] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: anything):
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f1
    v3 = AssumeType v2 castType=Promise
    Return v3
}
function f1 name="callee" role=CoroutineBody flags=[IsAsync, IsChecked] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0 parameterMap=[{original=0}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: anything, v1: undefined|Promise):
    v2 = ReturnAsyncResult v1, v0
    Return v2
}
function f2 name="awaitsBehindATestedRead" role=CoroutineRamp flags=[IsAsync, IsChecked] parameters=[{type=L0 flags=[IsExpected]}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
  b0(v0: anything ~ L0):
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f3
    v3 = AssumeType v2 castType=Promise
    Return v3
}
function f3 name="awaitsBehindATestedRead" role=CoroutineBody flags=[IsAsync, IsChecked] parameters=[{type=L0 flags=[IsExpected]}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f2 parameterMap=[{original=0}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
  b0(v0: anything ~ L0, v1: undefined|Promise):
    v2 = PropGet v0 key="a"
    v3 = CallDirect v2 function=f0
    v4 = Upcast v3 castType=anything
    v5 = AwaitBySavingFrame v4, v1
    v6 = ReturnAsyncResult v1, v5
    Return v6
}
# CHECK-LABEL: function f3 name="awaitsBehindATestedRead"
# CHECK-NOT: = AwaitBySavingFrame
# CHECK-COUNT-2: = AwaitCallBySavingFrame
# CHECK-NOT: = AwaitBySavingFrame
