# The layouts on which a lookup finds a field are one arm, however many they are and in whatever order they list their fields: one test of the whole set, one slot operation.
# MaxDispatchCases counts arms, never the layouts of an arm. The slot plan keeps the field of such an arm in one place, so selection leaves the operation as it is.
# A layout on which the lookup finds something else is another arm with a test of its own. A field that the slot plan keeps in two places is one arm for the passes,
# and selection splits it: the layouts that keep it in one place are one case of the dispatch
# FORM: Prepared
# RUN(ARMS): partition-members layouts=[L0,L1,L2,L3,L4] key="x"
# ARMS: arm [L0, L1, L2, L3, L4]: Field level=Proven
# ARMS-NOT: arm
# ARMS-NOT: rest
# RUN(TWOARMS): partition-members layouts=[L0,L1,L5] key="x"
# TWOARMS: arm [L0, L1]: Field level=Proven
# TWOARMS-NEXT: arm [L5]: Absent level=Proven
# RUN: pass PlaceTypeTests
# RUN(SECOND): pass PlaceTypeTests PlaceTypeTests
# RUN(SELECTED): pass PlaceTypeTests Select

module m0 path="main.js" displayPath="main.js"
layout L0 name="Pair" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="PairInOtherOrder" fields=[{key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Single" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="Triple" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L4 name="Tail" fields=[{key="z" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L5 name="Without" fields=[{key="y" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L6 name="Count" fields=[{key="value" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L7 name="CountOrText" fields=[{key="value" declared={type=number|string} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

# Five layouts are more than MaxDispatchCases. A second round finds nothing left to expect in the copy
function f0 name="fiveLayoutsOneTest" parameters=[{type=L0|L1|L2|L3|L4 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0|L1|L2|L3|L4):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f0 name="fiveLayoutsOneTest"
# CHECK: = TypeTest v0 testedType=L0|L1|L2|L3|L4
# CHECK-NOT: TypeTest
# CHECK: v1:{{*}}= GetSlot {{*}}key="x" receivers=[L0, L1, L2, L3, L4] level=Expected
# CHECK-NOT: GetSlot
# CHECK: = PropGet {{*}}key="x"
# CHECK-NOT: TypeTest
# SECOND-LABEL: function f0 name="fiveLayoutsOneTest"
# SECOND: = TypeTest v0 testedType=L0|L1|L2|L3|L4
# SECOND-NOT: TypeTest
# SELECTED-LABEL: function f0 name="fiveLayoutsOneTest"
# SELECTED-NOT: SwitchOnShape
# SELECTED: = GetSlot {{*}}key="x" receivers=[L0, L1, L2, L3, L4] level=Expected
# SELECTED-NOT: SwitchOnShape

# The arm that finds the field comes first. The arm that finds nothing is tested for where the first test has failed
function f1 name="layoutWithoutTheFieldIsAnotherArm" parameters=[{type=L0|L1|L5 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0|L1|L5):
    v1 = PropGet v0 key="x"
    Return v1
}
# CHECK-LABEL: function f1 name="layoutWithoutTheFieldIsAnotherArm"
# CHECK: = TypeTest v0 testedType=L0|L1
# CHECK-NOT: TypeTest
# CHECK: v1:{{*}}= GetSlot {{*}}key="x" receivers=[L0, L1] level=Expected
# CHECK: = PropGet {{*}}key="x"
# CHECK-NOT: TypeTest
# SECOND-LABEL: function f1 name="layoutWithoutTheFieldIsAnotherArm"
# SECOND: = TypeTest v0 testedType=L0|L1
# SECOND: = GetSlot {{*}}key="x" receivers=[L0, L1] level=Expected
# SECOND: = TypeTest {{*}}testedType=L5
# SECOND: = Undefined
# SECOND: = PropGet {{*}}key="x"

# The reads that know the layout weigh more than the read through both, so each field keeps the form of its own type: a raw number, a boxed value
function f2 name="fieldKeptInTwoPlaces" parameters=[{type=L6|L7 flags=[IsExpected]}, {type=L6}] results=[{type=anything}] {
  b0(v0: anything ~ L6|L7, v1: L6):
    v2 = GetSlot v1 key="value" receivers=[L6] level=Proven
    v3 = GetSlot v1 key="value" receivers=[L6] level=Proven
    v4 = PropGet v0 key="value"
    Return v4
}
# CHECK-LABEL: function f2 name="fieldKeptInTwoPlaces"
# CHECK: = TypeTest v0 testedType=L6|L7
# CHECK-NOT: TypeTest
# CHECK: v4:{{*}}= GetSlot {{*}}key="value" receivers=[L6, L7] level=Expected
# SELECTED-LABEL: function f2 name="fieldKeptInTwoPlaces"
# SELECTED-NOT: receivers=[L6, L7]
# SELECTED: = TypeTest v0 testedType=L6|L7
# SELECTED: = TypeTest {{*}} testedType=L6
# SELECTED: = GetSlot {{*}}key="value" receivers=[L6] level=Expected
# SELECTED: = GetSlot {{*}}key="value" receivers=[L7] level=Expected
# SELECTED-NOT: receivers=[L6, L7]
