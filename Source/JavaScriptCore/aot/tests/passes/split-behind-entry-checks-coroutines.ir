# An async function and a generator whose parameter keeps its check are split like any function. The tests are no coroutine: they hand on the promise or the generator of the body they call,
# and they keep the flags, which say what kind of function object a closure of them is. A stack trace does not list them: it would show the function twice
# FORM: AsRead
# RUN: pipeline SplitBehindEntryChecks
# RUN(WHOLE): compile
# STATISTIC: FunctionsSplitBehindEntryChecks = 2
# WHOLE: image not empty

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter
typesite w1 module=m0 position=55 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Call v3, -, v0, v1
    Return
}
function f1 name="later" module=m0 position=5 flags=[IsAsync, IsChecked] length=1 parameters=[{type=number site=w0}] results=[{type=anything}] {
    v1 = Integer integer=2
    v2 = Mul v0, v1
    v3 = Await v2
    Return v3
}
# CHECK-LABEL: function f1 name="later" module=m0 position=5 role=EntryChecks flags=[IsAsync, IsChecked, IsHiddenInStackTraces]
# CHECK: = TypeTest v0 testedType=number
# CHECK-NOT: Await
function f2 name="range" module=m0 position=45 flags=[IsGenerator, TakesCallee, IsChecked] length=1 parameters=[{type=number site=w1}] results=[{type=anything}] {
    InitialYield
    v3 = Yield v1
    v4 = ResultAt v3 index=0
    v5 = Integer integer=2
    v6 = Mul v1, v5
    v7 = Yield v6
    v8 = ResultAt v7 index=0
    Return
}
# CHECK-LABEL: function f2 name="range" module=m0 position=45 role=EntryChecks flags=[IsGenerator, TakesCallee, IsChecked, IsHiddenInStackTraces]
# CHECK: = TypeTest v1 testedType=number
# CHECK-NOT: Yield
# CHECK: name="later" module=m0 position=5 flags=[IsAsync, IsChecked] length=1 thisType={type=anything} parameters=[{type=number site=w0}]
# CHECK: = Await
# CHECK: name="range" module=m0 position=45 flags=[IsGenerator, TakesCallee, IsChecked] length=1 thisType={type=anything} parameters=[{type=number site=w1}]
# CHECK: InitialYield
# CHECK: name="later" module=m0 position=5 role=GenericVersion flags=[IsAsync, IsChecked]
# CHECK: name="range" module=m0 position=45 role=GenericVersion flags=[IsGenerator, TakesCallee, IsChecked]
