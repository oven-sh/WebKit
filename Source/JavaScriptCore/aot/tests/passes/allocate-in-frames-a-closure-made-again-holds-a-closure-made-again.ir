# Two closures lie in the frame until they leave, and the second holds the first. The closure of the heap that is made of the second holds the closure of the heap that is made of the first, on every way out
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass only-passes=BuildCallGraph,EstimateHeat,ComputeEffectSummaries,AllocateInFrames heat=EverythingIsHot

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = CallDirect v2, v2 function=f1
    v5 = CallDirect v2, v2 function=f2
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="theSecondIsStored" parameters=[{type=boolean}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f4
    v3 = CallDirect v2 function=f3
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v4 = NewClosure v2 function=f5
    v5 = CallDirect v4 function=f3
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    PutModuleVariable v4 variable=g0
    Return
  b3():
    Return
# CHECK: v2: f4 = NewClosure function=f4 {{*}}storage=Frame
# CHECK: [[first1]]: f4 = NewClosure function=f4
# CHECK-NOT: storage=
# CHECK: v4: f5 = NewClosure [[first1]] function=f5 {{*}}storage=Frame
# CHECK: [[second1]]: f5 = NewClosure [[first1]] function=f5
# CHECK-NOT: storage=
# CHECK: PutModuleVariable [[second1]] variable=g0
}

function f2 name="theSecondIsStoredOrPassedOnAnEdge" parameters=[{type=boolean}, {type=boolean}] results=[{type=anything}] {
    v2 = NewClosure function=f4
    v3 = CallDirect v2 function=f3
    Branch v0 -> taken b1(), notTaken b4()
  b1():
    v4 = NewClosure v2 function=f5
    v5 = CallDirect v4 function=f3
    Branch v1 -> taken b2(), notTaken b3(v4)
  b2():
    PutModuleVariable v4 variable=g0
    Return
  b3(v7: anything):
    Return v7
  b4():
    Return
# CHECK: v2: f4 = NewClosure function=f4 {{*}}storage=Frame
# CHECK: [[first2]]: f4 = NewClosure function=f4
# CHECK-NOT: storage=
# CHECK: v4: f5 = NewClosure [[first2]] function=f5 {{*}}storage=Frame
# CHECK: [[second2]]: f5 = NewClosure [[first2]] function=f5
# CHECK-NOT: storage=
# CHECK: PutModuleVariable [[second2]] variable=g0
# CHECK: [[onEdge2]]: f5 = NewClosure [[first2]] function=f5
# CHECK-NOT: storage=
# CHECK: Jump -> next b3([[onEdge2]])
}

function f3 name="borrows" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}

function f4 name="first" kind=Arrow results=[{type=anything}] {
    Return
}

function f5 name="second" kind=Arrow captures=[{type=function}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
