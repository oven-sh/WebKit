# A loop sums a list that is proven to hold numbers and undefined, behind a test for Double storage. Its reads are copied for storage that holds any value, and an element that is no number leaves the copy.
# Behind the tests for Double storage and for its position `list[i] === undefined` is false, so a second loop that looked for such an element is a loop that counts: the test of the position is all that is left of its read.
# The general code beside that loop reads the element, asks for Double storage again and goes on in the loop. So the first proof no longer holds there and a second one does, which nobody is handed.
# A copy of the first loop would go on into the second with a list that does hold undefined, and find none.
# FORM: Prepared
# RUN: pass PlanArrayCapacities

module m0 path="main.js" displayPath="main.js"

function f0 name="sums" parameters=[{type=Array<undefined|number, proven, pristine[Storage, Names, Dense]>}] results=[{type=anything}] {
    v1 = Double number=0.5
    v2 = Integer
    v3 = HasArrayStorage v0 arrayStorage=Double
    Branch v3 -> taken b1(| 0), notTaken b6()
  b1(v4):
    Jump -> next b2(v1, v2)
  b2(v5: number, v6: int[0, 4294967295]):
    LoopHint
    v8 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v9 = Less v6, v8
    Branch v9 -> taken b3(| 0), notTaken b5()
  b3(v10):
    v11 = IsInBounds v0, v10
    Branch v11 -> taken b4(| 0), notTaken b6()
  b4(v12):
    v13 = AllGuards v4, v12
    v14 = GetArrayElement v0, v10, v13 arrayStorage=Double level=Expected [keyIsIntegral, isInBounds]
    v15 = Add v5, v14
    v16 = Increment v10
    Jump -> next b2(v15, v16)
  b5():
    Return v5
  b6() frequency=Rare:
    v17 = ElemGet v0, v2 [keyIsIntegral]
    Return v17
}
# CHECK-LABEL: function f0
# CHECK: HasArrayStorage v0 arrayStorage=Double
# CHECK: HasArrayStorage v0 arrayStorage=Contiguous
# CHECK: [[element]]: {{*}} = GetArrayElement v0, {{*}} arrayStorage=Contiguous
# CHECK: TypeTest [[element]] testedType=number

function f1 name="sumsAndLooksForUndefined" parameters=[{type=Array<undefined|number, proven, pristine[Storage, Names, Dense]>}] results=[{type=anything}] {
    v1 = Double number=0.5
    v2 = Integer
    v3 = HasArrayStorage v0 arrayStorage=Double
    Branch v3 -> taken b1(| 0), notTaken b13()
  b1(v4):
    Jump -> next b2(v1, v2)
  b2(v5: number, v6: int[0, 4294967295]):
    LoopHint
    v8 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v9 = Less v6, v8
    Branch v9 -> taken b3(| 0), notTaken b5()
  b3(v10):
    v11 = IsInBounds v0, v10
    Branch v11 -> taken b4(| 0), notTaken b13()
  b4(v12):
    v13 = AllGuards v4, v12
    v14 = GetArrayElement v0, v10, v13 arrayStorage=Double level=Expected [keyIsIntegral, isInBounds]
    v15 = Add v5, v14
    v16 = Increment v10
    Jump -> next b2(v15, v16)
  b5():
    Jump -> next b6(v2)
  b6(v17: int[0, 4294967295]):
    LoopHint
    v19 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v20 = Less v17, v19
    Branch v20 -> taken b7(| 0), notTaken b12()
  b7(v21):
    v22 = IsInBounds v0, v21
    Branch v22 -> taken b8(), notTaken b9()
  b8():
    v23 = Increment v21
    Jump -> next b6(v23)
  b9() frequency=Rare:
    v24 = ElemGet v0, v21 [keyIsIntegral]
    v25 = TypeTest v24 testedType=undefined
    Branch v25 -> taken b11(), notTaken b10()
  b10() frequency=Rare:
    v26 = Increment v21
    v27 = HasArrayStorage v0 arrayStorage=Double
    Branch v27 -> taken b6(v26), notTaken b13()
  b11() frequency=Rare:
    Return v21
  b12():
    Return v5
  b13() frequency=Rare:
    v28 = ElemGet v0, v2 [keyIsIntegral]
    Return v28
}
# CHECK-LABEL: function f1
# CHECK: HasArrayStorage v0 arrayStorage=Double
# CHECK-NOT: arrayStorage=Contiguous

