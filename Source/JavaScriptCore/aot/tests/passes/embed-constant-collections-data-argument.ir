function f5 name="stringsCreatedInFrontOfTheLoop" parameters=[{type=anything}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean):
    v2 = Data data=d5
    Jump -> next b1()
  b1():
