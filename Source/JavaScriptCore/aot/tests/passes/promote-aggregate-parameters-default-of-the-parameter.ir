# An options bag with a default, as in f({ a, b } = {}) or bag = bag || {}, is still replaced by what is read from it
# FORM: Prepared
# RUN: pass PromoteAggregateParameters
# STATISTIC: AggregateParametersPromoted = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}]
layout L1 name="Empty"

function f0 name="withoutDefault" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="a"
    v2 = PropGet v0 key="b"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v1, v2
    Return v5
}
# CHECK-LABEL: function f0 name="withoutDefault"
# CHECK: role=ParameterWrapper

function f1 name="defaultOfThePattern" parameters=[{type=undefined|L0}] results=[{type=anything}] {
  b0(v0: undefined|L0):
    v1 = TypeTest v0 testedType=undefined
    Branch v1 -> taken b1(), notTaken b2(| 0)
  b1():
    v2 = NewObject layout=L1
    Jump -> next b3(v2)
  b2(v3):
    Jump -> next b3(v3)
  b3(v4):
    v5 = PropGet v4 key="a"
    v6 = PropGet v4 key="b"
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="sink" [isFreeName]
    v9 = Call v8, -, v5, v6
    Return v9
}
# CHECK-LABEL: function f1 name="defaultOfThePattern"
# CHECK: role=ParameterWrapper {{*}}creator=ParameterWrapper{body=[[patternBody]]}
# CHECK: = TypeTest v0 testedType=undefined
# CHECK: = NewObject layout=L1
# CHECK: [[a1]]: anything = PropGet v4 key="a"
# CHECK: [[b1]]: anything = PropGet v4 key="b"
# CHECK-NOT: key="sink"
# CHECK: = CallDirect [[a1]], [[b1]] function=[[patternBody]]

function f2 name="orAnEmptyObject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    v2 = NewObject layout=L1
    Jump -> next b3(v2)
  b3(v3):
    v4 = PropGet v3 key="a"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v4
    Return v7
}
# CHECK-LABEL: function f2 name="orAnEmptyObject"
# CHECK: role=ParameterWrapper {{*}}creator=ParameterWrapper{body=[[orBody]]}
# CHECK: = ToBoolean v0
# CHECK: [[a2]]: anything = PropGet v3 key="a"
# CHECK-NOT: key="sink"
# CHECK: = CallDirect [[a2]] function=[[orBody]]

function f3 name="defaultOfSeveralBlocks" parameters=[{type=undefined|L0}, {type=boolean}] results=[{type=anything}] {
  b0(v0: undefined|L0, v1: boolean):
    v2 = TypeTest v0 testedType=undefined
    Branch v2 -> taken b1(), notTaken b4(| 0)
  b1():
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    v3 = NewObject layout=L1
    Jump -> next b5(v3)
  b3():
    v4 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    Jump -> next b5(v4)
  b4(v5):
    Jump -> next b5(v5)
  b5(v6):
    v7 = PropGet v6 key="a"
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = Call v9, -, v7
    Return v10
}
# CHECK-LABEL: function f3 name="defaultOfSeveralBlocks"
# CHECK: role=ParameterWrapper

function f4 name="passedOnBehindTheDefault" parameters=[{type=undefined|L0}] results=[{type=anything}] {
  b0(v0: undefined|L0):
    v1 = TypeTest v0 testedType=undefined
    Branch v1 -> taken b1(), notTaken b2(| 0)
  b1():
    v2 = NewObject layout=L1
    Jump -> next b3(v2)
  b2(v3):
    Jump -> next b3(v3)
  b3(v4):
    v5 = PropGet v4 key="a"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="sink" [isFreeName]
    v8 = Call v7, -, v4, v5
    Return v8
}
# CHECK-LABEL: function f4 name="passedOnBehindTheDefault"
# CHECK-NOT: role=ParameterWrapper

function f5 name="meetsItselfInALoop" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    Jump -> next b1(v0)
  b1(v1):
    LoopHint
    v3 = PropGet v1 key="a"
    v4 = ToBoolean v3
    Branch v4 -> taken b1(v1), notTaken b2()
  b2():
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v3
    Return v7
}
# CHECK-LABEL: function f5 name="meetsItselfInALoop"
# CHECK-NOT: role=ParameterWrapper

function f6 name="passesLiterals" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v3 = CallDirect v2 function=f0
    v4 = CallDirect v2 function=f1
    v5 = CallDirect v2 function=f2
    v6 = CallDirect v2, v1 function=f3
    v7 = CallDirect v2 function=f4
    v8 = CallDirect v2 function=f5
    Return v8
}
