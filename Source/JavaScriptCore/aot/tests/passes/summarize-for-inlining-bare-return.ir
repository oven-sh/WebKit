# A summary says whether a return without a value can be reached
# FORM: AsRead
# RUN: pipeline SummarizeForInlining

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    v5 = CallDirect v1 function=f4
    Return
}
function f1 name="returnsNothing" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
# CHECK: f1: barrier=None {{*}} bareReturn

function f2 name="returnsNothingOnOnePath" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return
}
# CHECK: f2: barrier=None {{*}} bareReturn

function f3 name="returnsValueOnEveryPath" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v2 = Undefined
    Return v2
}
# CHECK: f3: barrier=None
# CHECK-NOT: bareReturn

function f4 name="neverReachesBareReturn" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=true
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return
}
# CHECK: f4: barrier=None
# CHECK-NOT: bareReturn
# CHECK: f6:
