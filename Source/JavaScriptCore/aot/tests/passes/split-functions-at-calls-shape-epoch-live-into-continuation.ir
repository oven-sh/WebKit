# A shape epoch renews a guard of the function that read it. As a parameter of another function it is a number that proves nothing, so a function is not split where an epoch would have to be passed on
# FORM: Selected
# OPTIONS: check=VerifyEachPass
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="epochReadInFrontOfTheCall" parameters=[{type=Array}, {type=function}, {type=boolean}] results=[{type=anything}] {
  b0(v0: Array, v1: function, v2: boolean):
    v3 = GetShapeEpoch
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = Call v1, -, v0
    v5 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    TestAndBranch v5 -> taken b3(| 0), notTaken b5()
  b3(v6):
    v7 = Call v1, -, v0
    v8 = IsShapeEpochCurrent v3, v6
    TestAndBranch v8 -> taken b4(| 0), notTaken b5()
  b4(v9):
    v10 = Integer integer=0
    v11 = GetArrayElement v0, v10, v9 level=Predicted [keyIsIntegral]
    Return v11
  b5():
    Return v4
}
# CHECK-LABEL: function f0 name="epochReadInFrontOfTheCall"
# CHECK-NOT: CallDirect
# CHECK: = IsShapeEpochCurrent v3, v6

function f1 name="epochReadBehindTheCall" parameters=[{type=Array}, {type=function}, {type=boolean}] results=[{type=anything}] {
  b0(v0: Array, v1: function, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Call v1, -, v0
    v4 = GetShapeEpoch
    v5 = IsPristine v0 builtinClass=Array aspects=[Storage, Names]
    TestAndBranch v5 -> taken b3(| 0), notTaken b5()
  b3(v6):
    v7 = Call v1, -, v0
    v8 = IsShapeEpochCurrent v4, v6
    TestAndBranch v8 -> taken b4(| 0), notTaken b5()
  b4(v9):
    v10 = Integer integer=0
    v11 = GetArrayElement v0, v10, v9 level=Predicted [keyIsIntegral]
    Return v11
  b5():
    Return v3
}
# CHECK-LABEL: function f1 name="epochReadBehindTheCall"
# CHECK: = CallDirect {{*}} function=f2
# CHECK-LABEL: function f2 {{*}}role=Continuation
# CHECK: = GetShapeEpoch
# CHECK: = IsShapeEpochCurrent
