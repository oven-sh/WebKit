# A value has passed two tests in front of a loop, and a read in the loop names what passed both: its layouts are those that both tests leave. Another read in the loop asks for the second test alone, which the
# edge in front of the loop has proven already. The way back into the loop makes that test again, of the value as it was in front of both tests. What stands for the second test in the loop is then the join of
# the two, with the layouts of the second test. The first read goes on naming the value that passed both.
# FORM: Prepared optimizing
# OPTIONS: heat=NothingIsHottest
# RUN: pass PlaceTypeTests
# RUN(PLAN): test-placement

module m0 path="main.js" displayPath="main.js"
layout L0 name="Wide" fields=[{key="width" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="WideAndDeep" fields=[{key="width" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="depth" declared={type=number} flags=[IsRequired]}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Deep" fields=[{key="depth" declared={type=number} flags=[IsRequired]}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}

function f0 name="readsInALoopWhatPassedTwoTests" flags=[IsChecked] parameters=[{type=L1|L2 flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ L1|L2, v1: boolean):
    v2 = TypeTest v0 testedType=L0|L1
    Branch v2 -> taken b1(| 0), notTaken b5()
  b1(v3: L0|L1):
    v4 = TypeTest v3 testedType=L1|L2
    Branch v4 -> taken b2(| 0), notTaken b5()
  b2(v5: L1):
    Jump -> next b3()
  b3():
    LoopHint
    v7 = GetSlot v5 key="width" receivers=[L0, L1] level=Expected
    v8 = PropGet v0 key="depth"
    v9 = Add v7, v8
    Branch v1 -> taken b3(), notTaken b4()
  b4():
    Return v9
  b5():
    v10 = PropGet v0 key="width"
    Return v10
}
# PLAN-LABEL: function f0
# PLAN: proof taken-edge b1.0;{{*}} way back into b3
# CHECK-LABEL: function f0 name="readsInALoopWhatPassedTwoTests"
# CHECK: ([[passedBoth]]: L1):
# CHECK: Jump -> next [[front]](
# CHECK: [[front]]([[passedSecond]]: L1|L2):
# CHECK: LoopHint
# CHECK-NEXT: = GetSlot [[passedBoth]] key="width" receivers=[L0, L1]
# CHECK: = GetSlot [[passedSecond]], {{*}} key="depth" receivers=[L1, L2]
# CHECK: LoopHint
# CHECK-NEXT: = GetSlot [[passedBoth]] key="width" receivers=[L0, L1]
# CHECK-NEXT: = PropGet v0 key="depth"
# CHECK: = TypeTest v0 testedType=L1|L2
# CHECK: ([[passedAgain]]: L1|L2)
# CHECK-NEXT: Jump -> next [[front]]([[passedAgain]])
