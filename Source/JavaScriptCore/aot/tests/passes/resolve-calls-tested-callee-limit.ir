# A call with more predicted callees than a dispatch has arms tests for none of them: none is likelier than another, and the call stays where it is
# FORM: Prepared
# RUN: pass PlaceTypeTests
# LOSS: MaxDispatchCases
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="first" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f1 name="second" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="third" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="fourth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f4 name="fifth" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f5 name="as-many-predicted-callees-as-the-limit" parameters=[{type=anything predicted=f0|f1|f2|f3}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0|f1|f2|f3, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f5 name="as-many-predicted-callees-as-the-limit"
# CHECK: = IsClosureOf v0 function=f0
# CHECK: = CallDirect v1 function=f0
function f6 name="one-predicted-callee-more" parameters=[{type=anything predicted=f0|f1|f2|f3|f4}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ f0|f1|f2|f3|f4, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f6 name="one-predicted-callee-more"
# CHECK-NEXT: b0(v0: anything ~ f0|f1|f2|f3|f4, v1: anything):
# CHECK-NEXT: v2: anything = Call v0, -, v1
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f7 name="stamp-lists-one-callee-more" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1 callees=[f0, f1, f2, f3, f4, ..]
    Return v2
}
# CHECK-LABEL: function f7 name="stamp-lists-one-callee-more"
# CHECK-NEXT: b0(v0: anything, v1: anything):
# CHECK-NEXT: v2: anything = Call v0, -, v1 callees=[f0, f1, f2, f3, f4, ..]
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
