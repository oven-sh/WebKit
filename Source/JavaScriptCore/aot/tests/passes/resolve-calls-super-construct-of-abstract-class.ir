# CHECK: SuperConstruct v0, v1 layout=L6
function f12 name="the-class-has-instances-of-its-own" parameters=[{type=f0}, {type=f7|f8}] results=[{type=anything}] {
  b0(v0: f0, v1: f7|f8):
    v2 = SuperConstruct v0, v1 layout=L7
    Return v2
}
