function f11 name="no-class-has-instances" parameters=[{type=f0}, {type=f6}] results=[{type=anything}] {
  b0(v0: f0, v1: f6):
    v2 = SuperConstruct v0, v1 layout=L6
    Return v2
}
# CHECK-LABEL: function f11 name="no-class-has-instances"
