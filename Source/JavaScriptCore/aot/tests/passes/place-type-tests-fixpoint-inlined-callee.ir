# The accesses of an inlined callee to the receiver of its caller join the stretch of the caller through the guard that is there, so the receiver is tested once
# FORM: AsRead
# RUN: pipeline EliminateGuards
# OPTIONS: disable=flow:ProvenLayoutSets
# STATISTIC: MaxOptimizationRoundsHits = 0
# LOSS: MaxOptimizationRounds x0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=number}}, {key="y" declared={type=number}}, {key="z" declared={type=number}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = Call v1
    v3 = ToNumber v2
    v4 = NewObject -, v3, v3, v3 layout=L0 fields=[0, 1, 2]
    v5 = Call v1, -, v4
    v6 = NewClosure function=f1
    v7 = Call v1, -, v6
    Return
}

function f1 name="readsThroughCallee" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="x"
    v2 = CallDirect v0 function=f2
    v3 = PropGet v0 key="z"
    v4 = Mul v1, v2
    v5 = Mul v4, v3
    Return v5
}
# CHECK-LABEL: function f1 name="readsThroughCallee"
# CHECK: [[test1]]: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch [[test1]] -> taken [[fast1]](| 0), notTaken
# CHECK-NEXT: [[fast1]]([[guard1]]: guard):
# CHECK-NEXT: : number = GetSlot v0, [[guard1]] key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: : number = GetSlot v0, [[guard1]] key="y" receivers=[L0] level=Predicted
# CHECK-NOT: ShapeTest
# CHECK: : number = GetSlot v0, {{*}} key="z" receivers=[L0] level=Predicted
# CHECK-NOT: ShapeTest
# CHECK-NOT: GetSlot
# CHECK-LABEL: function f2 name="readY"

function f2 name="readY" parameters=[{type=object predicted=L0}] results=[{type=anything}] {
  b0(v0: object ~ L0):
    v1 = PropGet v0 key="y"
    Return v1
}
