# A sum of integers is held as an integer whatever its range, and a bitwise operator takes its low half: it gets no test. A number out of a call does
# FORM: Prepared
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
function f0 name="sumOfAnIntegerAndAByte" parameters=[{type=i32}, {type=int[0, 255]}] results=[{type=i32}] {
    v2: int[-2147483648, 2147483902] ~ int[0, 255] = Add v0, v1
    v3 = Integer integer=0
    v4: i32 = BitOr v2, v3
    Return v4
# CHECK-NOT: TypeTest
}

function f1 name="differenceOfWordsIsShifted" parameters=[{type=int[0, 4294967295]}, {type=int[0, 4294967295]}] results=[{type=i32}] {
    v2: int[-4294967295, 4294967295] ~ i32 = Sub v0, v1
    v3 = Integer integer=2
    v4: i32 = RShift v2, v3
    Return v4
# CHECK-NOT: TypeTest
}

function f2 name="sumWithANumber" parameters=[{type=i32}, {type=i32 flags=[IsExpected]}] results=[{type=i32}] {
  b0(v0: i32, v1: anything ~ i32):
    v2 = Add v0, v1
    v3 = Integer integer=0
    v4: i32 = BitOr v2, v3
    Return v4
# CHECK: TypeTest
}
