# The function that stores the initial values of a class's fields is handed an object that its caller has allocated and not finished. Where it is called and not taken in,
# its tests ask the order word, and it takes the mark off behind the store that fills the last field. Of a class without a parent nobody has seen the object;
# in front of the initializer of a derived class the constructor of the parent has run, so there the run time looks.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass FinishBirths
# STATISTIC: BirthsFinished = 2
# STATISTIC: BirthsLeftToRunTime = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Point" fields=[{key="x" declared={type=anything} flow={occupancy=FilledAtBirth}}, {key="y" declared={type=anything} flow={occupancy=FilledAtBirth}}]
layout L1 kind=Instance name="Below" base=L0 fields=[{key="z" declared={type=anything} flow={occupancy=FilledAtBirth}}] flags=[HasHeritage]

function f0 name="ofClassWithoutParent" kind=Initializer flags=[HasThis] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=undefined}] {
    v1 = Undefined
    v2 = HasNoFieldOutsideSlot v0
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    PutSlotOrAdd v0, v3, v1 key="x" receivers=[L0] level=Proven
    PutSlotOrAdd v0, v3, v1 key="y" receivers=[L0] level=Proven
    Return v1
  b2():
    PropDefine v0, v1 key="x"
    PropDefine v0, v1 key="y"
    Return v1
}
# CHECK-LABEL: name="ofClassWithoutParent"
# CHECK: = HasNoFieldOutsideSlot v0 [mayMeetUnfinishedObject]
# CHECK: PutSlotOrAdd v0, v3, v1 key="y"
# CHECK-NEXT: FinishBirth v0
# CHECK-NEXT: Return v1

function f1 name="ofDerivedClass" kind=Initializer flags=[HasThis] thisType={type=L1 flags=[IsFromCompiler]} results=[{type=undefined}] {
    v1 = Undefined
    v2 = HasNoFieldOutsideSlot v0
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    PutSlotOrAdd v0, v3, v1 key="z" receivers=[L1] level=Proven
    Return v1
  b2():
    PropDefine v0, v1 key="z"
    Return v1
}
# CHECK-LABEL: name="ofDerivedClass"
# CHECK: = HasNoFieldOutsideSlot v0 [mayMeetUnfinishedObject]
# CHECK: PutSlotOrAdd v0, v3, v1 key="z"
# CHECK-NEXT: TryFinishBirth v0
# CHECK-NEXT: Return v1

function f2 name="theCheckOfThisHasBecomeATest" kind=Initializer flags=[HasThis] thisType={type=L0 flags=[IsFromCompiler, IsExpected]} results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = AssumeType v0 provenType=object
    v3 = TypeTest v2 testedType=L0
    Branch v3 -> taken b1(| 0), notTaken b3()
  b1(v4: L0):
    v5 = HasNoFieldOutsideSlot v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    PutSlotOrAdd v4, v6, v1 key="x" receivers=[L0] level=Expected
    PutSlotOrAdd v4, v6, v1 key="y" receivers=[L0] level=Expected
    Jump -> next b4()
  b3():
    PropDefine v2, v1 key="x"
    PropDefine v2, v1 key="y"
    Jump -> next b4()
  b4():
    Return v1
}
# CHECK-LABEL: name="theCheckOfThisHasBecomeATest"
# CHECK: = HasNoFieldOutsideSlot v4 [mayMeetUnfinishedObject]
# CHECK: PutSlotOrAdd v4, v6, v1 key="y"
# CHECK-NEXT: FinishBirth v4
# CHECK: PropDefine v2, v1 key="y"
# CHECK-NEXT: TryFinishBirth v2
# CHECK-NEXT: Jump

function f3 name="nobodyLooksInFrontOfTheInitializer" results=[{type=L0}] {
    v0 = NewObject layout=L0
    v1 = CallDirect v0 function=f0
    Return v0
}
# CHECK-LABEL: name="nobodyLooksInFrontOfTheInitializer"
# CHECK: = NewObject layout=L0
# CHECK-NEXT: = CallDirect v0 function=f0
# CHECK-NEXT: TryFinishBirth v0
# CHECK-NEXT: Return v0
