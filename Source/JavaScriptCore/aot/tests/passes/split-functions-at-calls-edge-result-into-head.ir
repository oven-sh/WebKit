# What the edge into a cut block proves arrives in the block that leaves the entry part, and a narrowed value goes on as a parameter of the continuation. A guard stays in the entry part with its uses
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1
# CHECK: outcome: Changed
# RUN(AGAIN): pass SplitFunctionsAtCalls SplitFunctionsAtCalls
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled}}] flow={members=[L0]}

function f0 name="narrowedOnTakenEdge" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = Call v1, -, v3
    Return v4
  b2():
    Return v0
}
# CHECK-LABEL: function f0 name="narrowedOnTakenEdge"
# CHECK-NOT: = Call
# CHECK: Branch v2 -> taken [[leaving0]](| 0), notTaken
# CHECK: [[leaving0]]([[narrowed0]]: number):
# CHECK-NEXT: [[rest0]]: anything = CallDirect v1, [[narrowed0]] function=f8
# CHECK-NEXT: ReturnCall [[rest0]]

function f1 name="narrowedOnNotTakenEdge" parameters=[{type=number|string}, {type=function}] results=[{type=anything}] {
  b0(v0: number|string, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return v3
  b2(v4):
    v5 = Call v1, -, v4
    Return v5
}
# CHECK-LABEL: function f1 name="narrowedOnNotTakenEdge"
# CHECK-NOT: = Call
# CHECK: Branch v2 -> taken b1(| 0), notTaken [[leaving1]](| 0)
# CHECK: b1(v3: number):
# CHECK-NEXT: Return v3
# CHECK: [[leaving1]]([[narrowed1]]: string):
# CHECK-NEXT: [[rest1]]: anything = CallDirect v1, [[narrowed1]] function=f9
# CHECK-NEXT: ReturnCall [[rest1]]

function f2 name="argumentBeforeNarrowedValue" parameters=[{type=anything}, {type=function}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: boolean):
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b1(v2 | 0), notTaken b2()
  b1(v4, v5):
    v6 = Call v1, -, v4, v5
    Return v6
  b2():
    Return v0
}
# CHECK-LABEL: function f2 name="argumentBeforeNarrowedValue"
# CHECK-NOT: = Call
# CHECK: Branch v3 -> taken [[leaving2]](v2 | 0), notTaken
# CHECK: [[leaving2]]([[passed2]]: boolean, [[narrowed2]]: string):
# CHECK-NEXT: [[rest2]]: anything = CallDirect v1, [[passed2]], [[narrowed2]] function=f10
# CHECK-NEXT: ReturnCall [[rest2]]

function f3 name="caseValue" parameters=[{type=i32}, {type=function}] results=[{type=anything}] {
  b0(v0: i32, v1: function):
    Switch v0 cases=[7] -> case b1(| 0), otherwise b2()
  b1(v2):
    v3 = Call v1, -, v2
    Return v3
  b2():
    Return v0
}
# CHECK-LABEL: function f3 name="caseValue"
# CHECK-NOT: = Call
# CHECK: Switch v0 cases=[7] -> case [[leaving3]](| 0), otherwise
# CHECK: [[leaving3]]([[narrowed3]]: 7):
# CHECK-NEXT: [[rest3]]: anything = CallDirect v1, [[narrowed3]] function=f11
# CHECK-NEXT: ReturnCall [[rest3]]

function f4 name="oneEdgeProvesOtherPassesArgument" parameters=[{type=anything}, {type=function}, {type=boolean}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: boolean, v3: number):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v4 = TypeTest v0 testedType=number
    Branch v4 -> taken b3(| 0), notTaken b4()
  b2():
    Jump -> next b3(v3)
  b3(v5):
    v6 = Call v1, -, v5
    Return v6
  b4():
    Return v0
}
# CHECK-LABEL: function f4 name="oneEdgeProvesOtherPassesArgument"
# CHECK-NOT: = Call
# CHECK: Branch v4 -> taken [[leaving4]](| 0), notTaken
# CHECK: Jump -> next [[leaving4]](v3)
# CHECK: [[leaving4]]([[narrowed4]]: number):
# CHECK-NEXT: [[rest4]]: anything = CallDirect v1, [[narrowed4]] function=f12
# CHECK-NEXT: ReturnCall [[rest4]]
# CHECK-NOT: CallDirect

function f5 name="narrowedInEntryPartAndUsedBehindCut" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(| 0), notTaken b4()
  b1(v3):
    v4 = TypeTest v3 testedType=i32
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    Return v5
  b3():
    v6 = Call v1, -, v3
    Return v6
  b4():
    Return v0
}
# CHECK-LABEL: function f5 name="narrowedInEntryPartAndUsedBehindCut"
# CHECK-NOT: = Call
# CHECK: b1(v3: number):
# CHECK: [[rest5]]: anything = CallDirect v1, v3 function=f13
# CHECK-NEXT: ReturnCall [[rest5]]

function f6 name="narrowedByFusedTest" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    TestAndBranch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = Call v1, -, v3
    Return v4
  b2():
    Return v0
}
# CHECK-LABEL: function f6 name="narrowedByFusedTest"
# CHECK-NOT: = Call
# CHECK: = TypeTest v0 testedType=number
# CHECK-NEXT: TestAndBranch v2 -> taken [[leaving6]](| 0), notTaken
# CHECK: [[leaving6]]([[narrowed6]]: number):
# CHECK-NEXT: [[rest6]]: anything = CallDirect v1, [[narrowed6]] function=f14
# CHECK-NEXT: ReturnCall [[rest6]]

function f7 name="guardOnTakenEdge" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = GetSlot v0, v3 key="x" receivers=[L0] level=Predicted
    v5 = Call v1, -, v4
    Return v5
  b2():
    Return v0
}
# CHECK-LABEL: function f7 name="guardOnTakenEdge"
# CHECK-NOT: = Call
# CHECK: Branch v2 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v3: guard):
# CHECK-NEXT: = GetSlot v0, v3 key="x"
# CHECK-NEXT: Jump -> next [[leaving7]]()
# CHECK: [[leaving7]]():
# CHECK-NEXT: [[rest7]]: anything = CallDirect v1, v4 function=f15
# CHECK-NEXT: ReturnCall [[rest7]]

