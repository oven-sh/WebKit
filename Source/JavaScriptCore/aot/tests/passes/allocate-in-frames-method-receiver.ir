# An object on which a callee calls an inherited method of the program is in the caller's frame: the method is no part of the object. It is on the heap where the inherited method is a built-in, because native code takes cells of the heap only, and where the method gives the object back and the callee keeps it
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass only-passes=ComputeEffectSummaries,SummarizeForInlining,ResolveCalls,ResolveAccesses,InlineCalls,AllocateInFrames
# STATISTIC: ObjectsInFrames = 1
# CHECK: L0 may be in a frame
# CHECK-NOT: L1 may be in a frame
# CHECK-NOT: L2 may be in a frame

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Asked" module=m0 constructor=f7 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="AskedByBuiltin" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Kept" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f7
    v3 = NewClass v2 layout=L0
    v4 = NewClosure function=f8
    DefineMethod v3, v4 layout=L0 key="twice"
    v6 = FinishClass v3 layout=L0
    v7 = CallDirect v6, v1 function=f1
    v8 = CallDirect v1 function=f2
    v9 = CallDirect v1 function=f3
    Return
}
function f1 name="receiverOfInheritedMethod" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Construct v0, -, v1
    v3 = NewClosure function=f4
    v4 = Call v3, -, v2 [isNeverInlined]
    Return v4
}
# CHECK: [[asked]]:{{*}}= NewObject layout=L0 storage=Frame
# CHECK: = CallDirect {{*}}function=f4 {{*}}[isNeverInlined]

function f2 name="receiverOfInheritedBuiltin" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewClosure function=f5
    v3 = Call v2, -, v1 [isNeverInlined]
    Return v3
}
# CHECK: = NewObject {{*}}layout=L1 fields=[0] allocationSite
# CHECK: = CallDirect {{*}}function=f5 {{*}}[isNeverInlined]

function f3 name="receiverGivenBackAndKept" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure function=f6
    v3 = Call v2, -, v1 [isNeverInlined]
    Return v3
}
# CHECK: = NewObject {{*}}layout=L2 fields=[0] allocationSite
# CHECK: = CallDirect {{*}}function=f6 {{*}}[isNeverInlined]

function f4 name="asksTwice" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="twice"
    v2 = Call v1, v0 calleeKey="twice" [isNeverInlined]
    Return v2
}
function f5 name="asksForKey" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="hasOwnProperty"
    v2 = String string="x"
    v3 = Call v1, v0, v2 calleeKey="hasOwnProperty"
    Return v3
}
function f6 name="keepsValueOf" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="valueOf"
    v2 = Call v1, v0 calleeKey="valueOf"
    PutModuleVariable v2 variable=g0
    Return
}
function f7 name="Asked" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f8 name="twice" kind=Method flags=[HasThis] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = Add v1, v1
    Return v2
}
