# An edge keeps its target when a handler below the chosen successor uses a value of the merge block
# FORM: Prepared
# RUN: pass ThreadJumps
# STATISTIC: ThreadJumpsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="handlerUsesParameter" parameters=[{type=anything}, {type=number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Undefined
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v1)
  b3(v4):
    v5 = ToBoolean v4
    Branch v5 -> taken b4(), notTaken b5()
  b4():
    Return v1
  b5() handler=b7():
    v6 = Call v0
    Jump -> next b6()
  b6():
    Return v6
  b7() role=CatchHandler:
    v7 = CatchValue
    Return v4
# CHECK: b1():
# CHECK: Jump -> next b3(v3)
# CHECK: Return v4
}

