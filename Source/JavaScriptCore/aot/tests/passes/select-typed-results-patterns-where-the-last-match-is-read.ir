# The program reads RegExp.$1, which tells of its own last match: the shared regexp literals of patterns and formats are matched without a record
# FORM: AsRead
# OPTIONS: only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=string validation=[{shape=Primitive{} type=string rules=[Pattern{source="^a"}, Format{format=Uuid}]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = ToString v1
    v4 = CallDirect v3 function=f2
    v5 = Builtin builtin=RegExp
    v6 = PropGet v5 key="$1"
    Return v6
}
function f1 name="validates" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=BunBundleValidate
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
function f2 name="parses" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
}
# CHECK-NOT: RegExpPrototypeTest
# CHECK: [[pattern]]:{{*}}= SharedRegExpLiteral pattern="^a"
# CHECK-NEXT: = MatchesUnrecorded [[pattern]],
# CHECK: [[format]]:{{*}}= SharedRegExpLiteral pattern="^([0-9a-fA-F]{8}-
# CHECK-NEXT: = MatchesUnrecorded [[format]],
# CHECK-NOT: RegExpPrototypeTest
