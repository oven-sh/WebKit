# main.mjs: require(name); require("./running.mjs")        running.mjs: import "./imported.mjs"; report()        built with one entry point, main.mjs. A name made at run time finds running.mjs
# The build refuses code outside the image, and no text is evaluated: all the code that runs is compiled, and none of it calls import(). The site calls what the module runs.
# call-modules-where-a-name-may-find-code-outside-the-image.ir admits such files
# OPTIONS: exclude=CodeOutsideImage
# DIAGNOSTIC: CodeOutsideImageIsRefused 1
# FORM: AsRead
# RUN: pipeline CallModules
# STATISTIC: RequireSitesBound = 1
# CHECK: function f0 name="main"
# CHECK-NOT: EvaluateRequiredModule

module m0 path="/main.mjs" displayPath="main.mjs" body=f0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/running.mjs" displayPath="running.mjs" flags=[IsFoundByName] body=f1 requests=[{target=m2 completes=true}]
module m2 path="/imported.mjs" displayPath="imported.mjs" body=f2
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = RequireDynamic v1 referrer=m0
    EvaluateModule module=m1 referrer=m0 [isBare]
    Return
}
function f1 name="running" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
function f2 name="imported" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
