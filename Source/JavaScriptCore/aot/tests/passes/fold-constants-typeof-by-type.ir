# typeof is a constant where the type of its operand decides it. An object that may be callable is asked at run time.
# FORM: Prepared
# RUN: pass FoldConstants

module m0 path="main.js" displayPath="main.js" 
layout L0 module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = TypeOf v0
# CHECK: v1: "object" = String string="object"
    v2 = NewClosure function=f1
    v3 = TypeOf v2
# CHECK: v3: "function" = String string="function"
    v4 = Integer integer=1
    v5 = TypeOf v4
# CHECK: v5: "number" = String string="number"
    v6 = CallDirect function=f1
    v7 = TypeOf v6
# CHECK: v7{{*}}= TypeOf v6
    Return v1
}

function f1 name="g" results=[{type=object}] {
    v0 = NewObject layout=L0
    Return v0
}
