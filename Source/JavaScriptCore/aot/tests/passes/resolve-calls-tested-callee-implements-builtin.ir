# A stamp that names a built-in and the library function that implements it predicts no closure of that function: the test for the built-in is the test for its one closure
# FORM: Prepared
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
runtimefunction id=12 function=f0
function f0 name="call" module=m1 role=Library flags=[HasThis] enclosingRuntimeFunction=12 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
function f1 name="plain" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}

function f2 name="besideItsBuiltin" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, v1, v1 callees=[f0, builtin(FunctionPrototypeCall), ..]
    Return v2
}
# CHECK-LABEL: function f2 name="besideItsBuiltin"
# CHECK-NOT: IsClosureOf
# CHECK: v2: anything = Call v0, v1, v1

function f3 name="otherFunctionBesideBuiltin" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, v1, v1 callees=[f0, f1, builtin(FunctionPrototypeCall), ..]
    Return v2
}
# CHECK-LABEL: function f3 name="otherFunctionBesideBuiltin"
# CHECK-NOT: function=f0
# CHECK: = IsClosureOf v0 function=f1
# CHECK-NOT: function=f0

function f4 name="withoutBuiltin" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, v1, v1 callees=[f0, ..]
    Return v2
}
# CHECK-LABEL: function f4 name="withoutBuiltin"
# CHECK: = IsClosureOf v0 function=f0
