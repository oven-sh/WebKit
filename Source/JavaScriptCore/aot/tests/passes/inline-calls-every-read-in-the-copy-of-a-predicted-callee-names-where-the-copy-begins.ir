# A variable that is stored once is known to be stored only where a function that reads it is entered: the function around a copy may run and never enter the copy. So in the copy of a callee the read names the
# fact, whether flow has followed the callee to the call or the callee was predicted, and so does a read in the copy of whatever the callee calls
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls VerifyProgram

module m0 path="main.js" displayPath="main.js"
variable g0 name="storedOnce" declared={type=string} flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}

function f0 name="reads" results=[{type=number}] {
    v0 = GetModuleVariable variable=g0
    v1 = GetStringLength v0
    Return v1
}
function f1 name="callsReader" results=[{type=number}] {
    v0 = CallDirect function=f0 [isAlwaysInlined]
    Return v0
}
function f2 name="callsWhatFlowFollowed" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IsClosureOf v0 function=f0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect function=f0 [isAlwaysInlined]
    Return v2
  b2():
    Return
}
# CHECK-LABEL: name="callsWhatFlowFollowed"
# CHECK: b1():
# CHECK-NEXT: [[entered2]]: fact = Entered function=f0
# CHECK: = GetModuleVariable fact=[[entered2]] variable=g0

function f3 name="callsWhatWasPredicted" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IsClosureOf v0 function=f0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect function=f0 [isAlwaysInlined, calleeIsPredicted]
    Return v2
  b2():
    Return
}
# CHECK-LABEL: name="callsWhatWasPredicted"
# CHECK: b1():
# CHECK-NEXT: [[entered3]]: fact = Entered function=f0
# CHECK: = GetModuleVariable fact=[[entered3]] variable=g0

function f4 name="callsWhatWasPredictedAndCallsTheReader" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = IsClosureOf v0 function=f1
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect function=f1 [isAlwaysInlined, calleeIsPredicted]
    Return v2
  b2():
    Return
}
# CHECK-LABEL: name="callsWhatWasPredictedAndCallsTheReader"
# CHECK: b1():
# CHECK: [[entered4]]: fact = Entered function=
# CHECK: = GetModuleVariable fact=[[entered4]] variable=g0
