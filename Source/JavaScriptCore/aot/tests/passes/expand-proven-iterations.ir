# An iteration whose plan has one arm, no test and nothing to do at a close is expanded in Prepare, as ExpandIteration would expand it. Every other iteration, every spread and every for..in stays as it is written, for ExpandIteration to expand once the tests are placed
# FORM: Prepared optimizing
# RUN: pass ExpandProvenIterations
# RUN(ABSENT): pass ExpandProvenIterations
# RUN(TWICE): pass ExpandProvenIterations ExpandProvenIterations
# RUN(LATER): pass ExpandProvenIterations ExpandIteration
# RUN(LEFT): pass ExpandProvenIterations ExpandIteration
# STATISTIC: ExpandProvenIterationsChanges = 10
# STATISTIC: IterationsExpandedByClass >= 10
# CHECK: outcome: Changed
# TWICE: outcome: Changed
# TWICE-NEXT: outcome: Unchanged
# LATER: outcome: Changed
# LATER-NEXT: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Stack" flow={baseState=BuiltinClass baseClass=Array}

function f0 name="array" parameters=[{type=Array<number, pristine[Names]>}, {type=anything}] results=[{type=undefined}] {
    v2 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b6(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b5():
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b4(), notTaken b1()
  b4():
    IteratorClose v2
    Return
  b5() role=IterationCleanup subject=v2:
    v10 = CatchException
    IteratorClose v2 completion=Throw
    Rethrow v10
  b6():
    Return
}
# The close-on-throw region goes with the closes.
