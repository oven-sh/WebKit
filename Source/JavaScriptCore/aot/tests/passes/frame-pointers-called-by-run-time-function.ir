# Where the stub of a call with a list or of a construction cannot make the call, a run-time function does, and native code can enter no closure of a frame. That holds for the function that owns the frame and for a callee it gives the closure to. A plain call enters the closure from compiled code
# FORM: AsRead
# RUN: frame-pointers flow
# DIAGNOSTIC: CalleeRetainsFramePointer 4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = CallDirect function=f3
    v3 = CallDirect function=f4
    v4 = CallDirect function=f5
    Return
}

function f1 name="givenToCallWithList" results=[{type=anything}] {
    v0 = NewClosure function=f10 storage=Frame
    v1 = CallDirect v0 function=f6
    Return
}
# CHECK: function f1
# CHECK: v0 v1(0) may leak: yes

function f2 name="givenToConstruction" results=[{type=anything}] {
    v0 = NewClosure function=f10 storage=Frame
    v1 = CallDirect v0 function=f7
    Return
}
# CHECK: function f2
# CHECK: v0 v1(0) may leak: yes

function f3 name="givenTwoCallsAboveCallWithList" results=[{type=anything}] {
    v0 = NewClosure function=f10 storage=Frame
    v1 = CallDirect v0 function=f8
    Return
}
# CHECK: function f3
# CHECK: v0 v1(0) may leak: yes

function f4 name="givenToPlainCall" results=[{type=anything}] {
    v0 = NewClosure function=f10 storage=Frame
    v1 = CallDirect v0 function=f9
    Return
}
# CHECK: function f4
# CHECK: v0 v1(0) may leak: no

function f5 name="calledWithListByItsOwner" results=[{type=anything}] {
    v0 = NewClosure function=f10 storage=Frame
    v1 = Integer integer=1
    v2 = NewArray v1 contents=anything
    v3 = CallList v0, -, v2
    Return
}
# CHECK: function f5
# CHECK: v0 v3(0) may leak: yes

function f6 name="callsWithList" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = NewArray v1 contents=anything
    v3 = CallList v0, -, v2
    Return v3
}
function f7 name="constructs" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Construct v0
    Return
}
function f8 name="passesToCallWithList" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f6
    Return v1
}
function f9 name="calls" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    Return v1
}
function f10 name="callback" results=[{type=anything}] {
    Return
}
