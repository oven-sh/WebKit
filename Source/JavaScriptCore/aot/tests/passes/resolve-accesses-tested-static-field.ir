# ORDER-NEXT: [[unchanged]]: boolean = AreMembersUnchanged conditions=[{layout=L2 side=Static key="count"}, {kind=PrototypeLinkUnchanged layout=L2 side=Static}]
# ORDER-NEXT: Branch [[unchanged]] -> taken
# ORDER-NOT: AreMembersUnchanged
}
function f11 name="proven" parameters=[{type=f3}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
# CHECK-NEXT: b0(v0: f3):
# CHECK-NEXT: = PropGet v0 key="count"
