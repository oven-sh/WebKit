# A static field that unknown code may touch is read and stored as its variable under the guard of the member, with the access by name in the generic copy
# Ahead of the guard the variable may hold the mark of a field that has left it, so the read names a fact that stands behind the guard
# FORM: Prepared
# RUN: pass PlaceTypeTests
# RUN(ORDER): pass PlaceTypeTests
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="count" module=m0 declared={type=number} owner=L0 flow={initialization=StoredBeforeEveryRead}
variable g1 name="count" module=m0 declared={type=number} owner=L1 flow={writers=AllKnown initialization=StoredBeforeEveryRead}
variable g2 name="count" module=m0 declared={type=number} owner=L3 flow={writers=AllKnown initialization=StoredBeforeEveryRead}
variable g3 name="count" module=m0 declared={type=number} owner=L4
layout L0 kind=Instance name="UnknownWriters" constructor=f0 staticFields=[{key="count" variable=g0}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L1 kind=Instance name="EvaluatedAgain" constructor=f1 staticFields=[{key="count" variable=g1}] flow={baseState=None} classFlow={prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L2 kind=Instance name="LinkMayChange" base=L0 constructor=f2 flags=[HasHeritage] flow={baseState=Layout base=L0} classFlow={evaluations=AtMostOnce prototypeLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L3 kind=Instance name="Proven" constructor=f3 staticFields=[{key="count" variable=g2}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L4 kind=Instance name="ReadEarly" constructor=f4 staticFields=[{key="count" variable=g3}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}

function f0 name="UnknownWriters" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f1 name="EvaluatedAgain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L1
function f2 name="LinkMayChange" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L2
function f3 name="Proven" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L3
function f4 name="ReadEarly" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L4

function f5 name="read" parameters=[{type=f0}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
# CHECK-NEXT: b0(v0: f0):
# CHECK-NEXT: [[unchanged5]]: boolean = AreMembersUnchanged conditions=[{layout=L0 side=Static key="count"}]
# CHECK-NEXT: Branch [[unchanged5]] -> taken
# CHECK: [[behind5]]: fact = Specified
# CHECK-NEXT: v1: number = GetModuleVariable fact=[[behind5]] variable=g0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="count"
}
function f6 name="store" parameters=[{type=f0}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="count"
    Return
# CHECK: [[unchanged6]]: boolean = AreMembersUnchanged conditions=[{layout=L0 side=Static key="count"}]
# CHECK-NEXT: Branch [[unchanged6]] -> taken
# CHECK: PutModuleVariable v1 variable=g0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v0, v1 key="count"
}
function f7 name="test" parameters=[{type=f0}] results=[{type=anything}] {
    v1 = PropHas v0 key="count"
    Return v1
# CHECK: [[unchanged7]]: boolean = AreMembersUnchanged conditions=[{layout=L0 side=Static key="count"}]
# CHECK-NEXT: Branch [[unchanged7]] -> taken
# CHECK: v1: true = Boolean boolean=true
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropHas v0 key="count"
}
function f8 name="two-reads" parameters=[{type=f0}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    v2 = PropGet v0 key="count"
    v3 = Add v1, v2
    Return v3
# CHECK: = AreMembersUnchanged conditions=[{layout=L0 side=Static key="count"}]
# CHECK-NOT: AreMembersUnchanged
# CHECK: [[first8]]: fact = Specified
# CHECK-NEXT: v1: number = GetModuleVariable fact=[[first8]] variable=g0
# CHECK-NEXT: [[second8]]: fact = Specified
# CHECK-NEXT: v2: number = GetModuleVariable fact=[[second8]] variable=g0
# CHECK-NOT: AreMembersUnchanged
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="count"
# CHECK-NEXT: = PropGet v0 key="count"
# CHECK-NOT: AreMembersUnchanged
}
function f9 name="class-may-be-evaluated-again" parameters=[{type=f1}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
# CHECK-NOT: AreMembersUnchanged
# CHECK: [[once9]]: boolean = AreMembersUnchanged conditions=[{kind=ClassEvaluatedOnce layout=L1}]
# CHECK-NEXT: Branch [[once9]] -> taken
# CHECK: [[behind9]]: fact = Specified
# CHECK-NEXT: v1: number = GetModuleVariable fact=[[behind9]] variable=g1
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="count"
}
function f10 name="through-subclass-whose-link-may-change" parameters=[{type=f2}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
# CHECK: [[behind10]]: fact = Specified
# CHECK-NEXT: v1: number = GetModuleVariable fact=[[behind10]] variable=g0
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="count"
