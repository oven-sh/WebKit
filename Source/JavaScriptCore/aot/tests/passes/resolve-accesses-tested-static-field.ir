}
function f12 name="definition-may-not-have-run" parameters=[{type=f4}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
# CHECK-NEXT: b0(v0: f4):
# CHECK-NEXT: = PropGet v0 key="count"
# CHECK-NEXT: Return v1
# CHECK-NEXT: }
}
function f13 name="stored-value-may-not-fit" parameters=[{type=f0}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="count"
    Return
# CHECK-NEXT: b0(v0: f0, v1: anything):
# CHECK-NEXT: PropSet v0, v1 key="count"
# CHECK-NEXT: Return
# CHECK-NEXT: }
}
function f14 name="rare-block" parameters=[{type=f0}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = PropGet v0 key="count"
    Return v2
  b2():
    Return
# CHECK-NOT: AreMembersUnchanged
# CHECK: frequency=Rare:
# CHECK-NEXT: = PropGet v0 key="count"
# CHECK-NOT: AreMembersUnchanged
}
