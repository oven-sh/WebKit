function f7 name="storeInsideLengthEndsNoProof" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}, {type=i32}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000], v2: i32):
    v3 = GetArrayLength v0
    v4 = Less v1, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    ElemSet v0, v1, v2 mode=Strict
    v6 = ElemGet v0, v1
    Return v6
  b2():
    v7 = Undefined
    Return v7
}
# CHECK-LABEL: function f7 name="storeInsideLengthEndsNoProof"
# CHECK-COUNT-1: = HasArrayStorage v0
# CHECK-NOT: = HasArrayStorage v0

function f8 name="storeAnywhereEndsTheProofs" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}, {type=i32}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000], v2: i32, v3: int[0, 1000]):
    v4 = GetArrayLength v0
    v5 = Less v1, v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    ElemSet v0, v3, v2 mode=Strict
    v7 = ElemGet v0, v1
    Return v7
  b2():
    v8 = Undefined
    Return v8
}
# CHECK-LABEL: function f8 name="storeAnywhereEndsTheProofs"
# CHECK-COUNT-2: = HasArrayStorage v0

function f9 name="loopThatStoresInsideTheLength" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>):
    v1 = Integer integer=0
    Jump -> next b1(v1)
  b1(v2: int[0, 4294967295]):
    LoopHint
    v4 = GetArrayLength v0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = ElemGet v0, v6
    v8 = Integer integer=3
    v9 = Mul v7, v8
    v10 = Integer integer=1023
    v11 = BitAnd v9, v10
    ElemSet v0, v6, v11 mode=Strict
    v13 = Integer integer=1
    v14 = Add v6, v13
    Jump -> next b1(v14)
  b3():
    Return
}
# The test of the kind stands in front of the loop, because nothing in the loop ends its proof.
# CHECK-LABEL: function f9 name="loopThatStoresInsideTheLength"
# CHECK: = HasArrayStorage v0 arrayStorage=Int32 [isWritable]
# CHECK-NOT: = HasArrayStorage
# CHECK: LoopHint
# CHECK-NOT: = HasArrayStorage
# CHECK: : i32 = GetArrayElement v0, {{*}} arrayStorage=Int32 level=Predicted [keyIsIntegral, isInBounds]
# CHECK-NOT: = HasArrayStorage
# CHECK: PutArrayElement v0, {{*}} arrayStorage=Int32 level=Predicted [keyIsIntegral, isInBounds]
# CHECK-NOT: = HasArrayStorage

function f10 name="loopThatStoresAnywhere" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000]):
    v2 = Integer integer=0
    Jump -> next b1(v2)
  b1(v3: int[0, 4294967295]):
    LoopHint
    v5 = GetArrayLength v0
    v6 = Less v3, v5
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = ElemGet v0, v7
    v9 = Integer integer=3
    v10 = Mul v8, v9
    v11 = Integer integer=1023
    v12 = BitAnd v10, v11
    ElemSet v0, v1, v12 mode=Strict
    v14 = Integer integer=1
    v15 = Add v7, v14
    Jump -> next b1(v15)
  b3():
    Return
}
# The store may lengthen the array or give it other storage, so every turn tests the kind again.
# CHECK-LABEL: function f10 name="loopThatStoresAnywhere"
# CHECK: LoopHint
# CHECK: = HasArrayStorage v0 arrayStorage=Int32 [isWritable]
# CHECK: PutArrayElement v0, v1, {{*}} arrayStorage=Int32 level=Predicted [keyIsIntegral]
