function f5 name="storeBelowLength" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}, {type=i32}] results=[{type=undefined}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000], v2: i32):
    v3 = GetArrayLength v0
    v4 = Less v1, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    ElemSet v0, v1, v2 mode=Strict
    Return
  b2():
    Return
}
# CHECK-LABEL: function f5 name="storeBelowLength"
# CHECK: = HasArrayStorage v0 arrayStorage=Int32 [isWritable]
# CHECK: PutArrayElement v0, v1, v2, {{*}} arrayStorage=Int32 level=Predicted [keyIsIntegral, isInBounds]
# CHECK: = IsInBounds v0, v1

