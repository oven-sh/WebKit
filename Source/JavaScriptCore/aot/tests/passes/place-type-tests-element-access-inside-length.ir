# Where the function compares a position with the length of the array, the access gets the test of the position with its other tests and is an access inside the length: a read of an array without holes gives the element type, and a store writes one element and ends no proof. Each case stands beside one that differs in the one thing that costs the test
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
function f0 name="readBelowLength" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000]):
    v2 = GetArrayLength v0
    v3 = Less v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = ElemGet v0, v1
    Return v4
  b2():
    v5 = Undefined
    Return v5
}
# CHECK-LABEL: function f0 name="readBelowLength"
# CHECK: = HasArrayStorage v0 arrayStorage=Int32
# CHECK: v4: i32 = GetArrayElement v0, v1, {{*}} arrayStorage=Int32 level=Predicted [keyIsIntegral, isInBounds]
# CHECK: [[isInside0]]: boolean = IsInBounds v0, v1
# CHECK-NEXT: Branch [[isInside0]] -> taken {{*}}(| 0), notTaken

function f1 name="readWithoutComparison" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f1 name="readWithoutComparison"
# CHECK-NOT: IsInBounds
# CHECK: v2: undefined|i32 = GetArrayElement v0, v1, {{*}} arrayStorage=Int32 level=Predicted
# CHECK-NOT: IsInBounds

function f2 name="comparedWithLengthOfAnother" parameters=[{type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}, {type=int[0, 1000]}, {type=Array<i32, proven, pristine[Storage, Names, Dense]> predicted=Array<i32, proven, Int32, pristine[Storage, Names, Dense]>}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>, v1: int[0, 1000], v2: Array<i32, proven, pristine[Storage, Names, Dense]> ~ Array<i32, proven, Int32, pristine[Storage, Names, Dense]>):
    v3 = GetArrayLength v2
    v4 = Less v1, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = ElemGet v0, v1
    Return v5
  b2():
    v6 = Undefined
    Return v6
}
# CHECK-LABEL: function f2 name="comparedWithLengthOfAnother"
# CHECK-NOT: IsInBounds
# CHECK: v5: undefined|i32 = GetArrayElement v0, v1,
# CHECK-NOT: IsInBounds

