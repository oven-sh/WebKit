# CHECK-NOT: function=f1
# CHECK-COUNT-16: = Mul
# CHECK-NOT: function=f1
# TWICE-LABEL: function f0 name="main"
# TWICE: = CallDirect {{*}} function=f2
# TWICE: = CallDirect {{*}} function=f2
# VALUE-LABEL: function f0 name="main"
# VALUE: = CallDirect {{*}} function=f3
