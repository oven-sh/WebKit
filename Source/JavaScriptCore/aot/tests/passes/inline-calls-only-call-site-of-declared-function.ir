# A declared function is copied into its only call site whatever its size up to MaxOnlyCallSiteBytes: the site is a call by value when the call graph is built
# RUN: pipeline CheckPlacement
# RUN(TWICE): pipeline CheckPlacement
# RUN(VALUE): pipeline CheckPlacement

variable g0 name="calledOnce" module=m0 declared={type=function} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="calledTwice" module=m0 declared={type=function} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="calledOnceAndKeptAsValue" module=m0 declared={type=function} initialization=Function function=f3 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v1
    v4 = GetModuleVariable variable=g1
    v5 = Call v4, -, v3
    v6 = GetModuleVariable variable=g1
    v7 = Call v6, -, v5
    v8 = GetModuleVariable variable=g2
    v9 = Call v8, -, v7
    v10 = PropGet v0 key="publish" [isFreeName]
    v11 = Call v10, -, v9, v8
    Return
}
