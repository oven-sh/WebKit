# What an initializer takes from outside and does again, such as a constant, stands in its function where it is first taken, as in the body, and once: what takes it later finds it there
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline DeferInitializers
# STATISTIC: InitializersDeferred = 1
# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: NewObject
# CHECK: Return
# CHECK: function {{*}} name="" {{*}}role=OutlinedBody
# CHECK: b0():
# CHECK-NEXT: [[one]]: fractional = Double number=1.5
# CHECK-NEXT: [[a]]: L1 = NewObject -, [[one]] layout=L1
# CHECK-NEXT: [[two]]: fractional = Double number=2.5
# CHECK-NEXT: [[b]]: L1 = NewObject -, [[two]] layout=L1
# CHECK-NEXT: [[three]]: fractional = Double number=3.5
# CHECK-NEXT: [[c]]: L1 = NewObject -, [[three]] layout=L1
# CHECK-NEXT: [[d]]: L1 = NewObject -, [[one]] layout=L1
# CHECK-NEXT: [[table]]: L0 = NewObject -, [[a]], [[b]], [[c]], [[d]] layout=L0
# CHECK-NEXT: PutModuleVariable [[table]] variable=g0
# CHECK-NEXT: Return [[table]]

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}, {key="c" declared={type=anything} flags=[IsRequired]}, {key="d" declared={type=anything} flags=[IsRequired]}]
layout L1 fields=[{key="n" declared={type=number} flags=[IsRequired]}]
variable g0 name="table" module=m0 declared={type=L0}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Double number=1.5
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = Double number=2.5
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Double number=3.5
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = NewObject -, v0 layout=L1 fields=[0]
    v7 = NewObject -, v1, v3, v5, v6 layout=L0 fields=[0, 1, 2, 3]
    PutModuleVariable v7 variable=g0
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = NewClosure function=f1
    v12 = Call v10, -, v11
    Return
}
function f1 name="reader" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = Call v0, -, v1
    Return v2
}
