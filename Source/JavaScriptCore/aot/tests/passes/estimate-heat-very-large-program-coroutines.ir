# In a very large program the callers of an async function, of a generator and of an async generator are counted at the function that starts it. Its body has that one caller and runs as often:
# it is hot where four functions start it and cold where one does.
# FORM: Prepared
# OPTIONS: limit=MaxWarmCodeValues:1
# RUN: pass EstimateHeat
# CHECK: f1 Hot 90 100
# CHECK-NEXT: f2 Hot 90 100
# CHECK-NEXT: f3 Hot 90 100
# CHECK-NEXT: f4 Cold 10 1
# CHECK: f9 Hot 90 100
# CHECK-NEXT: f10 Hot 90 100
# CHECK-NEXT: f11 Hot 90 100
# CHECK-NEXT: f12 Cold 10 1
# CHECK: thresholds: cold=4 hot=50

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v0 function=f5
    v4 = CallDirect v0 function=f6
    v5 = CallDirect v0 function=f7
    v6 = CallDirect v0 function=f8
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}

function f1 name="asyncFunction" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] capabilities=[HasOrdinaryFrame] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f9
    v3 = AssumeType v2 provenType=Promise
    Return v3
}

function f2 name="generator" role=CoroutineRamp flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=Generator}] capabilities=[HasOrdinaryFrame] creator=Coroutine{ramp=f2 body=f10 promiseParameter=2} {
    v2 = NewGenerator v0 function=f2
    v3 = CallDirect v0, v1, v2 function=f10
    Return v2
}

function f3 name="asyncGenerator" role=CoroutineRamp flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=AsyncGenerator}] capabilities=[HasOrdinaryFrame] creator=Coroutine{kind=AsyncGenerator ramp=f3 body=f11 promiseType=Promise promiseParameter=2} {
    v2 = NewAsyncGenerator v0 function=f3
    v3 = CallDirect v0, v1, v2 function=f11
    Return v2
}

function f4 name="asyncFunctionThatOneFunctionStarts" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] capabilities=[HasOrdinaryFrame] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f12 entryWithoutPromise=f12 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f12
    v3 = AssumeType v2 provenType=Promise
    Return v3
}

function f5 name="firstCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = NewClosure function=f2
    v3 = CallDirect v2, v0 function=f2
    v4 = NewClosure function=f3
    v5 = CallDirect v4, v0 function=f3
    v6 = CallDirect v0 function=f4
    Return v1
}

function f6 name="secondCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = NewClosure function=f2
    v3 = CallDirect v2, v0 function=f2
    v4 = NewClosure function=f3
    v5 = CallDirect v4, v0 function=f3
    Return v1
}

function f7 name="thirdCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = NewClosure function=f2
    v3 = CallDirect v2, v0 function=f2
    v4 = NewClosure function=f3
    v5 = CallDirect v4, v0 function=f3
    Return v1
}

function f8 name="fourthCaller" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f1
    v2 = NewClosure function=f2
    v3 = CallDirect v2, v0 function=f2
    v4 = NewClosure function=f3
    v5 = CallDirect v4, v0 function=f3
    Return v1
}

function f9 name="asyncFunction" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f1 parameterMap=[{original=0}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f1 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1} {
    v2 = AwaitBySavingFrame v0, v1
    v3 = ReturnAsyncResult v1, v2
    Return v3
}

function f10 name="generator" role=CoroutineBody flags=[IsGenerator, TakesCallee] parameters=[{type=anything}, {type=Generator}] results=[{type=anything}] derivation={source=f2 parameterMap=[{original=0}, {original=1}, {}]} creator=Coroutine{ramp=f2 body=f10 promiseParameter=2} {
    v3 = YieldBySavingFrame v2, v1, v0
    v4 = ResultAt v3
    Return v4
}

function f11 name="asyncGenerator" role=CoroutineBody flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=anything}, {type=AsyncGenerator}] results=[{type=anything}] derivation={source=f3 parameterMap=[{original=0}, {original=1}, {}]} creator=Coroutine{kind=AsyncGenerator ramp=f3 body=f11 promiseType=Promise promiseParameter=2} {
    v3 = AsyncGeneratorYield v2, v1, v0
    v4 = ResultAt v3
    Return v4
}

function f12 name="asyncFunctionThatOneFunctionStarts" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f4 parameterMap=[{original=0}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f12 entryWithoutPromise=f12 promiseType=Promise promiseParameter=1} {
    v2 = AwaitBySavingFrame v0, v1
    v3 = ReturnAsyncResult v1, v2
    Return v3
}
