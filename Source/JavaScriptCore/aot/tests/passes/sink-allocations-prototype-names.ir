# Whether a name can be found on a prototype decides what an access by name does to a field that is not stored
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 2
# STATISTIC: AllocationsSunk = 3
# STATISTIC: StoresFoldedIntoAllocations = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Bag" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="t" declared={type=anything} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 kind=Instance name="Holder" constructor=f11 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="t" declared={type=anything} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None}
layout L2 kind=Instance name="Closed" constructor=f12 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flow={baseState=None} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="m" function=f10}] namedMembers=[{key="m" function=f10}]}

function f0 name="missingNameReadsUndefined" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = PropGet v1 key="q" receivers=[L0]
    Return v2
}
# CHECK-LABEL: function f0 name="missingNameReadsUndefined"
# CHECK-NOT: NewObject
# CHECK-NOT: PropGet
# CHECK: [[missing0]]: undefined = Undefined
# CHECK-NEXT: v2: anything = Upcast [[missing0]] castType=anything

function f1 name="nameOnObjectPrototype" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = PropGet v1 key="toString" receivers=[L0]
