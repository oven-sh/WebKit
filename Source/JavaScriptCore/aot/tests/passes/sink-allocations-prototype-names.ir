  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    PropSet v1, v0 key="t" mode=Strict receivers=[L0]
    v3 = Call v0, -, v1
    Return v3
}
# CHECK-LABEL: function f3 name="storeCreatesField"
# CHECK-NOT: PropSet
# CHECK: = NewObject -, v0, v0 layout=L0 fields=[0, 1]

function f4 name="storeOfNameAbsentOnPrototypes" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v1, v0 key="t" mode=Strict receivers=[L1]
