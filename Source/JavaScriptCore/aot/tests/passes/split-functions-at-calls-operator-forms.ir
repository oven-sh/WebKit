# An operator needs a frame only in a form that calls the run time
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="integerFormOnEntryPath" parameters=[{type=i32}, {type=i32}, {type=function}] results=[{type=anything}] {
  b0(v0: i32, v1: i32, v2: function):
    v3 = Add v0, v1 form=CheckedIntegers
    v4 = Less v3, v1 form=Integers
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v3
  b2():
    v5 = Call v2, -, v3
    Return v5
}
# CHECK-LABEL: function f0 name="integerFormOnEntryPath"
# CHECK-NOT: = Call
# CHECK: [[rest0]]: anything = CallDirect {{*}}function=f3
# CHECK-NEXT: ReturnCall [[rest0]]

function f1 name="genericFormOnEntryPath" parameters=[{type=anything}, {type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: function):
    v3 = Add v0, v1 form=Generic
    v4 = TypeTest v3 testedType=number
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v3
  b2():
    v5 = Call v2, -, v3
    Return v5
}
# CHECK-LABEL: function f1 name="genericFormOnEntryPath"
# CHECK-NOT: CallDirect
# CHECK: = Call v2, -, v3

function f2 name="stringFormAfterTest" parameters=[{type=anything}, {type=string}] results=[{type=anything}] {
  b0(v0: anything, v1: string):
    v2 = TypeTest v0 testedType=string
    Branch v2 -> taken b2(| 0), notTaken b1()
  b1():
    Return v0
  b2(v3):
    v4 = Add v3, v1 form=Strings
    Return v4
}
# CHECK-LABEL: function f2 name="stringFormAfterTest"
# CHECK-NOT: = Add
# CHECK: [[rest2]]: anything = CallDirect {{*}}function=f4
# CHECK-NEXT: ReturnCall [[rest2]]
