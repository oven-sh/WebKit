# A way back joins what the copy has made with what the typed code has made. An object that never leaves the function needs no cell in the typed code, until it meets the other one:
# the typed code would build it for the meeting, each time it runs. So the copy does not come back where such an object is live. One that has left the function is built anyway
# FORM: Prepared
# OPTIONS: heat=NothingIsHottest
# RUN: pass AddGenericVersion
# STATISTIC: GenericVersionsCreated = 2
# STATISTIC: WaysBackFromGenericVersion = 1

module m0 path="main.js" displayPath="main.js" flags=[IsLibrary]
layout L0 name="Sized" fields=[{key="size" declared={type=anything}}]

function f0 name="listIsOnlyRead" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v0 expectedType=L0
    v3 = NewArray v1, v1 contents=anything
    v4: anything ~ number = PropGet v2 key="size"
    v5 = Call v1
    v6 = Integer integer=0
    v7 = ElemGet v3, v6
    v8 = Add v4, v7
    Return v8
# CHECK-COUNT-2: = NewArray
# CHECK-NOT: : Array{{*}}):
}

function f1 name="listIsHandedOut" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v0 expectedType=L0
    v3 = NewArray v1, v1 contents=anything
    v4: anything ~ number = PropGet v2 key="size"
    v5 = Call v1, -, v3
    v6 = Integer integer=0
    v7 = ElemGet v3, v6
    v8 = Add v4, v7
    Return v8
# CHECK-COUNT-2: = NewArray
}
