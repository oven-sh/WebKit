# const p = c ? o.c : { d: 7 }; return p.d
# The inner object of `o` lies in the room of `o`, so the name behind the meeting stands for slots that lie somewhere (BorrowedParameter). A fresh object that meets it there needs a cell: it is built.
# FORM: Prepared
# OPTIONS: references=narrow check=VerifyEachPass
# RUN: pass SinkAllocations

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Outer" fields=[{key="c" declared={type=L1} flags=[IsRequired] flow={location={deferral=FlattenedObject} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None} flattenedObjects=[{layout=L1 fields=[0]}]
layout L1 name="Inner" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Double number=0.5
    v1 = CallDirect v0 function=f1
    v2 = Boolean boolean=true
    v3 = CallDirect v1, v2 function=f2
    Return
}
function f1 name="make" parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L1 fields=[0] [isMadeOnDemand]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    Return v2
}
function f2 name="meetsBehindABorrowedRead" parameters=[{type=L0}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
    Jump -> next b3(v2)
  b2():
    v3 = Double number=7
    v4 = NewObject -, v3 layout=L1 fields=[0]
    Jump -> next b3(v4)
  b3(v5: L1):
    v6 = BorrowedParameter v5
    v7 = GetSlot v6 key="d" receivers=[L1] level=Proven
    Return v7
}
# CHECK-LABEL: function f2 name="meetsBehindABorrowedRead"
# CHECK: [[fresh]]:{{*}}= NewObject -, {{*}}layout=L1
# CHECK: [[met]]:{{*}}= BorrowedParameter
# CHECK-NEXT: = GetSlot [[met]] key="d"
