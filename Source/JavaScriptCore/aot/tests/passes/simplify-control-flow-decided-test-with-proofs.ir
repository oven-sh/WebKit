# A branch on a test that the types or constant operands decide becomes a jump that passes the tested value where the edge passed it narrowed
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# STATISTIC: SimplifyControlFlowChanges = 7
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="alwaysPasses" parameters=[{type=i32}, {type=boolean}, {type=number}] results=[{type=number}] {
  b0(v0: i32, v1: boolean, v2: number):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b3(| 0), notTaken b4()
  b2():
    v4 = Negate v2
    Jump -> next b3(v4)
  b3(v5):
    Return v5
  b4():
    Return v2
}
# CHECK-LABEL: function f0 name="alwaysPasses"
# CHECK: = TypeTest v0 testedType=number
# CHECK-NEXT: Jump -> next b3(v0)
# CHECK: Jump -> next b3(v4)
# CHECK: b3(v5: number):
# CHECK-NEXT: Return v5
# CHECK-NOT: Return v2

function f1 name="alwaysFails" parameters=[{type=i32}, {type=boolean}, {type=number}] results=[{type=number}] {
  b0(v0: i32, v1: boolean, v2: number):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(| 0), notTaken b4(| 0)
  b2():
    v4 = Negate v2
    Jump -> next b4(v4)
  b3(v5):
    Unreachable
  b4(v6):
    Return v6
}
# CHECK-LABEL: function f1 name="alwaysFails"
# CHECK: = TypeTest v0 testedType=string
# CHECK-NEXT: Jump -> next b4(v0)
# CHECK: b4(v6: number):
# CHECK-NEXT: Return v6

function f2 name="argumentsComeBeforeTestedValue" parameters=[{type=string}, {type=boolean}, {type=number}] results=[{type=anything}] {
  b0(v0: string, v1: boolean, v2: number):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(v2, v1 | 0), notTaken b4()
  b2():
    Jump -> next b3(v2, v1, v0)
  b3(v4, v5, v6):
    v7 = NewArray v4, v5, v6 contents=anything
    Return v7
  b4():
    Return v2
}
# CHECK-LABEL: function f2 name="argumentsComeBeforeTestedValue"
# CHECK: = TypeTest v0 testedType=string
# CHECK-NEXT: Jump -> next b3(v2, v1, v0)

function f3 name="onlyPredecessor" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Negate v2
    Return v3
  b2():
    Return v0
}
# CHECK-LABEL: function f3 name="onlyPredecessor"
# CHECK-NOT: Branch
# CHECK: = Negate v0
# CHECK-NEXT: Return v3
# CHECK-NOT: Return v0

function f4 name="constantOperands" parameters=[{type=boolean}, {type=number}] results=[{type=number}] {
  b0(v0: boolean, v1: number):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=3
    v3 = Integer integer=3
    v4 = StrictEq v2, v3
    Branch v4 -> taken b3(| 0), notTaken b4()
  b2():
    v5 = Negate v1
    Jump -> next b3(v5)
  b3(v6):
    Return v6
  b4():
    Return v1
}
# CHECK-LABEL: function f4 name="constantOperands"
# CHECK: = StrictEq v2, v3
# CHECK-NEXT: Jump -> next b3(v2)
# CHECK-NOT: Return v1

function f5 name="typeDecidesNothing" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Negate v2
    Return v3
  b2(v4):
    Return v4
}
# CHECK-LABEL: function f5 name="typeDecidesNothing"
# CHECK: Branch v1 -> taken b1(| 0), notTaken b2(| 0)
# CHECK-NEXT: b1(v2: number):
# CHECK: b2(v4: undefined|null|boolean|string|symbol|bigint|object):

function f6 name="typeOverlapsTestedType" parameters=[{type=number|string}] results=[{type=number|string}] {
  b0(v0: number|string):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = Negate v2
    Return v3
  b2(v4):
    Return v4
}
# CHECK-LABEL: function f6 name="typeOverlapsTestedType"
# CHECK: Branch v1 -> taken b1(| 0), notTaken b2(| 0)
# CHECK-NEXT: b1(v2: number):
# CHECK: b2(v4: string):

function f7 name="oneOperandUnknown" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=3
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Return v3
  b2():
    Return v1
}
# CHECK-LABEL: function f7 name="oneOperandUnknown"
# CHECK: Branch v2 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v3: 3):

function f8 name="zeroEqualsNegativeZero" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=0
    v2 = Double number=-0
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0, 1), notTaken b2()
  b1(v4, v5):
    v6 = Div v4, v5
    Return v6
  b2():
    Return v0
}
# CHECK-LABEL: function f8 name="zeroEqualsNegativeZero"
# CHECK-NOT: Branch
# CHECK: = Div v1, v2
# CHECK-NEXT: Return v6
# CHECK-NOT: Return v0

function f9 name="notANumberDiffersFromItself" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Double number=NaN
    v2 = StrictEq v1, v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Return v3
  b2():
    Return v0
}
# CHECK-LABEL: function f9 name="notANumberDiffersFromItself"
# CHECK-NOT: Branch
# CHECK: Return v0

function f10 name="unknownNumberComparedWithItself" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = StrictEq v0, v0
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return v2
  b2(v3):
    v4 = Negate v3
    Return v4
}
# CHECK-LABEL: function f10 name="unknownNumberComparedWithItself"
# CHECK: Branch v1 -> taken b1(| 0), notTaken b2(| 0)

function f11 name="bothEdgesProveIntoOneBlock" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b1(| 0)
  b1(v2):
    Return v2
}
# CHECK-LABEL: function f11 name="bothEdgesProveIntoOneBlock"
