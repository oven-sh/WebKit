# A call of a group takes its convention from the entrypoint it names: that entrypoint keeps its body although the program creates closures of the other members only. An entrypoint that only a dead call names goes
# FORM: Selected
# RUN: pass RemoveUnreachableFunctions
# OPTIONS: check=VerifyEachPass
# STATISTIC: UnreachableFunctionsRemoved = 5
# CHECK: outcome: Changed

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = CallDirect v0 function=f3
    Return v1
}
function f1 name="memberWithoutClosure" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="memberWithClosure" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f3 name="caller" parameters=[{type=f1|f2}] results=[{type=anything}] {
  b0(v0: f1|f2):
    v1 = CallGroup v0 function=f4 callees=[f1, f2]
    Return v1
}
function f4 name="namedByLivingCall" role=GroupEntrypoint captures=[{type=f1|f2}] results=[{type=anything}] creator=Entrypoint{target=f1 group=[f1, f2] arguments=Registers} {
  b0(v0: f1|f2):
    v1 = CallDirect function=f1
    Return v1
}
# CHECK-LABEL: function f4 name="namedByLivingCall"
# CHECK: b0(
function f5 name="enteredThroughClosure" role=GroupEntrypoint captures=[{type=f1|f2}] results=[{type=anything}] creator=Entrypoint{target=f2 group=[f1, f2] arguments=Registers} {
  b0(v0: f1|f2):
    v1 = CallDirect function=f2
    Return v1
}
# CHECK-LABEL: function f5 name="enteredThroughClosure"
# CHECK: b0(
function f6 name="genericOfMemberWithoutClosure" role=GenericEntrypoint captures=[{type=f1}] results=[{type=anything}] creator=Entrypoint{target=f1 groupEntrypoint=f4} {
  b0(v0: f1):
    v1 = CallDirect function=f1
    Return v1
}
# CHECK-LABEL: function f6 name="genericOfMemberWithoutClosure"
# CHECK-NOT: b0(
function f7 name="genericOfMemberWithClosure" role=GenericEntrypoint captures=[{type=f2}] results=[{type=anything}] creator=Entrypoint{target=f2 groupEntrypoint=f5} {
  b0(v0: f2):
    v1 = CallDirect function=f2
    Return v1
}
# CHECK-LABEL: function f7 name="genericOfMemberWithClosure"
# CHECK: b0(

function f8 name="memberOfDeadGroup" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
# CHECK-LABEL: function f8 name="memberOfDeadGroup"
# CHECK-NOT: b0(
function f9 name="deadCaller" parameters=[{type=f8}] results=[{type=anything}] {
  b0(v0: f8):
    v1 = CallGroup v0 function=f10 callees=[f8]
    Return v1
}
# CHECK-LABEL: function f9 name="deadCaller"
# CHECK-NOT: b0(
function f10 name="namedByDeadCall" role=GroupEntrypoint captures=[{type=f8}] results=[{type=anything}] creator=Entrypoint{target=f8 group=[f8] arguments=Registers} {
  b0(v0: f8):
    v1 = CallDirect function=f8
    Return v1
}
# CHECK-LABEL: function f10 name="namedByDeadCall"
# CHECK-NOT: b0(
function f11 name="genericOfDeadGroup" role=GenericEntrypoint captures=[{type=f8}] results=[{type=anything}] creator=Entrypoint{target=f8 groupEntrypoint=f10} {
  b0(v0: f8):
    v1 = CallDirect function=f8
    Return v1
}
