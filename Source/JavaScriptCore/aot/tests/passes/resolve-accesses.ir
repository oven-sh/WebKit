    v1 = PropGet v0 key="deferred"
    Return v1
# CHECK: v1: f0 = GetDeferredClosureSlot v0 key="deferred" receivers=[L2] level=Proven
}
function f9 name="closure-not-deferred" parameters=[{type=L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="eager"
    Return v1
# CHECK: v1: f0 = GetSlot v0 key="eager" receivers=[L2] level=Proven
}
function f10 name="checked-receiver" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 castType=L0
    v2 = PropGet v1 key="x"
    Return v2
# CHECK: v2: number = GetSlot v1 key="x" receivers=[L0] level=Proven
}
function f11 name="rare-block" parameters=[{type=L0}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = PropGet v0 key="x"
    Return v2
  b2():
    Return
# CHECK: frequency=Rare:
# CHECK-NEXT: v2: number = GetSlot v0 key="x" receivers=[L0] level=Proven
}
