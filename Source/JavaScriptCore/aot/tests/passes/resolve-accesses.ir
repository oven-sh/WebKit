# A property access that types and flow records prove becomes a slot operation without a guard or a constant, and every other access stays by name
# FORM: Prepared
# RUN: pass ResolveAccesses
# STATISTIC: ResolveAccessesChanges = 18
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=number}}, {key="w" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Named" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="name" declared={type=string} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Widget" fields=[{key="deferred" declared={type=f0} flow={location={deferral=CapturesNothing deferredFunction=f0} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="eager" declared={type=f0} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="Unlisted" fields=[{key="y" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype] keys=NeverEnumerated}
layout L4 name="Freezable" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[AddProperty, ChangePrototype]}
layout L5 kind=Instance name="Buffer" constructor=f1 flow={baseState=None impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="size" kind=Getter function=f2 mutability=Fixed}]}
function f0 name="callback" kind=Arrow results=[{type=anything}] {
    Return
}
function f1 name="Buffer" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f2 name="size" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}

function f3 name="filled-field" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NEXT: b0(v0: L0):
# CHECK-NEXT: v1: number = GetSlot v0 key="x" receivers=[L0] level=Proven
# CHECK-NEXT: Return v1
}
function f4 name="users-narrow-in-the-same-run" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = Add v1, v1
    v3 = Add v2, v1
    Return v3
# CHECK: v1: number = GetSlot v0 key="x"
# CHECK-NEXT: v2: number = Add v1, v1
# CHECK-NEXT: v3: number = Add v2, v1
}
function f5 name="field-of-two-layouts" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
# CHECK: v1: number = GetSlot v0 key="x" receivers=[L0, L1] level=Proven
}
function f6 name="access-site-is-kept" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x" accessSite=3
    Return v1
# CHECK: v1: number = GetSlot v0 key="x" receivers=[L0] level=Proven accessSite=3
}
function f7 name="empty-slot-means-no-property" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="y"
    Return v1
# CHECK: v1: undefined|number = GetSlotOrUndefined v0 key="y" receivers=[L0] level=Proven
}
