# A literal that is passed to a direct call stays an allocation although the flow results say that the callee only inspects it
# FORM: AsRead
# RUN: pipeline ShareRegExpLiterals
# RUN(FLOW): flow
# OPTIONS: only-passes=ShareRegExpLiterals
# FLOW: function f2 parameter 0 uses=[Inspects]
# FLOW: function f3 parameter 0 uses=[Inspects]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    v1 = Undefined
    v2 = CallDirect v1 function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="print" [isFreeName]
    v5 = Call v4, -, v0, v2
    Return
}

function f1 name="passesLiteral" results=[{type=boolean}] {
    v0 = NewRegExp pattern="a"
    v1 = CallDirect v0 function=f2
    Return v1
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}

function f2 name="comparesWithOwnLiteral" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewRegExp pattern="a"
    v2 = StrictEq v0, v1
    Return v2
# CHECK: SharedRegExpLiteral pattern="a"
# CHECK-NOT: NewRegExp
}

function f3 name="comparesWithEarlierEvaluation" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = NewRegExp pattern="a"
    v2 = TypeTest v0 testedType=undefined
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v1 function=f3
    Return v3
  b2():
    v4 = StrictEq v0, v1
    Return v4
# CHECK: NewRegExp
# CHECK-NOT: SharedRegExpLiteral
}
