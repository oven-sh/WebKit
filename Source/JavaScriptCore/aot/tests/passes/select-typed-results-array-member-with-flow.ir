# The type flow gives a field that holds arrays has proofs no test can give: a parser tests the class of the array it created and assumes the rest
# The results are handed to a built-in that looks at its operand and neither keeps nor writes it: a callee nobody knows may store into the arrays, and then nothing is proven of them
# FORM: AsRead
# OPTIONS: report=Declines only-passes=ResolveBuiltins,SelectTypedResults
# RUN: pipeline SelectTypedResults
# STATISTIC: TypedResultsSelected = 2
# STATISTIC: ParsersCreated = 6
# CHECK-NOT: decline

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
expectedresult x0 type=L3 layouts=[L2, L3]
layout L0 name="Row" module=m0 position=10 fields=[{key="id" declared={type=number}}]
layout L1 name="Page" module=m0 position=20 fields=[{key="items" declared={type=Array<L0>}}, {key="total" declared={type=number}}]
layout L2 name="CheckedRow" module=m0 position=30 fields=[{key="id" declared={type=number}}]
layout L3 name="CheckedPage" module=m0 position=40 fields=[{key="items" declared={type=Array<L2>}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = Builtin builtin=ArrayIsArray
    v4 = CallDirect v2 function=f1
    v5 = Call v3, -, v4
    v6 = CallDirect v2 function=f2
    v7 = Call v3, -, v6
    Return
}

function f1 name="converted" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L1} illTypedCause=FromLooseType
    Return v3
# CHECK: = CallDirect {{*}} function=[[parserOfPage]]
}

function f2 name="withExpectedResult" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0 expectedResult=x0
    Return v2
# CHECK: = CallDirect {{*}} function=[[parserOfCheckedPage]]
# CHECK: function [[parserOfCheckedPage]] {{*}}role=Parser
# CHECK: [[assumedChecked]]: {{*}}pristine[Storage, Names]> = AssumeType {{*}} provenType=Array<
# CHECK: = NewObject -, [[assumedChecked]] layout=L3 fields=[0]
# CHECK: function [[parserOfRows]] {{*}}role=Parser {{*}}type=undefined|Array<L0>}
# CHECK: function [[parserOfPage]] {{*}}role=Parser
# CHECK: ({{*}}: undefined|Array<L0>, {{*}}: boolean, {{*}}: undefined|number, {{*}}):
# CHECK-NEXT: LoopHint
# CHECK: ([[items]]: undefined|Array<L0>, {{*}}: boolean, {{*}}: undefined|number, {{*}}):
# CHECK: = CallDirect {{*}} function=[[parserOfRows]]
# CHECK: [[isArray]]: boolean = TypeTest [[items]] testedType=Array<L0>
# CHECK-NEXT: Branch [[isArray]] -> taken [[whenArray]](| 0), notTaken
# CHECK: [[whenArray]]([[array]]: Array<L0>):
# CHECK-NEXT: [[assumed]]: {{*}}pristine[Storage, Names]> = AssumeType [[array]] provenType=Array<
# CHECK: = NewObject -, [[assumed]], {{*}} layout=L1 fields=[0, 1]
}
