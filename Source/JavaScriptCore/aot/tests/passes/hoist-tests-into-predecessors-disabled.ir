module m0 path="main.js" displayPath="main.js"
function f0 name="truthinessOfJoinedValue" parameters=[{type=boolean}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = ToBoolean v3
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
