# A callee that gives back or keeps what it reads from a parameter lets the contents leave, not the cell: a frame record may be passed to it. A callee that keeps the parameter itself may not get one
# FORM: AsRead
# RUN: frame-pointers flow
# DIAGNOSTIC: CalleeRetainsFramePointer 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Options" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="saved" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = CallDirect v1 function=f3
    Return
}

function f1 name="calleeReturnsField" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = CallDirect v1 function=f4
    Return v2
}
# CHECK: function f1
# CHECK-NEXT: allocations: [v1]
# CHECK: v1 v2(0) may leak: no

function f2 name="calleeKeepsField" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = CallDirect v1 function=f5
    Return
}
# CHECK: function f2
# CHECK-NEXT: allocations: [v1]
# CHECK: v1 v2(0) may leak: no

function f3 name="calleeKeepsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0] storage=Frame
    v2 = CallDirect v1 function=f6
    Return
}
# CHECK: function f3
# CHECK-NEXT: allocations: [v1]
# CHECK: v1 v2(0) may leak: yes

function f4 name="returnsField" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
function f5 name="keepsField" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    PutModuleVariable v1 variable=g0
    Return
}
function f6 name="keepsParameter" parameters=[{type=anything}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    Return
}
