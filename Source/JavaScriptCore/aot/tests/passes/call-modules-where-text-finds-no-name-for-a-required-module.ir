# main.mjs: require("./running.mjs")        running.mjs: import "./imported.mjs"; eval(text)        built with one entry point, main.mjs
# The run time answers an import() of a text with an entry point and with no other file of the program, and the one entry point has begun before any text runs.
# So no import() names running.mjs while the require() evaluates it, and the site calls what the module runs.
# call-modules-where-text-may-import-a-required-entry-point.ir is the same program with running.mjs as a second entry point
# FORM: AsRead
# RUN: pipeline CallModules
# STATISTIC: RequireSitesBound = 1
# CHECK: function f0 name="main"
# CHECK-NOT: EvaluateRequiredModule

module m0 path="/main.mjs" displayPath="main.mjs" body=f0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/running.mjs" displayPath="running.mjs" body=f1 requests=[{target=m2 completes=true}]
module m2 path="/imported.mjs" displayPath="imported.mjs" body=f2
entry module=m0
evalscope e0
function f0 name="main" kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    Return
}
function f1 name="running" module=m1 kind=Module results=[{type=anything}] {
    v0 = String string="text"
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return
}
function f2 name="imported" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Call v1
    Return
}
