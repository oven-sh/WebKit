# A call by value of a frame closure reads its captures from the closure: an environment in the frame is a frame pointer again where the capture is read
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# OPTIONS: check=VerifyEachPass
# OPTIONS: only-passes=ComputeEffectSummaries,ResolveCalls,ChooseCallingConventions,AllocateInFrames
# STATISTIC: ClosuresInFrames = 4
# STATISTIC: EnvironmentsInFrames = 1
# STATISTIC: EnvironmentsOnHeap = 1
# CHECK: L0 only in frames
# CHECK-NOT: L1
# CHECK: f3 only in frames
# CHECK-NEXT: f4 only in frames
# CHECK-NEXT: f3 capture 0 holds frame pointers
# CHECK-NOT: f4 capture

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="onlyRead" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="published" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    v3 = CallDirect v1, v2 function=f1
    v4 = CallDirect v1, v2 function=f2
    v5 = PropGet v0 key="print" [isFreeName]
    v6 = Call v5, -, v3, v4
    Return
}

function f1 name="calleeReadsCapture" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewClosure v2 function=f3
    Jump -> next b3(v3)
  b2():
    v4 = NewClosure v2 function=f3
    Jump -> next b3(v4)
  b3(v5):
    v6 = Call v5
    Return v6
}
# CHECK-LABEL: function f1 name="calleeReadsCapture"
# CHECK: v2: env L0 = NewObject -, v0 layout=L0 {{*}}storage=Frame
# CHECK: = NewClosure v2 function=f3 {{*}}storage=Frame
# CHECK: = NewClosure v2 function=f3 {{*}}storage=Frame
# CHECK: [[environment1]]: env L0 = GetCapture v5 function=f3
# CHECK-NEXT: = CallDirect [[environment1]] function=f3

function f2 name="calleePublishesCapture" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0 layout=L1 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewClosure v2 function=f4
    Jump -> next b3(v3)
  b2():
    v4 = NewClosure v2 function=f4
    Jump -> next b3(v4)
  b3(v5):
    v6 = Call v5
    Return v6
}
# CHECK-LABEL: function f2 name="calleePublishesCapture"
# CHECK-NOT: layout=L1 {{*}}storage=Frame
# CHECK: = NewClosure v2 function=f4 {{*}}storage=Frame
# CHECK: [[environment2]]: env L1 = GetCapture v5 function=f4
# CHECK-NEXT: = CallDirect [[environment2]] function=f4

function f3 name="readsCapture" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}

function f4 name="publishesCapture" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = NewClosure v0 function=f5
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="holder" [isFreeName]
    PropSet v3, v1 key="callback" mode=Strict
    Return
}

function f5 name="readsLater" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
