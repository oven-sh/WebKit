# A frame closure may be held by a frame environment that dies with it
# FORM: AsRead
# RUN: pipeline AllocateInFrames
# RUN(PLAN): frame-plan flow
# OPTIONS: check=VerifyEachPass
# OPTIONS: only-passes=ComputeEffectSummaries,AllocateInFrames
# STATISTIC: EnvironmentsMaterializedLate = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="captured" fields=[{key="x" declared={type=anything}}]
layout L1 kind=Environment name="closureInEnvironment" fields=[{key="read" declared={type=anything}}]
layout L2 kind=Environment name="storedLater" fields=[{key="x" declared={type=anything}}]
layout L3 kind=Environment name="outsideLoop" fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToBoolean v1
    v3 = CallDirect v1, v2 function=f1
    v4 = CallDirect v1 function=f5
    v5 = CallDirect v1 function=f6
    Return
}
# CHECK: L1.0 holds frame pointers
# CHECK-NEXT: L2.0 holds frame pointers
# CHECK-NOT: holds frame pointers

function f1 name="closureInEnvironmentUsedAfterCopy" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewClosure v2 function=f2
    v4 = NewObject -, v3 layout=L1 fields=[0]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v5 = NewClosure v2 function=f3
    v6 = Call v0, -, v5
    Jump -> next b2()
  b2():
    v7 = CallDirect v4 function=f4
    Return v7
}
# CHECK-LABEL: function f1 name="closureInEnvironmentUsedAfterCopy"
# CHECK-NOT: storage=
# CHECK: function=f2 {{*}}storage=Frame
# CHECK: layout=L1 {{*}}storage=Frame
# CHECK-NOT: storage=
# CHECK-NOT: MaterializeEnvironment
# PLAN-LABEL: function f1
# PLAN-NEXT: v2: Heap MaterializationDoesNotPay
# PLAN-NEXT: v3: Frame
# PLAN-NEXT: v4: Frame
# PLAN-NEXT: v5: Heap Escapes by v6(2)

function f2 name="read" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
# CHECK-LABEL: function f2 name="read"
# PLAN-LABEL: function f2

function f3 name="write" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = Integer integer=1
    PutEnvironmentField v0, v1 layout=L0 field=0
    Return
}

function f4 name="callsClosureInEnvironment" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = Call v1
    Return v2
}

function f5 name="closureStoredIntoEnvironmentLater" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure function=f7
    PutEnvironmentField v1, v2 layout=L2 field=0
    v4 = CallDirect v1 function=f8
    Return
}
# CHECK-LABEL: function f5 name="closureStoredIntoEnvironmentLater"
# CHECK: layout=L2 {{*}}storage=Frame
# CHECK: function=f7 {{*}}storage=Frame
# PLAN-LABEL: function f5
# PLAN-NEXT: v1: Frame
# PLAN-NEXT: v2: Frame

function f6 name="environmentOutsideLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L3 fields=[0]
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewClosure function=f7
    PutEnvironmentField v1, v3 layout=L3 field=0
    v5 = CallDirect v1 function=f9
    v6 = ToBoolean v5
    Branch v6 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f6 name="environmentOutsideLoop"
# CHECK: layout=L3 {{*}}storage=Frame
# CHECK: NewClosure function=f7
# CHECK-NOT: storage=
# PLAN-LABEL: function f6
# PLAN-NEXT: v1: Frame
# PLAN-NEXT: v3: Heap SeveralLiveInstances

function f7 name="callback" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
# CHECK-LABEL: function f7 name="callback"
# PLAN-LABEL: function f7

function f8 name="callsStoredLater" kind=Arrow captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    v2 = Call v1
    Return v2
}

function f9 name="callsOutsideLoop" kind=Arrow captures=[{type=env L3}] results=[{type=anything}] {
  b0(v0: env L3):
    v1 = GetEnvironmentField v0 layout=L3 field=0
    v2 = Call v1
    Return v2
}
