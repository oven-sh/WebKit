# Only the body of a coroutine may hold TakeGeneratorPrototype, so it stays there, however rare its block and however many bodies hold the like of it
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# CHECK-NOT: role=OutlinedBody
# CHECK-COUNT-8: TakeGeneratorPrototype v0, v1

module m0 path="main.js" displayPath="main.js"

function f0 name="ramp0" role=CoroutineRamp flags=[IsGenerator, TakesCallee] results=[{type=anything}] creator=Coroutine{ramp=f0 body=f1} {
  b0(v0: function):
    v1 = NewGenerator v0 function=f0
    Return v1
}
function f1 name="body0" role=CoroutineBody parameters=[{type=object}, {type=function}, {type=boolean}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{ramp=f0 body=f1} {
  b0(v0: object, v1: function, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    TakeGeneratorPrototype v0, v1
    Jump -> next b2()
  b2():
    Return
}

