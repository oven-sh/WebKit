# The code of a module runs once, and a loop in it turns as often as a loop anywhere else: the call in the loop gets the head of its callee.
# The call of the same function beside the loop runs once, and stays as it is
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline InlineHeads
# STATISTIC: SelectedHeadsInlined = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="next" [isFreeName]
    v2 = Call v1
    v3 = CallDirect v2 function=f1
    v4 = Call v1, -, v3
    Jump -> next b1()
  b1():
    LoopHint
    v6 = Call v1
    v7 = CallDirect v6 function=f1
    v8 = Call v1, -, v7
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="early" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = TypeTest v0 testedType=i32
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() frequency=Unlikely:
    v2 = Call v0, -, v0
    Return v2
}
# CHECK-LABEL: name="main"
# CHECK: = CallDirect {{*}} function=f1
# CHECK-NOT: isAfterInlinedHead
# CHECK: LoopHint
# CHECK: = CallDirect {{*}} function=f1 {{*}}[isAfterInlinedHead]
# CHECK-LABEL: name="early"
