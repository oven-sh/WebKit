# Heat with flow results, for callbacks of built-ins, code that runs once and closures handed to a callee nobody knows: one call for each time the closure is handed over
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat
# RUN: pipeline EstimateHeat
# RUN(ONCE): pipeline EstimateHeat
# RUN(HANDED): pipeline EstimateHeat

module m0 path="/main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="input" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Builtin builtin=Uint8Array
    v2 = Integer integer=4
    v3 = Construct v1, -, v2
    v4 = NewClosure function=f1
    v5 = PropGet v3 key="forEach"
    v6 = Call v5, v3, v4
    v7 = CallDirect v0 function=f3
    v8 = NewClosure function=f5
    v9 = ToBoolean v0
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="register" [isFreeName]
    v12 = NewClosure function=f7
    v13 = Call v11, -, v12
    Jump -> next b1()
  b1():
    LoopHint
    v15 = NewClosure function=f2
    v16 = PropGet v3 key="forEach"
    v17 = Call v16, v3, v15
    v18 = CallDirect v0 function=f4
    v19 = Call v8, -, v0
    v20 = NewClosure function=f6
    v21 = Call v11, -, v20
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return
}

function f1 name="perElement" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f2 name="perElementInLoop" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f3 name="calledOnce" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f4 name="calledInLoop" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f5 name="closureCalledInLoop" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f6 name="handedOverInLoop" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}

function f7 name="handedOverOnce" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
# CHECK: f0 RunsOnce [[p0]] 1
# CHECK-NEXT: f1 [[c1]] [[p1]] 8
# CHECK-NEXT: f2 [[c2]] [[p2]] 80
# CHECK-NEXT: f3 RunsOnce [[p3]] 1
# CHECK-NEXT: f4 [[c4]] [[p4]] 10
# CHECK-NEXT: f5 [[c5]] [[p5]] 10
# ONCE-NOT: f1 RunsOnce
# ONCE-NOT: f2 RunsOnce
# ONCE-NOT: f4 RunsOnce
# ONCE-NOT: f5 RunsOnce
# HANDED-NOT: f6 Cold
# HANDED: f7 Cold
