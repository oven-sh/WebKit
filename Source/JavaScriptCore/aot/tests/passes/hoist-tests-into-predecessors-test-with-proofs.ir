# A test whose branch passes a proof stays in the merge block: a block parameter as condition proves nothing
# FORM: Prepared
# RUN: pass HoistTestsIntoPredecessors
# STATISTIC: HoistTestsIntoPredecessorsChanges = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="truthinessWithoutProof" parameters=[{type=boolean}, {type=undefined|number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: boolean, v1: undefined|number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = ToBoolean v3
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
}
# CHECK-LABEL: function f0 name="truthinessWithoutProof"
# CHECK: b2():
# CHECK-NEXT: [[converted]]:{{*}}= ToBoolean v1
# CHECK-NEXT: Jump -> next b3([[converted]])
# CHECK: b3(v3: boolean):
# CHECK-NEXT: Branch v3 -> taken b4(), notTaken b5()

