# CHECK: b2():
# CHECK-NEXT: [[second]]:{{*}}= Less v1, v0
# CHECK-NEXT: Jump -> next b3([[second]])
# CHECK: b3([[joined]]: boolean):
# CHECK-NEXT: Branch [[joined]] -> taken b4(), notTaken b5()

