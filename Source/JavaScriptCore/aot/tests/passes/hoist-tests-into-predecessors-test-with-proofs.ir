function f3 name="comparisonWithoutProof" parameters=[{type=number}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: anything, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v1)
  b3(v3):
    v4 = Less v3, v0
    Branch v4 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    Return v1
}
