# What a caller knows of a receiver is worth more than the bytes it saves only as a bet that the copy runs often. The method table has an entrypoint for every method under a name, nobody knows
# which of them a call enters, and the body stays where it is for whoever calls the method by value: in an entrypoint an access is worth the bytes by which a slot is shorter than a name.
# `for (const watcher of watchers) watcher.close()` copied the whole of every close() of the program and of the library
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot
# RUN: pass InlineCalls

module m0 path="main.js" displayPath="main.js"
layout L0 name="Record" fields=[{key="a" declared={type=anything}}, {key="b" declared={type=anything}}, {key="c" declared={type=anything}}, {key="d" declared={type=anything}}, {key="e" declared={type=anything}}, {key="f" declared={type=anything}}, {key="g" declared={type=anything}}, {key="h" declared={type=anything}}, {key="i" declared={type=anything}}, {key="j" declared={type=anything}}, {key="k" declared={type=anything}}, {key="l" declared={type=anything}}, {key="m" declared={type=anything}}, {key="n" declared={type=anything}}, {key="o" declared={type=anything}}, {key="p" declared={type=anything}}]

function f0 name="storeSixteen" kind=Method flags=[HasThis] length=1 thisType={type=object} parameters=[{type=anything}] results=[{type=undefined}] {
    PropSet v0, v1 key="a"
    PropSet v0, v1 key="b"
    PropSet v0, v1 key="c"
    PropSet v0, v1 key="d"
    PropSet v0, v1 key="e"
    PropSet v0, v1 key="f"
    PropSet v0, v1 key="g"
    PropSet v0, v1 key="h"
    PropSet v0, v1 key="i"
    PropSet v0, v1 key="j"
    PropSet v0, v1 key="k"
    PropSet v0, v1 key="l"
    PropSet v0, v1 key="m"
    PropSet v0, v1 key="n"
    PropSet v0, v1 key="o"
    PropSet v0, v1 key="p"
    v18 = Undefined
    Return v18
}

function f1 name="knowsTheReceiver" parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
    v2 = CallDirect v0, v1 function=f0
    Return v0
# CHECK-NOT: CallDirect
# CHECK: PropSet {{*}}, v1 key="p"
}

function f2 name="storeSixteen" kind=Method role=TableEntrypoint flags=[HasThis] length=1 thisType={type=object} parameters=[{type=anything}] results=[{type=anything}] derivation={source=f0 parameter=2147483649} creator=Entrypoint{target=f0 arguments=Registers} {
    v2 = AssumeType v0 provenType=L0
    v3 = CallDirect v2, v1 function=f0
    ReturnCall v3 requirement=Allowed
# CHECK: = CallDirect {{*}}, v1 function=f0
# CHECK-NOT: PropSet
}
