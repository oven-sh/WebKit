module m0 path="main.js" displayPath="main.js"
function f0 name="behindMergePoint" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
  b0(v0: anything, v1: number):
    v2 = ToBoolean v0
    Branch v2 -> taken b1(), notTaken b2(v1)
  b1():
    v3 = Integer integer=1
    Jump -> next b2(v3)
  b2(v4):
    v5 = ToBoolean v0
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v4
  b4():
    Return v1
}
