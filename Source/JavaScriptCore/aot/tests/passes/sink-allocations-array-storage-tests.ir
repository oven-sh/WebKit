# CHECK-NOT: HasArrayStorage
# CHECK: Switch v2 cases=[0, 1]
# CHECK: frequency=Rare:
# CHECK-NEXT: [[cell9]]:{{*}}= NewArray v0, v1 contents=number
# CHECK-NEXT: PutModuleVariable [[cell9]] variable=g0

function f10 name="numbersAreAskedForAnotherKind" parameters=[{type=number}, {type=number}, {type=i32}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: i32):
    v3 = NewArray v0, v1 contents=number
    v4 = HasArrayStorage v3 arrayStorage=Int32
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
