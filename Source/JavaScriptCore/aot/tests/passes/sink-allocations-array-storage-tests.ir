function f11 name="guardOfNumbersMeetsTheGuardOfAnArrayFromOutside" parameters=[{type=number}, {type=number}, {type=i32}, {type=boolean}, {type=Array<number, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: i32, v3: boolean, v4: Array<number, proven, pristine[Storage, Names]>):
    Branch v3 -> taken b1(), notTaken b3()
  b1():
    v5 = NewArray v0, v1 contents=number
    v6 = AssumeType v5 castType=Array<number, proven, pristine[Storage, Names]>
    v7 = HasArrayStorage v6 arrayStorage=Double
    Branch v7 -> taken b2(| 0), notTaken b6()
  b2(v8):
    Jump -> next b5(v6, v8)
  b3():
    v9 = HasArrayStorage v4 arrayStorage=Double
    Branch v9 -> taken b4(| 0), notTaken b6()
  b4(v10):
    Jump -> next b5(v4, v10)
  b5(v11: Array<number, proven, pristine[Storage, Names]>, v12: guard):
    v13 = GetArrayElement v11, v2, v12 arrayStorage=Double level=Expected [keyIsIntegral]
    Return v13
  b6():
    Return v0
}
# CHECK-LABEL: function f11 name="guardOfNumbersMeetsTheGuardOfAnArrayFromOutside"
# CHECK: v5:{{*}}= NewArray v0, v1 contents=number
# CHECK: v7: boolean = HasArrayStorage v6 arrayStorage=Double
# CHECK-NEXT: Branch v7 -> taken b2(| 0), notTaken b6()

function f12 name="guardOfNumbersIsPutTogetherWithOneOfTheBuiltArray" parameters=[{type=number}, {type=number}, {type=i32}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: i32, v3: boolean):
    v4 = NewArray v0, v1 contents=number
    v5 = AssumeType v4 castType=Array<number, proven, pristine[Storage, Names, Dense]>
    v6 = HasArrayStorage v5 arrayStorage=Double
    Branch v6 -> taken b1(| 0), notTaken b5()
  b1(v7):
    Branch v3 -> taken b2(), notTaken b4()
  b2() frequency=Rare:
    v8 = IsInBounds v5, v2
    Branch v8 -> taken b3(| 0), notTaken b5()
  b3(v9) frequency=Rare:
    v10 = AllGuards v7, v9
    v11 = GetArrayElement v5, v2, v10 arrayStorage=Double level=Expected [keyIsIntegral, isInBounds]
    Return v11
  b4():
    v12 = Integer integer=1
    v13 = GetArrayElement v5, v12, v7 arrayStorage=Double level=Expected [keyIsIntegral]
    Return v13
  b5():
    Return v0
}
# CHECK-LABEL: function f12 name="guardOfNumbersIsPutTogetherWithOneOfTheBuiltArray"
# CHECK: v4:{{*}}= NewArray v0, v1 contents=number
# CHECK: v6: boolean = HasArrayStorage v5 arrayStorage=Double
# CHECK-NEXT: Branch v6 -> taken b1(| 0), notTaken b5()
