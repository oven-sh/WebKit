# The body behind the tests takes the tested types for proven. Where the tests at the head were the only checks, nothing waits for a generic version any more:
# what stands behind a value that never completes is cut, as in any function without a check. Here a member is read of a parameter of type undefined, which always throws
# FORM: AsRead
# RUN: pipeline SplitBehindEntryChecks
# OPTIONS: check=VerifyEachPass
# STATISTIC: FunctionsSplitBehindEntryChecks = 1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="register" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f1 name="readsOfUndefined" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=undefined site=w0}] results=[{type=anything}] {
  b0(v0: undefined):
    v1 = RequireObjectCoercible v0 name="once"
    v2 = PropGet v1 key="once"
    Return v2
}
# CHECK-LABEL: function f1 name="readsOfUndefined" module=m0 position=5 role=EntryChecks
# CHECK: = TypeTest v0 testedType=undefined
# CHECK: name="readsOfUndefined" module=m0 position=5 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=undefined site=w0}]
# CHECK: : never = RequireObjectCoercible
# CHECK-NEXT: Unreachable
# CHECK: name="readsOfUndefined" module=m0 position=5 role=GenericVersion
# CHECK: = PropGet
