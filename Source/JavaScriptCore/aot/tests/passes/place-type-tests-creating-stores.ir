# Where unknown JavaScript may run, a store in a constructor is expected to find its slot empty: it creates the field under the tests that the name is nowhere but in the slot. A store in a method that no constructor calls expects a filled slot, which is one test
# FORM: AsRead
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" constructor=f1 fields=[{key="count" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="reset"
    v4 = FinishClass v1 layout=L0
    v5 = Integer integer=1
    v6 = Construct v4, v4, v5
    v7 = PropGet v6 key="reset"
    v8 = Call v7, v6
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="text" [isFreeName]
    v11 = Builtin builtin=Function
    v12 = Construct v11, -, v10
    v13 = Call v12, -, v6, v4
    Return v8
}
function f1 name="Counter" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="count" mode=Strict
    Return v3
}
# CHECK-LABEL: function f1 name="Counter"
# CHECK-NOT: IsSlotFilled
# CHECK: = HasLayoutPrototype
# CHECK: ([[fits]]: undefined|int[-2147483643, 2147483647]):
# CHECK: PutSlotOrAdd {{*}}, [[fits]] key="count" receivers=[L0] level=Expected
# CHECK: frequency=Unlikely:
# CHECK-NEXT: PropSet v3, v1 key="count"
# The type of the field governs the slot: only a value that fits is stored there.
# CHECK: = AreMembersUnchanged conditions=[{kind=PrototypeLinkUnchanged layout=L0}, {kind=MemberPassedByStores layout=L0 key="count"}]
# CHECK: = TypeTest v1 testedType=undefined|int[-2147483643, 2147483647]
# CHECK-NOT: IsSlotFilled
function f2 name="reset" kind=Method flags=[HasThis] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = Integer integer=0
    PropSet v0, v1 key="count" mode=Strict
    Return
}
# CHECK-LABEL: function f2 name="reset"
# CHECK-NOT: PutSlotOrAdd
# CHECK: PutSlot [[object]], {{*}}, v1 key="count" receivers=[L0] level=Expected
# CHECK-NOT: AreMembersUnchanged
# The constructor fills the field, so the cell answers for the slot.
# CHECK: = HasBirthFieldsFilled [[object]]
