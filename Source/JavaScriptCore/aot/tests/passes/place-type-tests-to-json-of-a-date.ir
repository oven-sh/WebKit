# toJSON of a date that passes the test for a pristine date is the overload that writes the time value; with any other receiver the call counts as one that may run the receiver's own code.
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests ResolveBuiltins
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="ofADate" parameters=[{type=Date}] results=[{type=anything}] {
  b0(v0: Date):
    v1 = PropGet v0 key="toJSON"
    v2 = Call v1, v0 calleeKey="toJSON" callees=[builtin(DatePrototypeToJSON), ..]
    Return v2
}
# CHECK-LABEL: function f0 name="ofADate"
# CHECK: = IsPristine v0 builtinClass=Date aspects=[Names]
# CHECK: null|string = CallBuiltin v0{{*}} overload=DatePrototypeToJSON/0
# CHECK: frequency=Unlikely:
# CHECK: = PropGet v0 key="toJSON"

function f1 name="ofAnyObject" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = Builtin builtin=DatePrototypeToJSON
    v2 = Call v1, v0
    Return v2
}
# CHECK-LABEL: function f1 name="ofAnyObject"
# CHECK: anything = CallBuiltin v0 overload=DatePrototypeToJSON/0 builtinCallForm=AnyReceiver
