# Code that is proven to run at most once gets no test: one run cannot win back the copy that a test costs. A loop in such code gets its tests, and so does a function that somebody may call again
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" module=m0 fields=[{key="x" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = Call v1
    v3 = ToBoolean v2
    v4 = CallDirect v2 function=f1
    v5 = CallDirect v2, v3 function=f2
    v6 = NewClosure function=f3
    v7 = NewObject -, v0 layout=L0 fields=[0]
    v8 = Call v1, -, v4, v5, v6, v7
    Return
}

function f1 name="runsOnce" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
# CHECK-NOT: TypeTest
# CHECK: = PropGet v0 key="x"
}

function f2 name="loopsInOneRun" parameters=[{type=number flags=[IsExpected]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ number, v1: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = Mul v0, v0
    Branch v1 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1()
  b3():
    Return v3
# CHECK: = TypeTest v0 testedType=number
}

function f3 name="mayRunAgain" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ L0):
    v1 = PropGet v0 key="x"
    Return v1
# CHECK: = TypeTest v0 testedType=L0
}
