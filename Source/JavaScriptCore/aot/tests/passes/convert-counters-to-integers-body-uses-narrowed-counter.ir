# Every use of the counter below the staying edge reads the value the edge passes, so an index in the body has the bounded range
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 4
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="indexInBody" parameters=[{type=Array<number>}, {type=int[0, 100]}] results=[{type=number}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = ElemGet v0, v4
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b3():
    Return v4
# CHECK: b1(v4: int[0, 100]):
# CHECK: Less v4, v1
# CHECK-NEXT: Branch v6 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[index0]]: int[0, 99]):
# CHECK-NEXT: ElemGet v0, [[index0]]
# CHECK-NEXT: v8: int[1, 100] = Add [[index0]], v3
# CHECK: b3():
# CHECK-NEXT: Return v4
}

function f1 name="boundIsLengthReadInHeader" parameters=[{type=string}] results=[{type=undefined}] {
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = GetStringLength v0
    v6 = Less v3, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = ElemGet v0, v3
    v8 = Add v3, v2
    Jump -> next b1(v8)
  b3():
    Return
# CHECK: b1(v3: int[0, 2147483647]):
# CHECK: Branch v6 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[index1]]: int[0, 2147483646]):
# CHECK-NEXT: ElemGet v0, [[index1]]
# CHECK-NEXT: v8: int[1, 2147483647] = Add [[index1]], v2
}

function f2 name="usesInBlocksBelowTheBody" parameters=[{type=Array<number>}, {type=int[0, 100]}, {type=boolean}] results=[{type=undefined}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3)
  b1(v5):
    LoopHint
    v7 = Less v5, v1
    Branch v7 -> taken b2(), notTaken b6()
  b2():
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v8 = ElemGet v0, v5
    Jump -> next b5(v5)
  b4():
    v9 = Mul v5, v4
    Jump -> next b5(v9)
  b5(v10):
    v11 = ElemGet v0, v10
    v12 = Add v5, v4
    Jump -> next b1(v12)
  b6():
    Return
# CHECK: b2([[index2]]: int[0, 99]):
# CHECK: b3():
# CHECK-NEXT: ElemGet v0, [[index2]]
# CHECK-NEXT: Jump -> next b5([[index2]])
# CHECK-NEXT: b4():
# CHECK-NEXT: v9: int[0, 99] = Mul [[index2]], v4
# CHECK: b5(v10: int[0, 99]):
# CHECK-NEXT: ElemGet v0, v10
# CHECK-NEXT: v12: int[1, 100] = Add [[index2]], v4
}

function f3 name="usesTheEdgeDoesNotDominate" parameters=[{type=Array<number>}, {type=int[0, 100]}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = ElemGet v0, v4
    v7 = Less v4, v1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b3():
    v9 = ElemGet v0, v4
    Return v9
# CHECK: b1(v4: int[0, 100]):
# CHECK: ElemGet v0, v4
# CHECK-NEXT: Less v4, v1
# CHECK-NEXT: Branch v7 -> taken b2(| 0), notTaken b3()
# CHECK-NEXT: b2([[index3]]: int[0, 99]):
# CHECK-NEXT: Add [[index3]], v3
# CHECK: b3():
# CHECK-NEXT: ElemGet v0, v4
}

function f4 name="counterStaysNumber" parameters=[{type=Array<number>}, {type=number}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = ElemGet v0, v4
    v8 = Add v4, v3
    Jump -> next b1(v8)
  b3():
    Return
# CHECK: b1(v4: int|whole):
# CHECK: Branch v6 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: ElemGet v0, v4
# CHECK-NEXT: v8: int|whole = Add v4, v3
}
