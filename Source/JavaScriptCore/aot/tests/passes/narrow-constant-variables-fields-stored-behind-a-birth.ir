# `const E = {}; E.a = 1;`: a read of a field becomes the constant that every new object of the layout is given before anybody can see it, where no store anywhere gives the field another value.
# The walk behind a birth passes constants, casts, stores that run no code, a jump, and a call of one known function. The type of the field stays: its slot is empty until the store.
# The constant of a literal that a function makes is read as the constant too, and the type of that field stays as well.
# FORM: Prepared
# RUN: pass NarrowConstantVariables
# CHECK: outcome: Changed
# CHECK: layout L0 name="storedBehindBirth" fields=[{key="a" declared={type=number} {{*}}
# CHECK: layout L12 name="madeByAFunction" fields=[{key="a" declared={type=number} {{*}}
# CHECK-LABEL: name="reads"
# CHECK: v13: 1 = Integer integer=1
# CHECK-NEXT: v14: {{*}} = PropGet v1 key="a"
# CHECK-NEXT: v15: {{*}} = PropGet v2 key="a"
# CHECK-NEXT: v16: {{*}} = PropGet v3 key="a"
# CHECK-NEXT: v17: 1 = Integer integer=1
# CHECK-NEXT: v18: 1 = Integer integer=1
# CHECK-NEXT: v19: 1 = Integer integer=1
# CHECK-NEXT: v20: {{*}} = PropGet v7 key="a"
# CHECK-NEXT: v21: 1 = Integer integer=1
# CHECK-NEXT: v22: {{*}} = PropGet v9 key="a"
# CHECK-NEXT: v23: {{*}} = PropGet v10 key="a"
# CHECK-NEXT: v24: {{*}} = PropGet v11 key="b"
# CHECK-NEXT: v25: 2 = Integer integer=2

