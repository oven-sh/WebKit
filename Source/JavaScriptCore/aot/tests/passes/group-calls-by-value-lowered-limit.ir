# The pass reads the lowered limit of the dispatch: two callees are more than one arm, one callee is not
# FORM: Prepared
# OPTIONS: limit=MaxDispatchCases:1
# RUN: pass GroupCallsByValue
# CHECK: group g0 members=[f2, f3] sites=[a0] this=[omitted] arguments=[]
# CHECK-NOT: group

module m0 path="main.js" displayPath="main.js"
function f0 name="callsTwo" parameters=[{type=f2|f3}] results=[{type=anything}] {
  b0(v0: f2|f3):
    v1 = Call v0 accessSite=0 callees=[f2, f3]
    Return v1
}
function f1 name="callsOne" parameters=[{type=f4}] results=[{type=anything}] {
  b0(v0: f4):
    v1 = Call v0 accessSite=1 callees=[f4]
    Return v1
}
function f2 name="first" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f3 name="second" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
function f4 name="third" kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
