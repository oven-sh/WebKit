# An operation that finds no room for what it allocates goes on, and the error is thrown at the next poll. What a handler covers polls before it leaves the handler, on each way on which
# something may have allocated since the last poll, so the handler that covers the operation takes the error.
# FORM: Prepared
# RUN: pass RemoveRedundantHandlers

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]

function f0 name="allocates" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: b0(v0: anything) handler=b2():
# CHECK-NEXT: = NewObject
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Jump
}

function f1 name="returns" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Return v1
  b1() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: = Call v0
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Return v1
}

function f2 name="throws" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b1():
    v1 = Call v0
    Throw v1
  b1() role=CatchHandler:
    v2 = CatchValue
    Return v2
# CHECK: = Call v0
# CHECK-NEXT: Throw v1
}

function f3 name="leavesOnOneEdge" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean) handler=b4():
    v2 = Call v0
    Branch v1 -> taken b1(), notTaken b2()
  b1() handler=b4():
    v3 = Add v1, v1
    Jump -> next b3()
  b2():
    Return v2
  b3():
    Return v0
  b4() role=CatchHandler:
    v4 = CatchValue
    Return v4
# CHECK: Branch v1 -> taken b1(), notTaken [[added]]()
# CHECK: b1() handler=b4():
# CHECK: LoopHint [leavesHandler]
# CHECK-NEXT: Jump -> next b3()
# CHECK: [[added]]() handler=b4():
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Jump -> next b2()
}

function f4 name="hasPolledSince" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b2():
    v2 = Call v0
    LoopHint
    v4 = Add v1, v1
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v5 = CatchValue
    Return v5
# CHECK: LoopHint
# CHECK-NEXT: = Add
# CHECK-NEXT: Jump
}

function f5 name="leavesTheInnerOfTwo" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b3():
    v2 = Call v0
    Jump -> next b1()
  b1() handler=b4():
    v3 = Add v1, v1
    Jump -> next b2()
  b2():
    Return v2
  b3() role=CatchHandler handler=b4():
    v4 = CatchValue
    v5 = Call v4
    Return v5
  b4() role=CatchHandler:
    v6 = CatchValue
    Return v6
# CHECK: b0(v0: anything, v1: number) handler=b3():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Jump -> next b1()
# CHECK-NEXT: b1():
# CHECK-NEXT: = Add
# CHECK-NEXT: Jump -> next b2()
}

function f6 name="needsItsPollNoLonger" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b2():
    v2 = Add v1, v1
    LoopHint [leavesHandler]
    Jump -> next b1()
  b1():
    Return v2
  b2() role=CatchHandler:
    v4 = CatchValue
    Return v4
# CHECK: b0(v0: anything, v1: number):
# CHECK-NEXT: = Add
# CHECK-NEXT: Jump
# CHECK-NOT: CatchValue
}

function f7 name="passesBlockThatDoesNothing" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number) handler=b4():
    v2 = Call v0
    Jump -> next b1()
  b1():
    v3 = Add v1, v1
    Jump -> next b2()
  b2() handler=b4():
    v4 = Call v0
    Jump -> next b3()
  b3():
    Return v3
  b4() role=CatchHandler:
    v5 = CatchValue
    Return v5
# CHECK: b0(v0: anything, v1: number) handler=b4():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: Jump -> next b1()
# CHECK: b2() handler=b4():
# CHECK-NEXT: = Call v0
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Jump -> next b3()
}

function f8 name="handsOverResultOfAsyncFunction" parameters=[{type=anything}, {type=Promise}] results=[{type=anything}] {
  b0(v0: anything, v1: Promise) handler=b1():
    v2 = Call v0
    v3 = ReturnAsyncResult v1, v2
    Return v3
  b1() role=CatchHandler:
    v4 = CatchValue
    Return v4
# CHECK: = Call v0
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: = ReturnAsyncResult v1, v2
# CHECK-NEXT: Return
}

function f9 name="hasLostItsLastHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    LoopHint [leavesHandler]
    Return v1
# CHECK: = Call v0
# CHECK-NEXT: Return v1
}
