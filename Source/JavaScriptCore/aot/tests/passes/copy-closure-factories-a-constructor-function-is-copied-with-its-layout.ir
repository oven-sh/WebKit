# function make(kind) { function Made(held) { this.held = held }   Made.prototype = { kind };   return held => new Made(held) }   const a = make(1), b = make(2);   a(1);   b(2)
# Each call of the factory has a copy of it. The copy creates a copy of Made that constructs objects of a layout of its own, as a copy of a class factory evaluates a class of its own.
# Whoever names the layout as it is written means the objects of each call.
# FORM: AsRead
# RUN: pass CopyClosureFactories
# CHECK: outcome: Changed
# CHECK: layout L2 kind=Instance name="Made" module=m0 constructor=f4
# CHECK: layout L3 kind=Instance name="Made" module=m0 constructor=f7
# CHECK-LABEL: function f0 name="main"
# CHECK: v7{{*}} = NewClosure function=f6
# CHECK-NEXT: v2 = Call v7, -, v1
# CHECK: v8{{*}} = NewClosure function=f9
# CHECK-NEXT: v4 = Call v8, -, v3
# CHECK-LABEL: function f2 name="Made" {{*}}thisType={type=L0|L2|L3 flags=[IsExpected]}
# CHECK-LABEL: function f4 name="Made" {{*}}thisType={type=L2 flags=[IsExpected]} {{*}}derivation={source=f2} constructedClass=L2
# CHECK-LABEL: function f6 name="make"
# CHECK: v1 = NewClosure function=f4
# CHECK-LABEL: function f7 name="Made" {{*}}thisType={type=L3 flags=[IsExpected]} {{*}}derivation={source=f2} constructedClass=L3
# CHECK-LABEL: function f9 name="make"
# CHECK: v1 = NewClosure function=f7

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Made" module=m0 constructor=f2 fields=[{key="held" declared={type=anything}}] flags=[IsConstructorFunction]
layout L1 kind=Record module=m0 fields=[{key="kind" declared={type=anything}}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Call v0, -, v1
    v3 = Integer integer=2
    v4 = Call v0, -, v3
    v5 = Call v2, -, v1
    v6 = Call v4, -, v3
    Return
}
function f1 name="make" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = NewObject -, v0 layout=L1 fields=[0]
    PropSet v1, v2 key="prototype" mode=Strict
    v4 = NewClosure v1 function=f3
    Return v4
}
function f2 name="Made" module=m0 flags=[HasThis] thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f3 name="construct" module=m0 kind=Arrow captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Construct v0, -, v1
    Return v2
}
