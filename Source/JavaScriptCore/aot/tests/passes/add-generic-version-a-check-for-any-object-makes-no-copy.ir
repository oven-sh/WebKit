# A type that holds any object names no layout. Code that has it proven reads the object by name, as code that knows nothing of the value does, so a copy for the values that the check turns away would stand beside the same code.
# The check becomes what is expected of the value. A check for a layout beside it keeps its test and its copy
# FORM: Prepared
# OPTIONS: heat=NothingIsHottest
# RUN: pass AddGenericVersion
# STATISTIC: GenericVersionsCreated = 1
# STATISTIC: ChecksReplacedByGuards = 3

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Sized" fields=[{key="size" declared={type=number} flags=[IsRequired]}]

function f0 name="readsAnyObjectByName" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=object
    v2 = PropGet v1 key="size"
    v3 = PropGet v1 key="count"
    v4 = Add v2, v3
    Return v4
# CHECK: v1: anything ~ object = Expect v0 expectedType=object
# CHECK-NOT: = TypeTest
# CHECK-NOT: frequency=
# CHECK: Return v4
# CHECK-NEXT: }
}

function f1 name="readsAnyObjectOrNothingByName" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=undefined|null|object
    v2 = PropGet v1 key="size"
    Return v2
# CHECK: v1: anything ~ undefined|null|object = Expect v0 expectedType=undefined|null|object
# CHECK-NOT: = TypeTest
# CHECK-NOT: frequency=
# CHECK: Return v2
# CHECK-NEXT: }
}

function f2 name="readsWhatACallReturnsByName" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    v2 = Check v1 expectedType=object
    v3 = PropGet v2 key="size"
    Return v3
# CHECK: v2: anything ~ object = Expect v1 expectedType=object
# CHECK-NOT: = TypeTest
# CHECK-NOT: frequency=
# CHECK: Return v3
# CHECK-NEXT: }
}

function f3 name="readsALayout" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=L0
    v2 = PropGet v1 key="size"
    v3 = Add v2, v2
    Return v3
# CHECK: = TypeTest v0 testedType=L0
# CHECK: ) frequency=Unlikely:
}
