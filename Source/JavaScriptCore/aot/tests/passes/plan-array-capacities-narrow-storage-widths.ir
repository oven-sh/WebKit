# A local array of small integers gets the narrowest typed array that holds every value stored in it
# TODO: nobody: a local `new Array(n).fill(0)` with one store and one read is no longer given narrow storage
# FORM: Prepared
# RUN: pass PlanArrayCapacities
# STATISTIC: ArraysNarrowed = 4

module m0 path="main.js" displayPath="main.js"
function f0 name="int8" parameters=[{type=int[1, 1000]}, {type=int[-128, 127]}] results=[{type=anything}] {
  b0(v0: int[1, 1000], v1: int[-128, 127]):
    v2 = CallBuiltin -, v0 overload=Array/2
    v3 = Integer integer=0
    v4 = CallBuiltin v2, v3 overload=ArrayPrototypeFill/0
    PutArrayElement v2, v3, v1, v2 level=Proven [keyIsIntegral]
    v6 = GetArrayElement v2, v3, v2 level=Proven [keyIsIntegral]
    Return v6
}
# CHECK-LABEL: function f0 name="int8"
# CHECK: v2: Int8Array = CallBuiltin -, v0 overload=Int8Array/
# CHECK: PutTypedArrayElement v2, v3, v1 typedArrayType=1
# CHECK-NEXT: v6: {{*}} = GetTypedArrayElement v2, v3 typedArrayType=1

function f1 name="uint16" parameters=[{type=int[1, 1000]}, {type=int[0, 256]}] results=[{type=anything}] {
  b0(v0: int[1, 1000], v1: int[0, 256]):
    v2 = CallBuiltin -, v0 overload=Array/2
    v3 = Integer integer=0
    v4 = CallBuiltin v2, v3 overload=ArrayPrototypeFill/0
    PutArrayElement v2, v3, v1, v2 level=Proven [keyIsIntegral]
    v6 = GetArrayElement v2, v3, v2 level=Proven [keyIsIntegral]
    Return v6
}
# CHECK-LABEL: function f1 name="uint16"
# CHECK: v2: Uint16Array = CallBuiltin -, v0 overload=Uint16Array/
# CHECK: PutTypedArrayElement v2, v3, v1 typedArrayType=5
# CHECK-NEXT: v6: {{*}} = GetTypedArrayElement v2, v3 typedArrayType=5

function f2 name="int16" parameters=[{type=int[1, 1000]}, {type=int[-129, 127]}] results=[{type=anything}] {
  b0(v0: int[1, 1000], v1: int[-129, 127]):
    v2 = CallBuiltin -, v0 overload=Array/2
    v3 = Integer integer=0
    v4 = CallBuiltin v2, v3 overload=ArrayPrototypeFill/0
    PutArrayElement v2, v3, v1, v2 level=Proven [keyIsIntegral]
    v6 = GetArrayElement v2, v3, v2 level=Proven [keyIsIntegral]
    Return v6
}
# CHECK-LABEL: function f2 name="int16"
# CHECK: v2: Int16Array = CallBuiltin -, v0 overload=Int16Array/
# CHECK: PutTypedArrayElement v2, v3, v1 typedArrayType=4
# CHECK-NEXT: v6: {{*}} = GetTypedArrayElement v2, v3 typedArrayType=4

function f3 name="int32" parameters=[{type=int[1, 1000]}, {type=i32}] results=[{type=anything}] {
  b0(v0: int[1, 1000], v1: i32):
    v2 = CallBuiltin -, v0 overload=Array/2
    v3 = Integer integer=0
    v4 = CallBuiltin v2, v3 overload=ArrayPrototypeFill/0
    PutArrayElement v2, v3, v1, v2 level=Proven [keyIsIntegral]
    v6 = GetArrayElement v2, v3, v2 level=Proven [keyIsIntegral]
    Return v6
}
# CHECK-LABEL: function f3 name="int32"
# CHECK: v2: Int32Array = CallBuiltin -, v0 overload=Int32Array/
# CHECK: PutTypedArrayElement v2, v3, v1 typedArrayType=6
# CHECK-NEXT: v6: {{*}} = GetTypedArrayElement v2, v3 typedArrayType=6

function f4 name="widerThanInt32" parameters=[{type=int[1, 1000]}, {type=int[0, 4294967295]}] results=[{type=anything}] {
  b0(v0: int[1, 1000], v1: int[0, 4294967295]):
    v2 = CallBuiltin -, v0 overload=Array/2
    v3 = Integer integer=0
    v4 = CallBuiltin v2, v3 overload=ArrayPrototypeFill/0
    PutArrayElement v2, v3, v1, v2 level=Proven [keyIsIntegral]
    v6 = GetArrayElement v2, v3, v2 level=Proven [keyIsIntegral]
    Return v6
}
# CHECK-LABEL: function f4 name="widerThanInt32"
# CHECK: overload=Array/2
# CHECK-NOT: TypedArrayElement
