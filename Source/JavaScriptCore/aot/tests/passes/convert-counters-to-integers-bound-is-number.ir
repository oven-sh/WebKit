function f3 name="decreasingTowardNumber" parameters=[{type=int[0, 100]}, {type=number}] results=[{type=undefined}] {
  b0(v0: int[0, 100], v1: number):
    v2 = Integer integer=1
    Jump -> next b1(v0)
  b1(v3):
    LoopHint
    v5 = Greater v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Sub v3, v2
    Jump -> next b1(v6)
  b3():
    Return
}
