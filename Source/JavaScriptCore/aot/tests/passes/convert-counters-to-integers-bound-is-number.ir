function f2 name="boundIsQuotient" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    v2 = Integer integer=1
    v3 = Integer integer=2
    v4 = Div v0, v3
    Jump -> next b1(v1)
  b1(v5):
    LoopHint
    v7 = Less v5, v4
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v5, v2
    Jump -> next b1(v8)
  b3():
    Return
}
