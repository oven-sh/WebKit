# A bound that may be infinite or have a fraction bounds no integer range, so the counter stays a number
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 0
# STATISTIC: ConvertCountersToIntegersChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="boundIsNumber" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Return
}
