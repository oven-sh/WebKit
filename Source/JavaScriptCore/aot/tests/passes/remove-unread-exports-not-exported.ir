# A namespace object shows only exports: in a module whose namespace object is read by an unknown key, a variable that is no export and is never read still loses its store
# FORM: AsRead
# RUN: pipeline RemoveUnreadExports
# OPTIONS: only-passes=RemoveUnreadExports
# STATISTIC: UnreadVariableStoresRemoved = 1
# CHECK: variable g0 name="exported"{{*}}stores=AtMostOnce
# CHECK: variable g1 name="local"{{*}}writers=AllKnown stores=Never{{*}}reads=NeverRead

module m0 path="/main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/by-key.ts" displayPath="by-key.ts" body=f1 exports=[{name="exported" variable=g0}]
entry module=m0
variable g0 name="exported" module=m1 declared={type=anything}
variable g1 name="local" module=m1 declared={type=anything}

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = ModuleNamespace module=m1
    v3 = ElemGet v2, v1
    v4 = PropGet v0 key="print" [isFreeName]
    v5 = Call v4, -, v3
    Return
}

function f1 name="readByUnknownKey" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    Return
# CHECK: PutModuleVariable v0 variable=g0
# CHECK-NOT: variable=g1
}
