# A read of a number whose location holds another known value at the end of each predecessor becomes a block parameter
# FORM: Prepared
# RUN: pass EliminateRedundantReads
# STATISTIC: EliminateRedundantReadsChanges = 5
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="n" module=m0 declared={type=undefined|number} initialization=Undefined
layout L0 name="Counter" fields=[{key="count" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[DeleteField, RedefineProperty, ChangeIntegrity]}

function f0 name="storeInEachArm" parameters=[{type=number}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: number, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v0 variable=g0
    Jump -> next b3()
  b2():
    PutModuleVariable v1 variable=g0
    Jump -> next b3()
  b3():
    v5 = GetModuleVariable variable=g0
    Return v5
}
# CHECK-LABEL: function f0 name="storeInEachArm"
# CHECK: Jump -> next b3(v0)
# CHECK: Jump -> next b3(v1)
# CHECK: b3([[merged0]]: number):
# CHECK-NEXT: v5: number = Upcast [[merged0]]
# CHECK-NOT: GetModuleVariable

function f1 name="readInOneArmStoreInTheOther" parameters=[{type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: number, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = GetModuleVariable variable=g0
    Jump -> next b3()
  b2():
    PutModuleVariable v0 variable=g0
    Jump -> next b3()
  b3():
    v4 = GetModuleVariable variable=g0
    Return v4
}
# CHECK-LABEL: function f1 name="readInOneArmStoreInTheOther"
# CHECK: Jump -> next b3(v2)
# CHECK: Jump -> next b3(v0)
# CHECK: b3([[merged1]]: undefined|number):
# CHECK-NEXT: v4: undefined|number = Upcast [[merged1]]

