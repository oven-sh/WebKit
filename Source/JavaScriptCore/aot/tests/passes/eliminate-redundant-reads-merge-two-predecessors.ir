# CHECK: b2([[merged2]]: number):
# CHECK-NEXT: v5: number = Upcast [[merged2]]

function f3 name="slotStoreInEachArm" parameters=[{type=L0}, {type=number}, {type=number}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0, v1: number, v2: number, v3: boolean):
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    PutSlot v0, -, v1 key="count" receivers=[L0] level=Proven
    Jump -> next b3()
  b2():
    PutSlot v0, -, v2 key="count" receivers=[L0] level=Proven
    Jump -> next b3()
  b3():
    v6 = GetSlot v0 key="count" receivers=[L0] level=Proven
