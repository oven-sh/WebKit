# CHECK: ([[iterator]]: ArrayIterator):
# CHECK-NEXT: = PropGet [[iterator]] key="toString"
function f8 name="class-without-an-instance-test-beside-another-object" parameters=[{type=string|Array<number>|ArrayIterator}] results=[{type=anything}] {
