# An entrypoint has the budget of any caller. A body over it stays a function of its own and the entrypoint calls it, also where nothing else is seen to enter the body:
# a call that tests for the function, a call of a method by its name or a version of the caller may come to name it while its caller is optimized, and then a body that the entrypoint had taken in would be there twice
# FORM: AsRead
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot only-passes=EstimateHeat,SummarizeForInlining,InlineCalls
# RUN: pipeline InlineCalls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    v5 = PropGet v0 key="input" [isFreeName]
    v6 = Call v3, -, v5
    Return
}
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call {{*}}callees=[f2]

function f1 name="enteredByUnknownCodeAlone" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = ToNumber v0
# REPEAT: i = 1..20
    v%(i+1) = Mul v%(i), v1
# END REPEAT
    v22 = CallDirect v21 function=f3
    Return v22
}

function f2 name="alsoCalledByValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = ToNumber v0
# REPEAT: i = 1..20
    v%(i+1) = Mul v%(i), v1
# END REPEAT
    v22 = CallDirect v21 function=f3
    Return v22
}

function f3 name="thirteenOperations" parameters=[{type=number}] results=[{type=number}] {
# REPEAT: i = 0..12
    v%(i+1) = Mul v%(i), v0
# END REPEAT
    Return v13
}
# CHECK-LABEL: name="enteredByUnknownCodeAlone" module=m0 role=GenericEntrypoint
# CHECK-NOT: = Mul
# CHECK: = CallDirect {{*}}function=f1
# CHECK-LABEL: name="alsoCalledByValue" module=m0 role=GenericEntrypoint
# CHECK-NOT: = Mul
# CHECK: = CallDirect {{*}}function=f2
