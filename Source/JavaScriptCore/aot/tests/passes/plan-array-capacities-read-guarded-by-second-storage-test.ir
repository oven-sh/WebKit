# The read takes its storage proof from the second storage test, which the copy for Double storage would keep as Contiguous, so no copy is made
# FORM: Prepared
# RUN: pass PlanArrayCapacities

module m0 path="main.js" displayPath="main.js"

function f0 name="incrementAll" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2: int[0, 4294967295]):
    LoopHint
    v4 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b8()
  b2(v6):
    v7 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v7 -> taken b3(| 0), notTaken b7()
  b3(v8):
    v9 = IsElementPresent v0, v6, v8 arrayStorage=Contiguous [keyIsIntegral]
    Branch v9 -> taken b4(| 0), notTaken b7()
  b4(v10):
    v11 = HasArrayStorage v0 arrayStorage=Contiguous [isWritable]
    Branch v11 -> taken b5(| 0), notTaken b7()
  b5(v12):
    v13 = AllGuards v12, v10
    v14 = GetArrayElement v0, v6, v13 arrayStorage=Contiguous level=Expected [keyIsIntegral, isPresent]
    v15 = TypeTest v14 testedType=number
    Branch v15 -> taken b6(| 0), notTaken b7()
  b6(v16):
    v17 = Increment v16
    PutArrayElement v0, v6, v17, v12 arrayStorage=Contiguous mode=Strict level=Expected [keyIsIntegral]
    v19 = Increment v6
    Jump -> next b1(v19)
  b7() frequency=Rare:
    v20 = ElemGet v0, v6 [keyIsIntegral]
    Return v20
  b8():
    Return v2
# CHECK-NOT: arrayStorage=Double
}
