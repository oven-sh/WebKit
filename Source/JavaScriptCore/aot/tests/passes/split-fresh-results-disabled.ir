# The pass is turned off: a function that returns a fresh aggregate stays whole
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot disable=pass:SplitFreshResults
# RUN: pass SplitFreshResults VerifyProgram
# STATISTIC: FreshResultsSplit = 0
# STATISTIC: ResultsReturnedInRegisters = 0
# CHECK: outcome: Unchanged
# CHECK-NOT: role=ResultWrapper
# CHECK: = NewArray v0, v1 contents=number
# CHECK: = CallDirect v0 function=f0

module m0 path="main.js" displayPath="main.js"
function f0 name="pairArray" parameters=[{type=number}] results=[{type=Array<number>}] {
    v1 = Add v0, v0
    v2 = NewArray v0, v1 contents=number
    Return v2
}
function f1 name="readsPair" parameters=[{type=number}] results=[{type=anything}] {
    v1 = CallDirect v0 function=f0
    v2 = Integer integer=1
    v3 = ElemGet v1, v2
    Return v3
}
