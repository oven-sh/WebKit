# `map.set(key, value)` right behind the same call stores what is there: it goes, and its result is the first one's
# FORM: Prepared
# RUN: pass EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
variable g0 name="shared" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Named" fields=[{key="name" declared={type=string} flags=[IsRequired] flow={location={initialization=SetAtCreation} occupancy=AlwaysFilled prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="sameCallTwice" parameters=[{type=Map<anything, anything>}, {type=L0}] results=[{type=anything}] {
    v2 = GetSlot v1 key="name" receivers=[L0] level=Proven
    v3 = CallBuiltin v0, v2, v1 overload=MapPrototypeSet/0
    v4 = GetSlot v1 key="name" receivers=[L0] level=Proven
    v5 = CallBuiltin v0, v4, v1 overload=MapPrototypeSet/0
    Return v5
# CHECK: v3:{{*}}= CallBuiltin v0, v2, v1 overload=MapPrototypeSet/0
# CHECK-NOT: CallBuiltin
# CHECK: Return v3
}

function f1 name="anotherValue" parameters=[{type=Map<anything, anything>}, {type=string}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v4 = CallBuiltin v0, v1, v2 overload=MapPrototypeSet/0
    v5 = CallBuiltin v0, v1, v3 overload=MapPrototypeSet/0
    Return v5
# CHECK: = CallBuiltin v0, v1, v2 overload=MapPrototypeSet/0
# CHECK-NEXT: = CallBuiltin v0, v1, v3 overload=MapPrototypeSet/0
}

function f2 name="anotherMapOrKey" parameters=[{type=Map<anything, anything>}, {type=Map<anything, anything>}, {type=string}, {type=string}] results=[{type=anything}] {
    v4 = CallBuiltin v0, v2, v2 overload=MapPrototypeSet/0
    v5 = CallBuiltin v1, v2, v2 overload=MapPrototypeSet/0
    v6 = CallBuiltin v1, v3, v2 overload=MapPrototypeSet/0
    Return v6
# CHECK: = CallBuiltin v0, v2, v2 overload=MapPrototypeSet/0
# CHECK-NEXT: = CallBuiltin v1, v2, v2 overload=MapPrototypeSet/0
# CHECK-NEXT: = CallBuiltin v1, v3, v2 overload=MapPrototypeSet/0
}

function f3 name="deletedBetween" parameters=[{type=Map<anything, anything>}, {type=string}] results=[{type=anything}] {
    v2 = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
    v3 = CallBuiltin v0, v1 overload=MapPrototypeDelete/0
    v4 = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
    Return v4
# CHECK: = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
# CHECK-NEXT: = CallBuiltin v0, v1 overload=MapPrototypeDelete/0
# CHECK-NEXT: = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
}

function f4 name="unknownCodeBetween" parameters=[{type=Map<anything, anything>}, {type=string}, {type=anything}] results=[{type=anything}] {
    v3 = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
    v4 = Call v2, -
    v5 = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
    Return v5
# CHECK: = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
# CHECK-NEXT: = Call v2
# CHECK-NEXT: = CallBuiltin v0, v1, v1 overload=MapPrototypeSet/0
}
