    Return v0
}
function f4 name="fourth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
function f5 name="fifth" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Return v0
}
