# A list that a counted loop pushes to once in every turn is told its length, the counter and the bound
# FORM: Prepared
# RUN: pass PlanArrayCapacities

module m0 path="main.js" displayPath="main.js"
function f0 name="pushedOnceInEveryTurn" parameters=[{type=int[0, 1000000]}, {type=anything}] results=[{type=Array<anything>}] {
    v2 = NewArray contents=anything
    v3 = Integer integer=0
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v0
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = CallBuiltin v2, v1 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v9 = Integer integer=1
    v10 = Add v7, v9
    Jump -> next b1(v10)
  b3():
    Return v2
# CHECK: = NewArray {{*}}capacity={{*}} [isFilledToCapacity]
# CHECK: AppendElement v2, v1, v4, v4, v0
}

function f1 name="eitherArmPushes" parameters=[{type=int[0, 1000000]}, {type=anything}, {type=boolean}] results=[{type=Array<anything>}] {
    v3 = NewArray contents=anything
    v4 = Integer integer=0
    Jump -> next b1(v4)
  b1(v5):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b2(| 0), notTaken b6()
  b2(v8):
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v9 = CallBuiltin v3, v1 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    Jump -> next b5()
  b4():
    v10 = CallBuiltin v3, v2 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    Jump -> next b5()
  b5():
    v11 = Integer integer=1
    v12 = Add v8, v11
    Jump -> next b1(v12)
  b6():
    Return v3
# CHECK-NOT: isFilledToCapacity
# CHECK-NOT: AppendElement
# CHECK-COUNT-2: = CallBuiltin v3,
}

