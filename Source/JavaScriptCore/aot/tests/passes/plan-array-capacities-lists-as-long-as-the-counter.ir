function f5 name="eitherOfTwoLists" parameters=[{type=int[0, 1000000]}, {type=anything}, {type=boolean}] results=[{type=Array<anything>}] {
    v3 = NewArray contents=anything
    v4 = NewArray contents=anything
    v5 = Integer integer=0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v5, v3)
  b2():
    Jump -> next b3(v5, v4)
  b3(v6, v7):
    LoopHint
    v9 = Less v6, v0
    Branch v9 -> taken b4(| 0), notTaken b5()
  b4(v10):
    v11 = CallBuiltin v7, v1 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    v12 = Integer integer=1
    v13 = Add v10, v12
    Jump -> next b3(v13, v7)
  b5():
    v14 = NewArray v3, v4 contents=anything
    Return v14
# CHECK-NOT: isFilledToCapacity
# CHECK-NOT: AppendElement
}

