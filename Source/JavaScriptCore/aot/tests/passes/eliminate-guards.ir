# A test whose condition holds on every path to it is folded to its passed edge, and its users get the guard that holds there
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 10

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Size" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L2 kind=Instance name="Widget" constructor=f0 flow={baseState=None}
function f0 name="Widget" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]

function f1 name="underPassedTest" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b4()
  b1(v2):
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Return v5
  b3():
    Return v0
  b4():
    Return v0
}
# CHECK-LABEL: function f1 name="underPassedTest"
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b4()
# CHECK-NEXT: b1(v2: guard):
# CHECK-NEXT: Jump -> next b2(v2)
# CHECK-NEXT: b2(v4: guard):
# CHECK-NEXT: v5: number = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: Return v5
# CHECK-NEXT: b3():
# CHECK-NEXT: Unreachable

function f2 name="chain" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(), notTaken b6()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b2(), notTaken b5()
  b2():
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4):
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Return v5
  b4():
    Return v0
  b5():
    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f2 name="chain"
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b6()
# CHECK-NEXT: b1([[first2]]: guard):
# CHECK-NEXT: Jump -> next b2()
# CHECK-NEXT: b2():
# CHECK-NEXT: Jump -> next b3([[first2]])
# CHECK-NEXT: b3(v4: guard):
# CHECK-NOT: ShapeTest

function f3 name="throughUpcast" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = Upcast v0 castType=anything
    v4 = ShapeTest v3 layouts=[L0]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = GetSlot v0, v5 key="x" receivers=[L0] level=Predicted
    Return v6
  b3():
    Return v0
}
# CHECK-LABEL: function f3 name="throughUpcast"
# CHECK: b1(v2: guard):
# CHECK-NOT: ShapeTest
# CHECK: Jump -> next b2(v2)

function f4 name="memberUnchanged" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = IsMemberUnchanged layout=L2 key="draw"
    Branch v1 -> taken b1(), notTaken b3()
  b1():
    v2 = IsMemberUnchanged layout=L2 key="draw"
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3():
    Return v0
}
# CHECK-LABEL: function f4 name="memberUnchanged"
# CHECK: v1: boolean = IsMemberUnchanged layout=L2 key="draw"
# CHECK-NOT: IsMemberUnchanged
# CHECK: Jump -> next b2()

function f5 name="onBothArms" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b3(| 0), notTaken b7()
  b2():
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b4(| 0), notTaken b7()
  b3(v4):
    Jump -> next b5()
  b4(v5):
    Jump -> next b5()
  b5():
    v6 = ShapeTest v0 layouts=[L0]
    Branch v6 -> taken b6(| 0), notTaken b7()
  b6(v7):
    v8 = GetSlot v0, v7 key="x" receivers=[L0] level=Predicted
    Return v8
  b7():
    Return v0
}
# CHECK-LABEL: function f5 name="onBothArms"
# CHECK: b3(v4: guard):
# CHECK-NEXT: Jump -> next b5(v4)
# CHECK-NEXT: b4(v5: guard):
# CHECK-NEXT: Jump -> next b5(v5)
# CHECK-NEXT: b5([[joined5]]: guard):
# CHECK-NEXT: Jump -> next b6([[joined5]])
# CHECK-NEXT: b6(v7: guard):
# CHECK-NEXT: v8: number = GetSlot v0, v7 key="x" receivers=[L0] level=Predicted

function f6 name="underSwitchCase" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    SwitchOnShape v0 layoutSets=[[L0], [L1]] -> case b1(| 0), case b2(| 0), otherwise b5()
  b1(v1):
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b3(| 0), notTaken b4()
  b2(v3):
    Return v0
  b3(v4):
    v5 = GetSlot v0, v4 key="x" receivers=[L0] level=Predicted
    Return v5
  b4():
    Return v0
  b5():
    Return v0
}
# CHECK-LABEL: function f6 name="underSwitchCase"
# CHECK: b1(v1: guard):
# CHECK-NEXT: Jump -> next b3(v1)
# CHECK-NOT: ShapeTest

function f7 name="repeatedEpochTest" parameters=[{type=object}, {type=function}] results=[{type=anything}] {
  b0(v0: object, v1: function):
    v2 = GetShapeEpoch
    v3 = ShapeTest v0 layouts=[L0]
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4):
    v5 = Call v1
    v6 = IsShapeEpochCurrent v2, v4
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7):
    v8 = GetSlot v0, v7 key="x" receivers=[L0] level=Predicted
    v9 = IsShapeEpochCurrent v2, v7
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10):
    v11 = GetSlot v0, v10 key="y" receivers=[L0] level=Predicted
    Return v11
  b4():
    Return v0
}
# CHECK-LABEL: function f7 name="repeatedEpochTest"
# CHECK: v6: boolean = IsShapeEpochCurrent v2, v4
# CHECK-NEXT: Branch v6 -> taken b2(| 0), notTaken b4()
# CHECK-NEXT: b2(v7: guard):
# CHECK-NEXT: v8: number = GetSlot v0, v7 key="x" receivers=[L0] level=Predicted
# CHECK-NEXT: Jump -> next b3(v7)
# CHECK-NOT: IsShapeEpochCurrent

