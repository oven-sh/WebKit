# A callee that calls two parameters gets a copy for the first function. The next run makes a copy of that copy for the second, and the run after that changes nothing
# FORM: Prepared
# OPTIONS: heat=OnlyLoopsAreHot limit=MaxInlinedCallerBytes:1
# RUN: pass InlineCalls InlineCalls InlineCalls
# STATISTIC: CalleeVersions = 2
# CHECK: outcome: Changed
# CHECK: outcome: Changed
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="double" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
    v1 = Add v0, v0
    Return v1
}
function f1 name="negate" kind=Arrow parameters=[{type=number}] results=[{type=number}] {
    v1 = Negate v0
    Return v1
}
function f2 name="applyBoth" parameters=[{type=function}, {type=function}, {type=anything}] results=[{type=anything}] {
    v3 = Call v0, -, v2
    v4 = Call v1, -, v3
    v5 = Add v4, v2
    v6 = Add v5, v2
    v7 = Add v6, v2
    v8 = Add v7, v2
    v9 = Add v8, v2
    v10 = Add v9, v2
    Return v10
}

function f3 name="passesTwoKnownFunctions" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClosure function=f0
    v2 = NewClosure function=f1
    v3 = CallDirect v1, v2, v0 function=f2
    v4 = CallDirect v1, v2, v0 function=f2
    Return v4
# CHECK: = CallDirect v1, v2, v0 function=[[forBoth]]
# CHECK-NEXT: = CallDirect v1, v2, v0 function=[[forBoth]]
# CHECK: function [[forDouble]] name="applyBoth" {{*}}role=CalleeVersion {{*}}parameters=[{type=f0}, {type=function}, {type=anything}] {{*}}derivation={source=f2 {{*}}creator=Version{provenVersion=f2}
# CHECK: function [[forBoth]] name="applyBoth" {{*}}role=CalleeVersion {{*}}parameters=[{type=f0}, {type=f1}, {type=anything}] {{*}}derivation={source=[[forDouble]] parameter=1 node=1 {{*}}creator=Version{provenVersion=[[forDouble]]}
# CHECK-NEXT: b0(v0: f0, v1: f1, v2: anything):
# CHECK-NOT: role=CalleeVersion
}
