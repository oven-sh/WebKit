# A loop whose bound is the counter of another loop is converted in the round after that counter became an integer
# FORM: Prepared
# RUN: pass ConvertCountersToIntegers
# STATISTIC: CountersConverted = 7
# STATISTIC: ConvertCountersToIntegersChanges = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="innerBoundIsOuterCounter" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b6()
  b2():
    Jump -> next b3(v1)
  b3(v6):
    LoopHint
    v8 = LessEq v6, v3
    Branch v8 -> taken b4(), notTaken b5()
  b4():
    v9 = Add v6, v2
    Jump -> next b3(v9)
  b5():
    v10 = Add v3, v2
    Jump -> next b1(v10)
  b6():
    Return
}
# CHECK-LABEL: function f0 name="innerBoundIsOuterCounter"
# CHECK: b1(v3: int[0, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b6()
# CHECK-NEXT: b2([[outer0]]: int[0, 99]):
# CHECK: b3(v6: int[0, 100]):
# CHECK: v8: boolean = LessEq v6, [[outer0]]
# CHECK-NEXT: Branch v8 -> taken b4(| 0), notTaken b5()
# CHECK-NEXT: b4([[inner0]]: int[0, 99]):
# CHECK-NEXT: v9: int[1, 100] = Add [[inner0]], v2
# CHECK: v10: int[1, 100] = Add [[outer0]], v2

function f1 name="threeLoops" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    v2 = Integer integer=1
# REPEAT: i = 0..2
    Jump -> next b%(i*2+1)(v1)
  b%(i*2+1)(v%(i*3+3)):
    LoopHint
    v%(i*3+5) = Less v%(i*3+3), v%(i*3)
    Branch v%(i*3+5) -> taken b%(i*2+2)(), notTaken b%(i*-1+9)()
  b%(i*2+2)():
# END REPEAT
    v12 = Add v9, v2
    Jump -> next b5(v12)
  b7():
    v13 = Add v6, v2
    Jump -> next b3(v13)
  b8():
    v14 = Add v3, v2
    Jump -> next b1(v14)
  b9():
    Return
}
# CHECK-LABEL: function f1 name="threeLoops"
# CHECK: b1(v3: int[0, 100]):
# CHECK: b2([[outer1]]: int[0, 99]):
# CHECK: b3(v6: int[0, 99]):
# CHECK: Less v6, [[outer1]]
# CHECK-NEXT: Branch v8 -> taken b4(| 0), notTaken b8()
# CHECK-NEXT: b4([[middle1]]: int[0, 98]):
# CHECK: b5(v9: int[0, 98]):
# CHECK: Less v9, [[middle1]]
# CHECK-NEXT: Branch v11 -> taken b6(| 0), notTaken b7()
# CHECK-NEXT: b6([[inner1]]: int[0, 97]):
# CHECK-NEXT: v12: int[1, 98] = Add [[inner1]], v2
# CHECK: v13: int[1, 99] = Add [[middle1]], v2
# CHECK: v14: int[1, 100] = Add [[outer1]], v2

function f2 name="counterBoundsTheLoopBehind" parameters=[{type=int[0, 100]}] results=[{type=undefined}] {
  b0(v0: int[0, 100]):
    v1 = Integer integer=0
    v2 = Integer integer=1
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Less v3, v0
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v2
    Jump -> next b1(v6)
  b3():
    Jump -> next b4(v1)
  b4(v7):
    LoopHint
    v9 = Less v7, v3
    Branch v9 -> taken b5(), notTaken b6()
  b5():
    v10 = Add v7, v2
    Jump -> next b4(v10)
  b6():
    Return
}
# CHECK-LABEL: function f2 name="counterBoundsTheLoopBehind"
# CHECK: b1(v3: int[0, 100]):
# CHECK: Branch v5 -> taken b2(| 0), notTaken b3()
# CHECK: b4(v7: int[0, 100]):
# CHECK: v9: boolean = Less v7, v3
# CHECK-NEXT: Branch v9 -> taken b5(| 0), notTaken b6()
# CHECK-NEXT: b5([[behind2]]: int[0, 99]):
# CHECK-NEXT: v10: int[1, 100] = Add [[behind2]], v2

