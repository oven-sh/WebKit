# Guards of an object that is sunk: tests of a virtual object fold, a kept access names a guard of the cell that was built
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 5
# STATISTIC: AllocationsSunk = 7

module m0 path="main.js" displayPath="main.js"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Point" fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]

function f0 name="guardIsTheAllocation" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v2 variable=g0
    v4 = GetSlot v2, v2 key="x" receivers=[L0] level=Proven
    Return v4
  b2():
    Return v0
}
# CHECK-LABEL: function f0 name="guardIsTheAllocation"
# CHECK: b0(
# CHECK-NEXT: Branch
# CHECK: b1():
# CHECK-NEXT: [[cell0]]:{{*}}= NewObject -, v0, v0
# CHECK-NEXT: [[guard0]]: guard = AllGuards [[cell0]]
# CHECK-NEXT: PutModuleVariable [[cell0]] variable=g0
# CHECK-NEXT: = GetSlot [[cell0]], [[guard0]] key="x"

function f1 name="twoBuildsMeet" parameters=[{type=anything}, {type=int[0, 2]}] results=[{type=anything}] {
  b0(v0: anything, v1: int[0, 2]):
    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    Switch v1 cases=[0, 1] -> case b1(), case b2(), otherwise b4()
  b1():
    PutModuleVariable v2 variable=g0
    Jump -> next b3()
  b2():
    PutModuleVariable v2 variable=g0
    Jump -> next b3()
  b3():
    v5 = GetSlot v2, v2 key="x" receivers=[L0] level=Proven
    Return v5
  b4():
    Return v0
}
