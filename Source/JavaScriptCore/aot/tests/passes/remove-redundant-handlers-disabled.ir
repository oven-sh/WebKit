# With the pass disabled a block that cannot throw keeps its handler
# FORM: Prepared
# OPTIONS: disable=pass:RemoveRedundantHandlers
# RUN: pass RemoveRedundantHandlers
# STATISTIC: RemoveRedundantHandlersChanges = 0
# CHECK: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"
function f0 name="pureValues" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number) handler=b2():
    v1 = Add v0, v0
    Jump -> next b1()
  b1():
    Return v0
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
