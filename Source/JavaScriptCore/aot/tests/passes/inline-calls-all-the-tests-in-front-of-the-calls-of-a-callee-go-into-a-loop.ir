    v44 = PropGet v43 key="y"
    v45 = PropGet v44 key="z"
    v46 = PropGet v45 key="a"
    v47 = PropGet v46 key="b"
    v48 = PropGet v47 key="c"
    v49 = PropGet v48 key="d"
    v50 = PropGet v49 key="e"
    v51 = PropGet v50 key="f"
    v52 = PropGet v51 key="g"
    v53 = PropGet v52 key="h"
