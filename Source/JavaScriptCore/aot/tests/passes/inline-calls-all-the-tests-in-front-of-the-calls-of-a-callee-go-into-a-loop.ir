# `while (isWordCharacter(text.charCodeAt(at))) at++`: the callee sorts a number into six ranges and leaves what is left to calls, so it is too large to be copied whole.
# A loop of the caller pays for the call at every turn: there all that only reads, tests and returns is copied, as far as the budget of the place goes. Elsewhere the first 48 bytes, as ever.
# A rope that the copy makes flat is flat when the callee reads it again, so a read of a code unit is no trace either.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass InlineCalls
# LOSS: MaxInlineHeadBytes x1 f0

module m0 path="main.js" displayPath="main.js"
function f0 name="isWordCharacter" parameters=[{type=i32}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=48
    v3 = Less v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Integer integer=36
    v5 = StrictEq v0, v4
    Return v5
  b2():
    v6 = Integer integer=58
    v7 = Less v0, v6
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    v8 = Boolean boolean=true
    Return v8
  b4():
    v9 = Integer integer=65
    v10 = Less v0, v9
    Branch v10 -> taken b5(), notTaken b6()
  b5():
    v11 = Boolean
    Return v11
  b6():
    v12 = Integer integer=91
    v13 = Less v0, v12
    Branch v13 -> taken b3(), notTaken b7()
  b7():
    v14 = Integer integer=97
    v15 = Less v0, v14
    Branch v15 -> taken b8(), notTaken b9()
  b8():
    v16 = Integer integer=95
    v17 = StrictEq v0, v16
    Return v17
  b9():
    v18 = Integer integer=123
    v19 = Less v0, v18
    Branch v19 -> taken b3(), notTaken b10()
  b10():
    v20 = PropGet v1 key="a"
    v21 = PropGet v20 key="b"
    v22 = PropGet v21 key="c"
    v23 = PropGet v22 key="d"
    v24 = PropGet v23 key="e"
