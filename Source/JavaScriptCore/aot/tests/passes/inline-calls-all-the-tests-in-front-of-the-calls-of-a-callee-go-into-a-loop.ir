function f2 name="inALoop" parameters=[{type=i32}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1(v0)
  b1(v2):
    LoopHint
    v4 = CallDirect v2, v1 function=f0
    v5 = ToBoolean v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Integer integer=1
    v7 = BitOr v2, v6
    Jump -> next b1(v7)
  b3():
    Return v4
# CHECK-NOT: PropGet
# CHECK: frequency=Unlikely:
# CHECK-NEXT: = CallDirect {{*}} function=f0 [isAfterInlinedHead]
# CHECK-NOT: PropGet
# CHECK: integer=48
# CHECK: integer=58
# CHECK: integer=65
# CHECK: integer=91
# CHECK: integer=97
# CHECK: integer=123
# CHECK-NOT: PropGet
}

function f3 name="readsInALoop" parameters=[{type=string}, {type=i32}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = CallDirect v0, v3, v2 function=f1
    v6 = ToBoolean v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Integer integer=1
    v8 = BitOr v3, v7
    Jump -> next b1(v8)
  b3():
    Return v5
# CHECK: = CallDirect {{*}} function=f1 [isAfterInlinedHead]
# CHECK: GetStringCodeUnit
# CHECK-NOT: PropGet
}

function f4 name="outsideALoop" parameters=[{type=i32}, {type=anything}, {type=string}] results=[{type=anything}] {
    v3 = CallDirect v0, v1 function=f0
    v4 = CallDirect v2, v0, v1 function=f1
    v5 = Add v3, v4
    Return v5
# CHECK-NOT: integer=123
# CHECK-NOT: GetStringCodeUnit
}
