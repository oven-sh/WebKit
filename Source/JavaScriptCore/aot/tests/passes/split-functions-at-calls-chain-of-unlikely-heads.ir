# Each test of a chain leaves for its own place in one unlikely copy of the chain. A continuation holds its own step and goes on in the continuation of the next place, so the copy is written once and not once per place
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="chain" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b4(v0)
  b1():
    v3 = TypeTest v0 testedType=i32
    Branch v3 -> taken b2(), notTaken b5(v0)
  b2():
    v4 = TypeTest v0 testedType=int[0, 9]
    Branch v4 -> taken b3(), notTaken b6(v0)
  b3():
    Return v0
  b4(v5: anything) frequency=Unlikely:
    v6 = Call v1, -, v5
    Jump -> next b5(v6)
  b5(v7: anything) frequency=Unlikely:
    v8 = Call v1, -, v7
    Jump -> next b6(v8)
  b6(v9: anything) frequency=Unlikely:
    v10 = Call v1, -, v9
    Return v10
}
# CHECK-LABEL: function f0 name="chain"
# CHECK-NOT: = Call v
# CHECK-LABEL: function f1 name="chain" module=m0 role=Continuation
# CHECK: [[next1]]: anything = CallDirect {{*}}function=f2
# CHECK-NEXT: ReturnCall [[next1]]
# CHECK-COUNT-1: = Call v
# CHECK-LABEL: function f2 name="chain" module=m0 role=Continuation
# CHECK: [[next2]]: anything = CallDirect {{*}}function=f3
# CHECK-NEXT: ReturnCall [[next2]]
# CHECK-COUNT-1: = Call v
# CHECK-LABEL: function f3 name="chain" module=m0 role=Continuation
# CHECK-NOT: CallDirect
# CHECK-COUNT-1: = Call v
