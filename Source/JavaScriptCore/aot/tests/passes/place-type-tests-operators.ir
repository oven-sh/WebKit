# STATISTIC: StretchesGuarded = 26

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="mulOfExpectedNumbers" parameters=[{type=number flags=[IsExpected]}, {type=number flags=[IsExpected]}] results=[{type=number|bigint}] {
  b0(v0: anything ~ number, v1: anything ~ number):
    v2 = Mul v0, v1
    Return v2
}
