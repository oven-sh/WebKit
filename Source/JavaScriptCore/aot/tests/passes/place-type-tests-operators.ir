# CHECK: [[test0f0]]:{{*}}= TypeTest v0 testedType=number
# CHECK-NEXT: Branch [[test0f0]] -> taken [[passed0f0]](| 0), notTaken [[copy0]]()
# CHECK-NEXT: [[fast0]]([[narrowed1f0]]: number):
# CHECK-NEXT: v2: number = Mul [[narrowed0f0]], [[narrowed1f0]]
# CHECK-NEXT: Return v2
# CHECK-NEXT: [[copy0]]() frequency=Unlikely:
# CHECK-NEXT: [[generic0]]:{{*}}= Mul v0, v1
# CHECK-NEXT: Return [[generic0]]
# CHECK-NEXT: [[passed0f0]]([[narrowed0f0]]: number):
# CHECK-NEXT: [[test1f0]]:{{*}}= TypeTest v1 testedType=number
# CHECK-NEXT: Branch [[test1f0]] -> taken [[fast0]](| 0), notTaken [[copy0]]()
# CHECK: }

