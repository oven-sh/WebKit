# function age(date) { return date.getTime() }
# The name says that the parameter is a Date, and from the first run on its position says so.
# A second run finds the position as the first one left it: it changes nothing, and says so.
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass PlaceTypeTests PlaceTypeTests
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged
# CHECK: function f0 name="age"{{*}}parameters=[{type=Date flags=[IsExpected]}]
# CHECK-NEXT: b0(v0: anything ~ Date):

module m0 path="main.js" displayPath="main.js"
function f0 name="age" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="getTime"
    v2 = Call v1, v0
    Return v2
}
