    v3 = Integer integer=0
    Jump -> next b1(v0, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v2
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v1
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    v11 = Strcat v4, v1
    Return v11
}
# CHECK-LABEL: name="firstStateMayBeNumber"
# CHECK: [[h1]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: StringBuilderAppend [[h1]], v0
# CHECK: b1(v4: stringbuilder, v5: int|whole):

