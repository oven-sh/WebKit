# A block parameter that may hold undefined, null or a number is a state of a string in a builder where everything that happens to it converts it to a string
# FORM: Prepared
# RUN: pass CreateStringBuilders
# STATISTIC: StringBuildersCreated = 2
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="firstStateMayBeUndefined" parameters=[{type=undefined|string}, {type=string}, {type=number}] results=[{type=string}] {
  b0(v0: undefined|string, v1: string, v2: number):
    v3 = Integer integer=0
    Jump -> next b1(v0, v3)
  b1(v4, v5):
    LoopHint
    v7 = Less v5, v2
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Add v4, v1
    v9 = Integer integer=1
    v10 = Add v5, v9
    Jump -> next b1(v8, v10)
  b3():
    v11 = Add v4, v1
    Return v11
}
# CHECK-LABEL: name="firstStateMayBeUndefined"
# CHECK: [[h0]]: stringbuilder = StringBuilderBegin
# CHECK-NEXT: StringBuilderAppend [[h0]], v0
# CHECK-NEXT: Jump -> next b1([[h0]], v3)
# CHECK: b1(v4: stringbuilder, v5: int|whole):
# CHECK: StringBuilderAppend v4, v1
# CHECK: StringBuilderAppend v4, v1
# CHECK-NEXT: [[r0]]: string = StringBuilderFinish v4
# CHECK-NEXT: Return [[r0]]

function f1 name="firstStateMayBeNumber" parameters=[{type=null|number|string}, {type=string}, {type=number}] results=[{type=string}] {
