# A test that passes a guard has no effect of its own: it goes when nobody branches on it, and its guard goes when no access names it
# FORM: Prepared
# RUN: pass EliminateDeadCode
# STATISTIC: EliminateDeadCodeChanges = 6

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled}}, {key="y" declared={type=number}}]
layout L1 name="Size" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled}}]

function f0 name="testNobodyBranchesOn" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Return v0
# CHECK-NEXT: b0(
# CHECK-NEXT: Return v0
}

function f1 name="guardNobodyNames" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return v0
  b2():
    Return
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
}

function f2 name="guardOfUnusedRead" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v0, v2 key="x" receivers=[L0] level=Expected
    Return v0
  b2():
    Return
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
}

function f3 name="secondTestNobodyBranchesOn" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = IsSlotFilled v0, v2 key="y" receivers=[L0] level=Expected
    Return v0
  b2():
    Return
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
}

function f4 name="joinedGuardsNobodyNames" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = IsSlotFilled v0, v2 key="y" receivers=[L0] level=Expected
    Branch v3 -> taken b2(| 0), notTaken b3()
  b2(v4):
    v5 = AllGuards v2, v4
    Return v0
  b3():
    Return
# CHECK: Branch v1 -> taken b1(| 0), notTaken b3()
# CHECK-NEXT: b1(v2: guard):
# CHECK-NEXT: v3: boolean = IsSlotFilled v0, v2 key="y"
# CHECK-NEXT: Branch v3 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: Return v0
}

function f5 name="guardOfShapeCaseNobodyNames" parameters=[{type=object}] results=[{type=anything}] {
    SwitchOnShape v0 layoutSets=[[L0], [L1]] -> case b1(| 0), case b2(| 0), otherwise b3()
  b1(v1):
    Return v0
  b2(v2):
    v3 = GetSlot v0, v2 key="x" receivers=[L1] level=Expected
    Return v3
  b3():
    Return
# CHECK: SwitchOnShape v0 layoutSets={{*}} -> case b1(), case b2(| 0), otherwise b3()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v0
# CHECK-NEXT: b2(v2: guard):
# CHECK-NEXT: = GetSlot v0, v2 key="x"
}

function f6 name="guardOfUsedRead" parameters=[{type=object}] results=[{type=anything}] {
    v1 = ShapeTest v0 layouts=[L0]
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v0, v2 key="x" receivers=[L0] level=Expected
    Return v3
  b2():
    Return
# CHECK: v1: boolean = ShapeTest v0 layouts=[L0]
# CHECK-NEXT: Branch v1 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v2: guard):
# CHECK-NEXT: = GetSlot v0, v2 key="x"
}
