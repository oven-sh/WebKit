# An async iteration over a value of a class without an arm is the protocol alone: an unsplit function awaits with Await behind each call of next and return, a coroutine body by saving its frame.
# The open says whether it wrapped a sync iterator. The program never sees the wrapper, so its next is not called: it is stepped with StepAsyncGenerator, which suspends the function by itself
# FORM: Prepared optimizing
# RUN: pass ExpandIteration
# RUN(ABSENT): pass ExpandIteration
# RUN(LEFT): pass ExpandIteration
# STATISTIC: IterationsExpandedByClass = 1
# STATISTIC: IterationsExpandedGenerically = 3

module m0 path="main.js" displayPath="main.js"
layout L0 name="Bag" fields=[{key="x" declared={type=number}}]

function f0 name="forAwait" flags=[IsAsync] parameters=[{type=undefined|null|L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|L0, v1: anything):
    v2 = IteratorOpen v0 iteratorKind=Async
    Jump -> next b1()
  b1():
    LoopHint
    v4 = IteratorResume v2 iteratorKind=Async
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Branch v5 -> taken b7(), notTaken b2()
  b2():
    Jump -> next b3()
  b3() handler=b6():
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b4(), notTaken b1()
  b4():
    IteratorClose v2 iteratorKind=Async
    Jump -> next b5()
  b5():
    Return v7
  b6() role=IterationCleanup subject=v2:
    v10 = CatchException
    IteratorClose v2 iteratorKind=Async completion=Throw
    Rethrow v10
  b7():
    Return v1
}
