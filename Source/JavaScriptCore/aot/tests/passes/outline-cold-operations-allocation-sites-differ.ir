# Allocations of different allocation sites never share a body: what flow proves about an allocation class holds for the objects of its sites only
# FORM: Selected
# OPTIONS: check=VerifyEachPass heat=OnlyLoopsAreHot
# RUN: pass OutlineColdOperations
# STATISTIC: OutlinedBodiesCreated = 1
# STATISTIC: ColdSitesOutlined = 6
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="Failure" fields=[{key="cause" declared={type=anything}}, {key="detail" declared={type=anything}}]

function f0 name="allocationSitesDiffer" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 1..5
  b%(i)() frequency=Rare:
    v%(i+1) = NewObject -, v1, v1 layout=L0 fields=[0, 1] allocationSite=%(i)
    Return v%(i+1)
# END REPEAT
  b6() frequency=Rare:
    v7 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    Return v7
  b7():
    Return v1
}
# CHECK-LABEL: function f0
# CHECK-NOT: CallDirect
# CHECK-COUNT-6: = NewObject -, v1, v1 layout=L0
# CHECK-NOT: CallDirect

function f1 name="copiesOfOneAllocationSite" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    Switch v0 cases=[0, 1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), case b6(), otherwise b7()
# REPEAT: i = 2..7
  b%(i-1)() frequency=Rare:
    v%(i) = NewObject -, v1, v1 layout=L0 fields=[0, 1] allocationSite=6
    Return v%(i)
# END REPEAT
  b7():
    Return v1
}
# CHECK-LABEL: function f1
# CHECK-NOT: NewObject
# CHECK-COUNT-6: = CallDirect v1 function=f2
# CHECK-NOT: NewObject

# CHECK-LABEL: function f2 {{*}}role=OutlinedBody
# CHECK: [[object]]:{{*}}= NewObject -, v0, v0 layout=L0 fields=[0, 1] allocationSite=6
# CHECK-NEXT: Return [[object]]
