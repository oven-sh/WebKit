# In the tested copy a parameter receives one value alone, so there it is that value. Where the copies meet it is a join again, and a test of the join says nothing about the value that the tested copy passed to it.
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Point" constructor=f3 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="link" declared={type=anything} flags=[IsRequired]}] flow={baseState=None}

function f0 name="compare" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3: anything ~ L0 = Upcast v0 castType=anything
    v4: anything ~ L0 = Upcast v1 castType=anything
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = PropGet v3 key="x"
    Jump -> next b3(v3)
  b2() frequency=Rare:
    Jump -> next b3(v4)
  b3(v6: anything ~ L0):
    v7 = PropGet v3 key="x"
    v8 = CallDirect v6 function=f2
    v9 = StrictEq v6, v3
    v10 = Add v8, v9
    Return v10
# CHECK: = StrictEq {{*}}, v3
# CHECK: = StrictEq {{*}}, v3
}

function f1 name="store" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
    v3: anything ~ L0 = Upcast v0 castType=anything
    v4: anything ~ L0 = Upcast v1 castType=anything
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = PropGet v3 key="x"
    Jump -> next b3(v3)
  b2() frequency=Rare:
    Jump -> next b3(v4)
  b3(v6: anything ~ L0):
    v7 = PropGet v3 key="x"
    v8 = CallDirect v6 function=f2
    PropSet v6, v3 key="link"
    Return v8
# CHECK: PutSlotOrAdd {{*}}, {{*}}, v3 key="link"
}

function f2 name="show" parameters=[{type=anything}] results=[{type=anything}]
function f3 name="Point" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
