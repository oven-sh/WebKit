# Nothing above the layout has the name, and flow has seen the read find something: an object that was handed another prototype finds it there.
# The prototype is tested where the read stands, and what follows goes on for both answers. Whoever reads the name expects to find it, so the arm that finds nothing is the unlikely one.
# Where flow has seen the read call one getter, the arm under another prototype takes the getter that its site remembers for the Structure of the object and calls that function directly.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline ResolveAccesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Message" constructor=f1 fields=[{key="count" declared={type=anything}}]
layout L1 name="Above" fields=[{key="step" declared={type=anything}}, {key="twice" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Integer integer=1
    v4 = Construct v2, v2, v3
    v5 = NewClosure function=f2
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = NewClosure function=f3
    DefineGetter v6, v7 key="twice"
    v9 = FinishObject v6
    v10 = Builtin builtin=ObjectSetPrototypeOf
    v11 = Call v10, -, v4, v9
    v12 = NewClosure function=f4
    v13 = Call v12, -, v4
    v14 = NewClosure function=f5
    v15 = Call v14, -, v4
    v16 = NewClosure function=f6
    v17 = Call v16, -, v4
    Return v17
}

function f1 name="Message" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="count" mode=Strict
    Return v3
}

function f2 name="step" flags=[HasThis] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
}

function f3 name="twice" kind=Getter flags=[HasThis] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    Return v1
}

function f4 name="callsMember" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="step"
    v2 = Call v1, v0
    Return v2
# CHECK: [[keeps]]: boolean = HasLayoutPrototype v0
# CHECK-NEXT: Branch [[keeps]] -> taken [[usual]](| 0), notTaken [[other]]()
# CHECK: [[behind]]([[member]]: anything):
# CHECK: [[other]]():
# CHECK-NEXT: [[found]]: anything = PropGet v0 key="step"
# CHECK-NEXT: Jump -> next [[behind]]([[found]])
# CHECK: [[usual]]({{*}}: guard) frequency=Unlikely:
# CHECK-NEXT: [[nothing]]: undefined = Undefined
# CHECK-NEXT: Jump -> next [[behind]]([[nothing]])
}

function f5 name="readsThroughGetter" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="twice"
    Return v1
# CHECK: [[keepsIts]]: boolean = HasLayoutPrototype v0
# CHECK-NEXT: Branch [[keepsIts]] -> taken {{*}}(| 0), notTaken [[another]]()
# CHECK: [[another]]():
# CHECK-NEXT: [[getter]]: anything = GetCachedGetter v0 key="twice"
# CHECK-NEXT: [[isGetter]]: boolean = TypeTest [[getter]] testedType=f3
# CHECK-NEXT: Branch [[isGetter]] -> taken [[direct]](| 0), notTaken [[asksByName]](| 0)
# CHECK: [[direct]]({{*}}: f3):
# CHECK-NEXT: = CallDirect v0 function=f3
# CHECK: [[asksByName]]({{*}}: anything) frequency=Unlikely:
# CHECK-NEXT: = PropGet v0 key="twice"
}

# Flow has seen nothing under the name: the read is undefined for as long as the prototype is the one of the layout, and the test is placed with all others.
function f6 name="readsWhatNobodyHas" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="missing"
    Return v1
# CHECK-NOT: HasLayoutPrototype
}
