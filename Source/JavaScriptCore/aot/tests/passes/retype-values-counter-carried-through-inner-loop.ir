  b3(v8, v9):
    LoopHint
    v11 = Less v8, v0
    Branch v11 -> taken b4(| 0), notTaken b5()
  b4(v12):
    v13 = Increment v12
    Jump -> next b3(v13, v9)
  b5():
    Jump -> next b1(v9)
  b6():
    Return
}
