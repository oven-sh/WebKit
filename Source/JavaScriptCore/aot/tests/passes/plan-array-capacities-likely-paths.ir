    v7 = Less v5, v0
    Branch v7 -> taken b2(| 0), notTaken b6()
  b2(v8):
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v9 = CallBuiltin v3, v1 overload=ArrayPrototypePush/0 builtinCallForm=Whole
    Jump -> next b5()
  b4() frequency=Unlikely:
    v10 = PropGet v3 key="push"
    v11 = Call v10, v3, v1
    Jump -> next b5()
  b5():
    v12 = Integer integer=1
    v13 = Add v8, v12
    Jump -> next b1(v13)
  b6():
    Return v3
}
