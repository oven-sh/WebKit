# The traversal is library code whose summary knows no types of a chain. A chain of calls that say how little they do is not fused where that would take the body out of the summary of its function, which callers have placed tests by, or end a guard of the function itself
# FORM: Prepared
# OPTIONS: report=Declines heat=OnlyLoopsAreHot
# RUN: pass FuseArrayChains
# RUN(DECLINES): pass FuseArrayChains
# STATISTIC: ArrayChainsFused = 1
# CHECK: outcome: Changed
# DECLINES: decline ArrayChainNotFused f1 v5 None [0] reason=Unknown
# DECLINES: decline ArrayChainNotFused f3 v10 None [0] reason=Unknown
# DECLINES-NOT: decline

module m0 path="main.js" displayPath="main.js"
variable g0 name="callback" module=m0 declared={type=anything} initialization=Undefined
runtimefunction id=131091 function=f0
function f0 name="traverseArray" role=Library enclosingRuntimeFunction=131091 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v6 = Less v1, v2
    v7 = ElemGet v0, v1
    Return v7
}

function f1 name="writesNothing" parameters=[{type=Array<string, proven, pristine[Storage, Names]>}, {type=i32}, {type=i32}] results=[{type=string}] {
    v3 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSlice/0
    v4 = AssumeType v3 provenType=Array<string, proven, pristine[Storage, Names]>
    v5 = CallBuiltin v4 overload=ArrayPrototypeJoin/0
    Return v5
# CHECK: = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSlice/0
# CHECK: = CallBuiltin v4 overload=ArrayPrototypeJoin/0
# CHECK-NOT: CallDirect
}

function f2 name="runsUnknownCodeAnyway" parameters=[{type=Array<string, proven, pristine[Storage, Names]>}, {type=i32}, {type=i32}] results=[{type=string}] {
    v3 = GetModuleVariable variable=g0
    v4 = Call v3, -
    v5 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSlice/0
    v6 = AssumeType v5 provenType=Array<string, proven, pristine[Storage, Names]>
    v7 = CallBuiltin v6 overload=ArrayPrototypeJoin/0
    Return v7
# CHECK-NOT: CallBuiltin
# CHECK: = CallDirect v0, v1, v2, {{*}} function=
# CHECK-NOT: CallBuiltin
}

function f3 name="guardAcrossTheChain" parameters=[{type=Array<string, proven, pristine[Storage, Names]>}, {type=i32}, {type=i32}, {type=Array<number, proven, pristine[Storage, Names]>}] results=[{type=anything}] {
    v4 = GetModuleVariable variable=g0
    v5 = Call v4, -
    v6 = HasArrayStorage v3 arrayStorage=Int32
    Branch v6 -> taken b1(| 0), notTaken b2()
  b1(v7: guard):
    v8 = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSlice/0
    v9 = AssumeType v8 provenType=Array<string, proven, pristine[Storage, Names]>
    v10 = CallBuiltin v9 overload=ArrayPrototypeJoin/0
    v11 = Integer integer=0
    v12 = GetArrayElement v3, v11, v7 arrayStorage=Int32 level=Expected [keyIsIntegral]
    Return v12
  b2():
    v13 = Undefined
    Return v13
}
# CHECK-LABEL: function f3 name="guardAcrossTheChain"
# CHECK: = CallBuiltin v0, v1, v2 overload=ArrayPrototypeSlice/0
# CHECK: = CallBuiltin v9 overload=ArrayPrototypeJoin/0
# CHECK-NOT: CallDirect
# CHECK-LABEL: function {{*}}role=ChainStep
