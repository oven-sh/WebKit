# A function that can be entered by other ways than direct calls keeps every result: an unknown caller may read any of them
# FORM: Prepared
# RUN: pass RemoveUnusedResults
# STATISTIC: UnusedResultsRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
variable g0 name="hoisted" module=m0 declared={type=anything} initialization=Function function=f1

function f0 name="closureIsCreated" parameters=[{type=int}] results=[{type=number}, {type=number}] {
  b0(v0: int):
    v1 = Add v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f0 name="closureIsCreated"{{*}}results=[{type=number}, {type=number}] 
# CHECK: = Mul v0, v0
# CHECK-NEXT: = Results

function f1 name="namedByVariable" parameters=[{type=int}] results=[{type=number}, {type=number}] {
  b0(v0: int):
    v1 = Add v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f1 name="namedByVariable"{{*}}results=[{type=number}, {type=number}] 
# CHECK: = Mul v0, v0
# CHECK-NEXT: = Results

function f2 name="onlyCalledDirectly" parameters=[{type=int}] results=[{type=number}, {type=number}] {
  b0(v0: int):
    v1 = Add v0, v0
    v2 = Mul v0, v0
    v3 = Results v1, v2
    Return v3
}
# CHECK-LABEL: function f2 name="onlyCalledDirectly"{{*}}results=[{type=number}] 
# CHECK-NOT: = Mul
# CHECK-NOT: = Results

function f3 name="readsFirstOfEach" parameters=[{type=int}, {type=anything}] results=[{type=number}] {
  b0(v0: int, v1: anything):
    v2 = CallDirect v0 function=f0
    v3 = ResultAt v2 index=0
    v4 = CallDirect v0 function=f1
    v5 = ResultAt v4 index=0
    v6 = CallDirect v0 function=f2
    v7 = ResultAt v6 index=0
    v8 = NewClosure function=f0
    v9 = Call v1, -, v8
    v10 = Add v3, v5
    v11 = Add v10, v7
    Return v11
}
# CHECK-LABEL: function f3 name="readsFirstOfEach"
# CHECK: [[closure]]:{{*}}= CallDirect v0 function=f0
# CHECK-NEXT: = ResultAt [[closure]]
# CHECK-NEXT: [[variable]]:{{*}}= CallDirect v0 function=f1
# CHECK-NEXT: = ResultAt [[variable]]
# CHECK-NEXT: : number = CallDirect v0 function=f2
# CHECK-NOT: ResultAt
