function f2 name="aTestThatAnEarlierOneOnTheWayHasAnswered" parameters=[{type=i32}, {type=i32}] results=[{type=anything}] {
    Jump -> next b1(v0, v1)
  b1(v2, v3):
    LoopHint
    v5 = TypeTest v3 testedType=i32
    Branch v5 -> taken b2(| 0), notTaken b6()
  b2(v6):
    v7 = TypeTest v6 testedType=number
    Branch v7 -> taken b3(| 0), notTaken b6()
  b3(v8):
    v9 = ToBoolean v8
    Branch v9 -> taken b4(), notTaken b5()
  b4():
    v10 = Mod v2, v8
    Jump -> next b1(v8, v10)
  b5():
    Return v2
  b6() frequency=Rare:
    Return v3
}
# CHECK-LABEL: function f2
# CHECK: Jump -> next b1(v8, v10)
