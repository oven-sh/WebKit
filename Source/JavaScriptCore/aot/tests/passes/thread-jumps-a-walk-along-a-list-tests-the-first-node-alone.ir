# `for (let node = first; node !== undefined; node = node.next) if (node.key === key) ..`: what comes back round was read from a field and has its type. Only the first node may be anything
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN: function-passes behind-rounds ThreadJumps
# RUN(ROUNDS): function-passes ThreadJumps
# RUN(CLEANED): function-passes behind-rounds ThreadJumps RetypeValues FoldConstants
# LOSS: MaxInlineHeadBytes

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="key" declared={type=anything} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="next" declared={type=undefined|L0} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Loose" fields=[{key="key" declared={type=anything} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="next" declared={type=anything} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="find" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1(v0)
  b1(v2):
    LoopHint
    v4 = TypeTest v2 testedType=undefined
    Branch v4 -> taken b2(), notTaken b3(| 0)
  b2():
    Return
  b3(v5):
    v6 = RequireObjectCoercible v5 name="key"
    v7 = TypeTest v6 testedType=L0
    Branch v7 -> taken b4(| 0), notTaken b7()
  b4(v8):
    v9 = GetSlot v8 key="key" receivers=[L0] level=Proven
    v10 = StrictEq v9, v1
    Branch v10 -> taken b5(), notTaken b6()
  b5():
    Return v9
  b6():
    v11 = GetSlot v8 key="next" receivers=[L0] level=Proven
    Jump -> next b1(v11)
  b7() frequency=Rare:
    v12 = PropGet v6 key="key"
    Return v12
}
# CHECK-LABEL: function f0
# CHECK: b1(v2: anything):
# CHECK: Jump -> next [[copy]](v11)
# CHECK: [[copy]]({{*}}: anything):
# CHECK-NEXT: LoopHint
# ROUNDS-LABEL: function f0
# ROUNDS: Jump -> next b1(v11)
# CLEANED-LABEL: function f0
# CLEANED: b1(v2: anything):
# CLEANED: v7: boolean = TypeTest v6 testedType=L0
# CLEANED: Jump -> next [[copy]](v11)
# CLEANED: [[copy]]({{*}}: undefined|L0):
# CLEANED: : true = TypeTest {{*}} testedType=L0

function f1 name="findWhereTheNextMayBeAnything" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1(v0)
  b1(v2):
    LoopHint
    v4 = TypeTest v2 testedType=undefined
    Branch v4 -> taken b2(), notTaken b3(| 0)
  b2():
    Return
  b3(v5):
    v6 = RequireObjectCoercible v5 name="key"
    v7 = TypeTest v6 testedType=L1
    Branch v7 -> taken b4(| 0), notTaken b7()
  b4(v8):
    v9 = GetSlot v8 key="key" receivers=[L1] level=Proven
    v10 = StrictEq v9, v1
    Branch v10 -> taken b5(), notTaken b6()
  b5():
    Return v9
  b6():
    v11 = GetSlot v8 key="next" receivers=[L1] level=Proven
    Jump -> next b1(v11)
  b7() frequency=Rare:
    v12 = PropGet v6 key="key"
    Return v12
}
# CHECK-LABEL: function f1
# CHECK: Jump -> next b1(v11)
# CLEANED-LABEL: function f1
# CLEANED: Jump -> next b1(v11)
