# With 1024 unchecked bytes at most two functions in a row are entered without a stack check
# FORM: Selected
# OPTIONS: limit=UncheckedStackBytes:1024
# RUN: pass ElideStackChecks
# STATISTIC: StackChecksCoveredByCallers = 11
# STATISTIC: StackChecksDeferredToCallee = 0
# LOSS: UncheckedStackBytes x5 f0

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    v1 = CallDirect function=f3
    v2 = CallDirect function=f6
    v3 = CallDirect function=f11
    v4 = CallDirect function=f13
    Return v4
}

function f1 name="pair0" results=[{type=undefined}] {
    v0 = CallDirect function=f2
    Return v0
}

function f2 name="pair1" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}

function f3 name="triple0" results=[{type=undefined}] {
    v0 = CallDirect function=f4
    Return v0
}

function f4 name="triple1" results=[{type=undefined}] {
    v0 = CallDirect function=f5
    Return v0
}

function f5 name="triple2" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}
# REPEAT: i = 0..3

function f%(i+6) name="five%(i)" results=[{type=undefined}] {
    v0 = CallDirect function=f%(i+7)
    Return v0
}
# END REPEAT

function f10 name="five4" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}

function f11 name="callsLeafAndPair" results=[{type=undefined}] {
    v0 = CallDirect function=f12
    v1 = CallDirect function=f1
    Return v1
}

function f12 name="leaf" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}

function f13 name="tail0" results=[{type=undefined}] {
    v0 = CallDirect function=f14
    ReturnCall v0
}

function f14 name="tail1" results=[{type=undefined}] {
    v0 = CallDirect function=f15
    ReturnCall v0
}

function f15 name="tail2" results=[{type=undefined}] {
    v0 = Undefined
    Return v0
}
# CHECK: f0 stack check: Required
# CHECK-NEXT: f1 stack check: CoveredByCallers
# CHECK-NEXT: f2 stack check: CoveredByCallers
# CHECK-NEXT: f3 stack check: Required
# CHECK-NEXT: f4 stack check: CoveredByCallers
# CHECK-NEXT: f5 stack check: CoveredByCallers
# CHECK-NEXT: f6 stack check: CoveredByCallers
# CHECK-NEXT: f7 stack check: CoveredByCallers
# CHECK-NEXT: f8 stack check: Required
# CHECK-NEXT: f9 stack check: CoveredByCallers
# CHECK-NEXT: f10 stack check: CoveredByCallers
# CHECK-NEXT: f11 stack check: Required
# CHECK-NEXT: f12 stack check: CoveredByCallers
# CHECK-NEXT: f13 stack check: Required
# CHECK-NEXT: f14 stack check: CoveredByCallers
# CHECK-NEXT: f15 stack check: CoveredByCallers
# CHECK-NEXT: outcome: Unchanged
