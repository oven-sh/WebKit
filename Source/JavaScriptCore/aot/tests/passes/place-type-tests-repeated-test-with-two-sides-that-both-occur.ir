# `twin === null`, asked in arm after arm of a value that is expected to be null or an object: both answers occur. One test in front would send the side on which it fails
# into the copy of the failed tests, where nothing else is tested either, and every access on that side would go by name. So the tests of the program stay, each is one comparison,
# and the accesses on both sides of them get their own tests. Where the other answer is a surprise, one test stands in front as before
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN(A): pass PlaceTypeTests
# RUN(B): pass PlaceTypeTests
# RUN(SURPRISE): pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
layout L0 name="TreeNode" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]

function f0 name="bothSidesOccur" parameters=[{type=null|L0 flags=[IsExpected]}, {type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ null|L0, v1: anything ~ L0):
    v2 = TypeTest v0 testedType=null
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    v4 = PropGet v1 key="a"
    Jump -> next b3(v4)
  b2(v5):
    v6 = PropGet v5 key="a"
    Jump -> next b3(v6)
  b3(v7):
    v8 = TypeTest v0 testedType=null
    Branch v8 -> taken b4(| 0), notTaken b5(| 0)
  b4(v9):
    v10 = PropGet v1 key="b"
    v11 = StrictEq v10, v7
    Return v11
  b5(v12):
    v13 = PropGet v12 key="b"
    v14 = StrictEq v13, v7
    Return v14
}
# A-LABEL: function f0 name="bothSidesOccur"
# A: = GetSlot {{*}} key="a"
# A: = GetSlot {{*}} key="a"
# A-LABEL: function f1
# B-LABEL: function f0 name="bothSidesOccur"
# B: = GetSlot {{*}} key="b"
# B: = GetSlot {{*}} key="b"
# B-LABEL: function f1

function f1 name="theOtherSideIsASurprise" parameters=[{type=string flags=[IsExpected]}] results=[{type=i32}] {
  b0(v0: anything ~ string):
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetStringLength v2
    Jump -> next b3(v3)
  b2():
    v4 = Integer integer=1
    Jump -> next b3(v4)
  b3(v5):
    v6 = TypeTest v0 testedType=string
    Branch v6 -> taken b4(| 0), notTaken b5()
  b4(v7):
    v8 = GetStringLength v7
    v9 = BitXor v8, v5
    Return v9
  b5():
    Return v5
}
# SURPRISE-LABEL: function f1 name="theOtherSideIsASurprise"
# SURPRISE: [[inFront]]: boolean{{*}} = TypeTest v0 testedType=string
# SURPRISE: : true = TypeTest {{*}} testedType=string
# SURPRISE: : true = TypeTest {{*}} testedType=string
