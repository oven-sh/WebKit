# An object that is never built has the key order that the built object would have once a value was stored under the key of a listed field by name
# FORM: Prepared
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"
layout L0 name="StaysInSlots" fields=[{key="x" declared={type=undefined|null|boolean|number|string|object} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="MayLeaveSlots" fields=[{key="x" declared={type=undefined|null|boolean|number|string|object} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined]}}, {key="y" declared={type=number} flags=[IsEnforced] flow={location={writers=AllKnown} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

function f0 name="oneOfTwoOrdersIsFound" parameters=[{type=anything}, {type=boolean}, {type=number}] results=[{type=anything}] {
    Branch v1 -> taken b5(), notTaken b1()
  b1() frequency=Rare:
    v3 = Integer integer=0
    v4 = NewObject -, v3, v2 layout=L0 fields=[0, 1]
    PropSet v4, v0 key="x" mode=Strict receivers=[L0]
    v6 = HasKeyOrder v4 layout=L0 fields=[1, 0]
    Branch v6 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    Return v1
  b3() frequency=Rare:
    v7 = HasKeyOrder v4 layout=L0 fields=[0, 1]
    Branch v7 -> taken b4(), notTaken b6()
  b4() frequency=Rare:
    v8 = GetSlotOrUndefined v4 key="y" receivers=[L0] level=Proven
    Return v8
  b5():
    Return v0
  b6() frequency=Rare:
    Unreachable
# CHECK-NOT: NewObject
# CHECK: b1() frequency=Rare:
# CHECK: [[other0]]: false = Boolean
# CHECK-NEXT: v6: boolean = Upcast [[other0]]
# CHECK-NEXT: Jump -> next b3()
# CHECK: b3() frequency=Rare:
# CHECK-NEXT: [[written0]]: true = Boolean boolean=true
# CHECK-NEXT: v7: boolean = Upcast [[written0]]
# CHECK-NEXT: Jump -> next b4()
# CHECK: b4() frequency=Rare:
# CHECK-NEXT: v8: undefined|number = Upcast v2
}

function f1 name="theBuiltObjectIsAsked" parameters=[{type=anything}, {type=boolean}, {type=number}] results=[{type=anything}] {
    Branch v1 -> taken b3(), notTaken b1()
  b1() frequency=Rare:
    v3 = Integer integer=0
    v4 = NewObject -, v3, v2 layout=L1 fields=[0, 1]
    PropSet v4, v0 key="x" mode=Strict receivers=[L1]
    v6 = HasKeyOrder v4 layout=L1 fields=[0, 1]
    Branch v6 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v7 = GetSlotOrUndefined v4 key="y" receivers=[L1] level=Proven
    Return v7
  b3():
    Return v0
# CHECK: v4: L1 = NewObject -, v3, v2 layout=L1 fields=[0, 1]
# CHECK-NEXT: PropSet v4, v0 key="x"
# CHECK-NEXT: v6: boolean = HasKeyOrder v4 layout=L1 fields=[0, 1]
# CHECK-NEXT: Branch v6 -> taken b2(), notTaken b3()
}
