# In a validating build the second sum of the same two integers stays, its users take the first one's answer, and the two answers are held against each other. The sum that was kept is left alone by a second run.
# FORM: Prepared
# OPTIONS: validate check=VerifyEachPass
# RUN: pass EliminateRedundantReads EliminateRedundantReads

module m0 path="main.js" displayPath="main.js"
function f0 name="behindACall" parameters=[{type=int}, {type=int}, {type=anything}] results=[{type=anything}] {
    v3 = Add v0, v1
    v4 = Call v2, v3
    v5 = Add v0, v1
    v6 = Call v2, v5
    Return v6
# CHECK: = Add v0, v1
# CHECK-NEXT: = Call v2, v3
# CHECK-NEXT: = Add v0, v1
# CHECK-NEXT: ValidateSameValue v5, v3
# CHECK-NEXT: = Call v2, v3
# CHECK-NEXT: Return
}
