# function Counter(name) { this.name = name }  Counter.prototype.count = 0  function hit(counter: Counter) { counter.count++ }
# An object has the count of its prototype until its first increment. Where the test of the slot fails the name is read once; a number that the slot can hold becomes the object's own field under the tests
# that a store passes what the object inherits, and the function goes on in its typed code as for an object that had the field. Whatever fails there goes on in the copy behind the copy's own read
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline PlaceTypeTests

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Counter" constructor=f1 fields=[{key="name" declared={type=anything}}, {key="count" declared={type=number}}] flags=[IsConstructorFunction]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = Integer
    PropSet v1, v2 key="count"
    v4 = Integer integer=1
    v5 = Construct v0, -, v4
    v6 = NewClosure function=f2
    v7 = Call v6, -, v5
    v8 = NewClosure function=f3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="register" [isFreeName]
    v11 = Call v10, -, v5, v6, v8
    v12 = Call v8, -, v5, v11
    v13 = NewClosure function=f4
    v14 = Call v10, -, v13
    v15 = Call v13, -, v5
    Return v12
}
function f1 name="Counter" flags=[HasThis] thisType={type=L0 flags=[IsExpected]} parameters=[{type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="name"
    Return
}
function f2 name="hit" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="count"
    v2 = Increment v1
    PropSet v0, v2 key="count"
    Return
# CHECK: [[isFilled]]: boolean = IsSlotFilled [[counter]] key="count" {{*}}
# CHECK-NEXT: Branch [[isFilled]] -> taken [[filled]](| 0), notTaken [[empty]]()
# CHECK: [[readOfCopy]]: anything ~ undefined|number = PropGet v0 key="count" {{*}}
# CHECK-NEXT: Jump -> next [[behindRead]]([[readOfCopy]])
# CHECK: [[empty]]():
# CHECK-NEXT: [[inherited]]: anything ~ undefined|number = PropGet [[counter]] key="count" {{*}}
# CHECK-NEXT: [[isNumber]]: boolean = TypeTest [[inherited]] testedType=number
# CHECK-NEXT: Branch [[isNumber]] -> taken [[next]](| 0), notTaken [[behindRead]]([[inherited]])
# CHECK-NEXT: [[next]]([[number]]: number):
# CHECK: [[passes]]: boolean = AreMembersUnchanged conditions=[{kind=MemberPassedByStores layout=L0 key="count"}]
# CHECK-NEXT: Branch [[passes]] -> taken {{*}}(| 0), notTaken [[behindRead]]([[inherited]])
# CHECK: PutSlotOrAdd [[counter]], {{*}}, [[number]] key="count" {{*}}
# CHECK-NEXT: [[isFilledNow]]: boolean = IsSlotFilled [[counter]] key="count" {{*}}
# CHECK-NEXT: Branch [[isFilledNow]] -> taken [[filled]](| 0), notTaken [[behindRead]]([[inherited]])
}

# What is added may be an object whose valueOf() looks at the counter, and it finds no field there before the store.
function f3 name="add" parameters=[{type=L0 flags=[IsExpected]}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="count"
    v3 = Sub v2, v1
    PropSet v0, v3 key="count"
    Return
# CHECK: [[hasCount]]: boolean = IsSlotFilled {{*}} key="count" {{*}}
# CHECK-NEXT: Branch [[hasCount]] -> taken {{*}}(| 0), notTaken [[copyOfAdd]]()
# CHECK-NOT: PutSlotOrAdd
# CHECK: [[copyOfAdd]]() frequency=Unlikely:
# CHECK-NEXT: {{*}} = PropGet v0 key="count" {{*}}
# CHECK-NOT: PutSlotOrAdd
# CHECK: PropSet v0, {{*}} key="count" {{*}}
}

# The name is read again behind the increment, under the test that stands in front of it. A getter of `count` may have deleted the name, so nothing that has read `count` by name comes back in between.
function f4 name="hitBetweenReads" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = PropGet v0 key="name"
    v2 = PropGet v0 key="count"
    v3 = Increment v2
    PropSet v0, v3 key="count"
    v5 = PropGet v0 key="name"
    Return v5
}
# CHECK-LABEL: function {{*}}name="hitBetweenReads"
# CHECK: [[hasName]]: guard
# CHECK: IsSlotFilled {{*}} key="count" {{*}}
# CHECK-NOT: PutSlotOrAdd
