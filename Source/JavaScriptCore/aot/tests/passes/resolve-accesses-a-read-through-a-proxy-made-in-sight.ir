# The function that reads through the proxy has made it, so handler and target are at hand: the trap is read off the handler as the program would read it, and its body is pasted in.
# class Counting {
#   reads = 0;
#   get(target: any, key: string): unknown {
#     this.reads++;
#     return target[key];
#   }
# }
# function read(value: number): unknown {
#   const proxy: any = new Proxy({ alpha: value, beta: 2 }, new Counting());
#   return proxy.alpha;
# }
# declare const input: any;
# (globalThis as any).answer = read(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline CheckPlacement

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=135 kind=Parameter function=f1
typesite w1 module=m0 position=19 kind=Field
typesite w2 module=m0 position=49 kind=Parameter function=f3
typesite w3 module=m0 position=32 kind=This
typesite w4 module=m0 position=219 kind=CallResult
typesite w5 module=m0 position=77 kind=Field
layout L0 kind=Instance name="Counting" module=m0 position=6 constructor=f2 fields=[{key="reads" declared={type=number site=w1} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 position=192 fields=[{key="alpha" declared={type=number} flags=[IsRequired]}, {key="beta" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="Counting" module=m0 declared={type=absent|f2 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g1
    v5 = NewClosure function=f3
    DefineMethod v3, v5 layout=L0 key="get"
    v7 = FinishClass v3 layout=L0
    v8 = Convert v7 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v9 = Convert v7 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    PutModuleVariable v9 variable=g0
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="globalThis" [isFreeName]
    v13 = Convert v12 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v14 = Convert v13 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = Convert v16 declared={type=number flags=[IsExpected]}
    v18 = ToNumber v17
    v19 = Call v1, -, v18 calleeName="read"
    PropSet v14, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="read" module=m0 position=121 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
