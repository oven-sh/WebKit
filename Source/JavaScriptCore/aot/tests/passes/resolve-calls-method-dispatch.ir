function f20 name="casts-are-copied-into-the-rest" parameters=[{type=L0|L3}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Check v2 expectedType=function site=w0
    v4 = Call v3, v0, v1 calleeKey="run"
    Return v4
# CHECK-NEXT: b0(v0: L0|L3, v1: anything):
# CHECK-NEXT: v2: undefined = Undefined
# CHECK-NEXT: v3: undefined = Undefined
# CHECK-NEXT: = TypeTest v0 testedType=L0
# CHECK: = CallDirect {{*}}, v1 function=f1
