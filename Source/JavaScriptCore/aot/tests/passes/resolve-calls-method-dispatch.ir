function f22 name="under-handler" parameters=[{type=L0|L1}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0|L1, v1: anything) handler=b2():
    v2 = PropGet v0 key="run"
    v3 = Call v2, v0, v1 calleeKey="run"
    Jump -> next b1()
  b1():
    Return v3
  b2() role=CatchHandler:
    v4 = CatchValue
    Return v4
# CHECK: ({{*}}: L0) handler=b2():
# CHECK-NEXT: = CallDirect {{*}}, v1 function=f1
# CHECK: ({{*}}: L1) handler=b2():
# CHECK-NEXT: = CallDirect {{*}}, v1 function=f3
}
