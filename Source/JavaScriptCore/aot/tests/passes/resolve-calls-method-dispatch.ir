}
function f17 name="field-among-the-arms-after-unknown-code" parameters=[{type=L0|L5}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Call v1
    v4 = Call v2, v0, v3 calleeKey="run"
    Return v4
# CHECK-NEXT: b0(v0: L0|L5, v1: anything):
# CHECK-NEXT: = PropGet v0 key="run"
# CHECK-NEXT: = Call v1
# CHECK-NEXT: = Call v2, v0, v3 calleeKey="run"
