function f19 name="nullable-receiver" parameters=[{type=undefined|L0|L1}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Call v2, v0, v1 calleeKey="run"
    Return v3
# CHECK-NEXT: b0(v0: undefined|L0|L1, v1: anything):
# CHECK-NEXT: v2: L0|L1 = RequireObjectCoercible v0 name="run"
