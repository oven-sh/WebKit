# A member call on a proven union of layouts is a chain of type tests with one direct call per arm, and the members nothing is known about share one rest
# FORM: Prepared
# RUN: pass ResolveCalls
# STATISTIC: CallsResolved = 10
# STATISTIC: DispatchArms = 18
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
typesite w0 module=m0 position=5 kind=Assertion text="Function"
layout L0 kind=Instance name="Add" constructor=f0 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f1 mutability=Fixed}]}
layout L1 kind=Instance name="Subtract" constructor=f2 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f3 mutability=Fixed}]}
layout L2 kind=Instance name="Multiply" constructor=f4 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="run" function=f5 mutability=Fixed}]}
layout L3 kind=Instance name="Plugin" constructor=f6 flags=[HasHeritage] flow={impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L4 kind=Instance name="AddChecked" base=L0 constructor=f7 flags=[HasHeritage] flow={baseState=Layout base=L0 impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L5 kind=Instance name="Custom" constructor=f8 fields=[{key="run" declared={type=anything} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
layout L6 kind=Instance name="Buffer" constructor=f9 flow={baseState=None impossibleMutations=[AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="size" kind=Getter function=f10 mutability=Fixed}, {key="size" kind=Setter function=f11 mutability=Fixed}, {key="level" kind=Setter function=f12 mutability=Fixed}]}
function f0 name="Add" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f1 name="run" kind=Method flags=[HasThis] thisType={type=L0|L4} parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
function f2 name="Subtract" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f3 name="run" kind=Method flags=[HasThis] thisType={type=L1} parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
function f4 name="Multiply" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f5 name="run" kind=Method flags=[HasThis] thisType={type=L2} parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
function f6 name="Plugin" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f7 name="AddChecked" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f8 name="Custom" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f9 name="Buffer" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
function f10 name="size" kind=Getter flags=[HasThis] thisType={type=L6} results=[{type=anything}] {
    Return
}
function f11 name="size" kind=Setter flags=[HasThis] thisType={type=L6} parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
function f12 name="level" kind=Setter flags=[HasThis] thisType={type=L6} parameters=[{type=anything}] results=[{type=anything}] {
    Return
}

function f13 name="three-methods" parameters=[{type=L0|L1|L2}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Call v2, v0, v1 calleeKey="run"
    Return v3
# CHECK-NEXT: b0(v0: L0|L1|L2, v1: anything):
# CHECK-NEXT: v2: undefined = Undefined
# CHECK-NEXT: [[isAdd]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: Branch [[isAdd]] -> taken [[addArm]](| 0), notTaken [[notAdd]](| 0)
# CHECK-NEXT: [[join]](v3: anything):
# CHECK-NEXT: Return v3
# CHECK-NEXT: [[addArm]]([[add]]: L0):
# CHECK-NEXT: [[sum]]: anything = CallDirect [[add]], v1 function=f1
# CHECK-NEXT: Jump -> next [[join]]([[sum]])
# CHECK-NEXT: [[notAdd]]([[subtractOrMultiply]]: L1|L2):
# CHECK-NEXT: [[isSubtract]]: boolean = TypeTest [[subtractOrMultiply]] testedType=L1
# CHECK-NEXT: Branch [[isSubtract]] -> taken [[subtractArm]](| 0), notTaken [[multiplyArm]](| 0)
# CHECK-NEXT: [[subtractArm]]([[subtract]]: L1):
# CHECK-NEXT: [[difference]]: anything = CallDirect [[subtract]], v1 function=f3
# CHECK-NEXT: Jump -> next [[join]]([[difference]])
# CHECK-NEXT: [[multiplyArm]]([[multiply]]: L2):
# CHECK-NEXT: [[product]]: anything = CallDirect [[multiply]], v1 function=f5
# CHECK-NEXT: Jump -> next [[join]]([[product]])
# CHECK-NEXT: }
}
function f14 name="three-methods-and-a-rest" parameters=[{type=L0|L1|L2|L3}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="run"
    v3 = Call v2, v0, v1 calleeKey="run"
    Return v3
# CHECK-NEXT: b0(v0: L0|L1|L2|L3, v1: anything):
# CHECK-NEXT: v2: undefined = Undefined
# CHECK-NEXT: = TypeTest v0 testedType=L0
# CHECK: = CallDirect {{*}}, v1 function=f1
# CHECK: ([[withoutAdd]]: L1|L2|L3):
# CHECK-NEXT: = TypeTest [[withoutAdd]] testedType=L1
# CHECK: = CallDirect {{*}}, v1 function=f3
# CHECK: ([[withoutSubtract]]: L2|L3):
# CHECK-NEXT: = TypeTest [[withoutSubtract]] testedType=L2
# CHECK: = CallDirect {{*}}, v1 function=f5
# CHECK: ([[plugin]]: L3) frequency=Unlikely:
# CHECK-NEXT: [[pluginMethod]]: anything = PropGet [[plugin]] key="run" receivers=[L3]
# CHECK-NEXT: = Call [[pluginMethod]], [[plugin]], v1 calleeKey="run"
# CHECK-NOT: TypeTest
}
