# A store to a variable that nothing reads stays when flow does not know every writer of the variable
# FORM: AsRead
# RUN: pipeline RemoveUnreadExports
# OPTIONS: disable=flow:StoreCounts disable-in=0:1
# STATISTIC: UnreadVariableStoresRemoved = 1
# CHECK-NOT: variable g0 name="unknownWriters"{{*}}writers=AllKnown
# CHECK: variable g0 name="unknownWriters"{{*}}reads=NeverRead
# CHECK: variable g1 name="knownWriters"{{*}}writers=AllKnown stores=Never{{*}}reads=NeverRead

module m0 path="/main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/library.ts" displayPath="library.ts" body=f1 exports=[{name="knownWriters" variable=g1}, {name="unknownWriters" variable=g0}]
entry module=m0
variable g0 name="unknownWriters" module=m1 declared={type=anything}
variable g1 name="knownWriters" module=m1 declared={type=anything}

function f0 name="main" kind=Module results=[{type=anything}] {
    Return
}

function f1 name="library" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="compute" [isFreeName]
    v2 = Call v1
    v3 = ToNumber v2
    PutModuleVariable v3 variable=g0
    PutModuleVariable v3 variable=g1
    Return
# CHECK: [[computed]]:{{*}}= ToNumber
# CHECK-NEXT: PutModuleVariable [[computed]] variable=g0
# CHECK-NEXT: Return
}
