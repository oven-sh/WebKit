# for (const name of ["a", "b"]) object[name] = function () { return name; };
# A turn asks which of the written names it was handed. It has a version for each, which creates a closure of a copy, and one for any other value.
# FORM: AsRead
# RUN: pass CopyClosureFactories
# CHECK: outcome: Changed
# CHECK-LABEL: function f0 name="main"
# CHECK: [[name]]{{*}} = ResultAt {{*}} index=1
# CHECK: [[a]]{{*}} = String string="a"
# CHECK-NEXT: StrictEq [[name]], [[a]]
# CHECK: [[b]]{{*}} = String string="b"
# CHECK: [[first]]{{*}} = NewClosure [[a]] function=f2
# CHECK-NEXT: ElemSet v0, [[a]], [[first]]
# CHECK: [[second]]{{*}} = NewClosure [[b]] function=f3
# CHECK-NEXT: ElemSet v0, [[b]], [[second]]
# CHECK: [[other]]{{*}} = NewClosure [[rest]]{{*}} function=f1
# CHECK-NEXT: ElemSet v0, [[rest]], [[other]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[]
data d0 root=Array{contents=string elements=[String{value="a"}, String{value="b"}]} module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = Data data=d0
    v2 = IteratorOpen v1
    Jump -> next b1()
  b1():
    v3 = IteratorResume v2
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b3(), notTaken b2()
  b2():
    v6 = NewClosure v5 function=f1
    ElemSet v0, v5, v6
    Jump -> next b1()
  b3():
    Return
}
function f1 name="member" module=m0 position=20 captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}
