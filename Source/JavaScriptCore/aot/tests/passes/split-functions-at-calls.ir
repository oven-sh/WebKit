function f3 name="sharedTail" parameters=[{type=anything}, {type=i32}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: i32, v2: function):
    v3 = TypeTest v0 testedType=number
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Switch v1 cases=[0, 1, 2, 3] -> case b3(), case b4(), case b5(), case b6(), otherwise b1()
  b3():
    v4 = Call v2, -, v0
    Jump -> next b7(v4)
  b4():
    v5 = Call v2, -, v0
    Jump -> next b7(v5)
  b5():
    v6 = Call v2, -, v0
    Jump -> next b7(v6)
  b6():
    v7 = Call v2, -, v0
    Jump -> next b7(v7)
  b7(v8):
    v9 = TypeTest v8 testedType=number
    v10 = TypeTest v8 testedType=number
    v11 = TypeTest v8 testedType=number
    v12 = TypeTest v8 testedType=number
    v13 = TypeTest v8 testedType=number
    v14 = TypeTest v8 testedType=number
    Return v8
}
# CHECK-LABEL: function f3 name="sharedTail"
# CHECK-NOT: Switch
# CHECK: [[rest3]]: anything = CallDirect v0, v1, v2 function=f18
# CHECK-NEXT: ReturnCall [[rest3]]
# CHECK-NOT: CallDirect

function f4 name="loop" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    LoopHint
    v4 = Call v1, -, v0
    v5 = TypeTest v4 testedType=string
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b2()
  b4():
    Return v0
}
