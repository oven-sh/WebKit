function f2 name="sharedRarePath" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = TypeTest v0 testedType=string
    Branch v3 -> taken b3(), notTaken b4()
  b3():
    v4 = Call v1, -, v0
    v5 = TypeTest v4 testedType=number
    Branch v5 -> taken b7(), notTaken b6()
  b4():
    v6 = TypeTest v0 testedType=boolean
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    v7 = Call v1
    v8 = TypeTest v7 testedType=number
    Branch v8 -> taken b7(), notTaken b6()
  b6() frequency=Rare:
    v9 = Call v1, -, v1
    Return v9
  b7():
    Return v0
}
