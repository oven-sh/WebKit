# A function is cut where it first needs a frame
# FORM: Selected
# RUN: pass SplitFunctionsAtCalls
# STATISTIC: SplitFunctionsAtCallsChanges = 1
# LOSS: MaxContinuationSizePercent f3

module m0 path="main.js" displayPath="main.js"
function f0 name="oneSlowPath" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
  b0(v0: anything, v1: function):
    v2 = TypeTest v0 testedType=number
    v3 = Integer integer=7
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = Call v1, -, v0, v3
    Return v4
}
# CHECK-LABEL: function f0 name="oneSlowPath"
# CHECK-NOT: = Call
# CHECK: [[rest0]]: anything = CallDirect v0, v1 function=f12
# CHECK-NEXT: ReturnCall [[rest0]]

function f1 name="twoSlowPaths" parameters=[{type=anything}, {type=function}] results=[{type=anything}] {
