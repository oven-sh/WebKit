# The rest of an object pattern copies every field but the ones that the pattern names: an excluded field is neither read nor defined, and the copy by the run time on the rare path keeps the list. A pattern with a computed key stays a copy by the run time
# FORM: Prepared optimizing
# OPTIONS: heat=EverythingIsHot
# RUN: pass ExpandOwnKeys
# STATISTIC: OwnKeyWalksExpanded = 1

module m0 path="main.js" displayPath="main.js"
layout L0 name="Rest"
layout L1 name="Person" fields=[{key="id" declared={type=number}}, {key="name" declared={type=string}}, {key="tags" declared={type=anything}}] flow={constructorOrders=[{fields=[0, 1, 2]}]}

function f0 name="named" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object ~ L1):
    v1 = NewObject layout=L0
    CopyDataProperties v1, v0 excludedKeys=["id"]
    v3 = FinishObject v1
    Return v3
}
# CHECK-LABEL: function f0 name="named"
# CHECK: = ShapeTest v0 layouts=[L1]
# CHECK: frequency=Rare:
# CHECK-NEXT: CopyDataProperties v1, v0 excludedKeys=["id"]
# CHECK: = HasKeyOrder v0, {{*}} layout=L1 fields=[0, 1, 2]
# CHECK-NOT: key="id"
# CHECK: [[name]]: string = GetSlot v0, {{*}} key="name" receivers=[L1] level=Expected
# CHECK-NEXT: [[tags]]: anything = GetSlot v0, {{*}} key="tags" receivers=[L1] level=Expected
# CHECK-NEXT: PropDefine v1, [[name]] key="name"
# CHECK-NEXT: PropDefine v1, [[tags]] key="tags"
# CHECK-NOT: key="id"

function f1 name="computed" parameters=[{type=object}, {type=string}] results=[{type=anything}] {
  b0(v0: object ~ L1, v1: string):
    v2 = NewObject layout=L0
    CopyDataProperties v2, v0, v1
    v4 = FinishObject v2
    Return v4
}
# CHECK-LABEL: function f1 name="computed"
# CHECK-NEXT: b0(v0: object ~ L1, v1: string):
# CHECK-NEXT: = NewObject layout=L0
# CHECK-NEXT: CopyDataProperties v2, v0, v1
# CHECK-NEXT: = FinishObject v2
