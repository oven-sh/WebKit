# A parameter that is passed on to a parameter in use, or to a function that keeps its signature, stays in every function on the way
# FORM: Prepared
# RUN: pass RemoveUnusedParameters
# STATISTIC: UnusedParametersRemoved = 1
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="top" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f1
    Return v2
# CHECK-NEXT: b0(v0: number, v1: number):
# CHECK-NEXT: = CallDirect v0, v1 function=f1
# CHECK-NEXT: Return
}

function f1 name="middle" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = CallDirect v0, v1 function=f2
    Return v2
# CHECK-NEXT: b0(v0: number, v1: number):
# CHECK-NEXT: = CallDirect v0, v1 function=f2
# CHECK-NEXT: Return
}

function f2 name="bottomUsesBoth" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = Add v0, v1
    Return v2
# CHECK-NEXT: b0(v0: number, v1: number):
# CHECK-NEXT: = Add v0, v1
}

function f3 name="passesToUsedAndToUnused" parameters=[{type=number}] results=[{type=number}] {
    v1 = Integer integer=1
    v2 = CallDirect v1, v0 function=f4
    v3 = CallDirect v0, v1 function=f4
    v4 = Add v2, v3
    Return v4
}
# CHECK-LABEL: function f3 name="passesToUsedAndToUnused"{{*}}parameters=[{type=number}]
# CHECK-NEXT: b0(v0: number):
# CHECK: = CallDirect v1 function=f8
# CHECK-NEXT: = CallDirect v0 function=f8

function f4 name="ignoresSecond" parameters=[{type=number}, {type=number}] results=[{type=number}] {
    v2 = Add v0, v0
    Return v2
# CHECK: = CallDirect v0 function=f8
# CHECK-NEXT: ReturnCall
}

function f5 name="passesToFunctionWithFixedSignature" parameters=[{type=number}] results=[{type=Promise}] {
    v1 = CallDirect v0 function=f6
    Return v1
}
# CHECK-LABEL: function f5 name="passesToFunctionWithFixedSignature"{{*}}parameters=[{type=number}]
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: = CallDirect v0 function=f6
# CHECK-NEXT: Return

function f6 name="asynchronous" flags=[IsAsync] parameters=[{type=number}] results=[{type=Promise}] {
    v1 = Undefined
    v2 = Await v1 @10
    Return v2
}
# CHECK-LABEL: function f6 name="asynchronous"{{*}}parameters=[{type=number}]
# CHECK-NEXT: b0(v0: number):

function f7 name="caller" parameters=[{type=number}, {type=number}] results=[{type=anything}] {
    v2 = CallDirect v0, v1 function=f0
    v3 = CallDirect v2 function=f3
    v4 = CallDirect v3 function=f5
    Return v4
# CHECK: [[first]]: number = CallDirect v0, v1 function=f0
# CHECK-NEXT: [[second]]: number = CallDirect [[first]] function=f3
# CHECK-NEXT: = CallDirect [[second]] function=f5
}

# CHECK-LABEL: function f8 name="ignoresSecond"{{*}}parameters=[{type=number}] results=[{type=number}]{{*}}derivation={source=f4 parameterMap=[{original=0}]}
# CHECK-NOT: function f9
