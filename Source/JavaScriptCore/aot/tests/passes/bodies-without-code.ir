    Return v0
}
function f11 name="outlinedFromBodyWithCode" role=OutlinedBody results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
# Nothing creates its closure, so it has no entrypoint.
function f12 name="namedByCalleeSetAlone" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
