# A body that stays for the effects of calls by value gets no code where closures lead to an entrypoint that holds a copy of it and no call in generated code names it
# FORM: Selected
# RUN: bodies-without-code

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0

function f0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0 callees=[f1]
    v2 = NewClosure function=f3
    v3 = Call v2 callees=[f3]
    v4 = NewClosure function=f5
    v5 = Call v4 callees=[f5]
    v6 = CallDirect function=f5
    v7 = NewClosure function=f7
    v8 = Call v7 callees=[f7]
    v9 = CallDirect function=f9
    v10 = CallDirect function=f11
    v11 = Call v2 callees=[f12]
    Return v1
}
function f1 name="copiedIntoEntrypoint" results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f7
    v1 = CallDirect function=f10
    Return v0
}
function f2 name="copiedIntoEntrypoint" role=GenericEntrypoint captures=[{type=f1}] results=[{type=anything}] derivation={source=f1} creator=Entrypoint{target=f1 arguments=Registers} {
  b0(v0: f1):
    v1 = Undefined
    Return v1
}
