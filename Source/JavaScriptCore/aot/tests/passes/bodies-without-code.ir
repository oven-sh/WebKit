    v0 = Undefined
    Return v0
}
function f4 name="calledByEntrypoint" role=GenericEntrypoint captures=[{type=f3}] results=[{type=anything}] derivation={source=f3} creator=Entrypoint{target=f3 arguments=Registers} {
  b0(v0: f3):
    v1 = CallDirect function=f3
    Return v1
}
function f5 name="copiedAndCalled" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f6 name="copiedAndCalled" role=GenericEntrypoint captures=[{type=f5}] results=[{type=anything}] derivation={source=f5} creator=Entrypoint{target=f5 arguments=Registers} {
  b0(v0: f5):
    v1 = Undefined
    Return v1
}
# Its one caller gets no code.
function f7 name="calledFromBodyWithoutCode" results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f8 name="calledFromBodyWithoutCode" role=GenericEntrypoint captures=[{type=f7}] results=[{type=anything}] derivation={source=f7} creator=Entrypoint{target=f7 arguments=Registers} {
  b0(v0: f7):
    v1 = Undefined
    Return v1
}
