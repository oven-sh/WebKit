# A callee may read, fill, call and pass on a cell of its caller's frame. It may not store the pointer in a cell, however soon that cell dies, capture it, keep it across a suspension, return it, throw it, hand it to a built-in or look it up under a computed key, and neither may a function it passes the pointer to
# FORM: AsRead
# RUN: frame-pointers flow
# DIAGNOSTIC: CalleeRetainsFramePointer 20

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Point" fields=[{key="y" declared={type=anything}}]
layout L1 name="Holder" fields=[{key="held" declared={type=anything}}]
layout L2 kind=Environment name="scope" fields=[{key="o" declared={type=anything}}]
layout L3 name="OnlyRead" fields=[{key="y" declared={type=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
# REPEAT: i = 1..23
    v%(i+1) = CallDirect v1 function=f%(i)
# END REPEAT
    Return
}

