# An array that a loop body allocates is fresh in every iteration: its tests fold until it escapes, whatever became of the arrays of earlier iterations
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 2

module m0 path="main.js" displayPath="main.js"

function f0 name="escapesAfterLastGuard" parameters=[{type=anything}, {type=Array<anything, pristine[Storage, Names]>}] results=[{type=undefined}] {
  b0(v0: anything, v1: Array<anything, pristine[Storage, Names]>):
    Jump -> next b1()
  b1():
    LoopHint
    v3 = NewArray contents=anything
    v4 = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = CallBuiltin v3, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b4(v6)
  b3() frequency=Unlikely:
    v7 = PropGet v3 key="push"
    v8 = Call v7, v3, v0 calleeKey="push"
    Jump -> next b4(v8)
  b4(v9):
    v10 = IsPristine v3 builtinClass=Array aspects=[Storage, Names]
    Branch v10 -> taken b5(| 0), notTaken b6()
  b5(v11):
    v12 = CallBuiltin v3, v0 overload=ArrayPrototypePush/0 [needsPristineReceiver]
    Jump -> next b7(v12)
  b6() frequency=Unlikely:
    v13 = PropGet v3 key="push"
    v14 = Call v13, v3, v0 calleeKey="push"
    Jump -> next b7(v14)
  b7(v15):
    v16 = CallBuiltin v1, v3 overload=ArrayPrototypePush/0
    v17 = Call v0, -, v1
    v18 = ToBoolean v17
    Branch v18 -> taken b1(), notTaken b8()
  b8():
    Return
}
