# Reads that follow each other can run twice. The first eight tests among them that fail enter the generic copy behind themselves. Every later one enters it where the eighth does, through one block, and hands over nothing that was read since. A store cannot run twice: the count begins again behind it.
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests

module m0 path="main.js" displayPath="main.js"
variable g0 name="count" module=m0 declared={type=number}
function f0 name="readsOnly" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = ElemGet v0, v1
    v3 = Integer integer=2
    v4 = ElemGet v0, v3
    v5 = Integer integer=3
    v6 = ElemGet v0, v5
    v7 = Integer integer=4
    v8 = ElemGet v0, v7
    v9 = Integer integer=5
    v10 = ElemGet v0, v9
    v11 = Integer integer=6
    v12 = ElemGet v0, v11
    v13 = Integer integer=7
    v14 = ElemGet v0, v13
    v15 = Integer integer=8
    v16 = ElemGet v0, v15
    v17 = Integer integer=9
    v18 = ElemGet v0, v17
    v19 = Integer integer=10
    v20 = ElemGet v0, v19
    v21 = Integer integer=11
    v22 = ElemGet v0, v21
    v23 = Integer integer=12
    v24 = ElemGet v0, v23
    v25 = NewArray v2, v4, v6, v8, v10, v12, v14, v16, v18, v20, v22, v24 contents=anything
    Return v25
# CHECK: notTaken b21(v2, v4, v6, v8, v10, v12, v14)
# CHECK: notTaken b28()
# CHECK: notTaken b28()
# CHECK: notTaken b28()
# CHECK: notTaken b28()
# CHECK: b28() frequency=Unlikely:
# CHECK: Jump -> next b21(v2, v4, v6, v8, v10, v12, v14)
}

function f1 name="storeBetweenReads" parameters=[{type=Array<number, pristine[Storage, Names]>}] results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = ElemGet v0, v1
    v3 = Integer integer=2
    v4 = ElemGet v0, v3
    v5 = Integer integer=3
    v6 = ElemGet v0, v5
    v7 = Integer integer=4
    v8 = ElemGet v0, v7
    v9 = Integer integer=5
    v10 = ElemGet v0, v9
    v11 = Integer integer=6
    v12 = ElemGet v0, v11
    PutModuleVariable v11 variable=g0
    v14 = Integer integer=7
    v15 = ElemGet v0, v14
    v16 = Integer integer=8
    v17 = ElemGet v0, v16
    v18 = Integer integer=9
    v19 = ElemGet v0, v18
    v20 = Integer integer=10
    v21 = ElemGet v0, v20
    v22 = Integer integer=11
    v23 = ElemGet v0, v22
    v24 = Integer integer=12
    v25 = ElemGet v0, v24
    v26 = NewArray v2, v4, v6, v8, v10, v12, v15, v17, v19, v21, v23, v25 contents=anything
    Return v26
# CHECK: PutModuleVariable
# CHECK: notTaken b25(v2, v4, v6, v8, v10, v12, v15, v17, v19, v21, v23)
}
