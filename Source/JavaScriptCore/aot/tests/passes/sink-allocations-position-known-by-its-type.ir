# A test of a position is answered on a virtual array where the type of the position says on which side of the end it lies. A read that is kept on the cell has the allocation for its guard, which proves nothing about a position, so the array is not sunk
# FORM: Prepared optimizing
# OPTIONS: check=VerifyEachPass
# RUN: pass SinkAllocations

module m0 path="main.js" displayPath="main.js"

# The first turn of a loop over one of two literals: the position is a parameter that a branch has narrowed to one integer.
function f0 name="oneOfTwoLiterals" parameters=[{type=boolean}, {type=string}, {type=string}, {type=string}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v4 = NewArray v1, v2, v3 contents=string
    Jump -> next b3(v4)
  b2():
    v5 = NewArray v1, v2 contents=string
    Jump -> next b3(v5)
  b3(v6):
    v7 = AssumeType v6 provenType=Array<string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v8 = GetArrayLength v7
    v9 = Integer
    v10 = Less v9, v8
    Branch v10 -> taken b4(| 0), notTaken b7()
  b4(v11):
    v12 = IsInBounds v7, v11
    Branch v12 -> taken b5(| 0), notTaken b6()
  b5(v13):
    v14 = GetArrayElement v7, v11, v13 arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
    Return v14
  b6() frequency=Unlikely:
    v15 = GetArrayElement v7, v11 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v15
  b7():
    Return
# CHECK: [[test0]]: boolean = IsInBounds [[array0]], [[position0]]
# CHECK-NEXT: Branch [[test0]] -> taken [[inside0]](| 0), notTaken
# CHECK: [[inside0]]([[guard0]]: guard):
# CHECK-NEXT: = GetArrayElement [[array0]], [[position0]], [[guard0]] arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
}

function f1 name="oneLiteral" parameters=[{type=string}, {type=string}, {type=int[1, 9]}] results=[{type=anything}] {
    v3 = NewArray v0, v1 contents=string
    v4 = AssumeType v3 provenType=Array<string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v5 = Integer
    v6 = Less v5, v2
    Branch v6 -> taken b1(| 0), notTaken b4()
  b1(v7):
    v8 = IsInBounds v4, v7
    Branch v8 -> taken b2(| 0), notTaken b3()
  b2(v9):
    v10 = GetArrayElement v4, v7, v9 arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
    Return v10
  b3() frequency=Unlikely:
    v11 = GetArrayElement v4, v7 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v11
  b4():
    Return
# CHECK-NOT: NewArray
# CHECK-NOT: IsInBounds
# CHECK: Switch v7 cases=[0] -> case [[join1]](v0), otherwise [[join1]](v1)
}

# The position is inside one of the two literals alone, so the answer is a test of the tag and the way of the read has one variant.
function f2 name="insideTheLongerLiteralAlone" parameters=[{type=boolean}, {type=string}, {type=string}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = NewArray v1, v2 contents=string
    Jump -> next b3(v3)
  b2():
    v4 = NewArray contents=string
    Jump -> next b3(v4)
  b3(v5):
    v6 = AssumeType v5 provenType=Array<string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v7 = GetArrayLength v6
    v8 = Integer
    v9 = Less v8, v7
    Branch v9 -> taken b4(| 0), notTaken b7()
  b4(v10):
    v11 = IsInBounds v6, v10
    Branch v11 -> taken b5(| 0), notTaken b6()
  b5(v12):
    v13 = GetArrayElement v6, v10, v12 arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
    Return v13
  b6() frequency=Unlikely:
    v14 = GetArrayElement v6, v10 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v14
  b7():
    Return
# CHECK-NOT: NewArray
# CHECK-NOT: IsInBounds
# CHECK: [[bit2]]:{{*}}= BitAnd
# CHECK-NEXT: [[isLonger2]]: boolean = ToBoolean [[bit2]]
# CHECK: Switch v10 cases=[0] -> case [[join2]]([[first2]]), otherwise [[join2]]([[second2]])
}

# The read says more of its answer than is known of the elements, so it is kept on the cell.
function f3 name="oneLiteralOfElementsThatMayBeAnything" parameters=[{type=anything}, {type=anything}, {type=int[1, 9]}] results=[{type=anything}] {
    v3 = NewArray v0, v1 contents=string
    v4 = AssumeType v3 provenType=Array<string, proven, Contiguous, pristine[Storage, Names, Dense]>
    v5 = Integer
    v6 = Less v5, v2
    Branch v6 -> taken b1(| 0), notTaken b4()
  b1(v7):
    v8 = IsInBounds v4, v7
    Branch v8 -> taken b2(| 0), notTaken b3()
  b2(v9):
    v10 = GetArrayElement v4, v7, v9 arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
    Return v10
  b3() frequency=Unlikely:
    v11 = GetArrayElement v4, v7 arrayStorage=Contiguous level=Proven [keyIsIntegral]
    Return v11
  b4():
    Return
# CHECK: [[test3]]: boolean = IsInBounds [[array3]], [[position3]]
# CHECK-NEXT: Branch [[test3]] -> taken [[inside3]](| 0), notTaken
# CHECK: [[inside3]]([[guard3]]: guard):
# CHECK-NEXT: = GetArrayElement [[array3]], [[position3]], [[guard3]] arrayStorage=Contiguous level=Proven [keyIsIntegral, isInBounds]
}
