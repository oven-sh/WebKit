# A store through an object that inherits from another ends its walk at a field of that one. It is refused where the field is read-only, as the fields of a frozen object are,
# and it reaches no setter of the name further up. So flow does not publish such a field as never read, though no read reaches it, and the field stays.
# A field of a prototype that is never frozen with nothing of its name above it, and a field of a frozen object that is nobody's prototype, are removed
# FORM: AsRead
# RUN: pipeline RemoveUnreadFields
# OPTIONS: only-passes=ComputeEffectSummaries,ResolveCalls,ResolveAccesses,EliminateDeadCode,RemoveUnreadFields
# STATISTIC: UnreadFieldsRemoved = 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="FrozenPrototype" fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Prototype" fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Frozen" fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L3 name="Top"
layout L4 name="OverSetter" fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Heir"
# CHECK: layout L0 name="FrozenPrototype" {{*}}initialization=SetAtCreation isUnchangedDuringActivation=true
# CHECK: layout L1 name="Prototype" {{*}}initialization=SetAtCreation reads=NeverRead
# CHECK: layout L2 name="Frozen" {{*}}initialization=SetAtCreation reads=NeverRead
# CHECK: layout L4 name="OverSetter" {{*}}initialization=SetAtCreation isUnchangedDuringActivation=true

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = Integer integer=1
    v2 = PropGet v0 key="Object" [isFreeName]
    v3 = PropGet v2 key="freeze"
    v4 = PropGet v2 key="create"
    v5 = NewObject -, v1 layout=L0 fields=[0]
    v6 = Call v3, v2, v5
    v7 = Call v4, v2, v5
    PropSet v7, v1 key="tag" mode=Strict
    v9 = NewObject -, v1 layout=L1 fields=[0]
    v10 = Call v4, v2, v9
    PropSet v10, v1 key="tag" mode=Strict
    v12 = NewObject -, v1 layout=L2 fields=[0]
    v13 = Call v3, v2, v12
    v14 = NewObject layout=L3
    v15 = NewClosure function=f1
    DefineSetter v14, v15 key="tag"
    v17 = FinishObject v14
    v18 = NewObject -, v1 layout=L4 fields=[0]
    SetLiteralPrototype v18, v17
    v20 = FinishObject v18
    v21 = NewObject layout=L5
    SetLiteralPrototype v21, v20
    v23 = FinishObject v21
    PropSet v23, v1 key="tag" mode=Strict
    Return
# CHECK: layout=L0 fields=[0]
# CHECK: = NewObject layout=L1 allocationSite=
# CHECK: = NewObject layout=L2 allocationSite=
# CHECK: layout=L4 fields=[0]
}

function f1 name="tag" kind=Method parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
