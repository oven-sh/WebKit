# The result of Object.create inherits from the object the call was handed, not from Object.prototype: it is no pristine instance of Object, and the test of it stays. The fresh result of another built-in proves the test
# FORM: Prepared
# RUN: pass EliminateGuards
# STATISTIC: GuardsEliminated = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="created" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = CallBuiltin -, v0 overload=ObjectCreate/0
    v2 = IsPristine v1 builtinClass=Object aspects=[Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = Builtin builtin=ObjectPrototypeToString
    Jump -> next b3(v4)
  b2() frequency=Unlikely:
    v5 = PropGet v1 key="toString"
    Jump -> next b3(v5)
  b3(v6):
    Return v6
}
# CHECK-LABEL: function f0 name="created"
# CHECK: v2: boolean = IsPristine v1 builtinClass=Object aspects=[Names]
# CHECK-NEXT: Branch v2 -> taken b1(| 0), notTaken b2()
# CHECK: = PropGet v1 key="toString"
function f1 name="keys" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = CallBuiltin -, v0 overload=ObjectKeys/0
    v2 = IsPristine v1 builtinClass=Array aspects=[Names]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = Builtin builtin=ArrayPrototypePush
    Jump -> next b3(v4)
  b2() frequency=Unlikely:
    v5 = PropGet v1 key="push"
    Jump -> next b3(v5)
  b3(v6):
    Return v6
}
# CHECK-LABEL: function f1 name="keys"
# CHECK-NOT: IsPristine
# CHECK: b2():
# CHECK-NEXT: Unreachable
