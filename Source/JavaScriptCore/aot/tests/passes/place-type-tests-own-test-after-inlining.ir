# A store, a read of a name the layout lacks and a second store meet in one function over several rounds of inlining: the test placed for the read in one round stands between the two stores in the next
# FORM: AsRead
# RUN: compile
# OPTIONS: check=VerifyEachPass

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Three" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}, {key="z" declared={type=anything}}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    PutModuleVariable v3 variable=g0
    Return
}
function f1 name="test" parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything):
    v5 = NewObject -, v4, v3 layout=L0 fields=[0, 2]
    v6 = Integer integer=0
    Jump -> next b1(v5, v6)
  b1(v7, v8):
    LoopHint
    v10 = Integer integer=1
    v11 = Less v8, v10
    Branch v11 -> taken b2(), notTaken b6()
  b2():
    v12 = ToBoolean v2
    Branch v12 -> taken b3(), notTaken b4()
  b3():
    v13 = CallDirect v4, v7 function=f3
    Jump -> next b5(v7)
  b4():
    v14 = CallDirect v0, v1, v4 function=f2
    Jump -> next b5(v14)
  b5(v15):
    v16 = Integer integer=1
    v17 = Add v8, v16
    Jump -> next b1(v15, v17)
  b6():
    Return
}
function f2 name="make" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = ToBoolean v0
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = NewObject -, v2, v2 layout=L0 fields=[1, 0]
    Return v4
  b2():
    v5 = ToBoolean v1
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    v6 = GetModuleVariable variable=g0
    Return v6
  b4():
    v7 = Null
    Return v7
}
function f3 name="storeReadStore" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v0, v1 function=f4
    v3 = PropGet v1 key="w"
    v4 = CallDirect v0, v1 function=f4
    Return
}
function f4 name="storeThroughClosure" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v1, v0 key="y"
    Return
}
# CHECK: image not empty
