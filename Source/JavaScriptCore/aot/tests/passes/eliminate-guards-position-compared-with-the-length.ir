# A position that may be negative is below the length and outside the list.
function f5 name="positionMayBeNegative" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=int[-5, 100]}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number, proven, pristine[Storage, Names]>, v1: int[-5, 100], v2: number):
    v3 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v4 = Less v1, v3
    Branch v4 -> taken b1(| 0), notTaken b4()
  b1(v5: int[-5, 100]):
    v6 = NewArray contents=number
    v7 = IsInBounds v0, v5
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    Return v6
  b3():
    Return v2
  b4():
    Return
}
# CHECK-LABEL: name="positionMayBeNegative"
# CHECK: = Less
# CHECK-NOT: IsInBounds
# CHECK: = NewArray
# CHECK-NEXT: = IsInBounds

# Only another test stands in between. Nothing there writes, so whoever generates code sees that the comparison and the test ask the same: the tests stay in their order.
function f6 name="onlyATestInBetween" parameters=[{type=Array<number, proven, pristine[Storage, Names]>}, {type=int[0, 100]}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<number, proven, pristine[Storage, Names]>, v1: int[0, 100], v2: number):
    v3 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v4 = Less v1, v3
    Branch v4 -> taken b1(| 0), notTaken b5()
  b1(v5: int[0, 100]):
    v6 = HasArrayStorage v0 arrayStorage=Double
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7):
    v8 = IsInBounds v0, v5
    Branch v8 -> taken b3(| 0), notTaken b4()
  b3(v9):
    Return v2
  b4():
    Return v2
  b5():
    Return
}
# CHECK-LABEL: name="onlyATestInBetween"
# CHECK: = Less
# CHECK-NOT: IsInBounds
# CHECK: = HasArrayStorage
# CHECK-COUNT-1: = IsInBounds
