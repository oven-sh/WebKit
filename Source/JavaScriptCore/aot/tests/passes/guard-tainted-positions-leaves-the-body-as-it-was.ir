# To find out what a store takes where every check lets everything through, the pass types the stored value, and what it is made from, without the checks of the body.
# Behind the question the body is what it was: the check tests, and every value has the type that it had, in a loop, in front of a store and where nothing is stored.
# The sum is made from the checked value, so its variable is only expected. The comparison is a boolean whatever it compares, so its variable keeps its type
# FORM: AsRead
# RUN: pass TypeValues GuardTaintedPositions VerifyProgram
# STATISTIC: TaintedPositions = 1
# STATISTIC: ChecksOnTaintedPositions = 0
# CHECK: variable g0 name="sum" module=m0 declared={type=number flags=[IsExpected]}
# CHECK: variable g1 name="isLarge" module=m0 declared={type=boolean}

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="sum" module=m0 declared={type=number} initialization=Uninitialized
variable g1 name="isLarge" module=m0 declared={type=boolean} initialization=Uninitialized

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="given" [isFreeName]
    v2 = Convert v1 declared={type=number}
    v3 = Double number=0.5
    Jump -> next b1(v3)
  b1(v4: number):
    LoopHint
    v6 = Add v4, v2
    v7 = Less v6, v2
    Branch v7 -> taken b1(v6), notTaken b2()
  b2():
    PutModuleVariable v6 variable=g0
    PutModuleVariable v7 variable=g1
    v10 = Mul v2, v2
    v11 = Sub v10, v6
    Return
# CHECK: v2: number = Check v1 expectedType=number
# CHECK: b1(v4: number):
# CHECK: v6: number = Add v4, v2
# CHECK-NEXT: v7: boolean = Less v6, v2
# CHECK: PutModuleVariable v6 variable=g0
# CHECK-NEXT: PutModuleVariable v7 variable=g1
# CHECK-NEXT: v10: number = Mul v2, v2
# CHECK-NEXT: v11: number = Sub v10, v6
}
