# CHECK-NOT: NewObject
# CHECK: b3([[tag0]]: i32, [[list0]]: anything):
# CHECK-NOT: TypeTest
# CHECK: = BitAnd [[tag0]], 
# CHECK: Branch {{*}} -> taken b4(), notTaken b5()
# CHECK: b4():
# CHECK-NEXT: [[null0]]: null = Null
# CHECK-NEXT: Return [[null0]]
# CHECK: b5():
# CHECK-NEXT: v8: anything = Upcast [[list0]] castType=anything

function f1 name="chainOfThree" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Upcast v1 castType=anything
    v3 = TypeTest v2 testedType=object
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4):
    v5 = ToBoolean v4
    Branch v5 -> taken b2(| 0), notTaken b4()
  b2(v6):
    v7 = Null
    v8 = StrictEq v6, v7
    Branch v8 -> taken b4(), notTaken b3(| 0)
  b3(v9):
    v10 = PropGet v9 key="list" receivers=[L0]
    Return v10
  b4():
    Return v0
}
