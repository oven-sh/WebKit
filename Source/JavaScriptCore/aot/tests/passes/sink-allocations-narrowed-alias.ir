# A parameter that an edge fills with the narrowed object is the object
# FORM: Prepared
# RUN: pass SinkAllocations
# STATISTIC: AllocationsRemoved = 4
# STATISTIC: AllocationsSunk = 8

module m0 path="main.js" displayPath="main.js"
typesite w0 kind=Assertion
layout L0 name="Holder" fields=[{key="list" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Other" fields=[{key="list" declared={type=anything} flags=[IsRequired]}]

function f0 name="bothEdgesPassTheObject" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = NewObject -, v0 layout=L0 fields=[0]
    Jump -> next b3(v2)
  b2():
    v3 = Null
    Jump -> next b3(v3)
  b3(v4):
    v5 = TypeTest v4 testedType=null
    Branch v5 -> taken b4(| 0), notTaken b5(| 0)
  b4(v6):
    Return v6
  b5(v7):
    v8 = PropGet v7 key="list" receivers=[L0]
    Return v8
}
