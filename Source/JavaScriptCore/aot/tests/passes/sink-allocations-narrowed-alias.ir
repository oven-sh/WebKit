# CHECK-NOT: NewObject
# CHECK-NOT: Branch
# CHECK: Jump -> next b1()
# CHECK: Jump -> next b2()
# CHECK: Jump -> next b3()
# CHECK: b3():
# CHECK-NEXT: v10: anything = Upcast v0 castType=anything

