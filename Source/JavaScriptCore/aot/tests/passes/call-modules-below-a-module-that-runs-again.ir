# The host loads a test file several times in one realm under `bun test --rerun-each`, and what the file imports runs once.
# So what such a module imports has a state, though only this module comes to it: the second run reads there that it has run. What lies below that is run with it, as ever.
# FORM: Prepared
# RUN: pass CallModules
# STATISTIC: ModulesWithState = 2
# STATISTIC: ModulesWithoutState = 1
# CHECK: outcome: Changed

variable g0 name="calls" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="deep" module=m2 declared={type=anything} initialization=Undefined
module m0 path="/a.test.js" displayPath="a.test.js" flags=[RunsAgain] body=f0 requests=[{target=m1 completes=true}]
module m1 path="/counter.js" displayPath="counter.js" body=f1 requests=[{target=m2 completes=true}] exports=[{name="calls" variable=g0}]
module m2 path="/deep.js" displayPath="deep.js" body=f2 exports=[{name="deep" variable=g1}]
entry module=m0
# CHECK: module m0 {{*}}flags=[RunsAgain, EvaluatesItself] body=f0
# CHECK: module m1 {{*}}flags=[EvaluatesItself] body=f1
# CHECK: module m2 path="/deep.js" displayPath="deep.js" exports=

function f0 name="test" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    Return
}
# CHECK-LABEL: function f0 name="test"
# CHECK: BeginModuleEvaluation module=m0
# CHECK: = CallDirect function=f1
# CHECK: FinishModuleEvaluation module=m0
function f1 name="counter" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=0
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-LABEL: function f1 name="counter"
# CHECK: BeginModuleEvaluation module=m1
# CHECK: = CallDirect function=f2
# CHECK: FinishModuleEvaluation module=m1
function f2 name="deep" module=m2 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
# CHECK-LABEL: function f2 name="deep"
# CHECK-NOT: ModuleEvaluation
