# CHECK-LABEL: function f11 name="proven-callee"
# CHECK-NEXT: b0(v0: f1, v1: anything):
# CHECK-NEXT: = Call v0, -, v1
# CHECK-NEXT: Return v2
# CHECK-NEXT: }
function f12 name="no-function-in-the-type" parameters=[{type=string}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: anything):
    v2 = Predict v0 predicted=f1
    v3 = Call v2, -, v1
    Return v3
}
# CHECK-LABEL: function f12 name="no-function-in-the-type"
# CHECK-NOT: IsClosureOf
function f13 name="no-prediction" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    Return v2
}
# CHECK-LABEL: function f13 name="no-prediction"
