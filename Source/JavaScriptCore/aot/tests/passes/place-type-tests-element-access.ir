# An access by key on a receiver expected to be an array or a typed array gets the tests of its class, of its elements and of its storage kind, and becomes an element operation under them. Where the kind is known and nothing asks whether the element is there, a read tests that it is, which takes the place of the test of the elements
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# STATISTIC: TypeTestsPlaced = 35

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="expectedInt32Array" parameters=[{type=Array<i32, Int32> flags=[IsExpected]}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f0 name="expectedInt32Array"
# CHECK: [[isArray0]]:{{*}}= TypeTest v0 testedType=Array
# CHECK-NEXT: Branch [[isArray0]] -> taken [[arrayBlock0]](| 0), notTaken
# CHECK: [[presentBlock0]]([[present0]]: guard):
# CHECK: [[guard0]]: guard = AllGuards [[storage0]], [[present0]]
# CHECK-NEXT: v2: i32 = GetArrayElement [[array0]], v1, [[guard0]] arrayStorage=Int32 level=Expected [keyIsIntegral, isPresent]
# CHECK-NEXT: Return v2
# CHECK-NEXT: frequency=Unlikely:
# CHECK-NEXT: [[generic0]]:{{*}}= ElemGet v0, v1
# CHECK-NEXT: Return [[generic0]]
# CHECK: [[arrayBlock0]]([[array0]]: Array<i32>):
# CHECK-NEXT: [[hasStorage0]]: boolean = HasArrayStorage [[array0]] arrayStorage=Int32
# CHECK-NEXT: Branch [[hasStorage0]] -> taken [[storageBlock0]](| 0), notTaken
# CHECK: [[storageBlock0]]([[storage0]]: guard):
# CHECK-NEXT: [[isPresent0]]: boolean = IsElementPresent [[array0]], v1, [[storage0]] arrayStorage=Int32
# CHECK-NEXT: Branch [[isPresent0]] -> taken [[presentBlock0]](| 0), notTaken

function f1 name="expectedArrayWithoutKind" parameters=[{type=Array<anything> flags=[IsExpected]}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<anything>, v1: int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f1 name="expectedArrayWithoutKind"
# CHECK-NOT: HasArrayStorage
# CHECK: ([[pristine1]]: guard):
# CHECK-NOT: HasArrayStorage
# CHECK: v2: anything = GetArrayElement [[array1]], v1, [[pristine1]] level=Expected
# CHECK-NOT: HasArrayStorage
# CHECK: ([[array1]]: Array):
# CHECK-NEXT: = IsPristine [[array1]] builtinClass=Array aspects=[Storage]
# CHECK-NOT: HasArrayStorage

function f2 name="keyExpectedNumber" parameters=[{type=Array<i32, Int32> flags=[IsExpected]}, {type=int[0, 1000] flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: anything ~ int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f2 name="keyExpectedNumber"
# CHECK: = TypeTest v0 testedType=Array
# CHECK: = GetArrayElement [[array2]], [[key2]], [[guard2]] arrayStorage=Int32 level=Expected
# CHECK: [[hasStorage2]]: boolean = HasArrayStorage [[array2]] arrayStorage=Int32
# CHECK-NEXT: Branch [[hasStorage2]] -> taken [[storageBlock2]](| 0), notTaken
# CHECK: [[storageBlock2]]([[storage2]]: guard):
# The test asks for an int32 and not for the range in the expected type, as the test of an operator does.
# CHECK-NEXT: [[isNumber2]]:{{*}}= TypeTest v1 testedType=i32
# CHECK-NEXT: Branch [[isNumber2]] -> taken [[keyBlock2]](| 0), notTaken
# CHECK: [[keyBlock2]]([[key2]]: i32{{*}}):
# CHECK-NEXT: = IsElementPresent [[array2]], [[key2]], [[storage2]] arrayStorage=Int32
# CHECK-NOT: = TypeTest
# CHECK-NOT: = IsPristine
# CHECK-NOT: = HasArrayStorage

function f3 name="loopOfReads" parameters=[{type=Array<i32, Int32> flags=[IsExpected]}, {type=int[0, 1000]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000], v2: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ElemGet v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return v4
}
# CHECK-LABEL: function f3 name="loopOfReads"
# CHECK: Jump -> next [[tests3]]()
# CHECK-NEXT: [[loop3]]():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[guard3]]: guard = AllGuards [[storage3]], [[present3]]
# CHECK-NEXT: v4: i32 = GetArrayElement [[array3]], v1, [[guard3]] arrayStorage=Int32 level=Expected
# CHECK-NEXT: Branch v2 -> taken [[loop3]](), notTaken
# CHECK: [[tests3]]():
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK-NOT: = TypeTest
# CHECK: LoopHint
# CHECK-NEXT: = ElemGet v0, v1
# CHECK: ([[array3]]: Array<i32>):
# CHECK-NEXT: = HasArrayStorage [[array3]] arrayStorage=Int32
# CHECK-NOT: = HasArrayStorage
# CHECK: ([[storage3]]: guard):
# CHECK-NEXT: = IsElementPresent [[array3]], v1, [[storage3]] arrayStorage=Int32
# CHECK-NOT: = IsElementPresent
# CHECK: ([[present3]]: guard):
# CHECK-NEXT: Jump -> next [[loop3]]()

function f4 name="storeInLoop" parameters=[{type=Array<i32, Int32> flags=[IsExpected]}, {type=int[0, 1000]}, {type=i32}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000], v2: i32, v3: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    ElemSet v0, v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f4 name="storeInLoop"
# CHECK: Jump -> next [[tests4]]()
# CHECK-NEXT: [[loop4]]():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[hasStorage4]]: boolean = HasArrayStorage [[array4]] arrayStorage=Int32
# CHECK-NEXT: Branch [[hasStorage4]] -> taken [[storageBlock4]](| 0), notTaken
# CHECK: [[tests4]]():
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK: [[storageBlock4]]([[storage4]]: guard):
# CHECK: [[guard4]]: guard = AllGuards [[pristine4]], [[storage4]]
# CHECK-NEXT: PutArrayElement [[array4]], v1, v2, [[guard4]] arrayStorage=Int32 level=Expected
# CHECK-NEXT: Branch v3 -> taken [[loop4]](), notTaken
# CHECK: ElemSet v0, v1, v2
# CHECK: ([[array4]]: Array<i32>):
# CHECK-NEXT: = IsPristine [[array4]] builtinClass=Array aspects=[Storage]
# CHECK: ([[pristine4]]: guard):
# CHECK-NEXT: Jump -> next [[loop4]]()

