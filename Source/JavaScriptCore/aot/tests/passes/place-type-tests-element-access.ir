    v2 = IsPristine v0 builtinClass=Array aspects=[Storage]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = GetArrayElement v0, v1, v3 level=Predicted
    Return v4
  b2():
    Return
}
