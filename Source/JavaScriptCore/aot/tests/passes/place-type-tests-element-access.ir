# CHECK-NOT: HasArrayStorage

function f2 name="keyPredictedNumber" parameters=[{type=anything predicted=Array<i32, Int32>}, {type=anything predicted=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: anything ~ int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f2 name="keyPredictedNumber"
# CHECK: = TypeTest v0 testedType=Array
# CHECK: = GetArrayElement [[array2]], [[key2]], [[guard2]] arrayStorage=Int32 level=Predicted
# CHECK: = IsPristine [[array2]] builtinClass=Array
# CHECK: [[hasStorage2]]: boolean = HasArrayStorage [[array2]] arrayStorage=Int32
# CHECK-NEXT: Branch [[hasStorage2]] -> taken [[storageBlock2]](| 0), notTaken
# CHECK: [[storageBlock2]]({{*}}: guard):
# The range in the prediction is what flow happened to see: the test asks for an int32, as the test of an operator does.
# CHECK-NEXT: [[isNumber2]]:{{*}}= TypeTest v1 testedType=i32
# CHECK-NEXT: Branch [[isNumber2]] -> taken [[keyBlock2]](| 0), notTaken
# CHECK: [[keyBlock2]]([[key2]]: i32{{*}}):
# CHECK-NOT: = TypeTest
# CHECK-NOT: = IsPristine
# CHECK-NOT: = HasArrayStorage

function f3 name="loopOfReads" parameters=[{type=anything predicted=Array<i32, Int32>}, {type=int[0, 1000]}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000], v2: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ElemGet v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return v4
}
# CHECK-LABEL: function f3 name="loopOfReads"
# CHECK: Jump -> next [[tests3]]()
# CHECK-NEXT: [[loop3]]():
# CHECK-NEXT: LoopHint
# CHECK-NEXT: [[guard3]]: guard = AllGuards [[pristine3]], [[storage3]]
# CHECK-NEXT: v4: undefined|i32 = GetArrayElement [[array3]], v1, [[guard3]] arrayStorage=Int32 level=Predicted
# CHECK-NEXT: Branch v2 -> taken [[loop3]](), notTaken
# CHECK: [[tests3]]():
# CHECK-NEXT: = TypeTest v0 testedType=Array
# CHECK-NOT: = TypeTest
# CHECK: [[copy3]]() frequency=Unlikely:
# CHECK-NEXT: LoopHint
# CHECK-NEXT: = ElemGet v0, v1
# CHECK-NEXT: Branch v2 -> taken [[copy3]](), notTaken
# CHECK: ([[array3]]: Array<i32>):
# CHECK-NEXT: = IsPristine [[array3]] builtinClass=Array aspects=[Storage]
# CHECK-NOT: = IsPristine
# CHECK: ([[pristine3]]: guard):
# CHECK-NEXT: = HasArrayStorage [[array3]] arrayStorage=Int32
# CHECK-NOT: = HasArrayStorage
# CHECK: ([[storage3]]: guard):
# CHECK-NEXT: Jump -> next [[loop3]]()

function f4 name="storeInLoop" parameters=[{type=anything predicted=Array<i32, Int32>}, {type=int[0, 1000]}, {type=i32}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000], v2: i32, v3: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    ElemSet v0, v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b2():
    Return
}
