# An access by key on a receiver predicted to be an array or a typed array gets the tests of its class, of its elements and of its storage kind, and becomes an element operation under them
# FORM: Prepared optimizing
# RUN: pass PlaceTypeTests
# STATISTIC: TypeTestsPlaced = 34

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="predictedInt32Array" parameters=[{type=anything predicted=Array<i32, Int32>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<i32, Int32>, v1: int[0, 1000]):
    v2 = ElemGet v0, v1
    Return v2
}
# CHECK-LABEL: function f0 name="predictedInt32Array"
# CHECK: [[isArray0]]:{{*}}= TypeTest v0 testedType=Array
# CHECK-NEXT: Branch [[isArray0]] -> taken [[arrayBlock0]](| 0), notTaken
# CHECK: [[guard0]]: guard = AllGuards [[pristine0]], [[storage0]]
# CHECK-NEXT: v2: undefined|i32 = GetArrayElement [[array0]], v1, [[guard0]] arrayStorage=Int32 level=Predicted
# CHECK-NEXT: Return v2
# CHECK-NEXT: frequency=Unlikely:
# CHECK-NEXT: [[generic0]]:{{*}}= ElemGet v0, v1
# CHECK-NEXT: Return [[generic0]]
# CHECK: [[arrayBlock0]]([[array0]]: Array<i32>):
# CHECK-NEXT: [[isPristine0]]: boolean = IsPristine [[array0]] builtinClass=Array aspects=[Storage]
# CHECK-NEXT: Branch [[isPristine0]] -> taken [[pristineBlock0]](| 0), notTaken
# CHECK: [[pristineBlock0]]([[pristine0]]: guard):
# CHECK-NEXT: [[hasStorage0]]: boolean = HasArrayStorage [[array0]] arrayStorage=Int32
# CHECK-NEXT: Branch [[hasStorage0]] -> taken [[storageBlock0]](| 0), notTaken
# CHECK: [[storageBlock0]]([[storage0]]: guard):

function f1 name="predictedArrayWithoutKind" parameters=[{type=anything predicted=Array<anything>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: anything ~ Array<anything>, v1: int[0, 1000]):
