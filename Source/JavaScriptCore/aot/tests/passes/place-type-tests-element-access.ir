function f13 name="alreadyResolved" parameters=[{type=Array<i32>}, {type=int[0, 1000]}] results=[{type=anything}] {
  b0(v0: Array<i32> ~ Array<i32, Int32>, v1: int[0, 1000]):
    v2 = IsPristine v0 builtinClass=Array aspects=[Storage]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = GetArrayElement v0, v1, v3 level=Expected
    Return v4
  b2():
    Return
}
# CHECK-LABEL: function f13 name="alreadyResolved"
# CHECK-NEXT: b0(
# CHECK-NEXT: v2: boolean = IsPristine v0 builtinClass=Array aspects=[Storage]
# CHECK-NEXT: Branch v2 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v3: guard):
# CHECK-NEXT: = GetArrayElement v0, v1, v3 level=Expected
# CHECK-NEXT: Return v4
# CHECK-NEXT: b2():
# CHECK-NEXT: Return
# CHECK-NEXT: }

