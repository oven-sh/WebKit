# A subject that by its type is one of the listed integers leaves nothing for the rest: the last case is asked for no more and takes the place of the rest
# FORM: Prepared
# RUN: pass SimplifyControlFlow
# CHECK: outcome: Changed
# RUN(AGAIN): pass SimplifyControlFlow SimplifyControlFlow
# AGAIN: outcome: Changed
# AGAIN-NEXT: outcome: Unchanged

module m0 path="main.js" displayPath="main.js"

function f0 name="everyIntegerIsListed" parameters=[{type=int[0, 2]}, {type=number}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b4()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
  b4():
    Return v4
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
# CHECK: Return v3
# CHECK-NOT: Return v4
}

function f1 name="listedInAnotherOrder" parameters=[{type=int[-1, 1]}, {type=number}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[1, -1, 0] -> case b1(), case b2(), case b3(), otherwise b4()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
  b4():
    Return v4
# CHECK: Switch v0 cases=[1, -1] -> case b1(), case b2(), otherwise b3()
# CHECK-NOT: Return v4
}

function f2 name="whatTheRestPassesGoesAway" parameters=[{type=int[0, 1]}, {type=number}, {type=number}] results=[{type=undefined|number}] {
    v3 = Undefined
    Switch v0 cases=[0, 1] -> case b1(v1), case b1(v2), otherwise b1(v3)
  b1(v4):
    Return v4
# CHECK: Switch v0 cases=[0] -> case b1(v1), otherwise b1(v2)
}

function f3 name="oneIntegerIsNotListed" parameters=[{type=int[0, 3]}, {type=number}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b4()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
  b4():
    Return v4
# CHECK: Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK: Return v4
}

function f4 name="mayBeNoInteger" parameters=[{type=undefined|int[0, 1]}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
# CHECK: Return v3
}

function f5 name="mayBeNegativeZero" parameters=[{type=int[0, 1]|whole}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
# CHECK: Return v3
}

function f6 name="oneCaseGoesTheWayOfTheRest" parameters=[{type=int[0, 2]}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b3()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(), otherwise b3()
# CHECK: Return v3
}

function f7 name="theLastCasePassesWhatItProves" parameters=[{type=int[0, 1]}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1] -> case b1(), case b2(| 0), otherwise b3()
  b1():
    Return v1
  b2(v3):
    Return v3
  b3():
    Return v2
# CHECK: Switch v0 cases=[0, 1] -> case b1(), case b2(| 0), otherwise b3()
}

function f8 name="theWayThatMostCasesTake" parameters=[{type=int[0, 2]}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b1(), otherwise b3()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
# CHECK: Switch v0 cases=[1] -> case b2(), otherwise b1()
# CHECK-NOT: Return v3
}

function f9 name="everyCaseGoesOneWay" parameters=[{type=int[0, 1]}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1] -> case b1(), case b1(), otherwise b2()
  b1():
    Return v1
  b2():
    Return v2
# CHECK-NOT: Switch
# CHECK: Return v1
# CHECK-NOT: Return v2
}


# Enough integers for a window of bits, and several of them go one way: each stays listed.
function f10 name="severalOfManyGoOneWay" parameters=[{type=int[0, 3]}, {type=number}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2, 3] -> case b1(), case b2(), case b1(), case b3(), otherwise b4()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
  b4():
    Return v4
# CHECK: Switch v0 cases=[0, 1, 2, 3] -> case b1(), case b2(), case b1(), case b3(), otherwise b4()
}

function f11 name="eachOfManyGoesItsOwnWay" parameters=[{type=int[0, 3]}, {type=number}, {type=number}, {type=number}, {type=number}, {type=number}] results=[{type=number}] {
    Switch v0 cases=[0, 1, 2, 3] -> case b1(), case b2(), case b3(), case b4(), otherwise b5()
  b1():
    Return v1
  b2():
    Return v2
  b3():
    Return v3
  b4():
    Return v4
  b5():
    Return v5
# CHECK: Switch v0 cases=[0, 1, 2] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK-NOT: Return v5
}
