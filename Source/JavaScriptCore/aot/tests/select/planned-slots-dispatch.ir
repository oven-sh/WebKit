# Where the receivers of a slot operation hold the field in several places, the operation becomes a dispatch on the layouts that the type of the receiver lists: the layouts that hold it in one place are one arm, and each arm has a copy of the operation over its own layouts on the receiver as its test narrowed it
# FORM: Prepared
# OPTIONS: references=narrow testing=NoLayoutIsMadeSeldom
# RUN: pass Select
# RUN(PLACE): pass Select NumberAndEncode PlaceSiteCaches CheckPlacement
# STATISTIC: PlannedSlotsGroups = 7

module m0 path="main.js" displayPath="main.js"
layout L0 name="Text" fields=[{key="value" declared={type=undefined|string}}, {key="pad" declared={type=number}}] flow={members=[L0]}
layout L1 name="Count" fields=[{key="value" declared={type=undefined|number}}] flow={members=[L1]}
layout L2 name="Label" fields=[{key="value" declared={type=undefined|string}}, {key="pad" declared={type=number}}] flow={members=[L2]}

function f0 name="read" parameters=[{type=L0|L1|L2}] results=[{type=anything}] {
    v1 = GetSlotOrUndefined v0 key="value" receivers=[L0, L1, L2] level=Proven
    Return v1
# CHECK-NEXT: b0(v0: L0|L1|L2):
# CHECK-NEXT: [[isTextOfRead]]: boolean = TypeTest v0 testedType=L0|L2
# CHECK-NEXT: TestAndBranch [[isTextOfRead]] -> taken [[textsOfRead]](| 0), notTaken [[countsOfRead]](| 0)
# CHECK-NEXT: [[textsOfRead]]([[textObjectOfRead]]: L0|L2):
# CHECK-NEXT: [[textOfRead]]: undefined|string = GetSlotOrUndefined [[textObjectOfRead]] key="value" receivers=[L0, L2] level=Proven
# CHECK-NEXT: Return [[textOfRead]]
# CHECK-NEXT: [[countsOfRead]]([[countObjectOfRead]]: L1):
# CHECK-NEXT: [[countOfRead]]: undefined|null|number = GetSlotOrUndefined [[countObjectOfRead]] key="value" receivers=[L1] level=Proven
# CHECK-NEXT: Return [[countOfRead]]
# CHECK-NOT: Unreachable
}
function f1 name="store" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = Undefined
    PutSlotOrAdd v0, -, v1 key="value" receivers=[L0, L1] level=Proven
    Return
# CHECK: [[isTextOfStore]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: TestAndBranch [[isTextOfStore]] -> taken [[textsOfStore]](| 0), notTaken [[countsOfStore]](| 0)
# CHECK-NEXT: [[textsOfStore]]([[textObjectOfStore]]: L0):
# CHECK-NEXT: PutSlotOrAdd [[textObjectOfStore]], -, v1 key="value" receivers=[L0] level=Proven
# CHECK-NEXT: Jump -> next [[afterOfStore]]()
# CHECK-NEXT: [[countsOfStore]]([[countObjectOfStore]]: L1):
# CHECK-NEXT: PutSlotOrAdd [[countObjectOfStore]], -, v1 key="value" receivers=[L1] level=Proven
# CHECK-NEXT: Jump -> next [[afterOfStore]]()
# CHECK-NOT: receivers=[L0, L1]
}

# A branch passes the proofs of the test it names, so each arm ends in a copy of the branch. The read of the slot that the test has found filled stands in the arm of the test: one access has one dispatch.
function f2 name="test" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="value" receivers=[L0, L1] level=Proven
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v0, v2 key="value" receivers=[L0, L1] level=Proven
    Return v3
  b2():
    Return
# CHECK-NEXT: b0(v0: L0|L1):
# CHECK-NEXT: [[isTextOfTest]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: TestAndBranch [[isTextOfTest]] -> taken [[textsOfTest]](| 0), notTaken [[countsOfTest]](| 0)
# CHECK-NEXT: [[textsOfTest]]([[textObjectOfTest]]: L0):
# CHECK-NEXT: [[hasTextOfTest]]: boolean = IsSlotFilled [[textObjectOfTest]] key="value" receivers=[L0] level=Proven
# CHECK-NEXT: TestAndBranch [[hasTextOfTest]] -> taken [[filledTexts]](| 0), notTaken [[emptyOfTest]]()
# CHECK-NEXT: [[filledTexts]]([[isFilledText]]: guard):
# CHECK-NEXT: = GetSlot [[textObjectOfTest]], [[isFilledText]] key="value" receivers=[L0] level=Proven
# CHECK-NEXT: Return
# CHECK-NEXT: [[countsOfTest]]([[countObjectOfTest]]: L1):
# CHECK-NEXT: [[hasCountOfTest]]: boolean = IsSlotFilled [[countObjectOfTest]] key="value" receivers=[L1] level=Proven
# CHECK-NEXT: TestAndBranch [[hasCountOfTest]] -> taken [[filledCounts]](| 0), notTaken [[emptyOfTest]]()
# CHECK-NEXT: [[filledCounts]]([[isFilledCount]]: guard):
# CHECK-NEXT: = GetSlot [[countObjectOfTest]], [[isFilledCount]] key="value" receivers=[L1] level=Proven
# CHECK-NEXT: Return
# CHECK-NOT: TypeTest
# CHECK-NOT: receivers=[L0, L1]
}

function f3 name="test-as-value" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="value" receivers=[L0, L1] level=Proven
    Return v1
# CHECK: [[isTextAsValue]]: boolean = TypeTest v0 testedType=L0
# CHECK-NEXT: TestAndBranch [[isTextAsValue]] -> taken [[textsAsValue]](| 0), notTaken [[countsAsValue]](| 0)
# CHECK-NEXT: [[textsAsValue]]([[textAsValue]]: L0):
# CHECK-NEXT: = IsSlotFilled [[textAsValue]] key="value" receivers=[L0] level=Proven
# CHECK: [[countsAsValue]]([[countAsValue]]: L1):
# CHECK-NEXT: = IsSlotFilled [[countAsValue]] key="value" receivers=[L1] level=Proven
# CHECK-NOT: receivers=[L0, L1]
}

# Two layouts that hold the field in one place need no dispatch.
function f4 name="one-location" parameters=[{type=L0|L2}] results=[{type=anything}] {
    v1 = GetSlotOrUndefined v0 key="value" receivers=[L0, L2] level=Proven
    Return v1
# CHECK-NEXT: b0(v0: L0|L2):
# CHECK-NEXT: v1: undefined|string = GetSlotOrUndefined v0 key="value" receivers=[L0, L2] level=Proven
# CHECK-NEXT: Return v1
}

# What comes behind the read is not copied: the arms meet there.
function f5 name="test-and-go-on" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="value" receivers=[L0, L1] level=Proven
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = GetSlot v0, v2 key="value" receivers=[L0, L1] level=Proven
    v4 = TypeOf v3
    Return v4
  b2():
    Return
# CHECK: TypeTest v0 testedType=L0
# CHECK-NOT: TypeTest
# CHECK: [[textOfGoOn]]: {{*}} = GetSlot {{*}} receivers=[L0] level=Proven
# CHECK-NEXT: Jump -> next [[afterOfGoOn]]([[textOfGoOn]])
# CHECK-NOT: TypeTest
# CHECK: [[countOfGoOn]]: {{*}} = GetSlot {{*}} receivers=[L1] level=Proven
# CHECK-NEXT: Jump -> next [[afterOfGoOn]]([[countOfGoOn]])
# CHECK-NOT: TypeTest
# CHECK: = TypeOf
# CHECK-NOT: TypeOf
}

# A store takes what it stores, and the guards it needs, into the arm with it.
function f6 name="test-and-store" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="value" receivers=[L0, L1] level=Proven
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = AllGuards v2
    v4 = Undefined
    PutSlot v0, v3, v4 key="value" receivers=[L0, L1] level=Proven
    Return
  b2():
    Return
# CHECK: TypeTest v0 testedType=L0
# CHECK-NOT: TypeTest
# CHECK: PutSlot {{*}} key="value" receivers=[L0] level=Proven
# CHECK-NOT: TypeTest
# CHECK: PutSlot {{*}} key="value" receivers=[L1] level=Proven
# CHECK-NOT: TypeTest
# CHECK-NOT: receivers=[L0, L1]
}

# The value is tested in front of the slot, so that the test of the slot and the store have one dispatch.
function f7 name="test-slot-and-value-and-store" parameters=[{type=L0|L1}, {type=anything}] results=[{type=anything}] {
    v2 = IsSlotFilled v0 key="value" receivers=[L0, L1] level=Proven
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3):
    v4 = TypeTest v1 testedType=undefined
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    PutSlot v0, v3, v5 key="value" receivers=[L0, L1] level=Proven
    Return
  b3():
    Return
# CHECK-NEXT: b0(v0: L0|L1, v1: anything):
# CHECK-NEXT: = TypeTest v1 testedType=undefined
# CHECK: TypeTest v0 testedType=L0
# CHECK-NOT: TypeTest
# CHECK: PutSlot {{*}} key="value" receivers=[L0] level=Proven
# CHECK-NOT: TypeTest
# CHECK: PutSlot {{*}} key="value" receivers=[L1] level=Proven
# CHECK-NOT: TypeTest
# CHECK-NOT: receivers=[L0, L1]
}

# PLACE: access 0 "value" {L0 L2} read EveryMember
# PLACE-NEXT: access 1 "value" {L0} read EveryMember
# PLACE-NEXT: access 2 "value" {L0} store EveryMember
# PLACE-NEXT: access 3 "value" {L1} read EveryMember
# PLACE-NEXT: access 4 "value" {L1} store EveryMember
# PLACE-NOT: access
