# With the rule disabled a match against a literal stays the inline built-in
# FORM: Prepared
# OPTIONS: disable=rule:RegExpLiteralMatch
# STATISTIC: RegExpLiteralMatchGroups = 0
# RUN: pass Select
# CHECK-NOT: RegExpMatchLiteral

module m0 path="main.js" displayPath="main.js"
function f0 name="test" parameters=[{type=RegExp<"a+b"[], pristine[Storage, Names, AsCreated]>}, {type=string}] results=[{type=anything}] {
    v2 = CallBuiltin v0, v1 overload=RegExpPrototypeTest/0
    Return v2
}
