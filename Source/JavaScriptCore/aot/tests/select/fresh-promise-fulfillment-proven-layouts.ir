# A new promise resolved with an object is fulfilled without a test where the type proves that a lookup of `then` finds nothing. A layout that holds `then` or may gain a name keeps the test, which reads what the resolution reads
# FORM: Prepared
# OPTIONS: heat=everything-is-hot
# STATISTIC: FreshPromiseFulfillmentGroups = 4
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
layout L0 name="HoldsThen" fields=[{key="then" declared={type=undefined|f3} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None members=[L0] impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] addedKeysAreComplete=true ownAccessorsAreComplete=true}
layout L1 name="Record" fields=[{key="done" declared={type=boolean} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None members=[L1] impossibleMutations=[ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] addedKeysAreComplete=true ownAccessorsAreComplete=true}
layout L2 name="OpenRecord" fields=[{key="done" declared={type=boolean} flags=[IsRequired] flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation} prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None members=[L2] impossibleMutations=[DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType]}
function f0 name="numberOrHolderOfThen" parameters=[{type=1|L0}] results=[{type=Promise}] {
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
# CHECK: [[notThenable0]]: boolean = IsNotThenable v0
# CHECK-NEXT: Branch [[notThenable0]] -> taken [[fast0]](| 0), notTaken [[slow0]]()
# CHECK: [[fast0]]([[guard0]]: guard):
# CHECK-NEXT: FulfillFreshPromise v1, v0, [[guard0]]
}

function f1 name="recordWithoutThen" parameters=[{type=L1}] results=[{type=Promise}] {
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
# CHECK-NOT: IsNotThenable
# CHECK: FulfillFreshPromise v1, v0
# CHECK-NOT: ResolvePromise
}

function f2 name="numberNeedsNoTest" parameters=[{type=number}] results=[{type=Promise}] {
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
# CHECK-NOT: IsNotThenable
# CHECK: FulfillFreshPromise v1, v0
# CHECK-NOT: ResolvePromise
}

function f3 name="then" kind=Method parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Undefined
    Return v1
}

function f4 name="recordThatMayGainNames" parameters=[{type=L2}] results=[{type=Promise}] {
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
# CHECK: [[notThenable4]]: boolean = IsNotThenable v0
# CHECK-NEXT: Branch [[notThenable4]] -> taken [[fast4]](| 0), notTaken [[slow4]]()
# CHECK: [[fast4]]([[guard4]]: guard):
# CHECK-NEXT: FulfillFreshPromise v1, v0, [[guard4]]
}
