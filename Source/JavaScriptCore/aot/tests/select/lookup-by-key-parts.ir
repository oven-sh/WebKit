    v6 = CallBuiltin v0, v5, v4 overload=MapPrototypeSet/0
    v7 = Strcat v3, v2 [isLikelyKey]
    v8 = CallBuiltin v1, v7 overload=SetPrototypeAdd/0
    v9 = NewArray v6, v8 contents=anything
    Return v9
