# The string is needed for the second lookup, so it is created for both
function f9 name="keyOfTwoLookups" parameters=[{type=Map}, {type=string}, {type=string}] results=[{type=anything}] {
    v3 = Strcat v1, v2 [isLikelyKey]
    v4 = CallBuiltin v0, v3 overload=MapPrototypeHas/0
    v5 = CallBuiltin v0, v3 overload=MapPrototypeGet/0
    v6 = NewArray v4, v5 contents=anything
    Return v6
# CHECK-NOT: ByKeyParts
# CHECK: v3: string = Strcat v1, v2 [isLikelyKey]
# CHECK-NEXT: v4: {{*}} = CallInline v0, v3 inlineBuiltin=MapHas overload=MapPrototypeHas/0
# CHECK-NEXT: v5: {{*}} = CallInline v0, v3 inlineBuiltin=MapGet overload=MapPrototypeGet/0
# CHECK-NOT: ByKeyParts
}

# A number that is not an integer prints in another way than the digits of an int32. The lookup beside it has an int32 in the same place
