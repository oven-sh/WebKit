    v4 = CallBuiltin v0, v3 overload=MapPrototypeGet/0
    v5 = Strcat v1, v2, v1, v2, v1, v2, v1, v2 [isLikelyKey]
    v6 = CallBuiltin v0, v5 overload=MapPrototypeGet/0
    v7 = NewArray v4, v6 contents=anything
    Return v7
# CHECK-NEXT: b0(
# CHECK-NEXT: [[key16]]: string = Strcat v1, v2, v1, v2, v1, v2, v1, v2, v1 [isLikelyKey]
