# Each key goes with its own lookup
function f17 name="twoKeysOfTwoLookups" parameters=[{type=Map}, {type=string}, {type=string}] results=[{type=anything}] {
    v3 = Strcat v1, v2 [isLikelyKey]
    v4 = CallBuiltin v0, v3 overload=MapPrototypeGet/0
    v5 = Strcat v2, v1 [isLikelyKey]
    v6 = CallBuiltin v0, v5 overload=MapPrototypeHas/0
    v7 = NewArray v4, v6 contents=anything
    Return v7
# CHECK-NEXT: b0(
# CHECK-NEXT: [[first17]]: {{*}} = MapGetByKeyParts v0, v1, v2
# CHECK-NEXT: [[second17]]: boolean = HasByKeyParts v0, v2, v1
# CHECK-NEXT: = NewArray [[first17]], [[second17]]
}

# `return map.get(a + b)`
function f18 name="lookupWasInTailPosition" parameters=[{type=Map}, {type=Set}, {type=string}, {type=string}, {type=boolean}] results=[{type=anything}] {
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = Strcat v2, v3 [isLikelyKey]
    v6 = CallBuiltin v0, v5 overload=MapPrototypeGet/0 @0 tail
    Return v6
  b2():
    v7 = Strcat v2, v3 [isLikelyKey]
    v8 = CallBuiltin v1, v7 overload=SetPrototypeHas/0 @0 tail
    Return v8
# CHECK-NOT: Strcat
# CHECK: b1():
# CHECK-NEXT: [[inMap18]]: {{*}} = MapGetByKeyParts v0, v2, v3
# CHECK-NEXT: Return [[inMap18]]
# CHECK-NEXT: b2(
# CHECK-NEXT: [[inSet18]]: boolean = HasByKeyParts v1, v2, v3
# CHECK-NEXT: Return [[inSet18]]
}

