    v4 = Strcat v1, v2 [isLikelyKey]
    v5 = CallBuiltin v0, v4 overload=MapPrototypeGet/0
    v6 = Strcat v1, v3 [isLikelyKey]
    v7 = CallBuiltin v0, v6 overload=MapPrototypeGet/0
    v8 = NewArray v5, v7 contents=anything
    Return v8
# CHECK-NEXT: b0(
# CHECK-NEXT: [[key10]]: string = Strcat v1, v2 [isLikelyKey]
# CHECK-NEXT: [[byString10]]: {{*}} = CallInline v0, [[key10]] inlineBuiltin=MapGet overload=MapPrototypeGet/0
# CHECK-NEXT: [[byParts10]]: {{*}} = MapGetByKeyParts v0, v1, v3
# CHECK-NEXT: = NewArray [[byString10]], [[byParts10]]
}

