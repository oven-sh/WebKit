# A number with a value of unknown type is computed on a raw double where the result is a number whatever the value is. An addition may concatenate, and the remainder has no such form
# FORM: Prepared
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="difference" parameters=[{type=number}, {type=anything}] results=[{type=number}] {
    v2 = Sub v0, v1
    Return v2
# CHECK: number = Sub v0, v1 form=NumberAndValue
}
function f1 name="quotientWithNumberOnRight" parameters=[{type=anything}, {type=number}] results=[{type=number}] {
    v2 = Div v0, v1
    Return v2
# CHECK: number = Div v0, v1 form=NumberAndValue
}
function f2 name="sumMayConcatenate" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = Add v0, v1
    Return v2
# CHECK: = Add v0, v1 form=Generic
}
function f3 name="remainder" parameters=[{type=number}, {type=anything}] results=[{type=number}] {
    v2 = Mod v0, v1
    Return v2
# CHECK: number = Mod v0, v1 form=Generic
}
