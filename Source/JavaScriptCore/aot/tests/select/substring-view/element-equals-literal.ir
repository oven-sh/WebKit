# A character that is only compared with literals is read as a code unit and never created
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SubstringViewGroups = 11

module m0 path="main.js" displayPath="main.js"
function f0 name="element-equals-literal" parameters=[{type=string}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string="a"
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f0 name="element-equals-literal"
# CHECK-NOT: = ElemGet
# CHECK-NOT: = StringRangeCharacterOrUndefined
# CHECK-NOT: = GetStringLength
# CHECK: [[unit0]]: int[-1, 65535] = StringRangeCodeUnitOrMinusOne v0, -, -, v1
# CHECK-NEXT: [[codeUnit0]]: 97 = Integer integer=97
# CHECK-NEXT: [[result0]]: boolean = StrictEq [[unit0]], [[codeUnit0]]
# CHECK-NEXT: Return [[result0]]

function f1 name="char-at-equals-empty-string" parameters=[{type=string}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int):
    v2 = CallBuiltin v0, v1 overload=StringPrototypeCharAt/0
    v3 = String string=""
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f1 name="char-at-equals-empty-string"
# CHECK-NOT: StringPrototypeCharAt
# CHECK-NOT: = StringRangeC
# CHECK: [[range1]]: {{*}} = StringRange [[length1]], v1 method=SingleIndex
# CHECK-NEXT: [[from1]]: {{*}} = ResultAt [[range1]]
# CHECK-NEXT: [[to1]]: {{*}} = ResultAt [[range1]] index=1
# CHECK-NOT: = StringRangeC
# CHECK-NOT: = StringRangeEqualsLiteral
# CHECK: [[result1]]: boolean = StrictEq [[from1]], [[to1]]
# CHECK-NEXT: Return [[result1]]

function f2 name="element-equals-empty-string" parameters=[{type=string}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string=""
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f2 name="element-equals-empty-string"
# CHECK-NOT: = ElemGet
# CHECK-NOT: = StringRange
# CHECK: [[result2]]: false = Boolean
# CHECK-NEXT: Return [[result2]]

function f3 name="element-equals-longer-literal" parameters=[{type=string}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string="ab"
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f3 name="element-equals-longer-literal"
# CHECK-NOT: = ElemGet
# CHECK-NOT: = StringRange
# CHECK: [[result3]]: false = Boolean
# CHECK-NEXT: Return [[result3]]

function f4 name="shared-code-unit" parameters=[{type=string}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string="a"
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v4
  b2():
    v5 = String string="\xc3\xa9"
    v6 = StrictEq v5, v2
    Return v6
}
# CHECK-LABEL: function f4 name="shared-code-unit"
# CHECK: v2: int[-1, 65535] = StringRangeCodeUnitOrMinusOne v0, -, -, v1
# CHECK-NOT: = StringRangeCodeUnitOr
# CHECK: [[first4]]: 97 = Integer integer=97
# CHECK-NEXT: v4: boolean = StrictEq v2, [[first4]]
# CHECK-NOT: = StringRangeCodeUnitOr
# CHECK: [[second4]]: 233 = Integer integer=233
# CHECK-NEXT: v6: boolean = StrictEq [[second4]], v2

function f5 name="nullable-string" parameters=[{type=undefined|string}, {type=int}] results=[{type=boolean}] {
  b0(v0: undefined|string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string="a"
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f5 name="nullable-string"
# CHECK-NOT: StringRange
# CHECK: v2: {{*}} = ElemGet v0, v1
# CHECK-NOT: StringRange

# The taken edge passes the character on with the type of the literal, so the comparison needs the character
function f6 name="comparison-passes-proof" parameters=[{type=string}, {type=int}] results=[{type=string}] {
  b0(v0: string, v1: int):
    v2 = ElemGet v0, v1
    v3 = String string="a"
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    Return v5
  b2():
    Return v3
}
# CHECK-LABEL: function f6 name="comparison-passes-proof"
# CHECK-NOT: StringRangeCodeUnitOr
# CHECK: v2: undefined|string = StringRangeCharacterOrUndefined v0, -, -, v1
# CHECK: v4: boolean = StrictEq v2, v3
# CHECK-NEXT: Branch v4 -> taken b1(| 0), notTaken b2()
# CHECK-NOT: StringRangeCodeUnitOr
