# The length of a range is the difference of its bounds, masked to the range of a string length: it has the type of the read it replaces
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SubstringViewGroups = 6

module m0 path="main.js" displayPath="main.js"
function f0 name="slice-length" parameters=[{type=string}, {type=int}, {type=int}] results=[{type=int}] {
    v3 = GetStringLength v0
    v4 = StringRange v3, v1, v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    v7 = Substring v0, v5, v6
    v8 = GetStringLength v7
    Return v8
# CHECK-NOT: = Substring
# CHECK: v6: {{*}} = ResultAt v4 index=1
# CHECK-NEXT: [[difference0]]: int[-2147483647, 2147483647] = Sub v6, v5
# CHECK-NEXT: [[mask0]]: 2147483647 = Integer integer=2147483647
# CHECK-NEXT: [[length0]]: int[0, 2147483647] = BitAnd [[difference0]], [[mask0]]
# CHECK-NEXT: Return [[length0]]
}

function f1 name="slice-length-getter" parameters=[{type=string}, {type=int}, {type=int}] results=[{type=int}] {
    v3 = GetStringLength v0
    v4 = StringRange v3, v1, v2
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    v7 = Substring v0, v5, v6
    v8 = CallBuiltin v7 overload=StringPrototypeLength/0
    Return v8
# CHECK-NOT: = Substring
# CHECK-NOT: StringPrototypeLength
# CHECK: v6: {{*}} = ResultAt v4 index=1
# CHECK-NEXT: [[difference1]]: int[-2147483647, 2147483647] = Sub v6, v5
# CHECK-NEXT: [[mask1]]: 2147483647 = Integer integer=2147483647
# CHECK-NEXT: [[length1]]: int[0, 2147483647] = BitAnd [[difference1]], [[mask1]]
# CHECK-NEXT: Return [[length1]]
}

function f2 name="length-returned-as-a-length" parameters=[{type=string}, {type=int[0, 2147483647]}, {type=int[0, 2147483647]}] results=[{type=int[0, 2147483647]}] {
    v3 = Substring v0, v1, v2
    v4 = GetStringLength v3
    Return v4
# CHECK-NOT: = Substring
# CHECK: [[difference2]]: int[-2147483647, 2147483647] = Sub v2, v1
# CHECK-NEXT: [[mask2]]: 2147483647 = Integer integer=2147483647
# CHECK-NEXT: [[length2]]: int[0, 2147483647] = BitAnd [[difference2]], [[mask2]]
# CHECK-NEXT: Return [[length2]]
}
