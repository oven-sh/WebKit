# at() counts a negative index from the end of the string
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SubstringViewGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="at-negative-index" parameters=[{type=string}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = Integer integer=-1
    v2 = CallBuiltin v0, v1 overload=StringPrototypeAt/0
    v3 = String string="/"
    v4 = StrictEq v2, v3
    Return v4
}
