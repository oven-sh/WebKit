# RUN: pass Select
# STATISTIC: SubstringViewGroups = 9

module m0 path="main.js" displayPath="main.js"
function f0 name="slice" parameters=[{type=string}, {type=int}, {type=int}] results=[{type=boolean}] {
  b0(v0: string, v1: int, v2: int):
    v3 = CallBuiltin v0, v1, v2 overload=StringPrototypeSlice/0
    v4 = String string="ab"
    v5 = StrictEq v3, v4
    Return v5
}
