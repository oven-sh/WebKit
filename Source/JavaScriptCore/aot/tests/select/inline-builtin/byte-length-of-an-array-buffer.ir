# RUN: pass Select
# RUN(FORMS): inline-forms
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
function f0 name="byteLengths" parameters=[{type=ArrayBuffer}, {type=SharedArrayBuffer}] results=[{type=anything}] {
    v2 = CallBuiltin v0 overload=ArrayBufferPrototypeByteLength/0
    v3 = CallBuiltin v1 overload=SharedArrayBufferPrototypeByteLength/0
    v4 = NewArray v2, v3 contents=anything
    Return v4
}
