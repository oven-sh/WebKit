# OPTIONS: heat=EverythingIsHot
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="indexOfBoolean" parameters=[{type=Array<anything, pristine[Storage]>}, {type=boolean}] results=[{type=anything}] {
  b0(v0: Array<anything, pristine[Storage]>, v1: boolean):
    v2 = CallBuiltin v0, v1 overload=ArrayPrototypeIndexOf/1
    Return v2
}
