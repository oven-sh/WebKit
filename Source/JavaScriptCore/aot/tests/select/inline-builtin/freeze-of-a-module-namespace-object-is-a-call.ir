# import * as box from "./box.mjs"; Object.freeze(box)
# The exports of a module namespace object stay writable, so the attempt to freeze it throws a TypeError. The inline code sets the bits of an ordinary compiled object and throws nothing: the call stays.
# FORM: Prepared
# RUN: inline-forms
# CHECK: function f0
# CHECK-NEXT: v1 {{*}} ObjectFreeze {{*}} Call
# CHECK: function f1
# CHECK-NEXT: v1 {{*}} ObjectFreeze {{*}} TwoWay

module m0 path="main.mjs" displayPath="main.mjs"
module m1 path="box.mjs" displayPath="box.mjs"
layout L0 name="MayBeFrozen" fields=[{key="a" declared={type=number}}]
function f0 name="freezeNamespace" results=[{type=anything}] {
    v0 = ModuleNamespace module=m1
    v1 = CallBuiltin -, v0 overload=ObjectFreeze/0
    Return v1
}
function f1 name="freezeRecord" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = CallBuiltin -, v0 overload=ObjectFreeze/0
    Return v1
}
