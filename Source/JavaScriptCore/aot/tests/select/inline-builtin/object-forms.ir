function f6 name="createFromNullOrWithSecondArgument" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = Null
    v2 = CallBuiltin -, v1 overload=ObjectCreate/0
    v3 = Undefined
    v4 = CallBuiltin -, v0, v3 overload=ObjectCreate/0
    v5 = NewArray v2, v4 contents=anything
