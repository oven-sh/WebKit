function f4 name="ownPropertyTests" parameters=[{type=object}, {type=string}] results=[{type=anything}] {
  b0(v0: object, v1: string):
    v2 = CallBuiltin -, v0, v1 overload=ObjectHasOwn/0
    v3 = CallBuiltin v0, v1 overload=ObjectPrototypePropertyIsEnumerable/0
    v4 = NewArray v2, v3 contents=anything
    Return v4
}
