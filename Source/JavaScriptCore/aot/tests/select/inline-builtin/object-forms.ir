# Selection answers for each inline built-in of objects, own properties, functions, errors, formatters and dates whether the call stays, gets inline code with a miss edge to the call, or is inline code alone
# FORM: Prepared
# OPTIONS: heat=EverythingIsHot
# RUN: pass Select
# RUN(FORMS): inline-forms
# RUN(SHAPES): code-shapes
# CHECK: outcome: Changed

module m0 path="main.js" displayPath="main.js"
layout L0 name="MayBeFrozen" fields=[{key="a" declared={type=number}}]
layout L1 name="NeverFrozen" fields=[{key="a" declared={type=number}}] flow={impossibleMutations=[ChangeIntegrity]}

function f0 name="ownKeys" parameters=[{type=object}] results=[{type=anything}] {
  b0(v0: object):
    v1 = CallBuiltin -, v0 overload=ObjectKeys/0
    Return v1
}
# FORMS: function f0
# FORMS-NEXT: v1 {{*}} OwnPropertyKeys {{*}} TwoWay
# CHECK-LABEL: function f0 name="ownKeys"
# CHECK: TryCallInline -, v0 inlineBuiltin=OwnPropertyKeys inlineParameters=[{{*}}] overload=ObjectKeys/0 -> done [[done0]](), miss [[miss0]]()
# CHECK: [[miss0]]() frequency=Rare:
# CHECK-NEXT: = CallBuiltin -, v0 overload=ObjectKeys/0

function f1 name="ownKeysInCompactBlock" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = CallBuiltin -, v0 overload=ObjectKeys/0
    Return v2
  b2():
    Return v1
}
# SHAPES: f1 b1 Compact
# FORMS: function f1
# FORMS-NEXT: v2 {{*}} OwnPropertyKeys {{*}} Whole
# CHECK-LABEL: function f1 name="ownKeysInCompactBlock"
# CHECK-NOT: TryCallInline
# CHECK-NOT: CallBuiltin
# CHECK: v2: {{*}} = CallInline -, v0 inlineBuiltin=OwnPropertyKeys inlineParameters=[{{*}}] overload=ObjectKeys/0
# CHECK-NOT: TryCallInline
# CHECK-NOT: CallBuiltin

function f2 name="otherTwoWayBuiltinInCompactBlock" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = CallBuiltin -, v0 overload=ObjectCreate/0
    Return v2
  b2():
    Return v1
}
# SHAPES: f2 b1 Compact
# FORMS: function f2
# FORMS-NEXT: v2 {{*}} ObjectCreate {{*}} TwoWay
# CHECK-LABEL: function f2 name="otherTwoWayBuiltinInCompactBlock"
# CHECK: TryCallInline -, v0 inlineBuiltin=ObjectCreate overload=ObjectCreate/0 -> done

function f3 name="ownPropertyDescriptor" parameters=[{type=object}, {type=string}] results=[{type=anything}] {
  b0(v0: object, v1: string):
    v2 = CallBuiltin -, v0, v1 overload=ObjectGetOwnPropertyDescriptor/0
