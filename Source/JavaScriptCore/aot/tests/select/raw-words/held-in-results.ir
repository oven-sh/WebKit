# A raw word goes only where an operation inspects it: a list of results hands its values on, so it holds none
# FORM: Selected
# RUN: raw-words

module m0 path="main.js" displayPath="main.js"
function f0 name="holds-cursor" results=[{type=undefined}] {
  b0():
    v0 = StringBuilderBegin
    v1 = StringBuilderReserve v0 size=8
    v2 = Results v1
    StringBuilderCommit v0, v1
    StringBuilderDiscard v0
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v1 BuilderCursor: productions v1.0; bases v0
# CHECK-NEXT: error RawWordEscapes b0 v2
function f1 name="holds-address" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = ResolveCallTarget v0 argumentCount=0
    v2 = Results v1
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v1 CodeAddress:
# CHECK-NEXT: error RawWordEscapes b0 v2
function f2 name="holds-outcome" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = StringBuilderBegin
    v2 = StringBuilderReserve v1 size=64
    v3 = JSONAppendValue v1, v2, v0 jsonPosition=Element
    v4 = ResultAt v3 index=0
    v5 = ResultAt v3 index=1
    v6 = Results v4
    StringBuilderCommit v1, v5
    StringBuilderDiscard v1
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v2 BuilderCursor: productions v2.0; bases v1
# CHECK-NEXT: v5 BuilderCursor: productions v3.1; bases v1
# CHECK-NEXT: valid
