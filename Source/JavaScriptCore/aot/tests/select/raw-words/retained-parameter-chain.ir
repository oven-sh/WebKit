# The productions and bases of a block parameter are found through the parameters of earlier blocks, along handler edges and around loops
# FORM: Selected
# RUN: raw-words

module m0 path="main.js" displayPath="main.js"
function f0 name="one-builder" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = StringBuilderReserve v1 size=64
    Jump -> next b3(v2)
  b2():
    v3 = StringBuilderReserve v1 size=24
    Jump -> next b3(v3)
  b3(v4):
    Jump -> next b4(v4)
  b4(v5):
    v6 = JSONAppendBoolean v1, v5, v0
    StringBuilderCommit v1, v6
    v8 = StringBuilderFinish v1
    Return v8
}
# CHECK-LABEL: function f0
# CHECK: v4 BuilderCursor: productions v2.0 v3.0; bases v1
# CHECK-NEXT: v5 BuilderCursor: productions v2.0 v3.0; bases v1
# CHECK-NEXT: v6 BuilderCursor: productions v6.0; bases v1
# CHECK-NEXT: valid
function f1 name="two-builders" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    v2 = StringBuilderBegin
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = StringBuilderReserve v1 size=8
    Jump -> next b3(v3)
  b2():
    v4 = StringBuilderReserve v2 size=8
    Jump -> next b3(v4)
  b3(v5):
    Jump -> next b4(v5)
  b4(v6):
    v7 = JSONAppendBoolean v1, v6, v0
    StringBuilderCommit v1, v7
    v9 = StringBuilderFinish v1
    StringBuilderDiscard v2
    Return v9
}
# CHECK-LABEL: function f1
# CHECK: v5 BuilderCursor: productions v3.0 v4.0; bases v1 v2
# CHECK-NEXT: v6 BuilderCursor: productions v3.0 v4.0; bases v1 v2
# CHECK-NEXT: v7 BuilderCursor: productions v7.0; bases v1
# CHECK-NEXT: error RawPointerWithoutBase b4 v7
function f2 name="handler-edge" parameters=[{type=string}] results=[{type=string}] {
  b0(v0: string):
    v1 = StringBuilderBegin
    v2 = StringBuilderReserve v1 size=8
    Jump -> next b1()
  b1() handler=b2(v2):
    v3 = FlattenString v0
    Jump -> next b3()
  b2(v4) role=CatchHandler:
    v5 = CatchValue
    StringBuilderCommit v1, v4
    v7 = StringBuilderFinish v1
    Return v7
  b3():
    StringBuilderDiscard v1
    Return v0
}
# CHECK-LABEL: function f2
# CHECK: v4 BuilderCursor: productions v2.0; bases v1
# CHECK-NEXT: valid
function f3 name="loop-carried" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    v2 = StringBuilderReserve v1 size=8
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = JSONAppendBoolean v1, v3, v0
    Branch v0 -> taken b1(v3), notTaken b2()
  b2():
    StringBuilderCommit v1, v5
    v7 = StringBuilderFinish v1
    Return v7
}
# CHECK-LABEL: function f3
# CHECK: v3 BuilderCursor: productions v2.0; bases v1
# CHECK-NEXT: v5 BuilderCursor: productions v5.0; bases v1
# CHECK-NEXT: valid
