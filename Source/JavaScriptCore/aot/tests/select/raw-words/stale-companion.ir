# Two results of one producer belong together: an operation that takes the cursor of one append and the outcome of an earlier one mixes two states of the builder
# FORM: Selected
# RUN: raw-words

module m0 path="main.js" displayPath="main.js"
function f0 name="outcome-of-earlier-append" parameters=[{type=anything}, {type=anything}] results=[{type=string}] {
  b0(v0: anything, v1: anything):
    v2 = StringBuilderBegin
    v3 = StringBuilderReserve v2 size=64
    v4 = JSONAppendValue v2, v3, v0 jsonPosition=Element
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=1
    v7 = JSONAppendValue v2, v6, v1 jsonPosition=Element
    v8 = ResultAt v7 index=1
    v9 = JSONAppendInteger v2, v8, v5
    StringBuilderCommit v2, v9
    v11 = StringBuilderFinish v2
    Return v11
}
