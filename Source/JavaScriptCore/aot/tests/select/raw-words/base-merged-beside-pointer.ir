# A cursor and its builder that merge side by side in the parameters of one block belong together on every path, also through a second merge. A cursor that arrives beside another builder has no base
# FORM: Selected
# RUN: raw-words

module m0 path="main.js" displayPath="main.js"
function f0 name="side-by-side" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = StringBuilderBegin
    v2 = StringBuilderReserve v1 size=8
    Jump -> next b3(v1, v2)
  b2():
    v3 = StringBuilderBegin
    v4 = StringBuilderReserve v3 size=8
    Jump -> next b3(v3, v4)
  b3(v5, v6):
    v7 = JSONAppendBoolean v5, v6, v0
    StringBuilderCommit v5, v7
    v9 = StringBuilderFinish v5
    Return v9
}
# CHECK-LABEL: function f0
# CHECK: v6 BuilderCursor: productions v2.0 v4.0; bases v1 v3
# CHECK-NEXT: v7 BuilderCursor: productions v7.0; bases v5
# CHECK-NEXT: valid
function f1 name="through-two-merges" parameters=[{type=boolean}, {type=boolean}] results=[{type=string}] {
  b0(v0: boolean, v1: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = StringBuilderBegin
    Jump -> next b3(v2)
  b2():
    v3 = StringBuilderBegin
    Branch v1 -> taken b3(v3), notTaken b4(v3)
  b3(v4):
    v5 = StringBuilderReserve v4 size=8
    Jump -> next b5(v5, v4)
  b4(v6):
    v7 = StringBuilderReserve v6 size=8
    Jump -> next b5(v7, v6)
  b5(v8, v9):
    StringBuilderCommit v9, v8
    v11 = StringBuilderFinish v9
    Return v11
}
# CHECK-LABEL: function f1
# CHECK: v8 BuilderCursor: productions v5.0 v7.0; bases v4 v6
# CHECK-NEXT: valid
function f2 name="beside-another-builder" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    v2 = StringBuilderBegin
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = StringBuilderReserve v1 size=8
    Jump -> next b3(v2, v3)
  b2():
    v4 = StringBuilderReserve v2 size=8
    Jump -> next b3(v2, v4)
  b3(v5, v6):
    v7 = JSONAppendBoolean v5, v6, v0
    StringBuilderCommit v5, v7
    v9 = StringBuilderFinish v5
    StringBuilderDiscard v1
    Return v9
}
# CHECK-LABEL: function f2
# CHECK: v6 BuilderCursor: productions v3.0 v4.0; bases v1 v2
# CHECK: error RawPointerWithoutBase b3 v7
