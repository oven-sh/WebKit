# A block parameter merges the cursors of two builders, and an append can name only one of them
# FORM: Selected
# RUN: raw-words
# CHECK: function f0
# CHECK: v5 BuilderCursor: productions v3.0 v4.0; bases v1 v2
# CHECK-NEXT: v6 BuilderCursor: productions v6.0; bases v1
# CHECK-NEXT: error RawPointerWithoutBase b3 v6

module m0 path="main.js" displayPath="main.js"
function f0 name="other-base-through-parameter" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    v2 = StringBuilderBegin
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = StringBuilderReserve v1 size=8
    Jump -> next b3(v3)
  b2():
    v4 = StringBuilderReserve v2 size=8
    Jump -> next b3(v4)
  b3(v5):
    v6 = JSONAppendBoolean v1, v5, v0
    StringBuilderCommit v1, v6
    v8 = StringBuilderFinish v1
    StringBuilderDiscard v2
    Return v8
}
