# Productions on one base that merge in the parameters of one block are read like one production: the base is named once, and two results that merge side by side come from one producer on every path
# FORM: Selected
# RUN: raw-words

module m0 path="main.js" displayPath="main.js"
function f0 name="reservations-of-one-builder" parameters=[{type=boolean}] results=[{type=string}] {
  b0(v0: boolean):
    v1 = StringBuilderBegin
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = StringBuilderReserve v1 size=64
    Jump -> next b3(v2)
  b2():
    v3 = StringBuilderReserve v1 size=24
    Jump -> next b3(v3)
  b3(v4):
    v5 = JSONAppendBoolean v1, v4, v0
    StringBuilderCommit v1, v5
    v7 = StringBuilderFinish v1
    Return v7
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v2 BuilderCursor: productions v2.0; bases v1
# CHECK-NEXT: v3 BuilderCursor: productions v3.0; bases v1
# CHECK-NEXT: v4 BuilderCursor: productions v2.0 v3.0; bases v1
# CHECK-NEXT: v5 BuilderCursor: productions v5.0; bases v1
# CHECK-NEXT: valid
function f1 name="both-results-of-one-append" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=string}] {
  b0(v0: anything, v1: anything, v2: boolean):
    v3 = StringBuilderBegin
    v4 = StringBuilderReserve v3 size=64
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v5 = JSONAppendValue v3, v4, v0 jsonPosition=Element
    v6 = ResultAt v5 index=0
    v7 = ResultAt v5 index=1
    Jump -> next b3(v6, v7)
  b2():
    v8 = JSONAppendValue v3, v4, v1 jsonPosition=Element
    v9 = ResultAt v8 index=0
    v10 = ResultAt v8 index=1
    Jump -> next b3(v9, v10)
  b3(v11, v12):
    v13 = JSONAppendInteger v3, v12, v11
    StringBuilderCommit v3, v13
    v15 = StringBuilderFinish v3
    Return v15
}
# CHECK-LABEL: function f1
# CHECK: v12 BuilderCursor: productions v5.1 v8.1; bases v3
# CHECK-NEXT: v13 BuilderCursor: productions v13.0; bases v3
# CHECK-NEXT: valid
