# When two rules match a value, the rule with the earlier id claims it
# FORM: Prepared
# OPTIONS: heat=only-loops-are-hot
# RUN: pass Select
# STATISTIC: PropertyReadAndTestGroups = 1
# STATISTIC: PropertyChainGroups = 1
# STATISTIC: PropertyPairGroups = 0

module m0 path="main.js" displayPath="main.js"
function f0 name="readReadTest" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v1 key="y"
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
# CHECK-LABEL: function f0 name="readReadTest"
# CHECK: b0(v0: anything):
# CHECK-NEXT: [[x]]: anything = PropGet v0 key="x"
# CHECK-NEXT: [[test]]: boolean = PropGetAndTest [[x]] key="y"
# CHECK-NEXT: TestAndBranch [[test]] -> taken b1(), notTaken b2()
function f1 name="readReadThenRead" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v1 key="y"
    v3 = PropGet v0 key="z"
    v4 = StrictEq v2, v3
    Return v4
}
# CHECK-LABEL: function f1 name="readReadThenRead"
# CHECK: b0(v0: anything):
# CHECK-NEXT: [[y]]: anything = PropGetChain v0 key="x" secondKey="y"
# CHECK-NEXT: [[z]]: anything = PropGet v0 key="z"
# CHECK-NEXT: = StrictEq [[y]], [[z]]
