# A length in front of the read that it bounds is the place where the string is made flat, so that the flat string reaches the reads behind the join of the two paths.
# Not for one read alone, not where the read's block is rarer or has a second way in, and not under another handler
# FORM: Prepared
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="twoBoundedReads" parameters=[{type=string}, {type=int[0, 100]}] results=[{type=int}] {
    v2 = GetStringLength v0
    v3 = Less v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = GetStringCodeUnit v0, v1
    Jump -> next b3(v4)
  b2() frequency=Unlikely:
    v5 = Integer integer=0
    Jump -> next b3(v5)
  b3(v6):
    v7 = GetStringLength v0
    v8 = Less v6, v7
    Branch v8 -> taken b4(), notTaken b5()
  b4():
    v9 = GetStringCodeUnit v0, v6
    Return v9
  b5() frequency=Unlikely:
    v10 = Integer integer=0
    Return v10
# CHECK: [[flat0]]: flatstring = FlattenString v0
# CHECK-NEXT: v2: int[0, 2147483647] = GetStringLength [[flat0]]
# CHECK-NOT: FlattenString
# CHECK: v4: int[0, 65535] = GetStringCodeUnit [[flat0]], v1
# CHECK: v7: int[0, 2147483647] = GetStringLength [[flat0]]
# CHECK: v9: int[0, 65535] = GetStringCodeUnit [[flat0]], v6
}

function f1 name="oneBoundedRead" parameters=[{type=string}, {type=int[0, 100]}] results=[{type=int}] {
    v2 = GetStringLength v0
    v3 = Less v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = GetStringCodeUnit v0, v1
    Return v4
  b2() frequency=Unlikely:
    v5 = Integer integer=0
    Return v5
# CHECK-NOT: FlattenString
# CHECK: = GetStringLength v0
# CHECK: = GetStringCodeUnit v0, v1
}

function f2 name="readsInRarerBlocks" parameters=[{type=string}, {type=int[0, 100]}] results=[{type=int}] {
    v2 = GetStringLength v0
    v3 = Less v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v4 = GetStringCodeUnit v0, v1
    Jump -> next b3(v4)
  b2():
    v5 = Integer integer=0
    Jump -> next b3(v5)
  b3(v6):
    v7 = GetStringLength v0
    v8 = Less v6, v7
    Branch v8 -> taken b4(), notTaken b5()
  b4() frequency=Unlikely:
    v9 = GetStringCodeUnit v0, v6
    Return v9
  b5():
    v10 = Integer integer=0
    Return v10
# CHECK-NOT: FlattenString
# CHECK: = GetStringCodeUnit v0, v1
# CHECK-NOT: FlattenString
# CHECK: = GetStringCodeUnit v0, v6
}

function f3 name="readBehindSecondTest" parameters=[{type=string}, {type=int[0, 100]}, {type=boolean}] results=[{type=int}] {
    v3 = GetStringLength v0
    v4 = Less v1, v3
    Branch v4 -> taken b1(), notTaken b3()
  b1():
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v5 = GetStringCodeUnit v0, v1
    v6 = GetStringCodeUnit v0, v1
    v7 = BitXor v5, v6
    Return v7
  b3():
    v8 = Integer integer=0
    Return v8
# CHECK: = GetStringLength v0
# CHECK: b2():
# CHECK-NEXT: [[flat3]]: flatstring = FlattenString v0
# CHECK-NEXT: = GetStringCodeUnit [[flat3]], v1
# CHECK-NEXT: = GetStringCodeUnit [[flat3]], v1
}

function f4 name="readsUnderAnotherHandler" parameters=[{type=string}, {type=int[0, 100]}] results=[{type=int}] {
    v2 = GetStringLength v0
    v3 = Less v1, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1() handler=b3():
    v4 = GetStringCodeUnit v0, v1
    v5 = GetStringCodeUnit v0, v1
    v6 = BitXor v4, v5
    Return v6
  b2():
    v7 = Integer integer=0
    Return v7
  b3() role=CatchHandler:
    v8 = CatchValue
    v9 = Integer integer=1
    Return v9
# CHECK: = GetStringLength v0
# CHECK: b1() {{*}}handler=b3():
# CHECK-NEXT: [[flat4]]: flatstring = FlattenString v0
# CHECK-NEXT: = GetStringCodeUnit [[flat4]], v1
}
