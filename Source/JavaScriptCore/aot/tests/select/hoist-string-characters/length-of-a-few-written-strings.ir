# The length of one of a few written strings keeps its range when it is read from the flat string, which no longer says which strings it may be. The declared result rests on that range
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="lastSpace" parameters=[{type="a b c"|"abc"}] results=[{type=int[0, 40]}] {
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: int[0, 4], v4: int[0, 5]):
    LoopHint
    v6 = GetStringLength v0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b5()
  b2(v8):
    v9 = GetStringCodeUnit v0, v8
    v10 = Integer integer=32
    v11 = StrictEq v9, v10
    Branch v11 -> taken b3(), notTaken b4(v3)
  b3():
    Jump -> next b4(v8)
  b4(v12: int[0, 4]):
    v13 = Increment v8
    Jump -> next b1(v12, v13)
  b5():
    v14 = Integer integer=10
    v15 = Mul v3, v14
    Return v15
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NEXT: [[read]]: int[0, 2147483647] = GetStringLength [[flat]]
# CHECK-NEXT: v6: int[3, 5] = AssumeType [[read]] provenType=int[3, 5]
# CHECK-NEXT: = Less v4, v6 form=Integers
# CHECK: = GetStringCodeUnit [[flat]], v8
# CHECK: v15: int[0, 40] = Mul v3, v14 form=Integers
}
