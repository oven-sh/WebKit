# The block in front of the loop ends in a branch, so the string is flattened in a block of its own on the edge into the loop
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

# CHECK-LABEL: function f0 name="loop-entered-by-branch"
# CHECK: b0(v0: string, v1: number):
# CHECK-NOT: FlattenString
# CHECK: Branch v5 -> taken [[entry0]](), notTaken b3(v2)
# CHECK: v9: number = StringRangeCodeUnitOrNaN [[flat0]], -, -, v6
# CHECK: [[entry0]]()
# CHECK-NEXT: [[flat0]]: flatstring = FlattenString v0
# CHECK-NEXT: Jump -> next b1(v3, v2)
module m0 path="main.js" displayPath="main.js"
function f0 name="loop-entered-by-branch" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Less v3, v1
    Branch v5 -> taken b1(v3, v2), notTaken b3(v2)
  b1(v6, v7):
    LoopHint
    Jump -> next b2()
  b2():
    v9 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0
    v10 = Add v6, v4
    v11 = Less v10, v1
    Branch v11 -> taken b1(v10, v9), notTaken b3(v9)
  b3(v12):
    Return v12
}

# The block on the edge is covered by the handler of the header, and polls before it enters the loop, which has lost the handler
# CHECK-LABEL: function f1 name="covered-loop-entered-by-branch"
# CHECK: b0(v0: string, v1: number):
# CHECK-NOT: FlattenString
# CHECK: Branch v5 -> taken [[entry1]](), notTaken b3(v2)
# CHECK: v9: number = StringRangeCodeUnitOrNaN [[flat1]], -, -, v6
# CHECK: [[entry1]]() {{*}}handler=b4():
# CHECK-NEXT: [[flat1]]: flatstring = FlattenString v0
# CHECK-NEXT: LoopHint [leavesHandler]
# CHECK-NEXT: Jump -> next b1(v3, v2)
function f1 name="covered-loop-entered-by-branch" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
  b0(v0: string, v1: number) handler=b4():
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Less v3, v1
    Branch v5 -> taken b1(v3, v2), notTaken b3(v2)
  b1(v6, v7) handler=b4():
    LoopHint
    Jump -> next b2()
  b2() handler=b4():
    v9 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0
    v10 = Add v6, v4
    v11 = Less v10, v1
    Branch v11 -> taken b1(v10, v9), notTaken b3(v9)
  b3(v12):
    Return v12
  b4() role=CatchHandler:
    v13 = CatchValue
    Return v13
}
