# A call on a rare path of the loop does not stop the string from being flattened on the entry, and nothing follows the call
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 3

# CHECK-LABEL: function f0 name="call-on-rare-path"
# CHECK-NOT: LoopHint
# CHECK: [[flat0]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN [[flat0]], -, -, v6
# CHECK-NOT: FlattenString
# CHECK: v12: anything = Call v2
# CHECK-NEXT: Jump -> next b4()
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="call-on-rare-path" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b2(), notTaken b5()
  b2():
    v10 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Less v1, v6
    Branch v11 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v12 = Call v2
    Jump -> next b4()
  b4():
    v13 = Add v6, v4
    Jump -> next b1(v13, v10)
  b5():
    Return v7
}

# The string has a likely reader, so the rare reader takes the flat string too
# CHECK-LABEL: function f1 name="read-on-rare-path"
# CHECK-NOT: LoopHint
# CHECK: [[flat1]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN [[flat1]], -, -, v6
# CHECK: v12: anything = Call v2
# CHECK-NEXT: v13: number = StringRangeCodeUnitOrNaN [[flat1]], -, -, v6
# CHECK-NEXT: Jump -> next b4()
# CHECK-NOT: FlattenString
function f1 name="read-on-rare-path" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b2(), notTaken b5()
  b2():
    v10 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Less v1, v6
    Branch v11 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v12 = Call v2
    v13 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    Jump -> next b4()
  b4():
    v14 = Add v6, v4
    Jump -> next b1(v14, v10)
  b5():
    Return v7
}
