# A string is flattened for a loop only if a value that names the same object is defined outside the loop: without a test where that value is typed string, after a test where it is not
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 3

module m0 path="main.js" displayPath="main.js"

# CHECK-LABEL: function f0 name="string-is-loop-parameter"
# CHECK-NOT: FlattenString
# CHECK: v12: number = StringRangeCodeUnitOrNaN v8, -, -, v6
# CHECK-NOT: FlattenString
function f0 name="string-is-loop-parameter" parameters=[{type=string}, {type=number}, {type=string}] results=[{type=anything}] {
  b0(v0: string, v1: number, v2: string):
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Jump -> next b1(v3, v5, v0, v2)
  b1(v6, v7, v8, v9):
    LoopHint
    v11 = Less v6, v1
    Branch v11 -> taken b2(), notTaken b3()
  b2():
    v12 = CallBuiltin v8, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v13 = Add v6, v4
    Jump -> next b1(v13, v12, v9, v8)
  b3():
    Return v7
}

# CHECK-LABEL: function f1 name="cast-in-loop"
# CHECK-NOT: LoopHint
# CHECK: = TypeTest v0 testedType=string
# CHECK: LoopHint
# CHECK: v9: string = AssumeType v0 castType=string
# CHECK-NEXT: v10: number = StringRangeCodeUnitOrNaN [[flat1]], -, -, v5
# CHECK-COUNT-1: : flatstring = FlattenString
# CHECK: ([[flat1]]: flatstring):
function f1 name="cast-in-loop" parameters=[{type=undefined|string}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|string, v1: number):
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = AssumeType v0 castType=string
    v10 = CallBuiltin v9, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Add v5, v4
    Jump -> next b1(v11, v10)
  b3():
    Return v6
}

# CHECK-LABEL: function f2 name="cast-outside-loop"
# CHECK: v5: string = AssumeType v0 castType=string
# CHECK-NOT: LoopHint
# CHECK-NOT: TypeTest
# CHECK: [[flat2]]: flatstring = FlattenString v5
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN [[flat2]], -, -, v6
# CHECK-NOT: FlattenString
function f2 name="cast-outside-loop" parameters=[{type=undefined|string}, {type=number}] results=[{type=anything}] {
  b0(v0: undefined|string, v1: number):
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = AssumeType v0 castType=string
    Jump -> next b1(v3, v2)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = CallBuiltin v5, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Add v6, v4
    Jump -> next b1(v11, v10)
  b3():
    Return v7
}
