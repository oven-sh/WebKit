# A loop entered from two blocks has no single edge to flatten the string on, so the read keeps the plain string
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 1

# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN v0, -, -, v6
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="two-entry-loop" parameters=[{type=string}, {type=number}, {type=boolean}] results=[{type=anything}] {
  b0(v0: string, v1: number, v2: boolean):
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v3, v5)
  b2():
    Jump -> next b3(v4, v5)
  b3(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b4(), notTaken b5()
  b4():
    v10 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Add v6, v4
    Jump -> next b3(v11, v10)
  b5():
    Return v7
}
