# With the rule switched off nothing is flattened, and a read of one character stays a call of the inline built-in
# FORM: Prepared
# OPTIONS: disable=rule:HoistStringCharacters
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 0

# CHECK-NOT: FlattenString
# CHECK-NOT: StringRange
# CHECK: v9: number = CallInline v0, v5 inlineBuiltin=StringCharCodeAt overload=StringPrototypeCharCodeAt/0
# CHECK-NOT: FlattenString
# CHECK-NOT: StringRange
module m0 path="main.js" displayPath="main.js"
function f0 name="char-code-at" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
  b0(v0: string, v1: number):
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v10 = Add v5, v4
    Jump -> next b1(v10, v9)
  b3():
    Return v6
}
