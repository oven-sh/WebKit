# A string that is read only on rare paths of the loop may never be read, so it is not flattened
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 1

# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN v0, -, -, v5
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="read-only-on-rare-path" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    v4 = Undefined
    Jump -> next b1(v2, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b5()
  b2():
    v9 = Less v1, v5
    Branch v9 -> taken b3(), notTaken b4(v6)
  b3() frequency=Rare:
    v10 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    Jump -> next b4(v10)
  b4(v11):
    v12 = Add v5, v3
    Jump -> next b1(v12, v11)
  b5():
    Return v6
}
