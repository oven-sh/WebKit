# A comparison or a search with a literal that the rule for literal forms has made a row takes the flat string like any other read of characters
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 5

# CHECK-NOT: LoopHint
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: = StringIndexOfCharacter [[flat]], {{*}}codeUnit=97
# CHECK: = StringIndexOfLiteral [[flat]], {{*}}literal="ab"
# CHECK: = StringStartsWithLiteral [[flat]] literal="ab"
# CHECK: = StringEqualsLiteral [[flat]] literal="ab"
# CHECK: = StringOrderToCharacter [[flat]] codeUnit=97
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
variable g0 name="sink" declared={type=anything} initialization=Undefined
function f0 name="literal-forms" parameters=[{type=string}, {type=number}] results=[{type=undefined}] {
    v2 = Integer integer=0
    v3 = Integer integer=1
    Jump -> next b1(v2)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = String string="a"
    v8 = String string="ab"
    v9 = CallBuiltin v0, v7, v4 overload=StringPrototypeIndexOf/0
    PutModuleVariable v9 variable=g0
    v11 = CallBuiltin v0, v8, v4 overload=StringPrototypeIndexOf/0
    PutModuleVariable v11 variable=g0
    v13 = CallBuiltin v0, v8 overload=StringPrototypeStartsWith/1
    PutModuleVariable v13 variable=g0
    v15 = StrictEq v0, v8
    PutModuleVariable v15 variable=g0
    v17 = Less v0, v7
    PutModuleVariable v17 variable=g0
    v19 = Add v4, v3
    Jump -> next b1(v19)
  b3():
    Return
}
