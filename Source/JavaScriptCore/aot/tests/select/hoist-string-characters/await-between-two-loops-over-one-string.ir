# No flat string lives across a suspension: the loop behind the await does not take the string that was flattened for the loop in front of it, and flattens the string on its own entry
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="await-between-loops" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f1
    Return v3
}

# CHECK-LABEL: function f1 name="await-between-loops"
# CHECK-NOT: LoopHint
# CHECK: [[first]]: flatstring = FlattenString v0
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v11: number = StringRangeCodeUnitOrNaN [[first]], -, -, v7
# CHECK-NOT: FlattenString
# CHECK: v13: anything = AwaitBySavingFrame v2, v3
# CHECK-NEXT: [[second]]: flatstring = FlattenString v0
# CHECK-NEXT: Jump -> next b4(v4, v8)
# CHECK-NOT: FlattenString
# CHECK: v18: number = StringRangeCodeUnitOrNaN [[second]], -, -, v14
# CHECK-NOT: FlattenString
function f1 name="await-between-loops" role=CoroutineBody flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = Undefined
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v1
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = CallBuiltin v0, v7 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v12 = Add v7, v5
    Jump -> next b1(v12, v11)
  b3():
    v13 = AwaitBySavingFrame v2, v3
    Jump -> next b4(v4, v8)
  b4(v14, v15):
    LoopHint
    v17 = Less v14, v1
    Branch v17 -> taken b5(), notTaken b6()
  b5():
    v18 = CallBuiltin v0, v14 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v19 = Add v14, v5
    Jump -> next b4(v19, v18)
  b6():
    v20 = ReturnAsyncResult v3, v15
    Return v20
}
