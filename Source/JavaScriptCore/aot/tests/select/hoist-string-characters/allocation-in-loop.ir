# An allocation in the loop does not stop the string from being flattened on the entry
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 1

# CHECK-NOT: LoopHint
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v9: {{*}} = NewObject layout=L0
# CHECK-NEXT: v10: number = StringRangeCodeUnitOrNaN [[flat]], -, -, v5
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
layout L0
function f0 name="allocation-in-loop" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = NewObject layout=L0 fields=[]
    v10 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Add v5, v4
    Jump -> next b1(v11, v10)
  b3():
    Return v6
}
