# A flat string does not live across a suspension: the read in front of the await shares nothing with the reads behind it, and those share one flat string
# FORM: Prepared
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="reads-around-await" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
  b0(v0: string, v1: number, v2: anything):
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f1
    Return v3
}

