  b0(v0: string, v1: number, v2: anything, v3: undefined|Promise):
    v4 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    v5 = AwaitBySavingFrame v2, v3
    v6 = CallBuiltin v0, v1 overload=StringPrototypeCharCodeAt/0
    v7 = CallBuiltin v0, v4 overload=StringPrototypeCharCodeAt/0
    v8 = Add v6, v7
    v9 = ReturnAsyncResult v3, v8
    Return v9
}
