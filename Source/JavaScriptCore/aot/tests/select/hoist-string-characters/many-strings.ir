# Each string stands for itself: a loop that reads five strings gets five flat strings
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 5

# CHECK-NOT: LoopHint
# CHECK-COUNT-5: : flatstring = FlattenString
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: CallBuiltin
# CHECK-NOT: CallInline
# CHECK-NOT: FlattenString
# CHECK-COUNT-5: : number = StringRangeCodeUnitOrNaN
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="five-strings" parameters=[{type=string}, {type=string}, {type=string}, {type=string}, {type=string}, {type=number}] results=[{type=anything}] {
    v6 = Integer integer=0
    v7 = Integer integer=1
    v8 = Undefined
    Jump -> next b1(v6, v8)
  b1(v9, v10):
    LoopHint
    v12 = Less v9, v5
    Branch v12 -> taken b2(), notTaken b3()
  b2():
    v13 = CallBuiltin v0, v9 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v14 = CallBuiltin v1, v9 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v15 = CallBuiltin v2, v9 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v16 = CallBuiltin v3, v9 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v17 = CallBuiltin v4, v9 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v18 = Add v9, v7
    Jump -> next b1(v18, v17)
  b3():
    Return v10
}
