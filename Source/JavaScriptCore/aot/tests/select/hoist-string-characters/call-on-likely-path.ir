# A call of unknown code in every iteration does not stop the string from being flattened on the entry
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 1

# CHECK-NOT: LoopHint
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN [[flat]], -, -, v6
# CHECK-NEXT: v11: anything = Call
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="call-on-likely-path" parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: string, v1: number, v2: anything):
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = Call v2
    v12 = Add v6, v4
    Jump -> next b1(v12, v10)
  b3():
    Return v7
}
