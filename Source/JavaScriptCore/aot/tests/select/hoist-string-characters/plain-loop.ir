# A string that is read by characters in a loop and does not change there is flattened once on the loop entry, and the reads take the flat string
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 4

# CHECK-LABEL: function f0 name="char-code-at"
# CHECK-NOT: LoopHint
# CHECK: [[flat0]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v9: number = StringRangeCodeUnitOrNaN [[flat0]], -, -, v5
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="char-code-at" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v10 = Add v5, v4
    Jump -> next b1(v10, v9)
  b3():
    Return v6
}

# CHECK-LABEL: function f1 name="element-read"
# CHECK-NOT: LoopHint
# CHECK: [[flat1]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK-NOT: ElemGet
# CHECK: v9: undefined|string = StringRangeCharacterOrUndefined [[flat1]], -, -, v5
# CHECK-NOT: FlattenString
function f1 name="element-read" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = ElemGet v0, v5
    v10 = Add v5, v4
    Jump -> next b1(v10, v9)
  b3():
    Return v6
}

# CHECK-LABEL: function f2 name="two-reads"
# CHECK-NOT: LoopHint
# CHECK: [[flat2]]: flatstring = FlattenString v0
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v9: number = StringRangeCodeUnitOrNaN [[flat2]], -, -, v5
# CHECK-NEXT: v10: string = StringRangeCharacterOrEmpty [[flat2]], -, -, v5
# CHECK-NOT: FlattenString
function f2 name="two-reads" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2():
    v9 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v10 = CallBuiltin v0, v5 overload=StringPrototypeCharAt/0 builtinCallForm=Whole
    v11 = Add v9, v10
    v12 = Add v5, v4
    Jump -> next b1(v12, v11)
  b3():
    Return v6
}
