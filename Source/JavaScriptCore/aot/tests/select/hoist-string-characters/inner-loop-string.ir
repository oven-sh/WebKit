# Each string is flattened on the entry of the outermost loop in which it does not change
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

# CHECK: b0(v0: string, v1: number):
# CHECK-NOT: LoopHint
# CHECK: [[outerFlat]]: flatstring = FlattenString v0
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v9: string = ToString v5
# CHECK-NOT: LoopHint
# CHECK: [[innerFlat]]: flatstring = FlattenString v9
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v14: number = StringRangeCodeUnitOrNaN [[outerFlat]], -, -, v10
# CHECK-NEXT: v15: number = StringRangeCodeUnitOrNaN [[innerFlat]], -, -, v10
# CHECK-NOT: FlattenString
module m0 path="main.js" displayPath="main.js"
function f0 name="inner-loop-string" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
  b0(v0: string, v1: number):
    v2 = Integer integer=0
    v3 = Integer integer=1
    v4 = Undefined
    Jump -> next b1(v2, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b6()
  b2():
    v9 = ToString v5
    Jump -> next b3(v2, v6)
  b3(v10, v11):
    LoopHint
    v13 = Less v10, v1
    Branch v13 -> taken b4(), notTaken b5()
  b4():
    v14 = CallBuiltin v0, v10 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v15 = CallBuiltin v9, v10 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v16 = Add v10, v3
    Jump -> next b3(v16, v15)
  b5():
    v17 = Add v5, v3
    Jump -> next b1(v17, v11)
  b6():
    Return v6
}
