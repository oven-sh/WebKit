# A suspension behind the loop does not stop the string from being flattened on the entry: the flat string is dead there
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="await-after-loop" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f1
    Return v3
}

# CHECK-LABEL: function f1 name="await-after-loop"
# CHECK-NOT: LoopHint
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v11: number = StringRangeCodeUnitOrNaN [[flat]], -, -, v7
# CHECK: v13: anything = AwaitBySavingFrame v2, v3
# CHECK-NOT: FlattenString
function f1 name="await-after-loop" role=CoroutineBody flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = Undefined
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v1
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = CallBuiltin v0, v7 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v12 = Add v7, v5
    Jump -> next b1(v12, v11)
  b3():
    v13 = AwaitBySavingFrame v2, v3
    v14 = ReturnAsyncResult v3, v8
    Return v14
}
