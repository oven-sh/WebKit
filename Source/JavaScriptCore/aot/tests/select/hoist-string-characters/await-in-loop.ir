# No flat string lives across a suspension, so a string is not flattened for a loop that contains one, however rare
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 3

module m0 path="main.js" displayPath="main.js"
function f0 name="await-on-rare-path" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f1
    Return v3
}

# CHECK-LABEL: function f1 name="await-on-rare-path"
# CHECK-NOT: FlattenString
# CHECK: v11: number = StringRangeCodeUnitOrNaN v0, -, -, v7
# CHECK-NOT: FlattenString
# CHECK: v13: anything = AwaitBySavingFrame v2, v3
# CHECK-NOT: FlattenString
function f1 name="await-on-rare-path" role=CoroutineBody flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=3} {
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = Undefined
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v1
    Branch v10 -> taken b2(), notTaken b5()
  b2():
    v11 = CallBuiltin v0, v7 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v12 = Less v1, v7
    Branch v12 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v13 = AwaitBySavingFrame v2, v3
    Jump -> next b4()
  b4():
    v14 = Add v7, v5
    Jump -> next b1(v14, v11)
  b5():
    v15 = ReturnAsyncResult v3, v8
    Return v15
}

function f2 name="await-on-likely-path" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f3
    Return v3
}

# CHECK-LABEL: function f3 name="await-on-likely-path"
# CHECK-NOT: FlattenString
# CHECK: v11: number = StringRangeCodeUnitOrNaN v0, -, -, v7
# CHECK-NEXT: v12: anything = AwaitBySavingFrame v2, v3
# CHECK-NOT: FlattenString
function f3 name="await-on-likely-path" role=CoroutineBody flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=3} {
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = Undefined
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v1
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = CallBuiltin v0, v7 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v12 = AwaitBySavingFrame v2, v3
    v13 = Add v7, v5
    Jump -> next b1(v13, v11)
  b3():
    v14 = ReturnAsyncResult v3, v8
    Return v14
}

function f4 name="await-in-outer-loop" role=CoroutineRamp flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=3} {
    v3 = NewPromise
    v4 = CallDirect v0, v1, v2, v3 function=f5
    Return v3
}

# The inner loop contains no suspension, and a string flattened on its entry is dead at the await
# CHECK-LABEL: function f5 name="await-in-outer-loop"
# CHECK-NOT: FlattenString
# CHECK: v11: anything = AwaitBySavingFrame v2, v3
# CHECK-NEXT: [[flat5]]: flatstring = FlattenString v0
# CHECK-NEXT: Jump -> next b3(v4, v8)
# CHECK-NOT: FlattenString
# CHECK: v16: number = StringRangeCodeUnitOrNaN [[flat5]], -, -, v12
# CHECK-NOT: FlattenString
function f5 name="await-in-outer-loop" role=CoroutineBody flags=[IsAsync] parameters=[{type=string}, {type=number}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f5 entryWithoutPromise=f5 promiseType=Promise promiseParameter=3} {
    v4 = Integer integer=0
    v5 = Integer integer=1
    v6 = Undefined
    Jump -> next b1(v4, v6)
  b1(v7, v8):
    LoopHint
    v10 = Less v7, v1
    Branch v10 -> taken b2(), notTaken b6()
  b2():
    v11 = AwaitBySavingFrame v2, v3
    Jump -> next b3(v4, v8)
  b3(v12, v13):
    LoopHint
    v15 = Less v12, v1
    Branch v15 -> taken b4(), notTaken b5()
  b4():
    v16 = CallBuiltin v0, v12 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v17 = Add v12, v5
    Jump -> next b3(v17, v16)
  b5():
    v18 = Add v7, v5
    Jump -> next b1(v18, v13)
  b6():
    v19 = ReturnAsyncResult v3, v8
    Return v19
}
