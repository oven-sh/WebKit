# The length in the test of a loop and the code unit read in its body take the string that is flattened on the loop entry, and the sum stays an integer. A length alone flattens nothing
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="sumOfCodeUnits" parameters=[{type=string}] results=[{type=i32}] {
  b0(v0: string):
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3: i32, v4: int[0, 2147483647]):
    LoopHint
    v6 = GetStringLength v0
    v7 = Less v4, v6
    Branch v7 -> taken b2(| 0), notTaken b3()
  b2(v8):
    v9 = GetStringCodeUnit v0, v8
    v10 = Add v3, v9
    v11 = Integer
    v12 = BitOr v10, v11
    v13 = Increment v8
    Jump -> next b1(v12, v13)
  b3():
    Return v3
}
# CHECK-LABEL: function f0 name="sumOfCodeUnits"
# CHECK: [[flat]]: flatstring = FlattenString v0
# CHECK: LoopHint
# CHECK-NEXT: = GetStringLength [[flat]]
# CHECK: [[unit]]: int[0, 65535] = GetStringCodeUnit [[flat]], v8
# CHECK-NEXT: = Add v3, [[unit]] form=Integers

function f1 name="onlyLength" parameters=[{type=string}] results=[{type=i32}] {
  b0(v0: string):
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2: int[0, 2147483647]):
    LoopHint
    v4 = GetStringLength v0
    v5 = Less v2, v4
    Branch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Increment v6
    Jump -> next b1(v7)
  b3():
    Return v2
}
# CHECK-LABEL: function f1 name="onlyLength"
# CHECK-NOT: FlattenString
# CHECK: = GetStringLength v0
