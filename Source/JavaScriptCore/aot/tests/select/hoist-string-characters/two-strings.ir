# Two strings that are read in one loop are both flattened on its entry
# FORM: Prepared
# RUN: pass Select
# STATISTIC: HoistStringCharactersGroups = 2

# CHECK-NOT: LoopHint
# CHECK: [[firstFlat]]: flatstring = FlattenString
# CHECK: [[secondFlat]]: flatstring = FlattenString
# CHECK-NOT: FlattenString
# CHECK: LoopHint
# CHECK-NOT: FlattenString
# CHECK: v10: number = StringRangeCodeUnitOrNaN [[flatOfFirst]], -, -, v6
# CHECK-NEXT: v11: number = StringRangeCodeUnitOrNaN [[flatOfSecond]], -, -, v6
# CHECK-NOT: FlattenString
# RUN(FIRST): pass Select
# FIRST: [[flat]]: flatstring = FlattenString v0
# FIRST: v10: number = StringRangeCodeUnitOrNaN [[flat]], -, -, v6
# RUN(SECOND): pass Select
# SECOND: [[flat]]: flatstring = FlattenString v2
# SECOND: v11: number = StringRangeCodeUnitOrNaN [[flat]], -, -, v6
module m0 path="main.js" displayPath="main.js"
function f0 name="two-strings" parameters=[{type=string}, {type=number}, {type=string}] results=[{type=anything}] {
    v3 = Integer integer=0
    v4 = Integer integer=1
    v5 = Undefined
    Jump -> next b1(v3, v5)
  b1(v6, v7):
    LoopHint
    v9 = Less v6, v1
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = CallBuiltin v0, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v11 = CallBuiltin v2, v6 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v12 = Add v6, v4
    Jump -> next b1(v12, v11)
  b3():
    Return v7
}
