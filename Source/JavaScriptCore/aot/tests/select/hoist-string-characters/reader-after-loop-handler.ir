# The string is flattened in a block of its own on the entry of a loop, under the handler of the loop. The handler is reached from that block too, in front of the flat string,
# so a reader behind the handler reads the string itself. A reader in the loop reads the flat string.
# FORM: Prepared
# OPTIONS: check=VerifyEachPass
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="reader-behind-the-handler" parameters=[{type=string}, {type=number}] results=[{type=anything}] {
    v2 = Undefined
    v3 = Integer integer=0
    v4 = Integer integer=1
    Jump -> next b1(v3, v2)
  b1(v5, v6) handler=b4():
    LoopHint
    v8 = Less v5, v1
    Branch v8 -> taken b2(), notTaken b3()
  b2() handler=b4():
    v9 = CallBuiltin v0, v5 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    v10 = Add v5, v4
    Jump -> next b1(v10, v9)
  b3():
    Jump -> next b5()
  b4() role=CatchHandler:
    v11 = CatchValue
    Jump -> next b5()
  b5():
    v12 = CallBuiltin v0, v3 overload=StringPrototypeCharCodeAt/0 builtinCallForm=Whole
    Return v12
# CHECK: = StringRangeCodeUnitOrNaN [[flat]], -, -, v5
# CHECK: role=CatchHandler
# CHECK: = StringRangeCodeUnitOrNaN v0, -, -,
# CHECK: handler=b4():
# CHECK-NEXT: [[flat]]: flatstring = FlattenString v0
}
