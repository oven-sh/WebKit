# A read by name whose only use is the claim of a written type is one operation, with or without an exception handler around it
# FORM: Prepared
# RUN: pass Select
# STATISTIC: CheckedPropertyReadGroups = 2

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=30 kind=PropertyRead
layout L0 name="Names" fields=[{key="a" declared={type=number}}]
function f0 name="plain" parameters=[{type=anything}] results=[{type=undefined|null|number}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    v2 = Claim v1 castType=undefined|null|number site=w0
    Return v2
}
# CHECK-LABEL: function f0 name="plain"
# CHECK-NOT: = Claim
# CHECK: [[read0]]: undefined|null|number = PropGetChecked v0 key="a" checkedType=undefined|null|number site=w0
# CHECK-NEXT: Return [[read0]]

function f1 name="underHandler" parameters=[{type=anything}] results=[{type=undefined|null|number}] {
  b0(v0: anything):
    Jump -> next b1()
  b1() handler=b2():
    v1 = PropGet v0 key="a"
    v2 = Claim v1 castType=undefined|null|number site=w0
    Jump -> next b3(v2)
  b2() role=CatchHandler:
    v3 = Integer integer=1
    Jump -> next b3(v3)
  b3(v4: undefined|null|number):
    Return v4
}
# CHECK-LABEL: function f1 name="underHandler"
# CHECK: b1() handler=b2():
# CHECK-NEXT: [[read1]]: undefined|null|number = PropGetChecked v0 key="a" checkedType=undefined|null|number site=w0
# CHECK-NEXT: Jump -> next b3([[read1]])

function f2 name="readUsedTwice" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    v2 = Claim v1 castType=undefined|null|number site=w0
    Return v1
}
# CHECK-LABEL: function f2 name="readUsedTwice"
# CHECK-NOT: PropGetChecked
# CHECK: = PropGet v0 key="a"
# CHECK-NEXT: = Claim

function f3 name="typeWithoutCheckedForm" parameters=[{type=anything}] results=[{type=number}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    v2 = Claim v1 castType=number site=w0
    Return v2
}
# CHECK-LABEL: function f3 name="typeWithoutCheckedForm"
# CHECK-NOT: PropGetChecked
# CHECK: = PropGet v0 key="a"
# CHECK-NEXT: = Claim
