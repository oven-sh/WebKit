# A call of a value that does not vary in a loop finds its code address once, in front of the outermost such loop
# FORM: Prepared
# RUN: pass Select
# STATISTIC: ResolvedCallTargetGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="invariant-callee" parameters=[{type=anything}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Call v0, -, v2
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f0 name="invariant-callee"
# CHECK-NEXT: b0(
# CHECK-NEXT: [[target]]: codeaddress = ResolveCallTarget v0 argumentCount=1
# CHECK-NEXT: Jump -> next b1()
# CHECK: anything = CallResolved v0, [[target]], -, v2

function f1 name="nested-loops" parameters=[{type=anything}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    Jump -> next b2()
  b2():
    LoopHint
    v5 = Call v0, v2
    Branch v1 -> taken b2(), notTaken b3()
  b3():
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Return
}
# CHECK-LABEL: function f1 name="nested-loops"
# CHECK-NEXT: b0(
# CHECK-NEXT: [[outer]]: codeaddress = ResolveCallTarget v0
# CHECK-NEXT: Jump -> next b1()
# CHECK-NOT: ResolveCallTarget
# CHECK: anything = CallResolved v0, [[outer]], v2

function f2 name="call-in-rare-block" parameters=[{type=anything}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b2(), notTaken b3()
  b2() frequency=Rare:
    v4 = Call v0, -, v2
    Jump -> next b3()
  b3():
    Branch v1 -> taken b1(), notTaken b4()
  b4():
    Return
}
# CHECK-LABEL: function f2 name="call-in-rare-block"
# CHECK-NOT: ResolveCallTarget
# CHECK: anything = Call v0, -, v2

function f3 name="call-after-loop" parameters=[{type=anything}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    v4 = Call v0, -, v2
