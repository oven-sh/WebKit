# Expected types are removed before the rules run, so a callee with an expected type, on the value or under its casts, is resolved like any other
# FORM: Prepared
# RUN: pass Select
# STATISTIC: ResolvedCallTargetGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="expected-callee" parameters=[{type=f2 flags=[IsExpected]}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything ~ f2, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Call v0, -, v2
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f0 name="expected-callee"
# CHECK-NEXT: b0(v0: anything, v1: boolean, v2: anything):
# CHECK-NEXT: [[target]]: codeaddress = ResolveCallTarget v0 argumentCount=1
# CHECK: anything = CallResolved v0, [[target]], -, v2

function f1 name="expected-type-under-cast" parameters=[{type=f2 flags=[IsExpected]}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything ~ f2, v1: boolean, v2: anything):
    v3 = Upcast v0 castType=anything
    Jump -> next b1()
  b1():
    LoopHint
    v5 = Call v3, -, v2
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: function f1 name="expected-type-under-cast"
# CHECK-NEXT: b0(v0: anything, v1: boolean, v2: anything):
# CHECK-NEXT: [[cast]]: anything = Upcast v0 castType=anything
# CHECK-NEXT: [[second]]: codeaddress = ResolveCallTarget [[cast]] argumentCount=1
# CHECK: anything = CallResolved [[cast]], [[second]], -, v2

function f2 name="target" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
