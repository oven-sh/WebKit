# A call by value of one known function has the type of that function's result. The call with a resolved target that takes its place has it too, so a cast that rests on it stays valid
# FORM: Prepared
# RUN: pass Select
# STATISTIC: ResolvedCallTargetGroups = 1

module m0 path="main.js" displayPath="main.js"
function f0 name="isWanted" kind=Arrow parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = Undefined
    v2 = StrictEq v0, v1
    Return v2
}
function f1 name="one-known-callee" parameters=[{type=anything}, {type=boolean}] results=[{type=boolean}] {
    v2 = NewClosure function=f0
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Call v2, -, v0
    v5 = Upcast v4 castType=boolean
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    Return v5
  b3():
    Branch v1 -> taken b1(), notTaken b2()
}
# CHECK: [[target]]: codeaddress = ResolveCallTarget v2 argumentCount=1
# CHECK: [[result]]: boolean = CallResolved v2, [[target]], -, v0
# CHECK-NEXT: boolean = Upcast [[result]] castType=boolean
