# With the two rules switched off a read and a call stay a read and a call
# FORM: Prepared
# OPTIONS: disable=rule:MethodCall,rule:ResolvedCallTarget
# RUN: pass Select
# STATISTIC: MethodCallGroups = 0
# STATISTIC: ResolvedCallTargetGroups = 0
# CHECK-NOT: ResolveCallTarget
# CHECK: anything = Call v0, -, v2
# CHECK-NOT: CallMethod
# CHECK: [[read]]: anything = PropGet v0 key="m"
# CHECK-NEXT: anything = Call [[read]], v0, v1 calleeKey="m"

module m0 path="main.js" displayPath="main.js"
function f0 name="invariant-callee" parameters=[{type=anything}, {type=boolean}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: boolean, v2: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v4 = Call v0, -, v2
    Branch v1 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="read-and-call" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="m"
    v3 = Call v2, v0, v1 calleeKey="m"
    Return v3
}
