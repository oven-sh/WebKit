  b1():
    v3 = Integer
    v4 = Unspecified valueType=anything
    Jump -> next b3(v3, v4)
  b2():
    v5 = Integer integer=1
    Jump -> next b3(v5, v0)
  b3(v6, v7):
    Jump -> next b4()
  b4():
    LoopHint
    Switch v6 cases=[0] -> case b6(), otherwise b5()
  b5():
    v9 = Specified
    v10 = AssumeType v7, v9 provenType=anything
    v11 = Call v10, -
    Jump -> next b6()
  b6():
    Branch v2 -> taken b4(), notTaken b7()
  b7():
    Return
# CHECK-NOT: ResolveCallTarget
# CHECK: anything = Call v10
}

