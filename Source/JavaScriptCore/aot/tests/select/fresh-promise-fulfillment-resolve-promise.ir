# A promise that no operation has taken since its allocation is fulfilled by two stores, under a test of the value where its type admits a thenable
# FORM: Prepared
# OPTIONS: heat=everything-is-hot
# STATISTIC: FreshPromiseFulfillmentGroups = 6
# RUN: pass Select
# RUN(SLOW): pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="number" results=[{type=Promise}] {
  b0():
    v0 = Integer integer=7
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
}
# CHECK-LABEL: function f0 name="number"
# CHECK-NOT: ResolvePromise
# CHECK: v1: Promise = NewPromise
# CHECK-NEXT: FulfillFreshPromise v1, v0
# CHECK-NEXT: Return v1

function f1 name="string-or-undefined" parameters=[{type=undefined|string}] results=[{type=Promise}] {
  b0(v0: undefined|string):
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
}
# CHECK-LABEL: function f1 name="string-or-undefined"
# CHECK-NOT: ResolvePromise
# CHECK: FulfillFreshPromise v1, v0

function f2 name="unknown-code-that-does-not-get-the-promise" parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: anything):
    v1 = NewPromise
    v2 = Call v0
    v3 = Integer integer=7
    ResolvePromise v1, v3
    Return v1
}
# CHECK-LABEL: function f2 name="unknown-code-that-does-not-get-the-promise"
# CHECK-NOT: ResolvePromise
# CHECK: FulfillFreshPromise v1, v3

function f3 name="through-a-cast" results=[{type=object}] {
  b0():
    v0 = Integer integer=7
    v1 = NewPromise
    v2 = Upcast v1 castType=object
    ResolvePromise v2, v0
    Return v2
}
# CHECK-LABEL: function f3 name="through-a-cast"
# CHECK-NOT: ResolvePromise
# CHECK: FulfillFreshPromise v2, v0

function f4 name="passed-to-unknown-code-first" parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: anything):
    v1 = Integer integer=7
    v2 = NewPromise
    v3 = Call v0, -, v2
    ResolvePromise v2, v1
    Return v2
}
# CHECK-LABEL: function f4 name="passed-to-unknown-code-first"
# CHECK-NOT: FulfillFreshPromise
# CHECK: ResolvePromise v2, v1
# CHECK-NOT: FulfillFreshPromise

function f5 name="cast-passed-to-unknown-code-first" parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: anything):
    v1 = Integer integer=7
    v2 = NewPromise
    v3 = Upcast v2 castType=object
    v4 = Call v0, -, v3
    ResolvePromise v2, v1
    Return v2
}
# CHECK-LABEL: function f5 name="cast-passed-to-unknown-code-first"
# CHECK-NOT: FulfillFreshPromise
# CHECK: ResolvePromise v2, v1
# CHECK-NOT: FulfillFreshPromise

function f6 name="resolved-twice" results=[{type=Promise}] {
  b0():
    v0 = Integer integer=7
    v1 = NewPromise
    ResolvePromise v1, v0
    ResolvePromise v1, v0
    Return v1
}
# CHECK-LABEL: function f6 name="resolved-twice"
# CHECK: FulfillFreshPromise v1, v0
# CHECK-NEXT: ResolvePromise v1, v0
# CHECK-NOT: FulfillFreshPromise

function f7 name="rejected-first" results=[{type=Promise}] {
  b0():
    v0 = Integer integer=7
    v1 = NewPromise
    RejectPromise v1, v0
    ResolvePromise v1, v0
    Return v1
}
# CHECK-LABEL: function f7 name="rejected-first"
# CHECK-NOT: FulfillFreshPromise
# CHECK: ResolvePromise v1, v0
# CHECK-NOT: FulfillFreshPromise

function f8 name="allocated-in-front-of-a-loop" parameters=[{type=boolean}] results=[{type=Promise}] {
  b0(v0: boolean):
    v1 = Integer integer=7
    v2 = NewPromise
    Jump -> next b1()
  b1():
    LoopHint
    ResolvePromise v2, v1
    Branch v0 -> taken b1(), notTaken b2()
  b2():
    Return v2
}
# CHECK-LABEL: function f8 name="allocated-in-front-of-a-loop"
# CHECK-NOT: FulfillFreshPromise
# CHECK: ResolvePromise v2, v1
# CHECK-NOT: FulfillFreshPromise

function f9 name="promise-of-a-caller" parameters=[{type=Promise}] results=[{type=Promise}] {
  b0(v0: Promise):
    v1 = Integer integer=7
    ResolvePromise v0, v1
    Return v0
}
# CHECK-LABEL: function f9 name="promise-of-a-caller"
# CHECK-NOT: FulfillFreshPromise
# CHECK: ResolvePromise v0, v1
# CHECK-NOT: FulfillFreshPromise

function f10 name="value-may-be-thenable" parameters=[{type=anything}] results=[{type=Promise}] {
  b0(v0: anything):
    v1 = NewPromise
    ResolvePromise v1, v0
    Return v1
}
# CHECK-LABEL: function f10 name="value-may-be-thenable"
# CHECK: [[notThenable10]]: boolean = IsNotThenable v0
# CHECK-NEXT: Branch [[notThenable10]] -> taken [[fast10]](| 0), notTaken [[slow10]]()
# CHECK: [[fast10]]([[guard10]]: guard):
# CHECK-NEXT: FulfillFreshPromise v1, v0, [[guard10]]
# SLOW-LABEL: function f10 name="value-may-be-thenable"
# SLOW: Branch [[notThenable10]] -> taken [[fast10]](| 0), notTaken [[slow10]]()
# SLOW: [[slow10]]() frequency=Rare:
# SLOW-NEXT: ResolvePromise v1, v0

function f11 name="value-may-be-thenable-in-rare-block" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v2 = NewPromise
    ResolvePromise v2, v0
    Return v2
  b2():
    Return v0
}
# CHECK-LABEL: function f11 name="value-may-be-thenable-in-rare-block"
# CHECK-NOT: IsNotThenable
# CHECK: ResolvePromise v2, v0
# CHECK-NOT: FulfillFreshPromise
