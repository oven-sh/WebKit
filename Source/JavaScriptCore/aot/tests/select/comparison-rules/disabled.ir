# With the two rules switched off the comparisons stay as they are
# FORM: Prepared
# OPTIONS: disable=rule:IntegerBound,rule:SharedStringOrder
# RUN: pass Select
# STATISTIC: IntegerBoundGroups = 0
# STATISTIC: SharedStringOrderGroups = 0
# CHECK-NOT: IntegerBound
# CHECK-NOT: StringOrder

module m0 path="main.js" displayPath="main.js"
function f0 name="invariant-number" parameters=[{type=int}, {type=number}] results=[{type=int}] {
    v2 = Integer integer=1
    v3 = Integer integer=0
    Jump -> next b1(v0)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v4, v2
    v8 = BitOr v7, v3
    Jump -> next b1(v8)
  b3():
    Return v4
}
function f1 name="constant-number" parameters=[{type=int}] results=[{type=boolean}] {
    v1 = Double number=2.5
    v2 = Less v0, v1
    Return v2
}
function f2 name="comparator" parameters=[{type=string}, {type=string}] results=[{type=int}] {
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=-1
    Return v3
  b2():
    v4 = Greater v0, v1
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = Integer integer=1
    Return v5
  b4():
    v6 = Integer integer=0
    Return v6
}
