# StringOrder takes strings, so comparisons of operands that may be undefined stay as they are
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SharedStringOrderGroups = 0
# CHECK-NOT: StringOrder
# CHECK: boolean = Less v0, v1
# CHECK-NOT: StringOrder
# CHECK: boolean = Greater v0, v1
# CHECK-NOT: StringOrder

module m0 path="main.js" displayPath="main.js"
function f0 name="nullable-comparator" parameters=[{type=undefined|string}, {type=undefined|string}] results=[{type=int}] {
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=-1
    Return v3
  b2():
    v4 = Greater v0, v1
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = Integer integer=1
    Return v5
  b4():
    v6 = Integer integer=0
    Return v6
}
