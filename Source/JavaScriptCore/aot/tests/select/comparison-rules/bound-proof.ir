# A comparison whose branch passes a proof keeps its operands, because the type on the edge depends on them
# FORM: Prepared
# RUN: pass Select
# STATISTIC: IntegerBoundGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="loop-condition-passes-proof" parameters=[{type=int}, {type=number}] results=[{type=int}] {
    v2 = Integer integer=1
    v3 = Integer integer=0
    Jump -> next b1(v0)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(| 0), notTaken b3()
  b2(v7):
    v8 = Add v7, v2
    v9 = BitOr v8, v3
    Jump -> next b1(v9)
  b3():
    Return v4
# CHECK-NOT: IntegerBound
# CHECK: boolean = Less v4, v1
}

function f1 name="loop-condition-without-proof" parameters=[{type=int}, {type=number}] results=[{type=int}] {
    v2 = Integer integer=1
    v3 = Integer integer=0
    Jump -> next b1(v0)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Add v4, v2
    v8 = BitOr v7, v3
    Jump -> next b1(v8)
  b3():
    Return v4
# CHECK: [[bound]]: int = IntegerBound v1 comparison=Less
# CHECK: boolean = Less v4, [[bound]]
}

function f2 name="constant-condition-passes-proof" parameters=[{type=int}] results=[{type=int}] {
    v1 = Double number=2.5
    v2 = Less v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    Return v3
  b2():
    Return v0
# CHECK-NOT: = Integer
# CHECK: boolean = Less v0, v1
}

function f3 name="constant-condition-without-proof" parameters=[{type=int}] results=[{type=int}] {
    v1 = Double number=2.5
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return v0
# CHECK: [[three]]: 3 = Integer integer=3
# CHECK-NEXT: boolean = Less v0, [[three]]
}
