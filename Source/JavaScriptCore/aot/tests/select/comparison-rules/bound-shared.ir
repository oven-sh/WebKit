# Comparisons of one loop with the same number, operation and side share a bound, and another operation gets its own
# FORM: Prepared
# RUN: pass Select
# STATISTIC: IntegerBoundGroups = 1
# CHECK: [[less]]: int = IntegerBound v1 comparison=Less
# CHECK-NEXT: [[lessOrEqual]]: int = IntegerBound v1 comparison=LessEq
# CHECK-NEXT: Jump -> next b1(v0)
# CHECK-NOT: IntegerBound
# CHECK: boolean = Less v4, [[less]]
# CHECK: [[next]]: i32 = BitOr
# CHECK: boolean = Less [[next]], [[less]]
# CHECK: boolean = LessEq [[next]], [[lessOrEqual]]

module m0 path="main.js" displayPath="main.js"
function f0 name="three-comparisons" parameters=[{type=int}, {type=number}] results=[{type=int}] {
    v2 = Integer integer=1
    v3 = Integer integer=0
    Jump -> next b1(v0)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b5()
  b2():
    v7 = Add v4, v2
    v8 = BitOr v7, v3
    v9 = Less v8, v1
    Branch v9 -> taken b3(), notTaken b5()
  b3():
    v10 = LessEq v8, v1
    Branch v10 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b1(v8)
  b5():
    Return v4
}
