# The bound goes in front of the outermost loop in which the number is invariant
# FORM: Prepared
# RUN: pass Select
# STATISTIC: IntegerBoundGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="number-outside-both-loops" parameters=[{type=int}, {type=number}, {type=boolean}] results=[{type=int}] {
    v3 = Integer integer=1
    v4 = Integer integer=0
    Jump -> next b1(v0)
  b1(v5):
    LoopHint
    Branch v2 -> taken b2(v5), notTaken b5()
  b2(v7):
    LoopHint
    v9 = Less v7, v1
    Branch v9 -> taken b3(), notTaken b4()
  b3():
    v10 = Add v7, v3
    v11 = BitOr v10, v4
    Jump -> next b2(v11)
  b4():
    Jump -> next b1(v7)
  b5():
    Return v5
# CHECK: [[outer]]: int = IntegerBound v1 comparison=Less
# CHECK-NEXT: Jump -> next b1(v0)
# CHECK-NOT: IntegerBound
# CHECK: Branch v2 -> taken b2(v5), notTaken b5()
# CHECK: boolean = Less v7, [[outer]]
# CHECK-NOT: b6
}

function f1 name="number-from-outer-loop" parameters=[{type=int}, {type=number}, {type=boolean}] results=[{type=int}] {
    v3 = Integer integer=1
    v4 = Integer integer=0
    Jump -> next b1(v0, v1)
  b1(v5, v6):
    LoopHint
    Branch v2 -> taken b2(v5), notTaken b5()
  b2(v8):
    LoopHint
    v10 = Less v8, v6
    Branch v10 -> taken b3(), notTaken b4()
  b3():
    v11 = Add v8, v3
    v12 = BitOr v11, v4
    Jump -> next b2(v12)
  b4():
    v13 = Add v6, v3
    Jump -> next b1(v8, v13)
  b5():
    Return v5
# CHECK-NOT: IntegerBound
# CHECK: Branch v2 -> taken [[entry]](), notTaken b5()
# CHECK-NOT: IntegerBound
# CHECK: boolean = Less v8, [[inner]]
# CHECK-NOT: IntegerBound
# CHECK: [[entry]]():
# CHECK-NEXT: [[inner]]: int = IntegerBound v6 comparison=Less
# CHECK-NEXT: Jump -> next b2(v5)
}
