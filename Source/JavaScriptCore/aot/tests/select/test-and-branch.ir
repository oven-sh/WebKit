# A condition whose only use is the branch of its block is fused into the branch
# FORM: Prepared
# OPTIONS: heat=only-loops-are-hot
# STATISTIC: TestAndBranchGroups = 6
# RUN: pass Select

module m0 path="main.js" displayPath="main.js"
function f0 name="less" parameters=[{type=anything}, {type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
