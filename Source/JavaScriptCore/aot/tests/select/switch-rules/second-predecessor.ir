# A block with a second predecessor cannot be a later link of a chain, and it can be the head of one
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="jump-to-third-link"
# CHECK-NOT: Switch
function f0 name="jump-to-third-link" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b5()
  b1():
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3():
    v4 = String string="b"
    v5 = StrictEq v0, v4
    Branch v5 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    v6 = String string="c"
    v7 = StrictEq v0, v6
    Branch v7 -> taken b6(), notTaken b7()
  b6():
    Return v0
  b7():
    v8 = String string="d"
    v9 = StrictEq v0, v8
    Branch v9 -> taken b8(), notTaken b9()
  b8():
    Return v0
  b9():
    Return v0
}

# CHECK-LABEL: function f1 name="jump-to-head"
# CHECK: Branch v1 -> taken b1(), notTaken b3()
# CHECK: b3():
# CHECK: SwitchString v0 strings=["b", "c", "d"] -> case b4(), case b5(), case b6(), otherwise b7()
function f1 name="jump-to-head" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    Branch v1 -> taken b1(), notTaken b3()
  b1():
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b2(), notTaken b3()
  b2():
    Return v0
  b3():
    v4 = String string="b"
    v5 = StrictEq v0, v4
    Branch v5 -> taken b4(), notTaken b5()
  b4():
    Return v0
  b5():
    v6 = String string="c"
    v7 = StrictEq v0, v6
    Branch v7 -> taken b6(), notTaken b7()
  b6():
    Return v0
  b7():
    v8 = String string="d"
    v9 = StrictEq v0, v8
    Branch v9 -> taken b8(), notTaken b9()
  b8():
    Return v0
  b9():
    Return v0
}
