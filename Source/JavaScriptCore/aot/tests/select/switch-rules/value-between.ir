# A later link may contain only its comparison and constants, which move to the head
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="call-in-third-block"
# CHECK-NOT: Switch
function f0 name="call-in-third-block" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = String string="b"
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = Call v1
    v7 = String string="c"
    v8 = StrictEq v0, v7
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v9 = String string="d"
    v10 = StrictEq v0, v9
    Branch v10 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}

# CHECK-LABEL: function f1 name="constant-used-later"
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: [[third]]: "c" = String string="c"
# CHECK-NEXT: SwitchString v0 strings=["a", "b", "c", "d"] -> case b1(), case b2(), case b3(), case b4(), otherwise b5()
# CHECK: b3():
# CHECK-NEXT: Return [[third]]
function f1 name="constant-used-later" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v5
  b6():
    v7 = String string="d"
    v8 = StrictEq v0, v7
    Branch v8 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}

# CHECK-LABEL: function f2 name="comparison-used-later"
# CHECK-NOT: Switch
function f2 name="comparison-used-later" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v6
  b6():
    Return v0
}

# CHECK-LABEL: function f3 name="negated-comparison"
# CHECK-NOT: Switch
function f3 name="negated-comparison" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    v7 = LogicalNot v6
    Branch v7 -> taken b6(), notTaken b5()
  b5():
    Return v0
  b6():
    Return v0
}
