# The default of a switch passes no proof, so a chain is converted only where nothing but its comparisons relies on a subject narrowed by a failed comparison
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 2

module m0 path="main.js" displayPath="main.js"
function f0 name="narrower-type-returned" parameters=[{type="a"|"b"|"c"|"d"}] results=[{type=anything}] {
  b0(v0: "a"|"b"|"c"|"d"):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    Return v0
  b2(v3):
    v4 = String string="b"
    v5 = StrictEq v3, v4
    Branch v5 -> taken b3(), notTaken b4(| 0)
  b3():
    Return v0
  b4(v6):
    v7 = String string="c"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b5(), notTaken b6(| 0)
  b5():
    Return v0
  b6(v9):
    Return v9
}
# CHECK-LABEL: function f0 name="narrower-type-returned"
# CHECK-NOT: Switch

function f1 name="narrower-type-only-compared" parameters=[{type="a"|"b"|"c"|"d"}] results=[{type=anything}] {
  b0(v0: "a"|"b"|"c"|"d"):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    Return v0
  b2(v3):
    v4 = String string="b"
    v5 = StrictEq v3, v4
    Branch v5 -> taken b3(), notTaken b4(| 0)
  b3():
    Return v0
  b4(v6):
    v7 = String string="c"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
# CHECK-LABEL: function f1 name="narrower-type-only-compared"
# CHECK: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()

function f2 name="same-type-returned" parameters=[{type=string}] results=[{type=anything}] {
  b0(v0: string):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    Return v0
  b2(v3):
    v4 = String string="b"
    v5 = StrictEq v3, v4
    Branch v5 -> taken b3(), notTaken b4(| 0)
  b3():
    Return v0
  b4(v6):
    v7 = String string="c"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b5(), notTaken b6(| 0)
  b5():
    Return v0
  b6(v9):
    Return v9
}
# CHECK-LABEL: function f2 name="same-type-returned"
# CHECK: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK: b4():
# CHECK-NEXT: Return v0
