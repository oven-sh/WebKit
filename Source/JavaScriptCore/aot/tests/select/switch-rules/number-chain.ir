# An if chain that compares one number with integer constants becomes one Switch
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchNumberGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="three-numbers"
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: Switch v0 cases=[1, 2, 3] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK-NEXT: b1():
# CHECK-NOT: StrictEq
function f0 name="three-numbers" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
# REPEAT: i = 1..3
    v%(i*2-1) = Integer integer=%(i)
    v%(i*2) = StrictEq v0, v%(i*2-1)
    Branch v%(i*2) -> taken b%(i*2-1)(), notTaken b%(i*2)()
  b%(i*2-1)():
    Return v0
  b%(i*2)():
# END REPEAT
    Return v0
}

# CHECK-LABEL: function f1 name="loose-equality"
# CHECK-NOT: Switch
function f1 name="loose-equality" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=2
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Integer integer=3
    v6 = Eq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
