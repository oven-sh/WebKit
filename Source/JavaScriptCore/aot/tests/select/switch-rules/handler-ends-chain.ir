# A block under another handler than the head is not a link of the chain
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="third-comparison-under-handler"
# CHECK-NOT: Switch
function f0 name="third-comparison-under-handler" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4() handler=b9():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v7 = String string="d"
    v8 = StrictEq v0, v7
    Branch v8 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
  b9() role=CatchHandler:
    v9 = CatchValue
    Return v9
}

# CHECK-LABEL: function f1 name="every-comparison-under-one-handler"
# CHECK-NEXT: b0(v0: anything) handler=b5():
# CHECK: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK: b5() role=CatchHandler:
function f1 name="every-comparison-under-one-handler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b7():
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2() handler=b7():
    v3 = String string="b"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4() handler=b7():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
  b7() role=CatchHandler:
    v7 = CatchValue
    Return v7
}
