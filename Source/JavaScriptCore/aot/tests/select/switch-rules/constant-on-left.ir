# A comparison is a link of the chain no matter which operand is the constant
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="second-constant-on-left"
# CHECK-NEXT: b0(v0: anything):
# CHECK-NEXT: = String string="a"
# CHECK-NEXT: = String string="b"
# CHECK-NEXT: = String string="c"
# CHECK-NEXT: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK-NOT: StrictEq
function f0 name="second-constant-on-left" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = StrictEq v3, v0
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = String string="c"
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}

# CHECK-LABEL: function f1 name="two-constants"
# CHECK-NOT: Switch
function f1 name="two-constants" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = String string="b"
    v4 = String string="b"
    v5 = StrictEq v3, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = String string="c"
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
