# A comparison with a fraction is not a case, so its block becomes the default target of the preceding switch
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchNumberGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="fraction-after-three-integers"
# CHECK: Switch v0 cases=[1, 2, 3] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK: b4():
# CHECK-NEXT: [[fraction]]: fractional = Double number=2.5
# CHECK-NEXT: [[first]]: boolean = StrictEq v0, [[fraction]]
# CHECK-NEXT: Branch [[first]] -> taken b5(), notTaken b6()
# CHECK: b6():
# CHECK-NEXT: [[four]]: 4 = Integer integer=4
# CHECK-NEXT: [[second]]: boolean = StrictEq v0, [[four]]
# CHECK-NEXT: Branch [[second]] -> taken b7(), notTaken b8()
function f0 name="fraction-after-three-integers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=2
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Integer integer=3
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v7 = Double number=2.5
    v8 = StrictEq v0, v7
    Branch v8 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    v9 = Integer integer=4
    v10 = StrictEq v0, v9
    Branch v10 -> taken b9(), notTaken b10()
  b9():
    Return v0
  b10():
    Return v0
}

# CHECK-LABEL: function f1 name="fraction-after-two-integers"
# CHECK-NOT: Switch
function f1 name="fraction-after-two-integers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=2
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Double number=2.5
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v7 = Integer integer=3
    v8 = StrictEq v0, v7
    Branch v8 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}
