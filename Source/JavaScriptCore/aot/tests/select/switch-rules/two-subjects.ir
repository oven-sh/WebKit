# A comparison of a different value ends the chain
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="third-link-compares-another-value"
# CHECK-NOT: Switch
function f0 name="third-link-compares-another-value" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = String string="b"
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = String string="c"
    v7 = StrictEq v1, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v8 = String string="d"
    v9 = StrictEq v0, v8
    Branch v9 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}

# CHECK-LABEL: function f1 name="fourth-link-compares-another-value"
# CHECK: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK: b4():
# CHECK-NEXT: = ValueEqualsLiteral v1 literal="d"
function f1 name="fourth-link-compares-another-value" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = String string="b"
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = String string="c"
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    v8 = String string="d"
    v9 = StrictEq v1, v8
    Branch v9 -> taken b7(), notTaken b8()
  b7():
    Return v0
  b8():
    Return v0
}
