# Links that compare casts of the same value share a subject
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchStringGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="cast-in-head"
# CHECK-NEXT: b0(v0: string):
# CHECK-NEXT: = Upcast v0 castType=anything
# CHECK: SwitchString v0 strings=["a", "b", "c"] -> case b1(), case b2(), case b3(), otherwise b4()
# CHECK-NEXT: b1():
function f0 name="cast-in-head" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Upcast v0 castType=anything
    v2 = String string="a"
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = String string="b"
    v5 = StrictEq v1, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = String string="c"
    v7 = StrictEq v1, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}

# CHECK-LABEL: function f1 name="cast-in-link"
# CHECK-NOT: Switch
function f1 name="cast-in-link" parameters=[{type=string}] results=[{type=anything}] {
    v1 = String string="a"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Upcast v0 castType=anything
    v4 = String string="b"
    v5 = StrictEq v3, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = String string="c"
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}

# CHECK-LABEL: function f2 name="cast-of-another-value"
# CHECK-NOT: Switch
function f2 name="cast-of-another-value" parameters=[{type=string}, {type=string}] results=[{type=anything}] {
    v2 = Upcast v1 castType=anything
    v3 = String string="a"
    v4 = StrictEq v0, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v5 = String string="b"
    v6 = StrictEq v2, v5
    Branch v6 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v7 = String string="c"
    v8 = StrictEq v2, v7
    Branch v8 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}
