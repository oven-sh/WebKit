# A chain that compares an integer belongs to InferSwitches, and selection leaves it as it is
# FORM: Prepared
# RUN: pass Select
# STATISTIC: SwitchNumberGroups = 1

module m0 path="main.js" displayPath="main.js"
# CHECK-LABEL: function f0 name="three-integers"
# CHECK-NOT: Switch
function f0 name="three-integers" parameters=[{type=i32}] results=[{type=i32}] {
  b0(v0: i32):
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v3 = Integer integer=2
    v4 = StrictEq v0, v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v5 = Integer integer=3
    v6 = StrictEq v0, v5
    Branch v6 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v0
}

# CHECK-LABEL: function f1 name="number-cast-to-integer-after-chain"
# CHECK-NEXT: b0(v0: number):
# CHECK-NEXT: [[integer]]: i32 = AssumeType v0 castType=i32
# CHECK: Switch v0 cases=[1, 2, 3] -> case b1(), case b2(), case b3(), otherwise b4()
function f1 name="number-cast-to-integer-after-chain" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = AssumeType v0 castType=i32
    v2 = Integer integer=1
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = Integer integer=2
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = Integer integer=3
    v7 = StrictEq v0, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v1
}

# CHECK-LABEL: function f2 name="integer-ends-chain"
# CHECK-NOT: Switch
function f2 name="integer-ends-chain" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = AssumeType v0 castType=i32
    v2 = Integer integer=1
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    v4 = Integer integer=2
    v5 = StrictEq v0, v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    Return v0
  b4():
    v6 = Integer integer=3
    v7 = StrictEq v1, v6
    Branch v7 -> taken b5(), notTaken b6()
  b5():
    Return v0
  b6():
    Return v1
}
