# A literal whose pattern is plain text is searched for like a string, while its object stays as created and nothing reads what the last match left in RegExp
# TODO: flow-termination: `/abc/` read from a module variable has lost its text, so test and search are no searches for a literal string
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: pipeline Select
# RUN(BUILD): compile
# BUILD: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="plainText" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="compiledAgain" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewRegExp pattern="abc" @10
    PutModuleVariable v0 variable=g0
    v2 = NewRegExp pattern="abc" @20
    PutModuleVariable v2 variable=g1
    v4 = String string="c"
    v5 = PropGet v2 key="compile"
    v6 = Call v5, v2, v4 calleeKey="compile"
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="text" [isFreeName]
    v9 = ToString v8
    v10 = CallDirect v9 function=f1
    v11 = CallDirect v9 function=f2
    v12 = CallDirect v9 function=f3
    v13 = CallDirect v9 function=f4
    v14 = NewArray v10, v11, v12, v13 contents=anything holes=[]
    Return v14
}
function f1 name="test" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = PropGet v1 key="test"
    v3 = Call v2, v1, v0 calleeKey="test"
    Return v3
# CHECK-NOT: GetModuleVariable
# CHECK: = StringIndexOfLiteral v0{{*}}literal="abc"
# CHECK-NOT: CallInline
}
function f2 name="search" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = PropGet v0 key="search"
    v3 = Call v2, v0, v1 calleeKey="search"
    Return v3
# CHECK-NOT: GetModuleVariable
# CHECK: = StringIndexOfLiteral v0{{*}}literal="abc"
# CHECK-NOT: CallInline
}
function f3 name="sameTextCompiledAgain" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g1
    v2 = PropGet v1 key="test"
    v3 = Call v2, v1, v0 calleeKey="test"
    Return v3
# CHECK-NOT: StringIndexOfLiteral
}
function f4 name="ignoringCase" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewRegExp pattern="abc" regExpFlags=[IgnoreCase]
    v2 = PropGet v1 key="test"
    v3 = Call v2, v1, v0 calleeKey="test"
    Return v3
# CHECK-NOT: StringIndexOfLiteral
}
