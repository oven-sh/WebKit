# class Registry {
#   static make() { return "declared"; }
# }
# class Below extends Registry {}
# function Legacy() {}
# Registry["co" + suffix] = 0;
# Legacy["co" + suffix] = 0;
# function countInClass() { Registry.count++; }
# function countInFunction() { Legacy.count++; }
# function callMake() { return Registry.make() + " " + Below.make(); }
# for (let round = 0; round < rounds; round++) {
#   countInClass();
#   countInFunction();
# }
# const before = callMake();
# Registry.make = () => "first";
# const first = callMake();
# Registry.make = () => "second";
# const second = callMake();
# Object.freeze(Registry);
# let refused = "stored";
# try {
#   countInClass();
# } catch (error) {
#   refused = error.constructor.name;
# }
# report(Registry.count === rounds, Below.count === rounds, Legacy.count === rounds, before, first, second, refused);
# FORM: AsRead
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.rounds = 2500; globalThis.suffix = "unt"; globalThis.report = (...values) => { print(values.join(" ")); const calls = aotOperationCount("operationAOTPutById") + aotOperationCount("operationAOTPutByIdAndCache"); print(calls > 0 && calls < 50 ? "a few stores asked the run time" : calls); };
# A class object and a function each hold a property that no declaration names. The first stores that replace its value ask the run time, and the other 5,000 find the answer in a cache.
