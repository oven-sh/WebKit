# let sum = 0;
# for (let i = 0; i < Number(turns); i++) sum = (sum + i) | 0;
# report(sum);
# The shell reads the counter of the hardware where the program reads `turns` for the first time and where it reports. A turn of this loop takes a few instructions, at any load.
# Where the counter cannot be read the shell gets null, and the test says the same.
# FORM: AsRead
# RUN: run-in-shell let before; Object.defineProperty(globalThis, "turns", { get() { before ??= aotInstructionCount(); return 100000; } }); globalThis.report = sum => { const after = aotInstructionCount(); print(sum, after === null || (after - before > 100000 && after - before < 100000000) ? "a turn takes between 1 and 1,000 instructions" : after - before); };
# CHECK: 704982704 a turn takes between 1 and 1,000 instructions
# CHECK-NEXT: exited with 0

