# RUN: verify
# DIAGNOSTIC: PayloadOutOfRange 1

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
function f0 name="badProvenContents" parameters=[{type=anything}] results=[{type=anything}] {
