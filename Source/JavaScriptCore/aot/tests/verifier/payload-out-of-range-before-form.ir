# A field that a later stage fills is at its default before that form
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: PayloadOutOfRange 4

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="a" declared={type=number} flow={occupancy=AlwaysFilled}}]
function f0 name="badOperatorForm" parameters=[{type=number}] results=[{type=undefined}] {
    v1 = Add v0, v0 form=Numbers
    Return
}
function f1 name="badClosureForm" results=[{type=undefined}] {
    v0 = NewClosure function=f5 closureForm=Slim
    Return
}
function f2 name="badAllocation" parameters=[{type=number}] results=[{type=undefined}] {
    v1 = NewObject -, v0 layout=L0 fields=[0] allocation=0
    Return
}
function f3 name="badSiteCache" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = PropGet v0 key="a" siteCache=0
    Return
}
function f4 name="good" parameters=[{type=number}, {type=anything}] results=[{type=undefined}] {
    v2 = Add v0, v0
    v3 = NewClosure function=f5
    v4 = NewObject -, v0 layout=L0 fields=[0]
    v5 = PropGet v1 key="a"
    v6 = GetSlot v4, v4 key="a" receivers=[L0] level=Proven
    Return
}
function f5 name="closure" results=[{type=undefined}]
