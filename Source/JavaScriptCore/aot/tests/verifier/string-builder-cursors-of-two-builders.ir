# Each builder has a buffer of its own: what is done to one builder leaves the cursors into another as they are. `line += JSON.stringify(box)` inside a try makes such code:
# the builder of the line is discarded where the try is left, between the reservation in the builder of the JSON text and the next write there.
# Builders that meet in a parameter of a block count as one, and code that nobody knows may do anything to any builder.
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: BuilderCursorUsedAfterMove 3

module m0 path="main.js" displayPath="main.js"
function f0 name="goodOtherBuilderIsDiscarded" parameters=[{type=string}] results=[{type=string}] {
  b0(v0: string):
    v1 = StringBuilderBegin
    v2 = StringBuilderBegin
    StringBuilderAppend v2, v0
    v4 = StringBuilderReserve v1 size=40
    StringBuilderDiscard v2
    v6 = Integer integer=1
    v7 = JSONAppendInteger v1, v4, v6
    StringBuilderCommit v1, v7
    v9 = StringBuilderFinish v1
    Return v9
}
