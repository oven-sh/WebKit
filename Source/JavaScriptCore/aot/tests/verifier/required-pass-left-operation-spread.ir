# A spread into a list is left in form Prepared only if ExpandIteration did not run
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: RequiredPassLeftOperation 1

module m0 path="main.js" displayPath="main.js"
function f0 name="bad" parameters=[{type=Array}, {type=anything}] results=[{type=undefined}] {
    AppendSpread v0, v1
    Return
}
function f1 name="good" parameters=[{type=Array}, {type=anything}] results=[{type=undefined}] {
    AppendElement v0, v1
    Return
}
