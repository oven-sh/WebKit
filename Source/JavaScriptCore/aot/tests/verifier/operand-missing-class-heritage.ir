# NewClass of a class with a heritage takes the heritage and its resolved prototype, and NewClass of a class without one takes neither
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: OperandMissing 3
# DIAGNOSTIC: UnexpectedOperand 3

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance constructor=f8 flags=[HasHeritage]
layout L1 kind=Instance constructor=f9
function f0 name="badWithoutBoth" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = NewClass v0 layout=L0
    Return
}
function f1 name="badWithoutPrototypeParent" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = NewClass v0, v1 layout=L0
    Return
}
function f2 name="badWithoutHeritage" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = ResolveHeritage v1
    v3 = NewClass v0, -, v2 layout=L0
    Return
}
function f3 name="badPrototypeParentAlone" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = ResolveHeritage v1
    v3 = NewClass v0, -, v2 layout=L1
    Return
}
function f4 name="badHeritageAlone" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = NewClass v0, v1 layout=L1
    Return
}
function f5 name="badBothWithoutHeritageFlag" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = ResolveHeritage v1
    v3 = NewClass v0, v1, v2 layout=L1
    Return
}
function f6 name="goodWithHeritage" parameters=[{type=function}, {type=anything}] results=[{type=undefined}] {
    v2 = ResolveHeritage v1
    v3 = NewClass v0, v1, v2 layout=L0
    Return
}
function f7 name="goodWithoutHeritage" parameters=[{type=function}] results=[{type=undefined}] {
    v1 = NewClass v0 layout=L1
    Return
}
function f8 name="derivedConstructor" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=anything}]
function f9 name="baseConstructor" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
