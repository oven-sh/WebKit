# A Convert marks a value that enters a written position and claims nothing, so a program may hold one
# RUN: verify
# CHECK: verified

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="convert" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=anything}
    Return v1
}
function f1 name="convertToExpectedType" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    Return v2
}
function f2 name="check" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Check v0 expectedType=number
    Return v1
}
