# typing resolves every request, so a verified program as read has none
# FORM: AsRead
# RUN: verify
# DIAGNOSTIC: RequestAfterTyping 2

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="badConvert" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=anything}
    Return v1
}
function f1 name="badConvertToExpectedType" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    Return v2
}
function f2 name="goodResolved" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Check v0 castType=number
    Return v1
}
