  b0(v0: L0):
    v1 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
    v2 = CallDirect v1 function=f9
    Return v2
}
function f6 name="badHeldBehindCast" parameters=[{type=L0}] results=[{type=undefined}] {
  b0(v0: L0):
    v1 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
