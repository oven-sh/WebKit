# GetFlattenedSlot may return a pointer into the outer object, so its result may only be used for slot reads and writes. Any use that needs the real object is BorrowedObjectHeld.
# FORM: Prepared
# OPTIONS: references=narrow
# RUN: verify
# DIAGNOSTIC: BorrowedObjectHeld 7

module m0 path="main.ts" displayPath="main.ts"
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Outer" fields=[{key="c" declared={type=L1} flags=[IsRequired] flow={location={deferral=FlattenedObject} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None} flattenedObjects=[{layout=L1 fields=[0]}]
layout L1 name="Inner" fields=[{key="d" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None}
layout L2 name="Holder" fields=[{key="h" declared={type=L1} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] ownFieldCount=1 flow={baseState=None}
function f0 name="goodReadsAndStoresSlots" parameters=[{type=L0}] results=[{type=number}] {
  b0(v0: L0):
    v1 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
    v2 = GetSlot v1 key="d" receivers=[L1] level=Proven
    PutSlot v1, -, v2 key="d" receivers=[L1] level=Proven
    Return v2
}
function f1 name="goodMeetsBehindBorrowedParameter" parameters=[{type=L0}, {type=L0}, {type=boolean}] results=[{type=number}] {
  b0(v0: L0, v1: L0, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
    Jump -> next b3(v3)
  b2():
    v4 = GetFlattenedSlot v1 key="c" receivers=[L0] level=Proven
    Jump -> next b3(v4)
  b3(v5: L1):
    v6 = BorrowedParameter v5
    v7 = GetSlot v6 key="d" receivers=[L1] level=Proven
    Return v7
}
function f2 name="badStoredIntoVariable" parameters=[{type=L0}] results=[{type=undefined}] {
  b0(v0: L0):
    v1 = GetFlattenedSlot v0 key="c" receivers=[L0] level=Proven
