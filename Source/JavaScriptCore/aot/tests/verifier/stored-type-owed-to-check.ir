# A position that every store is held to outlives the checks of whoever stores into it. What is stored there has the type of the position also where each check lets everything through.
# A position that only expects its type takes whatever arrives.
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: StoredTypeOwedToCheck 4

variable g0 module=m0 declared={type=number}
variable g1 module=m0 declared={type=number flags=[IsExpected]}
variable g2 module=m0 declared={type=boolean}
module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="badCheckedValue" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Check v0 expectedType=number
    PutModuleVariable v1 variable=g0
    Return
}
function f1 name="badMadeOfCheckedValue" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Check v0 expectedType=number
    v2 = Add v1, v1
    PutModuleVariable v2 variable=g0
    Return
}
function f2 name="badArgument" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Check v0 expectedType=number
    v2 = CallDirect v1 function=f5
    Return
}
function f3 name="badResult" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Check v0 expectedType=number
    Return v1
}
function f4 name="good" parameters=[{type=anything}, {type=number}] results=[{type=undefined}] {
    v2 = Check v0 expectedType=number
    PutModuleVariable v2 variable=g1
    v4 = Add v1, v1
    PutModuleVariable v4 variable=g0
    v6 = StrictEq v2, v1
    PutModuleVariable v6 variable=g2
    Return
}
function f5 name="takesNumber" parameters=[{type=number}] results=[{type=undefined}] {
    Return
}
