module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="bad" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = Add v0, v2
    v2 = Add v0, v1
    Return
}
function f1 name="good" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = Add v0, v0
    v2 = Add v0, v1
    Return
}
