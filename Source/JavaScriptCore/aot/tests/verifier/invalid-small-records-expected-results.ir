# an expected result lists object layouts, and its validation nodes name nodes of the same record and fields of their layout
# FORM: AsRead
# RUN: verify
# DIAGNOSTIC: PayloadOutOfRange 11

module m0 path="main" displayPath="main"
entry module=m0
layout L0 kind=Environment fields=[{key="c" declared={type=anything}}]
layout L1 fields=[{key="c" declared={type=anything}}]
expectedresult x0 type=anything layouts=[L1] validation=[{shape=Object{layout=L1 members=[{key="c" node=1 field=0}] undeclared=Validated undeclaredValue=1} type=anything text="good"}, {shape=Union{arms=[2, 3]} type=anything}, {shape=Array{element=4} type=anything}, {shape=Tuple{elements=[4, 4]} type=anything}, {shape=Dictionary{value=4} type=anything}]
expectedresult x1 type=anything layouts=[L0] validation=[{shape=Unknown type=anything text="badLayoutIsEnvironment"}]
expectedresult x2 type=anything validation=[{shape=Array{element=1} type=anything text="badElementPastNodes"}]
expectedresult x3 type=anything validation=[{shape=Tuple{elements=[0, 1]} type=anything text="badTupleElementPastNodes"}]
expectedresult x4 type=anything validation=[{shape=Dictionary{value=1} type=anything text="badDictionaryValuePastNodes"}]
expectedresult x5 type=anything validation=[{shape=Union{arms=[0, 1]} type=anything text="badArmPastNodes"}]
expectedresult x6 type=anything validation=[{shape=Object{layout=L0} type=anything text="badObjectLayoutIsEnvironment"}]
expectedresult x7 type=anything validation=[{shape=Object{undeclaredValue=0} type=anything text="badUndeclaredValueNotValidated"}]
expectedresult x8 type=anything validation=[{shape=Object{undeclared=Validated} type=anything text="badValidatedWithoutValue"}]
expectedresult x9 type=anything validation=[{shape=Object{undeclared=Validated undeclaredValue=1} type=anything text="badUndeclaredValuePastNodes"}]
expectedresult x10 type=anything validation=[{shape=Object{layout=L1 members=[{key="c" node=1 field=0}]} type=anything text="badMemberNodePastNodes"}]
expectedresult x11 type=anything validation=[{shape=Object{layout=L1 members=[{key="c" node=0 field=1}]} type=anything text="badMemberFieldPastLayout"}]
