# A function stores one list in a variable of the environment that it is handed, and calls what it reads from that environment.
# Each variable is a slot of its own, as in an environment that the function makes itself: what is read from another variable is not the list that is stored.
# So a second list, which lies in the stored one and is handed to nobody before that, is still as it was made when the call returns.
# Read from the variable that is stored to, the callee may be the stored list for all that anybody knows, and the call may reach what lies in it
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: GuardNotAvailable 1

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="helper" declared={type=anything}}, {key="kept" declared={type=anything}}]

function f0 name="readsAnotherVariable" kind=Arrow captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    v2 = NewArray v1 contents=anything
    v3 = GetEnvironmentField v0 layout=L0 field=0
    v4 = Call v3, -, v1
    v5 = Integer integer=0
    v6 = GetArrayElement v2, v5, v2 arrayStorage=Contiguous level=Expected [keyIsIntegral]
    v7 = NewArray v2 contents=anything
    PutEnvironmentField v0, v7 layout=L0 field=1
    Return v6
}

function f1 name="readsTheSameVariable" kind=Arrow captures=[{type=env L0}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L0, v1: anything):
    v2 = NewArray v1 contents=anything
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = Call v3, -, v1
    v5 = Integer integer=0
    v6 = GetArrayElement v2, v5, v2 arrayStorage=Contiguous level=Expected [keyIsIntegral]
    v7 = NewArray v2 contents=anything
    PutEnvironmentField v0, v7 layout=L0 field=1
    Return v6
}
