# What the read of a brand gives is no JavaScript value, whatever the receiver: an operation on values does not take it; the private field beside it is a value
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: OperandTypeMismatch 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance fields=[{key=#"#"@L0 declared={type=classtoken} flags=[IsRequired, IsPrivate, IsImmutable, IsBrand, IsHidden]}, {key=#"secret"@L0 declared={type=anything} flags=[IsRequired, IsPrivate]}]
function f0 name="badOnUnknownReceiver" parameters=[{type=anything}, {type=classtoken}] results=[{type=string}] {
    v2 = PrivateGet v0, v1 layout=L0
    v3 = TypeOf v2
    Return v3
}
function f1 name="badOnProvenReceiver" parameters=[{type=L0}, {type=classtoken}] results=[{type=string}] {
    v2 = PrivateGet v0, v1 layout=L0
    v3 = TypeOf v2
    Return v3
}
function f2 name="goodField" parameters=[{type=anything}, {type=classtoken}] results=[{type=string}] {
    v2 = PrivateGet v0, v1 layout=L0 field=1
    v3 = TypeOf v2
    Return v3
}
function f3 name="goodUnusedBrand" parameters=[{type=anything}, {type=classtoken}] results=[{type=undefined}] {
