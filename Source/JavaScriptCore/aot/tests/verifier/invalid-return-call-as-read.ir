# what a returned call hands back enters the declared result: where that is not anything, the last cast lies inside it
# RUN: verify
# DIAGNOSTIC: InvalidReturnCall 2

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="goodWithoutCast" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    ReturnCall v1
}
function f1 name="goodCast" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=number}}]
}
function f2 name="badWithoutCast" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Call v0
    ReturnCall v1
}
function f3 name="badCastOutsideResult" parameters=[{type=anything}] results=[{type=number}] {
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=string}}]
}
