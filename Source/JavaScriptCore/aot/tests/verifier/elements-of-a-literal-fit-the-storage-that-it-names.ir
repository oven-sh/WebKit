# A list literal that names storage for numbers alone is born with it, and nobody who reads the name tests the storage. So its contents are proven and are stored there as they are, its elements are
# held to them, and a type proves such storage of a literal only where the literal names it. A literal that names none is born with the storage that fits the types of its elements
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: StoredTypeMismatch 6
# DIAGNOSTIC: PayloadOutOfRange 3

module m0 path="main.js" displayPath="main.js"
function f0 name="anythingAmongDoubles" parameters=[{type=anything}, {type=fractional}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=fractional arrayStorage=Double [contentsAreProven]
    Return v2
}
function f1 name="stringAmongIntegers" parameters=[{type=i32}, {type=string}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=i32 arrayStorage=Int32 [contentsAreProven]
    Return v2
}
function f2 name="fractionAmongIntegers" parameters=[{type=i32}, {type=fractional}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=i32 arrayStorage=Int32 [contentsAreProven]
    Return v2
}
function f3 name="doublesProvenOfLiteralThatNamesNoStorage" parameters=[{type=fractional}, {type=fractional}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=fractional
    v3 = AssumeType v2 provenType=Array<fractional, proven, Double>
    Return v3
}
