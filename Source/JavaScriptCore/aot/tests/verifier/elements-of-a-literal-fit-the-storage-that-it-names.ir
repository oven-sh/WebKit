function f12 name="anythingWhereNoStorageIsNamed" parameters=[{type=anything}, {type=fractional}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=fractional
    Return v2
}
function f13 name="anythingInStorageForEveryValue" parameters=[{type=anything}, {type=fractional}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=fractional arrayStorage=Contiguous [contentsAreProven]
