    v1 = NewArray v0 contents=i32|fractional arrayStorage=Int32 [contentsAreProven]
    Return v1
}
function f7 name="storageNamedForContentsThatAreNotProven" parameters=[{type=fractional}] results=[{type=anything}] {
    v1 = NewArray v0 contents=fractional arrayStorage=Double
    Return v1
}
function f8 name="anythingAmongProvenContentsThatMayGetStorageForNumbers" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray v0 contents=undefined|fractional [contentsAreProven]
    Return v1
}
function f9 name="anythingAmongProvenContentsInStorageForEveryValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewArray v0 contents=string [contentsAreProven]
    Return v1
}
function f10 name="doubles" parameters=[{type=fractional}, {type=i32}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=i32|fractional arrayStorage=Double [contentsAreProven]
