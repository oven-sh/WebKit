}
function f11 name="integers" parameters=[{type=i32}, {type=i32}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=i32 arrayStorage=Int32 [contentsAreProven]
    v3 = AssumeType v2 provenType=Array<i32, proven, Int32>
