# a module requests a target once in each phase
# FORM: AsRead
# RUN: verify
# DIAGNOSTIC: DuplicateListEntry 1

module m0 path="main" displayPath="main"
module m1 path="goodTwoPhases" displayPath="goodTwoPhases" requests=[{target=m0}, {target=m0 phase=Defer}]
module m2 path="badSameRequestTwice" displayPath="badSameRequestTwice" requests=[{target=m0}, {target=m0}]
entry module=m0
