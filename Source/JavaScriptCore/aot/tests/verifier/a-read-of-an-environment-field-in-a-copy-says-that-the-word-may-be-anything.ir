# That a variable of an enclosing function has been stored holds where a function that reads it is entered. In the body of that function a read says nothing more. In a frame of another function it says that the word
# may be anything, and only a cast that names a fact takes that away
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: InvalidGuard 1
# DIAGNOSTIC: UnspecifiedValueInspected 2

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="text" declared={type=string} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}}}]

function f0 name="goodReadOfTheFunctionItself" captures=[{type=env L0}] results=[{type=string}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f1 name="goodWordAndCast" parameters=[{type=env L0}] results=[{type=string}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = Entered function=f0
    v2 = GetEnvironmentField v0 layout=L0 field=0 [mayPrecedeItsStore] @0:1
    v3 = AssumeType v2, v1 provenType=string
    Return v3
}
function f2 name="goodWordGoesBackIntoTheField" parameters=[{type=env L0}] results=[{type=anything}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 [mayPrecedeItsStore] @0:1
    PutEnvironmentField v0, v1 layout=L0 field=0
    Return
}
function f3 name="badReadInFrameSaysNothing" parameters=[{type=env L0}] results=[{type=string}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 @0:1
    Return v1
}
# What a cast gives that names no fact may be anything too.
function f4 name="badCastNamesNoFact" parameters=[{type=env L0}] results=[{type=string}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 [mayPrecedeItsStore] @0:1
    v2 = AssumeType v1 provenType=string
    Return v2
}
function f5 name="badLook" parameters=[{type=env L0}] results=[{type=number}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 [mayPrecedeItsStore] @0:1
    v2 = GetStringLength v1
    Return v2
}
