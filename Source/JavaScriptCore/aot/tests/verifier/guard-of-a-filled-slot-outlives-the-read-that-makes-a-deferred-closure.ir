function f1 name="goodReadOfAnotherObjectBetween" parameters=[{type=L0}, {type=L0}] results=[{type=anything}] {
  b0(v0: L0, v1: L0):
    v2 = IsSlotFilled v0 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: guard):
    v4 = IsSlotFilled v1 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: guard):
    v6 = GetDeferredClosureSlot v1, v5 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    v7 = GetDeferredClosureSlot v0, v3 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    v8 = StrictEq v6, v7
    Return v8
  b3():
    v9 = Undefined
    Return v9
}
function f2 name="badStoreBetween" parameters=[{type=L0}, {type=L0}] results=[{type=anything}] {
  b0(v0: L0, v1: L0):
    v2 = IsSlotFilled v0 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: guard):
    v4 = Undefined
    PropSet v1, v4 key="step" mode=Sloppy
    v6 = GetDeferredClosureSlot v0, v3 key="step" receivers=[L0] level=Expected [holdsDeclaredType]
    Return v6
  b2():
    v7 = Undefined
    Return v7
}
