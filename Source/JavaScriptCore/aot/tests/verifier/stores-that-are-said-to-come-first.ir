# "On every path" and "before the target leaves" are promises about the order of things. The checker searches the paths itself: from the entry, or from behind the operation that makes the target, it must not get to a return, or to where the target leaves, but through a store whose holder is surely the target.
# RUN: verify-relations
# CHECK-NOT: f1 {{*}}
# CHECK-NOT: f2 {{*}}
# CHECK: f3 StoreIsOnEveryPath: store 0
# CHECK: f4 StoreIsOnEveryPath: store 0
# CHECK-NEXT: f4 StoreIsBeforeTargetLeaves: store 0
# CHECK-NEXT: f4 StoreIsOnEveryPath: store 1
# CHECK-NEXT: f4 StoreIsBeforeTargetLeaves: store 1
# CHECK: f5 StoreIsOnEveryPath: store 0
# CHECK: f6 StoreIsBeforeTargetLeaves: store 0
# CHECK-NOT: f7 {{*}}
# CHECK: f8 StoreIsOnEveryPath: store 0
# CHECK: f9 StoreIsOnEveryPath: store 3
# CHECK-NOT: f10 {{*}}
# CHECK: f11 StoreIsBeforeTargetLeaves: store 0
# CHECK: f12 StoreIsOnEveryPath: store 0
# CHECK-NOT: f13 {{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Environment name="scope" fields=[{key="held" declared={type=anything}}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="straight" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{kind=Parameter index=0 fate=[HasMembersWritten, IsStoredInVariable]}, {kind=Parameter index=1}] stores=[{source=1 target=0 key="a" isOnEveryPath=true isBeforeTargetLeaves=true}]} {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="a" mode=Strict
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="inBothArms" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{kind=Parameter index=0 fate=[HasMembersWritten]}, {kind=Parameter index=1}] stores=[{source=1 target=0 key="a" isOnEveryPath=true isBeforeTargetLeaves=true}]} {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    PropSet v0, v1 key="a" mode=Strict
    Return
  b2():
    PropSet v0, v1 key="a" mode=Strict
    Return
}
function f3 name="inOneArm" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{kind=Parameter index=0 fate=[HasMembersWritten]}, {kind=Parameter index=1}] stores=[{source=1 target=0 key="a" isOnEveryPath=true}]} {
