# a guard that one of several tests or allocations stands behind proves one of their layouts and the slots all of them fill.
# A compiled object keeps its shape, so no write to an object of any of them ends what the guard says about the layout
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: InvalidGuard 4

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 name="Size" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="goodTwoTests" parameters=[{type=object}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = ShapeTest v0 layouts=[L0]
    Branch v2 -> taken b3(| 0), notTaken b4()
  b2():
    v3 = ShapeTest v0 layouts=[L1]
    Branch v3 -> taken b3(| 0), notTaken b4()
  b3(v4):
    v5 = GetSlotOrUndefined v0, v4 key="x" receivers=[L0, L1] level=Proven
    Return v5
  b4():
    Return
}
