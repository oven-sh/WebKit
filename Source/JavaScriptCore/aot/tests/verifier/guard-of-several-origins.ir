    v2 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v3 = AllGuards v2
    Jump -> next b3(v2, v3)
  b2():
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = AllGuards v4
    Jump -> next b3(v4, v5)
  b3(v6, v7):
    v8 = GetSlot v6, v7 key="x" receivers=[L0, L1] level=Proven
    Return v8
}
