# only a namespace export has the phase Defer
# RUN: verify
# DIAGNOSTIC: InvalidModule 4

variable g0 name="a" module=m0 declared={type=anything}
variable g1 name="_0" module=m5 declared={type=anything} flags=[IsImmutable]
module m0 path="main" displayPath="main" requests=[{target=m1 phase=Defer}, {target=m2 completes=true}] exports=[{name="a" variable=g0 isFromStarExport=true}, {name="b" kind=Namespace module=m1 phase=Defer}, {name="c" kind=Indirect module=m2 importName="x"}]
module m1 path="other" displayPath="other"
module m2 path="external" displayPath="external" kind=External referrer=m0
module m3 path="badVariableExport" displayPath="badVariableExport" exports=[{name="a" variable=g0 phase=Defer}]
module m4 path="badIndirectExport" displayPath="badIndirectExport" requests=[{target=m2 completes=true}] exports=[{name="a" kind=Indirect module=m2 importName="x" phase=Defer}]
module m5 path="goodData" displayPath="goodData" kind=Data requireResult=DefaultExport exports=[{name="a" variable=g1 isOmitted=true}, {name="default" variable=g1}]
module m6 path="badNameLeftOutOfCode" displayPath="badNameLeftOutOfCode" exports=[{name="a" variable=g0 isOmitted=true}]
module m7 path="badNamespaceLeftOut" displayPath="badNamespaceLeftOut" requests=[{target=m1}] exports=[{name="a" kind=Namespace module=m1 isOmitted=true}]
entry module=m0
