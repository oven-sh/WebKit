# const held = { plain: 1, get doubled() { return 2 }, set doubled(v) { } }   const record = { plain: 1, doubled: 2 }
# The slot of `doubled` in `held` holds the pair of the two functions. The definitions of the accessor make the pair and put it there, so a literal leaves that slot out of its list,
# a test asks whether it is filled, and the getter and the setter are read out of the pair. Neither function by itself is what the slot holds.
# In `record` the slot of the same name holds a value: it is listed, read and stored, and there is no pair to read a half of.
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: SlotOfOtherForm 10

module m0 path="main.js" displayPath="main.js"
layout L0 name="Held" fields=[{key="plain" declared={type=anything} flow={occupancy=AlwaysFilled}}, {key="doubled" declared={type=anything} form=[IsAccessor] flow={occupancy=AlwaysFilled} slotType=f0 setterType=f1}]
layout L1 name="Record" fields=[{key="plain" declared={type=anything} flow={occupancy=AlwaysFilled}}, {key="doubled" declared={type=anything} flow={occupancy=AlwaysFilled}}]
layout L2 name="OnlySet" fields=[{key="doubled" declared={type=anything} form=[IsAccessor] setterType=f1}]
function f0 name="doubled" kind=Getter results=[{type=anything}]
function f1 name="doubled" kind=Setter parameters=[{type=anything}] results=[{type=anything}]
function f2 name="other" results=[{type=anything}]
function f3 name="goodLiteralLeavesTheSlotToTheDefinitions" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f0
    DefineGetter v1, v2 key="doubled"
    v4 = NewClosure function=f1
    DefineSetter v1, v4 key="doubled"
    Return v1
}
function f4 name="goodLiteralListsTheValue" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewClosure function=f2
    v2 = NewObject -, v0, v1 layout=L1 fields=[0, 1]
    Return v2
}
function f5 name="goodHalvesAreReadOutOfThePair" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="doubled" receivers=[L0] level=Proven
    v2 = GetSlotGetter v0 key="doubled" receivers=[L0] level=Proven
    v3 = GetSlotSetter v0 key="doubled" receivers=[L0] level=Proven
    Return v2
}
function f6 name="goodValueIsReadAndStored" parameters=[{type=L1}] results=[{type=anything}] {
    v1 = IsSlotFilled v0 key="doubled" receivers=[L1] level=Proven
    v2 = GetSlot v0 key="doubled" receivers=[L1] level=Proven
    PutSlot v0, -, v2 key="doubled" receivers=[L1] level=Proven
    Return v2
}
function f7 name="goodTestOfEitherForm" parameters=[{type=L0|L1}] results=[{type=boolean}] {
    v1 = IsSlotFilled v0 key="doubled" receivers=[L0, L1] level=Proven
    Return v1
}
function f8 name="badLiteralListsAnotherFunction" results=[{type=anything}] {
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L2 fields=[0]
    Return v1
}
function f9 name="badLiteralListsTheGetter" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewClosure function=f0
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    Return v2
}
function f10 name="badLiteralListsTheSetter" results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    Return v1
}
function f11 name="badLiteralListsANumber" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    Return v1
}
function f12 name="badStoreOfTheGetter" parameters=[{type=L0}, {type=f0}] results=[{type=undefined}] {
    PutSlot v0, -, v1 key="doubled" receivers=[L0] level=Proven
    Return
}
function f13 name="badStoreWhereOneReceiverHasTheAccessor" parameters=[{type=L0|L1}, {type=f0}] results=[{type=undefined}] {
    PutSlot v0, -, v1 key="doubled" receivers=[L0, L1] level=Proven
    Return
}
function f14 name="badStoreThatMayAdd" parameters=[{type=L2}, {type=anything}] results=[{type=undefined}] {
    PutSlotOrAdd v0, -, v1 key="doubled" receivers=[L2] level=Proven
    Return
}
function f15 name="badPairIsReadAsAValue" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = GetSlot v0 key="doubled" receivers=[L0] level=Proven
    Return v1
}
function f16 name="badPairOrNothingIsReadAsAValue" parameters=[{type=L2}] results=[{type=anything}] {
    v1 = GetSlotOrUndefined v0 key="doubled" receivers=[L2] level=Proven
    Return v1
}
function f17 name="badHalfOfAValue" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = GetSlotGetter v0 key="doubled" receivers=[L0, L1] level=Proven
    Return v1
}
