# a site that evaluates or records a module names a file of the program that its referrer requires; a bare site stands in the body of its referrer, where every run that ends passes it once and all of them in one order
# FORM: AsRead
# RUN: verify
# DIAGNOSTIC: InvalidModuleEvaluation 15

variable g0 name="c" module=m0 declared={type=anything} initialization=Undefined
data d0 root=Null
module m0 path="main" displayPath="main" body=f0 requests=[{target=m1 kind=Require completes=true}, {target=m2 kind=Require completes=true}, {target=m3 kind=Require}, {target=m4 kind=Require}, {target=m5 kind=Require}, {target=m6 completes=true}]
module m1 path="first" displayPath="first"
module m2 path="second" displayPath="second" kind=CommonJs body=f1
module m3 path="data" displayPath="data" kind=Data data=d0
module m4 path="library" displayPath="library" flags=[IsLibrary]
module m5 path="waits" displayPath="waits" flags=[HasTopLevelAwait] body=f2
module m6 path="imported" displayPath="imported"
module m7 path="badInBranch" displayPath="badInBranch" body=f11 requests=[{target=m1 kind=Require}]
module m8 path="badBehindReturn" displayPath="badBehindReturn" body=f12 requests=[{target=m1 kind=Require}]
module m9 path="badInLoop" displayPath="badInLoop" body=f13 requests=[{target=m1 kind=Require}]
module m10 path="badUnderHandler" displayPath="badUnderHandler" body=f14 requests=[{target=m1 kind=Require}]
module m11 path="badInTwoArmsThatThrow" displayPath="badInTwoArmsThatThrow" body=f15 requests=[{target=m1 kind=Require}, {target=m2 kind=Require}]
module m12 path="badInBodyThatWaits" displayPath="badInBodyThatWaits" flags=[HasTopLevelAwait] body=f16 requests=[{target=m1 kind=Require}]
module m13 path="goodBehindBranchesAndThrows" displayPath="goodBehindBranchesAndThrows" body=f17 requests=[{target=m1 kind=Require}, {target=m2 kind=Require}]
module m14 path="goodInArmOfBodyThatAlwaysThrows" displayPath="goodInArmOfBodyThatAlwaysThrows" body=f18 requests=[{target=m1 kind=Require}]
entry module=m0
function f0 name="good" module=m0 kind=Module results=[{type=anything}] {
    RecordRequire module=m1 referrer=m0
    EvaluateModule module=m1 referrer=m0 [isBare]
    EvaluateModule module=m2 referrer=m0 [isBare]
    EvaluateModule module=m1 referrer=m0 [isBare]
    Return
}
function f1 name="" module=m2 kind=CommonJsModule results=[{type=anything}]
function f2 name="" module=m5 kind=Module flags=[IsAsync] results=[{type=anything}]
function f3 name="goodLateSites" module=m0 results=[{type=anything}] {
    Jump -> next b1()
  b1() handler=b3():
    LoopHint
    EvaluateModule module=m1 referrer=m0
    RecordRequire module=m2 referrer=m0
    v3 = GetModuleVariable variable=g0
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
  b3() role=CatchHandler:
    v5 = CatchValue
    Return
}
function f4 name="badTargetIsData" module=m0 results=[{type=anything}] {
    EvaluateModule module=m3 referrer=m0
    Return
}
function f5 name="badTargetIsLibrary" module=m0 results=[{type=anything}] {
    EvaluateModule module=m4 referrer=m0
    Return
}
function f6 name="badTargetWaits" module=m0 results=[{type=anything}] {
