function f17 name="" module=m13 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m13 [isBare]
    v1 = GetModuleVariable variable=g0
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
