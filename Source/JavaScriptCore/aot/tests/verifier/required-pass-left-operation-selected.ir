# RUN: verify
# DIAGNOSTIC: RequiredPassLeftOperation 1

module m0 path="main.js" displayPath="main.js"
function f0 name="bad" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = ForInOpen v0
    v2 = ForInStep v1, v0
