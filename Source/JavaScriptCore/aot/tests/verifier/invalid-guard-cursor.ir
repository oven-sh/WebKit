# JSONAdvance names a guard on its own cursor, and the operations on a source name the guard of a JSONSourceOpen test
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: InvalidGuard 3

module m0 path="main.js" displayPath="main.js"
function f0 name="badGuardOnOtherCursor" role=Parser parameters=[{type=cursor}] results=[{type=cursor}] creator=Parser{type=anything} {
  b0(v0: cursor):
    v1 = JSONSkipWhitespace v0
    v2 = JSONStartsWith v1 string="true"
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = JSONAdvance v0, v3 string="true"
    Return v4
  b2():
    Return v0
}
function f1 name="badAdvanceUnderGuardOfSource" role=Parser parameters=[{type=cursor}, {type=anything}] results=[{type=cursor}] creator=Parser{type=anything} {
  b0(v0: cursor, v1: anything):
    v2 = IsPlainDataObject v1
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = JSONAdvance v0, v3 string="true"
    Return v4
  b2():
    Return v0
}
function f2 name="badStartUnderGuardOfOtherTest" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = IsPlainDataObject v0
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = JSONSourceStart v2
    Return
  b2():
    Return
}
function f3 name="good" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = JSONSourceOpen v0
    Branch v1 -> taken b1(| 0), notTaken b3()
  b1(v2):
    v3 = JSONSourceStart v2
    v4 = JSONStartsWith v3 string="true"
    Branch v4 -> taken b2(| 0), notTaken b4()
  b2(v5):
    v6 = JSONAdvance v3, v5 string="true"
    v7 = JSONSourceClose v2, v6
    Return
  b3():
    Return
  b4():
    JSONSourceAbandon v2
    Return
}
