# a file whose variable the code of another file names is reached from that file, over requests and what code loads
# RUN: verify
# DIAGNOSTIC: InvalidModule 2

variable g0 name="ofLast" module=m2 declared={type=anything} initialization=Undefined
variable g1 name="ofItself" module=m5 declared={type=anything} initialization=Undefined
variable g2 name="ofLibrary" module=m3 declared={type=anything} initialization=Undefined
module m0 path="main" displayPath="main" requests=[{target=m1 completes=true}]
module m1 path="middle" displayPath="middle" requests=[{target=m2 completes=true}]
module m2 path="last" displayPath="last"
module m3 path="library" displayPath="library" flags=[IsLibrary]
module m4 path="goodReadOverTwoRequests" displayPath="goodReadOverTwoRequests" requests=[{target=m0 completes=true}]
module m5 path="goodReadOfItself" displayPath="goodReadOfItself"
module m6 path="goodReadOfLibrary" displayPath="goodReadOfLibrary"
module m7 path="badReadNotReached" displayPath="badReadNotReached" requests=[{target=m5 completes=true}]
module m8 path="badStoreNotReached" displayPath="badStoreNotReached"
module m9 path="goodReadBehindWhatCodeLoads" displayPath="goodReadBehindWhatCodeLoads"
module m10 path="goodReadOverModuleBeside" displayPath="goodReadOverModuleBeside"
module m11 path="#11" displayPath="goodReadOverModuleBeside" body=f6 requests=[{target=m2 completes=true}]
module m12 path="goodReadInModuleBeside" displayPath="goodReadInModuleBeside" requests=[{target=m2 completes=true}]
module m13 path="#13" displayPath="goodReadInModuleBeside" body=f8
function f0 name="goodReadOverTwoRequests" module=m4 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f1 name="goodReadOfItself" module=m5 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    Return v0
}
function f2 name="goodReadOfLibrary" module=m6 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    Return v0
}
function f3 name="badReadNotReached" module=m7 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f4 name="badStoreNotReached" module=m8 results=[{type=anything}] {
  b0():
    v0 = Undefined
    PutModuleVariable v0 variable=g0
    Return v0
}
function f5 name="goodReadBehindWhatCodeLoads" module=m9 results=[{type=anything}] {
  b0():
    v0 = ImportModule module=m1 referrer=m9
    v1 = GetModuleVariable variable=g0
    Return v1
}
function f6 name="beside" module=m10 kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f7 name="goodReadOverModuleBeside" module=m10 results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f8 name="goodReadInModuleBeside" module=m12 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
entry module=m0
