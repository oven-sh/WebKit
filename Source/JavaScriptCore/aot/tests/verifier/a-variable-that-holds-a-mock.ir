# A variable with HoldsMock holds what replaces its module while a mock that was registered before the module loaded is in effect. Native code stores it, so it starts uninitialized,
# is replaceable and has no name. Its module has MayBeMocked, and a module has at most one such variable.
# RUN: verify
# DIAGNOSTIC: InvalidVariable 5

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="mocked.js" displayPath="mocked.js" flags=[MayBeMocked] body=f1
module m2 path="kept.js" displayPath="kept.js" body=f2
module m3 path="other.js" displayPath="other.js" flags=[MayBeMocked] body=f3
module m4 path="more.js" displayPath="more.js" flags=[MayBeMocked] body=f4
module m5 path="last.js" displayPath="last.js" flags=[MayBeMocked] body=f5
entry module=m0
variable g0 module=m1 declared={type=anything|absent} flags=[IsReplaceable, HoldsMock]
variable g1 module=m1 declared={type=anything|absent} flags=[IsReplaceable, HoldsMock]
variable g2 module=m2 declared={type=anything|absent} flags=[IsReplaceable, HoldsMock]
variable g3 module=m3 declared={type=anything|absent} flags=[HoldsMock]
variable g4 name="named" module=m4 declared={type=anything|absent} flags=[IsReplaceable, HoldsMock]
variable g5 module=m5 declared={type=anything} initialization=Undefined flags=[IsReplaceable, HoldsMock]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="mocked" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="kept" module=m2 kind=Module results=[{type=anything}] {
    Return
}
function f3 name="other" module=m3 kind=Module results=[{type=anything}] {
    Return
}
function f4 name="more" module=m4 kind=Module results=[{type=anything}] {
    Return
}
function f5 name="last" module=m5 kind=Module results=[{type=anything}] {
    Return
}
