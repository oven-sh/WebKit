# A read of an environment field in a frame of another function says where it gets its type from: that the word may be anything, or that it leans on the entry of the function that holds the copy
# FORM: Prepared
# RUN: verify
# DIAGNOSTIC: InvalidGuard 1

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment name="scope" fields=[{key="text" declared={type=string} flow={location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isStoredBeforeCapturersRun=true}}}]

function f0 name="reads" captures=[{type=env L0}] results=[{type=string}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f1 name="goodReadLeansOnEntryOfBody" captures=[{type=env L0}] results=[{type=string}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 [leansOnEntryOfBody] @0:1
    Return v1
}
function f2 name="badReadInFrameSaysNothing" captures=[{type=env L0}] results=[{type=string}] inlineFrames=[{}, {callee=f0 module=m0}] {
    v1 = GetEnvironmentField v0 layout=L0 field=0 @0:1
    Return v1
}
