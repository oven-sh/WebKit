# as read, every block but b0 has a predecessor with a lower number, and a handler edge counts
# FORM: AsRead
# RUN: verify
# DIAGNOSTIC: BlockOrderInvalid 1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="goodDiamond" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3()
  b2():
    Jump -> next b3()
  b3():
    Return
}
function f1 name="goodHandlerEdge" parameters=[{type=anything}] results=[{type=undefined}] {
    Jump -> next b1()
  b1() handler=b2():
    v1 = Call v0
    Return
  b2() role=CatchHandler:
    v2 = CatchValue
    Return
}
function f2 name="badLaterBlockFirst" results=[{type=undefined}] {
    Jump -> next b2()
  b1():
    Return
  b2():
    Jump -> next b1()
}
