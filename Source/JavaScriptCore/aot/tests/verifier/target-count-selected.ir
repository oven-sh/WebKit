# A TestAndBranch has its two targets
# FORM: Selected
# RUN: verify
# DIAGNOSTIC: TargetCountMismatch 1

module m0 path="main.js" displayPath="main.js"
function f0 name="bad" parameters=[{type=number}] results=[{type=undefined}] {
    v1 = Less v0, v0
    TestAndBranch v1 -> taken b1()
  b1():
    Return
}
function f1 name="good" parameters=[{type=number}] results=[{type=undefined}] {
    v1 = Less v0, v0
    TestAndBranch v1 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
