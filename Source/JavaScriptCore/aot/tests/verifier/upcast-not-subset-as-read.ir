# An Upcast widens, and a program may hold one
# RUN: verify
# CHECK: verified

module m0 path="main.js" displayPath="main.js"
entry module=m0
layout L0 fields=[{key="x" declared={type=number}}]
function f0 name="wider" parameters=[{type=number}, {type=L0}] results=[{type=undefined}] {
    v2 = Upcast v0 castType=undefined|number
    v3 = Upcast v1 castType=object
    Return
}
