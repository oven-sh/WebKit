function f0 name="badNarrower" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Upcast v0 castType=number
    Return
}
function f1 name="badWrittenLayout" parameters=[{type=L0}] results=[{type=undefined}] {
  b0(v0: object ? L0):
    v1 = Upcast v0 castType=L0
    Return
}
function f2 name="good" parameters=[{type=number}, {type=L0}] results=[{type=undefined}] {
  b0(v0: number, v1: object ? L0):
    v2 = Upcast v0 castType=undefined|number
