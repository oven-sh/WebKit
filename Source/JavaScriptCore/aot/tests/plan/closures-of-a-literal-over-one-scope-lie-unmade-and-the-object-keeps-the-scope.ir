# declare function print(...values: unknown[]): void;
# type Counter = { add: (by: number) => number; get: () => number; reset: () => void };
# function makeCounter(start: number): Counter { let n = start; return { add: (by: number) => (n += by), get: () => n, reset: () => { n = start; } }; }
# const kept: Counter[] = [];
# for (let i = 0; i < 5; i++) kept.push(makeCounter(i));
# function sum(list: Counter[]): number { let total = 0; for (let i = 0; i < list.length; i++) { list[i].add(1); total += list[i].get(); } return total; }
# print(sum(kept), sum(kept));
# -- end of source
# records of a5e852ff9736fa04
# Link proves of `add` and of `get` that they hold the closures of one function each, laid there by the construction alone, and each such closure is one word over the scope of makeCounter().
# Their slots hold a mark until the property is read as a value, four bytes wide, and the scope lies once in the object, in the other half of the first of them, under no name.
# `reset` captures `start` beside the scope: its closure is made where it is written.
