# CHECK: layout L0 CompiledObject
# CHECK-NEXT: slot 0 "add" DeferredClosure Inline offset=16 {{*}}type=f3
# CHECK-NEXT: slot 1 "get" DeferredClosure Inline offset=24 {{*}}type=f4
# CHECK-NEXT: slot 2 "reset" JSValue Inline offset=32
# CHECK-NEXT: slot 3 appended Cell32 Inline offset=20
# RUN(WITHHELD): plan layouts mechanisms=all-Deferral
# WITHHELD-NOT: DeferredClosure
# RUN(ANSWERS): run-in-shell
# ANSWERS: 15 20

