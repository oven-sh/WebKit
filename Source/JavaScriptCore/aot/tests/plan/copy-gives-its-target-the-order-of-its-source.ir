# WALK-NOT: PropDefine {{*}}key="a"
# WALK-NOT: PropDefine {{*}}key="b"
# WALK: = HasKeyOrder {{*}} layout=L1 fields=[0, 1]
# WALK: [[made]]: {{*}} = NewObject layout=L2
# WALK-NEXT: = TryCopyFields [[made]], {{*}} layout=L2 sourceLayout=L1 fields=[0, 1]
# WALK-NOT: PropDefine {{*}}key="a"
# WALK-NOT: PropDefine {{*}}key="b"
# RUN(WITHHELD): plan orders mechanisms=all-TypedSlots
# WITHHELD: orders L2
# WITHHELD-NEXT: order 0: "c" "a" "b"
# WITHHELD-NEXT: orders

