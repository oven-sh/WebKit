# the Body of a function whose result Link proves a number, an int32 or a boolean returns it raw: whoever calls it directly takes the word as it is, and the entry by value boxes it
# function half(n) { return n / 2 }  function bits(n) { return n | 0 }  function isBig(n) { return n > 2 }  function unsigned(n) { return n >>> 0 }
# function positive(n) { if (n > 0) return n }  async function later(n) { return n * 2 }  function Made() { return new.target === undefined ? 1 : 2 }
# RUN: plan units mechanisms=all
# CHECK: unit f1:Body ({{*}}) -> (Double)
# CHECK-NEXT: unit f1:GenericCallEntry -> f1:Body
# CHECK: unit f2:Body ({{*}}) -> (Int32)
# CHECK: unit f3:Body ({{*}}) -> (Boolean)
# An integer past int32 is returned as the double that it is
# CHECK: unit f4:Body ({{*}}) -> (Double)
# Undefined on one path: raw too, in the form that holds a number or undefined
# CHECK: unit f5:Body ({{*}}) -> (OptionalDouble)
# What a coroutine returns goes into its promise
# CHECK: unit f6:Body ({{*}}) -> (JSValue)
# CHECK: unit f6:CoroutineBody ({{*}}) -> (JSValue)
# Whoever constructs asks whether the body has handed back an object
# CHECK: unit f7:Body ({{*}}) -> (JSValue)
# CHECK: unit f7:GenericConstructEntry -> f7:Body
# function inner(n) { return n / 2 }  function outer(n) { return inner(n) }  sink(outer)
# Anybody may call outer, so it returns a boxed value, and nobody but its call in tail position takes what inner returns: boxed too, that call is a jump
# CHECK: unit f8:Body ({{*}}) -> (JSValue)
# CHECK: unit f9:Body ({{*}}) -> (JSValue)
# RUN(JUMPS): walk f9 mechanisms=-Inlining
# JUMPS: [[call]]: {{*}} @JSValue = CallDirect {{*}}function=f8
# JUMPS-NEXT: ReturnCall [[call]]
# Only a direct call takes a raw result, and only unboxed numbers make one
# RUN(BOXED): plan units mechanisms=-UnboxedNumbers
# BOXED-NOT: -> (Double)
# BOXED-NOT: -> (Int32)
# BOXED-NOT: -> (Boolean)
# BOXED-NOT: -> (OptionalDouble)
# RUN(CLOSED): plan units mechanisms=-DirectCalls
# CLOSED-NOT: -> (Double)
# CLOSED-NOT: -> (Int32)
# CLOSED-NOT: -> (Boolean)
# CLOSED-NOT: -> (OptionalDouble)

