  b0(v0: L1|L2):
    v1 = PropGet v0 key="y"
    Return v1
}
function f7 name="reader7" module=m0 length=1 thisType={type=anything} parameters=[{type=L1|L2 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L1|L2):
    v1 = PropGet v0 key="y"
