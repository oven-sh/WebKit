# the layouts of a written union get shape numbers side by side, so the test of the union is the test of a range. It is written of a parameter, so it is mentioned, and comes in front of a layout that nothing mentions
# type Shape = Circle | Square;   function area(s: Shape) { return s.r; }   with a record between the two that is no member: it has another field, since a record with the fields of a member is written as that member
# RUN: plan shapes mechanisms=none+TypedOperations
# CHECK: shape [[circle]] L0
# CHECK-NEXT: shape {{*}} L2
# CHECK: shape {{*}} L1
# RUN(ALL): plan shapes mechanisms=all
# ALL: shape [[circle]] L0
# ALL-NEXT: shape {{*}} L2

layout L0 name="Circle" module=m0 fields=[{key="r" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 name="Other" module=m0 fields=[{key="q" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L2 name="Square" module=m0 fields=[{key="r" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = FinishObject v5
    v7 = NewClosure function=f1
    v8 = Call v7, -, v2
    v9 = Call v7, -, v6
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="sink" [isFreeName]
    v12 = Call v11, -, v4, v8, v9
    Return v12
}
function f1 name="area" module=m0 length=1 thisType={type=anything} parameters=[{type=L0|L2 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0|L2):
    v1 = PropGet v0 key="r"
    Return v1
}
