# function kindOf(n: A | B | C) { return n.kind; }   A = { a, kind }   B = { kind, b }   C = { c, d, e }   beside   class K0 { f0 } .. class K4 extends K3 { f4 }, of which K4 alone is constructed.
# The union makes a group for the placer of union slots, and K2 and K3 repeat what their bases say of the fields above: the placer passed over those rows, and adds them to their units where groups arise.
# `kind` lies at one offset in A and B, and the foot of the row has the places of all fields above.
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject
# CHECK: slot 1 "kind" {{*}}offset=[[kind]]
# CHECK: layout L1 CompiledObject
# CHECK-NEXT: slot 0 "kind" {{*}}offset=[[kind]]
# CHECK: layout L4 None never-allocated
# CHECK: layout L5 None never-allocated
# CHECK: layout L6 None never-allocated
# CHECK: layout L7 CompiledObject size=64
# CHECK: "f4" {{*}} Inline offset=48
# CHECK: "f3" {{*}} Inline offset=40
# CHECK: "f2" {{*}} Inline offset=32
# CHECK: "f1" {{*}} Inline offset=24
# CHECK: "f0" {{*}} Inline offset=16

layout L0 name="A" module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="kind" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 name="B" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L2 name="C" module=m0 fields=[{key="c" declared={type=anything} flags=[IsRequired]}, {key="d" declared={type=anything} flags=[IsRequired]}, {key="e" declared={type=anything} flags=[IsRequired]}] ownFieldCount=3
layout L3 kind=Instance name="K0" module=m0 constructor=f2 fields=[{key="f0" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L4 kind=Instance name="K1" module=m0 base=L3 constructor=f3 fields=[{key="f1" declared={type=anything} flags=[IsRequired]}] supertypes=[L3] flags=[HasHeritage] ownFieldCount=1
layout L5 kind=Instance name="K2" module=m0 base=L4 constructor=f4 fields=[{key="f2" declared={type=anything} flags=[IsRequired]}] supertypes=[L4] flags=[HasHeritage] ownFieldCount=1
layout L6 kind=Instance name="K3" module=m0 base=L5 constructor=f5 fields=[{key="f3" declared={type=anything} flags=[IsRequired]}] supertypes=[L5] flags=[HasHeritage] ownFieldCount=1
layout L7 kind=Instance name="K4" module=m0 base=L6 constructor=f6 fields=[{key="f4" declared={type=anything} flags=[IsRequired]}] supertypes=[L6] flags=[HasHeritage] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = NewObject -, v0, v0 layout=L1 fields=[0, 1]
    v4 = FinishObject v3
    v5 = NewObject -, v0, v0, v0 layout=L2 fields=[0, 1, 2]
    v6 = FinishObject v5
    v7 = NewClosure function=f1
    v8 = Call v7, -, v2
    v9 = Call v7, -, v4
    v10 = Call v7, -, v6
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = NewClosure function=f2
    v14 = NewClass v13 layout=L3
    v15 = FinishClass v14 layout=L3
    v16 = Convert v15 declared={type=f2 flags=[IsFromCompiler]}
    v17 = ResolveHeritage v16
    v18 = NewClosure function=f3
    v19 = NewClass v18, v16, v17 layout=L4
    v20 = FinishClass v19 layout=L4
    v21 = Convert v20 declared={type=f3 flags=[IsFromCompiler]}
    v22 = ResolveHeritage v21
    v23 = NewClosure function=f4
    v24 = NewClass v23, v21, v22 layout=L5
    v25 = FinishClass v24 layout=L5
    v26 = Convert v25 declared={type=f4 flags=[IsFromCompiler]}
    v27 = ResolveHeritage v26
    v28 = NewClosure function=f5
    v29 = NewClass v28, v26, v27 layout=L6
    v30 = FinishClass v29 layout=L6
    v31 = Convert v30 declared={type=f5 flags=[IsFromCompiler]}
    v32 = ResolveHeritage v31
    v33 = NewClosure function=f6
    v34 = NewClass v33, v31, v32 layout=L7
    v35 = FinishClass v34 layout=L7
    v36 = Convert v35 declared={type=f6 flags=[IsFromCompiler]}
    v37 = Construct v36, -
    v38 = PropGet v37 key="f0"
    v39 = Call v12, -, v8, v9, v10, v38
    Return v39
}
function f1 name="kindOf" module=m0 length=1 thisType={type=anything} parameters=[{type=L0|L1|L2 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0|L1|L2):
    v1 = PropGet v0 key="kind"
    Return v1
}
