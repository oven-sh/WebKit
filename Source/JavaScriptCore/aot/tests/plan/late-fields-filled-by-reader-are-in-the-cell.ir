# class Point { constructor() { this.x = 1; } }  function prepare(points) { const p = points[0]; p.a = 0.5; p.b = 1.5; p.c = 2.5; p.d = 3.5; p.e = 4.5; p.f = 5.5; return p.a; }
# If only what a function is handed counted as filled together, six late fields of an object that it reads would lie out of line, and numbers would lie there as values.
