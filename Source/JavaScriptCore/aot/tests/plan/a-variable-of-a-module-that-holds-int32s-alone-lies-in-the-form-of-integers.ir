# The other raw form of a-variable-of-a-module-that-holds-numbers-alone-lies-raw.ir: `| 0` keeps the counter an int32, so Link says no double of it and it lies as an integer beside the markers.
# let count = 0;  function bump() { count = (count + 1) | 0; }  function read() { return count; }  bump();  read();
