# If what a require() evaluates counted as evaluated with the cycle around it, a module that ran to its end would keep the error of a cycle that it had left
# main.js: register(() => require("./first.js"), () => require("./outside.js"), () => require("./second.js"))
# first.js: import "./helper.js"; import "./second.js"; fail()    helper.js: hook()    outside.js: import "./second.js"; print("outside runs")    second.js: import "./first.js"; print("second runs")
# `hook` requires outside.js while first.js waits for helper.js: that evaluation begins second.js, passes over first.js, which another one has begun, and ends. Then first.js throws, alone.
# A site whose target leads to a cycle of imports asks the loader, which gives the evaluation a mark of its own. plain.js leads to none, and its start is called.
# RUN: plan module-starts
# CHECK-NOT: module m1 called-where-required
# CHECK-NOT: module m3 called-where-required
# CHECK-NOT: module m4 called-where-required
# CHECK: module m5 called-where-required
# RUN(FIRST): walk f6 mechanisms=none
# FIRST: EvaluateRequiredModule module=m1
# FIRST-NOT: role=ModuleStart
# RUN(OUTSIDE): walk f7 mechanisms=none
# OUTSIDE: EvaluateRequiredModule module=m3
# OUTSIDE-NOT: role=ModuleStart
# RUN(PLAIN): walk f9 mechanisms=none
# PLAIN: CallDirect function=f5 {{*}}role=ModuleStart
# PLAIN-NOT: EvaluateRequiredModule
# RUN(NONE): run-in-shell mechanisms=none globalThis.fail = () => { throw new Error("boom"); }; const ask = (name, load) => { try { load(); print(name + " returned"); } catch (error) { print(name + " threw " + error.message); } }; globalThis.register = (first, outside, second, plain) => { globalThis.hook = outside; ask("first", first); ask("second", second); ask("outside", outside); ask("first", first); ask("plain", plain); };
# NONE: second runs
# NONE-NEXT: outside runs
# NONE-NEXT: first threw boom
# NONE-NEXT: second returned
# NONE-NEXT: outside returned
# NONE-NEXT: first threw boom
# NONE-NEXT: plain runs
# NONE-NEXT: plain returned
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all globalThis.fail = () => { throw new Error("boom"); }; const ask = (name, load) => { try { load(); print(name + " returned"); } catch (error) { print(name + " threw " + error.message); } }; globalThis.register = (first, outside, second, plain) => { globalThis.hook = outside; ask("first", first); ask("second", second); ask("outside", outside); ask("first", first); ask("plain", plain); };
# ALL: second runs
# ALL-NEXT: outside runs
# ALL-NEXT: first threw boom
# ALL-NEXT: second returned
# ALL-NEXT: outside returned
# ALL-NEXT: first threw boom
# ALL-NEXT: plain runs
# ALL-NEXT: plain returned
# ALL-NEXT: exited with 0

