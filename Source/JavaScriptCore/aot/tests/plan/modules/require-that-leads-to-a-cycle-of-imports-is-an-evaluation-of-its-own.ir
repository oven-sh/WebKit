module m1 path="/first.js" displayPath="first.js" body=f1 requests=[{target=m2 completes=true}, {target=m4 completes=true}]
module m2 path="/helper.js" displayPath="helper.js" body=f2
module m3 path="/outside.js" displayPath="outside.js" body=f3 requests=[{target=m4 completes=true}]
module m4 path="/second.js" displayPath="second.js" body=f4 requests=[{target=m1 completes=true}]
module m5 path="/plain.js" displayPath="plain.js" body=f5
