# If the throw of a CommonJS file ended the load of the graph that imports it, the files that follow would never run. The loader runs them
# main.js: require("./graph.mjs")    graph.mjs: import "./first.cjs"; import "./second.cjs"; print("graph")    one.mjs: import "./third.cjs"
# The row of the graph runs its files before the graph begins, and they have states: the loader finishes a load that a throw interrupts.
# RUN: plan module-starts
# CHECK: module-start m1 body=f1: ResumeLoadOnThrow m1, CallStart f2, CallStart f3, BeginOrReturn m1, AbandonOnThrow m1, CallBody f1, Finish m1
# CHECK: module-start m2 body=f2: AbandonOnThrow m2, CallBody f2
# CHECK: module-start m3 body=f3: AbandonOnThrow m3, CallBody f3
# CHECK-NOT: ResumeLoadOnThrow m4
# RUN(NONE): run-in-shell mechanisms=none
# NONE: first
# NONE-NEXT: second
# NONE-NEXT: graph
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: first
# ALL-NEXT: second
# ALL-NEXT: graph
# ALL-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 kind=Require completes=true}, {target=m4 kind=Require completes=true}]
module m1 path="/graph.mjs" displayPath="graph.mjs" body=f1 requests=[{target=m2 completes=true isHoisted=true}, {target=m3 completes=true isHoisted=true}, {target=m2 completes=true}, {target=m3 completes=true}]
module m2 path="/first.cjs" displayPath="first.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f2 exportsVariable=g0
module m3 path="/second.cjs" displayPath="second.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f3 exportsVariable=g1
module m4 path="/one.mjs" displayPath="one.mjs" body=f4 requests=[{target=m5 completes=true isHoisted=true}, {target=m5 completes=true}]
module m5 path="/third.cjs" displayPath="third.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f5 exportsVariable=g2
entry module=m0
variable g0 name="exports" module=m2 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m3 declared={type=anything} initialization=Undefined
variable g2 name="exports" module=m5 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0 [isBare]
    EvaluateModule module=m4 referrer=m0 [isBare]
    Return
}
function f1 name="graph" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="graph"
    v3 = Call v1, -, v2
    Return
}
function f2 name="first" module=m2 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="first"
    v3 = Call v1, -, v2
    Return
}
function f3 name="second" module=m3 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="second"
    v3 = Call v1, -, v2
    Return
}
function f4 name="one" module=m4 kind=Module results=[{type=anything}] {
    Return
}
function f5 name="third" module=m5 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    Return
}
