# If a start went round a cycle of imports as often as the requests lead round it, a body would run twice, or the walk would never end
# main.js: import "./a.js"; print("main")    a.js: import "./b.js"; print("a")    b.js: import "./a.js"; print("b")
# The walk that fills a row comes to each module once, depth first, so `b` runs in front of `a`, which it imports and which has begun by then.
# RUN: plan module-starts
# CHECK: module-start m0 body=f0: BeginOrReturn m0, CallBody f2, CallBody f1, CallBody f0, Finish m0
# CHECK-NOT: module-start
# RUN(NONE): run-in-shell mechanisms=none
# NONE: b
# NONE-NEXT: a
# NONE-NEXT: main
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: b
# ALL-NEXT: a
# ALL-NEXT: main
# ALL-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/a.js" displayPath="a.js" body=f1 requests=[{target=m2 completes=true}]
module m2 path="/b.js" displayPath="b.js" body=f2 requests=[{target=m1 completes=true}]
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="main"
    v3 = Call v1, -, v2
    Return
}
function f1 name="a" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="a"
    v3 = Call v1, -, v2
    Return
}
function f2 name="b" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="b"
    v3 = Call v1, -, v2
    Return
}
