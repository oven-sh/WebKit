# If the run time walked the graph of imports itself, each of the thousands of modules of an application would cost a visit of the loader before the program has done anything
# main.js: import "./a.js"; import "./b.js"; print("main")    a.js: import "./shared.js"; print("a")    b.js: import "./shared.js"; print("b")    shared.js: print("shared")
# To evaluate such a module is only to call functions. The start of the entry point is a row of the image, which the stub StartModule goes through.
# `a` and `b` are reached through the entry point alone and run once with it, so neither has a state. Two ways lead to `shared`, both below the entry point: the walk comes to it once.
# RUN: plan module-starts
# CHECK: module-start m0 body=f0: BeginOrReturn m0, CallBody f3, CallBody f1, CallBody f2, CallBody f0, Finish m0
# CHECK-NOT: module-start
# CHECK: module m0 called-where-required starts-itself
# CHECK: module m1 called-where-required starts-itself evaluated-by-code-alone
# CHECK: module m2 called-where-required starts-itself evaluated-by-code-alone
# CHECK: module m3 called-where-required starts-itself evaluated-by-code-alone
# RUN(NONE): run-in-shell mechanisms=none
# NONE: shared
# NONE-NEXT: a
# NONE-NEXT: b
# NONE-NEXT: main
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: shared
# ALL-NEXT: a
# ALL-NEXT: b
# ALL-NEXT: main
# ALL-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="/a.js" displayPath="a.js" body=f1 requests=[{target=m3 completes=true}]
module m2 path="/b.js" displayPath="b.js" body=f2 requests=[{target=m3 completes=true}]
module m3 path="/shared.js" displayPath="shared.js" body=f3
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="main"
    v3 = Call v1, -, v2
    Return
}
function f1 name="a" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="a"
    v3 = Call v1, -, v2
    Return
}
function f2 name="b" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="b"
    v3 = Call v1, -, v2
    Return
}
function f3 name="shared" module=m3 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="shared"
    v3 = Call v1, -, v2
    Return
}
