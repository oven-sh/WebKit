# const box = { count: 1, ratio: 1.5, flag: true, name: "a", inner: { n: 1 } };   function read(b) { return b.count + b.ratio + b.inner.n + (b.flag ? b.name.length : 0); }   read(box)
# Every writer of each field is known, and the objects stay with compiled code. `type`: all that the form of the slot has, or nothing: every value. `doors`: what the record of the layout holds a store to (FieldData::type):
# Link's proof in the words of the test that the stubs run in line. A number slot loses its marks and keeps every number of its form, so that a store by name needs no test of the type as before; a boxed slot gets a type.
# RUN: plan layouts mechanisms=all
# CHECK: slot 0 "count" {{*}}type=undefined|null|{{*}} doors=
# CHECK-NOT: doors={{*}}undefined
# CHECK: slot 1 "ratio" OptionalDouble {{*}}type=undefined|null|number doors=number
# CHECK: slot 2 "flag" {{*}} doors=boolean
# CHECK: slot 3 "name" {{*}} doors=string
# CHECK: slot 4 "inner" {{*}} doors=L1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 fields=[{key="count" declared={type=anything} flags=[IsRequired]}, {key="ratio" declared={type=anything} flags=[IsRequired]}, {key="flag" declared={type=anything} flags=[IsRequired]}, {key="name" declared={type=anything} flags=[IsRequired]}, {key="inner" declared={type=anything} flags=[IsRequired]}] ownFieldCount=5
layout L1 module=m0 fields=[{key="n" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Double number=1.5
    v2 = Boolean boolean=true
    v3 = String string="a"
    v4 = Integer integer=1
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = NewObject -, v0, v1, v2, v3, v6 layout=L0 fields=[0, 1, 2, 3, 4]
    v8 = FinishObject v7
    v9 = NewClosure function=f1
    v10 = Call v9, -, v8 calleeName="read"
    Return v10
}
function f1 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="count"
    v2 = PropGet v0 key="ratio"
    v3 = Add v1, v2
    v4 = PropGet v0 key="inner"
    v5 = PropGet v4 key="n"
    v6 = Add v3, v5
    v7 = PropGet v0 key="flag"
    v8 = PropGet v0 key="name"
    v9 = PropGet v8 key="length"
    v10 = Add v6, v9
    v11 = Add v10, v7
    Return v11
}
