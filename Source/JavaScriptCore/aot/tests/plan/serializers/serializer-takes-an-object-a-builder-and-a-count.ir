# one serializer a layout: it takes the object, the builder and how many objects and lists are open around it, and returns an outcome. It is listed under the body of the module that declares the layout
# type T = { v: number; next?: T };  JSON.stringify({ v: 1 });
# RUN: plan units mechanisms=all
# CHECK: unit f0:Body
# CHECK: unit f0:Serializer:0 (Cell, Cell, Int32) -> (Int32)
# RUN(ONE): plan units mechanisms=all
# ONE-NOT: unit f0:Serializer:1

layout L0 module=m0 fields=[{key="v" declared={type=anything} flags=[IsRequired]}, {key="next" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=JSON [isNotReadFromHolder]
    v4 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v5 = Call v4, v3, v2 calleeName="JSON.stringify"
    Return v5
}
