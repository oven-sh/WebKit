# no built-in that the program comes by serializes: no layout has a place, and every other unit has the number that it had
# sink({ v: 1 });
# RUN: plan units mechanisms=all
# CHECK: unit f0:Body
# RUN(NEVER): plan units mechanisms=all
# NEVER-NOT: Serializer

layout L0 module=m0 fields=[{key="v" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="sink" [isFreeName]
    v5 = Call v4, -, v2 calleeName="sink"
    Return v5
}
