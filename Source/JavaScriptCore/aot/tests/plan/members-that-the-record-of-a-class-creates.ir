# The record of a class lists the members that its DefineMethods give it, and creates those that it can: on each side a beginning of them, because what the record creates comes first among the keys.
# A member under a computed key, under a name that its holder is made with (`name`, `length`, `prototype`, `constructor`), or over a capture that is not the one environment of the class object, is created at its definition, and so is every member of its side behind it.
# A class that is evaluated once creates them when one is first looked for. The walk builds no definition of a member that the record creates, and nothing names its closure, so the sweep drops that too: the record names the entry.
# class Plain { name(y) { return y; } get size() { return 1; } set size(v) { kept = v; } static make(y) { return y; } }
# let kept = 0;
# const key = String(kept);
# class Mixed { first() { return 1; } [key]() { return 2; } last() { return 3; } static name() { return 4; } static other() { return 5; } }
# function factory(tag) { return class Made { constructor() { this.tag = tag; } tagged() { return tag; } }; }
# class Below extends Plain { name(y) { return super.name(y) + 1; } }
# report(new Plain().name(1) + Plain.make(2) + new Mixed().last() + Mixed.other() + new (factory(6))().tagged() + new Below().name(7));
# RUN: plan classes mechanisms=all
# CHECK: class L0 lazy-members prototype-first class-object-on-mutation guards-hold-while-clear members=[ByClassRecord, ByClassRecord, ByClassRecord, ByClassRecord]
# CHECK-NEXT: class L1 members=[ByClassRecord, AtDefinition, AtDefinition, AtDefinition, AtDefinition]
# CHECK-NEXT: class L2 lazy-members class-object-on-mutation guards-hold-while-clear members=[ByClassRecord]
# CHECK-NEXT: class L3 guards-hold-while-clear members=[AtDefinition]
# RUN(WITHHELD): plan classes mechanisms=all-TypedOperations
# WITHHELD-NOT: class
# RUN(WALK): walk f0 f1 mechanisms=all-Inlining
# WALK-LABEL: code f0:Body
# WALK-NOT: function=f3
# WALK-NOT: function=f4
# WALK-NOT: function=f5
# WALK-NOT: function=f6
# WALK-NOT: layout=L0 {{*}}key=
# WALK: NewClass {{*}}layout=L1
# WALK-NOT: function=f8
# WALK: NewClosure function=f9
# WALK: DefineMethod {{*}}layout=L1 index=1
# WALK: DefineMethod {{*}}layout=L1 index=2 key="last"
# WALK: DefineMethod {{*}}layout=L1 side=Static index=3 key="name"
# WALK: DefineMethod {{*}}layout=L1 side=Static index=4 key="other"
# WALK: NewClass {{*}}layout=L2
# WALK-NOT: DefineMethod
# WALK-LABEL: code f1:Body
# WALK: DefineMethod {{*}}layout=L3 key="tagged"
# RUN(CLOSED): walk f0 mechanisms=none
# CLOSED: DefineMethod {{*}}layout=L0 key="name"
# CLOSED: DefineMethod {{*}}layout=L0 methodKind=Getter index=1 key="size"
# CLOSED: DefineMethod {{*}}layout=L0 methodKind=Setter index=2 key="size"
# CLOSED: DefineMethod {{*}}layout=L0 side=Static index=3 key="make"
# CLOSED: DefineMethod {{*}}layout=L1 key="first"
# CLOSED: DefineMethod {{*}}layout=L2 key="name"
# RUN(UNITS): units-with-code f3:GenericCallEntry f4:GenericCallEntry f5:GenericCallEntry f6:GenericCallEntry f8:GenericCallEntry f14:GenericCallEntry
# UNITS-NOT: has no code
# UNITS: unit f3:GenericCallEntry
# UNITS: unit f14:GenericCallEntry

