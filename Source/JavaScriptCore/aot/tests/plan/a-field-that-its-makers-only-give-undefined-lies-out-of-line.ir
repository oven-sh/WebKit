# CHECK-NEXT: slot 2 "declarations" {{*}}Inline offset=40
# CHECK-NEXT: slot 3 "parent" {{*}}Inline offset=48
# CHECK-NEXT: slot 4 "members" JSValue OutOfLine offset=8 {{*}}may-exist-without-storage
# CHECK-NEXT: slot 5 "only" JSValue OutOfLine offset=16 {{*}}may-exist-without-storage
# CHECK-NEXT: slot 6 "kept" {{*}}Inline offset=56
# CHECK-NEXT: slot 7 "later" appended

