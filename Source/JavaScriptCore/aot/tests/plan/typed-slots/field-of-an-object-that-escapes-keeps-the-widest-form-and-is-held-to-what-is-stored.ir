# the program stores numbers alone, but the object is handed to unknown code, which may store anything: not every writer is known, so the slot keeps the form that holds any value.
# It is HELD to what the stores of the program bring (Facts::held()): whoever stores anything else takes the field out of its slot.
# const o = { x: 1.5 }; sink(o)
# TODO: no slot is held to a type since 11-03 08:25: held types bought nothing on any judge and cost the servers 1 to 5% (plan/AOTSlotPlan.cpp, typeHeldOfFieldForSlotPlan())
# RUN: plan layouts mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# CHECK: layout L0 CompiledObject
# CHECK-NEXT: slot 0 "x" JSValue Inline {{*}} type=fractional
# RUN(LINK): link fields mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# LINK: field L0.0 "x"
# LINK-NOT: writers-known

layout L0 module=m0 fields=[{key="x" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="x"
    v3 = FinishObject v1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="sink" [isFreeName]
    v6 = Call v5, -, v3
    Return v6
}
