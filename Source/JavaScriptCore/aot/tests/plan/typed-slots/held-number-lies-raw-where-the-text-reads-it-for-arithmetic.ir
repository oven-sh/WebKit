# class Shape { r: number; low: number; high: number; side: number; label: number; kept: number; constructor(n: number) { this.r = n; this.low = n; this.high = n; this.side = n; this.label = n; this.kept = n; } }
# function area(s: Shape) { return s.r * s.r * 3.5; }
