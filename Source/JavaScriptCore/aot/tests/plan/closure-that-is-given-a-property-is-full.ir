# A slim closure that is given a property, frozen or moved below another object gets storage of its own at that moment, through the run time: 946 instructions for `f = () => a; f.tag = 1` where a full closure takes 153.
# So a function is given full closures where reached code does one of those to a value that holds its closures and no others. Reading `name` and `length`, calling, and looking for a name change nothing.
# It is an expectation: what unseen code does, or what is done through a value that may hold closures of several functions, is not in it, and costs time alone. Without a word of Link every one of these is slim.
# -- source: closures-changed.ts
# declare function use(...values: unknown[]): void;
# function makeAll(a: number) {
#   const onlyCalled = () => a;
#   const onlyRead = () => a + 1;
#   use(onlyRead.name, onlyRead.length, onlyRead.call(null), "x" in onlyRead);
#   const stored: any = () => a + 2;
#   stored.tag = 1;
#   const storedUnderSymbol: any = () => a + 3;
#   storedUnderSymbol[Symbol.iterator] = 1;
#   const defined = () => a + 4;
#   Object.defineProperty(defined, "x", { value: 1 });
#   const copiedInto = () => a + 5;
#   Object.assign(copiedInto, { x: 1 });
#   const frozen = () => a + 6;
#   Object.freeze(frozen);
#   const movedBelow = () => a + 7;
#   Object.setPrototypeOf(movedBelow, null);
#   const deletedFrom: any = () => a + 8;
#   delete deletedFrom.name;
#   const namesItself: any = () => namesItself.tag + a;
#   namesItself.tag = 9;
#   use(onlyCalled, onlyRead, stored, storedUnderSymbol, defined, copiedInto, frozen, movedBelow, deletedFrom, namesItself);
# }
# makeAll(1);
# -- end of source
