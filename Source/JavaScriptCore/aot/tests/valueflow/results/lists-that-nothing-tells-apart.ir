# A list of constants that nothing changes and nothing can tell from another list made at the same place: one cell may stand for all of them.
# `good` and `goodNested` are such lists. Every other function makes a list that something changes, compares, uses as a key, watches, or hands to code that flow does not know.
# In `innerCompared` the comparison meets the inner lists alone, and the outer list loses the fact with them: it must hold new inner lists each time.
# -- source: main.js
# function good() { return [1, 2, 3]; }
# function goodNested() { return [[1, 2], [3]]; }
# function compared() { return [1, 2, 4]; }
# function pushed() { return [1, 2, 5]; }
# function shortened() { return [1, 2, 6]; }
# function frozen() { return [1, 2, 7]; }
# function keyOfMap() { return [1, 2, 8]; }
# function handed() { return [1, 3, 1]; }
# function insideEscaped() { return [1, 3, 2]; }
# function returned() { return [1, 3, 3]; }
# function through() { return returned(); }
# function stored() { return [1, 3, 4]; }
# function memberOfSet() { return [1, 3, 5]; }
# function watched() { return [1, 3, 6]; }
# function sameValue() { return [1, 3, 7]; }
# function switched() { return [1, 3, 8]; }
# function named() { return [1, 4, 1]; }
# function parent() { return [1, 4, 2]; }
# function innerCompared() { return [[1, 4], [4]]; }
# function holdsObject() { return [{ a: 1 }]; }
# let sum = good()[1] + goodNested()[1][0];
# if (compared() === compared()) sum++;
# pushed().push(4);
# shortened().length = 0;
# Object.freeze(frozen());
# new Map().set(keyOfMap(), 1);
# report(handed());
# report({ inner: insideEscaped() });
# if (through() === through()) sum++;
# stored()[0] = 9;
# new Set().add(memberOfSet());
# new WeakRef(watched());
# if (Object.is(sameValue(), sameValue())) sum++;
# switch (switched()) {
#   case switched():
#     sum++;
# }
# named().extra = 1;
# Object.create(parent());
# if (innerCompared()[0] === innerCompared()[0]) sum++;
# sum += holdsObject()[0].a;
# report(sum);
# -- end of source
# FORM: AsRead
# RUN: valueflow-results
# CHECK: site [[good]] function=f2 builtinClass=Array
# CHECK-NEXT: site [[outer]] function=f3 builtinClass=Array
# CHECK: never-told-apart [[good]]
# CHECK-NEXT: never-told-apart [[outer]]
# CHECK-NEXT: never-told-apart [[first]]
# CHECK-NEXT: never-told-apart [[second]]
# CHECK-NOT: never-told-apart

