# function typed(s: string) { return s.length + s.charCodeAt(0) }  function expected(s /* string, by a prediction */) { return s.length }  function unknown(v) { return v.length }
# The length of a string and one of its code units are operations that carry no stamp of an access site, so the only stamped copy of such an access is its slow half.
# `typed` escapes: the reads by name are in its generic version, behind the check at the entry. In the typed version each is one load: free, as every access behind a parameter check.
# In `expected` nothing checks the parameter. A test was made for the read, which goes by name where the test fails: the read tests its receiver.
# Nothing is expected of `v`: that read is by name.
# The counts by cost are: by name, tests the receiver, tests the slot, free
# RUN: flow-report through=Select
# OPTIONS: report=Flow
# CHECK: access-count m0 accesses=[4, 0, 0] accessCosts=[1, 1, 0, 2]
# CHECK: access m0:110 Read Unknown Free
# CHECK-NEXT: access m0:120 Read Unknown Free
# CHECK-NEXT: access m0:125 Call Unknown Free
# CHECK-NEXT: access m0:220 Read Unknown TestsReceiver
# CHECK-NEXT: access m0:310 Read Unknown ByName
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = Call v1, -, v2, v3, v4
    Return v5
}
function f1 name="typed" parameters=[{type=string flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0):
    v1 = Check v0 expectedType=string @100
    v2 = PropGet v1 key="length" @110
    v3 = Integer
    v4 = PropGet v1 key="charCodeAt" @120
    v5 = Call v4, v1, v3 @125
    v6 = Add v2, v5 @130
    Return v6
}
function f2 name="expected" parameters=[{type=string flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="length" @220
    Return v1
}
function f3 name="unknown" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="length" @310
    Return v1
}
