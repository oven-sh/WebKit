# The slot of a field that holds only written strings holds their numbers. It holds cells where the program only uses what it reads
# from the field as a string, some store brings a cell, and the stores of written strings are no more than the accesses that want cells.
#   const texts = ["plain", "wider", "again", "more"];
#   const input = (globalThis as any).input | 0;
#   const readAsString = { text: "plain" };
#   readAsString.text = texts[input & 3]!;
#   const compared = { tag: "plain" };
#   compared.tag = texts[input & 3]!;
#   const mostlyWritten = { label: "a" };
#   mostlyWritten.label = "b";
#   mostlyWritten.label = "c";
#   mostlyWritten.label = "d";
#   mostlyWritten.label = texts[input & 3]!;
#   const onlyWritten = { note: "a" };
#   onlyWritten.note = input ? "b" : "c";
#   (globalThis as any).answer = [readAsString.text.length, compared.tag === "again", mostlyWritten.label.length, onlyWritten.note.length];
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: fields=[{key="text" declared={type=undefined|"again"|"more"|"plain"|"wider"{{*}} slotType=undefined|string}]
# CHECK-NOT: slotType
# CHECK: fields=[{key="tag" declared={type=undefined|"again"|"more"|"plain"|"wider"
# CHECK: fields=[{key="label" declared={type=undefined|"a"|"again"|"b"|"c"|"d"|"more"|"plain"|"wider"
# CHECK: fields=[{key="note" declared={type="a"|"b"|"c"

