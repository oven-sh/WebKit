# source = { kept: 1 }; target = {}; __exportStar(source, target), as the front end sends a call of the helper that it knows: the operation, and behind its `false` the loop as it is written.
# The operation does part of what that loop does, so neither object gets into hands that nobody follows: the field of the source keeps its slot.
# RUN: valueflow-apply
# CHECK: layout L0 name="Source" fields=[{key="kept" {{*}}storeNaming=EveryStoreNamesLocation
# CHECK-NOT: cause=ReachesUnknownJavaScript

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source" fields=[{key="kept" declared={type=anything}}]
layout L1 name="Target" fields=[]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    v2 = Integer integer=1
    PropSet v1, v2 key="kept" mode=Sloppy
    v4 = NewObject layout=L1
    v5 = FinishObject v4
    v6 = TryReExportFields v5, v1 function=f1
    Branch v6 -> taken b2(), notTaken b1()
  b1():
    v7 = String string="kept"
    v8 = NewClosure v1, v7 function=f1
    DefineGetter v5, v8 key="kept"
    Jump -> next b2()
  b2():
    v10 = PropGet v1 key="kept"
    Return
}
function f1 name="get" module=m0 captures=[{type=anything}, {type=anything}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
