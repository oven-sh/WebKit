# first.js: import "./inner.js"        inner.js: new Function(input)(); export let value = 1        second.js: import { value } from "./inner.js"; value        built with two entry points, first.js and second.js
# Text that Function is given names an entry point: the loader answers an import() of it under any name, and so does the require() that process.getBuiltinModule("module") makes for the text.
# So the text in inner.js begins second.js while inner.js runs, and second.js reads the variable before inner.js has stored it.
# evaluated-text-loads-no-file-of-the-program.ir has one entry point, which has begun before any text runs. two-entry-points-without-evaluated-text.ir has no text
# RUN: valueflow-apply
# CHECK: variable g0 name="value"
# CHECK-NOT: initialization=StoredBeforeEveryRead
# CHECK: module m0
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" body=f2 requests=[{target=m1 completes=true}]
entry module=m0
entry module=m2
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = Integer integer=1
    PutModuleVariable v5 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
