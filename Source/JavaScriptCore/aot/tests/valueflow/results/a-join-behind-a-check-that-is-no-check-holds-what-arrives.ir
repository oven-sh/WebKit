# interface Wanted { wanted: string }   class Other {}   let held: Wanted = new Other() as any; held = 5 as any
# function read() { return [][held as any] }, where the key is made of an object before the element is read
# The type of the variable is only expected, so a check stands behind the read, and what is typed from it is typed from what the check proved: behind the test for an object only undefined and null are left,
# and the join with the key that is made of an object is read as undefined, null, a string or a symbol.
# Flow knows every store to `held`: an object of another layout and a whole number. Neither passes the check, so it is no check, and the value has the type of what arrives.
# What flow says of a value behind such a check is what it holds there, the whole number too, and not the part of it that lies inside the type the value had.
# RUN: valueflow-apply
# CHECK-LABEL: function f1 name="read"
# CHECK: = AssumeType v0 provenType=int|absent|L1
# CHECK: b2([[rest]]: int{{*}}):
# CHECK: b3([[key]]: int|string|symbol{{*}}):
# CHECK-NOT: AssumeType [[key]] provenType=string|symbol
# CHECK: = ElemGet

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Wanted" fields=[{key="wanted" declared={type=string} flags=[IsRequired]}]
layout L1 name="Other" fields=[]
variable g0 name="held" module=m0 declared={type=undefined|null|absent|L0 flags=[IsExpected]}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L1
    PutModuleVariable v0 variable=g0
    v2 = CallDirect function=f1
    v3 = Integer integer=5
    PutModuleVariable v3 variable=g0
    v5 = CallDirect function=f1
    Return
}
function f1 name="read" module=m0 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Check v0 expectedType=undefined|null|absent|L0
    v2 = CheckInitialized v1 name="held"
    v3 = TypeTest v2 testedType=object
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = ToPropertyKey v4
    Jump -> next b3(v5)
  b2(v6):
    Jump -> next b3(v6)
  b3(v7):
    v8 = NewArray
    v9 = ElemGet v8, v7
    Return v9
}
