# { ...r, ...more } and Object.assign({}, q, more) under type parameters: what the maker of a copy copies into it besides gets fields in the layout that is copied.
# RUN: valueflow-apply
# CHECK: layout L0 name="R" fields=[{key="a"
# CHECK: {key="at" {{*}} flags=[IsAddedLate
# CHECK: layout L1 name="Base"
# CHECK: layout L3 name="Q" fields=[{key="b"
# CHECK: {key="to" {{*}} flags=[IsAddedLate
# CHECK: layout L4 name="To"

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="R" fields=[{key="a" declared={type=number}}, {key="name" declared={type=string}}] supertypes=[L1]
layout L1 name="Base" fields=[{key="name" declared={type=string} flags=[IsRequired]}]
layout L2 name="At" fields=[{key="at" declared={type=number}}]
layout L3 name="Q" fields=[{key="b" declared={type=number}}, {key="name" declared={type=string}}] supertypes=[L1]
layout L4 name="To" fields=[{key="to" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = String string="o"
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = Integer integer=2
    v4 = NewObject -, v3 layout=L2 fields=[0]
    v5 = CopyObject v2
    CopyDataProperties v5, v4
    v7 = NewObject -, v0, v1 layout=L3 fields=[0, 1]
    v8 = NewObject -, v3 layout=L4 fields=[0]
    v9 = CopyObject v7 [assigns]
    v10 = Builtin builtin=ObjectAssign
    v11 = Call v10, -, v9, v8
    v12 = PropGet v5 key="at"
    v13 = PropGet v9 key="to"
    v14 = Add v12, v13
    Return v14
}
