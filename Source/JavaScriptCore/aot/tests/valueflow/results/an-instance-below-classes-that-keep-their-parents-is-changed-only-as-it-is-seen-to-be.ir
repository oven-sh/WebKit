# class Base { constructor() { this.a = 1 } }  class Sub extends Base { constructor() { super(); this.b = 2 } }  class Keyed extends Map { constructor() { super(); this.b = 2 } }
# The constructor at the top makes the object. Each class object keeps the parent that it was defined with, so that is Base, a function of the program, or Map, whose class lists what it lays on a new instance.
# FORM: AsRead
# RUN: valueflow-results
# CHECK: class [[sub]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty,
# CHECK: class [[keyed]] layout=L2 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Sub" base=L0 constructor=f2 fields=[{key="b" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
layout L2 kind=Instance name="Keyed" constructor=f3 fields=[{key="b" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Builtin builtin=Map
    v8 = NewClosure function=f3
    v9 = ResolveHeritage v7
    v10 = NewClass v8, v7, v9 layout=L2
    v11 = FinishClass v10 layout=L2
    v12 = Construct v6
    v13 = PropGet v12 key="b"
    v14 = Construct v11
    v15 = PropGet v14 key="b"
    Return v13
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="a" mode=Strict
    Return v2
}
function f2 name="Sub" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropSet v3, v4 key="b" mode=Strict
    Return v3
}
function f3 name="Keyed" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    v4 = Integer integer=2
    PropSet v3, v4 key="b" mode=Strict
    Return v3
}
