# type Row = { v: number; at: number };   const shown: Row = { v: 1, at: 2 };   const row = JSON.parse(text) as Row;   kept[0] = shown;   kept[row.at];
# type Pair = { a: number };               kept[0] = { a: 3 };   kept[0] = { a: row.v };
# The program shows an int32 for every field, so NarrowFieldTypes keeps them as integers. A text may hold any number.
# Row.v is a number again, and so is Pair.a, which is stored what is read from a row: it may be any value, so the stores into Pair.a are tested for a number.
# Row.at is an index: it stays an integer, and a text that holds another number there is no Row.
# FORM: AsRead
# RUN: valueflow-apply

# CHECK: layout L0 name="Row" {{*}}{key="v" declared={type=number} flags=[IsRequired, IsEnforced] {{*}}{key="at" declared={type=int[-2147483643, 2147483647]} flags=[IsRequired, IsEnforced]
# CHECK: layout L1 name="Pair" {{*}}{key="a" declared={type=number} flags=[IsRequired, IsEnforced]
# CHECK-NOT: typeBeforeNarrowing

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Row" module=m0 fields=[{key="v" declared={type=number} flags=[IsRequired]}, {key="at" declared={type=number} flags=[IsRequired]}]
layout L1 name="Pair" module=m0 fields=[{key="a" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module flags=[IsChecked] results=[{type=anything}] {
    v0 = Builtin builtin=JSON
    v1 = Builtin builtin=JSONParse
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="text" [isFreeName]
    v4 = Call v1, v0, v3
    v5 = Convert v4 declared={type=undefined|null|L0 flags=[IsExpected]}
    v6 = Integer integer=1
    v7 = Integer integer=2
    v8 = Integer integer=3
    v9 = Integer
    v10 = NewArray contents=anything
    v11 = NewObject -, v6, v7 layout=L0 fields=[0, 1]
    v12 = FinishObject v11
    ElemSet v10, v9, v12
    v14 = PropGet v5 key="at"
    v15 = ElemGet v10, v14
    v16 = NewObject -, v8 layout=L1 fields=[0]
    v17 = FinishObject v16
    ElemSet v10, v9, v17
    v19 = PropGet v5 key="v"
    v20 = Convert v19 declared={type=number flags=[IsExpected]}
    v21 = NewObject -, v20 layout=L1 fields=[0]
    v22 = FinishObject v21
    ElemSet v10, v9, v22
    v24 = PropGet v22 key="a"
    v25 = NewArray v15, v24 contents=anything
    Return v25
}
