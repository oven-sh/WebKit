# first.js: import "./inner.js"   inner.js: input(); export let value = 1   mid.js: import { value } from "./inner.js"; value   second.js: import "./mid.js"   built with two entry points, first.js and second.js
# No text is evaluated: mid.js runs when inner.js has run to its end. evaluated-text-loads-an-entry-point-above-the-file-that-reads.ir is the same program with a text
# RUN: valueflow-apply
# CHECK: variable g0 name="value" {{*}}initialization=StoredBeforeEveryRead

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" body=f2 requests=[{target=m3 completes=true}]
module m3 path="mid.js" displayPath="mid.js" body=f3 requests=[{target=m1 completes=true}]
entry module=m0
entry module=m2
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    Return
}
function f3 name="mid" module=m3 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
