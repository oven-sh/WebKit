    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = CallDirect function=f5
    v5 = CallDirect function=f6
    v6 = CallDirect function=f6
    v7 = Boolean boolean=true
    Jump -> next b1()
  b1():
    v8 = NewClosure function=f3
    v9 = NewClass v8 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = Construct v10
    LoopHint
    Branch v7 -> taken b1(), notTaken b2()
  b2():
    Return
}
