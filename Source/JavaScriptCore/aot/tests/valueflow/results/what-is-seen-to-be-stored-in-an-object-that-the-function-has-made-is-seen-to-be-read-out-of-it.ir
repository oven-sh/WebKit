# In the library: type Listener = (request: Request) => void   function listen(listener: Listener) { unknown(listener, new Request()) }
# In the program: function listener(request) { const context = {}; context.request = request; read(context) }   function read(context) { context.request.url }   listen(listener)
# The requests that have gone out of sight are seen to come to the listener. It stores what it is given in an object that it has made itself, so they are seen to lie in that field,
# and whoever reads the field is seen to get them. Nothing is proven of what is read.
