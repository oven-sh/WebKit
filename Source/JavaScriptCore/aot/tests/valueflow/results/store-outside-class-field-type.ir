# A store by name of an instance of the built-in class that the type of a field names is inside that type. A store of any other object is outside: a built-in function in a field of maps, a plain object in a field of iterators
# RUN: valueflow-apply
# CHECK: layout L0 name="MapGetsFunction" fields=[{key="held" {{*}}stability=[IsNeverDeleted, IsNeverRedefined]}
# CHECK: layout L1 name="IteratorGetsPlainObject" fields=[{key="held" {{*}}stability=[IsNeverDeleted, IsNeverRedefined]}
# CHECK: layout L2 name="ArrayGetsArray" fields=[{key="held" {{*}}occupancy=AlwaysFilled {{*}}stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: layout L3 name="WeakRefGetsWeakRef" fields=[{key="held" {{*}}occupancy=AlwaysFilled {{*}}stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# CHECK: layout L4 name="MapGetsMap" fields=[{key="held" {{*}}occupancy=AlwaysFilled {{*}}stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}
# RUN(RESULTS): valueflow-results
# RESULTS: class [[mapGetsFunction]] layout=L0 impossibleMutations=[
# RESULTS-NOT: StoreOfOtherType
# RESULTS: class [[iteratorGetsPlainObject]] layout=L1 impossibleMutations=[
# RESULTS-NOT: StoreOfOtherType
# RESULTS: class [[arrayGetsArray]] layout=L2 impossibleMutations=[{{*}}StoreOfOtherType
# RESULTS-NEXT: class [[weakRefGetsWeakRef]] layout=L3 impossibleMutations=[{{*}}StoreOfOtherType
# RESULTS-NEXT: class [[mapGetsMap]] layout=L4 impossibleMutations=[{{*}}StoreOfOtherType

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="MapGetsFunction" fields=[{key="held" declared={type=undefined|null|Map} flags=[IsRequired]}]
layout L1 name="IteratorGetsPlainObject" fields=[{key="held" declared={type=undefined|null|Iterator} flags=[IsRequired]}]
layout L2 name="ArrayGetsArray" fields=[{key="held" declared={type=undefined|null|Array<anything>} flags=[IsRequired]}]
layout L3 name="WeakRefGetsWeakRef" fields=[{key="held" declared={type=undefined|null|WeakRef} flags=[IsRequired]}]
layout L4 name="MapGetsMap" fields=[{key="held" declared={type=undefined|null|Map} flags=[IsRequired]}]
layout L5
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Null
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewObject -, v0 layout=L3 fields=[0]
    v5 = NewObject -, v0 layout=L4 fields=[0]
    v6 = Builtin builtin=ArrayPrototypePush
    v7 = NewObject layout=L5 fields=[]
    v8 = NewArray contents=anything
    v9 = Builtin builtin=WeakRef
    v10 = Construct v9, -, v7
    v11 = Builtin builtin=Map
    v12 = Construct v11
    v13 = CallDirect v1, v6 function=f1
    v14 = CallDirect v2, v7 function=f2
    v15 = CallDirect v3, v8 function=f3
    v16 = CallDirect v4, v10 function=f4
    v17 = CallDirect v5, v12 function=f5
    Return
}
function f1 name="storeFunction" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f2 name="storePlainObject" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f3 name="storeArray" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f4 name="storeWeakRef" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f5 name="storeMap" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="held" mode=Strict
    Return
}
