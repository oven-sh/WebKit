# class Base {
#   constructor(a) {
#     this.a = a;
#   }
# }
# const parents = { Base };
# class Middle extends parents.Base {
#   constructor(a) {
#     super(a + 1);
#   }
# }
# parents.Middle = Middle;
# class Below extends parents.Middle {
#   constructor(a) {
#     super(a + 1);
#   }
# }
# report(Base, Middle, Below, new Below(1).a);
# FORM: AsRead
# RUN: valueflow-apply
# The declaration of Below names no parent: it extends what it reads from an object. All three classes escape, so the unknown object covers them wherever they arrive.
# super() in Below is still seen to call Middle: what the definition of a class is seen to extend is seen above the class.
# CHECK-LABEL: function {{*}}name="Below"
# CHECK: SuperConstruct {{*}} callees=[f2, ..]

