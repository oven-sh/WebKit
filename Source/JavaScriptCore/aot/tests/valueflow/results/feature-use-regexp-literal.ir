entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a|b"
    v1 = PropGet v0 key="test"
    v2 = String string="b"
    v3 = Call v1, v0, v2 calleeKey="test"
    Return
}
function f1 name="unreached" results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a+" regExpFlags=[Global]
