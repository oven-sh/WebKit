# interface Sized { size: number }   function parsed(text: string): Sized { return JSON.parse(text) }   function made(): Sized { return { get size() { return 2 } } }   function other() { return { get width() { return 2 } } }
# The parser makes its objects with the layout of the literal and puts a number into the field, so the field of L0 holds values, and the getter of the literal stays an extra property.
# The literal of L1 is the only birth of its layout: its getter lies in the slot.
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: layout L0 name="Sized"
# CHECK-NOT: IsAccessor
# CHECK: IsParsedByType
# CHECK: layout L1 {{*}}form=[IsAccessor]{{*}}slotType=f4
# CHECK: function f0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Sized" fields=[{key="size" declared={type=number} flags=[IsRequired]}]
layout L1 fields=[{key="width" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = CallDirect v2 function=f1
    v4 = PropGet v3 key="size"
    v5 = CallDirect function=f2
    v6 = PropGet v5 key="size"
    v7 = CallDirect function=f3
    v8 = PropGet v7 key="width"
    v9 = Add v4, v6
    v10 = Add v9, v8
    Return v10
}
function f1 name="parsed" parameters=[{type=string}] results=[{type=anything}] {
    v1 = Builtin builtin=JSONParse
    v2 = Call v1, -, v0
    v3 = Convert v2 declared={type=undefined|null|L0} illTypedCause=FromLooseType
    Return v3
}
function f2 name="made" results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = NewClosure function=f4
    DefineGetter v0, v1 key="size"
    v3 = FinishObject v0
    Return v3
}
function f3 name="other" results=[{type=anything}] {
    v0 = NewObject layout=L1
    v1 = NewClosure function=f4
    DefineGetter v0, v1 key="width"
    v3 = FinishObject v0
    Return v3
}
function f4 name="size" kind=Getter results=[{type=anything}] {
    v0 = Integer integer=2
    Return v0
}
