# sorted = [3, 1, 2]; sorted.sort()    reversed = [3, 1, 2]; reversed.reverse()    filled = [3, 1, 2]; filled.fill(x)
# sort() and reverse() put the elements of a list in another order: it holds what it held, is as long as it was and gets no hole. So the integers keep their range.
# The elements have moved, so nothing is said of the storage that the literal was made with. fill() stores what it is handed: nobody has followed that, and the integers are of any size.
# RUN: valueflow-apply
# CHECK-LABEL: variable g0 name="sorted"
# CHECK: declared={type=Array<int[1, 3], proven, pristine[Storage{{*}}, Dense]>}
# CHECK-LABEL: variable g1 name="reversed"
# CHECK: declared={type=Array<int[1, 3], proven, pristine[Storage{{*}}, Dense]>}
# CHECK-LABEL: variable g2 name="filled"
# CHECK-NOT: int[1, 3]
# CHECK-LABEL: function f0 name="main"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="sorted" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="reversed" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="filled" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = Integer integer=3
    v3 = NewArray v2, v0, v1 contents=anything
    PutModuleVariable v3 variable=g0
    v5 = PropGet v3 key="sort"
    v6 = Call v5, v3 calleeKey="sort"
    v7 = NewArray v2, v0, v1 contents=anything
    PutModuleVariable v7 variable=g1
    v9 = PropGet v7 key="reverse"
    v10 = Call v9, v7 calleeKey="reverse"
    v11 = NewArray v2, v0, v1 contents=anything
    PutModuleVariable v11 variable=g2
    v13 = PropGet v11 key="fill"
    v14 = Call v13, v11, v0 calleeKey="fill"
    v15 = Undefined
    Return v15
}
