layout L1 kind=Instance name="Below" base=L0 constructor=f3 fields=[{key="n" declared={type=number} flags=[IsRequired]}, {key="m" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
layout L2 kind=Instance name="DecidedByCheck" base=L0 constructor=f5 fields=[{key="n" declared={type=undefined|number}}] flags=[HasHeritage]
layout L3 kind=Instance name="HandsArgumentUp" base=L0 constructor=f7 fields=[{key="n" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
