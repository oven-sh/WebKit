# class Base { id = 1 }   class Below extends Base { n: number; m: number; constructor(n: number) { super(); this.n = n; this.m = n; } }   new Below(2);
# What super(..) answers is expected to have the layout of the class, and a check says so. In front of each `this` stands the test whether super(..) has been called.
# An object is never absent, with the check or without it: no version of the constructor enters the blocks that throw, both stores run before anybody looks at the object,
# and neither field holds the undefined of its definition. `HandsArgumentUp` calls super(n): what super(..) answers is an object whatever it is handed, also what a check would have turned away.
# `DecidedByCheck` stores only where its argument is not undefined, and that the check of the parameter alone decides: the generic version leaves the store out, and the undefined stays
# FORM: AsRead
# RUN: valueflow-apply

# CHECK: layout L1 kind=Instance name="Below" {{*}}{key="n" declared={type=int[{{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="m" declared={type=int[{{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="id"
# CHECK: layout L2 kind=Instance name="DecidedByCheck" {{*}}{key="n" declared={type=undefined|int[
# CHECK: layout L3 kind=Instance name="HandsArgumentUp" {{*}}{key="n" declared={type=int[{{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="id"

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
