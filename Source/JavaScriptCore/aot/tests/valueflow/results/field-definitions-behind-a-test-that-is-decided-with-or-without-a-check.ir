    v0 = Integer integer=2
    v1 = Undefined
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = NewClosure function=f3
    v6 = ResolveHeritage v4
    v7 = NewClass v5, v4, v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8, -, v0
    v10 = PropGet v9 key="n"
    v11 = PropGet v9 key="m"
    v12 = NewClosure function=f5
    v13 = ResolveHeritage v4
    v14 = NewClass v12, v4, v13 layout=L2
    v15 = FinishClass v14 layout=L2
    v16 = Construct v15, -, v0
    v17 = Construct v15, -, v1
    v18 = PropGet v17 key="n"
    v19 = NewClosure function=f7
    v20 = ResolveHeritage v4
    v21 = NewClass v19, v4, v20 layout=L3
    v22 = FinishClass v21 layout=L3
    v23 = Construct v22, -, v0
    v24 = PropGet v23 key="n"
    Return v18
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget, IsChecked] results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
