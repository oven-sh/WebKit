# function Type() {}    const type = new Type(); type.id = 1; publish(type)    publish(Object.create(target, { id: { get, set } }))
# Unknown code may hang every object that has escaped above every other one, and a definition on an object that nobody knows may hit every prototype that has escaped.
# So one accessor anywhere in the program lies "above" the instances of every class whose instances escape. That takes no name from them: `id` gets its field in Type.
# The field is right whatever hangs above an instance, since a store that creates it and a read that finds it empty test that the object inherits nothing under the name.
# An accessor that the program itself defines on the prototype object of the class does take the name: a store to `id` of a State runs the setter, and State gets no field
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Type" constructor=f1 fields=[{key="id" {{*}}flags=[IsAddedLate
# CHECK: layout L2 kind=Instance name="State" constructor=f4
# CHECK-NOT: fields=[{key="id"
# CHECK: layout L3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Type" constructor=f1 flags=[IsConstructorFunction]
layout L1 name="PropertyDescriptor" fields=[{key="get" declared={type=anything}}, {key="set" declared={type=anything}}]
layout L2 kind=Instance name="State" constructor=f4 flags=[IsConstructorFunction]
layout L3 name="Target" fields=[{key="text" declared={type=anything}}]
