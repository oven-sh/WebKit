# Text that Function is given names an entry point and no other file of the program: the run time refuses it an import() of any other. This program has one entry point, which has begun
# before any text runs. So an import() in the text does not begin it in the middle of a module that it imports, and a variable that the imported module stores before the entry point reads it
# is stored before every read. evaluated-text-loads-a-second-entry-point.ir has two entry points. A load of the program's own under a name nobody knows may name the entry point
# RUN: valueflow-apply
# CHECK: variable g0 name="value" {{*}}initialization=StoredBeforeEveryRead
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
entry module=m0
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = GetModuleVariable variable=g0
    v6 = CheckInitialized v5 name="value"
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
