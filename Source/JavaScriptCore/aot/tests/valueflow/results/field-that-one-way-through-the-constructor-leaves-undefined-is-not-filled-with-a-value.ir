# function Item(fill) { this.always = 1; this.sometimes = undefined; this.never = null; if (fill) this.sometimes = 2 }    publish(new Item(more))
# Every way through the constructor stores all three names, so each is filled at birth. One test of the cell may answer for the raw number in a slot only where every way stores
# something that may be another value than undefined and null: `always` is such a field; `sometimes` gets its number on one way only, and `never` on none
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Item" {{*}}{key="always" {{*}}occupancy=FilledWithValueAtBirth{{*}}{key="sometimes" {{*}}occupancy=FilledAtBirth{{*}}{key="never" {{*}}occupancy=FilledAtBirth
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Item" constructor=f1 fields=[{key="always" declared={type=number} flags=[IsRequired]}, {key="sometimes" declared={type=number} flags=[IsRequired]}, {key="never" declared={type=number} flags=[IsRequired]}] flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="more" [isFreeName]
    v3 = Construct v0, -, v2
    v4 = PropGet v1 key="publish" [isFreeName]
    v5 = Call v4, -, v3
    Return
}
function f1 name="Item" flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
    v2 = Integer integer=1
    PropSet v0, v2 key="always" mode=Strict
    v4 = Undefined
    PropSet v0, v4 key="sometimes" mode=Strict
    v6 = Null
    PropSet v0, v6 key="never" mode=Strict
    v8 = ToBoolean v1
    Branch v8 -> taken b1(), notTaken b2()
  b1():
    v9 = Integer integer=2
    PropSet v0, v9 key="sometimes" mode=Strict
    Jump -> next b2()
  b2():
    Return
}
