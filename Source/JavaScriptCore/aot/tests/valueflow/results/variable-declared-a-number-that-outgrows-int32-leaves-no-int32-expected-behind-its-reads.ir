# let total: number = 0;  function add(i: number) { total += i; return total & 1023 }
# The operand of `&` is expected to be an int32. The variable is a number in memory, every writer of it is seen, and a sum takes what they store beyond int32:
# a test for int32 would cost more than the operator saves and fail for good once the sum has grown, so nothing that comes of a read of the variable is expected to be one.
# RUN: valueflow-apply
# CHECK: variable g0 name="total" {{*}}declared={type=int|whole}
# CHECK-LABEL: function f1 name="add"
# CHECK-NOT: ~ i32

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="total" module=m0 declared={type=number|absent}
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=0
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Integer integer=3
    v4 = Call v2, -, v3
    Return v4
}
function f1 name="add" parameters=[{type=number}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="total"
    v3 = Add v2, v0
    PutModuleVariable v3 variable=g0
    v5 = GetModuleVariable variable=g0
    v6 = CheckInitialized v5 name="total"
    v7 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v8 = Integer integer=1023
    v9 = BitAnd v7, v8
    Return v9
}
