# interface Rule { limit: number }   let kept: any = unknown()   kept = new Made()   unknown(kept)   function readsMade(rule: Rule) { rule.limit }   readsMade(kept)   unknown({ limit } as Rule), where Made is a function of the library
# The variable holds any value and unknown code takes what it holds, so the unknown object stands for the constructed object behind it. Whether the object is still listed there hangs on when it came.
# In the code of the program it does not count as seen: the check says nothing of it.
# RUN: valueflow-apply
# CHECK-LABEL: function f2 name="readsMade"
# CHECK-NOT: cause=MayFail
# CHECK: = Check v0 expectedType=undefined|null|L0
# CHECK-NOT: cause=MayFail

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
runtimefunction id=0 function=f1
layout L0 name="Rule" fields=[{key="limit" declared={type=number} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Construct v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="unknown" [isFreeName]
    v4 = Call v3
    PutModuleVariable v4 variable=g0
    PutModuleVariable v1 variable=g0
    v7 = GetModuleVariable variable=g0
    v8 = Call v3, -, v7
    v9 = NewClosure function=f2
    v10 = GetModuleVariable variable=g0
    v11 = Call v9, -, v10
    v12 = NewObject layout=L0
    v13 = Call v3, -, v12
    Return
}
function f1 name="Made" role=Library flags=[HasThis] enclosingRuntimeFunction=0 thisType={type=anything} results=[{type=anything}] {
    Return
}
function f2 name="readsMade" module=m0 parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Check v0 expectedType=undefined|null|L0
    v2 = PropGet v1 key="limit"
    Return v2
}
