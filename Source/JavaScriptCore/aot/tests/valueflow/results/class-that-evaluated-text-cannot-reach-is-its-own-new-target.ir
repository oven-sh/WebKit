# Text that Function is given runs in the global scope, so it constructs with what it can reach. A class that no such code gets hold of is the new.target of its own constructor alone,
# and its constructor has filled the fields of every object of the layout. A class that lies in a global may be the new.target of another function
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Kept" {{*}}initialization=SetAtCreation
# CHECK: layout L1 kind=Instance name="HandedOut"
# CHECK-NOT: initialization=SetAtCreation
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Kept" constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="HandedOut" constructor=f2 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = NewClosure function=f1
    v6 = NewClass v5 layout=L0
    v7 = FinishClass v6 layout=L0
    v8 = Integer integer=1
    v9 = Construct v7, -, v8
    v10 = PropGet v9 key="a"
    v11 = NewClosure function=f2
    v12 = NewClass v11 layout=L1
    v13 = FinishClass v12 layout=L1
    PropSet v0, v13 key="handedOut" mode=Strict
    v15 = Construct v13, -, v8
    v16 = PropGet v15 key="a"
    Return
}
function f1 name="Kept" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="a" mode=Strict
    Return v3
}
function f2 name="HandedOut" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    PropSet v3, v1 key="a" mode=Strict
    Return v3
}
