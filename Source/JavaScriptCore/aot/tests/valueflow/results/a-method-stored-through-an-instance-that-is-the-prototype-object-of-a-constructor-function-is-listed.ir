# function Base() { }; function Derived() { }; Derived.prototype = new Base(); Derived.prototype.area = function () { }; new Derived().area()
# So do TypeScript's __extends and every program written before classes. The store of `area` goes through the object that Derived was born with and through the instance of Base.
# The instance is there because the program made it the prototype object of Derived, so the store is written for the prototype objects of Derived alone, and `area` is a member.
# A store that is written for the instances of the class itself lists nothing: store-written-for-the-instances-lists-no-member-of-the-prototype-object.ir.
# RUN: valueflow-apply
# CHECK: layout L1 kind=Instance name="Derived" {{*}}members=[{key="area" function=f3}] namedMembers=[{key="area" function=f3}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[] flags=[IsConstructorFunction]
layout L1 kind=Instance name="Derived" constructor=f2 fields=[] flags=[IsConstructorFunction]
variable g0 name="Base" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="Derived" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    v2 = Construct v0
    PropSet v1, v2 key="prototype" mode=Strict
    v4 = PropGet v1 key="prototype"
    v5 = NewClosure function=f3
    PropSet v4, v5 key="area" mode=Strict
    v7 = Construct v1
    v8 = PropGet v7 key="area"
    v9 = Call v8, v7 calleeKey="area"
    Return
}
function f1 name="Base" flags=[HasThis] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="Derived" flags=[HasThis] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="area" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
