# interface Span { name: string; [Symbol.dispose](): void }; function release(resource: Disposable) { .. }
# const span: Span = { name: "a", [Symbol.dispose]() {} }; (span as any).other = 2
# Where the program declares a type for the objects, a name that the type does not have gets no room: it is an extra property.
# A layout lists no member that its type has under a symbol of the language, so the absence of the key there says nothing: the key gets a field, like a symbol that the program creates
# RUN: valueflow-apply
# CHECK: layout L0 name="Span" fields=[{key="name"
# CHECK-NOT: key="other"
# CHECK: {key=@@dispose declared={type=f1} flags=[IsAddedLate
# CHECK-NOT: key="other"
# CHECK: layout L1 name="Disposable"

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Span" fields=[{key="name" declared={type=string}}] supertypes=[L1]
layout L1 name="Disposable"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    PropDefine v1, v2 key=@@dispose
    v4 = Integer integer=2
    PropSet v1, v4 key="other" mode=Strict
    v6 = PropGet v1 key=@@dispose
    Return v6
}
function f1 name="close" results=[{type=undefined}] {
    Return
}
