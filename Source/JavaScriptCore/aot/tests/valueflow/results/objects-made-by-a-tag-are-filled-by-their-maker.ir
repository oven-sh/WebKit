# interface Node { kind: number; pos: number }  interface Num extends Node { kind: 1; value: number }  interface Add extends Node { kind: 2; left: Node }
# function NodeObject(this: Node, kind: number, pos: number) { this.kind = kind; this.pos = pos }       new NodeObject(1, 7), new NodeObject(2, 8): nothing else makes a node, and nothing leaves the program.
# AllocateTaggedLayouts gives the function a copy of its body that allocates `this` itself, with the layout of the tag. The copy does to its object what the function does to `this`:
# it is the constructor of those objects, so what it stores before the object leaves its hands is set at the creation of every node, whatever its tag. No reader tests a slot or the cell
# FORM: AsRead
# RUN: pipeline ApplyFlowResults
# CHECK: layout L0 kind=Instance name="NodeObject" {{*}}{key="kind" {{*}}initialization=SetAtCreation{{*}} occupancy=AlwaysFilled {{*}}{key="pos" {{*}}initialization=SetAtCreation{{*}} occupancy=AlwaysFilled

