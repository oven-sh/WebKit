# The one store of a variable stands outside every cycle of code that runs once, and every read comes behind it: no loop that holds a read holds the store, and whoever enters such a loop has passed the store.
# Nothing of the kind holds of a variable that a loop stores, that a reader may find empty, or that a function with two callers stores. Nor of one whose reader is a closure made behind the store
# that a function entered in front of the store calls: inlined there, the read stands in a function that runs while the variable is empty
# RUN: valueflow-apply
# CHECK: variable g0 name="readByFunction" {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}
# CHECK: variable g1 name="readBesideItsStore" {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}
# CHECK: variable g2 name="storedInLoop" {{*}}flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
# CHECK: variable g3 name="readBeforeItsStore" {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation}
# CHECK: variable g4 name="storedByFunctionWithTwoCallers" {{*}}flow={writers=AllKnown storeNaming=EveryStoreNamesLocation}
# CHECK: variable g5 name="readByClosureThatAnEarlierFunctionCalls" {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="readByFunction" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="readBesideItsStore" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g2 name="storedInLoop" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g3 name="readBeforeItsStore" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g4 name="storedByFunctionWithTwoCallers" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g5 name="readByClosureThatAnEarlierFunctionCalls" module=m0 declared={type=anything|absent} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewClosure function=f2
    v2 = Call v1
    PutModuleVariable v0 variable=g0
    PutModuleVariable v0 variable=g1
    PutModuleVariable v0 variable=g3
    v6 = NewClosure function=f3
    v7 = Call v6
    v8 = Call v6
    v9 = NewClosure function=f4
    v10 = NewClosure function=f5
    v11 = Call v9, v0, v10
    PutModuleVariable v0 variable=g5
    v13 = NewClosure function=f6
    v14 = Call v9, v0, v13
    Jump -> next b1()
  b1():
    LoopHint
    PutModuleVariable v0 variable=g2
    v17 = GetModuleVariable variable=g2
    v18 = CheckInitialized v17 name="storedInLoop"
    v19 = GetModuleVariable variable=g1
    v20 = CheckInitialized v19 name="readBesideItsStore"
    v21 = NewClosure function=f1
    v22 = Call v21
    v23 = ToBoolean v22
    Branch v23 -> taken b1(), notTaken b2()
  b2():
    Return v22
}
function f1 name="reader" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="readByFunction"
    v2 = GetModuleVariable variable=g4
    v3 = CheckInitialized v2 name="storedByFunctionWithTwoCallers"
    Return v1
}
function f2 name="earlyReader" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="readBeforeItsStore"
    Return v1
}
function f3 name="storer" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    PutModuleVariable v0 variable=g4
    Return v0
}
function f4 name="callsWhatItIsGiven" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return v1
}
function f5 name="givenFirst" results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    Return v0
}
function f6 name="madeBehindTheStore" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g5
    v1 = CheckInitialized v0 name="readByClosureThatAnEarlierFunctionCalls"
    Return v1
}
