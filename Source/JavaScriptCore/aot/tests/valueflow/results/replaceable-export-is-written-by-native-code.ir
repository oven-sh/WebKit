# The test runner stores a function of its own into a replaceable export, and calls what the export held. So not every writer of the variable is known, in the module that declares it too, and the
# declared function is entered from outside. The export beside it keeps every proof
# RUN: valueflow-apply
# CHECK: variable g0 {{*}}declared={type=anything} {{*}}flags=[IsReplaceable] flow={cause=ReachesNativeCode}
# CHECK: variable g1 {{*}}declared={type=f3} {{*}}flow={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation initialization=SetAtCreation isUnchangedDuringActivation=true}
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v6 -> f3
# CALLS: f3 v2 -> unknown f2

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="math.js" displayPath="math.js" body=f1 exports=[{name="add" variable=g0}, {name="twice" variable=g1}]
entry module=m0
variable g0 name="add" module=m1 declared={type=anything} initialization=Function function=f2 flags=[IsReplaceable]
variable g1 name="twice" module=m1 declared={type=anything} initialization=Function function=f3
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = ModuleNamespace module=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="spy" [isFreeName]
    v3 = Call v2, -, v0
    v4 = GetModuleVariable variable=g1
    v5 = Integer integer=1
    v6 = Call v4, -, v5
    Return v6
}
function f1 name="math" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="add" module=m1 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    Return v2
}
function f3 name="twice" module=m1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0, v0
    Return v2
}
