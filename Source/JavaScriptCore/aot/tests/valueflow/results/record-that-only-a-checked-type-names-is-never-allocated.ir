# interface View { a: number }; function read(view: View) { return view.a }; read({ a: 1 }); somebody = new Proxy({}, {}); read(somebody() as View)
# The type lists the record of the interface and the layout of the literal. The unknown object passes the tests at the entry of `read` as the objects of both.
# No operation allocates the record and no parser is put in the place of the call, so no object has its layout.
# RUN: valueflow-apply split
# CHECK: layout L0 name="View" {{*}}allocation=NeverAllocated

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Assertion
layout L0 name="View" fields=[{key="a" declared={type=number} flags=[IsRequired]}]
layout L1 name="Empty"
layout L2 name="Literal" fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1
    v1 = NewObject layout=L1
    v2 = Builtin builtin=Proxy
    v3 = Construct v2, -, v0, v1
    v4 = Call v3, -
    v5 = Convert v4 declared={type=L0|L2 site=w1}
    v6 = NewClosure function=f1
    v7 = Call v6, -, v5
    v8 = Integer integer=1
    v9 = NewObject -, v8, v8 layout=L2 fields=[0, 1]
    v10 = Call v6, -, v9
    Return v7
}
function f1 name="read" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=L0|L2 site=w0}] results=[{type=anything}] {
  b0(v0: L0|L2):
    v1 = PropGet v0 key="a"
    Return v1
}
