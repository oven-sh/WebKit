# function probe(seen: string) { const given: any = seen; return "late" in given; }   class Seen { early = probe(this as any); late = 3; }
# The initializer hands the object on before `late` is defined. The check of the parameter admits no object, so by the types nothing that the body does is done to the object.
# The check turns the object away, and the generic version of `probe` looks at it: the field is not there yet. So `late` is not always filled.
# `Kept` hands nothing on: there the field is always filled
# FORM: AsRead
# RUN: valueflow-apply

# CHECK-NOT: name="Seen" {{*}}{key="late" {{*}}occupancy=AlwaysFilled
# CHECK: layout L1 kind=Instance name="Kept" {{*}}{key="late" {{*}}occupancy=AlwaysFilled

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
layout L0 kind=Instance name="Seen" constructor=f1 fields=[{key="early" declared={type=anything} flags=[IsRequired]}, {key="late" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Instance name="Kept" constructor=f4 fields=[{key="early" declared={type=anything} flags=[IsRequired]}, {key="late" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2, -
    v4 = PropGet v3 key="early"
    v5 = PropGet v3 key="late"
    v6 = NewClosure function=f4
    v7 = NewClass v6 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8, -
    v10 = PropGet v9 key="late"
    Return v4
}
function f1 name="Seen" kind=BaseConstructor flags=[HasNewTarget, IsChecked] results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = CallDirect v3 function=f2
    Return v3
}
function f2 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=anything}] {
    v1 = CallDirect v0 function=f3
    PropDefine v0, v1 key="early"
    v3 = Integer integer=3
    PropDefine v0, v3 key="late"
    Return v3
}
function f3 name="probe" flags=[IsChecked] length=1 parameters=[{type=string site=w0 flags=[IsExpected]}] results=[{type=anything}] {
    v1 = Check v0 expectedType=string site=w0
    v2 = PropHas v1 key="late"
    Return v2
}
function f4 name="Kept" kind=BaseConstructor flags=[HasNewTarget, IsChecked] results=[{type=object flags=[IsFromCompiler]}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    v3 = Convert v2 declared={type=L1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = CallDirect v3 function=f5
    Return v3
}
function f5 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=L1 flags=[IsFromCompiler]} results=[{type=anything}] {
    v1 = Integer integer=1
    PropDefine v0, v1 key="early"
    v3 = Integer integer=3
    PropDefine v0, v3 key="late"
    Return v3
}
