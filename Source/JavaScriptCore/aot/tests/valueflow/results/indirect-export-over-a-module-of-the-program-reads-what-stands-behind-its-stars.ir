# The run time reads an indirect export on the namespace object of the module that it names. Where that is a module of the program, what stands behind the stars of that module is read.
#   main.js: import * as all from "./second.js"; all.c   second.js: export { c } from "./index.js"   index.js: export * from "./inner.js", which the run follows   unread.js: export let c
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: variable g0
# CHECK-NOT: reads=
# CHECK: variable g1 {{*}}reads=NeverRead

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m4 completes=true}]
module m1 path="second.js" displayPath="second.js" body=f1 requests=[{target=m2 completes=true}] exports=[{name="c" kind=Indirect module=m2 importName="c"}]
module m2 path="index.js" displayPath="index.js" body=f2 requests=[{target=m3 isDynamicStarExport=true completes=true}]
module m3 path="inner.js" displayPath="inner.js" body=f3 exports=[{name="c" variable=g0}]
module m4 path="unread.js" displayPath="unread.js" body=f4 exports=[{name="c" variable=g1}]
entry module=m0
variable g0 name="c" module=m3 declared={type=anything}
variable g1 name="c" module=m4 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="c"
    Return
}
function f1 name="body1" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="body2" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="body3" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f4 name="body4" module=m4 kind=Module results=[{type=anything}] {
  b0():
    Return
}
