# first.js: import "./inner.js"        inner.js: input(); export var limit = 10        second.js: import { limit } from "./inner.js"; limit        built with two entry points, first.js and second.js
# No text is evaluated: second.js runs when inner.js has run to its end, and reads 10.
# evaluated-text-loads-a-second-entry-point-that-reads-a-var.ir is the same program with a text
# RUN: valueflow-apply
# CHECK-LABEL: function f2 name="second"
# CHECK: [[read]]: 10 = GetModuleVariable variable=g0

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" body=f2 requests=[{target=m1 completes=true}]
entry module=m0
entry module=m2
variable g0 name="limit" module=m1 declared={type=anything} initialization=Undefined
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=10
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="use" [isFreeName]
    Return
}
