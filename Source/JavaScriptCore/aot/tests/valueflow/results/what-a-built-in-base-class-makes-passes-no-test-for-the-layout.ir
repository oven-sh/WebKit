# class Registry extends Map {}  class Plain {}  function look(x: Registry | Plain) {}  function only(x: Plain) {}  look(new Registry()); look(new Plain()); only(new Plain())
# What `super()` of a class that extends a built-in class makes is a cell of the built-in class. It is filed under the layout of the class, and the test for that layout, which looks at the shape, turns it away.
# So a check against the layout stays a check, behind `super()` and at the head of a function that such an instance reaches.
# Beside it: a check that only objects allocated with the layout reach tests nothing
# RUN: valueflow-apply
# CHECK-LABEL: function f1 name="Registry"
# CHECK: = SuperConstruct
# CHECK-NEXT: : L0 = Check v3 castType=L0
# CHECK-LABEL: function f3 name="look"
# CHECK: : L0|L1 = Check {{*}} castType=L0|L1
# CHECK-LABEL: function f4 name="only"
# CHECK-NOT: = Check
# CHECK: : L1 = AssumeType {{*}} castType=L1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Instance name="Registry" constructor=f1 flags=[HasHeritage]
layout L1 kind=Instance name="Plain" constructor=f2
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Map
    v1 = ResolveHeritage v0
    v2 = NewClosure function=f1
    v3 = NewClass v2, v0, v1 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = NewClosure function=f2
    v6 = NewClass v5 layout=L1
    v7 = FinishClass v6 layout=L1
    v8 = Construct v4
    v9 = Construct v7
    v10 = NewClosure function=f3
    v11 = Call v10, -, v8
    v12 = Call v10, -, v9
    v13 = NewClosure function=f4
    v14 = Call v13, -, v9
    Return
}
function f1 name="Registry" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = Check v3 castType=L0
    Return v4
}
function f2 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="look" parameters=[{type=L0|L1 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Check v0 castType=L0|L1
    Return v1
}
function f4 name="only" parameters=[{type=L1 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Check v0 castType=L1
    Return v1
}
