# a = first(): watch(a)(): function watch(value) { new WeakRef(value); return value }     a closure of `inner1` is the target of a WeakRef, which it reaches through a parameter:
#                                                                                         `deref() === undefined` tells whether THIS closure is still there
# b = second(): registry.register(b, 1)                                                   a closure of `inner2` is watched by a FinalizationRegistry
# c = third(): registry.register({}, 1, c)                                                a closure of `inner3` is the token
# d = fourth(): d()                                                                       a closure of `inner4` is called, and that is all
# RUN: valueflow-results
# CHECK: closures-compared f1
# CHECK: closures-compared f2
# CHECK: closures-compared f3
# CHECK-NOT: closures-compared f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f5
    v2 = Call v1, -, v0
    v3 = Call v2, -
    v4 = NewClosure function=f6
    v5 = Builtin builtin=FinalizationRegistry
    v6 = Construct v5, -, v4
    v7 = NewClosure function=f2
    v8 = PropGet v6 key="register"
    v9 = Integer integer=1
    v10 = Call v8, v6, v7, v9 calleeKey="register"
    v11 = NewClosure function=f3
    v12 = NewObject
    v13 = Call v8, v6, v12, v9, v11 calleeKey="register"
    v14 = NewClosure function=f4
    v15 = Call v14, -
    v16 = Call v7, -
    v17 = Call v11, -
    Return
}
# REPEAT: i = 1..4
function f%(i) name="inner%(i)" kind=Arrow results=[{type=anything}] {
    Return
}
# END REPEAT
function f5 name="watch" kind=Plain parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=WeakRef
    v2 = Construct v1, -, v0
    Return v0
}
function f6 name="cleanup" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
