    v8 = NewClosure function=f2
    PropDefine v7, v8 key="get"
    v10 = NewClosure function=f3
    PropDefine v7, v10 key="set"
    v12 = FinishObject v7
    PropDefine v6, v12 key="id"
    v14 = Builtin builtin=Object
    v15 = Builtin builtin=ObjectCreate
    v16 = Call v15, v14, v5, v6
    v17 = NewObject layout=L3
    v18 = FinishObject v17
