# function Type() {}    table.above = Object.create(target, { id: { get, set } }); table.above = plain    Object.setPrototypeOf(Type.prototype, table.above)
# const made = new Type(); made.id = 1; publish(made)
# A link that may hold one of several objects says of none of them that the program puts it there. In a large program such a link holds hundreds: one helper that hangs `superCtor.prototype` above
# `ctor.prototype` for callers that nobody knows ties every prototype object to every other, and one accessor anywhere would take its name from every layout. Only a link that holds one object counts:
# `id` gets its field in Type. The field is right whatever hangs above an instance, since a store that creates it and a read that finds it empty test that the object inherits nothing under the name.
# An accessor that the program itself defines on the prototype object of the class does take the name: a store to `id` of a State runs the setter, and State gets no field.
# So does one on the only object that the program hangs above that prototype object: Below gets no field either
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Type" constructor=f1 fields=[{key="id" {{*}}flags=[IsAddedLate
# CHECK: layout L2 kind=Instance name="State" constructor=f4
# CHECK-NOT: fields=[{key="id"
# CHECK: layout L3
# CHECK: layout L4 kind=Instance name="Below" constructor=f5
# CHECK-NOT: fields=[{key="id"
# CHECK: layout L5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Type" constructor=f1 flags=[IsConstructorFunction]
layout L1 name="PropertyDescriptor" fields=[{key="get" declared={type=anything}}, {key="set" declared={type=anything}}]
layout L2 kind=Instance name="State" constructor=f4 flags=[IsConstructorFunction]
layout L3 name="Target" fields=[{key="text" declared={type=anything}}]
layout L4 kind=Instance name="Below" constructor=f5 flags=[IsConstructorFunction]
layout L5 name="Table" fields=[{key="above" declared={type=anything}}]
