    v20 = FinishObject v19
    PropSet v20, v16 key="above" mode=Strict
    PropSet v20, v18 key="above" mode=Strict
    v23 = PropGet v20 key="above"
    v24 = PropGet v3 key="prototype"
    v25 = Builtin builtin=ObjectSetPrototypeOf
    v26 = Call v25, v14, v24, v23
    v27 = Construct v3
    PropSet v27, v2 key="id" mode=Strict
    v29 = Call v1, -, v27
    v30 = NewClosure function=f4
    v31 = PropGet v30 key="prototype"
    v32 = NewDictionary
    v33 = NewObject layout=L1
    v34 = NewClosure function=f2
    PropDefine v33, v34 key="get"
    v36 = NewClosure function=f3
    PropDefine v33, v36 key="set"
    v38 = FinishObject v33
    PropDefine v32, v38 key="id"
    v40 = Builtin builtin=ObjectDefineProperties
    v41 = Call v40, v14, v31, v32
    v42 = Construct v30
    PropSet v42, v2 key="id" mode=Strict
    v44 = Call v1, -, v42
    v45 = NewClosure function=f5
    v46 = PropGet v45 key="prototype"
    v47 = Call v25, v14, v46, v16
    v48 = Construct v45
    PropSet v48, v2 key="id" mode=Strict
    v50 = Call v1, -, v48
    Return
}
