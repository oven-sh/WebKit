# An escaped built-in can be called with any operands, so the features of all its overloads are used
# RUN: valueflow-results
# CHECK: feature 7 StringPrototypeSplit
# CHECK: feature 53 StringPrototypeSplit

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="a,b"
    v1 = PropGet v0 key="split"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="callLater" [isFreeName]
    v4 = Call v3, -, v1
    Return
}
