# first.js: import "./inner.js"   inner.js: new Function(input)(); export let value = 1   second.cjs: require("./inner.js").value   built with two entry points, first.js and second.cjs
# The text in inner.js begins second.cjs while inner.js runs. Its require() finds inner.js begun, and the read comes before the store.
# two-entry-points-one-a-commonjs-file-without-evaluated-text.ir has no text
# RUN: valueflow-apply
# CHECK: variable g0 name="value"
# CHECK-NOT: initialization=StoredBeforeEveryRead
# CHECK: module m0
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.cjs" displayPath="second.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f2 exportsVariable=g1 requests=[{target=m1 kind=Require completes=true}]
entry module=m0
entry module=m2
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="exports" module=m2 declared={type=anything} initialization=Undefined
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = Integer integer=1
    PutModuleVariable v5 variable=g0
    Return
}
function f2 name="second" module=m2 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = NewDictionary
    PutModuleVariable v0 variable=g1
    EvaluateModule module=m1 referrer=m2 [isBare]
    v3 = GetModuleVariable variable=g0
    v4 = CheckInitialized v3 name="value"
    Return
}
