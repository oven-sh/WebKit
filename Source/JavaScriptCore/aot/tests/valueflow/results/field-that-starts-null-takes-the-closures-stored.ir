# A field of a literal in code without types starts as null and every store of a function into it is known: the field holds what is stored, and the reads and stores go to its slot
# FORM: AsRead
# RUN: pipeline ApplyFlowResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="run" declared={type=null flags=[IsExpected]} flags=[IsRequired]}]
# CHECK: layout L0 {{*}}key="run" declared={type=null|f1|f2}

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Null
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    PropSet v1, v2 key="run"
    v4 = PropGet v1 key="run"
    v5 = Call v4, v1
    v6 = NewClosure function=f2
    PropSet v1, v6 key="run"
    v8 = PropGet v1 key="run"
    v9 = Call v8, v1
    Return v9
}

function f1 name="first" parameters=[] results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}

function f2 name="second" parameters=[] results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
