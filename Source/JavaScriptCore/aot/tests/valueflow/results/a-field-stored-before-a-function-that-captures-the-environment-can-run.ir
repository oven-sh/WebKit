# Both fields are stored before every read. The first is stored before any function that captures the environment can run. The second is stored behind the first call of a function that captures the environment and
# does not read it: whoever is entered with the environment may find it not stored yet
# RUN: valueflow-apply
# CHECK: layout L0 {{*}}{key="early" {{*}}initialization=StoredBeforeEveryRead isStoredBeforeCapturersRun=true}{{*}}{key="late" {{*}}initialization=StoredBeforeEveryRead}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment module=m0 fields=[{key="early" declared={type=anything|absent}}, {key="late" declared={type=anything|absent}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = CallDirect v0 function=f1
    v2 = CallDirect v0 function=f1
    v3 = Add v1, v2
    Return v3
}
function f1 name="owner" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject layout=L0
    PutEnvironmentField v1, v0 layout=L0
    v3 = NewClosure v1 function=f2
    v4 = Call v3
    PutEnvironmentField v1, v4 layout=L0 field=1
    v6 = NewClosure v1 function=f3
    v7 = Call v6
    Return v7
}
function f2 name="readsEarly" captures=[{type=env L0 flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0
    Return v1
}
function f3 name="readsBoth" captures=[{type=env L0 flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0
    v2 = GetEnvironmentField v0 layout=L0 field=1
    v3 = Add v1, v2
    Return v3
}
