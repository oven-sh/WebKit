# var Base; function init() { Base = class Base { a = 1 } }  init(); class Derived extends Base { b = 2 }  o = new Derived(); o.a; o.b
# Until init() has run the variable holds undefined, and a class that extends undefined is never made: its definition throws. So Base is the heritage of Derived whatever happens,
# the image puts Derived below Base, and what the constructor of Base allocates under the prototype object of Derived is an instance of Derived and nothing else.
# RUN: valueflow-apply
# CHECK-LABEL: function f0
# CHECK: [[made]]: L1 = AssumeType v7
# CHECK: PropGet [[made]] key="a" {{*}} receivers=[L1]
# CHECK: PropGet [[made]] key="b" {{*}} receivers=[L1]
# CHECK: function f2 {{*}} results=[{type=L1}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f2 fields=[{key="a" declared={type=number flags=[IsExpected]} flags=[IsRequired]}]
layout L1 kind=Instance name="Derived" constructor=f3 fields=[{key="b" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] flags=[HasHeritage]
variable g0 name="Base" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = GetModuleVariable variable=g0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f3
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    v8 = PropGet v7 key="a"
    v9 = PropGet v7 key="b"
    Return
}
function f1 name="init" module=m0 results=[{type=anything}] {
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    PutModuleVariable v2 variable=g0
    Return
}
function f2 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropDefine v2, v3 key="a"
    Return v2
}
function f3 name="Derived" module=m0 kind=DerivedConstructor flags=[HasRestParameter, HasNewTarget, TakesCallee] parameters=[{type=Array}] results=[{type=object}] {
    v3 = GetSuperBase v0
    v4 = SuperConstructList v3, v1, v2 layout=L1
    v5 = Integer integer=2
    PropDefine v4, v5 key="b"
    Return v4
}
