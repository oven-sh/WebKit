# CHECK: parameters=[{type=L0|L1|L2|L3 flags=[IsExpected]}]
# CHECK: b0(v0: anything ~ L0|L1|L2|L3):
# CHECK: = PropGet v0 key="side" accessSite={{*}} receivers=[L1, L2, L3, ..]
function f4 name="takeTwo" parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="side"
    Return v1
}
