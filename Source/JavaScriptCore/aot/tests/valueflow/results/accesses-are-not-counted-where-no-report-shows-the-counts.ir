# function startOf(v) { return v.start }
# Nobody reads the counts of accesses in a build that asks for no report of them, so no access site is observed or graded.
# RUN: flow-report through=Select
# CHECK-NOT: access-count
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="startOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="start" @110
    Return v1
}
