# class Base {} class Once extends Base { #x = 1 } function mix(parent) { return class Again extends parent { #x = 1 } } function make() { return class Alone { #x = 1 } }
# new Once(); new (mix(mix(Base)))(); new (make())(); new (make())()
# Each evaluation of a class makes its own private names, and the field of the layout holds the name of one evaluation. An object on which a second evaluation defines its name gets a property.
# A class without a parent defines its names only on the objects that it makes
# RUN: valueflow-results
# CHECK: class C{{*}} layout=L1 impossibleMutations=[{{*}}RedefineProperty, AddProperty, ChangeIntegrity{{*}}]
# CHECK-NEXT: class C{{*}} layout=L2 impossibleMutations=[{{*}}RedefineProperty, ChangeIntegrity{{*}}] {{*}}addedKeys=[#"x"@L2] addedKeysAreComplete=true
# CHECK-NEXT: class C{{*}} layout=L3 impossibleMutations=[{{*}}RedefineProperty, AddProperty, ChangeIntegrity{{*}}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1
layout L1 kind=Instance name="Once" base=L0 constructor=f2 fields=[{key=#"x"@L1 declared={type=number} flags=[IsRequired, IsPrivate]}] flags=[HasHeritage]
layout L2 kind=Instance name="Again" constructor=f4 fields=[{key=#"x"@L2 declared={type=number} flags=[IsRequired, IsPrivate]}] flags=[HasHeritage]
layout L3 kind=Instance name="Alone" constructor=f6 fields=[{key=#"x"@L3 declared={type=number} flags=[IsRequired, IsPrivate]}]
variable g0 name="tokenOfOnce" module=m0 declared={type=classtoken flags=[IsFromCompiler]} initialization=Undefined
variable g1 name="tokenOfAgain" module=m0 declared={type=classtoken flags=[IsFromCompiler]} initialization=Undefined
variable g2 name="tokenOfAlone" module=m0 declared={type=classtoken flags=[IsFromCompiler]} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClassToken layout=L1
    PutModuleVariable v3 variable=g0
    v5 = ResolveHeritage v2
    v6 = NewClosure function=f2
    v7 = NewClass v6, v2, v5 layout=L1
    v8 = FinishClass v7 layout=L1
    v9 = Construct v8
    v10 = CallDirect v2 function=f8
    v11 = CallDirect v10 function=f8
    v12 = Construct v11
    v13 = CallDirect function=f9
    v14 = Construct v13
    v15 = CallDirect function=f9
    v16 = Construct v15
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="Once" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = CallDirect v3 function=f3
    Return v3
}
function f3 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = GetModuleVariable variable=g0
    PrivateDefine v0, v2, v1 layout=L1 field=0
    Return v1
}
function f4 name="Again" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    v4 = CallDirect v3 function=f5
    Return v3
}
function f5 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = GetModuleVariable variable=g1
    PrivateDefine v0, v2, v1 layout=L2 field=0
    Return v1
}
function f6 name="Alone" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3 fields=[]
    v3 = CallDirect v2 function=f7
    Return v2
}
function f7 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = GetModuleVariable variable=g2
    PrivateDefine v0, v2, v1 layout=L3 field=0
    Return v1
}
function f8 name="mix" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClassToken layout=L2
    PutModuleVariable v1 variable=g1
    v3 = ResolveHeritage v0
    v4 = NewClosure function=f4
    v5 = NewClass v4, v0, v3 layout=L2
    v6 = FinishClass v5 layout=L2
    Return v6
}
function f9 name="make" results=[{type=anything}] {
    v0 = NewClassToken layout=L3
    PutModuleVariable v0 variable=g2
    v2 = NewClosure function=f6
    v3 = NewClass v2 layout=L3
    v4 = FinishClass v3 layout=L3
    Return v4
}
