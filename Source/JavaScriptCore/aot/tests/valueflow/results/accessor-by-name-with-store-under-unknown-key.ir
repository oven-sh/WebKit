# function Duplex() {}; const key = Object.keys(source)[0]; Duplex.prototype[key] = source[key]; Object.defineProperties(Duplex.prototype, { ended: { get, set }, size: { get } }); new Duplex().ended
# The store under a key that nobody knows arrives under every name that somebody asks for, so nobody can say what `ended` holds: the name is listed without a function.
# What the program defines under the name is one getter and one setter. They are listed among the members as they were defined: a read of the name tests the bit of the class,
# which the run time sets where the prototype object holds that accessor.
# Where the list of keys is empty the key is `undefined`, and what the source holds under that name is nothing: no function is stored there.
# RUN: valueflow-apply
