# `(table as Other)[key]`: the layout of the table is none of the asserted type, so the test of the assertion never passes and what is read behind it has the type `never`. The conversion of that value to
# the type of the field is dropped: `never` lies inside every type. Code behind a test that never passes stays, for the generic version, and once flow's results are applied the read answers anything.
# Nothing stands between it and the allocation then, and flow does not answer for what the allocation writes: what arrives is unknown. So the value is tested in front of the allocation.
# The field keeps its type and its slot: the generic version stores what the test turns away behind the allocation, by a store that tests it, which flow leaves room for (no `stores=AtMostOnce`).
# FORM: AsRead
# RUN: pipeline ApplyFlowResults
# CHECK: layout L2 name="Made" fields=[{key="flag" declared={type=boolean} flags=[IsRequired, IsEnforced] flow={location={writers=AllKnown storeNaming=
# CHECK-LABEL: function f1 name="make"
# CHECK: [[read]]: anything = ElemGet
# CHECK-NEXT: [[tested]]: undefined|null|boolean = Check [[read]] castType=undefined|null|boolean cause=AddedByPass
# CHECK-NEXT: = NewObject -, [[tested]] layout=L2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Table" fields=[{key="first" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Other" fields=[{key="second" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Made" fields=[{key="flag" declared={type=boolean} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = String string="first"
    v5 = CallDirect v3, v4 function=f1
    v6 = PropGet v5 key="flag"
    Return v6
}
function f1 name="make" parameters=[{type=undefined|null|L0}, {type=string}] results=[{type=anything}] {
    v2 = Convert v0 declared={type=undefined|null|L1} illTypedCause=Assertion
    v3 = ElemGet v2, v1
    v4 = Convert v3 declared={type=boolean}
    v5 = NewObject -, v4 layout=L2 fields=[0]
    v6 = FinishObject v5
    Return v6
}
