# OPTIONS: admit=FilesRunByHost
# first.js: import "./inner.js"; import "./second.js"        inner.js: input(); export let value = 1        second.js: import { value } from "./inner.js"; value        one entry point, first.js. second.js is marked MayBeEvicted
# The host runs files that the build has not seen, and a copy of second.js from disk may run in its place. The run time lets such a file name second.js as well: second.js begins while inner.js runs.
# a-file-that-the-host-runs-loads-a-file-that-a-name-finds.ir has a file that a name finds
# RUN: valueflow-apply
# CHECK: variable g0 name="value"
# CHECK-NOT: initialization=StoredBeforeEveryRead
# CHECK: module m0

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" flags=[MayBeEvicted] body=f2 requests=[{target=m1 completes=true}]
entry module=m0
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
