# Object.defineProperties(State.prototype, { [computed]: { get }, flowing: { get, set }, ended: { get } })
# The map is an object literal that goes nowhere but into the call. One computed name in it hides no written name: `flowing` and `ended` are names of the prototype, so nobody takes a read of one
# of them on an instance for a read of a name that is not there. Which function answers is not said: what stands under the computed name may be defined under any name, a written one too.
# And the names of the prototype are not complete.
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="State"{{*}} namedMembers=[{key="flowing"}, {key="ended"}]
# CHECK-NOT: prototypeNamesAreComplete
# CHECK: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="State" constructor=f1 flags=[IsConstructorFunction]
layout L1 name="PropertyDescriptor" fields=[{key="get" declared={type=anything}}, {key="set" declared={type=anything}}, {key="value" declared={type=anything}}]
