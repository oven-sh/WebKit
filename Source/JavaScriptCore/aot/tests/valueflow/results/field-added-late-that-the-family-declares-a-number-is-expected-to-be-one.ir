# function mark(o: Markable, n: number) { o.marked = n }   function isMarked(o: Made) { return o.marked }   a literal is Markable, and unknown code has it, with both functions.
# Made gets a field for the name. Unknown code may store anything there, so nothing is proven of it, and the type that the family declares is a number of which nobody knows that it is an int32.
# An unboxed double is as wide as a boxed value, and a boxed slot keeps an int32 an int32, so the slot takes every value. Who reads it expects the number that the family declares:
# a test in front of an addition or a concatenation then says that no object is there whose valueOf would run
# RUN: valueflow-apply
# CHECK: layout L0 name="Made" {{*}}{key="marked" declared={type=number flags=[IsExpected]} flags=[IsAddedLate]
# CHECK-LABEL: function f2 name="isMarked"
# CHECK: anything ~ undefined|number = PropGet v1 key="marked"

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Made" fields=[{key="flags" declared={type=number}}] supertypes=[L1]
layout L1 name="Markable" fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="marked" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    v6 = Call v5, -, v1, v2, v3
    Return
}
function f1 name="mark" parameters=[{type=L0|L1 flags=[IsExpected]}, {type=number flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Check v0 castType=L0|L1
    v3 = Check v1 castType=number
    PropSet v2, v3 key="marked" mode=Strict
    Return
}
function f2 name="isMarked" parameters=[{type=L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Check v0 castType=L0
    v2 = PropGet v1 key="marked"
    Return v2
}
