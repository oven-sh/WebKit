# publish(Handed); const callee = flag ? unknown : other ? Handed : Kept; new callee(); callee()
# A callee that may be anything. The unknown object stands for `Handed`, which has escaped.
# The construction keeps it in the list that is not complete: whoever allocates for the constructor and tests it at run time finds there which one to expect.
# It has come by a way that passes through nothing made for the unknown object. The call of the same value leaves it out.
# The same program where one is many: callee-list-of-a-construction-leaves-out-the-many-that-have-escaped.ir
# RUN: valueflow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: = Construct v10 {{*}}callees=[f1, f2, ..]
# CHECK: = Call v10 {{*}}callees=[f2, ..]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v0 calleeName="publish"
    v5 = PropGet v2 key="unknown" [isFreeName]
    v6 = PropGet v2 key="flag" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b5(v5)
  b2():
    v8 = PropGet v2 key="other" [isFreeName]
    v9 = ToBoolean v8
    Branch v9 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b5(v0)
  b4():
    Jump -> next b5(v1)
  b5(v10):
    v11 = Construct v10
    v12 = Call v10
    Return
}
function f1 name="Handed" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f2 name="Kept" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
