# function merge(o) { return { a: 2.5, b: "x", ...o } }  merge(undefined).a; merge({ a: 1.5 }).b
# RUN: valueflow-apply
# CHECK: layout L0 name="Merged" fields=[{key="a"{{*}}location={writers=AllKnown{{*}}initialization=SetAtCreation{{*}}{key="b"{{*}}location={writers=AllKnown stores=AtMostOnce{{*}}initialization=SetAtCreation{{*}}occupancy=AlwaysFilled{{*}}addedKeysAreComplete=true

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Merged" fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Source" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Undefined
    v2 = Double number=1.5
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = Call v0, -, v1
    v5 = Call v0, -, v3
    v6 = PropGet v4 key="a"
    v7 = PropGet v5 key="b"
    Return
}
function f1 name="merge" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = Double number=2.5
    v2 = String string="x"
    v3 = NewObject -, v1, v2 layout=L0 fields=[0, 1]
    CopyDataProperties v3, v0
    v5 = FinishObject v3
    Return v5
}
