# (1.5).toLocaleString("de")
# Under a report the record of a feature has the place where the program names the built-in.
# RUN: valueflow-results
# OPTIONS: report=Flow
# CHECK: feature 10 NumberPrototypeToLocaleString f0:v0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=NumberPrototypeToLocaleString
    v1 = Double number=1.5
    v2 = String string="de"
    v3 = Call v0, v1, v2
    Return v3
}
