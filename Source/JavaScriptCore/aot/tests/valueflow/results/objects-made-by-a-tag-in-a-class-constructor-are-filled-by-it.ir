# interface Node { kind: number; pos: number }  interface Num extends Node { kind: 1; value: number }  interface Add extends Node { kind: 2; left: Node }
# class NodeObject implements Node { constructor(kind: number, pos: number) { this.kind = kind; this.pos = pos } }       new NodeObject(1, 7), new NodeObject(2, 8)
# The constructor of a base class allocates its own `this`. AllocateTaggedLayouts puts a switch on the tag where the allocation stood: one allocation for each tag, which meet in one value.
# Whichever of them has run, that value is the object under construction, so a store to it is a store to that object
