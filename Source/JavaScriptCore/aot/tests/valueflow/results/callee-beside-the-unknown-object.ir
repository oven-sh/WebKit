# A callee that may be a closure or whatever a property of the global object holds: the stamp lists the closure and stays open, and nothing is assumed about the callee.
# The loss names where the unknown object comes from: a property of a host object that the table does not declare
# RUN: valueflow-apply
# CHECK-LABEL: function f0 name="main"
# CHECK: = Call {{*}} callees=[f1, ..]
# CHECK-NOT: AssumeType
# RUN(RESULTS): valueflow-results
# RESULTS: access S{{*}} function=f0 kind=Call loss cause=UndescribedNativeResult witness=f0:v5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="handler" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    v3 = NewClosure function=f1
    Jump -> next b3(v3)
  b3(v4):
    v5 = Call v4
    Return
}
function f1 name="fallback" results=[{type=anything}] {
    v0 = Integer integer=1
    Return v0
}
