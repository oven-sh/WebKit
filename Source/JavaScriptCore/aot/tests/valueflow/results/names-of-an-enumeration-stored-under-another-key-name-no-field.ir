# for (const name in defaults) options[other] = defaults[name]
# The key of the store is not the name that the enumeration has handed out, so nothing is known of it and the object stays without fields.
# RUN: valueflow-apply
# CHECK-NOT: IsAddedLate

layout L0 fields=[{key="locations" declared={type=anything} flags=[IsRequired]}, {key="ranges" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Boolean
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = NewObject layout=L1
    v4 = FinishObject v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="other" [isFreeName]
    v7 = ForInOpen v2
    Jump -> next b1()
  b1():
    LoopHint
    v9 = ForInStep v7, v2
    v10 = ResultAt v9
    v11 = ResultAt v9 index=1
    Branch v10 -> taken b3(), notTaken b2()
  b2():
    v12 = ElemGet v2, v11
    ElemSet v4, v6, v12
    Jump -> next b1()
  b3():
    v14 = PropGet v5 key="hand" [isFreeName]
    v15 = Call v14, -, v4
    v16 = PropGet v4 key="locations"
    Return v16
}
