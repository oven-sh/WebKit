# interface Rule { limit: number }   function Made(this: any) {}   const made = new (Made as any)()   unknown(made)
# function readsMade(rule: Rule) { rule.limit }   readsMade(made); readsMade(unknown())
# Unknown code holds the constructed object, so the unknown object that arrives beside it stands for it as well. It stays listed among what arrives: the check says that it may fail.
# RUN: valueflow-apply
# CHECK-LABEL: function f2 name="readsMade"
# CHECK: = Check v0 castType=undefined|null|L0 cause=MayFail

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Rule" fields=[{key="limit" declared={type=number} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Construct v0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="unknown" [isFreeName]
    v4 = Call v3, -, v1
    v5 = Call v3
    v6 = NewClosure function=f2
    v7 = Call v6, -, v1
    v8 = Call v6, -, v5
    Return
}
function f1 name="Made" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f2 name="readsMade" module=m0 parameters=[{type=undefined|null|L0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Check v0 castType=undefined|null|L0
    v2 = PropGet v1 key="limit"
    Return v2
}
