# A member of a built-in object that nothing writes is the callee: the set lists the built-in and is complete, the callee has its type, the location is constant, and the uses are recorded
# RUN: valueflow-apply
# CHECK: = Call {{*}} callees=[builtin(MathFloor)]
# RUN(RESULTS): valueflow-results
# RESULTS: builtin-location Math."floor" Constant
# RESULTS: builtin-use MathFloor [Read, Called]
# RESULTS-NOT: unseen-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Math
    v1 = PropGet v0 key="floor"
    v2 = Double number=1.5
    v3 = Call v1, v0, v2
    Return
}
