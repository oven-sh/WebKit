# first.js: import "./inner.js"        inner.js: new Function(input)(); export let value = 1        second.js: import { value } from "./inner.js"; value        built with two entry points, first.js and second.js
# first.js has no code of its own. It still begins inner.js, whose text begins second.js while inner.js runs: an entry point that loads a file counts as one that runs
# RUN: valueflow-apply
# CHECK: variable g0 name="value"
# CHECK-NOT: initialization=StoredBeforeEveryRead
# CHECK: module m0
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="first.js" displayPath="first.js" requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f0
module m2 path="second.js" displayPath="second.js" body=f1 requests=[{target=m1 completes=true}]
entry module=m0
entry module=m2
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = Integer integer=1
    PutModuleVariable v5 variable=g0
    Return
}
function f1 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
