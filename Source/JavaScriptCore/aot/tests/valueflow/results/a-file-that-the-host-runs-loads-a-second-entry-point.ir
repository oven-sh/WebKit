# OPTIONS: admit=FilesRunByHost
# first.js: import "./inner.js"        inner.js: input(); export let value = 1        second.js: import { value } from "./inner.js"; value        built with two entry points, first.js and second.js
# No text is evaluated. The host runs files that the build has not seen, and such a file names an entry point as evaluated text does: it begins second.js while inner.js runs.
# two-entry-points-without-evaluated-text.ir is the same program without such files
# RUN: valueflow-apply
# CHECK: variable g0 name="value"
# CHECK-NOT: initialization=StoredBeforeEveryRead
# CHECK: module m0

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" body=f2 requests=[{target=m1 completes=true}]
entry module=m0
entry module=m2
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
