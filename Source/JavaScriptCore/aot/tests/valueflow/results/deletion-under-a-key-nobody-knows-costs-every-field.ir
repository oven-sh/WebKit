# entry = { cache: 1, kept: 1 }; entry.kept; entry.cache; delete entry[someName]
# deletion-that-names-its-key-costs-that-field-alone.ir with a key nobody knows: either field may be the one that is deleted.
# RUN: valueflow-apply
# CHECK: layout L0 name="Entry"
# CHECK-NOT: IsNeverDeleted
# CHECK: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Entry" fields=[{key="cache" declared={type=anything} flags=[IsRequired]}, {key="kept" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = PropGet v1 key="kept"
    v3 = PropGet v1 key="cache"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="someName" [isFreeName]
    v6 = ElemDelete v1, v5
    Return
}
