# function Readable() {}; const other = publish(Readable); other[other.key] = 1; Object.defineProperties(Readable.prototype, { ended: { get, set }, size: { get } })
# The function has escaped, and a store under a key that nobody knows to an object that nobody knows may have replaced its `prototype`: what the read of `Readable.prototype` answers holds the unknown object,
# which stands for every object that has escaped, the prototype object among them. The call names the property of the function itself, so the object that the function was born with is one of the receivers
# whichever of the two comes to stand there first, and the accessors are listed under their names. Their guards ask the object.
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Readable" {{*}}members=[{key="ended" kind=Getter function=f2}, {key="ended" kind=Setter function=f3}, {key="size" kind=Getter function=f4}]

