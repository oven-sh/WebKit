# const locale = "ja"; function show(n) { return n.toLocaleString(locale) }
# The constant has one store, which stands in the body of its module.
# RUN: valueflow-results
# CHECK: locale Constant "ja"
# CHECK-NOT: locale Unknown

variable g0 name="locale" module=m0 declared={type=string} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = String string="ja"
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Double number=1.5
    v4 = Call v2, -, v3
    Return v4
}
function f1 name="show" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Builtin builtin=NumberPrototypeToLocaleString
    v2 = GetModuleVariable variable=g0
    v3 = CheckInitialized v2 name="locale"
    v4 = Call v1, v0, v3
    Return v4
}
