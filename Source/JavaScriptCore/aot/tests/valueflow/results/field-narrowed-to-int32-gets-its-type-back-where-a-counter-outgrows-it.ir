# type Counted = { count: number };   for (let k = 0; k < input; k++) kept[0] = { count: k };
# type Sized = { size: number };      kept[0] = { size: input | 0 };
# type Summed = { total: number };    const sum = { total: 0 };   kept[0] = sum;   sum.total += input | 0;
# type Placed = { at: number };       for (..) { const placed = { at: k };   kept[0] = placed;   kept[placed.at]; }
# Every store that the program shows puts an int32 into each of the four fields, so NarrowFieldTypes keeps them as integers and tests the stores.
# Flow knows every writer. Nothing bounds k, so Counted.count gets the type back that it had, as far as flow proves it: no store is tested and no read is.
# Sized.size is stored nothing but int32s: it stays one. Summed.total is added to and Placed.at is an index: they stay integers, since no fraction is stored into them.
# FORM: AsRead
# RUN: valueflow-apply

# CHECK: layout L0 name="Counted" {{*}}{key="count" declared={type=int|whole} flags=[IsRequired, IsEnforced] {{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
# CHECK: layout L1 name="Sized" {{*}}{key="size" declared={type=i32} flags=[IsRequired, IsEnforced] {{*}}occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
# CHECK: layout L2 name="Summed" {{*}}{key="total" declared={type=int[-4503599627370496, 4503599627370495]} flags=[IsRequired, IsEnforced] {{*}}stability=[IsNeverDeleted, IsNeverRedefined]}}]
# CHECK: layout L3 name="Placed" {{*}}{key="at" declared={type=int[-2147483643, 2147483647]} flags=[IsRequired, IsEnforced] {{*}}stability=[IsNeverDeleted, IsNeverRedefined]}}]
# CHECK-NOT: typeBeforeNarrowing

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Counted" module=m0 fields=[{key="count" declared={type=number} flags=[IsRequired]}]
layout L1 name="Sized" module=m0 fields=[{key="size" declared={type=number} flags=[IsRequired]}]
layout L2 name="Summed" module=m0 fields=[{key="total" declared={type=number} flags=[IsRequired]}]
layout L3 name="Placed" module=m0 fields=[{key="at" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module flags=[IsChecked] results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Integer
    v3 = BitOr v1, v2
    v4 = NewArray contents=anything
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = FinishObject v5
    ElemSet v4, v2, v6
    v8 = NewObject -, v2 layout=L2 fields=[0]
    v9 = FinishObject v8
    ElemSet v4, v2, v9
    v11 = PropGet v9 key="total"
    v12 = Add v11, v3
    PropSet v9, v12 key="total" mode=Strict
    v14 = PropGet v6 key="size"
    v15 = PropGet v9 key="total"
    v16 = Convert v2 declared={type=number}
    Jump -> next b1(v16, v14)
  b1(v17: number, v18: anything):
    LoopHint
    v20 = Less v17, v1
    Branch v20 -> taken b2(), notTaken b3()
  b2():
    v21 = NewObject -, v17 layout=L0 fields=[0]
    v22 = FinishObject v21
    ElemSet v4, v2, v22
    v24 = PropGet v22 key="count"
    v25 = NewObject -, v17 layout=L3 fields=[0]
    v26 = FinishObject v25
    ElemSet v4, v2, v26
    v28 = PropGet v26 key="at"
    v29 = ElemGet v4, v28
    v30 = Increment v17
    v31 = Convert v30 declared={type=number}
    Jump -> next b1(v31, v24)
  b3():
    v32 = NewArray v18, v15 contents=anything
    Return v32
}
