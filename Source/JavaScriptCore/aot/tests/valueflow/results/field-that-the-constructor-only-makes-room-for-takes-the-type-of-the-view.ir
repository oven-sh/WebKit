# function Made(flags) { this.flags = flags; (this as any).links = undefined; (this as any).count = undefined; (this as any).other = undefined }
# interface Plain { flags: number }   interface WithLinks extends Plain { links: Links; count: number }   function fill(made: WithLinks, links: Links) { made.links = links }
# The constructor makes room for names that its own type does not have: all that it says of them is `undefined`. A narrower view of the object declares `links`, and typed code stores through that view.
# The field takes the type of the view beside what stands in for its value, and every store is tested against it: whoever reads it knows the layout, or finds undefined.
# A number stays as it was: a boxed slot keeps an int32 an int32. A name that no view declares stays as it was
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Made" {{*}}{key="links" declared={type=undefined|L3}{{*}}{key="count" declared={type=undefined flags=[IsExpected]}{{*}}{key="other" declared={type=undefined flags=[IsExpected]}

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Instance name="Made" constructor=f1 fields=[{key="flags" declared={type=number}}, {key="links" declared={type=undefined flags=[IsExpected]}}, {key="count" declared={type=undefined flags=[IsExpected]}}, {key="other" declared={type=undefined flags=[IsExpected]}}] supertypes=[L1, L2] flags=[IsConstructorFunction]
layout L1 name="Plain" fields=[{key="flags" declared={type=number}}] flags=[IsNeverAllocated]
layout L2 name="WithLinks" fields=[{key="count" declared={type=number}}, {key="flags" declared={type=number}}, {key="links" declared={type=L3}}] supertypes=[L1] flags=[IsNeverAllocated]
layout L3 name="Links" fields=[{key="id" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewClosure function=f1
    v2 = Construct v1, -, v0
    v3 = NewClosure function=f2
    v4 = NewObject -, v0 layout=L3 fields=[0]
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="publish" [isFreeName]
    v7 = Call v6, -, v1, v2, v3, v4
    Return
}
function f1 name="Made" flags=[HasThis] thisType={type=L0} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
    PropSet v0, v1 key="flags" mode=Strict
    v3 = Undefined
    PropSet v0, v3 key="links" mode=Strict
    PropSet v0, v3 key="count" mode=Strict
    PropSet v0, v3 key="other" mode=Strict
    Return
}
function f2 name="fill" parameters=[{type=L2 flags=[IsExpected]}, {type=L3 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Check v0 castType=L2
    v3 = Check v1 castType=L3
    PropSet v2, v3 key="links" mode=Strict
    Return
}
