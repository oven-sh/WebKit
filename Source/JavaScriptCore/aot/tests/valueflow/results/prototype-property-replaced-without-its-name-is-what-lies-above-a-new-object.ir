    v7 = ToString v6
    v8 = NewClosure function=f1
    ElemSet v8, v7, v4 mode=Strict
    v10 = Construct v8, -, v0
    v11 = PropGet v10 key="p"
    v12 = NewClosure function=f2
    v13 = NewObject -, v4 layout=L4 fields=[0]
    v14 = Undefined
    v15 = FinishObject v13
    v16 = Builtin builtin=Object
    v17 = Builtin builtin=ObjectAssign
    v18 = Call v17, v16, v12, v15
    v19 = Construct v12, -, v0
    v20 = PropGet v19 key="p"
    v21 = NewClosure function=f3
    v22 = Construct v21, -, v0
    v23 = PropGet v22 key="p"
    Return
}
