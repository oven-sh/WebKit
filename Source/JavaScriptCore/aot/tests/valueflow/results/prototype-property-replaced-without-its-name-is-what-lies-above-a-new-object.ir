# function ByKey(p) { this.p = p }    ByKey[key] = spy    new ByKey(1.5).p        spy = { set p(value) {} }, key is a string nobody knows
# function ByCopy(p) { this.p = p }   Object.assign(ByCopy, { prototype: spy })   new ByCopy(1.5).p
# function Plain(p) { this.p = p }    new Plain(1.5).p
# The key may be "prototype", and the copy brings that name: then spy lies above what `new` makes from then on, its setter takes the store of the constructor, and the object has no `p` of its own.
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="ByKey"
# CHECK-NOT: SetAtCreation
# CHECK-NOT: AlwaysFilled
# CHECK: layout L1 kind=Instance name="ByCopy"
# CHECK-NOT: SetAtCreation
# CHECK-NOT: AlwaysFilled
# CHECK: layout L2 kind=Instance name="Plain" {{*}}{key="p"{{*}}initialization=SetAtCreation{{*}}occupancy=AlwaysFilled

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="ByKey" constructor=f1 fields=[{key="p" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="ByCopy" constructor=f2 fields=[{key="p" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L2 kind=Instance name="Plain" constructor=f3 fields=[{key="p" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L3 name="Spy" fields=[]
layout L4 name="Source" fields=[{key="prototype" declared={type=anything} flags=[IsRequired]}]
