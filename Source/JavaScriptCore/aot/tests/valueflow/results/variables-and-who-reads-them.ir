# Only operations write a variable that no evaluated text binds and no loader fills. A declaration that is only called, or never read, says so, unless the namespace object of its module may be created:
# whoever holds that object reads every export
# RUN: valueflow-apply
# CHECK: variable g0 {{*}}flow={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=OnlyCalled isUnchangedDuringActivation=true}
# CHECK: variable g1 {{*}}flow={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation initialization=SetAtCreation reads=NeverRead isUnchangedDuringActivation=true}
# CHECK: variable g2 {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}
# CHECK: variable g3 {{*}}flow={writers=AllKnown stores=Never storeNaming=EveryStoreNamesLocation initialization=SetAtCreation isUnchangedDuringActivation=true}
# CHECK: variable g4 {{*}}flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead reads=NeverRead}
# RUN(RESULTS): valueflow-results
# RESULTS: module m0 namespaceUse=NeverCreated
# RESULTS: module m1 namespaceUse=NeverCreated
# RESULTS-NOT: module m2

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1}, {target=m2}]
module m1 path="bindings.js" displayPath="bindings.js" body=f1 exports=[{name="called" variable=g0}, {name="unread" variable=g1}, {name="value" variable=g2}]
module m2 path="namespace.js" displayPath="namespace.js" body=f2 exports=[{name="called" variable=g3}]
entry module=m0
variable g0 name="called" module=m1 declared={type=anything} initialization=Function function=f3
variable g1 name="unread" module=m1 declared={type=anything} initialization=Function function=f4
variable g2 name="value" module=m1 declared={type=anything} initialization=Undefined
variable g3 name="called" module=m2 declared={type=anything} initialization=Function function=f5
variable g4 name="storedTwice" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0
    v2 = GetModuleVariable variable=g2
    v3 = ModuleNamespace module=m2
    v4 = PropGet v3 key="called"
    v5 = Call v4, v3
    PutModuleVariable v1 variable=g4
    PutModuleVariable v5 variable=g4
    Return v2
}
function f1 name="bindings" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g2
    Return
}
function f2 name="namespace" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="called" module=m1 results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    Return v0
}
function f4 name="unread" module=m1 results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    Return v0
}
function f5 name="called" module=m2 results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    Return v0
}
