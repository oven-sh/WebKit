# class Base { constructor() { this.a = 1 } }  class Middle extends Base { constructor() { super(); this.b = 2 } }  class Top extends Middle { constructor() { super(); this.c = 3 } }  new Top().b
# class Alone extends Base { constructor() { super(); this.d = 4 } }  new Alone().d
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: layout L1 kind=Instance name="Middle" {{*}}allocation=NeverAllocated
# CHECK: layout L2 kind=Instance name="Top" {{*}}allocationClasses=[
# CHECK: layout L3 kind=Instance name="Alone" {{*}}allocationClasses=[

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Middle" base=L0 constructor=f2 fields=[{key="b" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
layout L2 kind=Instance name="Top" base=L1 constructor=f3 fields=[{key="c" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
layout L3 kind=Instance name="Alone" base=L0 constructor=f4 fields=[{key="d" declared={type=anything} flags=[IsRequired]}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = NewClosure function=f3
    v8 = ResolveHeritage v6
    v9 = NewClass v7, v6, v8 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = NewClosure function=f4
    v12 = ResolveHeritage v2
    v13 = NewClass v11, v2, v12 layout=L3
    v14 = FinishClass v13 layout=L3
    v15 = Construct v10, -
    v16 = PropGet v15 key="b"
    v17 = Construct v14, -
    v18 = PropGet v17 key="d"
    v19 = Add v16, v18
    Return v19
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="a" mode=Strict
    Return v2
}
function f2 name="Middle" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropSet v3, v4 key="b" mode=Strict
    Return v3
}
function f3 name="Top" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L2
    v4 = Integer integer=3
    PropSet v3, v4 key="c" mode=Strict
    Return v3
}
function f4 name="Alone" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L3
    v4 = Integer integer=4
    PropSet v3, v4 key="d" mode=Strict
    Return v3
}
