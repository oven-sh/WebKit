# a = { get size() { return 1 } }; b = { get size() { return 2 } }; c = { get size() { return 3 } }; publish(each of the three getters); (name ? a : b).size; (name ? a : name ? b : c).size
# A read that finds accessors enters them, and each entry is an indirect call of its site. All three getters are in hands nobody knows, so none of them is said to have known callers, whatever is listed.
# Up to as many callees as are told apart the list says what the site enters. Past that it names no closure that has escaped: whether the rule of the read was still shown such a closure when it last ran
# hangs on the order of the rounds, and a hundred entries out of one site would make a hundred functions as hot as the site.
# OPTIONS: limit=MaxValueFlowMembersToldApart:2
# RUN: valueflow-results
# CHECK: function f1 cause=ReachesNativeCode
# CHECK: function f2 cause=ReachesNativeCode
# CHECK: function f3 cause=ReachesNativeCode
# CHECK: access [[name]] function=f0 kind=Read loss cause=NonLayoutObject witness=f0:v14
# CHECK-NEXT: access [[pair]] function=f0 kind=Read
# CHECK-NEXT: access [[three]] function=f0 kind=Read
# CHECK: indirect f0 [[pair]] -> f1 Accessor Once
# CHECK-NEXT: indirect f0 [[pair]] -> f2 Accessor Once
# RUN(NOWHERE): valueflow-results
# NOWHERE-NOT: -> f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First"
layout L1 name="Second"
layout L2 name="Third"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure function=f1
    DefineGetter v0, v1 key="size"
    v3 = NewObject layout=L1 fields=[]
    v4 = NewClosure function=f2
    DefineGetter v3, v4 key="size"
    v6 = NewObject layout=L2 fields=[]
    v7 = NewClosure function=f3
    DefineGetter v6, v7 key="size"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = Call v10, -, v1
    v12 = Call v10, -, v4
    v13 = Call v10, -, v7
    v14 = PropGet v9 key="name" [isFreeName]
    v15 = ToBoolean v14
    Branch v15 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v0)
  b2():
    Jump -> next b3(v3)
  b3(v16: anything):
    v17 = PropGet v16 key="size"
    Branch v15 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b6(v16)
  b5():
    Jump -> next b6(v6)
  b6(v18: anything):
    v19 = PropGet v18 key="size"
    Return
}
# REPEAT: i = 1..3
function f%(i) name="size" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=%(i)
    Return v1
}
# END REPEAT
