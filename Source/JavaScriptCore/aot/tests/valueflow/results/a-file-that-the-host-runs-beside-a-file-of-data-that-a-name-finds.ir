# OPTIONS: admit=FilesRunByHost
# first.js: import { value } from "./inner.js"; value        inner.js: input(); export let value = 1        data.json: {}        one entry point, first.js. data.json is marked IsFoundByName
# The host runs files that the build has not seen, and such a file names data.json. A file of data runs nothing, so no realm runs code before first.js has begun: the variable is stored before every read.
# a-file-that-the-host-runs-loads-a-file-that-a-name-finds.ir has a file with code in place of data.json
# RUN: valueflow-apply
# CHECK: variable g0 name="value" {{*}}initialization=StoredBeforeEveryRead

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="data.json" displayPath="data.json" kind=Data flags=[IsFoundByName] body=f2
entry module=m0
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="data" module=m2 kind=Module results=[{type=anything}] {
    v0 = NewDictionary
    Return v0
}
