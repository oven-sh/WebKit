# other = undefined or a Set; set.union(other). The overload for set-like objects is behind the test for a Set, so undefined never reaches it.
# RUN: valueflow-apply
# CHECK: function f0 name="main" {{*}}results=[{type=Set<L0, proven, pristine[Storage, Names]>}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="other" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Item" fields=[{key="count" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=Set
    v3 = Construct v2
    v4 = Builtin builtin=SetPrototypeAdd
    v5 = Call v4, v3, v1
    v6 = Construct v2
    PutModuleVariable v6 variable=g0
    v8 = GetModuleVariable variable=g0
    v9 = Builtin builtin=SetPrototypeUnion
    v10 = Call v9, v3, v8
    Return v10
}
