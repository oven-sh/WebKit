# The inspector brings in code at run time, at any place. A build that admits it is not solved: the tables state nothing, the tables in which a missing record is a statement are full,
# and the program leaves ApplyFlowResults as it was read
# OPTIONS: admit=Inspector
# RUN: valueflow-results
# CHECK-NOT: function f
# CHECK: access S0 function=f0 kind=Call mayCallBoundFunction=true
# CHECK: builtin-use {{*}} [Tested, Read, Called, Constructed, Written, Escaped]
# CHECK: feature
# CHECK: locale Unknown
# CHECK: unseen-code OptionAdmitsCode
# RUN(APPLY): valueflow-apply
# APPLY: v1: anything = Call v0 accessSite=0
# APPLY: function f1 name="called" {{*}}results=[{type=anything}]
# APPLY: string="unreached"
# RUN(NOTHING): valueflow-apply
# NOTHING-NOT: AssumeType
# NOTHING-NOT: callees=
# NOTHING-NOT: flow=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = NewClosure function=f2
    Return
}
function f1 name="called" results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f2 name="unreached" results=[{type=anything}] {
  b0():
    v0 = String string="unreached"
    Return v0
}
