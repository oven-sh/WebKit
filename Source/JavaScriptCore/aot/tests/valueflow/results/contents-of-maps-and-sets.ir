# numbers = new Map; numbers.set("key", Number(x)); numbers.get("key")    texts = new Set; texts.add(String(x))    handedOut = new Map; handedOut.set("key", 1.5); publish(handedOut); handedOut.get("key")
# What a function stores into a Map or a Set that only followed code gets hold of is all that the collection holds: the type of the collection says so, proven, and a read answers that or undefined.
# Of a collection that code which nobody compiles has got hold of nothing is said
# RUN: valueflow-apply
# CHECK-LABEL: function f1 name="collections"
# CHECK: : Map<"key", number, proven, pristine[Storage, Names]> = AssumeType v3
# CHECK: [[read]]: anything = Call {{*}}callees=[builtin(MapPrototypeGet)]
# CHECK: : undefined|number = AssumeType [[read]]
# CHECK: : Set<string, proven, pristine[Storage, Names]> = AssumeType
# CHECK: [[handedOut]]: anything ~ object = Construct
# CHECK-NOT: proven
# CHECK: Return

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="read" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="collections" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = ToNumber v0
    v2 = Builtin builtin=Map
    v3 = Construct v2
    v4 = String string="key"
    v5 = Builtin builtin=MapPrototypeSet
    v6 = Call v5, v3, v4, v1
    v7 = Builtin builtin=MapPrototypeGet
    v8 = Call v7, v3, v4
    PutModuleVariable v8 variable=g0
    v10 = ToString v0
    v11 = Builtin builtin=Set
    v12 = Construct v11
    v13 = Builtin builtin=SetPrototypeAdd
    v14 = Call v13, v12, v10
    v15 = Construct v2
    v16 = Double number=1.5
    v17 = Call v5, v15, v4, v16
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="publish" [isFreeName]
    v20 = Call v19, -, v15
    v21 = Call v7, v15, v4
    Return v21
}
