# first.js: import "./inner.js"; import "./second.js"        inner.js: new Function(input)(); export let value = 1        second.js: import { value } from "./inner.js"; value        one entry point, first.js. second.js is marked IsFoundByName
# No load of the program names a file at run time, and the host runs no file that the build has not seen: the run time refuses the text the name of second.js. The one entry point has begun before any text runs.
# a-file-that-the-host-runs-loads-a-file-that-a-name-finds.ir is the same program where names find files
# RUN: valueflow-apply
# CHECK: variable g0 name="value" {{*}}initialization=StoredBeforeEveryRead
# RUN(RESULTS): valueflow-results
# RESULTS: unseen-code EvaluatesText

module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="inner.js" displayPath="inner.js" body=f1
module m2 path="second.js" displayPath="second.js" flags=[IsFoundByName] body=f2 requests=[{target=m1 completes=true}]
entry module=m0
variable g0 name="value" module=m1 declared={type=anything|absent} initialization=Uninitialized
function f0 name="first" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f1 name="inner" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Builtin builtin=Function
    v3 = Construct v2, -, v1
    v4 = Call v3
    v5 = Integer integer=1
    PutModuleVariable v5 variable=g0
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="value"
    Return
}
