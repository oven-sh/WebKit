# RUN: valueflow-results
# OPTIONS: admit=ReplacedBuiltins
# CHECK-NOT: added-name
# CHECK-NOT: replaced-builtin

module m0 path="main.test.js" displayPath="main.test.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somebody" [isFreeName]
    v2 = Builtin builtin=ObjectPrototype__defineGetter__
    v3 = Call v1, -, v2
    v4 = Builtin builtin=ObjectPrototype
    v5 = Call v1, v4
    v6 = String string="is loaded"
    v7 = Call v1, -, v6
    Return
}
