# interface Named { name: bigint }   const list: Named = words() as unknown as Named
# const text: number = (list as any).join("+"), sum: number = (list as any) + 1, place: number = (list as any).indexOf("a");   ({ text, sum, place })
# As read, only undefined and null pass both checks of the list. So the calls return nothing, the sum is a number, and no check stands in front of the literal.
# Flow replaces the second check with the array that arrives. It has seen a string arrive at the first two fields, so the literal tests those values.
# It has seen only integers arrive at the third field, so that value keeps its claim.
# FORM: AsRead
# OPTIONS: check=VerifyEachPass
# RUN: pipeline ApplyFlowResults

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Named" module=m0 fields=[{key="name" declared={type=undefined|null|bigint flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 fields=[{key="text" declared={type=number} flags=[IsRequired]}, {key="sum" declared={type=number} flags=[IsRequired]}, {key="place" declared={type=number} flags=[IsRequired]}] ownFieldCount=3
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    v1 = Check v0 expectedType=undefined|null|Array<undefined|null|string>
    v2 = Check v1 expectedType=undefined|null|L0
    v3 = PropGet v2 key="join"
    v4 = String string="+"
    v5 = Call v3, v2, v4
    v6 = Integer integer=1
    v7 = Add v2, v6
    v8 = PropGet v2 key="indexOf"
    v9 = String string="a"
    v10 = Call v8, v2, v9
    v11 = NewObject -, v5, v7, v10 layout=L1 fields=[0, 1, 2]
    v12 = FinishObject v11
    v13 = PropGet v12 key="text"
    Return v13
# CHECK: [[text]]: anything = Call {{*}} callees=[builtin(ArrayPrototypeJoin)]
# CHECK: [[sum]]: number|string|bigint = Add
# CHECK: [[place]]: anything = Call {{*}} callees=[builtin(ArrayPrototypeIndexOf)]
# CHECK: [[testedText]]: undefined|null|number = Check [[text]] expectedType=undefined|null|number
# CHECK-NEXT: [[testedSum]]: number = Check [[sum]] expectedType=undefined|null|number
# CHECK-NEXT: [[claimedPlace]]: number = AssumeType [[place]] provenType=number
# CHECK-NEXT: = NewObject -, [[testedText]], [[testedSum]], [[claimedPlace]] layout=L1
}
function f1 name="words" results=[{type=anything}] {
    v0 = String string="a"
    v1 = NewArray v0 contents=anything
    Return v1
}
