# Past the budget of logged edges every set of objects that still moves is given up: its members are no longer followed. The solve ends with a result all the same, the build records the loss,
# and what the results say still holds: the program with the results applied is valid
# OPTIONS: limit=MaxValueFlowEdgesLogged:1
# LOSS: MaxValueFlowEdgesLogged
# RUN: valueflow-solve
# CHECK-NOT: stopped at a limit
# CHECK: functions
# RUN(APPLY): valueflow-apply
# APPLY: function f0 name="main"
# APPLY: function f1 name="large"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Argument" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Allocated" fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
variable g0 name="stored" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = CallDirect v1 function=f1
    Return
}
function f1 name="large" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="x"
    v3 = PropGet v0 key="x"
    v4 = NewObject -, v3 layout=L1 fields=[0]
    PutModuleVariable v4 variable=g0
    v6 = CallDirect v4 function=f2
    Return v6
}
function f2 name="callee" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y"
    Return v1
}
