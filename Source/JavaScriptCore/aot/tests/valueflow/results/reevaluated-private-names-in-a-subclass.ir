# class Base {} function mix(parent) { return class Again extends parent { #x = 1 } } function also(parent) { return class Below extends parent { } }
# new (also(mix(mix(Base))))()
# Both evaluations of Again define their own #x on the instance of Below. The layout has one field for #x, so the second definition adds a property.
# RUN: valueflow-results
# CHECK: class C{{*}} layout=L2 impossibleMutations=[{{*}}RedefineProperty, ChangeIntegrity{{*}}] {{*}}addedKeys=[#"x"@L1] addedKeysAreComplete=true

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1
layout L1 kind=Instance name="Again" constructor=f2 fields=[{key=#"x"@L1 declared={type=number} flags=[IsRequired, IsPrivate]}] flags=[HasHeritage]
layout L2 kind=Instance name="Below" constructor=f4 flags=[HasHeritage]
variable g0 name="tokenOfAgain" module=m0 declared={type=classtoken flags=[IsFromCompiler]} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = CallDirect v2 function=f5
    v4 = CallDirect v3 function=f5
    v5 = CallDirect v4 function=f6
    v6 = Construct v5
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="Again" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = CallDirect v3 function=f3
    Return v3
}
function f3 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
    v1 = Integer integer=1
    v2 = GetModuleVariable variable=g0
    PrivateDefine v0, v2, v1 layout=L1 field=0
    Return v1
}
function f4 name="Below" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f5 name="mix" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewClassToken layout=L1
    PutModuleVariable v1 variable=g0
    v3 = ResolveHeritage v0
    v4 = NewClosure function=f2
    v5 = NewClass v4, v0, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    Return v6
}
function f6 name="also" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = ResolveHeritage v0
    v2 = NewClosure function=f4
    v3 = NewClass v2, v0, v1 layout=L2
    v4 = FinishClass v3 layout=L2
    Return v4
}
