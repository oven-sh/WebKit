# function loose(n: number): any { return n === 0 ? JSON.parse(text) : strict(n - 1) }   function strict(n: number): number { return loose(n) }
# The call of strict() is written where a number is declared, and nothing proves that a number comes back. The value goes to the caller of loose() and nowhere else, and loose() promises no type:
# the call stays a tail call, and the type is expected.
# FORM: AsRead
# RUN: valueflow-apply
# STATISTIC: ReturnCallsDemoted = 0
# CHECK: function f1 name="loose"
# CHECK: ReturnCall [[call]] casts=[{declared={type=number site=w0 flags=[IsExpected]} resolution=Nothing}
# CHECK-NOT: @{{*}} tail

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Result
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToString v1
    v3 = Integer integer=9
    v4 = CallDirect v3, v2 function=f2
    Return v4
}
function f1 name="loose" parameters=[{type=number}, {type=string}] results=[{type=anything}] {
    v2 = Integer
    v3 = StrictEq v0, v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Builtin builtin=JSONParse
    v5 = Call v4, -, v1
    Return v5
  b2():
    v6 = Integer integer=1
    v7 = Sub v0, v6
    v8 = CallDirect v7, v1 function=f2
    ReturnCall v8 casts=[{declared={type=number site=w0}}]
}
function f2 name="strict" parameters=[{type=number}, {type=string}] results=[{type=number site=w1 flags=[IsExpected]}] {
    v2 = CallDirect v0, v1 function=f1
    ReturnCall v2 casts=[{declared={type=number site=w1 flags=[IsExpected]}}]
}
