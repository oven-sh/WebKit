# shared = [mark, mark]; first(shared); function rest(...r) { return first(r) }  rest(mark); count(shared)    numbers = [x | 0]; firstNumber(numbers); restOfNumbers(x | 0)
# The arrays that meet in a set share a kind because a test for numbers that fails may convert the array that it was asked of. Nothing converts the storage that holds everything while no number lies in it.
# So a literal that is born with that storage for what it holds itself, and never holds a number, has it whatever it meets: `count`, where the literal arrives alone, reads it without a test.
# `first`, where it meets the array of a rest parameter, names no kind and tests. A literal of numbers beside such an array has no proven kind, as before.
# RUN: valueflow-apply
# CHECK-LABEL: variable g0 name="shared"
# CHECK: declared={type=Array<L0, proven, Contiguous
# CHECK-LABEL: variable g1 name="numbers"
# CHECK: declared={type=Array<i32, proven
# CHECK-NOT: Int32
# CHECK-LABEL: function f1 name="first"
# CHECK: parameters=[{type=Array<
# CHECK-NOT: Contiguous
# CHECK: results=
# CHECK-LABEL: function f3 name="count"
# CHECK: parameters=[{type=Array<L0, proven, Contiguous

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="m" declared={type=anything}}] ownFieldCount=1
variable g0 name="shared" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="numbers" module=m0 declared={type=anything} initialization=Undefined
data d0 root=Object{layout=L0 members=[{key="m" value=Number{value=4}}]} module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = NewArray v0, v0 contents=anything
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    v4 = Call v3, -, v1
    v5 = NewClosure function=f2
    v6 = Call v5, -, v0
    v7 = NewClosure function=f3
    v8 = Call v7, -, v1
    v9 = NewClosure function=f4
    v10 = Integer integer=1
    v11 = Call v9, -, v10
    Return
}
function f1 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = ElemGet v0, v1
    Return v2
}
function f2 name="rest" flags=[HasRestParameter] parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    Return v2
}
function f3 name="count" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = ElemGet v0, v1
    Return v2
}
function f4 name="ofNumbers" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = NewArray v2 contents=anything
    PutModuleVariable v3 variable=g1
    v5 = NewClosure function=f5
    v6 = Call v5, -, v3
    v7 = NewClosure function=f6
    v8 = Call v7, -, v2
    Return v8
}
function f5 name="firstNumber" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = ElemGet v0, v1
    Return v2
}
function f6 name="restOfNumbers" flags=[HasRestParameter] parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = NewClosure function=f5
    v2 = Call v1, -, v0
    Return v2
}
