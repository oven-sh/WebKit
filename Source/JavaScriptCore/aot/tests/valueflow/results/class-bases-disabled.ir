# class A { a = 1 }  class B extends A { b = 2 }  new B()
# With class bases switched off nothing is said of the base of a class with a heritage, and it inherits no field. A class without a heritage has no base whatever is switched off
# OPTIONS: disable=flow:ClassBases
# RUN: valueflow-apply
# CHECK: layout L0 {{*}}flow={{*}}baseState=None
# CHECK: layout L1 kind=Instance name="B"
# CHECK-NOT: IsInherited
# CHECK-NOT: baseState=
# CHECK: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1 fields=[{key="a" declared={type=anything}}]
layout L1 kind=Instance name="B" base=L0 constructor=f2 fields=[{key="b" declared={type=anything}}] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    Return
}
function f1 name="A" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="a" mode=Strict
    Return v2
}
function f2 name="B" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropSet v3, v4 key="b" mode=Strict
    Return v3
}
