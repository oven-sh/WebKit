# (1.5).toLocaleString("de"); new Intl.NumberFormat(["fr", "en-US"]); "a".localeCompare("b", flag ? "sv" : "fi")
# A tag that the call spells out is listed: a text, a list of texts that nobody but the call gets hold of, and either arm of a choice. Nothing else is kept.
# RUN: valueflow-results
# CHECK: locale Constant "fr" f0:v6
# CHECK: locale Constant "en-US" f0:v6
# CHECK: locale Constant "de" f0:v3
# CHECK: locale Constant "sv" f0:v16
# CHECK: locale Constant "fi" f0:v16
# CHECK-NOT: locale Unknown
# CHECK-NOT: locale HostDefault

data d0 root=Array { contents=string elements=[String { value="fr" }, String { value="en-US" }] }
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=NumberPrototypeToLocaleString
    v1 = Double number=1.5
    v2 = String string="de"
    v3 = Call v0, v1, v2
    v4 = Builtin builtin=IntlNumberFormat
    v5 = Data data=d0
    v6 = Construct v4, -, v5
    v7 = Builtin builtin=MathRandom
    v8 = Call v7, -
    v9 = ToBoolean v8
    Branch v9 -> taken b1(), notTaken b2()
  b1():
    v10 = String string="sv"
    Jump -> next b3(v10)
  b2():
    v11 = String string="fi"
    Jump -> next b3(v11)
  b3(v12: string):
    v13 = Builtin builtin=StringPrototypeLocaleCompare
    v14 = String string="a"
    v15 = String string="b"
    v16 = Call v13, v14, v15, v12
    Return v16
}
