# A read by name through a receiver that flow does not know expects what the program writes under that name, where that is instances of one built-in class.
# The literals spread an unknown object, so they have no layout, and their members are defined behind the copy. `keySet` is only ever a Set: the read in `has` expects one, and a test guards it.
# `both` is written with a Set and with a Map, and `count` with a number: neither read gets an expectation.
# -- source: main.js
# function normalize(def) {
#   return { ...def, keySet: new Set(), both: new Set(), count: 1 };
# }
# function other(def) {
#   return { ...def, both: new Map() };
# }
# function has(def, key) {
#   return def.keySet.has(key) || def.both.has(key) || def.count > 0;
# }
# report(has(normalize(take()), "a"), has(other(take()), "b"));
# -- end of source
# FORM: AsRead
# RUN: valueflow-apply
# CHECK-LABEL: function {{*}}name="has"
# CHECK: anything ~ Set{{*}} = PropGet {{*}} key="keySet"
# CHECK: anything = PropGet {{*}} key="both"
# CHECK: anything = PropGet {{*}} key="count"

