# table = {}; Object.defineProperty(table, name(), { get: answer }); publish(table); table.member    cache = {}; Object.defineProperty(cache, name(), { get: compute }); cache[name()] = 1; publish(cache); cache.member
# Both objects are in hands nobody knows, and so are their getters: whoever holds them enters them. On `table` the program lays nothing but the getter, so that is what a read under a name finds there:
# the read lists it as an indirect call. On `cache` the program also lays values under keys nobody knows, and a read under a name is expected to find one of those: it lists nothing.
# RUN: valueflow-results
# CHECK: function f1 cause=ReachesNativeCode
# CHECK: function f2 cause=ReachesNativeCode
# CHECK: indirect f0 {{*}} -> f1 Accessor Once
# RUN(NOWHERE): valueflow-results
# NOWHERE-NOT: -> f2 Accessor

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Table"
layout L1 name="Descriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Cache"
layout L3 name="DescriptorOfCache" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = PropGet v0 key="publish" [isFreeName]
    v3 = Builtin builtin=Object
    v4 = Builtin builtin=ObjectDefineProperty
    v5 = NewObject layout=L0 fields=[]
    v6 = NewClosure function=f1
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = Call v1
    v9 = ToPropertyKey v8
    v10 = Call v4, v3, v5, v9, v7
    v11 = Call v2, -, v5
    v12 = PropGet v5 key="member"
    v13 = NewObject layout=L2 fields=[]
    v14 = NewClosure function=f2
    v15 = NewObject -, v14 layout=L3 fields=[0]
    v16 = Call v4, v3, v13, v9, v15
    v17 = Integer integer=1
    ElemSet v13, v9, v17 mode=Strict
    v19 = Call v2, -, v13
    v20 = PropGet v13 key="member"
    Return
}
function f1 name="answer" results=[{type=anything}] {
    v0 = Integer integer=1
    Return v0
}
function f2 name="compute" results=[{type=anything}] {
    v0 = Integer integer=2
    Return v0
}
