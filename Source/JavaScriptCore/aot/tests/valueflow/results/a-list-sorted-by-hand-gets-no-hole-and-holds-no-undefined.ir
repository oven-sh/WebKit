# sorted = [3, 1, 2]; for (end = sorted.length - 1; end > 0; end--) for (k = 0; k < end; k++) if (sorted[k] > sorted[k + 1]) { held = sorted[k]; sorted[k] = sorted[k + 1]; sorted[k + 1] = held }
# sortedUpToItsLength: the same loops, but end = sortedUpToItsLength.length
# A counter that starts at 0 and a bound that starts below the length and only counts down are numbers, not integers, where flow runs. Both stores of the first sort still stand at whole positions from 0
# to the length less one, so the list gets no hole. What they store was read inside the length of a list without holes that never gets shorter, so it is an element and not undefined:
# the list holds integers alone and keeps the storage it was made with. In its last turn the second sort reads one position behind the end and stores there: it may hold undefined, and nothing is said of holes.
# RUN: valueflow-apply
# CHECK-LABEL: variable g0 name="sorted"
# CHECK: declared={type=Array<int[1, 3], proven, Int32, pristine[Storage{{*}}, Dense]>}
# CHECK-LABEL: variable g1 name="sortedUpToItsLength"
# CHECK: declared={type=Array<undefined|int[1, 3], proven{{*}}pristine[Storage
# CHECK-NOT: Dense
# CHECK-LABEL: function f0 name="main"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="sorted" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="sortedUpToItsLength" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = Integer integer=3
    v3 = Integer
    v4 = NewArray v2, v0, v1 contents=anything
    PutModuleVariable v4 variable=g0
    v6 = PropGet v4 key="length"
    v7 = Sub v6, v0
    Jump -> next b1(v7)
  b1(v8):
    LoopHint
    v10 = Greater v8, v3
    Branch v10 -> taken b2(| 0), notTaken b8()
  b2(v11):
    Jump -> next b3(v3)
  b3(v12):
    LoopHint
    v14 = Less v12, v11
    Branch v14 -> taken b4(| 0), notTaken b7()
  b4(v15):
    v16 = ElemGet v4, v15
    v17 = Add v15, v0
    v18 = ElemGet v4, v17
    v19 = Greater v16, v18
    Branch v19 -> taken b5(), notTaken b6()
  b5():
    v20 = ElemGet v4, v15
    v21 = Add v15, v0
    v22 = ElemGet v4, v21
    ElemSet v4, v15, v22 mode=Strict
    v24 = Add v15, v0
    ElemSet v4, v24, v20 mode=Strict
    Jump -> next b6()
  b6():
    v26 = Increment v15
    Jump -> next b3(v26)
  b7():
    v27 = Decrement v11
    Jump -> next b1(v27)
  b8():
    v28 = Integer integer=1
    v29 = Integer integer=2
    v30 = Integer integer=3
    v31 = Integer
    v32 = NewArray v30, v28, v29 contents=anything
    PutModuleVariable v32 variable=g1
    v34 = PropGet v32 key="length"
    Jump -> next b9(v34)
  b9(v35):
    LoopHint
    v37 = Greater v35, v31
    Branch v37 -> taken b10(| 0), notTaken b16()
  b10(v38):
    Jump -> next b11(v31)
  b11(v39):
    LoopHint
    v41 = Less v39, v38
    Branch v41 -> taken b12(| 0), notTaken b15()
  b12(v42):
    v43 = ElemGet v32, v42
    v44 = Add v42, v28
    v45 = ElemGet v32, v44
    v46 = Greater v43, v45
    Branch v46 -> taken b13(), notTaken b14()
  b13():
    v47 = ElemGet v32, v42
    v48 = Add v42, v28
    v49 = ElemGet v32, v48
    ElemSet v32, v42, v49 mode=Strict
    v51 = Add v42, v28
    ElemSet v32, v51, v47 mode=Strict
    Jump -> next b14()
  b14():
    v53 = Increment v42
    Jump -> next b11(v53)
  b15():
    v54 = Decrement v38
    Jump -> next b9(v54)
  b16():
    Return
}
