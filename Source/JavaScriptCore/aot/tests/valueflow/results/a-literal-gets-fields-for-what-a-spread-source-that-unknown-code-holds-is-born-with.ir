# const source = { b: 1.5, a: 1.5 }   unknown(source)   function copy(from) { return { z: 1.5, ...from } }   copy(source); copy(unknown())
# Unknown code holds the source, and what it hands over arrives beside it. What the listed source is born with gets fields in the literal: they take every value, may be missing, and once there are neither taken away nor made anything else.
# function copyAlone(from) { return { ...from } } has no member of its own and gets none.
# function copyEither(from) { return { z: 1.5, ...from } }   copyEither(source); copyEither({ a: 1.5, c: 1.5 }); copyEither(unknown()): only what both are born with.
