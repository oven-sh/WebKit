# A namespace object is frozen or sealed export by export: an export stays writable, so it refuses to be frozen, and one that is not initialized yet throws. So both read every export.
# Object.preventExtensions asks nothing of the exports and is counted with them.
#   import * as frozen ..  Object.freeze(frozen); Object.seal(sealed); Object.preventExtensions(closed); read.a
# FORM: AsRead
# RUN: valueflow-apply
# RUN(RESULTS): valueflow-results
# CHECK: variable g0
# CHECK-NOT: reads=
# CHECK: variable g7 {{*}}reads=NeverRead
# CHECK: module m0 path=
# RESULTS: module m0 namespaceUse=NeverCreated
# RESULTS-NOT: module m1
# RESULTS-NOT: module m2
# RESULTS-NOT: module m3
# RESULTS: module m4 namespaceUse=NamedReadsOnly

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}, {target=m3 completes=true}, {target=m4 completes=true}]
module m1 path="frozen.js" displayPath="frozen.js" body=f1 exports=[{name="a" variable=g0}, {name="b" variable=g1}]
module m2 path="sealed.js" displayPath="sealed.js" body=f2 exports=[{name="a" variable=g2}, {name="b" variable=g3}]
module m3 path="closed.js" displayPath="closed.js" body=f3 exports=[{name="a" variable=g4}, {name="b" variable=g5}]
module m4 path="read.js" displayPath="read.js" body=f4 exports=[{name="a" variable=g6}, {name="b" variable=g7}]
entry module=m0
variable g0 name="a" module=m1 declared={type=anything}
variable g1 name="b" module=m1 declared={type=anything}
variable g2 name="a" module=m2 declared={type=anything}
variable g3 name="b" module=m2 declared={type=anything}
variable g4 name="a" module=m3 declared={type=anything}
variable g5 name="b" module=m3 declared={type=anything}
variable g6 name="a" module=m4 declared={type=anything}
variable g7 name="b" module=m4 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Object
    v1 = ModuleNamespace module=m1
    v2 = Builtin builtin=ObjectFreeze
    v3 = Call v2, v0, v1
    v4 = ModuleNamespace module=m2
    v5 = Builtin builtin=ObjectSeal
    v6 = Call v5, v0, v4
    v7 = ModuleNamespace module=m3
    v8 = Builtin builtin=ObjectPreventExtensions
    v9 = Call v8, v0, v7
    v10 = ModuleNamespace module=m4
    v11 = PropGet v10 key="a"
    Return
}
function f1 name="body1" module=m1 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f2 name="body2" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f3 name="body3" module=m3 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f4 name="body4" module=m4 kind=Module results=[{type=anything}] {
  b0():
    Return
}
