entry module=m0
layout L0 kind=Instance name="Keyed" constructor=f1
layout L1 kind=Instance name="Either" constructor=f6
layout L2 kind=Instance name="Fresh" constructor=f10
layout L3 kind=Instance name="Named" constructor=f13
