    v0 = Builtin builtin=Symbol
    v1 = String string="k"
    v2 = Call v0, -, v1 callNumber=100 @100
    PutModuleVariable v2 variable=g0
    v4 = String string="g"
    v5 = Call v0, -, v4 callNumber=200 @200
    v6 = Builtin builtin=SymbolFor
    v7 = String string="s"
    v8 = Call v6, v0, v7 @300
    v9 = NewClosure function=f1
    v10 = NewClass v9 layout=L0
    v11 = GetModuleVariable variable=g0
    v12 = ToPropertyKey v11
    v13 = NewClosure function=f2
    DefineMethod v10, v13, v12 layout=L0
    v15 = ToPropertyKey v5
    v16 = NewClosure function=f3
    DefineMethod v10, v16, v15 layout=L0 methodKind=Getter index=1
    v18 = ToPropertyKey v8
    v19 = NewClosure function=f4
    DefineMethod v10, v19, v18 layout=L0 side=Static index=2
    v21 = NewClosure function=f5
    DefineMethod v10, v21 layout=L0 index=3 key="named"
    v23 = FinishClass v10 layout=L0
    v24 = Builtin builtin=GlobalThis
    v25 = PropGet v24 key="somethingThatNoTableLists" [isFreeName]
    v26 = ToBoolean v25
    Branch v26 -> taken b1(), notTaken b2()
# CHECK: DefineMethod v10, v13 layout=L0 key=symbol("k")@m0:100
# CHECK: DefineMethod v10, v16 layout=L0 methodKind=Getter index=1 key=symbol("g")@m0:200
# CHECK: DefineMethod v10, v19 layout=L0 side=Static index=2 key=Symbol.for("s")
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v5)
  b3(v27):
    v28 = NewClosure function=f6
    v29 = NewClass v28 layout=L1
    v30 = ToPropertyKey v27
    v31 = NewClosure function=f7
    DefineMethod v29, v31, v30 layout=L1
    v33 = NewClosure function=f8
    DefineMethod v29, v33 layout=L1 index=1 key="named"
    v35 = FinishClass v29 layout=L1
    v36 = CallDirect function=f9
    v37 = CallDirect function=f9
    v38 = CallDirect function=f12
    Return
# CHECK: DefineMethod v29, v31, {{*}} layout=L1
}
