# const k = Symbol("k"), g = Symbol("g"), s = Symbol.for("s");  class Keyed { [k]() {} get [g]() {} static [s]() {} named() {} }
# A computed key that can be one symbol only is the name of its member: the definition names it, the class lists the member under it, and the names of the class are complete.
# class Either { [unknown ? k : g]() {} named() {} }: the key is one of two. makeFresh() runs twice and makes a symbol each time: one key stands for two symbols.
# Those definitions keep their operands, their members have no name, and nothing is said of the other members of those classes.
# class Named { [k]() {} }: the function takes its name from the key where it is made, which hands it to nobody: its closure is only ever called
# RUN: valueflow-apply
# CHECK: layout L0 {{*}}prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key=symbol("k")@m0:100 function=f2 mutability=Fixed {{*}}{key=symbol("g")@m0:200 kind=Getter function=f3 mutability=Fixed {{*}}{key=Symbol.for("s") side=Static function=f4 mutability=Fixed {{*}}{key="named" function=f5 mutability=Fixed
# CHECK: layout L1 {{*}}members=[{function=f7{{*}}{key="named" function=f8
# CHECK: layout L2 {{*}}members=[{function=f11
# CHECK: layout L3 {{*}}members=[{key=symbol("k")@m0:100 function=f14 mutability=Fixed closureUse=CalledOnly

