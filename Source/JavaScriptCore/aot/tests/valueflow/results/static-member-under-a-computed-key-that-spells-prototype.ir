# const k = "prototype";  class Both { static [k]() {} static get [k]() {} [k]() {} }
# The prototype property of a class cannot be redefined: a static definition under that key throws where it runs. It keeps its operand, as a definition under a key nobody knows.
# The prototype object has no such property: there the key is the name of the member.
# RUN: valueflow-apply
# CHECK: layout L0 {{*}}members=[{side=Static function=f2{{*}}{side=Static kind=Getter function=f3{{*}}{key="prototype" function=f4

