    v4 = NewClosure function=f2
    DefineMethod v2, v4, v3 layout=L0 side=Static
    v6 = ToPropertyKey v0
    v7 = NewClosure function=f3
    DefineMethod v2, v7, v6 layout=L0 side=Static methodKind=Getter index=1
    v9 = ToPropertyKey v0
    v10 = NewClosure function=f4
    DefineMethod v2, v10, v9 layout=L0 index=2
    v12 = FinishClass v2 layout=L0
    Return
