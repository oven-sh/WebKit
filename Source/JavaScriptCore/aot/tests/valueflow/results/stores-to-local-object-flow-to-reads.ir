# function listener(request) { const context = {}; context.request = request; read(context) }   function read(context) { context.request.url }   unknown(listener)   const request = new Request()   unknown(request)   listener(request)
# Code that nobody sees may call the listener with anything, and has been handed the request, so nothing is proven of the parameter. The program is seen to hand it a request. The listener stores what it is given in an object
# that it has made itself, so requests are seen to lie in that field, and whoever reads the field is seen to get them. Nothing is proven of what is read.
# RUN: valueflow-apply
# CHECK: function f2 name="read"
# CHECK: = PropGet v1 key="url" {{*}}receivers=[L0, ..]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Request" constructor=f3 fields=[{key="url" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L1 kind=Record name="Context" fields=[{key="request" declared={type=anything}}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="unknown" [isFreeName]
    v3 = Call v2, -, v0
    v4 = NewClosure function=f3
    v5 = Construct v4
    v6 = Call v2, -, v5
    v7 = Call v0, -, v5
    Return
}
function f1 name="listener" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L1
    PropSet v1, v0 key="request" mode=Strict
    v3 = NewClosure function=f2
    v4 = Call v3, -, v1
    Return v4
}
function f2 name="read" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="request"
    v2 = PropGet v1 key="url"
    Return v2
}
function f3 name="Request" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="/"
    PropSet v0, v1 key="url" mode=Strict
    Return
}
