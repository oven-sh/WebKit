# A field that the constructor of its class, or an initializer, stores by one operation outside every cycle is stored at most once in each object.
# Not where a second operation stores it, where the store stands in a cycle, where a helper stores it, or where a method stores it again
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Once" {{*}}{key="a"{{*}}location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation{{*}}{key="b"{{*}}location={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation initialization=SetAtCreation
# CHECK: layout L1 kind=Instance name="Twice" {{*}}{key="a"{{*}}location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation
# CHECK: layout L2 kind=Instance name="InCycle" {{*}}{key="a"{{*}}location={writers=AllKnown storeNaming=EveryStoreNamesLocation
# CHECK: layout L3 kind=Instance name="ByHelper" {{*}}{key="a"{{*}}location={writers=AllKnown storeNaming=EveryStoreNamesLocation
# CHECK: layout L4 kind=Instance name="AgainByMethod" {{*}}{key="a"{{*}}location={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=SetAtCreation

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Once" constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}, {key="b" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="Twice" constructor=f3 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 kind=Instance name="InCycle" constructor=f4 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L3 kind=Instance name="ByHelper" constructor=f5 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L4 kind=Instance name="AgainByMethod" constructor=f7 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewClosure function=f1
    v2 = NewClass v1 layout=L0
    v3 = FinishClass v2 layout=L0
    v4 = Construct v3, -, v0
    v5 = PropGet v4 key="a"
    v6 = PropGet v4 key="b"
# REPEAT: i = 1..3
    v%(i*5+2) = NewClosure function=f%(i+2)
    v%(i*5+3) = NewClass v%(i*5+2) layout=L%(i)
    v%(i*5+4) = FinishClass v%(i*5+3) layout=L%(i)
    v%(i*5+5) = Construct v%(i*5+4), -, v0
    v%(i*5+6) = PropGet v%(i*5+5) key="a"
# END REPEAT
    v22 = NewClosure function=f7
    v23 = NewClass v22 layout=L4
    v24 = NewClosure function=f8
    DefineMethod v23, v24 layout=L4 key="reset"
    v26 = FinishClass v23 layout=L4
    v27 = Construct v26, -, v0
    v28 = PropGet v27 key="reset"
    v29 = Call v28, v27
    v30 = PropGet v27 key="a"
    Return
}
function f1 name="Once" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v5 = CallDirect v4 function=f2
    PropSet v4, v1 key="a" mode=Strict
    Return v4
}
function f2 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: L0):
    v1 = Double number=2.5
    PropDefine v0, v1 key="b"
    v3 = Undefined
    Return v3
}
function f3 name="Twice" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    PropSet v3, v1 key="a" mode=Strict
    PropSet v3, v1 key="a" mode=Strict
    Return v3
}
function f4 name="InCycle" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L2
    v3 = NewObject v2 layout=L2
    Jump -> next b1()
  b1():
    LoopHint
    PropSet v3, v1 key="a" mode=Strict
    v6 = ToBoolean v1
    Branch v6 -> taken b1(), notTaken b2()
  b2():
    Return v3
}
function f5 name="ByHelper" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L3
    v3 = NewObject v2 layout=L3
    v4 = CallDirect v3, v1 function=f6
    Return v3
}
function f6 name="fill" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="a" mode=Strict
    Return
}
function f7 name="AgainByMethod" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L4
    v3 = NewObject v2 layout=L4
    PropSet v3, v1 key="a" mode=Strict
    Return v3
}
function f8 name="reset" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Double number=0.5
    PropSet v0, v1 key="a" mode=Strict
    Return
}
