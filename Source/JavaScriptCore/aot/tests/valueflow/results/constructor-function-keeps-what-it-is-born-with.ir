# function Plain(x) { this.x = x }  new Plain(1)    function WithMethod(x) { this.x = x }  WithMethod.prototype.twice = function () { return this.x * 2 }  new WithMethod(1)
# function Replaced(x) { this.x = x }  Replaced.prototype = { other: 1 }  new Replaced(1)    function Relinked(x) { this.x = x }  Object.setPrototypeOf(Relinked.prototype, null)  new Relinked(1)
# function HandedOut(x) { this.x = x }  somethingThatNoTableLists(HandedOut)  new HandedOut(1)    function WithStatic(x) { this.x = x }  WithStatic.count = 0  new WithStatic(1)
# A function is born with Function.prototype above it and with a prototype object, which has Object.prototype above it. Nobody follows the order of what a program stores afterwards,
# and what is never done needs no order: a function that seen code alone has keeps `prototype`, both links and its names where nothing is stored, defined or linked anew.
# A name that is stored on the prototype object is listed, so the names stay complete. Each thing that is done costs the fact that it is about.
# FORM: AsRead
# RUN: flow
# CHECK: layout L0 flow=
# CHECK: classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true}
# CHECK: layout L1 flow=
# CHECK: classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="twice" function=f7}]
# CHECK: layout L2 flow=
# CHECK-NOT: prototypeProperty=Fixed
# CHECK-NOT: prototypeLink=Fixed
# CHECK-NOT: prototypeNamesAreComplete=true
# CHECK: layout L3 flow=
# CHECK-NOT: prototypeLink=Fixed
# CHECK: prototypeProperty=Fixed
# CHECK: layout L4 flow=
# CHECK-NOT: =Fixed
# CHECK-NOT: NamesAreComplete=true
# CHECK: layout L5 flow=
# CHECK: classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeProperty=Fixed prototypeNamesAreComplete=true}

