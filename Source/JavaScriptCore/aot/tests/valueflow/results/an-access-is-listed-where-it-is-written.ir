# function spanOf({ start, end }) { return end - start }  function linesOf({ first: { line }, last: { line: lastLine } }) { return lastLine - line }
# What an object pattern reads is reported at one place when it throws, and each name stands at a place of its own in the text.
# The list of accesses has each read where it is written, so two reads of one name are two accesses.
# RUN: flow-report through=Select
# OPTIONS: report=Flow
# CHECK: access-count m0 accesses=[6, 0, 0] accessCosts=[6, 0, 0, 0]
# CHECK: access m0:19 Read Unknown ByName
# CHECK-NEXT: access m0:26 Read Unknown ByName
# CHECK-NOT: access m0:110
# CHECK: access m0:219 Read Unknown ByName
# CHECK-NEXT: access m0:228 Read Unknown ByName
# CHECK-NEXT: access m0:236 Read Unknown ByName
# CHECK-NEXT: access m0:244 Read Unknown ByName
# CHECK-NOT: access m0:310
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="spanOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="start" @110 @19
    v2 = PropGet v0 key="end" @110 @26
    v3 = Sub v2, v1 @120
    Return v3
}
function f2 name="linesOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="first" @310 @219
    v2 = PropGet v1 key="line" @310 @228
    v3 = PropGet v0 key="last" @310 @236
    v4 = PropGet v3 key="line" @310 @244
    v5 = Sub v4, v2 @320
    Return v5
}
