    PropDefine v1, v3 key=@@hasInstance
    v5 = Integer integer=1
    v6 = Call v1, -, v5
    Return v6
}
function f1 name="Made" flags=[IsSloppy, HasThis] captures=[{type=env L1 flags=[IsFromCompiler]}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
