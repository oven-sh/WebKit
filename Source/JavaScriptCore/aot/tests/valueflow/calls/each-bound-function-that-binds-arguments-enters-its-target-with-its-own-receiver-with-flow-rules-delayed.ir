# handOut(letsThisGo.bind(first, 1)); handOut(keepsThis.bind(second, 1))
# Whoever holds the two bound functions can call them. Each enters its own target with the receiver that it was bound to: `letsThisGo` gets `first` and hands it on,
# so what `first` holds is entered. `second` goes to `keepsThis` alone and stays in the program, whether the two bound functions are handed out together or one after the other.
# each-bound-function-that-binds-arguments-enters-its-target-with-its-own-receiver.ir with another order of the rules: the answer is the same.
# OPTIONS: testing=DelayFlowRules
# RUN: valueflow-why escaped=f3 escaped=f4
# CHECK: escaped=f3
# CHECK-NEXT: n0 escaped
# CHECK: escaped=f4
# CHECK-NEXT: not held

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Second" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = NewClosure function=f4
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = Builtin builtin=FunctionPrototypeBind
    v7 = Integer integer=1
    v8 = Call v6, v0, v3, v7
    v9 = Call v6, v1, v5, v7
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="somethingThatNoTableLists" [isFreeName]
    v12 = Call v11, -, v8
    v13 = Call v11, -, v9
    Return
}
function f1 name="letsThisGo" flags=[HasThis] results=[{type=anything}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="somethingThatNoTableLists" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f2 name="keepsThis" flags=[HasThis] results=[{type=anything}] {
    Return
}
function f3 name="heldByFirst" kind=Arrow results=[{type=anything}] {
    Return
}
function f4 name="heldBySecond" kind=Arrow results=[{type=anything}] {
    Return
}
