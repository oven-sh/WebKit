# handOut(kept.bind(null)); handOut(alsoKept.bind(null)); handOut(given.bind(null)); handOut(given)
# Whoever holds a bound function can write `x instanceof bound`, which asks the target for Symbol.hasInstance with the target as `this`.
# More targets than the analysis tells apart: the three functions are looked up together. `given` is in hands nobody sees, so a method nobody knows may lie on it, and it is handed to that method.
# That says nothing about the two that were looked up beside it: each is asked by itself what it finds. They stay in the program, whichever of the four arrives first.
# targets-of-bound-functions-past-those-told-apart-are-tested-against-one-by-one.ir with another order of the rules: the answer is the same.
# OPTIONS: testing=DelayFlowRules,DelayOtherFlowRules
# OPTIONS: limit=MaxValueFlowMembersToldApart:1
# RUN: valueflow-why escaped=f1 escaped=f2 escaped=f3
# CHECK: escaped=f1
# CHECK-NEXT: not held
# CHECK: escaped=f2
# CHECK-NEXT: not held
# CHECK: escaped=f3
# CHECK-NEXT: n0 escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=FunctionPrototypeBind
    v4 = Null
    v5 = Call v3, v0, v4
    v6 = Call v3, v1, v4
    v7 = Call v3, v2, v4
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="somethingThatNoTableLists" [isFreeName]
    v10 = Call v9, -, v5
    v11 = Call v9, -, v6
    v12 = Call v9, -, v7
    v13 = Call v9, -, v2
    Return
}
function f1 name="kept" kind=Arrow results=[{type=anything}] {
    Return
}
function f2 name="alsoKept" kind=Arrow results=[{type=anything}] {
    Return
}
function f3 name="given" kind=Arrow results=[{type=anything}] {
    Return
}
