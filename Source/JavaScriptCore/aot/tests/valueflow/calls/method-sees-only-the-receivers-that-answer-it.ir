# CHECK: values=f2:v1
# CHECK: operand 0 {{*}} 1 members: [[a]]
# CHECK: values=f4:v1
# CHECK: operand 0 {{*}} 1 members: [[b]]
# RUN(CALLS): valueflow-solve calls
# CALLS: f5 v2 -> {{*}}f2 f4

