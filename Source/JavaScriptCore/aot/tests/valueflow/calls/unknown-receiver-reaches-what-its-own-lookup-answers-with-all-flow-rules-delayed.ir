# class A { m() { this.x } }  class B { m() { this.x } }  function run(o) { o.m() }  run(new A()); run(new B()); run(somethingNoTableLists)
# method-sees-only-the-receivers-that-answer-it.ir, and a receiver that nobody knows. It asks for `m` as every receiver does, and goes to what that lookup answers: a callee nobody knows. A method that the instances of a class find gets those instances.
# unknown-receiver-reaches-what-its-own-lookup-answers.ir with another order of the rules: the answer is the same.
# OPTIONS: testing=DelayFlowRules,DelayOtherFlowRules
# RUN: valueflow-why values=f2:v1 values=f4:v1
# CHECK: values=f2:v1
# CHECK: operand 0 {{*}} 1 members: object
# CHECK: values=f4:v1
# CHECK: operand 0 {{*}} 1 members: object

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" constructor=f3
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f3
    v6 = NewClass v5 layout=L1
    v7 = NewClosure function=f4
    DefineMethod v6, v7 layout=L1 key="m"
    v9 = FinishClass v6 layout=L1
    v10 = NewClosure function=f5
    v11 = Construct v4
    v12 = Call v10, -, v11
    v13 = Construct v9
    v14 = Call v10, -, v13
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="somethingThatNoTableLists" [isFreeName]
    v17 = Call v10, -, v16
    Return
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f3 name="B" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="m" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f5 name="run" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return
}
