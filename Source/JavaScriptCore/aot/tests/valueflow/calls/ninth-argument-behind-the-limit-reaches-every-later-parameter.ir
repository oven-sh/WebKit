# function both(a, b, c, d, e, f, g, h, i, j) { i(); j() }
# both(0, 0, 0, 0, 0, 0, 0, 0, nine, ten)
# ninth-argument-reaches-the-ninth-parameter-alone.ir with the limit at the fewest positions a group keeps. The ninth and the tenth argument share one node, so each of the two parameters
# receives both, and undefined (primitive 0) beside them: a caller that left a later position out is not told from one that filled it. The build reports the limit, with the function.
# OPTIONS: limit=MaxGroupedArguments:8
# LOSS: MaxGroupedArguments x1 f1
# RUN: valueflow-solve calls primitives
# CHECK: f1 v10 -> primitive0 f2 f3
# CHECK: f1 v11 -> primitive0 f2 f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Integer integer=0
    v4 = Call v0, -, v3, v3, v3, v3, v3, v3, v3, v3, v1, v2
    Return
}
function f1 name="both" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v10 = Call v8, -
    v11 = Call v9, -
    Return
}
function f2 name="nine" module=m0 results=[{type=anything}] {
    Return
}
function f3 name="ten" module=m0 results=[{type=anything}] {
    Return
}
