# function Point() { this.m() }   Point.prototype.m = function () { return 1 }   new Point()   Reflect.construct(Point, [], somethingThatNoTableLists)
# Under a new target nobody knows `this` may be an object nobody knows, so the callee of `this.m()` shows the unknown object at once. What an instance finds up its chain comes some rounds later.
# The member that nobody knows is called on the receivers that find it. An instance finds `m` of the prototype object, so it stays with the program, whichever of the two the callee showed first.
# RUN: valueflow-results
# CHECK: class C{{*}} layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,

layout L0 kind=Instance name="Point" module=m0 constructor=f1 flags=[IsConstructorFunction]
data d0 root=Array{contents=anything} module=m0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f2
    PropSet v1, v2 key="m"
    v4 = Construct v0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="somethingThatNoTableLists" [isFreeName]
    v7 = Builtin builtin=Reflect
    v8 = Builtin builtin=ReflectConstruct
    v9 = Data data=d0
    v10 = Call v8, v7, v0, v9, v6
    Return
}
function f1 name="Point" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return
}
function f2 name="m" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
