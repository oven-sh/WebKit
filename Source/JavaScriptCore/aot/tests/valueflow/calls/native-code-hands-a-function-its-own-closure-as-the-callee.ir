# Maker = class extends Function {}; new Maker("x", "return x + 1")        publish(class Below extends Base {})
# A class that has escaped is entered by native code, with the unknown value as every operand. The callee is no operand of that sort: whoever calls a function hands it its own closure.
# The constructor of a derived class finds the class that `super` goes to above its callee. So the super call of Maker is seen to apply the Function constructor, which lets in unseen code,
# and the super call of Below enters the constructor of Base.
# RUN: valueflow-solve unseen
# CHECK: unseen EvaluatesText Function
# CHECK: unseen-code yes
# RUN(CALLS): valueflow-solve calls
# CALLS: f3 v3 ->{{*}} f2

module m0 path="main.cjs" displayPath="main.cjs" body=f0
entry module=m0
layout L0 kind=Instance name="Maker" constructor=f1 flags=[HasHeritage]
layout L1 kind=Instance name="Base" constructor=f2
layout L2 kind=Instance name="Below" base=L1 constructor=f3 flags=[HasHeritage]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Function" [isFreeName]
    v2 = ResolveHeritage v1
    v3 = NewClosure function=f1
    v4 = NewClass v3, v1, v2 layout=L0
    v5 = FinishClass v4 layout=L0
    PropSet v0, v5 key="Maker" mode=Sloppy [isFreeName]
    v7 = PropGet v0 key="Maker" [isFreeName]
    v8 = String string="x"
    v9 = String string="return x + 1"
    v10 = Construct v7, -, v8, v9
    v11 = NewClosure function=f2
    v12 = NewClass v11 layout=L1
    v13 = FinishClass v12 layout=L1
    v14 = ResolveHeritage v13
    v15 = NewClosure function=f3
    v16 = NewClass v15, v13, v14 layout=L2
    v17 = FinishClass v16 layout=L2
    v18 = PropGet v0 key="publish" [isFreeName]
    v19 = Call v18, -, v17
    Return v10
}
function f1 name="Maker" module=m0 kind=DerivedConstructor flags=[HasRestParameter, HasNewTarget, TakesCallee] parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: function, v1: anything, v2: Array):
    v3 = GetSuperBase v0
    v4 = SuperConstructList v3, v1, v2 layout=L0
    Return v4
}
function f2 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="Below" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
