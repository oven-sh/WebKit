# function both(a, b, c, d, e, f, g, h, i, j) { i(); j() }  function wrap(...args) { both(...args) }
# wrap(0, 0, 0, 0, 0, 0, 0, 0, nine, ten)
# The cells of a rest array go by the positions every group keeps, eight: the ninth and the tenth argument lie among the later arguments of wrap's array, and the spread hands them to
# the ninth and the tenth parameter of both together, with undefined (primitive 0). The build names both under MaxGroupedArgumentsOfOtherCalls, as the direct call would under the limit.
# LOSS: MaxGroupedArgumentsOfOtherCalls x1 f1
# RUN: valueflow-solve calls primitives
# CHECK: f1 v10 -> primitive0 f3 f4
# CHECK: f1 v11 -> primitive0 f3 f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
