    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Integer integer=0
    v5 = Call v1, -, v4, v4, v4, v4, v4, v4, v4, v4, v2, v3
    Return
}
function f1 name="both" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v10 = Call v8, -
    v11 = Call v9, -
    Return
}
function f2 name="wrap" module=m0 flags=[HasRestParameter] parameters=[{type=Array}] results=[{type=anything}] {
    v1 = NewClosure function=f1
    v2 = CallList v1, -, v0
    Return v2
}
