# function join(a: string, b: string) { return a + b }; join("a", "b")
# In front of the analysis a function of the program becomes three: the tests of its arguments under its own number, its typed body and its generic version.
# The generic version runs only for a caller whose arguments fail a test. Here every argument fits, so nobody reaches it
# RUN: valueflow-solve split unreached calls
# CHECK: f0 v3 -> f1
# CHECK: unreached f4
# RUN(REACHED): valueflow-solve split unreached
# REACHED-NOT: unreached f3

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Parameter
typesite w2 module=m0 position=30 kind=Result
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="a"
    v2 = String string="b"
    v3 = Call v0, -, v1, v2
    Return
}
function f1 name="join" module=m0 position=5 flags=[IsChecked] length=2 parameters=[{type=string site=w0}, {type=string site=w1}] results=[{type=string site=w2}] {
  b0(v0: string, v1: string):
    v2 = Add v0, v1
    Return v2
}
