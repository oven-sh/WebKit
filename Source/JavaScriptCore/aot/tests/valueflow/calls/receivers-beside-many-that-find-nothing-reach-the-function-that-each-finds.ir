# RUN: valueflow-why values=f4:v2 values=f0:v24 values=f1:v1 values=f0:v27 values=f2:v1 values=f0:v13 values=f3:v1
# CHECK: values=f4:v2
# CHECK: operand 1 {{*}} 20 members:
# CHECK: values=f0:v24
# CHECK: operand 2 1 members: [[first]]
# CHECK: values=f1:v1
# CHECK: operand 0 {{*}} 1 members: [[first]]
# CHECK: values=f0:v27
# CHECK: operand 2 1 members: [[second]]
# CHECK: values=f2:v1
# CHECK: operand 0 {{*}} 1 members: [[second]]
# CHECK: values=f0:v13
# CHECK: operand 2 1 members: [[givenLater]]
# CHECK: values=f3:v1
# CHECK: operand 0 {{*}} 1 members: [[givenLater]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Holding" fields=[{key="m" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f4
    v1 = Integer integer=1
# REPEAT: i = 0..9
    v%(i*2+2) = NewObject -, v1 layout=L0 fields=[0]
    v%(i*2+3) = Call v0, -, v%(i*2+2)
# END REPEAT
    v22 = NewClosure function=f1
    v23 = NewObject -, v22 layout=L1 fields=[0]
    v24 = Call v0, -, v23
    v25 = NewClosure function=f2
    v26 = NewObject -, v25 layout=L1 fields=[0]
    v27 = Call v0, -, v26
# REPEAT: i = 0..7
    v%(i*2+28) = NewObject -, v1 layout=L1 fields=[0]
    v%(i*2+29) = Call v0, -, v%(i*2+28)
# END REPEAT
    v44 = NewClosure function=f3
    PropSet v12, v44 key="m"
    Return
}
# REPEAT: i = 1..3
function f%(i) name="m%(i)" module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
# END REPEAT
function f4 name="run" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return
}
