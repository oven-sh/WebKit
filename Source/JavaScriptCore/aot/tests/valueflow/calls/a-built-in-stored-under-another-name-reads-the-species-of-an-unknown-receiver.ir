# class List extends Array { static get [Symbol.species]() { return Array } }
# p = new Proxy(new List, {}); p.walk = Array.prototype.map; p.walk(one => one)
# The store lets map escape, so the value of the callee shows only the unknown object, and no row lists map under "walk". The call still reads `constructor` and the species of its receiver.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f2
# CHECK-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="List" constructor=f1 flags=[HasHeritage]
layout L1 name="Handler"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Array
    v1 = NewClosure function=f1
    v2 = ResolveHeritage v0
    v3 = NewClass v1, v0, v2 layout=L0
    v4 = NewClosure function=f2
    DefineMethod v3, v4 layout=L0 side=Static methodKind=Getter key=@@species
    v6 = FinishClass v3 layout=L0
    v7 = Construct v6
    v8 = NewObject layout=L1
    v9 = Builtin builtin=Proxy
    v10 = Construct v9, -, v7, v8
    v11 = Builtin builtin=ArrayPrototypeMap
    PropSet v10, v11 key="walk"
    v13 = PropGet v10 key="walk"
    v14 = NewClosure function=f3
    v15 = Call v13, v10, v14 calleeKey="walk"
    Return v15
}
function f1 name="List" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    Return v3
}
function f2 name="species" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = Builtin builtin=Array
    Return v1
}
function f3 name="one" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
