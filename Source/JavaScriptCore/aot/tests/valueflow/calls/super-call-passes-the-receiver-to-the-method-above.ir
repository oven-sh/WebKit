# base = { who() { this.x } }; home = { __proto__: base, who() { super.who() } }; other = { who: home.who }; other.who()
# `super.who()` names the key `who` too, and reads it from the object above the home object and not from the receiver. The read of `who` from the receiver answers the method of `home` alone,
# and the method of `base` still runs with the receiver as `this`.
# RUN: valueflow-why values=f1:v1
# CHECK: values=f1:v1
# CHECK: operand 0 {{*}} 1 members: [[other]]@f0
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v7 -> f2
# CALLS: f2 v4 -> f1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Home"
layout L1 name="Base" fields=[{key="who" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = NewObject v1 layout=L0 fields=[]
    v3 = NewClosure v2 function=f2
    PropDefine v2, v3 key="who"
    v5 = NewObject -, v3 layout=L1 fields=[0]
    v6 = PropGet v5 key="who"
    v7 = Call v6, v5 calleeKey="who"
    Return
}
function f1 name="who" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f2 name="who" module=m0 kind=Method flags=[HasThis] captures=[{type=object}] thisType={type=anything} results=[{type=anything}] {
    v2 = GetSuperBase v0
    v3 = SuperGet v2, v1 key="who"
    v4 = Call v3, v1 calleeKey="who"
    Return
}
