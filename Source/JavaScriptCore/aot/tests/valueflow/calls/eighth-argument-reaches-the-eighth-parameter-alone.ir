# function first(a, b, c, d, e, f, g, h) { a() }  function last(a, b, c, d, e, f, g, h) { h() }
# first(one, 0, 0, 0, 0, 0, 0, eight)  last(0, 0, 0, 0, 0, 0, 0, other)
# The last argument that a group of callees keeps a node for. Its pair with one argument more is ninth-argument-reaches-no-earlier-parameter.ir.
# RUN: valueflow-solve calls
# CHECK: f1 v8 -> f3
# CHECK: f2 v8 -> f5
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f4
# UNREACHED-NOT: unreached f5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = Integer integer=0
    v6 = Call v0, -, v2, v5, v5, v5, v5, v5, v5, v3
    v7 = Call v1, -, v5, v5, v5, v5, v5, v5, v5, v4
    Return
}
function f1 name="first" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v8 = Call v0, -
    Return
}
function f2 name="last" module=m0 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v8 = Call v7, -
    Return
}
function f3 name="one" module=m0 results=[{type=anything}] {
    Return
}
function f4 name="eight" module=m0 results=[{type=anything}] {
    Return
}
function f5 name="other" module=m0 results=[{type=anything}] {
    Return
}
