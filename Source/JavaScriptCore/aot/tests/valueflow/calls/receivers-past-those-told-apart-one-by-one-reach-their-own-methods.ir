# class A { m() { this.x } }  class B { m() { this.x } }  class C { m() { this.x } }  function run(o) { o.m() }  run(new A()); run(new B()); run(new C())
# as-many-receivers-as-are-told-apart-reach-their-own-methods.ir with one receiver more than the analysis tells apart one by one. From there on it looks at the receivers of one layout together,
# and each of the three has a layout to itself: nothing is lost, and no method sees an instance but its own.
# OPTIONS: limit=MaxValueFlowMembersToldApart:2
# RUN: valueflow-why values=f7:v2 values=f2:v1 values=f4:v1 values=f6:v1
# CHECK: values=f7:v2
# CHECK: operand 1 {{*}} 3 members: [[a]] [[b]] [[c]]
# CHECK: values=f2:v1
# CHECK: operand 0 {{*}} 1 members: [[a]]
# CHECK: values=f4:v1
# CHECK: operand 0 {{*}} 1 members: [[b]]
# CHECK: values=f6:v1
# CHECK: operand 0 {{*}} 1 members: [[c]]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="A" constructor=f1
layout L1 kind=Instance name="B" constructor=f3
layout L2 kind=Instance name="C" constructor=f5
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
# REPEAT: i = 0..2
    v%(i*5) = NewClosure function=f%(i*2+1)
    v%(i*5+1) = NewClass v%(i*5) layout=L%(i)
    v%(i*5+2) = NewClosure function=f%(i*2+2)
    DefineMethod v%(i*5+1), v%(i*5+2) layout=L%(i) key="m"
    v%(i*5+4) = FinishClass v%(i*5+1) layout=L%(i)
# END REPEAT
    v15 = NewClosure function=f7
    v16 = Construct v4
    v17 = Call v15, -, v16
    v18 = Construct v9
    v19 = Call v15, -, v18
    v20 = Construct v14
    v21 = Call v15, -, v20
    Return
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f3 name="B" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f4 name="m" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f5 name="C" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    Return v2
}
function f6 name="m" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return
}
function f7 name="run" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return
}
