# class P { x = 1 }  class Q {}  function f(p: P) { return p.x }  f(new P)
# The only argument is an instance of P, nothing passes a new.target by operand and P extends nothing, so no caller fails the entry test and the generic version is never reached.
# RUN: valueflow-solve split unreached
# CHECK: unreached f6

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
layout L0 kind=Instance name="P" constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Q" constructor=f2 fields=[]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f2
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = Construct v2
    v7 = NewClosure function=f3
    v8 = Call v7, -, v6
    v9 = Construct v5
    Return
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = Integer integer=1
    v3 = NewObject v1, v2 layout=L0 fields=[0]
    Return v3
}
function f2 name="Q" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f3 name="f" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=L0 site=w0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="x"
    Return v1
}
