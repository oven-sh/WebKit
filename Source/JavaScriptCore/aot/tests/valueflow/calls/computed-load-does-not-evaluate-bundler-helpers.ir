# import { helper } from "bun:wrap"; helper(); loaded = require(name); loaded.helper()   built with two entry points, main.js and other.js
# What the bundler imports for the constructs that it lowers is Bun's own code in the form of a file of the program.
# A name that is put together at run time may spell "bun:wrap", and plain Bun answers it. So the helper that a module of the program imports is listed by its path and is among the answers of such a load,
# and what it exports is among the callees. The helper that nobody imports is not listed: the load neither evaluates nor answers it, and it stays unreached. An entry point of the program is answered
# The build excludes code outside the image, as a hardened Bun does: the run time refuses a file with code that is not in the image.
# OPTIONS: exclude=CodeOutsideImage
# RUN: valueflow-solve calls
# CHECK: f0 v1 -> f2
# CHECK-NEXT: f0 v6 ->
# CHECK-NOT: f4
# CHECK: f2 f6
# CHECK-NOT: f4
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3
# UNREACHED-NEXT: unreached f4
# UNREACHED-NOT: unreached f5
# UNREACHED-NOT: unreached f6
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen LoadsModuleByName f0:v4
# UNSEEN: unseen-code no
# UNSEEN-NEXT: modules-by-name yes

module m0 path="/app/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="bun:wrap" displayPath="bun:wrap" flags=[IsBundlerHelper] body=f1 exports=[{name="helper" variable=g0}]
module m2 path="/$bun/js/runtime.cjs" displayPath="runtime.cjs" kind=CommonJs flags=[IsBundlerHelper] exportRule=CommonJs requireResult=ModuleExports body=f3
module m3 path="/app/other.js" displayPath="other.js" body=f5 exports=[{name="helper" variable=g1}]
entry module=m0
entry module=m3
variable g0 name="helper" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="helper" module=m3 declared={type=anything} initialization=Undefined
variable g2 name="helper" module=m2 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Call v0, -
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="name" [isFreeName]
    v4 = RequireDynamic v3 referrer=m0
    v5 = PropGet v4 key="helper"
    v6 = Call v5, -
    Return
}
function f1 name="wrap" module=m1 kind=Module role=Library results=[{type=anything}] {
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="helperOfWrap" module=m1 role=Library results=[{type=anything}] {
    Return
}
function f3 name="runtime" module=m2 kind=CommonJsModule role=Library thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f4
    PutModuleVariable v0 variable=g2
    Return
}
function f4 name="helperOfRuntime" module=m2 role=Library results=[{type=anything}] {
    Return
}
function f5 name="other" module=m3 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f6
    PutModuleVariable v0 variable=g1
    Return
}
function f6 name="helperOfProgram" module=m3 results=[{type=anything}] {
    Return
}
