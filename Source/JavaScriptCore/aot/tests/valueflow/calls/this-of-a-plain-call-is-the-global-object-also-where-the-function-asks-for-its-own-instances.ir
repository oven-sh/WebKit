# function Made(v) { if (!(this instanceof Made)) return new Made(v); this.kept = v }   Made(1)   in code that is not strict
# ToThis answers with the global object where undefined arrives, and the type of its result says so. Every use of `this` stands behind the test, which the global object fails here, so the store meets instances alone.
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: function f1 name="Made" {{*}}thisType={type=undefined|L0}
# CHECK: [[converted]]: object = ToThis v1
# CHECK: : L0|builtin(GlobalThis) = AssumeType [[converted]] provenType=L0|builtin(GlobalThis)
# CHECK: PropSet {{*}}key="kept" {{*}}receivers=[L0]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Made" constructor=f1 fields=[{key="kept" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L1 kind=Environment fields=[{key="Made" declared={type=f1 flags=[IsFromCompiler]}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L1
    v1 = NewClosure v0 function=f1
    PutEnvironmentField v0, v1 layout=L1
    v3 = Integer integer=1
    v4 = Call v1, -, v3
    Return v4
}
function f1 name="Made" flags=[IsSloppy, HasThis] captures=[{type=env L1 flags=[IsFromCompiler]}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: env L1, v1: anything, v2: anything):
    v3 = ToThis v1
    v4 = GetEnvironmentField v0 layout=L1
    v5 = InstanceOf v3, v4
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    PropSet v3, v2 key="kept" mode=Sloppy
    v7 = Undefined
    Return v7
  b2():
    v8 = Construct v4, -, v2
    Return v8
}
