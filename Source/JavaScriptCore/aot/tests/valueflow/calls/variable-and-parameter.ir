# function twice(f) { f(); return f() }  twice(one)
# A call through a variable that a declaration fills has that function as its callee, and a call through a parameter what the callers pass. A function that nobody mentions is never reached.
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f1
# CHECK: f1 v1 -> f2
# CHECK: f1 v2 -> f2
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="twice" module=m0 declared={type=anything} initialization=Function function=f1
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1
    Return
}
function f1 name="twice" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0, -
    v2 = Call v0, -
    Return v2
}
function f2 name="one" module=m0 results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="never" module=m0 results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
