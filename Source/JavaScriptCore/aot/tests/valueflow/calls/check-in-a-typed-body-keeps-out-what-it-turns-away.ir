# function first(list: string[]) { const head: string = list[0]; return head.length }; first(["a"]); first(somethingNobodyKnows)
# In the typed body a check in the middle keeps out what it turns away, like the tests at the entry: behind it `head` is a string, whatever the array of the second caller holds.
# The check may fail, so the generic version runs too, on all that arrives at the function, and what it returns counts as returned by the typed body
# RUN: valueflow-solve split unreached calls
# CHECK-NOT: unreached f3
# CHECK-NOT: unreached f4

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Variable
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="a"
    v2 = NewArray v1 contents=string
    v3 = Call v0, -, v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="somethingNobodyKnows" [isFreeName]
    v6 = Call v0, -, v5
    Return
}
function f1 name="first" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=Array<string> site=w0}] results=[{type=anything}] {
  b0(v0: Array<string>):
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    v3 = Convert v2 declared={type=string site=w1}
    v4 = PropGet v3 key="length"
    Return v4
}
