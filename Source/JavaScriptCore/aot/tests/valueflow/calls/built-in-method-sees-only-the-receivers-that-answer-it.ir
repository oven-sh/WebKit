# class Sized { get length() { .. } }    function run(o) { return o.slice() }    run([1]); run(new Sized())
# In `o.m(..)` a built-in runs with a receiver as `this` only where the read of `m` from that receiver answers it. The instance has no `slice`: the call throws for it.
# So Array.prototype.slice sees the array alone, and nobody asks the instance for its length.
# class Like { get length() { .. } }  Like.prototype.slice = Array.prototype.slice;  new Like().slice(): this receiver answers the built-in, which asks it for its length.
