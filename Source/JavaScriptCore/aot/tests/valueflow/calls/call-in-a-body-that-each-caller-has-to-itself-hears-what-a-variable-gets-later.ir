# emit("request", target)        table = down1({ inner: { request: go } })        function emit(type, a) { table.inner[type](a) }  function go(f) { f() }  down1(o) { return down2(o) } .. down4(o) { return o }
# A function that calls what it has read under a parameter is followed once more for each constant that a call passes there. What it reads out of a variable of the module is no part of its body:
# it is the same for every such copy, and it may get its value long after the copy was entered. The call in `emit` finds `go` all the same, and `target` is called.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK-NOT: unreached f2
# CHECK-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Inner" fields=[{key="request" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Table" fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
variable g0 name="table" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f3
    v2 = String string="request"
    v3 = Call v0, -, v2, v1
    v4 = NewClosure function=f2
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = NewClosure function=f4
    v8 = Call v7, -, v6
    PutModuleVariable v8 variable=g0
    Return
}
function f1 name="emit" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g0
    v3 = PropGet v2 key="inner"
    v4 = ElemGet v3, v0
    v5 = Call v4, -, v1
    Return v5
}
function f2 name="go" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0, -
    Return v1
}
function f3 name="target" module=m0 results=[{type=anything}] {
  b0():
    Return
}
# REPEAT: i = 1..3
function f%(i+3) name="down%(i)" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f%(i+4)
    v2 = Call v1, -, v0
    Return v2
}
# END REPEAT
function f7 name="down4" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
