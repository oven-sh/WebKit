  b0():
    v0 = NewClosure function=f1
    v1 = Call v0, -
    v2 = Call v1, -
    Return
}
function f1 name="make" module=m0 results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="made" module=m0 results=[{type=anything}] {
  b0():
