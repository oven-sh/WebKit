# a = []; a.length = { valueOf: one }; b = []; b[name()] = { valueOf: two }; Reflect.set([], "length", { valueOf: three }); Object.assign([], { length: { valueOf: four } }); Object.defineProperty([], "length", { value: { valueOf: five } }); Object.defineProperties([], { length: { value: { valueOf: six } } }); Reflect.defineProperty([], "length", { value: { valueOf: seven } }); held = { valueOf: eight }; record = {}; the same seven with record and held; [].size = held
# An array keeps a number as its length. Whatever stores or defines an object under that name, or under a key nobody knows, runs the conversion that the object names. A record keeps the object, and so does an array under another name.
