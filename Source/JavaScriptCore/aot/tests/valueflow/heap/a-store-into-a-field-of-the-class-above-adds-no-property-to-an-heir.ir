# class Base { constructor(a) { this.a = a; this.b = 0 } get() { this.b++; return this.a } }  class Sub extends Base {}
# class Loose { constructor(a) { this.a = a; this.extra = 0 } }  class LooseSub extends Loose {}
# `new Sub(42)`: the constructor of Base makes the object with the layout of Sub, which lists no field of its own until flow has run. The store `this.a = a` goes
# into a field that Sub has from Base: it adds no property, and the class is left without a cause. `this.extra = 0` names no field of Loose or of LooseSub: that
# store adds a property to the heir, and is its cause. Appended fields are off so that the store is not made a field of LooseSub.
# OPTIONS: disable=flow:AppendedFields
# RUN: valueflow-results
# CHECK: class [[sub]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype] keys=NeverEnumerated addedKeysAreComplete=true
# CHECK-NOT: cause=
# CHECK: class [[loose]] layout=L2
# CHECK: class [[looseSub]] layout=L3 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] keys=NeverEnumerated addedKeys=["extra"] addedKeysAreComplete=true cause=PropertyAdded
# RUN(APPLY): valueflow-apply
# APPLY: layout L1 kind=Instance name="Sub" {{*}} flow={baseState=Layout base=L0 allocationClasses=[1] constructorOrders=[{}] fieldCreation=OnlyAtConstruction impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype] keys=NeverEnumerated addedKeysAreComplete=true neverEscapes=true}
# APPLY: layout L3 kind=Instance name="LooseSub" {{*}} flow={baseState=Layout base=L2 allocationClasses=[3] constructorOrders=[{}] cause=PropertyAdded impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, RedefineProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] keys=NeverEnumerated addedKeys=["extra"] addedKeysAreComplete=true neverEscapes=true}

