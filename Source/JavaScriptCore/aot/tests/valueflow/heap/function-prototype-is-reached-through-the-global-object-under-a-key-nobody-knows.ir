# Object.defineProperty(globalThis[target].prototype, key, { value: installed })        [].slice.demethodize()        other.demethodize()
# The export helper of core-js. A read of the global object under a key nobody knows hands out no built-in that lets in unseen code: should it answer with `Function`, the run time refuses the application.
# It refuses nothing else. Whoever gets `Function` this way reads `prototype` from it, and what it defines on that object every function inherits, a built-in one and one of the program.
# RUN: valueflow-solve calls
# CHECK: f0 v13 ->{{*}} f1
# CHECK: f0 v16 ->{{*}} f1
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen-code no

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Descriptor" fields=[{key="value" declared={type=anything}}, {key="writable" declared={type=anything}}, {key="configurable" declared={type=anything}}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="name" [isFreeName]
    v2 = ElemGet v0, v1
    v3 = PropGet v2 key="prototype"
    v4 = NewClosure function=f1
    v5 = Boolean boolean=true
    v6 = NewObject -, v4, v5, v5 layout=L0 fields=[0, 1, 2]
    v7 = Builtin builtin=Object
    v8 = Builtin builtin=ObjectDefineProperty
    v9 = Call v8, v7, v3, v1, v6
    v10 = Builtin builtin=ArrayPrototypeSlice
    v11 = NewClosure function=f2
    v12 = PropGet v10 key="demethodize"
    v13 = Call v12, v10
    v14 = Undefined
    v15 = PropGet v11 key="demethodize"
    v16 = Call v15, v11
    Return v16
}
function f1 name="installed" module=m0 results=[{type=anything}] {
    v0 = Integer integer=1
    Return v0
}
function f2 name="other" module=m0 results=[{type=anything}] {
    v0 = Integer integer=2
    Return v0
}
