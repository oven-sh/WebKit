# bind reads `name` and `length` of the function it binds. A function object that has both as it was created with them answers by itself: the getter that stands under `name` on another function is entered with that other function alone.
# RUN: valueflow-solve calls
# CHECK: f3 v1 -> f2
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="GetterDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=ObjectDefineProperty
    v3 = String string="name"
    v4 = NewClosure function=f3
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = Call v2, -, v1, v3, v5
    v7 = Builtin builtin=FunctionPrototypeBind
    v8 = Call v7, v0
    v9 = Call v7, v1
    Return
}
function f1 name="asCreated" results=[{type=anything}] {
    Return
}
function f2 name="renamed" results=[{type=anything}] {
    Return
}
function f3 name="getter" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = Call v0
    Return
}
