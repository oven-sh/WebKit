# shown = {}; kept = {}; base = { who: one }; unknown = somethingNoTableLists; unknown.held = shown; unknown.__proto__ = base; shown.who(); kept.who()
# A store under `__proto__` through the unknown object runs the setter of the table, so whatever has escaped may inherit from what is stored. An object that has not escaped keeps its chain.
# RUN: valueflow-solve calls
# CHECK: f0 v9 -> f1
# CHECK-NOT: f0 v11 -> {{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Shown"
layout L1 name="Kept"
layout L2 name="Base" fields=[{key="who" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module parameters=[] results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewObject layout=L1 fields=[]
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L2 fields=[0]
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="somethingThatNoTableLists" [isFreeName]
    PropSet v5, v0 key="held" mode=Strict
    PropSet v5, v3 key="__proto__" mode=Strict
    v8 = PropGet v0 key="who"
    v9 = Call v8, v0
    v10 = PropGet v1 key="who"
    v11 = Call v10, v1
    Return
}
function f1 name="one" results=[{type=anything}] {
    Return
}
