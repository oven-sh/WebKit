# table = { run: 1, stop: 2 }; names = ["run", "stop"]; table[names[0]]    others = ["run", "written nowhere else"]; others[0]
# A list whose elements are all constants is one Data operation. A text in it that is a name of the program is that name, as it is in a list with a variable in it, so the read under it
# is a read under two names. A text that names nothing is a text nobody knows (primitive7).
# RUN: valueflow-why values=f0:v3 values=f0:v7 values=f0:v9
# CHECK: values=f0:v3
# CHECK: result {{*}} 3 members: primitive0 key{{*}} key{{*}}
# CHECK: values=f0:v7
# CHECK: operand 1 {{*}} 2 members: key{{*}} key{{*}}
# CHECK: values=f0:v9
# CHECK: result {{*}} 3 members: primitive0 primitive7 key{{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Record name="Table" fields=[{key="run" declared={type=number} flags=[IsRequired]}, {key="stop" declared={type=number} flags=[IsRequired]}]
data d0 root=Object{layout=L0 members=[{key="run" value=Number{value=1}}, {key="stop" value=Number{value=2}}]} module=m0
data d1 root=Array{contents=string elements=[String{value="run"}, String{value="stop"}]} module=m0
data d2 root=Array{contents=string elements=[String{value="run"}, String{value="written nowhere else"}]} module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Data data=d1
    v2 = Integer integer=0
    v3 = ElemGet v1, v2
    v4 = TypeTest v3 testedType=undefined
    Branch v4 -> taken b1(| 0), notTaken b2(| 0)
  b1(v5):
    Return
  b2(v6):
    v7 = ElemGet v0, v6
    v8 = Data data=d2
    v9 = ElemGet v8, v2
    Return v9
}
