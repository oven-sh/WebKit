    v3 = NewClosure function=f1
    PutModuleVariable v3 variable=g0
    v5 = GetModuleVariable variable=g0
    PropSet v5, v0 key="mark" mode=Sloppy
    v7 = Call v2
    v8 = GetModuleVariable variable=g0
    v9 = PropGet v8 key="mark"
    v10 = Call v9
    v11 = NewClosure function=f2
    PutModuleVariable v11 variable=g1
    v13 = Call v2
    v14 = GetModuleVariable variable=g1
    PropSet v14, v0 key="mark" mode=Sloppy
    v16 = Call v2
    v17 = GetModuleVariable variable=g1
    v18 = PropGet v17 key="mark"
    v19 = Call v18
    v20 = NewClosure function=f3
    PutModuleVariable v20 variable=g2
    v22 = GetModuleVariable variable=g2
    PropSet v22, v0 key="mark" mode=Sloppy
    v24 = NewClosure function=f3
    PutModuleVariable v24 variable=g4
    v26 = Call v2
    v27 = GetModuleVariable variable=g4
    v28 = PropGet v27 key="mark"
    v29 = Call v28
    v30 = NewClosure function=f4
