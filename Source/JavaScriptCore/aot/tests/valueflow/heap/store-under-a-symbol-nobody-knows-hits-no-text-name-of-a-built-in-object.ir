# globalThis[Symbol.for(text)] = { run }; Date.now()
# The text is not known, so the symbol is not. But it is a symbol: no global that anybody reads by its name lies under it, and the members of the global object stay what the table says
# RUN: valueflow-apply
# CHECK: = Call {{*}} callees=[builtin(DateNow)]
# RUN(RESULTS): valueflow-results
# RESULTS: builtin-location GlobalThis."Date" Constant
# RESULTS: builtin-location Date."now" Constant

layout L0 fields=[{key="run" declared={type=anything}}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Symbol
    v1 = Builtin builtin=SymbolFor
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="text" [isFreeName]
    v4 = Call v1, v0, v3
    v5 = NewClosure function=f1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    ElemSet v2, v4, v6
    v8 = PropGet v2 key="Date" [isFreeName]
    v9 = PropGet v8 key="now"
    v10 = Call v9, v8
    Return
}
function f1 name="run" results=[{type=anything}] {
    Return
}
