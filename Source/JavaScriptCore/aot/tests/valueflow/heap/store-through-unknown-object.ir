# kept = {}; shown = {}; unknown = somethingNoTableLists; unknown.held = shown; unknown.run = one; shown.run(); kept.run()
# The unknown object stands for what has reached native code. What is stored through it is found on an object that has escaped, and on no other.
# RUN: valueflow-solve calls
# CHECK: f0 v10 -> f1
# CHECK-NOT: f0 v12 -> {{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Kept"
layout L1 name="Shown"
function f0 name="main" kind=Module parameters=[] results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewObject layout=L1 fields=[]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="somethingThatNoTableLists" [isFreeName]
    PropSet v3, v1 key="held" mode=Strict
    v5 = NewClosure function=f1
    PropSet v3, v5 key="run" mode=Strict
    v7 = Integer integer=0
    v8 = Integer integer=0
    v9 = PropGet v1 key="run"
    v10 = Call v9, v1
    v11 = PropGet v0 key="run"
    v12 = Call v11, v0
    Return
}
function f1 name="one" results=[{type=anything}] {
    Return
}
