# table = {}; table["c" + name](): `constructor` begins with "c", so the read may find Object.   below = Object.create(RegExp); below["$" + name]: members of RegExp begin with "$".
# RUN: valueflow-solve calls
# CHECK: f0 v6 -> {{*}}Object
# RUN(REGEXP): valueflow-why values=f1:v7
# REGEXP: result {{*}}primitive

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewDictionary
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="name" [isFreeName]
    v3 = String string="c"
    v4 = Add v3, v2
    v5 = ElemGet v0, v4
    v6 = Call v5, v0
    v7 = NewClosure function=f1
    v8 = Call v7
    Return
}
function f1 name="second" results=[{type=anything}] {
    v0 = Builtin builtin=RegExp
    v1 = Builtin builtin=ObjectCreate
    v2 = Call v1, -, v0
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="name" [isFreeName]
    v5 = String string="$"
    v6 = Add v5, v4
    v7 = ElemGet v2, v6
    Return v7
}
