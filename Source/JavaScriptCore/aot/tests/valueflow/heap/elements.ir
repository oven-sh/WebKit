# list = [one]; list.push-like append of two; list[0](); list.named = three; list[0] does not find it; other = [four]; other[1]()
# What an array is made with, what is appended and what is stored under a number lie together, apart from the names and apart from other arrays.
# RUN: valueflow-solve calls
# CHECK: f0 v8 -> f1 f2 f5
# CHECK: f0 v13 -> f4
# CHECK-NOT: f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewArray v0 contents=anything
    v2 = NewClosure function=f2
    AppendElement v1, v2
    v4 = NewClosure function=f3
    PropSet v1, v4 key="named" mode=Strict
    v6 = Integer integer=0
    v7 = ElemGet v1, v6
    v8 = Call v7, v1
    v9 = NewClosure function=f4
    v10 = NewArray v9 contents=anything
    v11 = Integer integer=1
    v12 = ElemGet v10, v11
    v13 = Call v12, v10
    v14 = NewClosure function=f5
    ElemSet v1, v11, v14 mode=Strict
    Return
}
function f1 name="one" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="two" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="three" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="four" results=[{type=anything}] {
  b0():
    Return
}
function f5 name="five" results=[{type=anything}] {
