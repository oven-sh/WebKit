}
function f1 name="defineAll" kind=Arrow length=2 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ForInOpen v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = ForInStep v2, v1
