    v7 = Call v6, v3
    v8 = PropGet v3 key="toString"
    v9 = Call v8, v3
    v10 = Builtin builtin=ObjectGetPrototypeOf
    v11 = Call v10, -, v3
    v12 = PropGet v11 key="run"
