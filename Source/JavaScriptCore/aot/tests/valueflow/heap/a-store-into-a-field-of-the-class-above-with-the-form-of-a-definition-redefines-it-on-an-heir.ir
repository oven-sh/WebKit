# class Base { constructor() { this.fixed = 1 } }  class Sub extends Base {}  new Base(); new Sub()
# The layout of Base gives `fixed` the form of a definition that never runs. The store finds no property and creates an ordinary one, which the slot of the field does not hold: that is a
# redefinition, on an object made for Base and on one made for Sub alike. Sub lists no field of its own until flow has run: the field with the form is one it has from Base.
# RUN: valueflow-apply
# CHECK: layout L0 kind=Instance name="Base" {{*}} cause=PropertyRedefined
# CHECK: layout L1 kind=Instance name="Sub" {{*}} cause=PropertyRedefined
# RUN(RESULTS): valueflow-results
# RESULTS: class [[base]] layout=L0 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] keys=NeverEnumerated addedKeysAreComplete=true cause=PropertyRedefined
# RESULTS: class [[sub]] layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript, DeleteField, AddProperty, ChangeIntegrity, ChangePrototype, BecomePrototype, StoreOfOtherType] keys=NeverEnumerated addedKeysAreComplete=true cause=PropertyRedefined

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="fixed" declared={type=anything} form=[IsReadOnly, IsNotEnumerable, IsNotConfigurable]}]
layout L1 kind=Instance name="Sub" base=L0 constructor=f2 supertypes=[L0] flags=[HasHeritage]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v2
    v8 = Construct v6
    v9 = PropGet v7 key="fixed"
    v10 = PropGet v8 key="fixed"
    v11 = Add v9, v10
    Return v11
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="fixed" mode=Strict
    Return v2
}
function f2 name="Sub" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
