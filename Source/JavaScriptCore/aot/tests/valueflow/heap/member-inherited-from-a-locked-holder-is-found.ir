# CHECK: variable g7 name="pushBelowSetter" module=m0 declared={type=undefined|builtin(ArrayPrototypePush)}
# CHECK: variable g8 name="toStringOfNullObject" module=m0 declared={type=undefined}
# CHECK: variable g9 name="nothingOfArray" module=m0 declared={type=undefined}

