# `Object.defineProperty(f, "name", { value })` marks the function as redefined. A lookup of `bind` passes the function and still surely comes to Function.prototype.bind: nothing was defined under that name.
# Under the name that was redefined, and under every name once the key is not known, an accessor without a getter may lie there, and the lookup may answer undefined.
# FORM: AsRead
# RUN: flow
# CHECK: function f1 result 0 type=builtin(FunctionPrototypeBind) proven
# CHECK: function f2 result 0 type=undefined|builtin(FunctionPrototypeBind) proven
# CHECK: function f3 result 0 type=undefined|builtin(FunctionPrototypeBind) proven

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="ValueDescriptor" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
layout L1 name="SetterDescriptor" fields=[{key="set" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    v2 = CallDirect function=f3
    Return v0
}
function f1 name="otherName" results=[{type=anything}] {
    v0 = NewClosure function=f4
    v1 = Builtin builtin=ObjectDefineProperty
    v2 = String string="name"
    v3 = String string="other"
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = Call v1, -, v0, v2, v4
    v6 = PropGet v0 key="bind"
    Return v6
}
function f2 name="sameName" results=[{type=anything}] {
    v0 = NewClosure function=f5
    v1 = Builtin builtin=ObjectDefineProperty
    v2 = String string="bind"
    v3 = NewClosure function=f7
    v4 = NewObject -, v3 layout=L1 fields=[0]
    v5 = Call v1, -, v0, v2, v4
    v6 = PropGet v0 key="bind"
    Return v6
}
function f3 name="unknownName" results=[{type=anything}] {
    v0 = NewClosure function=f6
    v1 = Builtin builtin=ObjectDefineProperty
    v2 = Builtin builtin=MathRandom
    v3 = Call v2
    v4 = ToString v3
    v5 = NewClosure function=f7
    v6 = NewObject -, v5 layout=L1 fields=[0]
    v7 = Call v1, -, v0, v4, v6
    v8 = PropGet v0 key="bind"
    Return v8
}
function f4 name="first" kind=Arrow results=[{type=anything}] {
    Return
}
function f5 name="second" kind=Arrow results=[{type=anything}] {
    Return
}
function f6 name="third" kind=Arrow results=[{type=anything}] {
    Return
}
function f7 name="taker" kind=Arrow length=1 parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
