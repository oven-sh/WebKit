# function pick(given: any) { const kind: string | null | undefined = given; if (kind === null) none(); else if (kind === undefined) missing(); else other(); }    pick("x");
# A block that one edge leads to is entered only where the test on that edge can pass. Nothing that arrives in `kind` is null or undefined, so neither arm runs and what they call is not reached.
# The third arm stands behind both tests, and something is left of `kind` behind each.
