# A loop that narrows its own value keeps one node for the value and one for the filter.
# RUN: valueflow-body f0
# CHECK: body f0: nodes=5 sites=0 edges=4 edgesOnceReached=0 seeds=1 statements=0
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 result
# CHECK-NEXT: n2 thrown
# CHECK-NEXT: n3 merge v1
# CHECK-NEXT: n4 filter - undefined
# CHECK-NEXT: edge n0 -> n3
# CHECK-NEXT: edge n3 -> n1
# CHECK-NEXT: edge n3 -> n4
# CHECK-NEXT: edge n4 -> n3
# CHECK-NEXT: reached: seed n2 <- unknown
# CHECK-NEXT: observed v3: n3

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="narrowsInALoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1(v0)
  b1(v1):
    LoopHint
    v3 = TypeTest v1 testedType=undefined
    Branch v3 -> taken b2(| 0), notTaken b1(| 0)
  b2(v4):
    Return v1
}
