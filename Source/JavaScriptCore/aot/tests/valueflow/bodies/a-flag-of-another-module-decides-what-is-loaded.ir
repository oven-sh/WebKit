function f0 module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = ToBoolean v0
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    EvaluateModule module=m2 referrer=m0 [isCallOfRequire]
    Jump -> next b3()
  b2(v4):
    Jump -> next b3()
  b3():
    v5 = GetModuleVariable variable=g1
    v6 = String string="development"
    v7 = StrictEq v5, v6
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    EvaluateModule module=m3 referrer=m0 [isCallOfRequire]
    Jump -> next b5()
  b5():
    v9 = GetModuleVariable variable=g2
    v10 = ToBoolean v9
    Branch v10 -> taken b6(| 0), notTaken b7(| 0)
  b6(v11):
    EvaluateModule module=m4 referrer=m0 [isCallOfRequire]
    Jump -> next b8()
  b7(v13):
    Jump -> next b8()
  b8():
    v14 = GetModuleVariable variable=g3
    v15 = ToBoolean v14
    Branch v15 -> taken b9(| 0), notTaken b10(| 0)
  b9(v16):
    EvaluateModule module=m5 referrer=m0 [isCallOfRequire]
    Return
  b10(v18):
    Return
}
function f1 module=m1 kind=CommonJsModule results=[{type=anything}] {
    v0 = Boolean
    PutModuleVariable v0 variable=g0
    v2 = String string="production"
    PutModuleVariable v2 variable=g1
