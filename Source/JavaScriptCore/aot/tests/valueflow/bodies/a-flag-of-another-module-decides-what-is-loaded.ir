# k.cjs: exports.DEBUG = false; exports.MODE = "production"; exports.ON = true;
# main.ts: import { DEBUG, MODE, ON } from "./k.cjs"; if (DEBUG) require("./debug"); if (MODE === "development") require("./development"); if (ON) require("./on");
# A statement runs only where the tests in front of its block can pass, in a body of the program without a check too where the tested value is a variable of another module.
# Nothing truthy arrives in DEBUG and no "development" in MODE, so the two files are not loaded. A variable of the module itself is not read that way.
# RUN: valueflow-solve unreached
# CHECK: unreached f2
# CHECK: unreached f3
# CHECK-NOT: unreached f4
# CHECK-NOT: unreached f5

module m0 path="main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}, {target=m2 kind=Require completes=true}, {target=m3 kind=Require completes=true}, {target=m4 kind=Require completes=true}, {target=m5 kind=Require completes=true}]
module m1 path="k.cjs" displayPath="k.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
module m2 path="debug.ts" displayPath="debug.ts" body=f2
module m3 path="development.ts" displayPath="development.ts" body=f3
module m4 path="on.ts" displayPath="on.ts" body=f4
module m5 path="own.ts" displayPath="own.ts" body=f5
