# A conversion to an object lets the objects through and makes a wrapper of its class for each kind of primitive that the operand may be. Of an operand that is always an object nothing is made.
# RUN: valueflow-body f0
# CHECK: body f0: nodes=6 sites=5 edges=2 edgesOnceReached=0 seeds=3 statements=2
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 parameter v1 : object
# CHECK-NEXT: n2 result
# CHECK-NEXT: n3 thrown
# CHECK-NEXT: n4 merge v2
# CHECK-NEXT: n5 filter & object
# CHECK-NEXT: s0 v2 class=String
# CHECK-NEXT: s1 v2 class=Number
# CHECK-NEXT: s2 v2 class=Boolean
# CHECK-NEXT: s3 v2 class=Symbol
# CHECK-NEXT: s4 v2 class=BigInt
# CHECK-NEXT: edge n0 -> n5
# CHECK-NEXT: edge n5 -> n4
# CHECK-NEXT: reached: seed n2 <- undefined
# CHECK-NEXT: reached: seed n3 <- unknown
# CHECK-NEXT: reached: seed n4 <- s0 | s1 | s2 | s3 | s4
# CHECK-NEXT: PropGet v3 (n4) throws n3
# CHECK-NEXT: PropGet v5 (n1 & object) throws n3

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="wraps" parameters=[{type=anything}, {type=object}] results=[{type=anything}] {
  b0(v0: anything, v1: object):
    v2 = ToObject v0
    v3 = PropGet v2 key="a"
    v4 = ToObject v1
    v5 = PropGet v4 key="a"
    Return
}
