layout L0 name="Record" fields=[{key="a" declared={type=number}}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="functionTestedTwice" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=boolean
    v2 = TypeTest v1 testedType=function
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Jump -> next b3(v3)
  b2(v4):
    Jump -> next b3(v4)
  b3(v5):
    v6 = TypeTest v5 testedType=function
    Branch v6 -> taken b4(| 0), notTaken b5(| 0)
  b4(v7):
    Return v7
  b5(v8):
    Return v8
}
function f1 name="layoutTestedTwice" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=boolean
    v2 = TypeTest v1 testedType=L0
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Jump -> next b3(v3)
  b2(v4):
    Jump -> next b3(v4)
  b3(v5):
    v6 = TypeTest v5 testedType=L0
    Branch v6 -> taken b4(| 0), notTaken b5(| 0)
  b4(v7):
    Return v7
  b5(v8):
    Return v8
}
function f2 name="everyArgumentTookTheOtherSide" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Check v0 expectedType=boolean
    v3 = TypeTest v2 testedType=function
    Branch v3 -> taken b1(| 0), notTaken b7()
  b1(v4):
    v5 = ToBoolean v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b4(v4)
  b3():
    Jump -> next b4(v4)
  b4(v6):
    v7 = TypeTest v6 testedType=function
    Branch v7 -> taken b5(| 0), notTaken b6(| 0)
  b5(v8):
    Return v8
  b6(v9):
    Return v9
  b7():
    v10 = Undefined
    Return v10
}
function f3 name="joinIsLoopHeader" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=boolean
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = TypeTest v2 testedType=function
    Branch v4 -> taken b2(| 0), notTaken b3(| 0)
  b2(v5):
    Jump -> next b1(v5)
  b3(v6):
    Return v6
}
function f4 name="nineBlocksBetween" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Check v0 expectedType=boolean
    v2 = TypeTest v1 testedType=function
    Branch v2 -> taken b1(| 0), notTaken b10(| 0)
  b1(v3):
    Jump -> next b2(v3)
  b2(v4):
    Jump -> next b3(v4)
  b3(v5):
    Jump -> next b4(v5)
  b4(v6):
    Jump -> next b5(v6)
  b5(v7):
    Jump -> next b6(v7)
  b6(v8):
    Jump -> next b7(v8)
  b7(v9):
    Jump -> next b8(v9)
  b8(v10):
    Jump -> next b9(v10)
  b9(v11):
    Jump -> next b11(v11)
  b10(v12):
    Jump -> next b11(v12)
  b11(v13):
    v14 = TypeTest v13 testedType=function
    Branch v14 -> taken b12(| 0), notTaken b13(| 0)
  b12(v15):
    Return v15
  b13(v16):
    Return v16
}
