# CHECK-NEXT: n6 filter - L0
# CHECK-NEXT: n7 filter & L0
# CHECK-NEXT: n8 filter - L0
# CHECK-NEXT: edge n0 -> n3
# CHECK-NEXT: edge n3 -> n5
# CHECK-NEXT: edge n3 -> n6
# CHECK-NEXT: edge n4 -> n7
# CHECK-NEXT: edge n4 -> n8
# CHECK-NEXT: edge n5 -> n4
# CHECK-NEXT: edge n6 -> n4
# CHECK-NEXT: edge n7 -> n1
# CHECK-NEXT: edge n8 -> n1
# CHECK-NEXT: observed v2: n3
# CHECK-NEXT: observed v6: n4
# CHECK-NEXT: observed v1: n0
# CHECK-NEXT: body f2: nodes=9 sites=0 edges=6 edgesOnceReached=0 seeds=2 statements=0
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 parameter v1
# CHECK-NEXT: n2 result
# CHECK-NEXT: n3 thrown
# CHECK-NEXT: n4 filter v2 : boolean
# CHECK-NEXT: n5 filter v6 & function
# CHECK-NEXT: n6 merge
# CHECK-NEXT: n7 filter & function
# CHECK-NEXT: n8 filter & never
# CHECK-NEXT: edge n0 -> n4
# CHECK-NEXT: edge n4 -> n5
# CHECK-NEXT: edge n5 -> n7
# CHECK-NEXT: edge n5 -> n8
# CHECK-NEXT: edge n7 -> n2
# CHECK-NEXT: edge n8 -> n2
# CHECK-NEXT: reached: seed n2 <- undefined
# CHECK-NEXT: reached: seed n6 <- undefined
# CHECK-NEXT: returns n0 & function as it came, the rest in n6
# CHECK-NEXT: returns n0 & never & function as it came, the rest in n6
# CHECK-NEXT: observed v3: n4
# CHECK-NEXT: observed v5: n1
# CHECK-NEXT: observed v7: n5
# CHECK-NEXT: observed v2: n0
# CHECK-NEXT: body f3: nodes=9 sites=0 edges=7 edgesOnceReached=0 seeds=1 statements=0
# CHECK-NEXT: n0 parameter v0
