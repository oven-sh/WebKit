# Two values that meet get a node only where an operand reads them. What is only returned becomes one edge from each source, and a node that meets a constant is one operand that holds both.
# RUN: valueflow-body f0 f1 f2
# CHECK: body f0: nodes=6 sites=0 edges=2 edgesOnceReached=0 seeds=1 statements=1
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 parameter v1
# CHECK-NEXT: n2 parameter v2 & boolean
# CHECK-NEXT: n3 result
# CHECK-NEXT: n4 thrown
# CHECK-NEXT: n5 merge v3
# CHECK-NEXT: edge n0 -> n5
# CHECK-NEXT: edge n1 -> n5
# CHECK-NEXT: reached: seed n3 <- undefined
# CHECK-NEXT: PropGet v4 (n5) throws n4
# CHECK-NEXT: body f1: nodes=5 sites=0 edges=2 edgesOnceReached=0 seeds=0 statements=0
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 parameter v1
# CHECK-NEXT: n2 parameter v2 & boolean
# CHECK-NEXT: n3 result
# CHECK-NEXT: n4 thrown
# CHECK-NEXT: edge n0 -> n3
# CHECK-NEXT: edge n1 -> n3
# CHECK-NEXT: body f2: nodes=4 sites=0 edges=0 edgesOnceReached=0 seeds=1 statements=1
# CHECK-NEXT: n0 parameter v0
# CHECK-NEXT: n1 parameter v1 & boolean
# CHECK-NEXT: n2 result
# CHECK-NEXT: n3 thrown
# CHECK-NEXT: reached: seed n2 <- undefined
# CHECK-NEXT: PropGet v4 (n0 | null) throws n3

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="mergeReadByAnOperand" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Branch v2 -> taken b1(v0), notTaken b1(v1)
  b1(v3):
    v4 = PropGet v3 key="a"
    Return
}
function f1 name="mergeThatIsOnlyReturned" parameters=[{type=anything}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: boolean):
    Branch v2 -> taken b1(v0), notTaken b1(v1)
  b1(v3):
    Return v3
}
function f2 name="nodeAndConstant" parameters=[{type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: anything, v1: boolean):
    v2 = Null
    Branch v1 -> taken b1(v0), notTaken b1(v2)
  b1(v3):
    v4 = PropGet v3 key="a"
    Return
}
