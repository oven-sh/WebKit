# for (const x of give()) x()
# The unknown object stands for built-in containers and iterators too: a loop over it gives the unknown value, and the library's function behind next of the built-in iterators is entered.
# RUN: valueflow-solve calls
# CHECK: f0 v8 -> unknown
# RUN(LOOP): valueflow-solve unreached
# LOOP-NOT: unreached f1

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
entry module=m0
runtimefunction id=ArrayIteratorPrototypeNext function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="give" [isFreeName]
    v2 = Call v1, -
    v3 = IteratorOpen v2
    v4 = IteratorResume v3
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    v7 = Undefined
    v8 = Call v6
    Return
}
function f1 name="next" module=m1 role=Library flags=[HasThis] enclosingRuntimeFunction=ArrayIteratorPrototypeNext results=[{type=anything}] {
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler]}
    v2 = StepArrayIterator v1
    v3 = ResultAt v2 index=1
    v4 = ResultAt v2
    v5 = CreateIteratorResult v3, v4
    Return v5
}
