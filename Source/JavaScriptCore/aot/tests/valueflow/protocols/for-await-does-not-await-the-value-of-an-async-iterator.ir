# for await (own of { [Symbol.asyncIterator]() { return { async next() { return { value: load(), done: false } } } } }) ;
# for await (wrapped of { [Symbol.iterator]() { return { next() { return { value: load(), done: false } } } } }) ;  for await (element of [load()]) ;
# async function* delegates() { yield* ownIterable }  for await (delegated of delegates()) ;  async function* yields() { yield await load() }  for await (yielded of yields()) ;
# An asynchronous loop awaits what the method `next` of an asynchronous iterator answers and never the value in that answer: the promise that such an iterator hands out is what the loop binds.
# `yield*` in an async generator hands it on as it got it. Only the wrapper around a synchronous iterator awaits the values, and an async generator what it yields by itself.
# The state of a loop does not say by which of the two methods an iterator of the program came, so what a synchronous one hands out counts both awaited and as it is. An array's elements are awaited and nothing else.
# RUN: valueflow-apply
# CHECK-LABEL: variable g0 name="own"
# CHECK: declared={type={{*}}Promise
# CHECK-LABEL: variable g1 name="wrapped"
# CHECK: declared={type={{*}}int
# CHECK-LABEL: variable g2 name="element"
# CHECK: declared={type=undefined|int}
# CHECK-LABEL: variable g3 name="delegated"
# CHECK: declared={type={{*}}Promise
# CHECK-LABEL: variable g4 name="yielded"
# CHECK: declared={type=undefined|int}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
