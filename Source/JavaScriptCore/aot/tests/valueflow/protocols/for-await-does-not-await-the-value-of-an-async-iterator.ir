    v2 = IteratorOpen v1 iteratorKind=Async
    v3 = IteratorResume v2 iteratorKind=Async
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    PutModuleVariable v5 variable=g0
    v7 = NewClosure function=f5
    v8 = NewObject -, v7 layout=L3 fields=[0]
    v9 = IteratorOpen v8 iteratorKind=Async
    v10 = IteratorResume v9 iteratorKind=Async
    v11 = ResultAt v10
    v12 = ResultAt v10 index=1
    PutModuleVariable v12 variable=g1
    v14 = NewClosure function=f2
    v15 = Call v14
