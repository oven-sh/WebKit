    v17 = IteratorOpen v16 iteratorKind=Async
    v18 = IteratorResume v17 iteratorKind=Async
    v19 = ResultAt v18
    v20 = ResultAt v18 index=1
    PutModuleVariable v20 variable=g2
    v22 = NewClosure function=f7
    v23 = Call v22
    v24 = IteratorOpen v23 iteratorKind=Async
    v25 = IteratorResume v24 iteratorKind=Async
    v26 = ResultAt v25
    v27 = ResultAt v25 index=1
    PutModuleVariable v27 variable=g3
    v29 = NewClosure function=f8
    v30 = Call v29
    v31 = IteratorOpen v30 iteratorKind=Async
    v32 = IteratorResume v31 iteratorKind=Async
    v33 = ResultAt v32
    v34 = ResultAt v32 index=1
    PutModuleVariable v34 variable=g4
    Return
}
function f2 name="load" flags=[IsAsync] results=[{type=anything}] {
