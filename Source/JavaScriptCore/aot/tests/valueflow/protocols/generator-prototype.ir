# function* numbers() {}  numbers.prototype.extra = one; numbers().extra()
# The generators of a function inherit from its prototype object: what the program puts there is found on them.
# RUN: valueflow-solve calls
# CHECK: f0 v7 -> f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f2
    PropSet v1, v2 key="extra" mode=Strict
    v4 = Call v0
    v5 = PropGet v4 key="extra"
    v6 = Undefined
    v7 = Call v5, v4
    Return
}
function f1 name="numbers" flags=[IsGenerator, TakesCallee] results=[{type=anything}] {
    InitialYield
    Return
}
function f2 name="one" results=[{type=anything}] {
    Return
}
