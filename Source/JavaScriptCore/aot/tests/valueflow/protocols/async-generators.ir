    v8 = Call v0
    v9 = PropGet v8 key="next"
    v10 = Call v9, v8 calleeKey="next"
    v11 = Await v10
    v12 = PropGet v11 key="value"
    v13 = Undefined
    v14 = Call v12
    Return
}
