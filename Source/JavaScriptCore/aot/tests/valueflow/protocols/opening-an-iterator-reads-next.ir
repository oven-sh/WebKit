# const [] = { [Symbol.iterator]() { return { get next() {} } } }
# Whoever opens an iterator reads `next`, whether or not a step follows.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK-NOT: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Iterable"
layout L1 name="Steps"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0 fields=[]
    v1 = NewClosure function=f1
    PropSet v0, v1 key=@@iterator mode=Strict
    v3 = IteratorOpen v0 elementCount=0 [isDestructuring]
    IteratorClose v3
    Return
}
function f1 name="iterator" results=[{type=anything}] {
    v0 = NewObject layout=L1 fields=[]
    v1 = NewClosure function=f2
    DefineGetter v0, v1 key="next"
    Return v0
}
function f2 name="next" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
