# (await load()).then(); async function outer() { changed = loadOther(); changed.then = 1; changed.mark = two; return changed }  (await outer()).mark()
# A promise of the realm is a thenable, so awaiting it never gives the promise itself: nothing of Promise.prototype is found on what the await gives.
