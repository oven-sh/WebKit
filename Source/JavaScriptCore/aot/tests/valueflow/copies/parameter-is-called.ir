# A helper that calls what it is given: in the copy at each call site the callback of that call gets the elements of the array of that call. What holds for the helper's own operation is gathered from all copies: it calls both callbacks.
# OPTIONS: limit=MaxValueFlowCopiedNodesPercent:100
# RUN: valueflow-solve calls
# CHECK: f0 v4 -> f1
# CHECK-NEXT: f0 v8 -> f1
# CHECK-NEXT: f1 v4 -> f4 f5
# CHECK-NEXT: f4 v1 -> f2
# CHECK-NEXT: f5 v1 -> f3
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# UNREACHED-NOT: unreached f4
# UNREACHED-NOT: unreached f5

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="forEach" module=m0 declared={type=anything} initialization=Function function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure function=f2
    v2 = NewArray v1 contents=anything
    v3 = NewClosure function=f4
    v4 = Call v0, -, v2, v3
    v5 = NewClosure function=f3
    v6 = NewArray v5 contents=anything
    v7 = NewClosure function=f5
    v8 = Call v0, -, v6, v7
    Return
}
function f1 name="forEach" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    v3 = ElemGet v0, v2
    v4 = Call v1, -, v3
    Return
}
function f2 name="inFirstArray" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="inSecondArray" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f4 name="overFirstArray" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
function f5 name="overSecondArray" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    Return
}
