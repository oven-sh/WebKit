# A call whose callee is one known function that hands a parameter on has a copy of that function's body for itself: each call of identity gives back what that call passes, and nothing that another call passes.
# OPTIONS: limit=MaxValueFlowCopiedNodesPercent:100
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f1
# CHECK-NEXT: f0 v3 -> f2
# CHECK-NEXT: f0 v5 -> f1
# CHECK-NEXT: f0 v6 -> f3
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# RUN(BODY): valueflow-body copies f0
# BODY: body f0: nodes=10 sites=8 edges=6 edgesOnceReached=0 seeds=3 statements=5
# BODY-NEXT: n0 result
# BODY-NEXT: n1 thrown
# BODY-NEXT: n2 operation v2
# BODY-NEXT: n3 operation v5
# BODY-NEXT: n4 merge v0
# BODY-NEXT: n5 merge
# BODY-NEXT: n6 merge
# BODY-NEXT: n7 merge v0
# BODY-NEXT: n8 merge
# BODY-NEXT: n9 merge
# BODY-NEXT: s0 v2 result of a built-in
# BODY-NEXT: s1 v2 contents of the result of a built-in
# BODY-NEXT: s2 v3 result of a built-in
# BODY-NEXT: s3 v3 contents of the result of a built-in
# BODY-NEXT: s4 v5 result of a built-in
# BODY-NEXT: s5 v5 contents of the result of a built-in
# BODY-NEXT: s6 v6 result of a built-in
# BODY-NEXT: s7 v6 contents of the result of a built-in
# BODY-NEXT: edge n4 -> n5
# BODY-NEXT: edge n5 -> n2
# BODY-NEXT: edge n6 -> n1
# BODY-NEXT: edge n7 -> n8
# BODY-NEXT: edge n8 -> n3
# BODY-NEXT: edge n9 -> n1
# BODY-NEXT: reached: seed n0 <- undefined
# BODY-NEXT: reached: seed n4 <- closure f2
# BODY-NEXT: reached: seed n7 <- closure f3
# BODY-NEXT: Call v2 (g0, -, closure f2) -> n2 throws n1 has a copy of f1
# BODY-NEXT: Call v3 (n2, -) throws n1
# BODY-NEXT: Call v5 (g0, -, closure f3) -> n3 throws n1 has a copy of f1
# BODY-NEXT: Call v6 (n3, -) throws n1
# BODY-NEXT: ModuleEvaluation

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="identity" module=m0 declared={type=anything} initialization=Function function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1
    v3 = Call v2
    v4 = NewClosure function=f3
    v5 = Call v0, -, v4
    v6 = Call v5
    Return
}
function f1 name="identity" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
