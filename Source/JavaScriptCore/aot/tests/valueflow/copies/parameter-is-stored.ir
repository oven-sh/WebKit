# A helper that stores a parameter into an object it allocates: the allocation site is copied with the body, so each call site has an object of its own.
# OPTIONS: limit=MaxValueFlowCopiedNodesPercent:100
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f1
# CHECK-NEXT: f0 v4 -> f2
# CHECK-NEXT: f0 v6 -> f1
# CHECK-NEXT: f0 v8 -> f3
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box" fields=[{key="value" declared={type=anything} flags=[IsRequired]}]
variable g0 name="box" module=m0 declared={type=anything} initialization=Function function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1
    v3 = PropGet v2 key="value"
    v4 = Call v3
    v5 = NewClosure function=f3
    v6 = Call v0, -, v5
    v7 = PropGet v6 key="value"
    v8 = Call v7
    Return
}
function f1 name="box" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
