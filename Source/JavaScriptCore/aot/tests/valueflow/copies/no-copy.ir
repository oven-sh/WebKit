# No copy is made where a body stores to the variable that holds the callee, where the function reaches itself through calls that would be copied, and where the function hands no parameter on: all callers share the nodes of the function.
# OPTIONS: limit=MaxValueFlowCopiedNodesPercent:100
# RUN: valueflow-solve calls
# CHECK: f0 v3 -> f1 f4
# CHECK-NEXT: f0 v4 -> f1 f4
# CHECK-NEXT: f0 v5 -> f4 f5
# CHECK-NEXT: f0 v8 -> f2
# CHECK-NEXT: f0 v9 -> f2
# CHECK-NEXT: f0 v10 -> f4 f5
# CHECK-NEXT: f0 v12 -> f3
# CHECK-NEXT: f2 v2 -> f2
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# UNREACHED-NOT: unreached f4
# UNREACHED-NOT: unreached f5
# RUN(BODY): valueflow-body copies f0
# BODY: body f0
# BODY-NOT: has a copy

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="replaced" module=m0 declared={type=anything} initialization=Function function=f1
variable g1 name="recursive" module=m0 declared={type=anything} initialization=Function function=f2
variable g2 name="keepsNothing" module=m0 declared={type=anything} initialization=Function function=f3
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = NewClosure function=f5
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0
    v4 = Call v2, -, v1
    v5 = Call v3
    PutModuleVariable v0 variable=g0
    v7 = GetModuleVariable variable=g1
    v8 = Call v7, -, v0
    v9 = Call v7, -, v1
    v10 = Call v8
    v11 = GetModuleVariable variable=g2
    v12 = Call v11, -, v0
    Return
}
function f1 name="replaced" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="recursive" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = Call v1, -, v0
    Return v0
}
function f3 name="keepsNothing" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f5 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
