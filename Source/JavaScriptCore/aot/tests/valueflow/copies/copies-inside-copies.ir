# A parameter that is only passed on to a call counts where that call has a copy which hands it on. The copy of the outer function holds a copy of the inner one.
# OPTIONS: limit=MaxValueFlowCopiedNodesPercent:100
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f2
# CHECK-NEXT: f0 v3 -> f3
# CHECK-NEXT: f0 v5 -> f2
# CHECK-NEXT: f0 v6 -> f4
# CHECK-NEXT: f2 v2 -> f1
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# UNREACHED-NOT: unreached f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="identity" module=m0 declared={type=anything} initialization=Function function=f1
variable g1 name="throughIdentity" module=m0 declared={type=anything} initialization=Function function=f2
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = NewClosure function=f3
    v2 = Call v0, -, v1
    v3 = Call v2
    v4 = NewClosure function=f4
    v5 = Call v0, -, v4
    v6 = Call v5
    Return
}
function f1 name="identity" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="throughIdentity" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0
    Return v2
}
function f3 name="first" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f4 name="second" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
