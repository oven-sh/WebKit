# main.cjs: Object.defineProperty(module.__proto__, "hot", { get() { return this.exports } }); require("./inner.cjs").isHot()   inner.cjs: exports.isHot = () => module.hot
# The table names the object above the module objects, so the getter of Object.prototype under `__proto__` answers that object for a module object, and what the
# program lays on it is found by a lookup on every module object. inner.cjs finds the getter under `hot` and enters it with its own module object: `this.exports` in
# the getter is what inner.cjs exports. The getter has gone to Object.defineProperty, so what it returns is out of sight, and `secret` with it.
