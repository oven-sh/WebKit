# The properties of a namespace object are the variables that its module exports: a read under the name of an export gives what the variable holds, and nothing of the other exports
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f2
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="other.js" displayPath="other.js" body=f1 exports=[{name="first" variable=g0}, {name="second" variable=g1}]
entry module=m0
variable g0 name="first" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="second" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="first"
    v2 = Call v1, v0
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f3
    PutModuleVariable v2 variable=g1
    Return
}
function f2 name="first" module=m1 results=[{type=anything}] {
    Return
}
function f3 name="second" module=m1 results=[{type=anything}] {
    Return
}
