# hide(Function.prototype); hide(Function.prototype.call); taken = hide(); taken = Function.prototype.call; step0 = { next: () => { held = process.getBuiltinModule } }; step1 = { next: () => step0.next() }; and so on; step7.next(); `taken` is called on `held` with process and globalThis.name
