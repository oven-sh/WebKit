# A module whose package says nothing about side effects is evaluated by the import alone. What only an unused module without side effects imports is not
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK: unreached f2
# CHECK-NEXT: unreached f3

variable g0 name="first" module=m1 declared={type=anything} initialization=Uninitialized
variable g1 name="second" module=m3 declared={type=anything} initialization=Uninitialized
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="/first.js" displayPath="first.js" body=f1 exports=[{name="first" variable=g0}]
module m2 path="/package/index.js" displayPath="package/index.js" flags=[HasNoSideEffects] body=f2 requests=[{target=m3 completes=true}]
module m3 path="/polyfill.js" displayPath="polyfill.js" body=f3
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    Return
}
function f1 name="first" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="index" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    Return
}
function f3 name="polyfill" module=m3 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = Call v1, -
    v3 = Integer integer=2
    PutModuleVariable v3 variable=g1
    Return
}
