# input(process.getBuiltinModule)
# The loader may come back as a value nobody knows, and the program calls one: built-in modules are loaded by names made at run time.
# RUN: valueflow-solve unseen
# CHECK: unseen LoadsModuleByName ProcessGetBuiltinModule
# CHECK: modules-by-name yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="process" [isFreeName]
    v3 = PropGet v2 key="getBuiltinModule"
    v4 = Call v1, -, v3
    Return
}
