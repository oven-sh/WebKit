# The host reads the default export of an entry point. The variable behind it is in a module that its package declares free of side effects, which is evaluated for that read
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f

variable g0 name="server" module=m1 declared={type=anything} initialization=Uninitialized
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}] exports=[{name="default" variable=g0}]
module m1 path="/package/server.js" displayPath="package/server.js" flags=[HasNoSideEffects] body=f1 exports=[{name="default" variable=g0}]
entry module=m0 hostReads=[{exportName="default"}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    Return
}
function f1 name="server" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
