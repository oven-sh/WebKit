# An export may have a name that reads as a number: a read of the namespace object under such a name gives what the variable holds, and nothing of the exports under other names
# RUN: valueflow-solve calls
# CHECK: f0 v2 -> f5
# CHECK: f0 v5 -> f6
# CHECK: f0 v8 -> f7
# CHECK: f0 v11 -> f8
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f5
# UNREACHED-NOT: unreached f6
# UNREACHED-NOT: unreached f7
# UNREACHED-NOT: unreached f8
# UNREACHED: unreached f9

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="first.js" displayPath="first.js" body=f1 exports=[{name="NaN" variable=g0}, {name="other" variable=g4}]
module m2 path="second.js" displayPath="second.js" body=f2 exports=[{name="0" variable=g1}]
module m3 path="third.js" displayPath="third.js" body=f3 exports=[{name="-1" variable=g2}]
module m4 path="fourth.js" displayPath="fourth.js" body=f4 exports=[{name="Infinity" variable=g3}]
entry module=m0
variable g0 name="NaN" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="zero" module=m2 declared={type=anything} initialization=Undefined
variable g2 name="minusOne" module=m3 declared={type=anything} initialization=Undefined
variable g3 name="Infinity" module=m4 declared={type=anything} initialization=Undefined
variable g4 name="other" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="NaN"
    v2 = Call v1, v0
    v3 = ModuleNamespace module=m2
    v4 = PropGet v3 key="0"
    v5 = Call v4, v3
    v6 = ModuleNamespace module=m3
    v7 = PropGet v6 key="-1"
    v8 = Call v7, v6
    v9 = ModuleNamespace module=m4
    v10 = PropGet v9 key="Infinity"
    v11 = Call v10, v9
    Return
}
function f1 name="first" module=m1 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f5
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f9
    PutModuleVariable v2 variable=g4
    Return
}
function f2 name="second" module=m2 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f6
    PutModuleVariable v0 variable=g1
    Return
}
function f3 name="third" module=m3 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f7
    PutModuleVariable v0 variable=g2
    Return
}
function f4 name="fourth" module=m4 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f8
    PutModuleVariable v0 variable=g3
    Return
}
function f5 name="NaN" module=m1 results=[{type=anything}] {
    Return
}
function f6 name="zero" module=m2 results=[{type=anything}] {
    Return
}
function f7 name="minusOne" module=m3 results=[{type=anything}] {
    Return
}
function f8 name="Infinity" module=m4 results=[{type=anything}] {
    Return
}
function f9 name="other" module=m1 results=[{type=anything}] {
    Return
}
