# a.js: export const v = 1        main.js: import("./a.js", 5).catch(error => error.message)
# The module imports nothing and throws nothing. The loader itself rejects the promise, here because the options are no object,
# so the handler is handed a value that nobody knows.
# RUN: valueflow-why values=f2:v1
# CHECK: operand 0 {{*}}unknown{{*}}

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="a.js" displayPath="a.js" body=f1 exports=[{name="v" variable=g0}]
entry module=m0
variable g0 name="v" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Integer integer=5
    v1 = ImportModule v0 module=m1 referrer=m0
    v2 = PropGet v1 key="catch"
    v3 = NewClosure function=f2
    v4 = Call v2, v1, v3
    Return v4
}
function f1 name="a" module=m1 kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="handler" module=m0 kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="message"
    Return v1
}
