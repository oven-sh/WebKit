# a.js: throw new Failure()        main.js: import("./a.js").catch(error => error)
# The promise of the import is rejected with what the evaluation of the module throws, so the handler is handed the instance.
# A handler whose parameter holds nothing has its tests of the parameter folded away.
# RUN: valueflow-why values=f3:v1
# CHECK: operand 0 {{*}}object{{*}}@f2

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="a.js" displayPath="a.js" body=f1
entry module=m0
layout L0 kind=Instance name="Failure" constructor=f2
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = ImportModule module=m1 referrer=m0
    v1 = PropGet v0 key="catch"
    v2 = NewClosure function=f3
    v3 = Call v1, v0, v2
    Return v3
}
function f1 name="a" module=m1 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f2
    v1 = Construct v0
    Throw v1
}
function f2 name="Failure" module=m1 kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0 {
    v1 = NewObject layout=L0
    Return v1
}
function f3 name="handler" module=m0 kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="name"
    Return v1
}
