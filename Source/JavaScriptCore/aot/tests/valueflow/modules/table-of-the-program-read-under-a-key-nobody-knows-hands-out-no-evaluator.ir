# intrinsics = { "%parse%": parse, "%eval%": eval, "%Function%": Function }; intrinsics[name]("12")
# A table of the program holds the evaluators among its members, and the key names none of them. What may be `eval` is not `eval`: the call enters the function of the program that the table holds
# and is no event. The run time refuses an evaluator that comes out all the same in an image whose build saw no application of one.
# table-of-the-program-read-by-name-hands-out-the-evaluator.ir names one
# RUN: valueflow-solve unseen
# CHECK-NOT: unseen EvaluatesText
# CHECK: unseen-code no
# RUN(CALLS): valueflow-solve calls
# CALLS: f0 v13 -> {{*}}f1
# CALLS-NOT: Eval

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Intrinsics" fields=[{key="%parse%" declared={type=anything} flags=[IsRequired]}, {key="%eval%" declared={type=anything} flags=[IsRequired]}, {key="%Function%" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=Eval
    v2 = Builtin builtin=Function
    v3 = NewObject layout=L0
    PropDefine v3, v0 key="%parse%"
    PropDefine v3, v1 key="%eval%"
    PropDefine v3, v2 key="%Function%"
    v7 = FinishObject v3
    v8 = Builtin builtin=DateNow
    v9 = Call v8
    v10 = ToString v9
    v11 = ElemGet v7, v10
    v12 = String string="12"
    v13 = Call v11, -, v12
    Return
}
function f1 name="parse" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
