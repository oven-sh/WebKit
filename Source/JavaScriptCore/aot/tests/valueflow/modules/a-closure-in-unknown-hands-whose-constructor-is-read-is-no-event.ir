    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = PropGet v3 key="constructor"
    v5 = Call v3, -
    Return
}
function f1 name="any" results=[{type=anything}] {
