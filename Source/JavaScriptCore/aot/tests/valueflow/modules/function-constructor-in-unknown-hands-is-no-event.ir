# input(Function); input(function () {}.constructor)
# `Function` is the `constructor` of every function, so whoever holds a function holds it. That it is in unknown hands says no more than that a closure has escaped: only a call of it is an event.
# The run time refuses an evaluator that no reached call applies. function-constructor-that-is-called-is-an-event.ir is the twin that calls it
# RUN: valueflow-solve unseen
# CHECK-NOT: unseen EvaluatesText
# CHECK: unseen-code no
# RUN(WHY): valueflow-why escaped-builtin=Function
# WHY: escaped-builtin=Function
# WHY-NEXT: n0 escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v0 key="Function" [isFreeName]
    v3 = Call v1, -, v2
    v4 = NewClosure function=f1
    v5 = PropGet v4 key="constructor"
    v6 = Call v1, -, v5
    Return
}
function f1 name="any" results=[{type=anything}] {
  b0():
    Return
}
