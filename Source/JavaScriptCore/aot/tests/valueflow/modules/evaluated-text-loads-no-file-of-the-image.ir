# Text that is evaluated at run time reaches the global scope. It loads no file of the image: the run time refuses it each name that leads to one, as long as the program itself loads nothing by a computed name.
# So a module that nothing imports is not evaluated for it, and what a module exports is not in its hands. evaluated-text-beside-a-computed-load-reaches-what-entry-points-export.ir is the twin
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK: unreached f2
# CHECK: unreached f3
# RUN(UNSEEN): valueflow-solve unseen
# UNSEEN: unseen EvaluatesText f0:v2
# UNSEEN-NOT: unseen LoadsModuleByName
# UNSEEN: unseen-code yes

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="other.js" displayPath="other.js" body=f1 exports=[{name="exported" variable=g0}]
entry module=m0
evalscope e0
variable g0 name="exported" module=m1 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="text"
    v1 = Undefined
    v2 = DirectEval v0, v1 evalScope=e0
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f3
    Return
}
function f2 name="exported" module=m1 results=[{type=anything}] {
  b0():
    Return
}
function f3 name="keptInside" module=m1 results=[{type=anything}] {
  b0():
    Return
}
