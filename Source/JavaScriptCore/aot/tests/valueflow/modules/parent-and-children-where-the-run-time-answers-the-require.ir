# main.cjs: module.exports = exportedByMain; require("./child.cjs"); module.children[i].exports()        child.cjs: module.exports = exportedByChild; module.parent.exports(); require("./back.mjs")        back.mjs: import "./child.cjs"
# The loader of the run time answers the `require` in main.cjs, so main.cjs has no request for child.cjs. The two module objects hang together all the same:
# `parent` in child.cjs answers the module object of main.cjs, and `children` in main.cjs lists that of child.cjs.
