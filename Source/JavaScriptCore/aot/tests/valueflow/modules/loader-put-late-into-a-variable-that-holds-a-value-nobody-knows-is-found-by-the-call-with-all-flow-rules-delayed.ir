    v5 = Call v1, -, v4
    v6 = PropGet v0 key="name" [isFreeName]
    v7 = NewClosure function=f1
    v8 = NewObject layout=L0
    PropDefine v8, v7 key="next"
    v10 = FinishObject v8
    PutModuleVariable v10 variable=g1
    v12 = NewClosure function=f2
    v13 = NewObject layout=L0
    PropDefine v13, v12 key="next"
    v15 = FinishObject v13
