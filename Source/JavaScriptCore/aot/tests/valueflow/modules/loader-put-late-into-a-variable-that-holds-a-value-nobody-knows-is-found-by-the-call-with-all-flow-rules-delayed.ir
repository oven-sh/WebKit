    v17 = NewClosure function=f3
    v18 = NewObject layout=L0
    PropDefine v18, v17 key="next"
    v20 = FinishObject v18
    PutModuleVariable v20 variable=g3
    v22 = NewClosure function=f4
    v23 = NewObject layout=L0
    PropDefine v23, v22 key="next"
    v25 = FinishObject v23
    PutModuleVariable v25 variable=g4
    v27 = NewClosure function=f5
    v28 = NewObject layout=L0
    PropDefine v28, v27 key="next"
    v30 = FinishObject v28
    PutModuleVariable v30 variable=g5
    v32 = NewClosure function=f6
    v33 = NewObject layout=L0
    PropDefine v33, v32 key="next"
    v35 = FinishObject v33
    PutModuleVariable v35 variable=g6
    v37 = NewClosure function=f7
    v38 = NewObject layout=L0
    PropDefine v38, v37 key="next"
    v40 = FinishObject v38
    PutModuleVariable v40 variable=g7
    v42 = NewClosure function=f8
    v43 = NewObject layout=L0
    PropDefine v43, v42 key="next"
    v45 = FinishObject v43
    PutModuleVariable v45 variable=g8
    v47 = PropGet v45 key="next"
    v48 = Call v47, v45
    v49 = GetModuleVariable variable=g0
    v50 = Call v49, -, v6
    Return v50
}
function f1 name="next" module=m0 kind=Arrow results=[{type=anything}] {
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="getBuiltinModule"
    PutModuleVariable v1 variable=g0
    Return
}
function f2 name="next" module=m0 kind=Arrow results=[{type=anything}] {
