# main.cjs: Object.getPrototypeOf(require.resolve) === Object; input()
# The table does not say what stands above the `resolve` of a require function: the host keeps `paths` on an object of its own up there. Whoever holds that object reads what lies on it with any receiver,
# so the function is in unknown hands, and the answer is an object nobody knows.
# whoever-asks-what-stands-above-a-module-object-gets-the-object-that-the-table-names.ir asks about an object whose link the table names.
# RUN: valueflow-why escaped-builtin=ModuleRequireResolve values=f0:v5
# CHECK: escaped-builtin=ModuleRequireResolve
# CHECK-NEXT: n0 escaped
# CHECK: values=f0:v5
# CHECK: result {{*}} unknown

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
    v0 = ModuleBuiltin builtin=ModuleRequire module=m0
    v1 = PropGet v0 key="resolve"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="Object" [isFreeName]
    v4 = PropGet v3 key="getPrototypeOf"
    v5 = Call v4, v3, v1
    v6 = StrictEq v5, v3
    v7 = PropGet v2 key="input" [isFreeName]
    v8 = Call v7, -
    Return
}
