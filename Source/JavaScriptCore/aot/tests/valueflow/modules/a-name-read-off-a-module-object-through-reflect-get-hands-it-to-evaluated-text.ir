# inner.cjs: exports.secret = secret; exports.isHot = () => Reflect.get(module, "hot")   main.cjs: require("./inner.cjs").isHot(); new Function(input)()
# Reflect.get() looks the name up for a receiver that is an operand of the call. Evaluated text may have laid a getter under the name above the module objects, and the
# getter is entered with that operand.
# RUN: valueflow-why escaped-builtin=ModuleObject escaped=f3
# CHECK: n0 escaped   by Call f2 v4
# CHECK: held: those of 1 of 2 modules
# CHECK: escaped=f3
# CHECK-NEXT: n0 escaped

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0 requests=[{target=m1 kind=Require completes=true}]
module m1 path="/inner.cjs" displayPath="inner.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g1
entry module=m0
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m0
    v1 = GetModuleVariable variable=g1
    v2 = PropGet v1 key="isHot"
    v3 = Call v2, v1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Builtin builtin=Function
    v7 = Construct v6, -, v5
    v8 = Call v7
    Return
}
function f1 module=m1 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
    v0 = NewDictionary
    PutModuleVariable v0 variable=g1
    v2 = NewClosure function=f3
    PropSet v0, v2 key="secret" mode=Sloppy
    v4 = NewClosure function=f2
    PropSet v0, v4 key="isHot" mode=Sloppy
    Return
}
function f2 name="isHot" module=m1 kind=Arrow results=[{type=anything}] {
    v0 = ModuleBuiltin builtin=ModuleObject module=m1
    v1 = Builtin builtin=Reflect
    v2 = Builtin builtin=ReflectGet
    v3 = String string="hot"
    v4 = Call v2, v1, v0, v3
    Return v4
}
function f3 name="secret" module=m1 results=[{type=anything}] {
    Return
}
