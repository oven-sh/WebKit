# As names-of-a-commonjs-module-are-variables-that-its-body-stores-once.ir, and the request does not say that m1.cjs has run to its end behind the operation:
# a later require of a module that threw goes on with what the module has stored so far. A read in the other module may find the variable as it started
# RUN: valueflow-apply
# CHECK: variable g0 name="c" {{*}}flow={writers=AllKnown stores=AtMostOnce storeNaming=EveryStoreNamesLocation
# CHECK-NOT: variable g0 name="c" {{*}}initialization=StoredBeforeEveryRead

variable g0 name="c" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs requireResult=ModuleExports body=f0 requests=[{target=m1 kind=Require}]
module m1 path="/app/m1.cjs" displayPath="m1.cjs" kind=CommonJs requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0
    Return
}
function f1 name="m1" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="mayThrow" [isFreeName]
    v2 = Call v1
    v3 = Integer integer=1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="reader" module=m0 results=[{type=anything}] {
  b0():
    EvaluateModule module=m1 referrer=m0
    v1 = GetModuleVariable variable=g0
    Return v1
}
