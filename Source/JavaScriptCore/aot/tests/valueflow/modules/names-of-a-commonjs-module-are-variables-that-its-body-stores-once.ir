# m1.cjs: exports.c = 1; exports.f = function f() { return exports.c }        main.cjs: const a = require("./m1.cjs"); exports.g = function g() { return a.f() + a.c }; exports.g()
# The names that a CommonJS module exports are variables, and there is no object. The body of a module of the image runs at most once and owns its variables like the body of an ES module:
# each is stored at most once, by an operation that names it. Whoever reads one in another module stands behind the operation that evaluates m1.cjs, which has run to its end by then:
# the variables are stored before every read, and the call through the variable is a call of the one function
