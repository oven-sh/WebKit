module m1 path="/app/m1.cjs" displayPath="m1.cjs" kind=CommonJs flags=[KeepsError] requireResult=ModuleExports body=f1
entry module=m0
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
