    v1 = NewClosure function=f3
    PutModuleVariable v1 variable=g2
    v3 = GetModuleVariable variable=g2
    v4 = Call v3
    Return
}
function f1 name="m1" module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g1
