# function make() { return {} }                                    a fresh object
# function shared() { return kept }                                .. and one that somebody else holds
# function fills(o) { const t = make(); t.f = o }                  nothing: what it was stored into dies here
# function builds(o) { const t = make(); t.f = o; return t }       stored into the result
# function leaks(o) { const t = shared(); t.f = o }                stored in an object that somebody else may hold
# RUN: relational-summary
# CHECK: f3
# CHECK-NEXT: p0: nothing | contents: nothing
# CHECK: f4
# CHECK-NEXT: p0: nothing | contents: nothing stored-into-results=1
# CHECK: f5
# CHECK-NEXT: p0: stored-in-unknown-object | contents: nothing

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Empty" fields=[]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f3
    v3 = Call v2, -, v1
    v4 = NewClosure function=f4
    v5 = Call v4, -, v1
    v6 = NewClosure function=f5
    v7 = Call v6, -, v1
    Return
}
function f1 name="make" results=[{type=anything}] relations={subjects=[{kind=Allocation fate=[IsReturned] results=1}] resultsFullyListed=1} {
  b0():
    v0 = NewObject layout=L1 fields=[]
    Return v0
}
function f2 name="shared" results=[{type=anything}] relations={subjects=[{kind=Allocation fate=[IsReturned, IsStoredInVariable] results=1}] resultsFullyListed=1} {
  b0():
    v0 = NewObject layout=L1 fields=[]
    Return v0
}
function f3 name="fills" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}, {kind=CallResult index=2 fate=[HasMembersWritten]}] stores=[{target=2 key="f" isOnEveryPath=true}] handed=[{source=1 call=2}]} {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -
    PropSet v2, v0 key="f" mode=Strict
    Return
}
function f4 name="builds" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}, {kind=CallResult index=2 fate=[IsReturned, HasMembersWritten] results=1}] stores=[{target=2 key="f" isOnEveryPath=true}] handed=[{source=1 call=2}] resultsFullyListed=1} {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -
    PropSet v2, v0 key="f" mode=Strict
    Return v2
}
function f5 name="leaks" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}, {kind=CallResult index=2 fate=[HasMembersWritten]}] stores=[{target=2 key="f" isOnEveryPath=true}] handed=[{source=1 call=2}]} {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = Call v1, -
    PropSet v2, v0 key="f" mode=Strict
    Return
}
