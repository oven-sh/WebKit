    v10 = NewClosure function=f5
    v11 = NewClass v10 layout=L2
    v12 = NewClosure function=f6
    DefineMethod v11, v12 layout=L2 methodKind=Getter key="length"
    v14 = FinishClass v11 layout=L2
    v15 = Construct v4, -
    v16 = Construct v9, -
    v17 = Construct v14, -
    v18 = NewClosure function=f7
    v19 = Call v18, -, v15
    v20 = Call v18, -, v16
    v21 = Call v18, -, v17
    Return
}
