# let a = 1; reader = () => a
# An environment is no object of the language: it has no prototype and no accessors, and reads and stores of its fields are all that happens to it.
# RUN: runs-no-code
# CHECK: f0 v1: env L0: any=yes|yes keys=no iterate=no convert=no define=no unlisted=no called=yes
# CHECK: f0 v2: f1: any=no|no keys=yes iterate=no convert=no define=no unlisted=no called=yes
# CHECK: f1 v0: env L0: any=yes|yes keys=no iterate=no convert=no define=no unlisted=no called=yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment module=m0 position=20 fields=[{declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure v1 function=f1
    v3 = Call v2
    Return
}
function f1 name="reader" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0
    Return v1
}
