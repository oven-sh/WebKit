# class Holder { plain; get size() { .. } }  holder = new Holder;  holder.size;  holder.plain = record;  unknown.other;  unknown.other = record
# Where all that an access may find is proven, the accessors among it answer for the receiver, and what the getter returns is what the access answers. A value that goes into a field lies in the receiver.
# Where the receiver is not known the access is said as an access of the receiver, and anything becomes of the value: a setter may take it.
# RUN: fates-at-calls f2.p0=stored-in-variable f2.p0.results=1
# CHECK: f0 v6 PropGet operand 0: returned+stored-in-variable contents=returned results=[0]
# CHECK-NEXT: f0 v9 PropSet operand 0: nothing contents=nothing
# CHECK-NEXT: f0 v9 PropSet operand 1: nothing contents=nothing stored-into-operands=[0]
# CHECK: f0 v12 PropGet operand 0: members-read contents=returned read=["other"]
# CHECK-NEXT: f0 v13 PropSet operand 0: members-written contents=nothing written=["other"]
# CHECK-NEXT: f0 v13 PropSet operand 1: anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Holder" constructor=f1 fields=[{key="plain" declared={type=anything}}]
layout L1 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="size"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4, -
    v6 = PropGet v5 key="size"
    v7 = Integer integer=2
    v8 = NewObject -, v7 layout=L1 fields=[0]
    PropSet v5, v8 key="plain" mode=Strict
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="unknown" [isFreeName]
    v12 = PropGet v11 key="other"
    PropSet v11, v8 key="other" mode=Strict
    Return
}
function f1 name="Holder" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = Undefined
    v3 = NewObject v1, v2 layout=L0 fields=[0]
    Return v3
}
function f2 name="size" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
