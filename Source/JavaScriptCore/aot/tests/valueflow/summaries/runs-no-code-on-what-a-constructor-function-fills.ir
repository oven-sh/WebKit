# function Plain(pos) { this.pos = pos }            spy = { set pos(value) { } }            function define(target) { Object.defineProperty(target, "pos", { set: takes }) }            name = [1].join()
# define(Defined.prototype); define(DefinedToo.prototype)            Object.setPrototypeOf(Relinked.prototype, spy)            Reassigned.prototype = spy            Keyed.prototype[name] = spy
# unknown(Escaped.prototype)            Default.prototype.pos = 1            Linked.prototype.__proto__ = spy            Object.defineProperty(DefinedAlone.prototype, "pos", { set: takes })            ReassignedByKey[name] = spy
# `this.pos = pos` in a constructor function stores into an object that has no `pos` yet, so the store asks the prototype object of the function and whatever lies above it.
# Anybody who has the function reaches that object. A setter comes onto it by a definition, also one that is written for several prototype objects at once and so is listed for none;
# with another object above it; with another object in its place; and under a key nobody knows, which may be "__proto__" on the object and "prototype" on the function.
# Of all of these the answer for the store stays "no", whatever flow learns to say of `Plain`.
