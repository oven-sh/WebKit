variable g0 module=m0 declared={type=anything}
layout L0 kind=Instance name="Point" module=m0 constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="Kept" module=m0 constructor=f4 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction] ownFieldCount=1
layout L2 kind=Instance name="Other" module=m0 constructor=f6 flags=[IsConstructorFunction]
layout L3 name="Literal" fields=[{key="x" declared={type=anything}}]
layout L4 kind=Instance name="Third" module=m0 constructor=f9 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction] ownFieldCount=1
