# function Point(x) { }        function make(x) { return new Point(x) }        function passOn(x) { return make(x) }
# function Kept(x) { last = this; this.x = x }        function makeKept(x) { return new Kept(x) }
# function Other(x) { return { x } }        function makeOther(x) { return new Other(x) }        function makeFor(x, target) { return Reflect.construct(Third, [x], target) }
# Whoever constructs a constructor function gets the object that was made for the construction, unless the function returns another object.
# `Point` keeps `this` nowhere and returns nothing: the object is the caller's own, as if the caller had made it where the construction stands, and `make` answers a fresh object. So does who calls `make`.
# `Kept` stores `this` in a variable. `Other` returns an object of its own. For another new.target the object is of another class: of all three only "an object" is known
# RUN: relational-summary
# CHECK-LABEL: f1
# CHECK: result0: one of [o0], constructed: fresh | o0 = Undefined
# CHECK-LABEL: f2
# CHECK: result0: fresh one of [o0] | o0 = Construct f2 v2 held-by-nobody-else
# CHECK-LABEL: f3
# CHECK: result0: fresh one of [o0] | o0 = Construct f2 v2 held-by-nobody-else through f3 v1
# CHECK-LABEL: f4
# CHECK-NOT: constructed: fresh
# CHECK-LABEL: f5
# CHECK-NOT: result0
# CHECK-LABEL: f6
# CHECK-NOT: constructed: fresh
# CHECK-LABEL: f7
# CHECK-NOT: result0
# CHECK-LABEL: f8
# CHECK-NOT: result0

