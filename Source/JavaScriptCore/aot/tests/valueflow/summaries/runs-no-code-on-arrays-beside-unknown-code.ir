# plain = [1, 1]; handed = [1]; unknown(handed); keyed = [1]; keyed[name] = 1
# Each is handed to a helper of its own, and the question is asked of the type that flow proves for the helper's parameter.
# RUN: runs-no-code length push
# CHECK: f3 v0: Array<1, proven, Int32, pristine[Storage, Names, Dense]>: length=yes|yes push=yes|yes any=yes|yes keys=yes iterate=yes convert=yes define=no unlisted=no called=yes
# CHECK: f4 v0: Array: length=yes|yes push=no|no any=no|no keys=no iterate=no convert=no define=no unlisted=no called=yes
# CHECK: f5 v0: Array: length=yes|yes push=no|no any=no|no keys=no iterate=no convert=no define=no unlisted=no called=yes

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Spy"
layout L1 name="GetterDescriptor" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Builtin builtin=GlobalThis
    v2 = NewArray v0, v0 contents=anything
    v3 = PropGet v2 key="length"
    v4 = PropGet v2 key="push"
    v5 = NewClosure function=f3
    v6 = Call v5, -, v2
    v7 = NewArray v0 contents=anything
    v8 = PropGet v1 key="unknown" [isFreeName]
    v9 = Call v8, -, v7
    v10 = NewClosure function=f4
    v11 = Call v10, -, v7
    v12 = NewArray v0 contents=anything
    v13 = PropGet v1 key="name" [isFreeName]
    ElemSet v12, v13, v0 mode=Strict
    v15 = NewClosure function=f5
    v16 = Call v15, -, v12
    Return
}
function f1 name="spy" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="spy" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f3 name="takesPlain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="takesHanded" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f5 name="takesKeyed" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
