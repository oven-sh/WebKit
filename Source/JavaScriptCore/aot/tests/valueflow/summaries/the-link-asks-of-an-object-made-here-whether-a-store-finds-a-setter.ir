}
function f2 name="puts" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {kind=Allocation index=2 fate=[HasMembersWritten, HasMembersDeletedOrDefined]}, {kind=Allocation index=3}] stores=[{source=3 target=2 key="x" isOnEveryPath=true}, {target=2 key="x" isOnEveryPath=true}]} {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L1 fields=[]
    v3 = NewClosure function=f1
