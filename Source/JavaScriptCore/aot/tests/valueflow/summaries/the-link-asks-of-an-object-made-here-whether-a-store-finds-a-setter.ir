}
function f3 name="fills" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=2 fate=[HasMembersWritten]}] stores=[{source=4294967295 target=1 key="x" creationOperand=1 isOnEveryPath=true isBeforeTargetLeaves=true}, {target=1 key="x" isOnEveryPath=true}]} {
