# function keeps(value) { kept = value }                                          a setter
# function puts(o, other) { const box = { set x(value) { kept = value } }; box.x = o }   the store finds the setter, which has o: that the box dies here says nothing
# function fills(o) { const box = { x: 0 }; box.x = o }                           a plain store into a plain object: o dies with the box
# Of a parameter the caller asks whether an access runs code of the object. Of an object that the function has made itself nobody else will ever ask.
# RUN: relational-summary
# CHECK: f2
# CHECK-NEXT: p0: anything
# CHECK-NEXT: p1: nothing | contents: nothing
# CHECK: f3
# CHECK-NEXT: p0: nothing | contents: nothing

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Box"
layout L2 name="Plain" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = Call v2, -, v1, v1
    v4 = NewClosure function=f3
    v5 = Call v4, -, v1
    Return
}
function f1 name="keeps" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1 fate=[IsStoredInVariable]}]} {
  b0(v0: anything, v1: anything):
