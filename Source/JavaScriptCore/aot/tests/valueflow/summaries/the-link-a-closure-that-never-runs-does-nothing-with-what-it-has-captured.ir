# function keeps(p) { kept = p }
# function makes(p, q) { const never = () => { keeps(p) }; const runs = () => { keeps(q) }; runs() }
# Nobody calls `never`, and it goes nowhere: flow does not reach its function, which never runs. So nothing becomes of p. `runs` is called: q is kept.
# RUN: relational-summary
# CHECK: f2
# CHECK-NEXT: p0: nothing | contents: nothing
# CHECK-NEXT: p1: stored-in-variable

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = Call v2, -, v1, v1
    Return
}
function f1 name="keeps" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[IsStoredInVariable]}]} {
  b0(v0: anything):
    Return
}
function f2 name="makes" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {kind=Allocation index=2}, {kind=Allocation index=3 fate=[IsCalled]}] handed=[{call=2}, {source=1 call=3}, {source=3 call=4}]} {
  b0(v0: anything, v1: anything):
    v2 = NewClosure v0 function=f3
    v3 = NewClosure v1 function=f4
    v4 = Call v3, -
    Return
}
function f3 name="never" kind=Arrow captures=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}] handed=[{source=1 call=2}, {call=2 argument=2}]} {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    Return
}
function f4 name="runs" kind=Arrow captures=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}] handed=[{source=1 call=2}, {call=2 argument=2}]} {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    Return
}
