# new Error("m", { cause: record });  Reflect.set(holder, "k", record);  list.forEach(async x => ..);  Array.from.call(Other, list);  Array.from(list);  new Proxy(record, handler);  iterator.next(record)
# The answers for a built-in go by what flow's own reading of the table goes by. What a record puts into memory of native code is in unknown hands for good: `error.cause` hands it out again.
# A store by key may meet a setter or a trap of the object, which takes the value. The activation of a coroutine outlives the call of the built-in that has called it, with the closure and all that it was handed.
# An entry that wants its holder as `this` does with any other `this` what no overload declares. A proxy leads to its target and its handler. What is sent to an iterator goes where no record says.
# RUN: fates-at-calls f1.p0=members-read
# CHECK: f0 v6 Construct operand 3: members-read contents=anything read=[any]
# CHECK: f0 v11 Call operand 4: anything
# CHECK: f0 v15 Call operand 1: members-read contents=anything read=[any]
# CHECK-NEXT: f0 v15 Call operand 2: anything
# CHECK: f0 v20 Call operand 2: anything
# CHECK: f0 v21 Call operand 2: members-read+iterated+converted-to-primitive contents=stored-in-unknown-object+converted-to-primitive read=[any]
# CHECK: f0 v23 Construct operand 2: anything
# CHECK-NEXT: f0 v23 Construct operand 3: anything
# CHECK: f0 v27 Call operand 2: anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Options" fields=[{key="cause" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = Builtin builtin=Error
    v4 = String string="m"
    v5 = NewObject -, v0 layout=L0 fields=[0]
    v6 = Construct v3, -, v4, v2
    v7 = Builtin builtin=Reflect
    v8 = PropGet v7 key="set"
    v9 = String string="k"
    v10 = Undefined
    v11 = Call v8, v7, v5, v9, v1 calleeKey="set"
    v12 = NewArray v1 contents=anything
    v13 = NewClosure function=f1
    v14 = PropGet v12 key="forEach"
    v15 = Call v14, v12, v13 calleeKey="forEach"
    v16 = Builtin builtin=Array
    v17 = PropGet v16 key="from"
    v18 = PropGet v17 key="call"
    v19 = NewClosure function=f2
    v20 = Call v17, v19, v12 calleeKey="from"
    v21 = Call v17, v16, v12 calleeKey="from"
    v22 = Builtin builtin=Proxy
    v23 = Construct v22, -, v1, v5
    v24 = PropGet v12 key="values"
    v25 = Call v24, v12 calleeKey="values"
    v26 = PropGet v25 key="next"
    v27 = Call v26, v25, v1 calleeKey="next"
    Return
}
function f1 name="later" kind=Arrow flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="Other" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return
}
