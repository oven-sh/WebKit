# rest(a, b, c) with function rest(first, ...others);  all(a) with a function that reads `arguments`;  kept(a) with function kept(...others) { return others }
# A surplus argument lies in the array that the entry makes for the rest parameter: what is done with the contents of that array is done with it. Where the array is kept, whoever reads it has the argument.
# A function that looks at `arguments` finds every argument there.
# RUN: fates-at-calls f1.p0=nothing f1.p1=members-read f1.p1.contents=members-written f2.p0=nothing f2.p1=nothing f3.p0=nothing f3.p0.results=1
# CHECK: f0 v4 Call operand 2: nothing contents=nothing
# CHECK-NEXT: f0 v4 Call operand 3: members-written contents=members-written written=[any]
# CHECK-NEXT: f0 v4 Call operand 4: members-written contents=members-written written=[any]
# CHECK: f0 v6 Call operand 2: anything
# CHECK: f0 v8 Call operand 2: anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = NewClosure function=f1
    v4 = Call v3, -, v1, v2, v1
    v5 = NewClosure function=f2
    v6 = Call v5, -, v1
    v7 = NewClosure function=f3
    v8 = Call v7, -, v1
    Return
}
function f1 name="rest" flags=[HasRestParameter] parameters=[{type=anything}, {type=Array}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    Return
}
function f2 name="all" flags=[HasArgumentCount] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything):
    Return
}
function f3 name="kept" flags=[HasRestParameter] parameters=[{type=Array}] results=[{type=anything}] {
  b0(v0: Array):
    Return v0
}
