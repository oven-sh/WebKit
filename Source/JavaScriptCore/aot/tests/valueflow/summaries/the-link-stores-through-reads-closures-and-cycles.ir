    v3 = Call v2, -, v1
    Return
}
function f9 name="walkAndKeep" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[HasMembersRead]}, {kind=ReadFrom index=1 key="value" fate=[IsStoredInVariable]}, {kind=ReadFrom index=2 key="next"}, {kind=Allocation index=3 fate=[IsCalled]}] handed=[{source=3 call=4}, {source=2 call=4 argument=2}]} {
