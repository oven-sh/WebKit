# function through(k, v) { const temp = { slot: k }; temp.slot.held = v }       a store through a read lands in what the object holds: v hangs in k
# function run(cb) { cb() }                                                     a function that nobody knows may keep itself; apart from that it is only called: a row says so
# function setter() { k.held = v }   (captures k, v)                            v is stored into k
# function viaClosure(k, v) { run(() => { k.held = v }) }                       .. and so it is in the function that makes the closure, whoever calls it
# function each(list, use) { use(list[0]) }                                     an element of the list is passed to whatever `use` holds
# function keeper(x) { kept = x }
# function keepAll(list) { each(list, keeper) }                                 the closure is made here: its function answers: the CONTENTS of the list are kept, the list is not
# function walk(n) { walk(n.next) }                                             a cycle comes to rest: members are read, nothing is kept
# function walkAndKeep(n) { kept = n.value; walkAndKeep(n.next) }               .. the contents are kept
# RUN: relational-summary
# CHECK: f1
# CHECK-NEXT: p0: members-written | contents: members-written read=[any] written=[any]
# CHECK-NEXT: p1: members-written | contents: members-written stored-into-parameters=1 or-deeper read=[any] written=[any]
# CHECK: f2
# CHECK-NEXT: p0: called | contents: stored-in-unknown-object members-written
# CHECK: f3
# CHECK-NEXT: p0: members-written | contents: nothing written=["held"]
# CHECK-NEXT: p1: nothing | contents: nothing stored-into-parameters=1
# CHECK: f4
# CHECK-NEXT: p0: members-written | contents: nothing written=["held"]
# CHECK-NEXT: p1: nothing | contents: nothing stored-into-parameters=1
# CHECK: f5
# CHECK-NEXT: p0: members-read | contents: stored-in-variable read=[any]
# CHECK-NEXT: p1: called | contents: nothing
# CHECK: f6
# CHECK-NEXT: p0: stored-in-variable | contents: nothing
# CHECK: f7
# CHECK-NEXT: p0: members-read | contents: stored-in-variable read=[any]
# CHECK: f8
# CHECK-NEXT: p0: members-read | contents: members-read read=["next"]
# CHECK: f9
# CHECK-NEXT: p0: members-read | contents: stored-in-variable members-read read=["next", "value"]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Temporary" fields=[{key="slot" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1, v1
    v4 = NewClosure function=f4
    v5 = Call v4, -, v1, v1
    v6 = NewArray v1 contents=anything
    v7 = NewClosure function=f7
    v8 = Call v7, -, v6
    v9 = NewClosure function=f8
    v10 = Call v9, -, v1
    v11 = NewClosure function=f9
    v12 = Call v11, -, v1
    Return
}
function f1 name="through" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {kind=Allocation index=2 fate=[HasMembersRead]}, {kind=ReadFrom index=3 source=2 key="slot" fate=[HasMembersWritten]}] stores=[{target=2 key="slot" creationOperand=1 isOnEveryPath=true isBeforeTargetLeaves=true}, {source=1 target=3 key="held" isOnEveryPath=true}]} {
  b0(v0: anything, v1: anything):
    v2 = NewObject -, v0 layout=L1 fields=[0]
    v3 = PropGet v2 key="slot"
    PropSet v3, v1 key="held" mode=Strict
    Return
}
function f2 name="run" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[IsCalled]}] handed=[{call=1}]} {
  b0(v0: anything):
    v1 = Call v0, -
    Return
}
function f3 name="setter" kind=Arrow captures=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{fate=[HasMembersWritten]}, {index=1}] stores=[{source=1 key="held" isOnEveryPath=true}]} {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="held" mode=Strict
    Return
}
function f4 name="viaClosure" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {kind=Allocation index=2}, {kind=Allocation index=3 fate=[IsCalled]}] handed=[{call=2}, {source=1 call=2 argument=1}, {source=3 call=4}, {source=2 call=4 argument=2}]} {
  b0(v0: anything, v1: anything):
    v2 = NewClosure v0, v1 function=f3
    v3 = NewClosure function=f2
    v4 = Call v3, -, v2
    Return
}
function f5 name="each" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{fate=[HasMembersRead]}, {index=1 fate=[IsCalled]}, {kind=ReadFrom index=3}] handed=[{source=1 call=4}, {source=2 call=4 argument=2}]} {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    v3 = ElemGet v0, v2
    v4 = Call v1, -, v3
    Return
}
function f6 name="keeper" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[IsStoredInVariable]}]} {
  b0(v0: anything):
    Return
}
function f7 name="keepAll" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=1 fate=[IsCalled]}, {kind=Allocation index=2}] handed=[{source=1 call=3}, {call=3 argument=2}, {source=2 call=3 argument=3}]} {
