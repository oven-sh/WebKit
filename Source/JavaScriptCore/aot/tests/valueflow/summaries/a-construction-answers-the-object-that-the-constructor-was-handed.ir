# function Point(x) { this.x = x }  new Point(record);   function Leaky(x) { all.push(this); this.x = x }  new Leaky(record);   new Point(...list)
# Whoever constructs a plain function makes the object, hands it over as `this` and answers it. What the constructor stores into `this` lies in the result of the construction,
# which is the caller's own as long as the constructor has kept `this` nowhere. The called value is new.target: `prototype` is read out of it, and the new object holds what is found there.
# The elements of a list are arguments, nobody knows which.
# RUN: fates-at-calls f1.p0=members-written f1.p1=nothing f1.p1.into-parameters=1 f2.p0=stored-in-unknown-object f2.p1=nothing f2.p1.into-parameters=1
# CHECK: f0 v3 Construct operand 0: constructed+members-read contents=stored-in-unknown-object read=["prototype"]
# CHECK-NEXT: f0 v3 Construct operand 2: nothing contents=nothing stored-into-results=[0]
# CHECK: f0 v5 Construct operand 2: stored-in-unknown-object contents=nothing
# CHECK: f0 v7 ConstructList operand 2: members-read contents=stored-in-unknown-object read=[any]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f1
    v3 = Construct v2, -, v1
    v4 = NewClosure function=f2
    v5 = Construct v4, -, v1
    v6 = NewArray v1 contents=anything
    v7 = ConstructList v2, -, v6
    Return
}
function f1 name="Point" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="Leaky" flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
