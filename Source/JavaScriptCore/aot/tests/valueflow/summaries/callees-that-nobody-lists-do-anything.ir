# unknown(record);  (known or unknown)(record);  direct call;  a direct call of a function of which the table says nothing
# Where flow does not list every callee of a call, anything becomes of every operand. The operands of a direct call are the entry parameters of its callee, captures among them.
# RUN: fates-at-calls f1.p0=members-read f1.p1=nothing f1.p1.into-parameters=1
# CHECK: f0 v4 Call operand 0: anything
# CHECK-NEXT: f0 v4 Call operand 2: anything
# CHECK-NEXT: f0 v5 CallDirect operand 0: members-read contents=nothing read=[any]
# CHECK-NEXT: f0 v5 CallDirect operand 1: nothing contents=nothing stored-into-operands=[0]
# CHECK-NEXT: f0 v6 CallDirect operand 0: anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="unknown" [isFreeName]
    v4 = Call v3, -, v1
    v5 = CallDirect v1, v1 function=f1
    v6 = CallDirect v1 function=f2
    Return
}
function f1 name="known" captures=[{type=anything}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return
}
function f2 name="unsaid" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
