# list.push(record);  list.forEach(reader);  list.forEach(keeper);  list.map(giver);  Object.freeze(record);  Object.keys(record)
# The records of the table say where native code puts each operand: `push` stores its argument into the receiver, `freeze` returns its argument, `keys` lists the keys and keeps nothing.
# A callback is followed like a parameter that is called: `forEach` keeps neither the closure nor the list. It hands each element to the closure, whose function says what becomes of it,
# and the list itself as a third argument, which these functions cannot see. What `giver` returns goes into the array that `map` answers.
# RUN: fates-at-calls f1.p0=members-read f2.p0=members-written f2.p1=nothing f2.p1.into-parameters=1 f3.p0=nothing f3.p0.results=1
# CHECK: f0 v4 Call operand 1: members-read+members-written contents=nothing read=[any] written=[any]
# CHECK-NEXT: f0 v4 Call operand 2: nothing contents=nothing stored-into-operands=[1]
# CHECK: f0 v7 Call operand 1: members-read contents=members-read read=[any]
# CHECK-NEXT: f0 v7 Call operand 2: called contents=nothing
# CHECK: f0 v10 Call operand 1: members-read contents=stored-in-unknown-object read=[any]
# CHECK-NEXT: f0 v10 Call operand 2: called contents=members-written
# CHECK: f0 v13 Call operand 1: members-read contents=stored-in-unknown-object read=[any]
# CHECK-NEXT: f0 v13 Call operand 2: called contents=nothing
# CHECK: f0 v16 Call operand 2: returned+members-deleted-or-defined+keys-enumerated contents=nothing results=[0] written=[any]
# CHECK: f0 v18 Call operand 2: keys-enumerated contents=nothing

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Environment name="main" fields=[{key="kept" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    v3 = PropGet v2 key="push"
    v4 = Call v3, v2, v1 calleeKey="push"
    v5 = NewClosure function=f1
    v6 = PropGet v2 key="forEach"
    v7 = Call v6, v2, v5 calleeKey="forEach"
    v8 = NewObject layout=L1 fields=[]
    v9 = NewClosure v8 function=f2
    v10 = Call v6, v2, v9 calleeKey="forEach"
    v11 = NewClosure function=f3
    v12 = PropGet v2 key="map"
    v13 = Call v12, v2, v11 calleeKey="map"
    v14 = Builtin builtin=Object
    v15 = PropGet v14 key="freeze"
    v16 = Call v15, v14, v1 calleeKey="freeze"
    v17 = PropGet v14 key="keys"
    v18 = Call v17, v14, v1 calleeKey="keys"
    Return
}
function f1 name="reader" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f2 name="keeper" kind=Arrow captures=[{type=env L1}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: env L1, v1: anything):
    Return
}
function f3 name="giver" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
