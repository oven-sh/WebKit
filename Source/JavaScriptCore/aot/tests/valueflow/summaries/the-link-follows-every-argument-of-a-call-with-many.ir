# function last(a, b, c, d) { kept = d }
# function hands(o) { last(1, 2, 3, o) }         the fourth argument is an operand far behind the named ones
# RUN: relational-summary
# CHECK: f1
# CHECK-NEXT: p0: nothing | contents: nothing
# CHECK-NEXT: p1: nothing | contents: nothing
# CHECK-NEXT: p2: nothing | contents: nothing
# CHECK-NEXT: p3: stored-in-variable | contents: nothing
# CHECK: f2
# CHECK-NEXT: p0: stored-in-variable | contents: nothing

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewClosure function=f2
    v3 = Call v2, -, v1
    Return
}
function f1 name="last" parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {index=2}, {index=3 fate=[IsStoredInVariable]}]} {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return
}
function f2 name="hands" parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{}, {kind=Allocation index=2 fate=[IsCalled]}] handed=[{source=1 call=3}, {call=3 argument=5}]} {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1, v1, v1, v0
    Return
}
