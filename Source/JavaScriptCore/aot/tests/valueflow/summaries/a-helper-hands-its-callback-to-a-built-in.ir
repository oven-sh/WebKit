# function mapAll(list, use) { return list.map(use) }   mapAll(records, reader);  mapAll(records, giver)
# The call that calls `use` is native code's. The records of `map` say that it calls its argument with an element of the receiver, and the link puts that into the terms of `mapAll`.
# At each call of `mapAll` the function of the closure answers. What `giver` returns lies in the array that `map` answers, which `mapAll` returns.
# RUN: fates-at-calls
# CHECK: f0 v5 Call operand 2: members-read contents=called+members-read read=[any]
# CHECK-NEXT: f0 v5 Call operand 3: called contents=nothing
# CHECK: f0 v7 Call operand 2: members-read contents=stored-in-unknown-object+called read=[any]
# CHECK-NEXT: f0 v7 Call operand 3: called contents=nothing
# CHECK: f1 v3 Call operand 1: members-read contents=stored-in-unknown-object+members-read read=[any]
# CHECK-NEXT: f1 v3 Call operand 2: called contents=nothing

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewArray v1 contents=anything
    v3 = NewClosure function=f1
    v4 = NewClosure function=f2
    v5 = Call v3, -, v2, v4
    v6 = NewClosure function=f3
    v7 = Call v3, -, v2, v6
    Return
}
function f1 name="mapAll" kind=Arrow parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{fate=[HasMembersRead]}, {index=1}, {kind=ReadFrom index=2 key="map" fate=[IsCalled]}, {kind=CallResult index=3 fate=[IsReturned] results=1}] handed=[{source=2 call=3}, {call=3 argument=1}, {source=1 call=3 argument=2}]} {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="map"
    v3 = Call v2, v0, v1 calleeKey="map"
    Return v3
}
function f2 name="reader" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[HasMembersRead]}, {kind=ReadFrom index=1 key="x"}]} {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return
}
function f3 name="giver" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{fate=[IsReturned] results=1}] resultsFullyListed=1} {
  b0(v0: anything):
    Return v0
}
