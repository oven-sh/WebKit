# chosen = one or two or three; box = { go: kept }; answer = chosen.call(receiver, handed, box); answer(); box.go()    function one() { return made }
# The variable holds more functions than the analysis follows in one set, so the callee is the untracked object. It stands for functions of the program, which the analysis enters, so no code runs that nobody compiles.
# The receiver and the arguments stay in the program: none of them escapes, and a function among them that no callee calls is not entered. Nothing is stored into the object that is passed: a read of it finds what the program has stored and nothing else.
# The call gives what the callees return and no unknown object. call-of-unknown-lets-operands-escape.ir has the same call with a callee that nobody knows.
# OPTIONS: limit=MaxValueFlowSetMembers:2
# STATISTIC: MaxValueFlowSetMembersHits >= 1
# RUN: valueflow-solve calls
# CHECK: f0 v12 ->
# CHECK-NOT: unknown
# CHECK: f0 v13 -> f7
# CHECK-NEXT: f0 v15 -> f5
# CHECK-NOT: unknown
# RUN(CALLEES): valueflow-families callees
# CALLEES: application calls 3 unknown-callee 0 untracked-callee 1
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3
# UNREACHED: unreached f4
# UNREACHED-NEXT: unreached f6
# UNREACHED-NOT: unreached f7
# RUN(ESCAPED): valueflow-why escaped=f4 escaped=f5 escaped=f6
# ESCAPED: escaped=f4
# ESCAPED-NEXT: not held
# ESCAPED-NEXT: escaped=f5
# ESCAPED-NEXT: not held
# ESCAPED-NEXT: escaped=f6
# ESCAPED-NEXT: not held
# RUN(NUMBERS): valueflow-solve
# NUMBERS: reached-functions-escaped 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Box"
variable g0 name="chosen" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f3
    PutModuleVariable v4 variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = NewClosure function=f4
    v8 = NewObject layout=L0 fields=[]
    v9 = NewClosure function=f5
    PropSet v8, v9 key="go" mode=Strict
    v11 = NewClosure function=f6
    v12 = Call v6, v11, v7, v8
    v13 = Call v12
    v14 = PropGet v8 key="go"
    v15 = Call v14, v8
    Return
}
function f1 name="one" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewClosure function=f7
    Return v2
}
function f2 name="two" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return
}
function f3 name="three" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return
}
function f4 name="handed" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0, -
    Return
}
function f5 name="kept" module=m0 results=[{type=anything}] {
    Return
}
function f6 name="receiver" module=m0 results=[{type=anything}] {
    Return
}
function f7 name="made" module=m0 results=[{type=anything}] {
    Return
}
