# The program of protocols/generators.ir with a budget of one logged edge: every set of objects that still moves is given up, so the untracked object arrives wherever a rule expects a built-in, a closure or a container.
# The solve ends with a result all the same, and the program with the results applied is valid
# OPTIONS: limit=MaxValueFlowEdgesLogged:1
# LOSS: MaxValueFlowEdgesLogged
# RUN: valueflow-solve
# CHECK-NOT: stopped at a limit
# CHECK: functions
# RUN(APPLY): valueflow-apply
# APPLY: function f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    v2 = IteratorOpen v1
    v3 = IteratorResume v2
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    v6 = Undefined
    v7 = Call v5
    v8 = NewClosure function=f2
    v9 = Call v8
    v10 = PropGet v9 key="next"
    v11 = Call v10, v9 calleeKey="next"
    v12 = PropGet v11 key="value"
    v13 = Call v12
    v14 = NewClosure function=f6
    v15 = Call v10, v9, v14 calleeKey="next"
    Return
}
function f1 name="first" flags=[IsGenerator, TakesCallee] results=[{type=anything}] {
  b0(v0: function):
    InitialYield
    v2 = NewClosure function=f3
    v3 = Yield v2
    v4 = NewClosure function=f5
    Return v4
}
function f2 name="second" flags=[IsGenerator, TakesCallee] results=[{type=anything}] {
  b0(v0: function):
    InitialYield
    v2 = NewClosure function=f4
    v3 = Yield v2
    v4 = ResultAt v3
    v5 = Call v4
    Return
}
function f3 name="one" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="two" results=[{type=anything}] {
  b0():
    Return
}
function f5 name="returned" results=[{type=anything}] {
  b0():
    Return
}
function f6 name="sent" results=[{type=anything}] {
  b0():
    Return
}
