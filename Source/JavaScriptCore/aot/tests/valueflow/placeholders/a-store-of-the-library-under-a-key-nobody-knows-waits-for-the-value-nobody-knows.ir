# box.held = Bun; box.held = pass(somethingThatNoTableLists); storeOfLibrary(box.held, someKey); somethingThatNoTableLists(Bun)   where pass hands its operand through eight calls
# storeOfLibrary = (object, key) => { object[key] = 1 } is a function of the library. Its receiver shows Bun alone for a long while: the value nobody knows is still on its way, and in the end it stands for Bun there.
# A store under a key nobody knows hits every member of a built-in receiver, so the library's store waits until all else is at rest, and then writes no member of Bun.
# RUN: valueflow-solve used
# CHECK-NOT: BunServe

layout L0 name="Box" fields=[{key="held" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v2 = Builtin builtin=Bun
    v3 = Undefined
    v4 = NewObject layout=L0
    PropSet v4, v2 key="held" mode=Strict
    v6 = NewClosure function=f2
    v7 = Call v6, v3, v1
    PropSet v4, v7 key="held" mode=Strict
    v9 = PropGet v4 key="held"
    v10 = PropGet v0 key="someKey" [isFreeName]
    v11 = NewClosure function=f1
    v12 = Call v11, v3, v9, v10
    v13 = Call v1, v3, v2
    Return
}
function f1 name="storeOfLibrary" kind=Arrow role=Library parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=1
    ElemSet v0, v1, v2 mode=Strict
    Return
}
function f2 name="pass0" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = Undefined
    v3 = Call v1, v2, v0
    Return v3
}
