# The same program with a limit that its sets pass. A set that is given up may cost what is known about its own members. It does not make a function reachable that lies in an object nobody is handed
# OPTIONS: limit=MaxValueFlowSetMembers:2
# STATISTIC: MaxValueFlowSetMembersHits >= 1
# RUN: valueflow-solve unreached
# CHECK: unreached f71
# RUN(NUMBERS): valueflow-solve
# NUMBERS: unseen-code 0

layout L0 fields=[{key="kept" declared={type=anything}}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
