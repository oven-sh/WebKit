# new Set(plain = { [Symbol.iterator]: open, held }); new Set(odd = { [Symbol.iterator]: somethingNoTableLists, given })
# All that the constructor of sets goes over lies in one hub, and the method under @@iterator is called on an object with that object as `this`. A function nobody knows is found on one of the two objects alone:
# that one escapes, and what it holds is entered. On the other one a function of the program is found, which is entered with that object alone, and the object stays in the program.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# CHECK: unreached f2
# CHECK-NOT: unreached f3
# RUN(ESCAPED): valueflow-why escaped=f2 escaped=f3 escaped-layout=L0 values=f1:v1
# ESCAPED: escaped=f2
# ESCAPED-NEXT: not held
# ESCAPED: escaped=f3
# ESCAPED-NEXT: n0 escaped
# ESCAPED: escaped-layout=L0
# ESCAPED-NEXT: values=f1:v1
# ESCAPED: operand 0 {{*}} 1 members:

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key=@@iterator declared={type=anything} flags=[IsRequired]}, {key="held" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Odd" fields=[{key=@@iterator declared={type=anything} flags=[IsRequired]}, {key="given" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Set
    v1 = NewClosure function=f1
    v2 = NewClosure function=f2
    v3 = NewObject -, v1, v2 layout=L0 fields=[0, 1]
    v4 = Construct v0, -, v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="somethingThatNoTableLists" [isFreeName]
    v7 = NewClosure function=f3
    v8 = NewObject -, v6, v7 layout=L1 fields=[0, 1]
    v9 = Construct v0, -, v8
    Return
}
function f1 name="open" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="label"
    Return
}
function f2 name="held" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f3 name="given" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
