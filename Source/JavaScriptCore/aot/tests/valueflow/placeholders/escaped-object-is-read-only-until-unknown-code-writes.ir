# export default shown = { go: one, spare: two }; shown.go(); function never() { somethingNoTableLists() }
# The host reads the object, so it has escaped: code that nobody compiles reads what the object holds and calls it, also the function that the program itself never calls.
# Such code stores into what it holds only once something says that it may, and a call of a callee nobody knows in a function that is never reached says nothing. So a read finds what the program has stored and nothing else.
# realm-objects-stay-closed-without-unseen-code.ir has such an object after a call that is reached.
# RUN: valueflow-solve calls
# CHECK: f0 v5 -> f1
# CHECK-NOT: unknown
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="default" variable=g0}]
entry module=m0 hostReads=[{exportName="default"}]
layout L0 name="Shown" fields=[{key="go" declared={type=anything} flags=[IsRequired]}, {key="spare" declared={type=anything} flags=[IsRequired]}]
variable g0 name="default" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    PutModuleVariable v2 variable=g0
    v4 = PropGet v2 key="go"
    v5 = Call v4, v2
    v6 = NewClosure function=f3
    Return
}
function f1 name="one" results=[{type=anything}] {
    Return
}
function f2 name="two" results=[{type=anything}] {
    Return
}
function f3 name="never" results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v2 = Call v1, -
    Return
}
