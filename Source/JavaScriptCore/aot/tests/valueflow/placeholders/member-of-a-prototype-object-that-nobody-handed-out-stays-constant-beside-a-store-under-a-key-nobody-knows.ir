    v1 = PropGet v0 key="handedIn" [isFreeName]
    v2 = PropGet v0 key="name" [isFreeName]
    v3 = Builtin builtin=DatePrototype
    v4 = Call v1, -, v3
    v5 = Builtin builtin=ObjectGetPrototypeOf
    v6 = Call v5, -, v1
    v7 = NewClosure function=f1
    ElemSet v1, v2, v7
    v9 = ElemDelete v1, v2
    v10 = Builtin builtin=ErrorPrototype
    v11 = PropGet v10 key="toString"
    v12 = PropGet v3 key="toString"
    Return v6
}
