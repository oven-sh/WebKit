# handedIn(Date.prototype); above = Object.getPrototypeOf(handedIn); handedIn[globalThis.name] = mine; delete handedIn[globalThis.name]; Error.prototype.toString; Date.prototype.toString
# `above` may be any prototype object of the language, so all of them count as escaped. `handedIn` itself is one of them only where the program has handed
# that one out as a value: Date.prototype. Each member of it that can be replaced counts as written by the program. Error.prototype.toString stays constant: start-up locks it.
# RUN: valueflow-results
# CHECK: builtin-location DatePrototype."toString" Unknown
# CHECK: builtin-location ErrorPrototype."toString" Constant

