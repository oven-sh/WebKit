# function area(shape: Shape) { shape.side }  area(circle); area(square); area(triangle)    function count(shapes: Shape | Shape[]) { shapes.side }  count(circle); count(square); count(triangle)    spare.side
# The calls of one function share a node for each argument. Here that node gets more layouts than the analysis follows in one set, so the untracked object stands for them from there on.
# Nothing is tested in front of a parameter: its type is taken on trust. Where the type names layouts of the program alone, the untracked object can only be an object with one of those layouts,
# and one that the analysis has stopped following: those take its place, not the circle that is never passed, and no placeholder is left. Where other code makes values of the type too, here arrays,
# the untracked object passes as itself.
# OPTIONS: limit=MaxValueFlowSetMembers:2
# STATISTIC: MaxValueFlowSetMembersHits >= 2
# STATISTIC: LayoutsOutsideFamily = 0
# RUN: valueflow-families
# CHECK: parameter positions 2 layout-outside 0 unknown-object 0 object-without-layout 0 no-object 0 untracked-object 1
# RUN(RECEIVERS): valueflow-families receivers
# RECEIVERS: application accesses 3 unknown-object 0 object-without-layout 0 several-layouts 1 one-layout 1 no-object 0 untracked-object 1
# RUN(VALUES): valueflow-why values=f0:v5 values=f0:v6 values=f0:v7 values=f0:v12 values=f1:v1 values=f2:v1
# VALUES: values=f0:v5
# VALUES: operand 2 1 members: [[circle]]@f0
# VALUES: values=f0:v6
# VALUES: operand 2 1 members: [[square]]@f0
# VALUES: values=f0:v7
# VALUES: operand 2 1 members: [[triangle]]@f0
# VALUES: values=f0:v12
# VALUES: operand 0 1 members: [[spare]]@f0
# VALUES: values=f1:v1
# VALUES: operand 0
# VALUES-NOT: unknown
# VALUES-NOT: untracked
# VALUES-NOT: [[spare]]@f0
# VALUES: 3 members: [[circle]]@f0 [[square]]@f0 [[triangle]]@f0
# VALUES: values=f2:v1
# VALUES: operand 0 {{*}} untracked
# VALUES-NOT: [[spare]]@f0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Shape"
layout L1 name="Circle" supertypes=[L0]
layout L2 name="Square" supertypes=[L0]
layout L3 name="Triangle" supertypes=[L0]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1 fields=[]
    v1 = NewObject layout=L2 fields=[]
    v2 = NewObject layout=L3 fields=[]
    v3 = NewObject layout=L1 fields=[]
    v4 = NewClosure function=f1
    v5 = Call v4, -, v0
    v6 = Call v4, -, v1
    v7 = Call v4, -, v2
    v8 = NewClosure function=f2
    v9 = Call v8, -, v0
    v10 = Call v8, -, v1
    v11 = Call v8, -, v2
    v12 = PropGet v3 key="side"
    Return
}
function f1 name="area" module=m0 parameters=[{type=L0}] results=[{type=anything}] {
  b0(v0: L0):
    v1 = PropGet v0 key="side"
    Return
}
function f2 name="count" module=m0 parameters=[{type=L0|Array}] results=[{type=anything}] {
  b0(v0: L0|Array):
    v1 = PropGet v0 key="side"
    Return
}
