# JSON.stringify(plain = { held }); JSON.stringify(odd = { toJSON: somethingNoTableLists, given })
# All that JSON.stringify is handed, and whatever that holds, lies in one hub, and toJSON is called on an object with that object as `this`. A function nobody knows is found on one of the two objects alone:
# that one escapes, and what it holds is entered. The other one is read and stays in the program.
# one-serialized-object-with-an-unknown-toJSON-escapes-alone.ir with another order of the rules: the answer is the same.
# OPTIONS: testing=DelayFlowRules
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK-NOT: unreached f2
# RUN(ESCAPED): valueflow-why escaped=f1 escaped=f2 escaped-layout=L0
# ESCAPED: escaped=f1
# ESCAPED-NEXT: not held
# ESCAPED: escaped=f2
# ESCAPED-NEXT: n0 escaped
# ESCAPED: escaped-layout=L0
# ESCAPED-NOT: escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Odd" fields=[{key="toJSON" declared={type=anything} flags=[IsRequired]}, {key="given" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=JSONStringify
    v1 = NewClosure function=f1
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = Call v0, -, v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="somethingThatNoTableLists" [isFreeName]
    v6 = NewClosure function=f2
    v7 = NewObject -, v5, v6 layout=L1 fields=[0, 1]
    v8 = Call v0, -, v7
    Return
}
function f1 name="held" kind=Arrow results=[{type=anything}] {
    Return
}
function f2 name="given" kind=Arrow results=[{type=anything}] {
    Return
}
