# Promise.resolve(plain = { held }); Promise.resolve(odd = { then: somethingNoTableLists, given })
# All that Promise.resolve is handed lies in one hub, and `then` is called on an object with that object as `this`. A function nobody knows is found on one of the two objects alone: that one escapes, and what it holds is entered.
# The other one has no `then` and stays in the program.
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK-NOT: unreached f2
# RUN(ESCAPED): valueflow-why escaped=f1 escaped=f2 escaped-layout=L0
# ESCAPED: escaped=f1
# ESCAPED-NEXT: not held
# ESCAPED: escaped=f2
# ESCAPED-NEXT: n0 escaped
# ESCAPED: escaped-layout=L0
# ESCAPED-NOT: escaped

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Plain" fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Odd" fields=[{key="then" declared={type=anything} flags=[IsRequired]}, {key="given" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=PromiseResolve
    v1 = Builtin builtin=Promise
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Call v0, v1, v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="somethingThatNoTableLists" [isFreeName]
    v7 = NewClosure function=f2
    v8 = NewObject -, v6, v7 layout=L1 fields=[0, 1]
    v9 = Call v0, v1, v8
    Return
}
function f1 name="held" kind=Arrow results=[{type=anything}] {
    Return
}
function f2 name="given" kind=Arrow results=[{type=anything}] {
    Return
}
