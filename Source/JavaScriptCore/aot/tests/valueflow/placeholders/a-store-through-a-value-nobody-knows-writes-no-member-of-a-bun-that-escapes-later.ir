# box.held = Bun; box.held = somethingThatNoTableLists; box.held[someKey] = 1; somethingThatNoTableLists(pass(Bun))   where pass hands its operand through eight calls
# The receiver of the store is a value nobody knows or Bun, and Bun is handed out long after the rule of the store has first run. In the end the unknown object stands for Bun there, as if Bun had been
# handed out first: a store under a key nobody knows through a value nobody knows writes no member of a Bun that the receiver does not name.
# RUN: valueflow-solve used
# CHECK-NOT: BunServe

layout L0 name="Box" fields=[{key="held" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="somethingThatNoTableLists" [isFreeName]
    v2 = Builtin builtin=Bun
    v3 = Undefined
    v4 = NewObject layout=L0
    PropSet v4, v2 key="held" mode=Strict
    PropSet v4, v1 key="held" mode=Strict
    v7 = PropGet v4 key="held"
    v8 = PropGet v0 key="someKey" [isFreeName]
    v9 = Integer integer=1
    ElemSet v7, v8, v9 mode=Strict
    v11 = NewClosure function=f1
    v12 = Call v11, v3, v2
    v13 = Call v1, v3, v12
    Return
}
function f1 name="pass0" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f2
    v2 = Undefined
    v3 = Call v1, v2, v0
    Return v3
}
function f2 name="pass1" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = Undefined
    v3 = Call v1, v2, v0
    Return v3
}
