# Every writer of a variable is inside the type that the variable has once flow's results are applied
# RUN(VALID): flow-validate
# RUN(ALL): flow-validate
# VALID: valid
# ALL-NOT: invalid

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="held" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
