# A damage word that names nothing in the program, an unknown word and a second word are reported, and nothing is validated
# RUN: flow-validate members=L9999:L0
# CHECK: error: bad argument members=L9999:L0
# CHECK-NOT: valid
# RUN(VARIABLE): flow-validate declare-never=g1
# VARIABLE: error: bad argument declare-never=g1
# VARIABLE-NOT: valid
# RUN(VALUE): flow-validate assume=f0:v9:g0
# VALUE: error: bad argument assume=f0:v9:g0
# VALUE-NOT: valid
# RUN(CAST): flow-validate assume=f0:v0:g0
# CAST: error: bad argument assume=f0:v0:g0
# CAST-NOT: valid
# RUN(WORD): flow-validate forget=L0
# WORD: error: bad argument forget=L0
# WORD-NOT: valid
# RUN(SECOND): flow-validate members=L0:L0 declare-never=g0
# SECOND: error: bad argument declare-never=g0
# SECOND-NOT: valid

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="held" module=m0 declared={type=anything} initialization=Undefined
layout L0 name="Shape"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
