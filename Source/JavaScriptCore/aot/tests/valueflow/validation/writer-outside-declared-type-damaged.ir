# A store of a value outside the type of its variable is an error at the store
# RUN: flow-validate declare-never=g0
# CHECK: invalid
# DIAGNOSTIC: FlowWriterOutsideDeclaredType 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="held" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
