# name = key; name = "Glob"; [Bun].at(0)[name]()
# The key may be anything, and it may be the name that the program writes: that name is a use of Bun.Glob. No other member is named
# RUN: valueflow-solve used
# CHECK: BunGlob
# CHECK-NOT: BunArchive
# CHECK-NOT: BunSql

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="name" module=m0 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="key" [isFreeName]
    PutModuleVariable v1 variable=g0
    v3 = String string="Glob"
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=Bun
    v6 = NewArray v5 contents=anything
    v7 = PropGet v6 key="at"
    v8 = Integer
    v9 = Call v7, v6, v8
    v10 = GetModuleVariable variable=g0
    v11 = ElemGet v9, v10
    v12 = Call v11, v9
    Return v12
}
