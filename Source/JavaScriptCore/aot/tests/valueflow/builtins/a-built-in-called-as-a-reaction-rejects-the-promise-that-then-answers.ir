    v1 = Builtin builtin=PromiseResolve
    v2 = Builtin builtin=SymbolIterator
    v3 = Call v1, v0, v2
    v4 = Builtin builtin=PromisePrototypeThen
    v5 = Builtin builtin=MathAbs
    v6 = Call v4, v3, v5
    v7 = Builtin builtin=PromisePrototypeCatch
    v8 = NewClosure function=f1
    v9 = Call v7, v6, v8
    v10 = NewClosure function=f3
    v11 = NewObject -, v10 layout=L0 fields=[0]
    v12 = Call v1, v0, v11
    v13 = Builtin builtin=MathFloor
    v14 = Call v4, v12, v13
    v15 = NewClosure function=f2
    v16 = Call v7, v14, v15
    Return
}
