# function copy(target, source, key) { Object.defineProperty(target, key, Object.getOwnPropertyDescriptor(source, key)) }
# source = { first() {}, second() {} }; copy(target, source, unknownKey); target.first(); target.second()
# Both calls take one key value, so what lies under a name of the target is what lies under that name of the source.
# RUN: valueflow-solve calls
# CHECK: f0 v13 -> f2
# CHECK-NOT: f0 v13 -> {{*}}
# CHECK: f0 v15 -> f3
# CHECK-NOT: f0 v15 -> {{*}}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source"
layout L1 name="Target"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewObject layout=L0 fields=[]
    PropDefine v3, v1 key="first"
    PropDefine v3, v2 key="second"
    v6 = FinishObject v3
    v7 = NewObject layout=L1 fields=[]
    v8 = Builtin builtin=ObjectGetOwnPropertyNames
    v9 = Call v8, -, v6
    v10 = ElemGet v9, v9
    v11 = Call v0, -, v7, v6, v10
    v12 = PropGet v7 key="first"
    v13 = Call v12, v7
    v14 = PropGet v7 key="second"
    v15 = Call v14, v7
    Return
}
function f1 name="copy" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Builtin builtin=ObjectGetOwnPropertyDescriptor
    v4 = Call v3, -, v1, v2
    v5 = Builtin builtin=ObjectDefineProperty
    v6 = Call v5, -, v0, v2, v4
    Return
}
function f2 name="first" results=[{type=anything}] {
    Return
}
function f3 name="second" results=[{type=anything}] {
    Return
}
