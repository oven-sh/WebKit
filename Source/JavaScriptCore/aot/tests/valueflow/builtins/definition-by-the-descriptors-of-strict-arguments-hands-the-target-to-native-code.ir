# "use strict"; function strict() { target = {}; Object.defineProperties(target, Object.getOwnPropertyDescriptors(arguments)); other = {}; Object.defineProperties(other, Object.getOwnPropertyDescriptors({})) }
# The arguments of strict code are created with an accessor under `callee`, whose two functions are functions of the engine. The definition brings it, and a read of `target.callee` enters native code with the target.
# So the target may reach native code. The target of a definition from an ordinary object that has no accessor does not
# RUN: valueflow-results
# CHECK: class C0 layout=L0 impossibleMutations=[ReachUnknownJavaScript,
# CHECK-NEXT: class C1 layout=L1 impossibleMutations=[ReachNativeCode, ReachUnknownJavaScript,

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target"
layout L1 name="Other"
layout L2 name="Source"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Call v0, -, v1
    Return
}
function f1 name="strict" flags=[HasArgumentCount, HasHiddenRest] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: int[0, 4294967295], v1: anything, v2: Array):
    v3 = CreateUnmappedArguments v0, v2, v1
    v4 = NewObject layout=L0 fields=[]
    v5 = Builtin builtin=CompilerHelpersDescribeUnlessOrdinary
    v6 = Call v5, -, v3
    v7 = Builtin builtin=CompilerHelpersDefinePropertiesFrom
    v8 = Call v7, -, v4, v6, v3
    v9 = PropGet v4 key="callee"
    v10 = NewObject layout=L2 fields=[]
    v11 = NewObject layout=L1 fields=[]
    v12 = Call v5, -, v10
    v13 = Call v7, -, v11, v12, v10
    v14 = PropGet v11 key="callee"
    Return
}
