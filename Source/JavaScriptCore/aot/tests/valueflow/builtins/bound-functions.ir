# A bound function is an object of the call that made it. A call of it enters the target with the bound this and the bound arguments.
# RUN: valueflow-solve calls
# CHECK: f0 v4 -> FunctionPrototypeBind
# CHECK-NEXT: f0 v5 -> object
# CHECK-NEXT: f1 v2 -> f2
# CHECK-NEXT: f1 v3 -> f3
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED-NOT: unreached f3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=FunctionPrototypeBind
    v4 = Call v3, v0, v1, v2
    v5 = Call v4
    Return
}
function f1 name="target" flags=[HasThis] parameters=[{type=anything}] results=[{type=anything}] {
    v2 = Call v0
    v3 = Call v1
    Return
}
function f2 name="boundThis" kind=Arrow results=[{type=anything}] {
    Return
}
function f3 name="boundArgument" kind=Arrow results=[{type=anything}] {
    Return
}
