# var accessors = { flowing: { configurable: true }, ended: { configurable: true } };
# accessors.flowing.get = function () { .. }; accessors.ended.get = function () { .. };
# Object.defineProperties(State.prototype, accessors);
# Between the literal and the call the map is only read, under names that it was created with. Such a read runs no code and gives the map no name, so each name is defined by itself:
# a read of `flowing` runs the getter of `flowing` and no other, and under another name nothing is found. The same for a map that is a literal of constants.
# The third map is read under a name that it was not created with: a getter above it may have given it any name, and every read of every name may meet its getter.
# RUN: valueflow-solve calls
# CHECK: f0 v21 -> f4
# CHECK-NOT: f0 v21 -> f5
# CHECK: f0 v23 -> f5
# CHECK-NOT: f0 v23 -> f4
# CHECK-NOT: f0 v25 -> f
# CHECK: f0 v38 -> f8
# CHECK-NOT: f0 v40 -> f
# CHECK: f0 v55 -> f11
# CHECK: f0 v57 -> f11

