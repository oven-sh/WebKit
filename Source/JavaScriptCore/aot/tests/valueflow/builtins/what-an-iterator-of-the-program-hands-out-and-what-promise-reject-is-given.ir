  b0(v0: anything):
    v1 = NewObject -, v0 layout=L6 fields=[0]
    v2 = NewObject layout=L3
    v3 = NewClosure v1 function=f2
    PropSet v2, v3 key=@@iterator mode=Strict
    Return v2
}
