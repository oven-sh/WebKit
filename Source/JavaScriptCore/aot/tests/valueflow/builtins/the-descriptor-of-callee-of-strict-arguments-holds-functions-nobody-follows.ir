# "use strict"; function strict() { d = Object.getOwnPropertyDescriptor(arguments, "callee"); d.get(); d.set(1); Object.getOwnPropertyDescriptor(arguments, "length").get() }
# The arguments of strict code are created with an accessor under `callee`. Nobody writes it, so it is not among what was written into the object, and its two functions are functions of the engine
# that nobody follows: `get` and `set` of its descriptor are not undefined alone. `length` holds a value that was written: `get` of its descriptor is undefined, and the call of it calls nothing.
