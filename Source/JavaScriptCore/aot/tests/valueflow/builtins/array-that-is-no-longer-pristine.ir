# An array that has been given another prototype may fail the test for a pristine array. The overload for any object is then applied too: above the array lies Object.prototype, whose `constructor` finds nothing under @@species,
# so the result is a new array all the same, and what the mapper answers lies in it and nowhere else.
# Of a pristine array the answers lie in the new array and nowhere else, and nobody reads that here.
# RUN: valueflow-solve calls
# CHECK: f0 v4 -> ObjectSetPrototypeOf
# CHECK-NEXT: f0 v7 -> ArrayPrototypeMap
# CHECK-NEXT: f0 v8 -> object
# CHECK-NEXT: f0 v12 -> ArrayPrototypeMap
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f1
# UNREACHED-NOT: unreached f2
# UNREACHED: unreached f3
# UNREACHED-NOT: unreached f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=ObjectPrototype
    v3 = Builtin builtin=ObjectSetPrototypeOf
    v4 = Call v3, -, v1, v2
    v5 = Builtin builtin=ArrayPrototypeMap
    v6 = NewClosure function=f2
    v7 = Call v5, v1, v6
    v8 = Call v7
    v9 = NewClosure function=f3
    v10 = NewArray v9 contents=anything
    v11 = NewClosure function=f4
    v12 = Call v5, v10, v11
    Return
}
function f1 name="element" kind=Arrow results=[{type=anything}] {
    Return
}
function f2 name="mapper" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f3 name="elementOfPristineArray" kind=Arrow results=[{type=anything}] {
    Return
}
function f4 name="mapperOfPristineArray" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
