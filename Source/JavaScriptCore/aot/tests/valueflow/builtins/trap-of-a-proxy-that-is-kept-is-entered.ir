# kept = new Proxy({}, { get(target, key) { return key } })   publish(new Proxy({}, { get(target, key) { return key } }))
# No statement calls a trap: it runs where somebody does something to the proxy. Nothing is done to the proxy that is only kept in a variable: its trap is not entered.
# The other proxy is in unknown hands, and so is its handler then: what the handler holds is entered with operands nobody knows.
# RUN: valueflow-solve unreached
# CHECK: unreached f1
# CHECK-NOT: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Target"
layout L1 name="Handler" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
layout L2 name="HandlerOfPublished" fields=[{key="get" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewObject layout=L0
    v1 = NewClosure function=f1
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = Builtin builtin=Proxy
    v4 = Construct v3, -, v0, v2
    PutModuleVariable v4 variable=g0
    v6 = NewClosure function=f2
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = Construct v3, -, v0, v7
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="publish" [isFreeName]
    v11 = Call v10, -, v8
    Return
}
function f1 name="get" kind=Method parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
function f2 name="get" kind=Method parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
