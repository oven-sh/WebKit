# class Cache extends Map { constructor(entries) { super(entries) } set(key, value) { return [key, value] } }; new Cache([[1, held]])
# LIBRARY: own
# RUN: valueflow-why reached=f2 escaped=f2 escaped=f1 values=f2:v2
# CHECK: reached=f2
# CHECK-NEXT: f2 <- CallGroup
# CHECK: escaped=f2
# CHECK-NEXT: not held
# CHECK: escaped=f1
# CHECK-NEXT: not held
# CHECK: operand 1 {{*}}@f0
# CHECK-NEXT: operand 2 {{*}}@f0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Cache" constructor=f1 flags=[HasHeritage]
layout L1 name="Held"
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=Map
    v1 = NewClosure function=f1
    v2 = ResolveHeritage v0
    v3 = NewClass v1, v0, v2 layout=L0
    v4 = NewClosure function=f2
    DefineMethod v3, v4 layout=L0 key="set"
    v6 = FinishClass v3 layout=L0
    v7 = Integer integer=1
    v8 = NewObject layout=L1
    v9 = NewArray v7, v8 contents=anything
    v10 = NewArray v9 contents=anything
    v11 = Construct v6, -, v10
    Return v11
}
function f1 name="Cache" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] {
    v3 = GetSuperBase v0 homeKind=Object
    v4 = SuperConstruct v3, v1, v2 layout=L0
    Return v4
}
function f2 name="set" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = NewArray v0, v1 contents=anything
    Return v2
}
