# class Body { constructor() { this.hits = 0 } }; body = new Body; somebody = new Proxy({}, {}); somebody.onerror = body; return body.hits
# The proxy is the unknown object. The classes of the host that have a setter under the name throw for a receiver that is no instance of theirs, and nothing has made an instance.
