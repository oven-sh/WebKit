# holder = { kept: stored, other: beside }; handedOver(Object.getOwnPropertyDescriptor(holder, "kept"), Reflect.getOwnPropertyDescriptor(holder, "kept"))
# Whoever gets the record gets what lies under the key, and may call it. The record does not lead back to the object, so a function under another key of it is not entered.
# RUN: valueflow-solve unreached
# CHECK: unreached f2
# CHECK-NOT: unreached

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Holder" fields=[{key="kept" declared={type=anything} flags=[IsRequired]}, {key="other" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = String string="kept"
    v4 = Builtin builtin=Object
    v5 = Builtin builtin=ObjectGetOwnPropertyDescriptor
    v6 = Call v5, v4, v2, v3
    v7 = Builtin builtin=ReflectGetOwnPropertyDescriptor
    v8 = Call v7, -, v2, v3
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="handedOver" [isFreeName]
    v11 = Call v10, -, v6, v8
    Return
}
function f1 name="stored" results=[{type=anything}] {
    Return
}
function f2 name="beside" results=[{type=anything}] {
    Return
}
