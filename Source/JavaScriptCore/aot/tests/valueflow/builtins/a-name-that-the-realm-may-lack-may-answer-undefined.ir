# typeof ShadowRealm === "undefined" ? typeof WeakRef === "undefined" : 0
# An option of the engine takes ShadowRealm away, so the table marks it MayBeAbsent: the read may pass the global object by and answer undefined, and the test stays. Nothing takes WeakRef away, so undefined is none of its answers.
# RUN: valueflow-apply
# CHECK: = AssumeType v1 castType=undefined|builtin(ShadowRealm)
# CHECK-NEXT: : boolean = TypeTest
# CHECK-NOT: undefined|builtin(WeakRef)

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="ShadowRealm" [isFreeName, isForTypeOf]
    v2 = TypeTest v1 testedType=undefined
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = PropGet v0 key="WeakRef" [isFreeName, isForTypeOf]
    v4 = TypeTest v3 testedType=undefined
    Return v4
  b2():
    v5 = Integer integer=0
    Return v5
}
