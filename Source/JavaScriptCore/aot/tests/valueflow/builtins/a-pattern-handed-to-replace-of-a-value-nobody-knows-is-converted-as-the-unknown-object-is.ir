# const rule = /a/g; let label = globalThis.given ? "text" : globalThis.given; label = label.replace(rule, "-"); globalThis.report(label)
# `label` may be anything, so `replace` may be any function and the pattern escapes. String.prototype.replace walks over the pattern, and what it reads off an object that unknown code
# may have written to holds the unknown object, which stands for the pattern from then on. Until it arrived the walk looked up `toString` and `valueOf` on the pattern by itself,
# found a function nobody knows, and ran every built-in of those names on it: 65 built-ins at the usual order of flow's rules, 7 to 69 by the order.
# RUN: valueflow-solve used
# CHECK-NOT: run DatePrototypeToString
# CHECK-NOT: run ErrorPrototypeToString
# CHECK: run RegExpPrototypeExec
# CHECK: run RegExpPrototypeSymbolReplace
# CHECK: run StringPrototypeReplace
# CHECK-NOT: run SymbolPrototypeToString
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED: unreached f1

module m0 path="/app/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewRegExp pattern="a" regExpFlags=[Global]
    v1 = String string="text"
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="given" [isFreeName]
    v4 = ToBoolean v3
    Branch v4 -> taken b1(v1), notTaken b1(v3)
  b1(v5: anything):
    v6 = PropGet v5 key="replace"
    v7 = String string="-"
    v8 = Call v6, v5, v0, v7 calleeKey="replace"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="report" [isFreeName]
    v11 = Call v10, -, v8
    Return
}
