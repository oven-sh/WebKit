# The entry of a built-in is applied with the operands of one call: what is pushed to one array is not found in another.
# RUN: valueflow-solve calls
# CHECK: f0 v5 -> ArrayPrototypePush
# CHECK-NEXT: f0 v6 -> ArrayPrototypePush
# CHECK-NEXT: f0 v9 -> f1
# RUN(UNREACHED): valueflow-solve unreached
# UNREACHED-NOT: unreached f1
# UNREACHED: unreached f2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = NewArray contents=anything
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Builtin builtin=ArrayPrototypePush
    v5 = Call v4, v0, v2
    v6 = Call v4, v1, v3
    v7 = Integer integer=0
    v8 = ElemGet v0, v7
    v9 = Call v8
    Return
}
function f1 name="pushedToFirst" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="pushedToSecond" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
