# source = { run: one, idle: two, get late() { .. }, get never() { .. } }; target = {}; Object.defineProperties(target, Object.getOwnPropertyDescriptors(source)), as the front end writes the pair
# The target finds each property of the source under its name, and the source goes to nobody: `target.run()` calls `one` alone, and nobody calls `idle`.
# No getter runs at the definition: `never` is not reached. A read of `target.late` runs that getter.
# RUN: valueflow-solve unreached calls
# CHECK: f0 v14 -> f1
# CHECK-NOT: f0 v14 -> {{*}}
# CHECK: unreached f2
# CHECK-NOT: unreached f3
# CHECK: unreached f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Source" fields=[{key="run" declared={type=anything} flags=[IsRequired]}, {key="idle" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Target"
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    DefineGetter v4, v2 key="late"
    DefineGetter v4, v3 key="never"
    v7 = FinishObject v4
    v8 = NewObject layout=L1 fields=[]
    v9 = Builtin builtin=CompilerHelpersDescribeUnlessOrdinary
    v10 = Call v9, -, v7
    v11 = Builtin builtin=CompilerHelpersDefinePropertiesFrom
    v12 = Call v11, -, v8, v10, v7
    v13 = PropGet v8 key="run"
    v14 = Call v13, v8
    v15 = PropGet v8 key="late"
    Return
}
function f1 name="one" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="two" results=[{type=anything}] {
  b0():
    Return
}
function f3 name="late" results=[{type=anything}] {
  b0():
    Return
}
function f4 name="never" results=[{type=anything}] {
  b0():
    Return
}
