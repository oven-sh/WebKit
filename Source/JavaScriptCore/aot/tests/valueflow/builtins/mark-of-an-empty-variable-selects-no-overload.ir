# const plainText = /abc/; function search(text) { return text.search(plainText) }
# The set of a lexical variable holds the mark of a variable that is not initialized from the start. No call passes that mark, so it selects no overload of a built-in:
# the call takes the overload for a RegExp that behaves as the language says, answers a number, and leaves the literal as it was created
# RUN: valueflow-apply
# CHECK: variable g0 name="plainText" module=m0 declared={type=RegExp<"abc"[], pristine[Storage, Names, AsCreated]>}
# CHECK: function f1 name="search" {{*}}parameters=[{type=string}] results=[{type=number}]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="plainText" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewRegExp pattern="abc"
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="text" [isFreeName]
    v4 = ToString v3
    v5 = CallDirect v4 function=f1
    Return v5
}
function f1 name="search" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g0
    v2 = PropGet v0 key="search"
    v3 = Call v2, v0, v1 calleeKey="search"
    Return v3
}
