# [1].map(double), where the library's map hands its callback a function of its own
# The code behind a described built-in calls a callback nobody knows. That is no sign of code that nobody compiles, and what the call hands over is in the hands of the callback all the same:
# `inner`, which the library has written for it, is reached, with an operand nobody knows
# LIBRARY: own
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f3
# RUN(WHY): valueflow-why flag=h6 values=f3:v1
# WHY: flag=h6
# WHY-NEXT: not held
# WHY: values=f3:v1
# WHY: operand 0 {{*}} unknown

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=64 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    v2 = NewClosure function=f2
    v3 = PropGet v1 key="map"
    v4 = Call v3, v1, v2 calleeKey="map"
    Return
}
function f1 name="map" role=Library flags=[HasThis] enclosingRuntimeFunction=64 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = NewClosure function=f3
    v4 = Call v1, v2, v3
    Return v4
}
function f2 name="double" kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
function f3 name="inner" role=Library enclosingRuntimeFunction=64 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
