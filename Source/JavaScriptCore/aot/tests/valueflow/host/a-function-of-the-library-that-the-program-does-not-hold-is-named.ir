# Array.from({ length: 2 }, make), as the front end writes it: a call of the compiler's arrayFromLength, in a program that was handed over WITHOUT that function.
# Flow wants to enter it with what the call passes and does not find it. It says so: whoever handed the program over adds the function and compiles again.
# LIBRARY: own
# RUN: valueflow-solve lacked
# CHECK: lacked {{*}}
# CHECK-NOT: lacked

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=2
    v1 = NewClosure function=f1
    v2 = Builtin builtin=CompilerHelpersArrayFromLength
    v3 = Call v2, -, v0, v1
    Return
}
function f1 name="make" kind=Arrow parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
