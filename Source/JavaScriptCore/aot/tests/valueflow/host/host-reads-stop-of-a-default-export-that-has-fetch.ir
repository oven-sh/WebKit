# class Config { get stop() { .. } get other() { .. } fetch() { .. } }    export default new Config()
# A server has `fetch` too, so the host reads `stop` of a default export that has `fetch` before it hands it to Bun.serve. The getter above the instance runs. Nobody reads `other`.
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f2
# CHECK-NOT: unreached f3
# CHECK: unreached f4

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="default" variable=g0}]
entry module=m0 hostReads=[{exportName="default" builtin=BunServe}]
layout L0 kind=Instance name="Config" constructor=f1
variable g0 name="default" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="stop"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 index=1 key="fetch"
    v6 = NewClosure function=f4
    DefineMethod v1, v6 layout=L0 methodKind=Getter index=2 key="other"
    v8 = FinishClass v1 layout=L0
    v9 = Construct v8
    PutModuleVariable v9 variable=g0
    Return
}
function f1 name="Config" module=m0 kind=BaseConstructor flags=[HasNewTarget] results=[{type=object}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="stop" module=m0 kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f3 name="fetch" module=m0 kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
