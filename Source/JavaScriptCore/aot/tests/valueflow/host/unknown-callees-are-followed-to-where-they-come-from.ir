# RUN(NAMES): valueflow-why unknown-callees=names
# NAMES: roots
# NAMES: 3{{*}}parameter of an escaped function{{*}}f1 handler Source main.js escaped by
# NAMES: 1{{*}}member of a known object, UndescribedNativeResult{{*}}GlobalThis

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="take" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="handler" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="end"
    v2 = Call v1, v0
    v3 = PropGet v0 key="body"
    v4 = Call v3, v0
    v5 = PropGet v4 key="close"
    v6 = Call v5, v4
