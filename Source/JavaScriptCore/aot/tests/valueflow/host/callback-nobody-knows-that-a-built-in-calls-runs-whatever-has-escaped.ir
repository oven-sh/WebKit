# member = handedIn[someName]; new Promise(member)
# The executor of a promise is a value that the program hands over, and native code calls it. Nobody knows it: whatever has escaped may be the one.
# RUN: valueflow-solve used
# CHECK: run ArrayPrototypeSort

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="handedIn" [isFreeName]
    v2 = PropGet v0 key="someName" [isFreeName]
    v3 = ElemGet v1, v2
    v4 = Builtin builtin=Promise
    v5 = Construct v4, -, v3
    Return
}
