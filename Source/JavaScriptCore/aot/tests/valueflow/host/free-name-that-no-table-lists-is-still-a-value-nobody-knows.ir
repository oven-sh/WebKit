# CHECK: values=f0:v1
# CHECK: result {{*}} unknown
# CHECK: values=f0:v2
# CHECK: result {{*}} 1 members: primitive0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="someBinding" [isFreeName]
    v2 = PropGet v0 key="someBinding"
    v3 = NewClosure function=f1
    v4 = Call v3, -, v1
    v5 = Call v3, -, v2
    Return
}
function f1 name="keep" module=m0 parameters=[{type=anything}] results=[{type=anything}] {
    Return
}
