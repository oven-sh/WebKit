# member = handedIn[someName]; member()
# member-read-under-a-key-nobody-knows-is-held-and-does-not-run.ir with a call of the value. Nobody knows the callee, and it names no member of a receiver: whatever has escaped may be the one.
# RUN: valueflow-solve used
# CHECK: run ArrayPrototypeSort

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="handedIn" [isFreeName]
    v2 = PropGet v0 key="someName" [isFreeName]
    v3 = ElemGet v1, v2
    v4 = Call v3, -
    Return
}
