}
function f1 name="find" role=Library flags=[HasThis] enclosingRuntimeFunction=ArrayPrototypeFind parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = PropGet v0 key="length"
    v4 = Integer integer=0
    v5 = ElemGet v0, v4
    v6 = Call v1, v2, v5, v4, v0
