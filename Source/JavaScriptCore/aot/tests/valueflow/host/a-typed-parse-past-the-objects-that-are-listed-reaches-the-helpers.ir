# JSON.parse<Row>(text) where Row reaches more objects than a typed result lists. The validation stays: SelectTypedResults hands the answer of the call to validateByPlan in the library
# (runtimefunction 131117), so the call counts as a call of the helper, as one with a typed result does. What comes out of the call is whatever the helper makes: nobody knows it
# LIBRARY: own
# OPTIONS: limit=MaxObjectsOfTypedResult:1
# RUN: valueflow-solve unreached
# CHECK-NOT: unreached f1
# RUN(WHY): valueflow-why reached=f1
# WHY: f1 <- UsedBuiltins

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
expectedresult x0 type=L0 layouts=[L0] validation=[{shape=Object{layout=L0 members=[{key="id" node=1 field=0}]} type=L0}, {shape=Primitive{primitive=Number} type=number}]
layout L0 name="Row" module=m0 position=10 fields=[{key="id" declared={type=number}}]
runtimefunction id=131117 function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = String string="{\"id\":1}"
    v1 = Builtin builtin=JSON
    v2 = Builtin builtin=JSONParse
    v3 = Call v2, v1, v0 expectedResult=x0
    Return
}
function f1 name="validateByPlan" role=Library enclosingRuntimeFunction=131117 parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything):
    Return v0
}
