# The exports object belongs to one module, and native code holds it only if somebody hands it over
# RUN: valueflow-solve unreached
# CHECK: unreached f1

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0
layout L0 name="Exports"
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
    v0 = NewObject layout=L0
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    PropSet v0, v2 key="handler" mode=Strict
    Return
}
function f1 name="handler" module=m0 results=[{type=anything}] {
    Return
}
