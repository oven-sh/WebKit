# async function later(p) { await 0; p.n }   function* walk(p) { yield p.n }
# The activation outlives the call. A record that only says "members are read" is true of the body and false of the call.
# RUN: relational-summary
# CHECK-NOT: members-read
# RUN(SITES): fates-at-calls
# SITES: f0 v4 Call operand 2: anything
# SITES: f0 v5 Call operand 2: anything

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Thing" fields=[{key="n" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Integer integer=1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Call v0, -, v3
    v5 = Call v1, -, v3
    Return
}
function f1 name="later" module=m0 flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{kind=Parameter index=0 fate=[HasMembersRead]}, {kind=ReadFrom index=3 source=0 key="n"}]} {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = Await v1
    v3 = PropGet v0 key="n"
    Return
}
function f2 name="walk" module=m0 flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=anything}] relations={subjects=[{kind=Parameter index=1 fate=[HasMembersRead]}, {kind=ReadFrom index=3 source=0 key="n" fate=[IsYielded]}]} {
  b0(v0: function, v1: anything):
    InitialYield
    v3 = PropGet v1 key="n"
    v4 = Yield v3
    Return
}
