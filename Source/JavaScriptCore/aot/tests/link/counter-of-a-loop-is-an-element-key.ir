# If only an integer counted as the key of an element, the counter of `for (let i = 0; i < n; i++)`, which is an integer or a whole number to Link, would count as any name: `list[i] = "x"` would let the list escape, and `list[i]` would read anything
# function fill(list, n) { for (let i = 0; i < n; i++) list[i] = "x"; }  function last(list, n) { let found = 0; for (let i = 0; i < n; i++) found = list[i]; return found; }  const list = [];  fill(list, 3);  last(list, 3);
# Whatever number a key is, it is printed as an index or as another canonical numeric string, and a name of that kind goes with the elements too.
