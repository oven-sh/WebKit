# If every request of a module were evaluated as soon as any of its code is reached, a file that only a `require()` in a ruled-out block loads would run in Link's eyes, and all that it exports would escape
# main.js: enum Mode { On = 1 }  if (Mode.On !== 1) require("./behind.js").dead();  require("./loaded.js").live();
# A request of the kind Require stands for sites in bodies. Each site is an operation that names the file, so Link hears of it from the summary of whoever holds the operation.
# RUN: summary f0 mechanisms=all
# CHECK: names-where-no-run-comes m1
# CHECK: never-entered b1
# RUN(LINK): link functions mechanisms=all
# LINK: function f1 unreached
# LINK: function f2 unreached
# LINK-NOT: unreached
# RUN(BOTH): link functions mechanisms=-Folding
# BOTH-NOT: unreached
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 7
# ALL-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none
# NONE: 7
# NONE-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 kind=Require completes=true}, {target=m2 kind=Require completes=true}]
module m1 path="/behind.js" displayPath="behind.js" body=f1 exports=[{name="dead" variable=g0}]
module m2 path="/loaded.js" displayPath="loaded.js" body=f3 exports=[{name="live" variable=g1}]
entry module=m0
variable g0 name="dead" module=m1 declared={type=function} initialization=Function function=f2 flags=[IsImmutable]
variable g1 name="live" module=m2 declared={type=function} initialization=Function function=f4 flags=[IsImmutable]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b2(), notTaken b1()
  b1():
    EvaluateModule module=m1 referrer=m0 [isCallOfRequire]
    v4 = GetModuleVariable variable=g0
    v5 = Call v4, - calleeName="dead"
    Jump -> next b2()
  b2():
    EvaluateModule module=m2 referrer=m0 [isCallOfRequire]
    v7 = GetModuleVariable variable=g1
    v8 = Call v7, - calleeName="live"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="print" [isFreeName]
    v11 = Call v10, -, v8
    Return v11
}
function f1 name="behind" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="dead" module=m1 results=[{type=anything}] {
    v0 = Integer integer=5
    Return v0
}
function f3 name="loaded" module=m2 kind=Module results=[{type=anything}] {
    Return
}
function f4 name="live" module=m2 results=[{type=anything}] {
    v0 = Integer integer=7
    Return v0
}
