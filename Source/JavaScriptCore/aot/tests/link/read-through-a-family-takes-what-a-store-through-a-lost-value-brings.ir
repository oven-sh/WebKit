# A store through a lost value names no member: what it brings lies under the key, beside the fields of nobody in particular. A read through a declared union takes that once a member WITHOUT the name is lost.
# `o` meets an object of a layout that shares no family with it, so both are lost, and the store lays "x" on one of the two.
# Without that tie the result of `read` was undefined|i32, and `String(read(o))` printed undefined for "laid".
#   interface Other { w: number }
#   function read(value: A | B | C) { return (value as A).x; }
#   function pick(flag, one: unknown, two: unknown) { return flag ? one : two; }
#   function run(n) { const o = makeB(n); (pick(n > 0, o, makeOther(n)) as any).x = "laid"; return read(n > 1 ? makeA(n) : n > 0 ? o : makeC(n)); }
