# Function.prototype.call makes the call, and what stands at the site are the operands of `call`: the first is the receiver, not the locale. Nobody reads them
# const format = (5).toLocaleString; format.call(5, "de");
# LIBRARY: own
# RUN: locales
# CHECK: locale unknown NumberPrototypeToLocaleString
# RUN(NEVER): locales
# NEVER-NOT: locale constant

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    v1 = PropGet v0 key="toLocaleString"
    v2 = PropGet v1 key="call"
    v3 = String string="de"
    v4 = Call v2, v1, v0, v3 calleeKey="call"
    Return v4
}
