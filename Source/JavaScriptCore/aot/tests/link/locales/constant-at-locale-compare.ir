# the locale is the second argument: the row says which. The first is a text too, and is no locale
# "a".localeCompare("b", "sv");
# RUN: locales
# CHECK: locale constant "sv" StringPrototypeLocaleCompare
# RUN(NEVER): locales
# NEVER-NOT: locale constant "b"
# NEVER-NOT: locale unknown
# NEVER-NOT: efault

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = String string="b"
    v2 = String string="sv"
    v3 = PropGet v0 key="localeCompare"
    v4 = Call v3, v0, v1, v2 calleeKey="localeCompare"
    Return v4
}
