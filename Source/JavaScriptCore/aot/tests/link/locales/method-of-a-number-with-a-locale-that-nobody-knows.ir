# no operation names the method: Link finds it on the number. Unless somebody looks at that call the program asks for no locale at all, and a trimmed executable formats wrongly in silence
# (1234.5).toLocaleString(globalThis.input);
# RUN: locales
# CHECK: locale unknown NumberPrototypeToLocaleString at f0 v2
# RUN(NEVER): locales
# NEVER-NOT: locale constant

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Double number=1234.5
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="input" [isFreeName] @40
    v3 = PropGet v0 key="toLocaleString"
    v4 = Call v3, v0, v2 calleeKey="toLocaleString" @20
    Return v4
}
