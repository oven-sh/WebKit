# If the row counted as one that takes numbers alone, the call would count as refused, nobody would ask the object for a primitive, and `valueOf` would not be compiled: the program stops where it is called
# What a row writes of a parameter that it converts is what the conversion leaves as it is. The conversion takes whatever is passed
# Math.abs({ valueOf() { return 7; } });
# RUN: link functions mechanisms=all
# CHECK: function f1
# CHECK-NOT: unreached

layout L0 module=m0 fields=[{key="valueOf" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Math
    v1 = Builtin builtin=MathAbs
    v2 = NewClosure function=f1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Call v1, v0, v4 calleeName="Math.abs"
    Return v5
}
function f1 name="valueOf" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
