# With wide references the hidden words are as wide as a slot: the word of the Extension keeps its place in front of the slots, and that of the extra properties lies behind the last one.
# OPTIONS: references=wide
# RUN: plan layouts mechanisms=all
# CHECK: layout L0 CompiledObject size=48 extension=24
# CHECK: slot 0 "a" {{*}}Inline offset=24
# CHECK-NEXT: slot 1 "b" appended JSValue OutOfLine offset=8 record=1
# CHECK-NEXT: slot 2 "c" appended JSValue OutOfLine offset=16 record=2
# CHECK-NEXT: extension Cell Inline offset=16
# CHECK-NEXT: extra-properties Cell Inline offset=32

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = String string="s"
    PropSet v2, v3 key="b"
    v5 = Integer integer=2
    PropSet v2, v5 key="c"
    v7 = Null
    PropSet v2, v7 key="b"
    v9 = NewObject -, v0 layout=L1 fields=[0]
    v10 = FinishObject v9
    v11 = PropGet v2 key="b"
    v12 = PropGet v10 key="b"
    v13 = NewClosure function=f1
    v14 = Call v13, -, v11, v12 calleeName="use"
    v15 = Undefined
    Return v15
}
function f1 name="use" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Undefined
    Return v2
}
