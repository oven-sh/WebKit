# the one property changed: the promise is handed to code that nobody has seen. Its family holds anything in every slot, so nothing is expected of what it is fulfilled with. What the body returns is the body's, and stays known
# async function make(o) { return o; }  sink(make({ x: "a" }));
# the object has escaped with its promise, and a proof names no layout that has escaped, so it is written as an object of unseen code. A node that the escape had opened would hold anything, and nothing would be printed
# RUN: link coroutines mechanisms=all
# CHECK: coroutine f1 returned=object?UnseenCode
# RUN(HELD): link held coroutines mechanisms=all
# HELD: coroutine f1 returned=L0
# RUN(NOT): link held coroutines mechanisms=all
# NOT-NOT: fulfilled=

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2 calleeName="make"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="sink" [isFreeName]
    v7 = Call v6, -, v4
    v8 = Undefined
    Return v8
}
function f1 name="make" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
