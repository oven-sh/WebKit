# lacks.js never provides `paint`   stars.js: export function paint() { return "painted" }   t.js: export * from "./stars.js"; export { paint } from "./lacks.js"   main.js: import * as t from "./t.js"; out = t.paint()
# The run drops the entry `paint` of t.js while its variable is empty, and the function of stars.js is called.
# callExportOf() called what the variable behind the entry holds and nothing else. Nobody writes that variable, so the call had no callee and `out` was proven to hold nothing,
# and the executable stopped at its own test: "what a variable holds is not of the type that the compiler has proven of it. It is: string."
# RUN: link variables mechanisms=all
# CHECK-NOT: variable g2 proven

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/t.js" displayPath="t.js" body=f1 requests=[{target=m2 isDynamicStarExport=true completes=true}, {target=m3 completes=true}] exports=[{name="paint" variable=g0 isHiddenUntilInitialized=true}]
module m2 path="/stars.js" displayPath="stars.js" body=f2 exports=[{name="paint" variable=g1}]
module m3 path="/lacks.js" displayPath="lacks.js" body=f3
entry module=m0
variable g0 name="paint" module=m3 declared={type=anything|absent}
variable g1 name="paint" module=m2 declared={type=anything}
variable g2 name="out" module=m0 declared={type=anything|absent}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="paint"
    v2 = Call v1, v0 calleeKey="paint"
    PutModuleVariable v2 variable=g2
    v4 = Undefined
    Return v4
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    PutModuleVariable v0 variable=g1
    v2 = Undefined
    Return v2
}
function f3 module=m3 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f4 name="paint" module=m2 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="painted"
    Return v0
}
