# If Link had no word for an integer that fits int32, a parameter that only ever takes `x | 0` would be a number, boxed or a double in every callee. If it kept the word for a sum of two of them, 2147483647 + 1 would wrap
# function low(a) { return a | 0; }  function sum(a, b) { return low(a) + low(b); }  function unsigned(a) { return a >>> 0; }  function keep(n) { return n; }  function flip(a) { return ~low(a); }  sum(+text, +text);  unsigned(+text);  keep(5);  keep(low(+text));  flip(+text);
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=i32 returns
# CHECK-NEXT: parameter 0 {{*}}proven=number
# CHECK: function f2 {{*}}result=int[-9007199254740992, 9007199254740992] returns
# CHECK: function f3 {{*}}result=int[0, 4294967295] returns
# CHECK: function f4 {{*}}result=i32 returns
# CHECK-NEXT: parameter 0 {{*}}proven=i32
# CHECK: function f5 {{*}}result=i32 returns

variable g0 name="low" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="sum" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="unsigned" module=m0 declared={type=f3 flags=[IsFromCompiler]} initialization=Function function=f3 flags=[IsImmutable]
variable g3 name="keep" module=m0 declared={type=f4 flags=[IsFromCompiler]} initialization=Function function=f4 flags=[IsImmutable]
variable g4 name="flip" module=m0 declared={type=f5 flags=[IsFromCompiler]} initialization=Function function=f5 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = ToNumber v1
    v3 = GetModuleVariable variable=g1
    v4 = Call v3, -, v2, v2 calleeName="sum"
    v5 = GetModuleVariable variable=g2
    v6 = Call v5, -, v2 calleeName="unsigned"
    v7 = GetModuleVariable variable=g3
    v8 = Integer integer=5
    v9 = Call v7, -, v8 calleeName="keep"
    v10 = GetModuleVariable variable=g0
    v11 = Call v10, -, v2 calleeName="low"
    v12 = Call v7, -, v11 calleeName="keep"
    v13 = GetModuleVariable variable=g4
    v14 = Call v13, -, v2 calleeName="flip"
    v15 = Undefined
    Return v15
}
function f1 name="low" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = BitOr v0, v1
    Return v2
}
function f2 name="sum" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g0
    v3 = Call v2, -, v0 calleeName="low"
    v4 = Call v2, -, v1 calleeName="low"
    v5 = Add v3, v4
    Return v5
}
function f3 name="unsigned" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = URShift v0, v1
    Return v2
}
function f4 name="keep" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="flip" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="low"
    v3 = BitNot v2
    Return v3
}
