# class Holder { held = new Int32Array(8); at4() { return this.held[4]; } at8() { return this.held[8]; } } const holder = new Holder(); holder.at4(); holder.at8();
# the length that is written where the view is made goes with the view: both reads are told it; a written index below it finds an element, the length itself finds none
