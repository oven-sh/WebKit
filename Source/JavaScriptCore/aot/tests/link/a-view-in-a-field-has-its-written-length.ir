# RUN: link accesses functions mechanisms=all
# CHECK: read-off-views f3 v3 least-length=8
# CHECK: read-off-views f4 v3 least-length=8
# CHECK: function f3 {{*}}result=i32
# CHECK: function f4 {{*}}result=undefined|i32

