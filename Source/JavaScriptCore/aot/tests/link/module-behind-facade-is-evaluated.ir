# a module whose body runs is evaluated, whoever came to the body: the run time reads what a file exports out of its exports variable, so what lies there has escaped
# file.cjs: function one() { return 1 } function make() { return { one } } module.exports = make();
# main.js: import { one } from "./file.cjs"; print(one());
# The facade takes its names from the object at run time, so no operation reads "one". The body of the facade names the file as its module, and the request that leads to the file is the facade's
# RUN: link functions mechanisms=all
# CHECK-NOT: unreached
# RUN(NONE): run-in-shell mechanisms=none
# NONE: 1
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 1
# ALL-NEXT: exited with 0

layout L0 module=m1 fields=[{key="one" declared={type=anything} flags=[IsRequired]}]
module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m2 completes=true isHoisted=true}, {target=m2 completes=true}]
module m1 path="/file.cjs" displayPath="file.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g0
module m2 path="#2" displayPath="file.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f2 requests=[{target=m1 kind=Require completes=true}] syntheticExports=[{name="one" variable=g1}]
entry module=m0
variable g0 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="one" module=m2 declared={type=anything|absent}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="one"
    v2 = Call v1, - calleeName="one"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="print" [isFreeName]
    v5 = Call v4, -, v2
    Return
}
function f1 name="file" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = NewClosure function=f4
    v1 = Call v0, - calleeName="make"
    PutModuleVariable v1 variable=g0
    Return
}
function f2 name="facadeOfFile" module=m1 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m2 [isBare]
    Return
}
function f3 name="one" module=m1 results=[{type=anything}] {
    v0 = Integer integer=1
    Return v0
}
function f4 name="make" module=m1 results=[{type=anything}] {
    v0 = NewClosure function=f3
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="one"
    v3 = FinishObject v1
    Return v3
}
