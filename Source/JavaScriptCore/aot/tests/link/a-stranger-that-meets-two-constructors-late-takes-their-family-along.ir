}
function f4 name="Pot" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L3 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L3
    Return v3
}
