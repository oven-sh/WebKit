# interface Row { id: number }  const rows: Row[] = JSON.parse(text);  report(rows);
# The program makes no Row itself and hands none out of sight. The front end says what the parse is expected to give, and a maker that nobody has seen makes it: so the layout counts as made and as given up from the start.
# A record that no expected result names and that stays with compiled code is held closed as before
# RUN: link layouts mechanisms=all
# CHECK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK-NOT: layout L0 {{*}}never-allocated
# CHECK: layout L1 {{*}}stays-with-compiled-code
# CHECK: parsers-may-make L0
# CHECK-NOT: parsers-may-make L1

expectedresult x0 type=Array<undefined|null|L0> layouts=[L0] flags=[IsMadeByParser]
layout L0 module=m0 fields=[{key="id" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
layout L1 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = PropGet v0 key="text" [isFreeName]
    v3 = Builtin builtin=JSON
    v4 = PropGet v3 key="parse"
    v5 = Call v4, v3, v2 calleeKey="parse" calleeName="JSON.parse" expectedResult=x0
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = FinishObject v7
    v9 = PropGet v8 key="a"
    v10 = Call v1, -, v5, v9 calleeName="report"
    Return v10
}
