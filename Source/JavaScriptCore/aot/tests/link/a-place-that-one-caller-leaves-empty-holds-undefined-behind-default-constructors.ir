# The fewest arguments that any caller gives a class without a constructor of its own only goes down as Link goes, and whoever was let off `undefined` at a place must get it when it does, in the class above that one too. If a parameter that asked early kept what it was told, the field would be proven a string while `new Leaf(3)` leaves it `undefined`, in some orders and not in others.
#   class Base { constructor(n, s) { this.n = n; this.s = s; } }  class Middle extends Base {}  class Leaf extends Middle {}  new Leaf(1, "x"); new Middle(2, "y"); new Leaf(3);
# OPTIONS: check=FlowFixpoint
# RUN: link fields mechanisms=all
# CHECK: field L0.0 "n" proven=int[0, 2147483647] writers-known
# CHECK-NEXT: field L0.1 "s" proven=undefined|string writers-known
# RUN(OLDEST): link fields oldest-first mechanisms=all
# OLDEST: field L0.0 "n" proven=int[0, 2147483647] writers-known
# OLDEST-NEXT: field L0.1 "s" proven=undefined|string writers-known
# RUN(SCATTERED): link fields scattered mechanisms=all
# SCATTERED: field L0.0 "n" proven=int[0, 2147483647] writers-known
# SCATTERED-NEXT: field L0.1 "s" proven=undefined|string writers-known

layout L0 kind=Instance name="Base" module=m0 constructor=f1 fields=[{key="n" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 kind=Instance name="Middle" module=m0 base=L0 constructor=f2 fields=[{key="n" declared={type=anything} flags=[IsRequired, IsInherited] originLayout=L0 originField=0}, {key="s" declared={type=anything} flags=[IsRequired, IsInherited] originLayout=L0 originField=1}] supertypes=[L0] flags=[HasHeritage]
layout L2 kind=Instance name="Leaf" module=m0 base=L1 constructor=f3 fields=[{key="n" declared={type=anything} flags=[IsRequired, IsInherited] originLayout=L0 originField=0}, {key="s" declared={type=anything} flags=[IsRequired, IsInherited] originLayout=L0 originField=1}] supertypes=[L1] flags=[HasHeritage]
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
variable g2 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
