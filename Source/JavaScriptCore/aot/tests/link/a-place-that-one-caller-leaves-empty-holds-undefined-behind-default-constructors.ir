    PutModuleVariable v7 variable=g1
    v9 = FinishClass v7 layout=L1
    v10 = Convert v9 declared={type=f2 flags=[IsFromCompiler]}
    v11 = ResolveHeritage v10
    v12 = NewClosure function=f3
    v13 = NewClass v12, v10, v11 layout=L2
    PutModuleVariable v13 variable=g2
    v15 = FinishClass v13 layout=L2
    v16 = Convert v15 declared={type=f3 flags=[IsFromCompiler]}
    v17 = Integer integer=1
    v18 = String string="x"
    v19 = Construct v16, -, v17, v18 calleeName="Leaf"
    v20 = Integer integer=2
    v21 = String string="y"
    v22 = Construct v10, -, v20, v21 calleeName="Middle"
    v23 = Integer integer=3
    v24 = Construct v16, -, v23 calleeName="Leaf"
    v25 = Undefined
    Return v25
}
function f1 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
