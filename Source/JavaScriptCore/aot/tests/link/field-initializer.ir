# If handing `this` to the initializer of the fields counted as the object leaving its constructor, every field that a class declares with a value would count as written after construction by an unknown writer, and the class would gain a property
# class P { q = "a"; }  new P();
# RUN: summary f2
# CHECK: access {{*}} v2 Define Parameter 0 "q" <- Constant string at-construction
# RUN(KEPT): summary f2
# KEPT-NOT: Parameter 0 -> Unknown
# RUN(LINK): link calls fields layouts mechanisms=all
# LINK: call f1 v3 -> f2
# LINK: field L0.0 "q" proven=string writers-known written-at-construction-alone filled
# LINK: layout L0 changes=[]

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="q" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = Undefined
    Return v4
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = CallDirect v2 function=f2
    Return v2
}
function f2 module=m0 kind=Initializer flags=[HasThis, IsHiddenInStackTraces] thisType={type=object} results=[{type=anything}] {
  b0(v0: object):
    v1 = String string="a"
    PropDefine v0, v1 key="q"
    v3 = Undefined
    Return v3
}
