# no caller knows anything of an object that did not exist when it called, so the stores of a maker into its own object are no writes of the call
# function make(a) { const o = { a: 0 }; o.a = a; return o; }  make(1);
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}layouts-written=none
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}mayCallUnknownCode
# NEVER-NOT: function f1 {{*}}fields-written
# NEVER-NOT: function f1 {{*}}mayWriteObservableState

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    v3 = Undefined
    Return v3
}
function f1 name="make" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    v2 = NewObject -, v1 layout=L0 fields=[0]
    PropSet v2, v0 key="a"
    v4 = FinishObject v2
    Return v4
}
