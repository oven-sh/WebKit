# If the list that is spread into another flowed into unseen code, as in the first version, the first copy of a list would let go of all that any list holds
# function copy(list) { return [...list]; }  function get(o) { return o.x; }  const a = { x: "a", only: 0 };  get(copy([a])[0]);
# What the steps hand out goes into the list that is written to.
# RUN(LINK): link functions fields layouts mechanisms=all
# LINK: function f1 callers-known one-callee {{*}}result=Array
# LINK: function f2 callers-known one-callee {{*}}result=string
# LINK: field L0.0 "x" proven=string writers-known written-at-construction-alone
# LINK: layout L0 changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="only" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = Integer integer=0
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = NewArray v3 contents=anything
    v5 = NewClosure function=f1
    v6 = Call v5, -, v4 calleeName="copy"
    v7 = ElemGet v6, v1
    v8 = NewClosure function=f2
    v9 = Call v8, -, v7 calleeName="get"
    v10 = Undefined
    Return v10
}
function f1 name="copy" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewArray contents=anything
    AppendSpread v1, v0
    Return v1
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
