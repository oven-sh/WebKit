# parse.cjs: module.exports = function parse(n) { return n };      main.js: import parse from "./parse.cjs"; print(parse(1));
# An ES module sees a CommonJS file through a facade, whose variables the loader fills out of what the file exports. The flow goes the same way, so neither the file's exports nor the variable escape.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions calls variables mechanisms=all
# CHECK: function f2 callers-known
# CHECK: call f0 v2 -> f2
# CHECK: variable g0 proven={{*}}f2 writers-known
# CHECK: variable g1 proven={{*}}f2 writers-known

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m2 completes=true isHoisted=true}]
module m1 path="/parse.cjs" displayPath="parse.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g0
module m2 path="#2" displayPath="parse.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f3 requests=[{target=m1 kind=Require completes=true}] syntheticExports=[{name="default" variable=g1}]
entry module=m0
variable g0 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="default" module=m2 declared={type=anything|absent}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = Integer integer=1
    v2 = Call v0, -, v1 calleeName="parse"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="print" [isFreeName]
    v5 = Call v4, -, v2
    Return
}
function f1 name="file" module=m1 kind=CommonJsModule results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="parse" module=m1 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="facade" module=m1 kind=Module results=[{type=anything}] {
  b0():
    EvaluateModule module=m1 referrer=m2 [isBare]
    Return
}
