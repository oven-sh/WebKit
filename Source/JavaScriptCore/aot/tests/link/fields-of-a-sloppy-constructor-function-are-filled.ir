# If ToThis let the object that is being made leave, nothing that the body of a sloppy constructor function stores would count as filled.
# function P(a) { this.x = a; this.y = 2; }  P.prototype.get = function () { return this.x; };  new P(1).get();
# function Q(a) { if (a) return; this.x = a; }  new Q(1);  function R(a) { hand(this); this.x = a; }  new R(1);
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f1 callers-known one-callee
# CHECK: field L0.0 "x" proven=int[0, 2147483647] writers-known filled
# CHECK: field L0.1 "y" proven=int[0, 2147483647] writers-known filled
# CHECK: layout L0 {{*}}changes=[]
# RUN(EARLY): link fields mechanisms=all
# EARLY-NOT: field L1.0 "x" {{*}}filled
# RUN(HANDED): link fields mechanisms=all
# HANDED-NOT: field L2.0 "x" {{*}}filled
# RUN(SUMMARY): summary f1
# SUMMARY: construction This fills ["x", "y"]
# RUN(SEEN): summary f1
# SEEN-NOT: seen-from-outside

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=2
layout L1 kind=Instance name="Q" module=m0 constructor=f3 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L2 kind=Instance name="R" module=m0 constructor=f4 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = PropGet v0 key="prototype"
    v2 = NewClosure function=f2
    PropSet v1, v2 key="get" mode=Sloppy
    v4 = Integer integer=1
    v5 = Construct v0, -, v4
    v6 = PropGet v5 key="get"
    v7 = Call v6, v5 calleeKey="get"
    v8 = NewClosure function=f3
    v9 = Construct v8, -, v4
    v10 = NewClosure function=f4
    v11 = Construct v10, -, v4
    v12 = Undefined
    Return v12
}
function f1 name="P" module=m0 flags=[IsSloppy, HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = ToThis v0
    v3 = Convert v2 declared={type=L0 flags=[IsExpected]}
    PropSet v3, v1 key="x" mode=Sloppy
    v5 = Integer integer=2
    PropSet v3, v5 key="y" mode=Sloppy
    v7 = Undefined
    Return v7
}
function f2 module=m0 flags=[IsSloppy, HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToThis v0
    v2 = PropGet v1 key="x"
    Return v2
}
function f3 name="Q" module=m0 flags=[IsSloppy, HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L1 {
  b0(v0: anything, v1: anything):
    v2 = ToThis v0
    v3 = Convert v2 declared={type=L1 flags=[IsExpected]}
    v4 = ToBoolean v1
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = Undefined
    Return v5
  b2():
    PropSet v3, v1 key="x" mode=Sloppy
    v7 = Undefined
    Return v7
}
function f4 name="R" module=m0 flags=[IsSloppy, HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L2 {
  b0(v0: anything, v1: anything):
    v2 = ToThis v0
    v3 = Convert v2 declared={type=L2 flags=[IsExpected]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="hand" [isFreeName]
    v6 = Call v5, -, v3
    PropSet v3, v1 key="x" mode=Sloppy
    v8 = Undefined
    Return v8
}
