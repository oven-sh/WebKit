# -- source: way-that-ends-in-a-call-leaves-the-body-that-is-followed.js
# function Gauge(v) { this.v = v; }
# function Meter(v) { this.v = v; }
# function Scale(v) { this.v = v; }
# function note() { return 0; }
# (function () {
#   if (sink(1)) return note();
#   Gauge.prototype.next = function () { return this.v + 1; };
# })();
# (function () {
#   Meter.prototype.next = function () { return this.v + 2; };
#   if (sink(2)) return note();
#   return 5;
# })();
# (function () {
#   if (sink(3)) sink(4);
#   Scale.prototype.next = function () { return this.v + 3; };
#   return note();
# })();
# function run() { return new Gauge(1).next() + new Meter(2).next() + new Scale(3).next(); }
# sink(run());
# -- end of source
# `return note();` ends its block in ReturnCall: a way out of the body behind which the caller goes on, as a Return is. If the order of start counted Return alone, the block of Gauge's store
# would be the one way out, the name "laid ahead of every object", and the walk would call a method directly that was never laid.
# Meter's store stands in front of both ways . every way out of the third body ends in a call, and all pass Scale's store.
# SINCE 11-04 (R257) THE CLOCK OF START SAYS OF NO NAME THAT IT IS LAID AHEAD: through a hole in it the read of such a name gave undefined where the type said a function, and the process died; the claim fired on no program that we are judged by. What this test told apart by `laid-ahead` it no longer tells.
# RUN: link members mechanisms=all
# CHECK: on-prototype L1 "next" function=f{{*}}
# CHECK: on-prototype L2 "next" function=f{{*}}
# RUN(NOT): link members mechanisms=all
# NOT-NOT: on-prototype L0 "next" {{*}}laid-ahead

