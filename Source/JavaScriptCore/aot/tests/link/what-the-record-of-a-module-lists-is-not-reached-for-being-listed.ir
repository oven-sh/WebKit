# The record of a module lists the names that its namespace object shows. To be listed reaches nothing: a function declaration that no code of the program comes to stays out of the executable, though its module is evaluated
# and some site that nothing reaches hands the object out. `sum`, which the program calls by its binding alone, keeps its proven parameters. Both stay in: the image marks their entries (ModuleExportData::staysIn),
# and the run time hands the value of such an export to nobody, by whatever road the object is come by.
# library.js: export function sum(a, b) { return a + b }  export function makePlugins(a) { return helper(a) }  function helper(a) { return a }
# main.js: import { sum } from "./library.js"; const table = { never() { return import("./library.js") } }; print(sum(1, 2))
# RUN: link functions mechanisms=all
# CHECK: function f2 {{*}}callers-known
# CHECK: function f3 unreached
# CHECK: function f4 unreached
# CHECK: function f5 unreached
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 3
# ALL-NEXT: exited with 0

