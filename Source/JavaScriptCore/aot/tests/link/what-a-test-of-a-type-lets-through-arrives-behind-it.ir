# behind the program's own test the local has a name of its own. What arrives under that name is what the test lets through, so of whatever unseen code hands over only an object comes back out of `pick`, and no text, no boolean and no undefined
# function pick(f) { if (typeof f === "function") return f; return 0; }
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=i32|object?UnseenCode 

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=function
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = NarrowByTest v0, v2
    Return v3
  b2(v4):
    v5 = Integer
    Return v5
}
