# The global object reaches code out of sight, which finds everything that is stored on it.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions layouts mechanisms=all
# CHECK-NOT: function f1 callers-known
# CHECK-NOT: layout L0 changes=[]

layout L0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="registered" mode=Strict
    v3 = Integer integer=1
    v4 = NewObject -, v3 layout=L0 fields=[0]
    v5 = FinishObject v4
    PropSet v1, v5 key="shared" mode=Strict
    v7 = PropGet v1 key="registered"
    v8 = PropGet v1 key="shared"
    v9 = PropGet v8 key="x"
    v10 = Call v7, -, v9 calleeName="registered"
    v11 = PropGet v1 key="console" [isFreeName]
    v12 = PropGet v11 key="log"
    v13 = Call v12, v11, v1 calleeKey="log" calleeName="console.log"
    Return
}
function f1 name="registered" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
