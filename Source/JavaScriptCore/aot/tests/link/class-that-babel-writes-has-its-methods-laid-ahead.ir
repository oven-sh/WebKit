# var Counter = function () { function Counter(step) { this.step = step; this.value = 0; }
#   _createClass(Counter, [{ key: "bump", value: function bump() { this.value += this.step; return this; } }], [{ key: "of", value: function of(step) { return new Counter(step); } }]);
