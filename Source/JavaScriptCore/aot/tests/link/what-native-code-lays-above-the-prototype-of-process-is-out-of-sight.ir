# node:events hands native code the object that goes above the native prototype of `process`. From then on whoever climbs from `process` comes by that object, and no code in sight shows it.
# The row says that native code keeps the operand: what lies on it is reached though nobody in sight calls it, and nothing is proven of the object.
#   const above = { halt() { return 1; } };  makeProcessInheritFrom(above);
# LIBRARY: own
# RUN: link functions layouts mechanisms=all
# REQUIRES: entries-of-bun
# CHECK-NOT: function f2 unreached
# CHECK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# The call names neither `process` nor the native emitter, so neither is let go.
# RUN(LOOKUPS): link lookups mechanisms=all
# REQUIRES(LOOKUPS): entries-of-bun
# LOOKUPS: NativeNewCppFunctionBunProcessCppJsFunctionMakeProcessInheritFrom
# LOOKUPS-NOT: lookup let-go Process
# LOOKUPS-NOT: lookup at-unseen Process
# LOOKUPS-NOT: EventEmitterPrototype

layout L0 module=m1 fields=[{key="halt" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="node:events" displayPath="node:events" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeEvents body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = RequireModule module=m1 referrer=m0 specifier="node:events"
    v1 = Undefined
    Return v1
}
function f1 module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NativeBinding builtin=NativeNewCppFunctionBunProcessCppJsFunctionMakeProcessInheritFrom
    v3 = Call v2, -, v1 calleeName="makeProcessInheritFrom"
    v4 = Undefined
    Return v4
}
function f2 name="halt" module=m1 role=Library flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
