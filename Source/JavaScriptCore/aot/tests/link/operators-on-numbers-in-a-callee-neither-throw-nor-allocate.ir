    v2 = NewClosure function=f1
    v3 = Call v2, -, v0, v1
    Return v3
}
function f1 name="byRank" module=m0 kind=Arrow length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
