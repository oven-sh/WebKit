# The walk may copy the text of a built-in in line wherever it is called, and the copy mentions what that text mentions: here `someFrom`, in which `some` goes on.
# So the calls of `someFrom` that Link lists are not all its calls: it takes nothing of what callers leave. It is compiled with the text that names it: it is in the queue from the start, as `some` is.
# What Link knows of its callers holds for the copies too, which hand on what the text hands on: the callers stay known, or `callback` would no longer count as only called and an arrow would no longer be lent to it.
# If it were not, `some` named a function that no caller of `some` leads to: no unit might copy the text, and every list method with a text to go on in was called instead of copied.
# export const some = Array.prototype.some;  in the library: function some(callback) { return $someFrom(this, callback); }  function someFrom(list, callback) { return list; }
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}} in-queue-from-start
# CHECK-NOT: one-callee
# CHECK: function f2 callers-known cycle={{*}} in-queue-from-start
# CHECK-NOT: takes-arrivals

variable g0 name="some" module=m0 declared={type=anything} initialization=Uninitialized
module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="some" variable=g0}]
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ArrayPrototypeSome function=f1
runtimefunction id=ArrayPrototypeSomeFrom function=f2 visibility=Private
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ArrayPrototypeSome
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f1 name="some" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeSome thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = CallDirect v0, v1 function=f2
    Return v2
}
function f2 name="someFrom" module=m1 kind=Method role=Library length=2 enclosingRuntimeFunction=ArrayPrototypeSomeFrom thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
