# -- source: name-laid-on-a-function-is-followed.js
# function Ok(v) { this.v = v; }
# function Err(e) { this.e = e; }
# Ok.of = function (v) { return new Ok(v); };
# Err.of = function (e) { return new Err(e); };
# function Early(x) { this.x = x; }
# function useEarly() { return typeof Early.of; }
# sink(useEarly());
# Early.of = function (x) { return new Early(x); };
# function Twice(x) { this.x = x; }
# Twice.of = function (x) { return new Twice(x); };
# Twice.of = function (x) { return new Twice(x + 1); };
# function Defined(x) { this.x = x; }
# Defined.of = function (x) { return new Defined(x); };
# Object.defineProperty(Defined, "other", { value: 1 });
# sink(Ok.of(1).v + Err.of(2).e + useEarly() + Twice.of(1).x + Defined.of(1).x);
# -- end of source
# If what is stored under a name on a function went where whatever is stored under that name on anything goes, Ok.of and Err.of would meet, and both would be handed to unseen code with all that they make.
# What the program lays under a name on a function of its own lies at a node of that function and that name.
# RUN: link members layouts mechanisms=all
# CHECK: on-function f1 "of" function=f{{*}} laid-ahead
# CHECK: on-function f2 "of" function=f{{*}} laid-ahead
# CHECK: layout L0 {{*}}changes=[]
# CHECK: layout L1 {{*}}changes=[]
# Read above the store . two functions arrive . something else is done to the holder.
# RUN(NOT): link members mechanisms=all
# NOT-NOT: on-function f3 {{*}}laid-ahead
# NOT-NOT: on-function f4 {{*}}function=
# NOT-NOT: on-function f5 {{*}}function=

