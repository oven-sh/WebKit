# behind a scan of every reached body, the modules that no list of a summary names are those whose path no operation reads: an image that hides paths keeps no text for them
# main.js: import "./a.js"; import.meta;   a.js: nothing of the kind
# RUN: summary f0 f1 mechanisms=all
# CHECK: reads-paths-of m0
# CHECK-NOT: reads-paths-of
# RUN(LINK): link layouts mechanisms=all
# LINK-NOT: path-unread m0
# LINK: path-unread m1
# it goes by no mechanism: what an operation reads it reads whatever is withheld
# RUN(NONE): link layouts mechanisms=none
# NONE-NOT: path-unread m0
# NONE: path-unread m1

module m0 path="/app/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/app/a.js" displayPath="a.js" body=f1
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ImportMeta module=m0
    Return v0
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
