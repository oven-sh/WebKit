# function giveName(named, text) { Object.defineProperty(named, "name", { value: text }) } giveName(first, "one"); giveName(second, "two"); first.name
# The helper does one thing with its parameter: it is the object of a definition, by a descriptor in sight that lays no accessor, under a name that every plain closure is made with and of which no stage believes anything.
# If the two functions flowed to the parameter they would meet there, be lost and go on to unseen code: every function that a library names so would be compiled.
# The controls stand beside this file: functions-that-a-helper-*.ir.
# RUN: link functions mechanisms=all
# CHECK: function f2 unreached
# CHECK: function f3 unreached

layout L0 fields=[{key="value" declared={type=anything}}]
layout L1 fields=[{key="get" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = String string="one"
    v4 = Call v0, -, v1, v3 calleeName="giveName"
    v5 = String string="two"
    v6 = Call v0, -, v2, v5 calleeName="giveName"
    v7 = PropGet v1 key="name"
    Return v7
}
function f1 name="giveName" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Builtin builtin=Object
    v3 = Builtin builtin=ObjectDefineProperty
    v4 = String string="name"
    v5 = NewObject layout=L0
    PropDefine v5, v1 key="value"
    v7 = FinishObject v5
    v8 = Call v3, v2, v0, v4, v7 calleeName="Object.defineProperty"
    v9 = Undefined
    Return v9
}
function f2 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f3 name="second" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
