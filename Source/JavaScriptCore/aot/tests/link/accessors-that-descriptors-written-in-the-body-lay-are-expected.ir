# If the record of a constructor function listed only the methods that are stored on its prototype object, every accessor that `Object.defineProperties(P.prototype, { .. })` lays would stand there undeclared,
# and the guard of its name would never hold: not for P and not for any class below it. The scan names what a descriptor that is written in the body holds under `get` and `set`.
# NO PROOF: the run time looks at the prototype object where the guards begin. A value, a second descriptor under the name, a store under the name: nothing is expected.
# function P() { this.x = 1; }
# Object.defineProperties(P.prototype, { size: { get() { .. }, set(value) { .. } }, count: { enumerable: false, get() { .. } }, plain: { value: 3 }, twice: { get() { .. } }, stored: { configurable: true, get() { .. } } });
# Object.defineProperties(P.prototype, { twice: { get() { .. } } });   P.prototype.stored = 9;   P.prototype.method = function () { .. };
# function Q() { this.y = 1; }   publish(Q);   Object.defineProperties(Q.prototype, { size: { get() { .. } } });   Q.prototype.method = function () { .. };   publish(new P(), new Q());
