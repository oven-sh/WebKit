# If only the object that is handed to unseen code escaped, and not what its fields hold, that code could store into the inner object or call the closure with anything while the compiled program still trusts the types that Link proved of them
# const outer = { inner: { y: "a" }, run(v) { return v; } };  const home = { z: "a" };  sink(outer);
# `sink` is a function of the host without a row. What flows into it escapes, and what an escaped field held escapes in turn. What never flows there keeps all that is proven of it.
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f1
# CHECK-NOT: unreached
# CHECK-NOT: callers-known
# CHECK-NOT: proven=
# CHECK: field L0.0 "inner"
# CHECK-NOT: writers-known
# CHECK: field L2.0 "z" proven=string writers-known written-at-construction-alone
# CHECK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L1 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L2 changes=[]

layout L0 module=m0 fields=[{key="inner" declared={type=anything} flags=[IsRequired]}, {key="run" declared={type=anything} flags=[IsRequired, IsMethod]}]
layout L1 module=m0 fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = NewObject -, v2, v3 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = NewObject -, v0 layout=L2 fields=[0]
    v7 = FinishObject v6
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="sink" [isFreeName]
    v10 = Call v9, -, v5 calleeName="sink"
    v11 = Undefined
    Return v11
}
function f1 name="run" module=m0 kind=Method flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
