# If a store on `A.prototype` under a key that nobody knows left the class as it was, which the first version had no guard against, any method could have been replaced and any name could have got a setter while calls and stores still went straight to what the class spells out
# class A { constructor() { this.x = "a"; }  m() { return "m"; } }  A.prototype[key] = function () { return true; };  function ask(x) { return x.m(); }  ask(new A());
# The class escapes whole: its members, its constructor, its fields, and what was stored.
# RUN: summary f0
# CHECK: access [[prototype]] v5 Read Closure f1 "prototype" -> [[prototype]]
# CHECK: access {{*}} v9 Store [[prototype]] [{{*}}] <- Closure f3
# RUN(CALLS): link calls mechanisms=all
# CALLS-NOT: call f4 v2
# RUN(LINK): link functions fields members layouts mechanisms=all
# LINK: function f1
# LINK-NOT: callers-known
# LINK: function f2
# LINK-NOT: callers-known
# LINK: function f3
# LINK-NOT: unreached
# LINK-NOT: callers-known
# LINK: function f4
# LINK-NOT: result=string
# LINK: field L0.0 "x"
# LINK-NOT: writers-known
# LINK: field L1.0 "end"
# LINK: member L0 Prototype 0 Method "m"
# LINK-NOT: function=
# LINK-NOT: writers-known
# LINK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 module=m0 fields=[{key="end" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = PropGet v4 key="prototype"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="key" [isFreeName]
    v8 = NewClosure function=f3
    ElemSet v5, v7, v8
    v10 = Construct v4
    v11 = NewClosure function=f4
    v12 = Call v11, -, v10 calleeName="ask"
    v13 = Undefined
    Return v13
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = String string="a"
    PropSet v2, v3 key="x"
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="m"
    Return v0
}
function f3 module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f4 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
