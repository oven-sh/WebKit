# Nobody knows how long a list is that a caller spreads, nor which of its elements lands where. If it came to no place of a function that only passes its rest list on, the parameters of `take` would be proven `i32` and `string` while `wrap(...[2.5])` brings the first a fraction and leaves the second `undefined`. What the other caller wrote keeps its places.
#   function take(a, b) { return b; }  function wrap(...list) { return take(...list); }  wrap(1, "x"); wrap(...[2.5]);
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known {{*}}result=undefined|fractional|string returns=
# CHECK-NEXT: parameter 0 expected=undefined|i32|fractional proven=undefined|i32|fractional
# CHECK-NEXT: parameter 1 expected=undefined|fractional|string proven=undefined|fractional|string

variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = String string="x"
    v5 = Call v2, -, v3, v4 calleeName="wrap"
    v6 = Double number=2.5
    v7 = NewArray v6 contents=anything
    v8 = CallList v2, -, v7 calleeName="wrap"
    v9 = Undefined
    Return v9
}
function f1 name="wrap" module=m0 flags=[HasRestParameter] thisType={type=anything} parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = GetModuleVariable variable=g0
    v2 = CallList v1, -, v0 calleeName="take"
    Return v2
}
function f2 name="take" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
