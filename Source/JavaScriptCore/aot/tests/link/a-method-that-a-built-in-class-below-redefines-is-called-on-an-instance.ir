# `const table = new Uint8Array(256).fill(1)`: A METHOD THAT A BUILT-IN CLASS BELOW REDEFINES. Buffer stands below Uint8Array and has a fill, an indexOf, a lastIndexOf, an includes, a slice .. of its own.
# A call by name on an instance of a built-in class went to unseen code wherever a class below has a member of that name: the table was typed `anything`, every read off it stayed generic, and the library came into the image.
# Now a site knows whether its objects are of the class itself: what a constructor constructs for itself, what a row says `.exactly`, what an operation of the engine makes. There the member of the class itself is called.
# Any other site (what slice() gives; a site of the class itself that met such a one) calls EVERY definition that an instance may find: that of the class and that of each class below.
# export const filled = new Uint8Array(8).fill(1);
# export const twice = new Uint8Array(8).fill(1).fill(2);
# export const found = new Uint8Array(8).indexOf(1);
# export const last = new Uint8Array(8).lastIndexOf(1);
# export const has = new Uint8Array(8).includes(1);
# export const sliced = new Uint8Array(8).slice(1);
# export const slicedFilled = new Uint8Array(8).slice(1).fill(2);
# export const slicedFound = new Uint8Array(8).slice(1).indexOf(2);
# function either(first) { return first ? new Uint8Array(8) : new Uint8Array(8).slice(1); }
# export const eitherFilled = either(found === 1).fill(3);
# export const eitherFound = either(found === 2).indexOf(3);
# g0 = eitherFilled, g1 = eitherFound, g2 = filled, g3 = found, g4 = has, g5 = last, g6 = sliced, g7 = slicedFilled, g8 = slicedFound, g9 = twice
# OPTIONS: mechanisms=all exclude=CodeOutsideImage
