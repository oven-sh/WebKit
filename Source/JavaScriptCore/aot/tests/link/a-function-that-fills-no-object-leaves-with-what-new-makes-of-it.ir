# function Made(row) {}  function called(row) {}  const one = new Made(1);  called(1);  one.constructor.mark = 1;
# `Made` fills no object, so it has no layout, and what `new` makes of it is an object that nobody follows. The prototype above that object names `Made` under `constructor`:
# whoever holds the object holds the function, may call it with anything and may lay names on it. So `Made` leaves with what it makes: not every caller is known.
# `called` is only called. It stays in sight.
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 callers-known
# CHECK: function f2 callers-known one-callee

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Integer integer=1
    v3 = Construct v0, -, v2 calleeName="Made"
    v4 = Call v1, -, v2 calleeName="called"
    v5 = PropGet v3 key="constructor"
    PropSet v5, v2 key="mark"
    v7 = Undefined
    Return v7
}
function f1 name="Made" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Return v1
}
function f2 name="called" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Return v1
}
