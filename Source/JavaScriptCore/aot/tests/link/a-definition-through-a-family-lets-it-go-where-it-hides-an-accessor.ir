# A DEFINITION THROUGH A FAMILY OF LAYOUTS HIDES AN ACCESSOR OF A CLASS WHOSE LAYOUT LISTS NO FIELD UNDER THE KEY: WHATEVER THE KIND OF KEY.
# class Base { ["si" + "ze"] = "own"; }                      the lowering names the key, the checker lists no field
# class First extends Base { }   class Second extends Base { }   class Third extends Base { }
# class Loud extends Base { get size() { return "getter"; } }
# class Identity { constructor(given) { return given; } }
# class Stamp extends Identity { tag = "own"; }              the field is laid on whatever the base answers with
# class P { get tag() { return "getter"; } }   class Q { q = 1; }   class R { r = 1; }   class S { s = 1; }   class T { t = 1; }
# const p = new P();   new Stamp(p);   new Stamp(new Q());   new Stamp(new R());   new Stamp(new S());   new Stamp(new T());
# export const size = new Loud().size;   export const tag = p.tag;
# Both answers are "own". One layout at a time Link lets a layout go where a definition finds an accessor above and no listed field. Five layouts and more are a family; there the definition went the way of a store,
# no layout left, and whoever finds the accessor above objects of Loud or of P could call it without a look at the object.
# Now how a value is laid is part of the name of the node that it is laid through: a definition and an assignment through one family, or through the same lost objects, share no node and no ties,
# and the tie of a definition to a layout with such an accessor lets that layout go and enters no setter. It does not hang on who came first, a store or a definition.
# L4 = Loud, L7 = P
# OPTIONS: mechanisms=all exclude=CodeOutsideImage
# RUN: link layouts
# CHECK: layout L4 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L7 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
