# If this store counted as part of the construction, what the constructor stored would be taken for what the field holds for good, and a read behind a call of `set` would answer with the old value. If the store were missed, the field would be proven a string while it holds a boolean
# class P { constructor() { this.x = "a"; }  set(v) { this.x = v; } }  new P().set(true);
# RUN: summary f2
# CHECK: access {{*}} v2 Store Parameter 0 "x" <- Parameter 1
# CHECK-NOT: at-construction
# RUN(LINK): link calls fields layouts mechanisms=all
# LINK: call f0 v8 -> f2
# LINK: field L0.0 "x" proven=true|string writers-known
# LINK-NOT: written-at-construction-alone
# LINK: field L1.0 "end"
# LINK: layout L0 changes=[]

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 module=m0 fields=[{key="end" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="set"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="set"
    v7 = Boolean boolean=true
    v8 = Call v6, v5, v7 calleeKey="set"
    v9 = Undefined
    Return v9
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = String string="a"
    PropSet v2, v3 key="x"
    Return v2
}
function f2 name="set" module=m0 kind=Method flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="x"
    v3 = Undefined
    Return v3
}
