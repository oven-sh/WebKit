# CHECK: function f1 {{*}}result=number|string returns
# CHECK-NEXT: parameter 0 {{*}}proven=int[0, 2147483647]|string
# CHECK-NEXT: parameter 1 {{*}}proven=int[0, 2147483647]
# CHECK: function f2 {{*}}result=number returns
# CHECK-NEXT: parameter 0 {{*}}proven=int[0, 2147483647]|string
# CHECK: function f3 {{*}}result=number|bigint returns
# CHECK-NEXT: parameter 0 {{*}}proven=int[0, 2147483647]|bigint

