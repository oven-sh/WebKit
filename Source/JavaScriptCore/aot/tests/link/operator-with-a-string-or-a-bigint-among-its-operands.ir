# If an operator gave a number as soon as a number had arrived at its operands, and took no notice of what arrives later, `add("a", 1)` would hand a string to code that was compiled for numbers
# function add(a, b) { return a + b; }  function less(a, b) { return a - b; }  function big(a, b) { return a * b; }  add(1, 2);  add("a", 1);  less(1, 2);  less("7", 1);  big(2n, 3n);  big(2, 3);
