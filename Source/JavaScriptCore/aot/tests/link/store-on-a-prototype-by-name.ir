# If a store on `A.prototype` left no trace, as in the first version, the member would still be proven to hold the method of the class, and `x.m()` would go straight to a function that has been replaced
# class A { constructor() { this.x = "a"; }  m() { return "m"; } }  A.prototype.m = function () { return true; };  function ask(x) { return x.m(); }  ask(new A());
# The read of `prototype` off the class object gives the prototype object of the layout, and the store flows into the member. That ends the proof of `m` and of nothing else: the instances have not escaped.
# RUN: summary f0
# CHECK: access [[prototype]] v5 Read Closure f1 "prototype" -> [[prototype]]
# CHECK: access {{*}} v7 Store [[prototype]] "m" <- Closure f3
# RUN(CALLS): link calls mechanisms=all
# CALLS-NOT: call f4 v2
# RUN(LINK): link functions fields members layouts mechanisms=all
# LINK: function f4 callers-known one-callee {{*}}result=true|string
# LINK: field L0.0 "x" proven=string writers-known written-at-construction-alone
# LINK: member L0 Prototype 0 Method "m"
# LINK-NOT: function=
# LINK: layout L0 changes=[]
# RUN(REACHED): link functions mechanisms=all
# REACHED-NOT: unreached

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = PropGet v4 key="prototype"
    v6 = NewClosure function=f3
    PropSet v5, v6 key="m"
    v8 = Construct v4
    v9 = NewClosure function=f4
    v10 = Call v9, -, v8 calleeName="ask"
    v11 = Undefined
    Return v11
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = String string="a"
    PropSet v2, v3 key="x"
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="m"
    Return v0
}
function f3 module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f4 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
