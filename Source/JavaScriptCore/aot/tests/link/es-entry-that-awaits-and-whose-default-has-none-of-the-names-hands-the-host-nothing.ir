# main.mjs, the entry: await 0; export default { port: 0 }: the host looks at the exports of an entry once its body has ended, whether the body awaits or not.
# If the looks were laid for a body that returns alone, an entry that awaits would hand every default export to the host, whatever it holds.
# The controls: es-entry-that-awaits-and-whose-default-has-one-of-the-names-hands-it-to-the-host.ir, es-entry-whose-default-has-none-of-the-names-hands-the-host-nothing.ir.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK-NOT: lookup called-out-of-sight ObjectKeys
# CHECK: lookup entry-hands-host-nothing 0
# CHECK-NOT: lookup called-out-of-sight ObjectKeys

layout L0 module=m0 fields=[{key="port" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="default" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait] body=f0 exports=[{name="default" variable=g0}]
function f0 module=m0 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = Await v0
    v2 = Integer
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    v6 = Undefined
    Return v6
}
entry module=m0 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
