# The list that a rest parameter gathers is one site of its function, whichever lanes ask for it: two thousand callers enter `all` in one pass, and every lane finds the site in the same part of the table of sites.
# function all(...list) { return list[0]; }   function caller0() { return all(1, 1, 1, 1, 1, 1, 1, 1); }   ..   caller1999
# A lane that let go of the part's lock ahead of what the table had answered left that answer to the next lane: a build without NDEBUG stopped here, in WTF::removeIterator.
# RUN: link functions scattered mechanisms=all
# CHECK: function f1 callers-known one-callee {{*}}result=undefined|i32
# CHECK-NEXT: parameter 0 {{*}}proven=Array
# CHECK: function f2001 callers-known one-callee {{*}}result=undefined|i32

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
# REPEAT: i = 0..1999
    v%(i*2) = NewClosure function=f%(i+2)
    v%(i*2+1) = Call v%(i*2), - calleeName="caller%(i)"
# END REPEAT
    v4000 = Undefined
    Return v4000
}
function f1 name="all" module=m0 flags=[HasRestParameter] length=0 thisType={type=anything} parameters=[{type=Array<anything> flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array<anything>):
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    Return v2
}
# REPEAT: i = 0..1999
function f%(i+2) name="caller%(i)" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Call v0, -, v1, v1, v1, v1, v1, v1, v1, v1 calleeName="all"
    Return v2
}
# END REPEAT
