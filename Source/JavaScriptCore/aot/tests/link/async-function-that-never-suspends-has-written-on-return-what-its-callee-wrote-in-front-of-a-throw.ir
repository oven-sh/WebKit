# the ramp of a coroutine catches what its body throws and the call returns a rejected promise, so what a callee of the body has written on its way to a throw is written when the call returns
# function fail(o) { o.bad = 1; throw 1; }   async function save(o) { fail(o); }   save({ bad: 0 });
# f1 = fail, f2 = save
# TODO: coroutines-1: keepsDefaults() says of every coroutine that it may do anything, so nothing is said of save() until L6 lets an async function that never suspends have effects
# RUN: link functions mechanisms=all
# CHECK: function f2 {{*}}fields-written-on-return=1 fields-written=1

layout L0 module=m0 fields=[{key="bad" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f2
    v4 = Call v3, -, v2
    v5 = Undefined
    Return v5
}
function f1 name="fail" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="bad"
    Throw v1
}
function f2 name="save" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    v3 = Undefined
    Return v3
}
