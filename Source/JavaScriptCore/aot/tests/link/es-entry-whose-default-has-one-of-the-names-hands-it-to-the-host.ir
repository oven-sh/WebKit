# main.mjs, the entry: export default { port: 0, fetch() { return 1; } }
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK-NOT: lookup entry-hands-host-nothing 0
# CHECK-NOT: function f1 unreached

layout L0 module=m0 fields=[{key="fetch" declared={type=anything} flags=[IsRequired, IsMethod]}, {key="port" declared={type=anything} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
variable g0 name="default" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="/main.mjs" displayPath="main.mjs" flags=[CachesEvaluationError] body=f0 exports=[{name="default" variable=g0}]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewClosure function=f1
    v2 = NewObject -, v0, v1 layout=L0 fields=[1, 0]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g0
    v5 = Undefined
    Return v5
}
function f1 name="fetch" module=m0 sourceRange={start=26 end=47} kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
entry module=m0 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
