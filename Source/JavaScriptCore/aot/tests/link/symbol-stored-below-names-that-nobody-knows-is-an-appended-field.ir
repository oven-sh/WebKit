    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectDefineProperty
    v3 = PropGet v0 key="prototype"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="name" [isFreeName]
    v6 = NewClosure function=f2
    v7 = NewObject -, v6 layout=L1 fields=[0]
    v8 = Call v2, v1, v3, v5, v7 calleeName="Object.defineProperty"
    v9 = Builtin builtin=Symbol
    v10 = String string="mark"
    v11 = Call v9, -, v10 calleeName="Symbol" callNumber=0
    PutModuleVariable v11 variable=g0
    v13 = Integer integer=1
    v14 = Construct v0
    v15 = GetModuleVariable variable=g0
    v16 = CheckInitialized v15 name="kMark"
    ElemSet v14, v16, v13
    PropSet v14, v13 key="f"
    v19 = Undefined
    Return v19
}
function f1 name="P" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Integer integer=1
    PropSet v0, v1 key="x"
    v3 = Undefined
