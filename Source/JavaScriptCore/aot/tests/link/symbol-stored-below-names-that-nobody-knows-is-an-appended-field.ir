layout L1 module=m0 fields=[{key="set" declared={type=anything}}]
layout L2 module=m0 fields=[{key=symbol("mark")@m0:0 declared={type=anything} flags=[IsNeverWritten]}] flags=[IsNeverAllocated]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kMark" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
