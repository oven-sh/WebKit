# If a store behind the point at which `this` is handed to a function counted as filling the field, that function would read the mark of an empty slot as a value
# function look(p) { return p.y; }  class P { constructor(v) { this.x = v; look(this); this.y = v; } }  new P("a");
# RUN: summary f1
# CHECK: construction Allocated fills ["x"] looks-up ["x", "y"] seen-from-outside
# RUN(LINK): link functions fields mechanisms=all
# LINK: function f2 {{*}}result=undefined|string
# LINK: field L0.0 "x" {{*}}filled
# RUN(EMPTY): link fields mechanisms=all
# EMPTY-NOT: field L0.1 "y" {{*}}filled

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="look" module=m0 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = String string="a"
    v6 = Construct v4, -, v5
    v7 = Undefined
    Return v7
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    v5 = GetModuleVariable variable=g0
    v6 = Call v5, -, v3 calleeName="look"
    PropSet v3, v1 key="y"
    Return v3
}
function f2 name="look" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y"
    Return v1
}
