# A read through a declared union ties only the members that list the name one by one. The node of a name that is APPENDED to a member is made by the store, and the two are tied whichever comes first:
# the read that comes later finds the node, the store that comes later finds the read. Here the store has the longer way (through three functions), so the orders of the worklist take them both ways round.
# Without either tie the result of `read` was undefined|i32 in some order, and `String(read(o))` printed undefined for "laid".
#   interface A { kind: string; x: number }  interface B { kind: string; y: string }  interface C { kind: string; z: boolean }
#   function read(value: A | B | C) { return (value as A).x; }
#   function put(t: B, w: unknown) { (third(t) as any).x = w; }
#   function run(n) { const o = makeB(n); const found = read(n > 1 ? makeA(n) : n > 0 ? o : makeC(n)); put(o, "laid"); return found; }
