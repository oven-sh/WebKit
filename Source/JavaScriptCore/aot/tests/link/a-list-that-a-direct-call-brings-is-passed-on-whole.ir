# The operands of CallDirect are the entry parameters of the callee, so the caller makes the rest list itself, as long as it likes. If a function that only passes its rest list on knew of the arguments that calls by value write alone, the parameters of `take` would be proven `i32` and `string` while the list of the direct call holds one fraction.
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known {{*}}result=undefined|i32|fractional|string returns=
# CHECK-NEXT: parameter 0 expected=undefined|i32|fractional|string proven=undefined|i32|fractional|string
# CHECK-NEXT: parameter 1 expected=undefined|i32|fractional|string proven=undefined|i32|fractional|string

variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f1
    v3 = Integer integer=1
    v4 = String string="x"
    v5 = Call v2, -, v3, v4 calleeName="wrap"
    v6 = Double number=2.5
    v7 = NewArray v6 contents=anything
    v8 = CallDirect v7 function=f1
    v9 = Undefined
    Return v9
}
function f1 name="wrap" module=m0 flags=[HasRestParameter] thisType={type=anything} parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = GetModuleVariable variable=g0
    v2 = CallList v1, -, v0 calleeName="take"
    Return v2
}
function f2 name="take" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
