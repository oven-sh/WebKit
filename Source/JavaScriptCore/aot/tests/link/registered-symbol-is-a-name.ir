# export function read(holder: Holder) { return holder[kState]; }
# export function inLoop(holder: Holder, n: number) { let sum = 0; for (let i = 0; i < n; i++) { const key = Symbol.for("registered.state"); sum += (holder as any)[key]; } return sum; }
# export function unknownText(holder: Holder, text: string) { return (holder as any)[Symbol.for(text)]; }
# report(read(make("a")) + inLoop(make("b"), 2));
