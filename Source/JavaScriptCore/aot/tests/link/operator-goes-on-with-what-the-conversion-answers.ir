# If an object among the operands made the result the widest type of the row, one `new Count(1) + 2` would cost every sum of that function its type. If the object counted for nothing, `new Text() - 1` and `new Text() + 1` would be what the other operand alone gives
# class Count { valueOf() { return 1; }  toString() { return 2; } }  class Text { valueOf() { return "s"; } }  function add(a) { return a + 1; }  function join(a) { return a + 1; }  function bits(a) { return a | 0; }  add(new Count());  join(new Text());  bits(new Count());
# The conversion is a call by name for each key of the protocol. What those calls answer lies at one node, and the operator takes the primitives among it for its operand.
# RUN: summary f5
# CHECK: ResultOfConversion [[first]]
# CHECK: call [[first]] v2 Name @@toPrimitive this=[[objects]] (Constant string)
# CHECK-NEXT: call {{*}} v2 Name "valueOf" this=[[objects]] ()
# CHECK-NEXT: call {{*}} v2 Name "toString" this=[[objects]] ()
# CHECK: operator o0 v2 Add (Parameter 0 or converted-[[first]], Constant int[0, 2147483647])
# CHECK: edge Parameter 0 -> [[objects]] passes=object
# RUN(LINK): link functions mechanisms=all
# LINK: function f5 {{*}}result=int returns
# LINK-NEXT: parameter 0 {{*}}proven=L0
# LINK: function f6 {{*}}result=string returns
# LINK-NEXT: parameter 0 {{*}}proven=L1
# LINK: function f7 {{*}}result=i32 returns

layout L0 kind=Instance name="Count" module=m0 constructor=f1
layout L1 kind=Instance name="Text" module=m0 constructor=f2
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f3
    DefineMethod v1, v2 layout=L0 key="valueOf"
    v4 = NewClosure function=f8
    DefineMethod v1, v4 layout=L0 index=1 key="toString"
    v6 = FinishClass v1 layout=L0
    v7 = NewClosure function=f2
    v8 = NewClass v7 layout=L1
    v9 = NewClosure function=f4
    DefineMethod v8, v9 layout=L1 key="valueOf"
    v11 = FinishClass v8 layout=L1
    v12 = Construct v6
    v13 = NewClosure function=f5
    v14 = Call v13, -, v12 calleeName="add"
    v15 = Construct v11
    v16 = NewClosure function=f6
    v17 = Call v16, -, v15 calleeName="join"
    v18 = NewClosure function=f7
    v19 = Call v18, -, v12 calleeName="bits"
    v20 = Undefined
    Return v20
}
function f1 name="Count" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Text" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f3 name="valueOf" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f4 name="valueOf" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="s"
    Return v0
}
function f5 name="add" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
