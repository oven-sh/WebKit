# If the row for bound functions were applied to a closure of the program, or if asking a class for `prototype` let the class escape, one `x instanceof P` anywhere would open P and every object that is tested
# class P { constructor(v) { this.x = v; } }  function is(p) { return p instanceof P; }  function get(p) { return p.x; }  const p = new P("a");  is(p);  get(p);
# What `instanceof` finds on a class is native code of Function.prototype. It reads `prototype` off the class, which is a property of the class itself that can never become an accessor, and walks up from the value. It runs nothing and keeps nothing.
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f1 callers-known one-callee
# CHECK: function f2 callers-known one-callee {{*}}result=boolean
# CHECK-NEXT: parameter 0 {{*}}proven=L0
# CHECK: function f3 callers-known one-callee {{*}}result=string
# CHECK: field L0.0 "x" proven=string writers-known written-at-construction-alone filled
# CHECK: layout L0 changes=[]

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
variable g0 name="P" module=m0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    PutModuleVariable v1 variable=g0
    v3 = FinishClass v1 layout=L0
    v4 = String string="a"
    v5 = Construct v3, -, v4
    v6 = NewClosure function=f2
    v7 = Call v6, -, v5 calleeName="is"
    v8 = NewClosure function=f3
    v9 = Call v8, -, v5 calleeName="get"
    v10 = Undefined
    Return v10
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="is" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = InstanceOf v0, v1
    Return v2
}
function f3 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
