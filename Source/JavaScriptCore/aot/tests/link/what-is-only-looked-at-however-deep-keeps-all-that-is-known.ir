# If whatever a built-in looks at transitively escaped, one JSON.stringify(state) would open every class whose objects can be reached from the state
# class P { constructor(v) { this.x = v; } }  function get(p) { return p.x; }  const p = new P("a");  JSON.stringify([{ inner: p }]);  get(p);
# The row says that the walk reads own keys and own values and calls `toJSON`, on the operand and on all that it reaches. Nothing here answers to `toJSON` and no accessor is among the fields, so native code reads and nothing comes back:
# the list, the record in it and the object in the record keep their writers and their shapes. Nothing is joined either: what is looked at has not met.
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f2 callers-known one-callee {{*}}result=string
# CHECK-NEXT: parameter 0 {{*}}proven=L0
# CHECK: field L0.0 "x" proven=string writers-known written-at-construction-alone filled
# CHECK: field L1.0 "inner" proven=L0 writers-known
# CHECK: layout L0 changes=[]
# CHECK: layout L1 changes=[]

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 module=m0 fields=[{key="inner" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, -, v3
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = NewArray v6 contents=anything
    v8 = Builtin builtin=JSON [isNotReadFromHolder]
    v9 = Builtin builtin=JSONStringify [isNotReadFromHolder]
    v10 = Call v9, v8, v7 calleeName="JSON.stringify"
    v11 = NewClosure function=f2
    v12 = Call v11, -, v4 calleeName="get"
    v13 = Undefined
    Return v13
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
