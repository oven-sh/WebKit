# The twin of class-that-only-super-of-the-class-below-enters-is-never-allocated.ir: `new B()` stands in the program too, so B is its own new.target
# class A { constructor() { this.x = 1; } }  class B extends A { constructor() { super(); this.y = 2; } }  class C extends B { constructor() { super(); this.z = 3; } }  new C(); new B();
# RUN: link layouts mechanisms=all
# CHECK: layout L1 family=F0 changes=
# CHECK: layout L2 family=F0 changes=

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="B" module=m0 base=L0 constructor=f2 fields=[{key="y" declared={type=anything}}] supertypes=[L0] flags=[HasHeritage]
layout L2 kind=Instance name="C" module=m0 base=L1 constructor=f3 fields=[{key="z" declared={type=anything}}] supertypes=[L0, L1] flags=[HasHeritage]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = ResolveHeritage v6
    v8 = NewClosure function=f3
    v9 = NewClass v8, v6, v7 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = Construct v10
    v12 = Construct v6
    v13 = Undefined
    Return v13
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="x"
    Return v2
}
function f2 name="B" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = Integer integer=2
    PropSet v3, v4 key="y"
    Return v3
}
function f3 name="C" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    v4 = Integer integer=3
    PropSet v3, v4 key="z"
    Return v3
}
