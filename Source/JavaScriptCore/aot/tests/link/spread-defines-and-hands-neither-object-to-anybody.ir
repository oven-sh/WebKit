# `{ ...source }` DEFINES each property (CopyDataProperties: CreateDataProperty). No setter on the target or above it runs, nothing is relinked, nobody gets the target, and only an accessor of its own or a trap gets the source.
# If the copy counted as an assignment, as Object.assign() is one (object-assign.ir), the new record would be let go with all five changes, and with it whatever the fields of its source hold.
# function copy(s) { return { ...s }; }  copy({ x: "a", y: 1 });
# Every key that the source can have is a field of the target, and nothing lies beside the fields of the source: the target gains nothing.
# RUN: summary f1
# CHECK: change {{*}} CopiesInto {{*}} other=Parameter 0 defines
# RUN(LINK): link fields layouts mechanisms=all
# LINK: field L0.0 "x" proven=string writers-known
# LINK: field L1.0 "x" proven={{*}}string{{*}} writers-known
# LINK: field L1.1 "y" proven={{*}} writers-known
# LINK: layout L0 {{*}}changes=[]
# LINK: layout L1 {{*}}changes=[]
# RUN(HELD): link held layouts mechanisms=all
# HELD: layout L1 {{*}}changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = Integer integer=1
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = NewClosure function=f1
    v5 = Call v4, -, v3 calleeName="copy"
    v6 = Undefined
    Return v6
}
function f1 name="copy" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L1
    CopyDataProperties v1, v0
    v3 = FinishObject v1
    Return v3
}
