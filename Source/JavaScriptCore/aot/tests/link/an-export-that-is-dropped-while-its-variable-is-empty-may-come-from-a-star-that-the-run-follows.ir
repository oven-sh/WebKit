# lacks.js never provides `sep`   stars.js: sep = "/"   t.js: export * from "./stars.js"; export { sep } from "./lacks.js"; export const kept = 7   main.js: import * as t from "./t.js"; out = t.sep; other = t.kept
# The variable behind the entry `sep` of t.js stays empty. The run drops such an entry while it is empty, and the stars that it follows answer: a string.
# giveExport() gave what the variable holds and nothing else, so `out` was proven to hold undefined or nothing, and the executable stopped at its own test:
# "what a variable holds is not of the type that the compiler has proven of it. It is: string."
# the control: `kept` is an ordinary entry, and what its variable holds is proven of `other`
# RUN: link variables mechanisms=all
# CHECK-NOT: variable g2 proven
# CHECK: variable g4 proven=int

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/t.js" displayPath="t.js" body=f1 requests=[{target=m2 isDynamicStarExport=true completes=true}, {target=m3 completes=true}] exports=[{name="kept" variable=g3}, {name="sep" variable=g0 isHiddenUntilInitialized=true}]
module m2 path="/stars.js" displayPath="stars.js" body=f2 exports=[{name="sep" variable=g1}]
module m3 path="/lacks.js" displayPath="lacks.js" body=f3
entry module=m0
variable g0 name="sep" module=m3 declared={type=anything|absent}
variable g1 name="sep" module=m2 declared={type=anything}
variable g2 name="out" module=m0 declared={type=anything|absent}
variable g3 name="kept" module=m1 declared={type=anything}
variable g4 name="other" module=m0 declared={type=anything|absent}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="sep"
    PutModuleVariable v1 variable=g2
    v3 = PropGet v0 key="kept"
    PutModuleVariable v3 variable=g4
    v5 = Undefined
    Return v5
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    PutModuleVariable v0 variable=g3
    v2 = Undefined
    Return v2
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="/"
    PutModuleVariable v0 variable=g1
    v2 = Undefined
    Return v2
}
function f3 module=m3 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
