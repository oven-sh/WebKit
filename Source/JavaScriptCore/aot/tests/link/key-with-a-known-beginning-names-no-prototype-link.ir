# a store under a key that may be any text may be a store under `__proto__`, which answers every lookup from then on: the layout escapes. A key that begins with "on" is never that name, so the layout stays with compiled code
# function listen(emitter, kind, f) { emitter["on" + kind] = f; }   function hide(o, k, v) { o["__" + k] = v; }   function put(o, k, v) { o[k + "on"] = v; }
# listen({ onopen: 1 }, "open", 2);  hide({ a: 1 }, "proto__", 2);  put({ b: 1 }, "x", 2);
# `"__" + k` may be the name, and of `k + "on"` nobody knows how it begins: both as before
# RUN: summary f1 f2 f3 mechanisms=all
# CHECK: v5 Store Parameter 0 {{*}} begins-with "on"
# CHECK: v5 Store Parameter 0 {{*}} begins-with "__"
# CHECK-NOT: begins-with
# RUN(LINK): link layouts mechanisms=all
# LINK: layout L0 {{*}}stays-with-compiled-code
# LINK-NOT: layout L1 {{*}}stays-with-compiled-code
# LINK-NOT: layout L2 {{*}}stays-with-compiled-code
# RUN(WITHHELD): summary f1 mechanisms=-Folding
# WITHHELD-NOT: begins-with

layout L0 module=m0 fields=[{key="onopen" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=2
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = FinishObject v4
    v6 = NewObject -, v0 layout=L2 fields=[0]
    v7 = FinishObject v6
    v8 = NewClosure function=f1
    v9 = NewClosure function=f2
    v10 = NewClosure function=f3
    v11 = String string="open"
    v12 = String string="proto__"
    v13 = String string="x"
    v14 = Call v8, -, v3, v11, v1 calleeName="listen"
    v15 = Call v9, -, v5, v12, v1 calleeName="hide"
    v16 = Call v10, -, v7, v13, v1 calleeName="put"
    Return v16
}
function f1 name="listen" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = String string="on"
    v4 = Add v3, v1
    ElemSet v0, v4, v2 mode=Strict
    v6 = Undefined
    Return v6
}
function f2 name="hide" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = String string="__"
    v4 = Add v3, v1
    ElemSet v0, v4, v2 mode=Strict
    v6 = Undefined
    Return v6
}
function f3 name="put" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = String string="on"
    v4 = Add v1, v3
    ElemSet v0, v4, v2 mode=Strict
    v6 = Undefined
    Return v6
}
