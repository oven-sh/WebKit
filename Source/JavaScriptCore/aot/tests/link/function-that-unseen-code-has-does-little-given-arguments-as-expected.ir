# anything arrives at the parameters of a function that unseen code has got hold of, so by Link's own word each access in it may run any code. Given an argument as the source declares it, the store finds a field and the call of a parameter is left to whoever knows what he hands over
# function move(s: Shape, w) { s.w = w; }   function each(visit) { visit(); }   sink(move); sink(each); move(new-ish { w: 0 }, 1);
# f1 = move, f2 = each
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}mayCallUnknownCode
# CHECK: given-arguments as-expected=[0] layouts-written=1 returns=[{{*}}fields-written=1
# CHECK: function f2 {{*}}mayCallUnknownCode
# CHECK: given-arguments called=[0] layouts-written=none returns=[
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: given-arguments {{*}}mayCallUnknownCode

layout L0 module=m0 fields=[{key="w" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v1, -, v4
    v6 = Integer
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = Integer integer=1
    v10 = Call v2, -, v8, v9
    Return v10
}
function f1 name="move" module=m0 length=2 thisType={type=anything} parameters=[{type=L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: L0, v1: anything):
    PropSet v0, v1 key="w"
    v3 = Undefined
    Return v3
}
function f2 name="each" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    v2 = Undefined
    Return v2
}
