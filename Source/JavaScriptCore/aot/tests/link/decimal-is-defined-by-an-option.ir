# Nobody stores either name on the global object. The first is undefined, so its call hands the closure to nobody.
# An option of the engine defines the second, so its call hands the closure to code outside the program.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK: function f2 cycle=

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="define" [isFreeName, isForTypeOf]
    v4 = TypeTest v3 testedType=function
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="define" [isFreeName]
    v8 = Call v7, -, v0 calleeName="define"
    Jump -> next b2()
  b2():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="Decimal" [isFreeName, isForTypeOf]
    v11 = TypeTest v10 testedType=function
    Branch v11 -> taken b3(| 0), notTaken b4()
  b3(v12):
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="Decimal" [isFreeName]
    v15 = Call v14, -, v1 calleeName="Decimal"
    Jump -> next b4()
  b4():
    v16 = Integer integer=1
    v17 = Call v0, -, v16 calleeName="first"
    v18 = Call v1, -, v16 calleeName="second"
    Return
}
function f1 name="first" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="second" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
