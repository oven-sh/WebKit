# CHECK: v23 DefinesByDescriptor Builtin Math other=Allocation L0 under-a-name-that-nobody-else-names descriptor-in-sight lays-text-number-or-boolean
# CHECK-NOT: lays-text-number-or-boolean
# RUN(ALL): summary f0
# ALL-COUNT-10: DefinesByDescriptor

