    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L0
    PutModuleVariable v5 variable=g0
    v7 = NewClosure function=f4
    DefineMethod v5, v7 layout=L0 key="set"
    v9 = FinishClass v5 layout=L0
    v10 = Convert v9 declared={type=f3 flags=[IsFromCompiler]}
    v11 = NewClosure function=f5
    v12 = Call v11, - calleeName="make"
    v13 = Integer integer=1
    v14 = Call v1, -, v13 calleeName="record"
    v15 = Construct v10, -, v12 calleeName="Cell"
    PropSet v12, v14 key="cell"
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="sink" [isFreeName]
    v19 = Call v3, -, v14 calleeName="read"
    v20 = Call v18, -, v19 calleeName="sink"
    v21 = Undefined
    Return v21
}
