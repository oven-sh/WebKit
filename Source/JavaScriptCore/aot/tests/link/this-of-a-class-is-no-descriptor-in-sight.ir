# `this` of a class is made in the constructor, like a literal, but with a prototype of its own: ToPropertyDescriptor finds `set` on the class.
#   class Cell { constructor(target) { Object.defineProperty(target, "cell", this); } set(v) { v.n = "text"; } }
#   function make() { return { name: "text" }; }  function record(n) { return { n, m: 0 }; }  function read(rec) { return rec.n; }
#   const box = make(), rec = record(1);  new Cell(box);  box.cell = rec;  sink(read(rec));
# When the scan took any object that the body makes for a descriptor in sight, it found no store under any of the six names: an empty descriptor, so a property that is read only and holds undefined.
# What is stored under the name then reached nobody: `n` stayed proven a number, and the run time stopped at "StoreOfOtherType of an object of layout L2, field 1".
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known
# RUN(NEVER): link functions fields layouts mechanisms=all
# NEVER-NOT: function f2 {{*}}result=i32
# NEVER-NOT: field L1.1 "cell" {{*}}form=read-only
# NEVER-NOT: field L2.1 "n" proven=i32
# NEVER-NOT: layout L2 {{*}}stays-with-compiled-code

layout L0 kind=Instance name="Cell" module=m0 constructor=f3
layout L1 module=m0 fields=[{key="name" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L2 module=m0 fields=[{key="m" declared={type=anything} flags=[IsRequired]}, {key="n" declared={type=anything} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
