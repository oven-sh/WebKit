# The store of an object into its own field hands it to nobody: only a read off it under that key does, in this body, in a part or in a class below. So what the constructor stores behind `this.next = this` still counts as filled.
# class N { constructor() { this.next = this; this.b = "b"; } }  class M extends N { constructor() { super(); this.d = "d"; } }  class O extends N { constructor() { super(); this.c = this.next; this.e = "e"; } }  class P { constructor() { this.next = this; this.r = this.next; this.f = "f"; } }
# RUN: summary f1
# CHECK: construction Allocated fills ["next", "b"] looks-up ["next", "b"]
# CHECK-NOT: seen-from-outside
# RUN(READS): summary f4
# READS: construction Allocated fills ["next"] {{*}}seen-from-outside
# RUN(LINK): link fields mechanisms=all
# LINK: field L0.1 "b" {{*}}filled
# LINK: field L1.0 "d" {{*}}filled
# RUN(BELOW): link fields mechanisms=all
# BELOW-NOT: field L2.1 "e" {{*}}filled
# RUN(SAME): link fields mechanisms=all
# SAME-NOT: field L3.2 "f" {{*}}filled

layout L0 kind=Instance name="N" module=m0 constructor=f1 fields=[{key="next" declared={type=anything}}, {key="b" declared={type=anything}}]
layout L1 kind=Instance name="M" module=m0 base=L0 constructor=f2 fields=[{key="d" declared={type=anything}}] supertypes=[L0] flags=[HasHeritage]
layout L2 kind=Instance name="O" module=m0 base=L0 constructor=f3 fields=[{key="c" declared={type=anything}}, {key="e" declared={type=anything}}] supertypes=[L0] flags=[HasHeritage]
layout L3 kind=Instance name="P" module=m0 constructor=f4 fields=[{key="next" declared={type=anything}}, {key="r" declared={type=anything}}, {key="f" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = ResolveHeritage v2
    v4 = NewClosure function=f2
    v5 = NewClass v4, v2, v3 layout=L1
    v6 = FinishClass v5 layout=L1
    v7 = Construct v6
    v8 = NewClosure function=f3
    v9 = NewClass v8, v2, v3 layout=L2
    v10 = FinishClass v9 layout=L2
    v11 = Construct v10
    v12 = NewClosure function=f4
    v13 = NewClass v12 layout=L3
    v14 = FinishClass v13 layout=L3
    v15 = Construct v14
    v16 = Undefined
    Return v16
}
function f1 name="N" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    PropSet v2, v2 key="next"
    v4 = String string="b"
    PropSet v2, v4 key="b"
    Return v2
}
function f2 name="M" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = String string="d"
    PropSet v3, v4 key="d"
    Return v3
}
function f3 name="O" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    v4 = PropGet v3 key="next"
    PropSet v3, v4 key="c"
    v6 = String string="e"
    PropSet v3, v6 key="e"
    Return v3
}
function f4 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L3 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    PropSet v2, v2 key="next"
    v4 = PropGet v2 key="next"
    PropSet v2, v4 key="r"
    v6 = String string="f"
    PropSet v2, v6 key="f"
    Return v2
}
