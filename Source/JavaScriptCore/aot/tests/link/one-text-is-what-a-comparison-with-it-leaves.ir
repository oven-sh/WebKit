# If a comparison with a text that is written left any text, `mode === "dev" ? only(mode) : 0` would hand only() a text of which nothing is known, though one text alone can pass
# function only(mode) { return mode; }  function pick(mode) { return mode === "dev" ? only(mode) : 0; }  pick(unknown);
# The edge lets through the text that it compares with: what is unknown and has passed is that text.
# TODO: the owner of facts/AOTLinkFlow: a test for one text cuts to texts, because Link has no rung for one text (unions-and-narrowing 4.13)
# RUN: link functions mechanisms=all
# CHECK: function f2
# CHECK-NEXT: parameter 0 {{*}}proven="dev"

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="unknown" [isFreeName]
    v3 = Call v0, -, v2 calleeName="pick"
    v4 = Undefined
    Return v4
}
function f1 name="pick" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="dev"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = CallDirect v0 function=f2
    Return v3
  b2():
    v4 = Integer integer=0
    Return v4
}
function f2 name="only" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
