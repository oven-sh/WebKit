# `globalThis.window = globalThis` and `globalThis.self = globalThis`: the global object is found under one more name and stays in sight.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="registered" mode=Strict
    PropSet v1, v1 key="window" mode=Strict
    PropSet v1, v1 key="self" mode=Strict
    v5 = PropGet v1 key="window"
    v6 = PropGet v5 key="registered"
    v7 = Integer integer=1
    v8 = Call v6, -, v7 calleeName="registered"
    Return
}
function f1 name="registered" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
