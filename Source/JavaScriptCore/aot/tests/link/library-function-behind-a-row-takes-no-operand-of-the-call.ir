# If the operands of a call of a built-in flowed through the code of the library behind its row, the receivers of all calls would meet at its parameters and be united, and what its body lets go would take them along:
# `Base.call(this, a)` would let `this` escape through the rest list of the library's `call`
# [1].map(double);
# The row says what the call does. The function behind it is reached, entered from outside, and the callback is entered by the row's word alone: every caller of it is known.
# LIBRARY: own
# RUN: link calls functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f2 callers-known

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ArrayPrototypeMapOfList function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewArray v0 contents=anything
    v2 = NewClosure function=f1
    v3 = PropGet v1 key="map"
    v4 = Call v3, v1, v2 calleeKey="map"
    v5 = Undefined
    Return v5
}
function f1 name="double" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="map" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeMapOfList thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v1, -, v0
    Return v2
}
