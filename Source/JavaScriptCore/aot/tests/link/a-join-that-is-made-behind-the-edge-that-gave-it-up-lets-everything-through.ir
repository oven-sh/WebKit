# As in an-edge-that-leads-back-without-what-its-target-took-gives-it-up.ir two ways lead into the round of b2 and b3, and b2 took from its one forward entry that v0 is not true. Here v0 is first
# asked for in b4, which is read BEHIND the edge that leads back from b3: the join is made when what b2 took has been given up already: it is made letting everything through.
# RUN: summary f1
# CHECK-NOT: passes=undefined|null|false
# CHECK: -> Contents Element of ClassInstance Array

module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs flags=[CachesEvaluationError, IsImportedAsESModule] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0
layout L0 module=m0 place=0
layout L1 module=m0 place=0
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined place=2
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewObject layout=L0 @0
    v1 = FinishObject v0 @0
    PutModuleVariable v1 variable=g0 @0
    v3 = NewClosure function=f1 @0
    v4 = Convert v3 declared={type=f1 flags=[IsFromCompiler]} @0
    v5 = Builtin builtin=GlobalThis @59
    v6 = PropGet v5 key="print" [isFreeName] @59
    v7 = Boolean boolean=true @70
    v8 = Call v4, -, v7, v7 calleeName="keep" @65
    v9 = PropGet v8 key="length" @74
    v10 = Integer integer=2 @90
    v11 = Call v4, -, v10, v7 calleeName="keep" @85
    v12 = PropGet v11 key="length" @91
    v13 = Add v9, v12 @85
    v14 = Call v6, -, v13 calleeName="print" @59
    v15 = Undefined @59
    Return v15 @59
}
function f1 name="keep" module=m0 flags=[IsSloppy, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    v2 = ToBoolean v1 @29
    Branch v2 -> taken b1(), notTaken b3() @29
  b1():
    v3 = Boolean boolean=true @29
    v4 = StrictEq v0, v3 @29
    Branch v4 -> taken b5(), notTaken b2() @29
  b2():
    LoopHint @52
    v6 = ToBoolean v1 @52
    Branch v6 -> taken b3(), notTaken b4() @52
  b3():
    v7 = ToBoolean v0 @35
    Branch v7 -> taken b2(), notTaken b5() @35
  b4():
    v8 = NewArray v0 contents=anything @52
    PutModuleVariable v8 variable=g0 @52
    Jump -> next b5() @52
  b5():
    v10 = NewArray contents=anything @52
    Return v10 @52
}
