# class Tags extends Set {} new Tags()[hidden]
# A control of a-class-written-over-set-brings-what-is-used-of-set-alone.ir.
# RUN: features
# CHECK: by SetPrototypeDifference

layout L0 kind=Instance name="Tags" module=m0 constructor=f1 flags=[HasHeritage]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Set
    v1 = ResolveHeritage v0
    v2 = NewClosure function=f1
    v3 = NewClass v2, v0, v1 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4, -
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="hidden" [isFreeName]
    v8 = ElemGet v5, v7
    Return v8
}
function f1 name="Tags" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=anything}] constructedClass=L0 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L0
    Return v3
}
