  b0():
    v0 = Integer integer=3
    v1 = GetModuleVariable variable=g4
    v2 = Call v1, -, v0 calleeName="added"
    v3 = GetModuleVariable variable=g3
    v4 = Call v3, -, v0 calleeName="entersOther"
    v5 = GetModuleVariable variable=g5
    v6 = Call v5, -, v0 calleeName="ring"
    v7 = GetModuleVariable variable=g6
    v8 = Call v7, -, v0 calleeName="floor"
    v9 = GetModuleVariable variable=g7
    v10 = Call v9, -, v0, v0 calleeName="byList"
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = Call v12, -, v2, v4, v6, v8, v10
    Return v13
}
