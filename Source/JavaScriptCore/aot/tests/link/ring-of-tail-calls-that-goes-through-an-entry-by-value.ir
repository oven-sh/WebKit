# a call in tail position is a jump, and whoever is jumped to returns in place of the function. An entry by value returns a boxed value, and comes back for a raw one to box it.
# Round a ring a row of such calls may go on without end, so there each has to be a jump: a ring with a call by value in it returns boxed values, whatever is proven of its results
# function first(n, next, other) { return n === 0 ? n * 1 : next(n - 1, other, next) }  function second(n, next, other) { return n === 0 ? n * 2 : next(n - 1, other, next) }
# function enters(n) { return first(n, second, first) }  function entersOther(n) { return first(n, first, second) }  function added(n) { return enters(n) + 1 }
# function ring(n) { return n === 0 ? 0.5 : ring(n - 1) }  function floor(n) { return Math.floor(n) }  function byList(n, ...rest) { return n === 0 ? 0.5 : byList(n - 1, ...rest) }
# RUN: summary f1
# CHECK: call c0 {{*}} in-tail-position
# RUN(ADDED): summary f5
# ADDED-NOT: in-tail-position
# All of them return numbers
# RUN(LINK): link functions mechanisms=all
# LINK: function f1 {{*}}result=int|whole {{*}}ring-by-value
# LINK: function f2 {{*}}result=int|whole {{*}}ring-by-value
# LINK: function f3 {{*}}result=int|whole
# LINK: function f6 {{*}}result=fractional {{*}}ring-by-value
# LINK: function f8 {{*}}result=fractional {{*}}ring-by-value
# RUN(LISTED): link functions mechanisms=all
# LISTED-NOT: function f3 {{*}}ring-by-value
# LISTED-NOT: function f4 {{*}}ring-by-value
# LISTED-NOT: function f5 {{*}}ring-by-value
# LISTED-NOT: function f7 {{*}}ring-by-value
# RUN(PLAN): plan units mechanisms=all
# PLAN: unit f1:Body ({{*}}) -> (JSValue)
# PLAN: unit f2:Body ({{*}}) -> (JSValue)
# Whoever only leads into the ring stands in none: it comes back from its call, once, and unboxes
# PLAN: unit f3:Body ({{*}}) -> (Double)
# PLAN: unit f4:Body ({{*}}) -> (Double)
# PLAN: unit f5:Body ({{*}}) -> (Double)
# A ring of one call of a value, listed with its one callee: whether such a call is direct is decided unit by unit, so the ring returns boxed values: ring-of-tail-calls-returns-raw-values-only-where-each-call-is-written-direct.ir
# PLAN: unit f6:Body ({{*}}) -> (JSValue)
# Native code comes back
# PLAN: unit f7:Body ({{*}}) -> (Double)
# The one callee is listed, and still the call goes by value: the walk lays out no list whose length it does not know
# PLAN: unit f8:Body ({{*}}) -> (JSValue)

variable g0 name="first" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="second" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="enters" module=m0 declared={type=f3 flags=[IsFromCompiler]} initialization=Function function=f3 flags=[IsImmutable]
variable g3 name="entersOther" module=m0 declared={type=f4 flags=[IsFromCompiler]} initialization=Function function=f4 flags=[IsImmutable]
variable g4 name="added" module=m0 declared={type=f5 flags=[IsFromCompiler]} initialization=Function function=f5 flags=[IsImmutable]
variable g5 name="ring" module=m0 declared={type=f6 flags=[IsFromCompiler]} initialization=Function function=f6 flags=[IsImmutable]
variable g6 name="floor" module=m0 declared={type=f7 flags=[IsFromCompiler]} initialization=Function function=f7 flags=[IsImmutable]
variable g7 name="byList" module=m0 declared={type=f8 flags=[IsFromCompiler]} initialization=Function function=f8 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
