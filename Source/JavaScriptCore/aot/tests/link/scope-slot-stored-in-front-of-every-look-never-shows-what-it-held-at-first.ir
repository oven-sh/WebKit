# If what a slot of a scope holds before its first store were part of its type wherever the slot is stored later, `const limit = 10` would be `undefined|i32|absent` in every closure: a check and a generic operator at each use
# function make() { var count = 0; const limit = 10; return read; function read() { return limit + count; } }
# both stores stand above the one point at which a closure over the scope leaves. The allocation lists undefined for the var, as the language has it, and nobody sees that either
# RUN: link fields mechanisms=all
# CHECK: field L0.0 @"0" proven=i32 writers-known
# CHECK: field L0.1 @"1" proven=i32 writers-known

layout L0 kind=Environment module=m0 fields=[{key=@"0" declared={type=anything|absent} flags=[IsImmutable] variableName="limit"}, {key=@"1" declared={type=anything} flags=[IsRequired] variableName="count"}] ownFieldCount=2
variable g0 name="sink" module=m0 declared={type=anything}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    PutModuleVariable v1 variable=g0
    v3 = Undefined
    Return v3
}
function f1 name="make" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = NewObject -, v0 layout=L0 fields=[1]
    v2 = NewClosure v1 function=f2
    v3 = Integer
    PutEnvironmentField v1, v3 layout=L0 field=1
    v5 = Integer integer=10
    PutEnvironmentField v1, v5 layout=L0
    Return v2
}
function f2 name="read" module=m0 captures=[{type=env L0 flags=[IsFromCompiler]}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0
    v2 = CheckInitialized v1 name="limit"
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = Add v2, v3
    Return v4
}
