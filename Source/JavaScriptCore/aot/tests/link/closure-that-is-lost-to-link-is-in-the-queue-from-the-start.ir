# Link no longer tells two closures apart that have met and that are more than called. A caller may: it folds a branch, it knows what a slot holds. What it has proven of its argument is proven of the parameter, so the callee may mention one of the two.
# Which, nobody lists. So no referrer stands for that: all that is made of the bodies of lost functions is in the queue from the start, and `pass`, at whose parameter they arrive, leads to neither.
# function a() {}  function b() {}  let kept; function pass(f) { kept = f; return kept; }  pass(a); const g = pass(b); g.prototype; g();
# One of them is called: functions that have met and that nobody calls are not reached (functions-that-met-and-are-never-called-are-not-reached.ir).
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}} in-queue-from-start
# CHECK: referrers f0
# CHECK: function f2 {{*}} in-queue-from-start
# CHECK: referrers f0
# CHECK: function f3 callers-known one-callee {{*}} takes-arrivals
# CHECK-NOT: group

module m0 path="main.js" displayPath="main.js" body=f0
variable g0 name="kept0" module=m0 declared={type=anything} initialization=Undefined
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Call v2, -, v0 calleeName="pass"
    v4 = Call v2, -, v1 calleeName="pass"
    v5 = PropGet v4 key="prototype"
    v6 = Call v4, -
    v7 = Undefined
    Return v7
}
function f1 name="a" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="b" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f3 name="pass" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    Return v2
}
