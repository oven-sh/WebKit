# main.mjs: pick(api)(1), where pick(from) returns from.helper . api.mjs: export { helper } from "./barrel.mjs" . barrel.mjs: export * from "./one.cjs"; export * from "./two.cjs"
# Where a barrel has two stars the front end cannot say whose name `helper` is: the export of api.mjs is an indirect one onto a name that the barrel does not list. giveExport() finds no such entry: it gives anything,
# AND THE BARREL's NAMESPACE IS LET GO THEN, with what its stars pass on. (Without that escape `helper` was reached by nobody and the executable died: "This function was not compiled".)
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK-NOT: function f2 unreached

layout L0 module=m0 fields=[{key="helper" declared={type=anything}}] ownFieldCount=1
layout L1 module=m2 fields=[{key="other" declared={type=anything}}] ownFieldCount=1
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="exports" module=m2 declared={type=anything} initialization=Undefined
module m0 path="/one.cjs" displayPath="one.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
