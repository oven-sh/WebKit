module m2 path="/two.cjs" displayPath="two.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f3 exportsVariable=g1
module m3 path="#3" displayPath="two.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f4 requests=[{target=m2 kind=Require completes=true}]
module m4 path="/barrel.mjs" displayPath="barrel.mjs" flags=[CachesEvaluationError] body=f5 requests=[{target=m1 isDynamicStarExport=true completes=true}, {target=m3 isDynamicStarExport=true completes=true}]
module m5 path="/api.mjs" displayPath="api.mjs" flags=[CachesEvaluationError, IsImportedAsNamespace] body=f6 requests=[{target=m4 completes=true}] exports=[{name="helper" kind=Indirect module=m4 importName="helper"}] requiredNames=[{module=m4 name="helper" exportName="helper" specifier="./barrel.mjs"}]
module m6 path="/main.mjs" displayPath="main.mjs" flags=[CachesEvaluationError] body=f7 requests=[{target=m1 completes=true isHoisted=true}, {target=m3 completes=true isHoisted=true}, {target=m5 completes=true}]
