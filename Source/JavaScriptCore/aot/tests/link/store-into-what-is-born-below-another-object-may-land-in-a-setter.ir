# A store into an object that is BORN BELOW ANOTHER OBJECT may land in a setter up there, which is handed what is stored. The scan makes a plain edge into the field of a store into a fresh allocation, with no record of an access,
# and whether a field is filled never asks for another prototype. Both are sound only because such an object, and with it what is stored, escapes: the literal with `__proto__:` at its birth, the function at `F.prototype = other`.
# Whoever takes one of the two escapes away turns this test red: x of P or of Q would stay proven a number while the setter has kept the object and a text is stored there. R, stored into a plain record, is the control.
# const kept = [];
# const above = { set slot(v) { kept.push(v); } };
# function born(v) { const o = { __proto__: above }; o.slot = v; return o; }
# function F(v) { this.slot = v; }
# F.prototype = above;
# class P { x = 1; }
# class Q { x = 1; }
# class R { x = 1; }
# function plain(v) { const o = {}; o.slot = v; return o; }
# born(new P());
# new F(new Q());
# plain(new R());
# kept[0].x = "s";
# kept[1].x = "s";
# RUN: link fields mechanisms=all
# CHECK: field L3.0 "x" proven=i32 writers-known
# CHECK: field L6.0 "slot" proven=L3
# RUN(KEPT): link fields mechanisms=all
# KEPT-NOT: field L1.0 "x" proven
# KEPT-NOT: field L2.0 "x" proven

