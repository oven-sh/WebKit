# The same entry where code from outside the image may run: it imports the entry and calls what it likes.
# main.ts: export function pathOf(n) { return n } export default function serve(n) { return n }
# REQUIRES: code-outside-image
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 callers-known
# CHECK-NOT: function f2 callers-known

module m0 path="/main.js" displayPath="main.js" body=f0 exports=[{name="default" variable=g1}, {name="pathOf" variable=g0}]
entry module=m0 hostReads=[{exportName="default"}]
variable g0 name="pathOf" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="serve" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=1
    v2 = Call v0, -, v1 calleeName="pathOf"
    v3 = GetModuleVariable variable=g1
    v4 = Call v3, -, v1 calleeName="serve"
    Return
}
function f1 name="pathOf" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="serve" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
