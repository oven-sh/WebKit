# If an operand that an operator converts flowed into unseen code, as in the first version, every object that is ever added, compared or joined into a text would lose what is known of its fields
# class N { constructor() { this.n = "s"; }  valueOf() { return 1; } }  function inc(n) { return n + 1; }  function get(n) { return n.n; }  const n = new N();  inc(n);  get(n);
# The conversion is a call by name for each key of the protocol, with the objects among the operand for `this`. The class answers to one key, and the object reaches that method and nothing else.
# RUN: summary f3
# CHECK: call {{*}} v2 Name "valueOf" this=[[objects]] ()
# CHECK: edge Parameter 0 -> [[objects]] passes=object
# RUN(KEPT): summary f3
# KEPT-NOT: -> Unknown
# RUN(LINK): link functions fields layouts mechanisms=all
# LINK: function f2 callers-known
# LINK-NOT: unreached
# LINK: parameter 0 {{*}}proven=L0
# LINK: function f4 callers-known one-callee {{*}}result=string
# LINK: field L0.0 "n" proven=string writers-known
# LINK: layout L0 changes=[]

layout L0 kind=Instance name="N" module=m0 constructor=f1 fields=[{key="n" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
