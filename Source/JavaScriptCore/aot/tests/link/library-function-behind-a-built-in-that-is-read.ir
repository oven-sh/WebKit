# If only a call of a built-in reached the code of the library behind it, a built-in that is read as a value and called out of sight would have a function object that the interpreter runs
# export const map = Array.prototype.map;
# The program calls nothing. Whoever imports the module has the function object, so it has to work.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached
# RUN(IMAGE): image ProgramTables
# IMAGE: compiledRuntimeFunction ArrayPrototypeMap
# IMAGE-NOT: compiledRuntimeFunction ArrayPrototypeFilter

