# If the copy were not seen as a store into the target under every name of the source, the field of the target would stay proven a string while it holds a boolean, and the target would have no field "z"
# function mix(t, s) { Object.assign(t, s); }  mix({ x: "a" }, { x: true, z: null });
# Neither object escapes, and nothing is stored beside the fields of the source. So the copy stores its two names into the target after its construction: one into a listed field, one into a field that is appended. The source is only read.
# RUN: summary f1
# CHECK: change {{*}} v3 CopiesInto Parameter 0 other=Parameter 1
# RUN(KEPT): summary f1
# KEPT-NOT: Parameter 0 -> Unknown
# KEPT-NOT: Parameter 1 -> Unknown
# RUN(LINK): link fields layouts mechanisms=all
# LINK: field L0.0 "x" proven=true|string writers-known
# LINK-NOT: written-at-construction-alone
# LINK: field L0.1 "z" appended proven=null writers-known
# LINK: field L1.0 "x" proven=true writers-known written-at-construction-alone
# LINK: field L1.1 "z" proven=null writers-known written-at-construction-alone
# LINK: layout L0 {{*}}changes=[]
# LINK: layout L1 {{*}}changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Boolean boolean=true
    v4 = Null
    v5 = NewObject -, v3, v4 layout=L1 fields=[0, 1]
    v6 = FinishObject v5
    v7 = NewClosure function=f1
    v8 = Call v7, -, v2, v6 calleeName="mix"
    v9 = Undefined
    Return v9
}
function f1 name="mix" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Builtin builtin=ObjectAssign [isNotReadFromHolder]
    v3 = Call v2, -, v0, v1
    v4 = Undefined
    Return v4
}
