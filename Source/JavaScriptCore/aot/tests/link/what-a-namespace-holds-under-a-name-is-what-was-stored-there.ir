# namespace N { export function f() { return 1 } export const late = 2 }  function replace() { (N as any).f = g }  function use() { return N.f() }
# The name `f` is bound to the function for good. The property of the object is not: what it holds is what the stores bring. And the object is in the variable before its block has stored anything:
# the scan follows the allocation as it follows a record's, so neither field counts as filled by the construction.
# RUN: link fields layouts variables mechanisms=all
# CHECK: field L0.0 "f"
# CHECK-NOT: proven=f1
# CHECK: field L0.1 "late"
# CHECK: layout L0 changes=[] stays-with-compiled-code
# CHECK: variable g0 proven=undefined|L0
# RUN(FILLED): link fields mechanisms=all
# FILLED-NOT: field L0.{{*}} filled
# RUN(SCAN): summary f0
# SCAN: leaves-empty L0.0 "f"
# SCAN: leaves-empty L0.1 "late"

layout L0 kind=Container name="N" module=m0 fields=[{key="f" declared={type=f1 flags=[IsFromCompiler, IsExpected]}}, {key="late" declared={type=2}}] ownFieldCount=2
variable g0 name="N" module=m0 declared={type=anything} initialization=Undefined flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    PutModuleVariable v1 variable=g0
    v3 = NewClosure function=f1
    PropSet v1, v3 key="f"
    v5 = Integer integer=2
    PropSet v1, v5 key="late"
    v7 = NewClosure function=f3
    v8 = Call v7, - calleeName="replace"
    v9 = NewClosure function=f4
    v10 = Call v9, - calleeName="use"
    Return v10
}
function f1 name="f" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f2 name="g" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    Return v0
}
function f3 name="replace" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = NewClosure function=f2
    PropSet v0, v1 key="f"
    v3 = Undefined
    Return v3
}
function f4 name="use" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="f"
    v2 = Call v1, v0 calleeKey="f" calleeName="N.f"
    Return v2
}
