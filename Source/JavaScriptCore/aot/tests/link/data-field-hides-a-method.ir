# If Link looked a name up among the members of the class alone, `x.m()` would go straight to the method while the object's own field holds another function, which is the one that JavaScript calls
# class A { constructor(g) { this.m = g; }  m() { return "method"; } }  function g() { return true; }  function ask(x) { return x.m(); }  ask(new A(g));
# A read off an instance sees the data field if the object has it by then, else the member. Where a layout has both, both flow.
# RUN: link calls mechanisms=all
# CHECK-NOT: call f4 v2
# RUN(BOTH): link functions fields members mechanisms=all
# BOTH: function f4 callers-known one-callee {{*}}result=true|string
# BOTH: field L0.0 "m" proven=f3 writers-known
# BOTH: member L0 Prototype 0 Method "m" function=f2
# RUN(REACHED): link functions mechanisms=all
# REACHED-NOT: unreached

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="m" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f3
    v6 = Construct v4, -, v5
    v7 = NewClosure function=f4
    v8 = Call v7, -, v6 calleeName="ask"
    v9 = Undefined
    Return v9
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="m"
    Return v3
}
function f2 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="method"
    Return v0
}
function f3 name="g" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f4 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
