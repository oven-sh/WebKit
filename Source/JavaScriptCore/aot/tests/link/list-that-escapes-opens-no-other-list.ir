# If a list that is handed to unseen code opened the elements of every list, as in the second version, one call of a host function without a row would take away what is known of every object that any list holds. If it did not open its own, unseen code could change the object in it behind a proof
# const out = [{ x: "a" }], home = [{ y: "a" }];  sink(out);  function first(l) { return l[0]; }  first(home);
# Only what has reached unseen code escapes: the site of the one list, and with it what it holds.
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f1 callers-known one-callee {{*}}result=undefined|L1
# CHECK: field L0.0 "x"
# CHECK-NOT: writers-known
# CHECK: field L1.0 "y" proven=string writers-known written-at-construction-alone
# CHECK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L1 changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray v2 contents=anything
    v4 = NewObject -, v0 layout=L1 fields=[0]
    v5 = FinishObject v4
    v6 = NewArray v5 contents=anything
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="sink" [isFreeName]
    v9 = Call v8, -, v3
    v10 = NewClosure function=f1
    v11 = Call v10, -, v6 calleeName="first"
    v12 = Undefined
    Return v12
}
function f1 name="first" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    Return v2
}
