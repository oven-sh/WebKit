# all that ever arrives at the key of an access is one written text: the access is one under that name, in flows, effects, writes and referrers, and the walk builds it by the name
# function get(o, k) { return o[k]; }   function set(o, k, v) { o[k] = v; }   const p = { x: "a", y: 1 };  set(p, "x", "b");  get(p, "x");
# as an access under any key the store reaches `y` too, may name the prototype link and lets the layout escape
# TODO: link: the rung "one written text" of Link's ladder is not built (RULINGS.md, unions-and-narrowing (d)); its design stands under ASK in the HOOKS.txt of strings-3
# RUN: link accesses fields layouts mechanisms=all
# CHECK: access f1 v2 under "x"
# CHECK-NEXT: access f2 v3 under "x"
# CHECK: field L0.0 "x" proven=string writers-known
# CHECK: field L0.1 "y" proven={{*}} writers-known written-at-construction-alone
# CHECK: layout L0 changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = Integer integer=1
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = String string="x"
    v7 = String string="b"
    v8 = Call v5, -, v3, v6, v7 calleeName="set"
    v9 = Call v4, -, v3, v6 calleeName="get"
    Return v9
}
function f1 name="get" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
function f2 name="set" module=m0 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    ElemSet v0, v1, v2 mode=Strict
    v4 = Undefined
    Return v4
}
