# `wrap` passes its rest list on to `between`, which takes the first argument itself, gathers what is left and passes that on to `take`. If the places were not counted anew behind the parameters of `between`, `take` would get `true` and `i32` where `i32` and `string` arrive.
#   function take(a, b) { return b; }  function between(first, ...rest) { return take(...rest); }  function wrap(...list) { return between(...list); }  wrap(true, 1, "x");
# OPTIONS: check=FlowFixpoint
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known {{*}}result=string returns=
# CHECK-NEXT: parameter 0 expected=i32 proven=int[0, 2147483647]
# CHECK-NEXT: parameter 1 expected=string proven=string
# CHECK: function f3 callers-known
# CHECK-NEXT: parameter 0 expected=true proven=true

variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f3
    PutModuleVariable v2 variable=g1
    v4 = NewClosure function=f1
    v5 = Boolean boolean=true
    v6 = Integer integer=1
    v7 = String string="x"
    v8 = Call v4, -, v5, v6, v7 calleeName="wrap"
    v9 = Undefined
    Return v9
}
function f1 name="wrap" module=m0 flags=[HasRestParameter] thisType={type=anything} parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: Array):
    v1 = GetModuleVariable variable=g1
    v2 = CallList v1, -, v0 calleeName="between"
    Return v2
}
function f2 name="take" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
function f3 name="between" module=m0 flags=[HasRestParameter] length=1 thisType={type=anything} parameters=[{type=anything}, {type=Array flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: anything, v1: Array):
    v2 = GetModuleVariable variable=g0
    v3 = CallList v2, -, v1 calleeName="take"
    Return v3
}
