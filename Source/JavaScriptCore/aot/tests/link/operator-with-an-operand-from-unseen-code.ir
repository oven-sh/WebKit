# If an operand that comes from code nobody has seen counted like one at which nothing has arrived, `both(text, text)` would have no result, and whoever takes it would be compiled for a value that never comes. If an operand at which nothing ever arrives counted for anything, dead code would widen what live code proves
# function add(a) { return a + 1; }  function fail() { throw 1; }  function after() { return fail() + 1; }  function both(a, b) { return a + b; }  add(text);  after();  both(text, text);
# Only where nobody has seen what arrives is the result the widest type of the row, and a number on the other side still rules out a bigint: that sum throws.
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=number|string returns
# CHECK: function f3 callers-known one-callee cycle={{*}} rank={{*}} returns
# CHECK: function f4 {{*}}result=number|string|bigint returns

variable g0 name="fail" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1 calleeName="add"
    v4 = NewClosure function=f3
    v5 = Call v4, - calleeName="after"
    v6 = NewClosure function=f4
    v7 = Call v6, -, v1, v1 calleeName="both"
    v8 = Undefined
    Return v8
}
function f1 name="add" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Add v0, v1
    Return v2
}
function f2 name="fail" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Throw v0
}
function f3 name="after" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0, - calleeName="fail"
    v2 = Integer integer=1
    v3 = Add v1, v2
    Return v3
}
function f4 name="both" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    Return v2
}
