# function first() {} Object.defineProperty(first, "limit", { set: (value) => value() }); first.limit = second
# The name is followed on the closure, so the store lays `second` there. The setter is entered out of unseen code: what is laid under the name goes there too.
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f3 unreached

layout L0 fields=[{key="get" declared={type=anything}}, {key="set" declared={type=anything}}, {key="enumerable" declared={type=anything}}, {key="value" declared={type=anything}}]
layout L1 fields=[{key="limit" declared={type=anything}}, {key="mark" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectDefineProperty
    v3 = NewClosure function=f2
    v4 = NewObject -, v3 layout=L0 fields=[1]
    v5 = FinishObject v4
    v6 = String string="limit"
    v7 = Call v2, v1, v0, v6, v5 calleeName="Object.defineProperty"
    v8 = NewClosure function=f3
    PropSet v0, v8 key="limit"
    v10 = Undefined
    Return v10
}
function f1 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 module=m0 kind=Arrow length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0, -
    Return v1
}
function f3 name="second" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
