# If all layouts that ever met a stranger were one family, the first value of it that reached unseen code would take them all, and a store through one family of strangers would spoil the fields of the other
# function first(c) { switch (c) { case 1: return { x: "a", p: 0 }; case 2: return { x: "b", t: 0 }; case 3: return { x: "c", u: 0 }; case 4: return { x: "d", v: 0 }; default: return { x: true, q: 0 }; } }
# function second(c) { switch (c) { case 1: return { x: 1, r: 0 }; case 2: return { x: 2, w: 0 }; case 3: return { x: 3, y: 0 }; case 4: return { x: 4, z: 0 }; default: return { x: null, s: 0 }; } }
# function read(o) { return o.x; }  report(typeof read(first(flag)));  sink(second(flag));
# Five meet in what each function gives, one more than a set takes, so they are lost. The first five meet each other and nobody else. The other five meet each other, and what holds one of them is handed to unseen code: those five escape, and the first five do not.
# A read through the first five finds what those five hold under the name
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f3 callers-known one-callee {{*}}result=undefined|true|string
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1|L4|L5|L6
# CHECK: field L0.0 "x" proven=string writers-known
# CHECK: field L1.0 "x" proven=true writers-known
# CHECK: field L4.0 "x" proven=string writers-known
# CHECK: field L5.0 "x" proven=string writers-known
# CHECK: field L6.0 "x" proven=string writers-known
# CHECK: layout L0 {{*}}changes=[]
# CHECK: layout L1 {{*}}changes=[]
# CHECK: layout L2 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L3 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L4 {{*}}changes=[]
# CHECK: layout L5 {{*}}changes=[]
# CHECK: layout L6 {{*}}changes=[]
# CHECK: layout L7 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L8 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L9 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# RUN(ANSWER): run-in-shell globalThis.flag = false; globalThis.report = value => print(String(value)); globalThis.sink = o => { o.x = "changed"; o.more = 1; print(Object.keys(o).join()); };
# ANSWER: boolean
# ANSWER-NEXT: x,s,more
# ANSWER-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none globalThis.flag = false; globalThis.report = value => print(String(value)); globalThis.sink = o => { o.x = "changed"; o.more = 1; print(Object.keys(o).join()); };
# NONE: boolean
# NONE-NEXT: x,s,more
# NONE-NEXT: exited with 0

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="r" declared={type=anything} flags=[IsRequired]}]
layout L3 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flags=[IsRequired]}]
layout L4 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="t" declared={type=anything} flags=[IsRequired]}]
layout L5 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="u" declared={type=anything} flags=[IsRequired]}]
layout L6 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="v" declared={type=anything} flags=[IsRequired]}]
layout L7 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="w" declared={type=anything} flags=[IsRequired]}]
layout L8 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="y" declared={type=anything} flags=[IsRequired]}]
layout L9 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="z" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = PropGet v0 key="report" [isFreeName]
    v3 = PropGet v0 key="sink" [isFreeName]
    v4 = NewClosure function=f1
    v5 = NewClosure function=f2
    v6 = NewClosure function=f3
    v7 = Call v4, -, v1 calleeName="first"
    v8 = Call v6, -, v7 calleeName="read"
    v9 = TypeOf v8
    v10 = Call v2, -, v9 calleeName="report"
    v11 = Call v5, -, v1 calleeName="second"
    v12 = Call v3, -, v11 calleeName="sink"
    Return v12
}
function f1 name="first" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Switch v0 cases=[1, 2, 3, 4] -> case b1(), case b2(), case b3(), case b4(), otherwise b5()
  b1():
    v2 = String string="a"
    v3 = NewObject -, v2, v1 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    Jump -> next b6(v4)
  b2():
    v5 = String string="b"
    v6 = NewObject -, v5, v1 layout=L4 fields=[0, 1]
    v7 = FinishObject v6
    Jump -> next b6(v7)
  b3():
    v8 = String string="c"
    v9 = NewObject -, v8, v1 layout=L5 fields=[0, 1]
    v10 = FinishObject v9
    Jump -> next b6(v10)
  b4():
    v11 = String string="d"
    v12 = NewObject -, v11, v1 layout=L6 fields=[0, 1]
    v13 = FinishObject v12
    Jump -> next b6(v13)
  b5():
    v14 = Boolean boolean=true
    v15 = NewObject -, v14, v1 layout=L1 fields=[0, 1]
    v16 = FinishObject v15
    Jump -> next b6(v16)
  b6(v17):
    Return v17
}
function f2 name="second" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Switch v0 cases=[1, 2, 3, 4] -> case b1(), case b2(), case b3(), case b4(), otherwise b5()
  b1():
    v2 = Integer integer=1
    v3 = NewObject -, v2, v1 layout=L2 fields=[0, 1]
    v4 = FinishObject v3
    Jump -> next b6(v4)
  b2():
    v5 = Integer integer=2
    v6 = NewObject -, v5, v1 layout=L7 fields=[0, 1]
    v7 = FinishObject v6
    Jump -> next b6(v7)
  b3():
    v8 = Integer integer=3
    v9 = NewObject -, v8, v1 layout=L8 fields=[0, 1]
    v10 = FinishObject v9
    Jump -> next b6(v10)
  b4():
    v11 = Integer integer=4
    v12 = NewObject -, v11, v1 layout=L9 fields=[0, 1]
    v13 = FinishObject v12
    Jump -> next b6(v13)
  b5():
    v14 = Null
    v15 = NewObject -, v14, v1 layout=L3 fields=[0, 1]
    v16 = FinishObject v15
    Jump -> next b6(v16)
  b6(v17):
    Return v17
}
function f3 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
