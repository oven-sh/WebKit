# two closures meet at what is called, so the call has no one callee. It enters functions of the program alone all the same: it gives what they give and does what they do
# const pick = globalThis.flag ? () => 1 : () => 2;  pick();
# RUN: link calls mechanisms=all
# CHECK: several f0 v5 result={{*}} layouts-written=none returns=[mayThrow
# RUN(NEVER): link calls mechanisms=all
# NEVER-NOT: call f0 v5
# NEVER-NOT: several f0 v5 {{*}}mayCallUnknownCode
# NEVER-NOT: several f0 v5 {{*}}mayWriteWhatIsSeen

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v2)
  b2():
    Jump -> next b3(v3)
  b3(v4):
    v5 = Call v4
    v6 = Add v5, v5
    Return v6
}
function f1 name="one" module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f2 name="two" module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
