# one.js: export function first(n) { return n }   two.js: export function second(n) { return n }
# main.js: import * as one from "./one.js"; import * as two from "./two.js"; function ask(space) { return Object.isFrozen(space) } ask(one); ask(two); first(1); second(1)
# Two namespace objects meet in `space` as a set of two layouts. Object.isFrozen() reads what lies under every name of the object that it is given: all that both modules export has escaped, as where one object comes alone.
# RUN: link functions mechanisms=all
# CHECK-NOT: function f4 {{*}}callers-known
# CHECK-NOT: function f5 {{*}}callers-known

module m0 path="/one.js" displayPath="one.js" body=f1 exports=[{name="first" variable=g0}]
module m1 path="/two.js" displayPath="two.js" body=f2 exports=[{name="second" variable=g1}]
module m2 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m0 completes=true}, {target=m1 completes=true}]
entry module=m2
variable g0 name="first" module=m0 declared={type=function} initialization=Function function=f4 flags=[IsImmutable]
variable g1 name="second" module=m1 declared={type=function} initialization=Function function=f5 flags=[IsImmutable]
function f0 name="main" module=m2 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f3
    v1 = ModuleNamespace module=m0
    v2 = Call v0, -, v1 calleeName="ask"
    v3 = ModuleNamespace module=m1
    v4 = Call v0, -, v3 calleeName="ask"
    v5 = Integer integer=1
    v6 = GetModuleVariable variable=g0
    v7 = Call v6, -, v5 calleeName="first"
    v8 = GetModuleVariable variable=g1
    v9 = Call v8, -, v5 calleeName="second"
    Return
}
function f1 name="one" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="two" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f3 name="ask" module=m2 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=ObjectIsFrozen
    v2 = Call v1, -, v0 calleeName="Object.isFrozen"
    Return v2
}
function f4 name="first" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f5 name="second" module=m1 length=1 parameters=[{type=anything}] results=[{type=anything}] {
