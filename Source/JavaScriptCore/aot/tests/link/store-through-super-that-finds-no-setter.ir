# A store through `super` that comes to no accessor lays the property on the receiver. Nobody follows that store, so the receiver and the value go to unseen code: if they did not, the layout would count as one that gains no property
# class Base { name() { return "b"; }  get size() { return this; }  set size(v) { } }  class Derived extends Base { name() { return super.name(); }  get size() { return super.size; }  set size(v) { super.size = v; }  lay(v) { super.other = v; } }
# const d = new Derived();  d.lay("s");
# RUN: link members layouts mechanisms=all
# CHECK: member L1 Prototype 3 Method "lay"
# CHECK: layout L0 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# CHECK: layout L1 {{*}}changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]

layout L0 kind=Instance name="Base" module=m0 constructor=f1
layout L1 kind=Instance name="Derived" module=m0 base=L0 constructor=f4 supertypes=[L0] flags=[HasHeritage]
variable g0 name="Derived" module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="name"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 methodKind=Getter index=1 key="size"
    v6 = NewClosure function=f7
    DefineMethod v1, v6 layout=L0 methodKind=Setter index=2 key="size"
    v8 = FinishClass v1 layout=L0
    v9 = ResolveHeritage v8
    v10 = NewClosure function=f4
    v11 = NewClass v10, v8, v9 layout=L1
    PutModuleVariable v11 variable=g0
    v13 = NewClosure function=f5
    DefineMethod v11, v13 layout=L1 key="name"
    v15 = NewClosure function=f6
    DefineMethod v11, v15 layout=L1 methodKind=Getter index=1 key="size"
    v17 = NewClosure function=f8
    DefineMethod v11, v17 layout=L1 methodKind=Setter index=2 key="size"
    v19 = NewClosure function=f9
    DefineMethod v11, v19 layout=L1 index=3 key="lay"
    v21 = FinishClass v11 layout=L1
    v22 = Construct v21
    v23 = PropGet v22 key="lay"
    v24 = String string="s"
    v25 = Call v23, v22, v24 calleeKey="lay"
    v26 = Undefined
    Return v26
}
function f1 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="name" module=m0 kind=Method flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="b"
    Return v1
}
