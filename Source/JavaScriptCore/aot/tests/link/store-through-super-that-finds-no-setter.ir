  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = GetSuperBase v1 homeKind=ClassPrototype
    v3 = SuperGet v2, v0 key="name"
    v4 = Call v3, v0 calleeName="super.name"
