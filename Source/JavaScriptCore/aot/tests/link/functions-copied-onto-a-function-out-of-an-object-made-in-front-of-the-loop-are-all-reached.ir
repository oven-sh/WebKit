# function Holder() {} const source = { used }; do { Object.assign(Holder, source); source.used = unused; } while (hidden); Holder.used()
# A control of functions-copied-onto-a-function-out-of-a-literal-do-not-meet.ir: the store behind the call comes in front of it on the next turn: only a literal of the call's own block is written for the call.
# RUN: link functions mechanisms=all
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f3 unreached

layout L0 fields=[{key="used" declared={type=anything}}, {key="unused" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewObject -, v1 layout=L0 fields=[0]
    Jump -> next b1()
  b1():
    LoopHint
    v5 = Builtin builtin=Object
    v6 = Builtin builtin=ObjectAssign
    v7 = Call v6, v5, v0, v3 calleeKey="assign" calleeName="Object.assign"
    PropSet v3, v2 key="used"
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="hidden" [isFreeName]
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b2()
  b2():
    v12 = PropGet v0 key="used"
    v13 = Call v12, v0 calleeKey="used"
    Return v13
}
function f1 name="Holder" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="used" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="unused" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
