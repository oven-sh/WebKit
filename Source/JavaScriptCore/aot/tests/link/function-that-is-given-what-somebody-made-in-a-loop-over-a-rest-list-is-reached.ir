# function hide(...fns) { for (const fn of fns) Object.defineProperty(fn, "name", hidden); }  function first() {}  hide(first);
# The control of function-that-is-named-in-a-loop-over-a-rest-list-is-not-reached.ir: `undefined` arrives first and nothing is handed over then; when the function arrives the definition is looked at again, and nobody knows this descriptor.
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: function f2 unreached

layout L0 fields=[{key="value" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1 calleeName="hide"
    v3 = Undefined
    Return v3
}
function f1 name="hide" module=m0 flags=[HasRestParameter, HasExplicitName] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v6 = Undefined
    Return v6
  b3():
    v7 = Builtin builtin=Object
    v8 = Builtin builtin=ObjectDefineProperty
    v9 = String string="name"
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="hidden" [isFreeName]
    v12 = Convert v11 declared={type=anything}
    v13 = Call v8, v7, v5, v9, v12 calleeName="Object.defineProperty"
    Jump -> next b1()
}
function f2 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
