# If what Object.fromEntries() makes were taken for an object as Object makes it, it would have no property of its own, and what Object.values() reads out of it would be proven to be nothing at all.
# function use(e) { return e; }  use(Object.values(Object.fromEntries(Object.entries({ a: 1 })))[0]);
# The row calls its result unaliased: it is made there and nobody else holds it. That is all it says: the object is born with properties of its own that nobody lists.
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK-NOT: proven=
# CHECK: referrers f0

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Builtin builtin=Object
    v4 = Builtin builtin=ObjectEntries
    v5 = Call v4, v3, v2 calleeName="Object.entries"
    v6 = Builtin builtin=ObjectFromEntries
    v7 = Call v6, v3, v5 calleeName="Object.fromEntries"
    v8 = Builtin builtin=ObjectValues
    v9 = Call v8, v3, v7 calleeName="Object.values"
    v10 = Integer integer=0
    v11 = ElemGet v9, v10
    v12 = NewClosure function=f1
    v13 = Call v12, -, v11 calleeName="use"
    v14 = Undefined
    Return v14
}
function f1 name="use" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
