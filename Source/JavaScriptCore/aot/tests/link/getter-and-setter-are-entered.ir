# If a read and a store by name found data fields alone, the getter and the setter of a class would be left out of the executable, the read would count as giving nothing, and what the setter stores would never be seen
# class T { get v() { return "g"; }  set v(n) { this.kept = n; } }  function use(t) { t.v = true; return t.v; }  use(new T());
# The read enters the getter and gives its result, and no undefined beside it: a property with a getter and a setter runs the getter. The store enters the setter with the value. No listed call stands for either, so neither may take what the walks have left at calls for all that arrives.
# RUN: summary f0
# CHECK: member L0 Prototype 0 Getter "v" = Closure f2
# CHECK: member L0 Prototype 1 Setter "v" = Closure f3
# RUN(LINK): link functions fields members mechanisms=all
# LINK: function f2
# LINK-NOT: unreached
# LINK-NOT: one-callee
# LINK: parameter 0 {{*}}proven=L0
# LINK: function f3
# LINK-NOT: unreached
# LINK-NOT: one-callee
# LINK: parameter 0 {{*}}proven=L0
# LINK-NEXT: parameter 1 {{*}}proven=true
# LINK: function f4 callers-known one-callee {{*}}result=string
# LINK: field L0.0 "kept" proven=true writers-known
# LINK: member L0 Prototype 0 Getter "v" function=f2 writers-known
# LINK: member L0 Prototype 1 Setter "v" function=f3 writers-known

layout L0 kind=Instance name="T" module=m0 constructor=f1 fields=[{key="kept" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="v"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 methodKind=Setter index=1 key="v"
    v6 = FinishClass v1 layout=L0
    v7 = Construct v6
    v8 = NewClosure function=f4
    v9 = Call v8, -, v7 calleeName="use"
    v10 = Undefined
    Return v10
}
function f1 name="T" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="v" module=m0 kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="g"
    Return v1
}
function f3 name="v" module=m0 kind=Setter flags=[HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="kept"
    v3 = Undefined
    Return v3
}
function f4 name="use" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Boolean boolean=true
    PropSet v0, v1 key="v"
    v3 = PropGet v0 key="v"
    Return v3
}
