# CHECK: field L2.0 "x" proven=i32 writers-known
# CHECK: "y" proven=i32 writers-known written-at-construction-alone
# RUN(OLDER): link fields mechanisms=all
# OLDER-NOT: field L2.0 "x" {{*}}written-at-construction-alone
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 1 2
# ALL-NEXT: 1 1
# ALL-NEXT: exited with 0
# -- source: main.mjs
