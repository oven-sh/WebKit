# A test run that lays no name on Object.prototype and writes no member above the operands: each member that a row's questions pass by is taken for what the table lists, and the operands stay with compiled code, as in an executable
# "a".concat({ tag: "text" })      (1.25).toLocaleString("en-US", { tag: "text" })      const list = [1, 1]; "a".concat(list); list[0]
# OPTIONS: admit=ReplacedBuiltins
# RUN: link layouts mechanisms=all
# CHECK: layout L0 {{*}}stays-with-compiled-code
# CHECK: layout L1 {{*}}stays-with-compiled-code
# RUN(FIELDS): link fields mechanisms=all
# FIELDS: field L0.0 "tag" proven=string writers-known written-at-construction-alone filled
# FIELDS: field L1.0 "tag" proven=string writers-known written-at-construction-alone filled
# RUN(LIST): link accesses mechanisms=all
# LIST: read f0 v19 proven=undefined|int[0, 2147483647]
# LIST: receiver-as-made f0 v19

layout L0 module=m0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="text"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = String string="a"
    v4 = PropGet v3 key="concat"
    v5 = Call v4, v3, v2 calleeKey="concat"
    v6 = NewObject -, v0 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = Double number=1.25
    v9 = PropGet v8 key="toLocaleString"
    v10 = String string="en-US"
    v11 = Call v9, v8, v10, v7 calleeKey="toLocaleString"
    v12 = PropGet v2 key="tag"
    v13 = PropGet v7 key="tag"
    v14 = Integer integer=1
    v15 = NewArray v14, v14
    v16 = PropGet v3 key="concat"
    v17 = Call v16, v3, v15 calleeKey="concat"
    v18 = Integer
    v19 = ElemGet v15, v18
    Return v19
}
