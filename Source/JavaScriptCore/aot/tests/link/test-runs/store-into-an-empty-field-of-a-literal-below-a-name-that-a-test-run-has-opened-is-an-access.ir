# A test run has opened a name on Object.prototype, so an accessor may lie there: an assignment under the name to a literal that lacks it runs the setter, with the literal as `this`.
# The literal has left at that store: the store is an access, which Link resolves, and no edge into the field. Nobody knows who writes the other fields from then on
# function make(name) { const box = { name }; box.late = 1; box.last = 2; return box; }      Object.defineProperty(Object.prototype, "late", { set(value) { this.name = 7 } })
# store-into-an-empty-field-of-a-literal-below-another-name-that-a-test-run-has-opened-is-an-edge.ir is the twin: the same records, and the last line opens another name
# OPTIONS: admit=ReplacedBuiltins
# RUN: summary f1
# CHECK: access {{*}}Store Allocation L0 "late"
# RUN(EDGE): summary f1
# EDGE-NOT: -> Field L0.1 "late"
# RUN(LINK): link fields mechanisms=all
# LINK-NOT: field L0.0 "name" {{*}}writers-known

layout L0 module=m0 fields=[{key="name" declared={type=anything}}, {key="late" declared={type=anything}}, {key="last" declared={type=anything}}]
module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="text"
    v2 = Call v0, -, v1 calleeName="make"
    v3 = PropGet v2 key="name"
    Return v3
}
function f1 name="make" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Integer integer=1
    PropSet v1, v2 key="late"
    v4 = Integer integer=2
    PropSet v1, v4 key="last"
    Return v1
}
openedname holder=ObjectPrototype name="late"
