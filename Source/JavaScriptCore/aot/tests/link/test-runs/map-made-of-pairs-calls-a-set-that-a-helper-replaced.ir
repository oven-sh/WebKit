# the wire lists nothing, the flow brings Map.prototype to the store of a helper, and native code calls the replacement with the new map: so the rows of the construction are not taken at their word
# put(Map.prototype, () => 7); new Map(given)   with   put = (o, v) => { o.set = v }
# in the three orders of the worklist: in some the construction comes in front of the store, takes the member for a constant and is told again
# OPTIONS: admit=ReplacedBuiltins
# RUN: locks open mechanisms=all
# CHECK-NOT: locked MapPrototypeSet
# CHECK: open MapPrototypeSet written-under-its-name
# RUN(LIST): test-run
# LIST: replaces MapPrototypeSet
# RUN(OLDEST): test-run oldest-first
# OLDEST: replaces MapPrototypeSet
# RUN(SCATTERED): test-run scattered
# SCATTERED: replaces MapPrototypeSet

module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Map" [isFreeName]
    v2 = PropGet v0 key="given" [isFreeName]
    v3 = Construct v1, -, v2
    v4 = PropGet v1 key="prototype"
    v5 = NewClosure function=f1
    v6 = NewClosure function=f2
    v7 = Call v5, -, v4, v6
    Return v3
}
function f1 name="put" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="set"
    Return v1
}
function f2 name="fake" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
