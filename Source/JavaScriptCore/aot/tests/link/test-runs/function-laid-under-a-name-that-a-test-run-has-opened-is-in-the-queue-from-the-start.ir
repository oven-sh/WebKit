# A test run has opened `shut` on Object.prototype, so `Gate.prototype.shut = function () { .. }` may find a setter there: the flow lets the closure go to unseen code and keeps no record of the name.
# The table lists what the body writes all the same, the record of the class names it, and a run behind a test of the layout finds it by name. So it lies under its name for the queue as well:
# it is in the queue from the start, and the constructor leads to it. Without that the build stopped in UnitQueue: "the code of function 4, Body, mentions function 2, GenericCallEntry".
# function Gate(v) { this.count = v; this.parts = v; }      Gate.prototype.shut = function () { return this.count; };
# function take(gate) { return gate.count + gate.parts; }   function atEnd() { this.shut(); return take(this); }      sink({ handler: atEnd }); sink(new Gate(1));
# OPTIONS: admit=ReplacedBuiltins
# RUN: link functions members mechanisms=all
# CHECK: function f2 {{*}}in-queue-from-start
# CHECK: referrers f0, f1
# CHECK: on-prototype L0 "shut" expected=f2
# RUN(WALK): walk f3 mechanisms=all
# WALK-LABEL: code f3:Body
# WALK: AreMembersUnchanged conditions=[{layout=L0 key="shut"}]
# WALK: CallDirect {{*}}function=f2

module m0 path="gate.js" displayPath="gate.js" body=f0 namespaceLayout=L(m0)
