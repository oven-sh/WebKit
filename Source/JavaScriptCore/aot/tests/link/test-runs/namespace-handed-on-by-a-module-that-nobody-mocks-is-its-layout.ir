# the control of namespace-handed-on-by-a-mocked-module-is-anything.ir: in a test run without a mock the object that a module hands on is the object of that module, and what its names find is proven
# space.js: export const inner = "real inner"   lib.js: export * as space from "./space.js"   main.test.js: import * as ns from "./lib.js"; out = ns.space.inner
# OPTIONS: admit=ReplacedBuiltins
# RUN: link variables mechanisms=all
# CHECK: variable g1 proven={{*}}string
# RUN(NEVER): test-run
# NEVER-NOT: through-mock

module m0 path="/main.test.js" displayPath="main.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/lib.js" displayPath="lib.js" body=f1 requests=[{target=m2 completes=true}] exports=[{name="space" kind=Namespace module=m2}]
module m2 path="/space.js" displayPath="space.js" body=f2 exports=[{name="inner" variable=g0}]
entry module=m0
variable g0 name="inner" module=m2 declared={type=anything}
variable g1 name="out" module=m0 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="space"
    v2 = PropGet v1 key="inner"
    PutModuleVariable v2 variable=g1
    v4 = Undefined
    Return v4
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="real inner"
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
