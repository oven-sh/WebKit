# the flow brings Math to a store under a key that nobody can read: every member of Math that a test may replace stays open, used or not, and the image lists each
# tools.js: export const put = (o, k, v) => { o[k] = v }   a.test.js: put(Math, name, () => 7); Math.imul(given, given)
# nobody reads Math.max here. The run time's table locks it all the same, so it has to be listed too
# both files are the tests', so the build says nothing at the store: the run says what it has refused
# OPTIONS: admit=ReplacedBuiltins
# RUN: locks open
# CHECK: open MathImul holder-written-under-any-name
# RUN(UNUSED): locks open
# UNUSED: open MathMax holder-written-under-any-name
# RUN(LIST): test-run
# LIST: replaces MathImul
# RUN(LISTED): test-run
# LISTED: replaces MathMax

module m0 path="/a.test.js" displayPath="a.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/tools.js" displayPath="tools.js" body=f1
entry module=m0
variable g0 name="put" module=m1 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Math" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = NewClosure function=f3
    v4 = PropGet v0 key="name" [isFreeName]
    v5 = Call v2, -, v1, v4, v3
    v6 = PropGet v1 key="imul"
    v7 = PropGet v0 key="given" [isFreeName]
    v8 = Call v6, v1, v7, v7 calleeKey="imul"
    Return v8
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f2 name="put" module=m1 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    ElemSet v0, v1, v2
    Return v2
}
function f3 name="fake" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
