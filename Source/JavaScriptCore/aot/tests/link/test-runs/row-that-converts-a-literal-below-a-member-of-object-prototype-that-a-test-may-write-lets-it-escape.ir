# A row of native code converts its operand to a primitive. An object of one layout that answers to none of the names finds Object.prototype.toString, which is native code and hands the object to nobody:
# in an executable. A test run may write the member, and what lies there then gets the object as `this`: the layout escapes
# "a".concat({ tag: "text" })      (1.25).toLocaleString("en-US", { tag: "text" })      const list = [1, 1]; "a".concat(list); list[0]
# row-that-asks-an-operand-in-a-test-run-that-lays-and-writes-nothing-keeps-it.ir is the twin: the same records without the last line
# OPTIONS: admit=ReplacedBuiltins
# RUN: link layouts mechanisms=all
# CHECK-NOT: layout L0 {{*}}stays-with-compiled-code
# RUN(FIELDS): link fields mechanisms=all
# FIELDS-NOT: field L0.0 "tag" {{*}}writers-known

layout L0 module=m0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="text"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = String string="a"
    v4 = PropGet v3 key="concat"
    v5 = Call v4, v3, v2 calleeKey="concat"
    v6 = NewObject -, v0 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = Double number=1.25
    v9 = PropGet v8 key="toLocaleString"
    v10 = String string="en-US"
    v11 = Call v9, v8, v10, v7 calleeKey="toLocaleString"
    v12 = PropGet v2 key="tag"
    v13 = PropGet v7 key="tag"
    v14 = Integer integer=1
    v15 = NewArray v14, v14
    v16 = PropGet v3 key="concat"
    v17 = Call v16, v3, v15 calleeKey="concat"
    v18 = Integer
    v19 = ElemGet v15, v18
    Return v19
}
replaceablebuiltin member=ObjectPrototypeToString
