# Object.defineProperty(Object.prototype, "madeUp", { configurable: true, get() { return this.fround; } });      Math.madeUp;
# The run has opened `madeUp` on Object.prototype. `Math` does not list the name, so the lookup goes on above it and the accessor that the test laid there is handed `Math` as `this`:
# the object goes to unseen code, and what the accessor asks of its `this` by name is asked of `Math` too. In a whole test run the library hid that nothing let the object go:
# `Bun.madeUp`, whose getter reads `this.$`, ended the process with "Bun.$ was left out of the executable" as soon as fewer functions of the library were reached.
# OPTIONS: admit=ReplacedBuiltins
# RUN: link lookups mechanisms=all
# CHECK: lookup name-read "fround"
# CHECK: lookup let-go Math
# CHECK: lookup at-unseen Math

module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
layout L0 module=m0 position=60 fields=[{key="configurable" declared={type=anything} flags=[IsRequired]}, {key="get" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ObjectDefineProperty @10
    v1 = Builtin builtin=Object @10
    v2 = Builtin builtin=ObjectPrototype @20
    v3 = String string="madeUp" @30
    v4 = Boolean boolean=true @40
    v5 = NewClosure function=f1 @50
    v6 = NewObject -, v4, v5 layout=L0 fields=[0, 1] @60
    v7 = FinishObject v6 @60
    v8 = Call v0, v1, v2, v3, v7 calleeName="Object.defineProperty" @70
    v9 = Builtin builtin=GlobalThis @80
    v10 = PropGet v9 key="Math" [isFreeName] @80
    v11 = PropGet v10 key="madeUp" @90
    Return v11 @100
}
function f1 name="get" module=m0 position=50 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="fround" @55
    Return v1 @56
}
openedname holder=ObjectPrototype name="madeUp"
