# function merge(s) { return Object.assign({}, s); }  merge({ x: 1 });      Object.defineProperty(Object.prototype, "x", { set(value) { this.kept = value } })
# The call assigns, and an assignment finds a setter that lies above the target. In an executable Object.prototype has one, under `__proto__`. A test run has opened `x` there: the setter gets the target as `this`
# assignment-of-listed-keys-into-a-record-lays-what-a-definition-lays.ir is the twin: the same records in an executable
# OPTIONS: admit=ReplacedBuiltins
# RUN: link fields layouts mechanisms=all
# CHECK-NOT: field L1.0 "x"{{*}} writers-known
# CHECK-NOT: layout L1 {{*}}stays-with-compiled-code

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything}}]
module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2 calleeName="merge"
    v5 = Undefined
    Return v5
}
function f1 name="merge" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectAssign
    v3 = NewObject layout=L1
    v4 = FinishObject v3
    v5 = Call v2, v1, v4, v0 calleeName="Object.assign"
    Return v5
}
openedname holder=ObjectPrototype name="x"
