# a file that an executable holds too stores under the name of a method, through a value in which two built-in objects have met
# an executable locks the method whatever the program does, so the test run does, and the run time refuses the store as it does there
# src/patch.js, of the product: same(Math); same(JSON).imul = () => 7   a.test.js: import "./src/patch.js"; Math.imul(given, given)
# OPTIONS: admit=ReplacedBuiltins
# RUN: locks open
# CHECK: locked MathImul constant
# RUN(REPLACED): test-run
# REPLACED-NOT: replaces MathImul

module m0 path="/a.test.js" displayPath="a.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/src/patch.js" displayPath="src/patch.js" flags=[HasReadOnlyBuiltins] body=f3
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="given" [isFreeName]
    v2 = PropGet v0 key="Math" [isFreeName]
    v3 = PropGet v2 key="imul"
    v4 = Call v3, v2, v1, v1 calleeKey="imul"
    Return v4
}
function f1 name="same" module=m1 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="patched" module=m1 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
function f3 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="JSON" [isFreeName]
    v2 = PropGet v0 key="Math" [isFreeName]
    v3 = NewClosure function=f1
    v4 = Call v3, -, v2
    v5 = Call v3, -, v1
    v6 = NewClosure function=f2
    PropSet v5, v6 key="imul"
    Return v6
}
