# in a test run the locks are laid by the program. No file spells Math.imul beside a store: the flow brings Math to the store of a helper in another file, so the member stays open and the image lists it
# tools.js: export const put = (o, v) => { o.imul = v }   a.test.js: import { put } from "./tools.js"; put(Math, () => 7); Math.imul(2, 2)
# the table locks Math.imul, and the wire lists nothing
# OPTIONS: admit=ReplacedBuiltins
# RUN: locks open
# CHECK-NOT: locked MathImul
# CHECK: open MathImul written-under-its-name
# RUN(LIST): test-run
# LIST: replaces MathImul
# RUN(WALK): walk f0 mechanisms=all
# WALK-LABEL: code f0:Body
# WALK: key="imul"

module m0 path="/a.test.js" displayPath="a.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/tools.js" displayPath="tools.js" body=f1
entry module=m0
variable g0 name="put" module=m1 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Math" [isFreeName]
    v2 = GetModuleVariable variable=g0
    v3 = NewClosure function=f3
    v4 = Call v2, -, v1, v3
    v5 = PropGet v1 key="imul"
    v6 = PropGet v0 key="given" [isFreeName]
    v7 = Call v5, v1, v6, v6 calleeKey="imul"
    Return v7
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f2 name="put" module=m1 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="imul"
    Return v1
}
function f3 name="fake" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
