# a mock of a CommonJS file stands in place of the file, and importers see the file through its facade: so the facade may be mocked where the file has the flag
# file.cjs, which a test mocks: module.exports = { one: 1 }   lib.js: export * as cjs from "./file.cjs"   main.test.js: import * as ns from "./lib.js"; held = ns.cjs
# the object that lib.js hands on is that of the facade, which has no flag of its own
# OPTIONS: admit=ReplacedBuiltins
# RUN: test-run
# CHECK: through-mock m3 "cjs"

layout L0 module=m1 fields=[{key="one" declared={type=anything} flags=[IsRequired]}]
module m0 path="/main.test.js" displayPath="main.test.js" body=f0 requests=[{target=m3 completes=true}]
module m1 path="/file.cjs" displayPath="file.cjs" kind=CommonJs flags=[CachesEvaluationError, MayBeMocked] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g0
module m2 path="#2" displayPath="file.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f2 requests=[{target=m1 kind=Require completes=true}] syntheticExports=[{name="one" variable=g1}]
module m3 path="/lib.js" displayPath="lib.js" body=f3 requests=[{target=m2 completes=true}] exports=[{name="cjs" kind=Namespace module=m2}]
entry module=m0
variable g0 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="one" module=m2 declared={type=anything|absent}
variable g2 name="held" module=m0 declared={type=anything}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = ModuleNamespace module=m3
    v1 = PropGet v0 key="cjs"
    PutModuleVariable v1 variable=g2
    Return
}
function f1 name="file" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject layout=L0
    PropDefine v1, v0 key="one"
    v3 = FinishObject v1
    PutModuleVariable v3 variable=g0
    Return
}
function f2 name="facadeOfFile" module=m1 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m2 [isBare]
    Return
}
function f3 name="lib" module=m3 kind=Module results=[{type=anything}] {
    Return
}
