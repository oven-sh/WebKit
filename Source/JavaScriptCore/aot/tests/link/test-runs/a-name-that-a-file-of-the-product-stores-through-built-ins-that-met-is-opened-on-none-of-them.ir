# as lookup-is-told-again-of-a-name-added-through-built-ins-that-met.ir, where the store stands in a file of the product
# a file of the product adds what an executable lets it add: the name is opened on none of the objects, the run time refuses the store as an executable does, and nobody who went by a lookup under the name has to be told
# src/mark.js, of the product: same(Math); same(Function.prototype).marked = true   a.test.js: import "./src/mark.js"; marked.marked; other.other
# OPTIONS: admit=ReplacedBuiltins
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known
# CHECK: function f3 callers-known
# RUN(OLDEST): link functions oldest-first mechanisms=all
# OLDEST: function f2 callers-known
# OLDEST: function f3 callers-known
# RUN(ADDS): test-run
# ADDS-NOT: adds FunctionPrototype "marked"

module m0 path="/a.test.js" displayPath="a.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/src/mark.js" displayPath="src/mark.js" flags=[HasReadOnlyBuiltins] body=f4
variable g0 name="kept0" module=m1 declared={type=anything} initialization=Undefined
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = PropGet v0 key="marked"
    v2 = Call v0, -
    v3 = NewClosure function=f3
    v4 = PropGet v3 key="other"
    v5 = Call v3, -
    Return v5
}
function f1 name="same" module=m1 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g0
    Return v2
}
function f2 name="marked" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="other" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
function f4 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Function" [isFreeName]
    v2 = PropGet v1 key="prototype"
    v3 = PropGet v0 key="Math" [isFreeName]
    v4 = NewClosure function=f1
    v5 = Call v4, -, v3
    v6 = Call v4, -, v2
    v7 = Boolean boolean=true
    PropSet v6, v7 key="marked"
    Return v7
}
