# A test run has opened a name on Object.prototype. Under every other name nothing lies above a literal, so an assignment that fills an empty field of a literal which nothing but the body has yet is an edge, as in an executable
# function make(name) { const box = { name }; box.late = 1; box.last = 2; return box; }      Object.defineProperty(Object.prototype, "early", { set(value) { this.name = 7 } })
# store-into-an-empty-field-of-a-literal-below-a-name-that-a-test-run-has-opened-is-an-access.ir is the twin
# OPTIONS: admit=ReplacedBuiltins
# RUN: summary f1
# CHECK: edge Constant {{*}} -> Field L0.1 "late"
# RUN(ACCESS): summary f1
# ACCESS-NOT: access
# RUN(LINK): link fields mechanisms=all
# LINK: field L0.0 "name" proven=string writers-known written-at-construction-alone filled
# LINK: field L0.1 "late" proven=int[0, 2147483647]

layout L0 module=m0 fields=[{key="name" declared={type=anything}}, {key="late" declared={type=anything}}, {key="last" declared={type=anything}}]
module m0 path="/a.test.js" displayPath="a.test.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="text"
    v2 = Call v0, -, v1 calleeName="make"
    v3 = PropGet v2 key="name"
    Return v3
}
function f1 name="make" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = Integer integer=1
    PropSet v1, v2 key="late"
    v4 = Integer integer=2
    PropSet v1, v4 key="last"
    Return v1
}
openedname holder=ObjectPrototype name="early"
