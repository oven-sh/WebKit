# no name leads from the global object to %TypedArray%, so the program can lay no lock of its own there. The table's lock holds at run time unless the image opens the member, and the flow follows the object to the store
# tools.js: export const put = (o, k, v) => { o[k] = v }   a.test.js: put(Object.getPrototypeOf(Uint8Array).prototype, name, f)
# what Object.getPrototypeOf() answers stands beside what nobody knows, so the type stops naming the object: it is one of the built-ins that are lost in sight
# OPTIONS: admit=ReplacedBuiltins
# RUN: locks open
# CHECK: open TypedArrayPrototype{{*}} written-through-lost-built-ins
# RUN(LIST): test-run
# LIST: replaces TypedArrayPrototype

module m0 path="/a.test.js" displayPath="a.test.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="/tools.js" displayPath="tools.js" body=f1 exports=[{name="put" variable=g0}]
entry module=m0
variable g0 name="put" module=m1 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Object" [isFreeName]
    v2 = PropGet v1 key="getPrototypeOf"
    v3 = PropGet v0 key="Uint8Array" [isFreeName]
    v4 = Call v2, v1, v3 calleeKey="getPrototypeOf"
    v5 = PropGet v4 key="prototype"
    v6 = GetModuleVariable variable=g0
    v7 = NewClosure function=f3
    v8 = PropGet v0 key="name" [isFreeName]
    v9 = Call v6, -, v5, v8, v7
    Return v9
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f2 name="put" module=m1 length=3 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    ElemSet v0, v1, v2
    Return v2
}
function f3 name="fake" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    Return v0
}
