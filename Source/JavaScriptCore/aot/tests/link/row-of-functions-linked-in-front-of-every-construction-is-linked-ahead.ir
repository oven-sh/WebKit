# -- source: row-of-functions-linked-in-front-of-every-construction-is-linked-ahead.js
# function Base(a) { this.a = a; }
# Base.prototype.first = function () { return this.a; };
# function Created(a) { Base.call(this, a); }
# Created.prototype = Object.create(Base.prototype);
# Created.prototype.second = function () { return this.first(); };
# function Linked(a) { Base.call(this, a); }
# Object.setPrototypeOf(Linked.prototype, Base.prototype);
# function Late(a) { Base.call(this, a); }
# function useLate() { return typeof new Late(1).first; }
# sink(useLate());
# Object.setPrototypeOf(Late.prototype, Base.prototype);
# function Kept(a) { Base.call(this, a); }
# const old = Kept.prototype;
# Kept.prototype = Object.create(Base.prototype);
# old.second = function () { return 1; };
# function Maybe(a) { Base.call(this, a); }
# if (globalThis.no) Maybe.prototype = Object.create(Base.prototype);
# sink(new Created(1).second() + new Linked(1).first() + useLate() + typeof new Kept(1).second + typeof new Maybe(1).first);
# -- end of source
# If a row of constructor functions counted as linked from the start, `useLate()` above the link would find what Base has laid.
# `Created.prototype = Object.create(Base.prototype)` and `Object.setPrototypeOf(Linked.prototype, Base.prototype)` in a block of the body of the module that every way passes, in front of whatever enters the function:
# every object of it stands below one prototype object, which stands below Base's.
# RUN: link layouts mechanisms=all
# CHECK: layout L0 {{*}}prototype-object-settled
# CHECK: layout L1 {{*}}prototype-object-settled linked-ahead
# CHECK: layout L2 {{*}}prototype-object-settled linked-ahead
# Entered above the link . the object that the function was made with is read in front of the store, so somebody may have it . stored under a condition.
# RUN(NOT): link layouts mechanisms=all
# NOT-NOT: layout L3 {{*}}linked-ahead
# NOT-NOT: layout L4 {{*}}prototype-object-settled
# NOT-NOT: layout L5 {{*}}prototype-object-settled

