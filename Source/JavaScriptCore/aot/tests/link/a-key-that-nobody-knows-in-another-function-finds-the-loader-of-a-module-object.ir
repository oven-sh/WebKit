# function take(holder, name) { return holder[name]; }  sink(take(require.main, name));
# The module object leaves the body that read it. Another body reads it under a key that nobody knows, and that key may be "require".
# OPTIONS: exclude=CodeOutsideImage
# RUN: causes mechanisms=all
# CHECK: cause LoadsModuleByName ModuleRequire

module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs body=f0
entry module=m0
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = PropGet v0 key="name" [isFreeName]
    v3 = NewClosure function=f1
    v4 = ModuleBuiltin builtin=ModuleRequire module=m0
    v5 = PropGet v4 key="main"
    v6 = Call v3, -, v5, v2 calleeName="take"
    v7 = Call v1, -, v6
    v8 = Undefined
    Return v8
}
function f1 name="take" module=m0 length=2 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
