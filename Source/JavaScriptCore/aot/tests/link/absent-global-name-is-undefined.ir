# Nobody stores the name on the global object or above it. The free name is undefined, so its call hands the closure to nobody.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="define" [isFreeName, isForTypeOf]
    v3 = TypeTest v2 testedType=function
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="define" [isFreeName]
    v7 = Call v6, -, v0 calleeName="define"
    Jump -> next b2()
  b2():
    v8 = Integer integer=1
    v9 = Call v0, -, v8 calleeName="factory"
    Return
}
function f1 name="factory" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
