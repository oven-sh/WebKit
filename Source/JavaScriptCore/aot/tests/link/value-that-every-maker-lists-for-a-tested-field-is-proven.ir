# type Shape = { kind: "circle", r } | { kind: "square", s } | { kind: 1 } | { kind: true }   function area(x) { if (x.kind === "circle") return x.r; return 0; }
# Link's flow knows kinds of primitives alone. Of a field under a name by which some body tells holders apart, it is read off the edges which text, integer or boolean the makers list: where all list one and nothing is stored there by name, that is proven.
# RUN: link fields mechanisms=all
# CHECK: field L0.0 "kind" proven="circle" writers-known written-at-construction-alone filled
# CHECK: field L1.0 "kind" proven="square" writers-known written-at-construction-alone filled
# CHECK: field L2.0 "kind" proven=1 writers-known written-at-construction-alone filled
# CHECK: field L3.0 "kind" proven=true writers-known written-at-construction-alone filled
# Two makers that list two texts, a maker that lists what it was handed, and a store by name: the kind of value is all that is proven.
# CHECK: field L4.0 "kind" proven=string writers-known written-at-construction-alone filled
# CHECK: field L5.0 "kind" proven=string writers-known written-at-construction-alone filled
# CHECK: field L6.0 "kind" proven=string writers-known filled
# Nobody tells holders apart by `r`.
# RUN(OTHER): link fields mechanisms=all
# OTHER: field L0.1 "r" proven=2 writers-known written-at-construction-alone filled

layout L0 name="Circle" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}, {key="r" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Square" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flags=[IsRequired]}]
layout L2 name="One" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
layout L3 name="True" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
layout L4 name="TwoTexts" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
layout L5 name="Handed" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
layout L6 name="Stored" module=m0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
data d0 root=Object{layout=L1 members=[{key="kind" value=String{value="square"}}, {key="s" value=Number{value=3}}]} module=m0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="circle"
    v2 = Integer integer=2
    v3 = NewObject -, v1, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    v5 = Data data=d0
    v6 = Integer integer=1
    v7 = NewObject -, v6 layout=L2 fields=[0]
    v8 = FinishObject v7
    v9 = Boolean boolean=true
    v10 = NewObject -, v9 layout=L3 fields=[0]
    v11 = FinishObject v10
    v12 = NewObject -, v1 layout=L4 fields=[0]
    v13 = FinishObject v12
    v14 = String string="square"
    v15 = NewObject -, v14 layout=L4 fields=[0]
    v16 = FinishObject v15
    v17 = NewClosure function=f2
    v18 = Call v17, -, v1
    v19 = NewObject -, v1 layout=L6 fields=[0]
    v20 = FinishObject v19
    v21 = NewClosure function=f3
    v22 = Call v21, -, v20
    v23 = Call v0, -, v4
    v24 = Call v0, -, v5
    v25 = Call v0, -, v8
    v26 = Call v0, -, v11
    v27 = Call v0, -, v13
    v28 = Call v0, -, v16
    v29 = Call v0, -, v18
    v30 = Call v0, -, v20
    Return v30
}
function f1 name="area" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="kind"
    v2 = String string="circle"
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    v6 = PropGet v5 key="r"
    Return v6
  b2(v7):
    v8 = Integer integer=0
    Return v8
}
function f2 name="make" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject -, v0 layout=L5 fields=[0]
    v2 = FinishObject v1
    Return v2
}
function f3 name="change" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="circle"
    PropSet v0, v1 key="kind"
    Return v0
}
