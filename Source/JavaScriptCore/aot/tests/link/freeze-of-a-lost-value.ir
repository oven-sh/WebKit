    v10 = FinishObject v9
    v11 = NewObject -, v0 layout=L5 fields=[0]
    v12 = FinishObject v11
    v13 = NewObject -, v0 layout=L6 fields=[0]
    v14 = FinishObject v13
    v15 = NewClosure function=f1
    v16 = Call v15, -, v2 calleeName="ice"
    v17 = Call v15, -, v4 calleeName="ice"
    v18 = Call v15, -, v10 calleeName="ice"
    v19 = Call v15, -, v12 calleeName="ice"
    v20 = Call v15, -, v14 calleeName="ice"
    v21 = NewClosure function=f2
    v22 = Call v21, -, v4 calleeName="look"
    v23 = Call v21, -, v6 calleeName="look"
    v24 = Call v21, -, v10 calleeName="look"
    v25 = Call v21, -, v12 calleeName="look"
    v26 = Call v21, -, v14 calleeName="look"
    v27 = NewClosure function=f3
    v28 = Call v27, -, v8 calleeName="alone"
    v29 = Undefined
    Return v29
}
