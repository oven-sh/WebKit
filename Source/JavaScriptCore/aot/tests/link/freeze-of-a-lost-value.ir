# If a freeze through a lost value marked only the layouts that were lost when the freeze was looked at, a layout that joins later would count as never frozen, and a store to it would be compiled as a plain write of the slot
# function ice(o) { Object.freeze(o); }  function look(o) { }  function alone(o) { }  const a = { a: "s" }, b = { b: "s" }, c = { c: "s" }, d = { d: "s" }, e = { e: "s" }, f = { f: "s" }, g = { g: "s" };  ice(a); ice(b); ice(e); ice(f); ice(g);  look(b); look(c); look(e); look(f); look(g);  alone(d);
# At `ice` five layouts meet, one more than a set takes, and are lost. A sixth is lost elsewhere, at `look`, where it meets four of them. A lost value is an object of some member, so the freeze counts for all six, in whichever order the worklist comes to them: the type at `ice` does not climb again when a member joins. What is not lost is not touched.
# RUN: link fields layouts mechanisms=all
# CHECK: field L0.0 "a" proven=string writers-known
# CHECK: field L1.0 "b" proven=string writers-known
# CHECK: field L2.0 "c" proven=string writers-known
# CHECK: field L3.0 "d" proven=string writers-known
# CHECK: field L4.0 "e" proven=string writers-known
# CHECK: field L5.0 "f" proven=string writers-known
# CHECK: field L6.0 "g" proven=string writers-known
# CHECK: layout L0 {{*}}changes=[IsFrozen]
# CHECK: layout L1 {{*}}changes=[IsFrozen]
# CHECK: layout L2 {{*}}changes=[IsFrozen]
# CHECK: layout L3 {{*}}changes=[]
# CHECK: layout L4 {{*}}changes=[IsFrozen]
# CHECK: layout L5 {{*}}changes=[IsFrozen]
# CHECK: layout L6 {{*}}changes=[IsFrozen]
# RUN(LOST): link functions mechanisms=all
# LOST: function f1 callers-known one-callee
# LOST-NEXT: parameter 0 {{*}}proven=L0|L1|L2|L4|L5|L6
# LOST: function f2 callers-known one-callee
# LOST-NEXT: parameter 0 {{*}}proven=L0|L1|L2|L4|L5|L6
# LOST: function f3 callers-known one-callee
# LOST-NEXT: parameter 0 {{*}}proven=L3

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="b" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="c" declared={type=anything} flags=[IsRequired]}]
layout L3 module=m0 fields=[{key="d" declared={type=anything} flags=[IsRequired]}]
layout L4 module=m0 fields=[{key="e" declared={type=anything} flags=[IsRequired]}]
layout L5 module=m0 fields=[{key="f" declared={type=anything} flags=[IsRequired]}]
layout L6 module=m0 fields=[{key="g" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="s"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v0 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v0 layout=L2 fields=[0]
    v6 = FinishObject v5
    v7 = NewObject -, v0 layout=L3 fields=[0]
    v8 = FinishObject v7
