# If the elements of `[[o]].flat()` were taken for the elements of the outer list, what is read out of the result would be proven a list while it is the object.
# function first(list) { return list.flat()[0]; }  first([[{ x: 1 }]]);
# The row says that whatever can be reached from the list is stored into the result, and its record names only what the list itself holds. So the list escapes with all that it leads to, and the result holds anything.
# RUN: link functions layouts mechanisms=all
# CHECK: function f1 callers-known
# CHECK-NOT: result=
# CHECK: parameter 0
# CHECK: layout L0 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewArray v2 contents=anything
    v4 = NewArray v3 contents=anything
    v5 = NewClosure function=f1
    v6 = Call v5, -, v4 calleeName="first"
    v7 = Undefined
    Return v7
}
function f1 name="first" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="flat"
    v2 = Call v1, v0 calleeKey="flat"
    v3 = Integer
    v4 = ElemGet v2, v3
    Return v4
}
