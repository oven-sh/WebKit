    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    PropSet v1, v3 key="tag"
    v5 = Call v0, -, v1 calleeName="take"
    v6 = Call v0, -, v2 calleeName="take"
    v7 = Undefined
    Return v7
}
