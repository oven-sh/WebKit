# export const copy = { map: Array.prototype.map, run(x) { return x; } };
# No code in the program reads the export, and the host does not look for its name. The built-in inside the object is still compiled.
# Nothing else escapes: the object keeps its known writers, and the function that nobody calls is not compiled.
# OPTIONS: exclude=CodeOutsideImage
# LIBRARY: own
# RUN: link functions variables mechanisms=all
# CHECK: function f1 unreached
# CHECK-NOT: function f2 unreached
# CHECK: function f3 unreached
# CHECK: variable g0 proven=L0 writers-known

layout L0 module=m0 fields=[{key="map" declared={type=anything} flags=[IsRequired]}, {key="run" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="copy" module=m0 declared={type=anything} initialization=Uninitialized
module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="copy" variable=g0}]
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app", "stop"]}, {exportName="then"}]
runtimefunction id=ArrayPrototypeFilter function=f3
runtimefunction id=ArrayPrototypeMap function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ArrayPrototypeMap
    v1 = NewClosure function=f1
    v2 = NewObject -, v0, v1 layout=L0 fields=[0, 1]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g0
    v5 = Undefined
    Return v5
}
function f1 name="run" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="map" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f3 name="filter" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeFilter thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
