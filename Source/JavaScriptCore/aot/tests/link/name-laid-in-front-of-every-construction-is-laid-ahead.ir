# -- source: name-laid-in-front-of-every-construction-is-laid-ahead.ts
# declare function report(value: unknown): void;
# function First(this: any, x: number) { this.x = x; }
# First.prototype.m = function (this: any) { return this.x + 1; };
# function Early(this: any, x: number) { this.x = x; }
# function useEarly() { return typeof new (Early as any)(1).m; }
# report(useEarly());
# Early.prototype.m = function (this: any) { return this.x + 2; };
# function Maybe(this: any, x: number) { this.x = x; }
# if ((globalThis as any).no) Maybe.prototype.m = function (this: any) { return this.x + 3; };
# function Twice(this: any, x: number) { this.x = x; }
# Twice.prototype.m = function (this: any) { return this.x + 4; };
# Twice.prototype.m = function (this: any) { return this.x + 5; };
# function Swapped(this: any, x: number) { this.x = x; }
# Swapped.prototype.m = function (this: any) { return this.x + 6; };
# (Swapped as any).prototype = 5;
# function Tagged(this: any, x: number) { this.x = x; }
# Tagged.prototype.m = function (this: any) { return this.x + 7; };
# function tag(o: any) { o.m = 1; return o; }
# report(new (First as any)(1).m() + typeof new (Maybe as any)(1).m + new (Twice as any)(1).m() + typeof new (Swapped as any)(1).m + useEarly() + typeof tag(new (Tagged as any)(1)).m);
# -- end of source
# If a method that is stored on the prototype object of a constructor function counted as laid from the start, `useEarly()` above the store would call what is not there yet.
# The body of the module lays First's m in a block that every way passes, in front of whatever enters First: every object of First finds it, as it finds a method of a class.
# SINCE 11-04 (R257) THE CLOCK OF START SAYS OF NO NAME THAT IT IS LAID AHEAD: through a hole in it the read of such a name gave undefined where the type said a function, and the process died; the claim fired on no program that we are judged by. What this test told apart by `laid-ahead` it no longer tells.
# RUN: link members mechanisms=all
# CHECK: on-prototype L0 "m" function=f{{*}}
# Entered above the store . laid under a condition . two functions arrive . `prototype` is stored . an object gets the name for itself.
# RUN(NOT): link members mechanisms=all
# NOT-NOT: on-prototype L1 {{*}}laid-ahead
# NOT-NOT: on-prototype L2 {{*}}laid-ahead
# NOT-NOT: on-prototype L3 {{*}}laid-ahead
# NOT-NOT: on-prototype L4 {{*}}laid-ahead
# NOT-NOT: on-prototype L5 {{*}}laid-ahead

