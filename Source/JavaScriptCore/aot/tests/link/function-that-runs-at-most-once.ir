# in one realm a function runs at most once where it is the body of a module that the loader enters once, or where one call alone may enter it, outside of loops, in a function of which the same holds
# function once() { return below() }  function below() { return 1 }  function twice() {}  function looped() {}  function ring(n) { return n ? ring(n - 1) : 0 }
# function under() {}  function handedOut() {}
# once(); twice(); twice(); ring(3); handedOut(); sink(handedOut); do {} while (looped())   and looped() calls under()
