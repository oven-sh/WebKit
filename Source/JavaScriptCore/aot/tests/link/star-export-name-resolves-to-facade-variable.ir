# main.mjs: import * as all from "./barrel.mjs"; all.helper(handed) . barrel.mjs: export * from "./lib.cjs" . lib.cjs: exports.helper = ..; exports.spare = ..
# The front end lists on the facade of the file every name that the text asks through the barrel. The namespace of the barrel does not list `helper`; its star goes onto that facade, so the read gives what the facade's variable holds.
# The star binds like an import: the exports of the file stay in sight, and `spare`, which nobody asks for, is reached by nobody.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK: function f3 unreached

layout L0 module=m0 fields=[{key="helper" declared={type=anything}}, {key="spare" declared={type=anything}}] ownFieldCount=2
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="helper" module=m1 declared={type=anything|absent}
module m0 path="/lib.cjs" displayPath="lib.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
module m1 path="#1" displayPath="lib.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f1 requests=[{target=m0 kind=Require completes=true}] syntheticExports=[{name="helper" variable=g1 isKnownMember=true}]
module m2 path="/barrel.mjs" displayPath="barrel.mjs" flags=[CachesEvaluationError, IsImportedAsNamespace] body=f4 requests=[{target=m1 isDynamicStarExport=true completes=true}]
module m3 path="/main.mjs" displayPath="main.mjs" flags=[CachesEvaluationError] body=f5 requests=[{target=m1 completes=true isHoisted=true}, {target=m2 completes=true}]
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
