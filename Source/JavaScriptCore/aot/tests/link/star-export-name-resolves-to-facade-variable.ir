  b0():
    v0 = Undefined
    Return v0
}
function f5 module=m3 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f6
    v1 = Convert v0 declared={type=f6 flags=[IsFromCompiler]}
    v2 = NewClosure function=f7
    v3 = Convert v2 declared={type=f7 flags=[IsFromCompiler]}
    v4 = GetModuleVariable variable=g1
    v5 = CheckInitialized v4 name="helper"
    v6 = ModuleNamespace module=m2
    v7 = Call v5, v6, v1 calleeName="all.helper"
    v8 = Undefined
    Return v8
}
