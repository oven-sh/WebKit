    v1 = FinishObject v0
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g0
    v4 = Convert v3 declared={type=L0 flags=[IsExpected]}
    v5 = NewClosure function=f2
    PropSet v4, v5 key="helper" mode=Sloppy
    v7 = GetModuleVariable variable=g0
    v8 = Convert v7 declared={type=L0 flags=[IsExpected]}
    v9 = NewClosure function=f3
    PropSet v8, v9 key="spare" mode=Sloppy
    v11 = Undefined
    Return v11
}
function f1 module=m0 kind=Module flags=[IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m0 referrer=m1 [isBare]
    v1 = Undefined
    Return v1
}
function f2 name="helper" module=m0 sourceRange={start=17 end=59} flags=[IsSloppy, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|function flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: undefined|null|function):
    v1 = Call v0 calleeName="given"
    Return v1
}
function f3 name="spare" module=m0 sourceRange={start=77 end=107} flags=[IsSloppy, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=3
    Return v0
}
