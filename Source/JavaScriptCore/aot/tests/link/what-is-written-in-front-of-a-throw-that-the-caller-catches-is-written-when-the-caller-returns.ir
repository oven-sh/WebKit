# fail() writes only on its way to a throw, so it has written nothing when it returns. guard() catches what fail() throws and returns, so guard() has written the field when it returns. pass() has no handler: where fail() throws, pass() does not return
# function fail(o) { o.bad = 1; throw 1; }   function guard(o) { try { fail(o); } catch { } }   function pass(o) { fail(o); }
# f1 = fail, f2 = guard, f3 = pass
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}throws=[{{*}}] fields-written=1
# CHECK: function f2 {{*}}fields-written-on-return=1 fields-written=1
# CHECK: function f3 {{*}}throws=[{{*}}] fields-written=1
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}fields-written-on-return
# NEVER-NOT: function f3 {{*}}fields-written-on-return

layout L0 module=m0 fields=[{key="bad" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f2
    v4 = Call v3, -, v2
    v5 = NewClosure function=f3
    v6 = Call v5, -, v2
    Return v6
}
function f1 name="fail" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="bad"
    Throw v1
}
function f2 name="guard" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    Jump -> next b1()
  b1() handler=b2():
    v2 = Call v1, -, v0
    Jump -> next b3()
  b2() role=CatchHandler:
    v3 = CatchValue
    Jump -> next b3()
  b3():
    v4 = Undefined
    Return v4
}
function f3 name="pass" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0
    Return v2
}
