    v1 = Integer integer=1
    Return v1
}
function f5 name="lay" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Null
    PropSet v0, v1 key="x"
    v3 = Undefined
