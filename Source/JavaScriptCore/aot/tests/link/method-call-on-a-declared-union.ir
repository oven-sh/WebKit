# If the two classes of a declared union were forgotten where they meet, the call would enter every method of that name in the program and its receiver would be any object. If one of the two were forgotten, its method would be left out of the executable
# class Circle { area() { return "c"; } }  class Square { area() { return true; } }  class Other { area() { return null; } }
# function ask(s: Circle | Square) { return s.area(); }  ask(new Circle()); ask(new Square()); new Other();
# The union is a family, so neither class is lost. `Other` has a method of the same name, is no member, and never arrives: nothing enters its method.
# RUN: link families functions layouts mechanisms=all
# CHECK: family [[shape]] [L0, L1]
# CHECK: function f2 callers-known
# CHECK: function f4 callers-known
# CHECK: function f6 unreached
# CHECK: function f7 callers-known one-callee {{*}}result=true|string
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1
# CHECK: layout L0 family=[[shape]] changes=[]
# CHECK: layout L1 family=[[shape]] changes=[]
# CHECK: layout L2 changes=[]
# RUN(CALLS): link calls mechanisms=all
# CALLS-NOT: call f7 v2

layout L0 kind=Instance name="Circle" module=m0 constructor=f1
layout L1 kind=Instance name="Square" module=m0 constructor=f3
layout L2 kind=Instance name="Other" module=m0 constructor=f5
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="area"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f3
    v6 = NewClass v5 layout=L1
    v7 = NewClosure function=f4
    DefineMethod v6, v7 layout=L1 key="area"
    v9 = FinishClass v6 layout=L1
    v10 = NewClosure function=f5
    v11 = NewClass v10 layout=L2
    v12 = NewClosure function=f6
    DefineMethod v11, v12 layout=L2 key="area"
    v14 = FinishClass v11 layout=L2
    v15 = Construct v4
    v16 = Construct v9
    v17 = Construct v14
    v18 = NewClosure function=f7
    v19 = Call v18, -, v15 calleeName="ask"
    v20 = Call v18, -, v16 calleeName="ask"
    v21 = Undefined
    Return v21
}
function f1 name="Circle" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="area" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="c"
    Return v0
}
function f3 name="Square" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f4 name="area" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f5 name="Other" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f6 name="area" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Null
    Return v0
}
function f7 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1):
    v1 = PropGet v0 key="area"
    v2 = Call v1, v0 calleeKey="area"
    Return v2
}
