# main.mjs, the entry: export * from "./lib.cjs"; import "./other.mjs"; await 0 . other.mjs: import { helper } from "./main.mjs"; helper()
# Who else asks the entry is no question where the entry awaits either: the host's look at `then` is a read off the file's exports.
# The control: entry-with-a-star-that-another-module-imports-hands-the-host-nothing-all-the-same.ir.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK: function f3 unreached
# CHECK: lookup entry-hands-host-nothing 0

layout L0 module=m0 fields=[{key="helper" declared={type=anything}}, {key="fetch" declared={type=anything}}] ownFieldCount=2
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="helper" module=m1 declared={type=anything|absent}
module m0 path="/lib.cjs" displayPath="lib.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
module m1 path="#1" displayPath="lib.cjs" exportRule=CommonJs body=f1 requests=[{target=m0 kind=Require completes=true}] syntheticExports=[{name="helper" variable=g1}]
module m2 path="/other.mjs" displayPath="other.mjs" body=f4 requests=[{target=m3 completes=true}]
module m3 path="/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait] body=f5 requests=[{target=m1 completes=true isHoisted=true}, {target=m1 isDynamicStarExport=true completes=true}, {target=m2 completes=true}]
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = FinishObject v0
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g0
    v4 = Convert v3 declared={type=L0 flags=[IsExpected]}
    v5 = NewClosure function=f2
    PropSet v4, v5 key="helper" mode=Sloppy
    v7 = GetModuleVariable variable=g0
    v8 = Convert v7 declared={type=L0 flags=[IsExpected]}
    v9 = NewClosure function=f3
    PropSet v8, v9 key="fetch" mode=Sloppy
    v11 = Undefined
    Return v11
}
function f1 module=m0 kind=Module flags=[IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m0 referrer=m1 [isBare]
    v1 = Undefined
    Return v1
}
function f2 name="helper" module=m0 flags=[IsSloppy, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="fetch" module=m0 flags=[IsSloppy, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
function f4 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="helper"
    v2 = Call v1 calleeName="helper"
    v3 = Undefined
    Return v3
}
function f5 module=m3 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = Await v0
    v2 = Undefined
    Return v2
}
entry module=m3 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
