# If a layout that may lose a property were opened, whatever unseen code holds would lie "beside the fields" of its objects, every call by name on them might call it with the object as `this`, and the whole class would escape for one `delete` somewhere.
# class P { constructor() { this.x = 1; }  get() { return this.x; } }  const p = new P(); p.get();  delete new P().x;
# A delete lays nothing beside the fields: it empties the field. The class stays with compiled code, the call has its one callee, and the field holds a number or nothing.
# RUN: link calls functions fields layouts mechanisms=all
# CHECK: call f0 v7 -> f2
# CHECK: function f2 callers-known
# CHECK: field L0.0 "x" proven=undefined|i32 writers-known
# CHECK: layout L0 changes=[LosesProperty] stays-with-compiled-code

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="get"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = PropGet v5 key="get"
    v7 = Call v6, v5 calleeKey="get"
    v8 = Construct v4
    v9 = PropDelete v8 key="x"
    Return v7
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Integer integer=1
    PropSet v2, v3 key="x"
    Return v2
}
function f2 name="get" module=m0 kind=Method flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
