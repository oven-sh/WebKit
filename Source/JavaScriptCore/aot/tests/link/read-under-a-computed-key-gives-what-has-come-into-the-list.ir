# `kept[0]`: all that the flow has seen come out of a read under a computed key stands in the tables of the reading that proves, with undefined for a place that holds nothing. The walk types the read by it, whatever form the read gets.
# const kept = [];  kept.push({ x: "a" });  kept[0];    const handed = [];  handed.push({ y: "b" });  sink(handed);  handed[0];    const asked = [];  asked.push({ z: "c" });  asked[sink()];
# A list that unseen code has may hold anything, and a key that nobody knows may be a name: of those two reads nothing is proven.
# A read under such a key lets its list go: an accessor that is laid on Array.prototype under the name gets the list as `this`. So that read has a list of its own, and `kept` stays with the program.
# What is held is a guess, which is tested at each use: of the list that unseen code has it says what the program was seen to put in.
# RUN: link accesses mechanisms=all
# CHECK: read f0 v7 proven=undefined|L0
# CHECK-NOT: read f0
# RUN(HELD): link held accesses mechanisms=all
# HELD: read f0 v7 proven=undefined|L0
# HELD: read f0 v17 proven=undefined|L1
# HELD: read f0 v25 proven={{*}}|L2

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="z" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = String string="a"
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = PropGet v0 key="push"
    v5 = Call v4, v0, v3 calleeKey="push"
    v6 = Integer integer=0
    v7 = ElemGet v0, v6
    v8 = NewArray contents=anything
    v9 = String string="b"
    v10 = NewObject -, v9 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = PropGet v8 key="push"
    v13 = Call v12, v8, v11 calleeKey="push"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="sink" [isFreeName]
    v16 = Call v15, -, v8 calleeName="sink"
    v17 = ElemGet v8, v6
    v18 = NewArray contents=anything
    v19 = String string="c"
    v20 = NewObject -, v19 layout=L2 fields=[0]
    v21 = FinishObject v20
    v22 = PropGet v18 key="push"
    v23 = Call v22, v18, v21 calleeKey="push"
    v24 = Call v15, - calleeName="sink"
    v25 = ElemGet v18, v24
    v26 = Undefined
    Return v26
}
