# If the integers of an established position were forgotten when its type becomes Link's, a variable and a result that the compiler itself declares int32 would be any integer to whoever reads them
# The result of `cut` is `a | 0` of a value that nobody has seen, an integer that fits int32 or a bigint by the rule of the row. The position holds of every value that is ever there, so what arrives has passed it.
# RUN: link functions variables mechanisms=all
# CHECK: function f1 {{*}}result=i32 returns
# CHECK: function f2 {{*}}result=i32 returns
# CHECK-NEXT: parameter 0 {{*}}proven=i32
# CHECK: variable g0 proven=i32

variable g0 name="count" module=m0 declared={type=i32 flags=[IsFromCompiler]}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="text" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1 calleeName="cut"
    v4 = NewClosure function=f2
    v5 = Call v4, -, v3 calleeName="keep"
    v6 = GetModuleVariable variable=g0
    v7 = Call v4, -, v6 calleeName="keep"
    v8 = Undefined
    Return v8
}
function f1 name="cut" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=i32 flags=[IsFromCompiler]}] {
  b0(v0: anything):
    v1 = Integer integer=0
    v2 = BitOr v0, v1
    Return v2
}
function f2 name="keep" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
