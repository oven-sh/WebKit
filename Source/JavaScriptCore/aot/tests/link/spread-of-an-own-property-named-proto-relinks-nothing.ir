# function copy(s) { return { ...s }; }  copy({ ["__proto__"]: { y: 1 } });
# An assignment under that name lays what is copied above the target (copy-that-assigns-a-prototype-link-lets-the-target-go.ir). A definition makes a property of that name: the record gains it and is let go by nobody.
# RUN: link fields layouts mechanisms=all
# CHECK: field L1.0 "x"{{*}} writers-known
# CHECK: layout L1 {{*}}changes=[GainsProperty]

layout L0 module=m0 fields=[{key="__proto__" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything}}]
layout L2 module=m0 fields=[{key="y" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = FinishObject v1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = Call v5, -, v4 calleeName="copy"
    v7 = Undefined
    Return v7
}
function f1 name="copy" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L1
    CopyDataProperties v1, v0
    v3 = FinishObject v1
    Return v3
}
