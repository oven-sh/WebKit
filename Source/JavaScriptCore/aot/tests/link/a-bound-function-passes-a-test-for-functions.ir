# function use(act, value) { if (typeof act === "function") return act(value); return 0; } use(Math.floor.bind(null), 65.5)
# A bound function is an object of a class of functions: a test for functions lets it pass, and the call behind the test goes by the rows of Math.floor. Where it is dropped the
# call has no callee and the result is the 0 of the other arm alone.
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=int|whole

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = Null
    v2 = PropGet v0 key="Math" [isFreeName]
    v3 = PropGet v2 key="floor"
    v4 = PropGet v3 key="bind"
    v5 = Call v4, v3, v1 calleeKey="bind"
    v6 = Double number=65.5
    v7 = NewClosure function=f1
    v8 = Call v7, -, v5, v6
    Return v8
}
function f1 name="use" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=function
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    v4 = NarrowByTest v0, v3
    v5 = Call v4, -, v1
    Return v5
  b2(v6):
    v7 = Integer
    Return v7
}
