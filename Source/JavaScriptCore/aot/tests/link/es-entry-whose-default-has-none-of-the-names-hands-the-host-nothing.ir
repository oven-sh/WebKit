# main.mjs, the entry: export default { port: 0, routes: {} }: the look at `default` is a read on the namespace, the looks at the names that the table lists are reads on what that gives.
# The control: es-entry-whose-default-has-one-of-the-names-hands-it-to-the-host.ir.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK: lookup entry-hands-host-nothing 0

data d0 root=Object{layout=L1 members=[{key="port" value=Number{}}, {key="routes" value=Object{layout=L0}}]} module=m0
layout L0 module=m0
layout L1 module=m0 fields=[{key="port" declared={type=anything} flags=[IsRequired]}, {key="routes" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="default" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="/main.mjs" displayPath="main.mjs" flags=[CachesEvaluationError] body=f0 exports=[{name="default" variable=g0}]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
entry module=m0 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
