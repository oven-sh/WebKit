    v9 = FinishClass v4 layout=L0
    v10 = Construct v9
    v11 = NewClosure function=f4
    v12 = Call v11, -, v10 calleeName="askM"
    v13 = NewClosure function=f5
    v14 = Call v13, -, v10 calleeName="askN"
    v15 = Undefined
    Return v15
}
