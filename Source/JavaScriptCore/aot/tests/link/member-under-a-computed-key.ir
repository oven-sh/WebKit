# If Link took the names that a class spells out for all its names, a call would go straight to `m` where the member under the computed key has replaced it, a lookup that finds nothing would count as a sure miss, and the member under the computed key would be left out of the executable
# class A { m() { return "m"; }  [key]() { return true; } }  function askM(x) { return x.m(); }  function askN(x) { return x.n(); }  askM(new A()); askN(new A());
# RUN: summary f0
# CHECK: member L0 Prototype 0 Method "m" = Closure f2
# CHECK: member L0 Prototype 1 Method [computed] = Closure f3
# RUN(CALLS): link calls mechanisms=all
# CALLS-NOT: call f4 v2
# CALLS-NOT: call f5 v2
# RUN(LINK): link functions members mechanisms=all
# LINK: function f3
# LINK-NOT: unreached
# LINK: function f4
# LINK-NOT: result=string
# LINK: function f5
# LINK: member L0 Prototype 0 Method "m"
# LINK-NOT: function=f2
# LINK: member L0 Prototype 1 Method [computed]

