# -- source: name-laid-on-a-function-is-not-found-under-keys-that-nobody-knows.js
# function K(v) { this.v = v; }
# K.of = function (v) { return new K(v); };
# function look(o, k) { return o[k]; }
# const bag = { a: 1 };
# bag.b = 2;
# sink(look(bag, sink()));
# sink(K.of(1).v);
# -- end of source
# `K.of = ..` lies on the closures of K under `of`, and every read of it off them is followed. If it went into the one node of "beside the fields of anything" too, each read under a key that nobody knows
# would find it there: `o[k]`, and every such read in the code of the library that prints an error. What such a read hands to unseen code has escaped: the function, what it returns, and with that the layout of K.
# SINCE 11-04 (R257) THE CLOCK OF START SAYS OF NO NAME THAT IT IS LAID AHEAD: through a hole in it the read of such a name gave undefined where the type said a function, and the process died; the claim fired on no program that we are judged by. What this test told apart by `laid-ahead` it no longer tells.
# RUN: link members layouts functions mechanisms=all
# CHECK: on-function f1 "of" function=f3
# CHECK: layout L0 {{*}}stays-with-compiled-code
# CHECK: function f3 callers-known

