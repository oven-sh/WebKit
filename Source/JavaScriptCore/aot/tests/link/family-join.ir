# A set holds layouts that stand in no declared family, or layouts that one declared family holds all. A layout of a family beside a stranger, and layouts of different families, are lost as before: else every place where hundreds of kinds meet would climb through three sets on its way there and tell its observers each time. If the join dropped one of the two, a read through the parameter would be compiled for the wrong shape
# abstract class Shape { }  class Circle, Square extends Shape  type Point
# A circle and a square arrive at `area`: the set of the two, which one declared family holds. A circle and a point arrive at `any`: the circle stands in a family that does not hold the point: both are lost, and the type names the two that met and no other member of the family. Neither has escaped.
# RUN: link families functions layouts mechanisms=all
# CHECK: family [[shape]] [{{*}}L1, L2]
# CHECK: function f1 callers-known one-callee
# CHECK-NEXT: parameter 0 {{*}}proven=L1|L2
# CHECK: function f2 callers-known one-callee
# CHECK-NEXT: parameter 0 {{*}}proven=L1|L3
# CHECK: layout L1 family=[[shape]] changes=[]
# CHECK: layout L2 family=[[shape]] changes=[]
# CHECK: layout L3 changes=[]

layout L0 kind=Instance name="Shape" module=m0 flags=[IsNeverAllocated]
layout L1 name="Circle" module=m0 fields=[{key="r" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Square" module=m0 fields=[{key="s" declared={type=anything} flags=[IsRequired]}] supertypes=[L0]
layout L3 name="Point" module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
variable g0 name="area" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="any" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject layout=L1
    PropDefine v1, v0 key="r"
    v3 = FinishObject v1
    v4 = NewObject layout=L2
    PropDefine v4, v0 key="s"
    v6 = FinishObject v4
    v7 = NewObject layout=L3
    PropDefine v7, v0 key="x"
    v9 = FinishObject v7
    v10 = GetModuleVariable variable=g0
    v11 = Call v10, -, v3 calleeName="area"
    v12 = Call v10, -, v6 calleeName="area"
    v13 = GetModuleVariable variable=g1
    v14 = Call v13, -, v3 calleeName="any"
    v15 = Call v13, -, v9 calleeName="any"
    Return v0
}
function f1 name="area" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
function f2 name="any" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=2
    Return v1
}
