# function never() { return eval("1"); }  function once() { return eval("held"); }  function again() { return eval("held"); }  function held() {}  function kept() {}  once(); again()
# The names of a file are listed once, in a scope that lies around the scopes of its direct evals. What it shows is let go once a body is reached that holds an eval of a scope inside it:
# `held` is named by no code, and text may call it.
# The control in the same file: nothing reaches `never`, and `kept`, which lies around its scope alone, is not reached.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK: function f1 unreached
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f3 unreached
# CHECK-NOT: function f4 unreached
# CHECK: function f5 unreached

module m0 path="main.js" displayPath="main.js" body=f0
variable g0 name="never" module=m0 declared={type=anything} initialization=Function function=f1
variable g1 name="once" module=m0 declared={type=anything} initialization=Function function=f2
variable g2 name="again" module=m0 declared={type=anything} initialization=Function function=f3
variable g3 name="held" module=m0 declared={type=anything} initialization=Function function=f4
variable g4 name="kept" module=m0 declared={type=anything} initialization=Function function=f5
evalscope e0 bindings=[{name="held" depth=1 variable=g3}]
evalscope e1 bindings=[{name="kept" depth=1 variable=g4}]
evalscope e2 flags=[IsInFunction, AllowsNewTarget] outer=e1
evalscope e3 flags=[IsInFunction, AllowsNewTarget] outer=e0
evalscope e4 flags=[IsInFunction, AllowsNewTarget] outer=e0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = Call v0, -
    v2 = GetModuleVariable variable=g2
    v3 = Call v2, -
    Return v3
}
function f1 name="never" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="1"
    v3 = DirectEval v2, v0, v1 evalScope=e2
    Return v3
}
function f2 name="once" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="held"
    v3 = DirectEval v2, v0, v1 evalScope=e3
    Return v3
}
function f3 name="again" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="held"
    v3 = DirectEval v2, v0, v1 evalScope=e4
    Return v3
}
function f4 name="held" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=1
    Return v2
}
function f5 name="kept" module=m0 flags=[HasThis, HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=2
    Return v2
}
