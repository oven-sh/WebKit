# main.mjs, the entry: export * from "./lib.cjs"; await 0 . lib.cjs: exports.default = { fetch() {} }; exports.fetch = ..: the host looks through the star of an entry that awaits as it does where the entry does not.
# Nothing lies under `then`, so neither function of the file is called, and its exports stay with compiled code.
# The controls: entry-that-awaits-with-a-star-over-a-file-that-lays-then-hands-it-to-the-host.ir, entry-with-a-star-over-a-file-that-lays-no-then-hands-the-host-nothing.ir.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK: function f2 unreached
# CHECK: module m0 value-stays-with-compiled-code
# CHECK: lookup entry-hands-host-nothing 0

layout L0 module=m0 fields=[{key="fetch" declared={type=anything} flags=[IsRequired, IsMethod]}] ownFieldCount=1
layout L1 module=m0 fields=[{key="default" declared={type=anything}}, {key="fetch" declared={type=anything}}] ownFieldCount=2
variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/lib.cjs" displayPath="lib.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
module m1 path="#1" displayPath="lib.cjs" exportRule=CommonJs body=f1 requests=[{target=m0 kind=Require completes=true}]
module m2 path="/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait] body=f4 requests=[{target=m1 completes=true isHoisted=true}, {target=m1 isDynamicStarExport=true completes=true}]
function f0 module=m0 kind=CommonJsModule flags=[IsSloppy] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L1
    v1 = FinishObject v0
    PutModuleVariable v1 variable=g0
    v3 = GetModuleVariable variable=g0
    v4 = Convert v3 declared={type=L1 flags=[IsExpected]}
    v5 = NewClosure function=f2
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = FinishObject v6
    PropSet v4, v7 key="default" mode=Sloppy
    v9 = GetModuleVariable variable=g0
    v10 = Convert v9 declared={type=L1 flags=[IsExpected]}
    v11 = NewClosure function=f3
    PropSet v10, v11 key="fetch" mode=Sloppy
    v13 = Undefined
    Return v13
}
function f1 module=m0 kind=Module flags=[IsHiddenInStackTraces] thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m0 referrer=m1 [isBare]
    v1 = Undefined
    Return v1
}
function f2 name="fetch" module=m0 kind=Method flags=[IsSloppy, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f3 name="fetch" module=m0 flags=[IsSloppy, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
function f4 module=m2 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = Await v0
    v2 = Undefined
    Return v2
}
entry module=m2 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
