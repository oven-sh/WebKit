# If every operator left a record, a summary would speak of locals: most sums are only compared, or only go into another operator
# function over(a, b) { if (a + b > 3) return 1; return 2; }  function count() { let i = 0; while (i < 10) { i = i + 1; } return i; }
# A counter that goes round a loop holds primitives alone, whichever: its conversion leaves no call.
# RUN: summary f1
# CHECK: call {{*}} v2 Name "valueOf"
# RUN(NONE): summary f1
# NONE-NOT: operator n
# RUN(LOOP): summary f2
# LOOP: operator [[step]] v6 Add ([[counter]], Constant int[0, 2147483647])
# LOOP: edge [[counter]] -> Result 0
# LOOP: edge Constant 0 -> [[counter]]
# LOOP: edge [[step]] -> [[counter]]
# RUN(CALLS): summary f2
# CALLS-NOT: call
# RUN(LINK): link functions mechanisms=all
# LINK: function f2 {{*}}result=int|whole returns

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0, v0 calleeName="over"
    v3 = NewClosure function=f2
    v4 = Call v3, - calleeName="count"
    v5 = Undefined
    Return v5
}
function f1 name="over" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    v3 = Integer integer=3
    v4 = Greater v2, v3
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v5 = Integer integer=1
    Return v5
  b2():
    v6 = Integer integer=2
    Return v6
}
function f2 name="count" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=0
    Jump -> next b1(v0)
  b1(v1: anything):
    LoopHint
    v3 = Integer integer=10
    v4 = Less v1, v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Integer integer=1
    v6 = Add v1, v5
    Jump -> next b1(v6)
  b3():
    Return v1
}
