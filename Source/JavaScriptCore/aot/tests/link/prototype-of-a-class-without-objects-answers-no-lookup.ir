# If a lookup off a value that nobody knows went on to the prototype object of every class of the engine and the host, the first object handed to native code would find `constructor`, `then` and `next` of them all:
# `console.log({})` would reach the constructors of streams, workers and timers, what their rows call, and in the end the whole library
# print([]);
# A value that nobody knows is an object that may exist. Native code may walk the list: `Symbol.iterator` finds `values`, whose row makes an iterator of lists, so `next` of that class is found and the code behind it is entered.
# Nothing makes a map, let alone an iterator of one, so the `next` of that class is not found.
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached
# RUN(NONE): link functions mechanisms=none
# NONE-NOT: function f1 unreached
# NONE: function f2 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/Iterators.ts" displayPath="/$bun/js/engine/Iterators.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=ArrayIteratorPrototypeNext function=f1
runtimefunction id=MapIteratorPrototypeNext function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = Call v2, -, v0 calleeName="print"
    v4 = Undefined
    Return v4
}
function f1 name="next" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] enclosingRuntimeFunction=ArrayIteratorPrototypeNext thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f2 name="next" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] enclosingRuntimeFunction=MapIteratorPrototypeNext thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
