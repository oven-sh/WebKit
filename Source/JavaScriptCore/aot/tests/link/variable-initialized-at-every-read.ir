# The loader enters the bodies of modules in one order, and Link follows it: a function is stamped with the earliest point at which anything may enter it, a variable with the store that ends its dead zone.
# If a variable lost the mark of emptiness although a reader may run first, the walk would fold the test away and the read would hand on a value that is none, where a ReferenceError is due
# function readFirst() { return first; }  function readEarly() { return early; }  function readMaybe() { return maybe; }  function readHanded() { return handed; }  function readLater() { return later; }
# let first = "a";  readFirst();  readEarly();  let early = "b";  if (unknown) { var maybe_ = (maybe = "c"); }  readMaybe();  host(readHanded);  let handed = "d";  let later = "e";  host(readLater);
# `first`: the only call stands behind the store. `early`: it stands in front. `maybe`: not every way through the body passes the store. `handed`: code that nobody knows has the reader before the store. `later`: it gets that reader behind the store, but it ran while the closure was there, and nobody follows what it was handed when.
# SINCE 11-04 (R244) THE CLOCK TAKES THE MARK OUT OF NO VARIABLE: five holes in it ended in the empty word read raw, and what the proof spared is a compare. `first` keeps it too, and its reader checks.
# RUN: link variables mechanisms=all
# CHECK: variable g0 proven=string|absent
# CHECK: variable g1 proven=string|absent
# CHECK: variable g2 proven=string|absent
# CHECK: variable g3 proven=string|absent
# CHECK: variable g4 proven=string|absent
# RUN(WALK): walk f1 f2 mechanisms=none+TypedOperations+Folding
# WALK-LABEL: code f1:Body
# WALK: CheckInitialized
# WALK-LABEL: code f2:Body
# WALK: CheckInitialized

variable g0 name="first" module=m0 declared={type=anything|absent}
variable g1 name="early" module=m0 declared={type=anything|absent}
variable g2 name="maybe" module=m0 declared={type=anything|absent}
variable g3 name="handed" module=m0 declared={type=anything|absent}
variable g4 name="later" module=m0 declared={type=anything|absent}
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = String string="a"
    PutModuleVariable v5 variable=g0
    v7 = Call v0 calleeName="readFirst"
    v8 = Call v1 calleeName="readEarly"
    v9 = String string="b"
    PutModuleVariable v9 variable=g1
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="unknown" [isFreeName]
    Branch v12 -> taken b1(), notTaken b2()
  b1():
    v13 = String string="c"
    PutModuleVariable v13 variable=g2
    Jump -> next b2()
  b2():
    v15 = Call v2 calleeName="readMaybe"
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="host" [isFreeName]
    v18 = Call v17, -, v3 calleeName="host"
    v19 = String string="d"
    PutModuleVariable v19 variable=g3
    v21 = String string="e"
    PutModuleVariable v21 variable=g4
    v23 = Call v17, -, v4 calleeName="host"
    v24 = Undefined
    Return v24
}
function f1 name="readFirst" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="first"
    Return v1
}
function f2 name="readEarly" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="early"
    Return v1
}
function f3 name="readMaybe" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g2
    v1 = CheckInitialized v0 name="maybe"
    Return v1
}
function f4 name="readHanded" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="handed"
    Return v1
}
function f5 name="readLater" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g4
    v1 = CheckInitialized v0 name="later"
    Return v1
}
