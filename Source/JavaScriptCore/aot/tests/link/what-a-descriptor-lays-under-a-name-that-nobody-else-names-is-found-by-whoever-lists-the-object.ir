# A written descriptor under a name that nobody else names leaves no access, and the layout is not opened. What it lays lies on the object all the same: whoever lists what the object holds, or reads under a computed key, may find it.
#   function make() { const made = { b: "y" }; Object.defineProperty(made, "laidForNobody", { value: 42, enumerable: true }); return made; }
#   function list(o) { return Object.values(o)[1]; }   function look(o, key) { return o[key]; }   function walk(o) { let last; for (const key in o) last = o[key]; return last; }
# When nothing brought it to them, `list` was proven undefined|string and `look` and `walk` undefined|null|string|object: `typeof found === "number"` was folded to false, silently.
# RUN: summary f1
# CHECK: change {{*}}DefinesByDescriptor {{*}}under-a-name-that-nobody-else-names descriptor-in-sight
# The object is handed to nobody: its maker answers its layout.
# RUN(SHUT): link functions layouts mechanisms=all
# SHUT: function f1 {{*}}result=L1
# SHUT: layout L1 changes=[IsFrozen, GainsProperty, GetsAccessor] stays-with-compiled-code
# RUN(FOUND): link functions accesses mechanisms=all
# FOUND-NOT: function f2 {{*}}result=
# FOUND-NOT: function f3 {{*}}result=
# FOUND-NOT: function f4 {{*}}result=
# FOUND-NOT: read f2
# FOUND-NOT: read f3
# FOUND-NOT: read f4

