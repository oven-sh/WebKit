# If a call by name that has looked at a set took its receiver for done, the method of a class that joins the set later would never be entered: it would be left out of the executable, and what it returns would be missing from the result
# class Circle { m() { return "c"; } }  class Square { m() { return true; } }  class Late { m() { return null; } }  function ask(s) { return s.m(); }  function unwrap(b) { return b.held; }  ask(new Circle()); ask(new Square()); ask(unwrap({ held: new Late() }));
# The third comes a round later, through a read: by then the call has been told of the set of two.
# RUN: link functions mechanisms=all
# CHECK: function f2 callers-known
# CHECK: function f4 callers-known
# CHECK: function f6 callers-known
# CHECK: function f7 callers-known one-callee {{*}}result=null|true|string returns=
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1|L2
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: unreached

layout L0 kind=Instance name="Circle" module=m0 constructor=f1
layout L1 kind=Instance name="Square" module=m0 constructor=f3
layout L2 kind=Instance name="Late" module=m0 constructor=f5
layout L3 module=m0 fields=[{key="held" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = NewClosure function=f3
    v6 = NewClass v5 layout=L1
    v7 = NewClosure function=f4
    DefineMethod v6, v7 layout=L1 key="m"
    v9 = FinishClass v6 layout=L1
    v10 = NewClosure function=f5
    v11 = NewClass v10 layout=L2
    v12 = NewClosure function=f6
    DefineMethod v11, v12 layout=L2 key="m"
    v14 = FinishClass v11 layout=L2
    v15 = Construct v4
    v16 = Construct v9
    v17 = Construct v14
    v18 = NewObject -, v17 layout=L3 fields=[0]
    v19 = FinishObject v18
    v20 = NewClosure function=f7
    v21 = Call v20, -, v15 calleeName="ask"
    v22 = Call v20, -, v16 calleeName="ask"
    v23 = NewClosure function=f8
    v24 = Call v23, -, v19 calleeName="unwrap"
    v25 = Call v20, -, v24 calleeName="ask"
    v26 = Undefined
    Return v26
}
function f1 name="Circle" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="c"
    Return v0
}
function f3 name="Square" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}
function f4 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
function f5 name="Late" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f6 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Null
    Return v0
}
function f7 name="ask" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
function f8 name="unwrap" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="held"
    Return v1
}
