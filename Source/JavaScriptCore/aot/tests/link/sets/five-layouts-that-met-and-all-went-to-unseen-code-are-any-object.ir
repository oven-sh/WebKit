# What met is named by its members as long as one of them has stayed with compiled code. Where all have gone to code that nobody sees, the set says no more than "an object that has escaped", and in a large program it is one bag of tens of thousands: a type that names it is dear to make and proves nothing.
# function take(o) { return o.x; }  function same(o) { return o; }  take({ x: 1, p: 1 });  take({ x: "a", q: 1 });  take({ x: true, r: 1 });  take({ x: null, s: 1 });  take(same({ x: "a", t: 1 }));   with   function take(o) { sink(o); return o.x; }
# One value of the five at unseen code takes all five.
# RUN: link functions layouts mechanisms=all
# CHECK: function f1 callers-known
# CHECK-NEXT: parameter 0 {{*}}proven=object
# CHECK-NOT: family=
# CHECK-NOT: stays-with-compiled-code

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="r" declared={type=anything} flags=[IsRequired]}]
layout L3 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flags=[IsRequired]}]
layout L4 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="t" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = String string="a"
    v4 = NewObject -, v3, v0 layout=L1 fields=[0, 1]
    v5 = FinishObject v4
    v6 = Boolean boolean=true
    v7 = NewObject -, v6, v0 layout=L2 fields=[0, 1]
    v8 = FinishObject v7
    v9 = Null
    v10 = NewObject -, v9, v0 layout=L3 fields=[0, 1]
    v11 = FinishObject v10
    v12 = NewObject -, v3, v0 layout=L4 fields=[0, 1]
    v13 = FinishObject v12
    v14 = NewClosure function=f1
    v15 = Call v14, -, v2 calleeName="take"
    v16 = Call v14, -, v5 calleeName="take"
    v17 = Call v14, -, v8 calleeName="take"
    v18 = Call v14, -, v11 calleeName="take"
    v19 = NewClosure function=f2
    v20 = Call v19, -, v13 calleeName="same"
    v21 = Call v14, -, v20 calleeName="take"
    v22 = Undefined
    Return v22
}
function f1 name="take" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="sink" [isFreeName]
    v3 = Call v2, -, v0 calleeName="sink"
    v4 = PropGet v0 key="x"
    Return v4
}
function f2 name="same" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
