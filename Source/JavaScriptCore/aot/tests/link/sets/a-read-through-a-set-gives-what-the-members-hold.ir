# If a read through a set of layouts found the field of one member alone, a text would be taken for an integer. If the members shared one node under the name, the field of each would be proven what the other holds
# function read(o) { return o.x; }  read({ x: 1, p: 1 });  read({ x: "a", q: 1 });
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f1 callers-known one-callee {{*}}result=int[0, 2147483647]|string returns=
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1
# CHECK: field L0.0 "x" proven=int[0, 2147483647] writers-known
# CHECK: field L1.0 "x" proven=string writers-known
# CHECK: layout L0 changes=[] stays-with-compiled-code
# CHECK: layout L1 changes=[] stays-with-compiled-code

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="q" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = String string="a"
    v4 = NewObject -, v3, v0 layout=L1 fields=[0, 1]
    v5 = FinishObject v4
    v6 = NewClosure function=f1
    v7 = Call v6, -, v2 calleeName="read"
    v8 = Call v6, -, v5 calleeName="read"
    v9 = Undefined
    Return v9
}
function f1 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
