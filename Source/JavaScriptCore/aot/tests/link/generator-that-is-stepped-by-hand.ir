# RUN(CALL): summary f1
# CALL: call c{{*}} v1
# CALL-NOT: only-iterated

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0 calleeName="first"
    v2 = Undefined
    Return v2
}
function f1 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Call v0 calleeName="count"
    v2 = PropGet v1 key="next"
    v3 = String string="in"
    v4 = Call v2, v1, v3 calleeKey="next"
    Return v4
}
function f2 name="count" module=m0 flags=[IsGenerator, HasThis, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: function):
    Jump -> next b1()
  b1():
    InitialYield
    v3 = Integer integer=1
    v4 = Yield v3
    v5 = ResultAt v4
    v6 = ResultAt v4 index=1
    Switch v6 cases=[1, 2] -> case b2(), case b3(), otherwise b4()
  b2():
    Throw v5
  b3():
    Return v5
  b4():
    v7 = Undefined
    Return v7
}
