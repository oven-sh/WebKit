# If a method of lists let its receiver escape because a list might not be as its class makes it, every list that is ever pushed to would open, and what comes out of `pop` would be anything
# const list = [];  function add(l, o) { l.push(o); }  function take(l) { return l.pop(); }  function get(o) { return o.x; }  add(list, { x: "a", only: 0 });  get(take(list));
# Nothing has laid a name on the list, defined an element by a descriptor or put another object above it, so no code of the program runs inside the two built-ins, and the rows for a list as its class makes it say all that they do.
# RUN: link functions fields layouts mechanisms=all
# CHECK: function f2 callers-known one-callee {{*}}result=undefined|L0
# CHECK: function f3 callers-known one-callee {{*}}result=string
# CHECK: field L0.0 "x" proven=string writers-known written-at-construction-alone
# CHECK: layout L0 changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="only" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewArray contents=anything
    v1 = String string="a"
    v2 = Integer integer=0
    v3 = NewObject -, v1, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    v5 = NewClosure function=f1
    v6 = Call v5, -, v0, v4 calleeName="add"
    v7 = NewClosure function=f2
    v8 = Call v7, -, v0 calleeName="take"
    v9 = NewClosure function=f3
    v10 = Call v9, -, v8 calleeName="get"
    v11 = Undefined
    Return v11
}
function f1 name="add" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push"
    v4 = Undefined
    Return v4
}
function f2 name="take" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="pop"
    v2 = Call v1, v0 calleeKey="pop"
    Return v2
}
function f3 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
