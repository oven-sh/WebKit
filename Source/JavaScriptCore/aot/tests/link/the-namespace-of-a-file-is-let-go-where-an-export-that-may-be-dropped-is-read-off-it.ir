# lacks.js never provides `sep`   stars.js: sep = "/"   t.js: export * from "./stars.js"; export { sep } from "./lacks.js"; export const kept = 7   plain.js: export const read = 1, unread = 2
# main.js: import * as t from "./t.js"; import * as plain from "./plain.js"; out = t.sep; other = plain.read
# The run drops the entry `sep` of t.js while its variable is empty, and whatever its stars lead to answers: a CommonJS file or a built-in module has no table that could say what.
# giveExport() said that the read may give anything and let nothing go, so a function that a CommonJS file behind the star exports was handed out while the compiler still held every caller for known,
# and the executable stopped at its own test: "an entry parameter is not of the type that the compiler has proven of it".
# A read of such an entry lets the whole namespace of the file go, as a read of a name that the table lacks does: no export of t.js stays in compiled code.
# the control: plain.js has no such entry, and what nobody reads off it stays in
# RUN: link modules mechanisms=all
# CHECK-NOT: export g3 stays-in
# CHECK: export g6 stays-in

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m4 completes=true}]
module m1 path="/t.js" displayPath="t.js" body=f1 requests=[{target=m2 isDynamicStarExport=true completes=true}, {target=m3 completes=true}] exports=[{name="kept" variable=g3}, {name="sep" variable=g0 isHiddenUntilInitialized=true}] namespaceLayout=L(m1)
module m2 path="/stars.js" displayPath="stars.js" body=f2 exports=[{name="sep" variable=g1}]
module m3 path="/lacks.js" displayPath="lacks.js" body=f3
module m4 path="/plain.js" displayPath="plain.js" body=f4 exports=[{name="read" variable=g5}, {name="unread" variable=g6}] namespaceLayout=L(m4)
entry module=m0
variable g0 name="sep" module=m3 declared={type=anything|absent}
variable g1 name="sep" module=m2 declared={type=anything}
variable g2 name="out" module=m0 declared={type=anything|absent}
variable g3 name="kept" module=m1 declared={type=anything}
variable g4 name="other" module=m0 declared={type=anything|absent}
variable g5 name="read" module=m4 declared={type=anything}
variable g6 name="unread" module=m4 declared={type=anything}
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = PropGet v0 key="sep"
    PutModuleVariable v1 variable=g2
    v3 = ModuleNamespace module=m4
    v4 = PropGet v3 key="read"
    PutModuleVariable v4 variable=g4
    v6 = Undefined
    Return v6
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=7
    PutModuleVariable v0 variable=g3
    v2 = Undefined
    Return v2
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="/"
    PutModuleVariable v0 variable=g1
    v2 = Undefined
    Return v2
}
function f3 module=m3 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f4 module=m4 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g5
    v2 = Integer integer=2
    PutModuleVariable v2 variable=g6
    v4 = Undefined
    Return v4
}
