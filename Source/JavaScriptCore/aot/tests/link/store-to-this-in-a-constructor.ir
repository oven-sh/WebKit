# If a store to `this` in a constructor let the class escape, no field of any class would have a type or a raw slot. If the store were not seen at all, the field would count as holding nothing and a read of it would be folded away
# class P { constructor(v) { this.x = v; } }  function get(p) { return p.x; }  get(new P("a"));
# Every way through the constructor stores the field in front of the return, so it is filled: the read gives what the field holds and no undefined. That a slot may be empty is no part of the field's type.
# RUN: summary f1
# CHECK-NOT: Allocation L0 -> Unknown
# CHECK-NOT: Parameter 1 -> Unknown
# RUN(LINK): link functions fields layouts mechanisms=all
# LINK: function f1 callers-known one-callee
# LINK-NEXT: parameter 0
# LINK-NEXT: parameter 1 {{*}}proven=string
# LINK: function f2 callers-known one-callee {{*}}result=string
# LINK-NEXT: parameter 0 {{*}}proven=L0
# LINK: field L0.0 "x" proven=string writers-known written-at-construction-alone filled
# LINK: layout L0 changes=[]

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, -, v3
    v5 = NewClosure function=f2
    v6 = Call v5, -, v4 calleeName="get"
    v7 = Undefined
    Return v7
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
