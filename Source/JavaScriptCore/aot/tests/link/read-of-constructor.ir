# If the read of `constructor` off an instance gave nothing that Link follows, the construction behind it would enter nothing, and the field would stay proven a string while `new a.constructor(true)` stores a boolean
# class A { constructor(v) { this.x = v; } }  class B { constructor(v) { this.y = v; } }  function again(a) { return new a.constructor(true); }  again(new A("a")); new B("a");
# The read is followed to the class object, or that one class escapes. Either way the boolean is seen, and a class that nobody asks for its constructor keeps all that is proven of it.
# RUN: summary f2
# CHECK: call c0 v3 Value a0 (Constant true) constructs
# CHECK: access a0 v1 Read Parameter 0 "constructor" -> a0
# RUN(LINK): link functions fields layouts mechanisms=all
# LINK: function f1
# LINK-NEXT: parameter 0
# LINK-NEXT: parameter 1
# LINK-NOT: proven=string
# LINK: function f2
# LINK: function f3 callers-known one-callee
# LINK-NEXT: parameter 0
# LINK-NEXT: parameter 1 {{*}}proven=string
# LINK: field L0.0 "x"
# LINK-NOT: proven=string
# LINK: field L1.0 "y" proven=string writers-known written-at-construction-alone
# LINK: layout L1 changes=[]

layout L0 kind=Instance name="A" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="B" module=m0 constructor=f3 fields=[{key="y" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = NewClosure function=f3
    v4 = NewClass v3 layout=L1
    v5 = FinishClass v4 layout=L1
    v6 = String string="a"
    v7 = Construct v2, -, v6
    v8 = Construct v5, -, v6
    v9 = NewClosure function=f2
    v10 = Call v9, -, v7 calleeName="again"
    v11 = Undefined
    Return v11
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
function f2 name="again" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="constructor"
    v2 = Boolean boolean=true
    v3 = Construct v1, -, v2
    Return v3
}
function f3 name="B" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1
    PropSet v3, v1 key="y"
    Return v3
}
