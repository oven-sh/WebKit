# the run time finds the module of an `import()` by its number, so a plain one reads no path. Where attributes arrive it looks, under the path of the file, for the form that they ask for
# main.js: import("./a.js", options);  import("./b.js");
# RUN: summary f0 mechanisms=all
# CHECK: reads-paths-of m0, m1
# RUN(LINK): link layouts mechanisms=all
# LINK-NOT: path-unread m0
# LINK-NOT: path-unread m1
# LINK: path-unread m2

module m0 path="/main.js" displayPath="main.js" body=f0
module m1 path="/a.js" displayPath="a.js" body=f1
module m2 path="/b.js" displayPath="b.js" body=f2
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="options" [isFreeName]
    v2 = ImportModule v1 module=m1 referrer=m0
    v3 = ImportModule module=m2 referrer=m0
    Return v3
}
function f1 module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 module=m2 kind=Module results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
