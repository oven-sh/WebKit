# If a getter that a literal defines let the object escape, all that the object holds would go with it: `{ get rules() { .. }, base, make }` is how a factory is written.
# const o = { a: 1, held: { b: 2 }, get x() { return this.a; }, set y(v) { this.a = v; } };  o.x;  o.y = 5;  o.held.b;
# DefineGetter and DefineSetter name the function. Whoever reads the field gets what the getter returns, and what is stored into the field is handed to the setter. Both run with the object as `this`.
# RUN(SCAN): summary f0
# SCAN: DefinesByDescriptor Allocation L0 "x" other=Closure f1 getter
# SCAN: DefinesByDescriptor Allocation L0 "y" other=Closure f2 setter
# RUN: link functions fields layouts mechanisms=all
# A name with a setter alone reads as undefined, and the field stands for what is read and for what is stored: so the setter counts as handed undefined too.
# CHECK: function f0 {{*}}result=undefined|int[0, 2147483647]
# CHECK: function f1 callers-known {{*}}result=undefined|int[0, 2147483647]
# CHECK-NEXT: parameter 0 {{*}}proven=L0
# CHECK: function f2 callers-known
# CHECK: field L0.0 "a" proven=undefined|int[0, 2147483647] writers-known
# CHECK: field L1.0 "b" proven=int[0, 2147483647] writers-known
# The slot of such a field is empty, so the tables say that objects of the layout get accessors. Nothing else may change.
# CHECK: layout L0 changes=[GetsAccessor]
# CHECK: layout L1 changes=[]

layout L0 name="O" module=m0 fields=[{key="a" declared={type=anything}}, {key="held" declared={type=anything}}, {key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
layout L1 name="Held" module=m0 fields=[{key="b" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = Integer integer=1
    PropDefine v0, v1 key="a"
    v3 = NewObject layout=L1
    v4 = Integer integer=2
    PropDefine v3, v4 key="b"
    PropDefine v0, v3 key="held"
    v7 = NewClosure function=f1
    DefineGetter v0, v7 key="x"
    v9 = NewClosure function=f2
    DefineSetter v0, v9 key="y"
    v11 = PropGet v0 key="x"
    v12 = Integer integer=5
    PropSet v0, v12 key="y"
    v14 = PropGet v0 key="held"
    v15 = PropGet v14 key="b"
    Return v11
}
function f1 module=m0 kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    Return v1
}
function f2 module=m0 kind=Setter flags=[HasThis] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="a"
    v3 = Undefined
    Return v3
}
