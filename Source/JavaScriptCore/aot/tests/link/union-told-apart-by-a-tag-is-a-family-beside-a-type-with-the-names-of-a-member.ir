    v14 = Add v10, v11
    v15 = Add v14, v13
    Return v15
}
function f1 name="map" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=L1|L2}] results=[{type=anything}] {
