# A row that reads by a key through the prototypes tells which member it finds above the object, so the code of the library behind that member is in the image. No other member comes along
# sink(Reflect.get([], "map"));
# LIBRARY: own
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached
# RUN(IMAGE): image ProgramTables
# IMAGE: compiledRuntimeFunction ArrayPrototypeMap
# IMAGE-NOT: compiledRuntimeFunction ArrayPrototypeFilter

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
data d0 root=Array{contents=never} module=m0
entry module=m0
runtimefunction id=ArrayPrototypeFilter function=f2
runtimefunction id=ArrayPrototypeMap function=f1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = Builtin builtin=Reflect
    v3 = Builtin builtin=ReflectGet
    v4 = Data data=d0
    v5 = String string="map"
    v6 = Call v3, v2, v4, v5 calleeName="Reflect.get"
    v7 = Call v1, -, v6
    v8 = Undefined
    Return v8
}
function f1 name="map" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f2 name="filter" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeFilter thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
