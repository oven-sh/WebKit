# CHECK-NEXT: leaves-empty L0.1 "size"
# RUN(LISTED): summary f2
# LISTED-NOT: leaves-empty
# RUN(LINK): link fields mechanisms=all
# LINK: field L1.0 "valueOf" {{*}}filled
# RUN(EMPTY): link fields mechanisms=all
