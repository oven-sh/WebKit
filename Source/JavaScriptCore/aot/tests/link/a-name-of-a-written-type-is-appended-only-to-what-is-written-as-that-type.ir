# interface Plain { first: number; later?: number }  interface Base { first: number }  interface Wide extends Base { wide?: number }
# function OfPlain(this: Plain) { this.first = 1; }  function OfBase(this: Base) { this.first = 2; }  globalThis.one = new OfPlain();  globalThis.other = new OfBase();  unknown.later = 3;  unknown.wide = 3;
# `later` is a name of the type as which the objects of OfPlain are written, and one of them may hide behind `unknown`: it gets a place. Nothing is written as Wide: that Wide extends Base makes no object of OfBase a Wide.
# Where the supertypes of such a type were climbed, the names of every record type above EventEmitter's in Bun's own library (sockets, client requests, file streams, readline) got a place in every response of a server.
# RUN: link fields mechanisms=all
# CHECK: field L0.0 "first"
# CHECK: field L0.1 "later" appended
# CHECK: field L1.0 "first"
# CHECK-NOT: field L1.1

layout L0 kind=Instance name="OfPlain" module=m0 constructor=f1 fields=[{key="first" declared={type=anything} flags=[IsRequired]}] supertypes=[L3] flags=[IsConstructorFunction]
layout L1 kind=Instance name="OfBase" module=m0 constructor=f2 fields=[{key="first" declared={type=anything} flags=[IsRequired]}] supertypes=[L2] flags=[IsConstructorFunction]
layout L2 module=m0 fields=[{key="first" declared={type=anything} flags=[IsRequired]}] flags=[IsNeverAllocated]
layout L3 module=m0 fields=[{key="first" declared={type=anything} flags=[IsRequired]}, {key="later" declared={type=anything}}] flags=[IsNeverAllocated]
layout L4 module=m0 fields=[{key="first" declared={type=anything} flags=[IsRequired]}, {key="wide" declared={type=anything}}] supertypes=[L2] flags=[IsNeverAllocated]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = Construct v0
    v4 = Construct v1
    PropSet v2, v3 key="one"
    PropSet v2, v4 key="other"
    v7 = PropGet v2 key="unknown" [isFreeName]
    v8 = Integer integer=3
    PropSet v7, v8 key="later"
    PropSet v7, v8 key="wide"
    v11 = Undefined
    Return v11
}
function f1 name="OfPlain" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Integer integer=1
    PropSet v0, v1 key="first"
    v3 = Undefined
    Return v3
}
function f2 name="OfBase" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Integer integer=2
    PropSet v0, v1 key="first"
    v3 = Undefined
    Return v3
}
