# function hide(...fns) { for (const fn of fns) Object.defineProperty(fn, "name", { value: "x" }); }  function first() {}  hide(first);
# hideFromStack(..fns) of internal/shared.ts. As a-function-that-is-given-a-name-where-it-is-written-is-not-reached.ir, but `undefined` (what a step answers at the end of the list) arrives at the subject of the definition first, the functions behind it.
# The call throws on a primitive before it looks at the descriptor, so nothing is handed over then. If the subject's place were tied to unseen code at that moment, the tie would stay, and every function that arrives later would go out through it.
# RUN: link functions mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK: function f2 unreached

layout L0 fields=[{key="value" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Call v0, -, v1 calleeName="hide"
    v3 = Undefined
    Return v3
}
function f1 name="hide" module=m0 flags=[HasRestParameter, HasExplicitName] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = IteratorOpen v0
    Jump -> next b1()
  b1():
    LoopHint
    v3 = IteratorResume v1
    v4 = ResultAt v3
    v5 = ResultAt v3 index=1
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v6 = Undefined
    Return v6
  b3():
    v7 = Builtin builtin=Object
    v8 = Builtin builtin=ObjectDefineProperty
    v9 = String string="name"
    v10 = String string="x"
    v11 = NewObject -, v10 layout=L0 fields=[0]
    v12 = FinishObject v11
    v13 = Call v8, v7, v5, v9, v12 calleeName="Object.defineProperty"
    Jump -> next b1()
}
function f2 name="first" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
