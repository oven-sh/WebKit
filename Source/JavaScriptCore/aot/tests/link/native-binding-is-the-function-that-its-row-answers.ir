# main.ts: import { crc32 } from "node:zlib"; crc32(new Uint8Array(3), 0)        node:zlib: const crc32 = $bindgen("node_zlib_binding.bind.ts", "crc32"); return { crc32 }
# The row of the binding says what the host answers for it: the function %NativeFunctions%.Node_zlib_bindingBindTsCrc32. So the name the importer
# takes off the module holds that function, the call reaches it, and its result is what the function's row declares.
# LIBRARY: own
# REQUIRES: entries-of-bun
# RUN: link calls variables
# CHECK: call f0 v4 Builtin NativeFunctionsNode_zlib_bindingBindTsCrc32
# CHECK: variable g0 proven=builtin(NativeFunctionsNode_zlib_bindingBindTsCrc32)

variable g0 name="crc32" module=m1 declared={type=anything}
layout L0 name="Exports" fields=[{key="crc32" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" body=f0 requests=[{target=m1 completes=true}]
module m1 path="node:zlib" displayPath="node:zlib" kind=RuntimeSource exportRule=RuntimeModule requireResult=DefaultExport runtimeModule=NodeZlib body=f1 syntheticExports=[{name="crc32" variable=g0 isKnownMember=true}]
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="crc32"
    v2 = Builtin builtin=Uint8Array
    v3 = Construct v2
    v4 = Call v1, -, v3 calleeName="crc32"
    Return v4
}
function f1 name="zlib" module=m1 kind=Module role=Library thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NativeBinding builtin=NativeBindgenNode_zlib_bindingBindTsCrc32
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
