# The record of a module lists the names that its namespace object shows. The front end lists them where some site hands the object out. Nothing here need reach that site, and the image shows the names all the same:
# whoever gets hold of the object calls what it finds there with what it likes, so nothing is proven of the parameters by the calls in sight.
# library.js: export function sum(a, b) { return a + b }
# main.js: import { sum } from "./library.js"; const table = { never() { return import("./library.js") } }; print(sum(1, 2))
# RUN: link functions mechanisms=all
# CHECK-NOT: function f2 callers-known
# CHECK: function f3 unreached
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 3
# ALL-NEXT: exited with 0

module m0 path="/library.js" displayPath="library.js" body=f1 exports=[{name="sum" variable=g0}]
module m1 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m0 completes=true}]
entry module=m1
variable g0 name="sum" module=m0 declared={type=function} initialization=Function function=f2 flags=[IsImmutable]
function f0 name="main" module=m1 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Integer integer=1
    v2 = Integer integer=2
    v3 = Call v0, -, v1, v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="print" [isFreeName]
    v6 = Call v5, -, v3
    Return
}
function f1 name="library" module=m0 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="sum" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Add v0, v1
    Return v2
}
function f3 name="never" module=m1 results=[{type=anything}] {
    v0 = ImportModule module=m0 referrer=m1
    Return v0
}
