# The list follows from the program alone. Whatever is done on real values is paid for by what it touches, before it is done: the characters of a text that is made a number, the places of a list that is spread, the words of a BigInt that is written out;
# and a built-in that is called back is handed the whole receiver at every element, so the price is the square.
# new RegExp("a" + +"9".repeat(1000000)) . ("b" + [...Array(1000000)][0]) . ("c" + String(BigInt("0x" + "f".repeat(100000))).length) . ("d" + "a".repeat(3000).split("").map([].concat.bind([])).length) . ("z+" + 1)
# DIAGNOSTIC: RegExpTextKnownAtRunTime
# RUN: regexp-texts mechanisms=all
# CHECK: text /z+1/
# CHECK-NOT: text /

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = Integer integer=1000000
    v2 = String string="9"
    v3 = PropGet v2 key="repeat"
    v4 = Call v3, v2, v1 calleeKey="repeat"
