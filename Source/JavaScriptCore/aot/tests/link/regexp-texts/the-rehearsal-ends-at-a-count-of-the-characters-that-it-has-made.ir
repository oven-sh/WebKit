# What ends the rehearsal is a count of what it has made, 256 * 1024 * 1024 characters, and nothing that the heap says: what a heap holds hangs on the memory of the host and on when its collector has run, and the list of texts would hang on them too.
# for (let n = 0; n < 400; n++) { "x".repeat(1000000); new RegExp("t" + n); }   A turn makes 1000000 characters and the text: 268000962 are made in front of the turn of 268, 269001000 and more in front of the next.
# RUN: regexp-texts mechanisms=all
# CHECK: text /t268/
# CHECK-NOT: text /t269/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = String string="x"
    v2 = Integer integer=1000000
    v3 = String string="t"
    v4 = Integer
    Jump -> next b1(v4)
  b1(v5: anything):
    LoopHint
    v7 = PropGet v1 key="repeat"
    v8 = Call v7, v1, v2 calleeKey="repeat"
    v9 = Add v3, v5
    v10 = Construct v0, -, v9
    v11 = Increment v5
    v12 = Integer integer=400
    v13 = Less v11, v12
    Branch v13 -> taken b1(v11), notTaken b2()
  b2():
    Return v4
}
