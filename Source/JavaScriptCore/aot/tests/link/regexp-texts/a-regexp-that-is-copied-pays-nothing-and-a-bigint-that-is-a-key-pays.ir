# The list follows from the program alone. A pattern that is a RegExp object is copied: nothing is converted and nothing is matched, so nothing is asked of it: new RegExp(/(?:a+)+b/, "i" + "").
# A BigInt that an operator makes a key is written out, which is paid for by the square of its words: new RegExp("c" + held[BigInt("0x" + "f".repeat(100000))]).
# DIAGNOSTIC: RegExpTextKnownAtRunTime
# RUN: regexp-texts mechanisms=all
# CHECK: text /(?:a+)+b/i
# CHECK-NOT: text /c

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=1 fields=[]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = NewRegExp pattern="(?:a+)+b"
    v2 = String string="i"
    v3 = String string=""
    v4 = Add v2, v3
    v5 = Construct v0, -, v1, v4
    v6 = String string="0x"
    v7 = String string="f"
    v8 = Integer integer=100000
    v9 = PropGet v7 key="repeat"
    v10 = Call v9, v7, v8 calleeKey="repeat"
    v11 = Add v6, v10
    v12 = Builtin builtin=BigInt
    v13 = Call v12, -, v11
    v14 = NewObject layout=L0
    v15 = String string="c"
    v16 = ElemGet v14, v13
    v17 = Add v15, v16
    v18 = Construct v0, -, v17
    v19 = NewArray v5, v18 contents=anything
    Return v19
}
