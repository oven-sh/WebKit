# The list follows from the program alone. Inside the rehearsal the program never holds a built-in itself: what it holds goes through the same call as any call of the program's, whoever calls it.
# So a built-in that stands in a slot of an object and is called by the engine, by protocol, is entered and paid for where it is written down how its work grows, and is not entered where it is not.
# const root = Math.cbrt.bind(null, 8), mute = { toString: root };   new RegExp("a" + mute) . ("b" + [mute].join()) . ("c" + String(mute)): Math.cbrt is not written down.
# const five = JSON.stringify.bind(null, 5), talker = { toString: five };   ("d" + talker) . ("e" + [talker].join()) . Object.defineProperty(holder, "x", { get: five }); ("f" + holder.x)
# DIAGNOSTIC: RegExpTextKnownAtRunTime
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /a
# CHECK-NOT: text /b
# CHECK-NOT: text /c
# CHECK: text /d5/
# CHECK: text /e5/
# CHECK: text /f5/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=1 fields=[{key="toString" declared={type=anything}}] ownFieldCount=1
layout L1 module=m0 position=2 fields=[{key="get" declared={type=anything}}] ownFieldCount=1
layout L2 module=m0 position=3 fields=[]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = Null
    v2 = Builtin builtin=Math
    v3 = PropGet v2 key="cbrt"
    v4 = Integer integer=8
    v5 = PropGet v3 key="bind"
    v6 = Call v5, v3, v1, v4 calleeKey="bind"
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = String string="a"
    v9 = Add v8, v7
    v10 = Construct v0, -, v9
    v11 = NewArray v7 contents=anything
    v12 = PropGet v11 key="join"
    v13 = Call v12, v11 calleeKey="join"
    v14 = String string="b"
    v15 = Add v14, v13
    v16 = Construct v0, -, v15
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="String" [isFreeName]
    v19 = Call v18, -, v7
    v20 = String string="c"
    v21 = Add v20, v19
    v22 = Construct v0, -, v21
    v23 = Builtin builtin=JSON
    v24 = PropGet v23 key="stringify"
    v25 = Integer integer=5
    v26 = PropGet v24 key="bind"
    v27 = Call v26, v24, v1, v25 calleeKey="bind"
    v28 = NewObject -, v27 layout=L0 fields=[0]
    v29 = String string="d"
    v30 = Add v29, v28
    v31 = Construct v0, -, v30
    v32 = NewArray v28 contents=anything
    v33 = PropGet v32 key="join"
    v34 = Call v33, v32 calleeKey="join"
    v35 = String string="e"
    v36 = Add v35, v34
    v37 = Construct v0, -, v36
    v38 = Builtin builtin=Object
    v39 = NewObject layout=L2
    v40 = String string="x"
    v41 = NewObject -, v27 layout=L1 fields=[0]
    v42 = PropGet v38 key="defineProperty"
    v43 = Call v42, v38, v39, v40, v41 calleeKey="defineProperty"
    v44 = PropGet v39 key="x"
    v45 = String string="f"
    v46 = Add v45, v44
    v47 = Construct v0, -, v46
    v48 = NewArray v10, v16, v22, v31, v37, v47 contents=anything
    Return v48
}
