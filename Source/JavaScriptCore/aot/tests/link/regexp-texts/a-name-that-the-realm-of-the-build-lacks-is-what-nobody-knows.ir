# The realm in which the build goes through the code has nothing of the host. `Builtin GlobalThis` is what `globalThis` gives there, which stands in front of the realm, and was not taken for the global object:
# a name that the host lays on it was a known undefined, and the rehearsal went one way, the wrong one.
# export const which = new RegExp(laidByTheHost ? "yes" : "no");
# RUN: regexp-texts mechanisms=all
# CHECK-COUNT-2: text /
# CHECK-NOT: text /
# RUN(YES): regexp-texts mechanisms=all
# YES: text /yes/
# RUN(NO): regexp-texts mechanisms=all
# NO: text /no/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="which" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="laidByTheHost" [isFreeName]
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = String string="yes"
    Jump -> next b3(v3)
  b2():
    v4 = String string="no"
    Jump -> next b3(v4)
  b3(v5):
    v6 = Builtin builtin=RegExp
    v7 = Construct v6, -, v5
    PutModuleVariable v7 variable=g0
    v9 = Undefined
    Return v9
}
