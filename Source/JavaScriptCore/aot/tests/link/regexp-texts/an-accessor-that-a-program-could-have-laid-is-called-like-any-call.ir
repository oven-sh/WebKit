# The list follows from the program alone. An accessor that a program could have laid (a bound function, a built-in function) is called by the rehearsal itself, like any call, by whatever road it was laid: what is not written down is not entered.
# const root = Math.cbrt.bind(null, 8);   one.__defineGetter__("x", root); new RegExp("a" + one.x) . Object.defineProperties(two, { x: { get: root } }); ("b" + two.x) . three = Object.create(null, { x: { get: root } }); ("c" + three.x)
# One that is written down is entered and paid for: four.__defineGetter__("x", Math.max.bind(null, 7)); ("d" + four.x). The accessors of the engine itself are called as ever: ("e" + /s+/.source).
# DIAGNOSTIC: RegExpTextKnownAtRunTime
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /a2/
# CHECK-NOT: text /b2/
# CHECK-NOT: text /c2/
# CHECK: text /d7/
# CHECK: text /es+/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=2 fields=[{key="get" declared={type=anything}}] ownFieldCount=1
layout L1 module=m0 position=3 fields=[]
layout L2 module=m0 position=4 fields=[{key="x" declared={type=anything}}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = Null
    v2 = Builtin builtin=Math
    v3 = PropGet v2 key="cbrt"
    v4 = Integer integer=8
    v5 = PropGet v3 key="bind"
    v6 = Call v5, v3, v1, v4 calleeKey="bind"
    v7 = Builtin builtin=Object
    v8 = String string="x"
    v9 = NewObject layout=L1
    v10 = PropGet v9 key="__defineGetter__"
    v11 = Call v10, v9, v8, v6 calleeKey="__defineGetter__"
    v12 = PropGet v9 key="x"
    v13 = String string="a"
    v14 = Add v13, v12
    v15 = Construct v0, -, v14
    v16 = NewObject layout=L1
    v17 = NewObject -, v6 layout=L0 fields=[0]
    v18 = NewObject -, v17 layout=L2 fields=[0]
    v19 = PropGet v7 key="defineProperties"
    v20 = Call v19, v7, v16, v18 calleeKey="defineProperties"
    v21 = PropGet v16 key="x"
    v22 = String string="b"
    v23 = Add v22, v21
    v24 = Construct v0, -, v23
    v25 = NewObject -, v6 layout=L0 fields=[0]
    v26 = NewObject -, v25 layout=L2 fields=[0]
    v27 = PropGet v7 key="create"
    v28 = Call v27, v7, v1, v26 calleeKey="create"
    v29 = PropGet v28 key="x"
    v30 = String string="c"
    v31 = Add v30, v29
    v32 = Construct v0, -, v31
    v33 = Builtin builtin=Math
    v34 = PropGet v33 key="max"
    v35 = Integer integer=7
    v36 = PropGet v34 key="bind"
    v37 = Call v36, v34, v1, v35 calleeKey="bind"
    v38 = NewObject layout=L1
    v39 = PropGet v38 key="__defineGetter__"
    v40 = Call v39, v38, v8, v37 calleeKey="__defineGetter__"
    v41 = PropGet v38 key="x"
    v42 = String string="d"
    v43 = Add v42, v41
    v44 = Construct v0, -, v43
    v45 = NewRegExp pattern="s+"
    v46 = PropGet v45 key="source"
    v47 = String string="e"
    v48 = Add v47, v46
    v49 = Construct v0, -, v48
    v50 = NewArray v15, v24, v32, v44, v49 contents=anything
    Return v50
}
