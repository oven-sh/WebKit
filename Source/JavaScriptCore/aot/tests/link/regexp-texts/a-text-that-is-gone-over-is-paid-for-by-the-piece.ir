    v13 = Add v12, v12
    v14 = Add v13, v13
    v15 = Add v14, v14
    v16 = Add v15, v15
    v17 = Add v16, v16
    v18 = NewArray contents=anything
    v19 = PropGet v18 key="push"
    v20 = Call v19, v18, v17 calleeKey="push"
    v21 = PropGet v18 key="length"
    v22 = String string="y"
    v23 = PropGet v22 key="toUpperCase"
    v24 = Call v23, v22 calleeKey="toUpperCase"
    v25 = Add v24, v21
