    v3 = Add v2, v2
    v4 = Add v3, v3
    v5 = Add v4, v4
    v6 = Add v5, v5
    v7 = Add v6, v6
    v8 = Add v7, v7
    v9 = Add v8, v8
    v10 = Add v9, v9
    v11 = Add v10, v10
    v12 = Add v11, v11
    v13 = Add v12, v12
    v14 = Add v13, v13
    v15 = Add v14, v14
    v16 = Add v15, v15
    v17 = Add v16, v16
    v18 = Builtin builtin=Set
    v19 = Construct v18, -, v17
    v20 = PropGet v19 key="size"
    v21 = String string="x"
    v22 = PropGet v21 key="toUpperCase"
    v23 = Call v22, v21 calleeKey="toUpperCase"
    v24 = Add v23, v20
    v25 = Builtin builtin=RegExp
    v26 = Construct v25, -, v24
    Return v26
}
function f2 name="kept" module=m0 position=20 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = Add v0, v0
    v2 = Add v1, v1
    v3 = Add v2, v2
    v4 = Add v3, v3
    v5 = Add v4, v4
    v6 = Add v5, v5
    v7 = Add v6, v6
    v8 = Add v7, v7
    v9 = Add v8, v8
