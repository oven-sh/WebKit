# The list follows from the program alone. A built-in that goes over a text piece by piece pays for each piece, whatever it makes of them: a Set of a long text of two letters holds two.
# What only keeps a text pays for its characters: sixteen to the operation.
# export function gone() { return new RegExp("x".toUpperCase() + new Set(doubled("ab", 17)).size); }   (doubled(text, k): text = text + text, k times)
# export function kept() { const list = []; list.push(doubled("ab", 17)); return new RegExp("y".toUpperCase() + list.length); }
# DIAGNOSTIC: RegExpPatternNotConstant
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /X2/
# CHECK: text /Y1/

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="gone" variable=g0}, {name="kept" variable=g1}]
entry module=m0
variable g0 name="gone" module=m0 declared={type=anything|absent} flags=[IsImmutable]
variable g1 name="kept" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g1
    v4 = Undefined
    Return v4
}
function f1 name="gone" module=m0 position=10 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = Add v0, v0
