# The list follows from the program alone. Characters that a built-in goes over are cheap; the pieces that it makes out of them are not: each costs an operation.
# export function grammar() { const text = doubled("ab", 14); text.split(""); .. eight times in all: 262,144 pieces ..; return new RegExp("cut".toUpperCase()); }: it is not gone through to its end.   (doubled(text, k): text = text + text, k times)
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /CUT/

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="grammar" variable=g0}]
entry module=m0
variable g0 name="grammar" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f1 name="grammar" module=m0 position=10 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = Add v0, v0
    v2 = Add v1, v1
    v3 = Add v2, v2
    v4 = Add v3, v3
    v5 = Add v4, v4
    v6 = Add v5, v5
    v7 = Add v6, v6
    v8 = Add v7, v7
    v9 = Add v8, v8
    v10 = Add v9, v9
    v11 = Add v10, v10
    v12 = Add v11, v11
    v13 = Add v12, v12
    v14 = Add v13, v13
    v15 = String string=""
    v16 = PropGet v14 key="split"
    v17 = Call v16, v14, v15 calleeKey="split"
    v18 = Call v16, v14, v15 calleeKey="split"
    v19 = Call v16, v14, v15 calleeKey="split"
    v20 = Call v16, v14, v15 calleeKey="split"
    v21 = Call v16, v14, v15 calleeKey="split"
    v22 = Call v16, v14, v15 calleeKey="split"
    v23 = Call v16, v14, v15 calleeKey="split"
    v24 = Call v16, v14, v15 calleeKey="split"
    v25 = String string="cut"
    v26 = PropGet v25 key="toUpperCase"
    v27 = Call v26, v25 calleeKey="toUpperCase"
    v28 = Builtin builtin=RegExp
    v29 = Construct v28, -, v27
    Return v29
}
