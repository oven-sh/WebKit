  b0():
    v0 = String string="a"
    v1 = Add v0, v0
    v2 = Add v1, v1
    v3 = Add v2, v2
    v4 = Add v3, v3
    v5 = Add v4, v4
    v6 = Add v5, v5
    v7 = Add v6, v6
