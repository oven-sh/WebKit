    v20 = Builtin builtin=RegExp
    v21 = String string="1"
    v22 = Add v19, v21
    v23 = Construct v20, -, v22
    v24 = String string="2"
    v25 = Add v19, v24
    v26 = Construct v20, -, v25
    v27 = String string="3"
    v28 = Add v19, v27
    v29 = Construct v20, -, v28
