# class Router { #routes = []; #matcher = null; add(path) { this.#routes[this.#routes.length] = path; } match(path) { if (!this.#matcher) { let text = ""; for (let i = 0; i < this.#routes.length; i++) text += (i ? "|" : "") + this.#routes[i]; this.#matcher = new RegExp("^(?:" + text + ")$"); } return this.#matcher.test(path); } }
# const router = new Router();
# router.add("/text");
# router.add("/users/[^/]+");
# host.serve({ fetch(request) { return router.match(request.url) ? "found" : "missing"; } });
# The router only notes its routes. Its one pattern is made when the first request comes, in a method that knows nothing by itself: the routes lie in the object that the start of the program has filled.
# The function that the start hands to code that nobody knows is called once, with what the start has left behind and nothing known of the request.
# RUN: regexp-texts mechanisms=all
# CHECK: text /^(?:/text|/users/[^/]+)$/
# CHECK-NOT: text /

