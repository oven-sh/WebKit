# The list follows from the program alone. includes and indexOf ask the identity of what a list holds: where it holds what nobody knows the answer no is not known.
# new RegExp(([5, [7].toSpliced()[0]].includes(7) ? "present" : "absent").toUpperCase() + "q");   ([7].toSpliced(): toSpliced is not entered: nobody knows what it gives.)
# RUN: regexp-texts mechanisms=all
# CHECK: text /ABSENTq/
# CHECK: text /PRESENTq/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    v1 = Integer integer=7
    v2 = NewArray v1 contents=anything
    v3 = PropGet v2 key="toSpliced"
    v4 = Call v3, v2 calleeKey="toSpliced"
    v5 = Integer
    v6 = ElemGet v4, v5
    v7 = NewArray v0, v6 contents=anything
    v8 = Integer integer=7
    v9 = PropGet v7 key="includes"
    v10 = Call v9, v7, v8 calleeKey="includes"
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b2()
  b1():
    v12 = String string="present"
    v13 = PropGet v12 key="toUpperCase"
    v14 = Call v13, v12 calleeKey="toUpperCase"
    Jump -> next b3(v14)
  b2():
    v15 = String string="absent"
    v16 = PropGet v15 key="toUpperCase"
    v17 = Call v16, v15 calleeKey="toUpperCase"
    Jump -> next b3(v17)
  b3(v18: anything):
    v19 = Builtin builtin=RegExp
    v20 = String string="q"
    v21 = Add v18, v20
    v22 = Construct v19, -, v21
    Return v22
}
