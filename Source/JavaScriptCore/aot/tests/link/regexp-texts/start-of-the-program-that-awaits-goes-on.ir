# async function load(name) { return name + "+"; }
# async function main(tail) { const text = await load("x"); const made = new RegExp("^" + text + tail); await host.ready(); return [made, new RegExp(text + "y" + tail)]; }
# const both = await main("$");
# export const third = new RegExp("z" + both.length + String("?"));
# The body of the module awaits an async function, which awaits another. Each is gone through in one go: what `load` gives is a promise that is settled, and `await` takes the text out of it.
# What the host gives nobody knows, and the function goes on behind that `await` too. The records of the library that stand behind a promise are left out here: the rehearsal has the realm's own.
# RUN: regexp-texts mechanisms=all
# CHECK-COUNT-3: text /
# CHECK-NOT: text /
# RUN(FIRST): regexp-texts mechanisms=all
# FIRST: text /^x+$/
# RUN(SECOND): regexp-texts mechanisms=all
# SECOND: text /x+y$/
# RUN(THIRD): regexp-texts mechanisms=all
# THIRD: text /z2?/

