    v26 = String string="b"
    v27 = Add v26, v25
    v28 = PropGet v15 key="indexOf"
    v29 = Call v28, v15, v27 calleeKey="indexOf"
    v30 = String string="x"
    v31 = PropGet v30 key="toUpperCase"
    v32 = Call v31, v30 calleeKey="toUpperCase"
    v33 = Add v32, v29
    v34 = Builtin builtin=RegExp
    v35 = Construct v34, -, v33
    Return v35
}
