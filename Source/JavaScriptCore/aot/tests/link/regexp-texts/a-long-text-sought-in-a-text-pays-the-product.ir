# The list follows from the program alone. The search for a text in a text knows the last 250 characters of what is sought; for a longer one it may take as many steps as the product of the two lengths, and that is what it pays.
# export function long() { return new RegExp("x".toUpperCase() + doubled("a", 15).indexOf("b" + doubled("a", 9))); }   (doubled(text, k): text = text + text, k times)
# export function short() { return new RegExp("y".toUpperCase() + doubled("a", 15).indexOf("b" + doubled("a", 7))); }
# DIAGNOSTIC: RegExpPatternNotConstant
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /X-1/
# CHECK: text /Y-1/

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="long" variable=g0}, {name="short" variable=g1}]
entry module=m0
variable g0 name="long" module=m0 declared={type=anything|absent} flags=[IsImmutable]
variable g1 name="short" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g1
    v4 = Undefined
    Return v4
}
function f1 name="long" module=m0 position=10 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
