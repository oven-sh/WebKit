# The list follows from the program alone. An object below Array.prototype that is no list finds the iterator, toString and join of lists there, and they go through it by its length: it is asked about wherever such an object is handed on.
# So it is with an object below a list.
# export function below() { const bag = Object.create(Array.prototype); bag.length = 3000000; return new RegExp("x".toUpperCase() + [...bag].length); }
# export function under() { const long = []; long.length = 3000000; return new RegExp("y".toUpperCase() + [...Object.create(long)].length); }
# export function words() { const bag = Object.create(Array.prototype); bag.length = 3000000; return new RegExp("z".toUpperCase() + ("" + bag).length); }
