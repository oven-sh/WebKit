# The list follows from the program alone. A built-in goes over sixteen characters in the time of one operation, and that is what they cost: a long text may pass through many built-ins
# in a function that is only guessed at.
# export function grammar() { let text = doubled("ab", 14); text = text.toUpperCase(); text = text.toLowerCase(); .. eight times in all ..; return new RegExp(text + "$"); }   (doubled(text, k): text = text + text, k times)
# RUN: regexp-texts mechanisms=all
# CHECK: text /abababab

module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="grammar" variable=g0}]
entry module=m0
variable g0 name="grammar" module=m0 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f1 name="grammar" module=m0 position=10 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="ab"
    v1 = Add v0, v0
    v2 = Add v1, v1
    v3 = Add v2, v2
    v4 = Add v3, v3
    v5 = Add v4, v4
    v6 = Add v5, v5
    v7 = Add v6, v6
    v8 = Add v7, v7
    v9 = Add v8, v8
    v10 = Add v9, v9
    v11 = Add v10, v10
    v12 = Add v11, v11
    v13 = Add v12, v12
    v14 = Add v13, v13
    v15 = PropGet v14 key="toUpperCase"
    v16 = Call v15, v14 calleeKey="toUpperCase"
    v17 = PropGet v16 key="toLowerCase"
    v18 = Call v17, v16 calleeKey="toLowerCase"
    v19 = PropGet v18 key="toUpperCase"
    v20 = Call v19, v18 calleeKey="toUpperCase"
    v21 = PropGet v20 key="toLowerCase"
    v22 = Call v21, v20 calleeKey="toLowerCase"
    v23 = PropGet v22 key="toUpperCase"
    v24 = Call v23, v22 calleeKey="toUpperCase"
    v25 = PropGet v24 key="toLowerCase"
    v26 = Call v25, v24 calleeKey="toLowerCase"
    v27 = PropGet v26 key="toUpperCase"
    v28 = Call v27, v26 calleeKey="toUpperCase"
    v29 = PropGet v28 key="toLowerCase"
    v30 = Call v29, v28 calleeKey="toLowerCase"
    v31 = String string="$"
    v32 = Add v30, v31
    v33 = Builtin builtin=RegExp
    v34 = Construct v33, -, v32
    Return v34
}
