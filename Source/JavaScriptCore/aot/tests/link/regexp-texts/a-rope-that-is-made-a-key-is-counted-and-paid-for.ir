# The list follows from the program alone. A joined text is one small cell until it is read as characters; to make it a key lays it out: that is counted like any text that is made, and paid for like any text that is gone over.
# A file that keeps such keys runs out of what it may do, and its neighbors keep their texts.
# neighbor.js: let big = "fifteen letters"; for (let turn = 0; turn < 16; turn++) big += big; const kept = {}; for (let turn = 0; turn < 300; turn++) kept[big + turn] = turn; new RegExp("k".toUpperCase() + Object.keys(kept).length);
# routes.js: export function route(path) { return new RegExp("^" + path); } . main.js: route("shops");
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /K300/
# CHECK: text /^shops/

module m0 path="/neighbor.js" displayPath="neighbor.js" body=f0
module m1 path="/routes.js" displayPath="routes.js" body=f1 exports=[{name="route" variable=g0}]
module m2 path="/main.js" displayPath="main.js" body=f3 requests=[{target=m0 completes=true}, {target=m1 completes=true}]
entry module=m2
layout L0 module=m0 position=1 fields=[]
variable g0 name="route" module=m1 declared={type=anything|absent} flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="fifteen letters"
    v1 = Integer
    Jump -> next b1(v0, v1)
  b1(v2: anything, v3: anything):
    LoopHint
    v5 = Add v2, v2
    v6 = Increment v3
    v7 = Integer integer=16
    v8 = Less v6, v7
    Branch v8 -> taken b1(v5, v6), notTaken b2()
  b2():
    v9 = NewObject layout=L0
    v10 = Integer
    Jump -> next b3(v10)
  b3(v11: anything):
    LoopHint
    v13 = Add v5, v11
    ElemSet v9, v13, v11
    v15 = Increment v11
    v16 = Integer integer=300
    v17 = Less v15, v16
    Branch v17 -> taken b3(v15), notTaken b4()
  b4():
    v18 = Builtin builtin=ObjectKeys
    v19 = Call v18, -, v9
    v20 = PropGet v19 key="length"
    v21 = String string="k"
    v22 = PropGet v21 key="toUpperCase"
    v23 = Call v22, v21 calleeKey="toUpperCase"
    v24 = Add v23, v20
    v25 = Builtin builtin=RegExp
    v26 = Construct v25, -, v24
    Return v26
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f2 name="route" module=m1 position=10 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="^"
    v2 = Add v1, v0
    v3 = Builtin builtin=RegExp
    v4 = Construct v3, -, v2
    Return v4
}
function f3 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = String string="shops"
    v2 = Call v0, -, v1
    Return v2
}
