    v16 = PropGet v1 key="values"
    v17 = Call v16, v1, v15 calleeKey="values"
    v18 = PropGet v2 key="max"
    v19 = PropGet v17 key="includes"
    v20 = Call v19, v17, v18 calleeKey="includes"
    v21 = String string="b"
    v22 = Add v21, v20
    v23 = Construct v0, -, v22
    v24 = Builtin builtin=Array
    v25 = PropGet v24 key="prototype"
    v26 = PropGet v1 key="create"
    v27 = Call v26, v1, v25 calleeKey="create"
    v28 = Integer integer=3
    PropSet v27, v28 key="length"
    v30 = NewArray v27 contents=anything
    v31 = PropGet v30 key="join"
    v32 = Call v31, v30 calleeKey="join"
    v33 = PropGet v32 key="length"
    v34 = String string="d"
    v35 = Add v34, v33
    v36 = Construct v0, -, v35
    v37 = Builtin builtin=Array
    v38 = PropGet v37 key="prototype"
    v39 = PropGet v1 key="create"
    v40 = Call v39, v1, v38 calleeKey="create"
    v41 = Integer integer=1000000
    PropSet v40, v41 key="length"
    v43 = NewArray v40 contents=anything
    v44 = PropGet v43 key="join"
    v45 = Call v44, v43 calleeKey="join"
    v46 = PropGet v45 key="length"
    v47 = PropGet v43 key="join"
    v48 = Call v47, v43 calleeKey="join"
    v49 = PropGet v48 key="length"
    v50 = Add v46, v49
    v51 = PropGet v43 key="join"
    v52 = Call v51, v43 calleeKey="join"
    v53 = PropGet v52 key="length"
    v54 = Add v50, v53
    v55 = PropGet v43 key="join"
    v56 = Call v55, v43 calleeKey="join"
    v57 = PropGet v56 key="length"
    v58 = Add v54, v57
    v59 = PropGet v43 key="join"
    v60 = Call v59, v43 calleeKey="join"
