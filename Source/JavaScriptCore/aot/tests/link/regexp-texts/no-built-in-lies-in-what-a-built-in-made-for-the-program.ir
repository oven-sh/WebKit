# The list follows from the program alone. Inside the rehearsal no built-in itself lies in a structure that a built-in made fresh for the program: a descriptor, a list of values.
# So a program that never held a built-in cannot lay it under another name either: Object.defineProperty(mute, "toString", Object.getOwnPropertyDescriptor(Math, "cbrt")); new RegExp("a" + mute): Math.cbrt is not written down.
# What lies there is what the program gets wherever it reads the same thing: ("b" + Object.values(Object.getOwnPropertyDescriptor(Math, "max")).includes(Math.max))
# An object inside a list pays by its length like one that is handed over: const small = Object.create(Array.prototype); small.length = 3; ("d" + [small].join().length)
# heir.length = 1000000; const holder = [heir]; ("c" + (holder.join().length + .. nine times ..)): the nine together are more than a start may do.
# DIAGNOSTIC: RegExpPatternNotConstant
# RUN: regexp-texts mechanisms=all
# CHECK-NOT: text /aNaN/
# CHECK: text /btrue/
# CHECK-NOT: text /c8999991/
# CHECK: text /d2/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=1 fields=[]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=Math
    v3 = NewObject layout=L0
    v4 = String string="toString"
    v5 = String string="cbrt"
    v6 = PropGet v1 key="getOwnPropertyDescriptor"
    v7 = Call v6, v1, v2, v5 calleeKey="getOwnPropertyDescriptor"
    v8 = PropGet v1 key="defineProperty"
