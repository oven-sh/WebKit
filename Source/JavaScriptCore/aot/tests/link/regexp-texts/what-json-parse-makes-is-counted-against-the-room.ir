# JSON.parse makes a cell out of as little as two characters: far more than the text itself takes. What parses may have made is counted in front of each call: half the characters, each the largest cell with its place in the holder. A parse that does not fit is not made: it gives what nobody knows. The count is its own, so parses take no room from anything else: the rehearsal goes on, and the texts behind are found.
# let text = "[],"; (doubled fourteen times by +); text = "[" + text + "[]]"; for (let n = 0; n < 400; n++) new RegExp("b" + n + "x" + JSON.parse(text).length); new RegExp("end");   49157 characters a turn: 36 bytes each: 256 MB have space for some 150 turns: the turn of 99 is parsed, the last is not
# RUN: regexp-texts mechanisms=all
# CHECK: text /end/
# CHECK-NOT: text /b399x16385/
# CHECK: text /b99x16385/

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
