# The list follows from the program alone, and finding it ends. What a built-in does with a RegExp is paid for by the characters of the subject; that holds only while the object is as it was made.
# const r = /a/; Object.defineProperty(r, "flags", { value: "g" }); new RegExp("x" + "aa".replace(r, "b")); new RegExp("z+" + 1);
# DIAGNOSTIC: RegExpPatternNotConstant
# RUN: regexp-texts mechanisms=all
# CHECK: text /z+1/
# CHECK-NOT: text /

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=1 fields=[{key="value" declared={type=anything}}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=RegExp
    v1 = NewRegExp pattern="a"
    v2 = Builtin builtin=Object
    v3 = PropGet v2 key="defineProperty"
    v4 = String string="g"
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = String string="flags"
    v7 = Call v3, v2, v1, v6, v5 calleeKey="defineProperty"
    v8 = String string="aa"
    v9 = PropGet v8 key="replace"
    v10 = String string="b"
    v11 = Call v9, v8, v1, v10 calleeKey="replace"
    v12 = String string="x"
    v13 = Add v12, v11
    v14 = Construct v0, -, v13
    v15 = String string="z+"
    v16 = Integer integer=1
    v17 = Add v15, v16
    v18 = Construct v0, -, v17
    v19 = NewArray v14, v18 contents=anything
    Return v19
}
