# the options are a copy of an object that nobody knows, and the block lays `app` on the copy: no lock is laid
# Bun.serve({ ...base, app: 0 }); Date.now();
# RUN: locks
# CHECK-NOT: locked

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="Bun" [isFreeName]
    v2 = PropGet v1 key="serve"
    v3 = PropGet v0 key="base" [isFreeName]
    v4 = CopyObject v3
    v5 = Integer
    PropDefine v4, v5 key="app"
    v7 = Call v2, v1, v4 calleeKey="serve"
    v8 = PropGet v0 key="Date" [isFreeName]
    v9 = PropGet v8 key="now"
    v10 = Call v9, v8 calleeKey="now"
    Return v10
}
