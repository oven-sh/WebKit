# the program evaluates a text that nobody has read. Whatever it lets in has the objects of the language in its scope and goes by them as compiled code does, so their members are locked whether or not compiled code names them
# eval(text);
# RUN: locks
# CHECK: locked DateNow
# CHECK: locked MathRandom

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="eval" [isFreeName]
    v2 = PropGet v0 key="text" [isFreeName]
    v3 = Call v1, -, v2
    Return v3
}
