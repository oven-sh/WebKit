# the call of Bun.serve() stands in a helper, whose body does not show what it is passed: the flow brings an object that was written with `app` there, and no lock is laid
# const start = options => Bun.serve(options); start({ app: 0 }); Date.now();
# RUN: locks open
# CHECK-NOT: locked
# CHECK: open DateNow no-lock-is-laid

layout L0 module=m0 fields=[{key="app" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = Call v0, -, v3
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="Date" [isFreeName]
    v7 = PropGet v6 key="now"
    v8 = Call v7, v6 calleeKey="now"
    Return v8
}
function f1 name="start" module=m0 kind=Arrow length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Bun" [isFreeName]
    v3 = PropGet v2 key="serve"
    v4 = Call v3, v2, v0 calleeKey="serve"
    Return v4
}
