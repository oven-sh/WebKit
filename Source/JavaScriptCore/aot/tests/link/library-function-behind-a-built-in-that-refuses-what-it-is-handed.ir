    Return v0
}
function f2 name="get" module=m1 kind=Method role=Library flags=[HasExplicitName] length=2 enclosingRuntimeFunction=ReflectObjectGet thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
