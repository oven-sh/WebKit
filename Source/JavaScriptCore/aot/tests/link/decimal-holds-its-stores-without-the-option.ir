# A program that has a global of its own under the name keeps it in sight, like one under any other name.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known
# CHECK: function f2 callers-known

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="Decimal"
    v4 = TypeTest v3 testedType=function
    Branch v4 -> taken b1(| 0), notTaken b2()
  b1(v5):
    Jump -> next b3()
  b2():
    PropSet v2, v0 key="Decimal" mode=Strict
    Jump -> next b3()
  b3():
    v7 = PropGet v2 key="Decimal" [isFreeName]
    v8 = Call v7, -, v1 calleeName="Decimal"
    v9 = Integer integer=1
    v10 = Call v1, -, v9 calleeName="second"
    Return
}
function f1 name="polyfill" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
function f2 name="second" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
