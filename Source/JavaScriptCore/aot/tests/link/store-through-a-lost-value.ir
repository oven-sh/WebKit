# If a store through a lost value missed a member, that member's field would be proven a type that it no longer holds. If it reached every layout with the name, one list of mixed objects would spoil the fields of the whole program
# const list = [{ x: "a", p: "a" }, { x: true, q: true }];  const apart = { x: "a", r: "a" };  function put(e) { e.x = null; e.p = null; }  put(list[0]);
# The store reaches the field of that name in the lost layouts and in no other. A member without the name may gain it.
# RUN: link fields layouts mechanisms=all
# CHECK: field L0.0 "x" proven=null|string writers-known
# CHECK-NOT: written-at-construction-alone
# CHECK: field L0.1 "p" proven=null|string writers-known
# CHECK-NOT: written-at-construction-alone
# CHECK: field L1.0 "x" proven=null|true writers-known
# CHECK-NOT: written-at-construction-alone
# CHECK: field L1.1 "q" proven=true writers-known written-at-construction-alone
# CHECK: field L2.0 "x" proven=string writers-known written-at-construction-alone
# CHECK: layout L0 changes=[]
# CHECK: layout L1 changes=[GainsProperty]
# CHECK: layout L2 changes=[]

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="r" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = Boolean boolean=true
    v4 = NewObject -, v3, v3 layout=L1 fields=[0, 1]
    v5 = FinishObject v4
    v6 = NewObject -, v0, v0 layout=L2 fields=[0, 1]
    v7 = FinishObject v6
    v8 = NewArray v2, v5 contents=anything
    v9 = Integer integer=0
    v10 = ElemGet v8, v9
    v11 = NewClosure function=f1
    v12 = Call v11, -, v10 calleeName="put"
    v13 = Undefined
    Return v13
}
function f1 name="put" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Null
    PropSet v0, v1 key="x"
    PropSet v0, v1 key="p"
    v4 = Undefined
    Return v4
}
