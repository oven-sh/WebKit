# If only a store in a block that every way passes counted, `if (c) this.x = 1; else this.x = 2;` would leave the field empty in the tables, and so would every constructor that fills a field in the arms of a switch
# class P { constructor(v) { if (typeof v === "string") this.x = v; else this.x = "b"; } }  new P("a");
# RUN: summary f1
# CHECK: construction Allocated fills ["x"] looks-up ["x"]
# RUN(LINK): link fields mechanisms=all
# LINK: field L0.0 "x" proven=string writers-known written-at-construction-alone filled

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, -, v3
    v5 = Undefined
    Return v5
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = TypeTest v1 testedType=string
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    PropSet v3, v1 key="x"
    Jump -> next b3()
  b2():
    v6 = String string="b"
    PropSet v3, v6 key="x"
    Jump -> next b3()
  b3():
    Return v3
}
