module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = PropGet v0 key="report" [isFreeName]
    v3 = NewClosure function=f1
    v4 = NewClosure function=f2
    v5 = NewClosure function=f3
    v6 = NewClosure function=f4
    v7 = Call v3, -, v1 calleeName="first"
    v8 = Call v5, -, v7 calleeName="read"
    v9 = Call v2, -, v8 calleeName="report"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v10 = Call v3, -, v1 calleeName="first"
    Jump -> next b3(v10)
  b2():
    v11 = Call v4, -, v1 calleeName="second"
    Jump -> next b3(v11)
  b3(v12):
    v13 = Call v6, -, v12 calleeName="readEither"
    v14 = Call v2, -, v13 calleeName="report"
    Return v14
}
