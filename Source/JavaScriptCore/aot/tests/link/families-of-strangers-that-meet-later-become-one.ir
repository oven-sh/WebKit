# If two families of strangers that meet stayed apart, whoever had read through the one before would never hear of what the other holds, and an escape of the one would leave the other closed
# function first(c) { return c ? { x: "a", p: 0 } : { x: true, q: 0 }; }  function second(c) { return c ? { x: 1, r: 0 } : { x: null, s: 0 }; }
# function read(o) { return o.x; }  read(first(flag));  const either = flag ? first(flag) : second(flag);  read2(either)
# The reader of the first pair was given its node before the pairs met. It is tied to the node of the other pair, so it finds what all four hold. Nothing has escaped
# RUN: link functions layouts mechanisms=all
# CHECK: function f3 callers-known one-callee {{*}}result=undefined|null|true|i32|string
# CHECK: function f4 callers-known one-callee {{*}}result=undefined|null|true|i32|string
# CHECK: layout L0 changes=[]
# CHECK: layout L1 changes=[]
# CHECK: layout L2 changes=[]
# CHECK: layout L3 changes=[]
# RUN(ANSWER): run-in-shell globalThis.flag = false; globalThis.report = value => print(String(value));
# ANSWER: true
# ANSWER-NEXT: null
# ANSWER-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none globalThis.flag = false; globalThis.report = value => print(String(value));
# NONE: true
# NONE-NEXT: null
# NONE-NEXT: exited with 0

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="p" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="q" declared={type=anything} flags=[IsRequired]}]
layout L2 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="r" declared={type=anything} flags=[IsRequired]}]
layout L3 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}, {key="s" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="flag" [isFreeName]
    v2 = PropGet v0 key="report" [isFreeName]
    v3 = NewClosure function=f1
    v4 = NewClosure function=f2
    v5 = NewClosure function=f3
    v6 = NewClosure function=f4
    v7 = Call v3, -, v1 calleeName="first"
    v8 = Call v5, -, v7 calleeName="read"
    v9 = Call v2, -, v8 calleeName="report"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v10 = Call v3, -, v1 calleeName="first"
    Jump -> next b3(v10)
  b2():
    v11 = Call v4, -, v1 calleeName="second"
    Jump -> next b3(v11)
  b3(v12):
    v13 = Call v6, -, v12 calleeName="readEither"
    v14 = Call v2, -, v13 calleeName="report"
    Return v14
}
function f1 name="first" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = String string="a"
    v3 = NewObject -, v2, v1 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    Jump -> next b3(v4)
  b2():
    v5 = Boolean boolean=true
    v6 = NewObject -, v5, v1 layout=L1 fields=[0, 1]
    v7 = FinishObject v6
    Jump -> next b3(v7)
  b3(v8):
    Return v8
}
function f2 name="second" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    v3 = NewObject -, v2, v1 layout=L2 fields=[0, 1]
    v4 = FinishObject v3
    Jump -> next b3(v4)
  b2():
    v5 = Null
    v6 = NewObject -, v5, v1 layout=L3 fields=[0, 1]
    v7 = FinishObject v6
    Jump -> next b3(v7)
  b3(v8):
    Return v8
}
function f3 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f4 name="readEither" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
