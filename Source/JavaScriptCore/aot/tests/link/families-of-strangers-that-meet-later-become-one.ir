# If two families of strangers that meet stayed apart, whoever had read through the one before would never hear of what the other holds, and an escape of the one would leave the other closed
# function first(c) { switch (c) { case 1: return { x: "a", p: 0 }; case 2: return { x: "b", t: 0 }; case 3: return { x: "c", u: 0 }; case 4: return { x: "d", v: 0 }; default: return { x: true, q: 0 }; } }
# function second(c) { switch (c) { case 1: return { x: 1, r: 0 }; case 2: return { x: 2, w: 0 }; case 3: return { x: 3, y: 0 }; case 4: return { x: 4, z: 0 }; default: return { x: null, s: 0 }; } }
# function read(o) { return o.x; }  read(first(flag));  const either = flag ? first(flag) : second(flag);  readEither(either)
# Five meet in what each function gives, one more than a set takes, so they are lost: two families. The reader of the first five was given its node before the families met. It is tied to the node of the other five, so it finds what all ten hold. Nothing has escaped
# RUN: link functions layouts mechanisms=all
# CHECK: function f3 callers-known one-callee {{*}}result=undefined|null|true|int[0, 2147483647]|string
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9
# CHECK: function f4 callers-known one-callee {{*}}result=undefined|null|true|int[0, 2147483647]|string
# CHECK-NEXT: parameter 0 {{*}}proven=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9
# CHECK: layout L0 {{*}}changes=[]
# CHECK: layout L1 {{*}}changes=[]
# CHECK: layout L2 {{*}}changes=[]
# CHECK: layout L3 {{*}}changes=[]
# CHECK: layout L4 {{*}}changes=[]
# CHECK: layout L5 {{*}}changes=[]
# CHECK: layout L6 {{*}}changes=[]
# CHECK: layout L7 {{*}}changes=[]
# CHECK: layout L8 {{*}}changes=[]
# CHECK: layout L9 {{*}}changes=[]
# RUN(ANSWER): run-in-shell globalThis.flag = false; globalThis.report = value => print(String(value));
# ANSWER: true
# ANSWER-NEXT: null
# ANSWER-NEXT: exited with 0
# RUN(NONE): run-in-shell mechanisms=none globalThis.flag = false; globalThis.report = value => print(String(value));
# NONE: true
# NONE-NEXT: null
# NONE-NEXT: exited with 0

