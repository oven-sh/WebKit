# If a field that every way through the constructor defines did not count as filled, a read of it on a proven layout would be a guess: closed in straight code, behind a look at the slot in a loop, and undefined would lie in all that is computed from it. If a field that one way leaves out counted as filled, a read of it would hand out the mark of an empty slot
# class P { constructor(v) { this.x = v; if (typeof v === "string") this.y = v; this.z = v; } }  function get(p) { return p.x; }  function maybe(p) { return p.y; }  const p = new P("a"); get(p); maybe(p);
# RUN: summary f1
# CHECK: construction Allocated fills ["x", "z"] looks-up ["x", "y", "z"]
# CHECK-NOT: seen-from-outside
# RUN(LINK): link functions fields mechanisms=all
# LINK: function f2 {{*}}result=string
# LINK: function f3 {{*}}result=undefined|string
# LINK: field L0.0 "x" proven=string writers-known written-at-construction-alone filled
# LINK: field L0.2 "z" proven=string writers-known written-at-construction-alone filled
# RUN(EMPTY): link fields mechanisms=all
# EMPTY-NOT: field L0.1 "y" {{*}}filled

layout L0 kind=Instance name="P" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}, {key="z" declared={type=anything}}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = String string="a"
    v4 = Construct v2, -, v3
    v5 = NewClosure function=f2
    v6 = Call v5, -, v4 calleeName="get"
    v7 = NewClosure function=f3
    v8 = Call v7, -, v4 calleeName="maybe"
    v9 = Undefined
    Return v9
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    v5 = TypeTest v1 testedType=string
    Branch v5 -> taken b1(), notTaken b2()
  b1():
    PropSet v3, v1 key="y"
    Jump -> next b2()
  b2():
    PropSet v3, v1 key="z"
    Return v3
}
function f2 name="get" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f3 name="maybe" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="y"
    Return v1
}
