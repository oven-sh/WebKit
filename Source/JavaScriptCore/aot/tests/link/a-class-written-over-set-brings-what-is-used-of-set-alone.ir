# class Tags extends Set {} new Tags().size
# The front end writes down which built-in class stands right above a layout. Set is constructed, objects lie below Set and Set.prototype, and their members are found by the names that code reads: nothing more is used.
# If the class above were let go, every member of it would count as used in every way: an executable with one such class would keep Set.prototype.difference, union ..
# The controls stand beside this file: a-class-written-over-set-*.ir, a-class-over-one-of-two-built-in-classes-lets-both-go.ir.
# RUN: features
# CHECK-NOT: by SetPrototypeDifference

layout L0 kind=Instance name="Tags" module=m0 constructor=f1 flags=[HasHeritage]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Set
    v1 = ResolveHeritage v0
    v2 = NewClosure function=f1
    v3 = NewClass v2, v0, v1 layout=L0
    v4 = FinishClass v3 layout=L0
    v5 = Construct v4, -
    v6 = PropGet v5 key="size"
    Return v6
}
function f1 name="Tags" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=anything}] constructedClass=L0 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L0
    Return v3
}
