# export const outer = { list: [Array.prototype.map], inner: { some: Array.prototype.some } };
# Built-ins nested in arrays and objects count too.
# OPTIONS: exclude=CodeOutsideImage
# LIBRARY: own
# RUN: link functions variables mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: function f2 unreached
# CHECK: function f3 unreached

layout L0 module=m0 fields=[{key="list" declared={type=anything} flags=[IsRequired]}, {key="inner" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
layout L1 module=m0 fields=[{key="some" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="outer" module=m0 declared={type=anything} initialization=Uninitialized
module m0 path="main.js" displayPath="main.js" body=f0 exports=[{name="outer" variable=g0}]
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app", "stop"]}, {exportName="then"}]
runtimefunction id=ArrayPrototypeFilter function=f3
runtimefunction id=ArrayPrototypeMap function=f1
runtimefunction id=ArrayPrototypeSome function=f2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=ArrayPrototypeMap
    v1 = NewArray v0 contents=anything
    v2 = Builtin builtin=ArrayPrototypeSome
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v1, v4 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    PutModuleVariable v6 variable=g0
    v8 = Undefined
    Return v8
}
function f1 name="map" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeMap thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f2 name="some" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeSome thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
function f3 name="filter" module=m1 kind=Method role=Library flags=[HasThis, HasExplicitName] length=1 enclosingRuntimeFunction=ArrayPrototypeFilter thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v0
}
