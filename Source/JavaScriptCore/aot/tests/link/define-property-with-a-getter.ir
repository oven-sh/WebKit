# If a definition by descriptor counted as a plain store, or as nothing, a read of the field would be compiled as a load of its slot and proven a string, where JavaScript runs the getter. And the getter, which nothing calls by name, would be left out of the executable
# function arm(o, d) { Object.defineProperty(o, "x", d); }  function read(o) { return o.x; }  const o = { x: "a" };  arm(o, { get() { return true; } }); read(o);
# RUN: summary f1
# CHECK: change {{*}} v4 DefinesByDescriptor Parameter 0 {{*}}other=Parameter 1
# RUN(LINK): link functions layouts mechanisms=all
# LINK: function f2
# LINK-NOT: result=string
# LINK-NOT: result=undefined|string
# LINK: function f3
# LINK-NOT: unreached
# LINK: layout L0 changes=[{{*}}GetsAccessor

layout L0 module=m0 fields=[{key="x" declared={type=anything} flags=[IsRequired]}]
layout L1 module=m0 fields=[{key="get" declared={type=anything} flags=[IsRequired, IsMethod]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f3
    v4 = NewObject -, v3 layout=L1 fields=[0]
    v5 = FinishObject v4
    v6 = NewClosure function=f1
    v7 = Call v6, -, v2, v5 calleeName="arm"
    v8 = NewClosure function=f2
    v9 = Call v8, -, v2 calleeName="read"
    v10 = Undefined
    Return v10
}
function f1 name="arm" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Builtin builtin=ObjectDefineProperty [isNotReadFromHolder]
    v3 = String string="x"
    v4 = Call v2, -, v0, v3, v1
    v5 = Undefined
    Return v5
}
function f2 name="read" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="x"
    Return v1
}
function f3 name="get" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Boolean boolean=true
    Return v0
}
