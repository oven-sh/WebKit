# The red side of a-star-import-hands-out-no-export-by-itself.ir: the object goes to a function that nobody has seen, which finds every export on it and calls it with whatever it likes.
# lib.ts: export function check(x: number): number { return x + 1; }   main.ts: import * as ns from "./lib.js"; print(ns); ns.check(1);
# RUN: link functions mechanisms=all
# CHECK-NOT: function f2 callers-known

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="lib.js" displayPath="lib.js" flags=[IsImportedAsNamespace] body=f1 exports=[{name="check" variable=g0}]
entry module=m0
variable g0 name="check" module=m1 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = ModuleNamespace module=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = Call v2, -, v0 calleeName="print"
    v4 = GetModuleVariable variable=g0
    v5 = Integer integer=1
    v6 = Call v4, v0, v5 calleeKey="check" calleeName="ns.check"
    Return v6
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="check" module=m1 length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Integer integer=1
    v2 = Add v0, v1
    Return v2
}
