# main.mjs, the entry: await 0; export default { port: 0, fetch() { return 1; } }: the host finds one of its names on the default export of an entry that awaits, and calls what it holds.
# The control: es-entry-that-awaits-and-whose-default-has-none-of-the-names-hands-the-host-nothing.ir.
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions modules lookups mechanisms=all
# CHECK-NOT: function f1 unreached
# CHECK-NOT: lookup entry-hands-host-nothing 0
# CHECK: lookup called-out-of-sight ObjectKeys
# CHECK-NOT: lookup entry-hands-host-nothing 0

layout L0 module=m0 fields=[{key="fetch" declared={type=anything} flags=[IsRequired, IsMethod]}, {key="port" declared={type=anything} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
variable g0 name="default" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait] body=f0 exports=[{name="default" variable=g0}]
function f0 module=m0 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = Await v0
    v2 = Integer
    v3 = NewClosure function=f1
    v4 = NewObject -, v2, v3 layout=L0 fields=[1, 0]
    v5 = FinishObject v4
    PutModuleVariable v5 variable=g0
    v7 = Undefined
    Return v7
}
function f1 name="fetch" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
entry module=m0 hostReads=[{exportName="default" builtin=ObjectKeys namesLookedFor=["fetch", "app"]}, {exportName="then"}]
