function f7 name="other" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="wrap" [isFreeName]
    v2 = NewClosure function=f5
