# A class that an immutable variable holds from its declaration on is known to whoever constructs it, calls a static method or reads a static accessor or field: what runs is the code of the class. A static accessor is entered, a method that a descriptor defines anew and a class in a variable that is stored into again are any code
# class Vector { constructor(x) { this.x = x; } static make(a) { return new Vector(a); } static get zero() { return 0; } static get unknown() { return stranger(); } }  class Point extends Vector { constructor(x) { super(x); this.y = 1; } }
# function makes(n) { return Vector.make(n); }  function constructs(n) { return new Point(n); }  function reads() { return Vector.zero; }  function enters() { return Vector.unknown; }  function other(n) { return new Other(n); }
# RUN: link functions mechanisms=all
# CHECK: function f4 {{*}}returns=[{{*}}mayCallUnknownCode
# CHECK: function f5 {{*}}returns=[{{*}}mayCallUnknownCode
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}mayCallUnknownCode
# NEVER-NOT: function f2 {{*}}mayCallUnknownCode
# NEVER-NOT: function f3 {{*}}mayCallUnknownCode
# NEVER-NOT: function f6 {{*}}mayCallUnknownCode
# NEVER-NOT: function f10 {{*}}mayCallUnknownCode

