    v12 = NewClass v11, v8, v10 layout=L1
    v13 = FinishClass v12 layout=L1
    PutModuleVariable v13 variable=g1
    v15 = NewClosure function=f11
    v16 = NewClass v15 layout=L2
    v17 = FinishClass v16 layout=L2
    PutModuleVariable v17 variable=g2
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="unknown" [isFreeName]
    PutModuleVariable v20 variable=g2
    v22 = Integer integer=1
    v23 = NewClosure function=f1
    v24 = Call v23, -, v22 calleeName="makes"
    v25 = NewClosure function=f2
    v26 = Call v25, -, v22 calleeName="constructs"
    v27 = NewClosure function=f3
    v28 = Call v27 calleeName="reads"
    v29 = NewClosure function=f4
    v30 = Call v29 calleeName="enters"
    v31 = NewClosure function=f5
    v32 = Call v31, -, v22 calleeName="other"
    v33 = Undefined
    Return v33
}
