# A class below a class is linked when it is made, so a read through their family finds the method and nothing else: what is owed to a constructor function that is linked by a statement is not charged here.
#   class Base { hello() { return 1; } }  class Below extends Base {}  function read(o) { return o.hello; }  sink(read(new Base()), read(new Below()));
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=f3
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}result=undefined

layout L0 kind=Instance name="Base" module=m0 constructor=f2
layout L1 kind=Instance name="Below" module=m0 base=L0 constructor=f4 supertypes=[L0] flags=[HasHeritage]
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
variable g1 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f3
    DefineMethod v3, v5 layout=L0 key="hello"
    v7 = FinishClass v3 layout=L0
    v8 = Convert v7 declared={type=f2 flags=[IsFromCompiler]}
    v9 = ResolveHeritage v8
    v10 = NewClosure function=f4
    v11 = NewClass v10, v8, v9 layout=L1
    PutModuleVariable v11 variable=g1
    v13 = FinishClass v11 layout=L1
    v14 = Convert v13 declared={type=f4 flags=[IsFromCompiler]}
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="sink" [isFreeName]
    v17 = Construct v8 calleeName="Base"
    v18 = Call v1, -, v17 calleeName="read"
    v19 = Construct v14 calleeName="Below"
    v20 = Call v1, -, v19 calleeName="read"
    v21 = Call v16, -, v18, v20 calleeName="sink"
    v22 = Undefined
    Return v22
}
function f1 name="read" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="hello"
    Return v1
}
function f2 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0}
    Return v3
}
function f3 name="hello" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
function f4 name="Below" module=m0 kind=DerivedConstructor flags=[HasRestParameter, HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} parameters=[{type=Array flags=[IsFromCompiler]}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything, v2: Array):
    v3 = GetSuperBase v0
    v4 = SuperConstructList v3, v1, v2 layout=L1
    v5 = Convert v4 declared={type=L1}
    Return v5
}
