# process.nextTick(() => {}), and the function of the library that makes the queue of ticks lets $makeErrorWithCode go
# The control of type-that-a-row-which-makes-nothing-answered-first-is-looked-at-again-for-a-row-of-the-host.ir: the last row of $makeErrorWithCode answers `any`, and it is a row of native code.
# LIBRARY: own
# RUN: link functions mechanisms=all
# REQUIRES: entries-of-bun
# CHECK-NOT: function f2 unreached
# CHECK-NOT: function f3 unreached

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="/$bun/js/builtins/ProcessObjectInternals.ts" displayPath="/$bun/js/builtins/ProcessObjectInternals.ts" flags=[IsLibrary]
module m2 path="/$bun/js/builtins/Glob.ts" displayPath="/$bun/js/builtins/Glob.ts" flags=[IsLibrary]
entry module=m0
runtimefunction id=GlobScan function=f2
runtimefunction id=ProcessObjectInternalsInitializeNextTickQueue function=f3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=Process
    v1 = PropGet v0 key="nextTick"
    v2 = Convert v1 declared={type=builtin(ProcessNextTick) flags=[IsExpected]}
    v3 = NewClosure function=f1
    v4 = Call v2, v0, v3 calleeKey="nextTick" calleeName="process.nextTick"
    Return v4
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
}
function f2 name="scan" module=m2 kind=Method role=Library flags=[HasExplicitName] length=1 enclosingRuntimeFunction=GlobScan thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="initializeNextTickQueue" module=m1 kind=Method role=Library flags=[HasExplicitName] length=3 enclosingRuntimeFunction=ProcessObjectInternalsInitializeNextTickQueue thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Builtin builtin=PrivateGlobalsMakeErrorWithCode
    v4 = Call v0, -, v3
    Return v4
}
