# of a member Link says that it may be allocated whatever is reached, so the plan is asked
# RUN: plan layouts mechanisms=all
# CHECK: layout L3 None never-allocated
# CHECK: layout [[member]] {{*}}never-allocated

layout L0 kind=Instance name="NodeMaker" module=m0 constructor=f1 fields=[{key="kind" declared={type=number} flags=[IsRequired] originLayout=L1 originField=0}, {key="pos" declared={type=number} flags=[IsRequired] originLayout=L1 originField=1}] supertypes=[L1] flags=[IsConstructorFunction] ownFieldCount=2
