layout L2 name="Num" module=m0 fields=[{key="kind" declared={type=1} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] supertypes=[L1] flags=[IsNeverAllocated] declaredOrder=[0, 2, 1] ownFieldCount=3
layout L3 name="Str" module=m0 fields=[{key="kind" declared={type=2} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="text" declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}] supertypes=[L1] flags=[IsNeverAllocated] declaredOrder=[0, 2, 1] ownFieldCount=3
module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Construct v0, -, v1, v3 calleeName="NodeMaker"
    v5 = PropGet v2 key="report" [isFreeName]
    v6 = Call v5, -, v4 calleeName="report"
    Return v6
}
function f1 name="NodeMaker" module=m0 flags=[HasThis, IsChecked, HasExplicitName] length=2 thisType={type=undefined|null|L0 flags=[OmitsNull, OmitsUndefined]} parameters=[{type=number}, {type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: undefined|null|L0, v1: number, v2: anything):
