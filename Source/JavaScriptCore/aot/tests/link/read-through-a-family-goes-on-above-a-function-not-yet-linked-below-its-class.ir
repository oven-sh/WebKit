# The layouts are written with the link that `Object.setPrototypeOf(Sub.prototype, Base.prototype)` lays. An object that Sub made in front of that statement finds nothing of the class: its read goes on above the classes.
#   class Base { hello() { return 1; } }  function Sub() { this.a = 1; }  function read(o) { return o.hello; }
#   sink(read(new Base()), read(new Sub()));  Object.setPrototypeOf(Sub.prototype, Base.prototype);  sink(read(new Sub()));
# The read on one layout has always said so. The read through a family (`read` is handed both) gave the method alone: `typeof read(new Sub())` was folded to "function", silently.
# RUN: link functions mechanisms=all
# CHECK: function f2 {{*}}result=undefined|f4
# RUN(ALONE): link functions mechanisms=all
# ALONE-NOT: function f2 {{*}}result=f4

layout L0 kind=Instance name="Base" module=m0 constructor=f3
layout L1 kind=Instance name="Sub" module=m0 base=L0 constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=1
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
module m0 path="main.mjs" displayPath="main.mjs" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L0
    PutModuleVariable v5 variable=g0
    v7 = NewClosure function=f4
    DefineMethod v5, v7 layout=L0 key="hello"
    v9 = FinishClass v5 layout=L0
    v10 = Convert v9 declared={type=f3 flags=[IsFromCompiler]}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="sink" [isFreeName]
    v13 = Construct v10 calleeName="Base"
    v14 = Call v3, -, v13 calleeName="read"
    v15 = Construct v1 calleeName="Sub"
    v16 = Call v3, -, v15 calleeName="read"
    v17 = Call v12, -, v14, v16 calleeName="sink"
    v18 = Builtin builtin=Object
    v19 = Builtin builtin=ObjectSetPrototypeOf
    v20 = PropGet v1 key="prototype"
    v21 = PropGet v10 key="prototype"
    v22 = Call v19, v18, v20, v21 calleeName="Object.setPrototypeOf"
    v23 = Construct v1 calleeName="Sub"
    v24 = Call v3, -, v23 calleeName="read"
    v25 = Call v12, -, v24 calleeName="sink"
    v26 = Undefined
    Return v26
}
function f1 name="Sub" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Integer integer=1
    PropSet v0, v1 key="a"
    v3 = Undefined
    Return v3
}
function f2 name="read" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="hello"
    Return v1
}
function f3 name="Base" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Convert v2 declared={type=L0}
    Return v3
}
function f4 name="hello" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
