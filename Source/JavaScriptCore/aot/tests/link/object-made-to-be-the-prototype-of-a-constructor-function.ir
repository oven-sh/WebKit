# If a store under `prototype` always let the function go, `F.prototype = { .. }` and `G.prototype = Object.create(F.prototype)` would cost every older package its layouts.
# function F() { this.a = 1; }  F.prototype = { m: function () { return "F"; } };  function G() { this.b = 2; }  G.prototype = Object.create(F.prototype);  G.prototype.n = function () { return 5; };  new G().m();  new G().n();  new F();
# The body makes the object, stores it under `prototype` and does nothing else with it but store into it under names. So the summary knows it as what a read of that `prototype` gives, and the store says that it was made for it.
# RUN(SCAN): summary f0
# SCAN: Read Closure f1 "prototype"
# SCAN: Store Closure f1 "prototype" {{*}}made-for-it
# SCAN: Store Closure f2 "prototype" {{*}}made-for-it
# SCAN: ChangesPrototype
# SCAN-NOT: BecomesPrototype
# RUN: link functions calls fields members layouts mechanisms=all
# CHECK: function f3 callers-known one-callee {{*}}result=string
# CHECK: function f4 callers-known one-callee {{*}}result=int[0, 2147483647]
# CHECK: field L0.0 "a" proven=int[0, 2147483647] writers-known
# CHECK: field L1.0 "b" proven=int[0, 2147483647] writers-known
# CHECK: on-prototype L0 "m" function=f3
# CHECK: on-prototype L1 "n" function=f4
# CHECK: layout L0 {{*}}changes=[]
# CHECK: layout L1 {{*}}changes=[]
# An object that the body also hands to somebody else is followed by nobody: the function and its layout go.
# CHECK: layout L2 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]
# So they do below null, where no lookup comes to Object.prototype.
# CHECK: layout L3 changes=[IsFrozen, GainsProperty, LosesProperty, ChangesPrototype, GetsAccessor]

layout L0 kind=Instance name="F" module=m0 constructor=f1 fields=[{key="a" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L1 kind=Instance name="G" module=m0 base=L0 constructor=f2 fields=[{key="b" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L2 kind=Instance name="H" module=m0 constructor=f5 fields=[{key="c" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
layout L3 kind=Instance name="N" module=m0 constructor=f6 fields=[{key="d" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction]
variable g0 name="kept" module=m0
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewDictionary
    v2 = NewClosure function=f3
    PropDefine v1, v2 key="m"
    PropSet v0, v1 key="prototype"
    v5 = NewClosure function=f2
    v6 = Builtin builtin=Object
    v7 = Builtin builtin=ObjectCreate
    v8 = PropGet v0 key="prototype"
    v9 = Call v7, v6, v8 calleeName="Object.create"
    PropSet v5, v9 key="prototype"
    v11 = PropGet v5 key="prototype"
    v12 = NewClosure function=f4
    PropSet v11, v12 key="n"
    v14 = Construct v5
    v15 = PropGet v14 key="m"
    v16 = Call v15, v14 calleeKey="m"
    v17 = Construct v5
    v18 = PropGet v17 key="n"
    v19 = Call v18, v17 calleeKey="n"
    v20 = Construct v0
    v21 = NewClosure function=f5
    v22 = NewDictionary
    PropSet v21, v22 key="prototype"
    PutModuleVariable v22 variable=g0
    v25 = Construct v21
    v26 = NewClosure function=f6
    v27 = Null
    v28 = Call v7, v6, v27 calleeName="Object.create"
    PropSet v26, v28 key="prototype"
    v30 = Construct v26
    Return v16
}
function f1 name="F" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Integer integer=1
    PropSet v0, v1 key="a"
    v3 = Undefined
    Return v3
}
function f2 name="G" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Integer integer=2
    PropSet v0, v1 key="b"
    v3 = Undefined
    Return v3
}
function f3 module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="F"
    Return v1
}
function f4 module=m0 flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=5
    Return v1
}
function f5 name="H" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L2 flags=[IsExpected]} results=[{type=anything}] constructedClass=L2 {
  b0(v0: L2):
    v1 = Integer integer=3
    PropSet v0, v1 key="c"
    v3 = Undefined
    Return v3
}
function f6 name="N" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L3 flags=[IsExpected]} results=[{type=anything}] constructedClass=L3 {
  b0(v0: L3):
    v1 = Integer integer=4
    PropSet v0, v1 key="d"
    v3 = Undefined
    Return v3
}
