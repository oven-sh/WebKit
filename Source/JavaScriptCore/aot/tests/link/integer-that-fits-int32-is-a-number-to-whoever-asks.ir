# If a mask that says Primitive::Number or Primitive::Integer cut away the integers that fit int32, `(5).toFixed(2)` would find no member and give nothing, the 1 of `"abc".charAt(1)` would fit no row, a read under `0` would count as a read under any name, and a test for a number would let no 5 pass
# function fixed(n) { return n.toFixed(2); }  function letter(text, i) { return text.charAt(i); }  function at(list, i) { return list[i]; }  function only(n) { return typeof n === "number" ? n : "none"; }  fixed(5);  letter("a", 5);  at(["a"], 0);  only(5);
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}result=string returns
# CHECK-NEXT: parameter 0 {{*}}proven=int[0, 2147483647]
# CHECK: function f2 {{*}}result=string returns
# CHECK: parameter 1 {{*}}proven=int[0, 2147483647]
# CHECK: function f3 {{*}}result=undefined|string returns
# CHECK: parameter 1 {{*}}proven=int[0, 2147483647]
# CHECK: function f4 {{*}}result=int[0, 2147483647]|string returns

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=5
    v1 = NewClosure function=f1
    v2 = Call v1, -, v0 calleeName="fixed"
    v3 = NewClosure function=f2
    v4 = String string="a"
    v5 = Call v3, -, v4, v0 calleeName="letter"
    v6 = NewArray v4 contents=anything
    v7 = Integer integer=0
    v8 = NewClosure function=f3
    v9 = Call v8, -, v6, v7 calleeName="at"
    v10 = NewClosure function=f4
    v11 = Call v10, -, v0 calleeName="only"
    v12 = Undefined
    Return v12
}
function f1 name="fixed" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="toFixed"
    v2 = Integer integer=2
    v3 = Call v1, v0, v2 calleeKey="toFixed"
    Return v3
}
function f2 name="letter" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="charAt"
    v3 = Call v2, v0, v1 calleeKey="charAt"
    Return v3
}
function f3 name="at" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
function f4 name="only" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    Return v2
  b2():
    v3 = String string="none"
    Return v3
}
