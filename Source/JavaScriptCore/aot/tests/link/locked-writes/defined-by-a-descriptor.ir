    v3 = String string="w" @1
    v4 = NewClosure function=f1 @1
    v5 = NewObject layout=L1 @1
    PropDefine v5, v4 key="get" @1
    v7 = FinishObject v5 @1
    v8 = Call v1, v0, v2, v3, v7 @2
    v9 = String string="toString" @3
    v10 = Boolean @3
    v11 = NewObject layout=L0 @3
    PropDefine v11, v10 key="writable" @3
    v13 = FinishObject v11 @3
    v14 = Call v1, v0, v2, v9, v13 @4
    Return v14 @5
}
function f1 module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined
    Return v0
