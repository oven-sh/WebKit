# If a block counted only the edges that bring a name, a block that a test leads to and that an edge without any test leads to as well would look like one that the test alone leads to, and all() would be proven to take texts alone
# function all(id) { return id; }  function pick(id, way) { switch (way) { case 1: if (typeof id !== "string") return 0; } return all(id); }  pick("a", 1);  pick(2, 0);
# The last edge of the switch says nothing of anything, so it brings no name at all. What comes along it is whole.
