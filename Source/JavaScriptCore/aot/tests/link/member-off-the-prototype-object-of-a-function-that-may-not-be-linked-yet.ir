# function Sub() { this.a = 1; }
# function read(p) { return p.hello; }
# function size(p) { return p.size; }
# read(Sub.prototype); size(Sub.prototype);
# Object.setPrototypeOf(Sub.prototype, Base.prototype);
# read(Sub.prototype); size(Sub.prototype);
