# the same store into an object that the caller has made is a write of the call: the caller may know what the field held
# function fill(o, a) { o.a = a; return o; }  fill({ a: 0 }, 1);
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}mayWriteObservableState{{*}}fields-written=1 layouts-written=1
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}layouts-written=none

layout L0 module=m0 fields=[{key="a" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Integer integer=1
    v4 = NewClosure function=f1
    v5 = Call v4, -, v2, v3
    v6 = Undefined
    Return v6
}
function f1 name="fill" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="a"
    Return v0
}
