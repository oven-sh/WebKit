# If a list of keys counted as no code whatever arrives, `for (const k in options)` on a proxy, whose ownKeys trap stores into a field, would leave the callers of open() with what they knew of that field in front of the call
# class P { }  function open(p) { for (const k in p) { } }  open(new P());  open(unknown);
# The twin of keys-of-an-object-of-the-program-are-listed-without-code.ir. What nobody knows may be a proxy.
# RUN: link functions mechanisms=all
# CHECK: function f2 {{*}}mayCallUnknownCode

layout L0 kind=Instance name="P" module=m0 constructor=f1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = NewClosure function=f2
    v5 = Call v4, -, v3 calleeName="open"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="unknown" [isFreeName]
    v8 = Call v4, -, v7 calleeName="open"
    v9 = Undefined
    Return v9
}
function f1 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="open" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ForInOpen v0
    v2 = Undefined
    Return v2
}
