# A further entry point answers to its name. Code that nobody knows needs nothing of the program to load it: `require(path)`, with a path that the build does not know, evaluates it here and now.
# Where that happens in the middle of a module that both entries import, the loader finds the module begun and passes it by, and the body of the second entry reads its bindings while it is unfinished.
# shared.js:  export let early = "a";  host();  export let late = "b";
# first.js:   import { early, late } from "./shared.js";  early + late;
# second.js:  the same
# Followed by itself, each start finds both stores in front of every read. `late` keeps the mark of emptiness all the same: `host` may have loaded the other entry. `early` was stored by then.
# If `late` lost the mark, the walk would fold the test away, and the second entry would hand on a value that is none where a ReferenceError is due.
# RUN: link variables mechanisms=all
# CHECK: variable g0 proven=string writers-known
# CHECK: variable g1 proven=string|absent
# RUN(WALK): walk f1 mechanisms=none+TypedOperations+Folding
# WALK-LABEL: code f1:
# WALK-COUNT-1: CheckInitialized
# WALK-NOT: CheckInitialized

variable g0 name="early" module=m2 declared={type=anything|absent}
variable g1 name="late" module=m2 declared={type=anything|absent}
module m0 path="first.js" displayPath="first.js" body=f0 requests=[{target=m2 completes=true}]
module m1 path="second.js" displayPath="second.js" body=f1 requests=[{target=m2 completes=true}]
module m2 path="shared.js" displayPath="shared.js" body=f2 exports=[{name="early" variable=g0}, {name="late" variable=g1}]
entry module=m0
entry module=m1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="early"
    v2 = GetModuleVariable variable=g1
    v3 = CheckInitialized v2 name="late"
    v4 = Add v1, v3
    Return v4
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="early"
    v2 = GetModuleVariable variable=g1
    v3 = CheckInitialized v2 name="late"
    v4 = Add v1, v3
    Return v4
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="host" [isFreeName]
    v4 = Call v3 calleeName="host"
    v5 = String string="b"
    PutModuleVariable v5 variable=g1
    v7 = Undefined
    Return v7
}
