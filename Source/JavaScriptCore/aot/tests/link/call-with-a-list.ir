# If the one node that stands for the elements of an argument list were read as the first argument, the first parameter alone would get a type, and the second would be proven to hold nothing while a boolean arrives
# function take(a, b) { return b; }  take(...["a", true]);
# How long the list is nobody knows, so what its elements hold may arrive at every parameter, and so may undefined: `take(...["a"])` leaves the same summary.
# RUN: summary f0
# CHECK: call c0 v4 Value Closure f1 ([[elements]]) passes-list
# CHECK: access [[elements]] v4 Read ClassInstance Array #2 contents Element -> [[elements]]
# RUN(LINK): link calls functions mechanisms=all
# LINK: call f0 v4 -> f1
# LINK: function f1 callers-known one-callee {{*}}result=undefined|true|string
# LINK-NEXT: parameter 0 {{*}}proven=undefined|true|string
# LINK-NEXT: parameter 1 {{*}}proven=undefined|true|string

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="a"
    v1 = Boolean boolean=true
    v2 = NewArray v0, v1 contents=anything
    v3 = NewClosure function=f1
    v4 = CallList v3, -, v2 calleeName="take"
    v5 = Undefined
    Return v5
}
function f1 name="take" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Return v1
}
