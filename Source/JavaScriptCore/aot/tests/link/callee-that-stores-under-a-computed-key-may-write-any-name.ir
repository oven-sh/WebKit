# under a key that nobody knows the store may find any setter, so the callee may do anything and no name is told apart
# function bump(c, k) { c[k] = 1; }  bump({ n: 0, m: 0 }, globalThis.key);
# RUN: link functions mechanisms=all
# CHECK: function f1 {{*}}mayCallUnknownCode
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}fields-written
# NEVER-NOT: function f1 {{*}}layouts-written

layout L0 module=m0 fields=[{key="n" declared={type=anything} flags=[IsRequired]}, {key="m" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0, v0 layout=L0 fields=[0, 1]
    v2 = FinishObject v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="key" [isFreeName]
    v5 = NewClosure function=f1
    v6 = Call v5, -, v2, v4
    Return v6
}
function f1 name="bump" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=1
    ElemSet v0, v1, v2
    v4 = Undefined
    Return v4
}
