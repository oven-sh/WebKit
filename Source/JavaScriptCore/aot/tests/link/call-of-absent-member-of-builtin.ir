# `if (typeof Reflect.decorate === "function") Reflect.decorate(target)`: nobody lays the member, so the closure is handed to nobody.
# OPTIONS: exclude=CodeOutsideImage,UnlistedGlobals
# RUN: link functions mechanisms=all
# CHECK: function f1 callers-known

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=Reflect
    v2 = PropGet v1 key="decorate"
    v3 = Call v2, v1, v0 calleeKey="decorate" calleeName="Reflect.decorate"
    v4 = PropGet v1 key="metadata"
    v5 = Call v4, -, v0 calleeName="metadata"
    v6 = Integer integer=1
    v7 = Call v0, -, v6 calleeName="target"
    Return
}
function f1 name="target" module=m0 length=1 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
