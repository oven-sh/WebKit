# the run at the bottom writes and throws, the run above it catches and returns: one function is both, so what it writes on its way to a throw counts on return too
# function dig(o, d) { if (!d) { o.bad = 1; throw 1; } try { dig(o, 0); } catch { } }
# RUN: summary f1
# CHECK: access {{*}}Store Parameter 0 "bad" {{*}}on-no-way-to-return
# RUN(LINK): link functions mechanisms=all
# LINK: function f1 {{*}}fields-written-on-return=1 fields-written=1

layout L0 module=m0 fields=[{key="bad" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = Integer integer=1
    v4 = NewClosure function=f1
    v5 = Call v4, -, v2, v3
    Return v5
}
function f1 name="dig" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    Branch v1 -> taken b2(), notTaken b1()
  b1():
    v2 = Integer integer=1
    PropSet v0, v2 key="bad"
    Throw v2
  b2():
    v4 = NewClosure function=f1
    v5 = Integer
    Jump -> next b3()
  b3() handler=b4():
    v6 = Call v4, -, v0, v5
    Jump -> next b5()
  b4() role=CatchHandler:
    v7 = CatchValue
    Jump -> next b5()
  b5():
    v8 = Undefined
    Return v8
}
