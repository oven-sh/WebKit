# A call through the method table mentions an entry for every method of the family, and a family is all that lies under one name. `C.m` lies under the name too, but one call alone enters it, straight:
# it waits for that caller and takes what it leaves, and nothing leads to it from whoever calls `m` on something else. So it has no row, and no entry.
# class A { m() {} }  class B1 extends A { m() {} }  class B2 extends A { m() {} }  class C { m(n) { return n; } }  function f(x) { return x.m(); }  f(new A); f(new B1); f(new B2);  new C().m(1);
# RUN: link functions mechanisms=all
# CHECK: function f2 {{*}} in-queue-from-start
# CHECK: function f9 callers-known one-callee {{*}} takes-arrivals
# RUN(WHOLE): units-with-code f2:Body f7:Body f9:Body mechanisms=all
# WHOLE: unit f2:Body {{*}} bytes
# WHOLE: unit f7:Body {{*}} bytes
# WHOLE: unit f9:Body {{*}} bytes
# RUN(ENTRIES): units-with-code mechanisms=all
# ENTRIES-NOT: unit f9:TableEntry

layout L0 kind=Instance name="A" module=m0 constructor=f1
layout L1 kind=Instance name="B1" module=m0 base=L0 constructor=f3 supertypes=[L0] flags=[HasHeritage]
layout L2 kind=Instance name="B2" module=m0 base=L0 constructor=f5 supertypes=[L0] flags=[HasHeritage]
layout L3 kind=Instance name="C" module=m0 constructor=f8
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="m"
    v4 = FinishClass v1 layout=L0
    v5 = ResolveHeritage v4
    v6 = NewClosure function=f3
    v7 = NewClass v6, v4, v5 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="m"
    v10 = FinishClass v7 layout=L1
    v11 = ResolveHeritage v4
    v12 = NewClosure function=f5
    v13 = NewClass v12, v4, v11 layout=L2
    v14 = NewClosure function=f6
    DefineMethod v13, v14 layout=L2 key="m"
    v16 = FinishClass v13 layout=L2
    v17 = NewClosure function=f8
    v18 = NewClass v17 layout=L3
    v19 = NewClosure function=f9
    DefineMethod v18, v19 layout=L3 key="m"
    v21 = FinishClass v18 layout=L3
    v22 = NewClosure function=f7
    v23 = Construct v4
    v24 = Call v22, -, v23 calleeName="f" [isNeverInlined]
    v25 = Construct v10
    v26 = Call v22, -, v25 calleeName="f" [isNeverInlined]
    v27 = Construct v16
    v28 = Call v22, -, v27 calleeName="f" [isNeverInlined]
    v29 = Construct v21
    v30 = PropGet v29 key="m"
    v31 = Integer integer=1
    v32 = Call v30, v29, v31 calleeKey="m" [isNeverInlined]
    Return v32
}
function f1 name="A" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    Return v0
}
function f3 name="B1" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f4 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=4
    Return v0
}
function f5 name="B2" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L2
    Return v3
}
function f6 name="m" module=m0 kind=Method flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Integer integer=6
    Return v0
}
function f7 name="f" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="m"
    v2 = Call v1, v0 calleeKey="m"
    Return v2
}
function f8 name="C" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L3 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
function f9 name="m" module=m0 kind=Method flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
