# class Greeter { greet() { return "one" } }  class Other { greet() { return "two" } }  function greetingOf(greeter) { return greeter.greet() }  greetingOf(new Greeter()); greetingOf(new Other())
# Flow knows the two callees, so a validating build looks at what the read of `greet` answers: ValidateType and ValidateCallee use the read beside the call.
# They keep nothing of it. The call is resolved by its receiver all the same, as in any other build: an arm for each layout, and in the arm the look-up that validates the direct call.
# A validating build that dispatched on the callee in its place would never run the arms that every other build runs.
# FORM: AsRead
# RUN: pipeline ResolveCalls
# OPTIONS: validate
# CHECK: function f3
# CHECK: TypeTest v0 testedType=L0
# CHECK: ValidateLookup {{*}} key="greet"
# CHECK-NEXT: = CallDirect {{*}}function=f2
# CHECK: ValidateLookup {{*}} key="greet"
# CHECK-NEXT: = CallDirect {{*}}function=f5
# CHECK: function f4

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Greeter" constructor=f1
layout L1 kind=Instance name="Other" constructor=f4
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="greet"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = NewClosure function=f4
    v7 = NewClass v6 layout=L1
    v8 = NewClosure function=f5
    DefineMethod v7, v8 layout=L1 key="greet"
    v10 = FinishClass v7 layout=L1
    v11 = Construct v10
    v12 = NewClosure function=f3
    v13 = Call v12, -, v5
    v14 = Call v12, -, v11
    Return
}
function f1 name="Greeter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="greet" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="one"
    Return v1
}
function f3 name="greetingOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="greet"
    v2 = Call v1, v0 calleeKey="greet"
    Return v2
}
function f4 name="Other" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1 fields=[]
    Return v2
}
function f5 name="greet" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="two"
    Return v1
}
