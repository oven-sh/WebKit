# function pair(a, b) { const made = {}; made.x = a; made.y = b; return made }  print(pair("first", "second").y)
# The table of origins says that `pair` answers one object, made for the call, and lists all that was stored into it: `a` under x, `b` under y.
# A validating build tests behind the call that the result is an object, and of the type of the operation that makes it, reads each member that has a name,
# and tests that it holds one of the values that were stored under that name.
# The program never reads x. Flow has said so before the tests are put in, and a pass removes the field: the test leaves such a member alone
# FORM: AsRead
# RUN: valueflow-apply
# RUN(RUNS): run-in-shell void 0;
# OPTIONS: validate
# CHECK: v3: L0 = Call v0, -, v1, v2
# CHECK: = TypeTest v3 testedType=object
# CHECK: ValidateSameValue
# CHECK-NEXT: ValidateType v3 validatedType=L0
# CHECK-NEXT: v23: {{*}} = PropGet v3 key="y"
# CHECK: = StrictEq v23, v2
# CHECK: ValidateSameValue
# CHECK-NOT: PropGet v3 key="x"
# RUNS: second
# RUNS-NOT: AOT validation
# RUNS: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Pair" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="first"
    v2 = String string="second"
    v3 = Call v0, -, v1, v2
    v4 = PropGet v3 key="y"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="print" [isFreeName]
    v7 = Call v6, -, v4
    Return
}
function f1 name="pair" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] relations={subjects=[{}, {index=1}, {kind=Allocation index=2 fate=[IsReturned, HasMembersWritten] results=1}] stores=[{target=2 key="x" isOnEveryPath=true isBeforeTargetLeaves=true}, {source=1 target=2 key="y" isOnEveryPath=true isBeforeTargetLeaves=true}] resultsFullyListed=1} {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L0 fields=[]
    PropSet v2, v0 key="x" mode=Strict
    PropSet v2, v1 key="y" mode=Strict
    Return v2
}
