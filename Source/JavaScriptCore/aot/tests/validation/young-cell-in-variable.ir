# let held = { value: 0.5 };  const store = () => { held = { value: 1.5 } }, read = () => held.value
# A variable of the module lies outside the heap, so a store into it has no owner to run a barrier on: it marks the card of the variable, and a collection of the young looks at the marked cards alone.
# The first store marks the card, the collection of everything takes the mark away, and the cell that store() makes is named by the variable alone.
# FORM: AsRead
# RUN(SLOTS): plan-slots variables
# RUN: run-in-shell --verifyGC=1 globalThis.register = (store, read) => { gc(); store(); edenGC(); print(read()); };
# SLOTS: g0 Statics Plain Cell
# CHECK-NOT: GC Verifier
# CHECK: 1.5
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 name="Coin" fields=[{key="value" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Environment fields=[{key="held" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Double number=0.5
    v1 = NewObject layout=L1 fields=[]
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutEnvironmentField v1, v3 layout=L1 field=0
    v5 = NewClosure v1 function=f1
    v6 = NewClosure v1 function=f2
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="register" [isFreeName]
    v9 = Call v8, -, v5, v6
    Return
}
function f1 name="store" captures=[{type=env L1}] results=[{type=undefined}] {
  b0(v0: env L1):
    v1 = Double number=1.5
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutEnvironmentField v0, v3 layout=L1 field=0
    Return
}
function f2 name="read" captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    v2 = PropGet v1 key="value"
    Return v2
}
