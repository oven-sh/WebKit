# function readX(point: Point) { return point.x }  register(readX, { x: 1.5 }, { text: "label" })
# A typed function is entered through tests of its arguments, and its typed body takes what they let through for proven.
# The lie: the first type test of every function passes whatever it is given (drop-guard). That is the test of `point`, so a caller that nobody compiled gets an object of another layout into the typed body.
# A validating build tests the value that the passing edge hands on, finds the other layout and ends the process.
# With an object of the right layout the same build runs to its end: the dropped test would have passed
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (readX, point, label) => { print(readX(label)); };
# RUN(SAME): run-in-shell globalThis.register = (readX, point, label) => { print(readX(point)); };
# OPTIONS: validate drop-guard=TypeTest:0
# STATISTIC: FunctionsWithTypesCheckedAtEntry = 1
# CHECK: AOT validation: ValueType f
# CHECK: crashed with
# SAME-NOT: AOT validation
# SAME: 1.5
# SAME-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="Label" fields=[{key="text" declared={type=string} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Double number=1.5
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = String string="label"
    v5 = NewObject -, v4 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="register" [isFreeName]
    v9 = Call v8, -, v0, v3, v6
    Return
}
function f1 name="readX" parameters=[{type=L0 site=w0}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
