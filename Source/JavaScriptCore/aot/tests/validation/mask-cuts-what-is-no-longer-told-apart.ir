# function makeKept(): Kept  function makeOther(): Other  function take(kept: Kept) {}  take(makeKept())  makeOther()
# Past the limit on edges flow no longer tells callees apart: `makeKept()` may call whatever function has been made, so an Other stands in the set of its result. That is what flow cannot rule out,
# not what it knows to arrive, and the type of `kept` may take it away: a validating build reports nothing.
# FORM: AsRead
# RUN: pipeline AnalyzeFlow
# OPTIONS: validate limit=MaxValueFlowEdgesLogged:1
# LOSS: MaxValueFlowEdgesLogged

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
variable g0 name="makeKept" module=m0 declared={type=anything}
variable g1 name="makeOther" module=m0 declared={type=anything}
layout L0 name="Kept" fields=[{key="a" declared={type=number} flags=[IsRequired]}]
layout L1 name="Other" fields=[{key="b" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g0
    v2 = NewClosure function=f2
    PutModuleVariable v2 variable=g1
    v4 = GetModuleVariable variable=g0
    v5 = Call v4
    v6 = GetModuleVariable variable=g1
    v7 = Call v6
    v8 = NewClosure function=f3
    v9 = Call v8, -, v5
    Return
}
function f1 name="makeKept" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
}
function f2 name="makeOther" results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    Return v1
}
function f3 name="take" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = PropGet v0 key="a"
    Return
}
