# function constructs() { function Holder() {} return new Holder() }  register(constructs)
# Written as it is once the construction is resolved and the empty body is inlined: the caller reads the prototype property of new.target and allocates under it.
# To the program that is a read. The first read makes the property: the function gets another Structure, and a butterfly. So B3 is told that a call which looks at an object
# writes the header of cells and the word behind it (AOTHeaps::mayConvertCells()), and repeats what it has loaded from them.
# A validating build compares the header and the word behind it of each operand around a call that is said to convert nothing. This call is said to convert, so nothing is compared.
# SinkAllocations and PlaceTypeTests are off so that the allocation and the read of the property stay as they are written
# FORM: AsRead
# RUN: run-in-shell globalThis.register = constructs => { print(typeof constructs()); };
# OPTIONS: validate disable=pass:SinkAllocations,pass:PlaceTypeTests
# CHECK-NOT: AOT validation
# CHECK: object
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Holder" constructor=f2 flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="register" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f1 name="constructs" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Holder" thisType={type=anything} results=[{type=anything}] {
  b0():
    Return
}
