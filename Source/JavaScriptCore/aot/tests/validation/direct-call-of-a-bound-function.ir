# interface Holder { callback: () => string }  function listed() { return "listed" }  function run(holder: Holder) { return holder.callback() }  register(run, { callback: listed })
# A type lists functions by their definitions, and what it admits is a closure of one of them. A bound function is a member of its own: it has another cell, no captures to read and its own `this` and arguments,
# so it is outside a type that lists only its target, even where a call of it ends up in that target.
# The lie: a writer that nobody listed (`storeInSlotWithoutTest` of the shell) puts `listed.bind(null)` into the slot of `callback`. A default build prints the right answer here by luck: the direct call runs `listed` either way.
# The flow analysis is off, and the text says by hand what it would find: the field holds closures of `listed` alone (the function type of the source admits every function), the slot is always filled and the property never leaves it.
# Without the analysis any function object may get another name, and a call of one that a stack trace shows has to say which it entered. No stack trace shows `listed`, so its calls may be direct.
# A validating build puts ValidateCallee in front of a call that a type made direct, and that keeps the callee alive (the run with the prefix IR).
# What ends the process is the test of the read that was kept, a ValueType, for the reason that direct-call-of-another-closure.ir gives: the callee's own type is the list that ValidateCallee compares it with.
# With the slot left alone the same build runs to its end
# FORM: AsRead
# RUN(IR): pipeline ResolveCalls
# RUN: run-in-shell globalThis.register = (run, holder) => { storeInSlotWithoutTest(holder, "callback", holder.callback.bind(null)); print("stored"); print(run(holder)); };
# RUN(SAME): run-in-shell globalThis.register = (run, holder) => { print(run(holder)); };
# OPTIONS: validate disable=flow-results
# IR: [[callee]]: f2 = GetSlot {{*}} key="callback"
# IR: ValidateCallee [[callee]] validatedType=f2
# IR: = CallDirect function=f2
# CHECK: stored
# CHECK: AOT validation: ValueType f
# CHECK: crashed with
# SAME-NOT: AOT validation
# SAME: listed
# SAME-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=100 kind=Parameter
layout L0 name="Holder" fields=[{key="callback" declared={type=f2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f2
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    v3 = NewClosure function=f1
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v3, v2
    Return
}
function f1 name="run" parameters=[{type=L0 site=w0}] results=[{type=anything}] {
    v1 = PropGet v0 key="callback"
    v2 = Call v1, v0 calleeKey="callback"
    Return v2
}
function f2 name="listed" flags=[IsHiddenInStackTraces] results=[{type=anything}] {
    v0 = String string="listed"
    Return v0
}
