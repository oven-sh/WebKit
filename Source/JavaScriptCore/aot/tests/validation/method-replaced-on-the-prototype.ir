# class Greeter { greet() { return "as defined" } }  function greetingOf(greeter: Greeter) { return greeter.greet() }  register(greetingOf, new Greeter())
# A method lies on the prototype object of its class, which anybody who holds an instance can reach and write. So what the class definition put there is no fact about the layout of the instances.
# A method call on a receiver with a proven layout is a direct call all the same, behind one test of a bit of the class. The run time clears the bit as soon as the member is stored, redefined or deleted.
# The lie: that test passes whatever the bit says (drop-guard), as if the run time had missed the store or flow had called the member fixed. The caller has stored another function under `greet` on the prototype object.
# A validating build looks the name up in front of every method call that became direct, without running code of the program. It finds a function of another definition and ends the process.
# Beside it, in the same build: the prototype object gets a member of another name, which an instance that reached unknown code allows, and the prototype object is left alone.
# The program evaluates text, so code that the build has not seen runs: only such code climbs from an instance to the prototype object of its class
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (greetingOf, greeter) => { Object.getPrototypeOf(greeter).greet = () => "replaced"; print(greetingOf(greeter)); };
# RUN(OTHER): run-in-shell globalThis.register = (greetingOf, greeter) => { Object.getPrototypeOf(greeter).other = () => "replaced"; print(greetingOf(greeter)); };
# RUN(SAME): run-in-shell globalThis.register = (greetingOf, greeter) => { print(greetingOf(greeter)); };
# OPTIONS: validate drop-guard=AreMembersUnchanged:0 heat=OnlyLoopsAreHot
# CHECK: AOT validation: LookupDiffers f
# CHECK: crashed with
# OTHER-NOT: AOT validation
# OTHER: as defined
# OTHER-NEXT: exited with 0
# SAME-NOT: AOT validation
# SAME: as defined
# SAME-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=80 kind=Parameter
layout L0 kind=Instance name="Greeter" constructor=f1
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="greet"
    v4 = FinishClass v1 layout=L0
    v5 = Construct v4
    v6 = NewClosure function=f3
    v7 = Builtin builtin=Function
    v8 = String string="return globalThis.register"
    v9 = Construct v7, -, v8
    v10 = Call v9
    v11 = Call v10, -, v6, v5
    Return
}
function f1 name="Greeter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0 fields=[]
    Return v2
}
function f2 name="greet" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    v1 = String string="as defined"
    Return v1
}
function f3 name="greetingOf" parameters=[{type=L0 site=w0}] results=[{type=anything}] {
    v1 = PropGet v0 key="greet"
    v2 = Call v1, v0 calleeKey="greet"
    Return v2
