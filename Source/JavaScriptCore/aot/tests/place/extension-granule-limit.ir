    Return
}

# Eighteen rows want a granule, and there are eighteen.
# CHECK: L0 CompiledObject size=48 extension=152
# CHECK: .2 "fits1" OptionalDouble @40
# CHECK-NEXT: .3 "fits2" JSValue out@8
# CHECK: .20 "fits19" JSValue out@144
# Twenty-two want one. The four that are read most stay in the cell beside the two that fit anyway.
# CHECK: L1 CompiledObject size=80 extension=152
# CHECK: .6 "more5" OptionalDouble @72
# CHECK-NEXT: .7 "more6" JSValue out@8
# CHECK: .24 "more23" JSValue out@144
