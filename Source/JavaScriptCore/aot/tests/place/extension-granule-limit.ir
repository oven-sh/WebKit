  b0(v0: anything, v1: number):
    PropSet v0, v1 key="more0"
    PropSet v0, v1 key="more1"
    PropSet v0, v1 key="more2"
    PropSet v0, v1 key="more3"
    PropSet v0, v1 key="more4"
    PropSet v0, v1 key="more5"
    PropSet v0, v1 key="more6"
    PropSet v0, v1 key="more7"
    PropSet v0, v1 key="more8"
    PropSet v0, v1 key="more9"
    PropSet v0, v1 key="more10"
    PropSet v0, v1 key="more11"
    PropSet v0, v1 key="more12"
    PropSet v0, v1 key="more13"
    PropSet v0, v1 key="more14"
    PropSet v0, v1 key="more15"
    PropSet v0, v1 key="more16"
    PropSet v0, v1 key="more17"
    PropSet v0, v1 key="more18"
    PropSet v0, v1 key="more19"
    PropSet v0, v1 key="more20"
    PropSet v0, v1 key="more21"
    PropSet v0, v1 key="more22"
    PropSet v0, v1 key="more23"
    v26 = PropGet v0 key="more0"
    v27 = PropGet v0 key="more1"
    v28 = PropGet v0 key="more2"
    v29 = PropGet v0 key="more3"
    v30 = PropGet v0 key="more0"
    v31 = PropGet v0 key="more1"
    v32 = PropGet v0 key="more2"
    v33 = PropGet v0 key="more3"
    v34 = PropGet v0 key="more0"
    v35 = PropGet v0 key="more1"
    v36 = PropGet v0 key="more2"
    v37 = PropGet v0 key="more3"
    Return
}
