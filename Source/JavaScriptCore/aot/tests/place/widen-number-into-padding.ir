# A 4-byte number slot becomes an 8-byte double where its cell has free bytes for it. The most accessed slot goes first, and no cell grows
# FORM: AsRead
# OPTIONS: references=narrow only-passes=ResolveAccesses disable=flow:NarrowedTypes
# RUN: plan-slots

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="HasFreeBytes" fields=[{key="cold" declared={type=number predicted=i32} flags=[IsRequired]}, {key="hot" declared={type=number predicted=i32} flags=[IsRequired]}, {key="boxed" declared={type=anything} flags=[IsRequired]}, {key="filler" declared={type=i32} flags=[IsRequired]}]
layout L1 name="Full" fields=[{key="first" declared={type=number predicted=i32} flags=[IsRequired]}, {key="second" declared={type=number predicted=i32} flags=[IsRequired]}, {key="third" declared={type=i32} flags=[IsRequired]}]
layout L2 name="NeighborMoves" fields=[{key="small" declared={type=number predicted=i32} flags=[IsRequired]}, {key="large" declared={type=number predicted=i32} flags=[IsRequired]}, {key="neighbor" declared={type=i32} flags=[IsRequired]}, {key="payload" declared={type=anything} flags=[IsRequired]}, {key="last" declared={type=i32} flags=[IsRequired]}]
layout L3 name="NeighborStays" fields=[{key="minor" declared={type=number predicted=i32} flags=[IsRequired]}, {key="counted" declared={type=number predicted=i32} flags=[IsRequired]}, {key="adjacent" declared={type=i32} flags=[IsRequired]}, {key="content" declared={type=anything} flags=[IsRequired]}, {key="tail" declared={type=i32} flags=[IsRequired]}]
layout L4 name="BothWiden" fields=[{key="lower" declared={type=number predicted=i32} flags=[IsRequired]}, {key="upper" declared={type=number predicted=i32} flags=[IsRequired]}, {key="held" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Integer integer=1
    v4 = BitOr v2, v3
    v5 = Add v4, v4
    v6 = NewObject -, v3, v3, v1, v3 layout=L0 fields=[0, 1, 2, 3]
    v7 = FinishObject v6
    v8 = NewObject -, v3, v3, v3 layout=L1 fields=[0, 1, 2]
    v9 = FinishObject v8
    v10 = NewObject -, v3, v5, v3, v1, v3 layout=L2 fields=[0, 1, 2, 3, 4]
    v11 = FinishObject v10
    v12 = NewObject -, v3, v5, v3, v1, v3 layout=L3 fields=[0, 1, 2, 3, 4]
    v13 = FinishObject v12
    v14 = PropGet v7 key="cold"
    v15 = PropGet v7 key="hot"
    v16 = PropGet v7 key="hot"
    v17 = PropGet v13 key="counted"
    v18 = TypeTest v17 testedType=undefined|null
    v19 = NewObject -, v3, v3, v1 layout=L4 fields=[0, 1, 2]
    v20 = FinishObject v19
    Return
}
# The Extension word, "cold", "boxed", "hot" and "filler" end at 40, so 8 aligned bytes are free. "cold" is the first row and "hot" has the higher weight.
# CHECK: L0 CompiledObject size=48 extension=
# CHECK-NEXT: "cold" Int32OrDouble @20 double@
# CHECK-NEXT: "hot" Double @40 record=
# CHECK: L1 CompiledObject size=32 extension=
# CHECK-NEXT: "first" Int32OrDouble @20 double@
# CHECK-NEXT: "second" Int32OrDouble @24 double@
# "large" is stored an integer past the int32 range and never used as an integer. Only bytes 44 to 48 are free: "neighbor" moves there, and "large" takes its 4 bytes as well.
# CHECK: L2 CompiledObject size=48 extension=
# CHECK-NEXT: "small" Int32OrDouble @20 double@
# CHECK-NEXT: "large" Double @32 record=
# CHECK-NEXT: "neighbor" Int32 @44
# "counted" is stored the same and has a use as an integer.
# CHECK: L3 CompiledObject size=48 extension=
# CHECK-NEXT: "minor" Int32OrDouble @20 double@
# CHECK-NEXT: "counted" Int32OrDouble @32 double@
# CHECK-NEXT: "adjacent" Int32 @36
# The Extension word, "lower", "held" and "upper" end at 36. "lower" takes bytes 40 to 48, "upper" grows where it stands, and the layout loses its Extension.
# CHECK: L4 CompiledObject size=48 fields=3
# CHECK-NEXT: "lower" Double @40 record=
# CHECK-NEXT: "upper" Double @32 record=
# CHECK-NEXT: "held" JSValue @24
# CHECK-NOT: extension Cell32
