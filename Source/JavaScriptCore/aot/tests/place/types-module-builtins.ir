# import.meta, module, exports and require are one object per module, so the record of a type that names one tests for an object or a function, wherever the type is kept: a variable, a field, a parameter of a function called by value. A built-in of the realm keeps the test for its cell
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow
# RUN: tables
# RUN(META): tables types
# RUN(MODULE): tables types
# RUN(EXPORTS): tables types
# RUN(REQUIRE): tables types
# RUN(REALM): tables types
# RUN(CELLS): tables constants

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m1}]
module m1 path="/library.cjs" displayPath="library.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0
layout L0 name="Holder" fields=[{key="meta" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Wrapper" fields=[{key="exports" declared={type=anything} flags=[IsRequired]}, {key="require" declared={type=anything} flags=[IsRequired]}, {key="module" declared={type=anything} flags=[IsRequired]}]
variable g0 name="meta" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="holder" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="push" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="callback" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = ModuleBuiltin builtin=ImportMeta module=m0
    PutModuleVariable v0 variable=g0
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g1
    v5 = Builtin builtin=ArrayPrototypePush
    PutModuleVariable v5 variable=g2
    v7 = NewClosure function=f2
    PutModuleVariable v7 variable=g3
    v9 = NewClosure function=f3
    PutModuleVariable v9 variable=g3
    v11 = GetModuleVariable variable=g3
    v12 = Call v11, -, v0
    v13 = GetModuleVariable variable=g0
    v14 = GetModuleVariable variable=g1
    v15 = GetModuleVariable variable=g2
    Return
}
function f1 name="library" module=m1 kind=CommonJsModule flags=[IsSloppy, HasThis] parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything, v3: anything, v4: anything, v5: anything):
    v6 = NewObject -, v1, v2, v3 layout=L1 fields=[0, 1, 2]
    v7 = FinishObject v6
    Return
}
function f2 name="first" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
function f3 name="second" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Return v0
}
# CHECK: types {{*}}
# META: type builtin(ImportMeta) {{*}}primitives=0x0 tests=[IsObject()]
# MODULE: type builtin(ModuleObject) {{*}}primitives=0x0 tests=[IsObject()]
# EXPORTS: type builtin(ModuleObjectExports) {{*}}primitives=0x0 tests=[IsObject()]
# REQUIRE: type builtin(ModuleRequire) {{*}}primitives=0x0 tests=[IsCallable()]
# REALM: type builtin(ArrayPrototypePush) {{*}}primitives=0x0 tests=[IsBuiltinCell(ArrayPrototypePush)]
# CELLS: cell=ArrayPrototypePush
# CELLS-NOT: cell=ImportMeta
# CELLS-NOT: cell=Module
