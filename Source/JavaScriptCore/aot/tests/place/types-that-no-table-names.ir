# A type has a record in the image only if a table or compiled code names it. The tables name the type that the record of a field holds and the type of a static field.
# Nothing names the type of a module variable: the variable is a slot among the statics and compiled code knows what it holds.
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow
# RUN: tables types
# CHECK-NOT: type L0
# CHECK-NOT: type int[0, 255]
# CHECK: type L1 {{*}}tests=[ShapeIn({{*}})]
# CHECK-NOT: type L0
# CHECK-NOT: type int[0, 255]
# CHECK: type "kept"
# CHECK-NOT: type L0
# CHECK-NOT: type int[0, 255]

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="OnlyInAVariable" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="InAField" fields=[{key="y" declared={type=number} flags=[IsRequired]}]
layout L2 name="Holder" fields=[{key="held" declared={type=L1} flags=[IsRequired]}]
layout L3 kind=Instance name="Kept" constructor=f1 staticFields=[{key="word" variable=g2}]
variable g0 name="object" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="byte" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="word" module=m0 declared={type=anything} owner=L3
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L3
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = ToNumber v3
    v5 = NewObject -, v4 layout=L0 fields=[0]
    v6 = FinishObject v5
    PutModuleVariable v6 variable=g0
    v8 = Integer integer=0
    PutModuleVariable v8 variable=g1
    v10 = Integer integer=255
    PutModuleVariable v10 variable=g1
    v12 = String string="kept"
    PutModuleVariable v12 variable=g2
    v14 = NewObject -, v4 layout=L1 fields=[0]
    v15 = FinishObject v14
    v16 = NewObject -, v15 layout=L2 fields=[0]
    v17 = FinishObject v16
    v18 = PropGet v17 key="held"
    v19 = GetModuleVariable variable=g0
    v20 = GetModuleVariable variable=g1
    v21 = GetModuleVariable variable=g2
    v22 = FinishClass v1 layout=L3
    Return
}
function f1 name="Kept" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
