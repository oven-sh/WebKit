# A reused environment has a byte for its escape flag after its last field and a word of the statics for its free cell, and any other environment has neither
# FORM: AsRead
# OPTIONS: references=narrow only-passes=ReuseEnvironments
# RUN: plan-slots
# RUN(STATICS): place statics
# STATISTIC: EnvironmentsReused = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="iteration" fields=[{key="value" declared={type=anything}}]
layout L1 kind=Environment name="outer" fields=[{key="value" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    v3 = NewClosure v2 function=f2
    v4 = Call v1, -, v3
    v5 = NewObject -, v4 layout=L0 fields=[0]
    Jump -> next b1(v5)
  b1(v6):
    LoopHint
    v8 = GetEnvironmentField v6 layout=L0 field=0
    v9 = ToBoolean v8
    Branch v9 -> taken b2(), notTaken b3()
  b2():
    v10 = NewClosure v6 function=f1
    v11 = Call v1, -, v10
    Jump -> next b3()
  b3():
    v12 = Call v1, -, v8
    v13 = NewObject -, v12 layout=L0 fields=[0]
    v14 = ToBoolean v12
    Branch v14 -> taken b1(v13), notTaken b4()
  b4():
    Return
}
function f1 name="readIteration" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f2 name="readOuter" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}

# The flag makes the cell one size step larger here: 8 bytes of header, 8 of the field, 1 of the flag.
# CHECK: L0 Environment size=32 escaped@16
# CHECK-NEXT: .0 "value" JSValue @8
# CHECK-NEXT: L1 Environment size=16
# CHECK-NOT: escaped@
# CHECK: .0 "value" JSValue @8

# STATICS: free-cell L0 @[[cell]]
# STATICS-NOT: free-cell
# STATICS: cleared={{*}}[[cell]]+8]
