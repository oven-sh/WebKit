# A cell is a multiple of 16 bytes. Where a field that holds a small integer can have 32 bits and the cell stays as large as it is, it has them: the table of fields, which answers a read by name from a value of unknown type, has a form for 32 bits and none for 8 or 16
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow testing=NoLayoutIsMadeSeldom
# RUN: plan-slots layouts

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Byte" fields=[{key="a" declared={type=int[0, 255]} flags=[IsRequired]}]
layout L1 name="SignedByte" fields=[{key="a" declared={type=int[-128, 127]} flags=[IsRequired]}]
layout L2 name="Short" fields=[{key="a" declared={type=int[0, 65535]} flags=[IsRequired]}]
layout L3 name="SignedShort" fields=[{key="a" declared={type=int[-32768, 32767]} flags=[IsRequired]}]
layout L4 name="FourBytes" fields=[{key="a" declared={type=int[0, 255]} flags=[IsRequired]}, {key="b" declared={type=int[0, 255]} flags=[IsRequired]}, {key="c" declared={type=int[0, 255]} flags=[IsRequired]}, {key="d" declared={type=int[0, 255]} flags=[IsRequired]}]
layout L5 name="BesideText" fields=[{key="text" declared={type=string} flags=[IsRequired]}, {key="number" declared={type=number} flags=[IsRequired]}, {key="a" declared={type=int[0, 255]} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = ToString v1
    v4 = Integer integer=255
    v5 = Integer integer=65535
    v6 = BitAnd v2, v4
    v7 = BitAnd v2, v5
    v8 = Integer integer=-100
    v9 = Integer integer=-30000
    v10 = NewObject -, v6 layout=L0 fields=[0]
    v11 = FinishObject v10
    v12 = NewObject -, v8 layout=L1 fields=[0]
    v13 = FinishObject v12
    v14 = NewObject -, v7 layout=L2 fields=[0]
    v15 = FinishObject v14
    v16 = NewObject -, v9 layout=L3 fields=[0]
    v17 = FinishObject v16
    v18 = NewObject -, v6, v6, v6, v6 layout=L4 fields=[0, 1, 2, 3]
    v19 = FinishObject v18
    v20 = NewObject -, v3, v2, v6 layout=L5 fields=[0, 1, 2]
    v21 = FinishObject v20
    v22 = PropGet v11 key="a"
    v23 = PropGet v13 key="a"
    v24 = PropGet v15 key="a"
    v25 = PropGet v17 key="a"
    v26 = PropGet v19 key="a"
    v27 = PropGet v19 key="b"
    v28 = PropGet v19 key="c"
    v29 = PropGet v19 key="d"
    v30 = PropGet v21 key="text"
    v31 = PropGet v21 key="number"
    v32 = PropGet v21 key="a"
    Return
}
# CHECK: L0 CompiledObject size=32
# CHECK-NEXT: "a" Int32 @16
# CHECK: L1 CompiledObject size=32
# CHECK-NEXT: "a" Int32 @16
# CHECK: L2 CompiledObject size=32
# CHECK-NEXT: "a" Int32 @16
# CHECK: L3 CompiledObject size=32
# CHECK-NEXT: "a" Int32 @16
# CHECK: L4 CompiledObject size=32
# CHECK-NEXT: "a" Int32 @
# CHECK-NEXT: "b" Int32 @
# CHECK-NEXT: "c" Int32 @
# CHECK-NEXT: "d" Int32 @
# CHECK: L5 CompiledObject size=32
# CHECK: "a" Int32 @
