# Site caches are numbered in the order of the program's text, module by module and function by function, not by heat: what belongs to code that never runs shares no page with what runs
# FORM: AsRead
# OPTIONS: only-passes=EstimateHeat disable=rule:PropertyPair
# RUN: place site-caches
# STATISTIC: SiteCachesPlaced = 6

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="library.js" displayPath="library.js" body=f3
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1, v1 function=f4
    v3 = CallDirect v1, v1 function=f4
    v4 = CallDirect v1, v1 function=f1
    v5 = CallDirect v1, v1 function=f1
    Jump -> next b1()
  b1():
    LoopHint
    v7 = CallDirect v1, v1 function=f2
    Branch v7 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="coldInMain" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v2 = PropGet v0 key="a"
    v3 = PropGet v1 key="b"
    v4 = StrictEq v2, v3
    Return v4
}
function f2 name="hotInMain" parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v2 = PropGet v0 key="a"
    v3 = PropGet v1 key="b"
    v4 = StrictEq v2, v3
    Return v4
}
function f3 name="library" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f4 name="coldInLibrary" module=m1 parameters=[{type=anything}, {type=anything}] results=[{type=boolean}] {
    v2 = PropGet v0 key="a"
    v3 = PropGet v1 key="b"
    v4 = StrictEq v2, v3
    Return v4
}

# CHECK: site caches 6, without 1
# CHECK-NEXT: f1 v2 PropGet cache=0
# CHECK-NEXT: f1 v3 PropGet cache=1
# CHECK-NEXT: f2 v2 PropGet cache=2
# CHECK-NEXT: f2 v3 PropGet cache=3
# CHECK-NEXT: f4 v2 PropGet cache=4
# CHECK-NEXT: f4 v3 PropGet cache=5
# CHECK-NOT: cache=
