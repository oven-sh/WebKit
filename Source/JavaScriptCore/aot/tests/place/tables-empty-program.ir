# The tables of a program whose only module does nothing, in the order of the list: a table about something the program does not have is empty but for a reserved first or a closing entry
# LIBRARY: own
# RUN: tables

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    Return
}

# CHECK: magic ok
