# A member that nothing calls still has a closure, so the record of its class names an entrypoint for it: a method that is never called, and the constructor of a class that is never constructed
# RUN: tables
# RUN(CLASSES): tables layouts functions

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Constructed" module=m0 constructor=f1
layout L1 kind=Instance name="NeverConstructed" module=m0 constructor=f4
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="called"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 index=1 key="uncalled"
    v6 = FinishClass v1 layout=L0
    v7 = Construct v6
    v8 = PropGet v7 key="called"
    v9 = Call v8, v7
    v10 = NewClosure function=f4
    v11 = NewClass v10 layout=L1
    v12 = FinishClass v11 layout=L1
    Return
}
function f1 name="Constructed" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="called" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f3 name="uncalled" kind=Method flags=[HasThis] results=[{type=anything}] {
  b0(v0: anything):
    Return
}
function f4 name="NeverConstructed" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    Return v2
}

# CHECK: magic ok
# CHECK: constructors 2 16
