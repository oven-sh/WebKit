# A required name tells the run time whether the link succeeds when the exporter does not export the name
# RUN: tables modules

module m0 path="/typed.ts" displayPath="typed.ts" body=f0 requests=[{target=m1 completes=true}] requiredNames=[{module=m1 name="required"}, {module=m1 name="optional" mayBeAbsent=true}, {module=m1 name="handedOn" exportName="renamed" specifier="./legacy"}]
module m1 path="/legacy.cjs" displayPath="legacy.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f1
entry module=m0

function f0 name="typed" kind=Module results=[{type=anything}] {
    Return
}
function f1 name="legacy" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    Return
}

# CHECK: requiredName 0 exporter=m1 name="required"
# CHECK-NOT: mayBeAbsent
# CHECK: requiredName 1 exporter=m1 name="optional" mayBeAbsent
# CHECK: requiredName 2 exporter=m1 name="handedOn"
# CHECK: exportStatement requiredName=2 exportName="renamed" specifier="./legacy"
