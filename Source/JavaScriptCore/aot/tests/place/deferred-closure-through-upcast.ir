# Only a closure whose one use is the store is deferred: one that reaches its field through a cast is created and its slot is a plain cell, as an initial field and in a store
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow
# RUN: place program
# RUN(PLAN): plan-slots layouts
# STATISTIC: DeferredClosureSlots = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="InitialFieldThroughCast" fields=[{key="run" declared={type=function} flags=[IsRequired]}]
layout L1 kind=Instance name="StoredThroughCasts" constructor=f2 fields=[{key="call" declared={type=function} flags=[IsRequired]}]
layout L2 name="InitialField" fields=[{key="run" declared={type=function} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Upcast v0 castType=function
    v2 = NewObject -, v1 layout=L0 fields=[0]
    v3 = FinishObject v2
    PutModuleVariable v3 variable=g0
    v5 = NewClosure function=f2
    v6 = NewClass v5 layout=L1
    v7 = FinishClass v6 layout=L1
    v8 = Construct v7
    PutModuleVariable v8 variable=g0
    v10 = NewClosure function=f4
    v11 = NewObject -, v10 layout=L2 fields=[0]
    v12 = FinishObject v11
    PutModuleVariable v12 variable=g0
    Return
}
function f1 name="run" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
function f2 name="StoredThroughCasts" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1
    v2 = NewObject v1 layout=L1
    v3 = NewClosure v2 function=f3
    v4 = Upcast v3 castType=function
    v5 = Upcast v4 castType=undefined|function
    PropDefine v2, v5 key="call"
    Return v2
}
function f3 name="call" kind=Arrow captures=[{type=L1}] results=[{type=anything}] {
  b0(v0: object ? L1):
    Return
}
function f4 name="direct" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}

# PLAN: L0 CompiledObject
# PLAN-NOT: DeferredClosure
# PLAN: L2 CompiledObject
# PLAN-NEXT: .0 "run" DeferredClosure @16 f4 record=0

# CHECK-LABEL: function f0 name="main"
# CHECK-NOT: closureForm=Deferred
# CHECK: v10: f4 = NewClosure function=f4 {{*}}closureForm=Deferred
# CHECK-LABEL: function f2 name="StoredThroughCasts"
# CHECK-NOT: closureForm=Deferred
# CHECK-LABEL: function f3 name="call"
