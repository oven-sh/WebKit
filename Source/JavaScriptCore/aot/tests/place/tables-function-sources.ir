# A function as read is its own source, so the image lists sources only from the first function on that is a form of another one
# LIBRARY: own
# RUN: tables
# RUN(TRACES): tables function-traces

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f2
    Return
}
function f1 name="first" results=[{type=anything}] {
  b0():
    Return
}
function f2 name="second" results=[{type=anything}] {
  b0():
    Return
}

# CHECK: functionNames 3 9
# CHECK-NEXT: functionNameGroups 2 8
# CHECK-NEXT: functionNameRuns 0 0
# CHECK-NEXT: functionRecordNumbers 4 4
# CHECK-NEXT: functionRecords
# CHECK-NEXT: functionRecordsByFunction 0 0
# CHECK-NEXT: functionSources 1 3
# CHECK-NEXT: implementedBuiltins 0 0
# TRACES: trace f0 role=Source source=f0 implements=-
# TRACES-NEXT: trace f1 role=Source source=f1 implements=-
# TRACES-NEXT: trace f2 role=Source source=f2 implements=-
# TRACES-NEXT: trace f3 role=GenericEntrypoint source=f0 implements=-
