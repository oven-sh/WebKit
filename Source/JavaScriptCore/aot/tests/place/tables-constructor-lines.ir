# The text of a constructor is that of its class. The table says how many lines of it stand above the parameters of the constructor, and lists no constructor that begins on the first line or that nobody wrote.
# RUN: tables function-texts
# CHECK: constructor f2 linesOfTextAbove=3
# CHECK-NOT: constructor

layout L0 kind=Instance name="First" module=m0 position=6 constructor=f1
layout L1 kind=Instance name="Below" module=m0 position=39 constructor=f2
layout L2 kind=Instance name="Default" module=m0 position=89 constructor=f3
module m0 path="/a.js" displayPath="a.js" body=f0 positions={lineStarts=[0, 33, 47, 61, 62, 81, 83, 99, 101, 133]} functionText="class First { constructor() {} }\x0aclass Below {\x0a  method() {}\x0a\x0a  constructor() {}\x0a}\x0aclass Default {\x0a}\x0apublish(First, Below, Default);\x0a"
entry module=m0

function f0 module=m0 kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1 @0
    v1 = NewClass v0 layout=L0 @0
    v2 = FinishClass v1 layout=L0 @0
    v3 = NewClosure function=f2 @33
    v4 = NewClass v3 layout=L1 @33
    v5 = FinishClass v4 layout=L1 @33
    v6 = NewClosure function=f3 @83
    v7 = NewClass v6 layout=L2 @83
    v8 = FinishClass v7 layout=L2 @83
    v9 = Builtin builtin=GlobalThis @101
    v10 = PropGet v9 key="publish" [isFreeName] @101
    v11 = Call v10, -, v2, v5, v8 @101
    Return
}
function f1 name="First" module=m0 position=25 text={end=32} kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0 @25
    v2 = NewObject v1 layout=L0 @25
    Return v2 @25
}
function f2 name="Below" module=m0 position=75 text={start=33 end=82} kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L1 @75
    v2 = NewObject v1 layout=L1 @75
    Return v2 @75
}
function f3 name="Default" module=m0 position=89 text={start=83 end=100} kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L2 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L2 @89
    v2 = NewObject v1 layout=L2 @89
    Return v2 @89
}
