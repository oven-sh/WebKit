    v134 = FinishObject v133
    Jump -> next b1()
  b1():
    LoopHint
    v136 = PropGet v0 key="value0" [isFreeName]
    v137 = Predict v136 predicted=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16|L17|L18|L19|L20|L21|L22|L23|L24|L25|L26|L27|L28|L29|L30|L31|L32|L33
    v138 = PropGet v137 key="x"
    v139 = PropGet v0 key="value1" [isFreeName]
    v140 = Predict v139 predicted=L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16|L17|L18|L19|L20|L21|L22|L23|L24|L25|L26|L27|L28|L29|L30|L31|L32|L33|L34|L35|L36|L37|L38|L39|L40|L41|L42|L43|L44|L45|L46|L47|L48|L49|L50|L51|L52|L53|L54|L55|L56|L57|L58|L59|L60|L61|L62|L63|L64
    v141 = PropGet v140 key="x"
    v142 = PropGet v0 key="value2" [isFreeName]
    v143 = Predict v142 predicted=L32|L33|L34|L35|L36|L37|L38|L39|L40|L41|L42|L43|L44|L45|L46|L47|L48|L49|L50|L51|L52|L53|L54|L55|L56|L57|L58|L59|L60|L61|L62|L63|L64|L65
    v144 = PropGet v143 key="x"
    v145 = ToBoolean v144
    Branch v145 -> taken b1(), notTaken b2()
  b2():
    v146 = Predict v1 predicted=L0|L65
    v147 = PropGet v146 key="x"
    Return
}
# The three sets that are tested in each iteration of the loop put First and Last at the two ends of the 64 layouts between them.
# CHECK: L0 shapes 1..1
# CHECK: L65 shapes 66..66
# CHECK: set [L0, L65] bitset 1..66 @0 cost=9
# TABLES: shapeSetBits 4 16
