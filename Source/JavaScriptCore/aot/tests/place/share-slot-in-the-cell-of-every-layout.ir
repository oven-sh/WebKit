# Wide has more optional fields than fit under its inline cap. Few of its objects get "shared", so by how often it is filled it would lie in the Extension with the rest.
# Small has "shared" in its cell, and one access in a hot loop reads the field of both. With the field in the cell of one and in the Extension of the other the access would have to ask which layout it has.
# A row is as good as the better of its ranks by fill and by access, so "shared" has room in the cell of Wide, which does not grow for it: the field that is filled least often of those in the cell makes way.
# share-slot-stays-out-of-line-for-few-accesses.ir reads the field once
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow testing=NoLayoutIsMadeSeldom
# RUN: plan-slots layouts accesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Small" fields=[{key="shared" declared={type=undefined|L2}}, {key="own" declared={type=number} flags=[IsRequired]}]
layout L1 name="Wide" fields=[{key="required0" declared={type=number} flags=[IsRequired]}, {key="required1" declared={type=number} flags=[IsRequired]}, {key="required2" declared={type=number} flags=[IsRequired]}, {key="filled0" declared={type=undefined|L2}}, {key="filled1" declared={type=undefined|L2}}, {key="filled2" declared={type=undefined|L2}}, {key="filled3" declared={type=undefined|L2}}, {key="filled4" declared={type=undefined|L2}}, {key="sometimes0" declared={type=undefined|L2}}, {key="sometimes1" declared={type=undefined|L2}}, {key="sometimes2" declared={type=undefined|L2}}, {key="sometimes3" declared={type=undefined|L2}}, {key="shared" declared={type=undefined|L2}}, {key="optional0" declared={type=undefined|L2}}, {key="optional1" declared={type=undefined|L2}}, {key="optional2" declared={type=undefined|L2}}, {key="optional3" declared={type=undefined|L2}}, {key="optional4" declared={type=undefined|L2}}, {key="optional5" declared={type=undefined|L2}}, {key="optional6" declared={type=undefined|L2}}, {key="optional7" declared={type=undefined|L2}}, {key="optional8" declared={type=undefined|L2}}, {key="optional9" declared={type=undefined|L2}}, {key="optional10" declared={type=undefined|L2}}, {key="optional11" declared={type=undefined|L2}}, {key="optional12" declared={type=undefined|L2}}, {key="optional13" declared={type=undefined|L2}}, {key="optional14" declared={type=undefined|L2}}, {key="optional15" declared={type=undefined|L2}}, {key="optional16" declared={type=undefined|L2}}, {key="optional17" declared={type=undefined|L2}}, {key="optional18" declared={type=undefined|L2}}, {key="optional19" declared={type=undefined|L2}}, {key="optional20" declared={type=undefined|L2}}, {key="optional21" declared={type=undefined|L2}}, {key="optional22" declared={type=undefined|L2}}, {key="optional23" declared={type=undefined|L2}}]
layout L2 name="Leaf" fields=[{key="value" declared={type=number} flags=[IsRequired]}]
variable g0 name="either" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = NewObject -, v2 layout=L2 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v4, v2 layout=L0 fields=[0, 1]
    v6 = FinishObject v5
    PutModuleVariable v6 variable=g0
    Jump -> next b1()
  b1():
    LoopHint
    v9 = NewObject -, v2, v2, v2, v4, v4, v4, v4, v4 layout=L1 fields=[0, 1, 2, 3, 4, 5, 6, 7]
    v10 = FinishObject v9
    v11 = Call v0
    v12 = ToBoolean v11
    Branch v12 -> taken b2(), notTaken b4()
  b2():
    v13 = Call v0
    v14 = ToBoolean v13
    Branch v14 -> taken b3(), notTaken b4()
  b3():
    PropSet v10, v4 key="sometimes0"
    PropSet v10, v4 key="sometimes1"
    PropSet v10, v4 key="sometimes2"
    PropSet v10, v4 key="sometimes3"
    Jump -> next b4()
  b4():
    v19 = Call v0
    v20 = ToBoolean v19
    Branch v20 -> taken b1(), notTaken b5()
  b5():
    v21 = CallDirect v10, v4 function=f1
    PutModuleVariable v10 variable=g0
    Jump -> next b6()
  b6():
    LoopHint
    Jump -> next b7()
  b7():
    LoopHint
    Jump -> next b8()
  b8():
    LoopHint
    Jump -> next b9()
  b9():
    LoopHint
    Jump -> next b10()
  b10():
    LoopHint
    v28 = GetModuleVariable variable=g0
    v29 = PropGet v28 key="shared"
    v30 = Call v0
    v31 = ToBoolean v30
    Branch v31 -> taken b10(), notTaken b11()
  b11():
    v32 = Call v0
    v33 = ToBoolean v32
    Branch v33 -> taken b9(), notTaken b12()
  b12():
    v34 = Call v0
    v35 = ToBoolean v34
    Branch v35 -> taken b8(), notTaken b13()
  b13():
    v36 = Call v0
    v37 = ToBoolean v36
    Branch v37 -> taken b7(), notTaken b14()
  b14():
    v38 = Call v0
    v39 = ToBoolean v38
    Branch v39 -> taken b6(), notTaken b15()
  b15():
    Return
}
function f1 name="fill" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key="shared"
    PropSet v0, v1 key="optional0"
    PropSet v0, v1 key="optional1"
    PropSet v0, v1 key="optional2"
    PropSet v0, v1 key="optional3"
    PropSet v0, v1 key="optional4"
    PropSet v0, v1 key="optional5"
    PropSet v0, v1 key="optional6"
    PropSet v0, v1 key="optional7"
    PropSet v0, v1 key="optional8"
    PropSet v0, v1 key="optional9"
    PropSet v0, v1 key="optional10"
    PropSet v0, v1 key="optional11"
    PropSet v0, v1 key="optional12"
    PropSet v0, v1 key="optional13"
    PropSet v0, v1 key="optional14"
    PropSet v0, v1 key="optional15"
    PropSet v0, v1 key="optional16"
    PropSet v0, v1 key="optional17"
    PropSet v0, v1 key="optional18"
    PropSet v0, v1 key="optional19"
    PropSet v0, v1 key="optional20"
    PropSet v0, v1 key="optional21"
    PropSet v0, v1 key="optional22"
    PropSet v0, v1 key="optional23"
    Return
}
# CHECK: L1 CompiledObject size=80
# CHECK: "shared" OptionalCell32 @20
# CHECK: "shared" {L0 L1} read
# CHECK-NEXT: one location OptionalCell32 @20
