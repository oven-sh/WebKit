# Placement gives a slot operation one location. It stops the build at a read whose receivers hold the field in two places, which selection dispatches on shape, and at a store one of whose receivers has no slot for the field, which the access plan does not form
# FORM: Selected
# OPTIONS: references=narrow testing=NoLayoutIsMadeSeldom
# RUN: pass NumberAndEncode
# DIAGNOSTIC: SlotAccessNotPlaced 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Text" fields=[{key="value" declared={type=undefined|string}}] flow={members=[L0]}
layout L1 name="Count" fields=[{key="value" declared={type=undefined|number}}] flow={members=[L1]}
layout L2 name="NeverStored" fields=[{key="value" declared={type=undefined} flow={location={writers=AllKnown stores=Never}}}] flow={members=[L2]}

function f0 name="read-in-two-places" parameters=[{type=L0|L1}] results=[{type=anything}] {
    v1 = GetSlotOrUndefined v0 key="value" receivers=[L0, L1] level=Proven
    Return v1
}
function f1 name="store-without-slot" parameters=[{type=L0|L2}] results=[{type=anything}] {
    v1 = Undefined
    PutSlotOrAdd v0, -, v1 key="value" receivers=[L0, L2] level=Proven
    Return
}
# A read through the same receivers finds the field absent in the member without the slot.
function f2 name="read-without-slot" parameters=[{type=L0|L2}] results=[{type=anything}] {
    v1 = GetSlotOrUndefined v0 key="value" receivers=[L0, L2] level=Proven
    Return v1
}
# CHECK: outcome
