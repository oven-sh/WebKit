# A slot that defers its closure also takes a closure that is made, and a closure in the full form names an allocation
# OPTIONS: references=narrow
# RUN: check-placement deferred-form
# DIAGNOSTIC: PlacementCheckFailed 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="A" fields=[{key="run" declared={type=function} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    v4 = NewClosure function=f2
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="publish" [isFreeName]
    v7 = Call v6, -, v4
    Return
}
function f1 name="run" kind=Arrow results=[{type=anything}] {
    Return
}
function f2 name="later" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="run"
    Return v1
}

# CHECK: mutated f0 v0
# CHECK-NEXT: rule PayloadMissing
# CHECK-NOT: rule DeferredClosureStore
