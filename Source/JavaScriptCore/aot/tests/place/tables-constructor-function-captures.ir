# A constructor function may capture anything: only a class whose record creates method closures restricts the captures of its constructor, because each of them is created over its environment
# RUN: tables
# RUN(CLASS): tables layouts functions

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Point" module=m0 constructor=f1 fields=[{key="x" declared={type=anything}}] flags=[IsConstructorFunction]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = CallDirect function=f2
    v1 = CallDirect function=f2
    Return
}
function f1 name="Point" flags=[HasThis] captures=[{type=number}, {type=string}] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] {
    v3 = Add v0, v1
    PropSet v2, v3 key="x"
    Return
}
function f2 name="createsConstructor" results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="first" [isFreeName]
    v2 = ToNumber v1
    v3 = PropGet v0 key="second" [isFreeName]
    v4 = ToString v3
    v5 = NewClosure v2, v4 function=f1
    v6 = PropGet v0 key="publish" [isFreeName]
    v7 = Call v6, -, v5
    Return
}

# CHECK: magic ok
# CHECK: constructors 1 8
# CLASS: class index=L0 {{*}}constructor=[[entrypoint]] environment=-
# CLASS: function [[entrypoint]] name="Point" {{*}}captures=2
# CLASS: constructor function=[[entrypoint]] layout=L0
