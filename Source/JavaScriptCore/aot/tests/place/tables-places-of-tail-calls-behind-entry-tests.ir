# The tests at the head of a typed function hand on to its body by a call in tail position that nobody wrote. It has no row: a stack trace lists the function, once it was constructed and has left, at the call that is written.
# RUN: tables functions

module m0 path="main.ts" displayPath="main.ts" body=f0 positions={lineStarts=[0, 100, 200]}
entry module=m0
typesite w0 module=m0 position=110 kind=Parameter

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = Double number=1.5
    Jump -> next b1()
  b1():
    LoopHint
    v6 = Call v2, -, v4
    v7 = Call v1, -, v6
    v8 = ToBoolean v7
    Branch v8 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="checked" module=m0 position=105 flags=[IsChecked] length=1 parameters=[{type=number site=w0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ number):
    v1 = Check v0 expectedType=number site=w0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="publish" [isFreeName]
    v4 = Call v3, -, v1 @140
    ReturnCall v4 @140
}

# CHECK-NOT: placeOfTailCall
# CHECK: placeOfTailCall function=f1 callee=- line=2 column=41
# CHECK-NOT: placeOfTailCall
