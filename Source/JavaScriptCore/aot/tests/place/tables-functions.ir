# Every function has a row in the tables by function, and each function with a closure word a row in the closure tables. Its text stays with the function that its generic entrypoint enters, which for an async function and a generator is the ramp. A function that is only called has neither
# OPTIONS: disable=pass:InlineCalls
# RUN: tables
# RUN(ROWS): tables functions
# RUN(PLAIN): tables functions function-texts
# RUN(ASYNC): tables functions function-texts
# RUN(GENERATOR): tables functions function-texts
# RUN(CALLED): tables functions function-texts

module m0 path="main.js" displayPath="main.js" body=f0 functionText="publish(function plain() { return value }); (() => value)(); publish(async function awaitsOnce(x) { return await x }); publish(function* yieldsOnce() { yield 1 })"
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = NewClosure function=f2
    v5 = Call v4
    v6 = NewClosure function=f3
    v7 = Call v1, -, v6
    v8 = NewClosure function=f4
    v9 = Call v1, -, v8
    Return
}
function f1 name="plain" text={start=8 end=41} results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="value" [isFreeName]
    Return v1
}
function f2 name="onlyCalled" text={start=45 end=56} kind=Arrow results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="value" [isFreeName]
    Return v1
}
function f3 name="awaitsOnce" text={start=69 end=116} flags=[IsAsync] length=1 parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Await v0
    Return v1
}
function f4 name="yieldsOnce" text={start=127 end=161} flags=[IsGenerator, TakesCallee] results=[{type=anything}] {
    InitialYield
    v2 = Integer integer=1
    v3 = Yield v2
    Return
}

# CHECK: magic ok
# CHECK: functionNames
# CHECK-NEXT: functionNameGroups
# CHECK-NEXT: functionNameRuns
# CHECK-NEXT: functionRecordNumbers
# CHECK-NEXT: functionRecords
# CHECK-NEXT: functionRecordsByFunction
# CHECK-NEXT: functionSources
# CHECK-NEXT: closureFormsBySource
# CHECK-NEXT: implementedBuiltins
# CHECK-NEXT: closureFunctionKinds [[closureFunctions]]
# CHECK-NEXT: functionLengths [[closureFunctions]]
# CHECK-NEXT: closureCaptureCounts [[closureFunctions]]
# CHECK-NEXT: functionsWithLargeCounts 0 0
# CHECK-NEXT: closureCellNumbers [[closureFunctions]]
# CHECK-NEXT: functionTexts 1 12

# ROWS: function f1 name="plain" callable=Plain
# ROWS-NEXT: function f2 name="onlyCalled" callable=Arrow
# ROWS-NEXT: function f3 name="awaitsOnce" callable=Plain {{*}} async
# ROWS-NEXT: function f4 name="yieldsOnce" callable=Plain {{*}} generator
# PLAIN: function [[entrypoint]] name="plain" {{*}}length=0
# PLAIN: [[entrypoint]] {{*}} "function plain() { return value }"
# ASYNC: function [[entrypoint]] name="awaitsOnce" {{*}} async {{*}}length=1
# ASYNC: [[entrypoint]] {{*}} "async function awaitsOnce(x) { return await x }"
# GENERATOR: function [[entrypoint]] name="yieldsOnce" {{*}} generator {{*}}length=0
# GENERATOR: [[entrypoint]] {{*}} "function* yieldsOnce() { yield 1 }"
# CALLED-NOT: name="onlyCalled" {{*}}length=
# CALLED-NOT: "() => value"
