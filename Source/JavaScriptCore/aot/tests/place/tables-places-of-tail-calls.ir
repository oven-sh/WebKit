# A plain function that may be entered by value has a row for each place where it makes a call in tail position: a stack trace lists it there once it was constructed and has left. Where it has several, a row names the callee that its call enters. An arrow function, a function that returns what its call returned, and a function that is only called directly have none
# RUN: tables
# RUN(ROWS): tables functions

module m0 path="main.js" displayPath="main.js" body=f0 positions={lineStarts=[0, 100, 200, 300, 400, 500, 600, 700, 800]}
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    v6 = NewClosure function=f6
    v7 = Call v5, -, v0, v1, v2, v3, v6
    v8 = CallDirect function=f5
    Return
}
function f1 name="leavesOnce" position=100 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0 @130
    ReturnCall v1 @130
}
function f2 name="leavesAtTwoPlaces" position=200 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Call v0 @240
    ReturnCall v2 @240
  b2():
    v3 = Call v0 @260
    ReturnCall v3 @260
}
function f3 name="arrow" position=300 kind=Arrow parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0 @330
    ReturnCall v1 @330
}
function f4 name="stays" position=400 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0 @430
    Return v1
}
function f5 name="calledDirectly" position=500 results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Call v1 @530
    ReturnCall v2 @530
}
function f6 name="leavesForTwoCallees" position=600 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToBoolean v0
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0 function=f7 [isNeverInlined] @640
    ReturnCall v2 @640
  b2():
    v3 = CallDirect v0 function=f8 [isNeverInlined] @660
    ReturnCall v3 @660
}
function f7 name="first" position=700 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0 @730
    Return v1
}
function f8 name="second" position=800 parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0 @830
    v2 = Call v0 @840
    Return v2
}

