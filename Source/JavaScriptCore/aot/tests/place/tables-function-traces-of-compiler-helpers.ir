# A function of the library that no stack trace lists is still listed as the innermost frame if it is a built-in that programs can call: next() of a generator.
# Only compiled code calls a helper of the compiler, such as the one that looks for the method of a `using` declaration: it is in no stack trace, whoever has written it.
# LIBRARY: own
# OPTIONS: disable=pass:InlineCalls
# RUN: tables function-traces

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
runtimefunction id=DisposableStackPrototypeGetDisposeMethod function=f1
runtimefunction id=GeneratorPrototypeNext function=f2

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="value" [isFreeName]
    v2 = Builtin builtin=CompilerHelpersGetDisposeMethod [isNotReadFromHolder]
    v3 = Call v2, -, v1
    v4 = PropGet v1 key="next"
    v5 = Call v4, v1 calleeKey="next"
    Return
}
function f1 name="getDisposeMethod" role=Library flags=[IsHiddenInStackTraces] enclosingRuntimeFunction=DisposableStackPrototypeGetDisposeMethod parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="dispose"
    Return v1
}
function f2 name="next" role=Library flags=[HasThis, IsHiddenInStackTraces] enclosingRuntimeFunction=GeneratorPrototypeNext parameters=[{type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="state"
    Return v2
}

# CHECK: trace f1 role=Library source=f1 implements=CompilerHelpersGetDisposeMethod visibility=Hidden
# CHECK: trace f2 role=Library source=f2 implements=GeneratorPrototypeNext visibility=VisibleOnlyOnTop
