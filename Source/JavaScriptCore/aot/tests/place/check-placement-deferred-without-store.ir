# A closure in the deferred form has no cell and no code: it is legal only as the value of the one store into a slot that defers it
# OPTIONS: references=narrow
# RUN: check-placement deferred-form-without-store
# DIAGNOSTIC: PlacementCheckFailed 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure v1 function=f1
    v3 = PropGet v0 key="publish" [isFreeName]
    v4 = Call v3, -, v2
    Return
}
function f1 name="published" kind=Arrow captures=[{type=anything}] results=[{type=anything}] {
    Return v0
}

# CHECK: mutated f0 v2
# CHECK-NEXT: rule DeferredClosureStore
