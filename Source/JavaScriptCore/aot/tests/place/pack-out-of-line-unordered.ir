# The late fields of a layout with more fields than a cell holds in line are created by a store that may allocate, also where nobody enumerates the keys, so that they can lie in the Extension
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow
# RUN(SLOTS): plan-slots layouts
# RUN(CODE): pipeline PlanSlots

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Wide" fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="late0" declared={type=undefined|L0}}, {key="late1" declared={type=undefined|L0}}, {key="late2" declared={type=undefined|L0}}, {key="late3" declared={type=undefined|L0}}, {key="late4" declared={type=undefined|L0}}, {key="late5" declared={type=undefined|L0}}, {key="late6" declared={type=undefined|L0}}, {key="late7" declared={type=undefined|L0}}, {key="late8" declared={type=undefined|L0}}, {key="late9" declared={type=undefined|L0}}, {key="late10" declared={type=undefined|L0}}, {key="late11" declared={type=undefined|L0}}, {key="late12" declared={type=undefined|L0}}, {key="late13" declared={type=undefined|L0}}, {key="late14" declared={type=undefined|L0}}, {key="late15" declared={type=undefined|L0}}, {key="late16" declared={type=undefined|L0}}, {key="late17" declared={type=undefined|L0}}, {key="late18" declared={type=undefined|L0}}, {key="late19" declared={type=undefined|L0}}, {key="late20" declared={type=undefined|L0}}, {key="late21" declared={type=undefined|L0}}, {key="late22" declared={type=undefined|L0}}, {key="late23" declared={type=undefined|L0}}]
layout L1 name="Small" fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="late0" declared={type=undefined|L1}}, {key="late1" declared={type=undefined|L1}}, {key="late2" declared={type=undefined|L1}}, {key="late3" declared={type=undefined|L1}}, {key="late4" declared={type=undefined|L1}}, {key="late5" declared={type=undefined|L1}}]
variable g0 name="wide" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="small" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    Jump -> next b1()
  b1():
    LoopHint
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    PutModuleVariable v5 variable=g0
    v7 = NewObject -, v2 layout=L1 fields=[0]
    v8 = FinishObject v7
    PutModuleVariable v8 variable=g1
    v10 = Call v0
    v11 = ToBoolean v10
    Branch v11 -> taken b1(), notTaken b2()
  b2():
    v12 = CallDirect function=f1
    v13 = CallDirect function=f1
    Return
}
function f1 name="fill" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = GetModuleVariable variable=g1
    PropSet v0, v0 key="late0"
    PropSet v0, v0 key="late1"
    PropSet v0, v0 key="late2"
    PropSet v0, v0 key="late3"
    PropSet v0, v0 key="late4"
    PropSet v0, v0 key="late5"
    PropSet v0, v0 key="late6"
    PropSet v0, v0 key="late7"
    PropSet v0, v0 key="late8"
    PropSet v0, v0 key="late9"
    PropSet v0, v0 key="late10"
    PropSet v0, v0 key="late11"
    PropSet v0, v0 key="late12"
    PropSet v0, v0 key="late13"
    PropSet v0, v0 key="late14"
    PropSet v0, v0 key="late15"
    PropSet v0, v0 key="late16"
    PropSet v0, v0 key="late17"
    PropSet v0, v0 key="late18"
    PropSet v0, v0 key="late19"
    PropSet v0, v0 key="late20"
    PropSet v0, v0 key="late21"
    PropSet v0, v0 key="late22"
    PropSet v0, v0 key="late23"
    PropSet v1, v1 key="late0"
    PropSet v1, v1 key="late1"
    PropSet v1, v1 key="late2"
    PropSet v1, v1 key="late3"
    PropSet v1, v1 key="late4"
    PropSet v1, v1 key="late5"
    v32 = PropGet v0 key="late0"
    v33 = PropGet v0 key="late1"
    v34 = PropGet v0 key="late2"
    v35 = PropGet v0 key="late3"
    v36 = PropGet v0 key="late4"
    v37 = PropGet v0 key="late5"
    v38 = PropGet v0 key="late6"
    v39 = PropGet v0 key="late7"
    v40 = PropGet v0 key="late8"
    v41 = PropGet v0 key="late9"
    v42 = PropGet v0 key="late10"
    v43 = PropGet v0 key="late11"
    v44 = PropGet v0 key="late12"
    v45 = PropGet v0 key="late13"
    v46 = PropGet v0 key="late14"
    v47 = PropGet v0 key="late15"
    v48 = PropGet v0 key="late16"
    v49 = PropGet v0 key="late17"
    v50 = PropGet v0 key="late18"
    v51 = PropGet v0 key="late19"
    v52 = PropGet v0 key="late20"
    v53 = PropGet v0 key="late21"
    v54 = PropGet v0 key="late22"
    v55 = PropGet v0 key="late23"
    v56 = PropGet v1 key="late0"
    v57 = PropGet v1 key="late1"
    v58 = PropGet v1 key="late2"
    v59 = PropGet v1 key="late3"
    v60 = PropGet v1 key="late4"
    v61 = PropGet v1 key="late5"
    Return
}

# SLOTS: L0 CompiledObject size=48 extension=84 unordered
# SLOTS-NEXT: .0 "flags" Double @24
# SLOTS: .5 "late4" OptionalCell32 @44
# SLOTS-NEXT: .6 "late5" OptionalCell32 out@8
# SLOTS: .24 "late23" OptionalCell32 out@80
# SLOTS-NEXT: extension Cell32 @16
# The fields of a small layout all fit into the cell, and the store that creates one allocates nothing.
# SLOTS-NEXT: L1 CompiledObject size=48 extension=0 unordered
# SLOTS-NOT: out@
# CODE-LABEL: function f1 name="fill"
# CODE: PutSlotOrAdd v0, -, v0 key="late0" receivers=[L0] level=Proven
# CODE: PutSlotOrAdd v0, -, v0 key="late23" receivers=[L0] level=Proven
# CODE-NEXT: PutSlot v1, -, v1 key="late0" receivers=[L1] level=Proven
# CODE: PutSlot v1, -, v1 key="late5" receivers=[L1] level=Proven
# CODE-NOT: PutSlotOrAdd
