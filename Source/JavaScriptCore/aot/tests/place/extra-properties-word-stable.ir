# A field that may be redefined or stored with a value of another type moves to the extra properties, so its layout has the word, and a layout whose fields all stay in their slots has none
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow references=narrow
# RUN: plan-slots layouts

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Redefined" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="StoredWithOtherType" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 name="Stable" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = ToString v1
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewClosure function=f1
    DefineGetter v5, v6 key="x"
    v8 = NewObject -, v2 layout=L1 fields=[0]
    v9 = FinishObject v8
    PropSet v9, v3 key="x"
    v11 = NewObject -, v2 layout=L2 fields=[0]
    v12 = FinishObject v11
    PropSet v12, v2 key="x"
    Return
}
function f1 name="x" kind=Getter flags=[HasThis] results=[{type=anything}] {
    Return
}

# CHECK: L0 CompiledObject size=32
# CHECK-NEXT: .0 "x" OptionalDouble @16
# CHECK-NEXT: extra-properties Cell32 @24
# CHECK-NEXT: L1 CompiledObject size=32
# CHECK-NEXT: .0 "x" OptionalDouble @16
# CHECK-NEXT: extra-properties Cell32 @24
# CHECK-NEXT: L2 CompiledObject size=32
# CHECK-NEXT: .0 "x" Double @16
# CHECK-NOT: extra-properties
