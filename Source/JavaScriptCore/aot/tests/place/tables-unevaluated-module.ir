# A module that only an uncalled function imports is never evaluated. Its record stays in the tables without a body, and the build succeeds. The module that is evaluated names the generic entrypoint of its body
# LIBRARY: own
# RUN: tables
# RUN(MODULES): tables modules

module m0 path="main.js" displayPath="main.js" body=f0
module m1 path="lazy.js" displayPath="lazy.js" body=f2
entry module=m0
variable g0 name="loadLater" module=m0 declared={type=function} initialization=Function function=f1
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Call v1
    Return
}
function f1 name="loadLater" results=[{type=anything}] {
    v0 = ImportModule module=m1 referrer=m0
    Return v0
}
function f2 name="lazy" module=m1 kind=Module results=[{type=anything}] {
    Return
}

# CHECK: magic ok
# CHECK: modules 3 120
# MODULES: module m0 kind=SourceText path="main.js" {{*}}body=f
# MODULES: module m1 kind=SourceText path="lazy.js" {{*}}body=- referrer
# MODULES: modulesByPath modules=[m0]
