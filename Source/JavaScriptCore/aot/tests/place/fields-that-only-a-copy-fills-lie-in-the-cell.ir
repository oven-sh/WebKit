# function rest(record) { const { secret, ...visible } = record; return visible }  for (..) kept = rest(i & 1 ? { id: 1, name: "a", secret: "x" } : { secret: "y", id: 2, name: "b", age: 3 })
# A field of the new object is filled as often as what is copied has one of that name.
# FORM: AsRead
# OPTIONS: references=narrow
# RUN: plan-slots layouts fill
# CHECK: L0 CompiledObject size=32 extension=0
# CHECK-NOT: out@
# CHECK: L0 allocated=
# CHECK-NEXT: "id" filled=99% besideCreation=100%
# CHECK-NEXT: "name" filled=99% besideCreation=100%
# CHECK-NEXT: "age" filled=74% besideCreation=100%

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Visible"
layout L1 name="Short" fields=[{key="id" declared={type=anything} flags=[IsRequired]}, {key="name" declared={type=anything} flags=[IsRequired]}, {key="secret" declared={type=anything} flags=[IsRequired]}]
layout L2 name="Long" fields=[{key="age" declared={type=anything} flags=[IsRequired]}, {key="id" declared={type=anything} flags=[IsRequired]}, {key="name" declared={type=anything} flags=[IsRequired]}, {key="secret" declared={type=anything} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=1
    v2 = String string="a"
    v3 = String string="x"
    v4 = NewObject -, v1, v2, v3 layout=L1 fields=[0, 1, 2]
    v5 = Integer integer=3
    v6 = Integer integer=2
    v7 = String string="b"
    v8 = String string="y"
    v9 = NewObject -, v5, v6, v7, v8 layout=L2 fields=[0, 1, 2, 3]
    v10 = Call v0, -, v4
    v11 = Call v0, -, v9
    PutModuleVariable v10 variable=g0
    PutModuleVariable v11 variable=g0
    Return
}
function f1 name="rest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0):
    v1 = PropGet v0 key="secret"
    v2 = NewObject layout=L0
    CopyDataProperties v2, v0 excludedKeys=["secret"]
    v4 = FinishObject v2
    Return v4
}
