# A field for int32s that may be absent, undefined or null takes 4 bytes and needs no Extension. The five lowest int32s are kept for the markers: a field that may hold one of them takes 8 bytes.
# A number field that is predicted to hold int32s is such a field where flow does not prove that no store brings another type: any other number is a value of another type for it.
# A prediction of other numbers changes nothing
# FORM: AsRead
# OPTIONS: references=narrow only-passes=ResolveAccesses disable=flow:NarrowedTypes
# RUN: plan-slots

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Optional" fields=[{key="small" declared={type=undefined|int[-2147483643, 2147483647]}}, {key="nullable" declared={type=null|int[0, 100000]} flags=[IsRequired]}, {key="either" declared={type=undefined|null|int[-1, 1]}}, {key="last" declared={type=undefined|int[0, 2147483647]}}, {key="fifth" declared={type=undefined|int[0, 7]}}, {key="sixth" declared={type=undefined|int[0, 7]}}]
layout L1 name="TooWide" fields=[{key="whole" declared={type=undefined|i32}}, {key="lowest" declared={type=undefined|int[-2147483644, 0]}}, {key="wide" declared={type=undefined|int}}, {key="unsigned" declared={type=undefined|int[0, 4294967295]}}]
layout L2 name="Predicted" fields=[{key="flags" declared={type=undefined|null|number predicted=int[0, 1073741824]} flags=[IsRequired]}, {key="maybe" declared={type=undefined|null|number predicted=undefined|i32}}, {key="kind" declared={type=undefined|null|number predicted=int[0, 400]} flags=[IsRequired]}, {key="sign" declared={type=undefined|null|number predicted=null|int[-1, 1]} flags=[IsRequired]}, {key="fifth" declared={type=undefined|null|number predicted=int[0, 7]} flags=[IsRequired]}, {key="sixth" declared={type=undefined|null|number predicted=int[0, 7]} flags=[IsRequired]}]
layout L3 name="NotPredicted" fields=[{key="fraction" declared={type=undefined|null|number predicted=number} flags=[IsRequired]}, {key="large" declared={type=undefined|null|number predicted=int[0, 4294967295]} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Integer integer=0
    v3 = NewObject -, v2, v2, v2, v2, v2, v2 layout=L0 fields=[0, 1, 2, 3, 4, 5]
    v4 = FinishObject v3
    v5 = Call v1, -, v4
    v6 = NewObject -, v2, v2, v2, v2 layout=L1 fields=[0, 1, 2, 3]
    v7 = FinishObject v6
    v8 = Call v1, -, v7
    v9 = NewObject -, v2, v2, v2, v2, v2, v2 layout=L2 fields=[0, 1, 2, 3, 4, 5]
    v10 = FinishObject v9
    v11 = Call v1, -, v10
    v12 = NewObject -, v2, v2 layout=L3 fields=[0, 1]
    v13 = FinishObject v12
    v14 = Call v1, -, v13
    v15 = PropGet v0 key="thing" [isFreeName]
    v16 = PropGet v0 key="name" [isFreeName]
    ElemSet v15, v16, v15 mode=Strict
    Return
}
# The cells of L0 and L2 are full, so no slot is widened into free bytes.
# CHECK: L0 CompiledObject size=48 fields=6
# CHECK-NEXT: "small" OptionalInt32 @
# CHECK-NEXT: "nullable" OptionalInt32 @
# CHECK-NEXT: "either" OptionalInt32 @
# CHECK-NEXT: "last" OptionalInt32 @
# CHECK: L1 CompiledObject size=64 fields=4
# CHECK-NEXT: "whole" OptionalInt64 @
# CHECK-NEXT: "lowest" OptionalInt64 @
# CHECK-NEXT: "wide" OptionalInt64 @
# CHECK-NEXT: "unsigned" OptionalInt64 @
# CHECK: L2 CompiledObject size=48 fields=6
# CHECK-NEXT: "flags" OptionalInt32 @
# CHECK-NEXT: "maybe" OptionalInt32 @
# CHECK-NEXT: "kind" OptionalInt32 @
# CHECK-NEXT: "sign" OptionalInt32 @
# CHECK: L3 CompiledObject size=48 fields=2
# CHECK-NEXT: "fraction" OptionalDouble @
# CHECK-NEXT: "large" OptionalDouble @
