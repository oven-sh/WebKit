# A layout whose objects may get a property under a computed key has the word for extra properties: in free bytes of the cell, or in a cell that grows for it
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow references=narrow
# RUN: plan-slots layouts
# RUN(ALLOCATIONS): place allocations
# STATISTIC: HiddenWordsPlaced >= 2

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="HasFreeBytes" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="CannotGainProperties" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 name="Full" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
layout L3 name="FullAndCannotGainProperties" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = ToString v1
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    ElemSet v5, v3, v2
    v7 = NewObject -, v2 layout=L1 fields=[0]
    v8 = FinishObject v7
    v9 = NewObject -, v2, v2 layout=L2 fields=[0, 1]
    v10 = FinishObject v9
    ElemSet v10, v3, v2
    v12 = NewObject -, v2, v2 layout=L3 fields=[0, 1]
    v13 = FinishObject v12
    Return
}

# CHECK: L0 CompiledObject size=32
# CHECK-NEXT: .0 "x" {{*}} @16
# CHECK-NEXT: extra-properties Cell32 @24
# CHECK-NEXT: L1 CompiledObject size=32
# CHECK-NEXT: .0 "x" {{*}} @16
# CHECK-NEXT: L2 CompiledObject size=48
# CHECK-NEXT: .0 "x" {{*}} @16
# CHECK-NEXT: .1 "y" {{*}} @24
# CHECK-NEXT: extra-properties Cell32 @32
# CHECK-NEXT: L3 CompiledObject size=32
# CHECK-NEXT: .0 "x" {{*}} @16
# CHECK-NEXT: .1 "y" {{*}} @24
# CHECK-NOT: extra-properties

# ALLOCATIONS: allocation {{*}} L2 {{*}} size=48
# ALLOCATIONS: allocation {{*}} L3 {{*}} size=32
