# Each RegExp literal site has its own root word in the statics, whichever of the two operations it has, and literals that match alike share a record
# FORM: AsRead
# OPTIONS: only-passes=ShareRegExpLiterals,ResolveCalls,ResolveAccesses
# RUN: place statics program

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToString v1
    v3 = NewRegExp pattern="a+" regExpFlags=[Global] @10
    PutModuleVariable v3 variable=g0
    v5 = NewRegExp pattern="a+" regExpFlags=[HasIndices] @20
    v6 = PropGet v5 key="exec"
    v7 = Call v6, v5, v2 calleeKey="exec"
    v8 = NewRegExp pattern="a+" regExpFlags=[Sticky] @30
    PutModuleVariable v8 variable=g0
    v10 = NewRegExp pattern="a+" regExpFlags=[Global] @40
    PutModuleVariable v10 variable=g0
    v12 = NewRegExp pattern="b" regExpFlags=[Global] @50
    PutModuleVariable v12 variable=g0
    Return
}

# CHECK: statics size=56
# CHECK: g0 offset=0
# CHECK: module-value m0 @8
# CHECK-NEXT: site-cell NewRegExp @16
# CHECK-NEXT: site-cell SharedRegExpLiteral @24
# CHECK-NEXT: site-cell NewRegExp @32
# CHECK-NEXT: site-cell NewRegExp @40
# CHECK-NEXT: site-cell NewRegExp @48
# CHECK-NEXT: roots=[0 8 16 24 32 40 48]
# CHECK: = NewRegExp pattern="a+" regExpFlags=[Global] {{*}}regExpRecord=0 staticsOffset=16 @10
# CHECK: = SharedRegExpLiteral pattern="a+" regExpFlags=[HasIndices] regExpRecord=0 staticsOffset=24 @20
# CHECK: = NewRegExp pattern="a+" regExpFlags=[Sticky] {{*}}regExpRecord=1 staticsOffset=32 @30
# CHECK: = NewRegExp pattern="a+" regExpFlags=[Global] {{*}}regExpRecord=0 staticsOffset=40 @40
# CHECK: = NewRegExp pattern="b" regExpFlags=[Global] {{*}}regExpRecord=2 staticsOffset=48 @50
