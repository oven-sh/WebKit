# Five small integers lie in 16 bytes, and three of them can have 32 bits there. The fields whose names are read by name the most come first, and the cell stays as large as it is
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow testing=NoLayoutIsMadeSeldom
# RUN: plan-slots layouts

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="FiveBytes" fields=[{key="a" declared={type=int[0, 255]} flags=[IsRequired]}, {key="b" declared={type=int[0, 255]} flags=[IsRequired]}, {key="c" declared={type=int[0, 255]} flags=[IsRequired]}, {key="d" declared={type=int[0, 255]} flags=[IsRequired]}, {key="e" declared={type=int[0, 255]} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Integer integer=255
    v4 = BitAnd v2, v3
    v5 = NewObject -, v4, v4, v4, v4, v4 layout=L0 fields=[0, 1, 2, 3, 4]
    v6 = FinishObject v5
    v7 = PropGet v6 key="a"
    v8 = PropGet v6 key="b"
    v9 = PropGet v6 key="c"
    v10 = PropGet v6 key="d"
    v11 = PropGet v6 key="e"
    v12 = PropGet v1 key="c"
    v13 = PropGet v1 key="d"
    Return
}
# CHECK: L0 CompiledObject size=32
# CHECK-NEXT: "a" Uint8 @
# CHECK-NEXT: "b" Uint8 @
# CHECK-NEXT: "c" Int32 @
# CHECK-NEXT: "d" Int32 @
# CHECK-NEXT: "e" Int32 @
