# What the bundler imports for the constructs that it lowers is Bun's own code in the form of a file of the program. Its importers are linked to it, so it has a record like any module that is evaluated.
# A file of the program that imports it names it, so the table by path lists it: a load under that name at run time finds the compiled module.
# One that only another helper imports is named by no file of the program and stays out: isBundlerHelperNamedByProgram().
# RUN: tables
# RUN(MODULES): tables modules

variable g0 name="helper" module=m1 declared={type=anything} initialization=Undefined
module m0 path="/app/main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="bun:wrap" displayPath="bun:wrap" flags=[IsBundlerHelper] body=f1 exports=[{name="helper" variable=g0}]
module m2 path="/app/other.js" displayPath="other.js" body=f3
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0, -
    Return
}
function f1 name="wrap" module=m1 kind=Module role=Library results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    Return
}
function f2 name="helper" module=m1 role=Library results=[{type=anything}] {
  b0():
    Return
}
function f3 name="other" module=m2 kind=Module results=[{type=anything}] {
  b0():
    Return
}

# CHECK: modulesByPath 4 8
# MODULES: module m0 kind=SourceText path="/app/main.js"
# MODULES-NEXT: module m1 kind=SourceText path="bun:wrap"
# MODULES-NEXT: module m2 kind=SourceText path="/app/other.js"
# MODULES: modulesByPath modules=[m0 m2 m1 m3]
