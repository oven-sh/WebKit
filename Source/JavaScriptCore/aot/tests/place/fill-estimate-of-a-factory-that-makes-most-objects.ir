# function Type(flags) { this.flags = flags }   function createType(flags) { const type = new Type(flags); type.id = next++; return type }   function createOriginType(flags) { return new Type(flags) }
# createType runs in a loop, createOriginType once. Two places construct, and one of them goes on to store `id`. Each place counts with how often it runs: nearly every object gets the field right behind
# its construction, so the field is the constructor's like `flags` and gets room in the cell. Counted as one place of two it fell into the Extension, which every object from the loop then had to allocate.
# `rare` is stored by the place that seldom runs: it stays what it was
# FORM: AsRead
# OPTIONS: only-passes=ResolveCalls,ResolveAccesses,EstimateHeat
# RUN: plan-slots fill
# CHECK-LABEL: L0 allocated=
# CHECK-NEXT: .0 "flags" filled={{*}} byConstructor likely
# CHECK-NEXT: .1 "id" filled={{*}} byConstructor likely
# CHECK-NEXT: .2 "rare" filled=
# CHECK-NOT: byConstructor

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Type" constructor=f3 fields=[{key="flags" declared={type=anything}}, {key="id" declared={type=anything}}, {key="rare" declared={type=anything}}] flags=[IsConstructorFunction]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v1 function=f1
    PutModuleVariable v3 variable=g0
    v5 = ToBoolean v1
    Branch v5 -> taken b1(), notTaken b2()
  b2():
    v6 = CallDirect v1 function=f2
    PutModuleVariable v6 variable=g0
    Return
}
function f1 name="createType" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = Construct v1, -, v0
    PropSet v2, v0 key="id"
    Return v2
}
function f2 name="createOriginType" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewClosure function=f3
    v2 = Construct v1, -, v0
    PropSet v2, v0 key="rare"
    Return v2
}
function f3 name="Type" flags=[HasThis] thisType={type=L0} parameters=[{type=anything}] results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0, v1: anything):
    PropSet v0, v1 key="flags"
    Return
}
