# Of three pairs of layouts that fit no one order the lightest is tested with bits, and the members with a field are tested within the receivers of the access
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses,PlaceTypeTests heat=EverythingIsHot
# RUN: place shapes accesses

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="A" fields=[{key="x" declared={type=number}}, {key="k" declared={type=number}}]
layout L1 name="B" fields=[{key="x" declared={type=number}}, {key="k" declared={type=number}}]
layout L2 name="C" fields=[{key="x" declared={type=number}}, {key="k" declared={type=number}}]
variable g0 name="any" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject -, v2, v2 layout=L0 fields=[0, 1]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    v6 = NewObject -, v2 layout=L1 fields=[0]
    v7 = FinishObject v6
    PutModuleVariable v7 variable=g0
    v9 = NewObject -, v2, v2 layout=L2 fields=[0, 1]
    v10 = FinishObject v9
    PutModuleVariable v10 variable=g0
    Jump -> next b1()
  b1():
    LoopHint
    v13 = PropGet v0 key="first" [isFreeName]
    v14 = Convert v13 declared={type=L0|L1 flags=[IsExpected]}
    v15 = PropGet v14 key="x"
    v16 = PropGet v0 key="second" [isFreeName]
    v17 = Convert v16 declared={type=L1|L2 flags=[IsExpected]}
    v18 = PropGet v17 key="x"
    v19 = ToBoolean v18
    Branch v19 -> taken b1(), notTaken b2()
  b2():
    v20 = Convert v1 declared={type=L0|L2 flags=[IsExpected]}
    v21 = PropGet v20 key="x"
    v22 = GetModuleVariable variable=g0
    v23 = PropGet v22 key="k"
    Return
}
# The pairs A B and B C are tested in each iteration of a loop, so they get the ranges.
# CHECK: L0 shapes 1..1
# CHECK: L1 shapes 2..2
# CHECK: L2 shapes 3..3
# CHECK: set [L0, L1] upto 2 cost=2
# CHECK-NEXT: set [L1, L2] range 2..3 cost=3
# CHECK-NEXT: set [L0, L2] bits 1..3 0x5 {{*}}cost=6
# CHECK: set [L0, L2] within [L0, L1, L2] bits 1..3 0x5 {{*}}cost=6
# B never stores "k" and has no slot for it.
# CHECK: "k" [L0, L1, L2] read SomeMembers Double @24 withField=[L0, L2] test=bits 1..3 0x5
