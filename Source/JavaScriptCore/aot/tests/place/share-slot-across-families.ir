# Two classes that are not related declare fields of the same names in another order, and each has a class below it. What reads the fields through all four layouts joins the two families: each name gets one location in all four
# TODO: flow-termination: one site stands for what a base constructor allocates for every class below it, so a field of a derived class is filed under the base and a shared slot is refused
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow
# RUN: plan-slots layouts accesses
# STATISTIC: SharesRefused = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Node" constructor=f1 fields=[{key="pos" declared={type=number} flags=[IsRequired]}, {key="kind" declared={type=number} flags=[IsRequired]}, {key="parent" declared={type=anything} flags=[IsRequired]}]
layout L1 kind=Instance name="NodeBelow" base=L0 constructor=f2 fields=[{key="name" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
layout L2 kind=Instance name="Token" constructor=f3 fields=[{key="parent" declared={type=anything} flags=[IsRequired]}, {key="own" declared={type=number} flags=[IsRequired]}, {key="kind" declared={type=number} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}]
layout L3 kind=Instance name="TokenBelow" base=L2 constructor=f4 fields=[{key="text" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
variable g0 name="Node" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="Token" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="any" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="below" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = NewClosure function=f1
    v4 = NewClass v3 layout=L0
    v5 = FinishClass v4 layout=L0
    PutModuleVariable v5 variable=g0
    v7 = ResolveHeritage v5
    v8 = NewClosure function=f2
    v9 = NewClass v8, v5, v7 layout=L1
    v10 = FinishClass v9 layout=L1
    v11 = NewClosure function=f3
    v12 = NewClass v11 layout=L2
    v13 = FinishClass v12 layout=L2
    PutModuleVariable v13 variable=g1
    v15 = ResolveHeritage v13
    v16 = NewClosure function=f4
    v17 = NewClass v16, v13, v15 layout=L3
    v18 = FinishClass v17 layout=L3
    v19 = Construct v5, -, v2
    v20 = Construct v10, -, v2
    v21 = Construct v13, -, v2
    v22 = Construct v18, -, v2
    PutModuleVariable v19 variable=g2
    PutModuleVariable v20 variable=g2
    PutModuleVariable v21 variable=g2
    PutModuleVariable v22 variable=g2
    PutModuleVariable v20 variable=g3
    PutModuleVariable v22 variable=g3
    v29 = GetModuleVariable variable=g2
    v30 = PropGet v29 key="kind"
    v31 = PropGet v29 key="pos"
    v32 = PropGet v29 key="parent"
    v33 = GetModuleVariable variable=g3
    v34 = PropGet v33 key="name"
    v35 = PropGet v21 key="own"
    v36 = PropGet v22 key="text"
    Return
}
function f1 name="Node" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="pos"
    PropSet v3, v1 key="kind"
    PropSet v3, v1 key="parent"
    v7 = FinishObject v3
    Return v7
}
function f2 name="NodeBelow" kind=DerivedConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = GetModuleVariable variable=g0
    v3 = SuperConstruct v2, v0, v1 layout=L1
    PropSet v3, v1 key="name"
    Return v3
}
function f3 name="Token" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L2
    v3 = NewObject v2 layout=L2
    PropSet v3, v1 key="parent"
    PropSet v3, v1 key="own"
    PropSet v3, v1 key="kind"
    PropSet v3, v1 key="pos"
    v8 = FinishObject v3
    Return v8
}
function f4 name="TokenBelow" kind=DerivedConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = GetModuleVariable variable=g1
    v3 = SuperConstruct v2, v0, v1 layout=L3
    PropSet v3, v1 key="text"
    PropSet v3, v1 key="name"
    Return v3
}
# CHECK: L0 CompiledObject size=48
# CHECK: L1 CompiledObject size=48
# CHECK: L2 CompiledObject size=64
# CHECK: L3 CompiledObject size=64
# CHECK: "pos" {L0 L1 L2 L3} read
# CHECK-NEXT: one location Double @16
# CHECK: "kind" {L0 L1 L2 L3} read
# CHECK-NEXT: one location Double @24
# CHECK: "parent" {L0 L1 L2 L3} read
# CHECK-NEXT: one location Double @32
# Flow gives the classes above the name that the classes below store, so four layouts hold it. "own", which only one family has, makes room for it.
# CHECK: "name" {L0 L1 L2 L3} read
# CHECK-NEXT: one location OptionalDouble @40
