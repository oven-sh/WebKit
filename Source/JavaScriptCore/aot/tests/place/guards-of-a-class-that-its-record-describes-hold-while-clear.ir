# class Widget { first() {} }   class Button extends Widget { second() {} }   class Keyed { [key]() {}  third() {} }   function Made() {}  Made.prototype.fourth = function () {}
# The definition of Widget runs once and every member has a constant name, so it can only make what the record says, and the same goes for Button below it. Their guards hold from the start:
# a clear bit says that the guard holds, nothing is looked at when the class is defined, and whoever changes the class sets the bit. A set of such guards holds while clear as well.
# Keyed has a member whose name is computed, so its guards hold once somebody has looked; a set of them still holds while clear, because nothing can be said of a class before it is defined.
# The function Made is there before its class, so neither its guards nor a set with one of them hold while clear.
# FORM: AsRead
# RUN: place guards
# RUN(TABLES): tables layouts

module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Widget" module=m0 constructor=f1
layout L1 kind=Instance name="Button" module=m0 base=L0 constructor=f2 flags=[HasHeritage]
layout L2 kind=Instance name="Keyed" module=m0 constructor=f3
layout L3 kind=Instance name="Made" module=m0 constructor=f4 flags=[IsConstructorFunction]
variable g0 name="Widget" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="Button" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="Keyed" module=m0 declared={type=anything} initialization=Undefined
variable g3 name="Made" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClass v2 layout=L0
    v4 = NewClosure function=f5
    DefineMethod v3, v4 layout=L0 key="first"
    v6 = FinishClass v3 layout=L0
    PutModuleVariable v6 variable=g0
    v8 = ResolveHeritage v6
    v9 = NewClosure function=f2
    v10 = NewClass v9, v6, v8 layout=L1
    v11 = NewClosure function=f6
    DefineMethod v10, v11 layout=L1 key="second"
    v13 = FinishClass v10 layout=L1
    PutModuleVariable v13 variable=g1
    v15 = NewClosure function=f3
    v16 = NewClass v15 layout=L2
    v17 = PropGet v0 key="key" [isFreeName]
    v18 = ToPropertyKey v17
    v19 = NewClosure function=f7
    DefineMethod v16, v19, v18 layout=L2
    v21 = NewClosure function=f8
    DefineMethod v16, v21 layout=L2 index=1 key="third"
    v23 = FinishClass v16 layout=L2
    PutModuleVariable v23 variable=g2
    v25 = NewClosure function=f4
    PutModuleVariable v25 variable=g3
    v27 = PropGet v25 key="prototype"
    v28 = NewClosure function=f9
    PropSet v27, v28 key="fourth"
    v30 = NewClosure function=f10
    v31 = Call v1, -, v6, v13, v23, v25, v30
    Return
}
function f1 name="Widget" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="Button" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f3 name="Keyed" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2
    Return v2
}
function f4 name="Made" flags=[HasThis] thisType={type=L3 flags=[IsExpected]} results=[{type=anything}] {
    Return
}
function f5 name="first" kind=Method flags=[HasThis] results=[{type=anything}] {
    Return
}
function f6 name="second" kind=Method flags=[HasThis] results=[{type=anything}] {
    Return
}
function f7 name="computed" kind=Method flags=[HasThis] results=[{type=anything}] {
    Return
}
function f8 name="third" kind=Method flags=[HasThis] results=[{type=anything}] {
    Return
}
function f9 name="fourth" flags=[HasThis] thisType={type=anything} results=[{type=anything}] {
    Return
}
function f10 name="use" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = Construct v0, -
    v2 = PropGet v1 key="first"
    v3 = Call v2, v1 calleeKey="first"
    v4 = PropGet v1 key="second"
    v5 = Call v4, v1 calleeKey="second"
    v6 = GetModuleVariable variable=g2
    v7 = Construct v6, -
    v8 = PropGet v7 key="third"
    v9 = Call v8, v7 calleeKey="third"
    v10 = GetModuleVariable variable=g3
    v11 = Construct v10, -
    v12 = PropGet v11 key="fourth"
    v13 = Call v12, v11 calleeKey="fourth"
    Return
}

# CHECK: L1 Prototype Member "first" {{*}} holdsWhileClear
# CHECK: L1 Static PrototypeLink - {{*}} holdsWhileClear
# CHECK-NOT: holdsWhileClear
# CHECK: L3 Static Member "prototype"
# The two sets of Button's guards and the set of Keyed's, then the set of Made's.
# CHECK-NEXT: set [{{*}}] {{*}} holdsWhileClear
# CHECK-NEXT: set [{{*}}] {{*}} holdsWhileClear
# CHECK-NEXT: set [{{*}}] {{*}} holdsWhileClear
# CHECK-NOT: holdsWhileClear
# TABLES: class index=L0 {{*}} guardsHoldWhileClear
# TABLES: class index=L1 {{*}} guardsHoldWhileClear
# TABLES: guard name="first" kind=Member side=Prototype
# TABLES-NEXT: set bit={{*}} holdsWhileClear members=[{{*}}] awaitedBeforeClassExists=[] holdingWhileClear=[{{*}} {{*}}]
# TABLES-NOT: guardsHoldWhileClear
# TABLES: class index=L2
# TABLES: guard name="third" kind=Member side=Prototype
# TABLES-NEXT: set bit={{*}} holdsWhileClear members=[{{*}}] awaitedBeforeClassExists=[] holdingWhileClear=[]
# TABLES: class index=L3
# TABLES-NOT: holdsWhileClear
# TABLES: shapeSetBits
