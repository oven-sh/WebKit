# The run time allocates the object of a subclass and of a function called with new without keys, so in such a layout with ordered keys every slot needs an absent state: the store that creates the field records the key
# RUN: check-placement run-time-allocation
# DIAGNOSTIC: PlacementCheckFailed 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="NeverEnumerated" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="Enumerated" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    v6 = NewObject -, v2 layout=L1 fields=[0]
    v7 = FinishObject v6
    v8 = Builtin builtin=ObjectKeys
    v9 = Call v8, -, v7
    PutModuleVariable v9 variable=g0
    Return
}

# CHECK: mutated L1
# CHECK-NEXT: rule AbsentStateMissing
