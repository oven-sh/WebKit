# A required number, a field that is stored once and a field that starts with a value stay inline.
# CHECK: L0 CompiledObject size=128 extension=320
# CHECK-NEXT: .0 "required0" Double @24
# CHECK: .8 "required8" Double @88
# CHECK-NEXT: .9 "storedOnce" OptionalDouble @96
# CHECK-NEXT: .10 "initialized" Double @104
# The 16 bytes that are left under the cap of 128 go to the field that is accessed, then to the first of the others.
# CHECK-NEXT: .11 "optional0" OptionalDouble @112
# CHECK-NEXT: .12 "optional1" JSValue out@8 record=
# CHECK-NEXT: .13 "optional2" JSValue out@16 record=
# CHECK: .50 "optional39" JSValue out@312 record=
# CHECK-NEXT: .51 "hot" OptionalDouble @120
# CHECK-NEXT: extension Cell32 @16
# A store to a slot that is always filled allocates nothing, so it cannot create an Extension.
# CHECK-NEXT: L1 CompiledObject size=144 extension=0
# CHECK-NOT: out@
# Nothing of L2 is set to a value at creation, so its cap is 48 bytes. A field that an allocation lists as undefined exists before the Extension does.
# CHECK: L2 CompiledObject size=48 extension=112
# CHECK-NEXT: .0 "listed0" OptionalDouble @24
# CHECK-NEXT: .1 "listed1" OptionalDouble @32
# CHECK-NEXT: .2 "listed2" OptionalDouble @40
# CHECK-NEXT: .3 "listed3" JSValue out@8 unlisted
# CHECK: .15 "listed15" JSValue out@104 unlisted
# CHECK-NEXT: extension Cell32 @16
