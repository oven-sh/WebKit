    PropSet v0, v1 key="optional33"
    PropSet v0, v1 key="optional34"
    PropSet v0, v1 key="optional35"
    PropSet v0, v1 key="optional36"
    PropSet v0, v1 key="optional37"
    PropSet v0, v1 key="optional38"
    PropSet v0, v1 key="optional39"
    PropSet v0, v1 key="hot"
    Return
}
function f2 name="fillObject" parameters=[{type=anything}, {type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    PropSet v0, v1 key="listed0"
    PropSet v0, v1 key="listed1"
    PropSet v0, v1 key="listed2"
    PropSet v0, v1 key="listed3"
    PropSet v0, v1 key="listed4"
    PropSet v0, v1 key="listed5"
    PropSet v0, v1 key="listed6"
