# The code that evaluated `Gone` and made its instances is gone: no body names the class, and nothing that a body names does. The tables describe the class that is evaluated and not the other:
# no record, no rank, no row of constructors, none of its names.
# RUN: tables layouts
# RUN(STRINGS): tables named-strings
# CHECK: index=L0
# CHECK-NOT: index=L1
# CHECK-NOT: fieldOfGone
# STRINGS-NOT: fieldOfGone

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Kept" module=m0 constructor=f1 fields=[{key="fieldOfKept" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Instance name="Gone" module=m0 constructor=f2 fields=[{key="fieldOfGone" declared={type=number} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2, v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="publish" [isFreeName]
    v6 = Call v5, -, v3
    Return v3
}
function f1 name="Kept" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = Double number=1.5
    PropSet v2, v3 key="fieldOfKept" mode=Strict
    Return v2
}
function f2 name="Gone" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}]
