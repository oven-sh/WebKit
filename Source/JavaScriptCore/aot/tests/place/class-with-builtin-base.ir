# The instances of a class that extends a built-in class are cells of that class, so placement gives the layout no shape and no slots, at any depth. The class keeps its record. A class of the program beside it gets both
# RUN: plan-slots layouts
# RUN(TABLES): tables layouts
# CHECK-NOT: L0 CompiledObject
# CHECK-NOT: L1 CompiledObject
# CHECK: L2 CompiledObject
# CHECK-NEXT: .0 "x"
# TABLES-NOT: index=L0 kind=Instance
# TABLES-NOT: index=L1 kind=Instance
# TABLES: layout shape=[[shape]] index=L2 kind=Instance name="Plain"
# TABLES: class index=L0 shape=0 base=- {{*}}hasUntypedBase
# TABLES: class index=L1 shape=0 base=L0
# TABLES: class index=L2 shape=[[shape]] base=-

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="List" module=m0 constructor=f1 fields=[{key="tag" declared={type=anything}}, {key="size" declared={type=anything}}] flags=[HasHeritage]
layout L1 kind=Instance name="Longer" module=m0 base=L0 constructor=f2 fields=[{key="extra" declared={type=anything}}] flags=[HasHeritage]
layout L2 kind=Instance name="Plain" module=m0 constructor=f3 fields=[{key="x" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = PropGet v0 key="Array" [isFreeName]
    v3 = NewClosure function=f1
    v4 = ResolveHeritage v2
    v5 = NewClass v3, v2, v4 layout=L0
    v6 = FinishClass v5 layout=L0
    v7 = NewClosure function=f2
    v8 = ResolveHeritage v6
    v9 = NewClass v7, v6, v8 layout=L1
    v10 = FinishClass v9 layout=L1
    v11 = NewClosure function=f3
    v12 = NewClass v11 layout=L2
    v13 = FinishClass v12 layout=L2
    v14 = Construct v6
    v15 = Construct v10
    v16 = Construct v13
    v17 = PropGet v14 key="tag"
    v18 = PropGet v15 key="extra"
    v19 = Call v1, -, v17, v18, v16
    Return
}
function f1 name="List" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L0
    v4 = String string="t"
    PropSet v3, v4 key="tag" mode=Strict
    v6 = Double number=1.5
    PropSet v3, v6 key="size" mode=Strict
    Return v3
}
function f2 name="Longer" kind=DerivedConstructor flags=[HasNewTarget, TakesCallee] results=[{type=anything}] {
    v2 = GetSuperBase v0 homeKind=Object
    v3 = SuperConstruct v2, v1 layout=L1
    v4 = String string="x"
    PropSet v3, v4 key="extra" mode=Strict
    Return v3
}
function f3 name="Plain" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L2
    v2 = NewObject v1 layout=L2 fields=[]
    v3 = Integer integer=1
    PropSet v2, v3 key="x" mode=Strict
    Return v2
}
