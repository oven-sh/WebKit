# A mapped argument of a direct eval names the arguments object by its operand, and its slot holds the index of the argument as the offset of a JSValue
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow
# RUN: tables requests
# RUN(PLACED): place requests program

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
evalscope e0 mode=Sloppy flags=[IsInFunction] bindings=[{name="x" kind=MappedArgument field=1 operand=0}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = String string="x"
    v2 = Call v0, -, v1, v1
    Return
}
function f1 name="sloppy" flags=[IsSloppy, HasThis, TakesCallee, HasArgumentCount, HasHiddenRest] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: function, v2: int[0, 2147483647], v3: anything, v4: anything, v5: Array):
    v6 = CreateMappedArguments v1, v2, v5, v3, v4
    v7 = DirectEval v3, v0, -, v6 evalScope=e0
    Return v7
}

# The text and the value of this come before the environments, so the first environment is operand 2.
# CHECK: request 4 DirectEval module=m0 inFunction
# CHECK-NEXT: binding name="x" kind=MappedArgument depth=0 operand=2 function=- setter=- privateKey=- slot=JSValue@1
# CHECK-NOT: binding

# PLACED: request @4 DirectEval e0 m0
# PLACED-NEXT: requests size=52 shared=0
# PLACED: = DirectEval v3, v0, -, v6 evalScope=e0 request=4
