# What the log of type errors prints: a layout set has the name of the layout whose family it is, and a type site is in the table only if a value refers to it. Here that value is the report on the failing edge of a check
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow type-errors=log
# RUN: tables types

module m0 path="/src/a.ts" displayPath="a.ts" body=f0 requests=[{target=m1 completes=true}] positions={lineStarts=[0, 10, 20]}
module m1 path="/src/b.ts" displayPath="b.ts" body=f1 positions={lineStarts=[0, 30]}
entry module=m0
typesite w0 module=m0 position=5 kind=Variable text="Point"
typesite w1 module=m0 position=9 kind=Assertion text="Line"
layout L0 name="Point" module=m0 position=12 fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="Point" module=m1 position=40 fields=[{key="y" declared={type=number} flags=[IsRequired]}]
layout L2 name="Line" module=m0 position=25 fields=[{key="z" declared={type=number} flags=[IsRequired]}]
# The tables name the type of a field, and that of a variable only where it is a static field.
layout L3 name="HoldsPoint" module=m0 position=26 fields=[{key="p" declared={type=L0} flags=[IsRequired]}]
layout L4 name="HoldsOtherPoint" module=m1 position=41 fields=[{key="q" declared={type=L1} flags=[IsRequired]}]
variable g0 name="p" module=m0 declared={type=L0 site=w0} initialization=Undefined
variable g1 name="q" module=m1 declared={type=L1} initialization=Undefined
variable g2 name="r" module=m0 declared={type=L2} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    v6 = GetModuleVariable variable=g0
    v7 = NewObject -, v2 layout=L2 fields=[0]
    v8 = FinishObject v7
    PutModuleVariable v8 variable=g2
    v10 = GetModuleVariable variable=g2
    v11 = Convert v1 declared={type=L2 site=w1} illTypedCause=FromLooseType
    v12 = PropGet v11 key="z"
    v13 = NewObject -, v4 layout=L3 fields=[0]
    v14 = FinishObject v13
    v15 = PropGet v14 key="p"
    Return
}
function f1 name="other" module=m1 kind=Module results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = NewObject -, v0 layout=L1 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g1
    v4 = GetModuleVariable variable=g1
    v5 = NewObject -, v2 layout=L4 fields=[0]
    v6 = FinishObject v5
    v7 = PropGet v6 key="q"
    Return
}
# CHECK: set {{*}} name="Point"
# CHECK-NEXT: set {{*}} name="Point"
# CHECK-NEXT: set {{*}} name="Line"
# CHECK-NEXT: site w1 module=m0 position=9 kind=Assertion text="Line"
# CHECK-NOT: site w
