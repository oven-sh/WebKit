# main.js imports eager.js and loads top.js with import(). top.js imports between.js, which imports leaf.js; top.js and leaf.js have a variable that is read before it is stored, between.js has none.
# The word of eager.js is filled when the program is entered. The words of top.js and leaf.js lie file by file behind it, no run goes on from one file into the next, and each of the three files lists the files it imports.
# RUN(STATICS): tables statics
# RUN(PLACED): place statics

module m0 path="main.js" displayPath="main.js" body=f0 requests=[{target=m1 completes=true}]
module m1 path="eager.js" displayPath="eager.js" body=f1 exports=[{name="a" variable=g0}]
module m2 path="top.js" displayPath="top.js" body=f2 requests=[{target=m3 completes=true}] exports=[{name="b" variable=g1}]
module m3 path="between.js" displayPath="between.js" body=f3 requests=[{target=m4 completes=true}]
module m4 path="leaf.js" displayPath="leaf.js" body=f4 exports=[{name="c" variable=g2}, {name="d" variable=g3}]
entry module=m0
variable g0 name="a" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="b" module=m2 declared={type=anything} initialization=Undefined
variable g2 name="c" module=m4 declared={type=anything} initialization=Undefined
variable g3 name="d" module=m4 declared={type=anything} initialization=Undefined
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = ImportModule module=m2 referrer=m0
    Return
}
function f1 name="eager" module=m1 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f5
    v3 = PropGet v0 key="publish" [isFreeName]
    v4 = Call v3, -, v2
    PutModuleVariable v1 variable=g0
    Return
}
function f2 name="top" module=m2 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f6
    v3 = PropGet v0 key="publish" [isFreeName]
    v4 = Call v3, -, v2
    PutModuleVariable v1 variable=g1
    Return
}
function f3 name="between" module=m3 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = Call v1, -
    Return
}
function f4 name="leaf" module=m4 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = NewClosure function=f7
    v3 = PropGet v0 key="publish" [isFreeName]
    v4 = Call v3, -, v2
    PutModuleVariable v1 variable=g2
    PutModuleVariable v1 variable=g3
    Return
}
function f5 name="readsA" module=m1 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    Return v0
}
function f6 name="readsB" module=m2 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    Return v0
}
function f7 name="readsCAndD" module=m4 results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = GetModuleVariable variable=g3
    v2 = NewArray v0, v1 contents=anything holes=[]
    Return v2
}

# STATICS: layout filledAtProgramEntry=8
