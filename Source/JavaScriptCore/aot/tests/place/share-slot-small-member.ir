# The names that are read most take the lowest offsets of the two large layouts. Those are the only offsets that the small layout has for "pos" and "end", which it shares with them.
# The sets that found no room go first in a second round, and every name gets one location. No cell grows
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses references=narrow testing=NoLayoutIsMadeSeldom
# RUN: plan-slots layouts accesses
# STATISTIC: SharedSlots = 4
# STATISTIC: SharesRefused = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Node" fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="flags" declared={type=number} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="end" declared={type=number} flags=[IsRequired]}]
layout L1 name="Token" fields=[{key="flags" declared={type=number} flags=[IsRequired]}, {key="end" declared={type=number} flags=[IsRequired]}, {key="kind" declared={type=number} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}]
layout L2 name="Range" fields=[{key="pos" declared={type=number} flags=[IsRequired]}, {key="end" declared={type=number} flags=[IsRequired]}]
variable g0 name="node" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="range" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject -, v2, v2, v2, v2 layout=L0 fields=[0, 1, 2, 3]
    v4 = FinishObject v3
    v5 = NewObject -, v2, v2, v2, v2 layout=L1 fields=[0, 1, 2, 3]
    v6 = FinishObject v5
    v7 = NewObject -, v2, v2 layout=L2 fields=[0, 1]
    v8 = FinishObject v7
    PutModuleVariable v4 variable=g0
    PutModuleVariable v6 variable=g0
    PutModuleVariable v4 variable=g1
    PutModuleVariable v6 variable=g1
    PutModuleVariable v8 variable=g1
    v14 = GetModuleVariable variable=g0
    v15 = PropGet v14 key="kind"
    v16 = PropGet v14 key="kind"
    v17 = PropGet v14 key="kind"
    v18 = PropGet v14 key="flags"
    v19 = PropGet v14 key="flags"
    v20 = GetModuleVariable variable=g1
    v21 = PropGet v20 key="pos"
    v22 = PropGet v20 key="end"
    Return
}
# CHECK: L0 CompiledObject size=48
# CHECK: L1 CompiledObject size=48
# CHECK: L2 CompiledObject size=32
# CHECK: "kind" {L0 L1} read
# CHECK-NEXT: one location Double @32
# CHECK-NEXT: "flags" {L0 L1} read
# CHECK-NEXT: one location Double @40
# CHECK-NEXT: "pos" {L0 L1 L2} read
# CHECK-NEXT: one location Double @16
# CHECK-NEXT: "end" {L0 L1 L2} read
# CHECK-NEXT: one location Double @24
