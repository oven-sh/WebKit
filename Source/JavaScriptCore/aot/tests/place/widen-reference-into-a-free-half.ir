# A free half of another word is room to widen a reference: the slot in the other half of the reference's word goes there
# FORM: AsRead
# OPTIONS: references=narrow only-passes=AnalyzeFlow disable=flow:NarrowedTypes testing=NoLayoutIsMadeSeldom
# RUN: plan-slots

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Node" fields=[{key="id" declared={type=i32} flags=[IsRequired]}]
layout L1 name="TwoHalves" fields=[{key="first" declared={type=null|L0} flags=[IsRequired]}, {key="low" declared={type=i32} flags=[IsRequired]}, {key="middle" declared={type=i32} flags=[IsRequired]}, {key="second" declared={type=null|L0} flags=[IsRequired]}, {key="high" declared={type=i32} flags=[IsRequired]}]
layout L2 name="OneHalf" fields=[{key="first" declared={type=null|L0} flags=[IsRequired]}, {key="low" declared={type=i32} flags=[IsRequired]}, {key="middle" declared={type=i32} flags=[IsRequired]}, {key="second" declared={type=null|L0} flags=[IsRequired]}, {key="high" declared={type=i32} flags=[IsRequired]}, {key="higher" declared={type=i32} flags=[IsRequired]}, {key="highest" declared={type=i32} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Integer integer=1
    v1 = Null
    v2 = NewObject -, v0 layout=L0 fields=[0]
    v3 = FinishObject v2
    v4 = NewObject -, v3, v0, v0, v1, v0 layout=L1 fields=[0, 1, 2, 3, 4]
    v5 = FinishObject v4
    v6 = NewObject -, v3, v0, v0, v1, v0, v0, v0 layout=L2 fields=[0, 1, 2, 3, 4, 5, 6]
    v7 = FinishObject v6
    Return
}
# "first" takes the free word at 40 and leaves the half at 16. "middle" goes there, and "second" grows over the half that "middle" leaves.
# CHECK: L1 CompiledObject size=48
# CHECK-NEXT: "first" JSValue @40
# CHECK-NEXT: "low" Int32 @20
# CHECK-NEXT: "middle" Int32 @16
# CHECK-NEXT: "second" JSValue @24
# CHECK-NEXT: "high" Int32 @32
# The one free half is at 44. "low" goes there, and nothing is left for "second".
# CHECK: L2 CompiledObject size=48
# CHECK-NEXT: "first" JSValue @16
# CHECK-NEXT: "low" Int32 @44
# CHECK-NEXT: "middle" Int32 @24
# CHECK-NEXT: "second" OptionalCell32 @28
