# CHECK-NEXT: f11 {{*}}callableKind=Bound
# CHECK-NEXT: f12 {{*}}takesNewTarget
# CHECK-NEXT: f13 {{*}}takesNewTarget
# CHECK-NEXT: f14 {{*}}callableKind=Method

