# The build says of a file that may load again from disk what its file looked like when it was read. The image lists that by module
# RUN: tables modules

module m0 path="/main.test.js" displayPath="main.test.js" body=f0 requests=[{target=m1 completes=true}, {target=m2 completes=true}]
module m1 path="/a.js" displayPath="a.js" body=f1
module m2 path="/b.js" displayPath="b.js" body=f2
sourcestamp module=m2 low=5 high=6
sourcestamp module=m1 low=3 high=4
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
    Return
}
function f1 name="a" module=m1 kind=Module results=[{type=anything}] {
    Return
}
function f2 name="b" module=m2 kind=Module results=[{type=anything}] {
    Return
}

# CHECK-NOT: sourceStamp module=m0
# CHECK: sourceStamp module=m1 low=3 high=4
# CHECK-NEXT: sourceStamp module=m2 low=5 high=6
