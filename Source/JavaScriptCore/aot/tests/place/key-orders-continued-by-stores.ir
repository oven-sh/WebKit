# What stores create is expected behind the keys of an allocation in the sequence in which the text holds the stores: nine allocation orders and eight created fields make nine orders, not 72. The code of a store names at most two places where its field comes next, and what a store makes of any other place is numbered at run time
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses
# RUN: place key-orders key-order-continuations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="a0" declared={type=number}}, {key="a1" declared={type=number}}, {key="a2" declared={type=number}}, {key="a3" declared={type=number}}, {key="a4" declared={type=number}}, {key="a5" declared={type=number}}, {key="a6" declared={type=number}}, {key="a7" declared={type=number}}, {key="a8" declared={type=number}}, {key="b0" declared={type=number}}, {key="b1" declared={type=number}}, {key="b2" declared={type=number}}, {key="b3" declared={type=number}}, {key="b4" declared={type=number}}, {key="b5" declared={type=number}}, {key="b6" declared={type=number}}, {key="b7" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = Builtin builtin=ObjectKeys
# REPEAT: i = 0..8
    v%(i*2+4) = NewObject -, v2 layout=L0 fields=[%(i)]
    v%(i*2+5) = FinishObject v%(i*2+4)
# END REPEAT
    v22 = CallDirect v5, v2 function=f1
    v23 = CallDirect v5, v2 function=f2
    v24 = CallDirect v5, v2 function=f3
    v25 = CallDirect v5, v2 function=f4
    v26 = CallDirect v5, v2 function=f5
    v27 = CallDirect v5, v2 function=f6
    v28 = CallDirect v5, v2 function=f7
    v29 = CallDirect v5, v2 function=f8
# REPEAT: i = 30..38
    v%(i) = Call v3, -, v%(i*2-55)
# END REPEAT
    Return
}
# REPEAT: i = 0..7
function f%(i+1) name="add%(i)" parameters=[{type=L0}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="b%(i)"
    Return
}
# END REPEAT
# CHECK: L0 orders=9: [0 9 10 11 12 13 14 15 16] [1 9 10 11 12 13 14 15 16] {{*}} [8 9 10 11 12 13 14 15 16]
# CHECK: L0 creating [9]: order=0 count=1 -> order=0 count=2; order=1 count=1 -> order=1 count=2;
# CHECK-NEXT: L0 creating [10]: order=0 count=2 -> order=0 count=3; order=1 count=2 -> order=1 count=3;
