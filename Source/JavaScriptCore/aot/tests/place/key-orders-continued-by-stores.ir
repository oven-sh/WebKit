# The code of a store names at most two places where its field comes next, so the image has the orders that the store makes of the first two orders it can continue, and no more: nine allocation orders and eight created fields make 16 orders, not 72. The other seven allocation orders stay as they are, and what a store makes of one is numbered at run time
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses
# RUN: place key-orders key-order-continuations

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Record" fields=[{key="a0" declared={type=number}}, {key="a1" declared={type=number}}, {key="a2" declared={type=number}}, {key="a3" declared={type=number}}, {key="a4" declared={type=number}}, {key="a5" declared={type=number}}, {key="a6" declared={type=number}}, {key="a7" declared={type=number}}, {key="a8" declared={type=number}}, {key="b0" declared={type=number}}, {key="b1" declared={type=number}}, {key="b2" declared={type=number}}, {key="b3" declared={type=number}}, {key="b4" declared={type=number}}, {key="b5" declared={type=number}}, {key="b6" declared={type=number}}, {key="b7" declared={type=number}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = Builtin builtin=ObjectKeys
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = NewObject -, v2 layout=L0 fields=[1]
    v7 = FinishObject v6
    v8 = NewObject -, v2 layout=L0 fields=[2]
    v9 = FinishObject v8
    v10 = NewObject -, v2 layout=L0 fields=[3]
    v11 = FinishObject v10
    v12 = NewObject -, v2 layout=L0 fields=[4]
    v13 = FinishObject v12
    v14 = NewObject -, v2 layout=L0 fields=[5]
    v15 = FinishObject v14
    v16 = NewObject -, v2 layout=L0 fields=[6]
    v17 = FinishObject v16
    v18 = NewObject -, v2 layout=L0 fields=[7]
    v19 = FinishObject v18
    v20 = NewObject -, v2 layout=L0 fields=[8]
    v21 = FinishObject v20
    v22 = CallDirect v5, v2 function=f1
    v23 = CallDirect v5, v2 function=f2
    v24 = CallDirect v5, v2 function=f3
    v25 = CallDirect v5, v2 function=f4
    v26 = CallDirect v5, v2 function=f5
    v27 = CallDirect v5, v2 function=f6
    v28 = CallDirect v5, v2 function=f7
    v29 = CallDirect v5, v2 function=f8
    v30 = Call v3, -, v5
    v31 = Call v3, -, v7
    v32 = Call v3, -, v9
    v33 = Call v3, -, v11
    v34 = Call v3, -, v13
    v35 = Call v3, -, v15
    v36 = Call v3, -, v17
    v37 = Call v3, -, v19
    v38 = Call v3, -, v21
    Return
}
function f1 name="add0" parameters=[{type=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: L0, v1: number):
    PropSet v0, v1 key="b0"
    Return
}
function f2 name="add1" parameters=[{type=L0}, {type=number}] results=[{type=anything}] {
  b0(v0: L0, v1: number):
    PropSet v0, v1 key="b1"
    Return
}
function f3 name="add2" parameters=[{type=L0}, {type=number}] results=[{type=anything}] {
