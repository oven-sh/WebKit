# An error at the top level of a module quotes what failed, so an executable keeps the text that the body of the module runs itself. The front end says which that is:
#   // note
#   run(function live() {}, function dead() {}).x;
#   last.y;
# each statement without the functions in it. A function that the program can enter has its own text, and what touches it is one piece with it. Nobody enters `dead`, so its text is not kept.
# No function stands for the text of the body: a place is found in it by its line and column. A body that runs nothing keeps nothing.
# RUN: tables function-texts
# CHECK: 4..22 "function live() {}"
# CHECK-NOT: dead
# CHECK: piece m0 0..24 line=2 column=1
# CHECK-NEXT: piece m0 24..28 line=2 column=43
# CHECK-NEXT: piece m0 28..35 line=3 column=1
# CHECK-NOT: piece

module m0 path="/a.js" displayPath="a.js" body=f0 positions={lineStarts=[0, 8, 55] textOfBody="\x08\x04\x12\x02\x12\x04\x01\x07"} functionText="// note\x0arun(function live() {}, function dead() {}).x;\x0alast.y;"
module m1 path="/b.js" displayPath="b.js" body=f3 positions={lineStarts=[0] textOfBody="\x00\x05"} functionText="idle;"
entry module=m0

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="run" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="live" module=m0 text={start=12 end=30} results=[{type=anything}] {
    Return
}
function f2 name="dead" module=m0 text={start=32 end=50} results=[{type=anything}] {
    Return
}
function f3 name="idle" module=m1 kind=Module results=[{type=anything}] {
    Return
}
