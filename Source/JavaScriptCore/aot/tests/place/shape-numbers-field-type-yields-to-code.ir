# The declared type of a field, which only the run time tests, yields to the sets that code tests: they get the consecutive shape numbers, and the type gets bits in the table of shape sets
# FORM: AsRead
# OPTIONS: only-passes=ResolveAccesses,PlaceTypeTests
# RUN: place shapes
# RUN(TABLES): tables types

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="First" fields=[{key="x" declared={type=number}}]
layout L1 name="Between" fields=[{key="x" declared={type=number}}]
layout L2 name="Last" fields=[{key="x" declared={type=number}}]
layout L3 name="Holder" fields=[{key="member" declared={type=L0|L2} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = NewObject -, v2 layout=L1 fields=[0]
    v6 = FinishObject v5
    v7 = NewObject -, v2 layout=L2 fields=[0]
    v8 = FinishObject v7
    v9 = NewObject -, v4 layout=L3 fields=[0]
    v10 = FinishObject v9
    v11 = NewObject -, v8 layout=L3 fields=[0]
    v12 = FinishObject v11
    Jump -> next b1()
  b1():
    LoopHint
    v14 = PropGet v0 key="first" [isFreeName]
    v15 = Convert v14 declared={type=L0|L1 flags=[IsExpected]}
    v16 = PropGet v15 key="x"
    v17 = PropGet v0 key="second" [isFreeName]
    v18 = Convert v17 declared={type=L1|L2 flags=[IsExpected]}
    v19 = PropGet v18 key="x"
    v20 = ToBoolean v19
    Branch v20 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK: L0 shapes 1..1
# CHECK: L1 shapes 2..2
# CHECK: L2 shapes 3..3
# CHECK: set [L0, L1] upto 2 cost=2
# CHECK-NEXT: set [L1, L2] range 2..3 cost=3
# TABLES: type L0|L2 {{*}}tests=[ShapeIn(1+3@0)]
