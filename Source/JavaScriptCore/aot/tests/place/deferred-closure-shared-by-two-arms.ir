# One created closure may be the value of both arms of a store into a slot that defers it: the arm by slot writes nothing, the arm by name brings the cell
# FORM: AsRead
# OPTIONS: references=narrow disable=pass:SinkConstants disable=pass:InlineCalls
# RUN: place program
# STATISTIC: DeferredClosureSlots = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="MayBeFrozen" constructor=f1 fields=[{key="run" declared={type=function} flags=[IsRequired]}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    v3 = Construct v2
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="Object" [isFreeName]
    v6 = PropGet v5 key="freeze"
    v7 = Call v6, v5, v3
    PutModuleVariable v3 variable=g0
    v9 = PropGet v3 key="run"
    PutModuleVariable v9 variable=g0
    Return
}
function f1 name="MayBeFrozen" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    v3 = CallDirect v2 function=f2
    Return v2
}
function f2 kind=Initializer flags=[HasThis] thisType={type=object written=L0 flags=[IsFromCompiler]} results=[{type=anything}] {
  b0(v0: object):
    v1 = NewClosure v0 function=f3
    PropDefine v0, v1 key="run"
    v3 = Undefined
    Return v3
}
function f3 name="run" kind=Arrow captures=[{type=L0}] results=[{type=anything}] {
  b0(v0: object ? L0):
    Return
}

# CHECK-LABEL: function f2
# CHECK: [[closure]]: f3 = NewClosure v0 function=f3 {{*}}closureForm=Slim
# CHECK: PutSlot v0, {{*}}, [[closure]] key="run" receivers=[L0] level=Predicted
# CHECK: PropDefine v0, [[closure]] key="run"
# CHECK-LABEL: function f3
