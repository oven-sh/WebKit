# Constant data is a tree of read-only nodes, children first, from word 1 on: an array is a header and its elements, an object a header, its values and the indices of its fields, four to a word
# RUN: tables data requests constants
# RUN(SIZES): tables

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Outer" fields=[{key="mixed" declared={type=anything} flags=[IsRequired]}, {key="doubles" declared={type=anything} flags=[IsRequired]}, {key="integers" declared={type=anything} flags=[IsRequired]}, {key="inner" declared={type=anything} flags=[IsRequired]}, {key="big" declared={type=anything} flags=[IsRequired]}, {key="text" declared={type=anything} flags=[IsRequired]}]
layout L1 name="Inner" fields=[{key="zero" declared={type=number} flags=[IsRequired]}, {key="nan" declared={type=number} flags=[IsRequired]}, {key="nothing" declared={type=anything} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="publish" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
data d0 root=Object{layout=L0 members=[{key="mixed" value=Array{contents=anything elements=[Number{value=1}, Hole, String{value="pear"}, Boolean{value=true}, Undefined]}}, {key="doubles" value=Array{contents=number elements=[Number{value=1.5}, Hole, Number{value=2}]}}, {key="integers" value=Array{contents=number elements=[Number{value=1}, Number{value=2}]}}, {key="inner" value=Object{layout=L1 members=[{key="zero" value=Number{value=-0}}, {key="nan" value=Number{value=NaN}}, {key="nothing" value=Null}]}}, {key="big" value=BigInt{digits="12345678901234567890"}}, {key="text" value=String{value="plum"}}]} module=m0

# CHECK: array 1 ArrayWithContiguous elements=[1 hole "pear" true undefined]
# CHECK-NEXT: array 7 ArrayWithDouble elements=[1.5 hole 2]
# CHECK-NEXT: array 11 ArrayWithInt32 elements=[1 2]
# CHECK-NEXT: object 14 allocation=[[inner]] fields=[0 1 2] values=[-0 NaN null]
# CHECK-NEXT: object 19 allocation=[[outer]] fields=[0 1 2 3 4 5] values=[@1 @7 @11 @14 "12345678901234567890"n "plum"]
# CHECK-NEXT: request 4 Data root=19 sharedStorage=-
# CHECK: bigInt 0 digits="12345678901234567890"
# SIZES: bigIntConstants 1 4
# SIZES-NEXT: data 28 224
# SIZES-NEXT: requests 3 12
