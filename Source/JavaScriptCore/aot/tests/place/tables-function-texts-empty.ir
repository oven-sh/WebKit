# Nested functions that are values and have no text give an empty table of texts. tables-function-texts.ir has the functions with text
# RUN: tables
# RUN(TEXTS): tables function-texts

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="outer" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    Return v0
}
function f2 name="inner" results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="value" [isFreeName]
    Return v1
}

# CHECK: magic ok
# CHECK: functionTexts 0 0
# TEXTS-NOT: ..
