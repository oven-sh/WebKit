# Prefixes share a key order, two sequences of the same keys are two orders, and the declared order is added only for objects that can start empty
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow
# RUN: place key-orders

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Prefix" fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number}}, {key="c" declared={type=number}}]
layout L1 name="Two" fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}]
layout L2 name="StartsEmpty" fields=[{key="a" declared={type=number}}, {key="b" declared={type=number}}]
layout L3 name="NeverEmpty" fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}]
variable g0 name="enumerated" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    v6 = NewObject -, v2, v2 layout=L0 fields=[0, 1]
    v7 = FinishObject v6
    PutModuleVariable v7 variable=g0
    v9 = NewObject -, v2, v2, v2 layout=L0 fields=[0, 1, 2]
    v10 = FinishObject v9
    PutModuleVariable v10 variable=g0
    v12 = NewObject -, v2, v2 layout=L1 fields=[0, 1]
    v13 = FinishObject v12
    PutModuleVariable v13 variable=g0
    v15 = NewObject -, v2, v2 layout=L1 fields=[1, 0]
    v16 = FinishObject v15
    PutModuleVariable v16 variable=g0
    v18 = NewObject layout=L2
    v19 = FinishObject v18
    PropSet v19, v2 key="a"
    PutModuleVariable v19 variable=g0
    v22 = NewObject -, v2 layout=L2 fields=[1]
    v23 = FinishObject v22
    PutModuleVariable v23 variable=g0
    v25 = NewObject -, v2, v2 layout=L3 fields=[1, 0]
    v26 = FinishObject v25
    PutModuleVariable v26 variable=g0
    v28 = GetModuleVariable variable=g0
    v29 = ForInOpen v28
    Return
}

# CHECK: L0 orders=1: [0 1 2]
# CHECK-NEXT: L1 orders=2: [0 1] [1 0]
# CHECK-NEXT: L2 orders=2: [0 1] [1]
# CHECK-NEXT: L3 orders=1: [1 0]
# CHECK: allocation {{*}} L0 fields=[0] order=0 count=1
# CHECK-NEXT: allocation {{*}} L0 fields=[0 1] order=0 count=2
# CHECK-NEXT: allocation {{*}} L0 fields=[0 1 2] order=0 count=3
# CHECK-NEXT: allocation {{*}} L1 fields=[0 1] order=0 count=2
# CHECK-NEXT: allocation {{*}} L1 fields=[1 0] order=1 count=2
# CHECK-NEXT: allocation {{*}} L2 fields=[] order=0 count=0
# CHECK-NEXT: allocation {{*}} L2 fields=[1] order=1 count=1
# CHECK-NEXT: allocation {{*}} L3 fields=[1 0] order=0 count=2
