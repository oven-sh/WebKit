# An environment stays alone or beside absent. Mixed with a JavaScript value it is anything.
# RUN: canonical
# CHECK: t0..t0 = env L0
# CHECK-NEXT: t0..t1 = absent|env L0
# CHECK-NEXT: t0..t2 = anything|absent
# CHECK-NEXT: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment
function f0 name="types" parameters=[{type=env L0}, {type=absent}, {type=undefined}] results=[{type=undefined}]
