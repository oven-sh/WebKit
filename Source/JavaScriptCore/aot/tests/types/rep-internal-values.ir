# An opaque kind has its own representation: a cell or a raw word. A cell that may be absent is a JSValue, a raw word stays one.
# The kinds that the wire cannot name are arguments, which count on behind the parameters.
# RUN: rep opaque(FlatString) opaque(CodeAddress) opaque(ViewVector) absent|opaque(CodeAddress)
# CHECK: t0: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t1: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t2: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t3: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t4: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t5: rep JSValue cells yes legal [Cell32, JSValue]
# CHECK-NEXT: t6: rep JSValue cells yes legal [Cell32, JSValue]
# CHECK-NEXT: t7: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t8: rep RawWord cells no legal [RawWord]
# CHECK-NEXT: t9: rep RawWord cells no legal [RawWord]
# CHECK-NEXT: t10: rep RawWord cells no legal [RawWord]
# CHECK: RawWord: never
# CHECK-NEXT: opaque(IteratorState): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(Enumerator): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(Exception): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(ClassToken): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(Cursor): RawWord legal [RawWord]
# CHECK-NEXT: opaque(KeyOrder): RawWord legal [RawWord]
# CHECK-NEXT: opaque(StringBuilder): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(FlatString): Cell legal [Cell, Cell32, JSValue]
# CHECK-NEXT: opaque(CodeAddress): RawWord legal [RawWord]
# CHECK-NEXT: opaque(Reciprocal): RawWord legal [RawWord]
# CHECK-NEXT: opaque(BuilderCursor): RawWord legal [RawWord]
# CHECK-NEXT: opaque(ViewVector): RawWord legal [RawWord]
# CHECK-NEXT: opaque(ArrayStoragePointer): RawWord legal [RawWord]
# CHECK-NEXT: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment
function f0 name="types" role=Signature parameters=[{type=iteratorstate}, {type=enumerator}, {type=exception}, {type=classtoken}, {type=env L0}, {type=absent|env L0}, {type=absent|classtoken}] results=[{type=undefined}]
entry module=m0
