# CHECK-NEXT: t0 - t1 = f1
# CHECK-NEXT: t0 & t2 = f1
# CHECK: t0 & t3 = never
# CHECK: t1 & t0 = f1
# CHECK-NEXT: t1 - t0 = Function
# CHECK: t1 & t2 = Function
# CHECK: t1 & t4 = f1|f2
# CHECK: t2 & t0 = f1
# CHECK: t2 & t1 = Function
# CHECK: t4 & t1 = f1|f2
# CHECK: laws hold

