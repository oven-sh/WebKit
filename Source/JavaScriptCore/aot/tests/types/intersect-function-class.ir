# CHECK-NEXT: t1 - t0 = Function
# CHECK: t1 & t3 = function
# CHECK: t1 & t5 = f1|f2
# CHECK: t2 & t0 = f1
# CHECK: t3 & t1 = Function
# CHECK: t5 & t1 = f1|f2
# CHECK: laws hold

