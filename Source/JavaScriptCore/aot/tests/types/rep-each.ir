# Each representation once: the default of a type, its slot, whether the collector must see it, every representation that can hold the type, and the widest type of each representation
# No type that the text can name has the form RawWord. It shows among the opaque kinds, which are listed behind the widest types.
# RUN: rep
# CHECK: t0: rep Boolean cells no legal [Boolean, JSValue]
# CHECK-NEXT: t1: rep Int32 cells no legal [Int32, Int64, Double, OptionalInt64, OptionalDouble, JSValue]
# CHECK-NEXT: t2: rep Int32 cells no legal [Int32, Int64, Double, OptionalInt64, OptionalDouble, JSValue]
# CHECK-NEXT: t3: rep Int64 cells no legal [Int64, Double, OptionalInt64, OptionalDouble, JSValue]
# CHECK-NEXT: t4: rep Double cells no legal [Double, OptionalDouble, JSValue]
# CHECK-NEXT: t5: rep OptionalInt64 cells no legal [OptionalInt64, OptionalDouble, JSValue]
# CHECK-NEXT: t6: rep OptionalDouble cells no legal [OptionalDouble, JSValue]
# CHECK-NEXT: t7: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t8: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t9: rep JSValue cells yes legal [JSValue]
# CHECK-NEXT: t10: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t11: rep Cell cells yes legal [Cell, Cell32, JSValue]
# CHECK-NEXT: t12: rep JSValue cells yes legal [Cell32, JSValue]
# CHECK-NEXT: t13: rep Void cells no legal [Void, OptionalInt64, OptionalDouble, Cell32, JSValue]
# CHECK-NEXT: Void: never
# CHECK-NEXT: Boolean: boolean
# CHECK-NEXT: Int32: i32
# CHECK-NEXT: Int64: int
# CHECK-NEXT: Double: number
# CHECK-NEXT: OptionalInt64: undefined|null|int|absent
# CHECK-NEXT: OptionalDouble: undefined|null|number|absent
# CHECK-NEXT: Cell: string|symbol|bigint|object
# CHECK-NEXT: Cell32: undefined|null|string|symbol|bigint|absent|object
# CHECK-NEXT: JSValue: absent|anything
# CHECK-NEXT: RawWord: never
# CHECK: opaque(CodeAddress): RawWord legal [RawWord]
# CHECK: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment
function f0 name="types" role=Signature parameters=[{type=boolean}, {type=int[0, 255]}, {type=int[-1, 255]}, {type=int}, {type=number}, {type=undefined|int}, {type=null|number}, {type=string}, {type=symbol}, {type=anything}, {type=iteratorstate}, {type=env L0}, {type=absent|env L0}, {type=undefined}] results=[{type=undefined}]
entry module=m0
