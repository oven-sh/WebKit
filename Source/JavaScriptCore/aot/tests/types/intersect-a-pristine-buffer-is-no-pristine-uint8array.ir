# One test tells a Buffer and a Uint8Array from everything else and not from each other. Only what finds the names of its class is known to be of that class and of no other
# What fails the test for a Uint8Array is no Buffer either.
# RUN: intersect
# CHECK: t0 - t1 = never
# CHECK: t0 & t3 = Buffer
# CHECK: t1 - t0 = Uint8Array
# CHECK: t2 & t3 = never
# CHECK: t3 & t0 = Buffer
# CHECK: t3 & t2 = never
# CHECK: t3 & t4 = Uint8Array<anything, pristine[Names]>
# CHECK: t3 & t5 = Buffer|Uint8Array<anything, pristine[Names]>
# CHECK: t4 & t0 = Buffer
# CHECK-NEXT: t4 - t0 = Uint8Array<anything, pristine[Names]>
# CHECK: t4 & t3 = Uint8Array<anything, pristine[Names]>
# CHECK-NEXT: t4 - t3 = Buffer<anything, pristine[Names]>
# CHECK: laws hold

module m0 path="main.js" displayPath="main.js"
function f0 name="types" parameters=[{type=Buffer}, {type=Uint8Array}, {type=Buffer<anything, pristine[Names]>}, {type=Uint8Array<anything, pristine[Names]>}, {type=Buffer<anything, pristine[Names]>|Uint8Array<anything, pristine[Names]>}, {type=Buffer|Uint8Array<anything, pristine[Names]>}] results=[{type=undefined}]
