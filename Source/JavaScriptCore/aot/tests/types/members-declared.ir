# After the read a layout is a member of itself and of every layout reachable through predicted bases and supertypes
# FORM: Prepared
# RUN: members

# The members of an interface are the interface, the classes that implement it and their subclasses.
module m0 path="main.js" displayPath="main.js"
layout L0 name="Named" fields=[{key="name" declared={type=string}}]
layout L1 kind=Instance name="Animal" fields=[{key="legs" declared={type=number}}]
layout L2 kind=Instance name="Dog" predictedBase=L1 fields=[{key="name" declared={type=string}}] supertypes=[L0] flags=[HasHeritage]
layout L3 kind=Instance name="Puppy" predictedBase=L2 flags=[HasHeritage]
# CHECK: L0: members [L0, L2, L3, L6]
# CHECK-NEXT: L1: members [L1, L2, L3]
# CHECK-NEXT: L2: members [L2, L3]
# CHECK-NEXT: L3: members [L3]

# A cycle in supertypes terminates, and each layout is a member of the other.
layout L4 name="Ping" supertypes=[L5]
layout L5 name="Pong" supertypes=[L4]
# CHECK-NEXT: L4: members [L4, L5]
# CHECK-NEXT: L5: members [L4, L5]

# A subclass may come before its base. A record may name a class as its supertype.
layout L6 kind=Instance name="Button" predictedBase=L7 fields=[{key="name" declared={type=string}}] supertypes=[L0] flags=[HasHeritage]
layout L7 kind=Instance name="Widget"
layout L8 name="WidgetOptions" supertypes=[L7]
# CHECK-NEXT: L6: members [L6]
# CHECK-NEXT: L7: members [L6, L7, L8]
# CHECK-NEXT: L8: members [L8]

# The only member of an environment is the environment.
layout L9 kind=Environment name="scope" fields=[{key="x" declared={type=anything}}]
# CHECK-NEXT: L9: members [L9]

# In this form a type holds the layouts it lists, not what is declared under them.
# CHECK-NEXT: t0: members [L0] only-layouts: yes
# CHECK-NEXT: t1: members [L1, L7] only-layouts: yes
function f0 name="types" parameters=[{type=L0}, {type=L1|L7}] results=[{type=undefined}]
