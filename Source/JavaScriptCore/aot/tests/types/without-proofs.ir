# The type a complete test can decide: a layout is tested as an object, a class without what is proven about its instances, and a built-in that each module has an object of its own for as a function or an object. A built-in of the realm is one cell, so it stays
# FORM: Prepared
# RUN: without-proofs
# CHECK: t0 = object
# CHECK-NEXT: t1 = object
# CHECK-NEXT: t2 = object
# CHECK-NEXT: t3 = function
# CHECK-NEXT: t4 = function
# CHECK-NEXT: t5 = undefined|number|function
# CHECK-NEXT: t6 = function|builtin(GlobalThis)
# CHECK-NEXT: t7 = object
# CHECK-NEXT: t8 = builtin(GlobalThis)|builtin(ArrayPrototypePush)
# CHECK-NEXT: t9 = f1
# CHECK-NEXT: t10 = object
# CHECK-NEXT: t11 = Array<int>
# CHECK-NEXT: t12 = RegExp
# CHECK-NEXT: t13 = int[0, 9]|"a"
# CHECK-NEXT: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0
function f0 name="types" parameters=[{type=builtin(ImportMeta)}, {type=builtin(ModuleObject)}, {type=builtin(ModuleObjectExports)}, {type=builtin(ModuleRequire)}, {type=builtin(ModuleRequireResolve)}, {type=undefined|number|builtin(ModuleRequire)}, {type=builtin(GlobalThis)|builtin(ModuleRequire)}, {type=builtin(GlobalThis)|builtin(ImportMeta)}, {type=builtin(GlobalThis)|builtin(ArrayPrototypePush)}, {type=f1}, {type=L0}, {type=Array<int, proven, Int32, pristine[Storage, Names]>}, {type=RegExp<"a"[]>}, {type=int[0, 9]|"a"}] results=[{type=undefined}]
function f1 name="listed" results=[{type=anything}]
