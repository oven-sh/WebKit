# The wider part absorbs the narrower one: function absorbs a listed function, object absorbs every object part
# RUN: canonical
# CHECK: t0..t0 = f1
# CHECK-NEXT: t0..t1 = function
# CHECK-NEXT: t0..t2 = function|L0
# CHECK-NEXT: t0..t3 = function|L0|Array<int>
# CHECK-NEXT: t0..t4 = object
# CHECK-NEXT: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0
function f0 name="types" parameters=[{type=f1}, {type=function}, {type=L0}, {type=Array<int>}, {type=object}] results=[{type=undefined}]
function f1 name="listed" results=[{type=anything}]
