# A family may have members that no layout stands for. What a cast to such a family gives lies inside the family: an object without a layout that only the source lists
# may be one of those members, so the result says `nolayout` of it and no longer names it. A part that the family lists itself keeps its name
# FORM: Prepared
# RUN(CAST): cast
# RUN(INTERSECT): intersect
# RUN(SUBSET): subset
# CAST: t1 as t0 = nolayout
# CAST: t1 as t7 = Array
# CAST: t2 as t0 = undefined|L0|nolayout
# CAST: t2 as t7 = L0|Array
# CAST: t3 as t0 = L0
# CAST: t4 as t0 = nolayout
# CAST: t5 as t0 = L0|nolayout
# CAST: t6 as t0 = undefined|null|L0|L1|nolayout
# CAST: laws hold
# INTERSECT: laws hold
# SUBSET: laws hold

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node"
layout L1 name="Token"
layout L2 name="Other"
function f0 name="types" parameters=[{type=undefined|null|L0|L1|nolayout}, {type=Array}, {type=undefined|Array|L0|L2}, {type=L0|L2}, {type=function}, {type=L0|L2|nolayout}, {type=anything}, {type=Array|L0|nolayout}, {type=object}, {type=string|builtin(ObjectPrototype)}] results=[{type=anything}]
