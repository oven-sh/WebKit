# Field lookup by key, with 7 and with 9 fields, and in the entries a subclass inherits along the classes as they are written
# RUN(SMALLFIRST): find-field L0 first
# RUN(SMALLSHARED): find-field L0 shared
# RUN(SMALLPRIVATE): find-field L0 #shared@L0
# RUN(SMALLLAST): find-field L0 last
# RUN(LARGEFIRST): find-field L1 first
# RUN(LARGESHARED): find-field L1 shared
# RUN(LARGEPRIVATE): find-field L1 #shared@L1
# RUN(LARGELAST): find-field L1 last
# SMALLFIRST: field: L0.0 declaration: L0.0
# SMALLSHARED: field: L0.3 declaration: L0.3
# SMALLPRIVATE: field: L0.2 declaration: L0.2
# SMALLLAST: field: L0.6 declaration: L0.6
# LARGEFIRST: field: L1.0 declaration: L1.0
# LARGESHARED: field: L1.3 declaration: L1.3
# LARGEPRIVATE: field: L1.2 declaration: L1.2
# LARGELAST: field: L1.8 declaration: L1.8

# A private name is not the text, and not the private name another class spells the same way. A null key finds nothing, not even a field without a key. A key that only an unrelated class declares is not found.
# RUN(NONE): find-field L0 secret
# RUN(NONE): find-field L1 secret
# RUN(NONE): find-field L0 #secret@L1
# RUN(NONE): find-field L1 #secret@L0
# RUN(NONE): find-field L0 missing
# RUN(NONE): find-field L1 missing
# RUN(NONE): find-field L4 -
# RUN(NONE): find-field L5 -
# RUN(NONE): find-field L3 e
# NONE: field: none

# Inherited entries follow the own ones in the order of the base, without the key the subclass declares again. The ninth entry is found through the index. The reader has taken them in, and taking them in again changes nothing.
# RUN(OWN): find-field L2 own
# RUN(SHADOWED): find-field L2 shared
# RUN(OWNSECRET): find-field L2 #secret@L2
# RUN(APPENDEDFIRST): find-field L2 first
# RUN(APPENDEDFIRST): find-field L2 first append-inherited
# RUN(APPENDEDSECRET): find-field L2 #secret@L0
# RUN(APPENDEDLAST): find-field L2 last
# RUN(TWICEFIRST): find-field L3 first
# RUN(TWICEFIRST): find-field L3 first append-inherited
# RUN(TWICESHARED): find-field L3 shared
# RUN(TWICEOWN): find-field L3 own
# RUN(TWICELAST): find-field L3 last
# OWN: field: L2.0 declaration: L2.0
# SHADOWED: field: L2.2 declaration: L2.2
# OWNSECRET: field: L2.1 declaration: L2.1
# APPENDEDFIRST: field: L2.3 declaration: L0.0
# APPENDEDSECRET: field: L2.4 declaration: L0.1
# APPENDEDLAST: field: L2.8 declaration: L0.6
# TWICEFIRST: field: L3.3 declaration: L0.0
# TWICESHARED: field: L3.2 declaration: L2.2
# TWICEOWN: field: L3.0 declaration: L2.0
# TWICELAST: field: L3.8 declaration: L0.6

# RUN(RANGE): find-field L1000 first
# RUN(NOOWNER): find-field L0 #secret
# RUN(BADOWNER): find-field L0 #secret@L1000
# RUN(EXTRA): find-field L0 first last
# RUN(BEHIND): find-field L0 first append-inherited last
# RUN(MISSING): find-field
# RUN(MISSING): find-field L0
# RANGE: error: bad argument L1000
# NOOWNER: error: bad argument #secret
# BADOWNER: error: bad argument #secret@L1000
# EXTRA: error: bad argument last
# BEHIND: error: bad argument last
# MISSING: error: missing argument

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Small" fields=[{key="first" declared={type=number}}, {key=#"secret"@L0 declared={type=number} flags=[IsPrivate]}, {key=#"shared"@L0 declared={type=number} flags=[IsPrivate]}, {key="shared" declared={type=number}}, {key="c" declared={type=number}}, {key="d" declared={type=number}}, {key="last" declared={type=number}}]
layout L1 kind=Instance name="Large" fields=[{key="first" declared={type=number}}, {key=#"secret"@L1 declared={type=number} flags=[IsPrivate]}, {key=#"shared"@L1 declared={type=number} flags=[IsPrivate]}, {key="shared" declared={type=number}}, {key="c" declared={type=number}}, {key="d" declared={type=number}}, {key="e" declared={type=number}}, {key="f" declared={type=number}}, {key="last" declared={type=number}}]
layout L2 kind=Instance name="Derived" base=L0 fields=[{key="own" declared={type=number}}, {key=#"secret"@L2 declared={type=number} flags=[IsPrivate]}, {key="shared" declared={type=string}}] flags=[HasHeritage]
layout L3 kind=Instance name="DerivedTwice" base=L2 flags=[HasHeritage]
layout L4 kind=Environment fields=[{declared={type=anything}}]
layout L5 kind=Environment fields=[{declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}, {declared={type=anything}}]
entry module=m0
