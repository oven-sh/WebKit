# CHECK: t0 & t4 = Array<number, proven, Double>
# CHECK: t0 & t5 = never
# CHECK: t1 & t0 = never
# CHECK: t1 & t3 = Array<number, proven, Contiguous>
# CHECK: t1 & t5 = never
# CHECK: t2 & t5 = Array<int, proven, Int32>
# CHECK: t5 & t3 = never
# CHECK: laws hold

