# An opaque value stays alone or beside absent. Mixed with a JavaScript value it is anything.
# The wire cannot name a code address, so the types are arguments.
# RUN: canonical opaque(CodeAddress) absent null object
# CHECK: t0..t0 = opaque(CodeAddress)
# CHECK-NEXT: t0..t1 = absent|opaque(CodeAddress)
# CHECK-NEXT: t0..t2 = absent|anything
# CHECK-NEXT: t0..t3 = absent|anything
# CHECK-NEXT: laws hold

module m0 path="main.js" displayPath="main.js"
function f0 name="types" role=Signature results=[{type=undefined}]
entry module=m0
