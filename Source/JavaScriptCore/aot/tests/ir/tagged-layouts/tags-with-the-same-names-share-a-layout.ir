layout L5 name="Not" fields=[{key="kind" declared={type=3} flags=[IsRequired]}, {key="operand" declared={type=undefined|null|L1} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}] supertypes=[L2] flags=[IsNeverAllocated]
layout L6 name="NotOrOther" fields=[{key="kind" declared={type=int[3, 4]} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}] supertypes=[L1] flags=[IsNeverAllocated]
