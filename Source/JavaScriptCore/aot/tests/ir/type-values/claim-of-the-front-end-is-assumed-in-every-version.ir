# Library code names an operation that takes one kind of value, and the front end claims that kind of the operand. Nothing tests a claim, and it holds whether or not the checks in front of the value stay:
# it becomes a type that is assumed in every version. It stays where the value has the type already: the position or the check that gives the type may go
# FORM: AsRead
# RUN: pass TypeValues VerifyProgram
# STATISTIC: RequestsResolvedToClaim = 4
# STATISTIC: RequestsResolvedToNothing = 0
# STATISTIC: RequestsResolvedToCheck = 2

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Assertion
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged
function f0 name="valueNobodyKnows" role=Library parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    PropDefine v1, v0 key="a"
    Return
# CHECK: v1: object = AssumeType v0 provenType=object [isWordOfFrontEnd]
# CHECK-NEXT: PropDefine v1, v0 key="a"
}
function f1 name="partOfWhatCheckLeaves" role=Library parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Convert v0 declared={type=undefined|L0 site=w0}
    v2 = Convert v1 declared={type=object flags=[IsFromCompiler, IsClaim]}
    PropDefine v2, v0 key="a"
    Return
# CHECK: v1: undefined|L0 = Check v0 expectedType=undefined|L0 site=w0
# CHECK-NEXT: v2: L0 = AssumeType v1 provenType=object [isWordOfFrontEnd]
# CHECK-NEXT: PropDefine v2, v0 key="a"
}
function f2 name="insideTheTypeByCheck" role=Library parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Convert v0 declared={type=L0 site=w0}
    v2 = Convert v1 declared={type=object flags=[IsFromCompiler, IsClaim]}
    PropDefine v2, v0 key="a"
    Return
# CHECK: v1: L0 = Check v0 expectedType=L0 site=w0
# CHECK-NEXT: v2: L0 = AssumeType v1 provenType=object [isWordOfFrontEnd]
# CHECK-NEXT: PropDefine v2, v0 key="a"
}
function f3 name="insideTheTypeByPosition" role=Library parameters=[{type=L0}] results=[{type=undefined}] {
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    PropDefine v1, v0 key="a"
    Return
# CHECK: v1: L0 = AssumeType v0 provenType=object [isWordOfFrontEnd]
# CHECK-NEXT: PropDefine v1, v0 key="a"
}
