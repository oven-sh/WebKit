# function inner(x: number): number { .. }  function outer(x: number): number { return inner(x) + 1 }
# The front end types the callee of `inner(x)` as that one function: a declaration that nothing assigns to. Whichever way a function is entered, what it returns has passed the
# conversions in front of its returns, so the result of the call by value has the declared result of the function, and the conversion behind the call is dropped (known).
# Beside it, each with a Check: a callee that may be one of two functions (either), a callee of any type (unknown), a callee whose result is only expected (expected).
# FORM: AsRead
# RUN: pass TypeValues
# STATISTIC: RequestsResolvedToCheck = 3
# STATISTIC: RequestsResolvedToNothing = 1

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=CallResult
typesite w1 module=m0 position=20 kind=Result
function f0 name="inner" parameters=[{type=anything}] results=[{type=number site=w1}] {
  b0(v0: anything):
    v1 = Integer integer=1
    Return v1
}
function f1 name="other" parameters=[{type=anything}] results=[{type=number site=w1}] {
  b0(v0: anything):
    v1 = Integer integer=2
    Return v1
}
function f2 name="loose" parameters=[{type=anything}] results=[{type=number site=w1 flags=[IsExpected]}] {
  b0(v0: anything):
    Return v0
}
function f3 name="known" captures=[{type=f0 flags=[IsFromCompiler]}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: f0, v1: anything):
    v2 = Call v0, -, v1
    v3 = Convert v2 declared={type=number site=w0}
    Return v3
}
# CHECK-LABEL: function f3 name="known"
# CHECK: [[result]]: number = Call v0, -, v1
# CHECK-NOT: Check
# CHECK: Return [[result]]
function f4 name="either" captures=[{type=f0|f1 flags=[IsFromCompiler]}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: f0|f1, v1: anything):
    v2 = Call v0, -, v1
    v3 = Convert v2 declared={type=number site=w0}
    Return v3
}
# CHECK-LABEL: function f4 name="either"
# CHECK: [[result]]: anything = Call v0, -, v1
# CHECK: = Check [[result]] castType=number
function f5 name="unknown" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    v3 = Convert v2 declared={type=number site=w0}
    Return v3
}
# CHECK-LABEL: function f5 name="unknown"
# CHECK: [[result]]: anything = Call v0, -, v1
# CHECK: = Check [[result]] castType=number
function f6 name="expected" captures=[{type=f2 flags=[IsFromCompiler]}] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: f2, v1: anything):
    v2 = Call v0, -, v1
    v3 = Convert v2 declared={type=number site=w0}
    Return v3
}
# CHECK-LABEL: function f6 name="expected"
# CHECK: [[result]]: anything{{*}} = Call v0, -, v1
# CHECK: = Check [[result]] castType=number
