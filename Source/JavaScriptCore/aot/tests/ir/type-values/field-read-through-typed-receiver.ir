# A read by name through a typed receiver proves nothing before flow: a store of another value, a deletion and a redefinition move a property out of its slot, and a read by name finds it wherever it is.
# What the fields of the family declare is what is expected of the read, and the conversion to the type of the field that the front end sends behind the read is a test.
# At the end: the type of a field that is only expected is tested nowhere, and a family that nothing allocates says nothing about the read
# FORM: AsRead
# RUN: pass TypeValues VerifyProgram
# STATISTIC: RequestsResolvedToCheck = 4
# STATISTIC: RequestsResolvedToNothing = 1
# STATISTIC: RequestsResolvedToUpcast = 0

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=PropertyRead
layout L0 name="Point" fields=[{key="x" declared={type=undefined|null|number}}]
layout L1 name="inferred" fields=[{key="x" declared={type=number flags=[IsExpected]}}] supertypes=[L0]
layout L2 name="inferredFromInferred" fields=[{key="x" declared={type=number flags=[IsExpected]}}] supertypes=[L1]
layout L3 name="unrelated" fields=[{key="x" declared={type=string flags=[IsExpected]}}]
layout L4 name="Labeled" fields=[{key="label" declared={type=undefined|null|string}}]
layout L5 name="NeverMade" fields=[{key="x" declared={type=undefined|null|number}}]
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged
function f0 name="allocates" results=[{type=anything}] {
  b0():
    v0 = NewObject layout=L0
    v1 = NewObject layout=L1
    v2 = NewObject layout=L2
    v3 = NewObject layout=L3
    v4 = NewObject layout=L4
    Return
}
function f1 name="throughFamily" parameters=[{type=undefined|null|L0 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|L0):
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=undefined|null|number site=w1}
    Return v2
}
# CHECK-LABEL: function f1 name="throughFamily"
# CHECK: b0(v0: undefined|null|L0|L1|L2):
# CHECK-NEXT: v1: anything ~ undefined|null|number = PropGet v0 key="x"
# CHECK-NEXT: v2: undefined|null|number = Check v1 castType=undefined|null|number site=w1
# CHECK-NEXT: Return v2
function f2 name="throughUnionWithUnrelatedType" parameters=[{type=undefined|null|L0|L3 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|L0|L3):
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=undefined|null|number|string site=w1}
    Return v2
}
# CHECK-LABEL: function f2 name="throughUnionWithUnrelatedType"
# CHECK: b0(v0: undefined|null|L0|L1|L2|L3):
# CHECK-NEXT: v1: anything ~ undefined|null|number|string = PropGet v0 key="x"
# CHECK-NEXT: v2: undefined|null|number|string = Check v1 castType=undefined|null|number|string site=w1
# CHECK-NEXT: Return v2
function f3 name="throughTypeThatTakesStrings" parameters=[{type=undefined|null|string|L4 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|string|L4):
    v1 = PropGet v0 key="label"
    v2 = Convert v1 declared={type=undefined|null|string site=w1}
    Return v2
}
# CHECK-LABEL: function f3 name="throughTypeThatTakesStrings"
# CHECK: b0(v0: undefined|null|string|L4):
# CHECK-NEXT: v1: anything ~ undefined|null|string = PropGet v0 key="label"
# CHECK-NEXT: v2: undefined|null|string = Check v1 castType=undefined|null|string site=w1
# CHECK-NEXT: Return v2
function f4 name="throughFamilyOfExpectedFields" parameters=[{type=undefined|null|L1 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|L1):
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=number site=w1 flags=[IsExpected]}
    Return v2
}
# CHECK-LABEL: function f4 name="throughFamilyOfExpectedFields"
# CHECK: b0(v0: undefined|null|L1|L2):
# CHECK-NEXT: v1: anything ~ undefined|number = PropGet v0 key="x"
# CHECK-NEXT: v2: anything ~ number = Upcast v1 castType=anything
# CHECK-NEXT: Return v2
function f5 name="throughFamilyThatNothingAllocates" parameters=[{type=undefined|null|L5 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|L5):
    v1 = PropGet v0 key="x"
    v2 = Convert v1 declared={type=undefined|null|number site=w1}
    Return v2
}
# CHECK-LABEL: function f5 name="throughFamilyThatNothingAllocates"
# CHECK: b0(v0: undefined|null|L5):
# CHECK-NEXT: v1: anything = PropGet v0 key="x"
# CHECK-NEXT: v2: undefined|null|number = Check v1 castType=undefined|null|number site=w1
# CHECK-NEXT: Return v2
