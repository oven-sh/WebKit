# In a build that logs type errors a request ends in a report and a prediction where thrown-mismatches.ir has a Claim, and no written type narrows a value
# FORM: AsRead
# OPTIONS: type-errors=log
# RUN: pass TypeValues
# STATISTIC: RequestsResolvedToReport = 8
# STATISTIC: RequestsResolvedToClaim = 1
# STATISTIC: ReturnCallsDemoted = 1

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Variable
typesite w1 module=m0 position=20 kind=Parameter
typesite w2 module=m0 position=30 kind=PropertyRead
typesite w3 module=m0 position=40 kind=Element
typesite w4 module=m0 position=50 kind=Result
typesite w5 module=m0 position=60 kind=Parameter
typesite w6 module=m0 position=70 kind=Variable
typesite w7 module=m0 position=80 kind=Parameter
layout L0 name="Point" fields=[{key="x" declared={type=undefined|null|number}}]
layout L1 kind=Environment fields=[{declared={type=undefined|null|number|absent site=w0}}, {declared={type=function flags=[IsFromCompiler]}}]
variable g0 name="count" module=m0 declared={type=undefined|null|number site=w0} initialization=Undefined
# CHECK: layout L0 name="Point" fields=[{key="x" declared={type=anything written=undefined|null|number}}]
# CHECK: layout L1 kind=Environment fields=[{declared={type=anything|absent written=undefined|null|number|absent site=w0}}, {declared={type=function flags=[IsFromCompiler]}}]
# CHECK: variable g0 name="count" module=m0 declared={type=anything written=undefined|null|number site=w0}
function f0 name="intoVariable" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|number site=w0}
    v2 = Integer integer=2
    v3 = Add v1, v2
    Return v3
}
# CHECK-LABEL: function f0 name="intoVariable"
# CHECK: b0(v0: anything):
# CHECK-NEXT: ReportMismatch v0 expectedType=undefined|null|number site=w0
# CHECK-NEXT: [[stored]]: anything {{*}}~ undefined|null|number = Predict v0 predicted=undefined|null|number
# CHECK: : number|string{{*}}= Add [[stored]],
function f1 name="parameter" parameters=[{type=undefined|null|number site=w1}] results=[{type=anything}] {
  b0(v0: undefined|null|number):
    Return v0
}
# CHECK-LABEL: function f1 name="parameter" {{*}}parameters=[{type=anything written=undefined|null|number site=w1}]
# CHECK: b0(v0: anything ~ undefined|null|number):
# CHECK-NEXT: ReportMismatch v0 expectedType=undefined|null|number site=w1 @20
# CHECK-NEXT: Return v0
function f2 name="fromCompiler" parameters=[{type=anything}, {type=Array<number> site=w7 flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: anything, v1: Array<number>):
    v2 = ClaimDeclared v0 declared={type=number flags=[IsFromCompiler]}
    Return v2
}
# CHECK-LABEL: function f2 name="fromCompiler" {{*}}parameters=[{type=anything}, {type=Array<number> site=w7 flags=[IsFromCompiler]}]
# CHECK: b0(v0: anything, v1: Array<number>):
# CHECK-NEXT: : number = Claim v0 castType=number
# CHECK-NOT: ReportMismatch
function f3 name="valueInside" results=[{type=anything}] {
  b0():
    v0 = Integer integer=2
    v1 = ClaimDeclared v0 declared={type=undefined|null|number site=w0}
    Return v1
}
# CHECK-LABEL: function f3 name="valueInside"
# CHECK-NOT: ReportMismatch
# CHECK: Return v0
function f4 name="fieldRead" parameters=[{type=undefined|null|L0 site=w5}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="x"
    v2 = ClaimRead v1, v0 source=Field{key="x"} site=w2
    Return v2
}
# CHECK-LABEL: function f4 name="fieldRead" {{*}}parameters=[{type=anything written=undefined|null|L0 site=w5}]
# CHECK: ReportMismatch v0 expectedType=undefined|null|object site=w5 @60
# CHECK-NEXT: [[read]]: anything {{*}}= PropGet v0 key="x"
# CHECK-NEXT: ReportMismatch [[read]] expectedType=undefined|null|number site=w2
# CHECK-NEXT: : anything {{*}}= Predict [[read]] predicted=undefined|null|number
function f5 name="contentsRead" results=[{type=anything}] {
  b0():
    v0 = NewArray contents=number holes=[]
    v1 = Integer integer=0
    v2 = ElemGet v0, v1
    v3 = ClaimRead v2, v0 source=Contents{} site=w3
    Return v3
}
# CHECK-LABEL: function f5 name="contentsRead"
# CHECK: [[element]]: anything {{*}}= ElemGet v0, v1
# CHECK-NEXT: ReportMismatch [[element]] expectedType=undefined|null|number site=w3
# CHECK-NEXT: : anything {{*}}= Predict [[element]] predicted=undefined|null|number
function f6 name="tailCall" parameters=[{type=anything}] results=[{type=undefined|null|number site=w4}] {
  b0(v0: anything):
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=undefined|null|number site=w4}}]
}
# CHECK-LABEL: function f6 name="tailCall"
# CHECK: [[result]]: anything = Call v0
# CHECK: ReportMismatch [[result]] expectedType=undefined|null|number site=w4
# CHECK-NEXT: Return
function f7 name="untypedTailCall" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    ReturnCall v1
}
# CHECK-LABEL: function f7 name="untypedTailCall"
# CHECK: ReturnCall v1
function f8 name="int32Promise" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|i32 predicted=i32 site=w6 flags=[IsInt32Promise]}
    Return v1
}
# CHECK-LABEL: function f8 name="int32Promise"
# CHECK: ReportMismatch v0 expectedType=undefined|null|i32 site=w6
# CHECK-NEXT: : anything {{*}}= Predict v0 predicted=i32
function f9 name="readVariable" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
# CHECK-LABEL: function f9 name="readVariable"
# CHECK: v0: anything ~ undefined|null|number = GetModuleVariable variable=g0
function f10 name="reportedOnce" parameters=[{type=undefined|null|number site=w1}] results=[{type=anything}] {
  b0(v0: undefined|null|number):
    v1 = ClaimDeclared v0 declared={type=undefined|null|number site=w6}
    Return v1
}
# CHECK-LABEL: function f10 name="reportedOnce"
# CHECK: ReportMismatch v0 expectedType=undefined|null|number site=w1 @20
# CHECK-NOT: ReportMismatch
# CHECK: Return
function f11 name="typedTailCall" results=[{type=undefined|null|number site=w4}] {
  b0():
    v0 = CallDirect function=f12
    ReturnCall v0 casts=[{declared={type=undefined|null|number site=w4}}]
}
# CHECK-LABEL: function f11 name="typedTailCall"
# CHECK: v0: anything {{*}}= CallDirect function=f12
# CHECK-NEXT: ReturnCall v0
function f12 name="typedCallee" results=[{type=undefined|null|number site=w4}] {
  b0():
    v0 = Integer integer=1
    Return v0
}
