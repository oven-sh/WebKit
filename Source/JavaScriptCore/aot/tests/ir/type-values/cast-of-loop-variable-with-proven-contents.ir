# The types of a loop rise from never by unions. A rule that answers something else for a wider operand, not more, leaves its first answer in the union:
# a cast takes the contents of an array from its operand while they are proven, and from its own type once they are not. What a value holds above its rule comes down again after the ascent
# FORM: Prepared
# RUN: pass RetypeValues

module m0 path="main.js" displayPath="main.js"
function f0 name="claim" parameters=[{type=boolean}, {type=Array<string, proven>}, {type=Array}] results=[{type=anything}] {
  b0(v0: boolean, v1: Array<string, proven>, v2: Array):
    Jump -> next b1(v1)
  b1(v3):
    LoopHint
    v5 = Claim v3 castType=Array<int>
    v6 = Predict v2 predicted=Array
    Branch v0 -> taken b2(), notTaken b3()
  b2():
    Jump -> next b1(v6)
  b3():
    Return v5
}
# CHECK-LABEL: function f0 name="claim"
# CHECK: v5: Array<int> = Claim
