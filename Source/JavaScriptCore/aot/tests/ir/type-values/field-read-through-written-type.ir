# A field read through a written type is tested against what the type declares, also when the layout of an inferred type flowed into the type
# FORM: AsRead
# RUN: pass TypeValues

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=PropertyRead
typesite w2 module=m0 position=30 kind=Assertion
layout L0 name="Point" fields=[{key="x" declared={type=undefined|null|number}}]
layout L1 name="inferred" fields=[{key="x" declared={type=anything predicted=number}}] supertypes=[L0]
layout L2 name="inferredFromInferred" fields=[{key="x" declared={type=anything predicted=number}}] supertypes=[L1]
layout L3 name="unrelated" fields=[{key="x" declared={type=anything predicted=string}}]
layout L4 name="Labeled" fields=[{key="label" declared={type=undefined|null|string}}]
layout L5 name="Sized" fields=[{key="length" declared={type=undefined|null|string}}]
function f0 name="throughWrittenType" parameters=[{type=undefined|null|L0 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="x"
    v2 = ClaimRead v1, v0 source=Field{key="x"} site=w1
    Return v2
}
# CHECK-LABEL: function f0 name="throughWrittenType"
# CHECK: [[read]]: anything {{*}}= PropGet v0 key="x"
# CHECK-NEXT: : undefined|null|number = Claim [[read]] castType=undefined|null|number site=w1
function f1 name="throughInferredType" parameters=[{type=undefined|null|L1 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="x"
    v2 = ClaimRead v1, v0 source=Field{key="x"} site=w1
    Return v2
}
# CHECK-LABEL: function f1 name="throughInferredType"
# CHECK-NOT: Claim
# CHECK: Return
function f2 name="throughUnionWithUnrelatedType" parameters=[{type=undefined|null|L0|L3 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="x"
    v2 = ClaimRead v1, v0 source=Field{key="x"} site=w1
    Return v2
}
# CHECK-LABEL: function f2 name="throughUnionWithUnrelatedType"
# CHECK-NOT: Claim
# CHECK: Return
function f3 name="afterCastToAnotherWrittenType" parameters=[{type=undefined|null|L0 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = ClaimDeclared v0 declared={type=undefined|null|L4 site=w2}
    v2 = PropGet v1 key="label"
    v3 = ClaimRead v2, v1 source=Field{key="label"} site=w1
    Return v3
}
# CHECK-LABEL: function f3 name="afterCastToAnotherWrittenType"
# CHECK: [[label]]: anything {{*}}= PropGet v1 key="label"
# CHECK-NEXT: : undefined|null|string = Claim [[label]] castType=undefined|null|string site=w1
function f4 name="throughTypeThatTakesStrings" parameters=[{type=undefined|null|string|L4 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|string|object):
    v1 = PropGet v0 key="label"
    v2 = ClaimRead v1, v0 source=Field{key="label"} site=w1
    Return v2
}
# CHECK-LABEL: function f4 name="throughTypeThatTakesStrings"
# CHECK: [[ofStringOrObject]]: anything {{*}}= PropGet v0 key="label"
# CHECK-NEXT: : undefined|null|string = Claim [[ofStringOrObject]] castType=undefined|null|string site=w1
function f5 name="nameThatStringsHave" parameters=[{type=undefined|null|string|L5 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|string|object):
    v1 = PropGet v0 key="length"
    v2 = ClaimRead v1, v0 source=Field{key="length"} site=w1
    Return v2
}
# CHECK-LABEL: function f5 name="nameThatStringsHave"
# CHECK-NOT: Claim
# CHECK: Return
