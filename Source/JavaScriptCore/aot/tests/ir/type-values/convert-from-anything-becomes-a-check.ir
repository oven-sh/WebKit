# Nothing is proven of a value that comes from `any`, from a call by value or from a wider type, so its conversion to a checked type is a test at that edge: a Check, whose result has the value's type met with the target type.
# At the end: a conversion to an expected type tests nothing. The value stays anything, and the type is what is expected of it from there on
# FORM: AsRead
# RUN: pass TypeValues VerifyProgram
# STATISTIC: RequestsResolvedToCheck = 4

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Variable
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=CallResult
typesite w3 module=m0 position=40 kind=Result
layout L0 name="Point" fields=[{key="x" declared={type=number}}]
layout L1 name="Point3" fields=[{key="x" declared={type=number}}, {key="z" declared={type=number}}] supertypes=[L0]
# CHECK: outcome: Changed
# CHECK-NEXT: outcome: Unchanged
function f0 name="intoPrimitives" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=undefined|null|number site=w0} illTypedCause=FromLooseType
    v2 = Integer integer=2
    v3 = Add v1, v2
    Return v3
# CHECK: v1: undefined|null|number = Check v0 castType=undefined|null|number site=w0
# CHECK: v3: number = Add v1, v2
}
function f1 name="intoFamily" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=undefined|null|L0 site=w1} illTypedCause=FromLooseType
    Return v1
# CHECK: v1: undefined|null|L0|L1 = Check v0 castType=undefined|null|L0|L1 site=w1
# CHECK-NEXT: Return v1
}
function f2 name="resultOfCallByValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Call v0
    v2 = Convert v1 declared={type=string site=w2} illTypedCause=UnprovenCallee
    Return v2
# CHECK: v1: anything = Call v0
# CHECK-NEXT: v2: string = Check v1 castType=string site=w2
# CHECK-NEXT: Return v2
}
function f3 name="fromOverlappingType" parameters=[{type=number|string}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=undefined|null|number site=w0} illTypedCause=Assertion
    Return v1
# CHECK: v1: number = Check v0 castType=undefined|null|number site=w0
# CHECK-NEXT: Return v1
}
function f4 name="tailCall" parameters=[{type=anything}] results=[{type=undefined|null|number site=w3}] {
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=undefined|null|number site=w3}}]
# CHECK: ReturnCall v1 casts=[{declared={type=undefined|null|number site=w3} resolution=Check}]
}
function f5 name="intoExpectedType" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=number flags=[IsExpected]}
    Return v1
# CHECK: [[converted]]: anything ~ number =
# CHECK-NOT: Convert
# CHECK-NOT: Check
# CHECK: Return [[converted]]
}
