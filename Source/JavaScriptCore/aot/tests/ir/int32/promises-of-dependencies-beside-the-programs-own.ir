# One function, two flows that are not proven: the one into an int32 that a dependency declares is a warning, the one into an int32 of the program's own is an error of the build
# FORM: AsRead
# RUN: pass TypeValues CheckInt32Promises
# DIAGNOSTIC: Int32OfDependencyNotProven 1
# DIAGNOSTIC: UnprovenInt32 1

module m0 path="main.ts" displayPath="main.ts"
module m1 path="node_modules/dependency/index.ts" displayPath="node_modules/dependency/index.ts"
entry module=m0
typesite w0 module=m1 position=20 kind=Variable
typesite w1 module=m0 position=30 kind=Variable
function f0 name="both" module=m0 parameters=[{type=number}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}
    v2 = Convert v0 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v2
}
