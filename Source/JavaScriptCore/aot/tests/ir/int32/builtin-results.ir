    Return v5
}
# CHECK-LABEL: function f11
# CHECK-NEXT: v5: unknown AnyNumber
function f12 name="lengthOfUnknownValue" parameters=[{type=anything}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=i32 site=w1 flags=[IsInt32Promise]} illTypedCause=FromLooseType
    Return v2
}
# CHECK-LABEL: function f12
# CHECK-NEXT: v2: unknown Untyped
function f13 name="withinLength" parameters=[{type=undefined|null|string}, {type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v2 = PropGet v0 key="length"
    v3 = Less v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = Increment v4
    v6 = Convert v5 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v6
  b2(v7):
    v8 = Convert v7 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v8
}
# CHECK-LABEL: function f13
# CHECK-NEXT: v6: integers [-2147483647, 2147483647]
