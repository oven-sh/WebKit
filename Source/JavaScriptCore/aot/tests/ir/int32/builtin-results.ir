# What a call or a read of a built-in gives is taken from the table of built-ins, with the ranges of the operands, before any call is resolved.
# The result of a method that only a declaration types is converted to a type that is no promise. TypeValues has made that request a Check by the time a flow is judged, so it stands here as a Check
# FORM: AsRead
# RUN: int32-bounds

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Result
typesite w2 module=m0 position=30 kind=Variable
typesite w3 module=m0 position=40 kind=CallResult
function f0 name="product" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}, {type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="Math" [isFreeName]
    v4 = Convert v3 declared={type=builtin(Math) flags=[IsExpected]}
    v5 = PropGet v4 key="imul"
    v6 = Convert v5 declared={type=builtin(MathImul) flags=[IsExpected]}
    v7 = Call v6, v4, v0, v1
    v8 = Convert v7 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v8
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v8: integers [-2147483648, 2147483647]
function f1 name="leadingZeros" parameters=[{type=number}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Math) flags=[IsExpected]}
    v4 = PropGet v3 key="clz32"
    v5 = Convert v4 declared={type=builtin(MathClz32) flags=[IsExpected]}
    v6 = Call v5, v3, v0
    v7 = Convert v6 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v7
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v7: integers [0, 32]
function f2 name="least" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Math) flags=[IsExpected]}
    v4 = PropGet v3 key="min"
    v5 = Convert v4 declared={type=builtin(MathMin) flags=[IsExpected]}
    v6 = Integer integer=7
    v7 = Call v5, v3, v0, v6
    v8 = Increment v7
    v9 = Convert v8 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v9
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v9: integers [-2147483647, 8]
function f3 name="greatest" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}, {type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="Math" [isFreeName]
    v4 = Convert v3 declared={type=builtin(Math) flags=[IsExpected]}
    v5 = PropGet v4 key="max"
    v6 = Convert v5 declared={type=builtin(MathMax) flags=[IsExpected]}
    v7 = Integer
    v8 = Call v6, v4, v0, v1, v7
    v9 = Convert v8 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v9
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v9: integers [0, 2147483647]
function f4 name="leastOfNumbers" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}, {type=number}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v2 = Builtin builtin=GlobalThis
