function f8 name="lengthOfString" parameters=[{type=undefined|null|string}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=i32 site=w1 flags=[IsInt32Promise]}
