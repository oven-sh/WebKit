# CHECK-LABEL: function f10
# CHECK-NEXT: v5: integers [-1, 2147483647]
function f11 name="codeUnit" parameters=[{type=undefined|null|string}, {type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v2 = PropGet v0 key="charCodeAt"
