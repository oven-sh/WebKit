    v4 = PropGet v3 key="abs"
    v5 = Convert v4 declared={type=builtin(MathAbs) flags=[IsExpected]}
    v6 = Call v5, v3, v0
    v7 = Convert v6 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v7
}
