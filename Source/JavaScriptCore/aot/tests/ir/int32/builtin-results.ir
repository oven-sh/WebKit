}
# CHECK-LABEL: function f4
# CHECK-NEXT: v8: unknown AnyNumber
function f5 name="distance" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Math) flags=[IsExpected]}
    v4 = PropGet v3 key="abs"
    v5 = Convert v4 declared={type=builtin(MathAbs) flags=[IsExpected]}
    v6 = Integer integer=255
    v7 = BitAnd v0, v6
    v8 = Integer integer=128
    v9 = Sub v7, v8
    v10 = Call v5, v3, v9
    v11 = Convert v10 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v11
}
# CHECK-LABEL: function f5
# CHECK-NEXT: v11: integers [0, 128]
function f6 name="absoluteValue" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Builtin builtin=GlobalThis
