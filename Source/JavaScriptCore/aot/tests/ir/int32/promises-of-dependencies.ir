# Who builds a program cannot mend a dependency. A flow into an int32 that a dependency declares, if it is not proven, is a warning: the build goes on and the flow is tested like any other conversion
# FORM: AsRead
# RUN: pass TypeValues CheckInt32Promises
# DIAGNOSTIC: Int32OfDependencyNotProven 2

module m0 path="main.ts" displayPath="main.ts"
module m1 path="node_modules/dependency/index.ts" displayPath="node_modules/dependency/index.ts"
entry module=m0
typesite w0 module=m1 position=10 kind=Result
typesite w1 module=m1 position=20 kind=Variable
function f0 name="number" module=m1 parameters=[{type=number}] results=[{type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}] {
  b0(v0: number):
    v1 = Convert v0 declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}
    Return v1
}
# CHECK-LABEL: function f0
# CHECK: Check v0 castType=i32
# CHECK-NOT: Convert
function f1 name="constant" module=m1 results=[{type=anything}] {
  b0():
    v0 = Double number=1.5
    v1 = Convert v0 declared={type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]}
    Return v1
}
function f2 name="proven" module=m1 parameters=[{type=number}] results=[{type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}] {
  b0(v0: number):
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = Convert v2 declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}
    Return v3
}
# CHECK-LABEL: function f2
# CHECK-NOT: Check
