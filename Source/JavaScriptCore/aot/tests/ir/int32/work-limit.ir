# A proof that visits more values than the limit allows gives up and says so. What the types of the values say holds without a visit
# FORM: AsRead
# OPTIONS: limit=MaxInt32ProofWork:2
# RUN: int32-bounds
# LOSS: MaxInt32ProofWork

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Result
function f0 name="half" parameters=[{type=undefined|null|i32 predicted=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=undefined|null|i32 predicted=i32 site=w1 flags=[IsInt32Promise]}] {
  b0(v0: anything):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Predict v2 predicted=builtin(Math)
    v4 = PropGet v3 key="floor"
    v5 = Predict v4 predicted=builtin(MathFloor)
    v6 = Integer integer=2
    v7 = Div v0, v6
    v8 = Call v5, v3, v7
    v9 = ClaimDeclared v8 declared={type=undefined|null|i32 predicted=i32 site=w1 flags=[IsInt32Promise]}
    Return v9
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v9: unknown WorkLimit
function f1 name="sum" parameters=[{type=undefined|null|i32 predicted=i32 site=w0 flags=[IsInt32Promise]}, {type=undefined|null|i32 predicted=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=undefined|null|i32 predicted=i32 site=w1 flags=[IsInt32Promise]}] {
  b0(v0: anything, v1: anything):
    v2 = Add v0, v1
    v3 = Add v2, v1
    v4 = ClaimDeclared v3 declared={type=undefined|null|i32 predicted=i32 site=w1 flags=[IsInt32Promise]}
    Return v4
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v4: integers [-6442450944, 6442450941]
