# CHECK-NEXT: v3: integers [0, 4294967295]
function f4 name="shiftedByUnknownCount" parameters=[{type=undefined|null|number predicted=number}, {type=undefined|null|i32 predicted=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=undefined|null|i32 predicted=i32 site=w1 flags=[IsInt32Promise]}] {
