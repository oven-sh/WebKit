# A type has no bounds for fractions. The proof follows a quotient of integers to where it is rounded or compared, and knows when a rounding can give -0
# FORM: AsRead
# RUN: int32-bounds

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Result
typesite w2 module=m0 position=30 kind=Variable
function f0 name="half" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
  b0(v0: i32):
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Math" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Math) flags=[IsExpected]}
    v4 = PropGet v3 key="floor"
    v5 = Convert v4 declared={type=builtin(MathFloor) flags=[IsExpected]}
    v6 = Integer integer=2
    v7 = Div v0, v6
    v8 = Call v5, v3, v7
    v9 = Convert v8 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v9
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v9: integers [-1073741824, 1073741824]
