function f5 name="eitherQuotient" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}, {type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
