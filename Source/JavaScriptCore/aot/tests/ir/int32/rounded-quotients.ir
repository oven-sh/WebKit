    v7 = Integer
    v8 = Greater v0, v7
    Branch v8 -> taken b1(| 0), notTaken b2(| 0)
  b1(v9):
    v10 = Integer integer=2
    v11 = Div v9, v10
    Jump -> next b3(v11)
  b2(v12):
    v13 = Integer integer=3
    v14 = Div v1, v13
