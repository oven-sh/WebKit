function f10 name="belowHalf" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=anything}] {
  b0(v0: i32):
    v1 = Integer
    v2 = Convert v1 declared={type=i32 site=w2 flags=[IsInt32Promise]}
    Jump -> next b1(v2)
  b1(v3: i32):
    v4 = Integer integer=2
    v5 = Div v0, v4
