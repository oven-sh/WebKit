# A position with a promise holds what its type says, like any other checked position. A request that the types prove leaves nothing behind.
# Where only an expected type says that the value is an int32, after a read by name or a call by value of a callee nobody knows, the build has its proof and the code relies on the types alone:
# the request becomes a Check, like any other conversion. A call by value of one known function has the result that the function declares, so nothing is left to ask. A promise is about the numbers of a type, so what is no number enters a union without a question
# FORM: AsRead
# RUN: pass TypeValues CheckInt32Promises

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Result
typesite w2 module=m0 position=30 kind=Variable
typesite w3 module=m0 position=40 kind=CallResult
layout L0 name="Cursor" fields=[{key="line" declared={type=i32 flags=[IsInt32Promise]} flags=[IsRequired]}, {key="column" declared={type=undefined|i32 flags=[IsInt32Promise]}}]
variable g0 name="count" module=m0 declared={type=undefined|i32 site=w2 flags=[IsInt32Promise]} initialization=Undefined
# CHECK: layout L0 name="Cursor" fields=[{key="line" declared={type=i32 flags=[IsInt32Promise]} flags=[IsRequired]}, {key="column" declared={type=undefined|i32 flags=[IsInt32Promise]}}]
# CHECK: variable g0 name="count" module=m0 declared={type=undefined|i32 site=w2 flags=[IsInt32Promise]}
function f0 name="parameter" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Convert v0 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v1
}
# CHECK-LABEL: function f0 name="parameter"{{*}}parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}]
# CHECK-NEXT: b0(v0: i32):
# CHECK-NEXT: Return v0
function f1 name="maskedNumber" parameters=[{type=number}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Integer integer=255
    v2 = BitAnd v0, v1
    v3 = Convert v2 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v3
# CHECK: v2: int[0, 255] = BitAnd v0, v1
# CHECK-NEXT: Return v2
}
function f2 name="field" parameters=[{type=undefined|null|L0}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = PropGet v0 key="line"
    v2 = Convert v1 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v2
# CHECK: v1: anything ~ i32 = PropGet v0 key="line"
# CHECK-NEXT: v2: i32 = Check v1 expectedType=i32 site=w1
# CHECK-NEXT: Return v2
}
function f3 name="optionalField" parameters=[{type=undefined|null|L0}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = PropGet v0 key="column"
    v2 = Convert v1 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v2
# CHECK: v1: anything ~ undefined|i32 = PropGet v0 key="column"
# CHECK-NEXT: v2: i32 = Check v1 expectedType=i32 site=w1
# CHECK-NEXT: Return v2
}
function f4 name="variable" results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v0 = GetModuleVariable variable=g0
    v1 = Convert v0 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v1
# CHECK: v0: undefined|i32 = GetModuleVariable variable=g0
# CHECK-NEXT: v1: i32 = Check v0 expectedType=i32 site=w1
# CHECK-NEXT: Return v1
}
function f5 name="callResult" results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v0 = NewClosure function=f4
    v1 = Call v0
    v2 = Convert v1 declared={type=i32 site=w3 flags=[IsInt32Promise]}
    v3 = Convert v2 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v3
# CHECK: v1: i32 = Call v0
# CHECK-NEXT: Return v1
}
function f6 name="tailCall" results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v0 = NewClosure function=f4
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=i32 site=w3 flags=[IsInt32Promise]}}, {declared={type=i32 site=w1 flags=[IsInt32Promise]}}]
# CHECK: ReturnCall v1 casts=[{declared={type=i32 site=w3 flags=[IsInt32Promise]} resolution=Nothing}, {declared={type=i32 site=w1 flags=[IsInt32Promise]} resolution=Nothing}]
}
function f7 name="nothing" results=[{type=undefined|i32 site=w1 flags=[IsInt32Promise]}] {
    v0 = Undefined
    v1 = Convert v0 declared={type=undefined|i32 site=w1 flags=[IsInt32Promise]}
    Return v1
# CHECK: v0: undefined = Undefined
# CHECK-NEXT: Return v0
# A layout that nothing allocates has no objects to read from, so something allocates the layout of the two reads
}
function f8 name="make" parameters=[{type=i32 site=w0 flags=[IsInt32Promise]}] results=[{type=undefined|null|L0}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    Return v1
# CHECK: v1: L0 = NewObject -, v0 layout=L0 fields=[0]
}
function f9 name="resultOfUnknownCallee" parameters=[{type=anything}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Call v0
    v2 = Convert v1 declared={type=i32 site=w3 flags=[IsInt32Promise]}
    v3 = Convert v2 declared={type=i32 site=w1 flags=[IsInt32Promise]}
    Return v3
# CHECK: v1: anything = Call v0
# CHECK-NEXT: v2: i32 = Check v1 expectedType=i32 site=w3
# CHECK-NEXT: Return v2
}
function f10 name="tailCallOfUnknownCallee" parameters=[{type=anything}] results=[{type=i32 site=w1 flags=[IsInt32Promise]}] {
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=i32 site=w3 flags=[IsInt32Promise]}}, {declared={type=i32 site=w1 flags=[IsInt32Promise]}}]
# CHECK: ReturnCall v1 casts=[{declared={type=i32 site=w3 flags=[IsInt32Promise]} resolution=Check}, {declared={type=i32 site=w1 flags=[IsInt32Promise]} resolution=Nothing}]
}
