# `e as int32` in a dependency is its author's word for e. Nothing is reported, neither there nor where the value goes next, and the position that it enters tests it like any other conversion. In the program's own files the same text needs the proof: unproven-flows.ir.
# FORM: AsRead
# RUN: pass TypeValues CheckInt32Promises

module m0 path="main.ts" displayPath="main.ts"
module m1 path="node_modules/dependency/index.ts" displayPath="node_modules/dependency/index.ts"
entry module=m0
typesite w0 module=m1 position=10 kind=Assertion
typesite w1 module=m1 position=20 kind=Result
function f0 name="asserted" module=m1 parameters=[{type=number}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}
    Return v1
}
# CHECK-LABEL: function f0
# CHECK-NOT: Convert
# CHECK: Return v0
function f1 name="assertedAndReturned" module=m1 parameters=[{type=number}] results=[{type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]}] {
    v1 = Convert v0 declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}
    v2 = Convert v1 declared={type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]}
    Return v2
}
# CHECK-LABEL: function f1
# CHECK: Check v0 castType=i32 site=w1
# CHECK-NOT: Convert
function f2 name="number" module=m1 results=[{type=number}] {
    v0 = Double number=1.5
    Return v0
}
function f3 name="assertedTailCall" module=m1 results=[{type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]}] {
    v0 = NewClosure function=f2
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=i32 site=w0 flags=[IsInt32Promise, IsDeclaredByDependency]}}, {declared={type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]}}]
}
# CHECK-LABEL: function f3
# CHECK: resolution=Nothing}, {declared={type=i32 site=w1 flags=[IsInt32Promise, IsDeclaredByDependency]} resolution=Check}]
