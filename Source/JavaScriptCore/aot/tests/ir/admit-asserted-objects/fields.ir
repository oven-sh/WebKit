# An asserted object stored under a name makes the field of the layouts expected at the receiver admit objects: written or only predicted, at the allocation or later. A typed read of that field lets the object through, and no other field changes
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 4

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Field
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=PropertyRead
typesite w3 module=m0 position=40 kind=Parameter
typesite w4 module=m0 position=50 kind=Result
layout L0 name="Written" fields=[{key="setting" declared={type=undefined|null|number predicted=number}}, {key="other" declared={type=undefined|null|number predicted=number}}]
layout L1 name="Predicted" fields=[{key="setting" declared={type=undefined|null|number predicted=number}}]
layout L2 name="Allocated" fields=[{key="setting" declared={type=undefined|null|number predicted=number}}]
layout L3 name="Unreached" fields=[{key="setting" declared={type=undefined|null|number predicted=number}}]
# CHECK: layout L0 name="Written" fields=[{key="setting" declared={type=undefined|null|number|object predicted=number flags=[AdmitsObjects]}}, {key="other" declared={type=undefined|null|number predicted=number}}]
# CHECK: layout L1 name="Predicted" fields=[{key="setting" declared={type=undefined|null|number|object predicted=number flags=[AdmitsObjects]}}]
# CHECK: layout L2 name="Allocated" fields=[{key="setting" declared={type=undefined|null|number|object predicted=number flags=[AdmitsObjects]}}]
# CHECK: layout L3 name="Unreached" fields=[{key="setting" declared={type=undefined|null|number predicted=number}}]
function f0 name="throughWrittenReceiver" parameters=[{type=undefined|null|L0 site=w3}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|object, v1: anything):
    v2 = ClaimDeclared v1 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w1}
    v3 = ClaimDeclared v2 declared={type=undefined|null|number predicted=number site=w0}
    PropSet v0, v3 key="setting"
    Return
}
function f1 name="readsWrittenReceiver" parameters=[{type=undefined|null|L0 site=w3}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="setting"
    v2 = ClaimRead v1, v0 source=Field{key="setting"} site=w2
    v3 = PropGet v0 key="other"
    v4 = ClaimRead v3, v0 source=Field{key="other"} site=w2
    v5 = Add v4, v4
    Return v2
}
# CHECK-LABEL: function f1 name="readsWrittenReceiver"
# CHECK: : undefined|null|number|object {{*}}= Claim v1 castType=undefined|null|number|object site=w2
# CHECK: : undefined|null|number {{*}}= Claim {{*}}castType=undefined|null|number site=w2
function f2 name="throughThis" kind=Method flags=[HasThis] thisType={type=anything predicted=L1} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ClaimDeclared v1 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w1}
    v3 = ClaimDeclared v2 declared={type=undefined|null|number predicted=number site=w0}
    PropSet v0, v3 key="setting"
    Return
}
function f3 name="readsThis" kind=Method flags=[HasThis] thisType={type=anything predicted=L1} results=[{type=undefined|null|number predicted=number site=w4}] {
  b0(v0: anything):
    v1 = PropGet v0 key="setting"
    v2 = ClaimRead v1, v0 source=Field{key="setting"} site=w2
    v3 = ClaimDeclared v2 declared={type=undefined|null|number predicted=number site=w4}
    Return v3
}
# CHECK-LABEL: function f3 name="readsThis" {{*}}results=[{type=undefined|null|number|object predicted=number site=w4 flags=[AdmitsObjects]}]
# CHECK: : undefined|null|number|object {{*}}= Claim {{*}}castType=undefined|null|number|object site=w4
function f4 name="atAllocation" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w1}
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number}
    v3 = NewObject -, v2 layout=L2 fields=[0]
    v4 = FinishObject v3
    Return v4
}
function f5 name="untypedStore" parameters=[{type=undefined|null|L3 site=w3}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|object, v1: anything):
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number site=w0}
    PropSet v0, v2 key="setting"
    Return
}
