# An asserted object that is stored into a written variable, a captured variable or an environment field makes that one position admit objects, and whoever reads the position gets the object part
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 3

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Variable
typesite w1 module=m0 position=20 kind=Variable
typesite w2 module=m0 position=30 kind=Assertion
typesite w3 module=m0 position=40 kind=Variable
typesite w4 module=m0 position=50 kind=Variable
layout L0 kind=Environment fields=[{declared={type=undefined|null|number site=w3}}, {declared={type=undefined|null|number site=w4}}]
variable g0 name="kept" module=m0 declared={type=undefined|null|number predicted=number site=w0} initialization=Undefined
variable g1 name="untouched" module=m0 declared={type=undefined|null|number predicted=number site=w1} initialization=Undefined
# CHECK: layout L0 kind=Environment fields=[{declared={type=undefined|null|number|object site=w3 flags=[AdmitsObjects]}}, {declared={type=undefined|null|number site=w4}}]
# CHECK: variable g0 name="kept" module=m0 declared={type=undefined|null|number|object predicted=number site=w0 flags=[AdmitsObjects]}
# CHECK: variable g1 name="untouched" module=m0 declared={type=undefined|null|number predicted=number site=w1}
function f0 name="intoVariable" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w2}
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number site=w0}
    PutModuleVariable v2 variable=g0
    v4 = ClaimDeclared v0 declared={type=undefined|null|number predicted=number site=w1}
    PutModuleVariable v4 variable=g1
    Return
}
# CHECK-LABEL: function f0 name="intoVariable"
# CHECK: [[asserted]]: undefined|null|number|object = Claim v0 castType=undefined|null|number|object site=w2
# CHECK: PutModuleVariable {{*}}variable=g0
# CHECK: [[tested]]: undefined|null|number = Claim v0 castType=undefined|null|number site=w1
# CHECK: PutModuleVariable {{*}}variable=g1
function f1 name="fromVariable" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    Return v0
}
# CHECK-LABEL: function f1 name="fromVariable"
# CHECK: v0: undefined|null|number|object ~ number = GetModuleVariable variable=g0
function f2 name="intoCapture" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w2}
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number site=w0}
    v3 = NewClosure v2 function=f3
    Return v3
}
function f3 name="capturing" kind=Arrow captures=[{type=undefined|null|number predicted=number site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|number):
    Return v0
}
# CHECK-LABEL: function f3 name="capturing" {{*}}captures=[{type=undefined|null|number|object predicted=number site=w0 flags=[AdmitsObjects]}]
# CHECK: b0(v0: undefined|null|number|object ~ number):
function f4 name="intoEnvironment" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    v2 = NewObject -, v1, v1 layout=L0 fields=[0, 1]
    v3 = ClaimDeclared v0 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w2}
    v4 = ClaimDeclared v3 declared={type=undefined|null|number site=w3}
    PutEnvironmentField v2, v4 layout=L0
    v6 = GetEnvironmentField v2 layout=L0
    v7 = GetEnvironmentField v2 layout=L0 field=1
    v8 = Add v7, v7
    Return v6
}
# CHECK-LABEL: function f4 name="intoEnvironment"
# CHECK: : undefined|null|number|object = GetEnvironmentField v2 layout=L0
# CHECK: : undefined|null|number = GetEnvironmentField v2 layout=L0 field=1
