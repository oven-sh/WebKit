# The field that an asserted value of unknown origin reaches has a slot for any value. The field beside it and the same field of another layout, with the same written type, keep the raw number
# FORM: AsRead
# OPTIONS: only-passes=AnalyzeFlow references=narrow
# RUN: plan-slots layouts
# STATISTIC: PositionsAdmittingObjects = 1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Assertion
typesite w1 module=m0 position=20 kind=Field
layout L0 name="Reached" fields=[{key="x" declared={type=number site=w1} flags=[IsRequired]}, {key="y" declared={type=number site=w1} flags=[IsRequired]}]
layout L1 name="Unreached" fields=[{key="x" declared={type=number site=w1} flags=[IsRequired]}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="input" [isFreeName]
    v5 = ClaimDeclared v4 declared={type=number|object written=number predicted=number site=w0}
    v6 = ClaimDeclared v5 declared={type=number site=w1}
    v7 = NewObject -, v6, v2 layout=L0 fields=[0, 1]
    v8 = FinishObject v7
    v9 = NewObject -, v2 layout=L1 fields=[0]
    v10 = FinishObject v9
    v11 = PropGet v3 key="publish" [isFreeName]
    v12 = Call v11, -, v8, v10
    Return
}

# CHECK: L0 CompiledObject
# CHECK-NEXT: .0 "x" JSValue
# CHECK-NEXT: .1 "y" Double
# CHECK: L1 CompiledObject
# CHECK-NEXT: .0 "x" Double
