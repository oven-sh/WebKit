# A function that returns an asserted object has a result that admits objects. The caller's claim of that result lets them through, in an ordinary call and in a tail call, and what the caller does with the value widens the next position, in another function
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 4

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=CallResult
typesite w3 module=m0 position=40 kind=Parameter
typesite w4 module=m0 position=50 kind=Result
typesite w5 module=m0 position=60 kind=Parameter
typesite w6 module=m0 position=70 kind=Result
variable g0 name="gives" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f0 flags=[IsImmutable]
variable g1 name="takes" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="last" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f3 flags=[IsImmutable]
variable g3 name="plain" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f5 flags=[IsImmutable]
function f0 name="gives" parameters=[{type=anything}] results=[{type=undefined|null|string predicted=string site=w0}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|string|object written=undefined|null|string predicted=string site=w1}
    v2 = ClaimDeclared v1 declared={type=undefined|null|string predicted=string site=w0}
    Return v2
}
# CHECK-LABEL: function f0 name="gives" {{*}}results=[{type=undefined|null|string|object predicted=string site=w0 flags=[AdmitsObjects]}]
function f1 name="passesOn" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="gives"
    v3 = ClaimDeclared v2 declared={type=undefined|null|string predicted=string site=w2}
    v4 = GetModuleVariable variable=g1
    v5 = Call v4, -, v3 calleeName="takes"
    Return v5
}
# CHECK-LABEL: function f1 name="passesOn"
# CHECK: : undefined|null|string|object = Claim v2 castType=undefined|null|string|object site=w2
function f2 name="takes" parameters=[{type=undefined|null|string predicted=string site=w3}] results=[{type=anything}] {
  b0(v0: undefined|null|string):
    v1 = GetModuleVariable variable=g2
    v2 = Call v1, -, v0 calleeName="last"
    Return v2
}
# CHECK-LABEL: function f2 name="takes" {{*}}parameters=[{type=undefined|null|string|object predicted=string site=w3 flags=[AdmitsObjects]}]
function f3 name="last" parameters=[{type=undefined|null|string predicted=string site=w5}] results=[{type=anything}] {
  b0(v0: undefined|null|string):
    Return v0
}
# CHECK-LABEL: function f3 name="last" {{*}}parameters=[{type=undefined|null|string|object predicted=string site=w5 flags=[AdmitsObjects]}]
function f4 name="tailCalls" parameters=[{type=anything}] results=[{type=undefined|null|string predicted=string site=w4}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="gives"
    ReturnCall v2 casts=[{declared={type=undefined|null|string predicted=string site=w2}}, {declared={type=undefined|null|string predicted=string site=w4}}]
}
# CHECK-LABEL: function f4 name="tailCalls" {{*}}results=[{type=undefined|null|string|object predicted=string site=w4 flags=[AdmitsObjects]}]
# CHECK: ReturnCall v2 casts=[{declared={type=undefined|null|string|object predicted=string site=w2 flags=[AdmitsObjects]} resolution=Claim}, {declared={type=undefined|null|string|object predicted=string site=w4 flags=[AdmitsObjects]}
function f5 name="plain" parameters=[{type=anything}] results=[{type=undefined|null|string predicted=string site=w6}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|string predicted=string site=w6}
    Return v1
}
# CHECK-LABEL: function f5 name="plain" {{*}}results=[{type=undefined|null|string predicted=string site=w6}]
# CHECK: : undefined|null|string = Claim v0 castType=undefined|null|string site=w6
function f6 name="callsPlain" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g3
    v2 = Call v1, -, v0 calleeName="plain"
    v3 = ClaimDeclared v2 declared={type=undefined|null|string predicted=string site=w2}
    Return v3
}
# CHECK-LABEL: function f6 name="callsPlain"
# CHECK: : undefined|null|string = Claim v2 castType=undefined|null|string site=w2
