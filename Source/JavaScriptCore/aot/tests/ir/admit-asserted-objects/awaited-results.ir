# What an async function returns comes out where its promise is awaited: the position behind the await admits the asserted object
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 1

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=CallResult
typesite w3 module=m0 position=40 kind=Variable
typesite w4 module=m0 position=50 kind=PromiseValue
variable g0 name="load" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f0 flags=[IsImmutable]
variable g1 name="loaded" module=m0 declared={type=undefined|null|string predicted=string site=w3} initialization=Undefined
# CHECK: variable g1 name="loaded" module=m0 declared={type=undefined|null|string|object predicted=string site=w3 flags=[AdmitsObjects]}
function f0 name="load" flags=[IsAsync] parameters=[{type=anything}] results=[{type=undefined|null|object predicted=Promise<string> site=w0}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|string|object written=undefined|null|string predicted=string site=w1}
    Return v1
}
# CHECK-LABEL: function f0 name="load" {{*}}results=[{type=undefined|null|object predicted=Promise<string> site=w0 flags=[AdmitsObjects]}]
function f1 name="awaits" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="load"
    v3 = ClaimDeclared v2 declared={type=undefined|null|object predicted=Promise<string> site=w2}
    v4 = Await v3
    v5 = ClaimRead v4, v3 source=Contents{slot=Value} site=w4
    v6 = ClaimDeclared v5 declared={type=undefined|null|string predicted=string site=w3}
    PutModuleVariable v6 variable=g1
    Return
}
# CHECK-LABEL: function f1 name="awaits"
# CHECK: : undefined|null|string|object {{*}}= Claim {{*}}castType=undefined|null|string|object site=w3
