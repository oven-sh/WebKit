# OPTIONS: report=Declines
# RUN: pass AdmitAssertedObjects
# STATISTIC: PositionsAdmittingObjects = 8
# STATISTIC: AssertedObjectsPassedToUnknownCallees = 1
# CHECK: decline AssertedObjectPassedToUnknownCallee f13 v2

