    DefineMethod v3, v4 layout=L0 key="put"
    v6 = NewClosure function=f4
    DefineMethod v3, v6 layout=L0 side=Static index=1 key="create"
    v8 = FinishClass v3 layout=L0
    PutModuleVariable v8 variable=g1
    v10 = NewClosure function=f5
    v11 = ResolveHeritage v8
    v12 = NewClass v10, v8, v11 layout=L1
    v13 = NewClosure function=f6
    DefineMethod v12, v13 layout=L1 key="put"
    v15 = FinishClass v12 layout=L1
    PutModuleVariable v15 variable=g2
    Return
}
