# A store under the name of an accessor passes the asserted object to the setter, and a read under it gives what the getter returns
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 4

module m0 path="main.ts" displayPath="main.ts" body=f0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=Result
typesite w3 module=m0 position=40 kind=Field
typesite w4 module=m0 position=50 kind=PropertyRead
typesite w5 module=m0 position=60 kind=Variable
layout L0 kind=Instance name="Cell" constructor=f1 fields=[{key="stored" declared={type=undefined|null|number predicted=number site=w3}}]
variable g0 name="seen" module=m0 declared={type=undefined|null|number predicted=number site=w5} initialization=Undefined
# CHECK: layout L0 kind=Instance name="Cell" {{*}}declared={type=undefined|null|number|object predicted=number site=w3 flags=[AdmitsObjects]}
# CHECK: variable g0 name="seen" module=m0 declared={type=undefined|null|number|object predicted=number site=w5 flags=[AdmitsObjects]}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 methodKind=Getter key="value"
    v4 = NewClosure function=f3
    DefineMethod v1, v4 layout=L0 methodKind=Setter index=1 key="value"
    v6 = FinishClass v1 layout=L0
    Return
}
function f1 name="Cell" kind=BaseConstructor flags=[HasNewTarget] results=[{type=object flags=[IsFromCompiler]}] {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="value" kind=Getter flags=[HasThis] thisType={type=anything predicted=L0} results=[{type=undefined|null|number predicted=number site=w2}] {
  b0(v0: anything):
    v1 = PropGet v0 key="stored"
    v2 = ClaimRead v1, v0 source=Field{key="stored"} site=w4
    v3 = ClaimDeclared v2 declared={type=undefined|null|number predicted=number site=w2}
    Return v3
}
# CHECK-LABEL: function f2 name="value" {{*}}results=[{type=undefined|null|number|object predicted=number site=w2 flags=[AdmitsObjects]}]
function f3 name="value" kind=Setter flags=[HasThis] thisType={type=anything predicted=L0} parameters=[{type=undefined|null|number predicted=number site=w0}] results=[{type=anything}] {
  b0(v0: anything, v1: undefined|null|number):
    v2 = ClaimDeclared v1 declared={type=undefined|null|number predicted=number site=w3}
    PropSet v0, v2 key="stored"
    Return
}
# CHECK-LABEL: function f3 name="value" {{*}}parameters=[{type=undefined|null|number|object predicted=number site=w0 flags=[AdmitsObjects]}]
function f4 name="uses" parameters=[{type=undefined|null|L0}, {type=anything}] results=[{type=anything}] {
  b0(v0: undefined|null|object, v1: anything):
    v2 = ClaimDeclared v1 declared={type=undefined|null|number|object written=undefined|null|number predicted=number site=w1}
    PropSet v0, v2 key="value"
    v4 = PropGet v0 key="value"
    v5 = ClaimDeclared v4 declared={type=undefined|null|number predicted=number site=w5}
    PutModuleVariable v5 variable=g0
    Return
}
# CHECK-LABEL: function f4 name="uses"
# CHECK: : undefined|null|number|object {{*}}= Claim v4 castType=undefined|null|number|object site=w5
