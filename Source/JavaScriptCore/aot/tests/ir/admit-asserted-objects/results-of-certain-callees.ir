function f3 name="callsCertainCallee" parameters=[{type=undefined|null|Array site=w3}] results=[{type=anything}] {
  b0(v0: undefined|null|Array):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="filter"
    v3 = ClaimDeclared v2 declared={type=undefined|null|object written=undefined|null|Array predicted=Array site=w1}
    v4 = ClaimDeclared v3 declared={type=undefined|null|object written=undefined|null|Array predicted=Array site=w1}
    v5 = ClaimDeclared v4 declared={type=undefined|null|Array predicted=Array site=w2}
