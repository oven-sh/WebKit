# CHECK: variable g3 name="fromReplaceableCallee" {{*}}declared={type=undefined|null|object predicted=Array site=w2 flags=[AdmitsObjects]}
# CHECK: variable g4 name="fromBuiltin" {{*}}declared={type=undefined|null|Array predicted=Array site=w2}
# CHECK: variable g5 name="fromPredictedReceiver" {{*}}declared={type=undefined|null|object predicted=Array site=w2 flags=[AdmitsObjects]}
# CHECK: variable g7 name="fromCalleeThatPassesOn" {{*}}declared={type=undefined|null|object predicted=Array site=w2 flags=[AdmitsObjects]}
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    PutModuleVariable v0 variable=g1
    Return
}
function f1 name="filter" parameters=[{type=undefined|null|Array site=w3}] results=[{type=undefined|null|Array predicted=Array site=w0}] {
  b0(v0: undefined|null|Array):
    Return v0
}
function f2 name="passesOn" parameters=[{type=anything}] results=[{type=undefined|null|Array predicted=Array site=w0}] {
  b0(v0: anything):
    v1 = ClaimDeclared v0 declared={type=undefined|null|object written=undefined|null|Array predicted=Array site=w1}
    v2 = ClaimDeclared v1 declared={type=undefined|null|Array predicted=Array site=w0}
    Return v2
}
