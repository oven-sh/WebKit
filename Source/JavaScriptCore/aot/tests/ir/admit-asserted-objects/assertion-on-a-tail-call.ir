# `return call() as T`: the assertion is one of the casts of the tail call. The casts behind it and the result of the function admit objects, the cast in front of it tests as ever. The object is the function's own, so the place behind every call of the function admits it
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 2
# STATISTIC: RequestsAdmittingObjects = 2

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=CallResult
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=Result
typesite w3 module=m0 position=40 kind=Variable
variable g0 name="asserts" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f0 flags=[IsImmutable]
variable g1 name="behindTheCall" module=m0 declared={type=undefined|null|string predicted=string site=w3} initialization=Undefined
# CHECK: variable g1 name="behindTheCall" {{*}}declared={type=undefined|null|string|object predicted=string site=w3 flags=[AdmitsObjects]}
function f0 name="asserts" parameters=[{type=anything}] results=[{type=undefined|null|string predicted=string site=w2}] {
  b0(v0: anything):
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=undefined|null|number|string|object site=w0}}, {declared={type=undefined|null|string|object written=undefined|null|string predicted=string site=w1}}, {declared={type=undefined|null|string predicted=string site=w2}}]
}
# CHECK-LABEL: function f0 name="asserts" {{*}}results=[{type=undefined|null|string|object predicted=string site=w2 flags=[AdmitsObjects]}]
# CHECK: ReturnCall v1 casts=[{declared={type=undefined|null|number|string|object site=w0} resolution=Claim}, {declared={type=undefined|null|string|object written=undefined|null|string predicted=string site=w1} resolution=Claim}, {declared={type=undefined|null|string|object predicted=string site=w2 flags=[AdmitsObjects]}
function f1 name="calls" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="asserts"
    v3 = ClaimDeclared v2 declared={type=undefined|null|string predicted=string site=w3}
    PutModuleVariable v3 variable=g1
    Return
}
