# What a generator yields comes out where a loop reads it: the position behind the read admits the asserted object
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingObjects = 1

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Result
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=CallResult
typesite w3 module=m0 position=40 kind=Variable
typesite w4 module=m0 position=50 kind=Element
variable g0 name="items" module=m0 declared={type=function flags=[IsFromCompiler]} initialization=Function function=f0 flags=[IsImmutable]
variable g1 name="seen" module=m0 declared={type=undefined|null|string predicted=string site=w3} initialization=Undefined
# CHECK: variable g1 name="seen" module=m0 declared={type=undefined|null|string|object predicted=string site=w3 flags=[AdmitsObjects]}
function f0 name="items" flags=[IsGenerator, TakesCallee] parameters=[{type=anything}] results=[{type=undefined|null|object predicted=Generator<string> site=w0}] {
  b0(v0: function, v1: anything):
    InitialYield
    v3 = ClaimDeclared v1 declared={type=undefined|null|string|object written=undefined|null|string predicted=string site=w1}
    v4 = Yield v3
    Return
}
# CHECK-LABEL: function f0 name="items" {{*}}results=[{type=undefined|null|object predicted=Generator<string> site=w0 flags=[AdmitsObjects]}]
function f1 name="loops" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="items"
    v3 = ClaimDeclared v2 declared={type=undefined|null|object predicted=Generator<string> site=w2}
    v4 = IteratorOpen v3
    Jump -> next b1()
  b1():
    LoopHint
    v6 = IteratorResume v4
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    Return
  b3():
    v9 = ClaimRead v8, v3 source=Contents{} site=w4
    v10 = ClaimDeclared v9 declared={type=undefined|null|string predicted=string site=w3}
    PutModuleVariable v10 variable=g1
    Jump -> next b1()
}
# CHECK-LABEL: function f1 name="loops"
# CHECK: : undefined|null|string|object {{*}}= Claim {{*}}castType=undefined|null|string|object site=w3
