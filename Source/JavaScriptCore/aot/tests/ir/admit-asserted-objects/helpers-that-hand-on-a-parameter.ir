function f5 name="passesOwnArray" parameters=[{type=undefined|null|Array site=w3}] results=[{type=anything}] {
  b0(v0: undefined|null|Array):
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="same"
