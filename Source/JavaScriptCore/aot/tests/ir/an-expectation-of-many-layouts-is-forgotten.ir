# function read(props) { return props.value }  in a file that is not checked, or `props: any` in one that is: the checker says what the uses say, `{ value }`, and that is every layout of the program with a `value`.
# Such a list is no guess: the object that comes is as often none of them, the test fails, and what stands behind the test goes by name with it.
# A list of more than sixteen is forgotten as the program is read: at a parameter, at a value, at a field. A list of sixteen stays, and so does a long one that the checker has checked.
# FORM: AsRead
# RUN: valueflow-apply
# CHECK: layout L17 name="Holder" fields=[{key="few" declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15 flags=[IsExpected]}{{*}}{key="many" declared={type=anything}

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="T0" fields=[{key="k0" declared={type=number} flags=[IsRequired]}]
layout L1 name="T1" fields=[{key="k1" declared={type=number} flags=[IsRequired]}]
layout L2 name="T2" fields=[{key="k2" declared={type=number} flags=[IsRequired]}]
layout L3 name="T3" fields=[{key="k3" declared={type=number} flags=[IsRequired]}]
layout L4 name="T4" fields=[{key="k4" declared={type=number} flags=[IsRequired]}]
layout L5 name="T5" fields=[{key="k5" declared={type=number} flags=[IsRequired]}]
layout L6 name="T6" fields=[{key="k6" declared={type=number} flags=[IsRequired]}]
layout L7 name="T7" fields=[{key="k7" declared={type=number} flags=[IsRequired]}]
layout L8 name="T8" fields=[{key="k8" declared={type=number} flags=[IsRequired]}]
layout L9 name="T9" fields=[{key="k9" declared={type=number} flags=[IsRequired]}]
layout L10 name="T10" fields=[{key="k10" declared={type=number} flags=[IsRequired]}]
layout L11 name="T11" fields=[{key="k11" declared={type=number} flags=[IsRequired]}]
layout L12 name="T12" fields=[{key="k12" declared={type=number} flags=[IsRequired]}]
layout L13 name="T13" fields=[{key="k13" declared={type=number} flags=[IsRequired]}]
layout L14 name="T14" fields=[{key="k14" declared={type=number} flags=[IsRequired]}]
layout L15 name="T15" fields=[{key="k15" declared={type=number} flags=[IsRequired]}]
layout L16 name="T16" fields=[{key="k16" declared={type=number} flags=[IsRequired]}]
layout L17 name="Holder" fields=[{key="few" declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15 flags=[IsExpected]} flags=[IsRequired]}, {key="many" declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16 flags=[IsExpected]} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="outside" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v2, -, v1
    v4 = NewClosure function=f2
    v5 = Call v4, -, v1
    v6 = NewClosure function=f3
    v7 = Call v6, -, v1
    v8 = NewObject -, v1, v1 layout=L17 fields=[0, 1]
    PropSet v0, v8 key="holder" mode=Strict
    Return
}
function f1 name="few" parameters=[{type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15):
    v1 = Convert v0 declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15 flags=[IsExpected]}
    Return v1
}
# CHECK-LABEL: function f1 name="few"
# CHECK: parameters=[{type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15 flags=[IsExpected]}]
# CHECK: b0(v0: anything ~ L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15):
function f2 name="many" parameters=[{type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16):
    v1 = Convert v0 declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16 flags=[IsExpected]}
    Return v1
}
# CHECK-LABEL: function f2 name="many"
# CHECK: parameters=[{type=anything}]
# CHECK: b0(v0: anything):
# CHECK-NOT: L15|L16
function f3 name="manyChecked" flags=[IsChecked] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Convert v0 declared={type=L0|L1|L2|L3|L4|L5|L6|L7|L8|L9|L10|L11|L12|L13|L14|L15|L16}
    Return v1
}
# CHECK-LABEL: function f3 name="manyChecked"
# CHECK: L15|L16
