# interface Message { id }   interface Reply extends Message { status }   interface Draft extends Message { text }
# class BaseMessage implements Message { id }   class ReplyMessage extends BaseMessage implements Reply { status }   class QueryMessage extends BaseMessage { path }
# (message as Reply).status   (message as Draft).text = ""
# Each assertion puts Message below the asserted type. ReplyMessage declares that it is a Reply and has `status`, so a Reply is an instance that has `status` too: not a BaseMessage, not a QueryMessage.
# No class declares that it is a Draft, so every Message may be one: the program may store `text` into it later.
# FORM: AsRead
# RUN: members

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
layout L0 name="Message" fields=[{key="id" declared={type=number} flags=[IsRequired]}] supertypes=[L1, L2]
layout L1 name="Reply" fields=[{key="id" declared={type=number} flags=[IsRequired]}, {key="status" declared={type=number} flags=[IsRequired]}] supertypes=[L0]
layout L2 name="Draft" fields=[{key="id" declared={type=number} flags=[IsRequired]}, {key="text" declared={type=string} flags=[IsRequired]}] supertypes=[L0]
layout L3 kind=Instance name="BaseMessage" constructor=f1 fields=[{key="id" declared={type=number} flags=[IsRequired]}] supertypes=[L0]
layout L4 kind=Instance name="ReplyMessage" base=L3 constructor=f2 fields=[{key="status" declared={type=number} flags=[IsRequired]}] supertypes=[L1] flags=[HasHeritage]
layout L5 kind=Instance name="QueryMessage" base=L3 constructor=f3 fields=[{key="path" declared={type=string} flags=[IsRequired]}] flags=[HasHeritage]
# CHECK: L0: members [L0, L1, L2, L3, L4, L5]
# CHECK-NEXT: L1: members [L1, L4]
# CHECK-NEXT: L2: members [L2, L3, L4, L5]

function f0 name="take" parameters=[{type=L0}, {type=L1}, {type=L2}] results=[{type=anything}] {
    Return
}
function f1 name="BaseMessage" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L3 flags=[IsFromCompiler]}]
function f2 name="ReplyMessage" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=L4 flags=[IsFromCompiler]}]
function f3 name="QueryMessage" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=L5 flags=[IsFromCompiler]}]
