# class Base { id }   class Derived extends Base { status }   class Other extends Base { path }   class Renamed extends Base {}   (base as Derived).status   (base as Renamed).id
# The assertion puts Base below Derived. A Derived has `status`, which a Base and an Other have not, so neither is expected where a Derived is.
# Renamed adds no field, so its fields do not tell a Base from it.
# FORM: AsRead
# RUN: members

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
layout L0 kind=Instance name="Base" constructor=f1 fields=[{key="id" declared={type=number} flags=[IsRequired]}] supertypes=[L1, L3]
layout L1 kind=Instance name="Derived" base=L0 constructor=f2 fields=[{key="status" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
layout L2 kind=Instance name="Other" base=L0 constructor=f3 fields=[{key="path" declared={type=string} flags=[IsRequired]}] flags=[HasHeritage]
layout L3 kind=Instance name="Renamed" base=L0 constructor=f4 flags=[HasHeritage]
# CHECK: L0: members [L0, L1, L2, L3]
# CHECK-NEXT: L1: members [L1]
# CHECK-NEXT: L2: members [L2]
# CHECK-NEXT: L3: members [L0, L1, L2, L3]

function f0 name="take" parameters=[{type=L0}, {type=L1}, {type=L2}, {type=L3}] results=[{type=anything}] {
    Return
}
function f1 name="Base" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L0 flags=[IsFromCompiler]}]
function f2 name="Derived" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=L1 flags=[IsFromCompiler]}]
function f3 name="Other" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=L2 flags=[IsFromCompiler]}]
function f4 name="Renamed" kind=DerivedConstructor flags=[HasNewTarget] results=[{type=L3 flags=[IsFromCompiler]}]
