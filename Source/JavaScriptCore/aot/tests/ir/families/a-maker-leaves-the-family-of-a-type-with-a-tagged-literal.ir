# interface Node { kind: number; pos: number }  interface Identifier extends Node { kind: 80 }  interface IfStatement extends Node { kind: 245; condition?: Node }  interface Token extends Node { kind: 70 | .. | 90 }
# interface MaybeIdentifier extends Node { kind: 80 | undefined }  interface Loose { kind: 7 }  function NodeObject(this: Node, kind: number, pos: number) { this.kind = kind; this.pos = pos }  new NodeObject(80, 0) as Identifier
# NodeObject gives an object the layout of its tag wherever there is one: L7 for 80 and L8 for 245. So an object with the layout of NodeObject itself was made with another tag,
# and that layout leaves the family of a type that writes one of those literals and nothing else for `kind`, whether its names brought it there (IfStatement) or an assertion of the program (Identifier).
# Beside them, NodeObject stays wherever one of its own objects may still arrive: in its declared type (Node writes `number`), in a type that lists more than one tag (Token),
# in a type whose `kind` may be undefined, which is no tag (MaybeIdentifier), and in a type whose literal has no layout, because Loose is no Node (an object made with 7 has the layout of NodeObject)
