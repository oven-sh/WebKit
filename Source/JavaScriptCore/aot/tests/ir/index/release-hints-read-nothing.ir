# a ReleaseHint reads nothing, and in the body of a coroutine an edge reads nothing that it brings to a parameter which only ReleaseHints read
# RUN: liveness

module m0 path="main.js" displayPath="main.js"

# let x = b; a(x); await ..; x = null
function f0 name="straight" flags=[IsAsync] parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0, -, v1
    v3 = Await v2
    ReleaseHint v1
    Return
# CHECK: v1 Parameter last use: v2
# CHECK: v3 Await last use: none live across: []
}

# let x; while (a()) { x = a(); await a(x); } x = null
function f1 name="loop" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Call v0
    v5 = ToBoolean v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Call v0
    v7 = Call v0, -, v6
    v8 = Await v7
    Jump -> next b1(v6)
  b3():
    ReleaseHint v2
    Return
# CHECK: v1 Undefined last use: none
# CHECK: v6 Call last use: v7
# CHECK: v8 Await last use: none live across: [v0]
}

# the same loop, and behind it x is returned
function f2 name="loopWhoseVariableIsRead" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Undefined
    Jump -> next b1(v1)
  b1(v2):
    LoopHint
    v4 = Call v0
    v5 = ToBoolean v4
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Call v0
    v7 = Call v0, -, v6
    v8 = Await v7
    Jump -> next b1(v6)
  b3():
    ReleaseHint v2
    Return v2
# CHECK: v6 Call last use: v9
# CHECK: v8 Await last use: none live across: [v0 v6]
}

# one such parameter is handed on to another
function f3 name="joins" flags=[IsAsync] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v0
    Jump -> next b3(v3)
  b2():
    v4 = Call v0
    Jump -> next b3(v4)
  b3(v5):
    Jump -> next b4(v5)
  b4(v6):
    ReleaseHint v6
    Return
# CHECK: v3 Call last use: none
# CHECK: v4 Call last use: none
# CHECK: v5 Parameter last use: none
}

# no coroutine: the edges of a twin name all their arguments, so each is handed over
function f4 name="joinsOfPlainFunction" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v0
    Jump -> next b3(v3)
  b2():
    v4 = Call v0
    Jump -> next b3(v4)
  b3(v5):
    Jump -> next b4(v5)
  b4(v6):
    ReleaseHint v6
    Return
# CHECK: v3 Call last use: v4
# CHECK: v4 Call last use: v5
# CHECK: v5 Parameter last use: v6
# CHECK: v6 Parameter last use: none
}
entry module=m0
