# Where the storage of a typed array or a collection is and what it holds are two heaps: a store of an element leaves the storage where it is, and finding a collection's table reads no entry
# FORM: Selected
# RUN: effects

module m0 path="main.js" displayPath="main.js"
function f0 name="typedArray" parameters=[{type=Uint8Array}, {type=int[0, 9]}] results=[{type=undefined}] {
  b0(v0: Uint8Array, v1: int[0, 9]):
    v2 = GetTypedArrayLength v0 typedArrayType=2
    v3 = GetTypedArrayElement v0, v1 typedArrayType=2 level=Proven
    PutTypedArrayElement v0, v1, v1 typedArrayType=2 level=Proven
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v2 GetTypedArrayLength: reads(TypedArrayStorage)
# CHECK-NOT: writes
# CHECK: v3 GetTypedArrayElement: reads(TypedArrayStorage, TypedArrayElements, AllocatorState) writes(AllocatorState) collects
# CHECK-NEXT: v4 PutTypedArrayElement: reads(TypedArrayStorage) writes(TypedArrayElements)
function f1 name="table" parameters=[{type=Map}, {type=anything}] results=[{type=undefined}] {
  b0(v0: Map, v1: anything):
    v2 = CollectionTable v0
    v3 = CallInline v0, v1, v1 inlineBuiltin=MapSet overload=MapPrototypeSet/0
    Return
}
# CHECK-LABEL: function f1
