# `==` converts an object only to compare it with a boolean, number, string, symbol or BigInt. Against undefined, null or another object it runs no code
# FORM: Prepared
# RUN: effects
# RUN(OPERANDS): operands

module m0 path="main.js" displayPath="main.js"
layout L0 name="MayGainNames" fields=[{key="x" declared={type=number}}] flow={impossibleMutations=[RedefineProperty, ChangePrototype]}
function f0 name="compares" parameters=[{type=anything}, {type=undefined|null|L0}, {type=object}, {type=number}, {type=undefined|object}] results=[{type=undefined}] {
  b0(v0: anything, v1: undefined|null|L0, v2: object, v3: number, v4: undefined|object):
    v5 = Null
    v6 = Eq v0, v5
    v7 = Eq v1, v5
    v8 = Eq v2, v2
    v9 = Eq v2, v4
    v10 = Eq v2, v3
    v11 = Eq v3, v2
    v12 = Eq v2, v0
    Return
}
