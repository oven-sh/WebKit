# CHECK-NEXT: v8 GetModuleVariable: read ModuleVariables[g7] stability=Unknown
# CHECK-NEXT: v9 GetModuleVariable: read ModuleVariables[g8] stability=Unknown
# CHECK-NEXT: v10 PutModuleVariable: write ModuleVariables[g4] stored=v0 stability=ChangedByOwnStores
# CHECK-NEXT: v11 PutModuleVariable: write ModuleVariables[g0] stored=v0 stability=Unknown
function f1 name="environmentFields" captures=[{type=env L0}] parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: env L0, v1: number):
    v2 = GetEnvironmentField v0 layout=L0 field=0
    v3 = GetEnvironmentField v0 layout=L0 field=1
    v4 = GetEnvironmentField v0 layout=L0 field=2
    v5 = GetEnvironmentField v0 layout=L0 field=3
    v6 = GetEnvironmentField v0 layout=L0 field=4
    v7 = GetEnvironmentField v0 layout=L0 field=5
    v8 = GetEnvironmentField v0 layout=L0 field=6
    PutEnvironmentField v0, v1 layout=L0 field=1
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v2 GetEnvironmentField: read EnvironmentFields[L0, 0] base=v0 stability=Unknown
# CHECK-NEXT: v3 GetEnvironmentField: read EnvironmentFields[L0, 1] base=v0 stability=ChangedByOwnStores
