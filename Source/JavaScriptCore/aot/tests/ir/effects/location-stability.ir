# CHECK-NEXT: v6 GetEnvironmentField: read EnvironmentFields[L0, 4] base=v0 stability=Unknown
# CHECK-NEXT: v7 GetEnvironmentField: read EnvironmentFields[L0, 5] base=v0 stability=ChangedByOwnStores
