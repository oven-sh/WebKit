# Whether a variable, an environment field or an object field changes behind the back of a function follows from flow's count of its stores and from how it is initialized; whatever flow does not say is unknown
# FORM: Prepared
# RUN: locations

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Environment fields=[{key="nothingKnown" declared={type=number}}, {key="storedAtCreation" declared={type=number} flow={location={stores=AtMostOnce initialization=SetAtCreation}}}, {key="storedFirst" declared={type=number} flow={location={stores=AtMostOnce initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}}}, {key="neverStored" declared={type=number} flow={location={stores=Never initialization=SetAtCreation}}}, {key="storedOnceSomewhere" declared={type=number} flow={location={stores=AtMostOnce}}}, {key="constantStoredFirst" declared={type=number} flags=[IsImmutable] flow={location={initialization=StoredBeforeEveryRead}}}, {key="constantMayBeReadEarly" declared={type=number|absent} flags=[IsImmutable]}]
layout L1 name="Fixed" fields=[{key="a" declared={type=number} flags=[IsRequired] flow={location={stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="c" declared={type=number} flags=[IsRequired] flow={location={stores=Never initialization=SetAtCreation isUnchangedDuringActivation=true} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L1] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L2 name="Stored" fields=[{key="a" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L2] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L3 name="Unchanged" fields=[{key="a" declared={type=number} flags=[IsRequired] flow={location={stores=Never initialization=SetAtCreation isUnchangedDuringActivation=true} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="c" declared={type=number} flags=[IsRequired] flow={location={stores=Never initialization=SetAtCreation isUnchangedDuringActivation=true} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={members=[L3] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L4 kind=Instance name="Base" fields=[{key="id" declared={type=number} flags=[IsRequired] flow={location={stores=AtMostOnce initialization=SetAtCreation} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="n" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L4, L5]}
layout L5 kind=Instance name="Derived" predictedBase=L4 fields=[{key="own" declared={type=number} flags=[IsRequired]}, {key="id" declared={type=number} flags=[IsRequired, IsInherited] originLayout=L4 originField=0}, {key="n" declared={type=number} flags=[IsRequired, IsInherited] originLayout=L4 originField=1}] flags=[HasHeritage] ownFieldCount=1 flow={baseState=Layout base=L4 members=[L5]}
variable g0 name="nothingKnown" declared={type=number} initialization=Undefined
variable g1 name="neverStoredStartUnknown" declared={type=number} initialization=Undefined flow={stores=Never}
variable g2 name="neverStored" declared={type=number} initialization=Undefined flow={stores=Never initialization=SetAtCreation}
variable g3 name="storedOnceSomewhere" declared={type=number} initialization=Undefined flow={stores=AtMostOnce}
variable g4 name="storedFirst" declared={type=number} initialization=Undefined flow={stores=AtMostOnce initialization=StoredBeforeEveryRead}
variable g5 name="storedOnceAfterStart" declared={type=number} initialization=Undefined flow={stores=AtMostOnce initialization=SetAtCreation}
variable g6 name="storedFirstBeforeActivation" declared={type=number} initialization=Undefined flow={stores=AtMostOnce initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}
variable g7 name="constant" declared={type=number} initialization=Undefined flags=[IsImmutable]
variable g8 name="storesUnknown" declared={type=number} initialization=Undefined flow={initialization=StoredBeforeEveryRead isUnchangedDuringActivation=true}
function f0 name="variables" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    v3 = GetModuleVariable variable=g2
    v4 = GetModuleVariable variable=g3
    v5 = GetModuleVariable variable=g4
    v6 = GetModuleVariable variable=g5
    v7 = GetModuleVariable variable=g6
    v8 = GetModuleVariable variable=g7
    v9 = GetModuleVariable variable=g8
    PutModuleVariable v0 variable=g4
    PutModuleVariable v0 variable=g0
    Return
}
