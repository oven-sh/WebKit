# CHECK-NEXT: v2 GetSlot: read ObjectFields["a"] base=v0 stability=ChangedByOwnStores
# CHECK-NEXT: v3 GetSlot: read ObjectFields["b"] base=v0 stability=Unknown
# CHECK-NEXT: v4 GetSlot: read ObjectFields["c"] base=v0 stability=UnchangedDuringActivation
# CHECK-NEXT: v5 PutSlot: write ObjectFields["a"] base=v0 stored=v1 stability=ChangedByOwnStores
function f3 name="fieldsOfTwoLayouts" parameters=[{type=L1|L2}, {type=L1|L3}] results=[{type=undefined}] {
  b0(v0: L1|L2, v1: L1|L3):
    v2 = GetSlot v0 key="a" receivers=[L1, L2] level=Proven
    v3 = GetSlot v1 key="a" receivers=[L1, L3] level=Proven
    v4 = GetSlot v1 key="c" receivers=[L1, L3] level=Proven
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v2 GetSlot: read ObjectFields["a"] base=v0 stability=Unknown
# CHECK-NEXT: v3 GetSlot: read ObjectFields["a"] base=v1 stability=ChangedByOwnStores
