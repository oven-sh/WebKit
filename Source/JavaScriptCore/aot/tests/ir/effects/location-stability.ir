# CHECK-NEXT: v9 PutEnvironmentField: write EnvironmentFields[L0, 1] base=v0 stored=v1 stability=ChangedByOwnStores
function f2 name="fieldsOfOneLayout" parameters=[{type=L1}, {type=number}] results=[{type=undefined}] {
  b0(v0: L1, v1: number):
    v2 = GetSlot v0 key="a" receivers=[L1] level=Proven
    v3 = GetSlot v0 key="b" receivers=[L1] level=Proven
    v4 = GetSlot v0 key="c" receivers=[L1] level=Proven
    PutSlot v0, -, v1 key="a" receivers=[L1] level=Proven
    Return
}
