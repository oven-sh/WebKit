function f4 name="inheritedFields" parameters=[{type=L5}, {type=L4|L5}] results=[{type=undefined}] {
  b0(v0: L5, v1: L4|L5):
    v2 = GetSlot v0 key="id" receivers=[L5] level=Proven
    v3 = GetSlot v0 key="n" receivers=[L5] level=Proven
    v4 = GetSlot v1 key="id" receivers=[L4, L5] level=Proven
    Return
}
