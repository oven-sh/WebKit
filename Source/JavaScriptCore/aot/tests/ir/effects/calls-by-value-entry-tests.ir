# A call by value goes through the entrypoint of its callee, which refuses a call of the wrong kind and collects the rest arguments.
# The tests of `this` and of the arguments against the declared types are operations of the body of the callee, and none of them throws: an operand that may fail its test adds nothing to the call
# FORM: Prepared
# RUN: effects summaries f8 f9 f10

module m0 path="main.ts" displayPath="main.ts"
layout L0 kind=Instance name="Counter" constructor=f5 flow={baseState=None members=[L0]}
function f0 name="deadBody" parameters=[{type=undefined|null|number}] results=[{type=anything}] {
    Unreachable
}
function f1 name="narrowed" parameters=[{type=int}] results=[{type=undefined}] {
    Return
}
function f2 name="expected" parameters=[{type=int flags=[IsExpected]}] results=[{type=undefined}] {
  b0(v0: anything ~ int):
    Return
}
function f3 name="typedThis" flags=[HasThis] thisType={type=undefined|null|string} results=[{type=undefined}] {
    Return
}
function f4 name="second" parameters=[{type=anything}, {type=undefined|null|string}] results=[{type=undefined}] {
    Return
}
function f5 name="Counter" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=undefined|null|number}] results=[{type=anything}] constructedClass=L0 {
    Unreachable
}
function f6 name="asynchronous" flags=[IsAsync] parameters=[{type=undefined|null|number}] results=[{type=anything}] {
    Unreachable
}
function f7 name="rest" flags=[HasRestParameter] parameters=[{type=Array<number>}] results=[{type=undefined}] {
    Return
}
function f8 name="arguments" parameters=[{type=f0}, {type=f1}, {type=f2}, {type=f4}, {type=anything}, {type=string}, {type=number}, {type=undefined}, {type=int}] results=[{type=undefined}] {
    v9 = Call v0, -, v5 callees=[f0]
    v10 = Call v0, -, v4 callees=[f0]
    v11 = Call v0, -, v6 callees=[f0]
    v12 = Call v0, -, v7 callees=[f0]
    v13 = Call v0 callees=[f0]
    v14 = Call v1, -, v5 callees=[f1]
    v15 = Call v1, -, v6 callees=[f1]
    v16 = Call v1, -, v8 callees=[f1]
    v17 = Call v2, -, v4 callees=[f2]
    v18 = Call v2, -, v8 callees=[f2]
    v19 = Call v3, -, v5, v6 callees=[f4]
    v20 = Call v3, -, v6, v5 callees=[f4]
    v21 = Call v3, -, v6 callees=[f4]
    Return
}
# The body of f0 is dead and its summary is `none`: nothing is left of the call, whatever the argument
# CHECK-LABEL: function f8
# CHECK-NEXT: v9 Call: throwsForLackOfStack
# CHECK-NEXT: v10 Call: throwsForLackOfStack
# CHECK-NEXT: v11 Call: throwsForLackOfStack
# CHECK-NEXT: v12 Call: throwsForLackOfStack
# CHECK-NEXT: v13 Call: throwsForLackOfStack
# The same for a type that flow narrowed and for a type that is only expected
# CHECK-NEXT: v14 Call: throwsForLackOfStack
# CHECK-NEXT: v15 Call: throwsForLackOfStack
# CHECK-NEXT: v16 Call: throwsForLackOfStack
# CHECK-NEXT: v17 Call: throwsForLackOfStack
# CHECK-NEXT: v18 Call: throwsForLackOfStack
# CHECK-NEXT: v19 Call: throwsForLackOfStack
# CHECK-NEXT: v20 Call: throwsForLackOfStack
# CHECK-NEXT: v21 Call: throwsForLackOfStack
function f9 name="receivers" parameters=[{type=f3}, {type=string}, {type=number}] results=[{type=undefined}] {
    v3 = Call v0, v1 callees=[f3]
    v4 = Call v0, v2 callees=[f3]
    v5 = Call v0 callees=[f3]
    Return
}
# CHECK-LABEL: function f9
# CHECK-NEXT: v3 Call: throwsForLackOfStack
# CHECK-NEXT: v4 Call: throwsForLackOfStack
# CHECK-NEXT: v5 Call: throwsForLackOfStack
function f10 name="otherEntries" parameters=[{type=f5}, {type=f6}, {type=f7}, {type=string}, {type=number}, {type=Array}] results=[{type=undefined}] {
    v6 = Construct v0, -, v3 callees=[f5]
    v7 = Construct v0, -, v4 callees=[f5]
    v8 = Call v1, -, v3 callees=[f6]
    v9 = Call v1, -, v4 callees=[f6]
    v10 = Call v2, -, v3 callees=[f7]
    v11 = Call v2, -, v4 callees=[f7]
    v12 = Call v2 callees=[f7]
    v13 = CallList v1, -, v5 callees=[f6]
    Return
}
# CHECK-LABEL: function f10
# CHECK-NEXT: v6 Construct: throwsForLackOfStack
# CHECK-NEXT: v7 Construct: throwsForLackOfStack
# CHECK-NEXT: v8 Call: throwsForLackOfStack
# CHECK-NEXT: v9 Call: throwsForLackOfStack
# CHECK-NEXT: v10 Call: reads(AllocatorState) writes(AllocatorState) throwsForLackOfStack collects
# CHECK-NEXT: v11 Call: reads(AllocatorState) writes(AllocatorState) throwsForLackOfStack collects
# CHECK-NEXT: v12 Call: reads(AllocatorState) writes(AllocatorState) throwsForLackOfStack collects
# A list of any length has to fit on the stack before the callee is entered
# CHECK-NEXT: v13 CallList: reads(Elements, ArrayStorage) throws
