# A function that returns a new object is split: its wrapper calls the worker, which holds the operations that stood in the function's own body. The call of the wrapper says of an operand what the call of the whole function said,
# also where the worker begins again in a generic version. So a caller that alone holds the list it hands over still knows it as it was made.
# FORM: Prepared
# RUN: operands summaries f0

module m0 path="main.js" displayPath="main.js"
function f0 name="caller" parameters=[{type=function}] results=[{type=anything}] {
    v1 = Double number=1.5
    v2 = NewArray v1 contents=number
    v3 = CallDirect v2, v0 function=f1
    v4 = CallDirect v2, v0 function=f2
    v5 = CallDirect v2, v0 function=f4
    Return v3
}
# CHECK-LABEL: function f0
# CHECK: v3 CallDirect 0: [Inspects]
# CHECK: v4 CallDirect 0: [Inspects]
# CHECK: v5 CallDirect 0: [Inspects]

function f1 name="whole" parameters=[{type=Array}, {type=function}] results=[{type=Array}] {
    v2 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v3 = Call v1, -
    v4 = NewArray v2, v3 contents=anything
    Return v4
}

function f2 name="split" role=ResultWrapper parameters=[{type=Array}, {type=function}] results=[{type=Array}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=ResultWrapper{worker=f3} {
    v2 = CallDirect v0, v1 function=f3
    v3 = ResultAt v2
    v4 = ResultAt v2 index=1
    v5 = NewArray v3, v4 contents=anything
    Return v5
}

function f3 name="split" role=ResultWorker parameters=[{type=Array}, {type=function}] results=[{type=int[0, 4294967295]}, {type=anything}] capabilities=[MayChangeSignature, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f2 parameterMap=[{original=0}, {original=1}]} creator=ResultWorker{origin=f2} {
    v2 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    v3 = Call v1, -
    v4 = Results v2, v3
    Return v4
}

function f4 name="splitAndBeginsAgain" role=ResultWrapper parameters=[{type=Array}, {type=function}] results=[{type=Array}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=ResultWrapper{worker=f5} {
    v2 = CallDirect v0, v1 function=f5
    v3 = ResultAt v2
    v4 = ResultAt v2 index=1
    v5 = NewArray v3, v4 contents=anything
    Return v5
}

function f5 name="splitAndBeginsAgain" role=ResultWorker parameters=[{type=Array}, {type=function}] results=[{type=int[0, 4294967295]}, {type=anything}] capabilities=[MayChangeSignature, MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f4 parameterMap=[{original=0}, {original=1}]} creator=ResultWorker{origin=f4} {
    v2 = CallDirect v0 function=f7 [isNeverInlined]
    v3 = Call v1, -
    v4 = Results v2, v3
    Return v4
}

function f6 name="measure" parameters=[{type=Array}] results=[{type=int[0, 4294967295]}] {
    v1 = CallBuiltin v0 overload=ArrayPrototypeLength/0
    Return v1
}

function f7 name="measure" role=GenericVersion parameters=[{type=Array flags=[IsExpected]}] results=[{type=int[0, 4294967295]}] derivation={source=f6 parameterMap=[{original=0}]} creator=Version{provenVersion=f6} {
  b0(v0: anything):
    v1 = AssumeType v0 provenType=Array
    v2 = CallBuiltin v1 overload=ArrayPrototypeLength/0
    Return v2
}
