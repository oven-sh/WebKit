# A summary has the reads and writes of the paths that return apart from those of the paths that throw, and the flags of every path in both
# FORM: Prepared
# RUN: effects summaries

module m0 path="main.js" displayPath="main.js"
variable g0 name="stored" declared={type=anything} initialization=Undefined
function f0 name="writesOnEachPath" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    PutModuleVariable v0 variable=g0
    Throw v0
  b2():
    v2 = String string="returns"
    Return
}
# CHECK: f0 return: reads(AllocatorState) writes(AllocatorState) throws throw: writes(ModuleVariables/1) throws
function f1 name="neverReturns" results=[{type=never}] {
    v0 = Undefined
    PutModuleVariable v0 variable=g0
    Throw v0
}
# CHECK-NEXT: f1 return: throws throw: writes(ModuleVariables/1) throws
function f2 name="blockEndsAtNever" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v1 = String string="before"
    v2 = CallDirect function=f1
    Unreachable
  b2():
    Return
}
# CHECK-NEXT: f2 return: throws throw: reads(AllocatorState) writes(ModuleVariables/1, AllocatorState) throws
function f3 name="returnsCall" results=[{type=undefined}] {
    v0 = CallDirect function=f4
    ReturnCall v0
}
# CHECK-NEXT: f3 return: writes(ModuleVariables/1) throw: none
function f4 name="cannotThrow" results=[{type=undefined}] {
    v0 = Undefined
    PutModuleVariable v0 variable=g0
    Return
}
# CHECK-NEXT: f4 return: writes(ModuleVariables/1) throw: none
function f5 name="flagsOfThrowingPath" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    LoopHint
    Throw v0
  b2():
    Return
}
# CHECK-NEXT: f5 return: throws collects terminates throw: reads(RuntimeState) writes(RuntimeState) throws collects terminates
function f6 name="flagsOfReturningPath" parameters=[{type=boolean}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Throw v0
  b2():
    LoopHint
    Return
}
# CHECK-NEXT: f6 return: reads(RuntimeState) writes(RuntimeState) throws collects terminates throw: reads(RuntimeState) writes(RuntimeState) throws collects terminates
function f7 name="reachesNoExit" results=[{type=undefined}] {
    Jump -> next b1()
  b1():
    LoopHint
    Jump -> next b1()
}
# CHECK-NEXT: f7 return: throwsForLackOfMemory collects terminates throw: reads(RuntimeState) writes(RuntimeState) throwsForLackOfMemory collects terminates
