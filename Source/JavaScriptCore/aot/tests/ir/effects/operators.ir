# An operator on numbers does nothing, on other primitives it has its declared set, and an object operand adds the lookups of its conversion and the code they can reach.
# What only makes a text of primitives that are no symbols and that fit in one string by their types ("a" + 1, String(1)) throws for lack of memory alone, so it goes away with its unused result;
# a text joined with any string may be longer than a string may be, and a BigInt added to a BigInt may be too large by the language's rule
# FORM: Prepared
# RUN: effects summaries f0 f1 f2 f3

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Amount" constructor=f4 flow={baseState=None impossibleMutations=[RedefineProperty, AddProperty, ChangePrototype]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="valueOf" function=f5 mutability=Fixed}, {key="toString" function=f6 mutability=Fixed}]}
variable g0 name="conversions" declared={type=number} initialization=Undefined
function f0 name="add" parameters=[{type=number}, {type=string}, {type=bigint}, {type=object}, {type=L0}] results=[{type=undefined}] {
    v5 = Add v0, v0
    v6 = Add v0, v1
    v7 = Add v2, v2
    v8 = Add v0, v3
    v9 = Add v0, v4
    v10 = String string="a"
    v11 = Add v0, v10
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v5 Add: none
# CHECK-NEXT: v6 Add: reads(StringStorage, AllocatorState) writes(StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NEXT: v7 Add: reads(StringStorage, AllocatorState) writes(StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NEXT: v8 Add: reads(all) {{*}}callsUnknownCode
# CHECK-NEXT: v9 Add: reads(ObjectFields, PrototypeLinks, NamedProperties, StringStorage, AllocatorState) writes(ModuleVariables/1, StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NOT: callsUnknownCode
# CHECK: v11 Add: reads(StringStorage, AllocatorState) writes(StringStorage, AllocatorState, RuntimeState) throwsForLackOfMemory collects
function f1 name="less" parameters=[{type=number}, {type=string}] results=[{type=undefined}] {
    v2 = Less v0, v0
    v3 = Less v1, v1
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v2 Less: none
# CHECK-NEXT: v3 Less: reads(StringStorage) writes(StringStorage, RuntimeState) throws collects
function f2 name="strictEq" parameters=[{type=object}, {type=string}, {type=undefined}, {type=anything}] results=[{type=undefined}] {
    v4 = StrictEq v0, v0
    v5 = StrictEq v1, v2
    v6 = StrictEq v1, v0
    v7 = StrictEq v1, v1
    v8 = StrictEq v1, v3
    Return
}
# CHECK-LABEL: function f2
# CHECK-NEXT: v4 StrictEq: none
# CHECK-NEXT: v5 StrictEq: none
# CHECK-NEXT: v6 StrictEq: none
# CHECK-NEXT: v7 StrictEq: reads(StringStorage) writes(StringStorage, RuntimeState) throwsForLackOfMemory collects
# CHECK-NEXT: v8 StrictEq: reads(StringStorage) writes(StringStorage, RuntimeState) throwsForLackOfMemory collects
function f3 name="conversions" parameters=[{type=number}, {type=string}, {type=symbol}] results=[{type=undefined}] {
    v3 = ToString v0
    v4 = ToString v1
    v5 = ToNumber v0
    v6 = ToNumber v2
    Return
}
# CHECK-LABEL: function f3
# CHECK-NEXT: v3 ToString: reads(StringStorage, AllocatorState) writes(StringStorage, AllocatorState, RuntimeState) throwsForLackOfMemory collects
# CHECK-NEXT: v4 ToString: reads(StringStorage, AllocatorState) writes(StringStorage, AllocatorState, RuntimeState) throwsForLackOfMemory collects
# CHECK-NEXT: v5 ToNumber: none
# CHECK-NEXT: v6 ToNumber: reads(StringStorage) writes(StringStorage, RuntimeState) throws collects
function f4 name="Amount" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f5 name="valueOf" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=number}] {
    v1 = Integer integer=1
    PutModuleVariable v1 variable=g0
    Return v1
}
function f6 name="toString" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=string}] {
    v1 = String string="amount"
    Return v1
}
