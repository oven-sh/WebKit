# The typed body behind the tests at the entrance of a function begins again in the generic version and hands on its own parameters. What the generic version makes of a parameter follows the type that is handed in:
# the side of a test, what two ways through the function join. A built-in whose operands fitted no overload while they could be anything is judged by what they are then: Number() of a string or zero runs no code of the program.
# Whoever else calls the generic version gets all that it may do, and so does a build: only the verifier makes such summaries.
# FORM: Prepared
# RUN: effects summaries-by-types-of-operands f1 f2 f3
# RUN(ASREAD): effects summaries f1 f3

module m0 path="main.js" displayPath="main.js"

function f0 name="counted" role=EntryChecks parameters=[{type=undefined|null|string flags=[IsExpected]}, {type=Array<number, proven, pristine[Storage, Names, Dense]>}] results=[{type=number}] creator=EntryChecks{body=f1 fallback=f2} {
  b0(v0: anything, v1: Array<number, proven, pristine[Storage, Names, Dense]>):
    v2 = TypeTest v0 testedType=undefined|null|string
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3: undefined|null|string):
    v4 = CallDirect v3, v1 function=f1
    Return v4
  b2() frequency=Rare:
    v5 = CallDirect v0, v1 function=f2
    Return v5
}

function f1 name="counted" parameters=[{type=undefined|null|string}, {type=Array<number, proven, pristine[Storage, Names, Dense]>}] results=[{type=number}] derivation={source=f0 parameterMap=[{original=0}, {original=1}]} {
  b0(v0: undefined|null|string, v1: Array<number, proven, pristine[Storage, Names, Dense]>):
    v2 = HasArrayStorage v1 arrayStorage=Double
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = Integer integer=1
    Return v4
  b2() frequency=Rare:
    v5 = CallDirect v0, v1 function=f2 [isNeverInlined]
    ReturnCall v5 requirement=Allowed
}
# CHECK: f1 return: reads(ArrayStorage, StringStorage, AllocatorState, RuntimeState) writes(StringStorage, AllocatorState, RuntimeState) throws collects throw:
# ASREAD: f1 return: {{*}}callsUnknownCode

function f2 name="counted" role=GenericVersion parameters=[{type=undefined|null|string flags=[IsExpected]}, {type=Array<number, proven, pristine[Storage, Names, Dense]>}] results=[{type=number}] derivation={source=f0 parameterMap=[{original=0}, {original=1}]} creator=Version{provenVersion=f1} {
  b0(v0: anything, v1: Array<number, proven, pristine[Storage, Names, Dense]>):
    v2 = TypeTest v0 testedType=undefined|null
    Branch v2 -> taken b1(), notTaken b2(| 0)
  b1():
    v3 = Integer
    Jump -> next b3(v3)
  b2(v4: boolean|number|string|symbol|bigint|object):
    Jump -> next b3(v4)
  b3(v5: boolean|number|string|symbol|bigint|object):
    v6 = CallBuiltin -, v5 overload=Number/0 builtinCallForm=AnyReceiver
    Return v6
}
# CHECK: f2 return: {{*}}callsUnknownCode

function f3 name="callsTheTypedBody" parameters=[{type=string}, {type=Array<number, proven, pristine[Storage, Names, Dense]>}] results=[{type=number}] {
  b0(v0: string, v1: Array<number, proven, pristine[Storage, Names, Dense]>):
    v2 = CallDirect v0, v1 function=f1
    Return v2
}
# CHECK: f3 return: reads(ArrayStorage, StringStorage, AllocatorState, RuntimeState) writes(StringStorage, AllocatorState, RuntimeState) throws collects throw:
# ASREAD: f3 return: {{*}}callsUnknownCode
