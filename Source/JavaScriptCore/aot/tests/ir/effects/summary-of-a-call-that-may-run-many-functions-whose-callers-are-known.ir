# Where a call may run more functions than the summary of a body follows, it does whatever any code can do. It is not "unknown code": that is the code which flow does not know, and it
# enters no function whose callers are all known and writes no variable whose writers are all known
# FORM: Prepared
# RUN: effects summaries f66

module m0 path="main.js" displayPath="main.js"
variable g0 name="written" declared={type=number} initialization=Undefined flow={writers=AllKnown}
variable g1 name="other" declared={type=number} initialization=Undefined flow={writers=AllKnown}
# REPEAT: i = 0..63
function f%(i) name="member%(i)" parameters=[{type=number}] results=[{type=undefined}] capabilities=[HasOnlyDirectCallers, IsNeverCalledByHost] {
    Return
}
# END REPEAT
function f64 name="member64" parameters=[{type=number}] results=[{type=undefined}] capabilities=[HasOnlyDirectCallers, IsNeverCalledByHost] {
    PutModuleVariable v0 variable=g0
    Return
}
function f65 name="callsMany" parameters=[{type=anything}, {type=number}] results=[{type=undefined}] capabilities=[HasOnlyDirectCallers, IsNeverCalledByHost] {
    v2 = Call v0, -, v1 callees=[f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31, f32, f33, f34, f35, f36, f37, f38, f39, f40, f41, f42, f43, f44, f45, f46, f47, f48, f49, f50, f51, f52, f53, f54, f55, f56, f57, f58, f59, f60, f61, f62, f63, f64]
    Return
}
function f66 name="caller" parameters=[{type=anything}, {type=number}] results=[{type=undefined}] {
    v2 = CallDirect v0, v1 function=f65
    Return
}
# CHECK-LABEL: function f66
# CHECK-NEXT: v2 CallDirect: unknownCode
