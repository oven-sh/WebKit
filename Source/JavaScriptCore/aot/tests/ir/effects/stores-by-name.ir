# A store by name has the effects of the slot operation or the setter its plan proves: a store to a slot that every object has filled writes the field and nothing else
# FORM: Prepared
# RUN: effects summaries f0 f1 f2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Filled" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[DeleteField, RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType, LoseShape]}
layout L1 name="CreatedLate" fields=[{key="y" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType, LoseShape]}
layout L2 name="CreatedLateNeverEnumerated" fields=[{key="y" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, StoreOfOtherType, LoseShape] keys=NeverEnumerated}
layout L3 name="MayBeFrozen" fields=[{key="x" declared={type=number} flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={impossibleMutations=[DeleteField, RedefineProperty, AddProperty, ChangePrototype, StoreOfOtherType, LoseShape]}
layout L4 kind=Instance name="Gauge" constructor=f3 flow={baseState=None impossibleMutations=[RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true namedMembers=[{key="level" kind=Setter function=f5 mutability=Fixed}]}
layout L5 kind=Instance name="ReplaceableGauge" constructor=f4 flow={baseState=None impossibleMutations=[RedefineProperty, AddProperty, ChangeIntegrity, ChangePrototype, LoseShape]} classFlow={evaluations=AtMostOnce prototypeLink=Fixed staticLink=Fixed prototypeNamesAreComplete=true staticNamesAreComplete=true members=[{key="level" kind=Setter function=f5}] namedMembers=[{key="level" kind=Setter function=f5}]}
variable g0 name="lastLevel" declared={type=anything} initialization=Undefined
function f0 name="fields" parameters=[{type=L0}, {type=L1}, {type=L2}, {type=L3}, {type=null|L0}, {type=number}, {type=string}] results=[{type=undefined}] {
  b0(v0: L0, v1: L1, v2: L2, v3: L3, v4: null|L0, v5: number, v6: string):
    PropSet v0, v5 key="x"
    PropSet v4, v5 key="x"
    PropSet v1, v5 key="y"
    PropSet v2, v5 key="y"
    PropSet v0, v6 key="x"
    PropSet v3, v5 key="x"
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v7 PropSet: writes(ObjectFields/1)
# CHECK-NOT: throws
# CHECK: v8 PropSet: writes(ObjectFields/1) throws
# CHECK-NEXT: v9 PropSet: reads(ObjectFields/1, OrderWords, AllocatorState) writes(ObjectFields/1, OrderWords, AllocatorState, RuntimeState) collects
# CHECK-NEXT: v10 PropSet: writes(ObjectFields/1)
# CHECK-NOT: ShapeWords
# CHECK: v11 PropSet: reads(all) {{*}}ShapeWords{{*}}callsUnknownCode
# CHECK-NEXT: v12 PropSet: reads(all) {{*}}ShapeWords{{*}}callsUnknownCode
function f1 name="setters" parameters=[{type=L4}, {type=L5}, {type=number}] results=[{type=undefined}] {
  b0(v0: L4, v1: L5, v2: number):
    PropSet v0, v2 key="level"
    PropSet v1, v2 key="level"
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v3 PropSet: writes(ModuleVariables/1)
# CHECK-NOT: callsUnknownCode
# CHECK: v4 PropSet: reads(all) {{*}}callsUnknownCode
function f2 name="definitions" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    PropDefine v1, v0 key="x"
    v3 = NewObject layout=L1 [keepsShape]
    PropDefine v3, v0 key="y"
    Return
}
# CHECK-LABEL: function f2
# CHECK: v2 PropDefine: writes(ObjectFields/1)
# CHECK: v4 PropDefine: reads(ObjectFields/1, OrderWords, AllocatorState) writes(ObjectFields/1, OrderWords, AllocatorState, RuntimeState) collects
# CHECK-NOT: ShapeWords
function f3 name="Gauge" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L4
function f4 name="ReplaceableGauge" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L5
function f5 name="level" kind=Setter flags=[HasThis] thisType={type=anything} parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything, v1: anything):
    PutModuleVariable v1 variable=g0
    Return
}
