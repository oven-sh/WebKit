# A read of a name on a closure that holds only stored values goes on to Function.prototype and Object.prototype. Under a name that neither can be given, and under `call`, which cannot be replaced, it runs no code.
# `demethodize` may be added to Function.prototype and `toString` may be replaced there, by an accessor too
# FORM: Prepared
# RUN: effects summaries f0 f1 f2 f3
# CHECK: f0 return: reads(ObjectFields/1, PrototypeLinks, NamedProperties/1) throwsForLackOfStack collects throw: reads(ObjectFields/1, PrototypeLinks, NamedProperties/1) throwsForLackOfStack collects p0: [Inspects, RetainsContents]
# CHECK-NEXT: f1 return: reads(ObjectFields/1, PrototypeLinks, NamedProperties/1) throwsForLackOfStack collects throw: reads(ObjectFields/1, PrototypeLinks, NamedProperties/1) throwsForLackOfStack collects p0: [Inspects, RetainsContents]
# CHECK-NEXT: f2 return: reads(all) writes(
# CHECK-NEXT: f3 return: reads(all) writes(

module m0 path="main.js" displayPath="main.js"
function f0 name="readsMember" parameters=[{type=f4}] results=[{type=anything}] {
    v1 = PropGet v0 key="member"
    Return v1
}
function f1 name="readsCall" parameters=[{type=f4}] results=[{type=anything}] {
    v1 = PropGet v0 key="call"
    Return v1
}
function f2 name="readsNameThatMayBeAdded" parameters=[{type=f4}] results=[{type=anything}] {
    v1 = PropGet v0 key="demethodize"
    Return v1
}
function f3 name="readsMethodThatMayBeReplaced" parameters=[{type=f4}] results=[{type=anything}] {
    v1 = PropGet v0 key="toString"
    Return v1
}
function f4 name="plain" results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, ClosuresAreReadWithoutCode] {
    Return
}
