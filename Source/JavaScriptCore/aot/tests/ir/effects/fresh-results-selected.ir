# The result of an operation selected for a call of an overload is as fresh as the overload declares, as the result of the call was
# FORM: Selected
# RUN: result-freshness

module m0 path="main.js" displayPath="main.js"
function f0 name="matches" parameters=[{type=RegExp<"a+b"[], pristine[Storage, Names, AsCreated]>}, {type=string}] results=[{type=undefined}] {
    v2 = CallBuiltin v0, v1 overload=RegExpPrototypeExec/0
    v3 = RegExpMatchLiteral v1, v0 overload=RegExpPrototypeExec/0 pattern="a+b" matchForm=Exec
    v4 = RegExpMatchLiteral v1, v0 overload=StringPrototypeMatch/0 pattern="a+b" matchForm=Match
    v5 = RegExpMatchLiteral v1, v0 overload=RegExpPrototypeTest/0 pattern="a+b"
    v6 = RegExpMatchLiteral v1, v0 overload=StringPrototypeSearch/0 pattern="a+b" matchForm=Search
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v2 CallBuiltin: unaliased
# CHECK-NEXT: v3 RegExpMatchLiteral: unaliased
# CHECK-NEXT: v4 RegExpMatchLiteral: unaliased
# CHECK-NEXT: v5 RegExpMatchLiteral: unknown
# CHECK-NEXT: v6 RegExpMatchLiteral: unknown
