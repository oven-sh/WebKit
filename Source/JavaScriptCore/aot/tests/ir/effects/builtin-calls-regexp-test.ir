# A match converts lastIndex, so only on a regular expression that stays as created, whose lastIndex holds a number, does it run no code of the program
# FORM: Prepared
# RUN: effects

module m0 path="main.js" displayPath="main.js"
function f0 name="test" parameters=[{type=RegExp<pristine[Names, AsCreated]>}, {type=string}, {type=RegExp<pristine[Names]>}, {type=RegExp}] results=[{type=undefined}] {
    v4 = CallBuiltin v0, v1 overload=RegExpPrototypeTest/0
    v5 = CallBuiltin v2, v1 overload=RegExpPrototypeTest/0
    v6 = CallBuiltin v3, v1 overload=RegExpPrototypeTest/1
    v7 = CallBuiltin v0, v1 overload=RegExpPrototypeExec/0
    v8 = CallBuiltin v2, v1 overload=RegExpPrototypeExec/0
    Return
}
# CHECK: v4 CallBuiltin: reads(RegExpState, StringStorage, AllocatorState, RuntimeState) writes(RegExpState, StringStorage, AllocatorState, RuntimeState) throws collects
# CHECK-NEXT: v5 CallBuiltin: unknownCode
