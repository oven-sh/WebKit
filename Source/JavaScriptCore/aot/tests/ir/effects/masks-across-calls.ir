variable g0 name="total" declared={type=number} initialization=Undefined
variable g1 name="untouched" declared={type=number} initialization=Undefined
function f0 name="writesFiveLocations" captures=[{type=env L0}] parameters=[{type=L1}, {type=number}] results=[{type=undefined}] {
  b0(v0: env L0, v1: L1, v2: number):
    PutSlot v1, -, v2 key="x" receivers=[L1] level=Proven
    PutSlot v1, -, v2 key="y" receivers=[L1] level=Proven
    PutSlot v1, -, v2 key="z" receivers=[L1] level=Proven
    PutEnvironmentField v0, v2 layout=L0 field=0
    PutModuleVariable v2 variable=g0
    Return
}
# CHECK: f0 return: writes(ModuleVariables/1) throwsForLackOfStack throw: throwsForLackOfStack p0: [Inspects] writes(EnvironmentFields/1) p1: [Inspects] writes(ObjectFields/3)
function f1 name="callsWriter" captures=[{type=env L0}] parameters=[{type=L1}, {type=number}] results=[{type=undefined}] {
  b0(v0: env L0, v1: L1, v2: number):
    v3 = CallDirect v0, v1, v2 function=f0
    Return
}
# CHECK: f1 return: writes(ModuleVariables/1) throwsForLackOfStack throw: writes(ModuleVariables/1) throwsForLackOfStack p0: [{{*}}] writes(EnvironmentFields/1) p1: [{{*}}] writes(ObjectFields/3)
function f2 name="writesEntireHeaps" parameters=[{type=L1}, {type=function}] results=[{type=undefined}] {
    DefineGetter v0, v1 key="x"
    Return
}
# CHECK: f2 return: {{*}}writes(ObjectFields, ShapeWords, OrderWords, MemberGuards, NamedProperties, AllocatorState, RuntimeState){{*}} p0: [{{*}}] reads({{*}}) writes(ObjectFields, ShapeWords, OrderWords, NamedProperties)
function f3 name="callsBoth" captures=[{type=env L0}] parameters=[{type=L1}, {type=number}, {type=function}] results=[{type=undefined}] {
  b0(v0: env L0, v1: L1, v2: number, v3: function):
    v4 = CallDirect v0, v1, v2 function=f0
    v5 = CallDirect v1, v3 function=f2
    Return
}
# CHECK: f3 return: {{*}}writes(ModuleVariables/1, ObjectFields, ShapeWords,{{*}} p0: [{{*}}] writes(EnvironmentFields/1) p1: [{{*}}] reads({{*}}) writes(ObjectFields, ShapeWords, OrderWords, NamedProperties)
function f4 name="callsSeventyWriters" parameters=[{type=L2}, {type=number}] results=[{type=undefined}] {
# REPEAT: i = 2..71
    v%(i) = CallDirect v0, v1 function=f%(i+3)
# END REPEAT
    Return
}
# CHECK: f4 return: throwsForLackOfStack throw: throwsForLackOfStack p0: [{{*}}] writes(ObjectFields/[[bits]])
# CHECK-NOT: NamedProperties
# REPEAT: i = 0..69
function f%(i+5) name="writesKey%(i)" parameters=[{type=L2}, {type=number}] results=[{type=undefined}] {
    PutSlot v0, -, v1 key="k%(i)" receivers=[L2] level=Proven
    Return
}
# END REPEAT
function f75 name="callsCallerOfSeventy" parameters=[{type=L2}, {type=number}] results=[{type=undefined}] {
    v2 = CallDirect v0, v1 function=f4
    Return
}
# CHECK: f5 return: throwsForLackOfStack throw: throwsForLackOfStack p0: [Inspects] writes(ObjectFields/1)
# CHECK: f74 return: throwsForLackOfStack throw: throwsForLackOfStack p0: [Inspects] writes(ObjectFields/1)
