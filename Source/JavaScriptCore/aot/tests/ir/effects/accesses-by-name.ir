# A read by name has the effects its plan proves from the type of the receiver: a slot read, a getter's summary, a walk of the chain. Without a proof it is unknown code
# FORM: Prepared
# RUN: effects summaries
# RUN(PLAIN): effects f3 f4 f7
# RUN(ONLY): effects f4

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled prototypeName=AbsentOnPrototypes stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="y" declared={type=number} flow={prototypeName=AbsentOnPrototypes stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="z" declared={type=number} flow={stability=[IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="redefined" declared={type=number}}] flow={members=[L0] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 kind=Instance name="Lazy" constructor=f0 flow={baseState=None members=[L1] impossibleMutations=[AddProperty, ChangePrototype]} classFlow={prototypeLink=Fixed prototypeNamesAreComplete=true members=[{key="x" kind=Getter function=f1 mutability=Fixed}, {key="run" function=f2 mutability=Fixed}, {key="loose" kind=Getter function=f1}] namedMembers=[{key="x" kind=Getter function=f1 mutability=Fixed}, {key="run" function=f2 mutability=Fixed}, {key="loose" kind=Getter function=f1}]}
variable g0 name="count" declared={type=number} initialization=Undefined
function f0 name="Lazy" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L1
function f1 name="x" kind=Getter flags=[HasThis] thisType={type=anything} results=[{type=number}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PutModuleVariable v1 variable=g0
    Return v1
}
function f2 name="run" kind=Method flags=[HasThis] thisType={type=anything} results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Integer integer=2
    PutModuleVariable v1 variable=g0
    Return
}
function f3 name="receiverIsNotProven" parameters=[{type=object}, {type=anything}] results=[{type=undefined}] {
  b0(v0: object, v1: anything):
    v2 = PropGet v0 key="x"
    v3 = PropGet v1 key="x"
    v4 = PropGet v0 key="x" receivers=[L0, ..]
    v5 = PropGet v0 key="x" receivers=[L0]
    Return
}
