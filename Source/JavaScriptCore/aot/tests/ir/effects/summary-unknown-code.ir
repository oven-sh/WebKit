# Unknown code writes a module variable or an environment field only where flow does not know every writer or where it can enter or resume a function that writes it
# FORM: AsRead
# RUN: effects flow summaries f3
# RUN(W): write-overlap flow summaries f3
# RUN(NOFLOW): effects summaries f3
# RUN(NOFLOWW): write-overlap summaries f3

module m0 path="main.js" displayPath="main.js" body=f2
entry module=m0
layout L0 kind=Environment fields=[{key="writtenByGenerator" declared={type=anything} flow={location={writers=AllKnown}}}, {key="writtenByPlainFunction" declared={type=anything} flow={location={writers=AllKnown}}}]
variable g0 name="writerHasOnlyDirectCallers" module=m0 declared={type=anything} initialization=Undefined flow={writers=AllKnown}
variable g1 name="writerEscapes" module=m0 declared={type=anything} initialization=Undefined flow={writers=AllKnown}
variable g2 name="writersUnknown" module=m0 declared={type=anything} initialization=Undefined
function f0 name="hasOnlyDirectCallers" results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g0
    Return
}
function f1 name="escapes" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    PutModuleVariable v0 variable=g1
    Return
}
function f2 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="queueMicrotask" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    v4 = Undefined
    v5 = NewObject -, v4, v4 layout=L0 fields=[0, 1]
    v6 = CallDirect v5 function=f3
    v7 = NewClosure v5 function=f4
    v8 = CallDirect v5, v7 function=f4
    v9 = CallDirect v5 function=f5
    Return
}
function f3 name="readsAroundUnknownCall" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetModuleVariable variable=g0
    v2 = GetModuleVariable variable=g1
    v3 = GetModuleVariable variable=g2
    v4 = GetEnvironmentField v0 layout=L0 field=0
    v5 = GetEnvironmentField v0 layout=L0 field=1
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="somethingUnknown" [isFreeName]
    v8 = Call v7
    Return
}
function f4 name="generatorWithKnownCallers" flags=[IsGenerator, TakesCallee] captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0, v1: function):
    InitialYield
    v3 = Integer integer=1
    PutEnvironmentField v0, v3 layout=L0 field=0
    Return
}
function f5 name="plainFunctionWithKnownCallers" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = Integer integer=1
    PutEnvironmentField v0, v1 layout=L0 field=1
    Return
}
