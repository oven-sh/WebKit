}
# CHECK-LABEL: function f6
# CHECK-NEXT: v3 GetArrayLength: not exact
# CHECK-NEXT: v4 GetMappedArgument: not exact
# CHECK-NEXT: v5 SetMappedArgument: not exact
# CHECK-NEXT: v6 AppendElement: not exact
# CHECK-NEXT: overlap Elements[Array] Elements[Arguments]: None
function f7 name="callback" kind=Arrow results=[{type=undefined}] {
