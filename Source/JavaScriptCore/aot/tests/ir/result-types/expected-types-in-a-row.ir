# What is expected of a value narrows what was expected of it before; where the two exclude each other the later one stands, inside the type of the value
# FORM: AsRead
# RUN: result-types
# CHECK: v1: anything ~ number|string
# CHECK-NEXT: v2: anything ~ number
# CHECK-NEXT: v3: anything ~ Array
# CHECK: function f1
# CHECK: v1: number|string ~ number
# CHECK-NEXT: v2: number|string ~ string
# CHECK-NEXT: v3: number|string
# CHECK-NOT: Array

module m0 path="main.js" displayPath="main.js"
function f0 name="unknownValue" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=number|string flags=[IsExpected]}
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    v3 = Convert v2 declared={type=Array flags=[IsExpected]}
    Return v3
}
function f1 name="typedValue" parameters=[{type=number|string}] results=[{type=anything}] {
    v1 = Convert v0 declared={type=number flags=[IsExpected]}
    v2 = Convert v1 declared={type=string flags=[IsExpected]}
    v3 = Convert v2 declared={type=Array flags=[IsExpected]}
    Return v3
}
