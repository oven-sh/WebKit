# ElemGet has the element type only for a number key and proven contents of a class whose elements are its indexed properties; declared contents are a prediction
# FORM: Prepared
# RUN: result-types
# CHECK: v9: undefined|number
# CHECK-NEXT: v10: anything ~ undefined|number
# CHECK-NEXT: v11: anything
# CHECK-NEXT: v12: undefined|string
# CHECK-NEXT: v13: undefined|int
# CHECK-NEXT: v14: anything
# CHECK-NEXT: v15: anything
# CHECK-NEXT: v16: anything
# CHECK-NOT: ~

module m0 path="main.js" displayPath="main.js"
function f0 name="e" parameters=[{type=Array<number, proven>}, {type=Array<number>}, {type=i32}, {type=string}, {type=string}, {type=Arguments<int, proven>}, {type=Set<int, proven>}, {type=Generator}, {type=Array<int, proven>|Set<int, proven>}] results=[{type=undefined}] {
  b0(v0: Array<number, proven>, v1: Array<number>, v2: i32, v3: string, v4: string, v5: Arguments<int, proven>, v6: Set<int, proven>, v7: Generator, v8: Array<int, proven>|Set<int, proven>):
    v9 = ElemGet v0, v2
    v10 = ElemGet v1, v2
    v11 = ElemGet v0, v3
    v12 = ElemGet v4, v2
    v13 = ElemGet v5, v2
    v14 = ElemGet v6, v2
    v15 = ElemGet v7, v2
    v16 = ElemGet v8, v2
    Return
}
