# Calls and by-name reads of an untyped receiver are anything
# FORM: Selected
# RUN: result-types
# CHECK: v1: anything
# CHECK-NEXT: v2: anything
# CHECK-NEXT: v3: builtin(GlobalThis)
# CHECK-NEXT: v4: anything
# CHECK-NEXT: v5: anything
# CHECK-NEXT: v6: anything
# CHECK-NOT: ~

module m0 path="main.js" displayPath="main.js"
function f0 name="u" parameters=[{type=anything}] results=[{type=undefined}] {
    v1 = Call v0
    v2 = CallMethod v0 key="m"
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="x" [isFreeName]
    v5 = PropGet v0 key="p"
    v6 = ElemGet v0, v0
    Return
}
