# A CallBuiltin in form Prefix has the results prefixLength states: a presence flag where the overload may return null, the length, the properties its entry lists, then the elements.
# An element of an overload whose elements are substrings of an operand is two results, its bounds in that operand, both -1 where there is no string. Any other element is one result, which may be missing.
# FORM: Prepared
# RUN: result-types
# CHECK: v4.0: int[0, 4294967295]
# CHECK-NEXT: v4.1: int[-1, 2147483647]
# CHECK-NEXT: v4.2: int[-1, 2147483647]
# CHECK-NEXT: v4.3: int[-1, 2147483647]
# CHECK-NEXT: v4.4: int[-1, 2147483647]
# CHECK-NEXT: v5: int[0, 4294967295]
# CHECK-NEXT: v6: int[-1, 2147483647]
# CHECK-NEXT: v7.0: boolean
# CHECK-NEXT: v7.1: int[0, 4294967295]
# CHECK-NEXT: v7.2: int[0, 2147483647]
# CHECK-NEXT: v7.3: string
# CHECK-NEXT: v7.4: int[-1, 2147483647]
# CHECK-NEXT: v7.5: int[-1, 2147483647]
# CHECK-NEXT: v7.6: int[-1, 2147483647]
# CHECK-NEXT: v7.7: int[-1, 2147483647]
# CHECK-NEXT: v8: boolean
# CHECK-NEXT: v9: int[0, 4294967295]
# CHECK-NEXT: v10.0: int[0, 4294967295]
# CHECK-NEXT: v11: Array<string>
# CHECK-NEXT: v12.0: boolean
# CHECK-NEXT: v12.1: int[0, 4294967295]
# CHECK-NEXT: v12.2: undefined|string
# CHECK-NEXT: v12.3: undefined|string
# CHECK-NEXT: v13.0: boolean
# CHECK-NEXT: v13.1: int[0, 4294967295]
# CHECK-NEXT: v13.2: int[0, 2147483647]
# CHECK-NEXT: v13.3: string
# CHECK-NEXT: v14: undefined|string

module m0 path="main.js" displayPath="main.js"
function f0 name="p" parameters=[{type=string}, {type=string}, {type=RegExp}, {type=RegExp<pristine[Storage, Names]>}] results=[{type=undefined}] {
  b0(v0: string, v1: string, v2: RegExp, v3: RegExp<pristine[Storage, Names]>):
    v4 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0 builtinCallForm=Prefix prefixLength=2
    v5 = ResultAt v4 index=0
    v6 = ResultAt v4 index=2
    v7 = CallBuiltin v2, v0 overload=RegExpPrototypeExec/0 builtinCallForm=Prefix prefixLength=2
    v8 = ResultAt v7 index=0
    v9 = ResultAt v7 index=1
    v10 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0 builtinCallForm=Prefix prefixLength=0
    v11 = CallBuiltin v0, v1 overload=StringPrototypeSplit/0
    v12 = CallBuiltin v0, v3 overload=StringPrototypeMatch/0 builtinCallForm=Prefix prefixLength=2
    v13 = CallBuiltin v2, v0 overload=RegExpPrototypeExec/0 builtinCallForm=Prefix prefixLength=0
    v14 = SubstringOrUndefined v0, v6, v6
    Return
}
