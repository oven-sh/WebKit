# NarrowByField has the type of its holder without undefined and null, on which the read threw, and without every member whose field cannot hold what the read gave.
# A member that nothing allocates goes too. Where no member is left they all stay: the code behind a check that never passes is what the generic version is copied from
# FORM: Prepared
# RUN: result-types

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Circle" fields=[{key="kind" declared={type=1} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L1 name="Square" fields=[{key="kind" declared={type=2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L2 name="Triangle" fields=[{key="kind" declared={type=3} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L3 name="Add" fields=[{key="kind" declared={type="add"} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L4 name="Mul" fields=[{key="kind" declared={type="mul"} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L5 name="Neg" fields=[{key="kind" declared={type="neg"} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L6 name="AnyKind" fields=[{key="kind" declared={type=number} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L7 kind=Instance name="Rectangle" fields=[{key="kind" declared={type=2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L8 kind=Instance name="RoundedRectangle" fields=[{key="corner" declared={type=number} flags=[IsRequired]}, {key="kind" declared={type=2} flags=[IsRequired, IsInherited] originLayout=L7 originField=0}] ownFieldCount=1 flow={baseState=Layout base=L7}
layout L9 name="Shape" fields=[{key="kind" declared={type=number} flags=[IsRequired]}] flow={allocation=NeverAllocated}

# The second test reads the tag from what the first one left
function f0 name="chainOfTests" parameters=[{type=undefined|null|L0|L1|L2}] results=[{type=undefined}] {
  b0(v0: undefined|null|L0|L1|L2):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    v8 = PropGet v7 key="kind"
    v9 = Integer integer=2
    v10 = StrictEq v8, v9
    Branch v10 -> taken b3(| 0), notTaken b4(| 0)
  b3(v11):
    v12 = NarrowByField v7, v11 key="kind"
    Return
  b4(v13):
    v14 = NarrowByField v7, v13 key="kind"
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v0: undefined|null|L0|L1|L2
# CHECK-NEXT: v1: int[1, 3]
# CHECK: v4: 1
# CHECK-NEXT: v5: L0
# CHECK-NOT: |L
# CHECK: v6: int[2, 3]
# CHECK-NEXT: v7: L1|L2
# CHECK-NEXT: v8: int[2, 3]
# CHECK: v11: 2
# CHECK-NEXT: v12: L1
# CHECK-NOT: |L
# CHECK: v13: 3
# CHECK-NEXT: v14: L2

# A range has no gaps, so the edge that is not taken learns nothing about the read, and the holder keeps its members
function f1 name="tagInsideTheRange" parameters=[{type=L0|L1|L2}] results=[{type=undefined}] {
  b0(v0: L0|L1|L2):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=2
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f1
# CHECK: v4: 2
# CHECK-NEXT: v5: L1
# CHECK-NOT: |L
# CHECK: v6: int[1, 3]
# CHECK-NEXT: v7: L0|L1|L2

function f2 name="stringTag" parameters=[{type=L3|L4|L5}] results=[{type=undefined}] {
  b0(v0: L3|L4|L5):
    v1 = PropGet v0 key="kind"
    v2 = String string="mul"
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f2
# CHECK: v1: "add"|"mul"|"neg"
# CHECK: v4: "mul"
# CHECK-NEXT: v5: L4
# CHECK-NOT: |L
# CHECK: v6: "add"|"neg"
# CHECK-NEXT: v7: L3|L5

# Two cases that share a body join what each of them left
function f3 name="switchOnTheField" parameters=[{type=L0|L1|L2}] results=[{type=undefined}] {
  b0(v0: L0|L1|L2):
    v1 = PropGet v0 key="kind"
    Switch v1 cases=[1, 3] -> case b1(| 0), case b2(| 0), otherwise b4()
  b1(v2):
    v3 = NarrowByField v0, v2 key="kind"
    Jump -> next b3(v3)
  b2(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b3(v5)
  b3(v6):
    Return
  b4():
    Return
}
# CHECK-LABEL: function f3
# CHECK: v2: 1
# CHECK-NEXT: v3: L0
# CHECK-NOT: |L
# CHECK: v4: 3
# CHECK-NEXT: v5: L2
# CHECK-NEXT: v6: L0|L2

function f4 name="switchOnAStringField" parameters=[{type=L3|L4|L5}] results=[{type=undefined}] {
  b0(v0: L3|L4|L5):
    v1 = PropGet v0 key="kind"
    SwitchString v1 strings=["add", "neg"] -> case b1(| 0), case b2(| 0), otherwise b3()
  b1(v2):
    v3 = NarrowByField v0, v2 key="kind"
    Return
  b2(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b3():
    Return
}
# CHECK-LABEL: function f4
# CHECK: v2: "add"
# CHECK-NEXT: v3: L3
# CHECK-NOT: |L
# CHECK: v4: "neg"
# CHECK-NEXT: v5: L5

function f5 name="fieldThatCanHoldTheValue" parameters=[{type=L0|L1|L6}] results=[{type=undefined}] {
  b0(v0: L0|L1|L6):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f5
# CHECK: v1: number
# CHECK: v4: 1
# CHECK-NEXT: v5: L0|L6
# CHECK-NEXT: v6: number
# CHECK-NEXT: v7: L0|L1|L6

# The copy of an inherited field says nothing about its stores. The field it was copied from does
function f6 name="inheritedField" parameters=[{type=L0|L7|L8}] results=[{type=undefined}] {
  b0(v0: L0|L7|L8):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f6
# CHECK: v4: 1
# CHECK-NEXT: v5: L0
# CHECK-NOT: |L
# CHECK: v6: 2
# CHECK-NEXT: v7: L7|L8

# The field of Shape holds every tag, and no object has that layout
function f7 name="memberThatNothingAllocates" parameters=[{type=L0|L1|L9}] results=[{type=undefined}] {
  b0(v0: L0|L1|L9):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f7
# CHECK: v1: int[1, 2]
# CHECK: v4: 1
# CHECK-NEXT: v5: L0
# CHECK-NOT: |L
# CHECK: v6: 2
# CHECK-NEXT: v7: L1
# CHECK-NOT: |L

# (A function without a check waits for no generic version: there the block is cut at such a narrowing. passes/inline-calls-narrowing-by-a-field-that-leaves-nothing.ir)
function f8 name="noMemberIsLeft" parameters=[{type=anything}, {type=1}] results=[{type=undefined}] {
  b0(v0: anything, v1: 1):
    v2 = Check v0 castType=undefined|L1|L2
    v3 = NarrowByField v2, v1 key="kind"
    Return
}
# CHECK-LABEL: function f8
# CHECK-NEXT: v0: anything
# CHECK-NEXT: v1: 1
# CHECK-NEXT: v2: undefined|L1|L2
# CHECK-NEXT: v3: L1|L2

function f9 name="readThatNothingReaches" parameters=[{type=L0|L1}, {type=never}] results=[{type=undefined}] {
  b0(v0: L0|L1, v1: never):
    v2 = NarrowByField v0, v1 key="kind"
    Unreachable
}
# CHECK-LABEL: function f9
# CHECK: v1: never
# CHECK-NEXT: v2: never
