# What is expected of a NarrowByField does not ask whether a field keeps values of its type: a test of the tag picks the expected member.
# It starts from what is expected of the holder and of the read, so it also narrows a holder whose layouts are only expected
# FORM: Prepared
# RUN: result-types

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Circle" fields=[{key="kind" declared={type=1} flags=[IsRequired]}]
layout L1 name="Square" fields=[{key="kind" declared={type=2} flags=[IsRequired]}]
layout L2 name="Triangle" fields=[{key="kind" declared={type=3} flags=[IsRequired]}]
layout L3 name="Untagged" fields=[{key="size" declared={type=number} flags=[IsRequired]}]
layout L4 name="ExpectedTag" fields=[{key="kind" declared={type=2 flags=[IsExpected]} flags=[IsRequired]}]
layout L5 name="ProvenCircle" fields=[{key="kind" declared={type=1} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]
layout L6 name="ProvenSquare" fields=[{key="kind" declared={type=2} flags=[IsRequired] flow={location={writers=AllKnown} occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}]

# On the edge that is not taken the read is anything, and only what is expected of it excludes 1
function f0 name="provenHolder" parameters=[{type=L0|L1|L2}] results=[{type=undefined}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f0
# CHECK-NEXT: v0: L0|L1|L2
# CHECK-NEXT: v1: anything ~ int[1, 3]
# CHECK: v4: 1
# CHECK-NEXT: v5: L0|L1|L2 ~ L0
# CHECK-NOT: |L
# CHECK: v6: anything ~ int[2, 3]
# CHECK-NEXT: v7: L0|L1|L2 ~ L1|L2

function f1 name="expectedHolder" parameters=[{type=undefined|L0|L1|L2 flags=[IsExpected]}] results=[{type=undefined}] {
  b0(v0: anything ~ undefined|L0|L1|L2):
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2(v6):
    v7 = NarrowByField v0, v6 key="kind"
    Return
}
# CHECK-LABEL: function f1
# CHECK-NEXT: v0: anything ~ undefined|L0|L1|L2
# CHECK-NEXT: v1: anything ~ int[1, 3]
# CHECK: v4: 1
# CHECK-NEXT: v5: boolean|number|string|symbol|bigint|object ~ L0
# CHECK-NOT: |L
# CHECK: v6: anything ~ int[2, 3]
# CHECK-NEXT: v7: boolean|number|string|symbol|bigint|object ~ L1|L2

function f2 name="memberWithoutTheField" parameters=[{type=L0|L1|L3}] results=[{type=undefined}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2():
    Return
}
# CHECK-LABEL: function f2
# CHECK: v4: 1
# CHECK-NEXT: v5: L0|L1|L3 ~ L0|L3

function f3 name="fieldWithAnExpectedType" parameters=[{type=L0|L4}] results=[{type=undefined}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2():
    Return
}
# CHECK-LABEL: function f3
# CHECK: v1: anything ~ int[1, 2]
# CHECK: v4: 1
# CHECK-NEXT: v5: L0|L4 ~ L0
# CHECK-NOT: |L

# An expectation that leaves no member is no expectation
function f4 name="noMemberIsLeft" parameters=[{type=L1|L2}, {type=1}] results=[{type=undefined}] {
    v2 = NarrowByField v0, v1 key="kind"
    Return
}
# CHECK-LABEL: function f4
# CHECK: v1: 1
# CHECK-NEXT: v2: L1|L2
# CHECK-NOT: ~

# Where the fields keep values of their types the same test is a proof, and nothing narrower is left to expect
function f5 name="fieldsThatKeepTheirValues" parameters=[{type=L5|L6}] results=[{type=undefined}] {
    v1 = PropGet v0 key="kind"
    v2 = Integer integer=1
    v3 = StrictEq v1, v2
    Branch v3 -> taken b1(| 0), notTaken b2()
  b1(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Return
  b2():
    Return
}
# CHECK-LABEL: function f5
# CHECK: v1: int[1, 2]
# CHECK: v4: 1
# CHECK-NEXT: v5: L5
# CHECK-NOT: |L
# CHECK-NOT: ~
