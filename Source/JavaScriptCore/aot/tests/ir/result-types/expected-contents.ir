# What a container is only declared to hold is what is expected of a value read from it and never the type of that value. A read of proven contents has them as its type, and nothing narrower is expected of it
# FORM: Prepared
# RUN: result-types
# CHECK: v8: anything ~ undefined|L0
# CHECK-NEXT: v9: undefined|object
# CHECK-NEXT: v10: anything ~ undefined|L0
# CHECK: v12: anything ~ undefined|string
# CHECK-NEXT: v13: anything ~ undefined|L0
# CHECK: v15: anything ~ undefined|L0
# CHECK-NEXT: v16: anything ~ L0
# CHECK-NEXT: v17: undefined|L0
# CHECK-NEXT: v18: anything ~ object
# CHECK: function f1
# CHECK: v5: anything ~ undefined|L0
# CHECK-NEXT: v6: anything ~ undefined|L0
# CHECK-NEXT: v7: anything ~ undefined|L0
# CHECK-NEXT: v8: Array ~ Array<L0>
# CHECK-NEXT: v9: undefined|object
# CHECK: function f2
# CHECK-NEXT: v0: anything ~ Array<L0>
# CHECK: v2: anything ~ undefined|L0

module m0 path="main.js" displayPath="main.js"
layout L0 name="Dog"
function f0 name="reads" flags=[IsAsync] parameters=[{type=Array<L0, pristine[Storage, Names]>}, {type=Array<object, proven>}, {type=i32}, {type=Map<string, L0>}, {type=Set<L0>}, {type=Promise<L0>}, {type=Array<L0, proven>}, {type=Promise<object, proven>}] results=[{type=anything}] {
  b0(v0: Array<L0, pristine[Storage, Names]>, v1: Array<object, proven>, v2: i32, v3: Map<string, L0>, v4: Set<L0>, v5: Promise<L0>, v6: Array<L0, proven>, v7: Promise<object, proven>):
    v8 = ElemGet v0, v2
    v9 = ElemGet v1, v2
    v10 = GetArrayElement v0, v2
    v11 = MapNext v3, v3, v2
    v12 = ResultAt v11 index=2
    v13 = ResultAt v11 index=3
    v14 = SetNext v4, v4, v2
    v15 = ResultAt v14 index=2
    v16 = Await v5
    v17 = ElemGet v6, v2
    v18 = Await v7
    Return v8
}
function f1 name="calls" parameters=[{type=Map<string, L0>}, {type=string}, {type=Array<L0>}, {type=i32}, {type=Map<string, object, proven>}] results=[{type=anything}] {
  b0(v0: Map<string, L0>, v1: string, v2: Array<L0>, v3: i32, v4: Map<string, object, proven>):
    v5 = CallBuiltin v0, v1 overload=MapPrototypeGet/0
    v6 = CallBuiltin v2, v3 overload=ArrayPrototypeAt/0
    v7 = CallBuiltin v2 overload=ArrayPrototypePop/0
    v8 = CallBuiltin v2 overload=ArrayPrototypeSlice/0
    v9 = CallBuiltin v4, v1 overload=MapPrototypeGet/0
    Return v5
}
function f2 name="expectedContainer" parameters=[{type=Array<L0> flags=[IsExpected]}, {type=i32}] results=[{type=anything}] {
  b0(v0: anything ~ Array<L0>, v1: i32):
    v2 = ElemGet v0, v1
    Return v2
}
