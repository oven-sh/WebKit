# A prediction narrows the one before it; where the two exclude each other the later one stands, inside the type of the value
# FORM: Prepared
# RUN: result-types
# CHECK: v1: anything ~ number|string
# CHECK-NEXT: v2: anything ~ number
# CHECK-NEXT: v3: anything ~ Array
# CHECK: function f1
# CHECK: v1: number|string ~ number
# CHECK-NEXT: v2: number|string ~ string
# CHECK-NEXT: v3: number|string
# CHECK-NOT: Array

module m0 path="main.js" displayPath="main.js"
function f0 name="unknownValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Predict v0 predicted=number|string
    v2 = Predict v1 predicted=number
    v3 = Predict v2 predicted=Array
    Return v3
}
function f1 name="typedValue" parameters=[{type=number|string}] results=[{type=anything}] {
  b0(v0: number|string):
    v1 = Predict v0 predicted=number
    v2 = Predict v1 predicted=string
    v3 = Predict v2 predicted=Array
    Return v3
}
