# JSON.parse without a reviver returns plain data: an object or an array of plain data, or null, a boolean, a number or a string. It never returns undefined, a symbol or a bigint.
# A test of the result for a number or for null is therefore not decided by its type, a test for undefined is.
# FORM: Prepared
# RUN: result-types
# CHECK: v3: null|boolean|number|string|object
# CHECK-NEXT: v4: boolean
# CHECK-NEXT: v5: boolean
# CHECK-NEXT: v6: boolean
# CHECK-NEXT: v7: false
# CHECK-NEXT: v8: anything

module m0 path="main.js" displayPath="main.js"
function f0 name="parse" parameters=[{type=string}, {type=anything}] results=[{type=undefined}] {
    v2 = Undefined
    v3 = CallBuiltin -, v0, v2 overload=JSONParse/0
    v4 = TypeTest v3 testedType=number
    v5 = TypeTest v3 testedType=null
    v6 = TypeTest v3 testedType=object
    v7 = TypeTest v3 testedType=undefined
    v8 = CallBuiltin -, v0, v1 overload=JSONParse/1
    Return
}
