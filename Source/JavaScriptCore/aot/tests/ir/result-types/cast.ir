# A cast has its operand's type met with its target: a wider target keeps the operand's type, declared contents come from the target
# FORM: Prepared
# RUN: result-types
# CHECK: v3: i32
# CHECK-NEXT: v4: string
# CHECK-NEXT: v5: Array<number>
# CHECK-NEXT: v6: undefined|number|absent|unspecified
# CHECK-NEXT: v7: fact
# CHECK-NEXT: v8: undefined|number|absent
# CHECK-NEXT: v9: undefined|number
# CHECK-NEXT: v10: number
# CHECK-NEXT: v11: object

module m0 path="main.js" displayPath="main.js"
typesite w0 kind=Assertion
function f0 name="c" parameters=[{type=i32}, {type=anything}, {type=Array<i32>}] results=[{type=undefined}] {
    v3 = Upcast v0 castType=number
    v4 = Check v1 expectedType=string site=w0
    v5 = Upcast v2 castType=Array<number>
    v6 = Unspecified valueType=undefined|number|absent
    v7 = Specified
    v8 = AssumeType v6, v7 provenType=undefined|number|absent
    v9 = CheckInitialized v8 name="x"
    v10 = RequireObjectCoercible v9 nullishAccess=Iterate
    v11 = RequireObject v1 runtimeError=IteratorResultNotObject
    Return
}
