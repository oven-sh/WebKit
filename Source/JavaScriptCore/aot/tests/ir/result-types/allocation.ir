# An allocation has the class it allocates; its layout is proven only where the allocation keeps its shape, and predicted otherwise
# FORM: Prepared
# RUN: result-types
# CHECK: v1: object ~ L0
# CHECK-NEXT: v2: L1
# CHECK-NEXT: v3: env L2
# CHECK-NEXT: v4: Array<number>
# CHECK-NEXT: v5: RegExp<"a"[]>
# CHECK-NEXT: v6: Promise

module m0 path="main.js" displayPath="main.js"
layout L0 fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L2 kind=Environment fields=[{key="c" declared={type=anything}}]
function f0 name="a" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0] [keepsShape]
    v3 = NewObject -, v0 layout=L2 fields=[0]
    v4 = NewArray v0 contents=number
    v5 = NewRegExp pattern="a"
    v6 = ImportModule module=m0 referrer=m0
    Return
}
