# Await of a primitive is the primitive; what a promise holds is only predicted, because Await names no guard for an untouched then
# FORM: Prepared
# RUN: result-types
# CHECK: v5: number
# CHECK-NEXT: v6: anything ~ string
# CHECK-NEXT: v7: anything ~ string
# CHECK-NEXT: v8: anything ~ undefined|string
# CHECK-NEXT: v9: anything
# CHECK-NOT: ~

module m0 path="main.js" displayPath="main.js"
function f0 name="a" flags=[IsAsync] parameters=[{type=number}, {type=Promise<string, proven>}, {type=Promise<string>}, {type=undefined|Promise<string, proven>}, {type=object}] results=[{type=anything}] {
  b0(v0: number, v1: Promise<string, proven>, v2: Promise<string>, v3: undefined|Promise<string, proven>, v4: object):
    v5 = Await v0
    v6 = Await v1
    v7 = Await v2
    v8 = Await v3
    v9 = Await v4
    Return v0
}
