# No test finds the members of a family that have no layout: an array or a function that was converted to an interface. They fail a test of layouts also where the tested type names them, so the taken edge has the listed layouts alone, the other edge keeps the members without a layout
# FORM: Prepared
# RUN: result-types

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="Box" fields=[{key="length" declared={type=number} flags=[IsRequired]}]

function f0 name="everyObjectIsNamed" parameters=[{type=undefined|L0|nolayout}] results=[{type=undefined}] {
  b0(v0: undefined|L0|nolayout):
    v1 = TypeTest v0 testedType=L0|nolayout
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return
  b2(v3):
    Return
}
# CHECK-LABEL: function f0
# CHECK: v2: L0
# CHECK-NOT: nolayout
# CHECK: v3: undefined|nolayout

function f1 name="anyObjectIsAskedFor" parameters=[{type=undefined|L0|nolayout}] results=[{type=undefined}] {
  b0(v0: undefined|L0|nolayout):
    v1 = TypeTest v0 testedType=object
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return
  b2(v3):
    Return
}
# CHECK-LABEL: function f1
# CHECK: v2: L0|nolayout
# CHECK: v3: undefined
# CHECK-NOT: nolayout
