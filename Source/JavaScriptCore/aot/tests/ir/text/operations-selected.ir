# CHECK-NEXT: v7:{{*}}= ResolveCallTarget v0
# CHECK-NEXT: v8:{{*}}= CallResolved v0, v7
# CHECK-NEXT: v9:{{*}}= CallInline v2, v3 inlineBuiltin=StringCharCodeAt overload=StringPrototypeCharCodeAt/0 accessSite=2
# CHECK-NEXT: v10:{{*}}= CallInline -, v3 inlineBuiltin=MathFunction inlineParameters=[1] overload=MathSinh/0 allocationSite=5
# CHECK-NEXT: v11:{{*}}= CallBuiltin v4 overload=ArrayPrototypeJoin/0 literalSeparator=", "
# CHECK-NEXT: TryCallInline v4, v1 inlineBuiltin=ArrayPush overload=ArrayPrototypePush/0 accessSite=3 allocationSite=4 -> done b1(), miss b2()
# CHECK-NEXT: b1(v12:{{*}}):
# CHECK-NEXT: Return v12
# CHECK-NEXT: b2():
# CHECK-NEXT: TryCallInline v4 inlineBuiltin=ArrayIterator inlineParameters=[1] overload=ArrayPrototypeValues/0 -> done b3(), miss b4()
# CHECK-NEXT: b3(v13:{{*}}):
# CHECK-NEXT: Return v13
# CHECK-NEXT: b4():
# CHECK-NEXT: Return
# CHECK-NEXT: }
# CHECK-NEXT: function f5 name="fieldsFromSelected" module=m0 thisType={type=anything} parameters=[{type=number}, {type=number}, {type=anything}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: number, v1: number, v2: anything):
# CHECK-NEXT: v3:{{*}}= Add v0, v1 form=Numbers
# CHECK-NEXT: v4:{{*}}= Add v2, v2 form=Generic
# CHECK-NEXT: v5:{{*}}= ToString v0 form=Number
# CHECK-NEXT: v6:{{*}}= NewClosure function=f0 closureForm=Slim
# CHECK-NEXT: v7:{{*}}= Data data=d0 encoding=ReadOnlyTree
# CHECK-NEXT: v8:{{*}}= Less v0, v1 form=Numbers
# CHECK-NEXT: TestAndBranch v8 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: Return v3
# CHECK-NEXT: b2():
# CHECK-NEXT: Return v4
# CHECK-NEXT: }
# CHECK-NEXT: data d0 root=Array{contents=anything}
# CHECK-NEXT: round trip: same

