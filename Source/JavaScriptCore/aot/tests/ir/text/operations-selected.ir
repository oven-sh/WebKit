# Every operation and terminator that is legal from form Selected on, and the payload fields that have a meaning from then on
# FORM: Selected
# RUN: round-trip
# CHECK: typesite w0 module=m0 position=3 kind=PropertyRead
# CHECK-NEXT: layout L0 name="Point" fields=[{key="x" declared={type=anything}}, {key="y" declared={type=number}}]
# CHECK-NEXT: module m0 path="main.js" displayPath="main.js"
# CHECK-NEXT: function f0 name="fusedAccesses" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=object}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: anything, v1: anything, v2: object):
# CHECK-NEXT: v3:{{*}}= PropGet v0 key="x" accessSite=1 receivers=[L0, ..]
# CHECK-NEXT: v4:{{*}}= PropGetChain v0 key="x" secondKey="y" readOrigin={position=6} accessSite=2 receivers=[L0] secondAccessSite=3
# CHECK-NEXT: v5:{{*}}= PropGetPair v0, v1 key="x" secondKey="y" readOrigin={position=7} accessSite=4 secondAccessSite=5
# CHECK-NEXT: v6:{{*}}= ResultAt v5
# CHECK-NEXT: v7:{{*}}= PropGetPair v0 key="x" secondKey="y" receivers=[L0] [readsFromFirstResult]
# CHECK-NEXT: v8:{{*}}= CallMethod v0, v1, v1 key="m" calleeName="a.m" readOrigin={position=8} accessSite=6 receivers=[L0] callees=[f0] callAccessSite=7
# CHECK-NEXT: v9:{{*}}= CallMethod v0 key="m"
# CHECK-NEXT: v10:{{*}}= TryPutByIds v2, v0, v1 keys=["x", "y"]
# CHECK-NEXT: v11:{{*}}= PropGetAndTest v0 key="x" comparedString="s" accessSite=8
# CHECK-NEXT: TestAndBranch v11 -> taken b1(), notTaken b2()
# CHECK-NEXT: b1():
# CHECK-NEXT: v12:{{*}}= PropGetAndTest v0 key="x" receivers=[L0]
# CHECK-NEXT: TestAndBranch v12 -> taken b2(), notTaken b3()
# CHECK-NEXT: b2():
# CHECK-NEXT: Return v3
# CHECK-NEXT: b3():
# CHECK-NEXT: Return
# CHECK-NEXT: }
# CHECK-NEXT: function f1 name="objects" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=number}, {type=object}, {type=string}, {type=function}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: anything, v1: number, v2: object, v3: string, v4: function):
# CHECK-NEXT: v5:{{*}}= NewObject -, v0, v1 layout=L0 fields=[0, 1]
# CHECK-NEXT: PutSlots v5, v5, v0, v1 placedKeys=[{key="x" level=Proven accessSite=1 mayAdd=true}, {key="y" level=Expected}] receivers=[L0]
# CHECK-NEXT: v7:{{*}}= DefineOwnProperty v2, v3, v0 descriptorFlags=[HasValue, HasWritable, IsWritable, HasEnumerable, IsEnumerable, HasConfigurable, IsConfigurable]
# CHECK-NEXT: v8:{{*}}= DefineOwnProperty v2, v3, -, v4, v4 descriptorFlags=[HasGet, HasSet]
# CHECK-NEXT: DefineAccessors v2, v4, v4 keys=["g", "s"] getterMask=1 enumerableMask=2
# CHECK-NEXT: v10:{{*}}= IntegerBound v1 comparison=Less [numberIsOnLeft]
# CHECK-NEXT: v11:{{*}}= NewPromise
# CHECK-NEXT: FulfillFreshPromise v11, v1
# CHECK-NEXT: v13:{{*}}= IsNotThenable v0
# CHECK-NEXT: Branch v13 -> taken b1(| 0), notTaken b2()
# CHECK-NEXT: b1(v14:{{*}}):
# CHECK-NEXT: FulfillFreshPromise v11, v0, v14
# CHECK-NEXT: Return v11
# CHECK-NEXT: b2():
# CHECK-NEXT: Return
# CHECK-NEXT: }
# CHECK-NEXT: function f2 name="strings" module=m0 thisType={type=anything} parameters=[{type=string}, {type=int}, {type=number}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: string, v1: int, v2: number):
# CHECK-NEXT: v3:{{*}}= StringOrder v0, v0
# CHECK-NEXT: v4:{{*}}= StringOrderToCharacter v0 codeUnit=97
# CHECK-NEXT: v5:{{*}}= StringEqualsLiteral v0 literal="a"
# CHECK-NEXT: v6:{{*}}= StringStartsWithLiteral v0 literal="a"
# CHECK-NEXT: v7:{{*}}= StringEndsWithLiteral v0 literal="a"
# CHECK-NEXT: v8:{{*}}= StringIndexOfLiteral v0, v1 literal="ab"
# CHECK-NEXT: v9:{{*}}= StringIndexOfCharacter v0, v1 codeUnit=97
# CHECK-NEXT: v10:{{*}}= StringLastIndexOfLiteral v0, v1 literal="ab"
# CHECK-NEXT: v11:{{*}}= StringRangeCodeUnitOrNaN v0, v1, v1, v2
# CHECK-NEXT: v12:{{*}}= StringRangeCodeUnitOrNaN v0, -, -, v2
# CHECK-NEXT: v13:{{*}}= StringRangeCodePointOrUndefined v0, v1, v1, v2
# CHECK-NEXT: v14:{{*}}= StringRangeCharacterOrEmpty v0, v1, -, v2
# CHECK-NEXT: v15:{{*}}= StringRangeCharacterOrUndefined v0, -, v1, v2
# CHECK-NEXT: v16:{{*}}= StringRangeEqualsLiteral v0, v1, v1 literal="a"
# CHECK-NEXT: v17:{{*}}= StringRangeToNumber v0, v1, v1
# CHECK-NEXT: v18:{{*}}= StringRangeParseInt v0, v1, v1
# CHECK-NEXT: v19:{{*}}= StringRangeSubstringOrUndefined v0, v1, v1
# CHECK-NEXT: v20:{{*}}= RegExpMatchLiteral v0 overload=RegExpPrototypeTest/0 pattern="a+" regExpFlags=[IgnoreCase]
# CHECK-NEXT: v21:{{*}}= RegExpMatchLiteral v0 overload=RegExpPrototypeExec/0 pattern="a" matchForm=Exec
# CHECK-NEXT: v22:{{*}}= ValueLooselyEqualsLiteral v0 literal="a"
# CHECK-NEXT: v23:{{*}}= ValueEqualsLiteral v0 literal="a"
# CHECK-NEXT: v24:{{*}}= StringRangeCodeUnitOrMinusOne v0, v1, -, v2
# CHECK-NEXT: Return v20
# CHECK-NEXT: }
# CHECK-NEXT: function f3 name="builderParts" module=m0 thisType={type=anything} parameters=[{type=string}, {type=int}, {type=number}, {type=boolean}, {type=anything}, {type=undefined|null|string}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: string, v1: int, v2: number, v3: boolean, v4: anything, v5: undefined|null|string):
# CHECK-NEXT: v6:{{*}}= StringBuilderBegin
# CHECK-NEXT: StringBuilderAppendConstant v6 string="a"
# CHECK-NEXT: StringBuilderAppendInteger v6, v1
# CHECK-NEXT: StringBuilderAppendNumber v6, v2
# CHECK-NEXT: StringBuilderAppendString v6, v0
# CHECK-NEXT: StringBuilderAppendStringRange v6, v0, v1, v1
# CHECK-NEXT: StringBuilderAppendBoolean v6, v3
# CHECK-NEXT: StringBuilderAppendStringOrNullish v6, v5
# CHECK-NEXT: StringBuilderAppendValue v6, v4
# CHECK-NEXT: v15:{{*}}= StringBuilderFinish v6
# CHECK-NEXT: Return v15
# CHECK-NEXT: }
# CHECK-NEXT: function f4 name="calls" module=m0 thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=string}, {type=number}, {type=Array}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: anything, v1: anything, v2: string, v3: number, v4: Array):
# CHECK-NEXT: v5:{{*}}= ResolveCallTarget v0 argumentCount=1
