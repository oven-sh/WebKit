# a class without a field of its own below a class that has one. The text of a program that was read once lists the field of the base in the layout below, and a count of zero is left out of the text:
# the layout's own fields are those in front of the first that is inherited
# class Handler { count = 0 }  class Below extends Handler { }
# RUN: print
# CHECK: layout L0 {{*}}name="Handler" {{*}}ownFieldCount=1
# CHECK-NEXT: layout L1 {{*}}name="Below" {{*}}fields=[{key="count" {{*}}IsInherited] originLayout=L0 originField=0}] supertypes=[L0] flags=[HasHeritage]
# CHECK-NOT: ownFieldCount
# CHECK: module m0

layout L0 kind=Instance name="Handler" module=m0 fields=[{key="count" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
layout L1 kind=Instance name="Below" module=m0 base=L0 fields=[{key="count" declared={type=anything} flags=[IsRequired, IsInherited] originLayout=L0 originField=0}] supertypes=[L0] flags=[HasHeritage]
module m0 path="main.ts" displayPath="main.ts" body=f0 positions={lineStarts=[0]}
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Undefined @1
    Return v0 @1
}
