function f3 name="conversions" module=m0 thisType={type=anything} parameters=[{type=number}, {type=int}, {type=i32}, {type=string}] results=[{type=anything}] {
  b0(v0: number @Double, v1: int @Int64, v2: i32 @Int32, v3: string @Cell):
    v4 @JSValue = Box v0
    v5 @Double = Unbox v4
