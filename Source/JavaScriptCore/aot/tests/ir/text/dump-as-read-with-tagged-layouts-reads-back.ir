# interface Node { kind: number; pos: number }  interface Num extends Node { kind: 1; value: number }  interface Add extends Node { kind: 2; left: Node; right: Node }
# function NodeObject(this: Node, kind: number, pos: number) { this.kind = kind; this.pos = pos }
# The reader derives a layout for each tag. A dump of the program as read reads back in: the derived layouts have comment lines, which the parser skips, the families name them by the numbers
# behind the layouts of the text, and the reader of the dump derives them again. The functions are as the front end sent them: a pass rewrites the constructor, not the reader
# RUN: round-trip

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
layout L0 kind=Instance name="NodeObject" constructor=f1 fields=[{key="kind" declared={type=number}}, {key="pos" declared={type=number}}] supertypes=[L1] flags=[IsConstructorFunction]
layout L1 name="Node" fields=[{key="kind" declared={type=number} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}]
layout L2 name="Num" fields=[{key="kind" declared={type=1} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] supertypes=[L1]
layout L3 name="Add" fields=[{key="kind" declared={type=2} flags=[IsRequired]}, {key="pos" declared={type=number} flags=[IsRequired]}, {key="left" declared={type=L1} flags=[IsRequired]}, {key="right" declared={type=L1} flags=[IsRequired]}] supertypes=[L1]
function f0 name="main" kind=Module results=[{type=anything}] {
    Return
}
function f1 name="NodeObject" flags=[HasThis] thisType={type=L1} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
    PropSet v0, v1 key="kind" mode=Strict
    PropSet v0, v2 key="pos" mode=Strict
    Return
}
function f2 name="valueOf" parameters=[{type=L2}] results=[{type=anything}] {
    v1 = PropGet v0 key="value"
    Return v1
}

