# CHECK-NEXT: layout L2 name="Num" fields=[{key="kind" declared={type=1} flags=[IsRequired]},
# CHECK-NEXT: layout L3 name="Add" fields=[{key="kind" declared={type=2} flags=[IsRequired]}, {{*}}, {key="left" declared={type=L0|L1|L2|L3|L4|L5} flags=[IsRequired]},
# CHECK-NEXT: # layout L4 kind=Instance name="NodeObject" fields=[{key="kind" {{*}}, {key="pos" {{*}}, {key="value" {{*}}flags=[IsDerived]
# CHECK-NEXT: # layout L5 kind=Instance name="NodeObject" fields=[{key="kind" {{*}}, {key="pos" {{*}}, {key="left" {{*}}, {key="right" {{*}}flags=[IsDerived]
# CHECK-NEXT: module m0
# CHECK-LABEL: function f1 name="NodeObject"
# CHECK: flags=[HasThis] thisType={type=L0|L1|L2|L3|L4|L5} parameters=[{type=number}, {type=number}]
