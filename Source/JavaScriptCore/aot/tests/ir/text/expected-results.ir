# Expected result lines with every field
# RUN: round-trip
# CHECK: expectedresult x0 type=anything
# CHECK-NEXT: expectedresult x1 type=object layouts=[L0, L1]
# CHECK-NEXT: layout L0 fields=[{key="y" declared={type=anything}}, {key="x" declared={type=number}}]
# CHECK-NEXT: layout L1
# CHECK-NEXT: module m0 path="/a.ts" displayPath="a.ts" body=f0
# CHECK-NEXT: function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}]
# CHECK-NEXT: b0():
# CHECK-NEXT: v0 = Builtin builtin=JSONParse
# CHECK-NEXT: v1 = String string="{}"
# CHECK-NEXT: v2 = Call v0, -, v1 expectedResult=x1
# CHECK-NEXT: Return
# CHECK-NEXT: }
# CHECK-NEXT: entry module=m0
# CHECK-NEXT: round trip: same
# RUN(V): verify
# V: valid

expectedresult x0 type=anything
expectedresult x1 type=object layouts=[L0, L1]
layout L0 fields=[{key="y" declared={type=anything}}, {key="x" declared={type=number}}]
layout L1
module m0 path="/a.ts" displayPath="a.ts" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = Builtin builtin=JSONParse
    v1 = String string="{}"
    v2 = Call v0, -, v1 expectedResult=x1
    Return
}
entry module=m0
