# Two values that name each other as operands: a text of a later form is typed before dominance is verified, and typing follows operands
# FORM: Prepared
# RUN: print
# DIAGNOSTIC: UseNotDominated 1

module m0 path="main.js" displayPath="main.js"
function f0 name="namesEachOther" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v2
    v2 = Add v0, v1
    Return v2
}
function f1 name="loopParameterIsNoCycle" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1(v0)
  b1(v1: number):
    v2 = Add v1, v0
    v3 = Less v2, v0
    Branch v3 -> taken b1(v2), notTaken b2()
  b2():
    Return v2
}
