# Two values that name each other as operands: the text parses, and the verifier refuses the use in front of its definition. A value that comes round a loop through a block parameter is no such use
# RUN: verify
# DIAGNOSTIC: UseNotDominated 1

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="namesEachOther" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    v1 = Add v0, v2
    v2 = Add v0, v1
    Return v2
}
function f1 name="loopParameterIsNoCycle" parameters=[{type=number}] results=[{type=number}] {
  b0(v0: number):
    Jump -> next b1(v0)
  b1(v1: number):
    LoopHint
    v3 = Add v1, v0
    v4 = Less v3, v0
    Branch v4 -> taken b1(v3), notTaken b2()
  b2():
    Return v3
}
