# An id may be used before the line that defines it: lines of different lists stand in any order and print list by list
# RUN: round-trip
# CHECK: layout L0
# CHECK-NEXT: layout L1
# CHECK-NEXT: variable g0 module=m0 declared={type=L1}
# CHECK-NEXT: module m0 path="main.js" displayPath="main.js"
# CHECK-NEXT: function f0 name="ids" module=m0 thisType={type=anything} parameters=[{type=function}] results=[{type=L1}]
# CHECK-NEXT: b0(v0: function):
# CHECK-NEXT: v1 = CallDirect function=f1
# CHECK-NEXT: PutModuleVariable v1 variable=g0
# CHECK-NEXT: Jump -> next b1(v1)
# CHECK-NEXT: b1(v3):
# CHECK-NEXT: Return v3
# CHECK-NEXT: }
# CHECK-NEXT: function f1 name="callee" module=m0
# CHECK-NEXT: entry module=m0
# CHECK-NEXT: round trip: same
# RUN(V): verify
# V: valid

entry module=m0
function f0 name="ids" parameters=[{type=function}] results=[{type=L1}] {
  b0(v0: function):
    v1 = CallDirect function=f1
    PutModuleVariable v1 variable=g0
    Jump -> next b1(v1)
  b1(v3):
    Return v3
}
variable g0 declared={type=L1}
layout L0
function f1 name="callee" results=[{type=L1}]
module m0 path="main.js" displayPath="main.js"
layout L1
