# Function lines of every kind and every role of the wire with every field, and the parameters of block 0 in the order of the entry parameters
# RUN: round-trip
# CHECK: typesite w0 module=m0 position=4 kind=This text="number"
# CHECK-NEXT: layout L0 kind=Environment module=m0 fields=[{key="c" declared={type=anything}}]
# CHECK-NEXT: layout L1 kind=Instance name="C" module=m0 position=20 constructor=f2
# CHECK-NEXT: layout L2 kind=Instance name="D" module=m0 position=40 predictedBase=L1 constructor=f3 supertypes=[L1] flags=[HasHeritage]
# CHECK-NEXT: module m0 path="/a.ts" displayPath="a.ts" flags=[HasTopLevelAwait] body=f0
# CHECK-NEXT: module m1 path="/b.cjs" displayPath="b.cjs" kind=CommonJs exportRule=CommonJs requireResult=ModuleExports body=f9
# CHECK-NEXT: module m2 path="internal:library" displayPath="internal:library" kind=RuntimeSource flags=[IsLibrary] exportRule=RuntimeModule
# CHECK-NEXT: function f0 module=m0 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}]
# CHECK-NEXT: b0():
# CHECK-NEXT: Return
# CHECK-NEXT: }
# CHECK-NEXT: function f1 name="a" module=m0 position=7 text={start=7 end=19} kind=Arrow flags=[IsAsync, IsSloppy] length=2 captures=[{type=number}, {type=env L0}] thisType={type=anything} parameters=[{type=number predicted=i32}, {type=anything}] results=[{type=anything}]
# CHECK-NEXT: function f2 name="C" module=m0 position=20 text={start=20 end=39} kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=object}]
# CHECK-NEXT: function f3 name="D" module=m0 position=40 text={start=40 end=59} kind=DerivedConstructor flags=[HasNewTarget] thisType={type=anything} results=[{type=object}]
# CHECK-NEXT: function f4 module=m0 kind=Method flags=[HasThis] thisType={type=number predicted=i32 site=w0} results=[{type=number}, {type=string}]
# CHECK-NEXT: function f5 name="get" module=m0 kind=Getter flags=[HasThis] thisType={type=object} results=[{type=anything}]
# CHECK-NEXT: function f6 name="set" module=m0 kind=Setter flags=[HasThis] length=1 thisType={type=object} parameters=[{type=anything}] results=[{type=undefined}]
# CHECK-NEXT: function f7 module=m0 kind=Initializer flags=[HasThis] thisType={type=object} results=[{type=anything}]
# CHECK-NEXT: function f8 name="every" module=m0 position=95 flags=[IsSloppy, HasThis, HasNewTarget, TakesCallee, HasArgumentCount, HasHiddenRest, IsHiddenInStackTraces] length=2 captures=[{type=env L0}, {type=classtoken}] thisType={type=object} parameters=[{type=string}, {type=number}] results=[{type=anything}]
# CHECK-NEXT: b0(v0: env L0, v1: classtoken, v2: object, v3: function, v4: anything, v5: int[0, 4294967295], v6: string, v7: number, v8: Array):
# CHECK-NEXT: Return v6
# CHECK-NEXT: }
# CHECK-NEXT: function f9 module=m1 kind=CommonJsModule flags=[IsSloppy, HasThis] thisType={type=anything} parameters=[{type=anything}, {type=anything}, {type=anything}, {type=anything}, {type=anything}] results=[{type=anything}]
# CHECK-NEXT: function f10 name="g" module=m0 flags=[IsGenerator, HasRestParameter, TakesCallee] thisType={type=anything} parameters=[{type=Array}] results=[{type=anything}]
# CHECK-NEXT: function f11 name="apply" module=m2 position=8 kind=Method role=Library flags=[HasThis] length=2 enclosingRuntimeFunction=4 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}]
# CHECK-NEXT: function f12 name="model" module=m2 role=Model thisType={type=anything} results=[{type=anything}]
# CHECK-NEXT: entry module=m0
# CHECK-NEXT: runtimefunction id=4 function=f11
# CHECK-NEXT: round trip: same
# RUN(V): verify
# V: valid

