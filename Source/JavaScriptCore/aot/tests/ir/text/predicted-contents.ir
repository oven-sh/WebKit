# What is predicted of the contents of a class stands behind each of them after `~`, and a prediction that repeats the contents is not kept
# FORM: Prepared
# RUN: round-trip
# CHECK: layout L0
# CHECK-NEXT: layout L1
# CHECK-NEXT: variable g0 module=m0 declared={type=Array<object ~ L0, proven>}
# CHECK-NEXT: variable g1 module=m0 declared={type=Array<object ~ L0|L1, proven, Contiguous, pristine[Storage, Names]>}
# CHECK-NEXT: variable g2 module=m0 declared={type=Array<object ~ L0>}
# CHECK-NEXT: variable g3 module=m0 declared={type=Array<anything ~ number>}
# CHECK-NEXT: variable g4 module=m0 declared={type=Map<string ~ "a"|"b", object ~ L1, proven>}
# CHECK-NEXT: variable g5 module=m0 declared={type=Map<string, object ~ L1, proven>}
# CHECK-NEXT: variable g6 module=m0 declared={type=Map<string ~ "a", object, proven>}
# CHECK-NEXT: variable g7 module=m0 declared={type=Promise<object ~ L0, proven>}
# CHECK-NEXT: variable g8 module=m0 declared={type=Array<Array<number, proven> ~ Array<number, proven, Double>, proven>}
# CHECK-NEXT: variable g9 module=m0 declared={type=Array<Array<object ~ L0, proven> ~ Array<object ~ L0, proven, Contiguous>, proven>}
# CHECK-NEXT: variable g10 module=m0 declared={type=null|Array<object ~ L0, proven>|Set<object ~ L1, proven>}
# CHECK-NEXT: variable g11 module=m0 declared={type=Array<object, proven>}
# CHECK-NEXT: variable g12 module=m0 declared={type=Map<string, object ~ L1, proven>}
# CHECK: round trip: same

variable g0 module=m0 declared={type=Array<object ~ L0, proven>}
variable g1 module=m0 declared={type=Array<object ~ L1|L0, proven, Contiguous, pristine[Storage, Names]>}
variable g2 module=m0 declared={type=Array<object ~ L0>}
variable g3 module=m0 declared={type=Array<anything ~ number>}
variable g4 module=m0 declared={type=Map<string ~ "a"|"b", object ~ L1, proven>}
variable g5 module=m0 declared={type=Map<string, object ~ L1, proven>}
variable g6 module=m0 declared={type=Map<string ~ "a", object, proven>}
variable g7 module=m0 declared={type=Promise<object ~ L0, proven>}
variable g8 module=m0 declared={type=Array<Array<number, proven> ~ Array<number, proven, Double>, proven>}
variable g9 module=m0 declared={type=Array<Array<object ~ L0, proven> ~ Array<object ~ L0, proven, Contiguous>, proven>}
variable g10 module=m0 declared={type=null|Set<object ~ L1, proven>|Array<object ~ L0, proven>}
variable g11 module=m0 declared={type=Array<object ~ object, proven>}
variable g12 module=m0 declared={type=Map<string ~ string, object ~ L1, proven>}
layout L0
layout L1
module m0 path="main.js" displayPath="main.js"
