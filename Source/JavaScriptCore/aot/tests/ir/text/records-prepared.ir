# CHECK-NEXT: function f8 name="asyncRamp" module=m0 role=CoroutineRamp flags=[IsAsync] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=Coroutine{kind=AsyncFunction ramp=f8 body=f9 entryWithoutPromise=f9 promiseType=Promise<number> promiseParameter=0}
