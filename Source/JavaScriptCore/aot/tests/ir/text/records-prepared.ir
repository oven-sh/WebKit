# CHECK-NEXT: function f26 name="validator" module=m0 role=Validator thisType={type=anything} results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost, IsHiddenInStackTraces] creator=Validator{type=L1 layout=L1 expectedResult=x0 node=1}
