# What only the engine writes in a record: every role with its creator record and derivation, kinds of layouts, flags of fields, a registered symbol as a key
# FORM: Prepared
# RUN: round-trip
# CHECK: expectedresult x0 type=L1 layouts=[L1] validation=[{shape=Object{layout=L1} type=L1}, {shape=Primitive{primitive=Number} type=number}]
# CHECK-NEXT: layout L0 kind=Instance name="B" module=m0 fields=[{key="x" declared={type=number}}] ownFieldCount=1
# CHECK-NEXT: layout L1 kind=Instance name="D" module=m0 predictedBase=L0 fields=[{key="y" declared={type=number}}, {key="x" declared={type=number} flags=[IsInherited] originLayout=L0 originField=0}, {key="z" declared={type=anything} flags=[IsAppendedByFlow]}, {key=Symbol.for("s") declared={type=anything} flags=[IsAppendedByFlow]}] flags=[HasHeritage] ownFieldCount=1 flow={baseState=Layout base=L0}
# CHECK-NEXT: layout L2 kind=Closure fields=[{declared={type=anything}}] ownFieldCount=1
# CHECK-NEXT: layout L3 kind=CoroutineFrame fields=[{declared={type=anything}}, {declared={type=number}}] ownFieldCount=2
# CHECK-NEXT: module m0 path="main.js" displayPath="main.js" namespaceLayout=L(m0)
# CHECK-NEXT: function f0 name="origin" module=m0 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost]
# CHECK-NEXT: function f1 name="genericEntrypoint" module=m0 role=GenericEntrypoint captures=[{type=function}] thisType={type=anything} results=[{type=anything}] capabilities=[HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] derivation={source=f0} creator=Entrypoint{target=f0 takesNewTarget=true}
# CHECK-NEXT: function f2 name="groupEntrypoint" module=m0 role=GroupEntrypoint thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] derivation={source=f0} creator=Entrypoint{target=f0 group=[f0, ..] arguments=Registers constructEntrypoint=f1}
# CHECK-NEXT: function f3 name="entrypointInRegisters" module=m0 role=GenericEntrypoint captures=[{type=function}] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] derivation={source=f0} creator=Entrypoint{target=f0 arguments=Registers groupEntrypoint=f2}
# CHECK-NEXT: function f4 name="genericVersion" module=m0 role=GenericVersion thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] derivation={source=f0 parameterMap=[{original=0}]} creator=Version{provenVersion=f0}
# CHECK-NEXT: function f5 name="allocatedThisVersion" module=m0 role=AllocatedThisVersion thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayBeInlined, HasOrdinaryFrame, HasOnlyDirectCallers, IsNeverCalledByHost] derivation={source=f0 parameter=1 node=2 parameterMap=[{}, {original=0}]} creator=Version{provenVersion=f0}
# CHECK-NEXT: function f6 name="generatorRamp" module=m0 role=CoroutineRamp flags=[IsGenerator, TakesCallee] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost, IsHiddenInStackTraces] creator=Coroutine{ramp=f6 body=f7}
