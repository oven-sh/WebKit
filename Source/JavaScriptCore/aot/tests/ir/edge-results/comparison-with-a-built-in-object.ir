# CHECK-LABEL: name="instancesOfTwoClassesThatNoTestTellsApart"
# CHECK: b1(v3: Boolean):
function f11 name="joinBehindTheComparison" parameters=[{type=Array<number>}, {type=builtin(Console)}] results=[{type=anything}] {
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Jump -> next b3(v3)
  b2(v4):
    Jump -> next b3(v4)
  b3(v5):
    Return v5
}
# CHECK-LABEL: name="joinBehindTheComparison"
# CHECK: b3(v5: Array<number>):
