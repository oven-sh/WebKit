# What a comparison leaves of its operand on the edge that is taken lies inside the type of the operand. A built-in object that can be no instance of the operand's class leaves nothing. One that may be an instance leaves the operand as it was
# FORM: Prepared
# RUN: print

module m0 path="main.js" displayPath="main.js"
function f0 name="arrayWithConstructor" parameters=[{type=Array<number>}, {type=builtin(WeakMap)}] results=[{type=undefined}] {
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Unreachable
  b2(v4):
    Return
}
# CHECK-LABEL: name="arrayWithConstructor"
# CHECK: v2: false = StrictEq v0, v1
# CHECK: b1(v3: never):
# CHECK: b2(v4: Array<number>):
function f1 name="arrayWithMethod" parameters=[{type=Array<number>}, {type=builtin(MathMax)}] results=[{type=undefined}] {
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Unreachable
  b2(v4):
    Return
}
# CHECK-LABEL: name="arrayWithMethod"
# CHECK: b1(v3: never):
