# EDGES: t0 failing t2 = never
# EDGES: t0 passing t3 = builtin(GlobalThis)
# EDGES: t0 failing t3 = builtin(ImportMeta)
# EDGES: t1 passing t2 = builtin(ImportMeta)
# EDGES: t1 failing t2 = number
# EDGES: laws hold
