# Each module has its own import.meta, so no test finds it. A test that names it among other objects refuses it as it refuses them, and the edge that is not taken keeps it. Where import.meta is the only object the value may be, the test asks for an object and decides. What can be tested of import.meta by itself is that it is an object: among other objects that test passes them all and narrows nothing. A built-in of the realm is one cell: the edge that is not taken has lost it, behind a test and behind a comparison. A comparison with import.meta that fails takes nothing away
# RUN: edge-results
# RUN(EDGES): edges
# RUN(WRITTEN): edges
# RUN(EQUAL): edges
# RUN(WRONG): edges
# TYPES: f4

module m0 path="main.js" displayPath="main.js"
entry module=m0
function f0 name="amongObjects" parameters=[{type=builtin(GlobalThis)|builtin(ImportMeta)}] results=[{type=undefined}] {
    v1 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return
  b2(v3):
    Return
}
# CHECK-LABEL: name="amongObjects"
# CHECK: b0 -> b1 proof: TestedType test: v1 subject: v0 operand index: 0 side: taken parameter: v2
# CHECK: b0 -> b2 proof: TestedType test: v1 subject: v0 operand index: 0 side: notTaken parameter: v3
function f1 name="onlyObject" parameters=[{type=number|builtin(ImportMeta)}] results=[{type=undefined}] {
    v1 = TypeTest v0 testedType=builtin(ImportMeta)
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return
  b2(v3):
    Return
}
function f2 name="ofRealm" parameters=[{type=builtin(GlobalThis)|builtin(ImportMeta)}] results=[{type=undefined}] {
    v1 = TypeTest v0 testedType=builtin(GlobalThis)
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    Return
  b2(v3):
    Return
}
# CHECK-LABEL: name="onlyObject"
# CHECK-COUNT-4: proof: TestedType test: v1 subject: v0 operand index: 0 side:
# CHECK-NOT: proof:
function f3 name="compared" parameters=[{type=number|builtin(ImportMeta)}] results=[{type=undefined}] {
    v1 = ModuleBuiltin builtin=ImportMeta module=m0
    v2 = StrictEq v0, v1
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    Return
  b2(v4):
    Return
}
# CHECK-LABEL: name="compared"
# CHECK: b0 -> b1 proof: Equality test: v2 subject: v0 operand index: 0 side: taken parameter: v3
# CHECK: b0 -> b2 proof: Equality test: v2 subject: v0 operand index: 0 side: notTaken parameter: v4
# CHECK-NOT: proof:
function f4 name="types" parameters=[{type=builtin(GlobalThis)|builtin(ImportMeta)}, {type=number|builtin(ImportMeta)}, {type=builtin(ImportMeta)}, {type=builtin(GlobalThis)}] results=[{type=undefined}] {
    Return
}
