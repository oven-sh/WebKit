# A test for a function of the application leaves no built-in on the edge that is taken and every built-in on the other. A built-in that is implemented in JavaScript may pass the test for the function the program registers for it, and a closure of that function may pass the test for the built-in: the refusal of either test takes nothing away. A comparison that fails takes away one value at most, and a function has many closures
# RUN: edge-results
# RUN(EDGES): edges
# RUN(EQUAL): edges
# RUN(WRONG): edges
# TYPES: f9

module m0 path="main.js" displayPath="main.js"
entry module=m0
runtimefunction id=FunctionPrototypeCall function=f1
function f0 name="ofTheApplication" captures=[{type=string}] parameters=[{type=anything}] results=[{type=anything}] {
    Return v1
}
function f1 name="call" role=Library flags=[HasRestParameter, HasThis] enclosingRuntimeFunction=FunctionPrototypeCall thisType={type=anything} parameters=[{type=anything}, {type=Array<anything>}] results=[{type=anything}] {
    v3 = CallList v0, v1, v2
    Return v3
}
function f2 name="libraryBuiltinBesideFunction" parameters=[{type=f0|builtin(FunctionPrototypeCall)}] results=[{type=string}] {
    v1 = TypeTest v0 testedType=f0
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = GetCapture v2 function=f0
    Return v3
  b2(v4):
    v5 = String string=""
    Return v5
}
