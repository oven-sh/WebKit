# A member of a constant record of a kind that the type declared for its field has no place for (a silenced error, `any`): the field takes the kind. Nothing throws where the record is expanded,
# and a typed read of the field lets the value through. A member that fits changes nothing, and undefined and null are in every type.
# FORM: AsRead
# RUN: pass AdmitAssertedObjects TypeValues
# STATISTIC: PositionsAdmittingOtherKinds = 4
# STATISTIC: PositionsAdmittingObjects = 0

module m0 path="main.ts" displayPath="main.ts"
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=PropertyRead
layout L0 name="Options" fields=[{key="verbose" declared={type=undefined|null|boolean predicted=boolean}}, {key="depth" declared={type=undefined|null|number predicted=number}}]
layout L1 name="Outer" fields=[{key="name" declared={type=undefined|null|string predicted=string}}, {key="options" declared={type=undefined|null|object written=undefined|null|L2 predicted=L2}}, {key="count" declared={type=undefined|null|number predicted=number}}]
layout L2 name="Inner" fields=[{key="level" declared={type=undefined|null|int[0, 3] predicted=int[0, 3]}}]
layout L3 name="Sound" fields=[{key="verbose" declared={type=undefined|null|boolean predicted=boolean}}, {key="depth" declared={type=undefined|null|number predicted=number}}]
# CHECK: layout L0 name="Options" fields=[{key="verbose" declared={type=undefined|null|boolean|number predicted=boolean}}, {key="depth" declared={type=undefined|null|number predicted=number}}]
# CHECK: layout L1 name="Outer" fields=[{key="name" declared={type=undefined|null|string|object predicted=string}}, {key="options" declared={type=undefined|null|string|object written=undefined|null|string|L2 predicted=L2}}, {key="count" declared={type=undefined|null|number predicted=number}}]
# CHECK: layout L2 name="Inner" fields=[{key="level" declared={type=undefined|null|number predicted=int[0, 3]}}]
# CHECK: layout L3 name="Sound" fields=[{key="verbose" declared={type=undefined|null|boolean predicted=boolean}}, {key="depth" declared={type=undefined|null|number predicted=number}}]
data d0 root=Object{layout=L0 members=[{key="verbose" value=Number{value=1}}, {key="depth" value=Number{value=3}}]}
data d1 root=Object{layout=L1 members=[{key="name" value=Array{contents=anything}}, {key="options" value=String{value="none"}}, {key="count" value=Null}]}
data d2 root=Array{contents=anything elements=[Object{layout=L2 members=[{key="level" value=Number{value=2}}]}, Object{layout=L2 members=[{key="level" value=Number{value=7}}]}]}
data d3 root=Object{layout=L3 members=[{key="verbose" value=Boolean{value=true}}, {key="depth" value=Undefined}]}

function f0 name="makes" results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    v1 = Data data=d1
    v2 = Data data=d2
    v3 = Data data=d3
    Return v0
}
function f1 name="reads" parameters=[{type=undefined|null|object written=undefined|null|L0 predicted=L0 site=w0}] results=[{type=anything}] {
  b0(v0: undefined|null|object):
    v1 = PropGet v0 key="verbose"
    v2 = ClaimRead v1, v0 source=Field{key="verbose"} site=w1
    v3 = PropGet v0 key="depth"
    v4 = ClaimRead v3, v0 source=Field{key="depth"} site=w1
    v5 = Add v2, v4
    Return v5
}
# CHECK-LABEL: function f1 name="reads"
# CHECK: : undefined|null|boolean|number {{*}}= Claim v1 castType=undefined|null|boolean|number site=w1
# CHECK: : undefined|null|number {{*}}= Claim {{*}}castType=undefined|null|number site=w1
