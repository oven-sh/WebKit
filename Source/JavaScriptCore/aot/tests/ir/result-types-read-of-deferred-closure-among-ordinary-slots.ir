# A slot that defers its closure holds what a narrow reference holds besides: undefined, null and objects. A read of it gives what its field declares.
# One receiver with such a slot makes a read look for a deferred closure. The slots of its other receivers are ordinary ones, and the read gives what they hold:
# a slot with markers may hold undefined and null, whichever of the two its field declares
# FORM: Prepared
# RUN: result-types
# CHECK: v5: undefined|null|f1
# CHECK: v8: undefined|null|bigint|f1
# CHECK: v11: undefined|null|f1

module m0 path="main.ts" displayPath="main.ts"
layout L0 name="BoxOfFunction" fields=[{key="value" declared={type=undefined|null|f1} flags=[IsRequired] flow={location={initialization=SetAtCreation deferral=CapturesNothing deferredFunction=f1} occupancy=AlwaysFilled}}]
layout L1 name="BoxOfUndefined" fields=[{key="value" declared={type=undefined} flags=[IsRequired]}]
layout L2 name="BoxOfNull" fields=[{key="value" declared={type=null} flags=[IsRequired]}]
layout L3 name="BoxOfBigInt" fields=[{key="value" declared={type=bigint} flags=[IsRequired]}]
function f0 name="reads" parameters=[{type=L0}, {type=L0|L1|L2|L3}, {type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0, v1: L0|L1|L2|L3, v2: L0|L1):
    v3 = IsSlotFilled v0 key="value" receivers=[L0] level=Proven
    Branch v3 -> taken b1(| 0), notTaken b4()
  b1(v4: guard):
    v5 = GetDeferredClosureSlot v0, v4 key="value" receivers=[L0] level=Proven
    v6 = IsSlotFilled v1 key="value" receivers=[L0, L1, L2, L3] level=Proven
    Branch v6 -> taken b2(| 0), notTaken b4()
  b2(v7: guard):
    v8 = GetDeferredClosureSlot v1, v7 key="value" receivers=[L0, L1, L2, L3] level=Proven
    v9 = IsSlotFilled v2 key="value" receivers=[L0, L1] level=Proven
    Branch v9 -> taken b3(| 0), notTaken b4()
  b3(v10: guard):
    v11 = GetDeferredClosureSlot v2, v10 key="value" receivers=[L0, L1] level=Proven
    Return v11
  b4():
    Return
}
function f1 name="kept" module=m0 kind=Arrow results=[{type=undefined}] {
  b0():
    Return
}
