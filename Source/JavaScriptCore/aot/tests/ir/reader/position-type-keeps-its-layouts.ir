# A position has one type, the one the front end sent. The reader replaces each layout in it by its family and moves nothing aside:
# no position of a function, a layout, a variable, a block or a request is widened to any object, and the program is valid before the flow analysis has run
# FORM: AsRead
# RUN: print
# RUN(NONE): print
# NONE-NOT: object
# RUN(TYPED): pass TypeValues VerifyProgram

module m0 path="main.ts" displayPath="main.ts"
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Assertion
typesite w2 module=m0 position=30 kind=Result
layout L0 name="Shape" fields=[{key="area" declared={type=number}}]
layout L1 name="Circle" fields=[{key="area" declared={type=number}}, {key="inner" declared={type=undefined|null|L0}}] supertypes=[L0]
layout L2 kind=Instance name="Square" constructor=f3 fields=[{key="area" declared={type=number}}] supertypes=[L0]
layout L3 kind=Environment fields=[{declared={type=L1}}]
variable g0 name="largest" module=m0 declared={type=undefined|null|L0} initialization=Undefined
# CHECK: layout L0 name="Shape" fields=[{key="area" declared={type=number}}]
# CHECK: layout L1 name="Circle" fields=[{key="area" declared={type=number}}, {key="inner" declared={type=undefined|null|L0|L1|L2}}] supertypes=[L0]
# CHECK: layout L2 kind=Instance name="Square" constructor=f3 fields=[{key="area" declared={type=number}}] supertypes=[L0]
# CHECK: layout L3 kind=Environment fields=[{declared={type=L1}}]
# CHECK: variable g0 name="largest" module=m0 declared={type=undefined|null|L0|L1|L2} initialization=Undefined
function f0 name="pick" flags=[HasThis] captures=[{type=env L3}] thisType={type=L2} parameters=[{type=undefined|null|L0 site=w0}, {type=string|L1}] results=[{type=undefined|null|L0 site=w2}] {
  b0(v0: env L3, v1: L2, v2: undefined|null|L0, v3: string|L1):
    v4 = Convert v2 declared={type=L1 site=w1} illTypedCause=Assertion
    Return v2
}
# CHECK-LABEL: function f0 name="pick"
# CHECK: captures=[{type=env L3}] thisType={type=L2} parameters=[{type=undefined|null|L0|L1|L2 site=w0}, {type=string|L1}] results=[{type=undefined|null|L0|L1|L2 site=w2}]
# CHECK-NEXT: b0(v0: env L3, v1: L2, v2: undefined|null|L0|L1|L2, v3: string|L1):
# CHECK-NEXT: v4 = Convert v2 declared={type=L1 site=w1} illTypedCause=Assertion
# TYPED: outcome: Changed
# TYPED-NEXT: outcome: Unchanged
# TYPED-LABEL: function f0 name="pick"
# TYPED: b0(v0: env L3, v1: L2, v2: undefined|null|L0|L1|L2, v3: string|L1):
# TYPED-NEXT: v4: L1 = Check v2 castType=L1 site=w1
function f1 name="forward" parameters=[{type=anything}] results=[{type=undefined|null|L0 site=w2}] {
    v1 = Call v0
    ReturnCall v1 casts=[{declared={type=undefined|null|L0 site=w2}}]
# CHECK: ReturnCall v1 casts=[{declared={type=undefined|null|L0|L1|L2 site=w2}}]
}
function f2 name="make" results=[{type=L0}] {
    v0 = Integer integer=1
    v1 = NewObject -, v0 layout=L1 fields=[0]
    Return v1
# CHECK: results=[{type=L0|L1|L2}]
# TYPED: v1: L1 = NewObject -, v0 layout=L1 fields=[0]
# TYPED-NEXT: Return v1
}
function f3 name="Square" kind=BaseConstructor flags=[HasNewTarget] results=[{type=L2 flags=[IsFromCompiler]}]
