# The emitters of a text in a builder, by themselves. No walk runs: the Code is written out.
# The builder comes out of the pool in line. A constant, the digits of an integer and the word of a boolean are written where the text ends, with no call while there is room, and the position is stored back.
# RUN: emit-code
# CHECK: unit f1:Body
# CHECK: = Load({{*}}AOTStringBuilderStorage_fields, origin = 5)
# CHECK: = Store({{*}}AOTStringBuilderStorage_fields, origin = 5)
# CHECK: = Store8({{*}}offset = 0, stringBuilderBytes, origin = 6)
# CHECK: = Store({{*}}AOTStringBuilderStorage_fields, origin = 6)
# CHECK: = Store({{*}}stringBuilderBytes, origin = 7)
# CHECK: = Store({{*}}AOTStringBuilderStorage_fields, origin = 7)
# CHECK: = Store({{*}}stringBuilderBytes, origin = 8)
# CHECK: = Store({{*}}AOTStringBuilderStorage_fields, origin = 8)
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: i32 @Int32 = ToInt32 v0 [givesOnlyLowestBits]
#     v3: boolean @Boolean = TypeTest v1 testedType=undefined
#     v4: opaque(StringBuilder) @Cell = StringBuilderBegin
#     v5 @Void = StringBuilderAppendConstant v4 string="k"
#     v6 @Void = StringBuilderAppendInteger v4, v2
#     v7 @Void = StringBuilderAppendBoolean v4, v3
#     v8: int[0, 2147483647] @Int32 = StringBuilderLength v4
#     v9: string @Cell = StringBuilderToString v4
#     v10 @Void = StringBuilderAppendString v4, v9
#     v11 @Void = StringBuilderAppendInteger v4, v8
#     v12: string @Cell = StringBuilderFinish v4
#     Return v12
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="joins" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
