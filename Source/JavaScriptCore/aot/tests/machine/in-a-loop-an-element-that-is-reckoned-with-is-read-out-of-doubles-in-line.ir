# function total(list: unknown[]) { let sum = 0; for (let i = 0; i < list.length; i++) { const x = list[i]; if (typeof x === "number") sum += x; } return sum; }
# function handOn(list: unknown[]) { for (let i = 0; i < list.length; i++) sink(list[i]); }
# Behind the guard both parameters are lists; nothing is declared or proven of what they hold, so the read gives a box and names no storage. In line it knew boxed elements alone: a list of doubles took the stub at every turn.
# Where an operation of the read's own block reckons with the element (an operator, a relation, an unboxing, a test for a number) the read has an arm for raw doubles too, on the rare edge: the way of boxed elements keeps its branch.
# Where the turn only hands the element on there is none: those are most of the loops of an application, and the arm would be bytes for nothing.
# RUN: emit f1:Body mechanisms=all-LoopInvariants
# CHECK-LABEL: unit f1:Body
# CHECK: = Load({{*}}indexedDoubleProperties
# RUN(ON): emit f2:Body mechanisms=all-LoopInvariants
# ON-LABEL: unit f2:Body
# ON-NOT: indexedDoubleProperties
# RUN(ANSWER): run-in-shell globalThis.sink = (...given) => { if (typeof given[0] !== "function") return print(String(given[0])); const [total, handOn] = given; print(total([0.5, 1.25])); print(total([1, 2])); print(total(["a", 2.5, {}])); print(total([0.5, , 1.5])); print(total([0.5, NaN])); print(Object.is(total([-0]), 0)); handOn([0.5, -0, , 2]); };
# ANSWER: 1.75
