  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="late" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Builtin builtin=Map
    v3 = Construct v2
    v4 = Call v1, -, v3
    v5 = PropGet v3 key="set" @60
    v6 = PropGet v0 key="k" @66
    v7 = Integer integer=1
    v8 = Call v5, v3, v6, v7 calleeKey="set" @64
    v9 = NewArray v3 contents=anything
    Return v9
}
