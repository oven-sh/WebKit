# The read stands between the two, as a call of the stub or of a thunk that names it.
# RUN(READ): bytes f1:Body mechanisms=all
# READ: GetById
# RUN(WITHHELD): bytes f1:Body mechanisms=all-BuiltinCalls
# WITHHELD-NOT: TryCallMethodOfBuiltinClass
# RUN(ANSWERS): run-in-shell globalThis.sink = found => { print(found(1, map => { map.set(1, "a"); })); print(found(1, map => { map.get = () => "own"; })); print(found(1, map => { Object.setPrototypeOf(map, { get() { return "moved"; } }); })); print(found(2, map => { map.extra = 1; map.set(2, "b"); })); print(found(3, map => { })); try { found(1, map => { map.get = 5; }); } catch (error) { print(error instanceof TypeError); } };
