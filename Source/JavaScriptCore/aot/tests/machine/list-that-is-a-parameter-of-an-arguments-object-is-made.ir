# No walk runs: the Code is written out. A list that is one of the ARGUMENTS is kept by the arguments object: it is made. The list behind the parameters, which nothing else names, is not: the row holds the parameter and that list's one element.
# RUN: emit-code mechanisms=all
# CHECK: unit f1:Body
# CHECK: = Store({{*}}offset = 0, argumentBuffer
# CHECK: = Store({{*}}offset = 8, argumentBuffer
# CHECK-NOT: offset = 16, argumentBuffer
# -- code
# code f1:Body {
#   v1: 2 @Int32 = Integer integer=2
#   b0(v0: anything @JSValue) entry=0:
#     v2: Array @Cell = NewArray v0, v0, v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     v3: Array @JSValue = Box v2
#     v4: Array @Cell = NewArray v0 contents=anything traits=[mayCollect, mayTouchMemory]
#     v5: Arguments @Cell = CreateUnmappedArguments v1, v4, v3 traits=[mayCollect, mayTouchMemory]
#     v6: Arguments @JSValue = Box v5
#     Return v6
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="kept" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
