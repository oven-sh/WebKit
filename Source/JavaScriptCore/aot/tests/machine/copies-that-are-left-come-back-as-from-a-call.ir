# The emitter of a LeaveCopies, by itself. No walk runs: the Code is written out.
# The fast frame stays and the slow body of the outermost copy returns to here: the Patch takes each value where it lies, as a Leave does, but it has a result, clobbers what a call clobbers, and its block goes on.
# RUN: emit-code
# CHECK: unit f1:Body
# CHECK: Int64 {{*}} = Patch({{*}}:ColdAny, {{*}}:ColdAny, resultConstraints = [Register({{*}}lateClobbered = [{{*}}NeedsFrameRecord
# CHECK-NEXT: = Return(
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: i32 @Int32 = ToInt32 v1 [givesOnlyLowestBits]
#     v3: boolean @Boolean = TypeTest v0 testedType=object
#     Branch v3 -> taken b1(), notTaken b2()
#   b1():
#     Return v0
#   b2() frequency=Rare:
#     v4: anything?UndescribedNativeResult @JSValue = LeaveCopies v0, v2 function=f1 role=SlowBody frames=[1, 4, 65536, 2, 4, 0, 2147483648, 2] traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteWhatIsSeen, mayTouchMemory, mayWriteOutsideObjects]
#     Return v4
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="sum" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="x"
    v3 = Add v2, v1
    Return v3
}
