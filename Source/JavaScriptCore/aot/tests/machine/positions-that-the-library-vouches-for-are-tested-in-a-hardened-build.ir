# What `bun build --aot-harden=ignore-told-ranges` asks for. The library's own reads and stores of elements test nothing by themselves: its code says that the position lies below the length.
# Here each of the eight holds its position against the length that the list has there, and the kind of storage that its name says against the byte of the list, and the process stops where either is false.
# Two of the reads hold what they have read as well: a boxed word is not the empty word, and a whole number lies in the box of an int32: a list made of a length and filled to a count holds the empty word inside its length.
# OPTIONS: testing=CheckBoundsAtRunTime
# RUN: emit f1 mechanisms=all
# CHECK: JSArray_indexingTypeAndMisc
# CHECK: Butterfly_publicLength
# CHECK: = Below(
# RUN(STOPS): emit f1 mechanisms=all
# STOPS-COUNT-21: effects = Terminal|ControlDependent
# STOPS-NOT: effects = Terminal|ControlDependent

module m0 path="main.mjs" displayPath="main.mjs" body=f0
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="each"
    v3 = Undefined
    Return v3
}
function f1 name="each" module=m1 kind=Method role=Library flags=[HasThis, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Convert v0 declared={type=Array flags=[IsFromCompiler, IsClaim]}
    v4 = Convert v1 declared={type=int flags=[IsFromCompiler, IsClaim]}
    v5 = GetOwnContiguousIndex v3, v4
    v6 = GetOwnDoubleIndex v3, v4
    v7 = GetOwnInt32Index v3, v4
    PutOwnContiguousIndex v3, v4, v2
    PutOwnDoubleIndex v3, v4, v6
    PutOwnInt32Index v3, v4, v7
    PutContiguousIndex v3, v4, v5
    PutDoubleIndex v3, v4, v6
    Return v5
}
