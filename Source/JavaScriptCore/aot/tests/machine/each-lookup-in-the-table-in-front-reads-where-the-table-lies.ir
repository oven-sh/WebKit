# The table in front, where lookups by name are filed, grows by moving, and the pages that it leaves are unmapped. Whoever has read where it lies may go by that up to the next call that can file, and no further.
# Two lookups of an accessor stand in one block. Between them stands a stub that declares no write, and that fills the answers of its place behind a miss.
# Each lookup ends what was read of the table before it, by a patch that makes no code, and reads for itself where the table lies: the one load of 64 bits under that heap.
# RUN: emit-code
# CHECK: unit f1:Body
# CHECK: = Patch({{*}}Writes:{AOTPropertyCaches_front}{{*}}OnlyKeepsChildrenAlive
# CHECK: Int64 {{*}}= Load({{*}}AOTPropertyCaches_front, origin = 2)
# CHECK: = Patch({{*}}Writes:{AOTPropertyCaches_front}{{*}}OnlyKeepsChildrenAlive
# CHECK: Int64 {{*}}= Load({{*}}AOTPropertyCaches_front, origin = 4)
# RUN(TWICE): emit-code
# TWICE-COUNT-2: Int64 {{*}}= Load({{*}}AOTPropertyCaches_front
# TWICE-NOT: Int64 {{*}}= Load({{*}}AOTPropertyCaches_front
# -- code
# code f1:Body {
#   b0(v0: object @Cell) entry=0:
#     v1: f2 @Cell = GetAccessorOfMember v0 key="first" valueType=f2
#     v2: anything @JSValue = GetCachedGetter v0 key="between"
#     v3: f2 @Cell = GetAccessorOfMember v0 key="second" valueType=f2
#     v4: f2 @JSValue = Box v1
#     v5: f2 @JSValue = Box v3
#     v6: boolean @Boolean = StrictEq v4, v5 form=Bits
#     Branch v6 -> taken b1(), notTaken b2()
#   b1():
#     Return v2
#   b2():
#     Return v4
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return
}
function f1 name="looksUpTwice" parameters=[{type=object}] results=[{type=anything}] {
    v1 = PropGet v0 key="first"
    v2 = PropGet v0 key="between"
    v3 = PropGet v0 key="second"
    Return v0
}
function f2 name="accessor" kind=Getter results=[{type=anything}] {
    Return
}
