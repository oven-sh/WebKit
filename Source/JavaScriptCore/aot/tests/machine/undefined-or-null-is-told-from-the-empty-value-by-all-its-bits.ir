# The emitter of a test of a boxed value, by itself. No walk runs: the Code is written out.
# What may come is anything or the empty value; what passes is undefined or null. No look of its own is spent on the empty value, so the one question must refuse it: the two values are told by all their bits. "No bit outside those of undefined is set" holds of the empty value too and may not be asked here.
# RUN: emit-code
# CHECK-LABEL: unit f1:Body
# CHECK: = Branch(
# CHECK-NOT: = Branch(
# CHECK-NOT: = Const64(-11)
# CHECK: = Const64(-9)
# CHECK: = Const64(2)
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1 @Void = CheckProof v0 checkedType=undefined|null typeWithoutProof=absent|anything source=Contents
#     Return v0
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="asks" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
