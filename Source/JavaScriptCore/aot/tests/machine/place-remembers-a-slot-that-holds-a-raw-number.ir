    v8 = NewObject layout=L0
    PropDefine v8, v6 key="part"
    PropDefine v8, v7 key="whole"
    v11 = FinishObject v8
    v12 = Integer
    Jump -> next b1(v12)
  b1(v13):
    LoopHint
    v15 = Integer integer=400
