    v22 = Call v5, -, v20, v21
    v23 = Double number=-0
    v24 = Integer integer=-2147483648
    PropSet v11, v23 key="part"
    PropSet v11, v24 key="whole"
    v27 = Call v2, -, v11
    v28 = Call v3, -, v11
    v29 = Call v5, -, v27, v28
    v30 = Double number=NaN
    v31 = Integer integer=5000000000
    PropSet v11, v30 key="part"
    PropSet v11, v31 key="whole"
    v34 = Call v2, -, v11
    v35 = Call v3, -, v11
    v36 = Call v5, -, v34, v35
    v37 = Integer integer=3
    PropSet v11, v37 key="part"
    PropSet v11, v37 key="whole"
    v40 = Call v2, -, v11
    v41 = Call v3, -, v11
    v42 = Call v5, -, v40, v41
    v43 = PropDelete v11 key="part"
    v44 = Call v2, -, v11
