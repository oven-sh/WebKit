# function readPart(o) { return o.part; }  function readWhole(o) { return o.whole; }   publish(readPart, readWhole);   const point = { part: 1.5, whole: 7 };   for (..) readPart(point) ..
# Every writer of the two fields is in sight and stores numbers, so their slots hold raw numbers. The two readers are handed out, so nothing is known of what they are handed: they read by name, at a place.
# The place remembers the shape and that the slot holds a raw number, and the stub boxes what it finds. A mark in the slot is no number.
# A read at a place calls one stub whatever the slots of the program hold: what the place remembers says the form.
# RUN(PLAN): plan layouts mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# PLAN: layout L0 CompiledObject
# PLAN-NEXT: slot 0 "part" OptionalDouble Inline
# PLAN-NEXT: slot 1 "whole" OptionalInt64 Inline
# RUN(CODE): bytes f1:Body f2:Body mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# CODE: Call Stub ReadAtSite.OfAnyValue
# CODE: Call Stub ReadAtSite.OfAnyValue
# RUN: run-in-shell globalThis.publish = () => { }; globalThis.show = (a, b) => print(Object.is(a, -0) ? "-0" : a, b); mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# CHECK: 1.5 7
# CHECK-NEXT: -0 -2147483648
# CHECK-NEXT: NaN 5000000000
# CHECK-NEXT: 3 3
# CHECK-NEXT: undefined 3
# CHECK-NEXT: exited with 0

layout L0 module=m0 fields=[{key="part" declared={type=anything} flags=[IsRequired]}, {key="whole" declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
