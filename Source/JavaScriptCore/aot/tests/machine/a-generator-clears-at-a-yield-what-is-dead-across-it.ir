# function* steps(tag) { let thing = { tag }; yield 0; const read = thing.tag; yield read; yield tag; return tag; }   globalThis.made = steps;
# `thing` lives across the first yield of the text and is dead across the second. It has a word in the frame in the heap, stored where it is made;
# at the second yield that word is cleared, so that a generator that waits there holds the object no longer. At the third nothing is left to clear:
# a body of many yields and many short lives has a store for each life, not for each life at each yield.
# RUN: emit f1:CoroutineBody mechanisms=all
# CHECK-LABEL: unit f1:CoroutineBody
# CHECK-COUNT-2: Store({{*}}offset = 88, InternalFields
# CHECK-NOT: Store({{*}}offset = 88, InternalFields

layout L0 module=m0 fields=[{key="tag" declared={type=anything} flags=[IsRequired]}]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="made"
    v3 = Undefined
    Return v3
}
function f1 name="steps" module=m0 flags=[IsGenerator, HasThis, TakesCallee, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned] {
  b0(v0: anything, v1: function, v2: anything):
    InitialYield v2, v0
    v4 = NewObject -, v2 layout=L0 fields=[0]
    v5 = FinishObject v4
    v6 = Integer integer=0
    v7 = Yield v6, v2, v0
    v8 = ResultAt v7
    v9 = ResultAt v7 index=1
    Switch v9 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    Throw v8
  b2():
    Return v8
  b3():
    v10 = PropGet v5 key="tag"
    v11 = Yield v10, v2, v0
    v12 = ResultAt v11
    v13 = ResultAt v11 index=1
    Switch v13 cases=[1, 2] -> case b4(), case b5(), otherwise b6()
  b4():
    Throw v12
  b5():
    Return v12
  b6():
    v14 = Yield v2, v2, v0
    v15 = ResultAt v14
    v16 = ResultAt v14 index=1
    Switch v16 cases=[1, 2] -> case b7(), case b8(), otherwise b9()
  b7():
    Throw v15
  b8():
    Return v15
  b9():
    Return v2
}
