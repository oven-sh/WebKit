# Among raw doubles a NaN is a hole. A typed store lays what it is handed and asks nothing of it: whoever proved that the number is no NaN vouches for that.
# Under the word that checks proofs at run time the store holds the number against itself, and the process stops where it is a NaN. Five of the stops here are those of the three claims, of the
# kind of storage and of the position; the sixth is this one. A hardened build asks for kinds and positions alone: positions-that-the-library-vouches-for-are-tested-in-a-hardened-build.ir counts those.
# THE RED CONTROL: the call taken out of ArrayIntrinsicEmitter::putInBounds(): five stops.
# RUN: emit f1 mechanisms=all testing=CheckProofsAtRunTime
# CHECK: effects = Terminal|ControlDependent
# CHECK: effects = Terminal|ControlDependent
# CHECK: effects = Terminal|ControlDependent
# CHECK: effects = Terminal|ControlDependent
# CHECK: effects = Terminal|ControlDependent
# CHECK: effects = Terminal|ControlDependent
# CHECK-NOT: effects = Terminal|ControlDependent


module m0 path="main.mjs" displayPath="main.mjs" body=f0
module m1 path="/$bun/js/engine/ArrayPrototype.ts" displayPath="/$bun/js/engine/ArrayPrototype.ts" flags=[IsLibrary]
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="lay"
    v3 = Undefined
    Return v3
}
function f1 name="lay" module=m1 kind=Method role=Library flags=[HasThis, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Convert v0 declared={type=Array flags=[IsFromCompiler, IsClaim]}
    v4 = Convert v1 declared={type=int flags=[IsFromCompiler, IsClaim]}
    v5 = Convert v2 declared={type=number flags=[IsFromCompiler, IsClaim]}
    PutDoubleIndex v3, v4, v5
    Return v5
}
