# A receiver whose type holds absent may be the empty value, which has no bit that is not a cell's: the store in line asks for that before it reads the structure.
# RUN: emit f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK-NOT: = Load({{*}}JSCell_structureID
# CHECK: = NotEqual(
# CHECK: = Load({{*}}RegExpState

module m0 path="last-index-stores-ask-for-cells.ts" displayPath="last-index-stores-ask-for-cells.ts" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1 @0
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} @0
    v2 = NewRegExp pattern="a" regExpFlags=[Global] @156
    v3 = Integer integer=3 @162
    v4 = Call v1, -, v2, v3 calleeName="reset" @150
    v5 = Builtin builtin=GlobalThis @166
    v6 = PropGet v5 key="say" [isFreeName] @166
    v7 = Call v6, -, v1 calleeName="say" @166
    v8 = Undefined @166
    Return v8 @166
}
function f1 name="reset" module=m0 position=45 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything|absent}, {type=number}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything|absent, v1: number):
    v2 = Integer @105
    v3 = Convert v2 declared={type=number} @105
    Jump -> next b1(v3) @101
  b1(v4: number):
    LoopHint @101
    v6 = Less v4, v1 @108
    Branch v6 -> taken b2(), notTaken b3() @108
  b2():
    PropSet v0, v4 key="lastIndex" @124
    v8 = Increment v4 @119
    v9 = Convert v8 declared={type=number} @119
    Jump -> next b1(v9) @119
  b3():
    v10 = Undefined @119
    Return v10 @119
}
