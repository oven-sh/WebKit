# class Square { area(k) { return 4; } }  class Disk extends Square { area(k) { return 3; } }  function areaOf(shape) { return shape.area(1); }  areaOf(new Square());  areaOf(new Disk());
# The receiver is proven to be of one of two layouts, which find different methods under the name: no single callee. The read and the call behind it are one call through the method table:
# the shape word of the receiver picks the word of the selector, and that word is where the code of the entry lies. No stub, no name, no test.
# RUN: bytes f5:Body mechanisms=-Inlining
# CHECK-LABEL: unit f5:Body
# CHECK-NOT: CallMethod
# CHECK: InstanceWord MethodSelector
# CHECK-NOT: CallMethod
# RUN(WITHHELD): bytes f5:Body mechanisms=none
# WITHHELD-LABEL: unit f5:Body
# WITHHELD-NOT: MethodSelector
# WITHHELD: argument thunk 0 CallMethodById

layout L0 kind=Instance name="Square" module=m0 constructor=f1
layout L1 kind=Instance name="Disk" module=m0 base=L0 constructor=f3 supertypes=[L0] flags=[HasHeritage]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClass v0 layout=L0
    v2 = NewClosure function=f2
    DefineMethod v1, v2 layout=L0 key="area"
    v4 = FinishClass v1 layout=L0
    v5 = ResolveHeritage v4
    v6 = NewClosure function=f3
    v7 = NewClass v6, v4, v5 layout=L1
    v8 = NewClosure function=f4
    DefineMethod v7, v8 layout=L1 key="area"
    v10 = FinishClass v7 layout=L1
    v11 = NewClosure function=f5
    v12 = Construct v4
    v13 = Call v11, -, v12 calleeName="areaOf"
    v14 = Construct v10
    v15 = Call v11, -, v14 calleeName="areaOf"
    v16 = Undefined
    Return v16
}
function f1 name="Square" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything):
    v1 = GetConstructPrototype v0 layout=L0
    v2 = NewObject v1 layout=L0
    Return v2
}
function f2 name="area" module=m0 kind=Method flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=4
    Return v2
}
function f3 name="Disk" module=m0 kind=DerivedConstructor flags=[HasNewTarget, TakesCallee, HasExplicitName] thisType={type=anything} results=[{type=object flags=[IsFromCompiler]}] constructedClass=L1 {
  b0(v0: function, v1: anything):
    v2 = GetSuperBase v0
    v3 = SuperConstruct v2, v1 layout=L1
    Return v3
}
function f4 name="area" module=m0 kind=Method flags=[HasThis, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=3
    Return v2
}
function f5 name="areaOf" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = PropGet v0 key="area"
    v3 = Call v2, v0, v1 calleeKey="area"
    Return v3
}
