# async function load(x) { await x; return x; }  sink(load);
# The ramp sets up no frame: the stub makes the promise in the register of the last argument of the body.
# RUN: bytes f1:Body
# REQUIRES: x86_64
# CHECK-LABEL: unit f1:Body
# CHECK-NOT: Call Function
# CHECK: Call Stub NewPromiseBeforeBody.SecondArgument
# CHECK: Jump

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return v3
}
function f1 name="load" module=m0 flags=[IsAsync] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Await v0
    Return v0
}
