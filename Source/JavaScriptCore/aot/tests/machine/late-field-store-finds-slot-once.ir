# class P { constructor(x) { this.x = x; } }  function fill(p) { p.a = 1; .. p.i = 1; }  function store(p, n) { for (let i = 0; i < n; i++) p.j = i * 0.5; return n; }
# Where a late field lies in its extension is asked of the extension's bits: once to see that there is room, once to see that the field is there and once to store, before the place was found once for all three. Where there is no room or no field the stub does what is left.
# RUN: emit f2:Body mechanisms=all
# CHECK-LABEL: unit f2:Body
# CHECK-COUNT-1: = PopCount
# CHECK-NOT: = PopCount
# RUN(SHELL): run-in-shell globalThis.sink = (...all) => { print(all.join(" ")); };
# SHELL: 1.5 4
# SHELL: exited with 0

layout L0 kind=Instance name="P" module=m0 constructor=f3 fields=[{key="x" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f3
    v5 = NewClass v4 layout=L0
    v6 = FinishClass v5 layout=L0
    v7 = Integer integer=1
    v8 = Construct v6, -, v7 calleeName="P"
    v9 = Call v1, -, v8 calleeName="fill"
    v10 = Integer integer=4
    v11 = Call v3, -, v8, v10 calleeName="store"
    v12 = PropGet v8 key="j"
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="sink" [isFreeName]
    v15 = Call v14, -, v12, v11 calleeName="sink"
    v16 = Undefined
    Return v16
}
function f1 name="fill" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=1
    PropSet v0, v1 key="a"
    PropSet v0, v1 key="b"
    PropSet v0, v1 key="c"
    PropSet v0, v1 key="d"
    PropSet v0, v1 key="e"
    PropSet v0, v1 key="f"
    PropSet v0, v1 key="g"
    PropSet v0, v1 key="h"
    PropSet v0, v1 key="i"
    v11 = Undefined
    Return v11
}
function f2 name="store" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer
    v3 = Convert v2 declared={type=number}
    Jump -> next b1(v3)
  b1(v4):
    LoopHint
    v6 = Less v4, v1
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = Double number=0.5
    v8 = Mul v4, v7
    PropSet v0, v8 key="j"
    v10 = Increment v4
    v11 = Convert v10 declared={type=number}
    Jump -> next b1(v11)
  b3():
    Return v1
}
function f3 name="P" module=m0 kind=BaseConstructor flags=[HasNewTarget, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=object flags=[IsFromCompiler]}] constructedClass=L0 {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    PropSet v3, v1 key="x"
    Return v3
}
