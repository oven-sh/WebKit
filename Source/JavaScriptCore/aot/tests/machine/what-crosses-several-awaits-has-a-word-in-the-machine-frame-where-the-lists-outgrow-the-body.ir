# async function sums(seed) { const a0 = await seed; .. const a11 = await seed; return [a0, .., a11]; }   async function small(seed, other) { const a = await seed; const b = await seed; return [a, b, other]; }
# A suspension names all that is alive across it. Where these lists together are longer than the body itself, what crosses several suspensions has a word in a slot of the machine frame:
# it is stored where it is defined and read once in each stretch that names it, and no suspension names it: the frame is saved with the slot in it. What crosses one suspension alone is
# named by that one, beside the promise. A body that is longer than its lists stays as it was, though `other` crosses both its awaits.
# RUN: emit f1:CoroutineBody mechanisms=all
# CHECK-LABEL: unit f1:CoroutineBody
# CHECK-NOT: LateColdAny, @{{*}}:LateColdAny, @
# CHECK: SlotBase
# RUN(SMALL): emit f2:CoroutineBody mechanisms=all
# SMALL-LABEL: unit f2:CoroutineBody
# SMALL-NOT: SlotBase
# SMALL: LateColdAny, @{{*}}:LateColdAny, @
# SMALL-NOT: SlotBase

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="globalThis" [isFreeName]
    v6 = Convert v5 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    PropSet v6, v1 key="made"
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="globalThis" [isFreeName]
    v10 = Convert v9 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    PropSet v10, v3 key="madeToo"
    v12 = Undefined
    Return v12
}
function f1 name="sums" module=m0 flags=[IsAsync, HasThis, HasExplicitName] length=1 syntax=[HasLiveAwait] thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    v2 = Await v1, v1, v0
    v3 = Await v1, v1, v0
    v4 = Await v1, v1, v0
    v5 = Await v1, v1, v0
    v6 = Await v1, v1, v0
    v7 = Await v1, v1, v0
    v8 = Await v1, v1, v0
    v9 = Await v1, v1, v0
    v10 = Await v1, v1, v0
    v11 = Await v1, v1, v0
    v12 = Await v1, v1, v0
    v13 = Await v1, v1, v0
    v14 = NewArray v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13 contents=anything
    Return v14
}
function f2 name="small" module=m0 flags=[IsAsync, HasThis, HasExplicitName] length=2 syntax=[HasLiveAwait] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = Await v1, v1, v2, v0
    v4 = Await v1, v1, v2, v0
    v5 = NewArray v3, v4, v2 contents=anything
    Return v5
}
