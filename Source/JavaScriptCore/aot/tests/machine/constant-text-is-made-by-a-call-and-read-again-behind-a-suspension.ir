# outside of loops the cell of a text is asked of the stub, which reads its word and fills it where it is empty. The site names the text and nothing else
# the cell is a root for good, so behind a suspension the answer of the call in front of it is found again
# in a loop the cell is read from its word, and made on a rare arm where the word is empty: one call of the stub that fills the word. The call says that it writes the heap of the word, and nothing in the unit stores there
# there the word is read again behind a suspension: kept, the cell would lie in the saved frame
# The texts here are those that an operation takes for itself: the conversion of a boolean asks for "true" and for "false" each time.
# function tell(print, a, b) { print(String(a === b)); return print(String(b === print)); }   async function tellAndWait(print, awaited) { print(String(print === awaited)); return print(String(await awaited === awaited)); }   each is called twice
# async function tellInTurns(print, awaited, times) { let i = 0; for (; i < times; i++) { print(String(print === awaited)); print(String(await awaited === awaited)); } return i; }
# RUN(CODE): walk f1:Body
# CODE-LABEL: code f1:Body
# CODE-COUNT-2: = ToString
# RUN(STORES): emit f1:Body f3:CoroutineBody
# STORES-LABEL: unit f1:Body
# STORES-NOT: AOTInstance_stringCells
# STORES-LABEL: unit f3:CoroutineBody
# STORES-NOT: = Store({{*}}AOTInstance_stringCells
# RUN(CALLS): bytes f1:Body f2:CoroutineBody
# CALLS-LABEL: unit f1:Body
# CALLS-NOT: InstanceWord StringCell
# CALLS-COUNT-2: Call Stub CreateConstant.String
# CALLS-NOT: InstanceWord StringCell
# CALLS-LABEL: unit f2:CoroutineBody
# CALLS-NOT: InstanceWord StringCell
# CALLS-COUNT-2: Call Stub CreateConstant.String
# CALLS: Call Stub AwaitBySavingFrame
# CALLS-NOT: CreateConstant
# CALLS-NOT: InstanceWord StringCell
# RUN(AWAIT): emit f3:CoroutineBody
# AWAIT-LABEL: unit f3:CoroutineBody
# AWAIT: IsSuspension
# AWAIT: = Load({{*}}AOTInstance_stringCells

module m0 path="main.js" displayPath="main.js" body=f0
