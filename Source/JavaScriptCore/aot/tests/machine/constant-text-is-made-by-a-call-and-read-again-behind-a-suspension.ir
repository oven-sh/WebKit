    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="print" [isFreeName]
    v4 = Integer integer=1
    v5 = Integer integer=2
    v6 = Call v0, -, v3, v4, v5
    v7 = Call v0, -, v3, v5, v5
    v8 = Call v1, -, v3, v4
    v9 = Call v1, -, v3, v5
    v10 = NewClosure function=f3
    v11 = Call v10, -, v3, v4, v5
    Return v11
}
