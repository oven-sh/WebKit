# const a = { part: 1.5, whole: 7, first: 7 }, b = { whole: "w", part: 2.5, second: 2.5 }, c = { part: "p", whole: "x", more: 1 };   const o = which ? a : b;   show(o.part, o.whole);
# The two reads run once, so they have no place. Three layouts have both names, and none is written as a kind of another. Two of them hold `part` as a raw number: the read under it calls the stub that asks the table of fields first.
# Two hold `whole` as any value: the read under it asks as every read by name does.
# RUN(PLAN): plan layouts mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# PLAN: layout L0 CompiledObject
# PLAN-NEXT: slot 0 "part" OptionalDouble Inline
# PLAN-NEXT: slot 1 "whole" OptionalInt64 Inline
# PLAN: layout L1 CompiledObject
# PLAN-NEXT: slot 0 "whole" JSValue Inline
# PLAN-NEXT: slot 1 "part" OptionalDouble Inline
# PLAN: layout L2 CompiledObject
# PLAN-NEXT: slot 0 "part" Cell32 Inline
# PLAN-NEXT: slot 1 "whole" Cell32 Inline
# RUN(CODE): bytes f0:Body mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# CODE: GetByIdAskingFieldTableFirst immediate mention
# CODE: GetById immediate mention
# RUN(FIRST): run-in-shell globalThis.which = true; globalThis.show = (a, b) => print(a, b); mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# FIRST: 1.5 7
# FIRST-NEXT: p x
# FIRST-NEXT: exited with 0
# RUN(SECOND): run-in-shell globalThis.which = false; globalThis.show = (a, b) => print(a, b); mechanisms=none+TypedOperations+UnboxedNumbers+TypedSlots
# SECOND: 2.5 w
# SECOND-NEXT: p x
# SECOND-NEXT: exited with 0

layout L0 module=m0 fields=[{key="part" declared={type=anything} flags=[IsRequired]}, {key="whole" declared={type=anything} flags=[IsRequired]}, {key="first" declared={type=anything} flags=[IsRequired]}] ownFieldCount=3
layout L1 module=m0 fields=[{key="whole" declared={type=anything} flags=[IsRequired]}, {key="part" declared={type=anything} flags=[IsRequired]}, {key="second" declared={type=anything} flags=[IsRequired]}] ownFieldCount=3
layout L2 module=m0 fields=[{key="part" declared={type=anything} flags=[IsRequired]}, {key="whole" declared={type=anything} flags=[IsRequired]}, {key="more" declared={type=anything} flags=[IsRequired]}] ownFieldCount=3
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="show" [isFreeName]
    v2 = Double number=1.5
    v3 = Integer integer=7
    v4 = NewObject layout=L0
    PropDefine v4, v2 key="part"
    PropDefine v4, v3 key="whole"
    PropDefine v4, v3 key="first"
    v8 = FinishObject v4
    v9 = String string="w"
    v10 = Double number=2.5
    v11 = NewObject layout=L1
    PropDefine v11, v9 key="whole"
    PropDefine v11, v10 key="part"
    PropDefine v11, v10 key="second"
    v15 = FinishObject v11
    v16 = String string="p"
    v17 = String string="x"
    v18 = Integer integer=1
    v19 = NewObject layout=L2
    PropDefine v19, v16 key="part"
    PropDefine v19, v17 key="whole"
    PropDefine v19, v18 key="more"
    v23 = FinishObject v19
    v24 = PropGet v0 key="which" [isFreeName]
    Branch v24 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v8, v23)
  b2():
    Jump -> next b3(v15, v23)
  b3(v25, v26):
    v27 = PropGet v25 key="part" @10
    v28 = PropGet v25 key="whole" @20
    v29 = Call v1, -, v27, v28
    Branch v24 -> taken b4(), notTaken b5()
  b4():
    Jump -> next b6(v26, v8)
  b5():
    Jump -> next b6(v26, v15)
  b6(v30, v31):
    v32 = PropGet v30 key="part" @30
    v33 = PropGet v30 key="whole" @40
    v34 = Call v1, -, v32, v33
    Return v34
}
