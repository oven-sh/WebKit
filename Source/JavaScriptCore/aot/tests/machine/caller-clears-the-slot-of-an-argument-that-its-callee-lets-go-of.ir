# function drain(big, more) { use(big); big = null; use(more); }        function keeps(big, more) { use(big); use(more); }
# each caller makes an object, which waits in a slot of the frame while other() runs, and hands it over as its last reader. The store in drain reaches no word of the caller's frame,
# so whoever calls drain clears the slot in front of the call. The caller of keeps pays nothing
# f1 = drain, f2 = keeps, f3 = use, f4 = other, f5 = make, f6 = callsDrain, f7 = callsKeeps
# REQUIRES: x86_64 unsanitized-code
# RUN: allocate f6:Body mechanisms=none+DirectCalls
# CHECK-LABEL: unit f6:Body
# CHECK: reload s0 ->
# CHECK-NEXT: clearSpill s0
# RUN(KEEPS): allocate f7:Body mechanisms=none+DirectCalls
# KEEPS-LABEL: unit f7:Body
# KEEPS: reload s0 ->
# KEEPS-NOT: clearSpill

variable g0 name="drain" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="keeps" module=m0 declared={type=f2 flags=[IsFromCompiler]} initialization=Function function=f2 flags=[IsImmutable]
variable g2 name="use" module=m0 declared={type=f3 flags=[IsFromCompiler]} initialization=Function function=f3 flags=[IsImmutable]
variable g3 name="other" module=m0 declared={type=f4 flags=[IsFromCompiler]} initialization=Function function=f4 flags=[IsImmutable]
variable g4 name="make" module=m0 declared={type=f5 flags=[IsFromCompiler]} initialization=Function function=f5 flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f6
    v3 = NewClosure function=f7
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="drain" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g2
    v3 = Call v2, -, v0 calleeName="use"
    ReleaseHint v0
    v5 = Call v2, -, v1 calleeName="use"
    Return v5
}
function f2 name="keeps" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetModuleVariable variable=g2
    v3 = Call v2, -, v0 calleeName="use"
    v4 = Call v2, -, v1 calleeName="use"
    Return v4
}
function f3 name="use" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key="a"
    Return v1
}
function f4 name="other" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="count" [isFreeName]
    Return v1
}
function f5 name="make" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="made" [isFreeName]
    Return v1
}
function f6 name="callsDrain" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g4
    v1 = Call v0, - calleeName="make"
    v2 = GetModuleVariable variable=g3
    v3 = Call v2, - calleeName="other"
    v4 = GetModuleVariable variable=g0
    v5 = Call v4, -, v1, v3 calleeName="drain"
    v6 = Call v2, - calleeName="other"
    Return v6
}
function f7 name="callsKeeps" module=m0 thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g4
    v1 = Call v0, - calleeName="make"
    v2 = GetModuleVariable variable=g3
    v3 = Call v2, - calleeName="other"
    v4 = GetModuleVariable variable=g1
    v5 = Call v4, -, v1, v3 calleeName="keeps"
    v6 = Call v2, - calleeName="other"
    Return v6
}
