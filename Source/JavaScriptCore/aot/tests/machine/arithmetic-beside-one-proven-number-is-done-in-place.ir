# CHECK: = AboveEqual(
# CHECK-NEXT: = Branch({{*}}, unlikely #
# CHECK: = IToD(
# CHECK-NEXT: = Mul(
# RUN(BYTES): bytes f1:Body f2:Body mechanisms=none+TypedOperations+UnboxedNumbers
# BYTES-LABEL: unit f1:Body
# BYTES: BinaryWithDouble.SubWithNumberOnRight
# BYTES-LABEL: unit f2:Body
# BYTES: BinaryWithDouble.Mul

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
