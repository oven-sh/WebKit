# function drain(big, more) { use(big); big = null; use(more); return true; }        function keeps(big, more) { use(big); use(more); return false; }
# const table = [drain, keeps];
# function leaves(i) { return table[i](make(), other()); }        function goesOn(i) { const answer = table[i](make(), other()); other(); return answer; }
# leaves answers a raw boolean and its callee a boxed value, so the call that is written in tail position comes back. Without the compiler no frame of leaves is left while the callee runs,
# and nobody can ask a callee out of a list whether it lets go of its parameter: the object that waited in a slot while other() ran is cleared out of the slot in front of the call.
# The call in goesOn is not written in tail position and pays nothing.
# function twice(i) { const big = make(); return table[i](big, big, other()); }        function alsoThis(i) { const big = make(); return table[i].call(big, big, other()); }
# In twice every register that takes the object is filled in front of the one clear. In alsoThis the object waits in a saved register: that register is released, and none that the call takes
# function numbers(i) { return table[i](other(), other()); }        function native() { return Object.is(make(), other()); }
# A number is nothing that the collector takes for a pointer, and native code sets no parameter to null: neither call pays
# f1 = drain, f2 = keeps, f3 = use, f4 = other, f5 = make, f6 = leaves, f7 = goesOn, f8 = twice, f9 = alsoThis, f10 = numbers, f11 = native
