# function isMap(x) { return x instanceof Map; }
# Outside loops the cell of a built-in is given by a stub, and the walk up to it is a stub. Where the prototype object is read for the walk alone the read is left to the walk: one stub takes the number of the cell. What is no cell is answered in line, in front of both.
# LIBRARY: own
# RUN: bytes f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: InstanceOf.PrototypeThatIsBuiltin
# RUN(ONE): bytes f1:Body mechanisms=all
# ONE-NOT: Stub BuiltinCell
# RUN(SHELL): run-in-shell globalThis.publish = isMap => { class Below extends Map {} const say = (...all) => print(all.map(isMap).join()); for (let i = 0; i < 3; i++) say(new Map(), {}, 7, undefined, null, "text", Object.create(Map.prototype), new Below(), new Set(), new Proxy({}, { getPrototypeOf() { return Map.prototype; } }), Map.prototype, Object.create(null)); };
# SHELL: true,false,false,false,false,false,true,true,false,true,false,false
# SHELL-NEXT: true,false,false,false,false,false,true,true,false,true,false,false
# SHELL-NEXT: true,false,false,false,false,false,true,true,false,true,false,false

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="isMap" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=Map
    v2 = InstanceOf v0, v1 @11
    Return v2
}
