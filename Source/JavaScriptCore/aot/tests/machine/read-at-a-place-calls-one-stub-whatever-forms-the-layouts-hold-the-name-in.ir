    v9 = PropGet v0 key="show" [isFreeName]
    v10 = Double number=1.5
    v11 = Integer integer=7
    v12 = NewObject layout=L0
    PropDefine v12, v10 key="part"
    PropDefine v12, v11 key="whole"
    PropDefine v12, v11 key="first"
    v16 = FinishObject v12
    v17 = String string="w"
    v18 = Double number=2.5
    v19 = NewObject layout=L1
    PropDefine v19, v17 key="whole"
    PropDefine v19, v18 key="part"
    PropDefine v19, v18 key="second"
    v23 = FinishObject v19
    v24 = String string="p"
    v25 = String string="x"
    v26 = Integer integer=1
    v27 = NewObject layout=L2
    PropDefine v27, v24 key="part"
    PropDefine v27, v25 key="whole"
    PropDefine v27, v26 key="more"
    v31 = FinishObject v27
    v32 = Integer
    Jump -> next b1(v32)
  b1(v33):
    LoopHint
    v35 = Integer integer=400
    v36 = Less v33, v35
    Branch v36 -> taken b2(), notTaken b3()
  b2():
    v37 = Call v2, -, v16
    v38 = Call v3, -, v16
    v39 = Call v4, -, v23
    v40 = Call v5, -, v23
    v41 = Call v6, -, v31
    v42 = Call v7, -, v31
    v43 = Increment v33
    Jump -> next b1(v43)
  b3():
    v44 = Call v2, -, v16
    v45 = Call v3, -, v16
    v46 = Call v9, -, v44, v45
    v47 = Call v4, -, v23
    v48 = Call v5, -, v23
    v49 = Call v9, -, v47, v48
    v50 = Call v6, -, v31
    v51 = Call v7, -, v31
    v52 = Call v9, -, v50, v51
    Return v52
}
