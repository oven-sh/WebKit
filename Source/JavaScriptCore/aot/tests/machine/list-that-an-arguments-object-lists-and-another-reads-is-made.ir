# No walk runs: the Code is written out. The list behind the parameters of an arguments object is also asked for its length: it is made, and the row of arguments holds the parameter alone.
# RUN: emit-code mechanisms=all
# CHECK: unit f1:Body
# CHECK: = Store({{*}}offset = 0, argumentBuffer
# CHECK-NOT: offset = 8, argumentBuffer
# -- code
# code f1:Body {
#   v1: fractional[2, 3] @Double = Double number=2.5
#   v2: 3 @Int32 = Integer integer=3
#   b0(v0: anything @JSValue) entry=0:
#     v3: Array @Cell = NewArray v0, v1 contents=anything traits=[mayCollect, mayTouchMemory]
#     v4: Arguments @Cell = CreateUnmappedArguments v2, v3, v0 traits=[mayCollect, mayTouchMemory]
#     v5: int[0, 4294967295] @Int64 = GetArrayLength v3 traits=[mayTouchMemory]
#     v6: int[0, 4294967295] @JSValue = Box v5
#     v7: Arguments @JSValue = Box v4
#     v8: anything?ResultOfUnknownCallee @JSValue = Call v0, -, v7, v6 traits=[mayThrow, mayThrowByRule, mayCollect, mayCallUnknownCode, mayBeTerminated, mayWriteObservableState, mayTouchMemory, mayWriteOutsideObjects]
#     Return v8
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="kept" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
