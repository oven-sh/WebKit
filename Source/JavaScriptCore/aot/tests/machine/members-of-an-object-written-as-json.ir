# The emitters of JSON text that compiled code writes, by themselves. No walk runs: the Code is written out.
# Room is reserved once. A key with its brace or comma, its quotes and its colon is one constant that is stored where the cursor stands; the cursor is a value, and Commit stores the position that it has reached.
# RUN: emit-code
# CHECK: unit f1:Body
# CHECK: = Store({{*}}offset = 0, stringBuilderBytes, origin = 7)
# CHECK: = Store({{*}}offset = 0, stringBuilderBytes, origin = 9)
# CHECK: = Store({{*}}stringBuilderBytes, origin = 10)
# CHECK: = Store8({{*}}offset = 0, stringBuilderBytes, origin = 11)
# CHECK: = Store({{*}}AOTStringBuilderStorage_fields, origin = 12)
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue, v1: anything @JSValue) entry=0:
#     v2: i32 @Int32 = ToInt32 v0 [givesOnlyLowestBits]
#     v3: boolean @Boolean = TypeTest v1 testedType=undefined
#     v4: opaque(StringBuilder) @Cell = StringBuilderBegin
#     v5: opaque(BuilderCursor) @RawWord = StringBuilderReserve v4 size=256
#     v6: opaque(BuilderCursor) @RawWord = JSONAppendKey v4, v5 string="id" [opensObject]
#     v7: opaque(BuilderCursor) @RawWord = JSONAppendInteger v4, v6, v2
#     v8: opaque(BuilderCursor) @RawWord = JSONAppendKey v4, v7 string="ok" [followsMember]
#     v9: opaque(BuilderCursor) @RawWord = JSONAppendBoolean v4, v8, v3
#     v10: opaque(BuilderCursor) @RawWord = JSONAppendToken v4, v9 jsonToken=CloseObject
#     v11 @Void = StringBuilderCommit v4, v10
#     v12: string @Cell = StringBuilderFinish v4
#     Return v12
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="writes" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Return v1
}
