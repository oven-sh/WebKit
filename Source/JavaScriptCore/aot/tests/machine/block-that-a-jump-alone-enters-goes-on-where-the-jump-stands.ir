# function later(x) { const same = x === 7; /* a block ends here */ if (same) return 1; return 2; }
# The comparison ends its block with a jump, and the branch that asks it stands alone in the next block, which nothing else enters: so the walk leaves it where it has walked a join apart for each way into it.
# The second block gets no machine block of its own. The branch then stands in the block where the answers of the comparison meet, and each of them goes straight to its side: no Boolean is made and tested.
# RUN: emit f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: unit f1:Body
# CHECK: Int32 {{*}} = Phi(
# CHECK-NEXT: = Branch(
# RUN(SHELL): run-in-shell globalThis.sink = (later, isOneOf) => { const values = [7, 7.5, 243, 244, 245, 246, 244.5, -0, NaN, "7", "244", null, undefined, true, {}]; let said = ""; for (let i = 0; i < values.length; i++) said += (i ? " " : "") + later(values[i]) + isOneOf(values[i]); print(said); };
# SHELL: 1false 2false 2true 2true 2true 2false 2false 2false 2false 2false 2false 2false 2false 2false 2false

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = Call v1, -, v2, v3
    Return v4
}
function f1 name="later" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=7
    v2 = StrictEq v0, v1
    Jump -> next b1()
  b1():
    Branch v2 -> taken b2(), notTaken b3()
  b2():
    v3 = Integer integer=1
    Return v3
  b3():
    v4 = Integer integer=2
    Return v4
}
function f2 name="isOneOf" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=243
    v2 = StrictEq v0, v1
    v3 = ToBoolean v2
    Branch v3 -> taken b1(| 0), notTaken b2(| 0)
  b1(v4):
    Jump -> next b3(v4)
  b2(v5):
    v6 = Integer integer=244
    v7 = StrictEq v0, v6
    Jump -> next b3(v7)
  b3(v8):
    v9 = ToBoolean v8
    Branch v9 -> taken b4(| 0), notTaken b5(| 0)
  b4(v10):
    Jump -> next b6(v10)
  b5(v11):
    v12 = Integer integer=245
    v13 = StrictEq v0, v12
    Jump -> next b6(v13)
  b6(v14):
    Return v14
}
