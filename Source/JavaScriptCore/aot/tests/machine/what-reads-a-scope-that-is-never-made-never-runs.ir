# only f4, which nobody calls, makes a closure of f1 and the scope that f1 reads. L0 is the first of a family that is lost, so it stands for the family, and f1 is reached
# RUN: emit f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: Oops
# CHECK: Oops
# RUN(LINK): link functions layouts mechanisms=all
# LINK: function f4 unreached
# LINK: layout L3 never-allocated

layout L0 kind=Instance name="Unmade" module=m0 constructor=f1 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=1
layout L1 kind=Instance name="First" module=m0 constructor=f2 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=1
layout L2 kind=Instance name="Second" module=m0 constructor=f3 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] flags=[IsConstructorFunction] ownFieldCount=1
layout L3 kind=Environment module=m0 fields=[{key=@"0" declared={type=f5 flags=[IsFromCompiler]} flags=[IsImmutable] variableName="fallback"}, {key=@"1" declared={type=anything} variableName="held"}] ownFieldCount=2
layout L4 module=m0 fields=[{key="other" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClosure function=f3
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="flag" [isFreeName]
    Switch v3 cases=[1, 2] -> case b1(), case b2(), otherwise b3()
  b1():
    v4 = Construct v0, -
    Jump -> next b4(v4)
  b2():
    v5 = Construct v1, -
    Jump -> next b4(v5)
  b3():
    v6 = NewObject -, v3 layout=L4 fields=[0]
    v7 = FinishObject v6
    Jump -> next b5(v7)
  b4(v8):
    v9 = Convert v8 declared={type=L0|L1|L2 flags=[IsExpected]}
    Jump -> next b5(v9)
  b5(v10):
    v11 = PropGet v2 key="sink" [isFreeName]
    v12 = Call v11, -, v10
    Return v12
}
function f1 name="Unmade" module=m0 flags=[HasThis] captures=[{type=env L3 flags=[IsFromCompiler]}] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: env L3, v1: L0):
    v2 = Integer integer=7
    PutEnvironmentField v0, v2 layout=L3 field=1
    v4 = GetEnvironmentField v0 layout=L3
    PropSet v1, v4 key="label"
    Return
}
function f2 name="First" module=m0 flags=[HasThis] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Integer integer=1
    PropSet v0, v1 key="label"
    Return
}
function f3 name="Second" module=m0 flags=[HasThis] thisType={type=L2 flags=[IsExpected]} results=[{type=anything}] constructedClass=L2 {
  b0(v0: L2):
    v1 = Integer integer=2
    PropSet v0, v1 key="label"
    Return
}
function f4 name="never" module=m0 results=[{type=anything}] {
  b0():
    v0 = Undefined
    v1 = NewObject -, v0 layout=L3 fields=[1]
    v2 = NewClosure v1 function=f5
    PutEnvironmentField v1, v2 layout=L3
    v4 = NewClosure v1 function=f1
    Return v4
}
function f5 name="fallback" module=m0 captures=[{type=env L3 flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: env L3):
    v1 = GetEnvironmentField v0 layout=L3 field=1
    Return v1
}
