# only a block of f4 that no run comes to makes a closure of f1 and the scope that f1 reads. Five classes below one class meet, one more than a set takes, so the value is known by the family, and a stranger joins it: the family is lost. L0 is its first, so it stands for the family, and f1 is reached
# RUN: emit f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: Oops
# CHECK: Oops
# RUN(LINK): link functions layouts mechanisms=all
# LINK: layout L3 never-allocated

layout L0 kind=Instance name="Unmade" module=m0 constructor=f1 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L1 kind=Instance name="First" module=m0 constructor=f2 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L2 kind=Instance name="Second" module=m0 constructor=f3 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L3 kind=Environment module=m0 fields=[{key=@"0" declared={type=f5 flags=[IsFromCompiler]} flags=[IsImmutable] variableName="fallback"}, {key=@"1" declared={type=anything} variableName="held"}] ownFieldCount=2
layout L4 module=m0 fields=[{key="other" declared={type=anything} flags=[IsRequired]}, {key="kind" declared={type=undefined|L0|L1|L2|L5|L6|L7}}] ownFieldCount=2
layout L5 kind=Instance name="Third" module=m0 constructor=f6 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L6 kind=Instance name="Fourth" module=m0 constructor=f7 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L7 kind=Instance name="Fifth" module=m0 constructor=f8 fields=[{key="label" declared={type=anything} flags=[IsRequired]}] supertypes=[L8] flags=[IsConstructorFunction] ownFieldCount=1
layout L8 kind=Instance name="Kind" module=m0 flags=[IsNeverAllocated]
module m0 path="/main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClosure function=f3
    v2 = NewClosure function=f6
    v3 = NewClosure function=f7
    v4 = NewClosure function=f8
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="flag" [isFreeName]
    Switch v6 cases=[1, 2, 3, 4, 5] -> case b1(), case b2(), case b3(), case b4(), case b5(), otherwise b6()
  b1():
    v7 = Construct v0, -
    Jump -> next b7(v7)
  b2():
    v8 = Construct v1, -
    Jump -> next b7(v8)
  b3():
    v9 = Construct v2, -
    Jump -> next b7(v9)
  b4():
    v10 = Construct v3, -
    Jump -> next b7(v10)
  b5():
    v11 = Construct v4, -
    Jump -> next b7(v11)
  b6():
    v12 = NewObject -, v6 layout=L4 fields=[0]
    v13 = FinishObject v12
    Jump -> next b8(v13)
  b7(v14):
    v15 = Convert v14 declared={type=L0|L1|L2|L5|L6|L7 flags=[IsExpected]}
    Jump -> next b8(v15)
  b8(v16):
    v17 = PropGet v5 key="sink" [isFreeName]
    v18 = Call v17, -, v16
    v19 = NewClosure function=f4
    v20 = Call v19, -
    Return v18
}
function f1 name="Unmade" module=m0 flags=[HasThis] captures=[{type=env L3 flags=[IsFromCompiler]}] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: env L3, v1: L0):
    v2 = Integer integer=7
    PutEnvironmentField v0, v2 layout=L3 field=1
    v4 = GetEnvironmentField v0 layout=L3
    PropSet v1, v4 key="label"
    Return
}
function f2 name="First" module=m0 flags=[HasThis] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Integer integer=1
    PropSet v0, v1 key="label"
    Return
}
function f3 name="Second" module=m0 flags=[HasThis] thisType={type=L2 flags=[IsExpected]} results=[{type=anything}] constructedClass=L2 {
  b0(v0: L2):
    v1 = Integer integer=2
    PropSet v0, v1 key="label"
    Return
}
function f4 name="never" module=m0 results=[{type=anything}] {
  b0():
    v0 = Integer integer=1
    v1 = Integer integer=1
    v2 = StrictEq v0, v1
    Branch v2 -> taken b2(), notTaken b1()
  b1():
    v3 = Undefined
    v4 = NewObject -, v3 layout=L3 fields=[1]
    v5 = NewClosure v4 function=f5
    PutEnvironmentField v4, v5 layout=L3
    v7 = NewClosure v4 function=f1
    Return v7
  b2():
    v8 = Undefined
    Return v8
}
function f5 name="fallback" module=m0 captures=[{type=env L3 flags=[IsFromCompiler]}] results=[{type=anything}] {
  b0(v0: env L3):
    v1 = GetEnvironmentField v0 layout=L3 field=1
    Return v1
}
function f6 name="Third" module=m0 flags=[HasThis] thisType={type=L5 flags=[IsExpected]} results=[{type=anything}] constructedClass=L5 {
  b0(v0: L5):
    v1 = Integer integer=3
    PropSet v0, v1 key="label"
    Return
}
function f7 name="Fourth" module=m0 flags=[HasThis] thisType={type=L6 flags=[IsExpected]} results=[{type=anything}] constructedClass=L6 {
  b0(v0: L6):
    v1 = Integer integer=4
    PropSet v0, v1 key="label"
    Return
}
function f8 name="Fifth" module=m0 flags=[HasThis] thisType={type=L7 flags=[IsExpected]} results=[{type=anything}] constructedClass=L7 {
  b0(v0: L7):
    v1 = Integer integer=5
    PropSet v0, v1 key="label"
    Return
}
