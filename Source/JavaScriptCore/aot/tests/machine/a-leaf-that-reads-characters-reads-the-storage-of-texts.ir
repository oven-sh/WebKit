# the call of a leaf that is handed a pointer to characters, by itself. No walk runs: the Code is written out.
# what such a leaf answers follows from the characters, not from its operands alone: its call reads the storage of texts, and is no function of its operands that a later call with the same ones could stand for.
# Number(text.slice(0, 2))
# RUN: emit-code
# CHECK-LABEL: unit f1:Body
# CHECK-COUNT-2: = Patch({{*}}effects = ControlDependent|Reads:{StringStorage
# RUN(NEVER): emit-code
# NEVER-NOT: Double @{{*}} = Patch({{*}}pureFunction
# -- code
# code f1:Body {
#   constants:
#     v0: 0 @Int32 = Integer
#     v1: 2 @Int32 = Integer integer=2
#   b0(v2: string @JSValue) entry=0:
#     v3: string @Cell = Unbox v2
#     v4: number @Double = StringRangeToNumber v3, v0, v1 traits=[mayThrow, mayCollect, mayTouchMemory]
#     v5: number @JSValue = Box v4
#     Return v5
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="asked" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="x"
    Return v1
}
