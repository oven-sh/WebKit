# `interface Parcel { weight: number; note?: string; count?: number }`, made often, and no maker gives `note` or `count`: they lie in the Extension (plan/a-field-of-a-record-that-no-maker-gives-lies-out-of-line.ir).
# Most objects have no Extension at all, so a read of such a field is written in line wherever it stands and asks first whether there is one. That is a state of knowledge with a name of its own in the schema, FieldLeftOutByMakers,
# and the rows of the five reads of slots list it under openUnder. `later` is a name that Link appended: outside of loops it is read by the stub, as the rows say of FieldInExtension, and in a loop in line.
# the emitter takes the form from the row, so nothing is listed as not named, and a whole build that writes the report and checks itself stops at nothing.
# f1 = pack, f2 = mark, f3 = noteOf, f4 = holdsCount, f5 = laterOf, f6 = notesOf
# -- source: parcels.ts
# declare function sink(...values: unknown[]): void;
# interface Parcel { weight: number; note?: string; count?: number }
# let work = 0;
# function pack(weight: number): Parcel { for (let i = 0; i < 2; i++) work = (work + i) | 0; return { weight }; }
# function mark(parcel: Parcel) { for (let i = 0; i < 2; i++) work = (work + i) | 0; parcel.note = "noted"; parcel.count = 2; (parcel as any).later = 1; }
# function noteOf(parcel: Parcel) { for (let i = 0; i < 2; i++) work = (work + i) | 0; return parcel.note; }
# function holdsCount(parcel: Parcel) { for (let i = 0; i < 2; i++) work = (work + i) | 0; return "count" in parcel; }
# function laterOf(parcel: Parcel) { for (let i = 0; i < 2; i++) work = (work + i) | 0; return (parcel as any).later; }
# function notesOf(parcels: Parcel[]) { let text = ""; for (let i = 0; i < parcels.length; i++) text += String(parcels[i].note) + String((parcels[i] as any).later); return text; }
# const parcels: Parcel[] = [];
# for (let i = 0; i < 4; i++) parcels.push(pack(i));
# mark(parcels[1]);
# sink(noteOf(parcels[0]), noteOf(parcels[1]), holdsCount(parcels[0]), holdsCount(parcels[1]), laterOf(parcels[0]), laterOf(parcels[1]), notesOf(parcels), work);
# -- end of source
# OPTIONS: report=Flow
# JSC-OPTIONS: --verifyAOTMachineCode=1
# RUN: bytes-by-form mechanisms=all
# CHECK-NOT: the build failed
# CHECK-NOT: not named:
# CHECK: every form is named
# RUN(ROWS): bytes-by-form mechanisms=all
# ROWS: GetSlotOrUndefined FieldInExtension Anywhere Closed
# ROWS: GetSlotOrUndefined FieldLeftOutByMakers Anywhere Open
# ROWS: GetSlotOrUndefined FieldLeftOutByMakers Loop Open
# RUN(FILLED): bytes-by-form mechanisms=all
# FILLED: IsSlotFilled FieldLeftOutByMakers Anywhere Open
# RUN(WHOLE): compile mechanisms=all
# WHOLE-NOT: the build failed
# RUN(NAMED): named-forms GetSlot GetSlotOrUndefined IsSlotFilled GetSlotGetter GetSlotSetter
# REPEAT: read = GetSlot GetSlotOrUndefined IsSlotFilled GetSlotGetter GetSlotSetter
# NAMED: %(read) Always Open, in a loop Open by the loop
# NAMED: %(read) FieldInExtension Closed, in a loop Open by the loop
# NAMED: %(read) FieldLeftOutByMakers Open, in a loop Open by the loop
# NAMED: %(read) in Loop Open
# END REPEAT

