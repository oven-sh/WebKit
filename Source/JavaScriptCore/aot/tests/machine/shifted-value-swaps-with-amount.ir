# function mix(a, b, c, d, e, f, g, h, i, j, count) { .. while (count > 0) { const s = (a ^ c) << (b & 15 ^ d); .. } }
# A shift takes its amount in rcx. Where no register is free, the value that is shifted may lie there: it is swapped with the amount, which dies there. It was stored, and read back behind the move of the amount
# (JetStream 2's zlib: the value that the loop carries through memory went through memory twice).
# REQUIRES: x86_64 unsanitized-code
# RUN: allocate f1:Body mechanisms=all
# CHECK-LABEL: unit f1:Body
# CHECK: swap r{{*}} <-> rcx, 32 bits

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
