  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="register" [isFreeName]
    v4 = Integer integer=1
    v5 = Integer integer=2
    v6 = Integer integer=3
    v7 = Integer integer=4
    v8 = Integer integer=5
    v9 = Integer integer=6
    v10 = Integer integer=7
    v11 = Integer integer=8
    v12 = Integer integer=9
    v13 = Integer integer=10
    v14 = Integer integer=1000
    v15 = Call v1, -, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14 calleeName="mix"
    v16 = Integer integer=-1
    v17 = Integer integer=2
    v18 = Integer integer=-3
    v19 = Integer integer=4
    v20 = Integer integer=-5
    v21 = Integer integer=6
    v22 = Integer integer=-7
    v23 = Integer integer=8
    v24 = Integer integer=-9
    v25 = Integer integer=10
    v26 = Integer integer=333
    v27 = Call v1, -, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26 calleeName="mix"
    v28 = Call v3, -, v15, v27 calleeName="register"
    Return v28
}
