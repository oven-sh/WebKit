# function isEighty(x) { return x === 80 ? 1 : 2; }   function isZero(x) { return x === 0 ? 1 : 2; }   function same(x, n) { return x === (n | 0) ? 1 : 2; }
# The tag of the value is asked for first, and what is left to compare is 32 bits wide. So the written integer stands in the compare, and no boxed integer is made for it, which takes an instruction of ten bytes.
# On the TypeScript compiler checking a project `node.kind === <a kind>` ran 376 million times, and the boxed integer was made each time.
# RUN: emit f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: unit f1:Body
# CHECK: = AboveEqual(
# CHECK-NEXT: = Branch({{*}}, rare #
# CHECK: = Trunc(
# CHECK-NEXT: = Equal(
# CHECK: = Const32(80)
# The integer 80 as a boxed value.
# CHECK-NOT: = Const64(-562949953421232)
# RUN(SHELL): run-in-shell globalThis.register = (isEighty, isZero, same) => { const row = (count, answer) => { let said = ""; for (let i = 0; i < count; i++) said += (i ? " " : "") + answer(i); print(said); }; const values = [80, 81, 80.5 - 0.5, 80.5, "80", null, undefined, -80, 4294967376, {}, true]; row(values.length, i => isEighty(values[i])); const zeros = [0, -0, 1, 0.5, "", null, false, NaN]; row(zeros.length, i => isZero(zeros[i])); const pairs = [[7, 7], [7, 8], [7, 7.9], [-1, 4294967295], ["7", 7], [0, -0], [-0, 0], [NaN, NaN]]; row(pairs.length, i => same(pairs[i][0], pairs[i][1])); };
# SHELL: 1 2 1 2 2 2 2 2 2 2 2
# SHELL-NEXT: 1 1 2 2 2 2 2 2
# SHELL-NEXT: 1 2 1 1 2 1 1 2
# SHELL: exited with 0

