# The code generator, by itself. No walk runs: the Code is written out.
# The check may throw, under a try: it leads to the handler. The stop by name behind it ends the process: it leads nowhere.
# RUN: emit-code
# CHECK-LABEL: unit f1:Body
# CHECK: = Patch({{*}}effects = Terminal|ExitsSideways
# CHECK: #[[pad]]: <- #[[throws]], landing pad
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue) entry=0:
#     Jump -> next b1()
#   b1() handler=b2():
#     v1: never @JSValue = RequireObjectCoercible v0 name="load" traits=[mayThrow, mayThrowByRule]
#     Unreachable
#   b2() role=CatchHandler:
#     v2: anything?CaughtException @JSValue = CatchValue traits=[mayCollect, mayTouchMemory]
#     Return v2
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="asks" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
