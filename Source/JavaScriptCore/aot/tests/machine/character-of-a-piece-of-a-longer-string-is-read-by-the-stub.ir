# function at(text, index) { return text[index]; }
# What slice() gives is a piece of a longer string, and it stays one however often it is read. The stub of the closed read by key took every rope to the operation, which read one character of the piece and left it as it was:
# 310 instructions a character where a flat string takes 25. The characters lie in the longer string, and the stub reads them there. A rope of parts, and a character that has no cell of its own, still go to the operation.
# LIBRARY: own
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.publish = at => { const letters = (length, wideEvery) => Array.from({ length }, (_, i) => wideEvery && !(i % wideEvery) ? "Ж" : String.fromCharCode(97 + i % 26)).join(""); const calls = () => aotOperationCount("operationAOTGetByVal"); const read = (text, from, to) => { let all = ""; for (let i = from; i < to; i++) all += at(text, i); return all; }; const piece = letters(300, 0).slice(30, 130), widePiece = letters(300, 7).slice(29, 129); let before = calls(); print(read(piece, 0, 8), read(piece, 92, 100), read(widePiece, 0, 6), read(widePiece, 7, 13), calls() - before); before = calls(); print(at(widePiece, 6).charCodeAt(0), calls() - before); print(at(piece, 100), at(piece, -1), at(piece, 1.5), at(piece, 4294967296), at(piece, "length"), at(widePiece, 100)); const parts = letters(40, 0) + letters(50, 0); before = calls(); print(at(parts, 41), at(parts, 42), calls() - before); };
# CHECK: efghijkl stuvwxyz defghi klmnop 0
# CHECK-NEXT: 1046 1
# CHECK-NEXT: undefined undefined undefined undefined 100 undefined
# CHECK-NEXT: b c 1
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="at" length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ElemGet v0, v1
    Return v2
}
