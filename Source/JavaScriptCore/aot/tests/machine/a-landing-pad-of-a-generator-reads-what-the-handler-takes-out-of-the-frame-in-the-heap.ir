# function* steps(limit, risky) { try { for (let i = 0; i < limit; i++) { yield i; risky(i); } } catch (error) { yield limit; } }   globalThis.made = steps;   the handler takes `limit` from the blocks in front of the yield and `risky` from those behind it
# The call of `risky` stands behind a yield, so what it names was read out of the frame in the heap behind that yield. Its landing pad is shared by every site with that handler and those arguments,
# in front of the yield and behind it: so the pad reads the argument out of the frame itself.
# RUN: emit f1:CoroutineBody mechanisms=all
# CHECK-LABEL: unit f1:CoroutineBody
# CHECK: landing pad
# CHECK-NEXT: Patch(
# CHECK-NEXT: Load({{*}}frameSlots
# CHECK-NEXT: Load({{*}}InternalFields
# CHECK-NEXT: Upsilon(

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    PropSet v1, v0 key="made"
    v3 = Undefined
    Return v3
}
function f1 name="steps" module=m0 flags=[IsGenerator, HasThis, TakesCallee, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned] {
  b0(v0: anything, v1: function, v2: anything, v3: anything):
    InitialYield v2, v3, v0
    v5 = Integer
    Jump -> next b1()
  b1() handler=b9(v2):
    v6 = Integer
    Jump -> next b2(v5, v6)
  b2(v7, v8) handler=b9(v2):
    LoopHint
    v10 = Less v8, v2
    Branch v10 -> taken b3(), notTaken b8()
  b3() handler=b9(v2):
    v11 = Increment v7
    Jump -> next b4()
  b4() handler=b9(v3):
    v12 = Yield v8, v2, v3, v0
    v13 = ResultAt v12
    v14 = ResultAt v12 index=1
    Switch v14 cases=[1, 2] -> case b5(), case b6(), otherwise b7()
  b5() handler=b9(v3):
    Throw v13
  b6() handler=b9(v3):
    Return v13
  b7() handler=b9(v3):
    v15 = Call v3, -, v8 calleeName="risky"
    v16 = Increment v8
    Jump -> next b2(v11, v16)
  b8() handler=b9(v2):
    Jump -> next b12()
  b9(v17) role=CatchHandler:
    v18 = CatchValue
    v19 = Yield v17, v2, v3, v0
    v20 = ResultAt v19
    v21 = ResultAt v19 index=1
    Switch v21 cases=[1, 2] -> case b10(), case b11(), otherwise b12()
  b10():
    Throw v20
  b11():
    Return v20
  b12():
    v22 = Undefined
    Return v22
}
