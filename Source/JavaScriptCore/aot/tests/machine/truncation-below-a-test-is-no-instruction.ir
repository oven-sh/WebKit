# function below(x) { return x < 80 ? 1 : 2; }
# The int32 in a boxed value is the low half of the register that holds the value. The compare reads that half where it lies: the Trunc between the two is no instruction and takes no register.
# On the TypeScript compiler checking a project each such test began with a copy of the register: ten of them for each character of an identifier.
# RUN: allocate f1:Body mechanisms=none+TypedOperations
# CHECK-LABEL: unit f1:Body
# CHECK: Branch AboveEqual(
# CHECK-NOT: = Trunc
# CHECK: Branch LessThan(Trunc({{*}}), 80)

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="register" [isFreeName]
    v5 = Call v4, -, v0, v1, v2 calleeName="register"
    v6 = Undefined
    Return v6
}
function f1 name="below" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=80
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
function f2 name="atLeast" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=80
    v2 = LessEq v1, v0
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
function f3 name="answer" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=-1
    v2 = Greater v0, v1
    Return v2
}
