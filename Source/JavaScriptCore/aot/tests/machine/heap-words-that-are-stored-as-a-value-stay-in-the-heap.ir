# No walk runs: the Code is written out. Of two sets of heap words the second is stored into a word of the first. The first is named by stores and reads of its words alone and lies in the frame;
# the second is named as the VALUE of a store: it stays a cell, and there is one slot, not two.
# RUN: emit-code mechanisms=all
# CHECK: unit f1:Body
# CHECK: = SlotBase(slot0)
# CHECK-NOT: slot1
# -- code
# code f1:Body {
#   b0(v0: anything @JSValue) entry=0:
#     v1: anything?UndescribedNativeResult @JSValue = NewHeapWords numberOfWords=3 traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     v2: anything?UndescribedNativeResult @JSValue = NewHeapWords numberOfWords=3 traits=[mayCollect, mayWriteObservableState, mayTouchMemory]
#     v3 @Void = PutHeapFrameWord v2, v0 [remembersFrame] traits=[mayWriteObservableState, mayTouchMemory]
#     v4 @Void = PutHeapFrameWord v1, v2 [remembersFrame] traits=[mayWriteObservableState, mayTouchMemory]
#     v5: anything @JSValue = GetHeapFrameWord v1 valueType=anything traits=[mayTouchMemory]
#     Return v5
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="kept" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
