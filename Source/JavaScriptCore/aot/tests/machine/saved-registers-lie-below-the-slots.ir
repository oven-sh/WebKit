# -- source: saved-registers-lie-below-the-slots.js
# function four(a, b, c, d) { report(a); report(a); report(b); report(b); report(c); report(c); report(d); return d; }
# report(id(four)(1, 2, 3, 4));
# -- end of source
# records of 8c796e1244cf5c42
# Four values live across calls and each is read twice, and x86-64 has two registers that callees save: the frame holds saves and slots. The saves lie at the bottom, where the stack pointer stands:
# the setup pushes them last and the teardown pops them, one or two bytes each for the four of a load off the frame pointer.
# f1 = four
# REQUIRES: x86_64 not-windows unsanitized-code
# RUN: frame f1:Body mechanisms=none
# CHECK-LABEL: unit f1:Body
# CHECK: coverage = WholeFunction
# CHECK-NEXT: size = [[size]]
# CHECK-NEXT: callee saves lie at the bottom
# CHECK-NEXT: calleeSaves = [{{*}} at -[[size]], {{*}}]
# CHECK: s0 at -
# RUN(RUNS): run-in-shell mechanisms=none globalThis.id = value => value; globalThis.report = value => print(String(value));
# RUNS: 1
# RUNS-NEXT: 1
# RUNS-NEXT: 2
# RUNS-NEXT: 2
# RUNS-NEXT: 3
# RUNS-NEXT: 3
# RUNS-NEXT: 4
# RUNS-NEXT: 4
# RUNS: exited with 0

