# No walk runs: the Code is written out. The list behind the parameters of an arguments object is read once, where the object is made, and copied. Where nothing else names the list it is not made:
# its elements stand in the row of arguments behind the parameters, a raw number boxed as the list would have boxed it, and the one empty list of the realm stands for the rest.
# RUN: emit-code mechanisms=all
# CHECK: unit f1:Body
# CHECK: = Load({{*}}NamesPermanentCell
# CHECK: = Store({{*}}offset = 0, argumentBuffer
# CHECK: = Store({{*}}offset = 8, argumentBuffer
# CHECK: = Store({{*}}offset = 16, argumentBuffer
# -- code
# code f1:Body {
#   v1: fractional[2, 3] @Double = Double number=2.5
#   v2: 3 @Int32 = Integer integer=3
#   b0(v0: anything @JSValue) entry=0:
#     v3: Array @Cell = NewArray v0, v1 contents=anything traits=[mayCollect, mayTouchMemory]
#     v4: Arguments @Cell = CreateUnmappedArguments v2, v3, v0 traits=[mayCollect, mayTouchMemory]
#     v5: Arguments @JSValue = Box v4
#     Return v5
# }
# -- end of code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2
    Return
}
function f1 name="kept" parameters=[{type=anything}] results=[{type=anything}] {
    Return v0
}
