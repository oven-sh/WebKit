# an allocation that fails throws, so under a handler it leads to the landing pad of its block
# for (const read of [r => r.x, r => r.y.z]) { try { read([1]); } catch { } }
# The call and the allocation of the array stand under the handler.
# On every edge the state of the iteration has the names that it has in front of the `try`, so no edge brings anything.
# Edges that bring nothing share one pad.
# RUN(PADS): emit f0
# PADS-COUNT-1: , landing pad
# PADS-NOT: landing pad

