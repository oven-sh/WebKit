  b0(v0: i32):
    Switch v0 cases=[1, 2, 5, 6] -> case b1(), case b3(), case b1(), case b3(), otherwise b2()
  b1():
    v1 = Integer integer=1
    Return v1
  b2():
    v2 = Integer integer=0
