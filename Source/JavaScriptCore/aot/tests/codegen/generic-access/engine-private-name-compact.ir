# A read, a store, a definition and a method call under a private name of the engine have code on an untyped receiver and pass the back-end checks in compact code without site caches. The key is the engine's symbol whatever its text, so @length and @0 are read by name too
# RUN: compile
# OPTIONS: heat=everything-is-cold validate check=validate-back-end limit=MaxSiteCaches:0
# STATISTIC: SiteCachesPlaced = 0
# STATISTIC: SitesWithoutSiteCache >= 2
# LOSS: MaxSiteCaches
# STATISTIC: MethodCallGroups = 0
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=3 kind=Assertion text="object"

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v1 key=@"bunNativePtr"
    PropSet v1, v2 key=@"bunNativePtr" mode=Strict
    v4 = Claim v1 castType=object site=w0
    PropDefine v4, v2 key=@"bunNativePtr"
    v6 = PropGet v1 key=@"then"
    v7 = Call v6, v1, v2 calleeKey=@"then"
    v8 = NewClosure function=f1
    v9 = NewClosure function=f2
    v10 = NewClosure function=f3
    v11 = NewClosure function=f4
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="register" [isFreeName]
    v14 = Call v13, -, v8, v9, v10, v11
    Return v14
}
function f1 name="reads" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropGet v0 key=@"bunNativePtr"
    v2 = PropGet v1 key=@"length"
    v3 = PropGet v2 key=@"0"
    Return v3
}
function f2 name="stores" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PropSet v0, v1 key=@"bunNativePtr" mode=Strict
    PropSet v1, v0 key=@"bunNativePtr" mode=Sloppy
    Return
}
function f3 name="definitions" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Claim v0 castType=object site=w0
    PropDefine v2, v1 key=@"bunNativePtr"
    Return
}
function f4 name="methodCalls" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key=@"then"
    v3 = Call v2, v0, v1 calleeKey=@"then"
    v4 = PropGet v3 key=@"get"
    v5 = Call v4, v3, v1 calleeKey=@"get"
    v6 = PropGet v5 key=@"bunNativePtr"
    v7 = Call v6, v5 calleeKey=@"bunNativePtr"
    Return v7
}
