# GO-NEXT: proven 543210 1: {"required":1,"whole":1,"text":"t1","late11":[3],"late7":[2],"late3":[1],"late0":[0]} required,whole,text,late11,late7,late3,late0
# GO-NEXT: proven 205 0: {"required":1,"late7":[2],"late0":[0],"whole":0} required,late7,late0,whole
# GO-NEXT: proven 205 1: {"required":1,"late7":[2],"late0":[0],"whole":1} required,late7,late0,whole
