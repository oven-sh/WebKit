# GO-NEXT: odd values: {"required":2,"text":5,"whole":"five","late3":null} required,text,whole,late0,late3
# GO-NEXT: and back: {"required":2,"text":"back","whole":6,"late0":1,"late3":null} required,text,whole,late0,late3
