# A layout keeps the fields that few of its objects get outside the cell. A store by name that knows the field, from the proven layout of its receiver or from the table of fields, creates it there:
# it appends the granule, stores the value and lists the key, without a miss and with nothing filed. What the object or the chain above it forbids goes on as a store by name.
# FORM: AsRead
# OPTIONS: heat=OnlyLoopsAreHot disable=pass:InlineCalls
# RUN(GO): run-in-shell globalThis.publish = (make, other, ...stores) => { const names = ["late0", "late3", "late7", "late11", "text", "whole"]; const show = (what, object) => print(what + ":", JSON.stringify(object), Object.keys(object).join()); for (const half of [0, 6]) { for (const order of [[0, 1, 2, 3, 4, 5], [5, 4, 3, 2, 1, 0], [2, 0, 5], [3], [1, 1, 4, 4]]) { for (let round = 0; round < 2; ++round) { const object = make(1); for (const index of order) stores[half + index](true, object, index == 4 ? "t" + round : index == 5 ? round : [index]); show((half ? "unproven " : "proven ") + order.join("") + " " + round, object); } } const odd = make(2); stores[half + 4](true, odd, 5); stores[half + 5](true, odd, "five"); stores[half + 0](true, odd, undefined); stores[half + 1](true, odd, null); show("odd values", odd); stores[half + 4](true, odd, "back"); stores[half + 5](true, odd, 6); stores[half + 0](true, odd, 1); show("and back", odd); for (const [what, change] of [["frozen", Object.freeze], ["sealed", Object.seal], ["not extensible", Object.preventExtensions]]) { const object = make(3); stores[half + 1](true, object, "kept"); change(object); let outcome = ""; for (const index of [1, 2]) { try { stores[half + index](true, object, "late"); outcome += " stored"; } catch (error) { outcome += " " + error.constructor.name; } } show(what + outcome, object); } const below = make(4); let seen = ""; Object.setPrototypeOf(below, { set late7(value) { seen += "set " + value; }, get late11() { return "got"; } }); let thrown = "none"; stores[half + 2](true, below, "caught"); try { stores[half + 3](true, below, "refused"); } catch (error) { thrown = error.constructor.name; } stores[half + 0](true, below, "own"); show("below accessors " + seen + " " + thrown, below); const gone = make(5); for (const index of [0, 1, 2]) stores[half + index](true, gone, index); delete gone.late3; show("deleted", gone); stores[half + 1](true, gone, "again"); show("created again", gone); } };
# GO: proven 012345 0: {"required":1,"late0":[0],"late3":[1],"late7":[2],"late11":[3],"text":"t0","whole":0} required,late0,late3,late7,late11,text,whole
# GO-NEXT: proven 012345 1: {"required":1,"late0":[0],"late3":[1],"late7":[2],"late11":[3],"text":"t1","whole":1} required,late0,late3,late7,late11,text,whole
