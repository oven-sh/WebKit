# A well-known symbol as the key of `in` passes the back-end checks in fast code: as a value, as a key whose symbol the program also reads as a value, and as a key alone
# RUN: compile
# OPTIONS: heat=everything-is-hot check=validate-back-end
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="register" [isFreeName]
    v5 = Call v4, -, v0, v1, v2
    Return v5
}
function f1 name="mentionedSymbol" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Builtin builtin=SymbolIterator
    v2 = ElemHas v0, v1
    Return v2
}
function f2 name="nameOfMentionedSymbol" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropHas v0 key=@@iterator
    Return v1
}
function f3 name="nameAlone" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropHas v0 key=@@asyncIterator
    Return v1
}
