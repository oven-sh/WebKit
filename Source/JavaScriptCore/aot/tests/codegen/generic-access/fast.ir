# Every access by name and by key on an untyped receiver passes the back-end checks in fast code. Every site in a function that may run again has a cache, so reads and stores probe the cache of their site. The six sites of the module body run once and ask for none
# RUN: compile
# OPTIONS: heat=everything-is-hot check=validate-back-end
# STATISTIC: SiteCachesPlaced >= 2
# STATISTIC: SitesWithoutSiteCache = 6
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=20 kind=Assertion text="checked"

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = PropGet v1 key="first"
    v3 = PropGet v1 key="length"
    PropSet v1, v2 key="first" mode=Strict
    PropSet v1, v2 key="first" mode=Sloppy
    v6 = PropHas v1 key="first"
    v7 = PropDelete v1 key="first" mode=Strict
    v8 = PropDelete v1 key="first" mode=Sloppy
    v9 = RequireObject v1 runtimeError=IteratorResultNotObject
    PropDefine v9, v2 key="first"
# REPEAT: i = 1..24
    v%(i+10) = NewClosure function=f%(i)
# END REPEAT
    v35 = Builtin builtin=GlobalThis
    v36 = PropGet v35 key="register" [isFreeName]
    v37 = Call v36, -, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34
    Return v37
}
function f1 name="reads" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first"
    v2 = PropGet v1 key="length"
    v3 = PropGet v2 key="call"
    v4 = PropGet v3 key="bind"
    v5 = PropGet v4 key="lastIndex"
    v6 = PropGet v5 key="0"
    v7 = PropGet v6 key="1.5"
    v8 = PropGet v7 key="__proto__"
    Return v8
}
function f2 name="oneStore" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="first" mode=Strict
    Return
}
function f3 name="stores" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    PropSet v0, v1 key="second" mode=Sloppy
    PropSet v1, v0 key="length" mode=Strict
    PropSet v0, v1 key="lastIndex" mode=Sloppy
    PropSet v1, v0 key="0" mode=Strict
    Return
}
function f4 name="definitions" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = RequireObject v0 runtimeError=IteratorResultNotObject
    PropDefine v3, v1 key="first"
    PropDefine v3, v1 key="0"
    ElemDefine v3, v2, v1
    Return
}
function f5 name="testsAndDeletes" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropHas v0 key="first"
    v2 = PropDelete v0 key="first" mode=Strict
    v3 = PropDelete v0 key="second" mode=Sloppy
    Return v3
}
function f6 name="byKey" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
    v3 = ElemGet v0, v1
    ElemSet v0, v1, v2 mode=Strict
    ElemSet v0, v1, v2 mode=Sloppy
    v6 = ElemHas v0, v1
    v7 = ElemDelete v0, v1 mode=Strict
    v8 = ElemDelete v0, v1 mode=Sloppy
    Return v3
}
function f7 name="byNumberKey" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Double number=1.5
    v3 = ElemGet v0, v2
    ElemSet v0, v2, v1 mode=Strict
    ElemSet v0, v2, v1 mode=Sloppy
    Return v3
}
function f8 name="checkedNumber" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @12
    v2 = Check v1 castType=undefined|null|number site=w0 @20
    Return v2
}
function f9 name="checkedBoolean" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @12
    v2 = Check v1 castType=undefined|null|boolean site=w0 @20
    Return v2
}
function f10 name="checkedString" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @12
    v2 = Check v1 castType=undefined|null|string site=w0 @20
    Return v2
}
function f11 name="checkedArray" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @12
    v2 = Check v1 castType=undefined|null|Array site=w0 @20
    Return v2
}
function f12 name="chain" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @5
    v2 = PropGet v1 key="second" @9
    Return v2
}
function f13 name="chainInCycle" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v2 = PropGet v0 key="first" @5
    v3 = PropGet v2 key="second" @9
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f14 name="chainWithBothResults" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @5
    v2 = PropGet v1 key="second" @9
    v3 = StrictEq v1, v2
    Return v3
}
function f15 name="chainWithBothResultsInCycle" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v2 = PropGet v0 key="first" @5
    v3 = PropGet v2 key="second" @9
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f16 name="sameReceiver" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first" @5
    v2 = PropGet v0 key="second" @9
    v3 = StrictEq v1, v2
    Return v3
}
function f17 name="sameReceiverInCycle" parameters=[{type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v2 = PropGet v0 key="first" @5
    v3 = PropGet v0 key="second" @9
    v4 = StrictEq v2, v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f18 name="twoReceivers" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v0 key="first" @5
    v3 = PropGet v1 key="second" @9
    v4 = StrictEq v2, v3
    Return v4
}
function f19 name="twoReceiversInCycle" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    Jump -> next b1()
  b1():
    LoopHint
    v3 = PropGet v0 key="first" @5
    v4 = PropGet v1 key="second" @9
    v5 = StrictEq v3, v4
    Branch v5 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f20 name="truthiness" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = PropGet v0 key="first"
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return
}
function f21 name="literal" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = String string="text"
    v2 = PropGet v0 key="first"
    v3 = StrictEq v2, v1
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return v0
  b2():
    Return
}
function f22 name="testsInHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = PropGet v0 key="first"
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    v3 = PropGet v0 key="first"
    v4 = ToBoolean v3
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = String string="text"
    v6 = PropGet v0 key="second"
    v7 = StrictEq v6, v5
    Branch v7 -> taken b4(), notTaken b5()
  b4():
    Return v2
  b5():
    Return v0
}
function f23 name="readUnderHandler" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything) handler=b2():
    v1 = PropGet v0 key="first"
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v2 = CatchValue
    Return v2
}
function f24 name="storeUnderHandler" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything) handler=b2():
    PropSet v0, v1 key="first" mode=Strict
    Jump -> next b1()
  b1():
    Return v1
  b2() role=CatchHandler:
    v3 = CatchValue
    Return v3
}
