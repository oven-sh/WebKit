# The stack is tested where the frame is set up, and a frame that does not fit is an error at the call in the caller. A function with a cheap early exit sets its frame up late, behind the test for the exit.
# exitsEarlyInATry has changed a variable by then and stands in a try: the error would leave the function past its own handler. So a function with a handler has its frame on every path.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: generate-code FunctionsWithFrameOnSomePaths
# CHECK: statistic FunctionsWithFrameOnSomePaths 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="total" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = ToNumber v1
    v3 = Integer integer=0
    v4 = BitOr v2, v3
    PutModuleVariable v4 variable=g0
    v6 = CallDirect v4, v4 function=f1
    v7 = CallDirect v4, v4 function=f2
    v8 = Add v6, v7
    Return v8
}
function f1 name="exitsEarly" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PutModuleVariable v1 variable=g0
    v3 = Integer integer=7
    v4 = StrictEq v0, v3
    Branch v4 -> taken b2(), notTaken b1()
  b1():
    v5 = BitXor v0, v1
    Return v5
  b2():
    v6 = CallDirect v0 function=f3
    v7 = CallDirect v1 function=f3
    v8 = BitXor v6, v7
    Return v8
}
function f2 name="exitsEarlyInATry" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    PutModuleVariable v1 variable=g0
    v3 = Integer integer=7
    v4 = StrictEq v0, v3
    Branch v4 -> taken b2(), notTaken b1()
  b1():
    v5 = BitXor v0, v1
    Return v5
  b2() handler=b3():
    v6 = CallDirect v0 function=f3
    v7 = CallDirect v1 function=f3
    v8 = BitXor v6, v7
    Return v8
  b3() role=CleanupHandler:
    v9 = CatchValue
    PutModuleVariable v0 variable=g0
    Throw v9
}
function f3 name="changesTotal" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g0
    v2 = PropGet v1 key="x"
    PutModuleVariable v2 variable=g0
    Return v2
}
