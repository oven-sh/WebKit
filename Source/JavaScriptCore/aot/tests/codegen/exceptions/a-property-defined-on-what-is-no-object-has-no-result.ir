}
function f8 name="on-anything" parameters=[{type=string}, {type=anything}, {type=anything}] results=[{type=object}] {
    v3 = DefineOwnProperty v2, v0, v1 descriptorFlags=[HasValue]
    Return v3
# CHECK: Void b@{{*}} = Patchpoint(b@[[object]]:{{*}}v3:DefineOwnProperty)
# CHECK-NEXT: Return(b@[[object]], Terminal)
}
