}
function f5 name="on-a-number-or-nothing" parameters=[{type=string}, {type=anything}, {type=undefined|number}] results=[{type=undefined}] {
    v3 = DefineOwnProperty v2, v0, v1 descriptorFlags=[HasValue]
    Unreachable
# CHECK: Void b@{{*}} = Patchpoint({{*}}v3:DefineOwnProperty)
