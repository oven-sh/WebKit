# What a suspension lists is a root, whether or not it is live after the suspension. An awaited call lists what it holds behind its arguments.
# RUN: frame-maps
# CHECK: f0:
# CHECK-NEXT: v4: v0:value v1:value v3:value
# CHECK-NEXT: v5: v1:value v0:value
# CHECK-NOT: v

module m0 path="main.js" displayPath="main.js"
variable g0 declared={type=anything} initialization=Undefined
function f0 name="holds" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=anything}, {type=number}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f0 promiseType=Promise promiseParameter=3} {
  b0(v0: anything @JSValue, v1: anything @JSValue, v2: number @Double, v3: undefined|Promise @JSValue):
    v4 @JSValue = AwaitBySavingFrame v1, v3, v0, v1, v2
    v5 @JSValue = AwaitCallBySavingFrame v3, v1, v0 function=f1 numberOfHeld=1
    PutModuleVariable v1 variable=g0
    v7 @JSValue = Undefined
    Return v7
}
function f1 name="callee" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f3 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1} {
  b0(v0: anything @JSValue, v1: undefined|Promise @JSValue):
    v2 @JSValue = ReturnAsyncResult v1, v0
    Return v2
}
function f2 name="holds" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}, {type=anything}, {type=number}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f0 promiseType=Promise promiseParameter=3}
function f3 name="callee" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f3 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=1}
