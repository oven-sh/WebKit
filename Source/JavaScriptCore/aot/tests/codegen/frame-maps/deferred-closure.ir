# A deferred closure and an upcast of one have no code, so no frame word contains them and they are not roots. The same closure in the full form is a root
# RUN: frame-maps
# CHECK: f0:
# CHECK-NEXT: v3:
# CHECK-NOT: v
# CHECK: f2:
# CHECK-NEXT: v3: v2:cell
# CHECK-NOT: v
# CHECK: f5:
# CHECK-NEXT: v4:
# CHECK-NOT: v

module m0 path="main.js" displayPath="main.js"
layout L0 name="A" fields=[{key="run" declared={type=f4} flags=[IsRequired]}]
function f0 name="deferred-closure" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f0 promiseType=Promise promiseParameter=1} {
  b0(v0: anything @JSValue, v1: undefined|Promise @JSValue):
    v2 @Cell = NewClosure function=f4 closureForm=Deferred
    v3 @JSValue = AwaitBySavingFrame v0, v1
    v4 @Cell = NewObject -, v2 layout=L0 fields=[0]
    v5 @JSValue = Box v4
    Return v5
}
function f1 name="deferred-closure" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f0 promiseType=Promise promiseParameter=1}
function f2 name="created-closure" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f3 body=f2 promiseType=Promise promiseParameter=1} {
  b0(v0: anything @JSValue, v1: undefined|Promise @JSValue):
    v2 @Cell = NewClosure function=f4
    v3 @JSValue = AwaitBySavingFrame v0, v1
    v4 @Cell = NewObject -, v2 layout=L0 fields=[0]
    v5 @JSValue = Box v4
    Return v5
}
function f3 name="created-closure" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f3 body=f2 promiseType=Promise promiseParameter=1}
function f4 name="run" results=[{type=undefined}] {
  b0():
    v0 @Void = Undefined
    Return v0
}
function f5 name="upcast-deferred-closure" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] creator=Coroutine{kind=AsyncFunction ramp=f6 body=f5 promiseType=Promise promiseParameter=1} {
  b0(v0: anything @JSValue, v1: undefined|Promise @JSValue):
    v2 @Cell = NewClosure function=f4 closureForm=Deferred
    v3 @Cell = Upcast v2 castType=f4
    v4 @JSValue = AwaitBySavingFrame v0, v1
    v5 @Cell = NewObject -, v3 layout=L0 fields=[0]
    v6 @JSValue = Box v5
    Return v6
}
function f6 name="upcast-deferred-closure" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f6 body=f5 promiseType=Promise promiseParameter=1}
