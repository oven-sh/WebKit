# RUN: frame-maps
# CHECK-NOT: f0:
# CHECK: f1:
# CHECK-NEXT: v3: v1:value v2:value
# CHECK-NOT: v

module m0 path="main.js" displayPath="main.js"
variable g0 declared={type=anything} initialization=Undefined
function f0 name="split-coroutine" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=2} {
  b0(v0: anything @JSValue, v1: anything @JSValue):
    v2 @Cell = NewPromise
    v3 @JSValue = Box v2
    v4 @JSValue = CallDirect v0, v1, v3 function=f1
    PutModuleVariable v1 variable=g0
    v6 @JSValue = AssumeType v4 castType=Promise
    Return v6
}
function f1 name="split-coroutine" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0 parameterMap=[{original=0}, {original=1}, {}]} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f1 entryWithoutPromise=f1 promiseType=Promise promiseParameter=2} {
  b0(v0: anything @JSValue, v1: anything @JSValue, v2: undefined|Promise @JSValue):
    v3 @JSValue = AwaitBySavingFrame v0, v2
    v4 @JSValue = ReturnAsyncResult v2, v1
    Return v4
}
