# An if chain that compares the code unit of a character, an integer, with constants becomes a jump table in B3. A chain that compares a number does not
# FORM: Selected
# RUN: generate-code
# CHECK: f0: size={{*}} jumpTables=1
# CHECK: f1: size={{*}} jumpTables=0

module m0 path="main.js" displayPath="main.js"
function f0 name="integers" parameters=[{type=string}, {type=i32}] results=[{type=int}] {
    v2 = StringRangeCodeUnitOrMinusOne v0, -, -, v1
# REPEAT: i = 1..8
    v%(i*4-1) = Integer integer=%(i+96)
    v%(i*4) = StrictEq v2, v%(i*4-1) form=Integers
    TestAndBranch v%(i*4) -> taken b%(i*2-1)(), notTaken b%(i*2)()
  b%(i*2-1)():
    v%(i*4+1) = Integer integer=%(i)
    v%(i*4+2) = BitAnd v1, v%(i*4+1) form=Integers
    Return v%(i*4+2)
  b%(i*2)():
# END REPEAT
    v35 = Integer integer=0
    Return v35
}
function f1 name="numbers" parameters=[{type=string}, {type=i32}] results=[{type=int}] {
    v2 = StringRangeCodeUnitOrNaN v0, -, -, v1
# REPEAT: i = 1..8
    v%(i*4-1) = Integer integer=%(i+96)
    v%(i*4) = StrictEq v2, v%(i*4-1) form=Numbers
    TestAndBranch v%(i*4) -> taken b%(i*2-1)(), notTaken b%(i*2)()
  b%(i*2-1)():
    v%(i*4+1) = Integer integer=%(i)
    v%(i*4+2) = BitAnd v1, v%(i*4+1) form=Integers
    Return v%(i*4+2)
  b%(i*2)():
# END REPEAT
    v35 = Integer integer=0
    Return v35
}
