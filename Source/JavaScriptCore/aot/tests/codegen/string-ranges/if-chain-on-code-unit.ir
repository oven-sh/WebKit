    v15 = Integer integer=101
    v16 = StrictEq v2, v15 form=Integers
    TestAndBranch v16 -> taken b9(), notTaken b10()
  b9():
    v17 = Integer integer=5
    Return v17
  b10():
    v18 = Integer integer=102
    v19 = StrictEq v2, v18 form=Integers
    TestAndBranch v19 -> taken b11(), notTaken b12()
  b11():
    v20 = Integer integer=6
