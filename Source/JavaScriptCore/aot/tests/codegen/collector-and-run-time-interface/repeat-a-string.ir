# function pad(text: string, count: number): number {
#   return text.repeat(count).length + 1;
# }
# declare const input: any;
# (globalThis as any).answer = pad(String(input), input | 0) + pad("ab", 3);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=13 kind=Parameter function=f1
typesite w1 module=m0 position=27 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=153 kind=CallResult
typesite w4 module=m0 position=149 kind=CallResult
typesite w5 module=m0 position=181 kind=CallResult
typesite w6 module=m0 position=61 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=String
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Call v6, -, v8 calleeName="String"
    v10 = Convert v9 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v14 = Integer
    v15 = BitOr v13, v14
    v16 = Call v1, -, v10, v15 calleeName="pad"
    v17 = Convert v16 declared={type=number site=w4}
    v18 = String string="ab"
    v19 = Integer integer=3
    v20 = Call v1, -, v18, v19 calleeName="pad"
    v21 = Convert v20 declared={type=number site=w5}
    v22 = Add v17, v21
    PropSet v5, v22 key="answer"
    v24 = Undefined
    Return v24
}
function f1 name="pad" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="repeat"
    v3 = Call v2, v0, v1 calleeKey="repeat" calleeName="text.repeat"
    v4 = Convert v3 declared={type=undefined|null|string site=w6 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v5 = PropGet v4 key="length"
    v6 = Integer integer=1
    v7 = Add v5, v6
    v8 = Convert v7 declared={type=number site=w2}
    Return v8
}

# The call into the run time allocates, and it throws where the result would be too long. It is marked as one that may leave sideways. Its result goes on as it is: nothing behind the call asks whether it threw.
# CHECK-LABEL: name="pad" role=Source
# CHECK: Int64 b@[[repeated]] = Patchpoint(b@[[text]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|ControlDependent|Writes:{collectorState, 
# CHECK-NEXT: Upsilon(b@[[repeated]], ^[[result]], WritesLocalState)
# CHECK-NEXT: Jump(Terminal)
# CHECK-NEXT: Successors: #[[behind]]
# CHECK-NEXT: BB#[[behind]]:
# CHECK: Int64 b@[[result]] = Phi(
# CHECK-NEXT: Int64 b@{{*}} = Load(b@[[result]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:GetStringLength)
# CHECK-LABEL: end of function
