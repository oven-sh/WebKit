# type Fork = { left: Fork | null; right: Fork | null };
# function fill(fork: Fork, left: Fork, right: Fork): void {
#   fork.left = left;
#   fork.right = right;
# }
# declare const input: any;
# const first: Fork = { left: null, right: null };
# const second: Fork = { left: null, right: null };
# fill(first, second, input ? first : second);
# fill(second, input ? first : second, first);
# (globalThis as any).answer = [first.left, first.right, second.left, second.right];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=190 kind=Variable
typesite w1 module=m0 position=239 kind=Variable
typesite w2 module=m0 position=69 kind=Parameter function=f1
typesite w3 module=m0 position=81 kind=Parameter function=f1
typesite w4 module=m0 position=93 kind=Parameter function=f1
typesite w5 module=m0 position=116 kind=Field
typesite w6 module=m0 position=136 kind=Field
layout L0 name="Fork" module=m0 position=5 fields=[{key="left" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="right" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="left" value=Null}, {key="right" value=Null}]} module=m0
data d1 root=Object{layout=L0 members=[{key="left" value=Null}, {key="right" value=Null}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = Data data=d1
    v5 = Convert v4 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    Jump -> next b6(v3)
  b4(v10):
    Jump -> next b5()
  b5():
    Jump -> next b6(v5)
  b6(v11):
    v12 = Call v1, -, v3, v5, v11 calleeName="fill"
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = ToBoolean v14
    Branch v15 -> taken b7(| 0), notTaken b9(| 0)
  b7(v16):
    Jump -> next b8()
  b8():
    Jump -> next b11(v3)
  b9(v17):
    Jump -> next b10()
  b10():
    Jump -> next b11(v5)
  b11(v18):
    v19 = Call v1, -, v5, v18, v3 calleeName="fill"
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="globalThis" [isFreeName]
    v22 = Convert v21 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v23 = Convert v22 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v24 = PropGet v3 key="left"
    v25 = PropGet v3 key="right"
    v26 = PropGet v5 key="left"
    v27 = PropGet v5 key="right"
    v28 = NewArray v24, v25, v26, v27 contents=anything
    PropSet v23, v28 key="answer"
    v30 = Undefined
    Return v30
}
function f1 name="fill" module=m0 position=55 flags=[IsChecked, HasExplicitName] length=3 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w4 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: undefined|null|L0, v2: undefined|null|L0):
    Jump -> next b1()
  b1():
    v3 = Convert v1 declared={type=undefined|null|L0 site=w5 flags=[OmitsUndefined]}
    PropSet v0, v3 key="left"
    v5 = Convert v2 declared={type=undefined|null|L0 site=w6 flags=[OmitsUndefined]}
    PropSet v0, v5 key="right"
    v7 = Undefined
    Return v7
}

# Nothing can collect between the two stores, so the barrier behind the second store covers the first.
# CHECK-LABEL: name="fill" role=Source
# CHECK-NOT: collectorState
# CHECK: Store(b@[[left]], b@[[fork]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK: Store(b@[[right]], b@[[fork]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[fork]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[done]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[done]]:
# CHECK-NOT: collectorState
# CHECK: Return(Terminal)
# CHECK: BB#[[remember]]:
# CHECK: Patchpoint(b@[[fork]]:{{*}}, resultConstraints = WarmAny, ControlDependent|Writes:collectorState|Reads:{collectorState, argumentBuffer}, {{*}}:PutSlot)
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of function
# ARM64 stores both references with one instruction.
# X64: instructions: 5, patchpoints: 0
# ARM64: instructions: 5, patchpoints: 0
