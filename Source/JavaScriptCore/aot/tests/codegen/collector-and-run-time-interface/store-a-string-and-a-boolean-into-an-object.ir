# A boolean is a byte in the object and needs no barrier. A string is a cell, so its store has one.
# CHECK-LABEL: name="update" role=Source
# CHECK-NOT: collectorState
# CHECK: Store8(b@[[isOpen]], b@[[door]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK: Store(b@[[label]], b@[[door]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[door]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[done]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[done]]:
# CHECK: Return(Terminal)
# CHECK-LABEL: end of function
