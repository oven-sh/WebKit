# The poll of the loop may collect and mark the owner, so every turn tests the state byte again. A turn has the store, the barrier in line, the load of the follower, the poll and the test for the end.
# CHECK-LABEL: loop #
# CHECK: Int64 b@[[entry]] = Phi(
# CHECK-NEXT: Store(b@[[entry]], b@[[owner]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[owner]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[rest]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[rest]]:
# CHECK: Int64 b@[[next]] = Load(b@[[entry]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Patchpoint({{*}}isLoopPoll
# CHECK-NOT: Reads:collectorState
# CHECK: BB#[[remember]]:
# CHECK: Patchpoint(b@[[owner]]:{{*}}, resultConstraints = WarmAny, ControlDependent|Writes:collectorState|Reads:{collectorState, argumentBuffer}, {{*}}:PutSlot)
# CHECK-LABEL: end of loop
# X64: loop #{{*}}, instructions: 5, patchpoints: 1
# ARM64: loop #{{*}}, instructions: 6, patchpoints: 1
