# type Entry = { follower: Entry | null; weight: number };
# function pointAtLast(owner: Entry, entry: Entry | null): void {
#   while (entry !== null) {
#     owner.follower = entry;
#     entry = entry.follower;
#   }
# }
# declare const input: any;
# const owner: Entry = { follower: null, weight: 0.5 };
# const last: Entry = { follower: null, weight: +input };
# pointAtLast(owner, { follower: last, weight: 1.5 });
# pointAtLast(owner, input ? last : null);
# (globalThis as any).answer = owner.follower!.weight;
