# type Fork = { left: Fork | null; right: Fork | null };
# function swap(fork: Fork): void {
#   const left = fork.left;
#   fork.left = fork.right;
#   fork.right = left;
# }
# declare const input: any;
# const first: Fork = { left: null, right: null };
# const second: Fork = { left: first, right: input ? first : null };
# swap(first);
# swap(second);
# (globalThis as any).answer = [first.left, first.right, second.left, second.right];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=196 kind=Variable
typesite w1 module=m0 position=245 kind=Variable
typesite w2 module=m0 position=69 kind=Parameter function=f1
typesite w3 module=m0 position=97 kind=Variable
typesite w4 module=m0 position=117 kind=Field
layout L0 name="Fork" module=m0 position=5 fields=[{key="left" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="right" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="left" value=Null}, {key="right" value=Null}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = ToBoolean v5
    Branch v6 -> taken b2(| 0), notTaken b4(| 0)
  b2(v7):
    Jump -> next b3()
  b3():
    Jump -> next b6(v3)
  b4(v8):
    Jump -> next b5()
  b5():
    v9 = Null
    Jump -> next b6(v9)
  b6(v10):
    v11 = Convert v10 declared={type=undefined|null|L0 flags=[OmitsUndefined]}
    v12 = NewObject -, v3, v11 layout=L0 fields=[0, 1]
    v13 = FinishObject v12
    v14 = Convert v13 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v15 = Call v1, -, v3 calleeName="swap"
    v16 = Call v1, -, v14 calleeName="swap"
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="globalThis" [isFreeName]
    v19 = Convert v18 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v20 = Convert v19 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v21 = PropGet v3 key="left"
    v22 = PropGet v3 key="right"
    v23 = PropGet v14 key="left"
    v24 = PropGet v14 key="right"
    v25 = NewArray v21, v22, v23, v24 contents=anything
    PropSet v20, v25 key="answer"
    v27 = Undefined
    Return v27
}
function f1 name="swap" module=m0 position=55 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="left"
    v2 = Convert v1 declared={type=undefined|null|L0 site=w3 flags=[OmitsUndefined]}
    v3 = PropGet v0 key="right"
    v4 = Convert v3 declared={type=undefined|null|L0 site=w4 flags=[OmitsUndefined]}
    PropSet v0, v4 key="left"
    PropSet v0, v2 key="right"
    v7 = Undefined
    Return v7
}

# Both references were in the object before, but the collector may look at the two fields at different times, so the stores have a barrier: one for both.
# CHECK-LABEL: name="swap" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[left]] = Load(b@[[fork]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int64 b@[[right]] = Load(b@[[fork]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Store(b@[[right]], b@[[fork]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Store(b@[[left]], b@[[fork]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[fork]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[done]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[done]]:
# CHECK: Return(Terminal)
# CHECK: BB#[[remember]]:
# CHECK: Patchpoint(b@[[fork]]:{{*}}, resultConstraints = WarmAny, ControlDependent|Writes:collectorState|Reads:{collectorState, argumentBuffer}, {{*}}:PutSlot)
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of function
# arm64 loads the pair with one instruction and stores it with one.
# X64: instructions: 7, patchpoints: 0
# ARM64: instructions: 6, patchpoints: 0
