function f2 name="note" module=m0 position=175 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = PropGet v0 key="weight"
    v3 = Call v1, -, v2 calleeName="remember"
    v4 = Convert v0 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    Return v4
}

# The call allocates, so it may collect, and the caller may hold the only reference to the entry. What is returned is the word that came in.
# CHECK-LABEL: name="note" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[entry]] = ArgumentReg(
# CHECK: Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = WarmAny, ControlDependent|Writes:{collectorState, {{*}}:CallDirect)
# CHECK-NEXT: Return(b@[[entry]], Terminal)
# CHECK-LABEL: end of function
# Across the call the word lies where the collector looks: on x86-64 in the frame, written as the frame is set up and read back as it is left.
# X64-LABEL: name="note" role=Source
# X64-NEXT: BB#0:
# X64-NEXT: EnterFrame $0, %rdi, $0
# X64-NEXT: MoveDouble 24(%rdi), %xmm0
# X64-NEXT: Patch &Patchpoint
# X64-NEXT: LeaveFrame %rax, $0
# X64-NEXT: Ret64 %rax
# X64-LABEL: end of function
# On ARM64 it lies in a register that every callee saves into its own frame before it uses it.
# ARM64-LABEL: name="note" role=Source
# ARM64-NEXT: BB#0:
# ARM64-NEXT: EnterFrame {{*}}, %x19
# ARM64-NEXT: Move %x0, %x19
# ARM64-NEXT: MoveDouble 24(%x0), %q0
# ARM64-NEXT: Patch &Patchpoint
# ARM64-NEXT: Move %x19, %x0
# ARM64-NEXT: LeaveFrame %x19
# ARM64-NEXT: Ret64 %x0
# ARM64-LABEL: end of function
