# The second call allocates, so it may collect and mark the object that the first call made. The store behind it keeps its barrier.
# CHECK-LABEL: name="chain" role=Source
# CHECK: Int64 b@[[entry]] = Patchpoint({{*}}Writes:{collectorState, {{*}}:CallDirect)
# CHECK: Int64 b@[[follower]] = Patchpoint({{*}}Writes:{collectorState, {{*}}:CallDirect)
# CHECK-NEXT: Store(b@[[follower]], b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[entry]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[done]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[done]]:
# CHECK: Return(b@[[entry]], Terminal)
# CHECK: BB#[[remember]]:
# CHECK: Patchpoint(b@[[entry]]:{{*}}, resultConstraints = WarmAny, ControlDependent|Writes:{collectorState, AOTInstance_siteCaches}|Reads:{collectorState, argumentBuffer}, {{*}}:PutSlot)
# CHECK-LABEL: end of function
