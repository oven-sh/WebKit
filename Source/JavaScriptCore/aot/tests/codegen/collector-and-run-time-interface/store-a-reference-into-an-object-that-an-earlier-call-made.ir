# type Entry = { follower: Entry | null; weight: number };
# let newest: Entry | null = null;
# function leaf(weight: number): Entry {
#   const entry: Entry = { follower: null, weight };
#   newest = entry;
#   return entry;
# }
# function chain(weight: number): Entry {
#   const entry = leaf(weight);
#   entry.follower = leaf(weight + 1);
#   return entry;
# }
# declare const input: any;
# (globalThis as any).answer = chain(+input).follower!.weight + chain(1.5).weight + newest!.weight;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f2
# REQUIRES: unsanitized-code

