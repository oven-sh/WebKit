    v7 = Convert v6 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v8 = Convert v7 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = ToNumber v11
    v13 = Call v1, -, v12 calleeName="chain"
    v14 = Convert v13 declared={type=undefined|null|L0 site=w5 flags=[OmitsNull, OmitsUndefined]}
    v15 = PropGet v14 key="follower"
    v16 = PropGet v15 key="weight"
    v17 = Double number=1.5
    v18 = Call v1, -, v17 calleeName="chain"
    v19 = Convert v18 declared={type=undefined|null|L0 site=w6 flags=[OmitsNull, OmitsUndefined]}
    v20 = PropGet v19 key="weight"
    v21 = Add v16, v20
    v22 = GetModuleVariable variable=g1
    v23 = CheckInitialized v22 name="newest"
    v24 = PropGet v23 key="weight"
    v25 = Add v21, v24
    PropSet v8, v25 key="answer"
    v27 = Undefined
    Return v27
}
function f1 name="leaf" module=m0 position=90 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
