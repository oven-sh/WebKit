# type Entry = { weight: number };
# let newest: Entry | null = null;
# function keep(entry: Entry): void {
#   newest = entry;
# }
# declare const input: any;
# keep({ weight: +input });
# if (input) keep({ weight: 1.5 });
# (globalThis as any).answer = newest;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=37 kind=Variable
typesite w1 module=m0 position=80 kind=Parameter function=f1
layout L0 name="Entry" module=m0 position=5 fields=[{key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
data d0 root=Object{layout=L0 members=[{key="weight" value=Number{value=1.5}}]} module=m0
variable g0 name="newest" module=m0 declared={type=undefined|null|absent|L0 site=w0 flags=[OmitsUndefined]}
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Null
    v3 = Convert v2 declared={type=undefined|null|L0 site=w0 flags=[OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=number flags=[IsExpected]}
    v8 = ToNumber v7
    v9 = Convert v8 declared={type=number}
    v10 = NewObject -, v9 layout=L0 fields=[0]
    v11 = FinishObject v10
    v12 = Call v1, -, v11 calleeName="keep"
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = ToBoolean v14
    Branch v15 -> taken b2(| 0), notTaken b4(| 0)
  b2(v16):
    Jump -> next b3()
  b3():
    v17 = Data data=d0
    v18 = Call v1, -, v17 calleeName="keep"
    Jump -> next b5()
  b4(v19):
    Jump -> next b5()
  b5():
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="globalThis" [isFreeName]
    v22 = Convert v21 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v23 = Convert v22 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v24 = GetModuleVariable variable=g0
    v25 = CheckInitialized v24 name="newest"
    PropSet v23, v25 key="answer"
    v27 = Undefined
    Return v27
}
function f1 name="keep" module=m0 position=66 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="newest"
    v3 = Convert v0 declared={type=undefined|null|L0 site=w0 flags=[OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Undefined
    Return v5
}

# A variable of the module is no cell and has no state byte. The store marks the card of the variable with one more store: no load, no comparison, no branch, no call.
# CHECK-LABEL: name="keep" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NOT: Load
# CHECK: Store(b@[[entry]], b@{{*}}, {{*}}Writes:ModuleVariables{{*}}:PutModuleVariable)
# CHECK-NOT: Load
# CHECK: Store8($1(b@{{*}}), b@{{*}}, {{*}}Writes:cards, {{*}}:PutModuleVariable)
# CHECK-NEXT: Return(Terminal)
# CHECK-NOT: BB#
# CHECK-LABEL: end of function
# ARM64 has no address with so large an offset: it makes both offsets and the constant in registers.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 6, patchpoints: 0
