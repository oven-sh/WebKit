# -- source: read-an-array-on-both-sides-of-a-call-that-may-give-it-other-storage.ts
# function pushes(onto: number[]): void {
#   onto.push(1.5);
# }
# function stores(into: number[], at: number): void {
#   into[at] = 2.5;
# }
# function names(bag: any): void {
#   bag.extra = 1;
# }
# function looksUp(bag: any): number {
#   return bag.extra;
# }
# function aroundPush(list: number[], other: number[]): number {
#   const first = list[0];
#   pushes(other);
#   return first + list[1];
# }
# function aroundStore(list: number[], other: number[]): number {
#   const first = list[0];
#   stores(other, 1);
#   return first + list[1];
# }
# function aroundName(list: number[], bag: any): number {
#   const first = list[0];
#   names(bag);
#   return first + list[1];
# }
# function aroundLookup(list: number[], bag: any): number {
#   const first = list[0];
#   return first + looksUp(bag) + list[1];
# }
# function aroundUnknown(list: number[], callee: () => void): number {
#   const first = list[0];
#   callee();
#   return first + list[1];
# }
# declare const input: any;
# const list: number[] = [+input, 0.5];
# (globalThis as any).answer =
#   aroundPush(list, list) + aroundStore(list, list) + aroundName(list, list) + aroundLookup(list, list) + aroundUnknown(list, input);
# -- end of source
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f5 f6 f7 f8 f9
# REQUIRES: unsanitized-code
# What each of these callees does may give a list other storage, and the list that it reaches may be the caller's: behind the call the storage and its length are loaded from the list again.
# The callee pushes onto a list.
# CHECK-LABEL: name="aroundPush" role=Source
# CHECK: Int64 b@{{*}} = Load(b@[[listOfAroundPush]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK: Patchpoint({{*}}:CallDirect)
# CHECK: Int64 b@[[storageBehindAroundPush]] = Load(b@[[listOfAroundPush]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehindAroundPush]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, 
# CHECK-LABEL: end of function
# The callee stores an element, which may lie behind the end of the list or be of a kind that its storage does not hold.
# CHECK-LABEL: name="aroundStore" role=Source
# CHECK: Int64 b@{{*}} = Load(b@[[listOfAroundStore]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK: Patchpoint({{*}}:CallDirect)
# CHECK: Int64 b@[[storageBehindAroundStore]] = Load(b@[[listOfAroundStore]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehindAroundStore]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, 
# CHECK-LABEL: end of function
# The callee stores under a name on an object that nobody knows: a list keeps such properties in its storage.
# CHECK-LABEL: name="aroundName" role=Source
# CHECK: Int64 b@{{*}} = Load(b@[[listOfAroundName]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK: Patchpoint({{*}}:CallDirect)
# CHECK: Int64 b@[[storageBehindAroundName]] = Load(b@[[listOfAroundName]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehindAroundName]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, 
# CHECK-LABEL: end of function
# The callee looks a name up on an object that nobody knows: the run time may put the properties of what it comes by in order.
# CHECK-LABEL: name="aroundLookup" role=Source
# CHECK: Int64 b@{{*}} = Load(b@[[listOfAroundLookup]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK: Patchpoint({{*}}:CallDirect)
# CHECK: Int64 b@[[storageBehindAroundLookup]] = Load(b@[[listOfAroundLookup]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehindAroundLookup]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, 
# CHECK-LABEL: end of function
# Nobody knows the callee.
# CHECK-LABEL: name="aroundUnknown" role=Source
# CHECK: Int64 b@{{*}} = Load(b@[[listOfAroundUnknown]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK: Patchpoint({{*}}:Call)
# CHECK: Int64 b@[[storageBehindAroundUnknown]] = Load(b@[[listOfAroundUnknown]], offset = 8, ControlDependent|Reads:JSArray_butterfly, 
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehindAroundUnknown]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, 
# CHECK-LABEL: end of function

