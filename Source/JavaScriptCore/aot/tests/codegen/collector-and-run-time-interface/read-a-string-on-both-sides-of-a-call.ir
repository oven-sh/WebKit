# The characters of a string never move, so their address is loaded once and lives across the call, which may collect. An opaque use of the string behind the last read keeps the string alive until then.
# CHECK-LABEL: name="ends" role=Source
# CHECK: Int64 b@[[text]] = Phi(
# CHECK: Int64 b@[[characters]] = Load(b@{{*}}, offset = 8, ControlDependent|ReadsImmutable|Reads:StringImpl_data, {{*}}:FlattenString)
# CHECK: Int32 b@{{*}} = Load8Z(b@[[characters]], ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:GetStringCodeUnit)
# CHECK: Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = WarmAny, ControlDependent|Writes:{collectorState, {{*}}:CallDirect)
# CHECK-NOT: Reads:StringImpl_data
# CHECK: Int32 b@{{*}} = Load8Z(b@[[characters]], offset = 1, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:GetStringCodeUnit)
# CHECK-NEXT: Patchpoint(b@[[text]]:ColdAny, {{*}}resultConstraints = WarmAny, WritesLocalState|Reads:Top, {{*}}:GetStringCodeUnit)
# CHECK-LABEL: end of function
