# -- source: module-variable-incremented-in-loop.ts
# let count = 0;
# let text = "";
# function counts(turns: number): number {
#   let sum = 0;
#   for (let i = 0; i < turns; i++) {
#     count += i & 3;
#     if (count > 64) {
#       sum = (sum + count) | 0;
#       count = 0;
#     }
#   }
#   return sum;
# }
# function writes(turns: number): void {
#   for (let i = 0; i < turns; i++) text += "a";
# }
# declare const input: any;
# (globalThis as any).answer = counts(+input) + counts(5);
# writes(+input);
# (globalThis as any).text = text;
# (globalThis as any).count = count;
# -- end of source
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1 f2
# REQUIRES: unsanitized-code
# The loop reads the variable only behind the test that may end it. Nothing in the loop throws or runs code, so nobody can look at the variable before the loop is left:
# it is read ahead of the loop, goes around in a register and is stored on the ways out.
# CHECK-LABEL: name="counts" role=Source
# CHECK-LABEL: steps by 1
# CHECK-NOT: ModuleVariables
# CHECK-LABEL: end of loop
# CHECK-LABEL: end of function
# Joining texts throws where the text gets too long, and whoever catches that may read the variable: every turn stores to it. Nothing else in the loop writes the variable,
# so what a turn would read there is what the turn before has stored: that goes around in a register.
# CHECK-LABEL: name="writes" role=Source
# CHECK-LABEL: loop #
# CHECK: Int64 b@[[text]] = Phi(
# CHECK-NOT: Reads:ModuleVariables
# CHECK: Int64 b@[[longer]] = Patchpoint(b@[[text]]:Register({{*}}:Add)
# CHECK: Store(b@[[longer]], b@{{*}}Writes:ModuleVariables{{*}}:PutModuleVariable)
# CHECK: Upsilon(b@[[longer]], ^[[text]],
# CHECK-LABEL: end of loop
# CHECK-LABEL: end of function

