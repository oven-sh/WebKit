# Every call is taken to replace the storage of arrays. So no address into the storage lives across the call: behind it the storage and its length are loaded from the array again.
# CHECK-LABEL: name="ends" role=Source
# CHECK: Int64 b@[[storage]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly, {{*}}:IsInBounds)
# CHECK: Double b@{{*}} = Load(b@[[storage]], ControlDependent|Reads:indexedDoubleProperties{{*}}:GetArrayElement)
# CHECK: Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = WarmAny, ControlDependent|Writes:{collectorState, {{*}}JSObject_butterfly, {{*}}:CallDirect)
# CHECK-NOT: b@[[storage]]
# CHECK: Int64 b@[[storageBehind]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly, {{*}}:IsInBounds)
# CHECK-NEXT: Int32 b@{{*}} = Load(b@[[storageBehind]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, {{*}}:IsInBounds)
# CHECK-NOT: b@[[storage]]
# CHECK: Double b@{{*}} = Load(b@[[storageBehind]], offset = 8, ControlDependent|Reads:indexedDoubleProperties{{*}}:GetArrayElement)
# CHECK-LABEL: end of function
