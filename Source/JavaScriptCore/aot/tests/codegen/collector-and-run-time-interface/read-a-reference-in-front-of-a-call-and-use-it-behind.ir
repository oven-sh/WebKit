# type Entry = { follower: Entry | null; weight: number };
# let newest: Entry | null = null;
# function remember(weight: number): void {
#   newest = { follower: newest, weight };
# }
# function weigh(entry: Entry): number {
#   const follower = entry.follower;
#   entry.follower = null;
#   remember(entry.weight);
#   return follower === null ? 0 : follower.weight;
# }
# declare const input: any;
# const last: Entry = { follower: null, weight: +input };
# (globalThis as any).answer = weigh(last) + weigh({ follower: input ? last : null, weight: 1.5 }) + newest!.weight;
