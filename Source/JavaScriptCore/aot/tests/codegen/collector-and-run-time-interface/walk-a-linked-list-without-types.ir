# function total(entry) {
#   let sum = 0;
#   while (entry !== null) {
#     sum += entry.weight;
#     entry = entry.follower;
#   }
#   return sum;
# }
# const last = { follower: null, weight: +input };
# globalThis.answer = total({ follower: last, weight: 1.5 }) + total(input ? last : null);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code faulting-loop-polls
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=152 fields=[{key="follower" declared={type=anything}}, {key="weight" declared={type=anything}}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Null
    v3 = NewObject layout=L0
    PropDefine v3, v2 key="follower"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    PropDefine v3, v7 key="weight"
    v9 = FinishObject v3
    v10 = Convert v9 declared={type=undefined|null|L0 flags=[IsExpected]}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="globalThis" [isFreeName]
    v13 = Convert v12 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v14 = NewObject layout=L0
    PropDefine v14, v10 key="follower"
    v16 = Double number=1.5
    PropDefine v14, v16 key="weight"
    v18 = FinishObject v14
    v19 = Call v1, -, v18 calleeName="total"
    v20 = Convert v19 declared={type=number flags=[IsExpected]}
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="input" [isFreeName]
    v23 = ToBoolean v22
    Branch v23 -> taken b2(| 0), notTaken b4(| 0)
  b2(v24):
    Jump -> next b3()
  b3():
    Jump -> next b6(v10)
  b4(v25):
    Jump -> next b5()
  b5():
    v26 = Null
    Jump -> next b6(v26)
  b6(v27):
    v28 = Call v1, -, v27 calleeName="total"
    v29 = Convert v28 declared={type=number flags=[IsExpected]}
    v30 = Add v20, v29
    PropSet v13, v30 key="answer"
    v32 = Undefined
    Return v32
}
function f1 name="total" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v0, v2)
  b2(v3, v4):
    LoopHint
    v6 = TypeTest v3 testedType=null
    Branch v6 -> taken b3(| 0), notTaken b5(| 0)
  b3(v7):
    Jump -> next b4()
  b4():
    v8 = Convert v4 declared={type=number flags=[IsExpected]}
    Return v8
  b5(v9):
    Jump -> next b6()
  b6():
    v10 = PropGet v9 key="weight"
    v11 = Add v4, v10
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = PropGet v9 key="follower"
    v14 = Convert v13 declared={type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}
    Jump -> next b2(v14, v12)
}

# Without a type in the source the loop is the same as with types: the program shows what the function is handed. A turn has two loads, the addition, one poll and the test for the end.
# CHECK-LABEL: loop #
# CHECK: Int64 b@[[entry]] = Phi(
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Double b@[[weight]] = Load(b@[[entry]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@{{*}} = Add(b@{{*}}, b@{{*}}, {{*}}:Add)
# CHECK-NEXT: Int64 b@[[follower]] = Load(b@[[entry]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Patchpoint({{*}}isLoopPoll, ExitsSideways|ControlDependent|Writes:{collectorState, {{*}}:LoopHint)
# CHECK-NEXT: Int32 b@[[isLast]] = Equal(b@[[follower]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[isLast]], Terminal, {{*}}:TypeTest)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of loop
# X64: loop #{{*}}, instructions: 3, patchpoints: 1
# ARM64: loop #{{*}}, instructions: 4, patchpoints: 1
