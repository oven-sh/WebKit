# The first parameter is always an object, so the back end is told that 32 bytes can be read at it wherever it likes. The second may be null: the back end is told nothing of it, and its read stays behind the test.
# CHECK-LABEL: name="sum" role=Source
# CHECK: Int32 b@[[isNull]] = Equal(b@[[other]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK: Branch(b@[[isNull]], Terminal, {{*}}:TypeTest)
# CHECK-NEXT: Successors: Then:Unlikely:#{{*}}, Else:#[[both]]
# CHECK-NEXT: BB#[[both]]:
# CHECK: Double b@{{*}} = Load(b@[[entry]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@{{*}} = Load(b@[[other]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Known properties:
# CHECK-NEXT: b@[[entry]]: dereferenceableBytes = 32
# CHECK-NEXT: end of function
# X64: instructions: 7, patchpoints: 0
# ARM64: instructions: 8, patchpoints: 0
