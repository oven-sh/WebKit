    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = Call v1, -, v11, v11 calleeName="sum"
    v17 = Convert v16 declared={type=number site=w4}
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="input" [isFreeName]
    v20 = ToBoolean v19
    Branch v20 -> taken b2(| 0), notTaken b4(| 0)
  b2(v21):
