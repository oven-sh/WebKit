# type Entry = { follower: Entry | null; weight: number };
# function sum(entry: Entry, other: Entry | null): number {
#   return other === null ? entry.weight : entry.weight + other.weight;
# }
# declare const input: any;
# const last: Entry = { follower: null, weight: +input };
# (globalThis as any).answer = sum(last, last) + sum(last, input ? last : null);
