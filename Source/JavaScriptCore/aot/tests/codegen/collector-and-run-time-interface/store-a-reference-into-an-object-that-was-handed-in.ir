# type Entry = { follower: Entry | null; weight: number };
# function link(entry: Entry, follower: Entry): void {
#   entry.follower = follower;
# }
# declare const input: any;
# const first: Entry = { follower: null, weight: +input };
# const second: Entry = { follower: null, weight: 1.5 };
# link(first, second);
# link(second, input ? first : second);
# (globalThis as any).answer = first.follower!.follower!.weight;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=173 kind=Variable
typesite w1 module=m0 position=230 kind=Variable
typesite w2 module=m0 position=71 kind=Parameter function=f1
typesite w3 module=m0 position=85 kind=Parameter function=f1
typesite w4 module=m0 position=112 kind=Field
layout L0 name="Entry" module=m0 position=5 fields=[{key="follower" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="follower" value=Null}, {key="weight" value=Number{value=1.5}}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Null
    v3 = Convert v2 declared={type=undefined|null|L0 flags=[OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v3, v8 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Data data=d0
    v13 = Convert v12 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v14 = Call v1, -, v11, v13 calleeName="link"
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = ToBoolean v16
    Branch v17 -> taken b2(| 0), notTaken b4(| 0)
  b2(v18):
    Jump -> next b3()
  b3():
    Jump -> next b6(v11)
  b4(v19):
    Jump -> next b5()
  b5():
    Jump -> next b6(v13)
  b6(v20):
    v21 = Call v1, -, v13, v20 calleeName="link"
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="globalThis" [isFreeName]
    v24 = Convert v23 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v25 = Convert v24 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v26 = PropGet v11 key="follower"
    v27 = PropGet v26 key="follower"
    v28 = PropGet v27 key="weight"
    PropSet v25, v28 key="answer"
    v30 = Undefined
    Return v30
}
function f1 name="link" module=m0 position=57 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: undefined|null|L0):
    Jump -> next b1()
  b1():
    v2 = Convert v1 declared={type=undefined|null|L0 site=w4 flags=[OmitsUndefined]}
    PropSet v0, v2 key="follower"
    v4 = Undefined
    Return v4
}

# The owner may be old and the follower young, so the store has a barrier. It is in line: the threshold of the collector, the state byte of the owner, one comparison and one branch.
# CHECK-LABEL: name="link" role=Source
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Branch(
# CHECK: Store(b@[[follower]], b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[entry]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK-NEXT: Successors: Then:#[[done]], Else:Rare:#[[remember]]
# CHECK-NEXT: BB#[[done]]:
# CHECK-NOT: Patchpoint(
# CHECK: Return(Terminal)
# Only the rare edge leads to the call that remembers the owner.
# CHECK: BB#[[remember]]:
# CHECK: Patchpoint(b@[[entry]]:{{*}}, resultConstraints = WarmAny, ControlDependent|Writes:collectorState|Reads:{collectorState, argumentBuffer}, {{*}}:PutSlot)
# CHECK-LABEL: end of function
# x86-64 compares the state byte with the threshold in memory. ARM64 loads the threshold first.
# X64: instructions: 4, patchpoints: 0
# ARM64: instructions: 5, patchpoints: 0
