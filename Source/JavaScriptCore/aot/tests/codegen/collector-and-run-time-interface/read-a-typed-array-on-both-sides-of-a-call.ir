# The call allocates, so it may collect. It cannot change the view, so the address of the elements is loaded once and lives across the call. The collector does not know that address:
# an opaque use of the view behind the last read keeps the view itself alive until then.
# CHECK-LABEL: name="ends" role=Source
# CHECK: Int64 b@[[vector]] = Load(b@[[list]], offset = 16, ControlDependent|Reads:JSArrayBufferView_vector, {{*}}:GetTypedArrayElement)
# CHECK-NEXT: Double b@{{*}} = Load(b@[[vector]], ControlDependent|Reads:TypedArrayElements, {{*}}:GetTypedArrayElement)
# CHECK: Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = WarmAny, ControlDependent|Writes:{collectorState, {{*}}:CallDirect)
# CHECK-NOT: Reads:JSArrayBufferView_vector
# CHECK: Double b@{{*}} = Load(b@[[vector]], offset = 8, ControlDependent|Reads:TypedArrayElements, {{*}}:GetTypedArrayElement)
# CHECK-NEXT: Patchpoint(b@[[list]]:ColdAny, {{*}}resultConstraints = WarmAny, WritesLocalState|Reads:Top, {{*}}:GetTypedArrayElement)
# CHECK-LABEL: end of function
