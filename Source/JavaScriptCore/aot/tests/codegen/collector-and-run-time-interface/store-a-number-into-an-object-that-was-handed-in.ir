    v21 = Convert v20 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v22 = Convert v21 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v23 = PropGet v8 key="follower"
