    v12 = ToNumber v11
    v13 = Call v1, -, v3, v12 calleeName="setWeight"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = ToNumber v16
    v18 = Call v1, -, v8, v17 calleeName="setWeight"
    v19 = Builtin builtin=GlobalThis
