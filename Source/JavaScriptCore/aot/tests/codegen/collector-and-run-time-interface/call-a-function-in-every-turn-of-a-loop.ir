# type Entry = { follower: Entry | null; weight: number };
# function depth(entry: Entry | null): number {
#   return entry === null ? 0 : 1 + depth(entry.follower);
# }
# function total(entry: Entry | null): number {
#   let sum = 0;
#   while (entry !== null) {
#     sum += depth(entry);
#     entry = entry.follower;
#   }
#   return sum;
# }
# declare const input: any;
# const last: Entry = { follower: null, weight: +input };
# (globalThis as any).answer = total({ follower: last, weight: 1.5 }) + total(input ? last : null);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f2
# REQUIRES: unsanitized-code

