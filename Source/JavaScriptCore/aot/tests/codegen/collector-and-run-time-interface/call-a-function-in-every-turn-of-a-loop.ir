# The entry is read again behind the call, so the reference lives across it: the load behind the call takes the same value that the call was handed. The call may run for any length of time, and the loop still polls once a turn.
# CHECK-LABEL: loop #
# CHECK: Int64 b@[[entry]] = Phi(
# CHECK-NOT: Patchpoint(
# CHECK: Double b@[[depth]] = Patchpoint(b@[[entry]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|{{*}}:CallDirect)
# CHECK: Int64 b@[[follower]] = Load(b@[[entry]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: Patchpoint(
# CHECK: Patchpoint({{*}}isLoopPoll, {{*}}:LoopHint)
# CHECK-NOT: Patchpoint(
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:TypeTest)
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Branch(
# CHECK-LABEL: end of loop
