module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=154 kind=Variable
typesite w1 module=m0 position=211 kind=Variable
typesite w2 module=m0 position=73 kind=Parameter function=f1
typesite w3 module=m0 position=261 kind=Field
typesite w4 module=m0 position=97 kind=Field
layout L0 name="Entry" module=m0 position=5 fields=[{key="follower" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
