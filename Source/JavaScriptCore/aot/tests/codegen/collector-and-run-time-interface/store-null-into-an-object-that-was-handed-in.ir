# type Entry = { follower: Entry | null; weight: number };
# function unlink(entry: Entry): void {
#   entry.follower = null;
# }
# declare const input: any;
# const first: Entry = { follower: null, weight: +input };
# const second: Entry = { follower: first, weight: 1.5 };
# first.follower = input ? second : null;
# unlink(first);
# if (input) unlink(second);
# (globalThis as any).answer = [first.follower, second.follower];
