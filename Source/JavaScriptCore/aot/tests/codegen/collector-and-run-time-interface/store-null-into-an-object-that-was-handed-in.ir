    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v3, v8 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Double number=1.5
    v13 = Convert v12 declared={type=number}
    v14 = NewObject -, v11, v13 layout=L0 fields=[0, 1]
    v15 = FinishObject v14
    v16 = Convert v15 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="input" [isFreeName]
    v19 = ToBoolean v18
    Branch v19 -> taken b2(| 0), notTaken b4(| 0)
  b2(v20):
    Jump -> next b3()
  b3():
    Jump -> next b6(v16)
  b4(v21):
    Jump -> next b5()
  b5():
    v22 = Null
    Jump -> next b6(v22)
  b6(v23):
    v24 = Convert v23 declared={type=undefined|null|L0 site=w3 flags=[OmitsUndefined]}
    PropSet v11, v24 key="follower"
    v26 = Call v1, -, v11 calleeName="unlink"
    v27 = Builtin builtin=GlobalThis
    v28 = PropGet v27 key="input" [isFreeName]
    v29 = ToBoolean v28
    Branch v29 -> taken b7(| 0), notTaken b9(| 0)
  b7(v30):
    Jump -> next b8()
  b8():
    v31 = Call v1, -, v16 calleeName="unlink"
    Jump -> next b10()
  b9(v32):
    Jump -> next b10()
  b10():
    v33 = Builtin builtin=GlobalThis
    v34 = PropGet v33 key="globalThis" [isFreeName]
    v35 = Convert v34 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v36 = Convert v35 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v37 = PropGet v11 key="follower"
    v38 = PropGet v16 key="follower"
