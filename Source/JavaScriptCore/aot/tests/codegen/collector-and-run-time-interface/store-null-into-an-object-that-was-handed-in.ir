# The field may hold a reference, but null is no cell: the store of the constant is all there is.
# CHECK-LABEL: name="unlink" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Store($2(b@{{*}}), b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-NOT: BB#
# CHECK-LABEL: end of function
# x86-64 stores the constant. ARM64 puts it into a register first.
# X64: instructions: 2, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
