# function add(list: Entry[], entry: Entry): void {
#   list.push(entry);
# }
# declare const input: any;
# const list: Entry[] = [];
# add(list, { weight: +input });
# add(list, { weight: 1.5 });
# (globalThis as any).answer = list[0].weight + list[1].weight;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=137 kind=Variable
typesite w1 module=m0 position=46 kind=Parameter function=f1
