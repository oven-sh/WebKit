typesite w4 module=m0 position=262 kind=Element
typesite w5 module=m0 position=85 kind=CallResult
layout L0 name="Entry" module=m0 position=5 fields=[{key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
data d0 root=Array{contents=undefined|null|L0} module=m0
data d1 root=Object{layout=L0 members=[{key="weight" value=Number{value=1.5}}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<undefined|null|L0> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = Call v1, -, v3, v10 calleeName="add"
    v12 = Data data=d1
    v13 = Call v1, -, v3, v12 calleeName="add"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="globalThis" [isFreeName]
    v16 = Convert v15 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v17 = Convert v16 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v18 = Integer
    v19 = ElemGet v3, v18
    v20 = Convert v19 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=ContainerWriterUnseen
    v21 = PropGet v20 key="weight"
    v22 = Integer integer=1
    v23 = ElemGet v3, v22
    v24 = Convert v23 declared={type=undefined|null|L0 site=w4 flags=[OmitsNull, OmitsUndefined]} illTypedCause=ContainerWriterUnseen
    v25 = PropGet v24 key="weight"
    v26 = Add v21, v25
    PropSet v17, v26 key="answer"
    v28 = Undefined
    Return v28
}
function f1 name="add" module=m0 position=33 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|L0> site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<undefined|null|L0>, v1: undefined|null|L0):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="push"
    v3 = Call v2, v0, v1 calleeKey="push" calleeName="list.push"
    v4 = Convert v3 declared={type=number site=w5} illTypedCause=DeclarationWithoutBody
    v5 = Undefined
    Return v5
}

# The fast path of push tests the state byte of the array before it stores: an array that the collector has marked goes to the call, which also serves a full or another kind of storage.
# So the fast path has three tests, two stores and nothing behind them.
# CHECK-LABEL: name="add" role=Source
# CHECK-NOT: Patchpoint(
# CHECK: Int64 b@[[storage]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly, {{*}}:CallInline)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:CallInline)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[list]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:CallInline)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:CallInline)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:CallInline)
# CHECK-NEXT: Successors: Then:#[[store]], Else:Rare:#[[call]]
# CHECK-NEXT: BB#[[store]]:
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Store(b@[[entry]], b@{{*}}, ControlDependent|Writes:indexedContiguousProperties, {{*}}:CallInline)
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Store(b@{{*}}, b@[[storage]], offset = -8, ControlDependent|Writes:Butterfly_publicLength, {{*}}:CallInline)
# CHECK-NOT: collectorState
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Return(Terminal)
# CHECK: BB#[[call]]:
# CHECK: Patchpoint(b@[[list]]:Register({{*}}), b@[[entry]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of function
# The first instruction on both targets copies the entry into the register in which the rare call takes it.
# X64: instructions: 12, patchpoints: 0
# ARM64: instructions: 14, patchpoints: 0
