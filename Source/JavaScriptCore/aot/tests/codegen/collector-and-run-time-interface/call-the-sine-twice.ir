# CHECK-NOT: ExitsSideways
# CHECK-NOT: Writes:
# CHECK-NOT: Reads:
# CHECK-NOT: Branch(
# CHECK: Double b@[[second]] = Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), pureFunction = {{*}}, ControlDependent, {{*}}:CallInline)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[first]], b@[[second]], 
