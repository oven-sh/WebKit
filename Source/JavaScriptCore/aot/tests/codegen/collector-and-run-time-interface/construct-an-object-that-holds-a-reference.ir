# Calls are inlined everywhere but in the body of the module, so the constructor is part of `prepend`. Its assignments to `this` have become the first stores into the new object:
# they follow the allocation at once, and none has a barrier.
# CHECK-LABEL: name="prepend" role=ResultWrapper
# CHECK: Int64 b@[[entry]] = Patchpoint({{*}}:NewObject)
# CHECK-NEXT: Store(b@[[follower]], b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[weight]], b@[[entry]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NOT: Load8Z(b@[[entry]], offset = 7,
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Store(
# CHECK: Return(b@[[entry]], Terminal)
# CHECK-NOT: Load8Z(b@[[entry]], offset = 7,
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of function
