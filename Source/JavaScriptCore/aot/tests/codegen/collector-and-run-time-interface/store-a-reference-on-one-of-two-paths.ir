typesite w2 module=m0 position=80 kind=Parameter function=f1
typesite w3 module=m0 position=94 kind=Parameter function=f1
typesite w4 module=m0 position=157 kind=Field
typesite w5 module=m0 position=191 kind=Field
layout L0 name="Entry" module=m0 position=5 fields=[{key="follower" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="follower" value=Null}, {key="weight" value=Number{value=1.5}}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Null
    v3 = Convert v2 declared={type=undefined|null|L0 flags=[OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v3, v8 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Data data=d0
    v13 = Convert v12 declared={type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v14 = Call v1, -, v11, v13 calleeName="linkIfHeavier"
    v15 = Call v1, -, v13, v11 calleeName="linkIfHeavier"
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="globalThis" [isFreeName]
    v18 = Convert v17 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v19 = Convert v18 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v20 = PropGet v11 key="follower"
    v21 = PropGet v13 key="follower"
    v22 = PropGet v11 key="weight"
    v23 = PropGet v13 key="weight"
    v24 = Add v22, v23
    v25 = NewArray v20, v21, v24 contents=anything
    PropSet v19, v25 key="answer"
    v27 = Undefined
    Return v27
}
function f1 name="linkIfHeavier" module=m0 position=57 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: undefined|null|L0):
    Jump -> next b1()
  b1():
    v2 = PropGet v1 key="weight"
    v3 = PropGet v0 key="weight"
    v4 = Greater v2, v3
    Branch v4 -> taken b2(), notTaken b3()
  b2():
    v5 = Convert v1 declared={type=undefined|null|L0 site=w4 flags=[OmitsUndefined]}
