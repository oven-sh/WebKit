# type Entry = { follower: Entry | null; weight: number };
# function linkIfHeavier(entry: Entry, follower: Entry): void {
#   if (follower.weight > entry.weight) entry.follower = follower;
#   else entry.weight = follower.weight;
# }
# declare const input: any;
# const first: Entry = { follower: null, weight: +input };
# const second: Entry = { follower: null, weight: 1.5 };
# linkIfHeavier(first, second);
# linkIfHeavier(second, first);
# (globalThis as any).answer = [first.follower, second.follower, first.weight + second.weight];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
