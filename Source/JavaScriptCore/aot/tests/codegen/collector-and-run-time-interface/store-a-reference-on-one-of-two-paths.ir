# The barrier belongs to the arm that stores the reference. The arm that stores the number returns without reading the state of the collector.
# CHECK-LABEL: name="linkIfHeavier" role=Source
# CHECK-NOT: collectorState
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Greater)
# CHECK-NEXT: Successors: Then:#[[link]], Else:#[[copy]]
# CHECK-NEXT: BB#[[link]]:
# CHECK: Store(b@[[follower]], b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK: Int32 b@[[threshold]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[state]] = Load8Z(b@[[entry]], offset = 7, ControlDependent|Reads:collectorState, {{*}}:PutSlot)
# CHECK-NEXT: Int32 b@[[isUnmarked]] = Below(b@[[threshold]], b@[[state]], {{*}}:PutSlot)
# CHECK-NEXT: Branch(b@[[isUnmarked]], Terminal, {{*}}:PutSlot)
# CHECK: BB#[[copy]]:
# CHECK-NOT: collectorState
# CHECK: Store(b@{{*}}, b@[[entry]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# X64: instructions: 9, patchpoints: 0
# ARM64: instructions: 10, patchpoints: 0
