# function sumBelow(limit: number): number {
#   let sum = 0;
#   for (let index = 0; index < limit; index++) sum += index;
#   return sum;
# }
# declare const input: any;
# (globalThis as any).answer = sumBelow(input | 0) + sumBelow(1000);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code faulting-loop-polls
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=18 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=189 kind=CallResult
typesite w3 module=m0 position=211 kind=CallResult
typesite w4 module=m0 position=49 kind=Variable
typesite w5 module=m0 position=69 kind=Variable
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="sumBelow"
    v12 = Convert v11 declared={type=number site=w2}
    v13 = Integer integer=1000
    v14 = Call v1, -, v13 calleeName="sumBelow"
    v15 = Convert v14 declared={type=number site=w3}
    v16 = Add v12, v15
    PropSet v5, v16 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="sumBelow" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number site=w4}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w5}
    Jump -> next b2(v2, v4)
  b2(v5: number, v6: number):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v9, v10):
    Jump -> next b4()
  b4():
    v11 = Add v5, v9
    v12 = Convert v11 declared={type=number site=w4}
    Jump -> next b5()
  b5():
    v13 = Increment v9
    v14 = Convert v13 declared={type=number site=w5}
    Jump -> next b2(v12, v14)
  b6(v15, v16):
    Jump -> next b7()
  b7():
    v17 = Convert v5 declared={type=number site=w1}
    Return v17
}

# The limit is a number of the caller, not the length of anything in memory, so the loop polls once a turn.
# CHECK-LABEL: steps by 1
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK: Patchpoint({{*}}isLoopPoll, ExitsSideways|ControlDependent|Writes:{collectorState, {{*}}:LoopHint)
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Branch(
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of loop
# x86-64 clears the register before it converts the counter to a double.
# X64: loop #{{*}}, instructions: 5, patchpoints: 1
# ARM64: loop #{{*}}, instructions: 4, patchpoints: 1
