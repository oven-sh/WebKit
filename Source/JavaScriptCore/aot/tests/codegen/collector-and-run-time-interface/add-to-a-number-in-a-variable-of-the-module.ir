# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=4 kind=Variable
typesite w1 module=m0 position=30 kind=Parameter function=f1
variable g0 name="total" module=m0 declared={type=number|absent site=w0}
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Double number=0.5
    v3 = Convert v2 declared={type=number site=w0}
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=number flags=[IsExpected]}
    v8 = ToNumber v7
    v9 = Call v1, -, v8 calleeName="add"
    v10 = Double number=1.5
    v11 = Call v1, -, v10 calleeName="add"
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = GetModuleVariable variable=g0
    v17 = CheckInitialized v16 name="total"
    PropSet v15, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="add" module=m0 position=17 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="total"
    v3 = Add v2, v0
    v4 = Convert v3 declared={type=number site=w0}
    v5 = GetModuleVariable variable=g0
    v6 = CheckInitialized v5 name="total"
    PutModuleVariable v4 variable=g0
    v8 = Undefined
    Return v8
}

# The variable holds a raw double, so the store marks no card.
# CHECK-LABEL: name="add" role=Source
# CHECK-NEXT: BB#0:
