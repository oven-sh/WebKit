# CHECK: Double b@[[sum]] = Add(b@{{*}}, b@{{*}}, {{*}}:Add)
# CHECK: Store(b@[[sum]], b@{{*}}, {{*}}Writes:ModuleVariables{{*}}:PutModuleVariable)
