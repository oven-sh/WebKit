module m0 path="main.js" displayPath="main.js"
function f0 name="countUp" parameters=[{type=int[0, 1000]}] results=[{type=int[0, 1000]}] {
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2: int[0, 1000]):
    LoopHint
    v4 = Less v2, v0 form=Integers
    TestAndBranch v4 -> taken b2(| 0), notTaken b3()
  b2(v5):
    v6 = Increment v5 form=Integers
    Jump -> next b1(v6)
  b3():
    Return v2

# An origin names the IR value and its operation. As emitted, blocks have no predecessors yet and the condition is tested at the top.
# LOWERED-NOT: Predecessors:
