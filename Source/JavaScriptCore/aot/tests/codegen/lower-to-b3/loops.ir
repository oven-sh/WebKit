# `loops` prints the innermost natural loops, each between a line that names its header and its counters and an end line.
# FORM: Placed
# OPTIONS: heat=EverythingIsHot disable=b3:UnrollLoops
# RUN: lower-to-b3 loops
# RUN(OPTIMIZED): lower-to-b3 optimized loops

module m0 path="main.js" displayPath="main.js"
function f0 name="nested" parameters=[{type=int[0, 1000]}] results=[{type=int[0, 1000]}] {
    v1 = Integer
    Jump -> next b1(v1)
  b1(v2: int[0, 1000]):
    LoopHint
    v4 = Less v2, v0 form=Integers
    TestAndBranch v4 -> taken b2(| 0), notTaken b5()
  b2(v5):
    Jump -> next b3(v0)
  b3(v6: int[0, 1000]):
    LoopHint
    v8 = Integer integer=2
    v9 = Less v8, v6 form=Integers
    TestAndBranch v9 -> taken b4(| 1), notTaken b6()
  b4(v10):
    v11 = Sub v10, v8 form=Integers
    Jump -> next b3(v11)
  b5():
    Return v2
  b6():
    v12 = Increment v5 form=Integers
    Jump -> next b1(v12)

# CHECK-NEXT: loop #[[inner]] in loop #[[outer]], b@[[counter]] steps by -2
# CHECK-NEXT: BB#[[inner]]:
# CHECK: b@[[counter]] = Phi(
# CHECK: end of loop #[[inner]]
# CHECK-NOT: loop

# OPTIMIZED: steps by -2
# OPTIMIZED: end of loop
# OPTIMIZED-NOT: loop
}
function f1 name="straight" results=[{type=int[0, 0]}] {
    v0 = Integer
    Return v0

# CHECK-NOT: BB#
}
