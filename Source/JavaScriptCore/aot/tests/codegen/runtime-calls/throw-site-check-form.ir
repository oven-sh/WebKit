# Without a handler a failed check is a check of the back end that needs no frame: a leaf that reads a variable in its dead zone or claims a number has one throw site and no frame, and a variable that is always initialized has no throw site
# FORM: AsRead
# RUN: generate-code
# OPTIONS: heat=everything-is-cold disable=pass:InlineCalls check=validate-back-end
# STATISTIC: ThrowSites = 2
# CHECK: f1: size={{*}} frame=none entries=1 sites=1 handlers=0
# CHECK: f2: size={{*}} frame=none entries=1 sites=1 handlers=0
# CHECK: f3: size={{*}} frame=none entries=1 sites=0 handlers=0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=3 kind=Assertion text="number"
variable g0 name="late" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="ready" module=m0 declared={type=anything} initialization=Undefined

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="register" [isFreeName]
    v5 = Call v4, -, v0, v1, v2
    PutModuleVariable v5 variable=g0
    PutModuleVariable v5 variable=g1
    Return v5
}
function f1 name="readsInDeadZone" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="late"
    Return v1
}
function f2 name="claimsNumber" parameters=[{type=anything}] results=[{type=number}] {
  b0(v0: anything):
    v1 = Claim v0 castType=number site=w0
    v2 = Add v1, v1
    Return v2
}
function f3 name="readsInitialized" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g1
    v1 = CheckInitialized v0 name="ready"
    Return v1
}
