# A leaf whose only call creates a constant in rare code sets no frame up at its entry, in compact code
# FORM: AsRead
# RUN: generate-code
# OPTIONS: heat=everything-is-cold disable=pass:InlineCalls,pass:RemoveUnusedParameters check=validate-back-end
# CHECK: f1: size={{*}} frame={{*}}@[[setup]]-
# CHECK: f2: size=
# CHECK-NOT: frame=none
# CHECK-NOT: @[[setup]]-
# CHECK: f4: size=
# PROGRAM-OF: leaf-with-rare-call.ir
