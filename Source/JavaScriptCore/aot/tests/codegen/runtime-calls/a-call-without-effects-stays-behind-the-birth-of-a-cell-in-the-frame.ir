# function whichOf(record) { return "kind" in record ? 10 : "sort" in record ? 100 : -1000 }   for (let i = 0; i < 100; i++) sum += whichOf({ kind: 1 })
# whichOf() only asks what it was given: it has no effects. The literal lies in the frame, at the same address in every round, and gets the words that say what it is from stores of the loop's body.
# The call stays behind those stores: moved in front of the loop it would ask memory that nobody has written.
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls heat=EverythingIsHot
# RUN(IR): pipeline Select
# RUN: run-in-shell globalThis.show = (sum, second, third) => { print(sum, second, third); };
# IR-LABEL: name="main"
# IR: = NewObject {{*}} storage=Frame
# IR: = CallDirect {{*}} function=f1
# CHECK: 1000 100 -1000
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="kind" declared={type=anything} flags=[IsRequired]}]
layout L1 fields=[{key="sort" declared={type=anything} flags=[IsRequired]}]
layout L2 fields=[{key="neither" declared={type=anything} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer
    v2 = Integer
    Jump -> next b1(v1, v2)
  b1(v3, v4):
    LoopHint
    v6 = Integer integer=100
    v7 = Less v4, v6
    Branch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Integer integer=1
    v9 = NewObject -, v8 layout=L0 fields=[0]
    v10 = FinishObject v9
    v11 = Call v0, -, v10
    v12 = Add v3, v11
    v13 = Increment v4
    Jump -> next b1(v12, v13)
  b3():
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="show" [isFreeName]
    v16 = Integer integer=2
    v17 = NewObject -, v16 layout=L1 fields=[0]
    v18 = FinishObject v17
    v19 = Call v0, -, v18
    v20 = NewObject -, v16 layout=L2 fields=[0]
    v21 = FinishObject v20
    v22 = Call v0, -, v21
    v23 = Call v15, -, v3, v19, v22
    Return v23
}
function f1 name="whichOf" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = PropHas v0 key="kind"
    v2 = ToBoolean v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=10
    Return v3
  b2():
    v4 = PropHas v0 key="sort"
    v5 = ToBoolean v4
    Branch v5 -> taken b3(), notTaken b4()
  b3():
    v6 = Integer integer=100
    Return v6
  b4():
    v7 = Integer integer=-1000
    Return v7
}
