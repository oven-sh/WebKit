# The test for a class goes by the type of the cell: it passes for every instance, whoever made it and whatever it inherits from, and for nothing else.
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (name, test, make) => { const map = new Map([[1, 2]]), set = new Set([1]); const values = { MapIterator: make => [map.entries(), map.keys(), map.values(), map[Symbol.iterator](), Object.setPrototypeOf(map.entries(), null), new (class extends Map {})().entries(), make(map)], SetIterator: make => [set.values(), set.keys(), set.entries(), set[Symbol.iterator](), Object.setPrototypeOf(set.values(), null), new (class extends Set {})().values(), make(set)], others: () => [Object.create(Object.getPrototypeOf(map.entries())), Object.getPrototypeOf(map.entries()), Object.create(Object.getPrototypeOf(set.values())), Object.getPrototypeOf(set.values()), "a"[Symbol.iterator](), map, set, {}, [], () => 1, 1, "a", null, undefined] }; let all = 0, passed = 0, passedWrongly = 0; for (const key in values) { const list = values[key](key === name ? make : id); for (let index = 0; index < list.length; index++) { if (key === name) all++; if (test(list[index])) key === name ? passed++ : passedWrongly++; } } print(name, passed, "of", all, "and", passedWrongly, "others"); };
# CHECK: MapIterator 7 of 7 and 0 others
# CHECK-NEXT: SetIterator 7 of 7 and 0 others
# CHECK-NEXT: exited with 0

