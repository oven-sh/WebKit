# Both sides of a conditional branch get a counter word, numbered across functions. A switch has one word for all its cases and one for the default
# FORM: Selected
# OPTIONS: count-branches
# RUN: branch-counters
# CHECK: function f0
# CHECK-NEXT: b0 counters: [0 1] position: 10 negated: no
# CHECK-NEXT: b1 counters: [2 3] position: 10 negated: yes
# CHECK-NEXT: b2 counters: [4 5] position: 30 negated: no
# CHECK-NEXT: function f2
# CHECK-NEXT: b1 counters: [6 7] position: 40 negated: no
# CHECK-NEXT: function f3
# CHECK-NEXT: b0 counters: [8 9] position: 50 negated: no
# CHECK-NOT: counters

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Null
    v3 = StrictEq v1, v2 @10
    Branch v3 -> taken b1(), notTaken b4()
  b1():
    v4 = LogicalNot v3 @20
    Branch v4 -> taken b2(), notTaken b4()
  b2():
    v5 = TypeTest v1 testedType=undefined|null @30
    TestAndBranch v5 -> taken b3(), notTaken b4()
  b3():
    Return
  b4():
    Return
}
function f1 name="withoutBranch" results=[{type=undefined}] {
    Return
}
function f2 name="testWithoutPosition" parameters=[{type=boolean}, {type=anything}] results=[{type=undefined}] {
    Branch v0 -> taken b1(), notTaken b3()
  b1():
    v2 = Null
    v3 = StrictEq v1, v2 @40
    v4 = LogicalNot v3 @41
    v5 = LogicalNot v4 @42
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    Return
  b3():
    Return
}
function f3 name="switchOnInteger" parameters=[{type=i32}] results=[{type=undefined}] {
    Switch v0 cases=[0, 1] -> case b1(), case b1(), otherwise b2() @50
  b1():
    Return
  b2():
    Return
}
