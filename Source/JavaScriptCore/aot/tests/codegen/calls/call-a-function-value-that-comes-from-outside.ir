}
function f2 module=m0 role=Signature thisType={type=anything} results=[{type=anything}]

# Nobody knows the callee. The call goes through the stub that calls any value: the callee in one register, the argument boxed in another.
# CHECK-LABEL: name="apply" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[operation]] = ArgumentReg(
# CHECK: Int64 b@[[result]] = Patchpoint(b@[[operation]]:Register({{*}}), {{*}}:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:Call)
# The declared type of the result is only expected. An integer is tested for first, and added to without leaving the integers.
# CHECK: Int32 b@[[isInteger]] = AboveEqual(b@[[result]],
# CHECK-NEXT: Branch(b@[[isInteger]], Terminal,
# CHECK: Int32 b@[[integer]] = Trunc(b@[[result]],
# CHECK-LABEL: end of function
# NONE-LABEL: name="apply" role=Source
# NONE-NOT: Reads:AOTSlimClosure_word
# NONE-NOT: :CallDirect)
# NONE-LABEL: end of function
