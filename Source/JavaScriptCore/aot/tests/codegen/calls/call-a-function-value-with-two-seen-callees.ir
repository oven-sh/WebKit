# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK: Double b@[[second]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
