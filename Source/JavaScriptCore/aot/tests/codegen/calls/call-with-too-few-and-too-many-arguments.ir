# The parameter that may be missing travels in a floating-point register, where undefined is one bit pattern among the NaNs.
# CHECK-LABEL: name="describe" role=Source
# CHECK: Double b@[[unit]] = ArgumentReg(
# CHECK: Int64 b@[[bits]] = BitwiseCast(b@[[unit]],
# CHECK: Int32 b@[[isMissing]] = GreaterEqual(b@[[bits]],
# CHECK: Branch(b@[[isMissing]], Terminal,
# CHECK-LABEL: end of function
# Both calls are direct and pass two registers. The first passes that bit pattern. The third argument of the second has no parameter: it is not passed, and its product is not computed.
# CHECK-LABEL: name="describeBoth" role=Source
# CHECK: Double b@[[first]] = Patchpoint(b@[[value]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK: Double b@[[second]] = Patchpoint(b@[[value]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[first]], b@[[second]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="describeBoth" role=Source
# NONE-NOT: Mul(
# NONE-NOT: :Call)
# NONE-LABEL: end of function
# X64: instructions: 5, patchpoints: 0
# ARM64: instructions: 6, patchpoints: 0
