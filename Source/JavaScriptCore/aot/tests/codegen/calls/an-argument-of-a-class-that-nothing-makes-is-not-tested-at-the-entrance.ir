# class Host { name = "host"; }
# class Guest { name = "guest"; }
# class Holder {
#   #count: number;
#   constructor(count: number) { this.#count = count | 0; }
#   read(host: Host): number { return this.#count ^ host.name.length; }
#   greet(guest: Guest): number { return this.#count ^ guest.name.length; }
# }
# declare const input: any;
# declare function keep(value: unknown): void;
# keep(new Guest());
# const holder = new Holder(+input);
# (globalThis as any).answer = holder.read(input) + holder.greet(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f3
# REQUIRES: unsanitized-code
# RUN(GUEST): lower-to-b3 optimized f4
# REQUIRES(GUEST): unsanitized-code
# Nothing makes a Host, so `read` is one function: the private field is one load and the sum stands in the same body.
# CHECK-NOT: role=EntryChecks
# CHECK-LABEL: name="read" role=Source
# CHECK: = Load({{*}}:GetSlot)
# CHECK: = BitXor({{*}}:BitXor)
# CHECK-LABEL: end of function
# CHECK-NOT: role=GenericVersion
# CHECK-LABEL: name="read" role=GenericEntrypoint
# A Guest was handed out, so `greet` tests its argument once at the entrance.
# GUEST-LABEL: name="greet" role=EntryChecks
# GUEST: :TypeTest)
# GUEST-LABEL: name="greet" role=Source
# GUEST-LABEL: name="greet" role=GenericVersion

