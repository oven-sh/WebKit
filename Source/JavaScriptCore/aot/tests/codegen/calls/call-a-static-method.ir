# A static method is a function. The first call hands a number over in a register and gets one back. The last call is a jump: the frame is gone before it.
# CHECK-LABEL: name="quarter" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[half]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Void b@{{*}} = Patchpoint(b@[[half]]:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|{{*}}:CallDirect)
# CHECK-NEXT: end of function
# Nothing reads the class or its member: both calls go to the method itself.
# CALLS-LABEL: f1: size=
# CALLS-NEXT: function f3 x2
# CALLS-NEXT: f{{*}}: size=
