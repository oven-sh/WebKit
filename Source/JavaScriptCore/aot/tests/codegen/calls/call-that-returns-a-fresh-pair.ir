# The object that the callee makes only to return two numbers is never made. Both numbers come back in floating-point registers.
# CHECK-LABEL: name="roundTrip" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[dividend]] = ArgumentReg(
# CHECK-NEXT: Double b@[[divisor]] = ArgumentReg(
# CHECK-NEXT: Double, Double b@[[pair]] = Patchpoint(b@[[dividend]]:Register({{*}}), b@[[divisor]]:Register({{*}}), resultConstraints = [Register({{*}}), Register({{*}})], ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[quotient]] = Extract(b@[[pair]], <<0,
# CHECK-NEXT: Double b@[[remainder]] = Extract(b@[[pair]], <<1,
# CHECK-NEXT: Double b@[[product]] = Mul(b@[[divisor]], b@[[quotient]],
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[remainder]], b@[[product]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="roundTrip" role=Source
# NONE-NOT: Reads:ObjectFields
# NONE-NOT: :NewObject)
# NONE-LABEL: end of function
