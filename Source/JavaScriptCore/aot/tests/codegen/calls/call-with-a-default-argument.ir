# A number that may be missing travels in a floating-point register: undefined is one bit pattern among the NaNs. One comparison of the bits chooses the default.
# CHECK-LABEL: name="grow" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[step]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[bits]] = BitwiseCast(b@[[step]],
# CHECK: Int32 b@[[isMissing]] = GreaterEqual(b@[[bits]],
# CHECK-NEXT: Branch(b@[[isMissing]], Terminal,
# CHECK: Upsilon({{*}}, ^[[chosen]],
# CHECK: Double b@[[chosen]] = Phi(
# CHECK: Double b@[[grown]] = Add(b@{{*}}, b@[[chosen]],
# CHECK-NEXT: Return(b@[[grown]], Terminal)
# CHECK: Upsilon(b@[[step]], ^[[chosen]],
# CHECK-LABEL: end of function
# Both calls are direct and pass two floating-point registers. A call without the argument passes that bit pattern.
# CHECK-LABEL: name="growTwice" role=Source
# CHECK: Double b@[[first]] = Patchpoint(b@[[value]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK: Double b@[[tripled]] = Mul(b@[[value]],
# CHECK: Double b@[[second]] = Patchpoint(b@[[value]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[first]], b@[[second]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
