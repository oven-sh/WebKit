# function twiceOf(value: number): number {
#   if (value < 0) throw new RangeError("negative");
#   return value * 2;
# }
# declare const input: any;
# (globalThis as any).answer = twiceOf(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=170 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="twiceOf"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="twiceOf" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Less v0, v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="RangeError" [isFreeName]
    v6 = Convert v5 declared={type=builtin(RangeError) flags=[IsExpected]}
    v7 = String string="negative"
    v8 = Construct v6, -, v7 calleeName="RangeError"
    v9 = Convert v8 declared={type=undefined|null|RangeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    Throw v9
  b4(v10):
    Jump -> next b5()
  b5():
    v11 = Integer integer=2
    v12 = Mul v10, v11
    v13 = Convert v12 declared={type=number site=w1}
    Return v13
}

# The way that throws is rare. The likely way is a comparison, a branch, an addition and the return, and falls through.
# CHECK-LABEL: name="twiceOf" role=Source
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK: Int32 b@[[isNegative]] = LessThan(b@[[value]],
# CHECK-NEXT: Branch(b@[[isNegative]], Terminal,
# CHECK: BB#{{*}}: ; frequency = 0.99
# CHECK: Double b@[[twice]] = Add(b@[[value]], b@[[value]],
# CHECK-NEXT: Return(b@[[twice]], Terminal)
# CHECK: BB#{{*}}: ; frequency = 0.00
# CHECK: :ThrowNewError)
# CHECK-LABEL: end of function
# Every call stands behind the return.
# NONE-LABEL: name="twiceOf" role=Source
# NONE-NOT: Patchpoint(
# NONE: Return(
# NONE-LABEL: end of function
# X64: instructions: 4, patchpoints: 0, rare instructions: 2
# ARM64: instructions: 3, patchpoints: 0, rare instructions: 2
