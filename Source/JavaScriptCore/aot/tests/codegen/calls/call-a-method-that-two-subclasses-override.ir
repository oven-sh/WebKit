# Two classes override the method. One load of the receiver's shape word and one comparison choose between two direct calls, and each of them is a jump.
# CHECK-LABEL: name="areaOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[word]] = Load(b@[[shape]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord, {{*}}:TypeTest)
# CHECK: Int32 b@[[isFirst]] = Equal(b@[[word]],
# CHECK-NEXT: Branch(b@[[isFirst]], Terminal,
# CHECK: Void b@{{*}} = Patchpoint(b@[[shape]]:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|{{*}}:CallDirect)
# CHECK: Void b@{{*}} = Patchpoint(b@[[shape]]:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|{{*}}:CallDirect)
# CHECK-LABEL: end of function
# There is no second test, no read of the prototype and no call by name.
# NONE-LABEL: name="areaOf" role=Source
# NONE: Branch(
# NONE-NOT: Branch(
# NONE-NOT: PrototypeLinks
# NONE-NOT: MemberGuards
# NONE-NOT: JSCell_structureID
# NONE-LABEL: end of function
# CALLS: f1: size={{*}} frame=none
# CALLS-NEXT: function f4 x1
# CALLS-NEXT: function f6 x1
# CALLS-NEXT: f{{*}}: size=
# x86-64 compares the word in memory. The receiver is already where both methods expect it.
# X64: instructions: 1, patchpoints: 2
# ARM64: instructions: 2, patchpoints: 2
