# A method of a class that nobody changes is called like a function. The receiver goes in a register beside the number, and a number comes back in a register.
# CHECK-LABEL: name="addTwice" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[amount]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[counter]] = ArgumentReg(
# CHECK-NEXT: Double b@[[first]] = Patchpoint(b@[[amount]]:Register({{*}}), b@[[counter]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:CallDirect)
# CHECK: Double b@[[next]] = Add(b@[[amount]],
# CHECK-NEXT: Double b@[[second]] = Patchpoint(b@[[next]]:Register({{*}}), b@[[counter]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[first]], b@[[second]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# The method reads its field off the receiver it was handed.
# CHECK-LABEL: name="add" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[this]] = ArgumentReg(
# CHECK-NEXT: Double b@[[total]] = Load(b@[[this]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[step]] = ArgumentReg(
# CHECK-NEXT: Double b@[[newTotal]] = Add(b@[[step]], b@[[total]],
# CHECK-NEXT: Return(b@[[newTotal]], Terminal)
# CHECK-LABEL: end of function
# Nothing reads the method off the object or its prototype, nothing tests the shape of the receiver, and nothing is boxed.
# NONE-LABEL: name="addTwice" role=Source
# NONE-NOT: Branch(
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: MemberGuards
# NONE-NOT: BitwiseCast(
# NONE-NOT: IToD(
# NONE-LABEL: end of function
# Both calls go to the method itself, which needs no frame.
# CALLS-LABEL: f1: size=
# CALLS-NEXT: function f3 x2
# CALLS-NEXT: f2: size=
# CALLS: f3: size={{*}} frame=none
# X64: instructions: 2, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
