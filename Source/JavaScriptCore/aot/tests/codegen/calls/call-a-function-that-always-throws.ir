# function refuse(value: number): never {
#   throw new RangeError("negative: " + value);
# }
# function twiceOf(value: number): number {
#   if (value < 0) refuse(value);
#   return value * 2;
# }
# declare const input: any;
# (globalThis as any).answer = twiceOf(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls disable-in=0:1
# RUN: lower-to-b3 optimized f2
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f2
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# REQUIRES(CALLS): unsanitized-code
# RUN(X64): lower-to-air size f2
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f2
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 position=105 kind=Parameter function=f2
typesite w2 module=m0 position=88 kind=Result
typesite w3 module=m0 position=239 kind=CallResult
variable g0 name="refuse" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="twiceOf"
    v11 = Convert v10 declared={type=number site=w3}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="refuse" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="RangeError" [isFreeName]
    v3 = Convert v2 declared={type=builtin(RangeError) flags=[IsExpected]}
    v4 = String string="negative: "
    v5 = Add v4, v0
    v6 = Construct v3, -, v5 calleeName="RangeError"
    v7 = Convert v6 declared={type=undefined|null|RangeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    Throw v7
}
function f2 name="twiceOf" module=m0 position=88 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Less v0, v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = GetModuleVariable variable=g0
    v5 = Call v4, -, v3 calleeName="refuse"
    Jump -> next b5(v3)
  b4(v6):
    Jump -> next b5(v6)
  b5(v7: number):
    v8 = Integer integer=2
    v9 = Mul v7, v8
    v10 = Convert v9 declared={type=number site=w2}
    Return v10
}

# The callee always throws, so the block that calls it is rare and ends at the call. The likely way has no call, sets up no frame and moves nothing for it.
# CHECK-LABEL: name="twiceOf" role=Source
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK: Int32 b@[[isNegative]] = LessThan(b@[[value]],
# CHECK-NEXT: Branch(b@[[isNegative]], Terminal,
# CHECK: BB#{{*}}: ; frequency = 0.99
# CHECK: Double b@[[twice]] = Add(b@[[value]], b@[[value]],
# CHECK-NEXT: Return(b@[[twice]], Terminal)
# CHECK: BB#{{*}}: ; frequency = 0.00
# CHECK: Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:CallDirect)
# CHECK-NEXT: Oops(Terminal)
# CHECK-LABEL: end of function
