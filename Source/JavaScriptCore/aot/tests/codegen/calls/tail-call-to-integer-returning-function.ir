# function whole(x: number): number { return x | 0; }
# function halfOrWhole(x: number): number { return x > 0 ? x * 0.5 : whole(x); }
# declare const input: any;
# (globalThis as any).answer = halfOrWhole(+input) + whole(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1 f2
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1 f2
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=73 kind=Parameter function=f2
typesite w3 module=m0 position=52 kind=Result
typesite w4 module=m0 position=186 kind=CallResult
typesite w5 module=m0 position=208 kind=CallResult
typesite w6 module=m0 position=119 kind=CallResult
variable g0 name="whole" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="halfOrWhole"
    v11 = Convert v10 declared={type=number site=w4}
    v12 = GetModuleVariable variable=g0
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=number flags=[IsExpected]}
    v16 = ToNumber v15
    v17 = Call v12, -, v16 calleeName="whole"
    v18 = Convert v17 declared={type=number site=w5}
    v19 = Add v11, v18
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="whole" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = Convert v2 declared={type=number site=w1}
    Return v3
}
function f2 name="halfOrWhole" module=m0 position=52 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Greater v0, v1
    Branch v2 -> taken b2(| 0), notTaken b5(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Double number=0.5
    v5 = Mul v3, v4
    Jump -> next b4()
  b4():
    v6 = Convert v5 declared={type=number site=w3}
    Return v6
  b5(v7):
    Jump -> next b6()
  b6():
    v8 = GetModuleVariable variable=g0
    v9 = Call v8, -, v7 calleeName="whole"
    ReturnCall v9 casts=[{declared={type=number site=w6}}, {declared={type=number site=w3}}]
}

# One function returns integers alone, the other a fraction or what the first returns. The call in tail position is no jump: the tail calls of the callee come to an end, so the caller keeps its frame,
# converts the integer and returns it. Each returns its number in a register of its own kind.
# CHECK-LABEL: name="whole" role=Source
# CHECK: Int32 b@[[integer]] = Phi(
# CHECK-NEXT: Return(b@[[integer]], Terminal)
# CHECK-LABEL: name="halfOrWhole" role=Source
# CHECK: Double b@[[half]] = Mul(
# CHECK-NEXT: Return(b@[[half]], Terminal)
# CHECK: Int32 b@[[whole]] = Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[number]] = IToD(b@[[whole]])
# CHECK-NEXT: Return(b@[[number]], Terminal)
# CHECK-LABEL: end of function
# Nothing is boxed in either.
# NONE-LABEL: name="whole" role=Source
# NONE-NOT: ZExt32(
# NONE-LABEL: name="halfOrWhole" role=Source
# NONE-NOT: Int64 b@{{*}} = Patchpoint(
# NONE-NOT: BitwiseCast(
# NONE-LABEL: end of function
