# function half(value) {
#   return value / 2;
# }
# function twice(value) {
#   return half(value) + half(value + 1);
# }
# globalThis.answer = twice(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1 f2
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f2
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="half" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    v8 = Call v1, -, v7 calleeName="twice"
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    PropSet v4, v9 key="answer"
    v11 = Undefined
    Return v11
}
function f1 name="half" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=number flags=[IsExpected]}
    v2 = Integer integer=2
    v3 = Div v1, v2
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    Return v4
}
function f2 name="twice" module=m0 position=45 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = Convert v0 declared={type=number flags=[IsExpected]}
    v3 = Call v1, -, v2 calleeName="half"
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = GetModuleVariable variable=g0
    v6 = Integer integer=1
    v7 = Add v2, v6
    v8 = Call v5, -, v7 calleeName="half"
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    v10 = Add v4, v9
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    Return v11
}

# No type is written, and only numbers are ever handed in. The code is that of the typed program: the number goes in a floating-point register and one comes back.
# CHECK-LABEL: name="half" role=Source
# CHECK: Double b@[[halved]] = ArgumentReg(
# CHECK: Double b@[[half]] = Mul(b@[[halved]],
# CHECK-NEXT: Return(b@[[half]], Terminal)
# CHECK-LABEL: end of function
# CHECK-LABEL: name="twice" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[first]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK: Double b@[[next]] = Add(b@[[value]],
# CHECK-NEXT: Double b@[[second]] = Patchpoint(b@[[next]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[first]], b@[[second]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="twice" role=Source
# NONE-NOT: Reads:
# NONE-NOT: Branch(
# NONE-LABEL: end of function
