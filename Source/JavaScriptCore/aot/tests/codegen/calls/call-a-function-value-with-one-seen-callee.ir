# Only one function is ever handed in, so the parameter is gone and the call is direct: nothing loads or tests the callee, and the number stays in its register.
# CHECK-LABEL: name="apply" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[result]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK: Double b@[[sum]] = Add(b@[[result]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
