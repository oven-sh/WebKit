# function double(value: number): number {
#   return value * 2;
# }
# function apply(operation: (value: number) => number, value: number): number {
#   return operation(value) + 1;
# }
# declare const input: any;
# (globalThis as any).answer = apply(double, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f2
# REQUIRES: unsanitized-code
