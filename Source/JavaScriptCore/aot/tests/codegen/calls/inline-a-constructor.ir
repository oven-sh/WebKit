# The constructor is inlined, and the new object is only returned. So the part of the function that does the work makes no object: it hands both fields back in registers.
# CHECK-LABEL: name="mirror" role=ResultWorker
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[y]] = Load(b@[[point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Void b@{{*}} = Patchpoint(b@[[y]]:Register({{*}}), b@[[x]]:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|
# CHECK-LABEL: end of function
# A caller that needs the object goes through the copy that allocates it and stores the two registers.
# NONE-LABEL: name="mirror" role=ResultWrapper
# NONE: Double, Double b@[[pair]] = Patchpoint(b@{{*}}:Register({{*}}), resultConstraints = [Register({{*}}), Register({{*}})], {{*}}:CallDirect)
# NONE: Int64 b@[[object]] = Patchpoint({{*}}:NewObject)
# NONE-NEXT: Store(b@{{*}}, b@[[object]], offset = 16,
# NONE-NEXT: Store(b@{{*}}, b@[[object]], offset = 24,
# NONE-NOT: :CallDirect)
# NONE-LABEL: end of function
