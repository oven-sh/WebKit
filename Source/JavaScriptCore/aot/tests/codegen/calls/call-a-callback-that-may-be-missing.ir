# The callback is one known function or undefined. One comparison with undefined decides, and the call is direct.
# CHECK-LABEL: name="notify" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[listener]] = ArgumentReg(
# CHECK: Int32 b@[[isMissing]] = Equal(b@[[listener]], $10(
# CHECK-NEXT: Branch(b@[[isMissing]], Terminal,
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[answer]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Upsilon(b@[[answer]], ^[[result]],
# CHECK: Double b@[[result]] = Phi(
# CHECK: Double b@[[sum]] = Add(b@[[result]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# Nothing looks into the closure, the result is not tested for undefined, and nothing is boxed.
# NONE-LABEL: name="notify" role=Source
# NONE: Branch(
# NONE-NOT: Branch(
# NONE-NOT: AOTSlimClosure_word
# NONE-NOT: BitwiseCast(
# NONE-NOT: IToD(
# NONE-LABEL: end of function
# CALLS-LABEL: f1: size=
# CALLS-NEXT: function f2 x1
# CALLS-NEXT: f{{*}}: size=
