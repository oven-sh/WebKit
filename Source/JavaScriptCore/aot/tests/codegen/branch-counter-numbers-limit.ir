# Past the limit a side of a branch has no counter word
# FORM: Selected
# OPTIONS: count-branches limit=BranchCounters:3
# RUN: branch-counters
# LOSS: BranchCounters x1 f0
# CHECK: function f0
# CHECK-NEXT: b0 counters: [0 1] position: 10 negated: no
# CHECK-NEXT: b1 counters: [2 -] position: 10 negated: yes
# CHECK-NEXT: b2 counters: [- -] position: 30 negated: no
# CHECK-NEXT: function f1
# CHECK-NEXT: b0 counters: [- -] position: 40 negated: no
# CHECK-NOT: counters

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Null
    v3 = StrictEq v1, v2 @10
    Branch v3 -> taken b1(), notTaken b4()
  b1():
    v4 = LogicalNot v3 @20
    Branch v4 -> taken b2(), notTaken b4()
  b2():
    v5 = TypeTest v1 testedType=undefined|null @30
    TestAndBranch v5 -> taken b3(), notTaken b4()
  b3():
    Return
  b4():
    Return
}
function f1 name="pastLimit" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Null
    v2 = StrictEq v0, v1 @40
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
