# The shape word of an object is written at its creation alone. So a shape test that is repeated behind a call of unknown code, or behind the join with an arm that calls some, is folded: the read by name on its failing side is gone
# FORM: Selected
# OPTIONS: heat=everything-is-hot
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"
layout L0 name="A" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled}}]
layout L1 name="B" fields=[{key="x" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled}}]
function f0 name="allocate" parameters=[{type=number}] results=[{type=undefined}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = NewObject -, v0 layout=L1 fields=[0]
    Return
}
function f1 name="behindCall" parameters=[{type=object}, {type=anything}] results=[{type=anything}] {
  b0(v0: object, v1: anything):
    SwitchOnShape v0 layoutSets=[[L0]] -> case b1(), otherwise b4()
  b1():
    v2 = Call v1
    SwitchOnShape v0 layoutSets=[[L0]] -> case b2(), otherwise b3()
  b2():
    Return v2
  b3():
    v3 = PropGet v0 key="y"
    Return v3
  b4():
    Return
}
function f2 name="behindJoin" parameters=[{type=object}, {type=anything}, {type=boolean}] results=[{type=anything}] {
  b0(v0: object, v1: anything, v2: boolean):
    SwitchOnShape v0 layoutSets=[[L0]] -> case b1(), otherwise b6()
  b1():
    Branch v2 -> taken b2(), notTaken b3()
  b2() frequency=Unlikely:
    v3 = Call v1
    Jump -> next b3()
  b3():
    SwitchOnShape v0 layoutSets=[[L0]] -> case b4(), otherwise b5()
  b4():
    v4 = Integer integer=1
    Return v4
  b5():
    v5 = PropGet v0 key="y"
    Return v5
  b6():
    Return
}
# CHECK: f1: size={{*}}
# CHECK-NOT: GetById
# CHECK: f2: size={{*}}
# CHECK-NOT: GetById
