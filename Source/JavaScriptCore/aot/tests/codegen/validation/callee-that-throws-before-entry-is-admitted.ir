# An arrow function that is constructed throws before it is entered: the stamp of the construction lists nothing, and in a validating build the test of the stamp admits the arrow function. The call beside it enters its callee, which its stamp lists
# OPTIONS: validate
# RUN: pipeline ApplyFlowResults

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Call v0
    Return v1
}
# CHECK-LABEL: function f0 name="main"
# CHECK: [[arrow]]: f1 = NewClosure function=f1
# CHECK: ValidateCallee [[arrow]] validatedType=f1
# CHECK-NEXT: = Call [[arrow]] {{*}}callees=[f1]

function f1 name="arrow" kind=Arrow results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = Construct v0, v0
    Return v1
}
# CHECK-LABEL: function f1 name="arrow"
# CHECK: [[inner]]: f2 = NewClosure function=f2
# CHECK: ValidateCallee [[inner]] validatedType=f2
# CHECK-NEXT: = Construct [[inner]], [[inner]] {{*}}callees=[]

function f2 name="neverEntered" kind=Arrow results=[{type=anything}] {
  b0():
    Return
}
