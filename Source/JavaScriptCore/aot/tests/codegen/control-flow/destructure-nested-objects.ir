# A pattern inside a pattern is a load of the inner object and a load of its field. The inner objects are not tested: their layout is proven.
# CHECK-LABEL: name="widthOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[line]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[start]] = Load(b@[[line]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[left]] = Load(b@[[start]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int64 b@[[end]] = Load(b@[[line]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[right]] = Load(b@[[end]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[width]] = Sub(b@[[right]], b@[[left]], {{*}}:Sub)
# CHECK-NEXT: Return(b@[[width]], Terminal)
# CHECK-LABEL: end of function
