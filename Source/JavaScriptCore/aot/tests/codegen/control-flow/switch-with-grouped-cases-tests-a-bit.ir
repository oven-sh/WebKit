# function isVowel(code: number): boolean {
#   switch (code) {
#     case 97: case 101: case 105: case 111: case 117:
#       return true;
#     default:
#       return false;
#   }
# }
# declare const input: any;
# (globalThis as any).answer = isVowel(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=226 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="isVowel"
    v12 = Convert v11 declared={type=boolean site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="isVowel" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    Switch v0 cases=[97, 101, 105, 111, 117] -> case b2(| 0), case b3(| 0), case b4(| 0), case b5(| 0), case b6(| 0), otherwise b8()
  b2(v1):
    Jump -> next b7()
  b3(v2):
    Jump -> next b7()
  b4(v3):
    Jump -> next b7()
  b5(v4):
    Jump -> next b7()
  b6(v5):
    Jump -> next b7()
  b7():
    v6 = Boolean boolean=true
    v7 = Convert v6 declared={type=boolean site=w1}
    Return v7
  b8():
    Jump -> next b9()
  b9():
    v8 = Boolean
    v9 = Convert v8 declared={type=boolean site=w1}
    Return v9
}

# Five cases that share one arm and lie within 64 values: one test of the range, then one bit of a constant mask. 1065233 has the bits 0, 4, 8, 14 and 20.
# CHECK-LABEL: name="isVowel" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int32 b@[[distance]] = Add(b@{{*}}, $-97(
# CHECK: Int32 b@[[isInRange]] = Below(b@[[distance]], $21(
# CHECK-NEXT: Branch(b@[[isInRange]], Terminal)
# CHECK-NEXT: Successors: Then:#[[inRange]], Else:#{{*}}
# CHECK-NEXT: BB#[[inRange]]:
# CHECK: Int64 b@[[shifted]] = ZShr($1065233(b@{{*}}), b@[[distance]])
# CHECK: Int64 b@[[bit]] = BitAnd(b@[[shifted]], $1(
# CHECK-NEXT: Branch(b@[[bit]], Terminal)
# CHECK-NOT: Branch(
# CHECK-NOT:  = Equal(
# CHECK-LABEL: end of function
# X64: instructions: 8, patchpoints: 0
# ARM64: instructions: 9, patchpoints: 0
