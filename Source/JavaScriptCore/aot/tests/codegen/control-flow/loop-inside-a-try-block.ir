# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=233 kind=CallResult
typesite w3 module=m0 position=227 kind=CallResult
typesite w4 module=m0 position=51 kind=Variable
typesite w5 module=m0 position=81 kind=Variable
typesite w6 module=m0 position=92 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=Float64Array
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Construct v6, -, v8 calleeName="Float64Array"
    v10 = Convert v9 declared={type=undefined|null|Float64Array site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    v11 = Call v1, -, v10 calleeName="total"
    v12 = Convert v11 declared={type=number site=w3}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="total" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Float64Array site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Float64Array):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number site=w4}
    Jump -> next b2()
  b2() handler=b11():
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w5}
    Jump -> next b3(v2, v4)
  b3(v5: number, v6: number) handler=b11():
    LoopHint
    v8 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v9 = PropGet v0 key="length"
    v10 = Convert v9 declared={type=number site=w6} illTypedCause=Assertion
    v11 = Less v8, v10
    Branch v11 -> taken b4(| 0), notTaken b8(| 0)
  b4(v12) handler=b11():
    Jump -> next b5()
  b5() handler=b11():
    v13 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v14 = ElemGet v0, v13
    v15 = Add v5, v14
    v16 = Convert v15 declared={type=number site=w4}
    Jump -> next b6()
  b6() handler=b11():
    Jump -> next b7()
  b7() handler=b11():
    v17 = Increment v13
    v18 = Convert v17 declared={type=number site=w5}
    Jump -> next b3(v16, v18)
  b8(v19) handler=b11():
    Jump -> next b9()
  b9() handler=b11():
    Jump -> next b10()
  b10():
    Jump -> next b12(v5)
  b11() role=CatchHandler:
    v20 = CatchValue
    v21 = Integer integer=-1
    v22 = Convert v21 declared={type=number site=w4}
    Jump -> next b12(v22)
  b12(v23: number):
    v24 = Convert v23 declared={type=number site=w1}
    Return v24
}

# Nothing in this loop allocates, so its poll has no error to throw to the handler and the handler goes. The loop is the one that stands outside a try block: eight elements a turn,
# no poll, no test of the view, no reload of its length or of the address of its elements. Its only branch is the loop condition.
# CHECK-LABEL: steps by 8
# CHECK-NOT: Branch(
# CHECK-NOT: LoopHint
# CHECK-NOT: Reads:JSArrayBufferView
# CHECK: Double b@{{*}} = Load(b@{{*}}, ControlDependent|Reads:TypedArrayElements
# REPEAT: turn = 1..7
# CHECK: Double b@{{*}} = Load(b@{{*}}, offset = %(turn*8), ControlDependent|Reads:TypedArrayElements
# END REPEAT
# CHECK-NOT: Reads:TypedArrayElements
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK-NOT: Branch(
# CHECK-NOT: LoopHint
# CHECK-LABEL: end of loop
# No poll in the function is the end of a block with a way to a handler.
# CHECK-NOT: Terminal|ExitsSideways{{*}}:LoopHint
# CHECK-LABEL: end of function
# X64: instructions: 10, patchpoints: 8, {{*}} steps by 8
# ARM64: instructions: 19, patchpoints: 8, {{*}} steps by 8
