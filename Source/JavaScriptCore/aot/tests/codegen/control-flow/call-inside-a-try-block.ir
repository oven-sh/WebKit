# declare const input: any;
# (globalThis as any).answer = safe(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f2
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f2
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f2
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=140 kind=Parameter function=f1
typesite w1 module=m0 position=125 kind=Result
typesite w2 module=m0 position=30 kind=Parameter function=f2
typesite w3 module=m0 position=16 kind=Result
typesite w4 module=m0 position=293 kind=CallResult
typesite w5 module=m0 position=74 kind=CallResult
variable g0 name="check" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="safe"
    v11 = Convert v10 declared={type=number site=w4}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="check" module=m0 position=125 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Less v0, v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="RangeError" [isFreeName]
    v6 = Convert v5 declared={type=builtin(RangeError) flags=[IsExpected]}
    v7 = String string="negative"
    v8 = Construct v6, -, v7 calleeName="RangeError"
    v9 = Convert v8 declared={type=undefined|null|RangeError flags=[IsExpected, OmitsNull, OmitsUndefined]}
    Throw v9
  b4(v10):
    Jump -> next b5()
  b5():
    v11 = Integer integer=2
    v12 = Mul v10, v11
    v13 = Convert v12 declared={type=number site=w1}
    Return v13
}
function f2 name="safe" module=m0 position=16 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    Jump -> next b2()
  b2() handler=b3():
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="check"
    v3 = Convert v2 declared={type=number site=w5}
    v4 = Integer integer=1
    v5 = Add v3, v4
    v6 = Convert v5 declared={type=number site=w3}
    Return v6
  b3() role=CatchHandler:
    v7 = CatchValue
    v8 = Integer integer=-1
    v9 = Convert v8 declared={type=number site=w3}
    Return v9
}

# The call ends its block and has two ways on: the next block, and the handler behind a rare edge. The way without an exception tests nothing after the call.
# CHECK-LABEL: name="safe" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[checked]] = Patchpoint(b@[[value]]:Register({{*}}Terminal|ExitsSideways{{*}}:CallDirect)
# CHECK-NEXT: Successors: #[[next]], Rare:#[[handler]]
# CHECK-NEXT: BB#[[next]]:
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint
# CHECK: Double b@[[sum]] = Add(b@[[checked]], 
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-NEXT: BB#[[handler]]:
# CHECK-LABEL: end of function
# Beside the call: set up the frame, add, leave the frame, return. The handler's instructions all count as rare.
# The function has calls, and Windows passes arguments in other registers: its count is not checked.
# X64: instructions: 4, patchpoints: 1, rare instructions: 6
# ARM64: instructions: 5, patchpoints: 1, rare instructions: 5
