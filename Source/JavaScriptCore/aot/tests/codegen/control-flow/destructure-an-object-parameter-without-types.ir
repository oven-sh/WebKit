# function areaOf({ width, height }) {
#   return width * height;
# }
# globalThis.answer = areaOf({ width: +input, height: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 fields=[{key="height" declared={type=anything}}, {key="width" declared={type=anything}}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    v8 = NewObject layout=L0
    PropDefine v8, v7 key="width"
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = ToNumber v11
    PropDefine v8, v12 key="height"
    v14 = FinishObject v8
    v15 = Call v1, -, v14 calleeName="areaOf"
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    PropSet v4, v16 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="areaOf" module=m0 position=69 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3() frequency=Unlikely:
    v3 = NewRuntimeError runtimeError=NotDestructurable name="width"
    Throw v3
  b4(v4):
    v5 = PropGet v4 key="width"
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = PropGet v4 key="height"
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Mul v6, v8
    v10 = Convert v9 declared={type=number flags=[IsExpected]}
    Return v10
}

# A pattern in the place of a parameter reads each named field by one load off the object: no test of the object, no copy, no call.
# CHECK-LABEL: name="areaOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[size]] = ArgumentReg(
# CHECK-NEXT: Double b@[[width]] = Load(b@[[size]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[height]] = Load(b@[[size]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[area]] = Mul(b@[[width]], b@[[height]], {{*}}:Mul)
# CHECK-NEXT: Return(b@[[area]], Terminal)
# CHECK-LABEL: end of function
# x86-64 multiplies by the second field from memory. ARM64 loads both.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 4, patchpoints: 0
