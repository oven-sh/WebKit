# Each `?.` is one comparison with null, and both go to the one block that makes the default. Nothing tests for undefined, no value in between is made, and `??` tests nothing again.
# CHECK-LABEL: name="secondValue" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int32 b@[[nodeIsNull]] = Equal(b@[[node]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[nodeIsNull]], Terminal
# CHECK-NEXT: Successors: Then:Unlikely:#[[default]], Else:#
# CHECK: Int64 b@[[next]] = Load(b@[[node]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int32 b@[[nextIsNull]] = Equal(b@[[next]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[nextIsNull]], Terminal
# CHECK-NEXT: Successors: Then:Unlikely:#[[default]], Else:#
# CHECK-NOT: Branch(
# CHECK: Double b@{{*}} = Load(b@[[next]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: Branch(
