# function* sums(first: number, second: number) {
#   yield first;
#   yield second;
#   yield first + second;
# }
# declare const input: any;
# (globalThis as any).answer = sums(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 position=30 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="sums"
    v15 = Convert v14 declared={type=undefined|null|Generator<number> flags=[IsExpected, OmitsNull, OmitsUndefined]}
    PropSet v5, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="sums" module=m0 flags=[IsGenerator, HasThis, TakesCallee, IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=undefined|null|Generator<number> flags=[IsExpected, OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, IsNeverCalledByHost] {
  b0(v0: anything, v1: function, v2: number, v3: number):
    Jump -> next b1()
  b1():
    InitialYield v2, v3
    v5 = Convert v2 declared={type=number site=w2}
    v6 = Yield v5, v2, v3
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Switch v8 cases=[1, 2] -> case b2(), case b3(), otherwise b4()
  b2():
    Throw v7
  b3():
    Return v7
  b4():
    v9 = Convert v3 declared={type=number site=w2}
    v10 = Yield v9, v2, v3
    v11 = ResultAt v10
    v12 = ResultAt v10 index=1
    Switch v12 cases=[1, 2] -> case b5(), case b6(), otherwise b7()
  b5():
    Throw v11
  b6():
    Return v11
  b7():
    v13 = Add v2, v3
    v14 = Convert v13 declared={type=number site=w2}
    v15 = Yield v14, v2, v3
    v16 = ResultAt v15
    v17 = ResultAt v15 index=1
    Switch v17 cases=[1, 2] -> case b8(), case b9(), otherwise b10()
  b8():
    Throw v16
  b9():
    Return v16
  b10():
    v18 = Undefined
    Return v18
}

# A yield is one operation that saves the frame and comes back with what the caller of next(), throw() or return() sent and with which of the three it was. Two tests follow it, both with a rare arm: throw, return.
# The body runs from top to bottom: no switch over a state picks the place to go on at.
# CHECK-LABEL: name="sums" role=CoroutineBody
# REPEAT: turn = 1..3
# CHECK: Int64, Int64 b@[[resumed%(turn)]] = Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}:YieldBySavingFrame)
# CHECK: Int64 b@[[wideMode%(turn)]] = Extract(b@[[resumed%(turn)]], <<1
# CHECK-NEXT: Int32 b@[[mode%(turn)]] = Trunc(b@[[wideMode%(turn)]]
# CHECK: Equal(b@[[mode%(turn)]], $1(
# CHECK: Successors: Then:Rare:#{{*}}, Else:#
# CHECK: Equal(b@[[mode%(turn)]], $2(
# CHECK: Successors: Then:Rare:#{{*}}, Else:#
# END REPEAT
# CHECK-LABEL: end of function
# The parameters are the same values in front of a yield and behind it. The only read of the generator object is the one at the entry, which asks whether this is the first step.
# NONE-LABEL: name="sums" role=CoroutineBody
# NONE-NOT: Switch(
# NONE: Load(b@{{*}}, offset = 24, ControlDependent|Reads:InternalFields, {{*}}:IsGeneratorRunning)
# NONE-NOT: Switch(
# NONE-NOT: Reads:InternalFields
# NONE-NOT: Writes:InternalFields
# NONE: Double b@{{*}} = Add(b@{{*}}, b@{{*}}, {{*}}:Add)
# NONE-LABEL: end of function
# Both numbers are stored into the frame once, at the entry, and each yield reads what it needs from there.
# X64-LABEL: role=CoroutineBody
# X64: EnterFrame
# X64: MoveDouble %xmm0, -[[first]](%rbp)
# X64-NEXT: MoveDouble %xmm1, -[[second]](%rbp)
# X64-NOT: MoveDouble %xmm{{*}}, -
# X64: AddDouble -[[first]](%rbp), %xmm
# X64-NOT: MoveDouble %xmm{{*}}, -
# X64-LABEL: end of function
# ARM64-LABEL: role=CoroutineBody
# ARM64: EnterFrame
# ARM64: MoveDouble %q0, -[[first]](%fp)
# ARM64-NEXT: MoveDouble %q1, -[[second]](%fp)
# ARM64-NOT: MoveDouble %q{{*}}, -
# ARM64: AddDouble %q
# ARM64-NOT: MoveDouble %q{{*}}, -
# ARM64-LABEL: end of function
