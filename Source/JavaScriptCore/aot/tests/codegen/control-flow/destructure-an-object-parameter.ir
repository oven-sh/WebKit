# function areaOf({ width, height }: { width: number; height: number }): number {
#   return width * height;
# }
# declare const input: any;
# (globalThis as any).answer = areaOf({ width: +input, height: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=85 kind=Parameter function=f1
typesite w1 module=m0 position=69 kind=Result
typesite w2 module=m0 position=231 kind=CallResult
layout L0 module=m0 position=104 fields=[{key="height" declared={type=number} flags=[IsRequired]}, {key="width" declared={type=number} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[1, 0]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="areaOf"
    v19 = Convert v18 declared={type=number site=w2}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="areaOf" module=m0 position=69 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3() frequency=Unlikely:
    v3 = NewRuntimeError runtimeError=NotDestructurable name="width"
    Throw v3
  b4(v4):
    v5 = PropGet v4 key="width"
    v6 = Convert v5 declared={type=number} illTypedCause=Assertion
    v7 = PropGet v4 key="height"
    v8 = Convert v7 declared={type=number} illTypedCause=Assertion
    v9 = Mul v6, v8
    v10 = Convert v9 declared={type=number site=w1}
    Return v10
}

# A pattern in the place of a parameter reads each named field by one load off the object: no test of the object, no copy, no call.
# CHECK-LABEL: name="areaOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[size]] = ArgumentReg(
# CHECK-NEXT: Double b@[[width]] = Load(b@[[size]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[height]] = Load(b@[[size]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[area]] = Mul(b@[[width]], b@[[height]], {{*}}:Mul)
# CHECK-NEXT: Return(b@[[area]], Terminal)
# CHECK-LABEL: end of function
# x86-64 multiplies by the second field from memory. ARM64 loads both.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 4, patchpoints: 0
