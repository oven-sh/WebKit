# enum Direction { Up, Down, Left, Right }
# function step(direction: Direction, position: number, width: number): number {
#   switch (direction) {
#     case Direction.Up: return position - width;
#     case Direction.Down: return position + width;
#     case Direction.Left: return position - 1;
#     case Direction.Right: return position + 1;
#   }
# }
# declare const input: any;
# (globalThis as any).answer = step(input | 0, +input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=55 kind=Parameter function=f1
typesite w1 module=m0 position=77 kind=Parameter function=f1
typesite w2 module=m0 position=95 kind=Parameter function=f1
typesite w3 module=m0 position=41 kind=Result
typesite w4 module=m0 position=395 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = Undefined
    v1 = NewClosure function=f1
    v2 = Convert v1 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="globalThis" [isFreeName]
    v5 = Convert v4 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v6 = Convert v5 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Convert v8 declared={type=i32 flags=[IsExpected]}
    v10 = Integer
    v11 = BitOr v9, v10
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=number flags=[IsExpected]}
    v15 = ToNumber v14
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=number flags=[IsExpected]}
    v19 = ToNumber v18
    v20 = Call v2, -, v11, v15, v19 calleeName="step"
    v21 = Convert v20 declared={type=number site=w4}
    PropSet v6, v21 key="answer"
    v23 = Undefined
    Return v23
}
function f1 name="step" module=m0 position=41 flags=[IsChecked, HasExplicitName] length=3 thisType={type=anything} parameters=[{type=i32 site=w0}, {type=number site=w1}, {type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: i32, v1: number, v2: number):
    Jump -> next b1()
  b1():
    Switch v0 cases=[0, 1, 2, 3] -> case b2(| 0), case b4(| 0), case b6(| 0), case b8(| 0), otherwise b10()
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Sub v1, v2
    v5 = Convert v4 declared={type=number site=w3}
    Return v5
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = Add v1, v2
    v8 = Convert v7 declared={type=number site=w3}
    Return v8
  b6(v9):
    Jump -> next b7()
  b7():
    v10 = Integer integer=1
    v11 = Sub v1, v10
    v12 = Convert v11 declared={type=number site=w3}
    Return v12
  b8(v13):
    Jump -> next b9()
  b9():
    v14 = Integer integer=1
    v15 = Add v1, v14
    v16 = Convert v15 declared={type=number site=w3}
    Return v16
  b10():
    Jump -> next b11()
  b11():
    v17 = Undefined
    v18 = Convert v17 declared={type=number site=w3} illTypedCause=FromLooseType
    Return v18
}

# Four cases are too few for a table: the value is compared in a tree, at most three tests deep. The type says that the four cases are all there is, and a number that is none of them still has to fall out of the switch.
# So the function may answer undefined: the block behind the last failed test returns the pattern of bits that stands for it in a floating-point register, and every arm returns its number there as it is. Nothing is boxed.
# The written result type excludes what that block returns, so both edges to it are rare.
# CHECK-LABEL: name="step" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NOT: pureFunction
# CHECK-NOT: BitwiseCast(
# CHECK: Int32 b@[[isUpOrDown]] = LessThan(b@[[direction]], $2(
# CHECK: Branch(b@[[isUpOrDown]], Terminal)
# CHECK: Branch(b@[[direction]], Terminal)
# CHECK: Equal(b@[[direction]], $1(
# CHECK: Successors: Then:#{{*}}, Else:Rare:#[[fallsOut]]
# CHECK: Double b@[[down]] = Add(b@[[position]], b@[[width]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[down]], Terminal)
# CHECK-NOT: pureFunction
# CHECK-NOT: BitwiseCast(
# CHECK: Double b@[[undefined]] = Load(b@
# CHECK-NEXT: Return(b@[[undefined]], Terminal)
# CHECK-NOT: pureFunction
# CHECK-NOT: BitwiseCast(
# CHECK: Equal(b@[[direction]], $2(
# CHECK: Equal(b@[[direction]], $3(
# CHECK: Successors: Then:#{{*}}, Else:Rare:#[[fallsOut]]
# CHECK-LABEL: end of function
