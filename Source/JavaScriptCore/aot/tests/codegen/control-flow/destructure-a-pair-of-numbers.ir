# `const [x, y] = pair` makes no iterator: each name is a load from the storage of the array. One test asks for double storage.
# In front of each load the index is compared with the length once, on its 32 bits: the step of the iteration and the bounds check of the read are one test.
# CHECK-LABEL: name="squaredLength" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:HasArrayStorage)
# CHECK: Int64 b@[[storage]] = Load(b@[[pair]], offset = 8, ControlDependent|Reads:JSArray_butterfly
# CHECK-NEXT: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength
# CHECK-NOT: ZExt32(b@[[length]]
# CHECK: Branch(b@[[length]], Terminal, {{*}}:IsInBounds)
# CHECK: Double b@[[x]] = Load(b@[[storage]], ControlDependent|Reads:indexedDoubleProperties_0, {{*}}:GetArrayElement)
# CHECK: Above(b@[[length]], $1({{*}}:IsInBounds)
# CHECK: Double b@[[y]] = Load(b@[[storage]], offset = 8, ControlDependent|Reads:indexedDoubleProperties_1, {{*}}:GetArrayElement)
# CHECK-LABEL: end of function
# The function has calls, and Windows passes arguments in other registers: its count is not checked.
# X64: instructions: 14, patchpoints: 0, rare instructions: 40
# ARM64: instructions: 15, patchpoints: 0, rare instructions: 45
