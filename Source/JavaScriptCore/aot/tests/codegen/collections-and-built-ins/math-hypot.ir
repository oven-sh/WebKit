# function distance(x: number, y: number): number {
#   return Math.hypot(x, y);
# }
# declare const input: any;
# (globalThis as any).answer = distance(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=18 kind=Parameter function=f1
typesite w1 module=m0 position=29 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=134 kind=CallResult
typesite w4 module=m0 position=59 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="distance"
    v15 = Convert v14 declared={type=number site=w3}
    PropSet v5, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="distance" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Builtin builtin=Math
    v3 = Builtin builtin=MathHypot
    v4 = Call v3, v2, v0, v1 calleeName="Math.hypot"
    ReturnCall v4 casts=[{declared={type=number site=w4}}, {declared={type=number site=w2}}]
}

# Math.hypot of two numbers is one call of a pure function: both operands and the result stay doubles in registers. Nothing loads or tests Math or its member.
# CHECK-LABEL: name="distance" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[x]] = ArgumentReg(
# CHECK-NEXT: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Double b@[[distance]] = Patchpoint(b@[[x]]:Register({{*}}), b@[[y]]:Register({{*}}), resultConstraints = Register({{*}}), pureFunction = {{*}}(children), ControlDependent, {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[distance]], Terminal)
# CHECK-LABEL: end of function
# The counts hold a call, whose moves follow the calling convention: not for Windows.
# X64: instructions: 3, patchpoints: 1
# ARM64: instructions: 3, patchpoints: 1
