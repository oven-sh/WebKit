}
function f1 name="last" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="at"
    v2 = Integer integer=-1
    v3 = Call v1, v0, v2 calleeKey="at" calleeName="list.at"
    v4 = Convert v3 declared={type=undefined|number site=w6} illTypedCause=FromLooseType
    v5 = TypeTest v4 testedType=undefined|null
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
