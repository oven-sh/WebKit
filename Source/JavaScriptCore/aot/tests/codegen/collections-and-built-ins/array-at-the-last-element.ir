# function last(list: number[]): number {
#   return list.at(-1) ?? 0;
# }
# declare const input: any;
# const list: number[] = [];
# list.push(input | 0);
# (globalThis as any).answer = last(list);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(ONCE): lower-to-b3 optimized f1
# REQUIRES(ONCE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=101 kind=Variable
typesite w1 module=m0 position=14 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=122 kind=CallResult
typesite w4 module=m0 position=173 kind=CallResult
typesite w5 module=m0 position=49 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v8 = Integer
    v9 = BitOr v7, v8
    v10 = Call v4, v3, v9 calleeKey="push" calleeName="list.push"
    v11 = Convert v10 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = Call v1, -, v3 calleeName="last"
    v17 = Convert v16 declared={type=number site=w4}
    PropSet v15, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="last" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="at"
    v2 = Integer integer=-1
    v3 = Call v1, v0, v2 calleeKey="at" calleeName="list.at"
    v4 = Convert v3 declared={type=undefined|number site=w5} illTypedCause=FromLooseType
    v5 = TypeTest v4 testedType=undefined|null
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
    Jump -> next b3()
  b3():
    v7 = Integer
    Jump -> next b5(v7)
  b4(v8):
    Jump -> next b5(v8)
  b5(v9):
    v10 = Convert v9 declared={type=number site=w2}
    Return v10
}

# at(-1) is written out: the length is loaded, one is taken off, and one unsigned comparison with the length catches the empty list.
# CHECK-LABEL: name="last" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[storage]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly)
# CHECK-NEXT: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength)
# CHECK-NEXT: Int64 b@[[wide]] = ZExt32(b@[[length]])
# CHECK: Int64 b@[[index]] = Add(b@[[wide]], $-1(b@{{*}}))
# CHECK-NEXT: Int32 b@[[inside]] = Above(b@[[wide]], b@[[index]])
# CHECK: Branch(b@[[inside]], Terminal)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# The kind of storage is compared with integers first, and that arm is one load of the element.
# CHECK: Int32 b@[[byte]] = Load8Z(b@[[list]], offset = 4, ControlDependent|Reads:JSCell_indexingTypeAndMisc)
# CHECK: Int32 b@[[kind]] = BitAnd(b@[[byte]], $14(b@{{*}}))
# CHECK: Int32 b@[[isIntegers]] = Equal(b@[[kind]], $4(b@{{*}}))
# CHECK: Branch(b@[[isIntegers]], Terminal)
# CHECK: Int64 b@{{*}} = Load(b@{{*}}, offset = -8, ControlDependent|Reads:indexedInt32Properties)
# CHECK: Int32 b@{{*}} = Equal(b@[[kind]], $6(b@{{*}}))
# CHECK: Double b@{{*}} = Load(b@{{*}}, offset = -8, ControlDependent|Reads:indexedDoubleProperties)
# CHECK: Int32 b@{{*}} = Equal(b@[[kind]], $8(b@{{*}}))
# CHECK: Int64 b@{{*}} = Load(b@{{*}}, offset = -8, ControlDependent|Reads:indexedContiguousProperties)
# CHECK-LABEL: end of function
# The storage, the length and the kind are each loaded once. Only a list in none of the three kinds of storage calls Array.prototype.at itself.
# ONCE-LABEL: name="last" role=Source
# ONCE-COUNT-1: Reads:JSObject_butterfly
# ONCE-NOT: Reads:JSObject_butterfly
# ONCE-COUNT-1: Reads:Butterfly_publicLength
# ONCE-NOT: Reads:Butterfly_publicLength
# ONCE-COUNT-1: Reads:JSCell_indexingTypeAndMisc
# ONCE-NOT: Reads:JSCell_indexingTypeAndMisc
# ONCE-NOT: ExitsSideways
# ONCE: ExitsSideways{{*}}:CallBuiltin)
# ONCE-NOT: ExitsSideways
# ONCE-LABEL: end of function
# The counts hold a call, whose moves follow the calling convention: not for Windows.
# X64: instructions: 39, patchpoints: 4, rare instructions: 23
# ARM64: instructions: 42, patchpoints: 4, rare instructions: 24
