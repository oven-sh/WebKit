# LOOP-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# LOOP: Int64 b@[[answer]] = Patchpoint(b@{{*}}:Register({{*}}), b@{{*}}:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:CallBuiltin)
