module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=54 kind=Parameter function=f1
typesite w1 module=m0 position=39 kind=Result
typesite w2 module=m0 position=186 kind=CallResult
typesite w3 module=m0 position=87 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[0, 1]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="width"
    v19 = Convert v18 declared={type=number site=w2}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="width" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectHasOwn
    v3 = String string="x"
    v4 = Call v2, v1, v0, v3 calleeName="Object.hasOwn"
    v5 = Convert v4 declared={type=boolean site=w3} illTypedCause=DeclarationWithoutBody
    v6 = ToBoolean v5
    Branch v6 -> taken b2(| 0), notTaken b4(| 0)
  b2(v7):
    Jump -> next b3()
  b3():
    v8 = PropGet v0 key="x"
    Jump -> next b6(v8)
  b4(v9):
    Jump -> next b5()
  b5():
    v10 = Integer integer=-1
    Jump -> next b6(v10)
  b6(v11):
    v12 = Convert v11 declared={type=number site=w1}
    Return v12
}

# A required field of a proven layout is always there: the question folds away with its branch, and the field is one load.
