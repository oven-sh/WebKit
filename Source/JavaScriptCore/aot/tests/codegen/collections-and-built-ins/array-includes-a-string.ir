}
function f1 name="has" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|string> site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<undefined|null|string>, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="includes"
    v3 = Call v2, v0, v1 calleeKey="includes" calleeName="list.includes"
    ReturnCall v3 casts=[{declared={type=boolean site=w8}}, {declared={type=boolean site=w3}}]
}

# includes on a list of strings calls Array.prototype.includes itself, as native code is called: its function object is fetched by one call, then the function is called with it, the list and the string.
# CHECK-LABEL: name="has" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[function]] = Patchpoint(resultConstraints = Register({{*}}), pureFunction = {{*}}:CallBuiltin)
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[answer]] = Patchpoint(b@[[function]]:Register({{*}}), b@[[list]]:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:CallBuiltin)
# The answer is a boolean in the lowest bit. Nothing tests which function the member holds, and there is no branch.
# CHECK-NEXT: Int32 b@[[low]] = Trunc(b@[[answer]])
# CHECK-NEXT: Int32 b@{{*}} = Const32(1)
# CHECK-NEXT: Int32 b@[[bit]] = BitAnd(b@[[low]], $1(b@{{*}}))
# CHECK-NEXT: Return(b@[[bit]], Terminal)
# CHECK-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 7, patchpoints: 2
# ARM64: instructions: 7, patchpoints: 2
