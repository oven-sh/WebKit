typesite w4 module=m0 position=149 kind=CallResult
typesite w5 module=m0 position=139 kind=CallResult
typesite w6 module=m0 position=204 kind=CallResult
typesite w7 module=m0 position=194 kind=CallResult
typesite w8 module=m0 position=63 kind=CallResult
data d0 root=Array{contents=undefined|null|string} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<undefined|null|string> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=String
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Call v5, -, v7 calleeName="String"
    v9 = Convert v8 declared={type=undefined|null|string site=w4 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v10 = Call v4, v3, v9 calleeKey="push" calleeName="list.push"
    v11 = Convert v10 declared={type=number site=w5} illTypedCause=DeclarationWithoutBody
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = Builtin builtin=String
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="input" [isFreeName]
    v19 = Call v16, -, v18 calleeName="String"
    v20 = Convert v19 declared={type=undefined|null|string site=w6 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v21 = Call v1, -, v3, v20 calleeName="has"
    v22 = Convert v21 declared={type=boolean site=w7}
    PropSet v15, v22 key="answer"
