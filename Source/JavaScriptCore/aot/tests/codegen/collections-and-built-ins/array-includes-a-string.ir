# includes() with a string is one stub call that takes the array and the string. Array.prototype.includes is not called, so its function object is not loaded.
# CHECK-LABEL: name="has" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[index]] = Patchpoint(b@[[list]]:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways{{*}}:CallInline)
# The stub returns an index, which is compared with -1. Nothing tests which function the member holds.
# CHECK-NEXT: Int64 b@{{*}} = Const64(-1
# CHECK-NEXT: Int32 b@[[found]] = NotEqual(b@[[index]], $-1(b@{{*}})
# CHECK-NEXT: Return(b@[[found]], Terminal)
# CHECK-LABEL: end of function
# CALLS-LABEL: name="has" role=Source
# CALLS-NOT: Branch(
# CALLS-LABEL: end of function
# The counts hold a call, whose moves follow the calling convention: not for Windows.
# X64: instructions: 6, patchpoints: 1
# ARM64: instructions: 6, patchpoints: 1
