module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=119 kind=Variable
typesite w1 module=m0 position=14 kind=Parameter function=f1
typesite w2 module=m0 position=30 kind=Parameter function=f1
typesite w3 module=m0 kind=Result
typesite w4 module=m0 position=140 kind=CallResult
typesite w5 module=m0 position=191 kind=CallResult
typesite w6 module=m0 position=64 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v8 = Integer
    v9 = BitOr v7, v8
    v10 = Call v4, v3, v9 calleeKey="push" calleeName="list.push"
    v11 = Convert v10 declared={type=number site=w4} illTypedCause=DeclarationWithoutBody
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=i32 flags=[IsExpected]}
    v19 = Integer
    v20 = BitOr v18, v19
    v21 = Call v1, -, v3, v20 calleeName="find"
    v22 = Convert v21 declared={type=number site=w5}
    PropSet v15, v22 key="answer"
    v24 = Undefined
    Return v24
}
function f1 name="find" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="indexOf"
    v3 = Call v2, v0, v1 calleeKey="indexOf" calleeName="list.indexOf"
    ReturnCall v3 casts=[{declared={type=number site=w6}}, {declared={type=number site=w3}}]
}

# indexOf looks at the kind of storage once. For integers and for doubles it calls a search that only reads: it cannot throw, allocate or run code of the program.
# CHECK-LABEL: name="find" role=Source
# CHECK: Int32 b@[[byte]] = Load8Z(b@[[list]], offset = 4, ControlDependent|Reads:JSCell_indexingTypeAndMisc)
# CHECK: Int32 b@[[kind]] = BitAnd(b@[[byte]], $14(b@{{*}}))
# CHECK: Int32 b@[[isIntegers]] = Equal(b@[[kind]], $4(b@{{*}}))
# CHECK: Branch(b@[[isIntegers]], Terminal)
# CHECK: Int64 b@{{*}} = Patchpoint(b@[[list]]:ColdAny, b@{{*}}:ColdAny, resultConstraints = Register({{*}}), ControlDependent|Reads:{JSCell_header, Elements, ArrayStorage})
# CHECK: Int32 b@[[isDoubles]] = Equal(b@[[kind]], $6(b@{{*}}))
# CHECK: Branch(b@[[isDoubles]], Terminal)
# CHECK: Int64 b@{{*}} = Patchpoint(b@[[list]]:ColdAny, b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent|Reads:{JSCell_header, Elements, ArrayStorage})
# Every other kind of storage calls Array.prototype.indexOf itself, the only call that can throw.
# CHECK-NOT: ExitsSideways
# CHECK: ExitsSideways{{*}}:CallBuiltin)
# CHECK-NOT: ExitsSideways
# CHECK-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 28, patchpoints: 4, rare instructions: 6
# ARM64: instructions: 26, patchpoints: 4, rare instructions: 6
