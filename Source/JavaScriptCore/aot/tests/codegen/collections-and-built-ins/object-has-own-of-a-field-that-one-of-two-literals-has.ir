entry module=m0
layout L0 module=m0 position=193 fields=[{key="limit" declared={type=anything}}] ownFieldCount=1
layout L1 module=m0 position=162 fields=[{key="limit" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key="step" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
