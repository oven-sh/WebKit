# function tail(list: number[]): number[] {
#   return list.slice(1);
# }
# declare const input: any;
# const list: number[] = [];
# list.push(input | 0);
# for (let turn = 0; turn < input; turn++) (globalThis as any).answer = tail(list);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=100 kind=Variable
typesite w1 module=m0 position=14 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=121 kind=CallResult
typesite w4 module=m0 position=152 kind=Variable
typesite w5 module=m0 position=213 kind=CallResult
typesite w6 module=m0 position=51 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v8 = Integer
    v9 = BitOr v7, v8
    v10 = Call v4, v3, v9 calleeKey="push" calleeName="list.push"
    v11 = Convert v10 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v12 = Integer
    v13 = Convert v12 declared={type=number site=w4}
    Jump -> next b2(v13)
  b2(v14: number):
    LoopHint
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=number flags=[IsExpected]}
    v19 = Less v14, v18
    Branch v19 -> taken b3(| 0), notTaken b6(| 0)
  b3(v20):
    Jump -> next b4()
  b4():
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="globalThis" [isFreeName]
    v23 = Convert v22 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v24 = Convert v23 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v25 = Call v1, -, v3 calleeName="tail"
    v26 = Convert v25 declared={type=undefined|null|Array<number> site=w5 flags=[OmitsNull, OmitsUndefined]}
    PropSet v24, v26 key="answer"
    Jump -> next b5()
  b5():
    v28 = Increment v20
    v29 = Convert v28 declared={type=number site=w4}
    Jump -> next b2(v29)
  b6(v30):
    Jump -> next b7()
  b7():
    v31 = Undefined
    Return v31
}
function f1 name="tail" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="slice"
    v2 = Integer integer=1
    v3 = Call v1, v0, v2 calleeKey="slice" calleeName="list.slice"
    ReturnCall v3 casts=[{declared={type=undefined|null|Array<number> site=w6 flags=[OmitsNull, OmitsUndefined]}}, {declared={type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}}]
}

# slice calls one function of the run time with the list and both bounds as plain integers; the end that was left out is a number above every length.
# CHECK-LABEL: name="tail" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[start]] = Const64(1)
# CHECK-NEXT: Int64 b@[[end]] = Const64(4294967296)
# CHECK-NEXT: Int64 b@[[copy]] = Patchpoint(b@[[list]]:Register({{*}}), $1(b@[[start]]):Register({{*}}), $4294967296(b@[[end]]):Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways
# It answers with nothing for a list that it does not copy itself: only then, rarely, Array.prototype.slice itself is called.
# CHECK-NEXT: Branch(b@[[copy]], Terminal)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#[[itself]]
# CHECK: Return(b@{{*}}, Terminal)
# CHECK: BB#[[itself]]:
# CHECK: ExitsSideways{{*}}:CallBuiltin)
# CHECK-LABEL: end of function
# The counts hold calls, whose moves follow the calling convention: not for Windows.
# X64: instructions: 8, patchpoints: 1, rare instructions: 6
# ARM64: instructions: 8, patchpoints: 1, rare instructions: 7
