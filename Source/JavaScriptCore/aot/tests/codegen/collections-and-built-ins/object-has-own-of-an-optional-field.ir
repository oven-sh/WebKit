# CHECK-NEXT: Branch(b@[[filled]], Terminal, {{*}}:IsSlotFilled)
# CHECK: Double b@{{*}} = Load(b@[[options]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
