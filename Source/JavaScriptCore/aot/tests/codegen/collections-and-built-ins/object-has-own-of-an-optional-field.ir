# type Options = { limit: number; step?: number };
# function step(options: Options): number {
#   return Object.hasOwn(options, "step") ? options.limit : 0;
# }
# declare const input: any;
# (globalThis as any).answer = step(input ? { limit: +input, step: 2.5 } : { limit: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=63 kind=Parameter function=f1
typesite w1 module=m0 position=49 kind=Result
typesite w2 module=m0 position=209 kind=CallResult
typesite w3 module=m0 position=100 kind=CallResult
layout L0 name="Options" module=m0 position=5 fields=[{key="limit" declared={type=number} flags=[IsRequired]}, {key="step" declared={type=undefined|number}}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Convert v13 declared={type=number}
    v15 = Double number=2.5
    v16 = Convert v15 declared={type=undefined|number}
    v17 = NewObject -, v14, v16 layout=L0 fields=[0, 1]
    v18 = FinishObject v17
    Jump -> next b6(v18)
  b4(v19):
    Jump -> next b5()
  b5():
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="input" [isFreeName]
    v22 = Convert v21 declared={type=number flags=[IsExpected]}
    v23 = ToNumber v22
    v24 = Convert v23 declared={type=number}
    v25 = NewObject -, v24 layout=L0 fields=[0]
    v26 = FinishObject v25
    Jump -> next b6(v26)
  b6(v27):
    v28 = Call v1, -, v27 calleeName="step"
    v29 = Convert v28 declared={type=number site=w2}
    PropSet v5, v29 key="answer"
    v31 = Undefined
    Return v31
}
function f1 name="step" module=m0 position=49 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Object
    v2 = Builtin builtin=ObjectHasOwn
    v3 = String string="step"
    v4 = Call v2, v1, v0, v3 calleeName="Object.hasOwn"
    v5 = Convert v4 declared={type=boolean site=w3} illTypedCause=DeclarationWithoutBody
    v6 = ToBoolean v5
    Branch v6 -> taken b2(| 0), notTaken b4(| 0)
  b2(v7):
    Jump -> next b3()
  b3():
    v8 = PropGet v0 key="limit"
    Jump -> next b6(v8)
  b4(v9):
    Jump -> next b5()
  b5():
    v10 = Integer
    Jump -> next b6(v10)
  b6(v11):
    v12 = Convert v11 declared={type=number site=w1}
    Return v12
}

# An optional field of a proven layout has a slot of its own: Object.hasOwn loads it and compares it with the mark of an empty slot. No call, no lookup by name.
# CHECK-LABEL: name="step" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[options]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[slot]] = Load(b@[[options]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:IsSlotFilled)
# CHECK: Int32 b@[[filled]] = NotEqual(b@[[slot]], {{*}}:IsSlotFilled)
# CHECK-NEXT: Branch(b@[[filled]], Terminal, {{*}}:IsSlotFilled)
# CHECK: Double b@{{*}} = Load(b@[[options]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK-LABEL: end of function
