# CHECK-NEXT: Int64 b@[[options]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[slot]] = Load(b@[[options]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:IsSlotFilled)
