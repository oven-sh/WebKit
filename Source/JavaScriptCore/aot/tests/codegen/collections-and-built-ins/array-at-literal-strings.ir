# const names: string[] = ["a", "bb", "ccc", "dddd", "e", "ff", "ggg", "hhhh"];
# function pick(index: number): number {
#   return names.at(index & 7)!.length;
# }
# declare const input: any;
# for (let turn = 0; turn < input; turn++) (globalThis as any).answer = pick(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=6 kind=Variable
typesite w1 module=m0 position=92 kind=Parameter function=f1
typesite w2 module=m0 position=78 kind=Result
typesite w3 module=m0 position=192 kind=Variable
typesite w4 module=m0 position=253 kind=CallResult
typesite w5 module=m0 position=126 kind=CallResult
data d0 root=Array{contents=undefined|null|string elements=[String{value="a"}, String{value="bb"}, String{value="ccc"}, String{value="dddd"}, String{value="e"}, String{value="ff"}, String{value="ggg"}, String{value="hhhh"}]} module=m0
variable g0 name="names" module=m0 declared={type=undefined|null|absent|Array<undefined|null|string> site=w0 flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<undefined|null|string> site=w0 flags=[OmitsNull, OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Integer
    v6 = Convert v5 declared={type=number site=w3}
    Jump -> next b2(v6)
  b2(v7: number):
    LoopHint
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = Less v7, v11
    Branch v12 -> taken b3(| 0), notTaken b6(| 0)
  b3(v13):
    Jump -> next b4()
  b4():
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="globalThis" [isFreeName]
    v16 = Convert v15 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v17 = Convert v16 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="input" [isFreeName]
    v20 = Convert v19 declared={type=i32 flags=[IsExpected]}
    v21 = Integer
    v22 = BitOr v20, v21
    v23 = Call v1, -, v22 calleeName="pick"
    v24 = Convert v23 declared={type=number site=w4}
    PropSet v17, v24 key="answer"
    Jump -> next b5()
  b5():
    v26 = Increment v13
    v27 = Convert v26 declared={type=number site=w3}
    Jump -> next b2(v27)
  b6(v28):
    Jump -> next b7()
  b7():
    v29 = Undefined
    Return v29
}
function f1 name="pick" module=m0 position=78 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="names"
    v3 = PropGet v2 key="at"
    v4 = Integer integer=7
    v5 = BitAnd v0, v4
    v6 = Call v3, v2, v5 calleeKey="at" calleeName="names.at"
    v7 = Convert v6 declared={type=undefined|null|string site=w5 flags=[OmitsNull]} illTypedCause=FromLooseType
    v8 = PropGet v7 key="length"
    v9 = Convert v8 declared={type=number site=w2}
    Return v9
}

# The list holds strings, and its type lists the texts that they are. What at hands out stays the string that was loaded: nothing looks it up among the texts to hold it as a number, as nothing does behind `names[index & 7]`.
# CHECK-LABEL: name="pick" role=Source
# CHECK: Int64 b@[[element]] = Load(b@{{*}}, ControlDependent|Reads:indexedContiguousProperties)
# CHECK-NOT: Patchpoint(b@[[element]]
# CHECK-LABEL: end of function
# X64: instructions: 13, patchpoints: 2, rare instructions: 2
# ARM64: instructions: 15, patchpoints: 2, rare instructions: 2
