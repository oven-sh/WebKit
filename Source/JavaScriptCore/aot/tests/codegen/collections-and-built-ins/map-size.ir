# The size of a Map is two loads: the storage off the cell and the count off the storage. One branch stands between them, for a map that has no storage yet. No call.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[map]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[storage]] = Load(b@[[map]], offset = 16, ControlDependent|Reads:JSMap_storage, {{*}}:CallInline)
# CHECK-NEXT: Branch(b@[[storage]], Terminal, {{*}}:CallInline)
# CHECK-NEXT: Successors: Then:#[[filled]], Else:Rare:#[[empty]]
# CHECK-NEXT: BB#[[filled]]:
# CHECK-NEXT: Predecessors:
# CHECK-NEXT: Int32 b@[[count]] = Load(b@[[storage]], offset = 12, ControlDependent|Reads:CollectionStorage, {{*}}:CallInline)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Reads:
# CHECK: Int32 b@[[size]] = Phi(
# CHECK-NEXT: Return(b@[[size]], Terminal)
# CHECK-NOT: Branch(
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Reads:
# CHECK-LABEL: end of function
# X64: instructions: 5, patchpoints: 0, rare instructions: 2
# ARM64: instructions: 5, patchpoints: 0, rare instructions: 2
