# function pick(list: number[], index: number): number {
#   return list.at(index) ?? 0;
# }
# declare const input: any;
# const list: number[] = [];
# list.push(input | 0);
# (globalThis as any).answer = pick(list, input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 not-windows unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 not-windows unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=119 kind=Variable
typesite w1 module=m0 position=14 kind=Parameter function=f1
typesite w2 module=m0 position=30 kind=Parameter function=f1
typesite w3 module=m0 kind=Result
typesite w4 module=m0 position=140 kind=CallResult
typesite w5 module=m0 position=191 kind=CallResult
typesite w6 module=m0 position=64 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=i32 flags=[IsExpected]}
    v8 = Integer
    v9 = BitOr v7, v8
    v10 = Call v4, v3, v9 calleeKey="push" calleeName="list.push"
    v11 = Convert v10 declared={type=number site=w4} illTypedCause=DeclarationWithoutBody
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=i32 flags=[IsExpected]}
    v19 = Integer
    v20 = BitOr v18, v19
    v21 = Call v1, -, v3, v20 calleeName="pick"
    v22 = Convert v21 declared={type=number site=w5}
    PropSet v15, v22 key="answer"
    v24 = Undefined
    Return v24
}
function f1 name="pick" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="at"
    v3 = Call v2, v0, v1 calleeKey="at" calleeName="list.at"
    v4 = Convert v3 declared={type=undefined|number site=w6} illTypedCause=FromLooseType
    v5 = TypeTest v4 testedType=undefined|null
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
    Jump -> next b3()
  b3():
    v7 = Integer
    Jump -> next b5(v7)
  b4(v8):
    Jump -> next b5(v8)
  b5(v9):
    v10 = Convert v9 declared={type=number site=w3}
    Return v10
}

# at with an integer adds the length to a negative index by a select, without a branch. One unsigned comparison with the length then catches both ends.
# CHECK-LABEL: name="pick" role=Source
# CHECK: Int64 b@[[index]] = SExt32(b@{{*}})
# CHECK: Int64 b@[[storage]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly)
# CHECK-NEXT: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength)
# CHECK-NEXT: Int64 b@[[wide]] = ZExt32(b@[[length]])
# CHECK: Int32 b@[[isNegative]] = LessThan(b@[[index]], $0(b@{{*}}))
# CHECK-NEXT: Int64 b@[[fromEnd]] = Add(b@[[index]], b@[[wide]])
# CHECK-NEXT: Int64 b@[[place]] = Select(b@[[isNegative]], b@[[fromEnd]], b@[[index]])
# CHECK-NEXT: Int32 b@[[inside]] = Above(b@[[wide]], b@[[place]])
# CHECK: Branch(b@[[inside]], Terminal)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# The kind of storage is compared with integers first, and that arm is one load of the element.
# CHECK: Int32 b@[[byte]] = Load8Z(b@[[list]], offset = 4, ControlDependent|Reads:JSCell_indexingTypeAndMisc)
# CHECK: Int32 b@[[kind]] = BitAnd(b@[[byte]], $14(b@{{*}}))
# CHECK: Int32 b@[[isIntegers]] = Equal(b@[[kind]], $4(b@{{*}}))
# CHECK: Branch(b@[[isIntegers]], Terminal)
# CHECK: Int64 b@[[offset]] = Shl(b@[[place]], $3(b@{{*}}))
# CHECK-NEXT: Int64 b@[[address]] = Add(b@[[offset]], b@[[storage]])
# CHECK-NEXT: Int64 b@{{*}} = Load(b@[[address]], ControlDependent|Reads:indexedInt32Properties)
# CHECK-LABEL: end of function
# The counts hold a call, whose moves follow the calling convention: not for Windows.
# X64: instructions: 42, patchpoints: 4, rare instructions: 23
# ARM64: instructions: 41, patchpoints: 4, rare instructions: 24
