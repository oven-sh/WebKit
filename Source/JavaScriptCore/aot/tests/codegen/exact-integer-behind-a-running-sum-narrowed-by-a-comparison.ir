# sum = (sum + list[i]) | 0; if (sum < limit) continue: the sum reaches the next iteration as the operand that the comparison narrowed.
# Each iteration still waits for the truncation in the one before, so the element is tested for a whole int32 and the sum is computed in integers.
# FORM: Selected
# RUN: generate-code ExactIntegersBehindNumbers
# CHECK: : size=
# CHECK-NOT: no code
# CHECK: statistic ExactIntegersBehindNumbers 1

module m0 path="main.js" displayPath="main.js"
function f0 name="runningSumBelowLimit" parameters=[{type=Array<number>}, {type=i32}] results=[{type=anything}] {
  b0(v0: Array<number>, v1: i32):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3: i32, v4: int[0, 127]):
    LoopHint
    v6 = HasArrayStorage v0 arrayStorage=Double
    TestAndBranch v6 -> taken b2(| 0), notTaken b5()
  b2(v7: guard):
    v8 = IsElementPresent v0, v4, v7 arrayStorage=Double [keyIsIntegral]
    TestAndBranch v8 -> taken b3(| 0), notTaken b5()
  b3(v9: guard):
    v10 = AllGuards v7, v9
    v11 = GetArrayElement v0, v4, v10 arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
    v12 = Add v3, v11 form=Numbers
    v13 = Integer integer=0
    v14 = BitOr v12, v13 form=Numbers
    v15 = Less v14, v1 form=Integers
    TestAndBranch v15 -> taken b4(| 0), notTaken b5()
  b4(v16: i32):
    v17 = Increment v4 form=Integers
    v18 = Integer integer=127
    v19 = BitAnd v17, v18 form=Integers
    Jump -> next b1(v16, v19)
  b5():
    Return v3
}
