# function less(x: number, y: number) { return x < y }, <=, >, >=, each also as the condition of an if, and x < 10 with an int32: what they answer for numbers that arrive boxed: int32 at both ends, -0, fractions, numbers beyond int32 and 2^53, infinities, NaN
# FORM: AsRead
# RUN(IR): pipeline ChooseRepresentations
# RUN: run-in-shell globalThis.register = (less, lessEq, greater, greaterEq, pick, lessThanTen) => { const values = [0, -0, 1, -1, 9, 10, 11, 0.5, -0.5, 9.5, 10.5, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296.5, 1e21, -1e21, 9007199254740991, 9007199254740992, Infinity, -Infinity, NaN]; let wrong = 0; const check = (name, x, y, got, want) => { if (!Object.is(got, want)) { wrong++; print(name, x, y, got, want); } }; for (const x of values) { check("lessThanTen", x, 10, lessThanTen(x), x < 10); for (const y of values) { check("less", x, y, less(x, y), x < y); check("lessEq", x, y, lessEq(x, y), x <= y); check("greater", x, y, greater(x, y), x > y); check("greaterEq", x, y, greaterEq(x, y), x >= y); check("pick", x, y, pick(x, y), x < y ? 1 : x >= y ? 2 : 3); } } print("wrong: " + wrong); };
# IR-LABEL: name="less" module=m0 role=GenericEntrypoint
# IR-NOT: = Unbox
# IR: = Less {{*}} form=Numbers
# CHECK: wrong: 0
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = NewClosure function=f6
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="register" [isFreeName]
    v8 = Call v7, -, v0, v1, v2, v3, v4, v5
    Return
}
function f1 name="less" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = Less v0, v1
    Return v2
}
function f2 name="lessEq" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = LessEq v0, v1
    Return v2
}
function f3 name="greater" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = Greater v0, v1
    Return v2
}
function f4 name="greaterEq" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = GreaterEq v0, v1
    Return v2
}
function f5 name="pick" module=m0 flags=[IsChecked] length=2 thisType={type=anything} parameters=[{type=number}, {type=number}] results=[{type=anything}] {
  b0(v0: number, v1: number):
    v2 = Less v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = GreaterEq v0, v1
    Branch v4 -> taken b3(), notTaken b4()
  b3():
    v5 = Integer integer=2
    Return v5
  b4():
    v6 = Integer integer=3
    Return v6
}
function f6 name="lessThanTen" module=m0 flags=[IsChecked] length=1 thisType={type=anything} parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = Integer integer=10
    v2 = Less v0, v1
    Return v2
}
