# CHECK-LABEL: f4:
# CHECK: stub BoxNumber.Integer x1

function f5 name="optionalIntegerInUnlikelyBlock" parameters=[{type=undefined|null|int}, {type=boolean}] results=[{type=anything}] {
  b0(v0: undefined|null|int @OptionalInt64, v1: boolean @Boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v2 @JSValue = Box v0
    Return v2
  b2():
    v3 @JSValue = Undefined
    Return v3
