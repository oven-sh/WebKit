function f6 name="int32InWideRegisterInUnlikelyBlock" parameters=[{type=i32}, {type=int}, {type=boolean}] results=[{type=anything}] {
  b0(v0: i32 @Int32, v1: int @Int64, v2: boolean @Boolean):
    v3 @Int64 = WidenInteger v0
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v4 @JSValue = Box v3
    Return v4
  b2():
    v5 @JSValue = Undefined
    Return v5
}
# CHECK-LABEL: f6:
# CHECK-NOT: stub BoxNumber
