# A leaf converts between a literal string and a string without a frame of its own, in compact code
# RUN: compile
# OPTIONS: heat=everything-is-cold validate check=validate-back-end
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="register" [isFreeName]
    v7 = Call v6, -, v0, v1, v2, v3, v4
    Return v7
}
function f1 name="widen" parameters=[{type="a"|"b"}] results=[{type=string}] {
  b0(v0: "a"|"b"):
    v1 = Upcast v0 castType=string
    Return v1
}
function f2 name="widenNullable" parameters=[{type=null|"a"|"b"}] results=[{type=anything}] {
  b0(v0: null|"a"|"b"):
    Return v0
}
function f3 name="merge" parameters=[{type="a"|"b"}, {type=string}, {type=boolean}] results=[{type=string}] {
  b0(v0: "a"|"b", v1: string, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Upcast v0 castType=string
    Jump -> next b3(v3)
  b2():
    Jump -> next b3(v1)
  b3(v4):
    Return v4
}
function f4 name="test" parameters=[{type=string}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="a"|"b"
    Return v1
}
function f5 name="passInTailCall" parameters=[{type="a"|"b"}, {type=function}] results=[{type=anything}] {
  b0(v0: "a"|"b", v1: function):
    v2 = Call v1, -, v0
    Return v2
}
