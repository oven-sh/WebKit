# A leaf converts between a literal string and a string without a frame of its own, in compact code
# RUN: compile
# OPTIONS: heat=everything-is-cold validate check=validate-back-end
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=20 kind=Parameter
typesite w2 module=m0 position=30 kind=Parameter
typesite w3 module=m0 position=40 kind=Parameter
typesite w4 module=m0 position=50 kind=Parameter
typesite w5 module=m0 position=60 kind=Parameter
typesite w6 module=m0 position=70 kind=Parameter
typesite w7 module=m0 position=80 kind=Parameter

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="register" [isFreeName]
    v7 = Call v6, -, v0, v1, v2, v3, v4
    Return v7
}
function f1 name="widen" parameters=[{type="a"|"b" site=w0}] results=[{type=string}] {
  b0(v0: "a"|"b"):
    v1 = Upcast v0 castType=string
    Return v1
}
function f2 name="widenNullable" parameters=[{type=null|"a"|"b" site=w1}] results=[{type=anything}] {
  b0(v0: null|"a"|"b"):
    Return v0
}
function f3 name="merge" parameters=[{type="a"|"b" site=w2}, {type=string site=w3}, {type=boolean site=w4}] results=[{type=string}] {
  b0(v0: "a"|"b", v1: string, v2: boolean):
    v3 = ToBoolean v2
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v4 = Upcast v0 castType=string
    Jump -> next b3(v4)
  b2():
    Jump -> next b3(v1)
  b3(v5):
    Return v5
}
function f4 name="test" parameters=[{type=string site=w5}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="a"|"b"
    Return v1
}
function f5 name="passInTailCall" parameters=[{type="a"|"b" site=w6}, {type=function site=w7}] results=[{type=anything}] {
  b0(v0: "a"|"b", v1: function):
    v2 = Call v1, -, v0
    Return v2
}
