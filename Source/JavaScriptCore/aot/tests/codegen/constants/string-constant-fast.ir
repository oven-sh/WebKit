# Where the code is run often the word of a string constant's cell is loaded and tested in place, also on an unlikely path, and the stub is called for the first use alone. A rare block calls the stub at once
# FORM: Selected
# OPTIONS: heat=everything-is-hot
# RUN: generate-code calls
# RUN(X64): generate-code
# REQUIRES(X64): x86_64

module m0 path="main.js" displayPath="main.js"

function f0 name="inNormalCode" results=[{type=anything}] {
  b0():
    v0 = String string="some text"
    Return v0
}
function f1 name="onRarePath" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v1 = String string="some text"
    Return v1
  b2():
    v2 = Undefined
    Return v2
}
function f2 name="onUnlikelyPath" parameters=[{type=boolean}] results=[{type=anything}] {
  b0(v0: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Unlikely:
    v1 = String string="some text"
    Return v1
  b2():
    v2 = Undefined
    Return v2
}
# CHECK: f0: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# CHECK: f1: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# CHECK: f2: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# X64: f0: size=27 frame
# X64-NEXT: f1: size=21 frame
# X64-NEXT: f2: size=37 frame
