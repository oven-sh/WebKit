# In compact code a string constant is one call of the stub that finds or creates its cell: the word of the cell is not loaded and tested in place
# FORM: Selected
# OPTIONS: heat=everything-is-cold
# RUN: generate-code calls
# RUN(X64): generate-code
# REQUIRES(X64): x86_64

# CHECK: f0: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# CHECK: f1: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# CHECK: f2: size={{*}}
# CHECK-NEXT: stub CreateConstant.String x1
# X64: f0: size=11 frame
# X64-NEXT: f1: size=21 frame
# X64-NEXT: f2: size=21 frame
# PROGRAM-OF: string-constant-fast.ir
