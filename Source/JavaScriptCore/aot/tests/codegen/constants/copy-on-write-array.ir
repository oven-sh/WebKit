# An array of constants shares its storage with every array of its site: where the code is run often the array is a cell allocated in place around that storage, and the run time is called where that cannot be. Other code calls a stub that does the same: that is less code than the literal. A tree of constants calls the run time every time
# FORM: Selected
# RUN: generate-code calls CopyOnWriteArraysCreatedInline
# OPTIONS: heat=EverythingIsHot

module m0 path="main.js" displayPath="main.js"
data d0 root=Array{contents=number elements=[Number{value=1}, Number{value=2}, Number{value=3}]}
data d1 root=Array{contents=number elements=[Number{value=1.5}, Number{value=2}]}
data d2 root=Array{contents=null|string elements=[String{value="a"}, Null]}
data d3 root=Array{contents=number elements=[Number{value=4}, Number{value=5}]}
data d4 root=Array{contents=anything elements=[Number{value=1}, Array{contents=number elements=[Number{value=2}]}]}
data d5 root=Array{contents=null|string elements=[String{value="b"}, Null]}

function f0 name="integers" results=[{type=anything}] {
    v0 = Data data=d0 encoding=CopyOnWriteArray
    Return v0
}
function f1 name="doubles" results=[{type=anything}] {
    v0 = Data data=d1 encoding=CopyOnWriteArray
    Return v0
}
function f2 name="values" results=[{type=anything}] {
    v0 = Data data=d2 encoding=CopyOnWriteArray
    Return v0
}
function f3 name="onRarePath" parameters=[{type=boolean}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v1 = Data data=d3 encoding=CopyOnWriteArray
    Return v1
  b2():
    v2 = Undefined
    Return v2
}
function f4 name="tree" results=[{type=anything}] {
    v0 = Data data=d4 encoding=ReadOnlyTree
    Return v0
}
function f5 name="valuesOnRarePath" parameters=[{type=boolean}] results=[{type=anything}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v1 = Data data=d5 encoding=CopyOnWriteArray
    Return v1
  b2():
    v2 = Undefined
    Return v2
}
# CHECK: f0: size={{*}}
# CHECK-NEXT: operation operationAOTNewFromData x1
# CHECK: f3: size={{*}}
# CHECK-NEXT: stub ArrayOfData.Double x1
# CHECK: f4: size={{*}}
# CHECK-NEXT: operation operationAOTNewFromData x1
# CHECK: f5: size={{*}}
# CHECK-NEXT: stub ArrayOfData.SharedValues x1
# CHECK: statistic CopyOnWriteArraysCreatedInline 3
