# function isEmpty(text) {
#   return text === "";
# }
# globalThis.answer = isEmpty(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Call v1, -, v6 calleeName="isEmpty"
    v8 = Convert v7 declared={type=boolean flags=[IsExpected]}
    PropSet v4, v8 key="answer"
    v10 = Undefined
    Return v10
}
function f1 name="isEmpty" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=boolean flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = String string=""
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean flags=[IsExpected]}
    Return v3
}

# There is one empty text, so a value of any kind equals "" if it is that cell: one comparison of two words. No type is tested and nothing is called.
# CHECK-LABEL: name="isEmpty" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[empty]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields, {{*}}:ValueEqualsLiteral)
# CHECK: Int32 b@[[isEmpty]] = Equal(b@{{*}}, b@[[empty]], {{*}}:ValueEqualsLiteral)
# CHECK-NEXT: Return(b@[[isEmpty]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isEmpty" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Reads:JSRopeString
# NONE-NOT: Reads:StringImpl
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64-LABEL: name="isEmpty" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="isEmpty" role=Source
# ARM64-NEXT: instructions: 3, patchpoints: 0
