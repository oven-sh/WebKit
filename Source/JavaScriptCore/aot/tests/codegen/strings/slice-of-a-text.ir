# function middle(text: string): string {
#   return text.slice(1, 4);
# }
# declare const input: any;
# (globalThis as any).answer = middle(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=124 kind=CallResult
typesite w3 module=m0 position=49 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="middle"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="middle" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="slice"
    v2 = Integer integer=1
    v3 = Integer integer=4
    v4 = Call v1, v0, v2, v3 calleeKey="slice" calleeName="text.slice"
    ReturnCall v4 casts=[{declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}}, {declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}}]
}

# `text.slice(1, 4)`: both bounds are clamped to the length by selects, without a branch, and the end to the start. Then the part of the function that makes the result is entered by a jump, with the text and both bounds as 32-bit integers in registers.
# CHECK-LABEL: name="middle" role=ResultWorker
# CHECK: Int32 b@[[length]] = Phi(
# CHECK: Int32 b@[[isShort]] = LessThan(b@[[length]], $1(
# CHECK: Int64 b@[[wideStart]] = Select(b@[[isShort]], b@{{*}}, $1(
# CHECK: Int32 b@[[start]] = Trunc(b@[[wideStart]],
# CHECK: Int32 b@[[endsEarly]] = LessThan(b@[[length]], $4(
# CHECK: Int64 b@[[wideEnd]] = Select(b@[[endsEarly]], b@{{*}}, $4(
# CHECK: Int32 b@[[end]] = Trunc(b@[[wideEnd]],
# CHECK: Int32 b@[[isEmpty]] = GreaterThan(b@[[start]], b@[[end]],
# CHECK: Int32 b@[[clampedEnd]] = Select(b@[[isEmpty]], b@[[start]], b@[[end]],
# CHECK-NEXT: Patchpoint(b@[[text]]:Register({{*}}), b@[[start]]:Register({{*}}), b@[[clampedEnd]]:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|
# CHECK-LABEL: end of function
# The only branch asks whether the text is a rope, for its length.
# NONE-LABEL: name="middle" role=ResultWorker
# NONE: Branch(b@{{*}}:GetStringLength)
# NONE-NOT: Branch(
# NONE-NOT: IToD
# NONE-NOT: Double
# NONE-LABEL: end of function
