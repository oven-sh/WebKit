# function same(left: string, right: string): boolean {
#   return left === right;
# }
# declare const input: any;
# (globalThis as any).answer = same(input, input + "x");
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=28 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=136 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = String string="x"
    v12 = Add v10, v11
    v13 = Call v1, -, v8, v12 calleeName="same"
    v14 = Convert v13 declared={type=boolean site=w3}
    PropSet v5, v14 key="answer"
    v16 = Undefined
    Return v16
}
function f1 name="same" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean site=w2}
    Return v3
}

# Two texts of which nothing more is known are compared by the stub for any two values.
# CHECK-LABEL: name="same" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[left]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[right]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[answer]] = Patchpoint(b@[[left]]:Register({{*}}), b@[[right]]:Register({{*}}), resultConstraints = Register({{*}}:StrictEq)
# CHECK-NEXT: Int32 b@[[isEqual]] = Trunc(b@[[answer]],
# CHECK-NEXT: Return(b@[[isEqual]], Terminal)
# CHECK-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub Equal.Strict x1
# CALLS-NEXT: f4: size=
