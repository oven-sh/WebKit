# globalThis.answer = checksum(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(HOT): lower-to-b3 optimized loops f1
# REQUIRES(HOT): unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Call v1, -, v6 calleeName="checksum"
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    PropSet v4, v8 key="answer"
    v10 = Undefined
    Return v10
}
function f1 name="checksum" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=i32 flags=[IsExpected]}
    v3 = Integer
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v2, v4)
  b2(v5, v6):
    LoopHint
    v8 = PropGet v0 key="length"
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    v10 = Less v6, v9
    Branch v10 -> taken b3(| 0), notTaken b6(| 0)
  b3(v11):
    Jump -> next b4()
  b4():
    v12 = PropGet v0 key="charCodeAt"
    v13 = Convert v12 declared={type=undefined|null|function flags=[IsExpected]}
    v14 = Call v13, v0, v11 calleeKey="charCodeAt" calleeName="text.charCodeAt"
    v15 = Convert v14 declared={type=number flags=[IsExpected]}
    v16 = Add v5, v15
    v17 = Integer
    v18 = BitOr v16, v17
    v19 = Convert v18 declared={type=i32 flags=[IsExpected]}
    Jump -> next b5()
  b5():
    v20 = Increment v11
    v21 = Convert v20 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v19, v21)
  b6(v22):
    Jump -> next b7()
  b7():
    v23 = Convert v5 declared={type=number flags=[IsExpected]}
    Return v23
}

# Without types the loop is entered by name once. As soon as `text` is seen to be a text, `length` its length and `charCodeAt` the built-in, an inner loop takes over that reads the bytes in line.
# CHECK-LABEL: loop #
# CHECK: Int32 b@[[unit]] = Load8Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:GetStringCodeUnit)
# CHECK: Int32 b@{{*}} = Add(b@[[unit]], b@{{*}}:Add)
# CHECK-LABEL: end of loop
# A rare path of that loop comes back into it, so it polls on every turn. It calls nothing, tests no type of the text and reads neither its length nor its characters' address again. The counter is the one thing it checks: that it stays a 31-bit integer.
# HOT-LABEL: loop #
# HOT-NOT: Reads:StringImpl
# HOT-NOT: Reads:JSRopeString
# HOT-NOT: Reads:JSCell
# HOT-NOT: IToD
# HOT-LABEL: end of loop
# X64: instructions: 6, patchpoints: 2
# ARM64: instructions: 6, patchpoints: 2
