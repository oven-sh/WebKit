# `if (text.length)` asks whether the text is the empty one, of which there is one cell: one comparison of two words, and no length is read.
# CHECK-LABEL: name="pick" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[empty]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields,
# CHECK: Int32 b@[[hasUnits]] = NotEqual(b@{{*}}, b@[[empty]],
# CHECK-NEXT: Branch(b@[[hasUnits]], Terminal,
# CHECK-LABEL: end of function
# NONE-LABEL: name="pick" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Reads:JSRopeString
# NONE-NOT: Reads:StringImpl
