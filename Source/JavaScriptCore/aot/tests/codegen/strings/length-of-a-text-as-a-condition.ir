    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = ToNumber v11
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=number flags=[IsExpected]}
    v16 = ToNumber v15
    v17 = Call v1, -, v8, v12, v16 calleeName="pick"
    v18 = Convert v17 declared={type=number site=w4}
