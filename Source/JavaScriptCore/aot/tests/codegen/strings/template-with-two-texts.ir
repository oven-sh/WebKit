# function path(folder: string, file: string): string {
#   return `${folder}/${file}`;
# }
# declare const input: any;
# (globalThis as any).answer = path(input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=30 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=141 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=undefined|null|string flags=[IsExpected]}
    v12 = Call v1, -, v8, v11 calleeName="path"
    v13 = Convert v12 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v13 key="answer"
    v15 = Undefined
    Return v15
}
function f1 name="path" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = ToString v0
    v3 = String string="/"
    v4 = ToString v1
    v5 = Strcat v2, v3, v4
    v6 = Convert v5 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}

# A template of two texts around one character is one rope of three. The cell of the character comes out of the table of one-character texts by two loads that never change.
# CHECK-LABEL: name="path" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[table]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields, {{*}}:String)
# CHECK: Int64 b@[[slash]] = Load(b@[[table]], offset = 376, ControlDependent|ReadsImmutable|Reads:singleCharacterStrings, {{*}}:String)
# CHECK: Int64 b@[[rope]] = Patchpoint(b@[[folder]]:Register({{*}}), b@[[slash]]:Register({{*}}), b@[[file]]:Register({{*}}), resultConstraints = Register({{*}}:Strcat)
# CHECK-NEXT: Return(b@[[rope]], Terminal)
# CHECK-LABEL: end of function
# Neither part is tested or converted: the types say that both are texts.
# NONE-LABEL: name="path" role=Source
# NONE-NOT: Branch(
# NONE-NOT: Reads:JSCell
# NONE-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub Concatenate.n3 x1
# CALLS-NEXT: f4: size=
