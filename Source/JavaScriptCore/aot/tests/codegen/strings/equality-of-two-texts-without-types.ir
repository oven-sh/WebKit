# function same(left, right) {
#   return left === right;
# }
# globalThis.answer = same(String(input), input + "x");
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=String
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Call v5, -, v7 calleeName="String"
    v9 = Convert v8 declared={type=undefined|null|string flags=[IsExpected]}
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = String string="x"
    v13 = Add v11, v12
    v14 = Call v1, -, v9, v13 calleeName="same"
    v15 = Convert v14 declared={type=boolean flags=[IsExpected]}
    PropSet v4, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="same" module=m0 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string flags=[IsExpected]}, {type=undefined|null|string flags=[IsExpected]}] results=[{type=boolean flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean flags=[IsExpected]}
    Return v3
}

# Both callers hand over texts, so without a written type the two are compared by the stub for two texts as well.
# CHECK-LABEL: name="same" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[left]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[right]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[answer]] = Patchpoint(b@[[left]]:Register({{*}}), b@[[right]]:Register({{*}}), resultConstraints = Register({{*}}:StrictEq)
# CHECK-NEXT: Int32 b@[[isEqual]] = Trunc(b@[[answer]],
# CHECK-NEXT: Return(b@[[isEqual]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="same" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: Reads:Top
# NONE-LABEL: end of function
# CALLS-LABEL: f1: size=
# CALLS-NEXT: stub StringsAreEqual x1
# CALLS-NEXT: f{{*}}: size=
