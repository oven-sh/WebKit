# function isFunction(kind: string): boolean {
#   return kind === "function";
# }
# declare const input: any;
# (globalThis as any).answer = isFunction(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=20 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=132 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="isFunction"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="isFunction" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = String string="function"
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean site=w1}
    Return v3
}

# Eight characters are the most that fit into a register: 0x6e6f6974636e7566 is "function", first character lowest. The comparison ends the block: it branches itself, and no truth value is made for a branch to test.
# CHECK-LABEL: name="isFunction" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Patchpoint(b@[[kind]]:Register({{*}}), $7957695015192261990(b@{{*}}):Register({{*}}), resultConstraints = WarmAny, Terminal|ControlDependent|Reads:{argumentBuffer, StringStorage}, {{*}}:StringEqualsLiteral)
# CHECK-NEXT: Successors: #{{*}}, #
# CHECK-LABEL: end of function
# No cell is loaded or made for the literal, and nothing that may throw or allocate is called.
# NONE-LABEL: name="isFunction" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Load
# NONE-NOT: Branch(
# NONE-LABEL: end of function
