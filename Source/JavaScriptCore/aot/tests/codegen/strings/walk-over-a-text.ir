# function commas(text: string): number {
#   let count = 0;
#   for (const character of text) if (character === ",") count++;
#   return count;
# }
# declare const input: any;
# (globalThis as any).answer = commas(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(HOT): lower-to-b3 optimized loops f1
# REQUIRES(HOT): unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=194 kind=CallResult
typesite w3 module=m0 position=46 kind=Variable
typesite w4 module=m0 position=70 kind=Element
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="commas"
    v10 = Convert v9 declared={type=number site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="commas" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number site=w3}
    v3 = IteratorOpen v0
    Jump -> next b2(v2)
  b2(v4: number):
    LoopHint
    v6 = IteratorResume v3
    v7 = ResultAt v6
    v8 = ResultAt v6 index=1
    Branch v7 -> taken b3(), notTaken b4()
  b3():
    v9 = Convert v4 declared={type=number site=w1}
    Return v9
  b4():
    Jump -> next b5()
  b5() handler=b11():
    v10 = Convert v8 declared={type=undefined|null|string site=w4 flags=[OmitsNull, OmitsUndefined]} illTypedCause=ContainerWriterUnseen
    v11 = String string=","
    v12 = StrictEq v10, v11
    Branch v12 -> taken b6(| 0), notTaken b9(| 0)
  b6(v13) handler=b11():
    Jump -> next b7()
  b7() handler=b11():
    v14 = Increment v4
    v15 = Convert v14 declared={type=number site=w3}
    Jump -> next b8()
  b8() handler=b11():
    Jump -> next b10(v15)
  b9(v16) handler=b11():
    Jump -> next b10(v4)
  b10(v17: number) handler=b11():
    Jump -> next b2(v17)
  b11() role=IterationCleanup subject=v3:
    v18 = CatchException
    IteratorClose v3 completion=Throw
    Rethrow v18
}

# `for (const character of text)` makes no iterator, no result object and no text for a character. In the loop for 8-bit characters the position goes up by one and the byte is compared with 44.
# CHECK-LABEL: steps by 1
# CHECK: Int32 b@[[unit]] = Load8Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8,
# CHECK: Int32 b@[[isComma]] = Equal(b@[[unit]], $44(
# CHECK: Branch(b@[[isComma]], Terminal,
# CHECK-LABEL: end of loop
# HOT-LABEL: steps by 1
# HOT-NOT: isLoopPoll
# HOT-NOT: Reads:StringImpl
# HOT-NOT: Reads:JSRopeString
# HOT-NOT: Reads:singleCharacterStrings
# HOT-NOT: ExitsSideways
# HOT-NOT: Writes:
# HOT-NOT: $55296(
# HOT-LABEL: end of loop
# A turn also computes the length of the character, (1 - position) + position, compares it with 1, and shifts the position by the width.
# X64: instructions: 44, patchpoints: 8
# X64: instructions: 17, patchpoints: 2
# ARM64: instructions: 43, patchpoints: 8
# ARM64: instructions: 13, patchpoints: 2
