# function isHttp(url) {
#   return url.slice(0, 4) === "http";
# }
# globalThis.answer = isHttp(String(input));
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=String
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Call v5, -, v7 calleeName="String"
    v9 = Convert v8 declared={type=undefined|null|string flags=[IsExpected]}
    v10 = Call v1, -, v9 calleeName="isHttp"
    v11 = Convert v10 declared={type=boolean flags=[IsExpected]}
    PropSet v4, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="isHttp" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string flags=[IsExpected]}] results=[{type=boolean flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="slice"
    v2 = Convert v1 declared={type=undefined|null|function flags=[IsExpected]}
    v3 = Integer
    v4 = Integer integer=4
    v5 = Call v2, v0, v3, v4 calleeKey="slice" calleeName="url.slice"
    v6 = Convert v5 declared={type=undefined|null|string flags=[IsExpected]}
    v7 = String string="http"
    v8 = StrictEq v6, v7
    v9 = Convert v8 declared={type=boolean flags=[IsExpected]}
    Return v9
}
function f2 module=m0 role=Signature thisType={type=anything} results=[{type=anything}]

# The caller hands over a text, so without a written type the slice is no text either: four bytes of the subject are compared with one immediate (0x70747468 is "http").
# CHECK-LABEL: name="isHttp" role=Source
# CHECK: Int32 b@[[isFour]] = Equal(b@{{*}}, $4({{*}}:StringRangeEqualsLiteral)
# CHECK-NEXT: Branch(b@[[isFour]], Terminal,
# CHECK: Int32 b@[[four]] = Load(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:StringRangeEqualsLiteral)
# CHECK: Int32 b@{{*}} = Equal(b@[[four]], $1886680168(
# CHECK-LABEL: end of function
# NONE-LABEL: name="isHttp" role=Source
# NONE-NOT: :StrictEq)
# NONE-NOT: :CallInline)
# NONE-NOT: :String)
# NONE-NOT: Shl($0(
# NONE-LABEL: end of function
# CALLS-LABEL: f1: size=
# CALLS-NEXT: stub RopeCharacters x1
# CALLS-NEXT: f{{*}}: size=
