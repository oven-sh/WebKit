# function isAbsolute(path: string): boolean {
#   return path.charCodeAt(0) === 47;
# }
# declare const input: any;
# (globalThis as any).answer = isAbsolute(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=20 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=138 kind=CallResult
typesite w3 module=m0 position=54 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="isAbsolute"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="isAbsolute" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="charCodeAt"
    v2 = Integer
    v3 = Call v1, v0, v2 calleeKey="charCodeAt" calleeName="path.charCodeAt"
    v4 = Convert v3 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v5 = Integer integer=47
    v6 = StrictEq v4, v5
    v7 = Convert v6 declared={type=boolean site=w1}
    Return v7
}

# `path.charCodeAt(0) === 47` on a flat 8-bit text is five loads: the cell's word, the length (an empty text has no first unit: that way is rare), the characters, the width, the unit. The unit stays an integer: the comparison is one of integers.
# CHECK-LABEL: name="isAbsolute" role=Source
# CHECK: Int64 b@[[word]] = Load(b@[[path]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0,
# CHECK: Int32 b@[[length]] = Load(b@[[word]], offset = 4, ControlDependent|ReadsImmutable|Reads:StringImpl_length,
# CHECK: Branch(b@[[length]], Terminal,
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Load(b@[[word]], offset = 8, ControlDependent|ReadsImmutable|Reads:StringImpl_data,
# CHECK: Load(b@[[word]], offset = 16, ControlDependent|Reads:StringImpl_hashAndFlags,
# CHECK: Int32 b@{{*}} = Load8Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:GetStringCodeUnit)
# CHECK: Int32 b@[[unit]] = Phi(
# CHECK: Int32 b@[[isSlash]] = Equal(b@[[unit]], $47(
# CHECK-NEXT: Return(b@[[isSlash]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isAbsolute" role=Source
# NONE-NOT: IToD
# NONE-NOT: Double
# NONE-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub RopeCharacters x1
# CALLS-NEXT: f4: size=
