# function isHttp(url: string): boolean {
#   return url.slice(0, 4) === "http";
# }
# declare const input: any;
# (globalThis as any).answer = isHttp(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=134 kind=CallResult
typesite w3 module=m0 position=49 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="isHttp"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="isHttp" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="slice"
    v2 = Integer
    v3 = Integer integer=4
    v4 = Call v1, v0, v2, v3 calleeKey="slice" calleeName="url.slice"
    v5 = Convert v4 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v6 = String string="http"
    v7 = StrictEq v5, v6
    v8 = Convert v7 declared={type=boolean site=w1}
    Return v8
}

# `url.slice(0, 4) === "http"` makes no text for the slice: its bounds are clamped by selects, its length is compared with 4, and four bytes of the subject are compared with one immediate (0x70747468 is "http").
# CHECK-LABEL: name="isHttp" role=Source
# CHECK: Int32 b@[[flatLength]] = Load(b@{{*}}, offset = 4, ControlDependent|ReadsImmutable|Reads:StringImpl_length,
# CHECK: Select(b@{{*}}:StringRange)
# CHECK: Int32 b@[[isFour]] = Equal(b@{{*}}, $4({{*}}:StringRangeEqualsLiteral)
# CHECK-NEXT: Branch(b@[[isFour]], Terminal,
# CHECK: Int32 b@[[four]] = Load(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:StringRangeEqualsLiteral)
# CHECK: Int32 b@{{*}} = Equal(b@[[four]], $1886680168(
# CHECK-LABEL: end of function
# No substring is made and no two texts are compared.
# NONE-LABEL: name="isHttp" role=Source
# NONE-NOT: :StrictEq)
# NONE-NOT: :StringEqualsLiteral)
# NONE-NOT: :CallInline)
# NONE-LABEL: end of function
# A cell is made for the literal on either way to the comparison.
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub CreateConstant.NewString x2
# CALLS-NEXT: stub RopeCharacters x1
# CALLS-NEXT: f4: size=
