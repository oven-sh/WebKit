# function repeated(piece, times) {
#   let out = "";
#   for (let i = 0; i < times; i++) out += piece;
#   return out;
# }
# globalThis.answer = repeated(input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Call v1, -, v6, v8 calleeName="repeated"
    v10 = Convert v9 declared={type=undefined|null|string flags=[IsExpected]}
    PropSet v4, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="repeated" module=m0 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=undefined|null|string flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    Jump -> next b1()
  b1():
    v2 = String string=""
    v3 = Convert v2 declared={type=undefined|null|string flags=[IsExpected]}
    v4 = Integer
    v5 = Convert v4 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v3, v5)
  b2(v6, v7):
    LoopHint
    v9 = Convert v1 declared={type=number flags=[IsExpected]}
    v10 = Less v7, v9
    Branch v10 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v11, v12):
    Jump -> next b4()
  b4():
    v13 = Add v6, v0
    v14 = Convert v13 declared={type=undefined|null|string flags=[IsExpected]}
    Jump -> next b5()
  b5():
    v15 = Increment v11
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v14, v16)
  b6(v17, v18):
    Jump -> next b7()
  b7():
    v19 = Convert v6 declared={type=undefined|null|string flags=[IsExpected]}
    Return v19
}

# Without types `out += piece` still fills the buffer on the stack. A turn has two calls: the piece is added to the empty text, which makes a text of whatever it is, and that text is copied into the buffer.
# CHECK-LABEL: loop #
# CHECK: Int64 b@[[cursor]] = Phi(
# CHECK: Int64 b@[[text]] = Patchpoint(b@{{*}}:Register({{*}}), b@[[piece]]:Register({{*}}), resultConstraints = Register({{*}}:Add)
# CHECK-NEXT: Int64 b@{{*}} = Patchpoint(b@{{*}}:Register({{*}}), b@[[cursor]]:Register({{*}}), b@[[text]]:Register({{*}}), resultConstraints = Register({{*}}:StringBuilderAppendString)
# CHECK-LABEL: end of loop
# No rope is made, and the text is made once, behind the loop.
# CALLS-LABEL: f1: size=
# CALLS-NOT: Concatenate
# CALLS: operation operationAOTStackStringBuilderFinish x1
# CALLS-NOT: Concatenate
# CALLS: f{{*}}: size=
