# function size(text: string): number {
#   return text.length;
# }
# declare const input: any;
# (globalThis as any).answer = size(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=117 kind=CallResult
typesite w3 module=m0 position=47 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="size"
    v10 = Convert v9 declared={type=number site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="size" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=number site=w3} illTypedCause=Assertion
    Return v2
}

# The length of a flat text is two loads: the word of the cell that points to the characters' header, then the length in that header.
# One bit of the word says that the text is a rope. A rope has its length in the cell.
# CHECK-LABEL: name="size" role=Source
# CHECK: Int64 b@[[text]] = ArgumentReg(
# CHECK: Int64 b@[[word]] = Load(b@[[text]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:GetStringLength)
# CHECK: Int64 b@[[isRope]] = BitAnd(b@[[word]], $1(
# CHECK: Branch(b@[[isRope]], Terminal,
# CHECK-NEXT: Successors: Then:Unlikely:#[[rope]], Else:#[[flat]]
# CHECK-NEXT: BB#[[flat]]:
# CHECK: Int32 b@{{*}} = Load(b@[[word]], offset = 4, ControlDependent|ReadsImmutable|Reads:StringImpl_length,
# CHECK: BB#[[rope]]:
# CHECK: Int32 b@{{*}} = Load(b@[[text]], offset = 16, ControlDependent|ReadsImmutable|Reads:JSRopeString_fiber1,
# CHECK-LABEL: end of function
# Nothing is called and the rope stays a rope.
# NONE-LABEL: name="size" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
# X64-LABEL: name="size" role=Source
# X64-NEXT: instructions: 8, patchpoints: 1
# ARM64-LABEL: name="size" role=Source
# ARM64-NEXT: instructions: 8, patchpoints: 1
