# function unit(text: string, position: number): number {
#   return text.charCodeAt(position);
# }
# declare const input: any;
# (globalThis as any).answer = unit(input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=28 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=149 kind=CallResult
typesite w4 module=m0 position=65 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = Call v1, -, v8, v11 calleeName="unit"
    v13 = Convert v12 declared={type=number site=w3}
    PropSet v5, v13 key="answer"
    v15 = Undefined
    Return v15
}
function f1 name="unit" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="charCodeAt"
    v3 = Call v2, v0, v1 calleeKey="charCodeAt" calleeName="text.charCodeAt"
    ReturnCall v3 casts=[{declared={type=number site=w4}}, {declared={type=number site=w2}}]
}

# `text.charCodeAt(position)` with a position that is any number: the number is tested for being a 32-bit integer, that integer is compared once, without sign, with the length, and the byte is loaded. The unit is boxed by one addition.
# CHECK-LABEL: name="unit" role=Source
# CHECK: Int32 b@[[position]] = Trunc(b@
# CHECK: Int64 b@[[word]] = Load(b@[[text]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0,
# CHECK: Int64 b@[[isRope]] = BitAnd(b@[[word]], $1(
# CHECK: Branch(b@[[isRope]], Terminal,
# CHECK: Int32 b@[[length]] = Phi(
# CHECK: Int32 b@[[isInside]] = Below(b@[[position]], b@[[length]],
# CHECK-NEXT: Branch(b@[[isInside]], Terminal,
# The test for a rope is made a second time, for the characters.
# CHECK: Branch(b@[[isRope]], Terminal,
# CHECK: Int32 b@{{*}} = Load8Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8, {{*}}:GetStringCodeUnit)
# CHECK: Int32 b@[[unit]] = Phi(
# CHECK: Int64 b@[[wide]] = ZExt32(b@[[unit]])
# CHECK: Int64 b@{{*}} = Add(b@[[wide]], b@
# CHECK-LABEL: end of function
# On the way to the byte the word of the cell and the length are read once each, and nothing is called.
# NONE-LABEL: name="unit" role=Source
# NONE: Reads:JSRopeString_fiber0
# NONE-NOT: Reads:JSRopeString_fiber0
# NONE-NOT: ExitsSideways
# NONE: Reads:StringImpl_length
# NONE-NOT: Reads:StringImpl_length
# NONE-NOT: Reads:JSRopeString_fiber0
# NONE-NOT: ExitsSideways
# NONE: Reads:characters8
# NONE-LABEL: end of function
