# function isApi(path) {
#   return path.startsWith("/api/");
# }
# globalThis.answer = isApi(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Call v1, -, v6 calleeName="isApi"
    PropSet v4, v7 key="answer"
    v9 = Undefined
    Return v9
}
function f1 name="isApi" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="startsWith"
    v2 = Convert v1 declared={type=undefined|null|function flags=[IsExpected]}
    v3 = String string="/api/"
    v4 = Call v2, v0, v3 calleeKey="startsWith" calleeName="path.startsWith"
    ReturnCall v4
}

# Without types `path.startsWith("/api/")` first asks whether the value is a text: is it a cell, is the cell's type byte 2. `startsWith` is not read by name on that way: what follows is the code of the typed form, the length against 5 and the characters against immediates.
# CHECK-LABEL: name="isApi" role=Source
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[path]], b@{{*}}:TypeTest)
# CHECK: Branch(b@[[notCell]], Terminal,
# CHECK-NEXT: Successors: Then:Unlikely:#[[other]], Else:#
# CHECK: Int32 b@[[type]] = Load8Z(b@[[path]], offset = 5, ControlDependent|ReadsImmutable|Reads:JSCell_typeInfoType,
# CHECK: Int32 b@[[isText]] = Equal(b@[[type]], $2(
# CHECK-NEXT: Branch(b@[[isText]], Terminal,
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Unlikely:#[[other]]
# CHECK: Load(b@[[path]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:StringStartsWithLiteral)
# CHECK: Int32 b@{{*}} = AboveEqual(b@{{*}}, $5(
# CHECK: Int32 b@[[four]] = Load(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8,
# CHECK: Equal(b@[[four]], $1768972591(
# CHECK-LABEL: end of function
# Up to the comparison of the characters nothing is called.
# NONE-LABEL: name="isApi" role=Source
# NONE-NOT: ExitsSideways
# NONE: $1768972591(
# NONE-LABEL: end of function
