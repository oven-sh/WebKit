# CHECK: Int64 b@[[second]] = Patchpoint(b@[[first]]:Register({{*}}), b@[[dot]]:Register({{*}}), b@[[c]]:Register({{*}}), resultConstraints = Register(
# CHECK-NEXT: Return(b@[[second]], Terminal)
