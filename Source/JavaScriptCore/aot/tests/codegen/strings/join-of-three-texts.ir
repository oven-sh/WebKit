# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 position=27 kind=Parameter function=f1
typesite w2 module=m0 position=38 kind=Parameter function=f1
typesite w3 module=m0 kind=Result
typesite w4 module=m0 position=146 kind=CallResult
typesite w5 module=m0 position=68 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=undefined|null|string flags=[IsExpected]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=undefined|null|string flags=[IsExpected]}
    v15 = Call v1, -, v8, v11, v14 calleeName="dotted"
    v16 = Convert v15 declared={type=undefined|null|string site=w4 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v16 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="dotted" module=m0 flags=[IsChecked, HasExplicitName] length=3 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|string, v2: undefined|null|string):
    Jump -> next b1()
  b1():
    v3 = NewArray v0, v1, v2 contents=undefined|null|string
    v4 = PropGet v3 key="join"
    v5 = String string="."
    v6 = Call v4, v3, v5 calleeKey="join" calleeName="join"
    ReturnCall v6 casts=[{declared={type=undefined|null|string site=w5 flags=[OmitsNull, OmitsUndefined]}}, {declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}}]
}

# `[a, b, c].join(".")` makes no array and calls no `join`: it is two ropes of three, a + "." + b and that + "." + c. The cell of "." is loaded once.
# CHECK-LABEL: name="dotted" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[dot]] = Load(b@{{*}}, offset = 368, ControlDependent|ReadsImmutable|Reads:singleCharacterStrings, {{*}}:String)
