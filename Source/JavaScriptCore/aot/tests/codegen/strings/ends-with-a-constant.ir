# function isTypeScript(path: string): boolean {
#   return path.endsWith(".ts");
# }
# declare const input: any;
# (globalThis as any).answer = isTypeScript(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=22 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=135 kind=CallResult
typesite w3 module=m0 position=56 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="isTypeScript"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="isTypeScript" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="endsWith"
    v2 = String string=".ts"
    v3 = Call v1, v0, v2 calleeKey="endsWith" calleeName="path.endsWith"
    ReturnCall v3 casts=[{declared={type=boolean site=w3}}, {declared={type=boolean site=w1}}]
}

# `path.endsWith(".ts")` on a flat 8-bit text: the length is compared with 3, then the characters from length - 3 on: two with one 16-bit immediate (0x742e is ".t"), the third with 115.
# CHECK-LABEL: name="isTypeScript" role=Source
# CHECK: Int64 b@[[word]] = Load(b@[[path]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:StringEndsWithLiteral)
# CHECK: Successors: Then:Unlikely:#[[rope]], Else:#
# CHECK: Int64 b@[[characters]] = Phi(
# CHECK: Int32 b@[[length]] = Phi(
# CHECK: Int32 b@[[isLongEnough]] = AboveEqual(b@[[length]], $3(
# CHECK: Branch(b@[[isLongEnough]], Terminal,
# CHECK: Int32 b@[[start]] = Add(b@[[length]], $-3(
# CHECK: Int32 b@[[two]] = Load16Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8,
# CHECK: Equal(b@[[two]], $29742(
# CHECK: Int32 b@[[third]] = Load8Z(b@{{*}}, offset = 2, ControlDependent|ReadsImmutable|Reads:characters8,
# CHECK: Equal(b@[[third]], $115(
# CHECK: BB#[[rope]]:
# CHECK: Patchpoint(b@[[path]]:Register({{*}}ExitsSideways
# CHECK-LABEL: end of function
# Up to the block of the rope nothing is called, and no cell is made for the literal.
# NONE-LABEL: name="isTypeScript" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: Writes:
# NONE: Reads:JSRopeString_fiber1
# NONE-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub RopeCharacters x1
# CALLS-NEXT: f4: size=
