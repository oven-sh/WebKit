# function kindOf(word) {
#   if (word === "get") return 1;
#   if (word === "post") return 2;
#   return 0;
# }
# globalThis.answer = kindOf(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Call v1, -, v6 calleeName="kindOf"
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    PropSet v4, v8 key="answer"
    v10 = Undefined
    Return v10
}
function f1 name="kindOf" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = String string="get"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Integer integer=1
    v5 = Convert v4 declared={type=number flags=[IsExpected]}
    Return v5
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = String string="post"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b6(| 0), notTaken b8(| 0)
  b6(v9):
    Jump -> next b7()
  b7():
    v10 = Integer integer=2
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    Return v11
  b8(v12):
    Jump -> next b9()
  b9():
    v13 = Integer
    v14 = Convert v13 declared={type=number flags=[IsExpected]}
    Return v14
}

# Without types `word === "get"` is still a comparison with an immediate (0x746567 is "get", 0x74736f70 is "post"). The stub takes any value: no type is tested in front of it, it only reads, and it ends the block by branching itself.
