# function orDefault(name: string): string {
#   return name ? name : "anonymous";
# }
# declare const input: any;
# (globalThis as any).answer = orDefault(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=19 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=136 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="orDefault"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="orDefault" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = ToBoolean v0
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    Jump -> next b6(v2)
  b4(v3):
    Jump -> next b5()
  b5():
    v4 = String string="anonymous"
    Jump -> next b6(v4)
  b6(v5):
    v6 = Convert v5 declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}

# There is one empty text, so a text used as a condition is compared with that cell. Neither its length nor its kind is read.
# CHECK-LABEL: name="orDefault" role=Source
# CHECK: Int64 b@[[empty]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields, {{*}}:ToBoolean)
# CHECK: Int32 b@[[isFilled]] = NotEqual(b@{{*}}, b@[[empty]], {{*}}:ToBoolean)
# CHECK-NEXT: Branch(b@[[isFilled]], Terminal,
# CHECK-LABEL: end of function
# NONE-LABEL: name="orDefault" role=Source
# NONE-NOT: Reads:JSRopeString
# NONE-NOT: Reads:StringImpl
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
