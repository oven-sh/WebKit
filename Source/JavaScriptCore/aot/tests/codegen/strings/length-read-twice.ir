# function half(text: string): number {
#   return text.length - (text.length >> 1);
# }
# declare const input: any;
# (globalThis as any).answer = half(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=138 kind=CallResult
typesite w3 module=m0 position=47 kind=PropertyRead
typesite w4 module=m0 position=62 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="half"
    v10 = Convert v9 declared={type=number site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="half" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=number site=w3} illTypedCause=Assertion
    v3 = PropGet v0 key="length"
    v4 = Convert v3 declared={type=number site=w4} illTypedCause=Assertion
    v5 = Integer integer=1
    v6 = RShift v4, v5
    v7 = Sub v2, v6
    v8 = Convert v7 declared={type=number site=w1}
    Return v8
}

# Two reads of the length of one text are one: one load of the cell's word, one test for a rope, one load of the length on either side, and one value where the two sides meet.
# CHECK-LABEL: name="half" role=Source
# CHECK: Load(b@[[text]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0,
# CHECK-NOT: Reads:JSRopeString_fiber0
# CHECK: Branch(
# CHECK-NOT: Branch(
# CHECK: Reads:StringImpl_length
# CHECK-NOT: Reads:StringImpl_length
# CHECK: Int32 b@[[length]] = Phi(
# CHECK-NOT: Phi(
# CHECK: Int32 b@[[half]] = SShr(b@[[length]], $1(
# CHECK: Int32 b@{{*}} = Sub(b@[[length]], b@[[half]],
# CHECK-NOT: Branch(
# CHECK: Reads:JSRopeString_fiber1
# CHECK-NOT: Reads:JSRopeString_fiber1
# CHECK-LABEL: end of function
# The difference of two lengths cannot leave the 32-bit integers, so it is not checked.
# NONE-LABEL: name="half" role=Source
# NONE-NOT: CheckSub
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
# X64-LABEL: name="half" role=Source
# X64-NEXT: instructions: 11, patchpoints: 2
# ARM64-LABEL: name="half" role=Source
# ARM64-NEXT: instructions: 9, patchpoints: 2
