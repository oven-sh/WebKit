# function hasUnits(text: string): boolean {
#   return text.length > 0;
# }
# declare const input: any;
# (globalThis as any).answer = hasUnits(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=18 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=126 kind=CallResult
typesite w3 module=m0 position=52 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="hasUnits"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="hasUnits" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=number site=w3} illTypedCause=Assertion
    v3 = Integer
    v4 = Greater v2, v3
    v5 = Convert v4 declared={type=boolean site=w1}
    Return v5
}

# Every text but the empty one has a length above 0, and there is one empty text: `text.length > 0` compares the cell with it and reads no length.
# CHECK-LABEL: name="hasUnits" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[empty]] = Load(b@{{*}}, offset = {{*}}, ControlDependent|ReadsImmutable|Reads:AOTInstance_fixedFields,
# CHECK: Int32 b@[[hasUnits]] = NotEqual(b@{{*}}, b@[[empty]],
# CHECK-NEXT: Return(b@[[hasUnits]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="hasUnits" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Reads:JSRopeString
# NONE-NOT: Reads:StringImpl
# NONE-LABEL: end of function
# X64-LABEL: name="hasUnits" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="hasUnits" role=Source
# ARM64-NEXT: instructions: 3, patchpoints: 0
