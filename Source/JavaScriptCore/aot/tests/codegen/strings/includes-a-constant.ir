# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=19 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=130 kind=CallResult
typesite w3 module=m0 position=52 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="hasScheme"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="hasScheme" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="includes"
    v2 = String string="://"
    v3 = Call v1, v0, v2 calleeKey="includes" calleeName="url.includes"
    ReturnCall v3 casts=[{declared={type=boolean site=w3}}, {declared={type=boolean site=w1}}]
}

# `url.includes("://")` hands the characters and the length of a flat 8-bit text to the search for a literal, which the call names by a number. No cell is made for the literal, and a rope is flattened by the stub that hands back its characters.
# CHECK-LABEL: name="hasScheme" role=Source
# CHECK: Int64 b@[[word]] = Load(b@[[url]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:StringIndexOfLiteral)
# CHECK: Int64 b@[[characters]] = Phi(
# CHECK: Int32 b@[[length]] = Phi(
# CHECK: Successors: Then:#[[narrow]], Else:Unlikely:#
# CHECK-NEXT: BB#[[narrow]]:
# CHECK: Int64 b@{{*}} = Patchpoint(b@[[characters]]:Register({{*}}), b@[[length]]:Register({{*}}), ${{*}}(b@{{*}}):Register({{*}}), $0(b@{{*}}):Register({{*}}), resultConstraints = Register(
# CHECK: Int32 b@[[position]] = Phi(
# CHECK: Int32 b@{{*}} = NotEqual(b@[[position]], $-1(
# CHECK-LABEL: end of function
