# type Kind = "eight" | "nine" | "six";
# function lengthOf(kind: Kind): number {
#   return kind.length;
# }
# declare const input: any;
# (globalThis as any).answer = lengthOf(input > 1 ? "eight" : input ? "nine" : "six");
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=56 kind=Parameter function=f1
typesite w1 module=m0 position=38 kind=Result
typesite w2 module=m0 position=157 kind=CallResult
typesite w3 module=m0 position=87 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Integer integer=1
    v10 = Greater v8, v9
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = String string="eight"
    Jump -> next b8(v11)
  b3():
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = ToBoolean v13
    Branch v14 -> taken b4(| 0), notTaken b6(| 0)
  b4(v15):
    Jump -> next b5()
  b5():
    v16 = String string="nine"
    Jump -> next b8(v16)
  b6(v17):
    Jump -> next b7()
  b7():
    v18 = String string="six"
    Jump -> next b8(v18)
  b8(v19):
    v20 = Call v1, -, v19 calleeName="lengthOf"
    v21 = Convert v20 declared={type=number site=w2}
    PropSet v5, v21 key="answer"
    v23 = Undefined
    Return v23
}
function f1 name="lengthOf" module=m0 position=38 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|"eight"|"nine"|"six" site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|"eight"|"nine"|"six"):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=number site=w3} illTypedCause=Assertion
    Return v2
}

# The text is one of three that the program spells, and arrives as the number of its text. The build knows the length of each: the length is chosen by comparing the number.
# No string is made, nothing is read from memory and nothing is called.
# CHECK-LABEL: name="lengthOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[kind]] = ArgumentReg(
# CHECK-NOT: Load
# CHECK-NOT: Patchpoint
# CHECK: Int32 b@[[isEight]] = Equal(b@[[kind]],
# CHECK: Int32 b@[[fiveOrThree]] = Select(b@[[isEight]], $5(b@{{*}}), $3(b@{{*}}),
# CHECK: Int32 b@[[isNine]] = Equal(b@[[kind]],
# CHECK: Int32 b@[[length]] = Select(b@[[isNine]], $4(b@{{*}}), b@[[fiveOrThree]],
# CHECK-NEXT: Return(b@[[length]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="lengthOf" role=Source
# X64-NEXT: instructions: 6, patchpoints: 0
