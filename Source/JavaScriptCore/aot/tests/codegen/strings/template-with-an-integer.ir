# function label(index: number): string {
#   return `item-${index | 0}`;
# }
# declare const input: any;
# (globalThis as any).answer = label(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: no-jscvt unsanitized-code
# RUN(CALLS): generate-code calls
# REQUIRES(CALLS): no-jscvt

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=127 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="label"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="label" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = String string="item-"
    v2 = Integer
    v3 = BitOr v0, v2
    v4 = ToString v3
    v5 = Strcat v1, v4
    v6 = Convert v5 declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}

# An integer in a template is made a text by the stub for integers, which gets it sign-extended in a register and not boxed. Then the literal and that text are one rope of two.
# CHECK-LABEL: name="label" role=Source
# CHECK: Int64 b@[[prefix]] = Patchpoint(resultConstraints = Register({{*}}:String)
# CHECK: Int32 b@[[index]] = Phi(
# CHECK: Int64 b@[[wide]] = SExt32(b@[[index]], {{*}}:Strcat)
# CHECK-NEXT: Int64 b@[[digits]] = Patchpoint(b@[[wide]]:Register({{*}}), resultConstraints = Register({{*}}:Strcat)
# CHECK-NEXT: Int64 b@[[rope]] = Patchpoint(b@[[prefix]]:Register({{*}}), b@[[digits]]:Register({{*}}), resultConstraints = Register({{*}}:Strcat)
# CHECK-NEXT: Return(b@[[rope]], Terminal)
# CHECK-LABEL: end of function
# The operation belongs to `index | 0`, on its rare side.
# CALLS-LABEL: f3: size=
# CALLS-NEXT: operation operationAOTToInt32 x1
# CALLS-NEXT: stub Concatenate.n2 x1
# CALLS-NEXT: stub CreateConstant.String x1
# CALLS-NEXT: stub IntegerToString x1
# CALLS-NEXT: f4: size=
