# function dashes(count: number): string {
#   let out = "";
#   for (let i = 0; i < count; i++) out += "-";
#   return out;
# }
# declare const input: any;
# (globalThis as any).answer = dashes(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(HOT): lower-to-b3 optimized loops f1
# REQUIRES(HOT): unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=174 kind=CallResult
typesite w3 module=m0 position=47 kind=Variable
typesite w4 module=m0 position=68 kind=Variable
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="dashes"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="dashes" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = String string=""
    v2 = Convert v1 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w4}
    Jump -> next b2(v2, v4)
  b2(v5: undefined|null|string, v6: number):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v9, v10):
    Jump -> next b4()
  b4():
    v11 = String string="-"
    v12 = Add v5, v11
    v13 = Convert v12 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}
    Jump -> next b5()
  b5():
    v14 = Increment v9
    v15 = Convert v14 declared={type=number site=w4}
    Jump -> next b2(v13, v15)
  b6(v16, v17):
    Jump -> next b7()
  b7():
    v18 = Convert v5 declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v18
}

# `out += "-"` in a loop fills a buffer on the stack: the character is stored as an immediate, the cursor goes up by one and is compared with the buffer's limit. Cursor and limit go round the loop as values: neither is loaded. No rope and no text is made in the loop.
# Under a bound that is an int32 eight iterations are written out. The loop that steps by one runs what is left.
# CHECK-LABEL: steps by 1
# CHECK: Int64 b@[[cursor]] = Phi(
# CHECK: Int64 b@[[limit]] = Phi(
# CHECK: Store8($45(b@{{*}}), b@[[cursor]], ControlDependent|Writes:stringBuilderBytes, {{*}}:StringBuilderAppendConstant)
# CHECK-NOT: Load(
# CHECK: Int64 b@[[next]] = Add(b@[[cursor]], $1(
# CHECK: Int32 b@[[fits]] = BelowEqual(b@[[next]], b@[[limit]],
# CHECK-NEXT: Branch(b@[[fits]], Terminal,
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#[[grow]]
# Only a full buffer calls. The call moves the characters, so behind it the limit is read out of the buffer's record.
# CHECK: BB#[[grow]]:
# CHECK: Patchpoint(b@{{*}}ExitsSideways{{*}}:StringBuilderAppendConstant)
# CHECK-NEXT: Int64 b@{{*}} = Load(b@{{*}}, ControlDependent|Reads:AOTStackStringBuilder_fields,
# CHECK-LABEL: end of loop
# HOT-LABEL: loop #
# HOT-NOT: AllocatorState
# HOT-NOT: Reads:AOTInstance
# HOT-NOT: Reads:AOTStackStringBuilder_fields
# HOT-NOT: Reads:StringBuilderContents
# HOT: Successors: Then:#{{*}}, Else:Rare:#
# HOT-LABEL: end of loop
# The loops hold a poll or, on their rare side, a call, so x86-64 is counted where the calling convention is not that of Windows.
# The rare block is the call, the load of the limit and the jump back.
# X64: instructions: 5, patchpoints: 0, rare instructions: 3
# X64: instructions: 26, patchpoints: 1, polls: 1
# ARM64: instructions: 26, patchpoints: 1, polls: 1
# ARM64: instructions: 5, patchpoints: 0, rare instructions: 3
# The text is made once, behind the loops: the two above and the copy for a bound that is no int32.
# CALLS-LABEL: f3: size=
# CALLS: operation operationAOTStackStringBuilderFinish x1
# CALLS-NEXT: operation operationAOTStackStringBuilderGrow x3
# CALLS-NEXT: f4: size=
