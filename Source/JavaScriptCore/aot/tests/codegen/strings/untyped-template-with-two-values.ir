# function path(folder, file) {
#   return `${folder}/${file}`;
# }
# for (let turn = 0; turn < input; turn++) globalThis.answer = path(input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Integer
    v3 = Convert v2 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v3)
  b2(v4):
    LoopHint
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Less v4, v7
    Branch v8 -> taken b3(| 0), notTaken b6(| 0)
  b3(v9):
    Jump -> next b4()
  b4():
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="globalThis" [isFreeName]
    v12 = Convert v11 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = Call v1, -, v14, v16 calleeName="path"
    v18 = Convert v17 declared={type=undefined|null|string flags=[IsExpected]}
    PropSet v12, v18 key="answer"
    Jump -> next b5()
  b5():
    v20 = Increment v9
    v21 = Convert v20 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v21)
  b6(v22):
    Jump -> next b7()
  b7():
    v23 = Undefined
    Return v23
}
function f1 name="path" module=m0 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=undefined|null|string flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    Jump -> next b1()
  b1():
    v2 = ToString v0
    v3 = String string="/"
    v4 = ToString v1
    v5 = Strcat v2, v3, v4
    v6 = Convert v5 declared={type=undefined|null|string flags=[IsExpected]}
    Return v6
}

# Without types each part of a template is asked whether it is a text: is it a cell, is the cell's type byte 2. A text goes into the rope as it is, and that is the way that falls through.
# Anything else is converted by the run time, on an unlikely path. The rope is the same one call as with types.
# CHECK-LABEL: name="path" role=Source
# CHECK: Int64 b@[[isNoCell]] = BitAnd(b@[[folder]], b@{{*}}:ToString)
# CHECK: Branch(b@[[isNoCell]], Terminal,
# CHECK-NEXT: Successors: Then:Unlikely:#[[convert]], Else:#
# CHECK: Int32 b@[[kind]] = Load8Z(b@[[folder]], offset = 5, ControlDependent|ReadsImmutable|Reads:JSCell_typeInfoType, {{*}}:ToString)
# CHECK: Successors: Then:#{{*}}, Else:Unlikely:#[[convert]]
# CHECK: Int64 b@[[first]] = Phi(
# CHECK: Int64 b@[[second]] = Phi(
# CHECK: Int64 b@[[rope]] = Patchpoint(b@[[first]]:Register({{*}}), b@{{*}}:Register({{*}}), b@[[second]]:Register({{*}}), resultConstraints = Register({{*}}:Strcat)
# CHECK-NEXT: Return(b@[[rope]], Terminal)
# CHECK: BB#[[convert]]:
# CHECK: Patchpoint(b@[[folder]]:{{*}}:ToString)
# CHECK-LABEL: end of function
# CALLS-LABEL: f1: size=
# CALLS-NEXT: operation operationAOTToString x2
# CALLS-NEXT: stub Concatenate.n3 x1
# CALLS-NEXT: f{{*}}: size=
