# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[method]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[lower]] = Patchpoint(b@[[method]]:ColdAny, resultConstraints = Register({{*}}:CallInline)
# CHECK: Patchpoint(b@[[lower]]:Register({{*}}), $7628135(b@{{*}}):Register({{*}}), resultConstraints = WarmAny, Terminal|ControlDependent|Reads:{argumentBuffer, StringStorage}, {{*}}:StringEqualsLiteral)
# CHECK-LABEL: end of function
