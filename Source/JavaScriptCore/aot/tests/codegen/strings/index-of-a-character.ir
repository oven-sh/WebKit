# function firstSlash(path: string): number {
#   return path.indexOf("/");
# }
# declare const input: any;
# (globalThis as any).answer = firstSlash(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=20 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=129 kind=CallResult
typesite w3 module=m0 position=53 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="firstSlash"
    v10 = Convert v9 declared={type=number site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="firstSlash" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="indexOf"
    v2 = String string="/"
    v3 = Call v1, v0, v2 calleeKey="indexOf" calleeName="path.indexOf"
    ReturnCall v3 casts=[{declared={type=number site=w3}}, {declared={type=number site=w1}}]
}

# `path.indexOf("/")` hands the characters, the length, the code 47 and the start 0 of a flat 8-bit text to a stub that reads characters and does nothing else: it cannot throw, allocate or write.
# CHECK-LABEL: name="firstSlash" role=Source
# CHECK: Int64 b@[[word]] = Load(b@[[path]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0, {{*}}:StringIndexOfCharacter)
# CHECK: Successors: Then:Unlikely:#[[rope]], Else:#
# CHECK: Int64 b@[[characters]] = Load(b@[[word]], offset = 8, ControlDependent|ReadsImmutable|Reads:StringImpl_data,
# CHECK: Int32 b@[[length]] = Load(b@[[word]], offset = 4, ControlDependent|ReadsImmutable|Reads:StringImpl_length,
# CHECK: Successors: Then:#[[narrow]], Else:Unlikely:#
# CHECK-NEXT: BB#[[narrow]]:
# CHECK: Int64 b@{{*}} = Patchpoint(b@[[characters]]:Register({{*}}), b@[[length]]:Register({{*}}), $47(b@{{*}}):Register({{*}}), $0(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), ControlDependent|Reads:{argumentBuffer, StringStorage}, {{*}}:StringIndexOfCharacter)
# The position is an integer from -1 on, so it is boxed by one addition.
# CHECK: Int64 b@[[wide]] = ZExt32(b@[[position]])
# CHECK: Int64 b@[[boxed]] = Add(b@[[wide]], b@
# CHECK-NEXT: Return(b@[[boxed]], Terminal)
# CHECK: b@[[position]]: range = [-1,2147483647]
# CHECK-LABEL: end of function
# A 16-bit text and a rope go to the run time.
# CALLS-LABEL: f3: size=
# CALLS-NEXT: operation operationAOTStringFindCharacter16 x1
# CALLS-NEXT: operation operationAOTStringIndexOfCharacter x1
# CALLS-NEXT: stub FindCharacter8 x1
# CALLS-NEXT: f4: size=
