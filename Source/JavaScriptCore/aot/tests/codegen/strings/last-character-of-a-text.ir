# function last(text: string): string {
#   return text[text.length - 1];
# }
# declare const input: any;
# (globalThis as any).answer = last(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=127 kind=CallResult
typesite w3 module=m0 position=52 kind=PropertyRead
typesite w4 module=m0 position=47 kind=Element
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="last"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="last" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="length"
    v2 = Convert v1 declared={type=number site=w3} illTypedCause=Assertion
    v3 = Integer integer=1
    v4 = Sub v2, v3
    v5 = ElemGet v0, v4
    v6 = Convert v5 declared={type=undefined|null|string site=w4 flags=[OmitsNull]} illTypedCause=FromLooseType
    Return v6
}

# `text[text.length - 1]` on a flat 8-bit text: one comparison of the index with the length (an empty text gives undefined), one load of the byte, one load out of the table of one-character texts at byte * 8. No text is allocated.
# CHECK-LABEL: name="last" role=Source
# CHECK: Int64 b@[[word]] = Load(b@[[text]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0,
# CHECK: Int32 b@[[flatLength]] = Load(b@[[word]], offset = 4, ControlDependent|ReadsImmutable|Reads:StringImpl_length,
# CHECK: Int32 b@{{*}} = Add(b@[[flatLength]], $-1(
# CHECK: Int32 b@[[isInside]] = Below(b@[[index]], b@[[length]],
# CHECK: Branch(b@[[isInside]], Terminal,
# CHECK: Int32 b@{{*}} = Load8Z(b@{{*}}, ControlDependent|ReadsImmutable|Reads:characters8,
# CHECK: Int64 b@[[offset]] = Shl(b@{{*}}, $3(
# CHECK: Int64 b@[[address]] = Add(b@
# CHECK: Int64 b@{{*}} = Load(b@[[address]], ControlDependent|ReadsImmutable|Reads:singleCharacterStrings,
# CHECK-LABEL: end of function
# The length is read once for the subtraction and the comparison.
# NONE-LABEL: name="last" role=Source
# NONE: Reads:StringImpl_length
# NONE-NOT: Reads:StringImpl_length
# NONE-LABEL: end of function
# A rope hands back its characters by a stub. A 16-bit unit above the table's end gets its text from the run time.
# CALLS-LABEL: f3: size=
# CALLS-NEXT: operation operationAOTCharToString x1
# CALLS-NEXT: stub RopeCharacters x1
# CALLS-NEXT: f4: size=
