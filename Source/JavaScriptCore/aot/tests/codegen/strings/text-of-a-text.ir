# function same(name: string): string {
#   return `${name}` + String(name) + name.toString();
# }
# declare const input: any;
# (globalThis as any).answer = same(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=148 kind=CallResult
typesite w3 module=m0 position=59 kind=CallResult
typesite w4 module=m0 position=74 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="same"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="same" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = ToString v0
    v2 = Builtin builtin=String
    v3 = Call v2, -, v0 calleeName="String"
    v4 = Convert v3 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v5 = Add v1, v4
    v6 = PropGet v0 key="toString"
    v7 = Call v6, v0 calleeKey="toString" calleeName="name.toString"
    v8 = Convert v7 declared={type=undefined|null|string site=w4 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v9 = Add v5, v8
    v10 = Convert v9 declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v10
}

# A template of one text, `String(text)` and `text.toString()` are the text itself: nothing is converted, tested or called for them. What is left is the rope of the three.
# CHECK-LABEL: name="same" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[rope]] = Patchpoint(b@[[name]]:Register({{*}}), b@[[name]]:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}:Strcat)
# CHECK-NEXT: Return(b@[[rope]], Terminal)
# CHECK-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub Concatenate.n3 x1
# CALLS-NEXT: f4: size=
