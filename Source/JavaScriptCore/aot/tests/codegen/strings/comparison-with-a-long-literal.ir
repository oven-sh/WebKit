# function isJson(type: string): boolean {
#   return type === "application/json; charset=utf-8";
# }
# declare const input: any;
# (globalThis as any).answer = isJson(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=151 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|string flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="isJson"
    v10 = Convert v9 declared={type=boolean site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="isJson" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = String string="application/json; charset=utf-8"
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean site=w1}
    Return v3
}

# A literal that does not fit into a register is compared by one stub, which gets the text alone: the literal's characters are named by the call site.
# The stub reads characters and nothing else. It neither allocates nor throws, so no cell is made for the literal.
# CHECK-LABEL: name="isJson" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[type]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[answer]] = Patchpoint(b@[[type]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent|Reads:{argumentBuffer, StringStorage}, {{*}}:StringEqualsLiteral)
# CHECK-NEXT: Int32 b@[[isEqual]] = Trunc(b@[[answer]],
# CHECK-NEXT: Return(b@[[isEqual]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isJson" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Load
# NONE-LABEL: end of function
# CALLS-LABEL: f3: size=
# CALLS-NEXT: stub StringEqualsLiteral x1
# CALLS-NEXT: f4: size=
