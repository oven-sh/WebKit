# An integer that may lie outside of int32 is made a string by the stub that looks into the caches of small and of recent integers, whatever the form. A number that is no integer calls the operation
# FORM: Selected
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="wideInteger" parameters=[{type=int[0, 4294967294]}] results=[{type=string}] {
    v1 = ToString v0 form=NumberByOperation
    Return v1
}
# CHECK: f0: size=
# CHECK-NEXT: stub IntegerToString x1
# CHECK-NEXT: f1: size=

function f1 name="wideIntegerInFastCode" parameters=[{type=int[0, 4294967294]}] results=[{type=string}] {
    v1 = ToString v0 form=Number
    Return v1
}
# CHECK-NEXT: stub IntegerToString x1
# CHECK-NEXT: f2: size=

function f2 name="int32" parameters=[{type=i32}] results=[{type=string}] {
    v1 = ToString v0 form=NumberByOperation
    Return v1
}
# CHECK-NEXT: stub IntegerToString x1
# CHECK-NEXT: f3: size=

function f3 name="anyNumber" parameters=[{type=number}] results=[{type=string}] {
    v1 = ToString v0 form=NumberByOperation
    Return v1
}
# CHECK-NEXT: operation operationAOTDoubleToString x1
# CHECK-NOT: stub IntegerToString
