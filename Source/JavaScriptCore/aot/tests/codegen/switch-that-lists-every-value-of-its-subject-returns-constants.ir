  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="weightOf"
    v10 = Convert v9 declared={type=number site=w2}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="weightOf" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer integer=7
    v2 = BitAnd v0, v1
    Switch v2 cases=[0, 1, 2, 3, 4, 5, 6, 7] -> case b2(), case b3(), case b4(), case b5(), case b6(), case b7(), case b8(), case b9(), otherwise b10()
  b2():
    v3 = Integer integer=7
    v4 = Convert v3 declared={type=number site=w1}
    Return v4
  b3():
    v5 = Integer integer=3
    v6 = Convert v5 declared={type=number site=w1}
    Return v6
  b4():
