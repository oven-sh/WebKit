# Arithmetic whose result is truncated by `| 0`, Math.imul and the shifts are 32-bit integer operations: no overflow check, and no double once both parameters are integers.
# CHECK-LABEL: name="mix" role=Source
# CHECK: Int32 b@[[shifted]] = Shl(b@[[b]], $3(
# CHECK: Int32 b@{{*}} = Sub(
# CHECK: Int32 b@[[hash]] = Add(
# CHECK: Int32 b@[[product]] = Mul(b@[[hash]], $31(
# CHECK: Int32 b@[[high]] = ZShr(b@[[product]], $7(
# CHECK: Int32 b@[[mixed]] = BitXor(b@[[product]], b@[[high]],
# CHECK-NEXT: Return(b@[[mixed]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="mix" role=Source
# NONE-NOT: CheckAdd
# NONE-NOT: CheckSub
# NONE-NOT: CheckMul
# NONE-NOT: IToD
