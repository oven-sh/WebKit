# function set(list: number[], at: number, value: number) { list[at] = value }  function pushOne(list: number[], a: number) { return list.push(a) }  function pushTwo(list: number[], a: number, b: number) { return list.push(a, b) }
# function pop(list: number[]) { return list.pop() }  function shift(list: number[]) { return list.shift() }  function setLength(list: number[], length: number) { list.length = length }
# function removeSecond(list: number[]) { return list.splice(1, 1).length }  function tryPut(list: number[], value: number) { return $tryPutIndex(list, 0, value) }
# An operation that writes the storage of an array compares the whole byte that names the kind of storage. The lock of the cell lies in the same byte, so while a thread holds the lock the comparison says no.
# Every such operation then goes the way that is right for any array: the program prints what it prints with the lock free, for storage of integers, of doubles and of any values.
# The same holds while another thread takes and releases the lock in the middle of the operations.
# FORM: AsRead
# RUN: run-in-shell globalThis.register = (...operations) => { for (const first of [1, 1.5, "a"]) { const list = []; list.push(first, first, first, first); lockCell(list); const answers = runAll(list, first, operations); unlockCell(list); print(answers + " | " + list.join()); } }; globalThis.runAll = (list, first, [set, pushOne, pushTwo, pop, shift, setLength, removeSecond, tryPut]) => { const answers = []; set(list, 1, first + first); set(list, 4, first); answers.push(pushOne(list, first), pushTwo(list, first, first + first), pop(list), shift(list)); setLength(list, 5); answers.push(removeSecond(list), tryPut(list, first + first + first)); return answers.join(); };
# RUN(FREE): run-in-shell globalThis.register = (...operations) => { for (const first of [1, 1.5, "a"]) { const list = []; list.push(first, first, first, first); const answers = runAll(list, first, operations); print(answers + " | " + list.join()); } }; globalThis.runAll = (list, first, [set, pushOne, pushTwo, pop, shift, setLength, removeSecond, tryPut]) => { const answers = []; set(list, 1, first + first); set(list, 4, first); answers.push(pushOne(list, first), pushTwo(list, first, first + first), pop(list), shift(list)); setLength(list, 5); answers.push(removeSecond(list), tryPut(list, first + first + first)); return answers.join(); };
# RUN(MOVING): run-in-shell globalThis.register = (set, pushOne, pushTwo, pop) => { for (const first of [1, 1.5, "a"]) { const list = []; list.push(first, first, first, first); print(callWhileAnotherThreadLocksCell(list, () => { for (let round = 0; round < 200000; round++) { set(list, round & 3, first); pushOne(list, first); pushTwo(list, first, first); pop(list); pop(list); pop(list); } return list.join(); })); } };
