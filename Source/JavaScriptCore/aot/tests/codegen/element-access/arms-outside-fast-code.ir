# Outside fast code an access to an element of an array whose kind of storage nobody knows is one call of a stub that takes the position as it is and keeps the registers of its caller: nothing is tested and nothing boxed in line but a stored number, which a stub boxes.
# Under a known kind of storage the access stands in line with one arm, the same call: a read and the test that `in` is compiled to leave an element that is not there to it, a store one behind the last element.
# Fast code has all of it in line, and its arm is the same call. A read of a typed array is no read of an array
# FORM: Placed
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end
# RUN: generate-code calls
# RUN(S): code-shapes

module m0 path="main.js" displayPath="main.js"
function f0 name="readsAtInteger" parameters=[{type=Array<anything, proven, pristine[Storage]>}, {type=int}] results=[{type=anything}] {
  b0(v0: Array<anything, proven, pristine[Storage]>, v1: int):
    v2 = GetArrayElement v0, v1 level=Proven
    Return v2
}
# CHECK: f0: size=
# CHECK-NEXT: stub ArrayGetAtIndex x1
# CHECK-NEXT: stub PollAtPrologue x1
# CHECK-NEXT: f1: size=
function f1 name="readsAtNumber" parameters=[{type=Array<anything, proven, pristine[Storage]>}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<anything, proven, pristine[Storage]>, v1: number):
    v2 = GetArrayElement v0, v1 level=Proven
    Return v2
}
# CHECK-NEXT: stub ArrayGetAtNumber x1
# CHECK-NEXT: stub PollAtPrologue x1
# CHECK-NEXT: f2: size=
function f2 name="readsKnownStorageAtNumber" parameters=[{type=Array<anything, proven, Contiguous, pristine[Storage]>}, {type=number}] results=[{type=anything}] {
  b0(v0: Array<anything, proven, Contiguous, pristine[Storage]>, v1: number):
    v2 = GetArrayElement v0, v1 arrayStorage=Contiguous level=Proven
    Return v2
}
# CHECK-NEXT: stub ArrayGetAtNumber x1
# CHECK-NEXT: stub PollAtPrologue x1
# CHECK-NEXT: f3: size=
function f3 name="storesAtInteger" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int}, {type=string}] results=[{type=undefined}] {
  b0(v0: Array<anything, pristine[Storage]>, v1: int, v2: string):
    PutArrayElement v0, v1, v2 level=Proven
    Return
}
