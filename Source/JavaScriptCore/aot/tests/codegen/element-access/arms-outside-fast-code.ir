}
# CHECK-NEXT: stub ArrayPutAtIndex.Number x1
# CHECK-NOT: operation
# CHECK: f6: size=
function f6 name="inFastCode" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int}, {type=number}, {type=string}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: Array<anything, pristine[Storage]>, v1: int, v2: number, v3: string, v4: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    v6 = GetArrayElement v0, v1 level=Proven
    v7 = GetArrayElement v0, v2 level=Proven
    PutArrayElement v0, v1, v6 level=Proven
    PutArrayElement v0, v2, v7 level=Proven
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK: stub ArrayGetAtIndex x1
# CHECK-NEXT: stub ArrayGetAtNumber x1
# CHECK-NEXT: stub ArrayPutAtIndex.Value x1
# CHECK-NEXT: stub ArrayPutAtNumber.Value x1
# CHECK-NOT: operation
# CHECK-NOT: stub GetByValCached
# S: f6 b1 Fast
# CHECK: f7: size=
function f7 name="inCompactCode" parameters=[{type=Array<anything, pristine[Storage]>}, {type=int}, {type=number}, {type=string}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: Array<anything, pristine[Storage]>, v1: int, v2: number, v3: string, v4: boolean):
    Branch v4 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    v5 = GetArrayElement v0, v1 level=Proven
    v6 = GetArrayElement v0, v2 level=Proven
    PutArrayElement v0, v1, v5 level=Proven
    PutArrayElement v0, v2, v6 level=Proven
    Jump -> next b2()
  b2():
    Return
}
