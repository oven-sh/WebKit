# The elements of an array are appended by one stub in code of every shape, whatever the two arrays hold
# FORM: Placed
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end
# RUN: generate-code calls
# RUN(S): code-shapes

module m0 path="main.js" displayPath="main.js"
function f0 name="stringsInCompactCode" parameters=[{type=Array}, {type=Array<string, pristine[Storage, Names]>}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: Array, v1: Array<string, pristine[Storage, Names]>, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1() frequency=Rare:
    AppendElements v0, v1
    Jump -> next b2()
  b2():
    Return
}
# CHECK-LABEL: f0: size=
# CHECK-NOT: operation operationAOTAppendElements
# CHECK: stub AppendElements x1
# CHECK-NOT: stub WriteBarrier
# S: f0 b1 Compact
