function f2 name="stringsInFastCode" parameters=[{type=Array}, {type=Array<string, pristine[Storage, Names]>}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: Array, v1: Array<string, pristine[Storage, Names]>, v2: boolean):
    Jump -> next b1()
  b1():
    LoopHint
    AppendElements v0, v1
    Branch v2 -> taken b1(), notTaken b2()
  b2():
    Return
}
# CHECK-LABEL: f2: size=
