# A reader's test for contiguous storage, and for that of int32s, is one test of bits of the array's byte: an array is never without storage for elements, so no mask and compare. Doubles take the mask and compare
# FORM: Placed
# RUN: generate-code
# REQUIRES: x86_64 unsanitized-code
# CHECK: f0: size=17 
# CHECK-NEXT: f1: size=17 
# CHECK-NEXT: f2: size=23 

module m0 path="main.js" displayPath="main.js"
function f0 name="contiguous" parameters=[{type=Array}] results=[{type=i32}] {
  b0(v0: Array):
    v1 = HasArrayStorage v0 arrayStorage=Contiguous
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
function f1 name="int32s" parameters=[{type=Array}] results=[{type=i32}] {
  b0(v0: Array):
    v1 = HasArrayStorage v0 arrayStorage=Int32
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
function f2 name="doubles" parameters=[{type=Array}] results=[{type=i32}] {
  b0(v0: Array):
    v1 = HasArrayStorage v0 arrayStorage=Double
    Branch v1 -> taken b1(| 0), notTaken b2()
  b1(v2):
    v3 = Integer integer=1
    Return v3
  b2():
    v4 = Integer integer=2
    Return v4
}
