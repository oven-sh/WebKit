# R-LABEL: function f2 name="valueInContiguousAtNumber"
# R: v1: number @Double):
# R-NEXT: v2: boolean @Boolean = IsElementPresent v0, v1 arrayStorage=Contiguous
function f3 name="branchOnValue" parameters=[{type=Array<number, proven, Double>}, {type=number}] results=[{type=anything}] {
    v2 = IsElementPresent v0, v1 arrayStorage=Double
    Branch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = GetArrayElement v0, v1, v3 arrayStorage=Double level=Proven [isPresent]
    Return v4
  b2():
    Return v2
}
# CHECK-NEXT: f3: size={{*}} frame=none
# R-LABEL: function f3 name="branchOnValue"
# R: v2: boolean @Boolean = IsElementPresent
# R: b1(v3: guard @Void):
function f4 name="underGuardOfKind" parameters=[{type=Array<number>}, {type=number}] results=[{type=boolean}] {
    v2 = HasArrayStorage v0 arrayStorage=Double
    TestAndBranch v2 -> taken b1(| 0), notTaken b2()
  b1(v3):
    v4 = IsElementPresent v0, v1, v3 arrayStorage=Double
    Return v4
  b2():
    v5 = Boolean
    Return v5
}
# CHECK: f4: size={{*}} frame=none
function f5 name="hasAtNumber" parameters=[{type=Array<number, proven, Double, pristine[Storage]>}, {type=number}] results=[{type=boolean}] {
