# A read from an array that has no holes tests for none: its code differs from the code of the same read from an array that may have one, in each storage kind, and so does the code of `in`
# FORM: Placed
# OPTIONS: check=validate-back-end
# RUN: generate-code
# CHECK: f0: size=[[int32]] frame=[[int32Frame]]@
# CHECK-NOT: f1: size=[[int32]] frame=[[int32Frame]]@
# CHECK: f2: size=[[double]] frame=[[doubleFrame]]@
# CHECK-NOT: f3: size=[[double]] frame=[[doubleFrame]]@
# CHECK: f4: size=[[contiguous]] frame=[[contiguousFrame]]@
# CHECK-NOT: f5: size=[[contiguous]] frame=[[contiguousFrame]]@
# CHECK: f6: size=[[has]] frame=[[hasFrame]]@
# CHECK-NOT: f7: size=[[has]] frame=[[hasFrame]]@

module m0 path="main.js" displayPath="main.js"
function f0 name="denseInt32" parameters=[{type=Array<i32, proven, Int32, pristine[Storage, Dense]>}, {type=i32}] results=[{type=anything}] {
  b0(v0: Array<i32, proven, Int32, pristine[Storage, Dense]>, v1: i32):
    v2 = GetArrayElement v0, v1 arrayStorage=Int32 level=Proven
    Return v2
}
