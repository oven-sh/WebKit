# The NewObject of a reused environment may hand out a released cell, which may be marked, so the store that follows keeps its barrier. The same store to an environment that is not reused gets none
# FORM: AsRead
# OPTIONS: references=narrow only-passes=ReuseEnvironments,RemoveRedundantBarriers
# RUN: compile
# STATISTIC: EnvironmentsReused = 1
# STATISTIC: BarriersEmitted = 1
# STATISTIC: BarriersOnUnmarkableOwners = 1
# STATISTIC: BarriersCoveredLater = 0
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment name="iteration" fields=[{key="value" declared={type=anything}}]
layout L1 kind=Environment name="outer" fields=[{key="value" declared={type=anything}}]
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewObject -, v1 layout=L1 fields=[0]
    PutEnvironmentField v2, v1 layout=L1 field=0
    v4 = NewClosure v2 function=f2
    v5 = Call v1, -, v4
    v6 = NewObject -, v5 layout=L0 fields=[0]
    Jump -> next b1(v6)
  b1(v7):
    LoopHint
    v9 = GetEnvironmentField v7 layout=L0 field=0
    v10 = ToBoolean v9
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = NewClosure v7 function=f1
    v12 = Call v1, -, v11
    Jump -> next b3()
  b3():
    v13 = Call v1, -, v9
    v14 = NewObject -, v13 layout=L0 fields=[0]
    PutEnvironmentField v14, v1 layout=L0 field=0
    v16 = ToBoolean v13
    Branch v16 -> taken b1(v14), notTaken b4()
  b4():
    Return
}
function f1 name="readIteration" kind=Arrow captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=0
    Return v1
}
function f2 name="readOuter" kind=Arrow captures=[{type=env L1}] results=[{type=anything}] {
  b0(v0: env L1):
    v1 = GetEnvironmentField v0 layout=L1 field=0
    Return v1
}
