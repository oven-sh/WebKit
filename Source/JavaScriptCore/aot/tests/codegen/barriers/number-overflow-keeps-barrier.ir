# A number that does not fit the four bytes of its slot goes to the Extension, which NewObject allocates after the cell exists: that allocation can collect and mark the cell, so the store that follows keeps its barrier. With an integer in the field it gets none
# FORM: Selected
# OPTIONS: references=narrow
# RUN: generate-code BarriersEmitted BarriersOnUnmarkableOwners BarriersCoveredLater
# RUN(SLOTS): pass PlanSlots
# CHECK: statistic BarriersEmitted 1
# CHECK-NEXT: statistic BarriersOnUnmarkableOwners 1
# CHECK-NEXT: statistic BarriersCoveredLater 0
# SLOTS: "maybeFraction" Int32OrDouble @{{*}} double@

# The cell is full, so no number slot is widened into free bytes
module m0 path="main.js" displayPath="main.js"
layout L0 name="Item" fields=[{key="next" declared={type=anything} flags=[IsRequired]}, {key="whole" declared={type=number predicted=i32} flags=[IsRequired]}, {key="tally" declared={type=number predicted=i32} flags=[IsRequired]}, {key="maybeFraction" declared={type=number predicted=i32}}, {key="filler0" declared={type=i32} flags=[IsRequired]}, {key="filler1" declared={type=i32} flags=[IsRequired]}] flow={members=[L0]}
function f0 name="numberInExtension" parameters=[{type=anything}, {type=number}] results=[{type=undefined}] {
  b0(v0: anything, v1: number):
    v2 = Integer integer=1
    v3 = Null
    v4 = NewObject -, v3, v2, v2, v1, v2, v2 layout=L0 fields=[0, 1, 2, 3, 4, 5] [keepsShape]
    PutSlot v4, v4, v0 key="next" receivers=[L0] level=Proven
    Return
}
function f1 name="integerInSlot" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Integer integer=1
    v2 = Null
    v3 = NewObject -, v2, v1, v1, v1, v1, v1 layout=L0 fields=[0, 1, 2, 3, 4, 5] [keepsShape]
    PutSlot v3, v3, v0 key="next" receivers=[L0] level=Proven
    Return
}
