# function asked(p: Point) { .. p.x .. p.method() .. }: whether the fields of a compiled object are where its layout puts them and whether it still has the prototype of its layout
# are bits of one byte of its cell. The tests of one object that stand above and below one another ask for all those bits, so the first answers for the rest: one test, one branch.
# In `apart` each object is asked one thing: each test asks for its own bit.
# FORM: Selected
# OPTIONS: heat=everything-is-hot
# RUN: generate-code
# REQUIRES: unsanitized-code
# RUN(X64): generate-code
# REQUIRES(X64): x86_64 unsanitized-code

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
function f0 name="asked" parameters=[{type=L0}] results=[{type=anything}] {
    v1 = HasBirthFieldsFilled v0
    TestAndBranch v1 -> taken b1(| 0), notTaken b4()
  b1(v2: guard):
    v3 = HasLayoutPrototype v0
    TestAndBranch v3 -> taken b2(| 0), notTaken b4()
  b2(v4: guard):
    v5 = HasNoFieldOutsideSlot v0, v4
    TestAndBranch v5 -> taken b3(| 0), notTaken b4()
  b3(v6: guard):
    v7 = Integer integer=1
    Return v7
  b4():
    v8 = Integer integer=2
    Return v8
}
function f1 name="apart" parameters=[{type=L0}, {type=L0}] results=[{type=anything}] {
    v2 = HasBirthFieldsFilled v0
    TestAndBranch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: guard):
    v4 = HasLayoutPrototype v1
    TestAndBranch v4 -> taken b2(| 0), notTaken b3()
  b2(v5: guard):
    v6 = Integer integer=1
    Return v6
  b3():
    v7 = Integer integer=2
    Return v7
}
# CHECK: f0: size={{*}}
# CHECK: f1: size={{*}}
# X64: f0: size=17 frame=none
# X64: f1: size=23 frame=none
