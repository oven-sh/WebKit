function f3 module=m0 position=6 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: L0):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
