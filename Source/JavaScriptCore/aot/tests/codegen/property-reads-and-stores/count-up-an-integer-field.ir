# class Counter {
#   count = 0;
# }
# function hit(counter: Counter): void {
#   counter.count++;
# }
# declare const input: any;
# const counter = new Counter();
# for (let i = 0; i < input; i++) hit(counter);
# (globalThis as any).answer = counter.count;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=44 kind=Parameter function=f1
typesite w1 module=m0 position=18 kind=Field
typesite w2 module=m0 position=133 kind=CallResult
typesite w3 module=m0 position=157 kind=Variable
typesite w4 module=m0 position=72 kind=Field
layout L0 kind=Instance name="Counter" module=m0 position=6 constructor=f2 fields=[{key="count" declared={type=number site=w1} flags=[IsRequired]}] ownFieldCount=1
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g0
    v5 = FinishClass v3 layout=L0
    v6 = Convert v5 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v7 = Convert v5 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v8 = Construct v7 calleeName="Counter"
    v9 = Convert v8 declared={type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=UnprovenCallee
    v10 = Integer
    v11 = Convert v10 declared={type=number site=w3}
    Jump -> next b2(v11)
  b2(v12: number):
    LoopHint
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = Less v12, v16
    Branch v17 -> taken b3(| 0), notTaken b6(| 0)
  b3(v18):
    Jump -> next b4()
  b4():
    v19 = Call v1, -, v9 calleeName="hit"
    Jump -> next b5()
  b5():
    v20 = Increment v18
    v21 = Convert v20 declared={type=number site=w3}
    Jump -> next b2(v21)
  b6(v22):
    Jump -> next b7()
  b7():
    v23 = Builtin builtin=GlobalThis
    v24 = PropGet v23 key="globalThis" [isFreeName]
    v25 = Convert v24 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v26 = Convert v25 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v27 = PropGet v9 key="count"
    PropSet v26, v27 key="answer"
    v29 = Undefined
    Return v29
}
function f1 name="hit" module=m0 position=31 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="count"
