# type Point = { x: number; y: number };
# function byName(point: Point, at: number): void {
#   point.x = at;
# }
# function byKey(point: Point, at: number): void {
#   point["x"] = at;
# }
# declare const input: any;
# const point: Point = { x: +input, y: +input };
# byName(point, +input);
# byKey(point, +input);
# (globalThis as any).answer = point.x + point.y;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1 f2
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1 f2
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1 f2
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=209 kind=Variable
typesite w1 module=m0 position=55 kind=Parameter function=f1
typesite w2 module=m0 position=69 kind=Parameter function=f1
typesite w3 module=m0 position=122 kind=Parameter function=f2
typesite w4 module=m0 position=136 kind=Parameter function=f2
typesite w5 module=m0 position=91 kind=Field
typesite w6 module=m0 position=158 kind=Field
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = ToNumber v11
    v13 = Convert v12 declared={type=number}
    v14 = NewObject -, v8, v13 layout=L0 fields=[0, 1]
    v15 = FinishObject v14
    v16 = Convert v15 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="input" [isFreeName]
    v19 = Convert v18 declared={type=number flags=[IsExpected]}
    v20 = ToNumber v19
    v21 = Call v1, -, v16, v20 calleeName="byName"
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="input" [isFreeName]
    v24 = Convert v23 declared={type=number flags=[IsExpected]}
    v25 = ToNumber v24
    v26 = Call v3, -, v16, v25 calleeName="byKey"
    v27 = Builtin builtin=GlobalThis
    v28 = PropGet v27 key="globalThis" [isFreeName]
    v29 = Convert v28 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v30 = Convert v29 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v31 = PropGet v16 key="x"
    v32 = PropGet v16 key="y"
    v33 = Add v31, v32
    PropSet v30, v33 key="answer"
    v35 = Undefined
    Return v35
}
function f1 name="byName" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = Convert v1 declared={type=number site=w5}
    PropSet v0, v2 key="x"
    v4 = Undefined
    Return v4
}
function f2 name="byKey" module=m0 position=107 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w4}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = Convert v1 declared={type=number site=w6}
    PropSet v0, v2 key="x"
    v4 = Undefined
    Return v4
}

# point["x"] = at is point.x = at: both spellings give one store of the double and nothing else.
# REPEAT: name = byName byKey
# CHECK-LABEL: name="%(name)" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[%(name)At]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[%(name)Point]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[%(name)At]], b@[[%(name)Point]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# END REPEAT
# X64-LABEL: name="byName" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="byName" role=Source
# ARM64-NEXT: instructions: 2, patchpoints: 0
# X64-LABEL: name="byKey" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="byKey" role=Source
# ARM64-NEXT: instructions: 2, patchpoints: 0
