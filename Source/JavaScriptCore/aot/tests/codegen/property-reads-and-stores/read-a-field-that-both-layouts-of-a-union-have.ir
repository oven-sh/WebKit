# type Circle = { radius: number; id: number };
# type Square = { side: number; color: number; id: number };
# function idOf(shape: Circle | Square): number {
#   return shape.id;
# }
# declare const input: any;
# const circle: Circle = { radius: +input, id: +input };
# const square: Square = { side: +input, color: +input, id: +input };
# (globalThis as any).answer = idOf(input ? circle : square) + circle.radius + square.side + square.color;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=206 kind=Variable
typesite w1 module=m0 position=261 kind=Variable
typesite w2 module=m0 position=119 kind=Parameter function=f1
typesite w3 module=m0 position=105 kind=Result
typesite w4 module=m0 position=352 kind=CallResult
layout L0 name="Circle" module=m0 position=5 fields=[{key="id" declared={type=number} flags=[IsRequired]}, {key="radius" declared={type=number} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
layout L1 name="Square" module=m0 position=51 fields=[{key="color" declared={type=number} flags=[IsRequired]}, {key="id" declared={type=number} flags=[IsRequired]}, {key="side" declared={type=number} flags=[IsRequired]}] declaredOrder=[2, 0, 1] ownFieldCount=3
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Convert v5 declared={type=number}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    v10 = ToNumber v9
    v11 = Convert v10 declared={type=number}
    v12 = NewObject -, v6, v11 layout=L0 fields=[1, 0]
    v13 = FinishObject v12
    v14 = Convert v13 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = Convert v16 declared={type=number flags=[IsExpected]}
    v18 = ToNumber v17
    v19 = Convert v18 declared={type=number}
    v20 = Builtin builtin=GlobalThis
    v21 = PropGet v20 key="input" [isFreeName]
    v22 = Convert v21 declared={type=number flags=[IsExpected]}
    v23 = ToNumber v22
    v24 = Convert v23 declared={type=number}
    v25 = Builtin builtin=GlobalThis
    v26 = PropGet v25 key="input" [isFreeName]
    v27 = Convert v26 declared={type=number flags=[IsExpected]}
    v28 = ToNumber v27
    v29 = Convert v28 declared={type=number}
    v30 = NewObject -, v19, v24, v29 layout=L1 fields=[2, 0, 1]
    v31 = FinishObject v30
    v32 = Convert v31 declared={type=undefined|null|L1 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v33 = Builtin builtin=GlobalThis
    v34 = PropGet v33 key="globalThis" [isFreeName]
    v35 = Convert v34 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v36 = Convert v35 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v37 = Builtin builtin=GlobalThis
    v38 = PropGet v37 key="input" [isFreeName]
    v39 = ToBoolean v38
    Branch v39 -> taken b2(| 0), notTaken b4(| 0)
  b2(v40):
    Jump -> next b3()
  b3():
    Jump -> next b6(v14)
  b4(v41):
    Jump -> next b5()
  b5():
    Jump -> next b6(v32)
  b6(v42):
    v43 = Call v1, -, v42 calleeName="idOf"
    v44 = Convert v43 declared={type=number site=w4}
    v45 = PropGet v14 key="radius"
    v46 = Add v44, v45
    v47 = PropGet v32 key="side"
    v48 = Add v46, v47
    v49 = PropGet v32 key="color"
    v50 = Add v48, v49
    PropSet v36, v50 key="answer"
    v52 = Undefined
    Return v52
}
function f1 name="idOf" module=m0 position=105 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0|L1):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="id"
    v2 = Convert v1 declared={type=number site=w3}
    Return v2
}

# The two types write id at different places among their fields. Both layouts keep it at one offset, so the read is one load: nothing asks which of the two the object is.
# CHECK-LABEL: name="idOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Double b@[[id]] = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[id]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="idOf" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="idOf" role=Source
# ARM64-NEXT: instructions: 2, patchpoints: 0
