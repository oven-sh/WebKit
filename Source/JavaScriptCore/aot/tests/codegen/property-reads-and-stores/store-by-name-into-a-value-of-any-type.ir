# function rename(value: any, name: string): void {
#   value.name = name;
# }
# declare const input: any;
# for (let i = 0; i < input.length; i++) rename(input[i], String(i));
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=28 kind=Parameter function=f1
typesite w1 module=m0 position=108 kind=Variable
typesite w2 module=m0 position=155 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Integer
    v3 = Convert v2 declared={type=number site=w1}
    Jump -> next b2(v3)
  b2(v4: number):
    LoopHint
    v6 = Convert v4 declared={type=i32 flags=[IsExpected]}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = PropGet v8 key="length"
    v10 = Convert v9 declared={type=number flags=[IsExpected]}
    v11 = Less v6, v10
    Branch v11 -> taken b3(| 0), notTaken b6(| 0)
  b3(v12):
    Jump -> next b4()
  b4():
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=undefined|null|string|Array flags=[IsExpected]}
    v16 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v17 = ElemGet v15, v16
    v18 = Builtin builtin=String
    v19 = Call v18, -, v16 calleeName="String"
    v20 = Convert v19 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v21 = Call v1, -, v17, v20 calleeName="rename"
    Jump -> next b5()
  b5():
    v22 = Increment v16
    v23 = Convert v22 declared={type=number site=w1}
    Jump -> next b2(v23)
  b6(v24):
    Jump -> next b7()
  b7():
    v25 = Undefined
    Return v25
}
function f1 name="rename" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = Convert v0 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    PropSet v2, v1 key="name"
    v4 = Undefined
    Return v4
}

# Nothing is known about the value, and the function runs many times. The store is the address of the cache of this place and one call of the shared code that looks the name up with it.
# Nothing else stands in the function: no test of the value in line, no load, no branch, no barrier.
# CHECK-LABEL: name="rename" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[site]] = Patchpoint(runsWithoutFrame, resultConstraints = SomeRegister, {{*}}:PropSet)
# CHECK-NEXT: Int64 b@[[value]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Patchpoint(b@[[value]]:Register({{*}}), b@[[name]]:Register({{*}}), b@[[site]]:Register({{*}}), resultConstraints = WarmAny, ExitsSideways|ControlDependent|Writes:{{*}}|Reads:Top, {{*}}:PropSet)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="rename" role=Source
# X64-NEXT: instructions: 4, patchpoints: 2
# ARM64-LABEL: name="rename" role=Source
# ARM64-NEXT: instructions: 3, patchpoints: 2
