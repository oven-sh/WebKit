# type Task = { done: boolean; cost: number };
# function remaining(task: Task): number {
#   return task.done ? 0 : task.cost;
# }
# declare const input: any;
# (globalThis as any).answer = remaining({ done: !input, cost: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=64 kind=Parameter function=f1
typesite w1 module=m0 position=45 kind=Result
typesite w2 module=m0 position=179 kind=CallResult
layout L0 name="Task" module=m0 position=5 fields=[{key="cost" declared={type=number} flags=[IsRequired]}, {key="done" declared={type=boolean} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    v9 = LogicalNot v8
    v10 = Convert v9 declared={type=boolean}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[1, 0]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="remaining"
    v19 = Convert v18 declared={type=number site=w2}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="remaining" module=m0 position=45 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="done"
    v2 = ToBoolean v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Integer
    Jump -> next b6(v4)
  b4(v5):
    Jump -> next b5()
  b5():
    v6 = PropGet v0 key="cost"
    Jump -> next b6(v6)
  b6(v7):
    v8 = Convert v7 declared={type=number site=w1}
    Return v8
}

# The flag is one byte of the cell, and the branch tests that byte as it is: nothing compares it with a boxed boolean.
# CHECK-LABEL: name="remaining" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[task]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[done]] = Load8Z(b@[[task]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Branch(b@[[done]], Terminal)
# CHECK: Double b@[[cost]] = Load(b@[[task]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-LABEL: end of function
# NONE-LABEL: name="remaining" role=Source
# NONE-NOT: Patchpoint(
# NONE-NOT: Equal(
# NONE-NOT: BitAnd(
# NONE-LABEL: end of function
# X64-LABEL: name="remaining" role=Source
# X64-NEXT: instructions: 6, patchpoints: 0
# ARM64-LABEL: name="remaining" role=Source
# ARM64-NEXT: instructions: 7, patchpoints: 0
