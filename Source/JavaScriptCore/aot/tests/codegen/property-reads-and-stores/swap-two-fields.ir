# type Pair = { left: number; right: number };
# function swap(pair: Pair): void {
#   const left = pair.left;
#   pair.left = pair.right;
#   pair.right = left;
# }
# declare const input: any;
# const pair: Pair = { left: +input, right: +input };
# swap(pair);
# (globalThis as any).answer = pair.left - pair.right;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=186 kind=Variable
typesite w1 module=m0 position=59 kind=Parameter function=f1
typesite w2 module=m0 position=87 kind=Variable
typesite w3 module=m0 position=107 kind=Field
layout L0 name="Pair" module=m0 position=5 fields=[{key="left" declared={type=number} flags=[IsRequired]}, {key="right" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Convert v5 declared={type=number}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    v10 = ToNumber v9
    v11 = Convert v10 declared={type=number}
    v12 = NewObject -, v6, v11 layout=L0 fields=[0, 1]
    v13 = FinishObject v12
    v14 = Convert v13 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v15 = Call v1, -, v14 calleeName="swap"
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="globalThis" [isFreeName]
    v18 = Convert v17 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v19 = Convert v18 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v20 = PropGet v14 key="left"
    v21 = PropGet v14 key="right"
    v22 = Sub v20, v21
    PropSet v19, v22 key="answer"
    v24 = Undefined
    Return v24
}
function f1 name="swap" module=m0 position=45 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="left"
    v2 = Convert v1 declared={type=number site=w2}
    v3 = PropGet v0 key="right"
    v4 = Convert v3 declared={type=number site=w3}
    PropSet v0, v4 key="left"
    PropSet v0, v2 key="right"
    v7 = Undefined
    Return v7
}

# Two loads, then two stores. Neither field is loaded again behind the store to the other.
# CHECK-LABEL: name="swap" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[pair]] = ArgumentReg(
# CHECK-NEXT: Double b@[[left]] = Load(b@[[pair]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[right]] = Load(b@[[pair]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Store(b@[[right]], b@[[pair]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Store(b@[[left]], b@[[pair]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="swap" role=Source
# X64-NEXT: instructions: 5, patchpoints: 0
# ARM64-LABEL: name="swap" role=Source
# ARM64-NEXT: instructions: 5, patchpoints: 0
