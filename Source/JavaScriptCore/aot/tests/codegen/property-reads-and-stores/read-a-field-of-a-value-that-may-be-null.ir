# type Parcel = { weight: number };
# function weightOf(parcel: Parcel | null): number {
#   return parcel!.weight;
# }
# declare const input: any;
# (globalThis as any).answer = weightOf(input ? { weight: +input } : null);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=52 kind=Parameter function=f1
typesite w1 module=m0 position=34 kind=Result
typesite w2 module=m0 position=167 kind=CallResult
layout L0 name="Parcel" module=m0 position=5 fields=[{key="weight" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Convert v13 declared={type=number}
    v15 = NewObject -, v14 layout=L0 fields=[0]
    v16 = FinishObject v15
    Jump -> next b6(v16)
  b4(v17):
    Jump -> next b5()
  b5():
    v18 = Null
    Jump -> next b6(v18)
  b6(v19):
    v20 = Call v1, -, v19 calleeName="weightOf"
    v21 = Convert v20 declared={type=number site=w2}
    PropSet v5, v21 key="answer"
    v23 = Undefined
    Return v23
}
function f1 name="weightOf" module=m0 position=34 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="weight"
    v2 = Convert v1 declared={type=number site=w1}
    Return v2
}

# parcel!.weight must throw for null. No branch asks: a load that traps stands in front of the read.
# CHECK-LABEL: name="weightOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[parcel]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[check]] = Load8Z<Traps>(b@[[parcel]], offset = 5, {{*}}:RequireObjectCoercible)
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[parcel]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[weight]], Terminal)
# CHECK-LABEL: end of function
# The read itself takes the trap, so the check costs no instruction: a load and a return.
# X64-LABEL: name="weightOf" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="weightOf" role=Source
# ARM64-NEXT: instructions: 2, patchpoints: 0
