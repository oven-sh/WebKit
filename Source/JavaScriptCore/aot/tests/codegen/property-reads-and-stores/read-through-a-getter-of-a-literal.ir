# Calls are inlined everywhere but in the body of the module. The accessor of a literal has a slot in the object. One test that the slot still holds it stands in front of the body of the getter,
# which is two loads and a product. The getter is not loaded and not called.
# CHECK-LABEL: name="twiceTheTotal" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[cart]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[accessor]] = Load(b@[[cart]], offset = 32, ControlDependent|Reads:ObjectFields{{*}}:IsSlotFilled)
# CHECK-NEXT: Branch(b@[[accessor]], Terminal,
# CHECK-NEXT: Successors: Then:#[[inlined]], Else:Rare:#
# CHECK-NEXT: BB#[[inlined]]:
# CHECK-NEXT: Predecessors:
# CHECK-NEXT: Double b@[[price]] = Load(b@[[cart]], offset = [[priceSlot]], ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[count]] = Load(b@[[cart]], offset = [[countSlot]], ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[total]] = Mul(b@[[price]], b@[[count]],
# CHECK-NEXT: Double b@[[twice]] = Add(b@[[total]], b@[[total]],
# CHECK-NEXT: Return(b@[[twice]], Terminal)
# CHECK-LABEL: end of function
