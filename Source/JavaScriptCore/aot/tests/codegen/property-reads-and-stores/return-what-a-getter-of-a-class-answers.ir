# Calls are inlined everywhere but in the body of the module. The body of the getter stands in place of the read: two loads and a product, no call of the getter.
# The function hands the product back as a boxed value: it asks whether the double is a 32-bit integer and boxes it as the one or the other.
# CHECK-LABEL: name="areaOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[box]] = ArgumentReg(
# CHECK-NEXT: Double b@[[width]] = Load(b@[[box]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[height]] = Load(b@[[box]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[area]] = Mul(b@[[width]], b@[[height]],
# CHECK-NEXT: Int64 b@[[truncated]] = Patchpoint(b@[[area]]:SomeRegister, runsWithoutFrame, resultConstraints = SomeRegister, pureFunction
# CHECK-NEXT: Int32 b@[[integer]] = Trunc(b@[[truncated]])
# CHECK-NEXT: Double b@[[back]] = IToD(b@[[integer]])
# CHECK: Int32 b@[[isInteger]] = Equal(b@
# CHECK: Branch(b@[[isInteger]], Terminal)
# CHECK: Int64 b@[[boxed]] = Phi(
# CHECK-NEXT: Return(b@[[boxed]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="areaOf" role=Source
# NONE-NOT: :CallDirect
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
