# type Point = { x: number; y: number };
# function pick(point: Point, key: "x" | "y"): number {
#   return point[key];
# }
# declare const input: any;
# (globalThis as any).answer = pick({ x: +input, y: +input }, input ? "x" : "y");
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(BRANCHES): lower-to-b3 optimized f1
# REQUIRES(BRANCHES): unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=53 kind=Parameter function=f1
typesite w1 module=m0 position=67 kind=Parameter function=f1
typesite w2 module=m0 position=39 kind=Result
typesite w3 module=m0 position=171 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[0, 1]
    v17 = FinishObject v16
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="input" [isFreeName]
    v20 = ToBoolean v19
    Branch v20 -> taken b2(| 0), notTaken b4(| 0)
  b2(v21):
    Jump -> next b3()
  b3():
    v22 = String string="x"
    Jump -> next b6(v22)
  b4(v23):
    Jump -> next b5()
  b5():
    v24 = String string="y"
    Jump -> next b6(v24)
  b6(v25):
    v26 = Call v1, -, v17, v25 calleeName="pick"
    v27 = Convert v26 declared={type=number site=w3}
    PropSet v5, v27 key="answer"
    v29 = Undefined
    Return v29
}
function f1 name="pick" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|"x"|"y" site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: undefined|null|"x"|"y"):
    Jump -> next b1()
  b1():
    v2 = ElemGet v0, v1
    v3 = Convert v2 declared={type=number site=w2}
    Return v3
}

# The key is "x" or "y" and the layout is known, so the read is a comparison of the key and one load on either side. No property is looked up by name.
# A string that is not in its short form is brought into it first, by a call that has no effects, on an unlikely path.
# CHECK-LABEL: name="pick" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[key]] = ArgumentReg(
# CHECK: Int32 b@[[isLong]] = AboveEqual(b@[[key]],
# CHECK-NEXT: Branch(b@[[isLong]], Terminal,
# CHECK-NEXT: Successors: Then:Unlikely:#[[shorten]], Else:#
# CHECK: Int64 b@[[short]] = Phi(
# CHECK: Int32 b@[[isX]] = Equal(b@[[short]],
# CHECK: Branch(b@[[isX]], Terminal,
# CHECK: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Double b@[[y]] = Load(b@[[point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[shorten]]:
# CHECK: Int64 b@[[shortened]] = Patchpoint(b@[[key]]:Register({{*}}), resultConstraints = Register({{*}}), pureFunction
# CHECK-LABEL: end of function
# BRANCHES-LABEL: name="pick" role=Source
# BRANCHES-COUNT-2: Branch(
# BRANCHES-NOT: Branch(
# BRANCHES-LABEL: end of function
# NONE-LABEL: name="pick" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: NamedProperties
# NONE-LABEL: end of function
# The count takes in the moves around the call on the unlikely path, which follow the calling convention.
# X64-LABEL: name="pick" role=Source
# X64-NEXT: instructions: 14, patchpoints: 1
# ARM64-LABEL: name="pick" role=Source
# ARM64-NEXT: instructions: 15, patchpoints: 1
