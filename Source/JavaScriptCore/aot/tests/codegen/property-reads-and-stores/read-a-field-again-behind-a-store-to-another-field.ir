typesite w3 module=m0 position=39 kind=Result
typesite w4 module=m0 position=263 kind=CallResult
typesite w5 module=m0 position=98 kind=Variable
typesite w6 module=m0 position=118 kind=Field
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Convert v5 declared={type=number}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    v10 = ToNumber v9
    v11 = Convert v10 declared={type=number}
    v12 = NewObject -, v6, v11 layout=L0 fields=[0, 1]
    v13 = FinishObject v12
    v14 = Convert v13 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="globalThis" [isFreeName]
    v17 = Convert v16 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v18 = Convert v17 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="input" [isFreeName]
    v21 = Convert v20 declared={type=number flags=[IsExpected]}
    v22 = ToNumber v21
    v23 = Call v1, -, v14, v22 calleeName="shift"
    v24 = Convert v23 declared={type=number site=w4}
    v25 = PropGet v14 key="y"
    v26 = Add v24, v25
    PropSet v18, v26 key="answer"
    v28 = Undefined
    Return v28
}
function f1 name="shift" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="x"
    v3 = Convert v2 declared={type=number site=w5}
    v4 = Convert v1 declared={type=number site=w6}
    PropSet v0, v4 key="y"
    v6 = PropGet v0 key="x"
    v7 = Add v3, v6
    v8 = Convert v7 declared={type=number site=w3}
    Return v8
}

# A store to y cannot change x, so x is loaded once, in front of the store.
# CHECK-LABEL: name="shift" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[by]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[by]], b@[[point]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[x]], b@[[x]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="shift" role=Source
