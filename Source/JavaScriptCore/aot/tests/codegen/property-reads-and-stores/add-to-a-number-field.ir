# type Account = { balance: number };
# function deposit(account: Account, amount: number): void {
#   account.balance += amount;
# }
# declare const input: any;
# const account: Account = { balance: +input };
# deposit(account, +input);
# (globalThis as any).answer = account.balance;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=158 kind=Variable
typesite w1 module=m0 position=53 kind=Parameter function=f1
typesite w2 module=m0 position=71 kind=Parameter function=f1
typesite w3 module=m0 position=97 kind=Field
layout L0 name="Account" module=m0 position=5 fields=[{key="balance" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Convert v5 declared={type=number}
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = Convert v8 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="deposit"
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="globalThis" [isFreeName]
    v17 = Convert v16 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v18 = Convert v17 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v19 = PropGet v9 key="balance"
    PropSet v18, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="deposit" module=m0 position=36 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = PropGet v0 key="balance"
    v3 = Add v2, v1
    v4 = Convert v3 declared={type=number site=w3}
    PropSet v0, v4 key="balance"
    v6 = Undefined
    Return v6
}

# account.balance += amount is one load, one addition and one store to the same slot.
# CHECK-LABEL: name="deposit" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[account]] = ArgumentReg(
# CHECK-NEXT: Double b@[[balance]] = Load(b@[[account]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[amount]] = ArgumentReg(
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[amount]], b@[[balance]],
# CHECK-NEXT: Store(b@[[sum]], b@[[account]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="deposit" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="deposit" role=Source
# ARM64-NEXT: instructions: 4, patchpoints: 0
