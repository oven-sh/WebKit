# type Point = { x: number; y: number };
# function sum(point: Point): number { return point.x + point.y; }
# declare const input: any;
# (globalThis as any).answer = sum({ x: +input, y: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=52 kind=Parameter function=f1
typesite w1 module=m0 position=39 kind=Result
typesite w2 module=m0 position=159 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[0, 1]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="sum"
    v19 = Convert v18 declared={type=number site=w2}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="sum" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    v4 = Convert v3 declared={type=number site=w1}
    Return v4
}

# Each field of a proven layout is one load of a double off the cell: no shape test, no unboxing, no call. The sum stays a double.
# CHECK-LABEL: name="sum" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[y]] = Load(b@[[point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[x]], b@[[y]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# x86-64 adds the second field from memory. ARM64 loads both.
# X64-LABEL: name="sum" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="sum" role=Source
# ARM64-NEXT: instructions: 4, patchpoints: 0
