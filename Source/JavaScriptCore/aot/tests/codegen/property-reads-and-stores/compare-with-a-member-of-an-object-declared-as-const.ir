# const Level = { Low: 1, High: 2 } as const;
# function isHigh(level: number): boolean {
#   return level === Level.High;
# }
# declare const input: any;
# (globalThis as any).answer = isHigh(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=6 kind=Variable
typesite w1 module=m0 position=60 kind=Parameter function=f1
typesite w2 module=m0 position=44 kind=Result
typesite w3 module=m0 position=174 kind=CallResult
layout L0 module=m0 position=14 fields=[{key="High" declared={type=2} flags=[IsRequired]}, {key="Low" declared={type=1} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="Low" value=Number{value=1}}, {key="High" value=Number{value=2}}]} module=m0
variable g0 name="Level" module=m0 declared={type=undefined|null|absent|L0 site=w0 flags=[OmitsNull, OmitsUndefined]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    PutModuleVariable v3 variable=g0
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="globalThis" [isFreeName]
    v7 = Convert v6 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v8 = Convert v7 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = ToNumber v11
    v13 = Call v1, -, v12 calleeName="isHigh"
    v14 = Convert v13 declared={type=boolean site=w3}
    PropSet v8, v14 key="answer"
    v16 = Undefined
    Return v16
}
function f1 name="isHigh" module=m0 position=44 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=boolean site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="Level"
    v3 = PropGet v2 key="High"
    v4 = StrictEq v0, v3
    v5 = Convert v4 declared={type=boolean site=w2}
    Return v5
}

# The type of a member of an object declared "as const" is its value, so the read is that number: neither the variable nor the object is loaded.
