    v2 = Integer
    v3 = Convert v2 declared={type=number site=w0}
    Jump -> next b2(v3)
  b2(v4: number):
    LoopHint
    v6 = Convert v4 declared={type=i32 flags=[IsExpected]}
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = PropGet v8 key="length"
    v10 = Convert v9 declared={type=number flags=[IsExpected]}
    v11 = Less v6, v10
    Branch v11 -> taken b3(| 0), notTaken b6(| 0)
  b3(v12):
    Jump -> next b4()
  b4():
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="globalThis" [isFreeName]
    v15 = Convert v14 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v16 = Convert v15 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="input" [isFreeName]
    v19 = Convert v18 declared={type=undefined|null|string|Array flags=[IsExpected]}
    v20 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v21 = ElemGet v19, v20
    v22 = Call v1, -, v21 calleeName="townOf"
    PropSet v16, v22 key="answer"
    Jump -> next b5()
  b5():
    v24 = Increment v20
    v25 = Convert v24 declared={type=number site=w0}
    Jump -> next b2(v25)
  b6(v26):
    Jump -> next b7()
  b7():
    v27 = Undefined
    Return v27
}
function f1 name="townOf" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
