  b1():
    v1 = Convert v0 declared={type=undefined|null|object flags=[IsExpected]}
    v2 = PropGet v1 key="home"
    v3 = Convert v2 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v4 = PropGet v3 key="town"
    Return v4
}

# Each step of a chain on a value of which nothing is known is one call of the shared code that looks a name up, with the cache of its place. The answer of the first goes into the second as it is: nothing tests it in line.
# CHECK-LABEL: name="townOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[homeSite]] = Patchpoint(runsWithoutFrame, resultConstraints = SomeRegister, {{*}}:PropGet)
# CHECK-NEXT: Int64 b@[[person]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[home]] = Patchpoint(b@[[person]]:Register({{*}}), b@[[homeSite]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|{{*}}:PropGet)
# CHECK-NEXT: Int64 b@[[townSite]] = Patchpoint(runsWithoutFrame, resultConstraints = SomeRegister, {{*}}:PropGet)
# CHECK-NEXT: Int64 b@[[town]] = Patchpoint(b@[[home]]:Register({{*}}), b@[[townSite]]:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|{{*}}:PropGet)
# CHECK-NEXT: Return(b@[[town]], Terminal)
# CHECK-LABEL: end of function
# The answer of the first call is in the register in which the second takes it: no move stands between them.
