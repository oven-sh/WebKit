# "limit" in search is a comparison of the slot with the bit pattern of a slot that holds nothing: one load, no branch, no lookup.
# CHECK-LABEL: name="isLimited" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[search]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[slot]] = Load(b@[[search]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:IsSlotFilled)
# CHECK: Int32 b@[[isFilled]] = NotEqual(b@[[slot]],
# CHECK-NEXT: Return(b@[[isFilled]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isLimited" role=Source
# NONE-NOT: Branch(
# NONE-NOT: Patchpoint(
# NONE-LABEL: end of function
