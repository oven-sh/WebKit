# type Point = { x: number; y: number };
# type Line = { start: Point; end: Point };
# function width(line: Line): number {
#   return line.end.x - line.start.x;
# }
# declare const input: any;
# (globalThis as any).answer = width({ start: { x: +input, y: +input }, end: { x: +input, y: +input } });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=96 kind=Parameter function=f1
typesite w1 module=m0 position=81 kind=Result
typesite w2 module=m0 position=211 kind=CallResult
layout L0 name="Line" module=m0 position=44 fields=[{key="end" declared={type=undefined|null|L1 flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="start" declared={type=undefined|null|L1 flags=[OmitsNull, OmitsUndefined]} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
layout L1 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L1 fields=[0, 1]
    v17 = FinishObject v16
    v18 = Convert v17 declared={type=undefined|null|L1 flags=[OmitsNull, OmitsUndefined]}
    v19 = Builtin builtin=GlobalThis
    v20 = PropGet v19 key="input" [isFreeName]
    v21 = Convert v20 declared={type=number flags=[IsExpected]}
    v22 = ToNumber v21
    v23 = Convert v22 declared={type=number}
    v24 = Builtin builtin=GlobalThis
    v25 = PropGet v24 key="input" [isFreeName]
    v26 = Convert v25 declared={type=number flags=[IsExpected]}
    v27 = ToNumber v26
    v28 = Convert v27 declared={type=number}
    v29 = NewObject -, v23, v28 layout=L1 fields=[0, 1]
    v30 = FinishObject v29
    v31 = Convert v30 declared={type=undefined|null|L1 flags=[OmitsNull, OmitsUndefined]}
    v32 = NewObject -, v18, v31 layout=L0 fields=[1, 0]
    v33 = FinishObject v32
    v34 = Call v1, -, v33 calleeName="width"
    v35 = Convert v34 declared={type=number site=w2}
    PropSet v5, v35 key="answer"
    v37 = Undefined
    Return v37
}
function f1 name="width" module=m0 position=81 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="end"
    v2 = PropGet v1 key="x"
    v3 = PropGet v0 key="start"
    v4 = PropGet v3 key="x"
    v5 = Sub v2, v4
    v6 = Convert v5 declared={type=number site=w1}
    Return v6
}

# Each step of a chain is one load off the object that the step before loaded. The inner objects are never null, so nothing tests them.
# CHECK-LABEL: name="width" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[line]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[end]] = Load(b@[[line]], offset = [[endSlot]], ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[endX]] = Load(b@[[end]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int64 b@[[start]] = Load(b@[[line]], offset = [[startSlot]], ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[startX]] = Load(b@[[start]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[width]] = Sub(b@[[endX]], b@[[startX]],
# CHECK-NEXT: Return(b@[[width]], Terminal)
# CHECK-LABEL: end of function
