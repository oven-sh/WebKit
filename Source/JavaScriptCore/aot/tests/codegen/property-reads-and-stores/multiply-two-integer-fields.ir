# type Page = { number: number; size: number };
# function offsetOf(page: Page): number {
#   return page.number * page.size;
# }
# declare const input: any;
# (globalThis as any).answer = offsetOf({ number: input | 0, size: input & 255 });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=64 kind=Parameter function=f1
typesite w1 module=m0 position=46 kind=Result
typesite w2 module=m0 position=177 kind=CallResult
layout L0 name="Page" module=m0 position=5 fields=[{key="number" declared={type=number} flags=[IsRequired]}, {key="size" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Convert v10 declared={type=number}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=i32 flags=[IsExpected]}
    v15 = Integer integer=255
    v16 = BitAnd v14, v15
    v17 = Convert v16 declared={type=number}
    v18 = NewObject -, v11, v17 layout=L0 fields=[0, 1]
    v19 = FinishObject v18
    v20 = Call v1, -, v19 calleeName="offsetOf"
    v21 = Convert v20 declared={type=number site=w2}
    PropSet v5, v21 key="answer"
    v23 = Undefined
    Return v23
}
function f1 name="offsetOf" module=m0 position=46 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="number"
    v2 = PropGet v0 key="size"
    v3 = Mul v1, v2
    v4 = Convert v3 declared={type=number site=w1}
    Return v4
}

# Both fields only ever hold integers, so their slots hold integers, one of them in four bytes. They become doubles for the product, which may pass 32 bits: no overflow check, no branch.
# CHECK-LABEL: name="offsetOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[page]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[number]] = Load(b@[[page]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int32 b@[[size]] = Load(b@[[page]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int64 b@[[wide]] = SExt32(b@[[size]],
# CHECK-NEXT: Double b@[[left]] = IToD(b@[[number]],
# CHECK-NEXT: Double b@[[right]] = IToD(b@[[wide]],
# CHECK-NEXT: Double b@[[product]] = Mul(b@[[left]], b@[[right]],
# CHECK-NEXT: Return(b@[[product]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="offsetOf" role=Source
# X64-NEXT: instructions: 5, patchpoints: 0
# ARM64-LABEL: name="offsetOf" role=Source
# ARM64-NEXT: instructions: 6, patchpoints: 0
