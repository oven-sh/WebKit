# type User = { name: string; age: number };
# function nameOf(user: User): string {
#   return user.name;
# }
# declare const input: any;
# (globalThis as any).answer = nameOf({ name: String(input), age: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=59 kind=Parameter function=f1
typesite w1 module=m0 position=43 kind=Result
typesite w2 module=m0 position=173 kind=CallResult
typesite w3 module=m0 position=158 kind=CallResult
layout L0 name="User" module=m0 position=5 fields=[{key="age" declared={type=number} flags=[IsRequired]}, {key="name" declared={type=undefined|null|string flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=String
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Call v6, -, v8 calleeName="String"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=number flags=[IsExpected]}
    v14 = ToNumber v13
    v15 = Convert v14 declared={type=number}
    v16 = NewObject -, v10, v15 layout=L0 fields=[1, 0]
    v17 = FinishObject v16
    v18 = Call v1, -, v17 calleeName="nameOf"
    v19 = Convert v18 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="nameOf" module=m0 position=43 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="name"
    v2 = Convert v1 declared={type=undefined|null|string site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v2
}

# A string field is one load of the reference. Nothing tests the object or the string.
# CHECK-LABEL: name="nameOf" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[user]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = Load(b@[[user]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[name]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="nameOf" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="nameOf" role=Source
