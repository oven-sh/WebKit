# CHECK-NEXT: Branch(b@[[isUndefined]], Terminal,
# CHECK-NEXT: Successors: Then:Unlikely:#{{*}}, Else:#[[read]]
# CHECK-NEXT: BB#[[read]]:
# CHECK-NEXT: Predecessors:
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[parcel]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Double b@[[answer]] = Phi(ReadsLocalState, {{*}}:Parameter)
