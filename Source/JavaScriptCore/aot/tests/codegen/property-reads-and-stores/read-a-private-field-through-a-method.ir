# CHECK-NEXT: Int64 b@[[meter]] = ArgumentReg(
# CHECK-NEXT: Double b@[[level]] = Load(b@[[meter]], offset = [[slot]], ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[level]], Terminal)
# CHECK-LABEL: end of function
