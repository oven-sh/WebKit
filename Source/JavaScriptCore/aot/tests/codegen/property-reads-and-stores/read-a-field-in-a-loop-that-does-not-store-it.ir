# type Step = { size: number };
# function walk(step: Step, count: number): number {
#   let total = 0;
#   for (let i = 0; i < count; i++) total += step.size;
#   return total;
# }
# declare const input: any;
# (globalThis as any).answer = walk({ size: +input }, input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(LOOP): lower-to-b3 optimized loops f1
# REQUIRES(LOOP): unsanitized-code
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=44 kind=Parameter function=f1
typesite w1 module=m0 position=56 kind=Parameter function=f1
typesite w2 module=m0 position=30 kind=Result
typesite w3 module=m0 position=225 kind=CallResult
typesite w4 module=m0 position=87 kind=Variable
typesite w5 module=m0 position=109 kind=Variable
layout L0 name="Step" module=m0 position=5 fields=[{key="size" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Convert v9 declared={type=number}
    v11 = NewObject -, v10 layout=L0 fields=[0]
    v12 = FinishObject v11
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=i32 flags=[IsExpected]}
    v16 = Integer
    v17 = BitOr v15, v16
    v18 = Call v1, -, v12, v17 calleeName="walk"
    v19 = Convert v18 declared={type=number site=w3}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="walk" module=m0 position=30 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = Integer
    v3 = Convert v2 declared={type=number site=w4}
    v4 = Integer
    v5 = Convert v4 declared={type=number site=w5}
    Jump -> next b2(v3, v5)
  b2(v6: number, v7: number):
    LoopHint
    v9 = Less v7, v1
    Branch v9 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v10, v11):
    Jump -> next b4()
  b4():
    v12 = PropGet v0 key="size"
    v13 = Add v6, v12
    v14 = Convert v13 declared={type=number site=w4}
    Jump -> next b5()
  b5():
    v15 = Increment v10
    v16 = Convert v15 declared={type=number site=w5}
    Jump -> next b2(v14, v16)
  b6(v17, v18):
    Jump -> next b7()
  b7():
    v19 = Convert v6 declared={type=number site=w2}
    Return v19
}

# The field is loaded once, in the block that leads into the loop. That block also asks whether the turns are few enough to go without a poll.
# CHECK-LABEL: name="walk" role=Source
# CHECK: Double b@[[size]] = Load(b@[[step]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: Reads:ObjectFields
# CHECK: Double b@[[total]] = Add(b@[[size]], b@
# CHECK-NOT: Reads:ObjectFields
# CHECK-LABEL: end of function
# An iteration adds, counts and compares. It reads no memory of the object.
# LOOP-LABEL: loop #
# LOOP-NOT: Reads:ObjectFields
# LOOP-LABEL: end of loop
# X64: loop #{{*}}, instructions: 3, patchpoints: 0
# ARM64: loop #{{*}}, instructions: 3, patchpoints: 0
