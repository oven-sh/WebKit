# function sum(point) {
#   return point.x + point.y;
# }
# globalThis.answer = sum({ x: +input, y: +input });
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=76 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}] ownFieldCount=2
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    v8 = NewObject layout=L0
    PropDefine v8, v7 key="x"
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = ToNumber v11
    PropDefine v8, v12 key="y"
    v14 = FinishObject v8
    v15 = Call v1, -, v14 calleeName="sum"
    PropSet v4, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="sum" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    Return v3
}

# No type is written. The only object that reaches the parameter is the literal, so the code is that of the typed program: two loads of doubles and an addition.
# CHECK-LABEL: name="sum" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[y]] = Load(b@[[point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[x]], b@[[y]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# X64-LABEL: name="sum" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="sum" role=Source
# ARM64-NEXT: instructions: 4, patchpoints: 0
