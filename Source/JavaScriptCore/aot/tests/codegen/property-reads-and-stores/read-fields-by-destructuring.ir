# type Point = { x: number; y: number };
# function sum(point: Point): number {
#   const { x, y } = point;
#   return x + y;
# }
# function sumOfParameter({ x, y }: Point): number {
#   return x + y;
# }
# declare const input: any;
# const point: Point = { x: +input, y: +input };
# (globalThis as any).answer = sum(point) + sumOfParameter(point);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1 f2
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1 f2
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1 f2
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=221 kind=Variable
typesite w1 module=m0 position=52 kind=Parameter function=f1
typesite w2 module=m0 position=39 kind=Result
typesite w3 module=m0 position=144 kind=Parameter function=f2
typesite w4 module=m0 position=120 kind=Result
typesite w5 module=m0 position=291 kind=CallResult
typesite w6 module=m0 position=304 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = ToNumber v11
    v13 = Convert v12 declared={type=number}
    v14 = NewObject -, v8, v13 layout=L0 fields=[0, 1]
    v15 = FinishObject v14
    v16 = Convert v15 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="globalThis" [isFreeName]
    v19 = Convert v18 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v20 = Convert v19 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v21 = Call v1, -, v16 calleeName="sum"
    v22 = Convert v21 declared={type=number site=w5}
    v23 = Call v3, -, v16 calleeName="sumOfParameter"
    v24 = Convert v23 declared={type=number site=w6}
    v25 = Add v22, v24
    PropSet v20, v25 key="answer"
    v27 = Undefined
    Return v27
}
function f1 name="sum" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3() frequency=Unlikely:
    v3 = NewRuntimeError runtimeError=NotDestructurable name="x"
    Throw v3
  b4(v4):
    v5 = PropGet v4 key="x"
    v6 = Convert v5 declared={type=number} illTypedCause=Assertion
    v7 = PropGet v4 key="y"
    v8 = Convert v7 declared={type=number} illTypedCause=Assertion
    v9 = Add v6, v8
    v10 = Convert v9 declared={type=number site=w2}
    Return v10
}
function f2 name="sumOfParameter" module=m0 position=120 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w4}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3() frequency=Unlikely:
    v3 = NewRuntimeError runtimeError=NotDestructurable name="x"
    Throw v3
  b4(v4):
    v5 = PropGet v4 key="x"
    v6 = Convert v5 declared={type=number} illTypedCause=Assertion
    v7 = PropGet v4 key="y"
    v8 = Convert v7 declared={type=number} illTypedCause=Assertion
    v9 = Add v6, v8
    v10 = Convert v9 declared={type=number site=w4}
    Return v10
}

# A pattern reads its fields as member expressions do: one load each, no test that the value is an object, no copy. It makes no difference whether the pattern stands in a declaration or in the parameter list.
# REPEAT: name = sum sumOfParameter
# CHECK-LABEL: name="%(name)" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[%(name)Point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[%(name)X]] = Load(b@[[%(name)Point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[%(name)Y]] = Load(b@[[%(name)Point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[%(name)Sum]] = Add(b@[[%(name)X]], b@[[%(name)Y]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[%(name)Sum]], Terminal)
# CHECK-LABEL: end of function
# END REPEAT
# X64-LABEL: name="sum" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="sum" role=Source
# ARM64-NEXT: instructions: 4, patchpoints: 0
# X64-LABEL: name="sumOfParameter" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="sumOfParameter" role=Source
# ARM64-NEXT: instructions: 4, patchpoints: 0
