# function tag(item, value) {
#   item.tag = value;
# }
# const item = { id: +input };
# tag(item, +input);
# globalThis.answer = item;
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:PromoteAggregateParameters
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=63 fields=[{key="id" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = ToNumber v3
    v5 = Convert v4 declared={type=number flags=[IsExpected]}
    v6 = NewObject layout=L0
    PropDefine v6, v5 key="id"
    v8 = FinishObject v6
    v9 = Convert v8 declared={type=undefined|null|L0 flags=[IsExpected]}
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = ToNumber v11
    v13 = Call v1, -, v9, v12 calleeName="tag"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="globalThis" [isFreeName]
    v16 = Convert v15 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    PropSet v16, v9 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="tag" module=m0 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|object, v1: anything):
    Jump -> next b1()
  b1():
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    PropSet v0, v2 key="tag"
    v4 = Undefined
    Return v4
}

# No type is written. The literal has no tag, and a store adds one later. The layout of the literal gets a slot for it, so the store is one store of the double:
# the shape does not change, nothing grows, nothing is called. The test in front keeps the bit pattern of an empty slot out.
# CHECK-LABEL: name="tag" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[isNumber]] = Equal(b@[[value]], b@[[value]],
# CHECK-NEXT: Branch(b@[[isNumber]], Terminal,
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Double b@[[stored]] = Phi(
# CHECK-NEXT: Int64 b@[[item]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[stored]], b@[[item]], offset = [[slot]], ControlDependent|Writes:ObjectFields{{*}}:PutSlot)
# CHECK-NEXT: Return(Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="tag" role=Source
# NONE-NOT: Patchpoint(
# NONE-NOT: Reads:
# NONE-NOT: Writes:ShapeWords
# NONE-NOT: Writes:OrderWords
# NONE-LABEL: end of function
# X64-LABEL: name="tag" role=Source
# X64-NEXT: instructions: 3, patchpoints: 0
# ARM64-LABEL: name="tag" role=Source
# ARM64-NEXT: instructions: 3, patchpoints: 0
