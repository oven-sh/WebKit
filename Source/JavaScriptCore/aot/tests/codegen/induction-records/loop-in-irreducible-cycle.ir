# b1 heads a loop that counts v3 up. b1, b4 and b5 are a cycle too: it hands v3 back as it is, and it is entered at b5 as well, so b1 does not dominate it and it is no part of the loop.
# Once the entry at b5 is gone it is part of the loop. The back end is told of no counter. Beside it: the same loop without the second entry.
# FORM: Placed
# OPTIONS: heat=EverythingIsHot check=ValidateBackEnd
# RUN(TWO): lower-to-b3 f0
# RUN(ONE): lower-to-b3 f1
# RUN: generate-code

module m0 path="main.js" displayPath="main.js"
function f0 name="enteredAtTwoBlocks" parameters=[{type=int[0, 1000]}, {type=boolean}] results=[{type=int[0, 1000]}] {
    v2 = Integer
    Branch v1 -> taken b1(v2, v2), notTaken b5(v2, v2)
  b1(v3: int[0, 1000], v4: int[0, 1000]):
    LoopHint
    v6 = Less v4, v0 form=Integers
    TestAndBranch v6 -> taken b4(| 0), notTaken b2()
  b2():
    v7 = Less v3, v0 form=Integers
    TestAndBranch v7 -> taken b3(| 0), notTaken b7()
  b3(v8):
    v9 = Increment v8 form=Integers
    Jump -> next b1(v9, v2)
  b4(v10):
    Jump -> next b5(v3, v10)
  b5(v11: int[0, 1000], v12: int[0, 1000]):
    v13 = Less v12, v0 form=Integers
    TestAndBranch v13 -> taken b6(| 0), notTaken b7()
  b6(v14):
    v15 = Increment v14 form=Integers
    Jump -> next b1(v11, v15)
  b7():
    Return v2
}
# TWO-NOT: induction, next

function f1 name="enteredAtOneBlock" parameters=[{type=int[0, 1000]}, {type=boolean}] results=[{type=int[0, 1000]}] {
    v2 = Integer
    Jump -> next b1(v2)
  b1(v3: int[0, 1000]):
    LoopHint
    v5 = Less v3, v0 form=Integers
    TestAndBranch v5 -> taken b2(| 0), notTaken b3()
  b2(v6):
    v7 = Increment v6 form=Integers
    Jump -> next b1(v7)
  b3():
    Return v2
}
