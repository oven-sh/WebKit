# A loop that also leaves through a second test is still counted for the back end: every trip passes the comparison with the bound, so the poll leaves the loop
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: generate-code
# STATISTIC: KnownInductionsUsed >= 1
# STATISTIC: LoopPollsStripMined = 1

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = BitOr v1, v1
    v3 = CallDirect v2, v2 function=f1
    Return v3
}
function f1 name="leavesEarly" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = Less v3, v0
    Branch v6 -> taken b2(), notTaken b4()
  b2():
    v7 = BitXor v4, v3
    v8 = StrictEq v7, v1
    Branch v8 -> taken b5(), notTaken b3()
  b3():
    v9 = Increment v3
    Jump -> next b1(v9, v7)
  b4():
    Return v4
  b5():
    Return v3
}
