# A trip can go round without passing the comparison with the bound, so the back end is told of no counter
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: generate-code
# STATISTIC: KnownInductionsUsed = 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = BitOr v1, v1
    v3 = CallDirect v2, v2 function=f1
    Return v3
}
function f1 name="testsInOneArm" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3, v4):
    LoopHint
    v6 = BitXor v4, v3
    v7 = StrictEq v6, v1
    Branch v7 -> taken b3(), notTaken b2()
  b2():
    v8 = Less v3, v0
    Branch v8 -> taken b3(), notTaken b4()
  b3():
    v9 = Increment v3
    Jump -> next b1(v9, v6)
  b4():
    Return v4
}
