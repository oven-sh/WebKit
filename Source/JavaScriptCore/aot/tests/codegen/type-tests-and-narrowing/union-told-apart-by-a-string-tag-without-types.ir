    Return v11
}

# Nothing is declared here, so `kind` is a field that holds some string. It is loaded by its slot, which both layouts share, and compared with the characters of the literal, packed into an immediate. Nothing that may throw or allocate is called.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[kind]] = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Patchpoint(b@[[kind]]:{{*}}Terminal|ControlDependent|Reads:{{*}}:StringEqualsLiteral)
# CHECK-NEXT: Successors: #[[notCircle]], #[[circle]]
# The text of the tag does not decide the layout: each arm tests the shape word once, then reads its field by a plain load.
# CHECK-NEXT: BB#[[notCircle]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Int32 b@[[word]] = Load(b@[[shape]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK: Int32 b@[[isSquare]] = Equal(b@[[word]], $-
# CHECK-NEXT: Branch(b@[[isSquare]], Terminal
# CHECK-NEXT: Successors: Then:#[[square]], Else:#
# CHECK-NEXT: BB#[[square]]:
# CHECK-NEXT: Predecessors: #[[notCircle]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[circle]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Int32 b@[[wordAgain]] = Load(b@[[shape]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK: Int32 b@[[isCircle]] = Equal(b@[[wordAgain]], $-
# CHECK-NEXT: Branch(b@[[isCircle]], Terminal
# CHECK-NEXT: Successors: Then:#[[radius]], Else:#
# CHECK-NEXT: BB#[[radius]]:
# CHECK-NEXT: Predecessors: #[[circle]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-LABEL: end of function
# NONE-LABEL: name="size" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: Writes:
# NONE-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
# X64-LABEL: name="size" role=Source
# X64-NEXT: instructions: 21, patchpoints: 1
# ARM64-LABEL: name="size" role=Source
# ARM64-NEXT: instructions: 21, patchpoints: 3
