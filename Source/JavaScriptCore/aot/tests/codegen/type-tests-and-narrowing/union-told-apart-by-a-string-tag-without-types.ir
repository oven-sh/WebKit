# function size(shape) {
#   if (shape.kind === "circle") return shape.radius + shape.radius;
#   return shape.side;
# }
# const circle = { kind: "circle", radius: +input };
# const square = { kind: "square", side: +input };
# globalThis.answer = size(input ? circle : square);
# FORM: AsRead
# The strings of the program stand for strings that are made at run time: flow does not say which they are.
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,flow:LiteralValues
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=128 fields=[{key="kind" declared={type=undefined|null|string flags=[IsExpected]} flags=[IsRequired]}, {key="radius" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] supertypes=[L2] ownFieldCount=2
layout L1 module=m0 position=179 fields=[{key="kind" declared={type=undefined|null|string flags=[IsExpected]} flags=[IsRequired]}, {key="side" declared={type=number flags=[IsExpected]} flags=[IsRequired]}] supertypes=[L2] ownFieldCount=2
layout L2 fields=[{key="kind" declared={type=anything}}, {key="radius" declared={type=anything}}, {key="side" declared={type=anything}}] flags=[IsNeverAllocated] ownFieldCount=3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = String string="circle"
    v3 = Convert v2 declared={type=undefined|null|string flags=[IsExpected]}
    v4 = NewObject layout=L0
    PropDefine v4, v3 key="kind"
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToNumber v7
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    PropDefine v4, v9 key="radius"
    v11 = FinishObject v4
    v12 = Convert v11 declared={type=undefined|null|L0 flags=[IsExpected]}
    v13 = String string="square"
    v14 = Convert v13 declared={type=undefined|null|string flags=[IsExpected]}
    v15 = NewObject layout=L1
    PropDefine v15, v14 key="kind"
    v17 = Builtin builtin=GlobalThis
    v18 = PropGet v17 key="input" [isFreeName]
    v19 = ToNumber v18
    v20 = Convert v19 declared={type=number flags=[IsExpected]}
    PropDefine v15, v20 key="side"
    v22 = FinishObject v15
    v23 = Convert v22 declared={type=undefined|null|L1 flags=[IsExpected]}
    v24 = Builtin builtin=GlobalThis
    v25 = PropGet v24 key="globalThis" [isFreeName]
    v26 = Convert v25 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v27 = Builtin builtin=GlobalThis
    v28 = PropGet v27 key="input" [isFreeName]
    v29 = ToBoolean v28
    Branch v29 -> taken b2(| 0), notTaken b4(| 0)
  b2(v30):
    Jump -> next b3()
  b3():
    Jump -> next b6(v12)
  b4(v31):
    Jump -> next b5()
  b5():
    Jump -> next b6(v23)
  b6(v32):
    v33 = Call v1, -, v32 calleeName="size"
    PropSet v26, v33 key="answer"
    v35 = Undefined
    Return v35
}
function f1 name="size" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0|L1 flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0|L1):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="kind"
    v2 = String string="circle"
    v3 = StrictEq v1, v2
    Branch v3 -> taken b2(| 0), notTaken b4(| 0)
  b2(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b3()
  b3():
    v6 = PropGet v5 key="radius"
    v7 = PropGet v5 key="radius"
    v8 = Add v6, v7
    Return v8
  b4(v9):
    v10 = NarrowByField v0, v9 key="kind"
    Jump -> next b5()
  b5():
