# The words for false and true are neighbors, so `typeof value === "boolean"` is one subtraction and one unsigned comparison. Which of the two it is, is the lowest bit.
# CHECK-LABEL: name="toNumber" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[fromFalse]] = Add(b@[[value]], $-6(b@{{*}}), {{*}}:TypeTest)
# CHECK: Int32 b@[[isBoolean]] = BelowEqual(b@[[fromFalse]], $1(b@{{*}}), {{*}}:TypeTest)
# CHECK: Branch(b@[[isBoolean]], Terminal
# CHECK-NEXT: Successors: Then:#[[boolean]], Else:#[[number]]
# CHECK-NEXT: BB#[[boolean]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Int32 b@[[word]] = Trunc(b@[[value]])
# CHECK: Int32 b@[[isTrue]] = BitAnd(b@[[word]], $1(
# CHECK-LABEL: end of function
# NONE-LABEL: name="toNumber" role=Source
# NONE-NOT: Patchpoint
# NONE-LABEL: end of function
# X64: instructions: 15, patchpoints: 0
# ARM64: instructions: 15, patchpoints: 0
