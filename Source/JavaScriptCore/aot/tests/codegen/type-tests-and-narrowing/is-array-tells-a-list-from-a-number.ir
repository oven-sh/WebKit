function f1 name="first" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|Array<number>):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Array
    v2 = Builtin builtin=ArrayIsArray
    v3 = Call v2, v1, v0 calleeName="Array.isArray"
    v4 = Convert v3 declared={type=boolean site=w5} illTypedCause=DeclarationWithoutBody
    v5 = ToBoolean v4
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
