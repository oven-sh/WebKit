# class Item {
#   weight: number;
#   constructor(weight: number) { this.weight = weight; }
# }
# function weigh(item: Item | null | undefined): number {
#   if (item == null) return 0;
#   return item.weight;
# }
# declare const input: any;
# (globalThis as any).answer = weigh(input > 1 ? new Item(+input) : input ? null : undefined);
