# function isFailure(value: unknown): number {
#   if (Error.isError(value)) return 1;
#   return 2;
# }
# declare const input: any;
# (globalThis as any).answer = isFailure(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 kind=Result
typesite w1 module=m0 position=152 kind=CallResult
typesite w2 module=m0 position=51 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Call v1, -, v7 calleeName="isFailure"
    v9 = Convert v8 declared={type=number site=w1}
    PropSet v5, v9 key="answer"
    v11 = Undefined
    Return v11
}
function f1 name="isFailure" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number site=w0}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="Error" [isFreeName]
    v3 = Convert v2 declared={type=builtin(Error) flags=[IsExpected]}
    v4 = PropGet v3 key="isError"
    v5 = Convert v4 declared={type=builtin(ErrorIsError) flags=[IsExpected]}
    v6 = Call v5, v3, v0 calleeKey="isError" calleeName="Error.isError"
    v7 = Convert v6 declared={type=boolean site=w2} illTypedCause=DeclarationWithoutBody
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    v10 = Integer integer=1
    v11 = Convert v10 declared={type=number site=w0}
    Return v11
  b4(v12):
    Jump -> next b5()
  b5():
    v13 = Integer integer=2
    v14 = Convert v13 declared={type=number site=w0}
    Return v14
}

# Error.isError of a value nobody knows is two tests in place: is it a cell, and is the type byte of the cell that of an error. The built-in is not called.
# CHECK-LABEL: name="isFailure" role=Source
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK: Int32 b@[[type]] = Load8Z(b@[[value]], offset = 5, ControlDependent|ReadsImmutable|Reads:JSCell_typeInfoType
# CHECK: Int32 b@[[isError]] = Equal(b@[[type]], $
# CHECK-NEXT: Branch(b@[[isError]], Terminal
# CHECK-LABEL: end of function
# NONE-LABEL: name="isFailure" role=Source
# NONE-NOT: Patchpoint
# NONE-COUNT-2: Branch(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64: instructions: 6, patchpoints: 0
# ARM64: instructions: 7, patchpoints: 0
