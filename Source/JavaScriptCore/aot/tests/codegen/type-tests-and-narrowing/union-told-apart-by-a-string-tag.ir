# type Circle = { kind: "circle"; radius: number };
# type Square = { kind: "square"; side: number };
# function size(shape: Circle | Square): number {
#   if (shape.kind === "circle") return shape.radius + shape.radius;
#   return shape.side;
# }
# declare const input: any;
# const circle: Circle = { kind: "circle", radius: +input };
# const square: Square = { kind: "square", side: +input };
# (globalThis as any).answer = size(input ? circle : square);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=268 kind=Variable
typesite w1 module=m0 position=327 kind=Variable
typesite w2 module=m0 position=112 kind=Parameter function=f1
typesite w3 module=m0 position=98 kind=Result
typesite w4 module=m0 position=407 kind=CallResult
layout L0 name="Circle" module=m0 position=5 fields=[{key="kind" declared={type=undefined|null|"circle" flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="radius" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
layout L1 name="Square" module=m0 position=55 fields=[{key="kind" declared={type=undefined|null|"square" flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="side" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = String string="circle"
    v3 = Convert v2 declared={type=undefined|null|"circle" flags=[OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v3, v8 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = String string="square"
    v13 = Convert v12 declared={type=undefined|null|"square" flags=[OmitsNull, OmitsUndefined]}
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = ToNumber v16
    v18 = Convert v17 declared={type=number}
    v19 = NewObject -, v13, v18 layout=L1 fields=[0, 1]
    v20 = FinishObject v19
    v21 = Convert v20 declared={type=undefined|null|L1 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="globalThis" [isFreeName]
    v24 = Convert v23 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v25 = Convert v24 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="input" [isFreeName]
    v28 = ToBoolean v27
    Branch v28 -> taken b2(| 0), notTaken b4(| 0)
  b2(v29):
    Jump -> next b3()
  b3():
    Jump -> next b6(v11)
  b4(v30):
    Jump -> next b5()
  b5():
    Jump -> next b6(v21)
  b6(v31):
    v32 = Call v1, -, v31 calleeName="size"
    v33 = Convert v32 declared={type=number site=w4}
    PropSet v25, v33 key="answer"
    v35 = Undefined
    Return v35
}
function f1 name="size" module=m0 position=98 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0|L1):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="kind"
    v2 = String string="circle"
    v3 = StrictEq v1, v2
    Branch v3 -> taken b2(| 0), notTaken b4(| 0)
  b2(v4):
    v5 = NarrowByField v0, v4 key="kind"
    Jump -> next b3()
  b3():
    v6 = Convert v5 declared={type=undefined|null|L0} illTypedCause=Assertion
    v7 = PropGet v6 key="radius"
    v8 = PropGet v6 key="radius"
    v9 = Add v7, v8
    v10 = Convert v9 declared={type=number site=w3}
    Return v10
  b4(v11):
    v12 = NarrowByField v0, v11 key="kind"
    Jump -> next b5()
  b5():
    v13 = Convert v12 declared={type=undefined|null|L1} illTypedCause=Assertion
    v14 = PropGet v13 key="side"
    v15 = Convert v14 declared={type=number site=w3}
    Return v15
}

# `shape.kind === "circle"` is one load of the tag and one comparison of words: the characters are not looked at. The tag decides the layout, so the fields of either arm are plain loads with no shape test.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[kind]] = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Int32 b@[[isCircle]] = Equal(b@[[kind]], ${{*}}:StrictEq)
# CHECK-NEXT: Branch(b@[[isCircle]], Terminal
# CHECK-NEXT: Successors: Then:#[[circle]], Else:#[[square]]
# CHECK-NEXT: BB#[[circle]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[radius]] = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[twice]] = Add(b@[[radius]], b@[[radius]]
# CHECK-NEXT: Return(b@[[twice]], Terminal)
# CHECK-NEXT: BB#[[square]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[side]] = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[side]], Terminal)
# CHECK-NOT: BB#
# CHECK-LABEL: end of function
# X64: instructions: 6, patchpoints: 0
# ARM64: instructions: 7, patchpoints: 0
