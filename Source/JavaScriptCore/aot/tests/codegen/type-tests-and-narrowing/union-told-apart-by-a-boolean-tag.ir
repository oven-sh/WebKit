# type Success = { ok: true; value: number };
# type Failure = { ok: false; code: number };
# function unwrap(result: Success | Failure): number {
#   if (result.ok) return result.value;
#   return result.code + result.code;
# }
# declare const input: any;
# const success: Success = { ok: true, value: +input };
# const failure: Failure = { ok: false, code: +input };
# (globalThis as any).answer = unwrap(input ? success : failure);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=249 kind=Variable
typesite w1 module=m0 position=303 kind=Variable
typesite w2 module=m0 position=104 kind=Parameter function=f1
typesite w3 module=m0 position=88 kind=Result
typesite w4 module=m0 position=380 kind=CallResult
layout L0 name="Success" module=m0 position=5 fields=[{key="ok" declared={type=true} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
layout L1 name="Failure" module=m0 position=49 fields=[{key="code" declared={type=number} flags=[IsRequired]}, {key="ok" declared={type=false} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Boolean boolean=true
    v3 = Convert v2 declared={type=true}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Convert v7 declared={type=number}
    v9 = NewObject -, v3, v8 layout=L0 fields=[0, 1]
    v10 = FinishObject v9
    v11 = Convert v10 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v12 = Boolean
    v13 = Convert v12 declared={type=false}
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = ToNumber v16
    v18 = Convert v17 declared={type=number}
    v19 = NewObject -, v13, v18 layout=L1 fields=[1, 0]
    v20 = FinishObject v19
    v21 = Convert v20 declared={type=undefined|null|L1 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="globalThis" [isFreeName]
    v24 = Convert v23 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v25 = Convert v24 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="input" [isFreeName]
    v28 = ToBoolean v27
    Branch v28 -> taken b2(| 0), notTaken b4(| 0)
  b2(v29):
    Jump -> next b3()
  b3():
    Jump -> next b6(v11)
  b4(v30):
    Jump -> next b5()
  b5():
    Jump -> next b6(v21)
  b6(v31):
    v32 = Call v1, -, v31 calleeName="unwrap"
    v33 = Convert v32 declared={type=number site=w4}
    PropSet v25, v33 key="answer"
    v35 = Undefined
    Return v35
}
function f1 name="unwrap" module=m0 position=88 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0|L1):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="ok"
    v2 = ToBoolean v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Convert v0 declared={type=undefined|null|L0} illTypedCause=Assertion
    v5 = PropGet v4 key="value"
    v6 = Convert v5 declared={type=number site=w3}
    Return v6
  b4(v7):
    Jump -> next b5()
  b5():
    v8 = Convert v0 declared={type=undefined|null|L1} illTypedCause=Assertion
    v9 = PropGet v8 key="code"
    v10 = PropGet v8 key="code"
    v11 = Add v9, v10
    v12 = Convert v11 declared={type=number site=w3}
    Return v12
}

# A tag of true and false is one byte in the object. `if (result.ok)` loads the byte and branches on it. The tag decides the layout, so the fields of either arm are plain loads with no shape test. Each arm returns a double.
# CHECK-LABEL: name="unwrap" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[result]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[ok]] = Load8Z(b@[[result]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Branch(b@[[ok]], Terminal
# CHECK-NEXT: Successors: Then:#[[success]], Else:#[[failure]]
# CHECK-NEXT: BB#[[success]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[value]] = Load(b@[[result]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[value]], Terminal)
# CHECK: BB#[[failure]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[code]] = Load(b@[[result]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[twice]] = Add(b@[[code]], b@[[code]]
# CHECK-NEXT: Return(b@[[twice]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="unwrap" role=Source
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
# X64-LABEL: name="unwrap" role=Source
# X64-NEXT: instructions: 6, patchpoints: 0
# ARM64-LABEL: name="unwrap" role=Source
# ARM64-NEXT: instructions: 7, patchpoints: 0
