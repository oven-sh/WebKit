# A tag of 0 and 1 is one byte in the object, loaded once and branched on. The tag decides the layout, so the fields of either arm are plain loads with no shape test, and each arm returns a double.
# CHECK-LABEL: name="total" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[node]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[op]] = Load8Z(b@[[node]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Branch(b@[[op]], Terminal
# CHECK-NEXT: Successors: Then:#[[pair]], Else:#[[leaf]]
# CHECK-NEXT: BB#[[pair]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[left]] = Load(b@[[node]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[right]] = Load(b@[[node]], offset = 32, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[left]], b@[[right]]
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-NEXT: BB#[[leaf]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[value]] = Load(b@[[node]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[value]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="total" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: AOTObject_shapeWord
# NONE-LABEL: end of function
# X64-LABEL: name="total" role=Source
# X64-NEXT: instructions: 6, patchpoints: 0
# ARM64-LABEL: name="total" role=Source
# ARM64-NEXT: instructions: 8, patchpoints: 0
