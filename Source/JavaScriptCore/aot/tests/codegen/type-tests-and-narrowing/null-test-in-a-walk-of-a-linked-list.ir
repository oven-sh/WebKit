# class Link {
#   value: number;
#   next: Link | null;
#   constructor(value: number, next: Link | null) { this.value = value; this.next = next; }
# }
# function total(first: Link | null): number {
#   let sum = 0;
#   for (let link = first; link !== null; link = link.next) sum += link.value;
#   return sum;
# }
