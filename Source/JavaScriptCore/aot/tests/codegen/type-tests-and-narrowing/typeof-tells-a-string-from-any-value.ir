# function width(value) {
#   if (typeof value === "string") return value.length;
#   return value;
# }
# globalThis.answer = width(input ? String(input) : +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b2(| 0), notTaken b4(| 0)
  b2(v8):
    Jump -> next b3()
  b3():
    v9 = Builtin builtin=String
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Call v9, -, v11 calleeName="String"
    v13 = Convert v12 declared={type=undefined|null|string flags=[IsExpected]}
    Jump -> next b6(v13)
  b4(v14):
    Jump -> next b5()
  b5():
    v15 = Builtin builtin=GlobalThis
    v16 = PropGet v15 key="input" [isFreeName]
    v17 = ToNumber v16
    Jump -> next b6(v17)
  b6(v18):
    v19 = Call v1, -, v18 calleeName="width"
    v20 = Convert v19 declared={type=undefined|null|number|string flags=[IsExpected]}
    PropSet v4, v20 key="answer"
    v22 = Undefined
    Return v22
}
function f1 name="width" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string flags=[IsExpected]}] results=[{type=undefined|null|number|string flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    v3 = PropGet v2 key="length"
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string flags=[IsExpected]}
    Return v5
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = Convert v6 declared={type=undefined|null|number|string flags=[IsExpected]}
    Return v7
}

# Without a declared type the value may be any cell, so `typeof value === "string"` is two tests in place: is it a cell, and is its type byte that of a string. Nothing is called and no text is compared.
# CHECK-LABEL: name="width" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:#[[other]], Else:#[[cell]]
# CHECK: BB#[[cell]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Int32 b@[[type]] = Load8Z(b@[[value]], offset = 5, ControlDependent|ReadsImmutable|Reads:JSCell_typeInfoType
# CHECK: Int32 b@[[isString]] = Equal(b@[[type]], $2(
# CHECK-NEXT: Branch(b@[[isString]], Terminal
# CHECK-NEXT: Successors: Then:#[[string]], Else:#[[other]]
# CHECK-NEXT: BB#[[string]]:
# CHECK-NEXT: Predecessors: #[[cell]]
# CHECK-NEXT: Load(b@[[value]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0
# CHECK-LABEL: end of function
# NONE-LABEL: name="width" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: StringStorage
# NONE-LABEL: end of function
# X64: instructions: 17, patchpoints: 1
# ARM64: instructions: 18, patchpoints: 1
