# function half(value: unknown): number {
#   return (value as number) / 2;
# }
# declare const input: any;
# (globalThis as any).answer = half(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 kind=Result
typesite w1 module=m0 position=129 kind=CallResult
typesite w2 module=m0 position=59 kind=Assertion
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="half"
    v11 = Convert v10 declared={type=number site=w1}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="half" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number site=w0}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=number site=w2} illTypedCause=FromLooseType
    v2 = Integer integer=2
    v3 = Div v1, v2
    v4 = Convert v3 declared={type=number site=w0}
    Return v4
}

# `value as number` is no operation, and every caller hands over a number: it arrives in a floating-point register and is used as it is. Nothing is tested or unboxed.
# CHECK-LABEL: name="half" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK-NEXT: Double b@[[half]] = Mul(b@[[value]], $0.5{{*}}:Div)
# CHECK-NEXT: Return(b@[[half]], Terminal)
# CHECK-NOT: BB#
# CHECK-LABEL: end of function
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
