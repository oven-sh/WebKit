# type Twice = { op: 2; operand: number };
# type Literal = { op: 3; value: number };
# function evaluate(node: Sum | Twice | Literal): number {
#   switch (node.op) {
#     case 1: return node.left + node.right;
#     case 2: return node.operand + node.operand;
#     case 3: return node.value;
#   }
# }
# declare const input: any;
# const sum: Sum = { op: 1, left: +input, right: +input };
# const twice: Twice = { op: 2, operand: +input };
# const literal: Literal = { op: 3, value: +input };
# (globalThis as any).answer = evaluate(input > 1 ? sum : input ? twice : literal);
# TODO: control-flow: a switch that lists every value its subject can have keeps a way for the rest: the last case is still tested and what is left leaves the function
