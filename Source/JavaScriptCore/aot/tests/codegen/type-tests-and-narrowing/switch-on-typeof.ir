# `switch (typeof value)` makes no string and compares none. Of a string, a number and a boolean the string is the cell and the number has the number bits: two masks tell the three apart.
# CHECK-LABEL: name="rank" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:#[[notString]], Else:#[[string]]
# CHECK-NEXT: BB#[[notString]]:
# CHECK-NEXT: Predecessors: #0
# CHECK: Int64 b@[[isNumber]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[isNumber]], Terminal
# CHECK-LABEL: end of function
# NONE-LABEL: name="rank" role=Source
# NONE-NOT: Switch(
# NONE-NOT: StringStorage
# NONE-NOT: JSCell_typeInfoType
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
# X64: instructions: 23, patchpoints: 1
# ARM64: instructions: 23, patchpoints: 1
