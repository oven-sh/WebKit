# function sum(point) {
#   return point.x + point.y + point.z;
# }
# globalThis.answer = sum(input ? { x: +input, y: +input, z: +input } : input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
