# X64-NEXT: BranchTest64 NonZero,
# X64-NEXT: Successors: Unlikely:#[[byName]], #[[cell]]
# X64-NEXT: BB#[[cell]]:
# X64-NEXT: Predecessors: #0
# X64-NEXT: Branch32 NotEqual, 12(%
# X64-NEXT: Successors: Unlikely:#[[byName]], #[[reads]]
# X64-NEXT: BB#[[reads]]:
# X64-NEXT: Predecessors: #[[cell]]
# X64-NEXT: MoveDouble
# X64-NEXT: AddDouble
# X64-NEXT: AddDouble
# X64-NEXT: Patch
# X64-LABEL: end of function
