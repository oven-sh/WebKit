# RUN(ARM64): lower-to-air f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=94 fields=[{key="x" declared={type=anything}}, {key="y" declared={type=anything}}, {key="z" declared={type=anything}}] ownFieldCount=3
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b2(| 0), notTaken b4(| 0)
  b2(v8):
    Jump -> next b3()
  b3():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = ToNumber v10
    v12 = NewObject layout=L0
    PropDefine v12, v11 key="x"
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = ToNumber v15
    PropDefine v12, v16 key="y"
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="input" [isFreeName]
    v20 = ToNumber v19
    PropDefine v12, v20 key="z"
    v22 = FinishObject v12
    Jump -> next b6(v22)
  b4(v23):
    Jump -> next b5()
  b5():
    v24 = Builtin builtin=GlobalThis
    v25 = PropGet v24 key="input" [isFreeName]
    Jump -> next b6(v25)
  b6(v26):
    v27 = Call v1, -, v26 calleeName="sum"
    PropSet v4, v27 key="answer"
    v29 = Undefined
    Return v29
}
function f1 name="sum" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0):
    Jump -> next b1()
  b1():
    v1 = PropGet v0 key="x"
    v2 = PropGet v0 key="y"
    v3 = Add v1, v2
    v4 = PropGet v0 key="z"
    v5 = Add v3, v4
    Return v5
}

# The value may be anything, and one layout is expected. The layout is tested once: is it a cell, is its shape word that of the layout. All three reads stand behind that one test and are plain loads.
# CHECK-LABEL: name="sum" role=Source
# CHECK-NOT: Reads:ObjectFields
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[point]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:Unlikely:#[[byName]], Else:#[[cell]]
# CHECK-NEXT: BB#[[cell]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Int32 b@[[shape]] = Load(b@[[point]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK-NOT: Reads:ObjectFields
# CHECK: Int32 b@[[isLayout]] = Equal(b@[[shape]], $
# CHECK-NEXT: Branch(b@[[isLayout]], Terminal
# CHECK-NEXT: Successors: Then:#[[reads]], Else:Unlikely:#[[byName]]
# CHECK-NEXT: BB#[[reads]]:
# CHECK-NEXT: Predecessors: #[[cell]]
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[y]] = Load(b@[[point]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[xy]] = Add(b@[[x]], b@[[y]]
# CHECK-NEXT: Double b@[[z]] = Load(b@[[point]], offset = 32, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@[[xyz]] = Add(b@[[xy]], b@[[z]]
# CHECK-LABEL: end of function
# NONE-LABEL: name="sum" role=Source
# NONE-COUNT-1: Reads:AOTObject_shapeWord
# NONE-NOT: Reads:AOTObject_shapeWord
# NONE-LABEL: end of function
# Two instructions test, three read and add. x86-64 tests and adds from memory.
# X64-LABEL: name="sum" role=Source
