# Of an Item and a number only the Item is a cell, so `typeof value === "object"` is one mask and one branch, and the field is a plain load behind it: no type byte, no shape test, no test for null.
# CHECK-LABEL: name="weigh" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:#[[number]], Else:#[[object]]
# CHECK: BB#[[object]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[value]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[weight]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="weigh" role=Source
# NONE-NOT: JSCell_typeInfoType
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: Patchpoint
# NONE-LABEL: end of function
# X64: instructions: 10, patchpoints: 0
# ARM64: instructions: 10, patchpoints: 0
