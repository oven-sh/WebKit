# function size(shape) {
#   if (shape.kind === "circle") return shape.radius;
#   return shape.side;
# }
# globalThis.answer = size(JSON.parse(input));
# The function runs once, so its code is compact, and the branch narrows `shape`, so the comparison stays a StrictEq with the text as an operand. One call that has the six characters in a register answers it. It used to take two: one that made the string cell of "circle", one that compared any two values.
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# CHECK-LABEL: name="size" role=Source
# CHECK: = Patchpoint({{*}}:PropGet)
# CHECK-NOT: :String)
# "circle"
# CHECK: b@[[text]] = Const64(111516199315811, {{*}}:StrictEq)
# CHECK-NEXT: = Patchpoint({{*}}, $111516199315811(b@[[text]]):{{*}}Terminal|ControlDependent|Reads:{argumentBuffer, StringStorage}, {{*}}:StrictEq)
# CHECK-NOT: :String)
# CHECK-LABEL: end of function

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1() @0
  b1():
    v0 = NewClosure function=f1 @0
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType @0
    v2 = Builtin builtin=GlobalThis @98
    v3 = PropGet v2 key="globalThis" [isFreeName] @98
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]} @98
    v5 = Builtin builtin=JSON @123
    v6 = PropGet v5 key="parse" @123
    v7 = Convert v6 declared={type=builtin(JSONParse) flags=[IsExpected]} @123
    v8 = Builtin builtin=GlobalThis @139
    v9 = PropGet v8 key="input" [isFreeName] @139
    v10 = Call v7, v5, v9 calleeKey="parse" calleeName="JSON.parse" @128
    v11 = Convert v10 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]} @123
    v12 = Call v1, -, v11 calleeName="size" @118
    PropSet v4, v12 key="answer" @98
    v14 = Undefined @98
    Return v14 @98
}
function f1 name="size" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|object):
    Jump -> next b1() @0
  b1():
    v1 = PropGet v0 key="kind" @29
    v2 = String string="circle" @44
    v3 = StrictEq v1, v2 @29
    Branch v3 -> taken b2(| 0), notTaken b4(| 0) @29
  b2(v4):
    v5 = NarrowByField v0, v4 key="kind" @29
    Jump -> next b3() @29
  b3():
    v6 = PropGet v5 key="radius" @61
    Return v6 @61
  b4(v7):
    v8 = NarrowByField v0, v7 key="kind" @29
    Jump -> next b5() @29
  b5():
    v9 = PropGet v8 key="side" @84
    Return v9 @84
}
