# `item === null` on a reference is one comparison with the word for null. Behind it the field is a plain load: no second test of the reference, no shape test.
# CHECK-LABEL: name="weigh" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[item]] = ArgumentReg(
# CHECK: Int32 b@[[isNull]] = Equal(b@[[item]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[isNull]], Terminal
# CHECK-NEXT: Successors: Then:Unlikely:#[[zero]], Else:#[[read]]
# CHECK-NEXT: BB#[[read]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[item]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[weight]], Terminal)
# CHECK-NEXT: BB#[[zero]]:
# CHECK-NOT: Branch(
# CHECK-LABEL: end of function
