# The tag is loaded once and compared as a word with each of the three literals in turn: the characters are not looked at. The tag decides the layout: every field is a plain load with no shape test. A tag that is none of the three leaves the typed body.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[kind]] = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: Int32 b@[[isCircle]] = Equal(b@[[kind]], $
# CHECK: Branch(b@[[isCircle]], Terminal
# CHECK-NEXT: Successors: Then:#[[circle]], Else:#[[notCircle]]
# CHECK-NEXT: BB#[[circle]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[notCircle]]:
# CHECK-NEXT: Predecessors: #0
# CHECK: Int32 b@[[isSquare]] = Equal(b@[[kind]], $
# CHECK-NEXT: Branch(b@[[isSquare]], Terminal
# CHECK-NEXT: Successors: Then:#[[square]], Else:#[[notSquare]]
# CHECK-NEXT: BB#[[square]]:
# CHECK-NEXT: Predecessors: #[[notCircle]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[notSquare]]:
# CHECK-NEXT: Predecessors: #[[notCircle]]
# CHECK: Int32 b@[[isBox]] = Equal(b@[[kind]], $
# CHECK-NEXT: Branch(b@[[isBox]], Terminal
# CHECK-NEXT: Successors: Then:#[[box]], Else:#[[none]]
# CHECK-NEXT: BB#[[box]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = {{*}}, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = {{*}}, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[none]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK: Patchpoint({{*}}Terminal
# CHECK-LABEL: end of function
# NONE-LABEL: name="size" role=Source
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: StringStorage
# NONE-NOT: :StringEqualsLiteral)
# NONE-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
