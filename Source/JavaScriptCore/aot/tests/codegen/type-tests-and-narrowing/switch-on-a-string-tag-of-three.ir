# type Circle = { kind: "circle"; radius: number };
# type Square = { kind: "square"; side: number };
# type Box = { kind: "box"; width: number; height: number };
# function size(shape: Circle | Square | Box): number {
#   switch (shape.kind) {
#     case "circle": return shape.radius + shape.radius;
#     case "square": return shape.side;
#     case "box": return shape.width + shape.height;
#   }
# }
# declare const input: any;
# const circle: Circle = { kind: "circle", radius: +input };
# const square: Square = { kind: "square", side: +input };
# const box: Box = { kind: "box", width: +input, height: +input };
# (globalThis as any).answer = size(input > 1 ? circle : input ? square : box);
