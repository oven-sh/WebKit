    v2 = PropGet v1 key="weight"
    v3 = Convert v2 declared={type=number site=w0}
    Return v3
}
function f2 name="Item" module=m0 position=44 kind=BaseConstructor flags=[HasNewTarget, IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w1}] results=[{type=object flags=[IsFromCompiler]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] constructedClass=L0 {
  b0(v0: anything, v1: number):
    Jump -> next b1()
  b1():
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v5 = CallDirect v4 function=f3
    v6 = Convert v1 declared={type=number site=w6}
    PropSet v4, v6 key="weight"
