function f3 module=m0 position=6 kind=Initializer flags=[HasThis, IsChecked, IsHiddenInStackTraces] thisType={type=L0 flags=[IsFromCompiler]} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: L0):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v2 = Undefined
    PropDefine v1, v2 key="weight"
    v4 = Undefined
    Return v4
}

# `value as Item` promises nothing: the value may be anything. The cast is taken as a prediction and tested once, in front of the body: a cell with the shape word of Item, or null or undefined, goes to the typed body, everything else to the generic one.
# CHECK-LABEL: name="weigh" role=EntryChecks
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK: Int32 b@[[shape]] = Load(b@[[value]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK: Int32 b@[[isItem]] = Equal(b@[[shape]], $
# CHECK-NEXT: Branch(b@[[isItem]], Terminal
# CHECK-NEXT: Successors: Then:#[[typed]], Else:Unlikely:#[[generic]]
# CHECK-LABEL: end of function
# The typed body does not test the layout again. The load that traps is the check for null and undefined that the read owes the language.
# CHECK-LABEL: name="weigh" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[item]] = ArgumentReg(
# CHECK-NEXT: Load8Z<Traps>(b@[[item]], offset = 5, {{*}}:RequireObjectCoercible)
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[item]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NOT: AOTObject_shapeWord
# CHECK-LABEL: end of function
# The generic body reads by name.
# CHECK-LABEL: name="weigh" role=GenericVersion
# CHECK-NOT: Reads:ObjectFields.
# CHECK: Patchpoint(b@{{*}}ExitsSideways
# CHECK-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
# X64-LABEL: name="weigh" role=Source
# X64-NEXT: instructions: 2, patchpoints: 1
# ARM64-LABEL: name="weigh" role=Source
# ARM64-NEXT: instructions: 11, patchpoints: 1
