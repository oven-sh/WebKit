# class Item {
#   weight: number;
#   constructor(weight: number) { this.weight = weight; }
# }
# function weigh(value: unknown): number {
#   return (value as Item).weight;
# }
# declare const input: any;
# (globalThis as any).answer = weigh(input ? new Item(+input) : input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=89 kind=Result
typesite w1 module=m0 position=45 kind=Parameter function=f2
typesite w2 module=m0 position=15 kind=Field
typesite w3 module=m0 position=234 kind=CallResult
typesite w4 module=m0 position=220 kind=CallResult
typesite w5 module=m0 position=149 kind=Assertion
typesite w6 module=m0 position=63 kind=Field
layout L0 kind=Instance name="Item" module=m0 position=6 constructor=f2 fields=[{key="weight" declared={type=number site=w2} flags=[IsRequired]}] ownFieldCount=1
variable g0 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = NewClass v2 layout=L0
    PutModuleVariable v3 variable=g0
    v5 = FinishClass v3 layout=L0
    v6 = Convert v5 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v7 = Convert v5 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="globalThis" [isFreeName]
    v10 = Convert v9 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v11 = Convert v10 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = ToBoolean v13
    Branch v14 -> taken b2(| 0), notTaken b4(| 0)
  b2(v15):
    Jump -> next b3()
  b3():
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=number flags=[IsExpected]}
    v19 = ToNumber v18
    v20 = Construct v7, -, v19 calleeName="Item"
    v21 = Convert v20 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    Jump -> next b6(v21)
  b4(v22):
    Jump -> next b5()
  b5():
    v23 = Builtin builtin=GlobalThis
    v24 = PropGet v23 key="input" [isFreeName]
    Jump -> next b6(v24)
  b6(v25):
    v26 = Call v1, -, v25 calleeName="weigh"
    v27 = Convert v26 declared={type=number site=w4}
    PropSet v11, v27 key="answer"
    v29 = Undefined
    Return v29
}
function f1 name="weigh" module=m0 position=89 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number site=w0}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
