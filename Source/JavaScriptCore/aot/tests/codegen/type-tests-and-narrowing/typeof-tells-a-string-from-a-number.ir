# function width(value: string | number): number {
#   if (typeof value === "string") return value.length;
#   return value;
# }
# declare const input: any;
# (globalThis as any).answer = width(input ? String(input) : +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=190 kind=CallResult
typesite w3 module=m0 position=176 kind=CallResult
typesite w4 module=m0 position=89 kind=PropertyRead
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    v10 = Builtin builtin=String
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Call v10, -, v12 calleeName="String"
    v14 = Convert v13 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    Jump -> next b6(v14)
  b4(v15):
    Jump -> next b5()
  b5():
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=number flags=[IsExpected]}
    v19 = ToNumber v18
    Jump -> next b6(v19)
  b6(v20):
    v21 = Call v1, -, v20 calleeName="width"
    v22 = Convert v21 declared={type=number site=w3}
    PropSet v5, v22 key="answer"
    v24 = Undefined
    Return v24
}
function f1 name="width" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=string
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    v3 = Convert v2 declared={type=undefined|null|string} illTypedCause=Assertion
    v4 = PropGet v3 key="length"
    v5 = Convert v4 declared={type=number site=w4} illTypedCause=Assertion
    Return v5
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = Convert v6 declared={type=number} illTypedCause=Assertion
    Return v7
}

# Of a string and a number only the string is a cell, so `typeof value === "string"` is one mask and one branch. The type byte of the cell is not read, and the length is read right behind the branch.
# CHECK-LABEL: name="width" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:#[[number]], Else:#[[string]]
# CHECK: BB#[[string]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Load(b@[[value]], offset = 8, ControlDependent|Reads:JSRopeString_fiber0
# CHECK-LABEL: end of function
# NONE-LABEL: name="width" role=Source
# NONE-NOT: JSCell_typeInfoType
# NONE-NOT: ExitsSideways
# NONE-LABEL: end of function
# The one patchpoint keeps the string alive while its characters' owner is read. It emits no code.
# X64: instructions: 16, patchpoints: 1
# ARM64: instructions: 16, patchpoints: 1
