# function resolve(value: number | (() => number)): number {
#   if (typeof value === "function") return value();
#   return value;
# }
# declare const input: any;
# (globalThis as any).answer = resolve(input ? () => +input : +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=199 kind=Result
typesite w3 module=m0 position=183 kind=CallResult
typesite w4 module=m0 position=101 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = ToBoolean v7
    Branch v8 -> taken b2(| 0), notTaken b4(| 0)
  b2(v9):
    Jump -> next b3()
  b3():
    v10 = NewClosure function=f2
    Jump -> next b6(v10)
  b4(v11):
    Jump -> next b5()
  b5():
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=number flags=[IsExpected]}
    v15 = ToNumber v14
    Jump -> next b6(v15)
  b6(v16):
    v17 = Call v1, -, v16 calleeName="resolve"
    v18 = Convert v17 declared={type=number site=w3}
    PropSet v5, v18 key="answer"
    v20 = Undefined
    Return v20
}
function f1 name="resolve" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|function|f2 site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|function|f2):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=function
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    v3 = Convert v2 declared={type=undefined|null|function|f2} illTypedCause=Assertion
    v4 = Call v3 calleeName="value"
    ReturnCall v4 casts=[{declared={type=number site=w4}}, {declared={type=number site=w1}}]
  b4(v5):
    Jump -> next b5()
  b5():
    v6 = Convert v5 declared={type=number} illTypedCause=Assertion
    Return v6
}
function f2 module=m0 position=199 kind=Arrow flags=[IsChecked] thisType={type=anything} results=[{type=number site=w2}] functionTypes=[f4] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Convert v1 declared={type=number flags=[IsExpected]}
    v3 = ToNumber v2
    v4 = Convert v3 declared={type=number site=w2}
    Return v4
}
function f3 module=m0 role=Signature thisType={type=anything} results=[{type=anything}]
function f4 module=m0 role=Signature thisType={type=anything} results=[{type=anything}] functionTypes=[f3]

# Of a function and a number only the function is a cell, so `typeof value === "function"` is one mask and one branch. Whether the cell can be called is not asked, and the one function it can be is called directly.
# CHECK-LABEL: name="resolve" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]], {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK-NEXT: Successors: Then:#[[number]], Else:#[[function]]
# CHECK: BB#[[function]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Patchpoint({{*}}Terminal{{*}}:CallDirect)
# CHECK-LABEL: end of function
# NONE-LABEL: name="resolve" role=Source
# NONE-NOT: JSCell_typeInfoType
# NONE-NOT: JSCell_typeInfoFlags
# NONE-NOT: JSCell_structureID
# NONE-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
# X64-LABEL: name="resolve" role=Source
# X64-NEXT: instructions: 8, patchpoints: 1
# ARM64-LABEL: name="resolve" role=Source
# ARM64-NEXT: instructions: 8, patchpoints: 1
