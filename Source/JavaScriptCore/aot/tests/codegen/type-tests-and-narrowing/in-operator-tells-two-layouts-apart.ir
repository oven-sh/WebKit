# type Circle = { radius: number };
# type Square = { side: number };
# function size(shape: Circle | Square): number {
#   if ("radius" in shape) return shape.radius;
#   return shape.side;
# }
# declare const input: any;
# const circle: Circle = { radius: +input };
# const square: Square = { side: +input };
# (globalThis as any).answer = size(input ? circle : square);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code not-windows

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=215 kind=Variable
typesite w1 module=m0 position=258 kind=Variable
typesite w2 module=m0 position=80 kind=Parameter function=f1
typesite w3 module=m0 position=66 kind=Result
typesite w4 module=m0 position=322 kind=CallResult
layout L0 name="Circle" module=m0 position=5 fields=[{key="radius" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
layout L1 name="Square" module=m0 position=39 fields=[{key="side" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Convert v5 declared={type=number}
    v7 = NewObject -, v6 layout=L0 fields=[0]
    v8 = FinishObject v7
    v9 = Convert v8 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Convert v13 declared={type=number}
    v15 = NewObject -, v14 layout=L1 fields=[0]
    v16 = FinishObject v15
    v17 = Convert v16 declared={type=undefined|null|L1 site=w1 flags=[OmitsNull, OmitsUndefined]}
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="globalThis" [isFreeName]
    v20 = Convert v19 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v21 = Convert v20 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="input" [isFreeName]
    v24 = ToBoolean v23
    Branch v24 -> taken b2(| 0), notTaken b4(| 0)
  b2(v25):
    Jump -> next b3()
  b3():
    Jump -> next b6(v9)
  b4(v26):
    Jump -> next b5()
  b5():
    Jump -> next b6(v17)
  b6(v27):
    v28 = Call v1, -, v27 calleeName="size"
    v29 = Convert v28 declared={type=number site=w4}
    PropSet v21, v29 key="answer"
    v31 = Undefined
    Return v31
}
function f1 name="size" module=m0 position=66 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|L0|L1 site=w2 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0|L1):
    Jump -> next b1()
  b1():
    v1 = PropHas v0 key="radius"
    v2 = ToBoolean v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Convert v0 declared={type=undefined|null|L0} illTypedCause=Assertion
    v5 = PropGet v4 key="radius"
    v6 = Convert v5 declared={type=number site=w3}
    Return v6
  b4(v7):
    Jump -> next b5()
  b5():
    v8 = Convert v0 declared={type=undefined|null|L1} illTypedCause=Assertion
    v9 = PropGet v8 key="side"
    v10 = Convert v9 declared={type=number site=w3}
    Return v10
}

# `"radius" in shape` looks no name up: which fields an object has is read off its shape word. The word is loaded once and compared with that of each layout in turn, and behind each comparison the field is a plain load. A word that is neither leaves the typed body.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[word]] = Load(b@[[shape]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK: Int32 b@[[isSquare]] = Equal(b@[[word]], $-
# CHECK: Branch(b@[[isSquare]], Terminal
# CHECK-NEXT: Successors: Then:#[[square]], Else:#[[notSquare]]
# CHECK-NEXT: BB#[[square]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[notSquare]]:
# CHECK-NEXT: Predecessors: #0
# CHECK: Int32 b@[[isCircle]] = Equal(b@[[word]], $-
# CHECK: Branch(b@[[isCircle]], Terminal
# CHECK-NEXT: Successors: Then:#[[circle]], Else:#[[neither]]
# CHECK-NEXT: BB#[[circle]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[neither]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK: Patchpoint({{*}}Terminal
# CHECK-LABEL: end of function
# NONE-LABEL: name="size" role=Source
# NONE-NOT: PrototypeLinks
# NONE-NOT: JSCell_structureID
# NONE-COUNT-1: AOTObject_shapeWord
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: PrototypeLinks
# NONE-NOT: JSCell_structureID
# NONE-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
# X64-LABEL: name="size" role=Source
# X64-NEXT: instructions: 8, patchpoints: 3
# ARM64-LABEL: name="size" role=Source
# ARM64-NEXT: instructions: 26, patchpoints: 3
