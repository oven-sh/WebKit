# Every caller hands over a Point, so the test is decided at build time: no walk of the prototype chain, no shape test, and the arm that calls String is gone.
# CHECK-LABEL: name="read" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[point]] = ArgumentReg(
# CHECK-NEXT: Double b@[[x]] = Load(b@[[point]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[x]], Terminal)
# CHECK-NOT: BB#
# CHECK-LABEL: end of function
