# class Point {
#   x: number;
#   constructor(x: number) { this.x = x; }
# }
# function read(point: Point): number {
#   if (point instanceof Point) return point.x;
#   return String(point).length;
# }
# declare const input: any;
# (globalThis as any).answer = read(new Point(+input));
