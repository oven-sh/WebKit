# function weigh(item) {
#   if (item === null) return 0;
#   return item.weight;
# }
# globalThis.answer = weigh(input ? { weight: +input } : null);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 module=m0 position=112 fields=[{key="weight" declared={type=anything}}] ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToBoolean v6
    Branch v7 -> taken b2(| 0), notTaken b4(| 0)
  b2(v8):
    Jump -> next b3()
  b3():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = ToNumber v10
    v12 = NewObject layout=L0
    PropDefine v12, v11 key="weight"
    v14 = FinishObject v12
    Jump -> next b6(v14)
  b4(v15):
    Jump -> next b5()
  b5():
    v16 = Null
    Jump -> next b6(v16)
  b6(v17):
    v18 = Call v1, -, v17 calleeName="weigh"
    v19 = Convert v18 declared={type=number flags=[IsExpected]}
    PropSet v4, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="weigh" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|string|symbol|bigint|L0 flags=[IsExpected]}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|string|symbol|bigint|L0):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=null
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    v3 = Integer
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    Return v4
  b4(v5):
    Jump -> next b5()
  b5():
    v6 = PropGet v5 key="weight"
    v7 = Convert v6 declared={type=number flags=[IsExpected]}
    Return v7
}

# Nothing is declared here. What the callers hand over is an object of one layout or null, and that gives the code of the typed program: one comparison with null, then a plain load.
# CHECK-LABEL: name="weigh" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[item]] = ArgumentReg(
# CHECK: Int32 b@[[isNull]] = Equal(b@[[item]], $2(b@{{*}}), {{*}}:TypeTest)
# CHECK-NEXT: Branch(b@[[isNull]], Terminal
# CHECK-NEXT: Successors: Then:Unlikely:#[[zero]], Else:#[[read]]
# CHECK-NEXT: BB#[[read]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@[[weight]] = Load(b@[[item]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[weight]], Terminal)
# CHECK-NEXT: BB#[[zero]]:
# CHECK-NOT: Branch(
# CHECK-LABEL: end of function
# X64: instructions: 5, patchpoints: 0
# ARM64: instructions: 5, patchpoints: 0
