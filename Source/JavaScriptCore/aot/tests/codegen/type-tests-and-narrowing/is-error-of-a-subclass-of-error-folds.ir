# Only what Error has made for `super()` arrives, so the generic body does not look at the object either.
# CHECK-LABEL: name="next" role=GenericVersion
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[givenCount]] = ArgumentReg(
# CHECK-NEXT: Double b@[[givenSum]] = Add(b@[[givenCount]], b@[[givenCount]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[givenSum]], Terminal)
# CHECK-LABEL: end of function
# The parameter is a class that extends Error, and Error makes its objects. In the typed body Error.isError is true at build time: one arm is left, and the object is not looked at.
# CHECK-LABEL: name="next" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[count]] = ArgumentReg(
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[count]], b@[[count]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="next" role=Source
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64-LABEL: name="next" role=Source
# X64-NEXT: instructions: 2, patchpoints: 0
# ARM64-LABEL: name="next" role=Source
# ARM64-NEXT: instructions: 2, patchpoints: 0
