# `shape instanceof Circle` walks no prototype chain: the class is read off the shape word of the object. The word is loaded once and compared with that of each class in turn, and behind each comparison the field is a plain load. A word that is neither leaves the typed body.
# CHECK-LABEL: name="size" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[shape]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[word]] = Load(b@[[shape]], offset = 12, ControlDependent|ReadsImmutable|Reads:AOTObject_shapeWord
# CHECK: Int32 b@[[isSquare]] = Equal(b@[[word]], $-
# CHECK: Branch(b@[[isSquare]], Terminal
# CHECK-NEXT: Successors: Then:#[[square]], Else:#[[notSquare]]
# CHECK-NEXT: BB#[[square]]:
# CHECK-NEXT: Predecessors: #0
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[notSquare]]:
# CHECK-NEXT: Predecessors: #0
# CHECK: Int32 b@[[isCircle]] = Equal(b@[[word]], $-
# CHECK: Branch(b@[[isCircle]], Terminal
# CHECK-NEXT: Successors: Then:#[[circle]], Else:#[[neither]]
# CHECK-NEXT: BB#[[circle]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK-NEXT: Double b@{{*}} = Load(b@[[shape]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK: BB#[[neither]]:
# CHECK-NEXT: Predecessors: #[[notSquare]]
# CHECK: Patchpoint({{*}}Terminal
# CHECK-LABEL: end of function
# NONE-LABEL: name="size" role=Source
# NONE-NOT: PrototypeLinks
# NONE-NOT: JSCell_structureID
# NONE-COUNT-1: AOTObject_shapeWord
# NONE-NOT: AOTObject_shapeWord
# NONE-NOT: PrototypeLinks
# NONE-NOT: JSCell_structureID
# NONE-LABEL: end of function
# Some of the patchpoints are calls, and the moves around a call follow the calling convention, so the counts leave Windows out.
# X64-LABEL: name="size" role=Source
# X64-NEXT: instructions: 8, patchpoints: 3
# ARM64-LABEL: name="size" role=Source
# ARM64-NEXT: instructions: 26, patchpoints: 3
