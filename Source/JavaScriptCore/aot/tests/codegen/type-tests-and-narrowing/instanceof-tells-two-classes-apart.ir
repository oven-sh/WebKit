# class Circle {
#   radius: number;
#   constructor(radius: number) { this.radius = radius; }
# }
# class Square {
#   side: number;
#   constructor(side: number) { this.side = side; }
# }
# function size(shape: Circle | Square): number {
#   if (shape instanceof Circle) return shape.radius;
#   return shape.side;
# }
