module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=152 kind=Variable
typesite w1 module=m0 position=15 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=176 kind=CallResult
typesite w4 module=m0 position=227 kind=CallResult
typesite w5 module=m0 position=47 kind=CallResult
typesite w6 module=m0 position=75 kind=PropertyRead
typesite w7 module=m0 position=97 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = PropGet v3 key="push"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = Convert v6 declared={type=number flags=[IsExpected]}
    v8 = ToNumber v7
    v9 = Call v4, v3, v8 calleeKey="push" calleeName="numbers.push"
    v10 = Convert v9 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="globalThis" [isFreeName]
    v13 = Convert v12 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v14 = Convert v13 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v15 = Call v1, -, v3 calleeName="count"
    v16 = Convert v15 declared={type=number site=w4}
    PropSet v14, v16 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="count" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<number>):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Array
    v2 = Builtin builtin=ArrayIsArray
    v3 = Call v2, v1, v0 calleeName="Array.isArray"
    v4 = Convert v3 declared={type=boolean site=w5} illTypedCause=DeclarationWithoutBody
    v5 = ToBoolean v4
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
    Jump -> next b3()
  b3():
    v7 = PropGet v0 key="length"
    v8 = Convert v7 declared={type=number site=w6} illTypedCause=Assertion
    Return v8
  b4(v9):
    Jump -> next b5()
  b5():
    v10 = Builtin builtin=String
    v11 = Call v10, -, v0 calleeName="String"
    v12 = Convert v11 declared={type=undefined|null|string site=w7 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v13 = PropGet v12 key="length"
    v14 = Convert v13 declared={type=number site=w2}
    Return v14
}

# The list is proven to be an array, so Array.isArray is decided at build time: the cell's type is not read, nothing is branched on, and the arm that calls String is gone.
# CHECK-LABEL: name="count" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[storage]] = Load(b@[[list]], offset = 8, ControlDependent|Reads:JSObject_butterfly
# CHECK-NEXT: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength
# CHECK-NEXT: Int64 b@[[wide]] = ZExt32(b@[[length]]
# CHECK-NEXT: Double b@[[number]] = IToD(b@[[wide]])
# CHECK-NEXT: Return(b@[[number]], Terminal)
# CHECK-NOT: BB#
