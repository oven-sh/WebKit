# function isList(value: unknown): number {
#   if (Array.isArray(value)) return 1;
#   return 2;
# }
# declare const input: any;
# (globalThis as any).answer = isList(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 kind=Result
typesite w1 module=m0 position=149 kind=CallResult
typesite w2 module=m0 position=48 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Call v1, -, v7 calleeName="isList"
    v9 = Convert v8 declared={type=number site=w1}
    PropSet v5, v9 key="answer"
    v11 = Undefined
    Return v11
}
function f1 name="isList" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number site=w0}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Array
    v2 = Builtin builtin=ArrayIsArray
    v3 = Call v2, v1, v0 calleeName="Array.isArray"
    v4 = Convert v3 declared={type=boolean site=w2} illTypedCause=DeclarationWithoutBody
    v5 = ToBoolean v4
    Branch v5 -> taken b2(| 0), notTaken b4(| 0)
  b2(v6):
    Jump -> next b3()
  b3():
    v7 = Integer integer=1
    v8 = Convert v7 declared={type=number site=w0}
    Return v8
  b4(v9):
    Jump -> next b5()
  b5():
    v10 = Integer integer=2
    v11 = Convert v10 declared={type=number site=w0}
    Return v11
}

# Array.isArray of a value nobody knows is decided in place: is it a cell, is its type byte one of the two kinds of array. Only a proxy, which must be asked for its target, goes on to the built-in, and by a rare edge.
# CHECK-LABEL: name="isList" role=Source
# CHECK-NOT: Branch(
# CHECK: Int64 b@[[notCell]] = BitAnd(b@[[value]],
# CHECK-NEXT: Branch(b@[[notCell]], Terminal
# CHECK: Int32 b@[[type]] = Load8Z(b@[[value]], offset = 5, ControlDependent|ReadsImmutable|Reads:JSCell_typeInfoType
# CHECK: Int32 b@[[fromFirstKind]] = Add(b@[[type]], $-
# CHECK: Int32 b@[[isArray]] = Below(b@[[fromFirstKind]], $2(
# CHECK-NEXT: Branch(b@[[isArray]], Terminal
# CHECK: Int32 b@[[isProxy]] = Equal(b@[[type]], $
# CHECK-NEXT: Branch(b@[[isProxy]], Terminal
# CHECK-NEXT: Successors: Then:Rare:#[[proxy]], Else:#
# CHECK-NEXT: BB#[[proxy]]:
# CHECK: Patchpoint({{*}}b@[[value]]:{{*}}ExitsSideways
# CHECK-LABEL: end of function
# X64: instructions: 9, patchpoints: 0, rare instructions: {{*}}
# ARM64: instructions: 10, patchpoints: 0, rare instructions: {{*}}
