# Stack slots that are live across no suspension lie at the bottom of the frame, where a suspension skips them. Slots that are read after the await are kept
# FORM: Selected
# RUN: generate-code
# OPTIONS: check=validate-back-end
# CHECK: f3: size={{*}} deadAtSuspensions=
# CHECK: f4: size={{*}} deadAtSuspensions=
# RUN(X64): generate-code
# REQUIRES(X64): x86_64
# X64: f3: size={{*}} frame=64@{{*}} deadAtSuspensions=48
# X64: f4: size={{*}} frame=64@{{*}} deadAtSuspensions=16

module m0 path="main.js" displayPath="main.js"
variable g0 declared={type=anything} initialization=Undefined
variable g1 declared={type=anything} initialization=Undefined
function f0 name="exchange" parameters=[{type=anything}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g1
    Return v2
}
function f1 name="dropsBeforeAwait" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f3
    v3 = AssumeType v2 provenType=Promise
    Return v3
}
function f2 name="readsAfterAwait" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f4 entryWithoutPromise=f4 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f4
    v3 = AssumeType v2 provenType=Promise
    Return v3
}
function f3 name="dropsBeforeAwait" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f1} creator=Coroutine{kind=AsyncFunction ramp=f1 body=f3 entryWithoutPromise=f3 promiseType=Promise promiseParameter=1} {
    v2 = CallDirect v0 function=f0
    v3 = CallDirect v0 function=f0
    v4 = CallDirect v0 function=f0
    v5 = CallDirect v0 function=f0
    v6 = CallDirect v2 function=f0
    v7 = CallDirect v3 function=f0
    v8 = CallDirect v4 function=f0
    v9 = CallDirect v5 function=f0
    v10 = AwaitBySavingFrame v0, v1 @10
    v11 = ReturnAsyncResult v1, v10
    Return v11
}
function f4 name="readsAfterAwait" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f2} creator=Coroutine{kind=AsyncFunction ramp=f2 body=f4 entryWithoutPromise=f4 promiseType=Promise promiseParameter=1} {
    v2 = CallDirect v0 function=f0
    v3 = CallDirect v0 function=f0
    v4 = CallDirect v0 function=f0
    v5 = CallDirect v0 function=f0
    v6 = AwaitBySavingFrame v0, v1 @10
    v7 = CallDirect v2 function=f0
    v8 = CallDirect v3 function=f0
    v9 = CallDirect v4 function=f0
    v10 = CallDirect v5 function=f0
    v11 = ReturnAsyncResult v1, v6
    Return v11
}
