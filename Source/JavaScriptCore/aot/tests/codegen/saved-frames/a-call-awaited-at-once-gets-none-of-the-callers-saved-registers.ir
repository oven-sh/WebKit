# A callee stores the saved registers that it uses in its own frame. A function that awaits what a call returns is suspended as soon as the callee returns,
# so in front of the call it puts back what its own caller had in them: the call needs the frame record. A call that is followed by anything else does not.
# FORM: Selected
# RUN: lower-to-b3 f7 f8 f9 f10 f11

module m0 path="main.js" displayPath="main.js"
function f0 name="callee" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f0 body=f6 entryWithoutPromise=f6 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f6
    v3 = AssumeType v2 provenType=Promise
    Return v3
}
function f1 name="awaitsCall" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f7 entryWithoutPromise=f7 promiseType=Promise promiseParameter=1}
function f2 name="awaitsPromiseOfCall" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f2 body=f8 entryWithoutPromise=f8 promiseType=Promise promiseParameter=1}
function f3 name="awaitsWhatValueReturns" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f3 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1}
function f4 name="awaitsWhatMethodReturns" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f4 body=f10 entryWithoutPromise=f10 promiseType=Promise promiseParameter=1}
function f5 name="awaitsWhatEarlierCallReturned" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f5 body=f11 entryWithoutPromise=f11 promiseType=Promise promiseParameter=1}
function f6 name="callee" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{kind=AsyncFunction ramp=f0 body=f6 entryWithoutPromise=f6 promiseType=Promise promiseParameter=1} {
    v2 = AwaitBySavingFrame v0, v1 @10
    v3 = ReturnAsyncResult v1, v2
    Return v3
}
function f7 name="awaitsCall" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f1} creator=Coroutine{kind=AsyncFunction ramp=f1 body=f7 entryWithoutPromise=f7 promiseType=Promise promiseParameter=1} {
    v2 = AwaitCallBySavingFrame v1, v0 function=f6 @20
    v3 = ReturnAsyncResult v1, v2
    Return v3
}
function f8 name="awaitsPromiseOfCall" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f2} creator=Coroutine{kind=AsyncFunction ramp=f2 body=f8 entryWithoutPromise=f8 promiseType=Promise promiseParameter=1} {
    v2 = CallDirect v0 function=f0 @30
    v3 = AwaitBySavingFrame v2, v1 @31
    v4 = ReturnAsyncResult v1, v3
    Return v4
}
function f9 name="awaitsWhatValueReturns" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f3} creator=Coroutine{kind=AsyncFunction ramp=f3 body=f9 entryWithoutPromise=f9 promiseType=Promise promiseParameter=1} {
    v2 = Call v0, - @40
    v3 = AssumeType v2 provenType=Promise
    v4 = AwaitBySavingFrame v3, v1 @41
    v5 = ReturnAsyncResult v1, v4
    Return v5
}
function f10 name="awaitsWhatMethodReturns" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f4} creator=Coroutine{kind=AsyncFunction ramp=f4 body=f10 entryWithoutPromise=f10 promiseType=Promise promiseParameter=1} {
    v2 = CallMethod v0 key="m" @50
    v3 = AwaitBySavingFrame v2, v1 @51
    v4 = ReturnAsyncResult v1, v3
    Return v4
}
function f11 name="awaitsWhatEarlierCallReturned" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f5} creator=Coroutine{kind=AsyncFunction ramp=f5 body=f11 entryWithoutPromise=f11 promiseType=Promise promiseParameter=1} {
    v2 = Call v0, - @60
    v3 = Call v0, - @61
    v4 = AwaitBySavingFrame v2, v1 @62
    v5 = ReturnAsyncResult v1, v4
    Return v5
}
# CHECK-LABEL: name="awaitsCall"
# CHECK: Patchpoint({{*}}needsFrameRecord, resultConstraints = {{*}}v2:AwaitCallBySavingFrame)
# CHECK-NEXT: Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}v2:AwaitCallBySavingFrame)
# CHECK-LABEL: name="awaitsPromiseOfCall"
# CHECK: Patchpoint({{*}}needsFrameRecord, resultConstraints = {{*}}v2:CallDirect)
# CHECK-NEXT: Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}v3:AwaitBySavingFrame)
# CHECK-LABEL: name="awaitsWhatValueReturns"
# CHECK: Patchpoint({{*}}needsFrameRecord, resultConstraints = {{*}}v2:Call)
# CHECK: Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}v4:AwaitBySavingFrame)
# CHECK-LABEL: name="awaitsWhatMethodReturns"
# CHECK: Patchpoint({{*}}needsFrameRecord, resultConstraints = {{*}}v2:CallMethod)
# CHECK-NEXT: Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}v3:AwaitBySavingFrame)
# CHECK-LABEL: name="awaitsWhatEarlierCallReturned"
# CHECK-NOT: needsFrameRecord{{*}}:Call)
# CHECK: Patchpoint<CloningForbidden>({{*}}isSuspension{{*}}v4:AwaitBySavingFrame)
