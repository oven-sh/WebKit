# Four values are read after the first await. Four more are made after it and last read before the second one. The second four share no word with the first four: they lie at the bottom of the frame, where a suspension skips them
# FORM: Selected
# RUN: generate-code
# OPTIONS: check=validate-back-end
# CHECK: f2: size={{*}} deadAtSuspensions=
# RUN(X64): generate-code
# REQUIRES(X64): x86_64
# X64: f2: size={{*}} frame=80@{{*}} deadAtSuspensions=32

module m0 path="main.js" displayPath="main.js"
variable g0 declared={type=anything} initialization=Undefined
variable g1 declared={type=anything} initialization=Undefined
function f0 name="exchange" parameters=[{type=anything}] results=[{type=anything}] {
    PutModuleVariable v0 variable=g0
    v2 = GetModuleVariable variable=g1
    Return v2
}
function f1 name="readsBetweenAwaits" role=CoroutineRamp flags=[IsAsync] parameters=[{type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f1 body=f2 entryWithoutPromise=f2 promiseType=Promise promiseParameter=1} {
    v1 = NewPromise
    v2 = CallDirect v0, v1 function=f2
    v3 = AssumeType v2 castType=Promise
    Return v3
}
function f2 name="readsBetweenAwaits" role=CoroutineBody flags=[IsAsync] parameters=[{type=anything}, {type=undefined|Promise}] results=[{type=anything}] derivation={source=f1} creator=Coroutine{kind=AsyncFunction ramp=f1 body=f2 entryWithoutPromise=f2 promiseType=Promise promiseParameter=1} {
    v2 = CallDirect v0 function=f0
    v3 = CallDirect v0 function=f0
    v4 = CallDirect v0 function=f0
    v5 = CallDirect v0 function=f0
    v6 = AwaitBySavingFrame v0, v1 @10
    v7 = CallDirect v2 function=f0
    v8 = CallDirect v3 function=f0
    v9 = CallDirect v4 function=f0
    v10 = CallDirect v5 function=f0
    v11 = CallDirect v0 function=f0
    v12 = CallDirect v0 function=f0
    v13 = CallDirect v0 function=f0
    v14 = CallDirect v0 function=f0
    v15 = CallDirect v11 function=f0
    v16 = CallDirect v12 function=f0
    v17 = CallDirect v13 function=f0
    v18 = CallDirect v14 function=f0
    v19 = AwaitBySavingFrame v0, v1 @20
    v20 = ReturnAsyncResult v1, v19
    Return v20
}
