# Each kind of generator object comes from its form of one stub, a step calls the form of the stub for its check or, of an async generator, the form for the kind of function that takes the step, and the tests for an unmodified generator are code without a call
# FORM: Selected
# RUN: generate-code calls
# OPTIONS: check=validate-back-end

module m0 path="main.js" displayPath="main.js"
function f0 name="generator" role=CoroutineRamp flags=[IsGenerator, TakesCallee] results=[{type=Generator}] creator=Coroutine{ramp=f0 body=f10 promiseParameter=1} {
    v1 = NewGenerator v0 function=f0
    v2 = CallDirect v0, v1 function=f10
    Return v1
}
# CHECK: f0: size=
# CHECK-NEXT: function f10 x1
# CHECK-NEXT: stub NewGenerator.Sync x1
# CHECK-NOT: operation
function f1 name="asyncGenerator" role=CoroutineRamp flags=[IsAsync, IsGenerator, TakesCallee] results=[{type=AsyncGenerator}] creator=Coroutine{kind=AsyncGenerator ramp=f1 body=f11 promiseType=Promise promiseParameter=1} {
    v1 = NewAsyncGenerator v0 function=f1
    v2 = CallDirect v0, v1 function=f11
    Return v1
}
# CHECK: f1: size=
# CHECK-NEXT: function f11 x1
# CHECK-NEXT: stub NewGenerator.Async x1
# CHECK-NOT: operation
function f2 name="stepsWithEachCheck" parameters=[{type=anything}, {type=Generator}, {type=anything}] results=[{type=anything}] {
    v3 = StepGenerator v0, v2 check=IsUnmodifiedGenerator
    v4 = ResultAt v3 index=0
    v5 = StepGenerator v0, v4 resumeMode=Throw check=IsGenerator
    v6 = ResultAt v5 index=0
    v7 = StepGenerator v1, v6 resumeMode=Return check=IsUnmodified
    v8 = ResultAt v7 index=0
    v9 = StepGenerator v1, v8 check=None
    v10 = ResultAt v9 index=0
    Return v10
}
# CHECK: f2: size=
# CHECK-NEXT: stub StepGenerator.IsGenerator x1
# CHECK-NEXT: stub StepGenerator.IsUnmodified x1
# CHECK-NEXT: stub StepGenerator.IsUnmodifiedGenerator x1
# CHECK-NEXT: stub StepGenerator.None x1
function f3 name="stepsTwiceWithOneCheck" parameters=[{type=Generator}, {type=anything}] results=[{type=anything}] {
    v2 = StepGenerator v0, v1 check=None
    v3 = ResultAt v2 index=0
    v4 = StepGenerator v0, v3 check=None
    v5 = ResultAt v4 index=0
    Return v5
}
# CHECK: f3: size=
# CHECK-NEXT: stub StepGenerator.None x2
# CHECK-NOT: stub StepGenerator
function f4 name="branchesOnTest" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = IsUnmodifiedGenerator v0
    TestAndBranch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1
    Return v3
  b2():
    Return v1
}
# CHECK: f4: size={{*}} sites=1
# CHECK-NEXT: stub CallValue
function f5 name="returnsTest" parameters=[{type=anything}] results=[{type=boolean}] {
    v1 = IsUnmodifiedGenerator v0
    Return v1
}
# CHECK-NEXT: f5: size={{*}} frame=none {{*}} sites=0
function f6 name="branchesOnTestOfNumber" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
    v2 = IsUnmodifiedGenerator v0
    TestAndBranch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Call v1
    Return v3
  b2():
    Return v1
}
# CHECK-NEXT: f6: size={{*}} frame=none {{*}} sites=0
function f7 name="returnsTestOfNumber" parameters=[{type=number}] results=[{type=boolean}] {
    v1 = IsUnmodifiedGenerator v0
    Return v1
}
# CHECK-NEXT: f7: size={{*}} frame=none {{*}} sites=0
function f8 name="stepsInAsyncFunction" role=CoroutineRamp flags=[IsAsync] parameters=[{type=AsyncGenerator}, {type=anything}] results=[{type=Promise}] creator=Coroutine{kind=AsyncFunction ramp=f8 body=f12 entryWithoutPromise=f12 promiseType=Promise promiseParameter=2}
function f9 name="stepsInAsyncGenerator" role=CoroutineRamp flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=AsyncGenerator}] results=[{type=AsyncGenerator}] creator=Coroutine{kind=AsyncGenerator ramp=f9 body=f13 promiseType=Promise promiseParameter=2}
function f10 name="generator" role=CoroutineBody flags=[IsGenerator, TakesCallee] parameters=[{type=Generator}] results=[{type=anything}] derivation={source=f0} creator=Coroutine{ramp=f0 body=f10 promiseParameter=1} {
    v2 = Undefined
