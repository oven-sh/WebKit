function f11 name="asyncGenerator" role=CoroutineBody flags=[IsAsync, IsGenerator, TakesCallee] parameters=[{type=AsyncGenerator}] results=[{type=anything}] derivation={source=f1} creator=Coroutine{kind=AsyncGenerator ramp=f1 body=f11 promiseType=Promise promiseParameter=1} {
    v2 = Undefined
