# The run time is told which frame owns an open JSON source. A frame that was saved goes on at another address, so each JSONSourceOpen takes the frame pointer where it stands: one value for the two would be live across the suspension
#   const parsed = JSON.parse('{"label":"parsed"}') as Holder; print(parsed.label)
#   await 0
#   const again = JSON.parse('[{"label":"text"}]') as Holder[]; print(parsed.label, again.length)
