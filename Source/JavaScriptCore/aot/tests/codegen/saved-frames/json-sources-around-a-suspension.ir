# The run time is told which frame owns an open JSON source. A frame that was saved goes on at another address, so each JSONSourceOpen takes the frame pointer where it stands: one value for the two would be live across the suspension
#   const parsed = JSON.parse('{"label":"parsed"}') as Holder; print(parsed.label)
#   await 0
#   const again = JSON.parse('[{"label":"text"}]') as Holder[]; print(parsed.label, again.length)
# OPTIONS: heat=EverythingIsHot
# RUN: pipeline CheckPlacement
# CHECK: role=CoroutineBody
# CHECK: = JSONSourceOpen
# CHECK: = AwaitBySavingFrame
# CHECK: = JSONSourceOpen
# RUN(CODE): compile
# CODE: image not empty

typesite w0 module=m0 position=138 kind=Assertion
typesite w1 module=m0 position=167 kind=PromiseValue
typesite w2 module=m0 position=226 kind=Assertion
layout L0 name="Holder" module=m0 position=62 fields=[{key="label" declared={type=undefined|null|string} flags=[IsRequired]}]
module m0 path="main.ts" displayPath="main.ts" flags=[HasTopLevelAwait] body=f0
function f0 module=m0 kind=Module flags=[IsAsync, IsChecked] thisType={type=anything} results=[{type=anything}] {
    Jump -> next b1() @0
  b1():
    v0 = Builtin builtin=GlobalThis @102
    v1 = PropGet v0 key="JSON" [isFreeName] @102
    v2 = Convert v1 declared={type=builtin(JSON) flags=[IsExpected]} @102
    v3 = PropGet v2 key="parse" @102
    v4 = Convert v3 declared={type=function flags=[IsExpected]} @102
    v5 = Convert v4 declared={type=builtin(JSONParse) flags=[IsExpected]} @102
    v6 = String string="{\"label\":\"parsed\"}" @113
    v7 = Call v5, v2, v6 calleeKey="parse" calleeName="parse" @107
    v8 = Convert v7 declared={type=undefined|null|L0 site=w0} illTypedCause=FromLooseType @102
    v9 = Builtin builtin=GlobalThis @146
    v10 = PropGet v9 key="print" [isFreeName] @146
    v11 = Convert v10 declared={type=function flags=[IsExpected]} @146
    v12 = PropGet v8 key="label" @152
    v13 = Call v11, -, v12 calleeName="print" @146
    v14 = Integer @173
    v15 = Await v14 @167
    v16 = Convert v15 declared={type=undefined|null|number site=w1} illTypedCause=ContainerWriterUnseen @167
    v17 = Builtin builtin=GlobalThis @190
    v18 = PropGet v17 key="JSON" [isFreeName] @190
    v19 = Convert v18 declared={type=builtin(JSON) flags=[IsExpected]} @190
    v20 = PropGet v19 key="parse" @190
    v21 = Convert v20 declared={type=function flags=[IsExpected]} @190
    v22 = Convert v21 declared={type=builtin(JSONParse) flags=[IsExpected]} @190
    v23 = String string="[{\"label\":\"text\"}]" @201
    v24 = Call v22, v19, v23 calleeKey="parse" calleeName="parse" @195
    v25 = Convert v24 declared={type=undefined|null|Array<undefined|null|L0> site=w2} illTypedCause=FromLooseType @190
    v26 = Builtin builtin=GlobalThis @236
    v27 = PropGet v26 key="print" [isFreeName] @236
    v28 = Convert v27 declared={type=function flags=[IsExpected]} @236
    v29 = PropGet v8 key="label" @242
    v30 = PropGet v25 key="length" @256
    v31 = Convert v30 declared={type=number flags=[IsExpected]} @256
    v32 = Call v28, -, v29, v31 calleeName="print" @236
    v33 = Undefined @236
    Return v33 @236
}
entry module=m0
