# A value that is strictly equal to "" is a string of length zero. Fast code asks for the cell, the type and the length in place. Other code calls the stub for a text of length zero that lies in a register.
# Neither calls the stub that looks the text up in the tables of the image: the empty text has no header there, and that stub hands it to an operation.
# FORM: Selected
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end
# RUN: generate-code calls StringLiteralsComparedInPlace
# RUN(S): code-shapes

module m0 path="main.js" displayPath="main.js"
function f0 name="valueInFastCode" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = ValueEqualsLiteral v0 literal=""
    TestAndBranch v2 -> taken b1(), notTaken b2()
  b2():
    Return
}
# S: f0 b1 Fast
# CHECK-LABEL: f0: size=
# CHECK-NOT: stub ValueEqualsLiteral
# CHECK-NOT: stub StringEqualsLiteral

function f1 name="valueInBalancedCode" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = ValueEqualsLiteral v0 literal=""
    Return v1
}
# S: f1 b0 Balanced
# CHECK-LABEL: f1: size=
# CHECK-NOT: stub ValueEqualsLiteral x
# CHECK: stub ValueEqualsLiteralOfLength{{*}} x1
# CHECK-NOT: stub ValueEqualsLiteral x

function f2 name="stringInBalancedCode" parameters=[{type=string}] results=[{type=boolean}] {
  b0(v0: string):
    v1 = StringEqualsLiteral v0 literal=""
    Return v1
}
# S: f2 b0 Balanced
# CHECK-LABEL: f2: size=
# CHECK-NOT: stub StringEqualsLiteral
# CHECK: statistic StringLiteralsComparedInPlace 1
