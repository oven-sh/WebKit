# function kindOf(word: string): number {
#   if (word === "get") return 1;
#   if (word === "post") return 2;
#   return 0;
# }
# function same(left: string, right: string): boolean {
#   return left === right;
# }
# declare const input: any;
# (globalThis as any).answer = kindOf(input) + (same(input, input + "x") ? 1 : 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=133 kind=Parameter function=f2
typesite w3 module=m0 position=147 kind=Parameter function=f2
typesite w4 module=m0 position=119 kind=Result
typesite w5 module=m0 position=255 kind=CallResult
typesite w6 module=m0 position=272 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="globalThis" [isFreeName]
    v6 = Convert v5 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v7 = Convert v6 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="input" [isFreeName]
    v10 = Convert v9 declared={type=undefined|null|string flags=[IsExpected]}
    v11 = Call v1, -, v10 calleeName="kindOf"
    v12 = Convert v11 declared={type=number site=w5}
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=undefined|null|string flags=[IsExpected]}
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = String string="x"
    v19 = Add v17, v18
    v20 = Call v3, -, v15, v19 calleeName="same"
    v21 = Convert v20 declared={type=boolean site=w6}
    v22 = ToBoolean v21
    Branch v22 -> taken b2(| 0), notTaken b4(| 0)
  b2(v23):
    Jump -> next b3()
  b3():
    v24 = Integer integer=1
    Jump -> next b6(v24)
  b4(v25):
    Jump -> next b5()
  b5():
    v26 = Integer
    Jump -> next b6(v26)
  b6(v27):
    v28 = Add v12, v27
    PropSet v7, v28 key="answer"
    v30 = Undefined
    Return v30
}
function f1 name="kindOf" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = String string="get"
    v2 = StrictEq v0, v1
    Branch v2 -> taken b2(| 0), notTaken b4(| 0)
  b2(v3):
    Jump -> next b3()
  b3():
    v4 = Integer integer=1
    v5 = Convert v4 declared={type=number site=w1}
    Return v5
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = String string="post"
    v8 = StrictEq v6, v7
    Branch v8 -> taken b6(| 0), notTaken b8(| 0)
  b6(v9):
    Jump -> next b7()
  b7():
    v10 = Integer integer=2
    v11 = Convert v10 declared={type=number site=w1}
    Return v11
  b8(v12):
    Jump -> next b9()
  b9():
    v13 = Integer
    v14 = Convert v13 declared={type=number site=w1}
    Return v14
}
function f2 name="same" module=m0 position=119 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]}] results=[{type=boolean site=w4}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|string):
    Jump -> next b1()
  b1():
    v2 = StrictEq v0, v1
    v3 = Convert v2 declared={type=boolean site=w4}
    Return v3
}

# `word === "get"` compares with the characters of the literal, packed into an immediate: 0x746567 is "get", 0x74736f70 is "post". No string cell is loaded for the literal, and nothing that may throw or allocate is called.
# CHECK-LABEL: name="kindOf" role=Source
# CHECK: Patchpoint(b@[[word]]:{{*}}, $7628135(b@{{*}}):{{*}}Terminal|ControlDependent|Reads:{{*}}StringStorage{{*}}:StringEqualsLiteral)
# CHECK: Patchpoint(b@[[word]]:{{*}}, $1953722224(b@{{*}}):{{*}}Terminal|ControlDependent|Reads:{{*}}StringStorage{{*}}:StringEqualsLiteral)
# CHECK-LABEL: end of function
# NONE-LABEL: name="kindOf" role=Source
# NONE-NOT: Writes:
# NONE-NOT: ExitsSideways
# NONE-NOT: Load
# NONE-LABEL: end of function
