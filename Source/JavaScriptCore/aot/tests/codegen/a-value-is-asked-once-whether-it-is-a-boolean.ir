# Every turn takes (a, b) to (b ^ (a & b), a): each value is computed from the two in front of it. Where the last one is compared, B3 asks whether it is a boolean, and that goes by its operands:
# each value answers once. Asked again for every way that leads to it, a chain of two hundred turns does not end.
# FORM: AsRead
# RUN: run-in-shell globalThis.register = mix => { print(mix(6, 1073741824), mix(12, 8), mix(-1, 255), mix(255, 0)); };
# CHECK: false false false true
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 name="main" module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="register" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
