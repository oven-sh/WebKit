    v6 = Convert v4 declared={type=i32 flags=[IsExpected]}
    v7 = Less v6, v1
    Branch v7 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v8, v9):
    Jump -> next b4()
  b4():
    v10 = Convert v8 declared={type=i32 flags=[IsExpected]}
    v11 = Integer integer=7
    v12 = BitAnd v10, v11
    v13 = Integer integer=1
    v14 = Add v10, v13
    v15 = Integer integer=2
    v16 = Add v10, v15
    v17 = NewArray v10, v14, v16 contents=number
    v18 = Convert v17 declared={type=undefined|null|Array<number> site=w3 flags=[OmitsNull, OmitsUndefined]}
    ElemSet v0, v12, v18
    Jump -> next b5()
  b5():
    v20 = Increment v10
    v21 = Convert v20 declared={type=number site=w2}
    Jump -> next b2(v21)
  b6(v22, v23):
