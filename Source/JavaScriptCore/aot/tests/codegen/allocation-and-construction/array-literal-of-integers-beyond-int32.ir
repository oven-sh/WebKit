    Return v24
}

# r + 1 and r + 2 may pass int32, so they are 64-bit integers and the list gets Double storage. Each integer is converted once and handed to the stub.
# CHECK-LABEL: loop #
# CHECK: Double b@[[third]] = IToD(b@{{*}}, {{*}}:NewArray)
# CHECK: Double b@[[first]] = IToD(b@{{*}}, {{*}}:NewArray)
# CHECK: Double b@[[second]] = IToD(b@{{*}}, {{*}}:NewArray)
# CHECK: Patchpoint({{*}}, b@[[first]]:Register({{*}}), b@[[second]]:Register({{*}}), b@[[third]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewArray)
# CHECK-LABEL: end of loop
# No integer is boxed on the way, which would test its range.
# NONE-LABEL: loop #
# NONE-NOT: Branch({{*}}:NewArray)
# NONE-NOT: BitwiseCast({{*}}:NewArray)
# NONE-NOT: Trunc({{*}}:NewArray)
# NONE-LABEL: end of loop
