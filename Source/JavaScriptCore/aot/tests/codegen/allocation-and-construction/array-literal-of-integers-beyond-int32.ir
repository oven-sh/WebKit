    Return v10
}
function f1 name="fill" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|Array<undefined|null|Array<number>> site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Array<undefined|null|Array<number>>, v1: number):
    Jump -> next b1()
  b1():
    v2 = Integer
    v3 = Convert v2 declared={type=number site=w2}
    Jump -> next b2(v3)
  b2(v4: number):
