# type Point = { x: number; y: number };
# function make(x: number, y: number): Point {
#   return { x, y };
# }
# declare const input: any;
# const point = make(+input, +input);
# (globalThis as any).answer = [point, point.x + point.y];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=53 kind=Parameter function=f1
typesite w1 module=m0 position=64 kind=Parameter function=f1
typesite w2 module=m0 position=39 kind=Result
typesite w3 module=m0 position=145 kind=CallResult
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v5, v9 calleeName="make"
    v11 = Convert v10 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = PropGet v11 key="x"
    v17 = PropGet v11 key="y"
    v18 = Add v16, v17
    v19 = NewArray v11, v18 contents=anything
    PropSet v15, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="make" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Convert v0 declared={type=number}
    v3 = Convert v1 declared={type=number}
    v4 = NewObject -, v2, v3 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = Convert v5 declared={type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}

# One call allocates the cell, and each number is one store of an unboxed double into it.
# CHECK-LABEL: name="make" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[point]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Double b@[[x]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[x]], b@[[point]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[y]], b@[[point]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Return(b@[[point]], Terminal)
# CHECK-LABEL: end of function
# The allocation wrote the header with the final shape: nothing here writes or reads it, boxes a number or calls anything else.
# NONE-LABEL: name="make" role=Source
# NONE-NOT: |Writes:JSCell_header
# NONE-NOT: Reads:JSCell
# NONE-NOT: BitwiseCast(
# NONE-COUNT-1: Patchpoint(
# NONE-NOT: Patchpoint(
# NONE-LABEL: end of function
# The allocation is the shared stub for a header and two words. Its slow path is in the stub, not here.
# CALLS: f1: size=
# CALLS-NEXT: stub AllocateCell.HeaderAndWords.n2 x1
# CALLS-NOT: stub
# CALLS-NOT: operation
# CALLS: f{{*}}: size=
# X64: instructions: 7, patchpoints: 1
# arm64 tests whether the collector is marking, and has its fence in a rare block.
# ARM64: instructions: 8, patchpoints: 1, rare instructions: 2
