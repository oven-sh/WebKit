# function-objects-of-top-level-functions.ir where all code counts as cold: the same stub creates the function objects.
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls heat=EverythingIsCold
# RUN: generate-code calls
# REQUIRES: unsanitized-code
# PROGRAM-OF: function-objects-of-top-level-functions.ir
# CHECK-NOT: operationAOTSingletonClosure
# CHECK: stub ClosureOfTable x2
# CHECK-NOT: operationAOTSingletonClosure
