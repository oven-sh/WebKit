  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f3
    v3 = NewClass v2 layout=L1
    PutModuleVariable v3 variable=g2
    v5 = NewClosure function=f4
    DefineMethod v3, v5 layout=L1 key="who"
    v7 = FinishClass v3 layout=L1
    v8 = Convert v7 declared={type=f3 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v9 = Convert v7 declared={type=f3 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    PutModuleVariable v9 variable=g1
    v11 = GetModuleVariable variable=g0
    v12 = PropGet v11 key="prototype"
    v13 = Convert v12 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v14 = NewClosure function=f5
    PropSet v13, v14 key="who"
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="report" [isFreeName]
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="count" [isFreeName]
    v20 = Call v1, -, v19 calleeName="run"
    v21 = Call v17, -, v20 calleeName="report"
    v22 = Undefined
    Return v22
}
function f1 name="Other" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] functionTypes=[f6] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] constructedClass=L0 {
  b0():
