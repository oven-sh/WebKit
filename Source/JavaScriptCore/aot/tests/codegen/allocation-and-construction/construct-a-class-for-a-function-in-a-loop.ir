# Whatever gives the object another prototype than that of its class may end what the guards of the class say, so the guard is read behind the allocation in every turn.
# CHECK-LABEL: name="run" role=Source
# CHECK: Patchpoint({{*}}:GetConstructPrototype)
# CHECK-NOT: :AreMembersUnchanged)
# CHECK: Patchpoint({{*}}:NewObject)
# CHECK: Load8Z({{*}}Reads:MemberGuards{{*}}:AreMembersUnchanged)
# CHECK: Patchpoint({{*}}Writes:{{*}}MemberGuards{{*}}:NewObject)
# CHECK-LABEL: end of function
