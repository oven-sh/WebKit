    v13 = GetModuleVariable variable=g1
    v14 = CheckInitialized v13 name="Base"
    v15 = Data data=d0
    v16 = Convert v15 declared={type=undefined|null|Array<never> flags=[IsExpected]}
    v17 = GetModuleVariable variable=g0 @232
    v18 = Call v12, v11, v14, v16, v17 calleeName="Reflect.construct" [isDoneInPlace]
    v19 = Convert v18 declared={type=undefined|null|object flags=[IsExpected]}
    v20 = PropGet v19 key="who"
    v21 = Convert v20 declared={type=undefined|null|function flags=[IsExpected]}
    v22 = Call v21, v19 calleeKey="who" calleeName="who"
    Jump -> next b5()
  b5():
    v23 = Increment v9
    v24 = Convert v23 declared={type=number flags=[IsExpected]}
    Jump -> next b2(v22, v24)
  b6(v25, v26):
