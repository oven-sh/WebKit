# REQUIRES: unsanitized-code
# RUN(GO): run-in-shell globalThis.count = 2; globalThis.report = print;
# GO: other
# GO-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Other" module=m0 constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="Base" module=m0 constructor=f3
layout L2 fields=[{key="who" declared={type=anything}}] flags=[IsNeverAllocated] ownFieldCount=1 flow={allocation=NeverAllocated}
layout L3 fields=[{key="who" declared={type=anything} flags=[IsRequired, IsMethod]}] flags=[IsNeverAllocated] ownFieldCount=1 flow={allocation=NeverAllocated}
variable g0 name="Other" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="Base" module=m0 declared={type=absent|f3 flags=[IsFromCompiler]} flags=[IsImmutable]
variable g2 module=m0 declared={type=function flags=[IsFromCompiler]} flags=[IsImmutable]
data d0 root=Array{contents=anything} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
