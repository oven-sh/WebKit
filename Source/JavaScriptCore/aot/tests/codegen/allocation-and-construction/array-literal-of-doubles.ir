# function pair(a: number, b: number): number[] {
#   return [a * 0.5, b * 0.5];
# }
# declare const input: any;
# (globalThis as any).answer = pair(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=25 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=134 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="pair"
    v15 = Convert v14 declared={type=undefined|null|Array<number> site=w3 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="pair" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Double number=0.5
    v3 = Mul v0, v2
    v4 = Double number=0.5
    v5 = Mul v1, v4
    v6 = NewArray v3, v5 contents=number
    v7 = Convert v6 declared={type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v7
}

# The list gets storage for unboxed doubles. One stub allocates and fills it: the elements go to it in floating-point registers.
# CHECK-LABEL: name="pair" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Double b@[[first]] = Mul(
# CHECK: Double b@[[second]] = Mul(
# CHECK: Int64 b@[[list]] = Patchpoint($770(b@{{*}}):Register({{*}}), b@[[first]]:Register({{*}}), b@[[second]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewArray)
# CHECK-NEXT: Return(b@[[list]], Terminal)
# CHECK-LABEL: end of function
# Nothing is boxed, stored or tested at the site.
# NONE-LABEL: name="pair" role=Source
# NONE-NOT: BitwiseCast(
# NONE-NOT: Store(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# CALLS: f1: size=
# CALLS-NEXT: stub ArrayLiteralWithDouble.n2 x1
# CALLS-NOT: stub
# CALLS-NOT: operation
# CALLS: f{{*}}: size=
# X64: instructions: 7, patchpoints: 1
# ARM64: instructions: 7, patchpoints: 1
