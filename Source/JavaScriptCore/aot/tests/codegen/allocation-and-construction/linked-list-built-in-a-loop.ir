# type Cell = { value: number; next: Cell | null };
# function build(limit: number): Cell | null {
#   let head: Cell | null = null;
#   for (let k = 0; k < limit; k++) head = { value: k, next: head };
#   return head;
# }
# declare const input: any;
# const list = build(input | 0);
# (globalThis as any).answer = [list, list!.value, list!.next];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized loops f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=65 kind=Parameter function=f1
typesite w1 module=m0 position=50 kind=Result
typesite w2 module=m0 position=250 kind=CallResult
typesite w3 module=m0 position=101 kind=Variable
typesite w4 module=m0 position=138 kind=Variable
layout L0 name="Cell" module=m0 position=5 fields=[{key="next" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}, {key="value" declared={type=number} flags=[IsRequired]}] declaredOrder=[1, 0] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=i32 flags=[IsExpected]}
    v5 = Integer
    v6 = BitOr v4, v5
    v7 = Call v1, -, v6 calleeName="build"
    v8 = Convert v7 declared={type=undefined|null|L0 site=w2 flags=[OmitsUndefined]}
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="globalThis" [isFreeName]
    v11 = Convert v10 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v12 = Convert v11 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v13 = PropGet v8 key="value"
    v14 = PropGet v8 key="next"
    v15 = NewArray v8, v13, v14 contents=anything
    PropSet v12, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="build" module=m0 position=50 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|L0 site=w1 flags=[OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Null
    v2 = Convert v1 declared={type=undefined|null|L0 site=w3 flags=[OmitsUndefined]}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w4}
    Jump -> next b2(v2, v4)
  b2(v5: undefined|null|L0, v6: number):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v9, v10):
    Jump -> next b4()
  b4():
    v11 = Convert v9 declared={type=number}
    v12 = Convert v5 declared={type=undefined|null|L0 flags=[OmitsUndefined]}
    v13 = NewObject -, v11, v12 layout=L0 fields=[1, 0]
    v14 = FinishObject v13
    v15 = Convert v14 declared={type=undefined|null|L0 site=w3 flags=[OmitsUndefined]}
    Jump -> next b5()
  b5():
    v16 = Increment v9
    v17 = Convert v16 declared={type=number site=w4}
    Jump -> next b2(v15, v17)
  b6(v18, v19):
    Jump -> next b7()
  b7():
    v20 = Convert v5 declared={type=undefined|null|L0 site=w1 flags=[OmitsUndefined]}
    Return v20
}

# Nothing that flow sees bounds the counter, so the field holds a number in 64 bits. Each turn allocates one cell and stores the counter, as a double, and the cell of the turn before. No store is tested, so the cell has no word for a value that fails a test.
# CHECK-LABEL: steps by 1
# CHECK: Int64 b@[[head]] = Phi(
# CHECK-NEXT: Int32 b@[[k]] = Phi(
# CHECK-NEXT: Double b@[[value]] = IToD(b@[[k]], {{*}}:NewObject)
# CHECK-NEXT: Int64 b@[[cell]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Store(b@[[value]], b@[[cell]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[head]], b@[[cell]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK: Upsilon(b@[[cell]], ^[[head]],
# CHECK-LABEL: end of loop
# The older cell goes into the newer one, so there is no write barrier. The counter is not boxed.
# NONE-LABEL: steps by 1
# NONE-NOT: Reads:JSCell
# NONE-NOT: offset = 7,
# NONE-NOT: Reads:ObjectFields
# NONE-LABEL: end of loop
# CALLS: f1: size=
# CALLS-NOT: stub
# CALLS: stub AllocateCell.HeaderAndWords.n2 x1
# CALLS-NOT: stub
# CALLS: f{{*}}: size=
# The cell is handed to the next turn ahead of the test, and the branch itself leads back.
# X64-NOT: , instructions:
# X64: loop #{{*}}, instructions: 9, patchpoints: 2
# X64-NOT: , instructions:
# ARM64-NOT: , instructions:
# ARM64: loop #{{*}}, instructions: 9, patchpoints: 2, rare instructions: 2
