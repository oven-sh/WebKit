layout L1 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="input" [isFreeName]
    v4 = Convert v3 declared={type=number flags=[IsExpected]}
    v5 = ToNumber v4
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v5, v9 calleeName="line"
    v11 = Convert v10 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="globalThis" [isFreeName]
    v14 = Convert v13 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v15 = Convert v14 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v16 = PropGet v11 key="start"
    v17 = PropGet v16 key="x"
    v18 = PropGet v11 key="start"
    v19 = PropGet v18 key="y"
    v20 = Add v17, v19
    v21 = PropGet v11 key="end"
    v22 = PropGet v21 key="x"
    v23 = Add v20, v22
    v24 = PropGet v11 key="end"
    v25 = PropGet v24 key="y"
    v26 = Add v23, v25
    v27 = NewArray v11, v26 contents=anything
    PropSet v15, v27 key="answer"
    v29 = Undefined
    Return v29
}
function f1 name="line" module=m0 position=81 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
