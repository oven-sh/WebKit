# Three allocations. The two inner cells go into the outer one, which is the newest of the three, by plain stores.
# CHECK-LABEL: name="line" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[start]] = Patchpoint($2(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK: Store(b@[[a]], b@[[start]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Store(b@[[b]], b@[[start]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Int64 b@[[end]] = Patchpoint($2(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Store(b@[[b]], b@[[end]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[a]], b@[[end]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Int64 b@[[line]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Store(b@[[start]], b@[[line]], offset = {{*}}, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[end]], b@[[line]], offset = {{*}}, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Return(b@[[line]], Terminal)
# CHECK-LABEL: end of function
# No store has a write barrier, and the inner cells stay in registers across the later allocations.
