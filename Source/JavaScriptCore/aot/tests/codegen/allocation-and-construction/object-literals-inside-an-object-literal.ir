# type Point = { x: number; y: number };
# type Line = { start: Point; end: Point };
# function line(a: number, b: number): Line {
#   return { start: { x: a, y: b }, end: { x: b, y: a } };
# }
# declare const input: any;
# const made = line(+input, +input);
# (globalThis as any).answer = [made, made.start.x + made.start.y + made.end.x + made.end.y];
# FORM: AsRead
