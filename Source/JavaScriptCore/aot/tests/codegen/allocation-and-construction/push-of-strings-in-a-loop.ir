# A push of a reference is inline: the test of the capacity, the test of the write barrier on the list, the two stores.
# CHECK-LABEL: steps by 1
# CHECK: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, {{*}}:HasSpareArrayCapacity)
# CHECK: Int32 b@[[fits]] = Below(b@[[length]], b@[[capacity]], {{*}}:HasSpareArrayCapacity)
# CHECK-NEXT: Branch(b@[[fits]], Terminal, {{*}}:HasSpareArrayCapacity)
# CHECK-NEXT: Successors: Then:#[[barrier]], Else:Rare:#
# CHECK-NEXT: BB#[[barrier]]:
# CHECK: Int32 b@[[state]] = Load8Z(b@[[list]], offset = 7, ControlDependent|Reads:collectorState,
# CHECK: Branch(b@{{*}}, Terminal,
# CHECK-NEXT: Successors: Then:#[[push]], Else:Rare:#
# CHECK-NEXT: BB#[[push]]:
# CHECK: Store(b@[[word]], b@{{*}}, ControlDependent|Writes:indexedContiguousProperties,
# CHECK-NEXT: Int32 b@[[longer]] = Add(b@[[length]], $1(
# CHECK-NEXT: Store(b@[[longer]], b@[[storage]], offset = -8, ControlDependent|Writes:Butterfly_publicLength,
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK-LABEL: end of loop
# NONE-LABEL: steps by 1
# NONE-NOT: Reads:JSObject_butterfly
# NONE-NOT: Reads:Butterfly_vectorLength
# NONE-NOT: Reads:JSCell
