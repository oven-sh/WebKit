# function pair(a: number, b: number): number[] {
#   return [a, b];
# }
# declare const input: any;
# (globalThis as any).answer = pair(input.a, input.b);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=25 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=122 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v9 = PropGet v8 key="a"
    v10 = Convert v9 declared={type=number flags=[IsExpected]}
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v14 = PropGet v13 key="b"
    v15 = Convert v14 declared={type=number flags=[IsExpected]}
    v16 = Call v1, -, v10, v15 calleeName="pair"
    v17 = Convert v16 declared={type=undefined|null|Array<number> site=w3 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="pair" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = NewArray v0, v1 contents=number
    v3 = Convert v2 declared={type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v3
}

# Each number may be an integer or not, and the list gets storage for any value. The typed body has the numbers as doubles, so it boxes each, as an integer where the double is one: by a stub on x86-64, in place on ARM64.
# CHECK-LABEL: name="pair" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[a]] = ArgumentReg(
# CHECK: Int64 b@[[list]] = Patchpoint(b@[[first]]:Register({{*}}), b@[[second]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewArray)
# CHECK-NEXT: Return(b@[[list]], Terminal)
# CHECK-LABEL: end of function
# The copy for arguments of other types hands its two values on as they came.
# CHECK-LABEL: name="pair" role=GenericVersion
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[anyA]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[anyB]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[anyList]] = Patchpoint(b@[[anyA]]:Register({{*}}), b@[[anyB]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewArray)
# CHECK-NEXT: Return(b@[[anyList]], Terminal)
# CHECK-LABEL: end of function
# CALLS: f3: size=
# CALLS: stub ArrayLiteral.n2 x1
# CALLS-NOT: stub ArrayLiteral
# CALLS: f4: size=
# CALLS-NEXT: stub ArrayLiteral.n2 x1
# The entry unboxes, the typed body boxes again, and the other copy does neither.
# X64-LABEL: role=EntryChecks
# X64: instructions: 15, patchpoints: 2
# X64-LABEL: role=Source
# X64: instructions: 7, patchpoints: 3
# X64-LABEL: role=GenericVersion
# X64: instructions: 5, patchpoints: 1
# ARM64-LABEL: role=EntryChecks
# ARM64: instructions: 14, patchpoints: 2
# ARM64-LABEL: role=Source
# ARM64: instructions: 20, patchpoints: 3
# ARM64-LABEL: role=GenericVersion
# ARM64: instructions: 5, patchpoints: 1
