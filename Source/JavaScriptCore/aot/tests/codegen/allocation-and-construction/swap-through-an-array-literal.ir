# [a, b] = [b, a] makes no list and runs no iterator: the two numbers change places where the paths meet.
# CHECK-LABEL: name="difference" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[a]] = ArgumentReg(
# CHECK-NEXT: Double b@[[b]] = ArgumentReg(
# CHECK-NEXT: Int32 b@[[isLess]] = LessThan(b@[[a]], b@[[b]],
# CHECK-NEXT: Branch(b@[[isLess]], Terminal,
# CHECK-NEXT: Successors: Then:#[[swap]], Else:#[[keep]]
# CHECK-NEXT: BB#[[swap]]:
# CHECK: Upsilon(b@[[b]], ^[[larger]],
# CHECK-NEXT: Upsilon(b@[[a]], ^[[smaller]],
# CHECK: Double b@[[larger]] = Phi(
# CHECK-NEXT: Double b@[[smaller]] = Phi(
# CHECK-NEXT: Double b@[[result]] = Sub(b@[[larger]], b@[[smaller]],
# CHECK-NEXT: Return(b@[[result]], Terminal)
# CHECK: BB#[[keep]]:
# CHECK: Upsilon(b@[[a]], ^[[larger]],
# CHECK-NEXT: Upsilon(b@[[b]], ^[[smaller]],
# CHECK-LABEL: end of function
# NONE-LABEL: name="difference" role=Source
# NONE-NOT: Patchpoint(
