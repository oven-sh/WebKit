# The callee is not inlined, and still its result object is never made. The half of the callee that computes the fields hands them back in two registers.
# CHECK-LABEL: name="divide" role=ResultWorker
# CHECK: Patchpoint(b@{{*}}:Register({{*}}), b@{{*}}:Register({{*}}), runsWithoutFrame, resultConstraints = WarmAny, Terminal|
# CHECK-LABEL: end of function
# The caller calls that half and uses the two registers.
# CHECK-LABEL: name="check" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[a]] = ArgumentReg(
# CHECK-NEXT: Double b@[[b]] = ArgumentReg(
# CHECK-NEXT: Double, Double b@[[division]] = Patchpoint(b@[[a]]:Register({{*}}), b@[[b]]:Register({{*}}), resultConstraints = [Register({{*}}), Register({{*}})], {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[quotient]] = Extract(b@[[division]], <<0,
# CHECK-NEXT: Double b@[[remainder]] = Extract(b@[[division]], <<1,
# CHECK-NEXT: Double b@[[product]] = Mul(b@[[b]], b@[[quotient]],
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[remainder]], b@[[product]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
