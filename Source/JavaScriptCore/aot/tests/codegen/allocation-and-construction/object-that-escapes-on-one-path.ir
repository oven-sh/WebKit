# Only one arm of the branch keeps the point. The allocation has moved into that arm, and the sum behind the branch adds the arguments.
# CHECK-LABEL: name="weigh" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Double b@[[x]] = ArgumentReg(
# CHECK: Int32 b@[[isNegative]] = LessThan(b@[[x]],
# CHECK: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Branch(b@[[isNegative]], Terminal,
# CHECK-NEXT: Successors: Then:#[[keep]], Else:#[[join]]
# CHECK-NEXT: BB#[[keep]]:
# CHECK: Int64 b@[[point]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Store(b@[[x]], b@[[point]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[y]], b@[[point]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Store(b@[[point]], b@{{*}}, ControlDependent|Writes:indexedContiguousProperties,
# CHECK: BB#[[join]]:
# CHECK: Double b@[[sum]] = Add(b@[[x]], b@[[y]],
# CHECK-NEXT: Return(b@[[sum]], Terminal)
# CHECK-LABEL: end of function
# Nothing is allocated ahead of the branch, and no field is read back.
# NONE-LABEL: name="weigh" role=Source
# NONE-NOT: :NewObject
# NONE: Branch(b@{{*}}, Terminal, {{*}}:Less)
# NONE-NOT: Reads:ObjectFields
# NONE-LABEL: end of function
