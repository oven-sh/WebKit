module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 kind=Result
typesite w1 module=m0 position=64 kind=Variable
typesite w2 module=m0 position=125 kind=CallResult
data d0 root=Array{contents=number elements=[Number{value=2}, Number{value=3}, Number{value=5}, Number{value=7}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Integer
    v3 = Convert v2 declared={type=number site=w1}
    Jump -> next b2(v3)
  b2(v4: number):
    LoopHint
    v6 = Integer integer=2
    v7 = Less v4, v6
    Branch v7 -> taken b3(| 0), notTaken b6(| 0)
  b3(v8):
    Jump -> next b4()
  b4():
    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="globalThis" [isFreeName]
    v11 = Convert v10 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v12 = Convert v11 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v13 = Call v1 calleeName="primes"
    v14 = Convert v13 declared={type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v12, v14 key="answer"
    v16 = StrictEq v14, v14
    PropSet v12, v16 key="same"
    Jump -> next b5()
  b5():
    v18 = Increment v8
    v19 = Convert v18 declared={type=number site=w1}
    Jump -> next b2(v19)
  b6(v20):
    Jump -> next b7()
  b7():
    v21 = Undefined
    Return v21
}
function f1 name="primes" module=m0 flags=[IsChecked, HasExplicitName] thisType={type=anything} results=[{type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = Data data=d0
    v1 = Convert v0 declared={type=undefined|null|Array<number> site=w0 flags=[OmitsNull, OmitsUndefined]}
    Return v1
}

# The lists are compared, so each call makes one. The four numbers are data of the image, and the list shares them until somebody writes to it: its storage is an address in that data. The cell is allocated in place, and two stores fill it.
