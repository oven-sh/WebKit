# CHECK: Int64 b@[[storage]] = Add(b@[[data]], $
# CHECK-NEXT: Int64 b@[[header]] = Load(b@[[instance]], offset = {{*}}, ControlDependent|Reads:AOTInstance_mutableFields, {{*}}:Data)
# CHECK-NEXT: Branch(b@[[header]], Terminal,
# CHECK-NEXT: Successors: Then:#[[allocate]], Else:Rare:#[[slow]]
# CHECK-NEXT: BB#[[allocate]]:
# CHECK: Int64 b@[[list]] = Patchpoint(b@{{*}}:SomeRegister, runsWithoutFrame, resultConstraints = SomeEarlyRegister, numGPScratchRegisters = 1, Terminal|{{*}}:Data)
# CHECK-NEXT: Successors: #[[fill]], Rare:#[[slow]]
# CHECK-NEXT: BB#[[fill]]:
# CHECK: Store(b@[[header]], b@[[list]], ControlDependent|Writes:JSCell_header,
# CHECK-NEXT: Store(b@[[storage]], b@[[list]], offset = 8, ControlDependent|Writes:JSArray_butterfly,
