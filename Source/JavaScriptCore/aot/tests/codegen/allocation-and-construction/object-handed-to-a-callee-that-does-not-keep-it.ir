# The callee only reads the object, so it is built in the frame of the caller: the header comes from a table, then the words that a cell starts with and the two fields are stored.
# CHECK-LABEL: name="square" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[found]] = Load(b@{{*}}, offset = -32, ControlDependent|Reads:AllocatorState, {{*}}:NewObject)
# CHECK-NEXT: Branch(b@[[found]], Terminal, {{*}}:NewObject)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#[[slow]]
# CHECK: Int64 b@[[header]] = Phi(
# CHECK-NEXT: Int64 b@[[size]] = SlotBase(stack0,
# CHECK-NEXT: Store(b@[[header]], b@[[size]], ControlDependent|Writes:JSCell_header, {{*}}:NewObject)
# CHECK: Double b@[[side]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[side]], b@[[size]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[side]], b@[[size]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Double b@[[area]] = Patchpoint(b@[[size]]:Register({{*}}), resultConstraints = Register({{*}}), {{*}}:CallDirect)
# CHECK-NEXT: Return(b@[[area]], Terminal)
# CHECK-NEXT: BB#[[slow]]:
# CHECK: Patchpoint($1(b@{{*}}):ColdAny, resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK: stack0: byteSize = 32,
# CHECK-LABEL: end of function
# Nothing is allocated in the heap: the one call on the likely path is the callee.
