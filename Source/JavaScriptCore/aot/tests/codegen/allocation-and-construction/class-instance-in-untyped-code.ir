# Without types the fields come from the assignments in the constructor. The instance is still born with both: one allocation, two stores.
# CHECK-LABEL: name="make" role=ResultWrapper
# CHECK-NEXT: BB#0:
# CHECK: Int64, Int64 b@[[fields]] = Patchpoint({{*}}:CallDirect)
# CHECK-NEXT: Int64 b@[[x]] = Extract(b@[[fields]], <<0,
# CHECK-NEXT: Int64 b@[[y]] = Extract(b@[[fields]], <<1,
# CHECK: Int64 b@[[point]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Store(b@[[x]], b@[[point]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Store(b@[[y]], b@[[point]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Return(b@[[point]], Terminal)
# CHECK-LABEL: end of function
# Nothing reads the class or its prototype, changes the shape behind the allocation, or has a write barrier.
