# The constructor fills both fields, so a read is one load: nothing asks whether the field is still empty, and nothing tests the shape.
# The read through friend needs an object. That test is a load of one byte of the cell that traps on null, and it is folded into the load of the name.
# CHECK-LABEL: name="nameOfFriend" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[person]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[friend]] = Load(b@[[person]], offset = 24, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Int32 b@{{*}} = Load8Z<Traps>(b@[[friend]], offset = 5, {{*}}:RequireObjectCoercible)
# CHECK-NEXT: Int64 b@[[name]] = Load(b@[[friend]], offset = 16, ControlDependent|Reads:ObjectFields{{*}}:GetSlot)
# CHECK-NEXT: Return(b@[[name]], Terminal)
# CHECK-LABEL: end of function
# Two loads and the return.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
