module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=191 kind=CallResult
typesite w3 module=m0 position=50 kind=Variable
typesite w4 module=m0 position=82 kind=Variable
typesite w5 module=m0 position=105 kind=CallResult
data d0 root=Array{contents=number} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="count"
    v12 = Convert v11 declared={type=undefined|null|Array<number> site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="count" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=undefined|null|Array<number> site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Data data=d0
    v2 = Convert v1 declared={type=undefined|null|Array<number> site=w3 flags=[OmitsNull, OmitsUndefined]}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w4}
    Jump -> next b2(v4)
  b2(v5: number):
    LoopHint
    v7 = Less v5, v0
    Branch v7 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v8, v9):
    Jump -> next b4()
  b4():
    v10 = PropGet v2 key="push"
    v11 = Call v10, v2, v8 calleeKey="push" calleeName="list.push"
    v12 = Convert v11 declared={type=number site=w5} illTypedCause=DeclarationWithoutBody
    Jump -> next b5()
  b5():
    v13 = Increment v8
    v14 = Convert v13 declared={type=number site=w4}
    Jump -> next b2(v14)
  b6(v15, v16):
    Jump -> next b7()
  b7():
    Return v2
}

# The list holds unboxed doubles. A push is inline: a test of the length against the capacity, the store of the element, the store of the new length.
# CHECK-LABEL: steps by 1
# CHECK: Int32 b@[[k]] = Phi(
# CHECK-NEXT: Int32 b@[[length]] = Load(b@[[storage]], offset = -8, ControlDependent|Reads:Butterfly_publicLength, {{*}}:HasSpareArrayCapacity)
# CHECK: Int32 b@[[fits]] = Below(b@[[length]], b@[[capacity]], {{*}}:HasSpareArrayCapacity)
# CHECK-NEXT: Branch(b@[[fits]], Terminal, {{*}}:HasSpareArrayCapacity)
# CHECK-NEXT: Successors: Then:#[[push]], Else:Rare:#
# CHECK-NEXT: BB#[[push]]:
# CHECK: Double b@[[element]] = IToD(b@[[k]],
# CHECK: Store(b@[[element]], b@{{*}}, ControlDependent|Writes:indexedDoubleProperties,
# CHECK-NEXT: Int32 b@[[longer]] = Add(b@[[length]], $1(
# CHECK-NEXT: Store(b@[[longer]], b@[[storage]], offset = -8, ControlDependent|Writes:Butterfly_publicLength,
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK-LABEL: end of loop
# The storage and its capacity are read ahead of the loop. Nothing in it calls, tests the kind of storage, or reads the list itself.
# NONE-LABEL: steps by 1
# NONE-NOT: Reads:JSObject_butterfly
# NONE-NOT: Reads:Butterfly_vectorLength
# NONE-NOT: Reads:JSCell
# NONE-NOT: :CallDirect
# The turns can be counted ahead of the loop: where they are few it goes without its poll, and a copy of it that polls takes the others.
# NONE-NOT: Patchpoint(
# NONE-LABEL: end of loop
# The list is made with room for all the elements, since the loop says how many there will be. Growing is out of the loop.
# CALLS: f1: size=
# CALLS: operation operationAOTReserveArrayCapacity x1
# CALLS-NEXT: stub ArrayPush x2
# CALLS-NEXT: stub NewArrayWithLength.Double x1
# CALLS-NEXT: stub NewEmptyArray.DoubleDefaultCapacity x1
# CALLS-NOT: stub
# CALLS-NOT: operation
# CALLS: f{{*}}: size=
# Four of the nine are for the length, which stays in the storage: the load, the test, the addition, the store.
# X64-NOT: , instructions:
# X64: loop #{{*}}, instructions: 9, patchpoints: 0
# X64: loop #{{*}}, instructions: 9, patchpoints: 0, rare instructions: 7, {{*}}entered rarely
# X64-NOT: , instructions:
# ARM64-NOT: , instructions:
# ARM64: loop #{{*}}, instructions: 8, patchpoints: 0
# ARM64: loop #{{*}}, instructions: {{*}}, patchpoints: 0, rare instructions: {{*}}entered rarely
# ARM64-NOT: , instructions:
