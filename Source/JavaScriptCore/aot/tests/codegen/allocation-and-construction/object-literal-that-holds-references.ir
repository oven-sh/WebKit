# type Entry = { name: string; next: Entry | null };
# function link(name: string, next: Entry | null): Entry {
#   return { name, next };
# }
# declare const input: any;
# const entry = link(String(input), link("last", null));
# (globalThis as any).answer = [entry, entry.name, entry.next];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code not-windows
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=65 kind=Parameter function=f1
typesite w1 module=m0 position=79 kind=Parameter function=f1
typesite w2 module=m0 position=51 kind=Result
typesite w3 module=m0 position=180 kind=CallResult
typesite w4 module=m0 position=195 kind=CallResult
typesite w5 module=m0 position=175 kind=CallResult
layout L0 name="Entry" module=m0 position=5 fields=[{key="name" declared={type=undefined|null|string flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}, {key="next" declared={type=undefined|null|L0 flags=[OmitsUndefined]} flags=[IsRequired]}] ownFieldCount=2
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=String
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="input" [isFreeName]
    v5 = Call v2, -, v4 calleeName="String"
    v6 = Convert v5 declared={type=undefined|null|string site=w3 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v7 = String string="last"
    v8 = Null
    v9 = Call v1, -, v7, v8 calleeName="link"
    v10 = Convert v9 declared={type=undefined|null|L0 site=w4 flags=[OmitsNull, OmitsUndefined]}
    v11 = Call v1, -, v6, v10 calleeName="link"
    v12 = Convert v11 declared={type=undefined|null|L0 site=w5 flags=[OmitsNull, OmitsUndefined]}
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="globalThis" [isFreeName]
    v15 = Convert v14 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v16 = Convert v15 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v17 = PropGet v12 key="name"
    v18 = PropGet v12 key="next"
    v19 = NewArray v12, v17, v18 contents=anything
    PropSet v16, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="link" module=m0 position=51 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=undefined|null|L0 site=w1 flags=[OmitsUndefined]}] results=[{type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string, v1: undefined|null|L0):
    Jump -> next b1()
  b1():
    v2 = Convert v0 declared={type=undefined|null|string flags=[OmitsNull, OmitsUndefined]}
    v3 = Convert v1 declared={type=undefined|null|L0 flags=[OmitsUndefined]}
    v4 = NewObject -, v2, v3 layout=L0 fields=[0, 1]
    v5 = FinishObject v4
    v6 = Convert v5 declared={type=undefined|null|L0 site=w2 flags=[OmitsNull, OmitsUndefined]}
    Return v6
}

# One call allocates the cell, and each reference is one store into it.
# CHECK-LABEL: name="link" role=Source
# CHECK-NEXT: BB#0:
# CHECK: Int64 b@[[entry]] = Patchpoint($1(b@{{*}}):Register({{*}}), resultConstraints = Register({{*}}), {{*}}:NewObject)
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[name]], b@[[entry]], offset = 16, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK-NEXT: Int64 b@[[next]] = ArgumentReg(
# CHECK-NEXT: Store(b@[[next]], b@[[entry]], offset = 24, ControlDependent|Writes:ObjectFields{{*}}:NewObject)
# CHECK: Return(b@[[entry]], Terminal)
# CHECK-LABEL: end of function
# The cell is new, so no store into it needs a write barrier. The allocation wrote the header with the final shape, so nothing here writes or reads it.
# NONE-LABEL: name="link" role=Source
# NONE-NOT: JSCell_cellState
# NONE-NOT: |Writes:JSCell_header
# NONE-NOT: Reads:JSCell
# NONE-NOT: :WriteBarrier
# NONE-COUNT-1: Patchpoint(
# NONE-NOT: Patchpoint(
# NONE-LABEL: end of function
# The allocation is the shared stub for a header and two words. Its slow path is in the stub, not here.
# CALLS: f1: size=
# CALLS-NEXT: stub AllocateCell.HeaderAndWords.n2 x1
# CALLS-NOT: stub
# CALLS-NOT: operation
# CALLS: f{{*}}: size=
# The stub changes the first argument register on x86-64, so the name is moved aside first.
# X64: instructions: 8, patchpoints: 1
# ARM64 tests whether the collector is marking, and has its fence in a rare block.
# ARM64: instructions: 8, patchpoints: 1, rare instructions: 2
