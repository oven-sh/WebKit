# type Point = { x: number; y: number };
# function walk(steps: number): number {
#   let at: Point = { x: 0, y: 0 };
#   for (let k = 0; k < steps; k++) at = { x: at.x + 1.5, y: at.y + at.x };
#   return at.x + at.y;
# }
# declare const input: any;
# (globalThis as any).answer = walk(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized loops f1
# REQUIRES(NONE): unsanitized-code
# RUN(CALLS): generate-code calls
# RUN(X64): lower-to-air loops f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air loops f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=53 kind=Parameter function=f1
typesite w1 module=m0 position=39 kind=Result
typesite w2 module=m0 position=265 kind=CallResult
typesite w3 module=m0 position=84 kind=Variable
typesite w4 module=m0 position=123 kind=Variable
layout L0 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="y" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
data d0 root=Object{layout=L0 members=[{key="x" value=Number{}}, {key="y" value=Number{}}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="walk"
    v12 = Convert v11 declared={type=number site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="walk" module=m0 position=39 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Data data=d0
    v2 = Convert v1 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w4}
    Jump -> next b2(v2, v4)
  b2(v5: undefined|null|L0, v6: number):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v9, v10):
    Jump -> next b4()
  b4():
    v11 = PropGet v5 key="x"
    v12 = Double number=1.5
    v13 = Add v11, v12
    v14 = Convert v13 declared={type=number}
    v15 = PropGet v5 key="y"
    v16 = PropGet v5 key="x"
    v17 = Add v15, v16
    v18 = Convert v17 declared={type=number}
    v19 = NewObject -, v14, v18 layout=L0 fields=[0, 1]
    v20 = FinishObject v19
    v21 = Convert v20 declared={type=undefined|null|L0 site=w3 flags=[OmitsNull, OmitsUndefined]}
    Jump -> next b5()
  b5():
    v22 = Increment v9
    v23 = Convert v22 declared={type=number site=w4}
    Jump -> next b2(v21, v23)
  b6(v24, v25):
    Jump -> next b7()
  b7():
    v26 = PropGet v5 key="x"
    v27 = PropGet v5 key="y"
    v28 = Add v26, v27
    v29 = Convert v28 declared={type=number site=w1}
    Return v29
}

# The loop makes a new point from the old one in every turn, and only the fields of the last are read. No point is allocated: the two fields are two doubles that the loop carries.
# CHECK-LABEL: steps by 1
# CHECK: Int32 b@[[k]] = Phi(
# CHECK-NEXT: Double b@[[x]] = Phi(
# CHECK-NEXT: Double b@[[y]] = Phi(
# CHECK-NEXT: Double b@[[nextX]] = Add(b@[[x]], $1.500000(
# CHECK-NEXT: Double b@[[nextY]] = Add(b@[[x]], b@[[y]],
# CHECK: Branch(b@{{*}}, Terminal, {{*}}:Less)
# CHECK: Upsilon(b@[[nextX]], ^[[x]],
# CHECK-NEXT: Upsilon(b@[[nextY]], ^[[y]],
# CHECK-LABEL: end of loop
# NONE-LABEL: steps by 1
# NONE-NOT: :NewObject
# NONE-NOT: ObjectFields
# NONE-NOT: Store(
# NONE-NOT: Load(
# The turns can be counted ahead of the loop: where they are few it goes without its poll, and a copy of it that polls takes the others.
# NONE-NOT: Patchpoint(
# NONE-LABEL: end of loop
# CALLS: f1: size=
# CALLS-NOT: stub
# CALLS-NOT: New
# CALLS: f{{*}}: size=
# Two additions, the counter, a move and the branch, which itself leads back.
# X64-NOT: , instructions:
# X64: loop #{{*}}, instructions: 5, patchpoints: 0
# X64: loop #{{*}}, instructions: 6, patchpoints: 0, rare instructions: 7, {{*}}entered rarely
# X64-NOT: , instructions:
# ARM64-NOT: , instructions:
# ARM64: loop #{{*}}, instructions: 5, patchpoints: 0
# ARM64: loop #{{*}}, instructions: {{*}}, patchpoints: 0, rare instructions: {{*}}entered rarely
# ARM64-NOT: , instructions:
