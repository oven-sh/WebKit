# type Point = { x: number };
# type Holder = { point: Point | null };
# function fill(holder: Holder, a: number): Point {
#   holder.point = { x: a };
#   return { x: a + 1 };
# }
# declare const input: any;
# const holder: Holder = { point: null };
# const made = fill(holder, +input);
# (globalThis as any).answer = [holder, made, holder.point!.x + made.x];
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls,pass:SplitFreshResults
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(FENCES): lower-to-b3 optimized f1
# REQUIRES(FENCES): arm64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=201 kind=Variable
typesite w1 module=m0 position=81 kind=Parameter function=f1
typesite w2 module=m0 position=97 kind=Parameter function=f1
typesite w3 module=m0 position=67 kind=Result
typesite w4 module=m0 position=248 kind=CallResult
typesite w5 module=m0 position=119 kind=Field
layout L0 name="Holder" module=m0 position=33 fields=[{key="point" declared={type=undefined|null|L1 flags=[OmitsUndefined]} flags=[IsRequired]}] ownFieldCount=1
layout L1 name="Point" module=m0 position=5 fields=[{key="x" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
data d0 root=Object{layout=L0 members=[{key="point" value=Null}]} module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Data data=d0
    v3 = Convert v2 declared={type=undefined|null|L0 site=w0 flags=[OmitsNull, OmitsUndefined]}
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="input" [isFreeName]
    v6 = Convert v5 declared={type=number flags=[IsExpected]}
    v7 = ToNumber v6
    v8 = Call v1, -, v3, v7 calleeName="fill"
    v9 = Convert v8 declared={type=undefined|null|L1 site=w4 flags=[OmitsNull, OmitsUndefined]}
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="globalThis" [isFreeName]
    v12 = Convert v11 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v13 = Convert v12 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v14 = PropGet v3 key="point"
    v15 = PropGet v14 key="x"
    v16 = PropGet v9 key="x"
    v17 = Add v15, v16
    v18 = NewArray v3, v9, v17 contents=anything
    PropSet v13, v18 key="answer"
    v20 = Undefined
    Return v20
}
function f1 name="fill" module=m0 position=67 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=undefined|null|L0 site=w1 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w2}] results=[{type=undefined|null|L1 site=w3 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|L0, v1: number):
    Jump -> next b1()
  b1():
    v2 = Convert v1 declared={type=number}
    v3 = NewObject -, v2 layout=L1 fields=[0]
    v4 = FinishObject v3
    v5 = Convert v4 declared={type=undefined|null|L1 site=w5 flags=[OmitsUndefined]}
    PropSet v0, v5 key="point"
    v7 = Integer integer=1
    v8 = Add v1, v7
    v9 = Convert v8 declared={type=number}
    v10 = NewObject -, v9 layout=L1 fields=[0]
    v11 = FinishObject v10
    v12 = Convert v11 declared={type=undefined|null|L1 site=w3 flags=[OmitsNull, OmitsUndefined]}
    Return v12
}

# The first cell is stored into the parameter before the second is made.
# CHECK-LABEL: name="fill" role=Source
# CHECK: Patchpoint({{*}}:NewObject)
# CHECK: Store({{*}}:PutSlot)
# CHECK: Patchpoint({{*}}:NewObject)
# CHECK-LABEL: end of function
# The collector may be reading the parameter: arm64 tests in front of the store into it whether the collector is marking, and again behind the second cell.
# FENCES-LABEL: name="fill" role=Source
# FENCES: Patchpoint({{*}}:NewObject)
# FENCES: Branch({{*}}:NewObject)
# FENCES: Store({{*}}:PutSlot)
# FENCES: Patchpoint({{*}}:NewObject)
# FENCES: Branch({{*}}:NewObject)
# FENCES-COUNT-2: Fence(
# FENCES-NOT: Fence(
# FENCES-LABEL: end of function
# ARM64: instructions: 16, patchpoints: 3, rare instructions: 4
