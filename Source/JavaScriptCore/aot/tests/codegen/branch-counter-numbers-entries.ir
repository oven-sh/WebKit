# Each function has one more counter word, for its entries. They are numbered behind the words of all the branches, so no branch's number depends on them. Past the limit a function has none
# FORM: Selected
# OPTIONS: count-branches limit=BranchCounters:6
# RUN: branch-counters
# LOSS: BranchCounters x1 f2
# CHECK: function f0
# CHECK-NEXT: b0 counters: [0 1] position: 10 negated: no
# CHECK-NEXT: function f2
# CHECK-NEXT: b0 counters: [2 3] position: 40 negated: no
# CHECK-NEXT: f0 entries: 4
# CHECK-NEXT: f1 entries: 5
# CHECK-NEXT: f2 entries: -

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Null
    v3 = StrictEq v1, v2 @10
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
function f1 name="withoutBranches" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    Return
}
function f2 name="pastLimit" parameters=[{type=anything}] results=[{type=undefined}] {
  b0(v0: anything):
    v1 = Null
    v2 = StrictEq v0, v1 @40
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    Return
  b2():
    Return
}
