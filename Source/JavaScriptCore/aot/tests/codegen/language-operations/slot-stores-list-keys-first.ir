variable g0 name="keys" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="kept" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=MathRandom
    v1 = Call v0
    v2 = ToNumber v1
    v3 = NewClosure function=f1
    v4 = NewClass v3 layout=L0
    v5 = FinishClass v4 layout=L0
    v6 = Construct v5, -, v2
    v7 = Builtin builtin=ObjectKeys
