    PutModuleVariable v8 variable=g0
    v10 = NewClosure function=f3
    v11 = NewClass v10 layout=L1
    v12 = FinishClass v11 layout=L1
    v13 = Construct v12, -, v2
    v14 = PropGet v13 key="a"
    v15 = PropGet v13 key="b"
    v16 = Add v14, v15
    v17 = PropGet v13 key="c"
    v18 = Add v16, v17
    v19 = PropGet v13 key="d"
    v20 = Add v18, v19
    v21 = PropGet v13 key="e"
    v22 = Add v20, v21
    v23 = PropGet v13 key="f"
    v24 = Add v22, v23
    v25 = PropGet v13 key="g"
    v26 = Add v24, v25
    v27 = PropGet v13 key="h"
    v28 = Add v26, v27
    v29 = PropGet v13 key="i"
    v30 = Add v28, v29
    v31 = PropGet v13 key="j"
    v32 = Add v30, v31
    PutModuleVariable v32 variable=g1
    Return
}
function f1 name="Enumerated" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: anything, v1: number):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = CallDirect v3, v1 function=f2
