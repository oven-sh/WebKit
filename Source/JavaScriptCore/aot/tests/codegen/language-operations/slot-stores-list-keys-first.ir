# OPTIONS: disable=pass:InlineCalls
# RUN: generate-code calls
# RUN(IR): pipeline Select

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="Enumerated" constructor=f1 fields=[{key="a" declared={type=number} flags=[IsRequired]}, {key="b" declared={type=number} flags=[IsRequired]}, {key="c" declared={type=number} flags=[IsRequired]}, {key="d" declared={type=number} flags=[IsRequired]}, {key="e" declared={type=number} flags=[IsRequired]}, {key="f" declared={type=number} flags=[IsRequired]}, {key="g" declared={type=number} flags=[IsRequired]}, {key="h" declared={type=number} flags=[IsRequired]}, {key="i" declared={type=number} flags=[IsRequired]}, {key="j" declared={type=number} flags=[IsRequired]}]
