# Getters, setters, function names, literal prototypes and copied properties pass the back-end checks in fast code
# RUN: compile
# OPTIONS: heat=everything-is-hot check=validate-back-end only-passes=EstimateHeat
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Literal"

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v0, v1, v2, v3
    Return v6
}
function f1 name="accessors" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    v2 = ToPropertyKey v0
    v3 = NewClosure function=f5
    DefineGetter v1, v3, v2
    DefineGetter v1, v3 key="g"
    DefineSetter v1, v3, v2
    DefineSetter v1, v3 key="g"
    v8 = FinishObject v1
    Return v8
}
function f2 name="functionNames" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = ToPropertyKey v0
    v2 = NewClosure function=f5
    SetFunctionName v2, v1
    SetFunctionName v2, v1 methodKind=Getter
    SetFunctionName v2, v1 methodKind=Setter
    Return v2
}
function f3 name="literalPrototype" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L0
    SetLiteralPrototype v1, v0
    v3 = FinishObject v1
    Return v3
}
function f4 name="copiedProperties" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L0
    v3 = ToPropertyKey v1
    CopyDataProperties v2, v0
    CopyDataProperties v2, v0, v3 excludedKeys=["x", "y"]
    v6 = FinishObject v2
    Return v6
}
function f5 name="callee" results=[{type=anything}] {
  b0():
    Return
}
