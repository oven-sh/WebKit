# CHECK-LABEL: name="handsOver" role=Source
# CHECK: Patchpoint({{*}}childrenLetGoByCallee

# What make() returned waits in a stack slot while count() runs. The store in letsGo() does not reach that slot, and the collector reads it for as long as handsOver() runs,
# so it is cleared once the object is in the argument register.
# X64-LABEL: name="handsOver" role=Source
# X64: Move %rax, (%rsp)
# X64: Move (%rsp), %rdi
# X64-NEXT: Move $0, (%rsp)
# X64-NEXT: Patch
# X64-LABEL: end of function
# The caller reads it again.
# X64-LABEL: name="readsAgain" role=Source
# X64-NOT: Move $0,
# X64-LABEL: end of function
# The callee names it for as long as it runs.
# X64-LABEL: name="calleeKeeps" role=Source
# X64-NOT: Move $0,
# X64-LABEL: end of function
# handsOn() sets nothing to null. It hands its parameter to a function that does.
# X64-LABEL: name="handsOverToOneThatHandsOn" role=Source
# X64: Move (%rsp), %rdi
# X64-NEXT: Move $0, (%rsp)
# X64-NEXT: Patch
# X64-LABEL: end of function
