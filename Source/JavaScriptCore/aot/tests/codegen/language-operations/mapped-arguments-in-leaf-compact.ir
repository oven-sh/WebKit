# In compact code a leaf that reads a mapped argument calls only in rare code and sets no frame up at its entry; the barrier of a store is a call, so a leaf that stores one does
# FORM: AsRead
# RUN: generate-code
# OPTIONS: heat=everything-is-cold disable=pass:InlineCalls check=validate-back-end
# CHECK: f1: size={{*}} frame={{*}}@[[setup]]-
# CHECK: f2: size=
# CHECK-NOT: frame=none
# CHECK-NOT: @[[setup]]-
# CHECK: f3: size={{*}} frame={{*}}@[[setup]]-
# PROGRAM-OF: mapped-arguments-in-leaf.ir
