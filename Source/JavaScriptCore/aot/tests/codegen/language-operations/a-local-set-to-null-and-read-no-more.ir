# CHECK-LABEL: name="beforeCall" role=Source
# CHECK: Void b@{{*}} = Patchpoint({{*}}releasesDeadValues

# The object waits in a stack slot for the second call. The collector reads that slot for as long as the function runs, so it is cleared in front of the third call.
# X64-LABEL: name="beforeCall" role=Source
# X64: Move %rax, (%rsp)
# X64: Move (%rsp), %rdi
# X64-NEXT: Patch
# X64-NEXT: Move $0, (%rsp)
# X64: Patch
# X64-LABEL: end of function
# Nothing can collect before the frame is gone.
# X64-LABEL: name="beforeReturn" role=Source
# X64-NOT: Move $0,
# X64-LABEL: end of function
