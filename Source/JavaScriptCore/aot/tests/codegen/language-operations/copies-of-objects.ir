# A literal made by one copy of an object nobody can name, the rest of a pattern with keys from the text and a computed key, and a copy between objects of one layout pass the back-end checks in fast code
# FORM: AsRead
# OPTIONS: heat=everything-is-hot check=validate-back-end
# RUN: compile
# CHECK: image not empty
# RUN(OPERATIONS): pipeline ExpandOwnKeys
# OPERATIONS-LABEL: name="spreadThenName"
# OPERATIONS: = CopyObject v0
# OPERATIONS-LABEL: name="rest"
# OPERATIONS: = CopyObject v0 excludedKeys=["a", "b"]
# OPERATIONS-LABEL: name="restWithComputedKey"
# OPERATIONS: = CopyObject v0, {{*}} excludedKeys=["a", "0"]
# OPERATIONS-LABEL: name="spreadOfSameLayout"
# OPERATIONS: = TryCopyFields {{*}} layout=L3

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Named" fields=[{key="a" declared={type=anything}}]
layout L1 name="Rest"
layout L2 name="RestWithComputedKey"
layout L3 name="State" fields=[{key="a" declared={type=anything written=anything}}, {key="b" declared={type=anything written=anything}}, {key="c" declared={type=anything written=anything}}]

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = NewClosure function=f5
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="register" [isFreeName]
    v7 = Call v6, -, v0, v1, v2, v3, v4
    Return v7
}
function f1 name="spreadThenName" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = NewObject layout=L0
    CopyDataProperties v2, v0
    PropDefine v2, v1 key="a"
    v5 = FinishObject v2
    Return v5
}
function f2 name="rest" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = NewObject layout=L1
    CopyDataProperties v1, v0 excludedKeys=["a", "b"]
    v3 = FinishObject v1
    Return v3
}
function f3 name="restWithComputedKey" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToPropertyKey v1
    v3 = NewObject layout=L2
    CopyDataProperties v3, v0, v2 excludedKeys=["a", "0"]
    v5 = FinishObject v3
    Return v5
}
function f4 name="makeState" parameters=[{type=anything}, {type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = NewObject -, v0, v1, v2 layout=L3 fields=[0, 1, 2]
    v4 = FinishObject v3
    Return v4
}
function f5 name="spreadOfSameLayout" parameters=[{type=anything predicted=L3}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything ~ L3, v1: anything):
    v2 = NewObject layout=L3
    CopyDataProperties v2, v0
    PropDefine v2, v1 key="a"
    v5 = FinishObject v2
    Return v5
}
