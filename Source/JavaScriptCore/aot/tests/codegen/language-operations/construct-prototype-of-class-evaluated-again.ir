# An allocation under the prototype of the class object at hand: where new.target is a function of the program its prototype property is read by name through the caches, with the operation on the rare side. With an unknown new.target, which may be a proxy, only the operation reads it
# FORM: AsRead
# OPTIONS: heat=OnlyLoopsAreHot disable=pass:InlineCalls check=validate-back-end
# RUN: generate-code calls
# CHECK-LABEL: f2: size=
# CHECK-NOT: stub GetById
# CHECK: operation operationAOTGetConstructPrototype x1
# CHECK-NEXT: operation operationAOTSetConstructPrototype x1
# CHECK-NOT: stub GetById
# CHECK-LABEL: f3: size=
# CHECK: operation operationAOTGetConstructPrototype x1
# CHECK-NEXT: operation operationAOTSetConstructPrototype x1
# CHECK: stub GetById
# CHECK-LABEL: f4: size=

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="InFunction" constructor=f2 fields=[{key="x" declared={type=anything}}]
layout L1 kind=Instance name="Other" constructor=f6 fields=[{key="y" declared={type=anything}}]
variable g0 name="kept" module=m0 declared={type=anything} initialization=Uninitialized
variable g1 name="FirstClass" module=m0 declared={type=anything} initialization=Uninitialized
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = CallDirect function=f1
    v1 = CallDirect function=f1
    PutModuleVariable v0 variable=g1
    PutModuleVariable v1 variable=g1
    v4 = Builtin builtin=GlobalThis
    v5 = NewClosure function=f3
    v6 = NewClosure function=f4
    v7 = NewClosure function=f6
    v8 = NewClass v7 layout=L1
    v9 = FinishClass v8 layout=L1
    v10 = NewClosure function=f5
    v11 = PropGet v4 key="publish" [isFreeName]
    v12 = Call v11, -, v5, v6, v9, v10
    Return
}
function f1 name="makeClass" results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f2
    v1 = NewClass v0 layout=L0
    v2 = FinishClass v1 layout=L0
    Return v2
}
function f2 name="InFunction" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0 fields=[]
    PropSet v3, v1 key="x" mode=Strict
    Return v3
}
function f3 name="constructInLoop" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    LoopHint
    v2 = GetModuleVariable variable=g1
    v3 = Construct v2, -, v0
    PutModuleVariable v3 variable=g0
    v5 = ToBoolean v0
    Branch v5 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f4 name="constructOnce" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = GetModuleVariable variable=g1
    v2 = Construct v1, -, v0
    Return v2
}
function f5 name="readKept" results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = PropGet v0 key="x"
    Return v1
}
function f6 name="Other" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = GetConstructPrototype v0 layout=L1
    v3 = NewObject v2 layout=L1 fields=[]
    PropSet v3, v1 key="y" mode=Strict
    Return v3
}
