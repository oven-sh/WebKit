# An object that the function has allocated, and that nothing but its own stores by slot has touched since, holds what the allocation and those stores put there:
# a store that creates fields writes the order word that follows and asks nothing, across tests that stand between, and two ways that each allocate may meet in front of it.
# What has been handed to other code, or comes in from outside, is asked as ever
# FORM: Selected
# OPTIONS: heat=EverythingIsHot
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"
layout L0 kind=Instance name="Counter" constructor=f0 fields=[{key="a" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="b" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L0] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
function f0 name="Counter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] constructedClass=L0
function f1 name="new-object" parameters=[{type=number}] results=[{type=anything}] {
  b0(v0: number):
    v1 = NewObject layout=L0
    PutSlotOrAdd v1, -, v0 key="a" receivers=[L0] level=Proven
    PutSlotOrAdd v1, -, v0 key="b" receivers=[L0] level=Proven
    Return v1
}
function f2 name="run-behind-a-test" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = NewObject layout=L0
    v3 = TypeTest v1 testedType=number
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    PutSlots v2, -, v0, v0 placedKeys=[{key="a" level=Proven mayAdd=true}, {key="b" level=Proven mayAdd=true}] receivers=[L0]
    Return v2
  b2():
    Return v2
}
function f3 name="handed-out-first" parameters=[{type=number}, {type=anything}] results=[{type=anything}] {
  b0(v0: number, v1: anything):
    v2 = NewObject layout=L0
    v3 = Call v1, -, v2
    PutSlots v2, -, v0, v0 placedKeys=[{key="a" level=Proven mayAdd=true}, {key="b" level=Proven mayAdd=true}] receivers=[L0]
    Return v2
}
# CHECK: f1: size=
# CHECK-NOT: stub DidCreateField
# CHECK: f2: size=
# CHECK-NOT: stub DidCreateField
# CHECK: f3: size=
# CHECK: stub DidCreateFieldAtPlace.Run x1
