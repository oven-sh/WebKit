# An array literal without a profile has code when every inline allocation takes its slow path
# FORM: Placed
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end testing=ForceGCSlowPaths
# RUN: generate-code
# CHECK-COUNT-9: : size=
# CHECK-NOT: no code
# RUN(S): code-shapes

# S: f0 b0 Balanced
# S: f0 b1 Fast
# S: f0 b3 Compact
# S: f1 b0 Balanced
# S: f1 b1 Fast
# S: f1 b3 Compact
# S: f2 b0 Balanced
# S: f2 b1 Fast
# S: f2 b3 Compact
# S: f3 b0 Balanced
# S: f3 b1 Fast
# S: f3 b3 Compact
# S: f4 b0 Balanced
# S: f4 b1 Fast
# S: f4 b3 Compact
# S: f5 b0 Balanced
# S: f5 b1 Fast
# S: f5 b3 Compact
# S: f6 b0 Balanced
# S: f6 b1 Fast
# S: f6 b3 Compact
# S: f7 b0 Balanced
# S: f7 b1 Fast
# S: f7 b3 Compact
# S: f8 b0 Balanced
# S: f8 b1 Fast
# S: f8 b3 Compact
# PROGRAM-OF: array-literals-fresh.ir
