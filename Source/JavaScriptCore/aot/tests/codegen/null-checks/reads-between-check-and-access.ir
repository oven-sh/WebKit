# Between a null check and the access that faults for it may stand a read through a pointer that may be read anywhere: a parameter, the result of a call. One of several results of a call is zero when the returned variant does not have that part, and a pointer that was itself read from memory holds only behind its guards: a read through either may fault, so the check stays in front of it
# FORM: Selected
# OPTIONS: heat=everything-is-hot check=validate-back-end
# RUN: generate-code NullChecksFoldedIntoAccesses
# CHECK: statistic NullChecksFoldedIntoAccesses 2

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="next" declared={type=null|L0} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="value" declared={type=number} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="count" declared={type=i32} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L0] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
layout L1 name="Holder" fields=[{key="node" declared={type=L0} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L1] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
function f0 name="allocate" parameters=[{type=number}, {type=i32}] results=[{type=L0}] {
  b0(v0: number, v1: i32):
    v2 = Null
    v3 = NewObject -, v2, v0, v1 layout=L0 fields=[0, 1, 2]
    Return v3
}
function f1 name="allocateOrCount" parameters=[{type=number}, {type=i32}, {type=boolean}] results=[{type=L0}, {type=i32}] {
  b0(v0: number, v1: i32, v2: boolean):
    Branch v2 -> taken b1(), notTaken b2()
  b1():
    v3 = Null
    v4 = NewObject -, v3, v0, v1 layout=L0 fields=[0, 1, 2]
    v5 = Results v4, v1
    Return v5
  b2():
    v6 = Unspecified valueType=L0
    v7 = Results v6, v1
    Return v7
}
function f2 name="readsParameterBetween" parameters=[{type=null|L0}, {type=L0}] results=[{type=undefined}] {
  b0(v0: null|L0, v1: L0):
    v2 = RequireObjectCoercible v0 name="value"
    v3 = GetSlot v1 key="value" receivers=[L0] level=Proven
    PutSlot v2, -, v3 key="value" receivers=[L0] level=Proven
    Return
}
function f3 name="readsResultBetween" parameters=[{type=null|L0}, {type=number}, {type=i32}] results=[{type=undefined}] {
  b0(v0: null|L0, v1: number, v2: i32):
    v3 = CallDirect v1, v2 function=f0
    v4 = RequireObjectCoercible v0 name="value"
    v5 = GetSlot v3 key="value" receivers=[L0] level=Proven
    PutSlot v4, -, v5 key="value" receivers=[L0] level=Proven
    Return
}
function f4 name="readsOneOfTwoResultsBetween" parameters=[{type=null|L0}, {type=number}, {type=i32}, {type=boolean}] results=[{type=undefined}] {
  b0(v0: null|L0, v1: number, v2: i32, v3: boolean):
    v4 = CallDirect v1, v2, v3 function=f1
    v5 = ResultAt v4
    Branch v3 -> taken b1(), notTaken b2()
  b1():
    v6 = RequireObjectCoercible v0 name="value"
    v7 = GetSlot v5 key="value" receivers=[L0] level=Proven
    PutSlot v6, -, v7 key="value" receivers=[L0] level=Proven
    Return
  b2():
    Return
}
function f5 name="readsLoadedPointerBetween" parameters=[{type=null|L0}, {type=L1}] results=[{type=undefined}] {
  b0(v0: null|L0, v1: L1):
    v2 = GetSlot v1 key="node" receivers=[L1] level=Proven
    v3 = RequireObjectCoercible v0 name="value"
    v4 = GetSlot v2 key="value" receivers=[L0] level=Proven
    PutSlot v3, -, v4 key="value" receivers=[L0] level=Proven
    Return
}
