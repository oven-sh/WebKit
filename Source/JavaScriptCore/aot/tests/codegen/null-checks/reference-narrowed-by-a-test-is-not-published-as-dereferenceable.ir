# const next = node.next; for (..) if (next !== null) sum += next.count
# The reference that the edge of a test has narrowed is a block parameter, a Phi with one source. B3 folds that away, and the address decoded from it is then computed from the word as it was read,
# wherever that is at hand. Were the address published as dereferenceable, the read of `count` would no longer depend on the test: it might be moved in front of the loop, where the word may say null.
# The same holds of a parameter that such a reference is handed on to. Published are what the caller hands over as a Node (7) and the parameters themselves (4): a Phi stays in its block, and what is known
# of it goes with it when it is folded. Not published is the address made from the narrowed reference that is kept in the form in which it was read: with it the count was 12.
# FORM: Selected
# OPTIONS: heat=everything-is-hot check=validate-back-end
# RUN: generate-code ReferencesPublishedAsDereferenceable
# CHECK: statistic ReferencesPublishedAsDereferenceable 11

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="next" declared={type=null|L0} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="count" declared={type=i32} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L0] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
function f0 name="narrowedInTheLoop" parameters=[{type=L0}, {type=i32}] results=[{type=i32}] {
  b0(v0: L0, v1: i32):
    v2 = GetSlot v0 key="next" receivers=[L0] level=Proven
    v3 = Integer integer=0
    Jump -> next b1(v3, v3)
  b1(v4: i32, v5: i32):
    LoopHint
    v7 = Less v4, v1 form=Integers
    TestAndBranch v7 -> taken b2(), notTaken b5()
  b2():
    v8 = TypeTest v2 testedType=L0
    TestAndBranch v8 -> taken b3(| 0), notTaken b4(v5)
  b3(v9: L0):
    v10 = GetSlot v9 key="count" receivers=[L0] level=Proven
    v11 = BitXor v5, v10 form=Numbers
    Jump -> next b4(v11)
  b4(v12: i32):
    v13 = BitXor v4, v12 form=Numbers
    Jump -> next b1(v13, v12)
  b5():
    Return v5
}
function f1 name="handedOnBehindTheTest" parameters=[{type=L0}] results=[{type=i32}] {
  b0(v0: L0):
    v1 = GetSlot v0 key="next" receivers=[L0] level=Proven
    v2 = TypeTest v1 testedType=L0
    TestAndBranch v2 -> taken b1(| 0), notTaken b3()
  b1(v3: L0):
    Jump -> next b2(v3)
  b2(v4: L0):
    v5 = GetSlot v4 key="count" receivers=[L0] level=Proven
    Return v5
  b3():
    v6 = Integer integer=0
    Return v6
}
function f2 name="onlyWhatTheCallerHandsOver" parameters=[{type=L0}, {type=L0}, {type=i32}] results=[{type=i32}] {
  b0(v0: L0, v1: L0, v2: i32):
    v3 = Less v2, v2 form=Integers
    TestAndBranch v3 -> taken b1(v0), notTaken b1(v1)
  b1(v4: L0):
    v5 = GetSlot v4 key="count" receivers=[L0] level=Proven
    Return v5
}
function f3 name="keptAsItWasRead" parameters=[{type=L0}, {type=L0}] results=[{type=i32}] {
  b0(v0: L0, v1: L0):
    v2 = GetSlot v0 key="next" receivers=[L0] level=Proven
    v3 = TypeTest v2 testedType=L0
    TestAndBranch v3 -> taken b1(| 0), notTaken b2()
  b1(v4: L0):
    PutSlot v1, -, v4 key="next" receivers=[L0] level=Proven
    v6 = GetSlot v4 key="count" receivers=[L0] level=Proven
    Return v6
  b2():
    v7 = Integer integer=0
    Return v7
}
function f4 name="keptAsAnyValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=L0
    TestAndBranch v1 -> taken b1(| 0), notTaken b2()
  b1(v2: L0):
    v3 = GetSlot v2 key="count" receivers=[L0] level=Proven
    PutSlot v2, -, v3 key="count" receivers=[L0] level=Proven
    v5 = Upcast v2 castType=anything
    Return v5
  b2():
    Return v0
}
