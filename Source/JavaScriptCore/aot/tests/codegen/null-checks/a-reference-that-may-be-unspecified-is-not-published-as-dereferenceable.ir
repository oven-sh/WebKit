# A word that may be anything takes the form of the rest of its type: here a reference. Nothing is published of it, in whichever way it comes to that form: as the parameter of a block, as one of two
# results of a call or the only one, as the word of a variable that is read ahead of its store, and as that word handed around a loop. Published is what the callers hand over as a Node (2) and the objects that are made (2).
# FORM: Selected
# OPTIONS: heat=everything-is-hot check=validate-back-end
# RUN: generate-code ReferencesPublishedAsDereferenceable
# CHECK: statistic ReferencesPublishedAsDereferenceable 4

module m0 path="main.js" displayPath="main.js"
layout L0 name="Node" fields=[{key="next" declared={type=null|L0} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}, {key="count" declared={type=i32} flags=[IsRequired] flow={occupancy=AlwaysFilled stability=[IsNeverDeleted, IsNeverRedefined, IsNeverStoredWithOtherType]}}] flow={baseState=None members=[L0] impossibleMutations=[AddProperty, ChangeIntegrity, ChangePrototype]}
variable g0 name="node" declared={type=L0} flow={writers=AllKnown storeNaming=EveryStoreNamesLocation initialization=StoredBeforeEveryRead}

function f0 name="parameterOfABlock" parameters=[{type=boolean}, {type=L0}] results=[{type=i32}] {
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    Jump -> next b3(v1)
  b2():
    v2 = Unspecified valueType=L0
    Jump -> next b3(v2)
  b3(v3: unspecified|L0):
    Branch v0 -> taken b4(), notTaken b5()
  b4():
    v4 = Specified
    v5 = AssumeType v3, v4 provenType=L0
    v6 = GetSlot v5 key="count" receivers=[L0] level=Proven
    Return v6
  b5():
    v7 = Integer integer=0
    Return v7
}
function f1 name="makesOrCounts" parameters=[{type=i32}, {type=boolean}] results=[{type=unspecified|L0}, {type=i32}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Null
    v3 = NewObject -, v2, v0 layout=L0 fields=[0, 1]
    v4 = Results v3, v0
    Return v4
  b2():
    v5 = Unspecified valueType=L0
    v6 = Results v5, v0
    Return v6
}
function f2 name="oneOfTwoResults" parameters=[{type=i32}, {type=boolean}] results=[{type=i32}] {
    v2 = CallDirect v0, v1 function=f1
    v3 = ResultAt v2
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v4 = Specified
    v5 = AssumeType v3, v4 provenType=L0
    v6 = GetSlot v5 key="count" receivers=[L0] level=Proven
    Return v6
  b2():
    Return v0
}
function f3 name="variableReadAheadOfItsStore" parameters=[{type=boolean}, {type=i32}] results=[{type=i32}] {
    v2 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v3 = Entered function=f3
    v4 = AssumeType v2, v3 provenType=L0
    v5 = GetSlot v4 key="count" receivers=[L0] level=Proven
    Return v5
  b2():
    Return v1
}
function f4 name="handedAroundALoop" parameters=[{type=L0}, {type=i32}] results=[{type=i32}] {
    v2 = GetModuleVariable variable=g0 [mayPrecedeItsStore]
    v3 = Integer integer=0
    Jump -> next b1(v2, v3)
  b1(v4: unspecified|L0, v5: i32):
    LoopHint
    v7 = Less v5, v1 form=Integers
    TestAndBranch v7 -> taken b2(), notTaken b3()
  b2():
    v8 = Entered function=f4
    v9 = AssumeType v4, v8 provenType=L0
    v10 = GetSlot v9 key="count" receivers=[L0] level=Proven
    v11 = BitXor v5, v10 form=Numbers
    Jump -> next b1(v4, v11)
  b3():
    v12 = GetSlot v0 key="count" receivers=[L0] level=Proven
    Return v12
}
function f5 name="makesOrNot" parameters=[{type=i32}, {type=boolean}] results=[{type=unspecified|L0}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Null
    v3 = NewObject -, v2, v0 layout=L0 fields=[0, 1]
    Return v3
  b2():
    v4 = Unspecified valueType=L0
    Return v4
}
function f6 name="theOnlyResult" parameters=[{type=i32}, {type=boolean}] results=[{type=i32}] {
    v2 = CallDirect v0, v1 function=f5
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = Specified
    v4 = AssumeType v2, v3 provenType=L0
    v5 = GetSlot v4 key="count" receivers=[L0] level=Proven
    Return v5
  b2():
    Return v0
}
