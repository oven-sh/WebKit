# The test for undefined of a variable that holds undefined as zero compares the stored word with zero: the same code as the test for `absent` of a variable in its dead zone. The test for undefined or null is one comparison too: zero and null are the two smallest words
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: generate-code
# RUN(X64): generate-code
# REQUIRES(X64): x86_64
# RUN(SLOTS): plan-slots variables
# SLOTS: g0 Statics UndefinedAsZero JSValue
# SLOTS-NEXT: g1 Statics Plain JSValue
# SLOTS-NEXT: g2 Statics UndefinedAsZero JSValue

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Range" fields=[{key="pos" declared={type=number}}]
variable g0 name="encoded" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="mayBeInDeadZone" module=m0 declared={type=anything|absent}
variable g2 name="encodedOrNull" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = Call v1, -, v2, v3, v4, v5
    Return
}
function f1 name="testsEncodedVariable" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = TypeTest v0 testedType=undefined
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# CHECK: f1: size=[[sizeOfTestForZero]] frame=
function f2 name="testsVariableInDeadZone" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = TypeTest v0 testedType=absent
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# CHECK-NEXT: f2: size=[[sizeOfTestForZero]] frame=
function f3 name="testsEncodedVariableForUndefinedOrNull" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g2
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# CHECK-NEXT: f3: size=
# X64: f1: size=[[sizeOfTestForZero]] frame=
# X64: f3: size=[[sizeOfTestForZero]] frame=
function f4 name="stores" parameters=[{type=number}, {type=boolean}, {type=boolean}] results=[{type=anything}] {
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v3 = NewObject -, v0 layout=L0 fields=[0]
    v4 = FinishObject v3
    PutModuleVariable v4 variable=g0
    PutModuleVariable v4 variable=g1
    PutModuleVariable v4 variable=g2
    Return
  b2():
    v8 = Undefined
    PutModuleVariable v8 variable=g0
    PutModuleVariable v8 variable=g2
    Branch v2 -> taken b3(), notTaken b4()
  b3():
    v11 = Null
    PutModuleVariable v11 variable=g2
    Return
  b4():
    Return
}
