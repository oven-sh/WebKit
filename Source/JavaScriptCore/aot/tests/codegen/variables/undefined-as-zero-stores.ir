# A store into a variable that holds undefined as zero encodes the value only where its type has undefined: a stored object costs what it costs in a plain variable
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot only-passes=AnalyzeFlow
# RUN: generate-code
# RUN(SLOTS): plan-slots variables
# SLOTS: g0 Statics UndefinedAsZero JSValue
# SLOTS-NEXT: g1 Statics Plain JSValue

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Range" fields=[{key="pos" declared={type=number}}]
variable g0 name="encoded" module=m0 declared={type=anything} initialization=Undefined
variable g1 name="plain" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="publish" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = NewClosure function=f5
    v7 = Call v1, -, v2, v3, v4, v5, v6
    Return
}
function f1 name="storesObjectInPlainVariable" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g1
    Return
}
# CHECK: f1: size=[[sizeOfPlainStore]] frame=
function f2 name="storesObjectInEncodedVariable" parameters=[{type=number}] results=[{type=anything}] {
    v1 = NewObject -, v0 layout=L0 fields=[0]
    v2 = FinishObject v1
    PutModuleVariable v2 variable=g0
    Return
}
# CHECK-NEXT: f2: size=[[sizeOfPlainStore]] frame=
function f3 name="storesObjectOrUndefinedInEncodedVariable" parameters=[{type=number}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g1
    PutModuleVariable v1 variable=g0
    Return
}
function f4 name="testsEncodedVariable" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g0
    v1 = Undefined
    v2 = StrictEq v0, v1
    Return v2
}
function f5 name="copiesPlainVariable" parameters=[{type=number}] results=[{type=anything}] {
    v1 = GetModuleVariable variable=g1
    PutModuleVariable v1 variable=g1
    Return
}
# CHECK-NEXT: f3: size=[[sizeOfEncodingStore]] frame=
# CHECK-NOT: f5: size=[[sizeOfEncodingStore]] frame=
# CHECK: f7: size=
