# Module variables, free names, environment fields and static fields pass the back-end checks in fast code
# RUN: compile
# OPTIONS: heat=everything-is-hot check=validate-back-end only-passes=EstimateHeat,ResolveAccesses
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Environment fields=[{key="count" declared={type=anything|absent}}, {key="label" declared={type=anything}}]
layout L1 name="Scope"
layout L2 kind=Environment fields=[{key="self" declared={type=anything|absent}}]
layout L3 kind=Instance name="Counter" constructor=f9 staticFields=[{key="count" variable=g4}]
variable g0 name="early" module=m0 declared={type=anything|absent} initialization=Uninitialized
variable g1 name="late" module=m0 declared={type=anything} initialization=Undefined
variable g2 name="total" module=m0 declared={type=number|absent} initialization=Uninitialized
variable g3 name="Counter" module=m0 declared={type=function|absent} initialization=Uninitialized
variable g4 module=m0 declared={type=number} initialization=Uninitialized owner=L3

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f5
    v4 = NewClosure function=f6
    v5 = NewClosure function=f8
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="register" [isFreeName]
    v8 = Call v7, -, v0, v1, v2, v3, v4, v5
    v9 = Double number=1.5
    PutModuleVariable v9 variable=g2
    PutModuleVariable v8 variable=g0
    v12 = NewClosure function=f9
    v13 = NewClass v12 layout=L3
    v14 = FinishClass v13 layout=L3
    PutModuleVariable v9 variable=g4
    PutModuleVariable v14 variable=g3
    Jump -> next b1()
  b1():
    LoopHint
    v18 = CallDirect function=f10
    v19 = CallDirect function=f11
    v20 = Call v7, -, v18
    v21 = ToBoolean v20
    Branch v21 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="moduleVariables" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    PutModuleVariable v0 variable=g1
    v2 = GetModuleVariable variable=g2
    v3 = CheckInitialized v2 name="total"
    v4 = Add v3, v3
    PutModuleVariable v4 variable=g2
    v6 = GetModuleVariable variable=g0
    v7 = CheckInitialized v6 name="early"
    Return v7
}
function f2 name="freeNames" results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="counter" [isFreeName]
    v2 = PropGet v0 key="missing" [isFreeName, isForTypeOf]
    PropSet v0, v1 key="counter" mode=Sloppy [isFreeName]
    PropSet v0, v2 key="counter" [isFreeName]
    v5 = PropDelete v0 key="counter" mode=Sloppy [isFreeName]
    Return v5
}
function f3 name="environmentFields" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = Absent
    v2 = NewObject -, v1, v0 layout=L0 fields=[0, 1]
    v3 = NewClosure v2 function=f4
    v4 = Call v3
    PutEnvironmentField v2, v0 layout=L0 field=0
    Return v3
}
function f4 name="closure" captures=[{type=env L0}] results=[{type=anything}] {
  b0(v0: env L0):
    v1 = GetEnvironmentField v0 layout=L0 field=1
    PutEnvironmentField v0, v1 layout=L0 field=1
    v3 = GetEnvironmentField v0 layout=L0 field=0
    v4 = CheckInitialized v3 name="count"
    Return v4
}
function f5 name="scopeObject" parameters=[{type=anything}] results=[{type=anything}] {
    v1 = NewObject layout=L1 fields=[]
    v2 = FinishObject v1
    v3 = ScopeHasBinding v2 key="counter"
    Return v3
}
function f6 name="deadZoneTestsUnderHandler" results=[{type=anything}] {
  b0() handler=b3():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="early"
    Jump -> next b1()
  b1() handler=b3():
    v2 = GetModuleVariable variable=g2
    v3 = CheckInitialized v2 name="total"
    PutModuleVariable v3 variable=g2
    Jump -> next b2()
  b2():
    Return v1
  b3() role=CatchHandler:
    v5 = CatchValue
    Return v5
}
function f7 name="readsOwnClosure" captures=[{type=env L2}] results=[{type=anything}] {
  b0(v0: env L2):
    v1 = GetEnvironmentField v0 layout=L2 field=0
    v2 = CheckInitialized v1 name="self"
    Return v2
}
function f8 name="storesClosureInOwnEnvironment" results=[{type=anything}] {
    v0 = Absent
    v1 = NewObject -, v0 layout=L2 fields=[0]
    v2 = NewClosure v1 function=f7
    PutEnvironmentField v1, v2 layout=L2 field=0
    Return v2
}
function f9 name="Counter" kind=BaseConstructor flags=[HasNewTarget] results=[{type=anything}] {
    v1 = GetConstructPrototype v0 layout=L3
    v2 = NewObject v1 layout=L3
    Return v2
}
function f10 name="readStaticField" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="Counter"
    v2 = PropGet v1 key="count"
    Return v2
}
function f11 name="storeStaticField" results=[{type=anything}] {
    v0 = GetModuleVariable variable=g3
    v1 = CheckInitialized v0 name="Counter"
    v2 = Double number=2
    PropSet v1, v2 key="count" mode=Strict
    Return
}
