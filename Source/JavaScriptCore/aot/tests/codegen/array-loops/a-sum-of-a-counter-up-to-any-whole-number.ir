# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# The counter may come near the greatest int32. The end of a stretch is taken only where it lies nearer than the bound, so the sum is kept as an integer all the same, and eight turns are written out.
# CHECK-LABEL: steps by 8
# CHECK-NOT: IToD
# CHECK-NOT: Double
# CHECK-LABEL: end of loop

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=13 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=174 kind=CallResult
typesite w3 module=m0 position=44 kind=Variable
typesite w4 module=m0 position=66 kind=Variable
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="sum"
    v12 = Convert v11 declared={type=number site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="sum" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number site=w3}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w4}
    Jump -> next b2(v2, v4)
  b2(v5: number, v6: number):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b3(| 0, 1), notTaken b6(| 0, 1)
  b3(v9, v10):
    Jump -> next b4()
  b4():
    v11 = Add v5, v9
    v12 = Convert v11 declared={type=number site=w3}
    Jump -> next b5()
  b5():
    v13 = Increment v9
    v14 = Convert v13 declared={type=number site=w4}
    Jump -> next b2(v12, v14)
  b6(v15, v16):
