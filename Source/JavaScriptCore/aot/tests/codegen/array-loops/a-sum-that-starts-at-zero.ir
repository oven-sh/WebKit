# function sum(text: string): number {
#   let total = 0;
#   for (let k = 0; k < text.length; k++) total += text.charCodeAt(k);
#   return total;
# }
# declare const input: any;
# (globalThis as any).answer = sum(String(input));
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# The sum starts at a whole number that the build knows, so nothing tests it on the way to the turns that are written out. Each later stretch tests what the sum has become.
# CHECK-LABEL: name="sum" role=Source
# CHECK-NOT: Double b@{{*}} = Sub(
# CHECK: Load8Z(
# CHECK: Double b@{{*}} = Sub(
# CHECK-LABEL: end of function

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=13 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=200 kind=CallResult
typesite w3 module=m0 position=196 kind=CallResult
typesite w4 module=m0 position=43 kind=Variable
typesite w5 module=m0 position=65 kind=Variable
typesite w6 module=m0 position=76 kind=PropertyRead
typesite w7 module=m0 position=103 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=String
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Call v6, -, v8 calleeName="String"
    v10 = Convert v9 declared={type=undefined|null|string site=w2 flags=[OmitsNull, OmitsUndefined]} illTypedCause=DeclarationWithoutBody
    v11 = Call v1, -, v10 calleeName="sum"
    v12 = Convert v11 declared={type=number site=w3}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="sum" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|string site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|string):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = Convert v1 declared={type=number site=w4}
    v3 = Integer
    v4 = Convert v3 declared={type=number site=w5}
    Jump -> next b2(v2, v4)
  b2(v5: number, v6: number):
    LoopHint
    v8 = PropGet v0 key="length"
    v9 = Convert v8 declared={type=number site=w6} illTypedCause=Assertion
    v10 = Less v6, v9
    Branch v10 -> taken b3(| 0), notTaken b6(| 0)
  b3(v11):
    Jump -> next b4()
  b4():
    v12 = PropGet v0 key="charCodeAt"
    v13 = Call v12, v0, v11 calleeKey="charCodeAt" calleeName="text.charCodeAt"
    v14 = Convert v13 declared={type=number site=w7} illTypedCause=DeclarationWithoutBody
    v15 = Add v5, v14
    v16 = Convert v15 declared={type=number site=w4}
    Jump -> next b5()
  b5():
    v17 = Increment v11
    v18 = Convert v17 declared={type=number site=w5}
    Jump -> next b2(v16, v18)
  b6(v19):
    Jump -> next b7()
  b7():
    v20 = Convert v5 declared={type=number site=w1}
    Return v20
}
