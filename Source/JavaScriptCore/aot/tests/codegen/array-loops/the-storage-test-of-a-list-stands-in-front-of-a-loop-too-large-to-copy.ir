    v8 = Builtin builtin=GlobalThis @263
    v9 = PropGet v8 key="input" [isFreeName] @263
    v10 = Call v7, v5, v9 calleeKey="parse" calleeName="JSON.parse" @252
    v11 = Convert v10 declared={type=undefined|null|Array<undefined|null|number|string|symbol|bigint|L0> flags=[IsExpected]} @247
    v12 = Call v1, -, v11 calleeName="sizes" @241
    v13 = Convert v12 declared={type=number flags=[IsExpected]} @241
    PropSet v4, v13 key="answer" @221
