# function sizes(shapes) {
#   let sum = 0;
#   for (let i = 0; i < 1024; i++) {
#     const shape = shapes[i];
#     if (shape.kind === "circle") sum += shape.radius + shape.radius;
#     else sum += shape.side;
#   }
#   return sum;
# }
# globalThis.answer = sizes(JSON.parse(input));
# `shapes[i]` asks how the list stores its elements, and a list that stores them otherwise leaves the loop. No turn of the loop writes what that test reads, so a turn that has come to the
# end of the loop has passed the test and the next one will. The test stands with the test of `i` in front of the loop and is not asked on the way back, and the storage and the length of
# the list, which are read behind it, are read in front of the loop too. The loop is too large to get a fast copy, and needs none for this.
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# CHECK-LABEL: name="sizes" role=Source
# CHECK-LABEL: steps by 1
# CHECK-NOT: = Branch({{*}}:HasArrayStorage)
# CHECK-NOT: Reads:JSArray_butterfly
# CHECK-NOT: Reads:Butterfly_publicLength
# CHECK: :GetArrayElement)
# CHECK-NOT: = Branch({{*}}:HasArrayStorage)
# CHECK-NOT: Reads:JSArray_butterfly
# CHECK-NOT: Reads:Butterfly_publicLength
# CHECK-LABEL: end of loop

layout L0 fields=[{key="kind" declared={type=anything} flags=[IsNeverWritten]}, {key="radius" declared={type=anything} flags=[IsNeverWritten]}, {key="side" declared={type=anything} flags=[IsNeverWritten]}] flags=[IsNeverAllocated]
module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
