# indexOf() with a string is one stub call that takes the array and the string in registers. The result is an integer: no boxing, no type check and no slow path around the call.
# CHECK-LABEL: name="find" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[index]] = Patchpoint(b@[[list]]:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}:CallInline)
# CHECK-NEXT: Return(b@[[index]], Terminal)
# CHECK-LABEL: end of function
# includes() compares the same result with -1.
# CHECK-LABEL: name="has" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[list]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[name]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[index]] = Patchpoint(b@[[list]]:Register({{*}}), b@[[name]]:Register({{*}}), resultConstraints = Register({{*}}:CallInline)
# CHECK-NOT: Patchpoint(
# CHECK-NOT: Branch(
# CHECK: Int32 b@[[found]] = NotEqual(b@[[index]], $-1(
# CHECK-NEXT: Return(b@[[found]], Terminal)
# CHECK-LABEL: end of function
# Both call the form of the stub for a dense array of strings. Neither calls a runtime operation or a host function.
# CALLS-LABEL: f1: size=
# CALLS-NEXT: stub ArrayIndexOfString.Strings x1
# CALLS-NEXT: f2: size=
# CALLS-NEXT: stub ArrayIndexOfString.Strings x1
# CALLS-NEXT: f3: size=
# Two moves put the operands into the stub's argument registers.
# X64-LABEL: name="find" role=Source
# X64-NEXT: instructions: 5, patchpoints: 1
# X64-LABEL: name="has" role=Source
# X64-NEXT: instructions: 6, patchpoints: 1
# ARM64-LABEL: name="find" role=Source
# ARM64-NEXT: instructions: 5, patchpoints: 1
# ARM64-LABEL: name="has" role=Source
# ARM64-NEXT: instructions: 6, patchpoints: 1
