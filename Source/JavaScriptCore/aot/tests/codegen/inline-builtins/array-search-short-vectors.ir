# `includes` and `indexOf` with a number compare the elements of a short vector of doubles or of int32 by a loop in the code. Only a vector with more elements than the limit is handed to the operation of its storage kind,
# so each search names both operations once, in rare code: a function that only searches sets no frame up at its entry, as one that always calls does, and a short vector is searched without one.
# Compact code has no loop: the same function with its search in a rare block has other code. An array of another kind takes the miss edge
# FORM: Selected
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end
# RUN: generate-code
# RUN(CALLS): generate-code calls
# RUN(S): code-shapes

module m0 path="main.js" displayPath="main.js"
function f0 name="includesInBalancedCode" parameters=[{type=Array<number, proven, pristine[Storage]>}, {type=number}, {type=boolean}] results=[{type=anything}] {
    Branch v2 -> taken b1(), notTaken b4()
  b1():
    TryCallInline v0, v1 inlineBuiltin=ArrayIncludes overload=ArrayPrototypeIncludes/0 -> done b2(), miss b3()
  b2(v3):
    Return v3
  b3() frequency=Rare:
    v4 = CallBuiltin v0, v1 overload=ArrayPrototypeIncludes/0
    Jump -> next b2(v4)
  b4():
    v5 = Undefined
    Return v5
}
