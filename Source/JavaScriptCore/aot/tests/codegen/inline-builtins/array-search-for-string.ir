# indexOf() and includes() with a string argument call the ArrayIndexOfString stub: the Strings form if every element is proven to be a string and the array is dense, the Values form otherwise.
# They do not call the host function. An argument of unknown type is tested for being a string first
# FORM: Selected
# OPTIONS: heat=OnlyLoopsAreHot check=validate-back-end
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="indexOfInStrings" parameters=[{type=Array<string, proven, Contiguous, pristine[Storage, Dense]>}, {type=string}] results=[{type=anything}] {
    v2 = CallInline v0, v1 inlineBuiltin=ArrayIndexOf overload=ArrayPrototypeIndexOf/1
    Return v2
}
# CHECK-LABEL: f0: size=
# CHECK-NOT: operation
# CHECK: stub ArrayIndexOfString.Strings x1
function f1 name="includesInStrings" parameters=[{type=Array<string, proven, Contiguous, pristine[Storage, Dense]>}, {type=string}] results=[{type=boolean}] {
    v2 = CallInline v0, v1 inlineBuiltin=ArrayIncludes overload=ArrayPrototypeIncludes/1
    Return v2
}
# CHECK-LABEL: f1: size=
# CHECK-NOT: operation
# CHECK: stub ArrayIndexOfString.Strings x1
function f2 name="indexOfInStringsAndHoles" parameters=[{type=Array<string, proven, Contiguous, pristine[Storage]>}, {type=string}] results=[{type=anything}] {
    v2 = CallInline v0, v1 inlineBuiltin=ArrayIndexOf overload=ArrayPrototypeIndexOf/1
    Return v2
}
# CHECK-LABEL: f2: size=
# CHECK-NOT: operation
# CHECK: stub ArrayIndexOfString.Values x1
function f3 name="indexOfInValues" parameters=[{type=Array<anything, pristine[Storage]>}, {type=string}] results=[{type=anything}] {
    v2 = CallInline v0, v1 inlineBuiltin=ArrayIndexOf overload=ArrayPrototypeIndexOf/1
    Return v2
}
# CHECK-LABEL: f3: size=
# CHECK-NOT: operation
# CHECK: stub ArrayIndexOfString.Values x1
function f4 name="indexOfAnything" parameters=[{type=Array<anything, proven, pristine[Storage]>}, {type=anything}] results=[{type=anything}] {
    TryCallInline v0, v1 inlineBuiltin=ArrayIndexOf overload=ArrayPrototypeIndexOf/1 -> done b1(), miss b2()
  b1(v2):
    Return v2
  b2() frequency=Rare:
    v3 = CallBuiltin v0, v1 overload=ArrayPrototypeIndexOf/1
    Jump -> next b1(v3)
}
# CHECK-LABEL: f4: size=
# CHECK: stub ArrayIndexOfString.Values x1
