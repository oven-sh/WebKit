# The inline code of Object.setPrototypeOf and Reflect.setPrototypeOf stores the Structure that the same change led to before, with the call of the function on the miss edge
# FORM: Selected
# OPTIONS: check=validate-back-end
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"
function f0 name="objectSetPrototypeOf" parameters=[{type=object}, {type=null|object}] results=[{type=object}] {
    TryCallInline -, v0, v1 inlineBuiltin=SetPrototypeOf inlineParameters=[0] overload=ObjectSetPrototypeOf/0 -> done b1(), miss b2()
  b1(v2: object):
    Return v2
  b2() frequency=Rare:
    v3 = CallBuiltin -, v0, v1 overload=ObjectSetPrototypeOf/0
    Jump -> next b1(v3)
}
# CHECK-LABEL: f0: size=
# CHECK-NOT: operation
# CHECK: stub CallHostFunction.n2 x1
# CHECK: stub WriteBarrier{{*}} x1
function f1 name="reflectSetPrototypeOf" parameters=[{type=object}, {type=null|object}] results=[{type=boolean}] {
    TryCallInline -, v0, v1 inlineBuiltin=SetPrototypeOf inlineParameters=[1] overload=ReflectSetPrototypeOf/0 -> done b1(), miss b2()
  b1(v2: boolean):
    Return v2
  b2() frequency=Rare:
    v3 = CallBuiltin -, v0, v1 overload=ReflectSetPrototypeOf/0
    Jump -> next b1(v3)
}
# CHECK-LABEL: f1: size=
# CHECK-NOT: operation
# CHECK: stub CallHostFunctionWithoutBoxedCall.n2 x1
# CHECK: stub WriteBarrier{{*}} x1
function f2 name="callWithoutInlineCode" parameters=[{type=object}, {type=null|object}] results=[{type=object}] {
    v2 = CallBuiltin -, v0, v1 overload=ObjectSetPrototypeOf/0
    Return v2
}
# CHECK-LABEL: f2: size=
