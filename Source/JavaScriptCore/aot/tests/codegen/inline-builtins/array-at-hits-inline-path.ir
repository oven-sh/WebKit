# Array.prototype.at() on an array with Int32, Double or Contiguous storage, copy-on-write or not, is answered by the inline code.
# The slow path calls the compiled library function, which is a stand-in here and returns undefined, so a miss prints undefined
# FORM: AsRead
# RUN(SELECTED): pipeline Select
# RUN: run-in-shell globalThis.publish = (numberAt, stringAt) => { const grown = []; grown.push(10, 20, 30); print(numberAt([10, 20, 30], 1)); print(numberAt(grown, -1)); print(numberAt([1.5, 2.5], 0)); print(stringAt(["a", "b"], 1)); print(numberAt(grown, 3)); };
# SELECTED: TryCallInline {{*}} overload=ArrayPrototypeAt/
# CHECK: 20
# CHECK-NEXT: 30
# CHECK-NEXT: 1.5
# CHECK-NEXT: b
# CHECK-NEXT: undefined
# CHECK-NEXT: exited with 0

