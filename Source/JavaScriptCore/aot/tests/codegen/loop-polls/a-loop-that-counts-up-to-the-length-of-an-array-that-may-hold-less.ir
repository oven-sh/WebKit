# The length of an array may be set to billions while the array holds three elements, and a view may hold billions. What a loop counts up to says nothing about how soon it ends.
# The loop of f1 polls on every turn. The turns of the likely loop of f2 are counted in front of it: it goes without a poll where they are few.
# FORM: AsRead
# f4 is the typed body of f1: one loop. f5 is that of f2: one poll is that of the rare copy, which reads `length` by name, the others stand where the likely loop has too many turns in front of it.
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls disable=b3:RotateLoops
# REQUIRES: x86_64 faulting-loop-polls
# RUN: generate-code
# CHECK: f4: size={{*}} polls=1
# CHECK: f5: size={{*}} polls=3

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
typesite w1 module=m0 position=110 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    v3 = CallDirect v1 function=f2
    v4 = Add v2, v3
    Return v4
}
function f1 name="countsUpToTheLengthOfAnArray" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=Array<number> site=w0}] results=[{type=anything}] {
    v1 = Integer integer=0
    Jump -> next b1(v1, v1)
  b1(v2, v3):
    LoopHint
    v5 = PropGet v0 key="length"
    v6 = Less v2, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = BitXor v3, v2
    v8 = Increment v2
    Jump -> next b1(v8, v7)
  b3():
    Return v3
}
function f2 name="countsUpToTheLengthOfAView" module=m0 position=105 flags=[IsChecked] length=1 parameters=[{type=Uint8Array site=w1}] results=[{type=anything}] {
    v1 = Integer integer=0
    Jump -> next b1(v1, v1)
  b1(v2, v3):
    LoopHint
    v5 = PropGet v0 key="length"
    v6 = Less v2, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = BitXor v3, v2
    v8 = Increment v2
    Jump -> next b1(v8, v7)
  b3():
    Return v3
}
