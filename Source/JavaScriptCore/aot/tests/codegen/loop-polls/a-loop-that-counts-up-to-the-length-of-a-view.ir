# The length of a typed array comes out of an inline read that may miss, so what the counter is compared with is a block parameter. It is a length of data all the same: the likely loop has no poll.
# FORM: AsRead
# f3 is the typed body of f1: its one poll is that of the rare copy, which reads `length` by name.
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls disable=b3:RotateLoops
# RUN: generate-code
# CHECK: f3: size={{*}} polls=1

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=10 kind=Parameter
function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = CallDirect v1 function=f1
    Return v2
}
function f1 name="walksAView" module=m0 position=5 flags=[IsChecked] length=1 parameters=[{type=Uint8Array site=w0}] results=[{type=anything}] {
  b0(v0: Uint8Array):
    v1 = Integer integer=0
    Jump -> next b1(v1, v1)
  b1(v2, v3):
    LoopHint
    v5 = PropGet v0 key="length"
    v6 = Less v2, v5
    Branch v6 -> taken b2(), notTaken b3()
  b2():
    v7 = BitXor v3, v2
    v8 = Increment v2
    Jump -> next b1(v8, v7)
  b3():
    Return v3
}
