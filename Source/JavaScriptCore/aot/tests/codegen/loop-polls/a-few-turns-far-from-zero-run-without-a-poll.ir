# A loop goes without its poll where few enough turns lie in front of it. Where it starts at zero or above, that it ends within so many turns of zero says so without a subtraction.
# A window of a few elements far into a long text, list or view ends farther out than that: there, on a rare path, the two ends are held against each other, and the few turns run in
# the same loop as they do near zero. Only a loop with many turns in front of it runs in the copy that polls, or in more than one stretch.
#
# function mix(offset: number, width: number): number {
#   const from = offset & 0xffffff;
#   const to = from + (width & 0xffffff);
#   let hash = 17;
#   for (let i = from; i < to; i++) hash = (Math.imul(hash, 31) + i) | 0;
#   return hash;
# }
# function find(bytes: Uint8Array, offset: number, width: number): number {
#   const from = offset & 0xffffff;
#   const to = from + (width & 0xffffff);
#   for (let i = from; i < to; i++) if (bytes[i] === 10) return i;
#   return -1;
# }
# declare const input: any;
# (globalThis as any).answer = mix(input, input) + find(input, input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# RUN(WRITTEN): lower-to-b3 optimized f2

typesite w0 module=m0 position=13 kind=Parameter
typesite w1 module=m0 position=29 kind=Parameter
typesite w2 module=m0 kind=Result
