typesite w14 module=m0 position=316 kind=Variable
typesite w15 module=m0 position=350 kind=Variable
typesite w16 module=m0 position=393 kind=Variable
layout L0 fields=[{key="answer" declared={type=anything}}] flags=[IsNeverAllocated]
module m0 path="main.ts" displayPath="main.ts" body=f0
