# `mix` walks nothing, so its turns are not written out: there is the loop, and a copy of it that polls.
# CHECK-LABEL: name="mix" role=Source
# CHECK: Int32 b@[[endsNear]] = BelowEqual(b@{{*}}, $1048576(
# CHECK: Branch(b@[[endsNear]], Terminal,
# CHECK-NEXT: Successors: Then:#[[near]], Else:Rare:#[[far]]
# CHECK: BB#[[near]]:
# CHECK: Successors: #[[loop]]
# CHECK-NOT: isLoopPoll
# CHECK: BB#[[far]]:
# CHECK: Int32 b@[[isShort]] = BelowEqual(b@{{*}}, $1048576(
# CHECK: Branch(b@[[isShort]], Terminal,
# CHECK-NEXT: Successors: Then:#[[short]], Else:Rare:#[[long]]
# CHECK: BB#[[short]]:
# CHECK: Successors: #[[loop]]
# CHECK: BB#[[long]]:
# CHECK: isLoopPoll
# CHECK-LABEL: end of function

# The turns of `find` are written out eight times and run in stretches. A stretch that holds all the turns ends at the far bound, seven short of the bound.
# WRITTEN-LABEL: name="find" role=Source
# WRITTEN: Int32 b@[[farBound]] = Add(b@{{*}}, $-7(
# WRITTEN: Int32 b@[[endsFar]] = Above(b@[[farBound]], $1048576(
# WRITTEN: Branch(b@[[endsFar]], Terminal,
# WRITTEN-NEXT: Successors: Then:Rare:#[[far]], Else:#[[near]]
# WRITTEN: BB#[[near]]:
# WRITTEN: Upsilon(b@[[farBound]],
# WRITTEN: Successors: #[[begins]]
# WRITTEN: BB#[[far]]:
# WRITTEN: Int32 b@[[isLong]] = Above(b@{{*}}, $1048583(
# WRITTEN: Branch(b@[[isLong]], Terminal,
# WRITTEN-NEXT: Successors: Then:Rare:#[[long]], Else:#[[short]]
# WRITTEN: BB#[[short]]:
# WRITTEN: Upsilon(b@[[farBound]],
# WRITTEN: Successors: #[[begins]]
# WRITTEN-LABEL: end of function
