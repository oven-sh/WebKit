# -- source: main.js
# function addUp(sums, values, place) {
#   for (let index = 0; index < values.length; index++) sums[place] = sums[place] + values[index];
#   return sums[place];
# }
# const values = new Int32Array(64);
# for (let index = 0; index < 64; index++) values[index] = index % 7;
# globalThis.answer = addUp(new Int32Array(16), values, 3);
# -- end of source
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls disable=b3:UnrollLoops disable=b3:VectorizeLoops
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# Every turn reads one element and stores to it, at an address that stays the same, and nothing else in the loop writes an element. What a turn would read there is what the turn
# before has stored: it is read once ahead of the loop and goes around in a register. The store stays: the other array may be the same one, and its elements are read out of memory.
# STATISTIC: WordsCarriedAroundLoops = 1
# CHECK-LABEL: name="addUp" role=Source
# CHECK-LABEL: steps by 1
# CHECK: Int32 b@[[sum]] = Phi(
# CHECK: Int32 b@[[value]] = Load(b@{{*}}Reads:TypedArrayElements{{*}}:GetTypedArrayElement)
# CHECK-NOT: Reads:TypedArrayElements
# CHECK: Int32 b@[[next]] = Add(b@[[value]], b@[[sum]],
# CHECK: Store(b@[[next]], b@{{*}}Writes:TypedArrayElements{{*}}:PutTypedArrayElement)
# CHECK: Upsilon(b@[[next]], ^[[sum]],
# CHECK-LABEL: end of loop

