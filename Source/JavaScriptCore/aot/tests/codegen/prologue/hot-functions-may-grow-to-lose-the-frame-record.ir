# A frame without a record saves two or three instructions each time it is set up. A hot function that sets its frame up at most entries may grow by some bytes for that:
# the same function as in frames-without-a-frame-record.ir, which keeps its record where it is cold. A frame that a short displacement off the stack pointer does not span keeps the record even so
# FORM: Selected
# OPTIONS: heat=everything-is-hot
# RUN: generate-code
# RUN(X64): generate-code
# REQUIRES(X64): x86_64

module m0 path="main.js" displayPath="main.js"
function f0 name="keepsTwoValues" parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = Call v0
    v3 = Call v0
    Return v1
}
function f1 name="keepsManyValues" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Call v0
    v2 = Call v0
    v3 = Call v0
    v4 = Call v0
    v5 = Call v0
    v6 = Call v0
    v7 = Call v0
    v8 = Call v0
    v9 = Call v0
    v10 = Call v0
    v11 = Call v0
    v12 = Call v0
    v13 = Call v0
    v14 = Call v0
    v15 = Call v0
    v16 = Call v0
    v17 = Call v0
    v18 = Call v0
    v19 = Call v0
    v20 = Call v0
    v21 = Call v0, -, v1, v2, v3, v4
    v22 = Call v0, -, v5, v6, v7, v8
    v23 = Call v0, -, v9, v10, v11, v12
    v24 = Call v0, -, v13, v14, v15, v16
    v25 = Call v0, -, v17, v18, v19, v20
    Return v25
}
# CHECK: f0: size={{*}}
# X64: f0: size={{*}} noFrameRecord
# X64-NOT: f1: size={{*}} noFrameRecord
