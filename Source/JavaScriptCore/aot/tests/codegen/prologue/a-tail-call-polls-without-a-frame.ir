# Both functions call themselves, so each has a stack check of its own wherever it sets up a frame. That check is also the poll of a cycle of tail calls, so a tail call used to set up a frame only to tear it down again.
# Where a poll is one load that faults, the tail call polls with that load on a path without a frame. A target that leaves its check to its callers is entered behind a check: there the frame stays
# FORM: Selected
# OPTIONS: heat=everything-is-hot
# RUN: generate-code
# RUN(X64): generate-code
# REQUIRES(X64): x86_64 not-windows

module m0 path="main.js" displayPath="main.js"
function f0 name="goesOn" parameters=[{type=boolean}, {type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean, v1: boolean):
    Branch v0 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v0, v1 function=f1 [isNeverInlined]
    ReturnCall v2
  b2():
    Branch v1 -> taken b3(), notTaken b4()
  b3():
    v3 = CallDirect v1, v0 function=f0 [isNeverInlined]
    Return v3
  b4():
    Return v0
}
function f1 name="callsItself" parameters=[{type=boolean}, {type=boolean}] results=[{type=boolean}] {
  b0(v0: boolean, v1: boolean):
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = CallDirect v1, v0 function=f1 [isNeverInlined]
    Return v2
  b2():
    Return v0
}
