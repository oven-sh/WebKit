# A small frame is allocated and then checked, with a record for the run time; a frame of more than 4096 bytes is checked before it is allocated, at the entry, and has no such record
# FORM: AsRead
# RUN: generate-code
# OPTIONS: check=validate-back-end disable=pass:InlineCalls,pass:OutlineColdOperations,pass:SplitFunctionsAtCalls
# CHECK: f1: size={{*}} prologueChecks=1
# CHECK-NOT: enteredWithoutStackCheck
# CHECK: f2: size={{*}} prologueChecks=0
# CHECK-NOT: enteredWithoutStackCheck
# CHECK: f4: size=
# The check of a small frame can resume after it failed, so it writes no register. The check of a large frame writes a scratch register and only leaves by throwing
# RUN(CALLS): generate-code calls
# CALLS-LABEL: f1: size=
# CALLS: stub PollAtPrologue x1
# CALLS-NOT: ThrowStackOverflow
# CALLS-LABEL: f2: size=
# CALLS-NOT: PollAtPrologue
# CALLS: stub ThrowStackOverflow.AtPrologue x1
# CALLS-NOT: PollAtPrologue
# CALLS-LABEL: f4: size=

module m0 path="main.js" displayPath="main.js" body=f0
