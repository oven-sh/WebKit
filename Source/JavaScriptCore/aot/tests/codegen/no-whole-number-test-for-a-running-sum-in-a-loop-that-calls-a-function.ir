# for (..) { note(i); sum = (sum + list[i]) | 0; }: an iteration that calls a function takes longer than the conversions of the sum, so the next one does not wait for them.
# The element is added and truncated as a double. In the second function the call stands on a rare path, and the element is tested as in a loop without a call.
# FORM: Selected
# RUN: generate-code ExactIntegersBehindNumbers
# CHECK: : size=
# CHECK-NOT: no code
# CHECK: statistic ExactIntegersBehindNumbers 1

module m0 path="main.js" displayPath="main.js"
function f0 name="note" parameters=[{type=i32}] results=[{type=anything}] capabilities=[HasOrdinaryFrame] {
  b0(v0: i32):
    Return v0
}
function f1 name="runningSumBesideCall" parameters=[{type=Array<number>}, {type=i32}] results=[{type=anything}] capabilities=[HasOrdinaryFrame] {
  b0(v0: Array<number>, v1: i32):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3: i32, v4: int[0, 127]):
    LoopHint
    v6 = Less v4, v1 form=Integers
    TestAndBranch v6 -> taken b2(), notTaken b5()
  b2():
    v7 = CallDirect v4 function=f0
    v8 = HasArrayStorage v0 arrayStorage=Double
    TestAndBranch v8 -> taken b3(| 0), notTaken b5()
  b3(v9: guard):
    v10 = IsElementPresent v0, v4, v9 arrayStorage=Double [keyIsIntegral]
    TestAndBranch v10 -> taken b4(| 0), notTaken b5()
  b4(v11: guard):
    v12 = AllGuards v9, v11
    v13 = GetArrayElement v0, v4, v12 arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
    v14 = Add v3, v13 form=Numbers
    v15 = Integer integer=0
    v16 = BitOr v14, v15 form=Numbers
    v17 = Increment v4 form=Integers
    v18 = Integer integer=127
    v19 = BitAnd v17, v18 form=Integers
    Jump -> next b1(v16, v19)
  b5():
    Return v3
}
function f2 name="runningSumBesideRareCall" parameters=[{type=Array<number>}, {type=i32}] results=[{type=anything}] capabilities=[HasOrdinaryFrame] {
  b0(v0: Array<number>, v1: i32):
    v2 = Integer integer=0
    Jump -> next b1(v2, v2)
  b1(v3: i32, v4: int[0, 127]):
    LoopHint
    v6 = Less v4, v1 form=Integers
    TestAndBranch v6 -> taken b2(), notTaken b7()
  b2():
    v7 = Integer integer=100
    v8 = Less v7, v4 form=Integers
    TestAndBranch v8 -> taken b3(), notTaken b4()
  b3() frequency=Rare:
    v9 = CallDirect v4 function=f0
    Jump -> next b4()
  b4():
    v10 = HasArrayStorage v0 arrayStorage=Double
    TestAndBranch v10 -> taken b5(| 0), notTaken b7()
  b5(v11: guard):
    v12 = IsElementPresent v0, v4, v11 arrayStorage=Double [keyIsIntegral]
    TestAndBranch v12 -> taken b6(| 0), notTaken b7()
  b6(v13: guard):
    v14 = AllGuards v11, v13
    v15 = GetArrayElement v0, v4, v14 arrayStorage=Double level=Expected [keyIsIntegral, isPresent]
    v16 = Add v3, v15 form=Numbers
    v17 = Integer integer=0
    v18 = BitOr v16, v17 form=Numbers
    v19 = Increment v4 form=Integers
    v20 = Integer integer=127
    v21 = BitAnd v19, v20 form=Integers
    Jump -> next b1(v18, v21)
  b7():
    Return v3
}
