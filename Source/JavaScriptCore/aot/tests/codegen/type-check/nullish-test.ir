# Where a test takes the mask as an immediate, undefined or null is one test of the bits outside undefined, like the test for a number. A value that may be empty has those bits clear too, so it keeps the comparison that tells them apart
# FORM: Selected
# OPTIONS: check=validate-back-end
# RUN: generate-code
# CHECK: f4: size=
# RUN(X64): generate-code
# REQUIRES(X64): x86_64

module m0 path="main.js" displayPath="main.js"
function f0 name="isNumber" parameters=[{type=anything}] results=[{type=int}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=number
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# X64: f0: size=[[sizeOfMaskTest]] frame=none
function f1 name="isNullish" parameters=[{type=anything}] results=[{type=int}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=undefined|null
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# X64-NEXT: f1: size=[[sizeOfMaskTest]] frame=none
function f2 name="isNotNullish" parameters=[{type=anything}] results=[{type=int}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=boolean|number|bigint|string|symbol|object
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=0
    Return v2
  b2():
    v3 = Integer integer=1
    Return v3
}
# X64-NEXT: f2: size=[[sizeOfMaskTest]] frame=none
function f3 name="requiresPresentValue" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = RequireObjectCoercible v0 nullishAccess=Read
    Return v1
}
# X64-NEXT: f3: size=[[sizeOfRequirement]] frame=
function f4 name="requiresValueThatMayBeEmpty" parameters=[{type=anything|absent}] results=[{type=anything|absent}] {
  b0(v0: anything|absent):
    v1 = RequireObjectCoercible v0 nullishAccess=Read
    Return v1
}
# X64-NOT: f4: size=[[sizeOfRequirement]] frame=
