# In balanced code every claim of claims-in-compact-code.ir is tested inline
# FORM: Selected
# RUN: generate-code
# OPTIONS: check=validate-back-end
# STATISTIC: TypeChecksByOperation = 0
# STATISTIC: TypeChecksInB3 = 6
# CHECK: f6: size=

module m0 path="main.js" displayPath="main.js"
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]
layout L1 name="Point3" fields=[{key="x" declared={type=number} flags=[IsRequired]}, {key="z" declared={type=number} flags=[IsRequired]}] supertypes=[L0]
function f0 name="allocate" parameters=[{type=number}] results=[{type=L0}] {
  b0(v0: number):
    v1 = NewObject -, v0 layout=L0 fields=[0] [keepsShape]
    v2 = NewObject -, v0, v0 layout=L1 fields=[0, 1] [keepsShape]
    Return v1
}
function f1 name="layout" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=undefined|null|L0
    Return v1
}
function f2 name="anyObject" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=undefined|null|object
    Return v1
}
function f3 name="literalStrings" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType="a"|"b"
    Return v1
}
function f4 name="number" parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = Claim v0 castType=number
    Return v1
}
function f5 name="mayBeAbsent" parameters=[{type=undefined|string|absent|L0}] results=[{type=anything}] {
  b0(v0: undefined|string|absent|L0):
    v1 = Claim v0 castType=undefined|L0
    Return v1
}
function f6 name="cell" parameters=[{type=L0|L1}] results=[{type=anything}] {
  b0(v0: L0|L1):
    v1 = Claim v0 castType=L1
    Return v1
}
