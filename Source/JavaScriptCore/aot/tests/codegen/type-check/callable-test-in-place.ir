# In fast code the test for a callable value stays in place: the ranges of cell types are compared there, and only a cell that answers for itself goes to the stub, which knows a Proxy by its flags and asks the operation about the rest.
# FORM: Selected
# OPTIONS: heat=everything-is-hot check=validate-back-end
# RUN: generate-code calls

module m0 path="main.js" displayPath="main.js"

function f0 name="isFunction" parameters=[{type=anything}] results=[{type=int}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=function
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
function f1 name="isFunctionOrUndefined" parameters=[{type=anything}] results=[{type=int}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=function|undefined
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
function f2 name="asValue" parameters=[{type=anything}] results=[{type=boolean}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=function
    Return v1
}
# CHECK-NOT: operation
# CHECK: f0: size={{*}}
# CHECK-NEXT: stub ValueIsCallable x1
# CHECK-NEXT: f1: size={{*}}
# CHECK-NEXT: stub ValueIsCallable x1
# CHECK-NEXT: f2: size={{*}}
# CHECK-NEXT: stub ValueIsCallable x1
