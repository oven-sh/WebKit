# The test whether a string is one of n literals compares the word of the literal with the n words by a switch: two or three compare and branch; from four on, numbers that lie within 64 of each other take one range test and one bit test, whatever n is. The entrypoints f7 to f10 hold the tests of 2, 4, 12 and 40 literals. As an or of comparisons the four took 68, 80, 101 and 103 bytes, the last two with a jump table; where the answer is a value, 14 bytes a literal
# FORM: AsRead
# OPTIONS: check=validate-back-end
# RUN: generate-code
# CHECK: f8: size=[[four]] frame={{*}} jumpTables=0
# CHECK: f9: size=[[four]] frame={{*}} jumpTables=0
# CHECK: f10: size=[[four]] frame={{*}} jumpTables=0
# RUN(X64): generate-code
# REQUIRES(X64): x86_64
# X64: f7: size=37 frame
# X64: f8: size=43 frame

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0

function f0 name="main" kind=Module results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f2
    v2 = NewClosure function=f3
    v3 = NewClosure function=f4
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="register" [isFreeName]
    v6 = Call v5, -, v0, v1, v2, v3
    Return v6
}
function f1 name="oneOfTwo" parameters=[{type=string}] results=[{type=int}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="w00"|"w01"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
function f2 name="oneOfFour" parameters=[{type=string}] results=[{type=int}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="w00"|"w01"|"w02"|"w03"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
function f3 name="oneOfTwelve" parameters=[{type=string}] results=[{type=int}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="w00"|"w01"|"w02"|"w03"|"w04"|"w05"|"w06"|"w07"|"w08"|"w09"|"w10"|"w11"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
function f4 name="oneOfForty" parameters=[{type=string}] results=[{type=int}] {
  b0(v0: string):
    v1 = TypeTest v0 testedType="w00"|"w01"|"w02"|"w03"|"w04"|"w05"|"w06"|"w07"|"w08"|"w09"|"w10"|"w11"|"w12"|"w13"|"w14"|"w15"|"w16"|"w17"|"w18"|"w19"|"w20"|"w21"|"w22"|"w23"|"w24"|"w25"|"w26"|"w27"|"w28"|"w29"|"w30"|"w31"|"w32"|"w33"|"w34"|"w35"|"w36"|"w37"|"w38"|"w39"
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = Integer integer=1
    Return v2
  b2():
    v3 = Integer integer=0
    Return v3
}
