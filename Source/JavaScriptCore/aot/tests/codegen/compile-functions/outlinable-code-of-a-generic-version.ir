# The machine outliner asks more of a piece that stands where cold code may run: a call and a return are paid each time. A generic version runs only where a test at an entrance has failed,
# which is expected of no call, so all of its code is taken like code behind a rare edge, in a program of any size. The typed body keeps its marks.
#   f1 takesString is called in a loop. f1 stays the entrance, f3 is the typed body, f4 the generic version
# FORM: AsRead
# OPTIONS: disable=pass:InlineCalls
# RUN: generate-code units
# RUN(ROLES): pipeline SplitBehindEntryChecks
# ROLES: function f1 name="takesString" {{*}} role=EntryChecks
# ROLES: function f4 name="takesString" {{*}} role=GenericVersion
# CHECK-LABEL: f4: size=
# CHECK-NEXT: units {{*}} mayRun=0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=30 kind=Parameter

function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    Jump -> next b1()
  b1():
    LoopHint
    v3 = CallDirect v1 function=f1
    v4 = ToBoolean v3
    Branch v4 -> taken b1(), notTaken b2()
  b2():
    Return
}
function f1 name="takesString" module=m0 position=200 flags=[IsChecked] length=1 parameters=[{type=string site=w0 flags=[IsExpected]}] results=[{type=anything}] {
  b0(v0: anything ~ string):
    v1 = Check v0 castType=string site=w0
    v2 = PropGet v1 key="length"
    v3 = PropGet v1 key="first"
    v4 = PropGet v1 key="second"
    v5 = Add v2, v3
    v6 = Add v5, v4
    Return v6
}
