# Thirty-eight small functions that share batches and a large one with a batch of its own are all compiled and counted on one thread
# FORM: AsRead
# RUN: compile
# REQUIRES: unsanitized-code
# OPTIONS: heat=everything-is-hot threads=1 check=validate-back-end disable=pass:InlineCalls,pass:OutlineColdOperations,pass:NarrowConstantVariables
# STATISTIC: LoopsRotated >= 38
# STATISTIC: NullChecksFoldedIntoAccesses >= 38
# CHECK: image not empty

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 name="Point" fields=[{key="x" declared={type=number} flags=[IsRequired]}]

function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="input" [isFreeName]
    v2 = Double number=1.5
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = Null
    v5 = ToBoolean v1
    Branch v5 -> taken b1(v3), notTaken b1(v4)
  b1(v6):
    v7 = ToNumber v1
# REPEAT: i = 1..38
    v%(i+7) = CallDirect v6, v7 function=f%(i)
# END REPEAT
    v46 = CallDirect v1 function=f39
    v47 = Call v1, -, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34, v35, v36, v37, v38, v39, v40, v41, v42, v43, v44, v45, v46
    Return v47
}
# REPEAT: i = 1..38
function f%(i) name="small%(i)" parameters=[{type=null|L0}, {type=number}] results=[{type=anything}] {
    v2 = Integer integer=%(i)
    Jump -> next b1(v2)
  b1(v3):
    LoopHint
    v5 = Less v3, v1
    Branch v5 -> taken b2(), notTaken b3()
  b2():
    v6 = Add v3, v3
    Jump -> next b1(v6)
  b3():
    v7 = PropGet v0 key="x"
    v8 = Add v7, v3
    Return v8
}
# END REPEAT
function f39 name="large" parameters=[{type=anything}] results=[{type=anything}] {
# REPEAT: i = 1..65
    v%(i) = Call v0, -, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0, v0
# END REPEAT
    Return v65
}
