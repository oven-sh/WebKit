# The start is handed to the counter by a move of 32 bits, once in front of the loop. From there on every value of the counter has zeros in its upper half,
# the counter and its widened form share one register, and no turn copies one to the other.
#
# function find(bytes: Uint8Array, from: number, to: number): number {
#   for (let i = from; i < to; i++) if (bytes[i] === 200) return i;
#   return -1;
# }
