# The code generator emits one bounds check against the length field, then a load at vector + (index << 3). Nothing is called.
# LOWERED: Int64 b@[[length]] = Load(b@[[view]], offset = 24, ControlDependent|Reads:JSArrayBufferView_length, [[check]]:IsInsideView)
# LOWERED: Int32 b@[[isInBounds]] = Below(b@[[index]], b@[[length]], [[check]]:IsInsideView)
# LOWERED-NEXT: Branch(b@[[isInBounds]], Terminal, [[check]]:IsInsideView)
# LOWERED-NEXT: Successors: Then:#[[body]], Else:Rare:
# LOWERED-NEXT: BB#[[body]]:
# LOWERED-NOT: Branch(
# LOWERED: Int64 b@[[vector]] = Load(b@[[view]], offset = 16, ControlDependent|Reads:JSArrayBufferView_vector, [[read]]:GetTypedArrayElement)
# LOWERED-NEXT: Int64 b@[[offset]] = Shl(b@[[index]], $3(
# LOWERED-NEXT: Int64 b@[[address]] = Add(b@[[vector]], b@[[offset]], [[read]]:GetTypedArrayElement)
# LOWERED-NEXT: Double b@[[element]] = Load(b@[[address]], ControlDependent|Reads:TypedArrayElements, [[read]]:GetTypedArrayElement)
# LOWERED: Double b@{{*}} = Add(b@{{*}}, b@[[element]], {{*}}:Add)

# B3 unrolls the loop eight times: eight element loads off one counter.
# UNROLLED-LABEL: steps by 8
# UNROLLED: Double b@{{*}} = Load(b@{{*}}, ControlDependent|Reads:TypedArrayElements
# REPEAT: turn = 1..7
# UNROLLED: Double b@{{*}} = Load(b@{{*}}, offset = %(turn*8), ControlDependent|Reads:TypedArrayElements
# END REPEAT
# UNROLLED-NOT: Reads:TypedArrayElements
# UNROLLED-LABEL: end of loop

# The unrolled loop has no bounds check, no poll and no reload of the length or the vector: its only branch is the loop condition.
# HOT-LABEL: steps by 8
# HOT-NOT: Branch(
# HOT-NOT: isLoopPoll
# HOT-NOT: Reads:JSArrayBufferView
# HOT: Branch(b@{{*}}, Terminal, {{*}}:Less)
# HOT-NOT: Branch(
# HOT-NOT: isLoopPoll
# HOT-LABEL: end of loop

# Eight elements cost ten instructions: eight additions from memory, the counter, the branch.
# X64: instructions: 10, patchpoints: 8, {{*}} steps by 8
# X64-COUNT-8: AddDouble {{*}}(%{{*}},%{{*}},8), %xmm
# ARM64 has no base + index * 8 + offset address: the loads share base + index * 8.
# ARM64: instructions: 20, patchpoints: 8, {{*}} steps by 8
