# The loop ends at a bound of the program's own, so its range checks are made once in front of a fast version. There too the turns that are written out add the elements as integers:
# TODO: row-4719: the clamp of loop bounds is switched off, and what rests on it is lost: fast versions of counted loops without range checks, their vectors and written-out turns
# the paths behind the comparisons that were decided for the fast version are left by nobody and look at no sum.
# A turn outside the view hands the sum back in front of the loop, so the start of the sum is no constant. Most sums start at zero: that is told by the bits of the start, and only
# another start is tested for being whole and small.
#
# function total(bytes: Uint8Array, offset: number, width: number): number {
#   const from = offset & 0xffffff;
#   const to = from + (width & 0xffffff);
#   let sum = 0;
#   for (let i = from; i < to; i++) sum += bytes[i]!;
#   return sum;
# }
# declare const input: any;
# (globalThis as any).answer = total(input, input, input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized loops f1
# REQUIRES: unsanitized-code
# RUN(START): lower-to-b3 optimized f1
# REQUIRES(START): unsanitized-code

