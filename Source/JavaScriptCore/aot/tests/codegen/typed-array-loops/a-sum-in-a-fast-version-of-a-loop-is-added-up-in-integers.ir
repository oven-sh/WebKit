    v9 = Builtin builtin=GlobalThis
    v10 = PropGet v9 key="input" [isFreeName]
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=number flags=[IsExpected]}
    v15 = Call v1, -, v8, v11, v14 calleeName="total"
    v16 = Convert v15 declared={type=number site=w4}
    PropSet v5, v16 key="answer"
    v18 = Undefined
    Return v18
}
function f1 name="total" module=m0 flags=[IsChecked, HasExplicitName] length=3 thisType={type=anything} parameters=[{type=undefined|null|Uint8Array site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}, {type=number site=w2}] results=[{type=number site=w3}] {
  b0(v0: undefined|null|Uint8Array, v1: number, v2: number):
    Jump -> next b1()
  b1():
    v3 = Integer integer=16777215
    v4 = BitAnd v1, v3
    v5 = Convert v4 declared={type=number site=w5}
    v6 = Integer integer=16777215
