# A scan walks a Uint8Array up to a byte. Its position may pass 32 bits, so every turn asks whether it still fits. That test is an order of the position and a constant,
# also where the start is known not to be negative: the loop is counted by it, runs in stretches without a poll, and eight turns are written out.
# -- source: a-scan-up-to-a-byte-is-written-out-wherever-it-starts.js
# const text = new Uint8Array(4096);
# function endOfLine(bytes, from) {
#   let p = from;
#   while (bytes[p] !== 10) p++;
#   return p;
# }
# function fromAProduct(n) {
#   let sum = 0;
#   for (let i = 0; i < n; i++) sum = (sum + endOfLine(text, (i & 15) * 256)) | 0;
#   return sum;
# }
# function fromAShift(n) {
#   let sum = 0;
#   for (let i = 0; i < n; i++) sum = (sum + endOfLine(text, (i & 15) << 8)) | 0;
#   return sum;
# }
# globalThis.answer = fromAProduct(input | 0) + fromAShift(input | 0);
# -- end of source
