# function truncated(value: number): number { return value | 0; }
# declare const input: any;
# (globalThis as any).answer = truncated(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: x86_64 unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ANY): lower-to-b3 optimized f1
# REQUIRES(ANY): unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=19 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=119 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="truncated"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="truncated" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer
    v2 = BitOr v0, v1
    v3 = Convert v2 declared={type=number site=w1}
    Return v3
}

# value | 0 of a number: one conversion instruction in line. It answers with one fixed value for what it cannot convert (NaN, an infinity, 2 to the 63 and beyond), and only that value takes the rare arm, which calls.
# CHECK-LABEL: name="truncated" role=Source
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK: Int64 b@[[converted]] = Patchpoint(b@[[value]]:SomeRegister, runsWithoutFrame, resultConstraints = SomeRegister, pureFunction = {{*}}:BitOr)
# CHECK: Int32 b@[[isConverted]] = NotEqual(b@[[converted]], b@{{*}}, {{*}}:BitOr)
# CHECK-NEXT: Branch(b@[[isConverted]], Terminal, {{*}}:BitOr)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#{{*}}
# CHECK: Int32 b@{{*}} = Trunc(b@[[converted]], {{*}}:BitOr)
# CHECK-LABEL: end of function
# X64: instructions: 2, patchpoints: 1, rare instructions: 4
# On every target the conversion is made in line from the floating-point register, a 32-bit integer without a tag goes back, and no arm but a rare one calls.
# ANY-LABEL: name="truncated" role=Source
# ANY: b@{{*}} = Patchpoint(b@{{*}}:SomeRegister, runsWithoutFrame, resultConstraints = SomeRegister, pureFunction = {{*}}:BitOr)
# ANY-NOT: Successors: Then:#{{*}}, Else:#
# ANY-NOT: ZExt32(
# ANY-LABEL: end of function
