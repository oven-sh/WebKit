# function negate(a: number): number { return -a; }
# declare const input: any;
# (globalThis as any).answer = negate(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 f1
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=105 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="negate"
    v12 = Convert v11 declared={type=number site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="negate" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Negate v0
    v2 = Convert v1 declared={type=number site=w1}
    Return v2
}

# -a of a 32-bit integer is -0 for 0 and 2147483648 for -2147483648. The integer becomes a double and the double is negated: no test for either value.
# CHECK-LABEL: name="negate" role=Source
# CHECK: BB#1:
# CHECK-NEXT: Double b@[[number]] = IToD(b@{{*}}, {{*}}:Negate)
# CHECK-NEXT: Double b@[[negated]] = Neg(b@[[number]], {{*}}:Negate)
# CHECK-NEXT: Return(b@[[negated]], Terminal)
# CHECK-LABEL: end of function
# x86-64 flips the sign bit with a constant from memory.
# X64: instructions: 4, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
