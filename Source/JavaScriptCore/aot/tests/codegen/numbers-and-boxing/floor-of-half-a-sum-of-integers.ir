# function middle(low: number, high: number): number { return Math.floor((low + high) / 2); }
# declare const input: any;
# (globalThis as any).answer = middle(input | 0, input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 position=29 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=147 kind=CallResult
typesite w4 module=m0 position=60 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v14 = Integer
    v15 = BitOr v13, v14
    v16 = Call v1, -, v10, v15 calleeName="middle"
    v17 = Convert v16 declared={type=number site=w3}
    PropSet v5, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="middle" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Builtin builtin=Math
    v3 = Builtin builtin=MathFloor
    v4 = Add v0, v1
    v5 = Integer integer=2
    v6 = Div v4, v5
    v7 = Call v3, v2, v6 calleeName="Math.floor"
    ReturnCall v7 casts=[{declared={type=number site=w4}}, {declared={type=number site=w2}}]
}

# Math.floor((low + high) / 2) of two 32-bit integers never leaves the integers: a 64-bit sum and an arithmetic shift, which rounds toward minus infinity as Math.floor does.
# CHECK-LABEL: name="middle" role=Source
# CHECK: Int64 b@[[sum]] = Add(b@{{*}}, b@{{*}}, {{*}}:Add)
# CHECK: Int64 b@[[half]] = SShr(b@[[sum]], $1(b@{{*}}), {{*}}:DivideIntegers)
# CHECK-NEXT: Double b@[[number]] = IToD(b@[[half]])
# CHECK-NEXT: Return(b@[[number]], Terminal)
# CHECK-LABEL: end of function
# No division, no rounding of a double, no call.
# NONE-LABEL: name="middle" role=Source
# NONE-NOT: Div(
# NONE-NOT: Floor(
# NONE-NOT: Double b@{{*}} = Mul(
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64: instructions: 6, patchpoints: 0
# ARM64: instructions: 5, patchpoints: 0
