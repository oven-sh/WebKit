# function isWhole(value: number): boolean { return Number.isInteger(value); }
# declare const input: any;
# (globalThis as any).answer = isWhole(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=132 kind=CallResult
typesite w3 module=m0 position=50 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="isWhole"
    v11 = Convert v10 declared={type=boolean site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="isWhole" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Number
    v2 = Builtin builtin=NumberIsInteger
    v3 = Call v2, v1, v0 calleeName="Number.isInteger"
    ReturnCall v3 casts=[{declared={type=boolean site=w3}}, {declared={type=boolean site=w1}}]
}

# Number.isInteger of a number: the number less its whole part is 0. For an infinity or NaN the difference is NaN, which equals nothing. No call, no branch.
# CHECK-LABEL: name="isWhole" role=Source
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK: Double b@[[whole]] = FTrunc(b@[[value]], {{*}}:CallInline)
# CHECK-NEXT: Double b@[[fraction]] = Sub(b@[[value]], b@[[whole]], {{*}}:CallInline)
# CHECK: Int32 b@[[isWhole]] = Equal(b@[[fraction]], $0.000000(b@{{*}}), {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[isWhole]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isWhole" role=Source
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64: instructions: 5, patchpoints: 0
# ARM64: instructions: 4, patchpoints: 0
