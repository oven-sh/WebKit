# function hold(value: number): number { return Math.min(Math.max(value, 0), 255); }
# declare const input: any;
# (globalThis as any).answer = hold(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=138 kind=CallResult
typesite w3 module=m0 position=55 kind=CallResult
typesite w4 module=m0 position=46 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="hold"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="hold" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Math
    v2 = Builtin builtin=MathMin
    v3 = Builtin builtin=Math
    v4 = Builtin builtin=MathMax
    v5 = Integer
    v6 = Call v4, v3, v0, v5 calleeName="Math.max"
    v7 = Convert v6 declared={type=number site=w3} illTypedCause=DeclarationWithoutBody
    v8 = Integer integer=255
    v9 = Call v2, v1, v7, v8 calleeName="Math.min"
    ReturnCall v9 casts=[{declared={type=number site=w4}}, {declared={type=number site=w1}}]
}

# Math.min(Math.max(value, 0), 255). A bound that is written out is not NaN, so the value stands second, where x86-64's instructions let NaN through, and nothing branches.
# Against 0 the maximum could be -0: adding 0 makes 0 of it and changes no other number.
# CHECK-LABEL: name="hold" role=Source
# CHECK-NOT: Branch(
# CHECK-LABEL: end of function
# X64-LABEL: name="hold" role=Source
# X64-NOT: Branch
# X64: MaxOrSecondDouble %xmm0, %[[raised]]
# X64-NEXT: AddDouble
# X64-NOT: Branch
# X64: MinOrSecondDouble
# X64-NEXT: RetDouble %xmm0
# X64-NEXT: end of function
# ARM64-LABEL: name="hold" role=Source
# ARM64: DoubleMax
# ARM64: DoubleMin
# ARM64-NEXT: RetDouble %q0
# ARM64-NEXT: end of function
