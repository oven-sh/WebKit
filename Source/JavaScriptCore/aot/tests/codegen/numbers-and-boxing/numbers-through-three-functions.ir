# Numbers go from function to function in floating-point registers and come back in one. The square root is taken of the sum of two results as they came back.
# CHECK-LABEL: name="distance" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[x]] = ArgumentReg(
# CHECK-NEXT: Double b@[[xSquared]] = Patchpoint(b@[[x]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Double b@[[ySquared]] = Patchpoint(b@[[y]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[xSquared]], b@[[ySquared]], {{*}}:Add)
# CHECK-NEXT: Double b@[[root]] = Sqrt(b@[[sum]], {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[root]], Terminal)
# CHECK-LABEL: end of function
# CHECK-LABEL: name="perimeter" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[x]] = ArgumentReg(
# CHECK-NEXT: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Double b@[[distance]] = Patchpoint(b@[[x]]:Register({{*}}), b@[[y]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[withX]] = Add(b@[[x]], b@[[distance]], {{*}}:Add)
# CHECK-NEXT: Double b@[[withY]] = Add(b@[[y]], b@[[withX]], {{*}}:Add)
# CHECK-NEXT: Return(b@[[withY]], Terminal)
# CHECK-LABEL: end of function
# In none of the three is a number boxed, unboxed or tested: no integer value at all, no load, no branch.
# NONE-LABEL: name="square" role=Source
# NONE-NOT: Int64
# NONE-NOT: Int32
# NONE-LABEL: end of function
# NONE-LABEL: name="distance" role=Source
# NONE-NOT: Int64
# NONE-NOT: Int32
# NONE-LABEL: end of function
# NONE-LABEL: name="perimeter" role=Source
# NONE-NOT: Int64
# NONE-NOT: Int32
# NONE-LABEL: end of function
