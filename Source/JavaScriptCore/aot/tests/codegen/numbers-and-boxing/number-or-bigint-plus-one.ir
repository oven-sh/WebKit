# function next(a: number | bigint): number | bigint { return typeof a === "bigint" ? a + 1n : a + 1; }
# declare const input: any;
# (globalThis as any).answer = next(input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=157 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=undefined|null|number|bigint flags=[IsExpected]}
    v9 = Call v1, -, v8 calleeName="next"
    v10 = Convert v9 declared={type=undefined|null|number|bigint site=w2 flags=[OmitsNull, OmitsUndefined]}
    PropSet v5, v10 key="answer"
    v12 = Undefined
    Return v12
}
function f1 name="next" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|number|bigint site=w0 flags=[OmitsNull, OmitsUndefined]}] results=[{type=undefined|null|number|bigint site=w1 flags=[OmitsNull, OmitsUndefined]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|number|bigint):
    Jump -> next b1()
  b1():
    v1 = TypeTest v0 testedType=bigint
    Branch v1 -> taken b2(| 0), notTaken b4(| 0)
  b2(v2):
    Jump -> next b3()
  b3():
    v3 = Convert v2 declared={type=undefined|null|bigint} illTypedCause=Assertion
    v4 = BigInt digits="1"
    v5 = Add v3, v4
    Jump -> next b6(v5)
  b4(v6):
    Jump -> next b5()
  b5():
    v7 = Convert v6 declared={type=number} illTypedCause=Assertion
    v8 = Integer integer=1
    v9 = Add v7, v8
    Jump -> next b6(v9)
  b6(v10):
    v11 = Convert v10 declared={type=undefined|null|number|bigint site=w1 flags=[OmitsNull, OmitsUndefined]}
    Return v11
}

# The parameter is a number or a BigInt, so it arrives boxed, and typeof a === "bigint" is one test of the tag bits: a number has some, a cell has none.
# CHECK-LABEL: name="next" role=Source
# CHECK: Int64 b@[[tags]] = BitAnd(b@[[a]], {{*}}:TypeTest)
# CHECK: Branch(b@[[tags]], Terminal, {{*}}:TypeTest)
# A boxed 32-bit integer plus one: the sum is made in 64 bits and compared with its own low half. This test for overflow stays, because nothing bounds the integer. A sum that fits gets the tag again.
# CHECK: Int32 b@[[isInteger]] = AboveEqual(b@[[a]], {{*}}:Add)
# CHECK: Branch(b@[[isInteger]], Terminal, {{*}}:Add)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Unlikely:#{{*}}
# CHECK: Int64 b@[[wide]] = SExt32(b@{{*}}, {{*}}:Add)
# CHECK: Int64 b@[[sum]] = Add(b@[[wide]], $1(b@{{*}}), {{*}}:Add)
# CHECK-NEXT: Int32 b@[[low]] = Trunc(b@[[sum]], {{*}}:Add)
# CHECK-NEXT: Int64 b@[[again]] = SExt32(b@[[low]], {{*}}:Add)
# CHECK-NEXT: Int32 b@[[fits]] = Equal(b@[[sum]], b@[[again]], {{*}}:Add)
# CHECK-NEXT: Branch(b@[[fits]], Terminal, {{*}}:Add)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Unlikely:#{{*}}
# CHECK: Int64 b@[[payload]] = ZExt32(b@[[low]], {{*}}:Add)
# CHECK: Int64 b@{{*}} = Add(b@[[payload]], {{*}}:Add)
# A sum that does not fit becomes a double in line.
# CHECK: Double b@{{*}} = IToD(b@[[sum]], {{*}}:Add)
# The BigInt plus 1n is a call, which may allocate and may throw.
# CHECK: Int64 b@{{*}} = Patchpoint(b@[[a]]:Register({{*}}), b@{{*}}:Register({{*}}), resultConstraints = Register({{*}}), ExitsSideways|{{*}}:Add)
# CHECK-LABEL: end of function
