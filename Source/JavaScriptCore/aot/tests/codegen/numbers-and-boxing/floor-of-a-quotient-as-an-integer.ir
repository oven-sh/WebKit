# function cell(position: number, width: number): number { return Math.floor(position / width) | 0; }
# declare const input: any;
# (globalThis as any).answer = cell(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=32 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=155 kind=CallResult
typesite w4 module=m0 position=64 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="cell"
    v15 = Convert v14 declared={type=number site=w3}
    PropSet v5, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="cell" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Builtin builtin=Math
    v3 = Builtin builtin=MathFloor
    v4 = Div v0, v1
    v5 = Call v3, v2, v4 calleeName="Math.floor"
    v6 = Convert v5 declared={type=number site=w4} illTypedCause=DeclarationWithoutBody
    v7 = Integer
    v8 = BitOr v6, v7
    v9 = Convert v8 declared={type=number site=w2}
    Return v9
}

# Math.floor(position / width) | 0: the quotient is rounded in its register and converted to an integer from there. Nothing is boxed between the three steps, and a 32-bit integer without a tag goes back.
# CHECK-LABEL: name="cell" role=Source
# CHECK: Double b@[[quotient]] = Div(b@{{*}}, b@{{*}}, ControlDependent, {{*}}:Div)
# CHECK-NEXT: Double b@[[floor]] = Floor(b@[[quotient]], {{*}}:CallInline)
# CHECK-NEXT: b@{{*}} = Patchpoint(b@[[floor]]:SomeRegister, runsWithoutFrame, resultConstraints = SomeRegister, pureFunction = {{*}}:BitOr)
# CHECK-LABEL: end of function
# NONE-LABEL: name="cell" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: BitwiseCast
# NONE-NOT: ZExt32(
# NONE-LABEL: end of function
# X64: instructions: 4, patchpoints: 1, rare instructions: 4
