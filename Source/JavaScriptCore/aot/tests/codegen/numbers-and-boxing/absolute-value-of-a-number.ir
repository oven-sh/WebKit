# function apply(value: number): number { return Math.abs(value); }
# declare const input: any;
# (globalThis as any).answer = apply(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 f1
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=121 kind=CallResult
typesite w3 module=m0 position=47 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="apply"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="apply" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Math
    v2 = Builtin builtin=MathAbs
    v3 = Call v2, v1, v0 calleeName="Math.abs"
    ReturnCall v3 casts=[{declared={type=number site=w3}}, {declared={type=number site=w1}}]
}

# Math.abs of a number clears the sign bit of the number in its register. Nothing is called, compared or boxed.
# CHECK-LABEL: name="apply" role=Source
# CHECK: BB#1:
# CHECK-NEXT: Double b@[[size]] = Abs(b@{{*}}, {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[size]], Terminal)
# CHECK-LABEL: end of function
# x86-64 has no such instruction: it makes a mask and applies it.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 2, patchpoints: 0
