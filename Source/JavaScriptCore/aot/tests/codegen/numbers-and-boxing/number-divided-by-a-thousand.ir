# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=19 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=136 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Call v1, -, v9 calleeName="toSeconds"
    v11 = Convert v10 declared={type=number site=w2}
    PropSet v5, v11 key="answer"
    v13 = Undefined
    Return v13
}
function f1 name="toSeconds" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer integer=1000
    v2 = Div v0, v1
    v3 = Convert v2 declared={type=number site=w1}
    Return v3
}

# 1 / 1000 is no exact double, so value / 1000 stays a division.
# CHECK-LABEL: name="toSeconds" role=Source
# CHECK: Double b@[[value]] = ArgumentReg(
# CHECK: Double b@[[seconds]] = Div(b@[[value]], {{*}}:Div)
# CHECK-NEXT: Return(b@[[seconds]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="toSeconds" role=Source
# NONE-NOT: Mul(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
