# function isOverHalf(count: number): boolean { return count > 0.5; }
# declare const input: any;
# (globalThis as any).answer = isOverHalf(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=20 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=123 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="isOverHalf"
    v12 = Convert v11 declared={type=boolean site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="isOverHalf" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=boolean site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Double number=0.5
    v2 = Greater v0, v1
    v3 = Convert v2 declared={type=boolean site=w1}
    Return v3
}

# An integer is above 0.5 exactly when it is above 0: the comparison is one of integers and nothing becomes a double.
# CHECK-LABEL: name="isOverHalf" role=Source
# CHECK: Int32 b@[[isAbove]] = GreaterThan(b@{{*}}, $0(b@{{*}}), {{*}}:Greater)
# CHECK-NEXT: Return(b@[[isAbove]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="isOverHalf" role=Source
# NONE-NOT: IToD
# NONE-NOT: Double
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64: instructions: 2, patchpoints: 0
# ARM64: instructions: 2, patchpoints: 0
