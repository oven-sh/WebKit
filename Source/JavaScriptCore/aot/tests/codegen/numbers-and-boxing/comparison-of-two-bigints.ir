    v12 = Builtin builtin=BigInt
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="input" [isFreeName]
    v15 = Convert v14 declared={type=undefined|null|boolean|number|string|bigint flags=[IsExpected]}
    v16 = Call v12, -, v15 calleeName="BigInt"
