# a < b of two BigInts is one call. Both go in as cells and a truth value comes back.
# CHECK-LABEL: name="isLess" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Int64 b@[[a]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[b]] = ArgumentReg(
# CHECK-NEXT: Int64 b@[[answer]] = Patchpoint(b@[[a]]:{{*}}, b@[[b]]:{{*}}, resultConstraints = Register({{*}}), ExitsSideways|{{*}}:Less)
# CHECK-NEXT: Int32 b@[[isLess]] = Trunc(b@[[answer]], {{*}}:Less)
# CHECK-NEXT: Return(b@[[isLess]], Terminal)
# CHECK-LABEL: end of function
# No path for numbers stands in front of the call.
# NONE-LABEL: name="isLess" role=Source
# NONE-NOT: Branch(
