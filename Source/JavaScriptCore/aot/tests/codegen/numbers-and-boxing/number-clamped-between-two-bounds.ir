function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = ToNumber v16
    v18 = Call v1, -, v9, v13, v17 calleeName="clamp"
    v19 = Convert v18 declared={type=number site=w4}
    PropSet v5, v19 key="answer"
    v21 = Undefined
    Return v21
}
function f1 name="clamp" module=m0 flags=[IsChecked, HasExplicitName] length=3 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}, {type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number, v2: number):
    Jump -> next b1()
  b1():
    v3 = Builtin builtin=Math
    v4 = Builtin builtin=MathMin
    v5 = Builtin builtin=Math
    v6 = Builtin builtin=MathMax
    v7 = Call v6, v5, v0, v1 calleeName="Math.max"
    v8 = Convert v7 declared={type=number site=w5} illTypedCause=DeclarationWithoutBody
    v9 = Call v4, v3, v8, v2 calleeName="Math.min"
    ReturnCall v9 casts=[{declared={type=number site=w6}}, {declared={type=number site=w3}}]
}

# Math.min(Math.max(value, low), high): the result of the inner call goes into the outer one as a number in a register.
# CHECK-LABEL: name="clamp" role=Source
# CHECK: BB#1:
