    v6 = Convert v5 declared={type=undefined|null|Float64Array site=w4 flags=[OmitsNull, OmitsUndefined]} illTypedCause=FromLooseType
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="input" [isFreeName]
    v9 = Convert v8 declared={type=i32 flags=[IsExpected]}
    v10 = Integer
    v11 = BitOr v9, v10
    v12 = Builtin builtin=GlobalThis
    v13 = PropGet v12 key="input" [isFreeName]
    v14 = Convert v13 declared={type=number flags=[IsExpected]}
    v15 = ToNumber v14
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="input" [isFreeName]
    v18 = Convert v17 declared={type=number flags=[IsExpected]}
    v19 = ToNumber v18
    v20 = Call v1, -, v6, v11, v15, v19 calleeName="put"
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="globalThis" [isFreeName]
    v23 = Convert v22 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v24 = Convert v23 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
