function f1 name="put" module=m0 flags=[IsChecked, HasExplicitName] length=4 thisType={type=anything} parameters=[{type=undefined|null|Float64Array site=w0 flags=[OmitsNull, OmitsUndefined]}, {type=number site=w1}, {type=number site=w2}, {type=number site=w3}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|Float64Array, v1: number, v2: number, v3: number):
