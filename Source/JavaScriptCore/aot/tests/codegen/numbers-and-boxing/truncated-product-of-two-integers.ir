# function product(a: number, b: number): number { return (a * b) | 0; }
# declare const input: any;
# (globalThis as any).answer = product(input | 0, input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=17 kind=Parameter function=f1
typesite w1 module=m0 position=28 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=126 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v14 = Integer
    v15 = BitOr v13, v14
    v16 = Call v1, -, v10, v15 calleeName="product"
    v17 = Convert v16 declared={type=number site=w3}
    PropSet v5, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="product" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Mul v0, v1
    v3 = Integer
    v4 = BitOr v2, v3
    v5 = Convert v4 declared={type=number site=w2}
    Return v5
}

# (a * b) | 0 is not the low half of the exact product: past 53 bits the product of the doubles is rounded first. The product is made in 64 bits, and one that fits 32 bits is the answer. This test for overflow stays.
# CHECK-LABEL: name="product" role=Source
# CHECK: Int64 b@[[wideA]] = SExt32(b@[[a]], {{*}}:BitOr)
# CHECK-NEXT: Int64 b@[[wideB]] = SExt32(b@[[b]], {{*}}:BitOr)
# CHECK-NEXT: Int64 b@[[product]] = Mul(b@[[wideA]], b@[[wideB]], {{*}}:BitOr)
# CHECK-NEXT: Int32 b@[[low]] = Trunc(b@[[product]], {{*}}:BitOr)
# CHECK-NEXT: Int64 b@[[again]] = SExt32(b@[[low]], {{*}}:BitOr)
# CHECK-NEXT: Int32 b@[[fits]] = Equal(b@[[product]], b@[[again]], {{*}}:BitOr)
# CHECK-NEXT: Branch(b@[[fits]], Terminal, {{*}}:BitOr)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#{{*}}
# The rare arm multiplies the doubles, which rounds, and converts that product.
# CHECK: Double b@[[left]] = IToD(b@[[a]], {{*}}:Mul)
# CHECK-NEXT: Double b@[[right]] = IToD(b@[[b]], {{*}}:Mul)
# CHECK-NEXT: Double b@{{*}} = Mul(b@[[left]], b@[[right]], {{*}}:Mul)
# CHECK-LABEL: end of function
# NONE-LABEL: name="product" role=Source
# NONE-NOT: ExitsSideways
# NONE-NOT: ZExt32(
# NONE-LABEL: end of function
# Both targets fold the likely path into a 32-bit multiplication and a branch on its overflow.
# X64: instructions: 3, patchpoints: 0
# ARM64: instructions: 3, patchpoints: 0
