# function inHalves(value: number): number { return value % 1000.5; }
# function inTurns(angle: number): number { return angle % 6.283185307179586; }
# declare const input: any;
# (globalThis as any).answer = inHalves(+input) + inTurns(+input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized
# REQUIRES: unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=18 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=85 kind=Parameter function=f2
typesite w3 module=m0 position=68 kind=Result
typesite w4 module=m0 position=201 kind=CallResult
typesite w5 module=m0 position=220 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="globalThis" [isFreeName]
    v6 = Convert v5 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v7 = Convert v6 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="input" [isFreeName]
    v10 = Convert v9 declared={type=number flags=[IsExpected]}
    v11 = ToNumber v10
    v12 = Call v1, -, v11 calleeName="inHalves"
    v13 = Convert v12 declared={type=number site=w4}
    v14 = Builtin builtin=GlobalThis
    v15 = PropGet v14 key="input" [isFreeName]
    v16 = Convert v15 declared={type=number flags=[IsExpected]}
    v17 = ToNumber v16
    v18 = Call v3, -, v17 calleeName="inTurns"
    v19 = Convert v18 declared={type=number site=w5}
    v20 = Add v13, v19
    PropSet v7, v20 key="answer"
    v22 = Undefined
    Return v22
}
function f1 name="inHalves" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Double number=1000.5
    v2 = Mod v0, v1
    v3 = Convert v2 declared={type=number site=w1}
    Return v3
}
function f2 name="inTurns" module=m0 position=68 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Double number=6.283185307179586
    v2 = Mod v0, v1
    v3 = Convert v2 declared={type=number site=w3}
    Return v3
}

# A dividend smaller than the divisor is the remainder. Otherwise |value| - trunc(|value| / 1000.5) * 1000.5, with a product in place of the division. fmod is called only for a quotient too large for an exact product.
# CHECK-LABEL: name="inHalves" role=Source
# CHECK: Int32 b@{{*}} = LessThan(b@[[magnitude]], {{*}}:Mod)
# CHECK: Double b@[[scaled]] = Mul(b@[[magnitude]], {{*}}:Mod)
# CHECK-NEXT: Double b@[[quotient]] = FTrunc(b@[[scaled]], {{*}}:Mod)
# CHECK: Int32 b@[[isSmall]] = LessThan(b@[[quotient]], {{*}}:Mod)
# CHECK-NEXT: Branch(b@[[isSmall]], Terminal, {{*}}:Mod)
# CHECK-NEXT: Successors: Then:#{{*}}, Else:Rare:#
# CHECK: Double b@[[product]] = Mul(b@[[quotient]], {{*}}:Mod)
# CHECK-NEXT: Double b@[[difference]] = Sub(b@[[magnitude]], b@[[product]], {{*}}:Mod)
# CHECK: Int32 b@{{*}} = GreaterEqual(b@[[difference]], {{*}}:Mod)
# CHECK: Double b@{{*}} = BitOr(b@{{*}}, b@{{*}}, {{*}}:Mod)
# CHECK-LABEL: end of function

# This divisor has too many bits for an exact product, so its high and low halves are multiplied apart.
# CHECK-LABEL: name="inTurns" role=Source
# CHECK: Double b@[[quotient]] = FTrunc(b@{{*}}, {{*}}:Mod)
# CHECK: Double b@[[highProduct]] = Mul(b@[[quotient]], {{*}}:Mod)
# CHECK-NEXT: Double b@[[partial]] = Sub(b@{{*}}, b@[[highProduct]], {{*}}:Mod)
# CHECK: Double b@[[lowProduct]] = Mul(b@[[quotient]], {{*}}:Mod)
# CHECK-NEXT: Double b@{{*}} = Sub(b@[[partial]], b@[[lowProduct]], {{*}}:Mod)
# CHECK-LABEL: end of function
