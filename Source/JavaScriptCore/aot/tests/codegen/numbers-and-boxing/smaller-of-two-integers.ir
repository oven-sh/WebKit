# function pick(a: number, b: number): number { return Math.min(a, b); }
# declare const input: any;
# (globalThis as any).answer = pick(input | 0, input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 position=25 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=126 kind=CallResult
typesite w4 module=m0 position=53 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="input" [isFreeName]
    v13 = Convert v12 declared={type=i32 flags=[IsExpected]}
    v14 = Integer
    v15 = BitOr v13, v14
    v16 = Call v1, -, v10, v15 calleeName="pick"
    v17 = Convert v16 declared={type=number site=w3}
    PropSet v5, v17 key="answer"
    v19 = Undefined
    Return v19
}
function f1 name="pick" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Builtin builtin=Math
    v3 = Builtin builtin=MathMin
    v4 = Call v3, v2, v0, v1 calleeName="Math.min"
    ReturnCall v4 casts=[{declared={type=number site=w4}}, {declared={type=number site=w2}}]
}

# Math.min of two 32-bit integers compares them as integers and selects one: no branch, no double comparison, no test for NaN or -0.
# CHECK-LABEL: name="pick" role=Source
# CHECK: Int32 b@[[isBelow]] = LessThan(b@[[a]], b@[[b]], {{*}}:CallInline)
# CHECK-NEXT: Int64 b@[[wide]] = Select(b@[[isBelow]], b@{{*}}, b@{{*}}, {{*}}:CallInline)
# CHECK-NEXT: Int32 b@[[smaller]] = Trunc(b@[[wide]], {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[smaller]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="pick" role=Source
# NONE-NOT: FMin
# NONE-NOT: IToD
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# Both operands are widened ahead of the select. The function hands its result back as an integer.
# X64: instructions: 4, patchpoints: 0
# ARM64: instructions: 4, patchpoints: 0
