# function tenth(a: number): number { return (a / 10) >>> 0; }
# declare const input: any;
# (globalThis as any).answer = tenth(input >>> 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=15 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=116 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = URShift v8, v9
    v11 = Call v1, -, v10 calleeName="tenth"
    v12 = Convert v11 declared={type=number site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="tenth" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer integer=10
    v2 = Div v0, v1
    v3 = Integer
    v4 = URShift v2, v3
    v5 = Convert v4 declared={type=number site=w1}
    Return v5
}

# (a / 10) >>> 0 of an integer in 0..4294967295 is the high half of an unsigned product with a constant and a shift.
# CHECK-LABEL: name="tenth" role=Source
# CHECK: Int32 b@[[high]] = UMulHigh(b@{{*}}, $-858993459(b@{{*}}), {{*}}:DivideIntegers)
# CHECK: Int32 b@[[quotient]] = ZShr(b@[[high]], $3(b@{{*}}), {{*}}:DivideIntegers)
# CHECK-NEXT: Int64 b@[[wide]] = ZExt32(b@[[quotient]], {{*}}:DivideIntegers)
# CHECK-NEXT: Return(b@[[wide]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="tenth" role=Source
# NONE-NOT: Div(
# NONE-NOT: IToD
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-LABEL: end of function
# X64: instructions: 5, patchpoints: 0
# ARM64: instructions: 5, patchpoints: 0
