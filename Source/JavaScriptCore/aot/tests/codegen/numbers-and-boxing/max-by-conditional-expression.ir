# function larger(a: number, b: number): number { return a > b ? a : b; }
# declare const input: any;
# (globalThis as any).answer = larger(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(X64): lower-to-air f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=16 kind=Parameter function=f1
typesite w1 module=m0 position=27 kind=Parameter function=f1
typesite w2 module=m0 kind=Result
typesite w3 module=m0 position=127 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=number flags=[IsExpected]}
    v9 = ToNumber v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="input" [isFreeName]
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    v13 = ToNumber v12
    v14 = Call v1, -, v9, v13 calleeName="larger"
    v15 = Convert v14 declared={type=number site=w3}
    PropSet v5, v15 key="answer"
    v17 = Undefined
    Return v17
}
function f1 name="larger" module=m0 flags=[IsChecked, HasExplicitName] length=2 thisType={type=anything} parameters=[{type=number site=w0}, {type=number site=w1}] results=[{type=number site=w2}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    Jump -> next b1()
  b1():
    v2 = Greater v0, v1
    Branch v2 -> taken b2(| 0, 1), notTaken b4(| 0, 1)
  b2(v3, v4):
    Jump -> next b3()
  b3():
    Jump -> next b6(v3)
  b4(v5, v6):
    Jump -> next b5()
  b5():
    Jump -> next b6(v6)
  b6(v7):
    v8 = Convert v7 declared={type=number site=w2}
    Return v8
}

# The expression chooses one of the two numbers that it compares. Which one hangs on the data, so nothing branches: the back end selects.
# CHECK-LABEL: name="larger" role=Source
# CHECK-NOT: Branch(
# CHECK: Int32 b@[[isAbove]] = GreaterThan(b@[[a]], b@[[b]]
# CHECK: Double b@[[chosen]] = Select(b@[[isAbove]], b@[[a]], b@[[b]]
# CHECK-NEXT: Return(b@[[chosen]], Terminal)
# CHECK-LABEL: end of function
# x86-64's maximum gives its second operand unless the first is above it, as the expression does.
# X64-LABEL: name="larger" role=Source
# X64-NEXT: BB#0:
# X64-NEXT: MaxOrSecondDouble %xmm1, %xmm0
# X64-NEXT: RetDouble %xmm0
# X64-NEXT: end of function
# ARM64-LABEL: name="larger" role=Source
# ARM64-NEXT: BB#0:
# ARM64-NEXT: MoveDoubleConditionallyDouble DoubleGreaterThanAndOrdered, %q0, %q1, %q0, %q1, %q0
# ARM64-NEXT: RetDouble %q0
# ARM64-NEXT: end of function
