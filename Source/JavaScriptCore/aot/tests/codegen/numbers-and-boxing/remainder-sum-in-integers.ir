# The remainder of whole numbers by a divisor that may be zero: zero goes to a rare arm, in front of the loop where the divisor stays the same. What is left is one division, and the sum that a list of 32-bit numbers takes is made in integers.
# -- source: remainder-sum-in-integers.js
# function sum(u, n) {
#   const a = new Int32Array(4);
#   for (let j = 0; j < n; j++) a[1] = a[1] + (j % u);
#   return a[1];
# }
# print(String(sum(id(40) | 0, id(1000) | 0)));
# print(String(sum(id(0) | 0, id(1000) | 0)));
# print(String(sum(id(-7) | 0, id(1000) | 0)));
# -- end of source
