# function low(value: number): number { return value & 0xffff; }
# function mixed(value: number): number { return (low(value) << 3) ^ low(value >> 16); }
# declare const input: any;
# (globalThis as any).answer = mixed(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f2
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1 f2
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=13 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=78 kind=Parameter function=f2
typesite w3 module=m0 position=63 kind=Result
typesite w4 module=m0 position=205 kind=CallResult
typesite w5 module=m0 position=111 kind=CallResult
typesite w6 module=m0 position=130 kind=CallResult
variable g0 name="low" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="mixed"
    v12 = Convert v11 declared={type=number site=w4}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="low" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Integer integer=65535
    v2 = BitAnd v0, v1
    v3 = Convert v2 declared={type=number site=w1}
    Return v3
}
function f2 name="mixed" module=m0 position=63 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w2}] results=[{type=number site=w3}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = GetModuleVariable variable=g0
    v2 = Call v1, -, v0 calleeName="low"
    v3 = Convert v2 declared={type=number site=w5}
    v4 = Integer integer=3
    v5 = LShift v3, v4
    v6 = GetModuleVariable variable=g0
    v7 = Integer integer=16
    v8 = RShift v0, v7
    v9 = Call v6, -, v8 calleeName="low"
    v10 = Convert v9 declared={type=number site=w6}
    v11 = BitXor v5, v10
    v12 = Convert v11 declared={type=number site=w3}
    Return v12
}

# A 32-bit integer goes to a function in a general register and comes back in one. The caller shifts and combines the results as they came back.
# CHECK-LABEL: name="mixed" role=Source
# CHECK: Int32 b@[[value]] = Trunc(b@{{*}})
# CHECK-NEXT: Int32 b@[[first]] = Patchpoint(b@[[value]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK: Int32 b@[[shifted]] = Shl(b@[[first]], $3(b@{{*}}), {{*}}:LShift)
# CHECK: Int32 b@[[upper]] = SShr(b@[[value]], $16(b@{{*}}), {{*}}:RShift)
# CHECK-NEXT: Int32 b@[[second]] = Patchpoint(b@[[upper]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Int32 b@[[mixed]] = BitXor(b@[[shifted]], b@[[second]], {{*}}:BitXor)
# CHECK-NEXT: Return(b@[[mixed]], Terminal)
# CHECK-LABEL: end of function
# Nothing becomes a double, gets a tag or loses one, and nothing is tested.
# NONE-LABEL: name="low" role=Source
# NONE-NOT: Double
# NONE-NOT: Branch(
# NONE-NOT: Reads:
# NONE-LABEL: end of function
# NONE-LABEL: name="mixed" role=Source
# NONE-NOT: Double
# NONE-NOT: Branch(
# NONE-NOT: Reads:
# NONE-NOT: Int64 b@{{*}} = Add(
# NONE-NOT: Int64 b@{{*}} = BitOr(
# NONE-LABEL: end of function
# value & 0xffff is one instruction and the return.
# X64: instructions: 2, patchpoints: 0
# ARM64: instructions: 2, patchpoints: 0
