# function size(a: number): number { return Math.abs(a); }
# declare const input: any;
# (globalThis as any).answer = size(input | 0);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f1
# REQUIRES: unsanitized-code
# RUN(NONE): lower-to-b3 optimized f1
# REQUIRES(NONE): unsanitized-code
# RUN(X64): lower-to-air size f1
# REQUIRES(X64): x86_64 unsanitized-code
# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
typesite w0 module=m0 position=14 kind=Parameter function=f1
typesite w1 module=m0 kind=Result
typesite w2 module=m0 position=112 kind=CallResult
typesite w3 module=m0 position=42 kind=CallResult
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Convert v4 declared={type=undefined|null|number|string|symbol|bigint|object flags=[IsExpected]}
    v6 = Builtin builtin=GlobalThis
    v7 = PropGet v6 key="input" [isFreeName]
    v8 = Convert v7 declared={type=i32 flags=[IsExpected]}
    v9 = Integer
    v10 = BitOr v8, v9
    v11 = Call v1, -, v10 calleeName="size"
    v12 = Convert v11 declared={type=number site=w2}
    PropSet v5, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="size" module=m0 flags=[IsChecked, HasExplicitName] length=1 thisType={type=anything} parameters=[{type=number site=w0}] results=[{type=number site=w1}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number):
    Jump -> next b1()
  b1():
    v1 = Builtin builtin=Math
    v2 = Builtin builtin=MathAbs
    v3 = Call v2, v1, v0 calleeName="Math.abs"
    ReturnCall v3 casts=[{declared={type=number site=w3}}, {declared={type=number site=w1}}]
}

# Math.abs of a 32-bit integer may be 2147483648. The integer is widened, and its sign, spread over 64 bits, is applied by an exclusive or and a subtraction: no branch.
# CHECK-LABEL: name="size" role=Source
# CHECK: Int64 b@[[wide]] = SExt32(b@{{*}}, {{*}}:CallInline)
# CHECK: Int64 b@[[sign]] = SShr(b@[[wide]], $63(b@{{*}}), {{*}}:CallInline)
# CHECK-NEXT: Int64 b@[[flipped]] = BitXor(b@[[wide]], b@[[sign]], {{*}}:CallInline)
# CHECK-NEXT: Int64 b@[[size]] = Sub(b@[[flipped]], b@[[sign]], {{*}}:CallInline)
# CHECK-NEXT: Double b@[[number]] = IToD(b@[[size]])
# CHECK-NEXT: Return(b@[[number]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="size" role=Source
# NONE-NOT: Patchpoint(
# NONE-NOT: Branch(
# NONE-NOT: Check
# NONE-LABEL: end of function
# X64: instructions: 7, patchpoints: 0
# ARM64: instructions: 6, patchpoints: 0
