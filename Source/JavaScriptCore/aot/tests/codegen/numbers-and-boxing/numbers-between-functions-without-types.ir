# RUN(ARM64): lower-to-air size f1
# REQUIRES(ARM64): arm64 unsanitized-code

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
variable g0 name="square" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]} illTypedCause=FromLooseType
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="globalThis" [isFreeName]
    v4 = Convert v3 declared={type=builtin(GlobalThis) flags=[IsExpected]}
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="input" [isFreeName]
    v7 = ToNumber v6
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="input" [isFreeName]
    v10 = ToNumber v9
    v11 = Call v1, -, v7, v10 calleeName="distance"
    v12 = Convert v11 declared={type=number flags=[IsExpected]}
    PropSet v4, v12 key="answer"
    v14 = Undefined
    Return v14
}
function f1 name="square" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
    Jump -> next b1()
  b1():
    v1 = Convert v0 declared={type=number flags=[IsExpected]}
    v2 = Mul v1, v1
    v3 = Convert v2 declared={type=number flags=[IsExpected]}
    Return v3
}
function f2 name="distance" module=m0 position=49 flags=[HasExplicitName] length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=number flags=[IsExpected]}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    Jump -> next b1()
  b1():
    v2 = Builtin builtin=Math
    v3 = Builtin builtin=MathSqrt
    v4 = GetModuleVariable variable=g0
    v5 = Convert v0 declared={type=number flags=[IsExpected]}
    v6 = Call v4, -, v5 calleeName="square"
    v7 = Convert v6 declared={type=number flags=[IsExpected]}
    v8 = GetModuleVariable variable=g0
    v9 = Convert v1 declared={type=number flags=[IsExpected]}
    v10 = Call v8, -, v9 calleeName="square"
    v11 = Convert v10 declared={type=number flags=[IsExpected]}
    v12 = Add v7, v11
    v13 = Call v3, v2, v12 calleeName="Math.sqrt"
    ReturnCall v13 casts=[{declared={type=number flags=[IsExpected]}}]
}

# Nothing declares a type here. Every caller passes numbers, so the functions take and return numbers in floating-point registers as typed ones do.
# CHECK-LABEL: name="distance" role=Source
# CHECK-NEXT: BB#0:
# CHECK-NEXT: Double b@[[x]] = ArgumentReg(
# CHECK-NEXT: Double b@[[xSquared]] = Patchpoint(b@[[x]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[y]] = ArgumentReg(
# CHECK-NEXT: Double b@[[ySquared]] = Patchpoint(b@[[y]]:Register({{*}}), resultConstraints = Register({{*}}), ControlDependent, {{*}}:CallDirect)
# CHECK-NEXT: Double b@[[sum]] = Add(b@[[xSquared]], b@[[ySquared]], {{*}}:Add)
# CHECK-NEXT: Double b@[[root]] = Sqrt(b@[[sum]], {{*}}:CallInline)
# CHECK-NEXT: Return(b@[[root]], Terminal)
# CHECK-LABEL: end of function
# NONE-LABEL: name="square" role=Source
# NONE-NOT: Int64
# NONE-NOT: Int32
# NONE-LABEL: end of function
# NONE-LABEL: name="distance" role=Source
# NONE-NOT: Int64
# NONE-NOT: Int32
# NONE-LABEL: end of function
# value * value is one multiplication and the return.
# X64: instructions: 2, patchpoints: 0
# ARM64: instructions: 2, patchpoints: 0
