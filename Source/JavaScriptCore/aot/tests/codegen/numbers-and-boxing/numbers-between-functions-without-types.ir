# function square(value) { return value * value; }
# function distance(x, y) { return Math.sqrt(square(x) + square(y)); }
# globalThis.answer = distance(+input, +input);
# FORM: AsRead
# OPTIONS: heat=EverythingIsHot disable=pass:InlineCalls
# RUN: lower-to-b3 optimized f2
