# Every sum and difference here is read by a bit operation alone, which takes its low 32 bits. All of them are 32-bit operations that wrap.
# CHECK-LABEL: name="countBits" role=Source
# CHECK: Int32 b@[[odd]] = BitAnd(b@{{*}}, $1431655765(b@{{*}}), {{*}}:BitAnd)
# CHECK: Int32 b@[[pairs]] = Sub(b@{{*}}, b@[[odd]], {{*}}:Sub)
# CHECK: Int32 b@[[lowPairs]] = BitAnd(b@[[pairs]], $858993459(b@{{*}}), {{*}}:BitAnd)
# CHECK: Int32 b@[[highPairs]] = BitAnd(b@{{*}}, $858993459(b@{{*}}), {{*}}:BitAnd)
# CHECK: Int32 b@[[nibbles]] = Add(b@[[lowPairs]], b@[[highPairs]], {{*}}:Add)
# CHECK: Int32 b@[[shifted]] = ZShr(b@[[nibbles]], $4(b@{{*}}), {{*}}:URShift)
# CHECK: Int32 b@[[bytes]] = Add(b@[[nibbles]], b@[[shifted]], {{*}}:Add)
# CHECK: Int32 b@[[masked]] = BitAnd(b@[[bytes]], $252645135(b@{{*}}), {{*}}:BitAnd)
# CHECK: Int32 b@[[product]] = Mul(b@[[masked]], $16843009(b@{{*}}), {{*}}:CallInline)
# CHECK: Int32 b@[[count]] = ZShr(b@[[product]], $24(b@{{*}}), {{*}}:URShift)
# CHECK-NEXT: Return(b@[[count]], Terminal)
# CHECK-LABEL: end of function
