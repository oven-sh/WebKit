# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; class MyError extends Error { constructor(message) { super(message); log += "made;"; } } const printing = { toString() { log += "printed;"; return "text"; } }; const refusing = { toString() { log += "refused;"; throw new RangeError("no text"); } }; function plain(bad) { try { if (bad) throw "bad"; return "fine"; } catch { return "caught"; } } function made(bad) { try { if (bad) throw new Error("bad"); return "fine"; } catch { return "caught"; } } function converts(bad, message) { try { if (bad) throw new Error(message); return "fine"; } catch { return "caught"; } } function own(bad) { try { if (bad) throw new MyError("bad"); return "fine"; } catch { return "caught"; } } function called(bad, make) { try { if (bad) throw make(); return "fine"; } catch { return "caught"; } } function reads(bad) { try { if (bad) throw new Error("bad"); return "fine"; } catch (e) { return e.message; } } function between(bad) { try { try { if (bad) throw new Error("bad"); return "fine"; } finally { log += "finally;"; } } catch { return "caught"; } } function inLoop(n) { let i = 0; try { for (;i < n; i++) { if (i === 3) throw new Error("three"); } } catch { return "caught" + i; } return "done" + i; } function stored(stop) { let at = "start"; try { at = "one"; if (stop === 1) throw new Error("1"); at = "two"; if (stop === 2) throw new Error("2"); at = "three"; } catch { return "caught " + at; } return "done " + at; } function both(o) { try { if (o.bad) throw new Error("bad"); return o.value.deep; } catch { return "caught"; } } function again(bad) { try { try { if (bad) throw new Error("inner"); } catch { throw new Error("outer"); } return "fine"; } catch (e) { return e.message; } } function goesOn(bad) { let text = "a"; try { text += "b"; if (bad) throw new Error("bad"); text += "c"; } catch { text += "d"; } return text + "e"; } function after(bad) { let kept; try { if (bad) { kept = new Error("kept"); throw kept; } } catch {} return kept ? kept.message : "none"; } function tell(f) { log = ""; try { report(f()); } catch (e) { report(e.name + e.message); } report(log); } function each(f) { tell(() => f(false)); tell(() => f(true)); tell(() => f(0)); tell(() => f("x")); } each(plain); each(made); each((bad) => converts(bad, "text")); each((bad) => converts(bad, printing)); each((bad) => converts(bad, refusing)); each((bad) => converts(bad, Symbol("no text"))); each((bad) => converts(bad, undefined)); each(own); each((bad) => called(bad, () => { log += "called;"; return 1; })); each((bad) => called(bad, () => { log += "threw;"; throw new RangeError("inside"); })); each(reads); each(between); tell(() => inLoop(2)); tell(() => inLoop(9)); tell(() => stored(0)); tell(() => stored(1)); tell(() => stored(2)); tell(() => both({ bad: true })); tell(() => both({ bad: false, value: { deep: "deep" } })); tell(() => both({ bad: false })); tell(() => both(null)); each(again); each(goesOn); each(after); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
