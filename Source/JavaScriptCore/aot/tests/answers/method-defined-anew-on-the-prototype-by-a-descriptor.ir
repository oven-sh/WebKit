# class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } }
# function stepOf(counter, by) { return counter.step(by) }
# const counter = new Counter(10);
# report(stepOf(counter, 1));
# Object.defineProperty(Counter.prototype, "step", { value(by) { return this.count - by }, configurable: true });
# report(stepOf(counter, 1));
# Object.defineProperty(Counter.prototype, "step", { get() { return () => "from a getter" }, configurable: true });
# report(stepOf(counter, 1));
# Object.defineProperty(counter, "step", { value() { return "own" } });
# report(stepOf(counter, 1));
# report(stepOf(new Counter(1), 1));
# report("end");
# Object.defineProperty() replaces a method by another value, then by a getter, then hides it on one instance.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } } function stepOf(counter, by) { return counter.step(by) } const counter = new Counter(10); report(stepOf(counter, 1)); Object.defineProperty(Counter.prototype, "step", { value(by) { return this.count - by }, configurable: true }); report(stepOf(counter, 1)); Object.defineProperty(Counter.prototype, "step", { get() { return () => "from a getter" }, configurable: true }); report(stepOf(counter, 1)); Object.defineProperty(counter, "step", { value() { return "own" } }); report(stepOf(counter, 1)); report(stepOf(new Counter(1), 1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 6 of 6 of 6
# CHECK-NEXT: exited with 0

