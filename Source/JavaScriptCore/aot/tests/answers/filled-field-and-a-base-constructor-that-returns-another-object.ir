# The base constructor returns another object, so the derived constructor stores into that one.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const other = { tag: 1 }; class A { constructor(v) { this.a = 1; if (v) return other; } } class B extends A { constructor(v) { super(v); this.b = 2; } readB() { return this.b; } } function readA(x) { return x.a; } function readB(x) { return x.b; } const swapped = new B(true); report(swapped === other); report(readA(swapped)); report(readB(swapped)); report(swapped.tag); const made = new B(false); report(readA(made)); report(made.readB()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
