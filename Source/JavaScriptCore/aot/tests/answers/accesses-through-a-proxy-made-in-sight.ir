# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function reads(v) { const p = new Proxy({ x: v }, { get(t, k) { return String(k) + "!" + String(t.x); } }); return p.x; } function keyed(v, k) { const p = new Proxy({ x: v }, { get(t, key) { return typeof key + ":" + String(key); } }); return p[k]; } function noTrap(v) { const p = new Proxy({ x: v, get y() { return this === p; } }, {}); return String(p.x) + String(p.y) + String("x" in p) + String(delete p.x) + String(p.x); } function notCallable(v) { const p = new Proxy({ x: v }, { get: 1 }); return p.x; } function nullTrap(v) { const p = new Proxy({ x: v }, { get: null, has: undefined }); return String(p.x) + String("x" in p); } function bound(v, answer) { const p = new Proxy(Object.freeze({ x: v }), { get() { return answer; } }); return p.x; } function replaced(v) { const h = { get() { return "first"; } }; const p = new Proxy({ x: v }, h); const a = p.x; h.get = () => "second"; const b = p.x; delete h.get; return a + b + String(p.x); } function receiver(v) { const h = { get(t, k, r) { return String(r === p) + String(this === h); } }; const p = new Proxy({ x: v }, h); return p.x; } function circle(v) { const p = new Proxy({ x: v }, { get(t, k, r) { return k === "x" ? r.y : "end"; } }); return p.x; } function stores(v, consent) { let log = ""; const t = { x: 0 }; const p = new Proxy(t, { set(o, k, given, r) { log += String(k) + String(given) + String(r === p); o[k] = given; return consent; } }); p.x = v; return log + String(t.x); } function storesBound(v) { const p = new Proxy(Object.freeze({ x: 0 }), { set() { return true; } }); p.x = v; return "stored"; } function asks(answer) { const p = new Proxy({ x: 1 }, { has(t, k) { return answer; } }); return "x" in p; } function asksBound(answer) { const p = new Proxy(Object.freeze({ x: 1 }), { has() { return answer; } }); return "x" in p; } function deletes(consent) { const p = new Proxy({ x: 1 }, { deleteProperty(t, k) { return consent; } }); return delete p.x; } function deletesBound() { const p = new Proxy(Object.freeze({ x: 1 }), { deleteProperty() { return true; } }); return delete p.x; } function owns(answer) { const p = new Proxy({ x: 1 }, { getOwnPropertyDescriptor() { return answer; } }); return Object.hasOwn(p, "x"); } function throws() { const p = new Proxy({ x: 1 }, { get() { throw new RangeError("trap"); } }); return p.x; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => reads(1)); tell(() => reads(2)); tell(() => keyed(1, "x")); tell(() => keyed(1, 5)); tell(() => keyed(1, 1.5)); tell(() => keyed(1, Symbol.iterator)); tell(() => keyed(1, { toString() { return "made"; } })); tell(() => keyed(1, null)); tell(() => noTrap(1)); tell(() => notCallable(1)); tell(() => nullTrap(1)); tell(() => bound(1, 1)); tell(() => bound(1, 2)); tell(() => replaced(1)); tell(() => receiver(1)); tell(() => circle(1)); tell(() => stores(4, true)); tell(() => stores(4, 0)); tell(() => storesBound(0)); tell(() => storesBound(4)); tell(() => asks(1)); tell(() => asks("")); tell(() => asksBound(true)); tell(() => asksBound(false)); tell(() => deletes(1)); tell(() => deletes(0)); tell(() => deletesBound()); tell(() => owns(undefined)); tell(() => owns({ value: 1, configurable: true, enumerable: true, writable: true })); tell(() => owns(5)); tell(() => throws()); tell(() => { let s = ""; for (let i = 0;i < 300; i++) s = reads(i); return s; }); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
