# Reflect.construct() with a plain function as new.target: the constructor of the class makes an object that stands below another prototype object.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } get twice() { return this.count * 2 } } function Stranger() { } Stranger.prototype.step = function (by) { return this.count * by }; function stepOf(counter, by) { return counter.step(by) } const plain = new Counter(10); const strange = Reflect.construct(Counter, [20], Stranger); report(stepOf(plain, 3)); report(stepOf(strange, 3)); report(plain.twice); report(strange.twice); report(strange instanceof Counter); report(strange instanceof Stranger); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
