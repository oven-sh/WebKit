# Object.create refuses what is neither an object nor null before the call behind it runs: the count of calls stands still for each value that is refused.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const members = { get size() { return this.items; } }; let calls = 0; function g() { calls++; return 7; } function make(proto) { const made = Object.create(proto); made.items = g(); return made; } function attempt(value) { try { make(value); return "made"; } catch (error) { return error instanceof TypeError ? "TypeError" : "another error"; } } report(make(members).size); report(calls); report(attempt(1)); report(calls); report(attempt("text")); report(attempt(undefined)); report(attempt(true)); report(calls); report(make(null).items); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 11 of 11 of 11
# CHECK-NEXT: exited with 0

