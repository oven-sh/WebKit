# DELETED-NEXT: full 4
# DELETED-NEXT: exited with 0
# A hundred names more, three times: from the third time on the extra properties stay a dictionary, which takes a name and keeps its Structure: the Structure that names it is never remembered.
# RUN(DICTIONARY): run-in-shell drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; const d = extra(); for (let round = 0; round < 4; round++) { for (let k = 0; k < 100; k++) d["p" + round + "_" + k] = k; let wrong = 0; for (let t = 0; t < 12800; t++) { if (!road(d).endsWith(" undefined")) wrong++; } d.missing = round; print(wrong, road(d)); delete d.missing; } };
