# An accessor under the asked name: the question runs no code, the read behind its no runs the getter once. (`fresh` makes the object itself: the layout is proven without the door, which an accessor closes.)
# RUN(ACCESSOR): run-in-shell drive = function ({ Meter, fresh }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; let calls = 0; const plain = o => { o.unrelated = 1; }; print(warm(fresh, () => plain, "lacks undefined")); const got = o => { o.unrelated = 1; Object.defineProperty(o, "missing", { get() { calls++; return "got"; }, configurable: true }); }; print(fresh(got), calls); print(warm(fresh, () => got, "may hold got"), calls); };
