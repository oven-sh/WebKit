# `$findsNoMember(object, "missing")` ON AN OBJECT THAT HOLDS OTHER PROPERTIES OF ITS OWN BESIDE ITS FIELDS. The operation asked the bit of the order word and said no wherever it was set: a framework that lays
# anything at all on each request of a server sent every question down the road that asks the object. Where the bit is set, a rare arm now calls one shared stub at the place of the question:
# the Structure of the object against those that the place remembers to lack the name among the extra properties (two; four more once a third kind has come). A miss says no, which says nothing, and is counted as every miss at a place is; every 32nd
# goes into the run time, which files the Structure only where it NAMES the Structure of the extra properties, and that one is no dictionary and lacks the name. No field outside its slot, the layout's prototype
# and the guard of the name are asked behind the arm as they were.
# A YES NO LONGER SAYS THAT THE OBJECT HOLDS NOTHING BESIDE ITS FIELDS. It is noted of the object AND THE NAME: the read of that name behind it is `undefined` with no test, a second question about it asks
# nothing of the cell, a read or a question under another name asks for itself; a store under a key that nobody knows, a call and an await end the note; a store into a field does not.
# function Meter(level) { this.level = level; this.count = 1; }
# Meter.prototype.read = function () { return this.level; };
# function road(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) return "short " + object.missing; return "full " + object.missing; }
# function fresh(decorate) { const object = new Meter(4); decorate(object); return $findsNoMember(object, "missing") ? "lacks " + object.missing : "may hold " + object.missing; }
# function taught(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) return "short " + object.unrelated + " " + object.missing; return "full " + object.unrelated + " " + object.missing; }
# function twice(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing") && $findsNoMember(object, "other") && $findsNoMember(object, "missing")) return "short " + object.missing + " " + object.other; return "full " + object.missing + " " + object.other; }
# function stored(object, name) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { object[name] = "stored"; return "short " + object.missing; } return "full " + object.missing; }
# function called(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { amid(object); return "short " + object.missing; } return "full " + object.missing; }
# function caught(object) { try { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { amid(object); return "short " + object.missing; } } catch (error) { return "caught " + object.missing; } return "full " + object.missing; }
# function turns(object, count, name) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { for (let turn = 0; turn < count; turn++) object[name] = turn; return "short " + object.missing; } return "full " + object.missing; }
# function looped(object, count, name) { let text = "seen"; if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { for (let turn = 0; turn < count; turn++) { text += " " + object.missing; object[name] = turn; } } return text; }
# function aliased(object, same) { if ($isPlainInstanceOf(object, Meter) && $isPlainInstanceOf(same, Meter) && $findsNoMember(object, "missing")) { same.missing = "alias"; return "short " + object.missing; } return "full " + object.missing; }
# async function awaited(object, promise) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { await promise; return "short " + object.missing; } return "full " + object.missing; }
# function inner(object) { return $findsNoMember(object, "missing"); }
# function outer(object) { if (!$isPlainInstanceOf(object, Meter)) return "-"; return (inner(object) ? "lacks " : "may hold ") + object.missing; }
# function beside(object) { if (!$isPlainInstanceOf(object, Meter)) return "-"; return (inner(object) ? "lacks " : "may hold ") + object.missing; }
# function odd(object) { if (!$isPlainInstanceOf(object, Meter)) return "-"; return $findsNoMember(object, "0") ? "lacks" : "may hold"; }
# drive({ Meter, road, fresh, taught, twice, stored, called, caught, turns, looped, aliased, awaited, outer, beside, odd });
# f3 = road . f5 = taught . f6 = twice . f7 = stored . f16 = odd
# OPTIONS: mechanisms=all
# RUN(FORM): walk f3
# FORM: String string=made "short undefined"
# FORM: = FindsNoMember {{*}}key="missing" conditions=[{layout=L0 key="missing"}] receivers=[L0] [asksForNoExtraPropertyUnderKey]
# FORM-NEXT: Branch
# FORM-NEXT: b{{*}}():
# FORM-NOT: = PropGet
# FORM: Return
# The stub is called out of the rare arm alone.
# RUN(STUB): bytes f3
# STUB: SiteCache {{*}} "missing" 10
# STUB: FindsNoExtraPropertyAtSite
# The read of the other name behind the yes looks at the cell for itself.
# RUN(TAUGHTFORM): walk f5
# TAUGHTFORM: = FindsNoMember {{*}}key="missing"
# TAUGHTFORM: = HasNoExtraProperties
# Each name asks the cell once: the third question, about the first name again, asks nothing of it.
# RUN(TWICEFORM): walk f6
# TWICEFORM: = FindsNoMember {{*}}key="missing" {{*}}[asksForNoExtraPropertyUnderKey]
# TWICEFORM: = FindsNoMember {{*}}key="other" {{*}}[asksForNoExtraPropertyUnderKey]
# TWICEFORM: = FindsNoMember {{*}}key="missing" receivers=[L0] traits
# The store under a key that nobody knows ends the note: the read behind it is a read.
# RUN(STOREDFORM): walk f7
# STOREDFORM: = FindsNoMember {{*}}key="missing"
# STOREDFORM: = ElemSet
# STOREDFORM: = HasNoExtraProperties
# A key that is looked up as an index is not stamped: false says nothing.
# RUN(ODDFORM): walk f16
# ODDFORM-NOT: receivers=[L0] [asksFor
# THE PLACE. The first question misses; the road behind its no reads the name, which makes the Structure of the object name the one of its extra properties; then the place is filled and stays so.
# RUN(WARM): run-in-shell --aotCountsPath=/dev/null drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; print(road(extra())); print(warm(road, extra, "short undefined"), aotOperationCount("operationAOTFillSiteAnswers") < 40 ? "and is asked no more" : "and is filled again and again"); print(road(extra()), road(new Meter(2))); };
# WARM: full undefined
# WARM-NEXT: the place answers and is asked no more
# WARM-NEXT: short undefined short undefined
# WARM-NEXT: exited with 0
# Objects of six kinds at one place: it keeps the Structures of all six, past a collection while an object of each kind lives.
# RUN(MANY): run-in-shell drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; const kinds = []; for (let k = 0; k < 6; k++) kinds.push(() => { const o = new Meter(1); o["kind" + k] = 1; return o; }); for (let t = 0; t < 96000; t++) road(kinds[t % 6]()); const kept = kinds.map(make => make()); const all = () => { let short = 0; for (let t = 0; t < 6000; t++) { if (road(kinds[t % 6]()) === "short undefined") short++; } return short === 6000 ? "the place holds all six" : "the place holds too few: " + short; }; print(all()); gc(); print(all()); kept[5].missing = 1; print(road(kept[5]), road(kept[0]), road(kinds[5]())); };
# MANY: the place holds all six
# MANY-NEXT: the place holds all six
# MANY-NEXT: full 1 short undefined short undefined
# MANY-NEXT: exited with 0
# WHO COULD LAY THE NAME. The object itself, between two questions at one place: the Structure in front is remembered, the one behind is another.
# RUN(LAID): run-in-shell drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; print(warm(road, extra, "short undefined")); const o = extra(); print(road(o)); o.missing = 1; print(road(o), road(extra())); const early = () => { const o = new Meter(1); o.missing = 2; o.unrelated = 1; return o; }; print(warm(road, early, "full 2")); };
# LAID: the place answers
# LAID-NEXT: short undefined
# LAID-NEXT: full 1 short undefined
# LAID-NEXT: the place answers
# LAID-NEXT: exited with 0
# Laid and deleted again: each step gives the extra properties another Structure.
# RUN(DELETED): run-in-shell drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; print(warm(road, extra, "short undefined")); const d = extra(); for (let i = 0; i < 2; i++) { d.missing = 1; delete d.missing; } let wrong = 0; for (let t = 0; t < 6400; t++) { if (!road(d).endsWith(" undefined")) wrong++; } d.missing = 3; print(wrong, road(d)); delete d.missing; print(road(d).endsWith(" undefined")); d.missing = 4; print(road(d)); };
