# if (parseFloat("3.5")) print("seen"); print("went on")
# The lie: every row of native code writes undefined or null for its result. So the test is answered while the program is compiled, its arm goes, and nothing is left that reads the call.
# The row of parseFloat neither throws nor writes, so by its effects the call might go where nothing reads it. The stop that holds what arrives against the row lies in the code of the call: the call stays.
# OPTIONS: testing=NativeCodeAnswersNullish
# RUN(CODE): walk f0:Body mechanisms=all
# CODE-LABEL: code f0:Body
# CODE: undefined|null @JSValue = CallBuiltin
# CODE-NOT: "seen"
# RUN: run-in-shell mechanisms=all
# CHECK: AOT: parseFloat (call) is declared as undefined | null, and native code answered with something else: number. This is a bug in Bun.
# CHECK-NOT: went on
# CHECK: crashed with

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = String string="3.5"
    v2 = Builtin builtin=ParseFloat
    v3 = Call v2, -, v1 calleeName="parseFloat"
    v4 = ToBoolean v3
    v5 = PropGet v0 key="print" [isFreeName]
    Branch v4 -> taken b1(), notTaken b2()
  b1():
    v6 = String string="seen"
    v7 = Call v5, -, v6 calleeName="print"
    Jump -> next b2()
  b2():
    v8 = String string="went on"
    v9 = Call v5, -, v8 calleeName="print"
    v10 = Undefined
    Return v10
}
