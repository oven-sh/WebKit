# A walk over a Map or a Set gives what the language says, whatever becomes of the table under it.
# function sum(set) { let total = 0; for (const value of set) total = total + value; return total; }   wide keys, narrow keys, no table
# function grow(set) { let turns = 0; for (const value of set) { if (value < 40) set.add(value + 1); turns++; } return turns; }   the table is replaced again and again
# function drop(set) { let turns = 0; for (const value of set) { set.delete(value + 1); turns++; } return turns; }   deleted entries
# function weigh(map) { let total = 0; for (const [key, value] of map) total = total + (value + key.length); return total; }
# function clears(set) { let turns = 0; for (const value of set) { if (value === 1) { set.clear(); set.add(7); } turns++; } return turns; }   a new table, and a small one emptied entry by entry
# function widens(map) { let total = 0; for (const [key, value] of map) { map.set(key, 0.5); total = total + value; } return total; }   a table of the same capacity with wider values
# function shrinks(set) { let turns = 0; for (const value of set) { if (value === 0) for (let i = 1; i < 45; i++) set.delete(i); turns++; } return turns; }   a smaller table, entries renumbered
# function constant() { let total = 0; for (const value of new Set(["a", "bc"])) total = total + value.length; return total; }   a table in the image
# function early(set) { const values = set.values(); set.add(1); let total = 0; for (const value of values) total = total + value; return total; }   no table when the iterator is made
# function catches(set) { let total = 0; for (const value of set) { try { if (value === 2) throw value; total = total + value; } catch { } } return total; }
# function nested(set) { let turns = 0; for (const a of set) for (const b of set) { if (b < 3) set.add(b + 10); turns++; } return turns; }
# function promised(map: Map<string, string>) { let turns = 0; for (const value of map.values()) turns++; return turns; }   called with a Map that holds a number
# function byKeys(map), byValues(map), byEntries(map): for (const x of map.keys() | map.values() | map.entries())
