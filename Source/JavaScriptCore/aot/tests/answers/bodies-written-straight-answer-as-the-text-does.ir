# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function tell(f) { try { return String(f()); } catch (e) { return "threw " + e.name; } } function sums(a, b) { return [a + b, a - b, a * b, a / b, a % b, a ** 2, -a, +b, a | b, a & b, a ^ b, a << 1, a >> 1, a >>> 1, ~a].join(" "); } function compares(a, b) { return [a < b, a <= b, a > b, a >= b, a == b, a != b, a === b, a !== b, !a, !!b, typeof a, typeof b].join(" "); } function chooses(a, b) { return [a && b, a || b, a ?? b, a ? 1 : 2, a?.x, a?.[0]].join(" "); } function reads(o, k) { return [o.x, o[k], "x" in o, k in o, delete o.gone, o.gone, Object.keys(o).length].join(" "); } function writes(o, k, v) { o.x = v; o[k] = v + 1; o.n ??= 5; o.m ||= 6; o.x += 2; o[k]++; return o.x + ":" + o[k] + ":" + o.n + ":" + o.m; } function makes(a, b) { const o = { a, b, [a + "k"]: b, get sum() { return this.a + this.b; }, set both(v) { this.a = v; this.b = v; }, twice() { return this.sum * 2; } }; const before = o.twice(); o.both = 4; return before + ":" + o.sum + ":" + o[a + "k"]; } function lists(a, b) { const l = [a, , b, ...[a, b]]; const [x, , y = 9, ...rest] = l; return l.length + ":" + x + ":" + y + ":" + rest.length + ":" + (1 in l); } function takes({ p, q = 3, ...others }, ...more) { return p + ":" + q + ":" + Object.keys(others).length + ":" + more.length; } function counts(n) { let s = 0; for (let i = 0;i < n; i++) { if (i === 2) continue; if (i === 6) break; s += i; } let j = 0; while (j < n) j += 2; do { j--; } while (j > n); return s + ":" + j; } function names(o) { let s = ""; for (const k in o) s += k + "=" + o[k] + ";"; return s; } function picks(v) { switch (v) { case 1: return "one"; case "two": return "two"; case 3: case 4: v += 10; default: return "other " + v; } } function words(v) { switch (v) { case "alpha": return 1; case "beta": return 2; case "gamma": return 3; case "delta": return 4; case "epsilon": return 5; default: return 0; } } function closes(n) { let held = n; const up = () => ++held; const both = () => [up(), up(), held].join(","); return both; } function tries(v) { let trail = ""; try { trail += "a"; if (v === 1) throw new TypeError("one"); if (v === 2) return trail + "r"; trail += "b"; } catch (e) { trail += "c" + e.message; } finally { trail += "f"; report(trail); } return trail; } function nests(v) { let kept = "k" + v; try { try { kept += "1"; if (v) null[v]; kept += "2"; } finally { kept += "3"; } } catch (e) { return kept + e.name; } return kept; } function tails(n, sum) { return n === 0 ? sum : tails(n - 1, sum + n); } class Base { x; static made = 0; constructor(x) { this.x = x; Base.made++; } get twice() { return this.x * 2; } say() { return "base " + this.x; } static of(x) { return new this(x); } } class Derived extends Base { #hidden = 7; y = 5; constructor(x) { super(x + 1); } say() { return "derived " + super.say() + " " + this.#hidden + " " + this.y; } has(o) { return #hidden in o; } } function builds(x) { const d = Derived.of(x); return [d.say(), d.twice, d instanceof Base, d.has(d), d.has({}), Base.made].join(" "); } function texts(a, b) { return `${a}-${b}-${a + b}` + a.length + a[0] + (a < b); } function early() { const before = tell(() => late); let late = 1; return before + late; } function asks(f) { return tell(() => f()) + tell(() => new f) + tell(() => f.x.y); } for (const [a, b] of [[7, 2], [1.5, -3], ["4", 2], [null, undefined], [true, "x"], [{ x: 1 }, [2]]]) { report(tell(() => sums(a, b))); report(tell(() => compares(a, b))); report(tell(() => chooses(a, b))); } report(reads({ x: 1, y: 2, gone: 3 }, "y")); report(writes({}, "k", 1)); report(writes({ n: 0, m: 0 }, 0, "s")); report(makes(1, 2)); report(makes("s", "t")); report(lists(1, undefined)); report(takes({ p: 1, r: 2, s: 3 }, 4, 5)); report(counts(9)); report(names({ a: 1, b: "two", 3: 3 })); for (const v of [1, "two", 3, 4, 5, undefined]) report(picks(v)); for (const v of ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", 1]) report(words(v)); report(closes(5)()); for (const v of [0, 1, 2]) report(tries(v)); report(nests(0)); report(nests(1)); report(tails(20000, 0)); report(builds(1)); report(builds("s")); report(texts("ab", "cd")); report(early()); report(asks(undefined)); report(asks(() => 1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
