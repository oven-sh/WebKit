# CELL-NOT: NewHeapWords
# RUN(NOTHING): walk f5 mechanisms=all
# NOTHING-NOT: ForInOpen
# function count(o: unknown) { let n = 0; for (const k in o as any) n++; return n; }
# function names(o: unknown) { let text = ""; for (const k in o as any) text += k + ","; return text; }
# function changing(o: any) { let text = ""; for (const k in o) { text += k; if (k === "a") { delete o.b; o.z = 1; } } return text; }
# function skipping(o: any) { let text = ""; for (const k in o) { if (k === "b") continue; if (k === "d") break; text += k; } return text; }
# function nothing() { let n = 0; for (const k in undefined as any) n++; for (const k in null as any) n++; return n; }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# class Pair { first = 1; second = 2; method() { return 0; } }
# function below() { const o = Object.create({ up: 1, a: 0 }); o.a = 1; o.b = 2; return o; }
# function hidden() { const o: any = { a: 1, b: 2, c: 3 }; Object.defineProperty(o, "b", { enumerable: false }); return o; }
# function trapped() { return new Proxy({ a: 1, b: 2 }, { ownKeys() { return ["b", "a"]; } }); }
# tell(() => count({ a: 1, b: 2, c: 3 }));
# tell(() => count({}));
# tell(() => count(undefined));
# tell(() => count(null));
# tell(() => count(7));
# tell(() => count("abc"));
# tell(() => count([4, 5]));
# tell(() => count(new Pair()));
# tell(() => names({ a: 1, b: 2, c: 3 }));
# tell(() => names({ b: 1, a: 2, 1: 3, 0: 4 }));
# tell(() => names(new Pair()));
# tell(() => names(below()));
# tell(() => names(hidden()));
# tell(() => names(trapped()));
# tell(() => names("ab"));
# tell(() => names([7, , 9]));
# tell(() => names(JSON.parse('{"x":1,"y":{"z":2}}')));
# tell(() => changing({ a: 1, b: 2, c: 3 }));
# tell(() => changing({ c: 1, a: 2, b: 3, d: 4 }));
# tell(() => changing(JSON.parse('{"a":1,"b":2,"c":3}')));
# tell(() => skipping({ a: 1, b: 2, c: 3, d: 4, e: 5 }));
# tell(() => nothing());
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function count(o) { let n = 0; for (const k in o) n++; return n; } function names(o) { let text = ""; for (const k in o) text += k + ","; return text; } function changing(o) { let text = ""; for (const k in o) { text += k; if (k === "a") { delete o.b; o.z = 1; } } return text; } function skipping(o) { let text = ""; for (const k in o) { if (k === "b") continue; if (k === "d") break; text += k; } return text; } function nothing() { let n = 0; for (const k in undefined) n++; for (const k in null) n++; return n; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } class Pair { first = 1; second = 2; method() { return 0; } } function below() { const o = Object.create({ up: 1, a: 0 }); o.a = 1; o.b = 2; return o; } function hidden() { const o = { a: 1, b: 2, c: 3 }; Object.defineProperty(o, "b", { enumerable: false }); return o; } function trapped() { return new Proxy({ a: 1, b: 2 }, { ownKeys() { return ["b", "a"]; } }); } tell(() => count({ a: 1, b: 2, c: 3 })); tell(() => count({})); tell(() => count(undefined)); tell(() => count(null)); tell(() => count(7)); tell(() => count("abc")); tell(() => count([4, 5])); tell(() => count(new Pair)); tell(() => names({ a: 1, b: 2, c: 3 })); tell(() => names({ b: 1, a: 2, 1: 3, 0: 4 })); tell(() => names(new Pair)); tell(() => names(below())); tell(() => names(hidden())); tell(() => names(trapped())); tell(() => names("ab")); tell(() => names([7, , 9])); tell(() => names(JSON.parse('{"x":1,"y":{"z":2}}'))); tell(() => changing({ a: 1, b: 2, c: 3 })); tell(() => changing({ c: 1, a: 2, b: 3, d: 4 })); tell(() => changing(JSON.parse('{"a":1,"b":2,"c":3}'))); tell(() => skipping({ a: 1, b: 2, c: 3, d: 4, e: 5 })); tell(() => nothing()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
