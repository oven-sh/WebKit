# made of bec613126685b2e1
# `text = text + "b"` in a loop that is built twice: the text goes round in a string builder, which is begun at the head, behind the looks. The head of the other copy takes no builder, so no turn begins again,
# and the read behind a look at its slot keeps its closed arm. The look that is tried for the typed copy says the same: under the verifier the walk stops where something is built in a loop that the looks have not counted on.
# OPTIONS: check=Validate
# f1 = id, f2 = grows
# RUN(FORM): walk f1 f2 mechanisms=all-ParameterGuards
# FORM: = StackStringBuilderBegin
# function id<T>(value: T): T { (globalThis as any).leaked = value; return (globalThis as any).leaked; }
# type Box = { x: number };
# function grows(o: Box, n: number): string { let text: string | null = "a"; let i = 0; while (text !== null) { if (i >= n) break; if (o.x === i) { text = null; break; } text = text + "b"; i++; } return String(text) + i; }
# id(grows);
# report(grows(id({ x: 3 }), 9));
# report(grows(id({ x: 30 }), 4));
# report(grows(id({ y: 0, x: 2 }) as any, 9));
# report(grows((0, eval)("({ get x() { return 1; } })"), 9));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function id(value) { globalThis.leaked = value; return globalThis.leaked; } function grows(o, n) { let text = "a"; let i = 0; while (text !== null) { if (i >= n) break; if (o.x === i) { text = null; break; } text = text + "b"; i++; } return String(text) + i; } id(grows); report(grows(id({ x: 3 }), 9)); report(grows(id({ x: 30 }), 4)); report(grows(id({ y: 0, x: 2 }), 9)); report(grows((0, eval)("({ get x() { return 1; } })"), 9)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

