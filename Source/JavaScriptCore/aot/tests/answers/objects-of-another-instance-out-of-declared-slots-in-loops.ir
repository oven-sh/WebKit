# Two instances of the image in one heap, as in objects-of-another-instance-behind-a-test-of-their-shape.ir. Here the classes declare their fields: `held: Thing`.
# Each instance reads, once and in a loop, what a box holds and calls `who` on it: its own box, the other's, and boxes into which either instance has put a thing of either, once and in a loop.
# `who` answers with the `mark` of the instance that made its object, whoever asks and wherever the object lies. Without the question for the instance behind a shape: 7 of 21.
# class Thing { tag: number; constructor(tag: number) { this.tag = tag; } who() { return mark; } }
# class Box { held: Thing; constructor(held: Thing) { this.held = held; } askInLoop(turns: number) { let sum = 0; for (let i = 0; i < turns; i++) sum += this.held.who(); return sum; } }
# var mark = id(0);
# function thing() { return new Thing(1); }
# function box(held: Thing) { return new Box(held); }
# function put(box: Box, held: Thing) { box.held = held; }
# function putInLoop(box: Box, held: Thing, turns: number) { for (let i = 0; i < turns; i++) box.held = held; }
# function askBox(box: Box, turns: number) { return box.askInLoop(turns); }
# function readOnce(box: Box) { return box.held.who(); }
# function readInLoop(box: Box, turns: number) { let sum = 0; for (let i = 0; i < turns; i++) sum += box.held.who(); return sum; }
# function tagInLoop(box: Box, turns: number) { let sum = 0; for (let i = 0; i < turns; i++) sum += box.held.tag; return sum; }
# function own() { const t = thing(), b = box(t); put(b, t); putInLoop(b, t, 2); return askBox(b, 2) + readOnce(b) + readInLoop(b, 2) + tagInLoop(b, 2); }
# register(thing, box, put, putInLoop, askBox, readOnce, readInLoop, tagInLoop, own);
# LIBRARY: own
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ thing: f[0], box: f[1], put: f[2], putInLoop: f[3], askBox: f[4], readOnce: f[5], readInLoop: f[6], tagInLoop: f[7], own: f[8] }); const twin = (id, register) => { class Thing { tag; constructor(tag) { this.tag = tag; } who() { return mark; } } class Box { held; constructor(held) { this.held = held; } askInLoop(turns) { let sum = 0; for (let i = 0;i < turns; i++) sum += this.held.who(); return sum; } } var mark = id(0); function thing() { return new Thing(1); } function box(held) { return new Box(held); } function put(box, held) { box.held = held; } function putInLoop(box, held, turns) { for (let i = 0;i < turns; i++) box.held = held; } function askBox(box, turns) { return box.askInLoop(turns); } function readOnce(box) { return box.held.who(); } function readInLoop(box, turns) { let sum = 0; for (let i = 0;i < turns; i++) sum += box.held.who(); return sum; } function tagInLoop(box, turns) { let sum = 0; for (let i = 0;i < turns; i++) sum += box.held.tag; return sum; } function own() { const t = thing(), b = box(t); put(b, t); putInLoop(b, t, 2); return askBox(b, 2) + readOnce(b) + readInLoop(b, 2) + tagInLoop(b, 2); } register(thing, box, put, putInLoop, askBox, readOnce, readInLoop, tagInLoop, own); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; say("own", () => a.own() + "," + b.own()); const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const asked = held => x.askBox(held, 3) + "," + y.askBox(held, 3) + "," + x.readOnce(held) + "," + y.readOnce(held) + "," + x.readInLoop(held, 3) + "," + y.readInLoop(held, 3) + "," + x.tagInLoop(held, 3); say("own box", () => asked(x.box(x.thing()))); say("their box", () => asked(y.box(y.thing()))); say("their thing in a new box", () => asked(x.box(y.thing()))); say("we put ours into theirs", () => { const held = y.box(y.thing()); x.put(held, x.thing()); return asked(held); }); say("we put ours into theirs, in a loop", () => { const held = y.box(y.thing()); x.putInLoop(held, x.thing(), 3); return asked(held); }); say("we put theirs into ours", () => { const held = x.box(x.thing()); x.put(held, y.thing()); return asked(held); }); say("we put theirs into ours, in a loop", () => { const held = x.box(x.thing()); x.putInLoop(held, y.thing(), 3); return asked(held); }); say("they put theirs into ours", () => { const held = x.box(x.thing()); y.put(held, y.thing()); return asked(held); }); say("they put theirs into ours, in a loop", () => { const held = x.box(x.thing()); y.putInLoop(held, y.thing(), 3); return asked(held); }); say("they put ours into ours", () => { const held = x.box(x.thing()); y.putInLoop(held, x.thing(), 3); return asked(held); }); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
