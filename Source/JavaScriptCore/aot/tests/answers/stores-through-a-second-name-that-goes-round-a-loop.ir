# FORM: [[made]]: {{*}} = NewObject
# FORM: PutSlot {{*}}key="n"
# FORM: [[read]]: {{*}} = GetSlot [[made]] key="n"
# FORM-NEXT: Return [[read]]
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function sum(n) { const acc = { n: 0 }; let k = acc; for (let i = 0; i < n; i++) { k.n = (k.n + i) | 0; k = k; } return acc.n; } function swapped(n) { const a = { n: 0 }, b = { n: 100 }; let p = a, q = b; for (let i = 0; i < n; i++) { p.n += i; const t = p; p = q; q = t; } return a.n + ":" + b.n; } function leftByBreak(n) { const acc = { n: 0 }; let k = acc, i = 0; while (true) { if (i >= n) break; k.n += i; i++; k = k; } return acc.n; } function roundOuter(n) { const acc = { n: 0 }; let k = acc; for (let i = 0; i < n; i++) { for (let j = 0; j < n; j++) k.n += j; k = k; } return acc.n; } function madeInOuter(n) { let sum = 0; for (let i = 0; i < n; i++) { const acc = { n: i }; let k = acc; for (let j = 0; j < n; j++) { k.n += j; k = k; } sum += acc.n; } return sum; } function element(n) { const list = [0, 0]; let k = list; for (let i = 0; i < n; i++) { k[0] = (k[0] + i) | 0; k = k; } return list[0]; } function readInside(n) { const acc = { n: 0 }; let k = acc; let seen = ""; for (let i = 0; i < n; i++) { k.n += i; seen += acc.n + ","; k = k; } return seen + acc.n; } function storedUnderFirstName(n) { const acc = { n: 0 }; let k = acc; let seen = 0; for (let i = 0; i < n; i++) { acc.n += i; seen += k.n; k = k; } return seen + ":" + k.n; } report(sum(0)); report(sum(6)); report(swapped(6)); report(leftByBreak(6)); report(roundOuter(4)); report(madeInOuter(4)); report(element(6)); report(readInside(4)); report(storedUnderFirstName(4)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
