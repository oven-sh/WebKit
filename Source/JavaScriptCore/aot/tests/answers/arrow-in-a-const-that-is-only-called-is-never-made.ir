# made of f7c9718072ee7f09
# `const f = (..) => ..` in a function, called by its name behind the initialization, is entered itself, and a name that nobody reads has no closure
# a closure that is made in front of the initialization reads the name as ever, and throws where it is called early; a name that is also read as a value has its one closure
# f1 = outer, f4 = add, f5 = twice, f2 = early, f6 = run, f7 = filled, f3 = keeps, f8 = kept
# RUN(FORM): walk f1 mechanisms=none
# FORM-LABEL: code f1:Body
# FORM: = CallDirect {{*}}function=f5
# RUN(NEVER): walk f1 mechanisms=none
# NEVER-NOT: = NewClosure
# RUN(EARLY): walk f6 mechanisms=none
# EARLY: = CheckInitialized
# RUN(READS): walk f6 mechanisms=none
# READS-NOT: = CallDirect
# RUN(VALUE): walk f3 mechanisms=none
# VALUE: = NewClosure {{*}}function=f8
# function outer(a: number, b: number) { let n = 0; const add = (x: number): number => { n++; return x + a; }; const twice = (x: number): number => add(add(x)) + b; return twice(1) + add(2) + n; }
# function early(first: boolean) { let said = ""; const run = () => filled(); if (first) { try { said += run(); } catch (e) { said += "threw"; } } const filled = () => "filled"; return said + run() + filled(); }
# function keeps() { const kept = (x: number) => x + 1; return kept(1) === 2 ? kept : kept; }
# report(outer(10, 100));
# report(outer(1, 2));
# report(early(true));
# report(early(false));
# report(keeps()(4));
# report(keeps() === keeps());
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function outer(a, b) { let n = 0; const add = (x) => { n++; return x + a; }; const twice = (x) => add(add(x)) + b; return twice(1) + add(2) + n; } function early(first) { let said = ""; const run = () => filled(); if (first) { try { said += run(); } catch (e) { said += "threw"; } } const filled = () => "filled"; return said + run() + filled(); } function keeps() { const kept = (x) => x + 1; return kept(1) === 2 ? kept : kept; } report(outer(10, 100)); report(outer(1, 2)); report(early(true)); report(early(false)); report(keeps()(4)); report(keeps() === keeps()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
