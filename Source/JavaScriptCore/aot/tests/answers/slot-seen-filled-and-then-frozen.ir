t(has(make(1, 2))); report(around(make(1, 2), nothing)); report(around(make(1, 2), change)); report(hasAround(make(1, 2), nothing)); report(hasAround(make(1, 2), change)); const later = make(3, 4); report(read(later)); report(has(later)); change(later); report(read(later)); report(has(later)); report(around(later, nothing)); report(inLoop(make(1, 2), nothing, 2)); report(inLoop(make(1, 2), change, 0)); report(inLoop(make(1, 2), change, 2)); report(inLoop(make(1, 2), change, 4)); report(overList([make(1, 2), make(3, 4), make(5, 6)], nothing, 0)); report(overList([make(1, 2), make(3, 4), make(5, 6)], change, 0)); report(overList([make(1, 2), make(3, 4), make(5, 6)], change, 2)); report(readOfAny(list())); report(readOfAny(make(1, 2))); report(hasOfAny(list())); report(hasOfAny(make(1, 2))); report(aroundOfAny(list(), nothing)); report(aroundOfAny(make(1, 2), nothing)); report(aroundOfAny(make(1, 2), change)); report(aroundOfAny(list(), change)); const laterOfAny = make(5, 6); report(readOfAny(laterOfAny)); change(laterOfAny); report(readOfAny(laterOfAny)); report(hasOfAny(laterOfAny)); report(inLoopOfAny(list(), nothing, 1)); report(inLoopOfAny(make(1, 2), nothing, 1)); report(inLoopOfAny(make(1, 2), change, 0)); report(inLoopOfAny(make(1, 2), change, 2)); report(inLoopOfAny(make(1, 2), change, 4)); report(inLoopOfAny(list(), change, 2)); report(calls); function store(p, v) { try { p.x = v; p.y = v + 1; } catch (error) { calls += 1000; } const { x, y } = p; return x * 10 + y; } function readAndStore(p, hook, v) { const { x, y } = p; hook(p); try { p.x = v; p.y = v; } catch (error) { calls += 1000; } const { x: nextX, y: nextY } = p; return (x + y) * 100 + nextX + nextY; } function storeInLoop(p, hook, at) { let sum = 0; for (let i = 0;i < 5; i++) { const { x, y } = p; sum = sum * 3 + x + y; if (i === at) hook(p); try { p.x = x + 1; p.y = y + 2; } catch (error) { calls += 1000; } } return sum * 10 + p.x; } report(store(make(1, 2), 5)); const cold = make(1, 2); change(c