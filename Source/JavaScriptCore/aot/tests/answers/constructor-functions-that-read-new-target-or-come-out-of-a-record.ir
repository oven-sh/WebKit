# A constructor function whose callee is known, or held to be known, is constructed in the place of the call: the object is made there under the layout of the class.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function Point(x) { if (!new.target) return new Point(x + 100); this.x = x; this.y = new.target === Point ? 0 : 1; } Point.prototype.sum = function() { return this.x + this.y; }; function Answer(kind) { this.kind = kind; if (kind === 1) return { other: true }; if (kind === 2) return 7; if (kind === 3) return null; if (kind === 4) return Answer; } function Pair(a) { this.a = a; this.b = a + 1; } Pair.prototype.both = function() { return this.a * 10 + this.b; }; function Other(a) { this.c = a; } Other.prototype.both = function() { return -this.c; }; function Below(x) { Point.call(this, x); this.z = 5; } Below.prototype = Object.create(Point.prototype); const record = { Pair }; const holders = [record]; function leak(value) { holders.push(value); return holders.length; } leak(record); const swap = new Function("holder", "value", "holder.Pair = value"); function makePoint(n) { const p = new Point(n); return [p.x, p.y, p.sum(), p instanceof Point, Object.getPrototypeOf(p) === Point.prototype, Object.keys(p).join()].join("|"); } function callPoint(n) { const p = Point(n); return [p.x, p.y, p instanceof Point].join("|"); } function makeAnswer(kind) { const a = new Answer(kind); return [typeof a, a instanceof Answer, a === Answer, a.kind, a.other].join("|"); } function makePair(n) { const q = new record.Pair(n); return [q.both(), Object.keys(q).join(), q instanceof Pair].join("|"); } function makeBelow(n) { const b = new Below(n); return [b.x, b.y, b.z, b.sum(), b instanceof Point].join("|"); } function byReflect(n) { const p = Reflect.construct(Point, [n], Pair); return [p.x, p.y, p instanceof Point, p instanceof Pair].join("|"); } for (let n = 0;n < 3; n++) report(makePoint(n)); report(callPoint(4)); for (let kind = 0;kind < 5; kind++) report(makeAnswer(kind)); for (let n = 0;n < 3; n++) report(makePair(n)); report(makeBelow(6)); report(byReflect(7)); swap(record, Other); report(makePair(8)); swap(record, Pair); report(makePair(9)); Point.prototype = { sum() { return "replaced"; } }; report(makePoint(10)); swap(record, 5); try { report(makePair(11)); } catch (e) { report(e.name); } swap(record, () => 1); try { report(makePair(12)); } catch (e) { report(e.name); } Object.freeze(Pair.prototype); swap(record, Pair); report(makePair(13)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
