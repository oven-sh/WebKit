ne", new Below)); report(call("lone", Object.create(make(18, 19)))); report(call("lone", Object.create(null))); report(call("lone", "text")); report(call("lone", 20)); report(call("lone", true)); report(call("lone", Symbol("s"))); report(call("lone", lone)); report(call("lone", [21])); report(call("lone", Object.assign([22], { x: 23 }))); report(call("lone", new Proxy({}, { get(target, key) { return key === "x" ? 24 : 25; } }))); report(call("guarded", make(26, 27))); report(call("guarded", undefined)); report(call("guarded", null)); report(call("chain", { p: make(28, 29) })); report(call("chain", { p: { x: 30 } })); report(call("chain", { p: "text" })); report(call("lone", make(31, 32))); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
