 5; const standsBelowAnotherList = [1, , 3]; Object.setPrototypeOf(standsBelowAnotherList, above); all(standsBelowAnotherList); const textsBelowAnotherList = ["a", , "c"]; Object.setPrototypeOf(textsBelowAnotherList, above); all(textsBelowAnotherList); const withoutPrototype = [1, 2, 3]; Object.setPrototypeOf(withoutPrototype, null); all(withoutPrototype); const named = ["a", "b"]; named[-1] = "below zero"; named.extra = 1; all(named); const withGetter = [1, 2, 3]; Object.defineProperty(withGetter, 1, { get() { hits++; return 7; } }); all(withGetter); all(Object.freeze([1, 2, 3])); all(Object.freeze(["a", "b"])); const sparse = ["a"]; sparse[1e5] = "far"; tell(() => kept[0](sparse, 10)); tell(() => kept[2](sparse, 6)); tell(() => kept[4](sparse, 3)); class Rows extends Array { } const rows = new Rows; rows[0] = 4; rows[1] = 5; all(rows); all(new Proxy([1, 2, 3], { get(target, key) { hits++; return target[key]; } })); all(new Uint8Array([1, 2, 3])); all(new Float64Array([1.5, 2.5])); all({ length: 2, 0: 1, 1: 2 }); all("text"); all(null); all(undefined); tell(() => kept[0](null, 0)); tell(() => kept[2](undefined, 0)); all(7); all(Array.prototype); all(Object.create(Array.prototype)); all(Object.create(["a", "b", "c"])); all(["a", "", "c", "d", "", "f", "g", "h"]); all([1, 2, 3]); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
