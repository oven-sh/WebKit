# ONE WORD OF $isPlainInstanceOf | $isPlainHeirOf: NO ACCESSOR AND NO PROPERTY THAT IS NOT WRITABLE HAS BEEN DEFINED ON THE PROTOTYPE OBJECT OF THE CLASS OR OF A CLASS ABOVE IT, AND NO LINK OF THAT CHAIN HAS CHANGED, SINCE THE GUARDS OF THE CLASS BEGAN.
# Only an accessor (or a proxy laid between: a changed link) can see how often, in which order and whether at all a member is asked, and only it or a property that is not writable can take a store at a birth. A data property sees nothing:
# a plain store of a function or a value, over a member or under a new name, leaves the word standing (tracing agents and polyfills do that): a replaced method stays with the guard of its own name.
# It is a named guard under one reserved name that the program interns for itself; the questions list it beside the guards of the fields' names.
# function Base() { this.low = 1; }
# Base.prototype.reach = function () { return "reach"; };
# Object.defineProperties(Base.prototype, { scale: { get() { return 10; }, set(value) { }, configurable: true } });            in a file of the library, as every function without a name here
# function Meter(level) { Base.call(this); this.level = level; }
# Object.setPrototypeOf(Meter.prototype, Base.prototype);
# Meter.prototype.read = function () { return this.level; };
# function libraryWrap(inner) { return function () { return inner(); }; }            in a file of the library
# function ask(object) { return $isPlainInstanceOf(object, Meter) ? "yes" : "no"; }            in a file of the library
# keep(Meter); keep(Base);
# const wraps = keep(libraryWrap);
# early(Meter, Base, wraps);
# const asks = keep(ask);
# print(asks(new Meter(1)), asks(new Meter(2)));
# later(Meter, Base, wraps);
# print(asks(new Meter(3)), asks(new Meter(4)));
# OPTIONS: mechanisms=all
# RUN(FORM): walk f4
# FORM: key="what sees a read or a store above"}
# RUN(QUIET): run-in-shell keep = x => x; early = function () { }; later = function () { };
