# If a store behind an early return counted as filling the field, a read of it on the object that returned early would hand out the mark of an empty slot.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor(v) { this.a = 1; if (v) return; this.b = 2; } } function readA(p) { return p.a; } function readB(p) { return p.b; } function hasB(p) { return "b" in p; } function addToB(p) { p.b = p.b + 1; return p.b; } const whole = new P(false); const half = new P(true); report(readA(whole)); report(readA(half)); report(readB(whole)); report(readB(half)); report(hasB(whole)); report(hasB(half)); report(addToB(whole)); report(addToB(half)); report(hasB(half)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 10 of 10 of 10
