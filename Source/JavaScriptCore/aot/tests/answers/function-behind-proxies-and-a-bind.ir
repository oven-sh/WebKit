  b0():
    v0 = NewClosure function=f1
    v1 = NewClosure function=f3
    v2 = NewClosure function=f4
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="print" [isFreeName]
    v5 = Integer integer=10
    v6 = Call v0, -, v5 calleeName="makeAdder"
    v7 = Integer integer=20
    v8 = Call v0, -, v7 calleeName="makeAdder"
    v9 = Integer integer=3
    v10 = Integer
    v11 = Integer integer=1
    v12 = Call v1, -, v6, v9 calleeName="behind"
    v13 = Call v12, -, v11
    v14 = Call v4, -, v13 calleeName="print"
    v15 = Call v1, -, v8, v10 calleeName="behind"
    v16 = Call v15, -, v11
    v17 = Call v4, -, v16 calleeName="print"
    v18 = Builtin builtin=FunctionPrototypeBind
    v19 = Null
    v20 = Integer integer=5
    v21 = Call v18, v8, v19, v20 calleeName="twenty.bind"
    v22 = Call v1, -, v21, v9 calleeName="behind"
    v23 = Call v22
    v24 = Call v4, -, v23 calleeName="print"
    v25 = Call v1, -, v21, v10 calleeName="behind"
    v26 = Call v25
    v27 = Call v4, -, v26 calleeName="print"
    v28 = Call v1, -, v6, v9 calleeName="behind"
    v29 = Integer integer=2
    v30 = Call v18, v28, v19, v29
    v31 = Call v30
    v32 = Call v4, -, v31 calleeName="print"
    v33 = Call v2, -, v6, v10 calleeName="bindsAndCalls"
    v34 = Call v4, -, v33 calleeName="print"
    v35 = Call v2, -, v8, v9 calleeName="bindsAndCalls"
    v36 = Call v4, -, v35 calleeName="print"
    v37 = Undefined
    Return v37
}
function f1 name="makeAdder" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
