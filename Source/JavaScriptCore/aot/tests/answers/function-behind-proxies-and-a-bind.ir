    v10 = Less v8, v1
    Branch v10 -> taken b2(), notTaken b3()
  b2():
    v11 = Builtin builtin=Proxy
    v12 = NewObject layout=L0
    v13 = FinishObject v12
    v14 = Construct v11, -, v7, v13 calleeName="Proxy"
    v15 = Integer integer=1
    v16 = Add v8, v15
    Jump -> next b1(v14, v16)
  b3():
    v17 = Call v7 calleeName="chain"
