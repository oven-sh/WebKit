# WHAT LINK SAYS OF A KEY CHOOSES THE NAME AND PROVES NOTHING. `box[chosen]` goes by the name because the type of the variable names the symbol, and each store into the variable is held to that type where it stands.
# THE RED CONTROL. The lie, testing=UnseenCodeAnswersUndefined (false-proofs-are-stopped-where-the-value-comes-in.ir): Link takes what the shell's `id` gives for undefined, so nothing passes the test for a symbol,
# and `depth` is the one symbol that Link names. It printed "deep" for "wide" and went on. Now the store is not shown to fit, so it is tested, and the failing side stops by name.
# OPTIONS: testing=UnseenCodeAnswersUndefined
# RUN(LINK): link accesses variables mechanisms=all
# LINK: access f1 v3 under symbol("depth")@m0:0
# LINK: variable g0 proven=absent|symbol("depth")@m0:0
# RUN(DOOR): walk f0 mechanisms=all
# DOOR: CheckProof {{*}}symbol("depth")@m0:0
# DOOR: PutModuleVariable {{*}} variable=g0
# The reader asks nothing.
# RUN(READ): walk f1 mechanisms=all
# READ-NOT: TypeTest
# READ-NOT: ElemGet
# READ: key=symbol("depth")@m0:0
# RUN(ALL): run-in-shell mechanisms=all
# ALL-NOT: deep
# ALL-NOT: went on
# ALL: AOT: f{{*}} at {{*}}: what a variable holds is not of the type that the compiler has proven of it. It is: symbol. This is a bug in Bun.
# ALL: crashed with
# RUN(CALLS): run-in-shell mechanisms=-Inlining
# CALLS-NOT: deep
# CALLS-NOT: went on
# CALLS: AOT: f{{*}} at {{*}}: what a variable holds is not of the type that the compiler has proven of it. It is: symbol. This is a bug in Bun.
# CALLS: crashed with

layout L0 module=m0 fields=[{key=symbol("depth")@m0:0 declared={type=anything} flags=[IsRequired]}, {key=symbol("width")@m0:1 declared={type=anything} flags=[IsRequired]}] ownFieldCount=2
variable g0 name="chosen" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = Builtin builtin=Symbol
    v3 = String string="depth"
    v4 = Call v2, -, v3 calleeName="Symbol" callNumber=0
    v5 = Builtin builtin=Symbol
    v6 = String string="width"
    v7 = Call v5, -, v6 calleeName="Symbol" callNumber=1
    v8 = Builtin builtin=GlobalThis
    v9 = PropGet v8 key="id" [isFreeName]
    v10 = Call v9, -, v7 calleeName="id"
    v11 = TypeTest v10 testedType=symbol
    Branch v11 -> taken b1(| 0), notTaken b2(v4)
  b1(v12):
    v13 = NarrowByTest v10, v12
    Jump -> next b2(v13)
  b2(v14):
    PutModuleVariable v14 variable=g0
    v16 = ToPropertyKey v4
    v17 = String string="deep"
    v18 = NewObject layout=L0
    ElemDefine v18, v16, v17
    v20 = ToPropertyKey v7
    v21 = String string="wide"
    ElemDefine v18, v20, v21
    v23 = FinishObject v18
    v24 = Builtin builtin=GlobalThis
    v25 = PropGet v24 key="print" [isFreeName]
    v26 = Call v1, -, v23 calleeName="read"
    v27 = Call v25, -, v26 calleeName="print"
    v28 = Builtin builtin=GlobalThis
    v29 = PropGet v28 key="print" [isFreeName]
    v30 = String string="went on"
    v31 = Call v29, -, v30 calleeName="print"
    v32 = Undefined
    Return v32
}
function f1 name="read" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=undefined|null|object flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: undefined|null|object):
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="chosen"
    v3 = ElemGet v0, v2
    Return v3
}
