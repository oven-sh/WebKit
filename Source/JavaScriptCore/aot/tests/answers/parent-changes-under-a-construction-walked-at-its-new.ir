# class A { a; constructor(a) { this.a = a; } first() { return this.a; } }
# class B extends A { b; constructor(a, b) { super(a); this.b = b; } second() { return this.b + this.first(); } }
# class C extends A { c; constructor(a, c) { super(a); note(this); this.c = c; } }
# class D extends A { d; constructor(a, d) { tick(a); super(a); this.d = d; } sum() { return this.d + this.a; } }
# sink(A); sink(B); sink(C); sink(D);
# function run(count) { let total = 0; for (let i = 0; i < count; i++) { tick(i); const item = new B(i & 1023, 2); total += item.second() + item.a; } return total; }
# function runLeaks(count) { let total = 0; for (let i = 0; i < count; i++) { tick(i); const item = new C(i, 3); total += item.c + item.a; } return total; }
# function runSeen(count) { let total = 0; for (let i = 0; i < count; i++) { const item = new D(i, 4); total += item.sum(); } return total; }
# const turns = Number(count);
# print(run(turns)); print(runLeaks(turns)); print(runSeen(turns)); print(ticks);
# For three turns of eight the shell lays another function above B, C and D, so the super call of each constructor enters that function, and `note` takes a field out of its slot.
# `tick` counts its calls: a constructor that calls it in front of super() is not begun a second time.
# RUN: run-in-shell globalThis.count = 8; globalThis.ticks = 0; globalThis.Other = function (a) { this.a = a * 100; }; globalThis.sink = made => { globalThis[made.name] = made; }; globalThis.tick = () => { ticks++; if (ticks % 8 === 3) for (const below of [B, C, D]) Object.setPrototypeOf(below, Other); if (ticks % 8 === 6) for (const below of [B, C, D]) Object.setPrototypeOf(below, A); }; globalThis.note = made => { if (made.a === 6) made.a = 6.5; if (made.a === 7) { delete made.a; made.a = 70; } };
# CHECK: 1854
# CHECK-NEXT: 1006.5
# CHECK-NEXT: 951
# CHECK-NEXT: 24
# CHECK-NEXT: exited with 0

