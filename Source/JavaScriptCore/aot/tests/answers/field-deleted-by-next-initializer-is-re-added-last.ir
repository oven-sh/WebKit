# The initializer of the second field of a class deletes the first, and the constructor adds to it: the sum is no number, and the name comes back behind the others.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const extraTurns = Date.now() < 0 ? 1 : 0; function interrupt(self) { delete self.a; return "b"; } class Thing { a = 1; b = interrupt(this); c = 3; constructor(seed) { this.a += seed; } } function total(one) { return one.a + one.c + String(one.b).length; } function run(seed) { const things = []; for (let at = 0; at < 3 + extraTurns; at++) things.push(new Thing(seed + at)); let said = ""; for (let turn = 0; turn < 4 + extraTurns; turn++) { const one = things[turn % 3]; said += total(one) + ":" + Object.keys(one).join("+") + ","; } return said; } report(run(1)); report(run(2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

