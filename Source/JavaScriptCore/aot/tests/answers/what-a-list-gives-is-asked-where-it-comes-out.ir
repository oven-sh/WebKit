# The contents of a container have no entry check. Native code stores into arrays, Maps and Sets, so the paths into a container cannot be enumerated.
# What Link says about the contents is checked on each value where it is read, in every build, and a mismatch crashes with a named error.
# This is the failing control. Fault injection, testing=AssumeUnknownCallsReturnUndefined (see false-proofs-are-stopped-where-the-value-comes-in.ir): Link assumes that the shell's `id` returns undefined.
# So all that it sees stored into the container is an object of one layout, and undefined. The read of `kept` from the string used a word of the string's cell as a slot: SIGSEGV.
# OPTIONS: testing=AssumeUnknownCallsReturnUndefined
# RUN(FORM): walk f1 mechanisms=all
# FORM: CheckProof {{*}} source=Contents
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 1
# ALL-NEXT: bun: internal AOT error: type check failed
# ALL-NEXT: found string in an element
# ALL-NOT: went on
# ALL: crashed with
# RUN(CALLS): run-in-shell mechanisms=-Inlining
# CALLS: 1
# CALLS-NEXT: bun: internal AOT error: type check failed
# CALLS-NEXT: found string in an element
# CALLS-NOT: went on
# CALLS: crashed with

layout L0 module=m0 fields=[{key="kept" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
variable g0 name="rows" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="id" [isFreeName]
    v4 = Integer integer=1
    v5 = Integer integer=1
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = NewArray v7 contents=anything
    PutModuleVariable v8 variable=g0
    v10 = PropGet v8 key="push"
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="id" [isFreeName]
    v13 = String string="text"
    v14 = Call v12, -, v13 calleeName="id"
    v15 = Call v10, v8, v14 calleeKey="push" calleeName="rows.push"
    v16 = Builtin builtin=GlobalThis
    v17 = PropGet v16 key="print" [isFreeName]
    v18 = Integer
    v19 = Call v1, -, v18 calleeName="read"
    v20 = Call v17, -, v19 calleeName="print"
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="print" [isFreeName]
    v23 = Integer integer=1
    v24 = Call v1, -, v23 calleeName="read"
    v25 = Call v22, -, v24 calleeName="print"
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="print" [isFreeName]
    v28 = String string="went on"
    v29 = Call v27, -, v28 calleeName="print"
    v30 = Undefined
    Return v30
}
function f1 name="read" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=i32 flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: i32):
    v1 = GetModuleVariable variable=g0
    v2 = CheckInitialized v1 name="rows"
