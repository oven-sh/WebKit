# made of 4e5bf37614d9c928
# a function that a function declares and that is only called by its name is entered itself, with what it captures at hand: no closure is made, and its name has no place in the scope
# function outer(a, b) { let n = 0; return first(a) + second(b) + n; function first(x) { n++; return x > 0 ? second(x - 1) : a; } function second(y) { .. first(y - 1) .. } }
# f1 = outer, f3 = first, f4 = second, f2 = keeps, f5 = bump
# RUN(FORM): walk f1 mechanisms=none
# FORM-LABEL: code f1:Body
# FORM: = CallDirect {{*}}function=f3
# RUN(NEVER): walk f1 mechanisms=none
# NEVER-NOT: = NewClosure
# RUN(SIBLING): walk f3 mechanisms=none
# SIBLING: = CallDirect {{*}}function=f4
# RUN(VALUE): walk f2 mechanisms=none
# VALUE: = NewClosure {{*}}function=f5
# function outer(a: number, b: number) { let n = 0; const r = first(a) + second(b); return r + n; function first(x: number): number { n++; return x > 0 ? second(x - 1) : a; } function second(y: number): number { n += 2; return y > 0 ? first(y - 1) : b; } }
# function keeps(start: number) { let n = start; bump(1); return bump; function bump(x: number): number { n += x; return n; } }
# report(outer(3, 4));
# report(outer(0, 0));
# report(outer(7, 1));
# const kept = keeps(10);
# report(kept(5));
# report(kept(5));
# report(keeps(0) === keeps(0));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function outer(a, b) { let n = 0; const r = first(a) + second(b); return r + n; function first(x) { n++; return x > 0 ? second(x - 1) : a; } function second(y) { n += 2; return y > 0 ? first(y - 1) : b; } } function keeps(start) { let n = start; bump(1); return bump; function bump(x) { n += x; return n; } } report(outer(3, 4)); report(outer(0, 0)); report(outer(7, 1)); const kept = keeps(10); report(kept(5)); report(kept(5)); report(keeps(0) === keeps(0)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
