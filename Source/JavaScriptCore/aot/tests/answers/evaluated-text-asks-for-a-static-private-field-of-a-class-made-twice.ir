# A STATIC PRIVATE FIELD OF A CLASS THAT IS MADE TWICE, ASKED FOR BY THE TEXT OF A DIRECT EVAL. The value lies in a field of an environment, one for each class.
# The text of one class reads and stores the field of its own class, finds it absent before its value, and is refused on the other class with the error of a field: each class object has a name of its own for the field, and the name leads to the slot of that class object alone.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(run) { try { return String(run()); } catch (error) { return error.name + ": " + error.message; } } function make(tag) { let early; class Tagged { static { early = String(eval("#tag in this")) + (#tag in this); } static #tag = tag; static ask(text, value) { return eval(text); } static read() { return this.#tag; } } report(early); return Tagged; } const first = make("first"); const second = make("second"); report(first.ask("this.#tag")); report(second.ask("this.#tag")); report(first.ask("#tag in value", first)); report(first.ask("#tag in value", second)); report(attempt(() => first.ask("value.#tag", second))); report(attempt(() => first.ask("value.#tag = 1", second))); report(first.ask("value.#tag = 'stored'", first)); report(first.ask("(() => value.#tag)()", first)); report(first.read()); report(second.read()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
