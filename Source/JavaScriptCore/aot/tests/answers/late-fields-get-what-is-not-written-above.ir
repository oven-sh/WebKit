# fields that are stored behind the birth are declared by the types that the objects are written as, and by no layout of the objects
# interface Sym { id: number }
# interface Type { flags: number; symbol: Sym; widened?: Type; label: string; loose: string }
# interface ObjectType extends Type { members?: Map<string, number>; isResolved?: boolean; target: Type }
# interface Reference extends Type { target: Sym }
# function TypeConstructor(this: Type, flags: number) { this.flags = flags; }
# function create(flags: number, symbol: Sym, label: string, loose: any): Type { const made = new TypeConstructor(flags); made.symbol = symbol; made.label = label; made.loose = loose; (made as any).odd = symbol; return made; }
# function fill(type: Type, other: Type) { const o = type as ObjectType; o.members = new Map(); o.isResolved = true; o.target = other; o.widened = other; }
# function point(type: Type, symbol: Sym) { (type as Reference).target = symbol; }
# function symbolOf(type: Type) { return type.symbol; }   function membersOf(type: Type) { return (type as ObjectType).members; }   function targetOf(type: Type) { return (type as ObjectType).target; }
# function isResolvedOf(type: Type) { return (type as ObjectType).isResolved; }   function labelOf(type: Type) { return type.label; }
# publish(create, fill, point, symbolOf, membersOf, targetOf, isResolvedOf, labelOf);
# The shell hands each of the compiled functions what nobody has written: numbers, texts, booleans, a symbol, a bigint, objects and functions of its own. An object of the text is no Sym either
# Each line: what the compiled reads find | what the shell finds by name | the keys in their order. Seven lines a value:
#   made . filled . pointed . stored by the shell . filled with what fits . target deleted . target stored again, so that it comes last
# RUN: run-in-shell globalThis.publish = (create, fill, point, symbolOf, membersOf, targetOf, isResolvedOf, labelOf) => { const show = v => v === null ? "null" : typeof v === "object" ? (v instanceof Map ? "Map" : "flags" in v ? "T" + v.flags : "object") : typeof v === "function" ? "function" : typeof v === "symbol" ? "symbol" : typeof v + ":" + String(v); const keysOf = t => { let text = ""; for (const key in t) text += (text ? "," : "") + key; return text; }; const line = t => show(symbolOf(t)) + " " + show(membersOf(t)) + " " + show(targetOf(t)) + " " + show(isResolvedOf(t)) + " " + show(labelOf(t)) + " | " + show(t.symbol) + " " + show(t.members) + " " + show(t.target) + " " + show(t.isResolved) + " " + show(t.label) + " | " + keysOf(t); const other = create(1, null, "o", 0); const values = [1, 1.5, "s", true, null, undefined, Symbol.iterator, 10n, {}, [], () => 1, other]; for (let i = 0; i < values.length; i++) { const value = values[i]; const a = create(2, value, value, value); print(line(a)); fill(a, value); print(line(a)); point(a, value); print(line(a)); a.members = value; a.isResolved = value; a.widened = value; print(line(a)); fill(a, other); print(line(a)); delete a.target; print(line(a)); point(a, null); print(line(a)); } };
