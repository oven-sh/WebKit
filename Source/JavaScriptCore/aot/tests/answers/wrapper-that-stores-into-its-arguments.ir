# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function target(...values) { return values.length + "/" + values.join(); } function wrap(a, b) { arguments[0] = 9; return target.apply(this, arguments) + "/" + a; } function tail(a, b) { arguments[1] = 8; return target.apply(this, arguments); } function deed(count) { if (count === 0) return wrap() + " " + tail(); if (count === 1) return wrap(1) + " " + tail(1); if (count === 2) return wrap(1, 2) + " " + tail(1, 2); return wrap(1, 2, 3) + " " + tail(1, 2, 3); } report(String(deed(2))); for (let i = 0;i < 4; i++) report(String(deed(i))); report(String(deed(1))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
