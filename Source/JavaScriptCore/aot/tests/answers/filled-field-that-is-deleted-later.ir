# Every construction fills the field, and one object loses it later.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor() { this.x = 1; this.y = 2; } } function readX(p) { return p.x; } function readY(p) { return p.y; } function hasX(p) { return "x" in p; } function storeX(p, v) { p.x = v; return p.x; } const p = new P(); report(readX(p)); delete p.x; report(readX(p)); report(hasX(p)); report(readY(p)); report(readX(new P())); report(storeX(p, 8)); report(hasX(p)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
