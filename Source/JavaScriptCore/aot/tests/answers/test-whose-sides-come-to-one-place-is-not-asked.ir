# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let reads = 0; const counted = { get flag() { reads++; return reads & 1; }, get kind() { reads += 10; return 1; } }; const thrower = { get flag() { throw new RangeError("flag"); }, get kind() { throw new RangeError("kind"); } }; const converted = { flag: { valueOf() { reads += 100; return 0; } }, kind: { valueOf() { reads += 100; return 1; } } }; function quiet(o) { if (o.flag) {} return reads; } function same(o, v) { const x = o.flag ? v : v; return x; } function differs(o, v) { const x = o.flag ? v : "other"; return x; } function some(o) { let seen = "none"; switch (o.kind) { case 1: break; case 2: seen = "two"; break; case 3: break; } return seen; } function none(o) { switch (o.kind) { case "a": break; case "b": break; } return reads; } function falls(o) { let seen = ""; switch (o.kind) { case 1: case 2: seen += "low"; case 3: break; default: seen += "rest"; } return seen; } function oneSide(o) { let seen = "none"; if (o.flag) { reads += 1000; } return seen + reads; } function readsOnOneSide(o, other) { if (o.flag) { other.flag; } return reads; } function tell(f) { try { report(f()); } catch (e) { report(e instanceof RangeError ? "range " + e.message : e.name); } } function each(f) { tell(() => f(counted)); tell(() => f(counted)); report(reads); tell(() => f(thrower)); tell(() => f(converted)); report(reads); tell(() => f({ flag: 1, kind: 2 })); tell(() => f({ flag: 0, kind: 3 })); tell(() => f({ flag: "", kind: "a" })); tell(() => f({ kind: 2.5 })); tell(() => f({ kind: NaN })); tell(() => f({ kind: "2" })); tell(() => f(null)); } each(quiet); each((o) => same(o, "same")); each((o) => differs(o, "taken")); each(some); each(none); each(falls); each(oneSide); each((o) => readsOnOneSide(o, counted)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
