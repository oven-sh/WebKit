  b0():
    v0 = NewClosure function=f2
    v1 = Convert v0 declared={type=f2 flags=[IsFromCompiler]}
    v2 = NewClosure function=f3
    v3 = Convert v2 declared={type=f3 flags=[IsFromCompiler]}
    v4 = NewClosure function=f4
    v5 = Convert v4 declared={type=f4 flags=[IsFromCompiler]}
    v6 = NewClosure function=f5
    v7 = Convert v6 declared={type=f5 flags=[IsFromCompiler]}
    v8 = Double number=0.5
    v9 = Convert v8 declared={type=number flags=[IsExpected]}
    PutModuleVariable v9 variable=g1
    v11 = Integer integer=3
    v12 = Convert v11 declared={type=i32 flags=[IsExpected]}
    PutModuleVariable v12 variable=g2
    v14 = Integer integer=1
    v15 = Convert v14 declared={type=number flags=[IsExpected]}
    PutModuleVariable v15 variable=g3
    v17 = Call v5 calleeName="show"
    v18 = Integer integer=2
    v19 = Call v1, -, v18 calleeName="scale"
    v20 = Call v3 calleeName="forget"
    v21 = Call v5 calleeName="show"
    v22 = Builtin builtin=GlobalThis
    v23 = PropGet v22 key="print" [isFreeName]
    v24 = Call v7 calleeName="probe"
    v25 = Call v23, -, v24 calleeName="print"
    v26 = Integer integer=7
    PutModuleVariable v26 variable=g4
    v28 = Builtin builtin=GlobalThis
    v29 = PropGet v28 key="print" [isFreeName]
    v30 = Call v7 calleeName="probe"
    v31 = Call v29, -, v30 calleeName="print"
    v32 = Undefined
    Return v32
}
function f1 name="early" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = GetModuleVariable variable=g4
    v1 = CheckInitialized v0 name="late"
    Return v1
}
function f2 name="scale" module=m0 flags=[HasExplicitName] length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
