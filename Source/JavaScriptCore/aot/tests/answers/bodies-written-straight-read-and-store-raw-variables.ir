# let ratio = 0.5;  let count = 3;  let gone = 1;
# function scale(by) { ratio = ratio * by; count = (count + by) | 0; }   function forget() { gone = undefined; }   function show() { print(ratio); print(count); print(gone); }
# function early() { return late; }   function probe() { try { return early(); } catch (error) { return error.name; } }
# show();  scale(2);  forget();  show();  print(probe());  let late = 7;  print(probe());
# The four variables hold numbers alone and lie raw, in both forms. With every body written straight that can be, the body of the module stores written numbers into them, `forget` a marker, and `show` and `early` read them:
# a number comes out of its form boxed, `undefined` and the dead zone come out as what they are. `scale` stores what it computes, which fits by no making: it is walked.
# OPTIONS: testing=ForceStraightCompilation
# RUN(PLAN): plan variables mechanisms=all
# PLAN: variable g1 {{*}}OptionalDouble
# PLAN-NEXT: variable g2 {{*}}OptionalInt64
# PLAN-NEXT: variable g3 {{*}}OptionalInt64
# PLAN-NEXT: variable g4 {{*}}OptionalInt64
# RUN(COUNT): compile StraightUnitsCompiled mechanisms=all
# COUNT: statistic StraightUnitsCompiled 5
# RUN: run-in-shell mechanisms=all
# CHECK: 0.5
# CHECK-NEXT: 3
# CHECK-NEXT: 1
# CHECK-NEXT: 1
# CHECK-NEXT: 5
# CHECK-NEXT: undefined
# CHECK-NEXT: ReferenceError
# CHECK-NEXT: 7
# CHECK-NEXT: exited with 0

variable g0 name="early" module=m0 declared={type=f1 flags=[IsFromCompiler]} initialization=Function function=f1 flags=[IsImmutable]
variable g1 name="ratio" module=m0 declared={type=number|absent flags=[IsExpected]}
variable g2 name="count" module=m0 declared={type=i32|absent flags=[IsExpected]}
variable g3 name="gone" module=m0 declared={type=number|absent flags=[IsExpected]}
variable g4 name="late" module=m0 declared={type=anything|absent} flags=[IsImmutable]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
