function f5 name="probe" module=m0 flags=[HasExplicitName] thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1() handler=b2():
    v0 = GetModuleVariable variable=g0
    v1 = Call v0 calleeName="early"
    Return v1
  b2() role=CatchHandler:
