# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ thing: f[0], klass: f[1], maker: f[2], lastSeen: f[3], layGetter: f[4], replaceWho: f[5], callInLoop: f[6], readInLoop: f[7], getInLoop: f[8], setInLoop: f[9], storeInLoop: f[10], isInLoop: f[11], constructorInLoop: f[12], closureInLoop: f[13], staticInLoop: f[14], newInLoop: f[15], own: f[16], box: f[17], put: f[18], askBox: f[19], listOf: f[20], sumList: f[21], sumByIndex: f[22], literal: f[23], callLiteralInLoop: f[24], steps: f[25], sumSteps: f[26], bound: f[27], mapped: f[28], giveTwice: f[29] }); const twin = (id, register) => { class Thing { constructor(tag) { this.tag = tag; } who() { return mark; } get got() { return mark + 10; } set put(value) { seen = mark * 100 + value; } static made() { return mark + 20; } } var mark = id(0); var seen = 0; function thing() { return new Thing(1); } function klass() { return Thing; } function maker() { return function inner() { return mark + 40; }; } function lastSeen() { return seen; } function layGetter() { Object.defineProperty(Thing.prototype, "tag", { get() { return mark + 50; }, set(value) { seen = mark * 100 + 7; }, configurable: true }); } function replaceWho() { Thing.prototype.who = function () { return mark + 60; }; } function callInLoop(value, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += value.who(); return sum; } function readInLoop(value, turns) { let f; for (let i = 0; i < turns; i++) f = value.who; return f(); } function getInLoop(value, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += value.got; return sum; } function setInLoop(value, turns) { for (let i = 0; i < turns; i++) value.put = i; return seen; } function storeInLoop(value, turns) { for (let i = 0; i < turns; i++) value.tag = i; return value.tag; } function isInLoop(value, turns) { let n = 0; for (let i = 0; i < turns; i++) if (value instanceof Thing) n++; return n; } function constructorInLoop(value, turns) { let n = 0; for (let i = 0; i < turns; i++) if (value.constructor === Thing) n++; return n; } function closureInLoop(f, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += f(); return sum; } function staticInLoop(k, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += k.made(); return sum; } function newInLoop(k, turns) { let last; for (let i = 0; i < turns; i++) last = new k(i); return last.who(); } class Box { constructor(held) { this.held = held; } askInLoop(turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += this.held.who(); return sum; } } function box(held) { return new Box(held); } function put(box, held) { box.held = held; } function askBox(box, turns) { return box.askInLoop(turns); } function listOf(first, second) { return [first, second]; } function sumList(list) { let sum = 0; for (const each of list) sum += each.who(); return sum; } function sumByIndex(list) { let sum = 0; for (let i = 0; i < list.length; i++) sum += list[i].who(); return sum; } function literal() { return { who() { return mark + 70; }, tag: 1 }; } function callLiteralInLoop(value, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += value.who(); return sum; } function* steps() { yield mark; yield mark + 80; } function sumSteps(walked) { let sum = 0; for (const each of walked) sum += each; return sum; } function bound() { return function add(more) { return mark + more; }.bind(null, 90); } function mapped(list, f) { return list.map(f).join(); } function twiceMark(each) { return each + mark * 2; } function giveTwice() { return twiceMark; } function own() { const t = thing(), k = klass(), f = maker(); return callInLoop(t, 2) + readInLoop(t, 2) + getInLoop(t, 2) + setInLoop(t, 2) + storeInLoop(t, 2) + isInLoop(t, 2) + constructorInLoop(t, 2) + closureInLoop(f, 2) + staticInLoop(k, 2) + newInLoop(k, 2) + askBox(box(t), 2) + sumList(listOf(t, t)) + sumByIndex(listOf(t, t)) + callLiteralInLoop(literal(), 2) + sumSteps(steps()) + closureInLoop(bound(), 2) + mapped([1, 2], twiceMark).length; } register(thing, klass, maker, lastSeen, layGetter, replaceWho, callInLoop, readInLoop, getInLoop, setInLoop, storeInLoop, isInLoop, constructorInLoop, closureInLoop, staticInLoop, newInLoop, own, box, put, askBox, listOf, sumList, sumByIndex, literal, callLiteralInLoop, steps, sumSteps, bound, mapped, giveTwice); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; say("own", () => a.own() + "," + b.own()); const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; say("call", () => x.callInLoop(x.thing(), 3) + "," + x.callInLoop(y.thing(), 3)); say("read", () => x.readInLoop(x.thing(), 3) + "," + x.readInLoop(y.thing(), 3)); say("get", () => x.getInLoop(x.thing(), 3) + "," + x.getInLoop(y.thing(), 3)); say("set", () => x.setInLoop(x.thing(), 3) + "," + x.setInLoop(y.thing(), 3) + "," + x.lastSeen() + "," + y.lastSeen()); say("store", () => x.storeInLoop(x.thing(), 3) + "," + x.storeInLoop(y.thing(), 3)); say("instanceof", () => x.isInLoop(x.thing(), 3) + "," + x.isInLoop(y.thing(), 3)); say("constructor", () => x.constructorInLoop(x.thing(), 3) + "," + x.constructorInLoop(y.thing(), 3)); say("closure", () => x.closureInLoop(x.maker(), 3) + "," + x.closureInLoop(y.maker(), 3)); say("static", () => x.staticInLoop(x.klass(), 3) + "," + x.staticInLoop(y.klass(), 3)); say("new", () => x.newInLoop(x.klass(), 3) + "," + x.newInLoop(y.klass(), 3)); say("held", () => x.askBox(x.box(x.thing()), 3) + "," + x.askBox(x.box(y.thing()), 3) + "," + x.askBox(y.box(y.thing()), 3) + "," + x.askBox(y.box(x.thing()), 3)); say("held, put by us", () => { const held = x.box(x.thing()); x.put(held, y.thing()); return x.askBox(held, 3) + "," + y.askBox(held, 3); }); say("held, put by them", () => { const held = x.box(x.thing()); y.put(held, y.thing()); return x.askBox(held, 3) + "," + y.askBox(held, 3); }); say("list", () => x.sumList(x.listOf(x.thing(), y.thing())) + "," + x.sumList(y.listOf(y.thing(), y.thing())) + "," + x.sumList([y.thing(), x.thing()])); say("list by index", () => x.sumByIndex(x.listOf(x.thing(), y.thing())) + "," + x.sumByIndex(y.listOf(y.thing(), y.thing())) + "," + x.sumByIndex([y.thing(), x.thing()])); say("literal", () => x.callLiteralInLoop(x.literal(), 3) + "," + x.callLiteralInLoop(y.literal(), 3)); say("generator", () => x.sumSteps(x.steps()) + "," + x.sumSteps(y.steps())); say("bound", () => x.closureInLoop(x.bound(), 3) + "," + x.closureInLoop(y.bound(), 3)); say("callback", () => x.mapped([1, 2, 3], x.giveTwice()) + ";" + x.mapped([1, 2, 3], y.giveTwice())); } b.replaceWho(); say("who replaced there, call", () => a.callInLoop(a.thing(), 3) + "," + a.callInLoop(b.thing(), 3) + "," + b.callInLoop(a.thing(), 3) + "," + b.callInLoop(b.thing(), 3)); say("who replaced there, read", () => a.readInLoop(a.thing(), 3) + "," + a.readInLoop(b.thing(), 3) + "," + b.readInLoop(a.thing(), 3)); b.layGetter(); say("accessor laid there, store", () => a.storeInLoop(a.thing(), 3) + "," + a.storeInLoop(b.thing(), 3) + "," + b.storeInLoop(a.thing(), 3) + "," + a.lastSeen() + "," + b.lastSeen()); return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
