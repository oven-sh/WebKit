# function own() { const c = caller(inner), d = caller(fresh()), k = keeper(); setF(c, inner); setInLoop(c, inner, 2); add(k, thing()); pushHere(k, thing()); return run(c, 2) + run(d, 2) + runHere(c, 2) + sum(k); }
# register(maker, fresh, thing, caller, setF, setInLoop, run, runHere, keeper, add, pushHere, sum, own);
# LIBRARY: own
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ maker: f[0], fresh: f[1], thing: f[2], caller: f[3], setF: f[4], setInLoop: f[5], run: f[6], runHere: f[7], keeper: f[8], add: f[9], pushHere: f[10], sum: f[11], own: f[12] }); const twin = (id, register) => { class Caller { constructor(f) { this.f = f; } runInLoop(turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += this.f(); return sum; } runOnce() { return this.f(); } } class Keeper { constructor() { this.list = []; } add(thing) { this.list.push(thing); } sum() { let sum = 0; for (let i = 0; i < this.list.length; i++) sum += this.list[i].who(); return sum; } } class Thing { who() { return mark; } } var mark = id(0); function inner() { return mark + 40; } function maker() { return inner; } function fresh() { return function made() { return mark + 50; }; } function thing() { return new Thing(); } function caller(f) { return new Caller(f); } function setF(held, f) { held.f = f; } function setInLoop(held, f, turns) { for (let i = 0; i < turns; i++) held.f = f; } function run(held, turns) { return held.runInLoop(turns) + held.runOnce(); } function runHere(held, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += held.f(); return sum; } function keeper() { return new Keeper(); } function add(kept, thing) { kept.add(thing); } function pushHere(kept, thing) { kept.list.push(thing); } function sum(kept) { return kept.sum(); } function own() { const c = caller(inner), d = caller(fresh()), k = keeper(); setF(c, inner); setInLoop(c, inner, 2); add(k, thing()); pushHere(k, thing()); return run(c, 2) + run(d, 2) + runHere(c, 2) + sum(k); } register(maker, fresh, thing, caller, setF, setInLoop, run, runHere, keeper, add, pushHere, sum, own); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; say("own", () => a.own() + "," + b.own()); const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const asked = held => x.run(held, 3) + "," + y.run(held, 3) + "," + x.runHere(held, 3) + "," + y.runHere(held, 3); say("own", () => asked(x.caller(x.maker())) + ";" + asked(x.caller(x.fresh()))); say("theirs", () => asked(y.caller(y.maker())) + ";" + asked(y.caller(y.fresh()))); say("their function in a new one of ours", () => asked(x.caller(y.maker())) + ";" + asked(x.caller(y.fresh()))); say("we set theirs in ours", () => { const held = x.caller(x.maker()); x.setF(held, y.maker()); return asked(held); }); say("we set theirs in ours, in a loop", () => { const held = x.caller(x.maker()); x.setInLoop(held, y.maker(), 3); return asked(held); }); say("they set theirs in ours", () => { const held = x.caller(x.maker()); y.setF(held, y.maker()); return asked(held); }); say("they set theirs in ours, in a loop", () => { const held = x.caller(x.maker()); y.setInLoop(held, y.maker(), 3); return asked(held); }); say("we set ours in theirs", () => { const held = y.caller(y.maker()); x.setF(held, x.maker()); return asked(held); }); say("we set ours in theirs, in a loop", () => { const held = y.caller(y.maker()); x.setInLoop(held, x.maker(), 3); return asked(held); }); say("kept", () => { const kept = x.keeper(); x.add(kept, x.thing()); x.add(kept, y.thing()); y.add(kept, y.thing()); x.pushHere(kept, y.thing()); y.pushHere(kept, y.thing()); y.pushHere(kept, x.thing()); return x.sum(kept) + "," + y.sum(kept); }); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
