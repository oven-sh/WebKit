# class Keeper { constructor() { this.list = []; } add(thing) { this.list.push(thing); } sum() { let sum = 0; for (let i = 0; i < this.list.length; i++) sum += this.list[i].who(); return sum; } }
# class Thing { who() { return mark; } }
