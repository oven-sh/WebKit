# function runHere(held, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += held.f(); return sum; }
# function keeper() { return new Keeper(); }
# function add(kept, thing) { kept.add(thing); }
# function pushHere(kept, thing) { kept.list.push(thing); }
