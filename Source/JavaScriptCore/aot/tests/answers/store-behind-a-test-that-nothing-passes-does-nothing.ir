# made of e50e1c0f362ce059
# no caller hands mark() a function, so nothing passes the test in front of its store and no run comes to it: the caller's own object is as it was
# the form that is owed stands in ../link/store-behind-a-test-that-nothing-passes-does-nothing-from-source.ir
# function mark(o: unknown) { if (typeof o === "function") (o as any).seen = 1; }
# function twice(box: { n: number }) { const before = box.n; mark(1); mark("text"); return before * 10 + box.n; }
# report(twice({ n: 4 }));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function mark(o) { if (typeof o === "function") o.seen = 1; } function twice(box) { const before = box.n; mark(1); mark("text"); return before * 10 + box.n; } report(twice({ n: 4 })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 2 of 2 of 2
# CHECK-NEXT: exited with 0

