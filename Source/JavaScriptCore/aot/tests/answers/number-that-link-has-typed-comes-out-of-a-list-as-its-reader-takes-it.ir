# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const one = +globalThis.nothingIsHere || 1; function show(x) { return Object.is(x, -0) ? "-0" : String(x); } function sum(list) { let s = 0; for (let i = 0;i < list.length; i++) s += list[i]; return s; } function sumPastTheEnd(list) { let s = 0; for (let i = 0;i <= list.length; i++) s += list[i]; return s; } function half(list, at) { return list[at] / 2; } function above(list, bound) { let n = 0; for (let i = 0;i < list.length; i++) { if (list[i] > bound) n++; } return n; } function handOn(list, at) { return keep(list[at]); } function keep(x) { kept = x; return kept; } let kept = 0; const fractions = []; for (let i = 0;i < 6; i++) fractions.push(i + one / 2); const whole = []; for (let i = 0;i < 6; i++) whole.push(i + 1); const turned = []; for (let i = 0;i < 6; i++) turned.push(i + 1); turned[2] = one / 4; const holed = []; for (let i = 0;i < 6; i++) holed.push(i + one / 2); holed.length = 3; holed[5] = one / 2; const zeros = []; for (let i = 0;i < 3; i++) zeros.push(-one * 0); const none = []; report(show(sum(fractions))); report(show(sumPastTheEnd(fractions))); report(show(half(fractions, 0))); report(show(half(fractions, 3))); report(show(half(fractions, 6))); report(show(half(fractions, -1))); report(above(fractions, one)); report(show(handOn(fractions, 2))); report(show(sum(whole))); report(show(sumPastTheEnd(whole))); report(show(half(whole, 0))); report(show(half(whole, 3))); report(show(half(whole, 6))); report(show(half(whole, -1))); report(above(whole, one)); report(show(handOn(whole, 2))); report(show(sum(turned))); report(show(sumPastTheEnd(turned))); report(show(half(turned, 0))); report(show(half(turned, 3))); report(show(half(turned, 6))); report(show(half(turned, -1))); report(above(turned, one)); report(show(handOn(turned, 2))); report(show(sum(holed))); report(show(sumPastTheEnd(holed))); report(show(half(holed, 0))); report(show(half(holed, 3))); report(show(half(holed, 6))); report(show(half(holed, -1))); report(above(holed, one)); report(show(handOn(holed, 2))); report(show(sum(zeros))); report(show(sumPastTheEnd(zeros))); report(show(half(zeros, 0))); report(show(half(zeros, 3))); report(show(half(zeros, 6))); report(show(half(zeros, -1))); report(above(zeros, one)); report(show(handOn(zeros, 2))); report(show(sum(none))); report(show(sumPastTheEnd(none))); report(show(half(none, 0))); report(show(half(none, 3))); report(show(half(none, 6))); report(show(half(none, -1))); report(above(none, one)); report(show(handOn(none, 2))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
