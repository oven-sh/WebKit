# import() of a graph of six ES modules while jobs of the program wait. The program sees how many jobs pass before the graph runs, so the loader takes its steps level by level.
# It takes them down one way to the lowest level: no step for an ES module runs code of the program. b.js asks for a module of its own level and for one that a.js has asked for, and c.js asks for the root.
# RUN: run-in-shell --aotCountsPath=/dev/null let job = 0; let isImported = false; globalThis.report = (label, value) => print(label + ": " + value + " behind job " + job); globalThis.register = closure => { globalThis.registered = closure; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(() => { const next = () => { if (isImported) return; ++job; Promise.resolve().then(next); }; Promise.resolve().then(next); registered().then(() => { isImported = true; print("imported behind job " + job); print("walked " + aotRuntimeCounters().match(/^(\d+)\tcounter:CompiledModulesWalkedByLoader$/m)[1]); }); }); return result; };
# CHECK: runs: e.js behind job 22
