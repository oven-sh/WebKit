# arguments, rest parameters, spread and apply: the list is read, measured, changed, cut short and handed on, with no operand and with more than are declared.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function count() { return arguments.length; } function last() { return arguments[arguments.length - 1]; } function total(...all) { let sum = 0; for (const each of all) sum += each; return sum; } function spreadOn(...all) { return total(...all, 1); } function applied(list) { return total.apply(null, list) + ":" + count.apply(null, list) + ":" + Math.max.apply(null, list); } function pushed(list, ...more) { list.push(...more); return list.length + ":" + list.join(); } function changed(a, b) { arguments[0] = 9; b = 8; return a + ":" + arguments[1] + ":" + arguments.length; } function strictly(a, b) { "use strict"; arguments[0] = 9; b = 8; return a + ":" + arguments[1] + ":" + arguments.length; } function sized(...all) { all.length = 1; return all.length + ":" + all[1]; } report(count()); report(count(1, 2, 3)); report(last(1, "z")); report(last()); report(total()); report(total(1, 2.5)); report(spreadOn(1, 2)); report(spreadOn()); report(applied([1, 2, 3])); report(applied([])); report(pushed([1], 2, 3)); report(pushed([])); report(changed(1, 2)); report(changed(1)); report(strictly(1, 2)); report(sized(1, 2, 3)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
