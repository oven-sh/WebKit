# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function codeAt(s, i) { return typeof s === "string" && typeof i === "number" ? s.charCodeAt(i) : "other"; } function pointAt(s, i) { return typeof s === "string" && typeof i === "number" ? s.codePointAt(i) : "other"; } function letterAt(s, i) { return typeof s === "string" && typeof i === "number" ? s.charAt(i) : "other"; } function relative(s, i) { return typeof s === "string" && typeof i === "number" ? s.at(i) : "other"; } function element(s, i) { return typeof s === "string" && typeof i === "number" ? s[i | 0] : "other"; } function firstOfRest(s, i) { return typeof s === "string" && typeof i === "number" ? s.slice(i).charCodeAt(0) : "other"; } function secondOfPiece(s, i) { return typeof s === "string" && typeof i === "number" ? s.substring(i, 3).charAt(1) : "other"; } function sumInside(s) { if (typeof s !== "string") return "other"; let sum = 0; for (let i = 0;i < s.length; i++) sum = sum * 31 + s.charCodeAt(i) | 0; return sum; } function withoutPosition(s) { if (typeof s !== "string") return "other"; const t = s; return t.charCodeAt() + "|" + t.charAt() + "|" + t.at() + "|" + t.codePointAt(); } function behindTests(s, i) { if (typeof s !== "string" || typeof i !== "number") return "other"; const k = i | 0; if (k < 0) return -3; if (k >= s.length) return s.charCodeAt(k); if (s.length > k) return s.charCodeAt(k); return -2; } function grown(n) { let text = ""; for (let i = 0;i < n; i++) text += "abĀ"; return text; } function show(v) { return typeof v === "number" ? String(v) : v === undefined ? "undefined" : JSON.stringify(v); } function codeAtOfAnything(s, i) { return typeof s === "string" && typeof i === "number" ? s.charCodeAt(i) : "other"; } const texts = ["", "a", "héllo", "Āb", "a\uD83D\uDE00b", "\uD83D", "\uDE00x", grown(5), grown(40).slice(7, 19)]; const positions = [-1, 0, 1, 2, 3, 1.5, -0.5, NaN, -0, 1 / 0, -1 / 0, 2147483647, 2147483648, -2147483648, -2147483649, 4294967296, 11, 12, 14, 15, -12, -13]; for (let t = 0;t < texts.length; t++) { for (let p = 0;p < positions.length; p++) { const s = "" + texts[t]; const i = +positions[p]; report(show(codeAt(s, i))); report(show(pointAt(s, i))); report(show(letterAt(s, i))); report(show(relative(s, i))); report(show(element(s, i))); report(show(firstOfRest(s, i))); report(show(secondOfPiece(s, i))); report(show(behindTests(s, i))); } } for (let t = 0;t < texts.length; t++) { const s = "" + texts[t]; report(show(sumInside(s))); report(show(withoutPosition(s))); } report(show(codeAtOfAnything(5, 0))); report(show(codeAtOfAnything("a", "0"))); report(show(sumInside(null))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
