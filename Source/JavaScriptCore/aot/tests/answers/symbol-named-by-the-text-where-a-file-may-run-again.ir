variable g1 name="exports" module=m1 declared={type=anything} initialization=Undefined
module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
module m1 path="/again.cjs" displayPath="again.cjs" kind=CommonJs flags=[KeepsError, MayBeEvicted] exportRule=CommonJs requireResult=ModuleExports body=f3 exportsVariable=g1
entry module=m0
