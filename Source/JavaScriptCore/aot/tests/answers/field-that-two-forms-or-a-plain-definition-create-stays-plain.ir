# function Unknown(this: any, v: number, flag: boolean) { Object.defineProperty(this, "u", { value: v, enumerable: flag }); }
# let text = "";
# for (let i = 0; i < 40; i++) { const two = new (Two as any)(i, (i & 1) === 1); const unknown = new (Unknown as any)(i, (i & 1) === 1); text = Object.keys(two).join() + Object.keys(unknown).join() + two.x + unknown.u; }
# report(text);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function Two(v, how) { if (how) { Object.defineProperty(this, "x", { value: v }); } else { Object.defineProperty(this, "x", { value: v, writable: true, enumerable: true }); } } function Unknown(v, flag) { Object.defineProperty(this, "u", { value: v, enumerable: flag }); } let text = ""; for (let i = 0;i < 40; i++) { const two = new Two(i, (i & 1) === 1); const unknown = new Unknown(i, (i & 1) === 1); text = Object.keys(two).join() + Object.keys(unknown).join() + two.x + unknown.u; } report(text); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
