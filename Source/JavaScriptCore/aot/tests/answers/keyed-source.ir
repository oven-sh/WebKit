layout L1 fields=[{key="a" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key=symbol("s")@m0:0 declared={type=number flags=[IsExpected]} flags=[IsNeverWritten]}] declaredOrder=[1, 0] ownFieldCount=2
layout L2 fields=[{key="b" declared={type=number flags=[IsExpected]} flags=[IsRequired]}, {key=symbol("s")@m0:0 declared={type=number flags=[IsExpected]} flags=[IsNeverWritten]}] declaredOrder=[1, 0] ownFieldCount=2
module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
data d0 root=Object{layout=L0 members=[{key="x" value=Number{value=1}}]} module=m0
data d1 root=Object{layout=L0 members=[{key="x" value=Number{value=1}}]} module=m0
data d2 root=Array{contents=never} module=m0
data d3 root=Object{layout=L0 members=[{key="x" value=Number{value=1}}]} module=m0
data d4 root=Object{layout=L0 members=[{key="x" value=Number{value=1}}]} module=m0
entry module=m0
