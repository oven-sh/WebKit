# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function sliced(s, a, b) { return typeof s === "string" && typeof a === "number" && typeof b === "number" ? s.slice(a, b) : "other"; } function cut(s, a, b) { return typeof s === "string" && typeof a === "number" && typeof b === "number" ? s.substring(a, b) : "other"; } function taken(s, a, b) { return typeof s === "string" && typeof a === "number" && typeof b === "number" ? s.substr(a, b) : "other"; } function rest(s, a) { return typeof s === "string" && typeof a === "number" ? s.slice(a) + "|" + s.substring(a) + "|" + s.substr(a) : "other"; } function written(s) { return typeof s === "string" ? s.slice(1) + "|" + s.slice(-2) + "|" + s.slice(0) + "|" + s.slice(2, 1) + "|" + s.substring(2, 1) + "|" + s.substr(-3, 2) + "|" + s.slice(0, -1) + "|" + s.substring(-4) + "|" + s.slice(1, undefined) + "|" + s.slice() : "other"; } function lengthOfPiece(s, a, b) { return typeof s === "string" && typeof a === "number" && typeof b === "number" ? s.slice(a, b).length : "other"; } function ends(s) { return typeof s === "string" ? (s.startsWith("ab") ? 1 : 0) + (s.endsWith("ab") ? 2 : 0) + (s.startsWith("a") ? 4 : 0) + (s.endsWith("b") ? 8 : 0) + (s.startsWith("") ? 16 : 0) + (s.endsWith("") ? 32 : 0) + (s.startsWith("Ā") ? 64 : 0) + (s.endsWith("Āb") ? 128 : 0) : "other"; } function places(s) { return typeof s === "string" ? s.indexOf("b") + "|" + s.indexOf("ab") + "|" + s.lastIndexOf("b") + "|" + s.lastIndexOf("ab") + "|" + s.includes("ba") + "|" + s.includes("Ā") + "|" + s.indexOf("") + "|" + s.lastIndexOf("") + "|" + s.includes("") : "other"; } function placesFrom(s, i) { return typeof s === "string" && typeof i === "number" ? s.indexOf("b", i) + "|" + s.indexOf("ab", i) + "|" + s.includes("ab", i) + "|" + s.lastIndexOf("ab", i | 0) + "|" + s.lastIndexOf("b", i | 0) : "other"; } function matches(s) { return typeof s === "string" ? (/ab/.test(s) ? 1 : 0) + "|" + s.search(/ba/) + "|" + (/a\.b/.test(s) ? 1 : 0) + "|" + (/AB/i.test(s) ? 1 : 0) + "|" + s.search(/b/) : "other"; } function under(path, dir, n) { if (typeof path !== "string" || typeof dir !== "string") return "other"; let c = 0; for (let i = 0;i < n; i++) { if (path.startsWith(dir + "/")) c += 1; if (path.endsWith("." + dir)) c += 10; } return c; } function amounts(s, a) { return typeof s === "string" && typeof a === "number" ? +s.slice(a) + "|" + Number(s.substring(a, 4)) + "|" + parseInt(s.slice(a), 16) + "|" + parseInt(s.slice(a, 3)) : "other"; } function grown(n) { let text = ""; for (let i = 0;i < n; i++) text += "ab"; return text; } const texts = ["", "a", "ab", "ba", "abab", "a.b", "Āb", "abĀb", grown(4), grown(30).slice(5, 12), "12", " 12 ", "0x1f", "1e3", "12px", "-7", "ff"]; const bounds = [-100, -3, -1, 0, 1, 2, 3, 100, 1.5, -1.5, NaN, 1 / 0, -1 / 0, 2147483648, -2147483649]; for (let t = 0;t < texts.length; t++) { const s = "" + texts[t]; for (let a = 0;a < bounds.length; a++) { const first = +bounds[a]; for (let b = 0;b < bounds.length; b++) { const second = +bounds[b]; report(sliced(s, first, second)); report(cut(s, first, second)); report(taken(s, first, second)); report(lengthOfPiece(s, first, second)); } report(rest(s, first)); report(placesFrom(s, first)); report(amounts(s, first)); } } for (let t = 0;t < texts.length; t++) { const s = "" + texts[t]; report(written(s)); report(ends(s)); report(places(s)); report(matches(s)); for (let u = 0;u < texts.length; u++) { const other = "" + texts[u]; report(under(s + "/" + other, s, 2) + "|" + under(s + "." + other, other, 2) + "|" + under(s, other, 2)); } } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
