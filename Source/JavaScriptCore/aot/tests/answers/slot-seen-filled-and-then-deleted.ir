5; } get dropLater() { if (this.b++ === 2) delete this.a; return 5; } } function insideRun(c) { const { a, drop: dropped, a: nextA } = c, kind = !c; return a + " " + dropped + " " + nextA + " " + kind; } function insideRunInLoop(c) { let all = ""; for (let i = 0;i < 5; i++) { const { a, dropLater: dropped, a: nextA } = c, kind = !c; all += a + "," + dropped + "," + nextA + "," + (kind ? 1 : 2) + ";"; } return all; } report({ insideRun, insideRunInLoop }); report(insideRun("")); report(insideRun(new Late(1, 2))); report(insideRunInLoop("")); report(insideRunInLoop(new Late(1, 0))); report(insideRunInLoop(new Late(1, 2))); report(insideRunInLoop(new Late(1, 9))); const gone = make(1, 2); report(orElse(gone)); change(gone); report(orElse(gone)); report(orElseInLoop(make(1, 2), change, 1)); report(orElseInLoop(make(1, 2), nothing, 1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
