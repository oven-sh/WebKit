# for (const text of ["ab", "ba", "b"]) report(found(text));
# report(said);
# report("end");
# A search converts lastIndex to a number also without the flags g and y: an object stored there is asked each time.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = report => { let said = ""; function found(text) { const pattern = /a+/; pattern.lastIndex = { valueOf() { said += "asked,"; return 1; } }; return pattern.test(text); } for (const text of ["ab", "ba", "b"]) report(found(text)); report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); }); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }; })();
# CHECK: 5 of 5 of 5
