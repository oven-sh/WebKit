# function read(payload) { return payload.value + payload.issues }   register(read, { value: one, issues: two })
# The program evaluates text and the record has escaped, so makers that nobody saw are counted on, and the image lists the record among those that parsers make.
# The interpreter gives an object literal of text under the names of the record its layout, so compiled code meets the shape that it tests for. A literal under other names stays an ordinary object.
# A Structure lists the properties of an ordinary object and none of a compiled one: that is what `ordinary` looks at.
# RUN: run-in-shell globalThis.one = 1; globalThis.two = 2; globalThis.register = (read, kept) => { const ordinary = o => describe(o).includes("value:"); const made = { value: 3, issues: 4 }; const other = { value: 7, more: 8 }; print(read(made), read(other), ordinary(kept), ordinary(made), ordinary(other), Object.keys(made), JSON.stringify(made)); };
