# class Base { constructor(held) { this.held = held; this.madeBy = "base" } }
# class Other { constructor(held) { this.held = held * 10; this.madeBy = "other" } }
# class Derived extends Base { constructor(held) { super(held); this.more = 1 } }
# function make(held) { return new Derived(held) }
# const first = make(1);
# report(first.held);
# report(first.madeBy);
# Object.setPrototypeOf(Derived, Other);
# const second = make(2);
# report(second.held);
# report(second.madeBy);
# report(second.more);
# report(second instanceof Derived);
# report(second instanceof Base);
# report("end");
# `super(..)` constructs with what stands above the class object when it runs.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Base { constructor(held) { this.held = held; this.madeBy = "base" } } class Other { constructor(held) { this.held = held * 10; this.madeBy = "other" } } class Derived extends Base { constructor(held) { super(held); this.more = 1 } } function make(held) { return new Derived(held) } const first = make(1); report(first.held); report(first.madeBy); Object.setPrototypeOf(Derived, Other); const second = make(2); report(second.held); report(second.madeBy); report(second.more); report(second instanceof Derived); report(second instanceof Base); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 8 of 8 of 8
# CHECK-NEXT: exited with 0

