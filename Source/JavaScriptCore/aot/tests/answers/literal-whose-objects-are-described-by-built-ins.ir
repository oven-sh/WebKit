# made of b6a215a8725d33db
# the same literals where each object is handed to Object.keys, JSON.stringify and Object.getOwnPropertyDescriptor: it leaves the program, so every slot takes every value and nothing is a misfit
# f1 = row, f2 = two, f3 = describe, f4 = tell
# RUN(FORM): walk f1 mechanisms=all-Arrivals
# FORM-LABEL: code f1:Body
# FORM-NOT: PropDefine
# FORM: = NewObject {{*}}fields=[0, 3, 2, 1]
# LIBRARY: own
# function row(a: number | undefined) { return { id: 1, tag: a, more: 2, last: "z" }; }
# function two(a: number | undefined, b: number | undefined) { return { first: a, id: 1, second: b, more: 2 }; }
# function describe(o: object): string { return Object.keys(o).join() + " " + JSON.stringify(o); }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => describe(row(1.5)));
# tell(() => describe(row(undefined)));
# tell(() => describe(row(-0)) + " " + Object.is(row(-0).tag, -0));
# tell(() => describe(row(NaN)));
# tell(() => describe(row(7)));
# tell(() => describe(two(1.5, undefined)));
# tell(() => describe(two(undefined, 2.5)));
# tell(() => describe(two(3, 4)));
# tell(() => "tag" in row(undefined) && Object.prototype.hasOwnProperty.call(row(undefined), "tag"));
# tell(() => { const d = Object.getOwnPropertyDescriptor(row(1.5), "tag")!; return d.value + " " + d.writable + " " + d.enumerable + " " + d.configurable; });
# tell(() => { let sum = 0; for (let i = 0; i < 300; i++) { const r = row(i % 3 ? i + 0.5 : undefined); sum += r.id + r.more + (r.tag === undefined ? 1 : r.tag); } return sum; });
# tell(() => { const r = row(1.5); r.tag = undefined; r.more = 9; return describe(r); });
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function row(a) { return { id: 1, tag: a, more: 2, last: "z" }; } function two(a, b) { return { first: a, id: 1, second: b, more: 2 }; } function describe(o) { return Object.keys(o).join() + " " + JSON.stringify(o); } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => describe(row(1.5))); tell(() => describe(row(undefined))); tell(() => describe(row(-0)) + " " + Object.is(row(-0).tag, -0)); tell(() => describe(row(NaN))); tell(() => describe(row(7))); tell(() => describe(two(1.5, undefined))); tell(() => describe(two(undefined, 2.5))); tell(() => describe(two(3, 4))); tell(() => ("tag" in row(undefined)) && Object.prototype.hasOwnProperty.call(row(undefined), "tag")); tell(() => { const d = Object.getOwnPropertyDescriptor(row(1.5), "tag"); return d.value + " " + d.writable + " " + d.enumerable + " " + d.configurable; }); tell(() => { let sum = 0; for (let i = 0;i < 300; i++) { const r = row(i % 3 ? i + 0.5 : undefined); sum += r.id + r.more + (r.tag === undefined ? 1 : r.tag); } return sum; }); tell(() => { const r = row(1.5); r.tag = undefined; r.more = 9; return describe(r); }); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
