# FORM: frequency=Rare isLoopHead=true
# FORM: = Less {{*}}form=Generic
# FORM: = Increment {{*}}form=Generic
# FORM: isInLoop=true isLoopHead=true
# FORM: = Less {{*}}form=Integers
# FORM: = Increment {{*}}form=Integers
# FORM-LABEL: code f2:Body
