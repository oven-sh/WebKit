# What the body of a module makes out of the text alone and only stores in a variable is made at the first read of the variable.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function tell(read) { try { return String(read()); } catch (e) { return e.name; } } function no() { return false; } function yes() { return true; } function fail() { throw new Error("stop"); } function readSkipped() { return skipped; } function readTaken() { return taken; } function readBehind() { return behind; } function readTurned() { return turned; } function readNoTurn() { return noTurn; } function readAssigned() { return assigned; } function readShared() { return shared; } function readAlias() { return alias; } function inLoop() { let n = 0; for (let i = 0;i < 4; i++) { if (i > 1) n += counted.length; } return n; } function inCatch() { try { fail(); return "none"; } catch { return caught.source; } } function inFinally() { let text = ""; try { fail(); } catch { text = "c"; } finally { text += last.source; } return text; } function twice() { const first = both; const second = both; return first === second; } function acrossCall() { const first = crossed; touch(); return first === crossed; } function touch() { return crossed.flags; } function unused() { ignored; return 1; } if (no()) { skipped = /s/; } var skipped; if (yes()) { taken = /t/; } var taken; try { fail(); behind = /b/; } catch {} var behind; const seen = []; for (let i = 0;i < 3; i++) { turned = /u/; seen.push(readTurned()); } var turned; for (let i = 0;i < 0; i++) { noTurn = /n/; } var noTurn; let assigned = /first/; const kept = readAssigned(); assigned = /second/; const shared = /h/; const alias = shared; const counted = [1, 2, 3]; const caught = /in-catch/; const last = /in-finally/; const both = { b: 1 }; const crossed = /x/gi; const ignored = /i/; report(tell(readSkipped)); report(tell(readTaken)); report(readTaken() === taken); report(tell(readBehind)); report(seen[0] === seen[1]); report(seen[1] === seen[2]); report(seen[2] === readTurned()); report(tell(readNoTurn)); report(tell(readAssigned)); report(kept === readAssigned()); report(String(kept)); report(readShared() === readAlias()); report(inLoop()); report(inLoop()); report(inCatch()); report(inFinally()); report(twice()); report(acrossCall()); report(unused()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
