# What a turn of a loop ends is asked again in the next turn, however seldom that turn comes. Each loop is one in which the tests and reads could otherwise stand in front.
# type Source = { text: string }
# class Counter { total = 0; constructor(public step: number) {} add(value: number) { this.total = (this.total + value * this.step) | 0; return this.total; } }
# Four times, function (counter: Counter, ..) { let last = 0; for (let i = 0; i < 100; i++) { last = counter.add(i); if (i === 50) .. } return last; }, with
# in `freezes` Object.freeze(counter), so the store of turn 51 throws, and in `deletes` delete counter.step, so from there on the product is NaN and the sum 0,
# in `replaces` proto.add = function () { return 7 }, where `proto` is Counter.prototype, and in `relinks` Object.setPrototypeOf(counter, other), where `other` has an `add` of its own.
# function shortens(source: Source, other: Source) { let turns = 0; while (turns < source.text.length) { other.text = other.text.slice(1); turns++; } return turns; }   The two are one object.
# function defines(source: Source, descriptor) { let turns = 0; while (turns < source.text.length) { arm(source, descriptor, turns); turns++; } return turns; }
# function arm(source: Source, descriptor, turn: number) { if (turn === 3) Object.defineProperty(source, "text", descriptor); }   The field becomes an accessor in a callee.
# The program evaluates text, so code that the build has not seen has the objects and calls the functions.
# RUN: run-in-shell globalThis.register = (freezes, deletes, replaces, relinks, shortens, defines, a, b, c, d, text, other, proto) => { print(deletes(a)); print(relinks(b, { add() { return -2; } })); print(shortens(text, text)); print(defines(other, { get() { return "x"; } })); try { freezes(c); } catch (error) { print(error.name, c.total); } print(replaces(d, proto)); };
# CHECK: 0
# CHECK-NEXT: -2
# CHECK-NEXT: 4
# CHECK-NEXT: 4
# CHECK-NEXT: TypeError 3825
# CHECK-NEXT: 7
# CHECK-NEXT: exited with 0

layout L0 module=m0 fields=[{key="text" declared={type=undefined|null|string flags=[IsExpected, OmitsNull, OmitsUndefined]} flags=[IsRequired]}] ownFieldCount=1
layout L1 kind=Instance name="Counter" module=m0 constructor=f1 fields=[{key="total" declared={type=number} flags=[IsRequired]}, {key="step" declared={type=number} flags=[IsRequired]}] ownFieldCount=2
module m0 path="main.ts" displayPath="main.ts" body=f0 namespaceLayout=L(m0)
entry module=m0
