# function returned(v: Uint8Array, start: number): number { let t = Math.floor(start); for (let i = 0; i < v.length; i++) { if (v[i] === 200) return t; t += v[i]; } return t; }
# function notLeft(v: Uint8Array, start: number): number { let t = Math.floor(start); for (let i = 0; i < v.length; i++) t += v[i] & 1; return t; }
# function byCounter(start: number, n: number, stop: number): number { let sum = start * 1; const end = n | 0, halt = stop | 0; for (let i = 0; i < end; i++) { if (i === halt) break; sum += i & 0; } return sum; }
# function bytesOf(length: number, at: number): Uint8Array { const v = new Uint8Array(length); for (let i = 0; i < length; i++) v[i] = i === at ? 200 : 0; return v; }
# const starts = [-0, 0, 5, -5, 0.5, NaN, -Infinity];
# function all(length: number): void { for (let at = -1; at <= length && at < 10; at++) { let said = ""; for (let s = 0; s < starts.length; s++) said += say(left(bytesOf(length, at), starts[s])) + "," + say(returned(bytesOf(length, at), starts[s])) + "," + say(notLeft(bytesOf(length, at), starts[s])) + "," + say(byCounter(starts[s], length, at)) + " "; report(length + " " + at + " " + said); } }
# all(0);
# all(1);
# all(7);
# all(8);
# all(9);
# all(17);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function say(value) { return Object.is(value, -0) ? "-0" : String(value); } function left(v, start) { let t = Math.floor(start); for (let i = 0;i < v.length; i++) { if (v[i] === 200) break; t += v[i]; } return t; } function returned(v, start) { let t = Math.floor(start); for (let i = 0;i < v.length; i++) { if (v[i] === 200) return t; t += v[i]; } return t; } function notLeft(v, start) { let t = Math.floor(start); for (let i = 0;i < v.length; i++) t += v[i] & 1; return t; } function byCounter(start, n, stop) { let sum = start * 1; const end = n | 0, halt = stop | 0; for (let i = 0;i < end; i++) { if (i === halt) break; sum += i & 0; } return sum; } function bytesOf(length, at) { const v = new Uint8Array(length); for (let i = 0;i < length; i++) v[i] = i === at ? 200 : 0; return v; } const starts = [-0, 0, 5, -5, 0.5, NaN, -1 / 0]; function all(length) { for (let at = -1;at <= length && at < 10; at++) { let said = ""; for (let s = 0;s < starts.length; s++) said += say(left(bytesOf(length, at), starts[s])) + "," + say(returned(bytesOf(length, at), starts[s])) + "," + say(notLeft(bytesOf(length, at), starts[s])) + "," + say(byCounter(starts[s], length, at)) + " "; report(length + " " + at + " " + said); } } all(0); all(1); all(7); all(8); all(9); all(17); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
