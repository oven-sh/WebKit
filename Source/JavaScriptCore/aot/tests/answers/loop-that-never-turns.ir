# made of fbf1cf3479cb37f5
# what is written as a loop and never comes round has no poll. Its body runs once, by every way out
# f3 = once, f4 = left, f5 = labeled, f6 = under, f1 = around, f7 = turns, f2 = tell, f8 = each
# RUN(FORM): walk f3 f5 mechanisms=none+Folding
# FORM-NOT: LoopHint
# RUN(WRITTEN): walk f3 mechanisms=none
# WRITTEN-LABEL: code f3:Body
# WRITTEN: = LoopHint
# RUN(KEPT): walk f7 mechanisms=none+Folding
# KEPT-LABEL: code f7:Body
# KEPT: = LoopHint
# let log = "";
# function once(o: any) { let x; do { x = o.x; } while (false); return x; }
# function left(o: any) { for (;;) { log += "turn;"; if (o.x) return "x"; break; } return "none"; }
# function labeled(o: any) { let text = ""; block: do { text += "a"; if (o.x) break block; text += "b"; } while (false); return text; }
# function under(o: any) { try { do { log += "turn;"; if (o.x) throw new RangeError("x"); } while (false); } catch (e) { return e instanceof RangeError ? e.message : (e as Error).name; } return "none"; }
# function around(n: number, o: any) { let s = 0; for (let i = 0; i < n; i++) { do { s += o.x; } while (false); } return s; }
# function turns(n: number) { let i = 0; do { i++; } while (i < n); return i; }
# function tell(f: () => unknown) { log = ""; try { report(f()); } catch (e) { report((e as Error).name); } report(log); }
# function each(f: (o: any) => unknown) { tell(() => f({ x: 1 })); tell(() => f({ x: 0 })); tell(() => f({ get x() { log += "read;"; return 2; } })); tell(() => f(null)); }
# each(once);
# each(left);
# each(labeled);
# each(under);
# each(o => around(3, o));
# each(o => around(0, o));
# report(turns(0));
# report(turns(5));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; function once(o) { let x; do { x = o.x; } while (false); return x; } function left(o) { for (;; ) { log += "turn;"; if (o.x) return "x"; break; } return "none"; } function labeled(o) { let text = ""; block: do { text += "a"; if (o.x) break block; text += "b"; } while (false); return text; } function under(o) { try { do { log += "turn;"; if (o.x) throw new RangeError("x"); } while (false); } catch (e) { return e instanceof RangeError ? e.message : e.name; } return "none"; } function around(n, o) { let s = 0; for (let i = 0;i < n; i++) { do { s += o.x; } while (false); } return s; } function turns(n) { let i = 0; do { i++; } while (i < n); return i; } function tell(f) { log = ""; try { report(f()); } catch (e) { report(e.name); } report(log); } function each(f) { tell(() => f({ x: 1 })); tell(() => f({ x: 0 })); tell(() => f({ get x() { log += "read;"; return 2; } })); tell(() => f(null)); } each(once); each(left); each(labeled); each(under); each((o) => around(3, o)); each((o) => around(0, o)); report(turns(0)); report(turns(5)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
