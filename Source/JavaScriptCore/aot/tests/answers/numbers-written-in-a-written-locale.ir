# -- source: numbers-written-in-a-written-locale.ts
# declare function report(value: unknown): void;
# function plain(n: number) { return n.toLocaleString("en-US"); }
# function german(n: number) { return n.toLocaleString("de-DE"); }
# function percent(n: number) { return n.toLocaleString("en-US", { style: "percent" }); }
# function digits(n: number) { return n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
# function badLocale(n: number) { return n.toLocaleString("not a locale"); }
# function formatter() { return new Intl.NumberFormat("en-US", { style: "percent", maximumFractionDigits: 1 }); }
# function tell(f: (n: number) => string, n: unknown) { try { report(f(n as number)); } catch (e) { report((e as Error).name); } }
# function all(n: unknown) { tell(plain, n); tell(german, n); tell(percent, n); tell(digits, n); tell(badLocale, n); }
# all(0);
# all(-0);
# all(1234.5678);
# all(-1);
# all(1e21);
# all(2 ** 53 + 2);
# all(1e-7);
# all(NaN);
# all(Infinity);
# all(999999.995);
# all(new Number(5));
# all(12345678901234567890n);
# report(formatter().format(0.1234));
# report(formatter() === formatter());
# report(formatter() instanceof Intl.NumberFormat);
# report(formatter().resolvedOptions().style);
# report(formatter().format(NaN));
# report("end");
# -- end of source
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function plain(n) { return n.toLocaleString("en-US"); } function german(n) { return n.toLocaleString("de-DE"); } function percent(n) { return n.toLocaleString("en-US", { style: "percent" }); } function digits(n) { return n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } function badLocale(n) { return n.toLocaleString("not a locale"); } function formatter() { return new Intl.NumberFormat("en-US", { style: "percent", maximumFractionDigits: 1 }); } function tell(f, n) { try { report(f(n)); } catch (e) { report(e.name); } } function all(n) { tell(plain, n); tell(german, n); tell(percent, n); tell(digits, n); tell(badLocale, n); } all(0); all(-0); all(1234.5678); all(-1); all(1000000000000000000000); all(2 ** 53 + 2); all(0.0000001); all(NaN); all(1 / 0); all(999999.995); all(new Number(5)); all(12345678901234567890n); report(formatter().format(0.1234)); report(formatter() === formatter()); report(formatter() instanceof Intl.NumberFormat); report(formatter().resolvedOptions().style); report(formatter().format(NaN)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
