# made of 4c8bd3a2866a6a3e
# `function outer(...xs) { return inner(...xs); }`: in the copy of outer the state knows what the list holds, so the call of the list is the call that writes the elements out, and inner is copied in its place.
# f1 = inner, f2 = outer, f3 = run
# RUN(FORM): walk f3 mechanisms=all
# FORM: frame 1 callee=f2
# FORM: frame 2 callee=f1
# RUN(NEVER): walk f3 mechanisms=all
# NEVER-NOT: NewArray
# NEVER-NOT: CallList
# NEVER-NOT: CallDirect
# LIBRARY: own
# function inner(a: number, b: number): number { return a * 10 + b; }
# function outer(...xs: [number, number]): number { return inner(...xs); }
# function run(turns: number): number { let sum = 0; for (let i = 0; i < turns; i++) { sum += outer(i, 1); } return sum; }
# report(run(1000));
# report(outer(2, 3));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function inner(a, b) { return a * 10 + b; } function outer(...xs) { return inner(...xs); } function run(turns) { let sum = 0; for (let i = 0;i < turns; i++) { sum += outer(i, 1); } return sum; } report(run(1000)); report(outer(2, 3)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

