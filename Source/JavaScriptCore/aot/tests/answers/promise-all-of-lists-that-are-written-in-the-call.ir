# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; async function a(x) { log += "a"; await null; log += "A"; return x; } async function b(x) { log += "b"; await null; await null; log += "B"; return x; } async function fails(x) { log += "f"; await null; throw "failed " + x; } async function failsEarly(x) { log += "g"; if (x !== log) throw "early " + x; await null; return x; } async function plain(x) { log += "p"; return x; } function both(x) { return Promise.all([a(x), b(x), x]); } function withFailure(x) { return Promise.all([a(x), fails(x), b(x)]); } function withTwoFailures(x) { return Promise.all([fails(x), failsEarly(x)]); } function withEarlyFailure(x) { return Promise.all([failsEarly(x), a(x)]); } function withPlain(x) { return Promise.all([plain(x), a(x), plain(x)]); } function ofNothing() { return Promise.all([]); } function ofValues(x, y) { return Promise.all([x, y]); } function ofOneCall(x) { return Promise.all([a(x)]); } async function awaited(x) { const [first, second] = await Promise.all([a(x), b(x)]); return "" + first + second; } async function beside() { log += "1"; await null; log += "2"; await null; log += "3"; await null; log += "4"; await null; log += "5"; } const thenable = { then(resolve) { log += "t"; resolve("T"); } }; const throwsInGetter = { get then() { log += "w"; throw "no then"; } }; async function tell(started) { const other = beside(); try { const given = await started; report(typeof given === "string" ? given : given.length + ":" + given.join()); } catch (e) { report("thrown " + e); } await other; report(log); log = ""; } function withHole(x) { return Promise.all([a(x), , x]); } async function plainFails(x) { log += "q"; throw "plain " + x; } function withPlainFailure(x) { return Promise.all([a(x), plainFails(x)]); } await tell(both(1)); await tell(both(thenable)); await tell(both(throwsInGetter)); await tell(withFailure(2)); await tell(withTwoFailures(3)); await tell(withEarlyFailure(4)); await tell(withPlain(5)); await tell(ofNothing()); await tell(ofValues(6, thenable)); await tell(ofValues(a(7), b(8))); await tell(ofOneCall(9)); await tell(awaited("z")); await tell(withHole(10)); await tell(withPlainFailure(11)); report(both(1) === both(1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
