# CHECK: = CallResolved
# RUN(ANSWER): run-in-shell mechanisms=all globalThis.sink = each => { for (const value of [undefined, 5, {}, x => print("called", x)]) { try { each(value, 2); } catch (error) { print(error.constructor.name, error.message); } } };
