# function cut(seed: number): string { const text = "aab" + seed; const pattern = /a+/y; return text.replace(pattern, "-"); }
# report(cut(1)); report(cut(2)); report(cut(3));
# report("end");
# A pattern literal with the flag y makes a new object each time it is evaluated: every replacement starts at the first character.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = report => { function cut(seed) { const text = "aab" + seed; const pattern = /a+/y; return text.replace(pattern, "-"); } report(cut(1)); report(cut(2)); report(cut(3)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); }); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }; })();
# CHECK: 4 of 4 of 4
# CHECK-NEXT: exited with 0

