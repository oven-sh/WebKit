# A rope that cannot be resolved goes through loops that do not read it.
# -- source: main.js
# function search(x, n) { let c = 0; for (let j = 0; j < n; j++) { if (j > 5) c += x.indexOf("a", j); } return c; }
# function counted(x, n) { let c = 0; for (let j = 0; j < n; j++) { if (j > 5) c += x.charCodeAt(j) + x.charCodeAt(j + 1); } return c; }
# function nested(x, n) { let c = 0; for (let j = 0; j < n; j++) { for (let i = 0; i < j - 5; i++) c += x.charCodeAt(i); } return c; }
# // A rope of 2^31 - 8 wide characters: a valid string, which can never be resolved. No turn below reads it when n is 2.
# function unresolvable() { let part = String.fromCharCode(0x3042).repeat(8), text = part; for (let i = 3; i < 30; i++) { part += part; text = part + text; } return text; }
# function attempt(name, f) { try { print(name, f()); } catch (e) { print(name, "threw", e.name); } }
# const cases = [["abcdefghijkl", 9], [unresolvable(), 2]];
# for (let i = 0; i < cases.length; i++) {
#     const text = cases[i][0], n = cases[i][1];
#     attempt("search", () => search("" + text, n | 0));
#     attempt("counted", () => counted("" + text, n | 0));
#     attempt("nested", () => nested("" + text, n | 0));
# }
# -- end of source
