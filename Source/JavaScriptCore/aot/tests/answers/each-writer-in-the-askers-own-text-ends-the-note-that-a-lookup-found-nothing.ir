# EACH WAY TO LAY THE NAME THAT THE ASKER'S OWN TEXT CAN TAKE ENDS THE NOTE THAT A LOOKUP FOUND NOTHING (a reviewer's program: one writer a function), AND THE ROAD THAT LAYS MANY NAMES AT ONCE MOVES THE KIND THAT A PLACE REMEMBERS.
# function Meter(level) { this.level = level; this.count = 1; }
# Meter.prototype.read = function () { return this.level; };
# function road(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) return "short " + object.missing; return "full " + object.missing; }
# function defined(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { Object.defineProperty(object, "missing", { value: "defined", configurable: true }); return "short " + object.missing; } return "full " + object.missing; }
# function given(object, give) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { object.__defineGetter__("missing", give); return "short " + object.missing; } return "full " + object.missing; }
# function assigned(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { Object.assign(object, { missing: "assigned" }); return "short " + object.missing; } return "full " + object.missing; }
# function reflected(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { Reflect.set(object, "missing", "reflected"); return "short " + object.missing; } return "full " + object.missing; }
# function libraryLays(object) { object.missing = "laid"; }
# function helped(object) { if ($isPlainInstanceOf(object, Meter) && $findsNoMember(object, "missing")) { libraryLays(object); return "short " + object.missing; } return "full " + object.missing; }
# drive({ Meter, road, defined, given, assigned, reflected, helped });
# f3 = road . f4 = defined . f5 = given . f6 = assigned . f7 = reflected . f8 = helped
# OPTIONS: mechanisms=all
# RUN(FORM): walk f4
# FORM: = FindsNoMember {{*}}key="missing" {{*}}[asksForNoExtraPropertyUnderKey
# RUN(WRITERS): run-in-shell drive = function ({ Meter, defined, given, assigned, reflected, helped }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; const give = () => "given"; print(defined(new Meter(1)), given(new Meter(1), give), assigned(new Meter(1)), reflected(new Meter(1)), helped(new Meter(1))); const right = (answer, word) => answer === "full undefined" || answer === "short " + word; let wrong = 0, short = 0; for (let t = 0; t < 12800; t++) { const answers = [defined(extra()), given(extra(), give), assigned(extra()), reflected(extra()), helped(extra())]; ["defined", "given", "assigned", "reflected", "laid"].forEach((word, at) => { if (!right(answers[at], word)) wrong++; if (answers[at] !== "full undefined") short++; }); } print(wrong, short > 30000 ? "the places answer" : "THE PLACES STAY EMPTY: " + short); };
# WRITERS: short defined short given short assigned short reflected short laid
# WRITERS-NEXT: 0 the places answer
# WRITERS-NEXT: exited with 0
# RUN(BATCH): run-in-shell drive = function ({ Meter, road }) { const extra = () => { const o = new Meter(1); o.unrelated = 1; return o; }; const warm = (ask, make, yes) => { let n = 0; for (let t = 0; t < 6400; t++) { if (ask(make()) === yes) n++; } return n > 6000 ? "the place answers" : "the place stays empty: " + n; }; print(warm(road, extra, "short undefined")); const o = extra(); print(road(o)); Object.assign(o, { a1: 1, a2: 2, a3: 3, missing: "assigned", a4: 4, a5: 5, a6: 6, a7: 7 }); print(road(o), road(extra())); let wrong = 0; for (let t = 0; t < 6400; t++) { const p = extra(); if (road(p) !== "short undefined") wrong++; Object.assign(p, { b1: 1, b2: 2, b3: 3, b4: 4, b5: 5, b6: 6, b7: 7, missing: t }); if (road(p) !== "full " + t) wrong++; } print(wrong); };
# BATCH: the place answers
# BATCH-NEXT: short undefined
# BATCH-NEXT: full assigned short undefined
# BATCH-NEXT: 0
# BATCH-NEXT: exited with 0

