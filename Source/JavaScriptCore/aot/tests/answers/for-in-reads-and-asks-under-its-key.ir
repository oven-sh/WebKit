# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function sum(o) { let text = ""; for (const k in o) text += k + "=" + o[k] + ","; return text; } function has(o) { let text = ""; for (const k in o) text += k + (k in o ? "+" : "-"); return text; } function owns(o) { let text = ""; for (const k in o) text += k + (Object.hasOwn(o, k) ? "+" : "-"); return text; } function changed(o, change) { let text = ""; for (const k in o) { change(o, k); text += k + "=" + o[k] + (k in o ? "+" : "-") + (Object.hasOwn(o, k) ? "+" : "-") + ","; } return text; } function other(o, p) { let text = ""; for (const k in o) text += k + "=" + p[k] + (k in p ? "+" : "-") + ","; return text; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } class Pair { first = 1; second = 2; } function below() { const o = Object.create({ up: "above", a: "hidden" }); o.a = 1; o.b = 2; return o; } function getters() { let n = 0; return { get a() { return ++n; }, b: 2, get c() { return ++n; } }; } function trapped() { return new Proxy({ a: 1, b: 2 }, { get(t, k) { return t[k] * 10; }, has(t, k) { return k === "a"; } }); } function many() { const o = {}; for (let i = 0;i < 40; i++) o["n" + i] = i; return o; } function same(o) { let text = ""; for (const k in o) text += Object.is(o, k) ? "+" : "-"; return text; } tell(() => sum({ a: 1, b: 2, c: 3 })); tell(() => sum(new Pair)); tell(() => sum(JSON.parse('{"x":1,"y":"two","z":null}'))); tell(() => sum(below())); tell(() => sum(getters())); tell(() => sum(trapped())); tell(() => sum(many())); tell(() => sum([5, 6])); tell(() => sum("ab")); tell(() => sum(undefined)); tell(() => has({ a: 1, b: undefined })); tell(() => has(below())); tell(() => has(trapped())); tell(() => has(JSON.parse('{"x":1,"y":2}'))); tell(() => owns({ a: 1, b: undefined })); tell(() => owns(below())); tell(() => owns(new Pair)); tell(() => owns(JSON.parse('{"x":1,"y":2}'))); tell(() => changed({ a: 1, b: 2, c: 3 }, () => {})); tell(() => changed({ a: 1, b: 2, c: 3 }, (o, k) => { if (k === "b") delete o.b; })); tell(() => changed({ a: 1, b: 2, c: 3 }, (o, k) => { if (k === "b") Object.defineProperty(o, "b", { get() { return "got"; }, enumerable: true, configurable: true }); })); tell(() => changed({ a: 1, b: 2, c: 3 }, (o, k) => { if (k === "a") o.z = 26; })); tell(() => changed(JSON.parse('{"a":1,"b":2,"c":3}'), (o, k) => { if (k === "a") { delete o.a; o.a = "again"; } })); tell(() => changed(JSON.parse('{"a":1,"b":2,"c":3}'), (o, k) => { if (k === "b") { delete o.b; Object.setPrototypeOf(o, { b: "above" }); } })); tell(() => other({ a: 1, b: 2 }, { b: "p" })); tell(() => other({ a: 1, b: 2 }, JSON.parse('{"a":"q"}'))); tell(() => same({ a: 1, b: 2 })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
