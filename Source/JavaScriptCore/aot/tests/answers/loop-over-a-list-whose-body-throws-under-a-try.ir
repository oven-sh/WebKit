# the body of a loop over a list throws, and a try around the loop in the same function catches it
# the twin of programs/tail-calls/loop-over-a-list-whose-body-throws-under-a-try.ts, made by integration/tests/program-to-answers.py: the test of a `sound` control is an .ir; the program stands beside it
# LIBRARY: own
# function walk(list: number[], limit: number): string { let seen = ""; try { for (const v of list) { seen += v; if (v === limit) throw new Error("at " + v); } } catch (e) { return seen + "!" + (e as Error).message; } return seen; }
# function deed(limit: number) { return walk([1, 2, 3], limit); }
# report(String(deed(9)));
# for (let i = 0; i < 5; i++) report(String(deed(i)));
# report(String(deed(9)));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function walk(list, limit) { let seen = ""; try { for (const v of list) { seen += v; if (v === limit) throw new Error("at " + v); } } catch (e) { return seen + "!" + e.message; } return seen; } function deed(limit) { return walk([1, 2, 3], limit); } report(String(deed(9))); for (let i = 0;i < 5; i++) report(String(deed(i))); report(String(deed(9))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 8 of 8 of 8
# CHECK-NEXT: exited with 0

