# `$isPlainHeirOf(object, Stream)` IN A PROGRAM THAT MAKES OBJECTS OF THE HEIRS ALONE. The yes also says `object instanceof Stream`, so the count holds two guards of Stream's own side,
# and those count from the start until the guards of Stream begin: with its first own object. A server makes requests and never a plain Readable: its door said no for good.
# So the guards of a constructor function are begun in front of the question, as they are in front of reads off the function.
# function Stream(level) { this.level = level; this.state = "s"; }
# Stream.prototype.on = function () { return "on of Stream"; };                            a function of the library
# function Message(level) { Stream.call(this, level); this.more = 1; }
# Object.setPrototypeOf(Message.prototype, Stream.prototype);
# function Leaf(level) { Message.call(this, level); }
# Object.setPrototypeOf(Leaf.prototype, Message.prototype);
# function road(object) { if ($isPlainHeirOf(object, Stream)) return "short " + object.level + object.state + ($findsDeclaredMember(object, "on", Stream) ? " on" : " -"); return "full " + object.level + object.state; }
# print(road(new Message(5)), road(new Leaf(3)));
# change(Stream, Message);
# print(road(new Message(6)), road(new Leaf(4)));
# (Found by reading, borne out on a real server.)
# f4 = road
# OPTIONS: mechanisms=all
# RUN(FORM): walk f4
# FORM: = BeginMemberGuards layout=L0
# FORM-NEXT: = IsPlainInstanceOf v0 {{*}}receivers=[L0, L1, L2]
# RUN(NOTHING): run-in-shell change = function () { };
# NOTHING: short 5s on short 3s on
# NOTHING-NEXT: short 6s on short 4s on
# NOTHING-NEXT: exited with 0
# RUN(HASINSTANCE): run-in-shell change = function (Stream) { Object.defineProperty(Stream, Symbol.hasInstance, { value() { return false; } }); };
# HASINSTANCE: short 5s on short 3s on
# HASINSTANCE-NEXT: full 6s full 4s
# RUN(PROTOTYPE): run-in-shell change = function (Stream) { Stream.prototype = { }; };
# PROTOTYPE: short 5s on short 3s on
# PROTOTYPE-NEXT: full 6s full 4s
# RUN(ABOVE): run-in-shell change = function (Stream) { Object.defineProperty(Stream.prototype, "state", { get() { return "above"; }, set(value) { }, configurable: true }); };
# ABOVE: short 5s on short 3s on
# ABOVE-NEXT: full 6above full 4above

