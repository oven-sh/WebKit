# A literal lists one field, and the others are stored behind it: on every way, on one way, behind a call that has seen the object.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function make(v) { const o = { a: 1 }; o.c = 3; if (v) o.b = 2; return o; } function early() { const o = { a: 1 }; const seen = look(o); o.b = seen === undefined ? 20 : 21; o.c = 4; return o; } function look(o) { return o.b; } function readA(o) { return o.a; } function readC(o) { return o.c; } report(readA(make(true))); report(look(make(true))); report(look(make(false))); report(readC(make(false))); report(look(early())); report(readC(early())); report("b" in make(false)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
