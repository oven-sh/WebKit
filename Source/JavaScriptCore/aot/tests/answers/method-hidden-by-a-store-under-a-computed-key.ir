# The key of the store is put together when the program runs, and it spells the name of a method.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } } function stepOf(counter, by) { return counter.step(by) } function lay(object, key, value) { object[key] = value } const first = new Counter(10); const second = new Counter(20); report(stepOf(first, 1)); lay(second, "st" + "ep", function (by) { return this.count * by }); report(stepOf(first, 3)); report(stepOf(second, 3)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
