# made of b0f30d943ca61581
# a turn hands the growing text to a function of the program, stores it, compares it, reads under it, switches on it. Each string that was handed out stays what it was while the builder goes on
# f1 = keep, f2 = handed, f3 = states, f4 = compared, f5 = keyed, f6 = twice, f7 = sometimes, f8 = switched
# RUN(FORM): walk f2 f3 f7 mechanisms=all
# FORM-LABEL: code f2:Body
# FORM: StringBuilderBegin
# FORM: StringBuilderToString
# FORM-LABEL: code f3:Body
# FORM: StringBuilderBegin
# FORM: StringBuilderToString
# FORM-LABEL: code f7:Body
# FORM: StringBuilderBegin
# FORM: StringBuilderToString
# let held = "";
# function keep(text: string) { held = held + "[" + text + "]"; }
# function handed(n: number) { let s = ""; for (let i = 0; i < n; i++) { s += "k" + i; keep(s); } return s; }
# function states(n: number) { const kept: string[] = []; let s = ""; for (let i = 0; i < n; i++) { s += "k" + i; kept[i] = s; } let all = ""; for (let i = 0; i < n; i++) all = all + kept[i] + "|"; return all + s; }
# function compared(n: number) { let s = ""; let hits = 0; for (let i = 0; i < n; i++) { s += "ab"; if (s === "ababab") hits += i + 1; } return hits; }
# function keyed(n: number) { const table: Record<string, number> = { a: 1, aa: 20, aaa: 300 }; let s = ""; let sum = 0; for (let i = 0; i < n; i++) { s += "a"; sum += table[s] ?? 4000; } return sum; }
# function twice(n: number) { let s = ""; let out = ""; for (let i = 0; i < n; i++) { s += "k" + i; const one = s; const two = s; out = out + (one === two) + one.length + two.charAt(1); } return out; }
# function sometimes(n: number) { let s = ""; let out = ""; for (let i = 0; i < n; i++) { s += "k" + i; if (i % 3 === 1) out = out + "(" + s + ")"; } return out + s; }
# function switched(n: number) { let s = ""; let out = 0; for (let i = 0; i < n; i++) { s += "a"; switch (s) { case "a": out += 1; break; case "aaa": out += 100; break; default: out += 10000; } } return out; }
# report(handed(0));
# report(held);
# report(handed(3));
# report(held);
# report(states(0));
# report(states(1));
# report(states(5));
# report(states(300).length);
# report(compared(2));
# report(compared(9));
# report(keyed(0));
# report(keyed(5));
# report(twice(3));
# report(sometimes(0));
# report(sometimes(8));
# report(switched(4));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let held = ""; function keep(text) { held = held + "[" + text + "]"; } function handed(n) { let s = ""; for (let i = 0;i < n; i++) { s += "k" + i; keep(s); } return s; } function states(n) { const kept = []; let s = ""; for (let i = 0;i < n; i++) { s += "k" + i; kept[i] = s; } let all = ""; for (let i = 0;i < n; i++) all = all + kept[i] + "|"; return all + s; } function compared(n) { let s = ""; let hits = 0; for (let i = 0;i < n; i++) { s += "ab"; if (s === "ababab") hits += i + 1; } return hits; } function keyed(n) { const table = { a: 1, aa: 20, aaa: 300 }; let s = ""; let sum = 0; for (let i = 0;i < n; i++) { s += "a"; sum += table[s] ?? 4000; } return sum; } function twice(n) { let s = ""; let out = ""; for (let i = 0;i < n; i++) { s += "k" + i; const one = s; const two = s; out = out + (one === two) + one.length + two.charAt(1); } return out; } function sometimes(n) { let s = ""; let out = ""; for (let i = 0;i < n; i++) { s += "k" + i; if (i % 3 === 1) out = out + "(" + s + ")"; } return out + s; } function switched(n) { let s = ""; let out = 0; for (let i = 0;i < n; i++) { s += "a"; switch (s) { case "a": out += 1; break; case "aaa": out += 100; break; default: out += 1e4; } } return out; } report(handed(0)); report(held); report(handed(3)); report(held); report(states(0)); report(states(1)); report(states(5)); report(states(300).length); report(compared(2)); report(compared(9)); report(keyed(0)); report(keyed(5)); report(twice(3)); report(sometimes(0)); report(sometimes(8)); report(switched(4)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
