# report("end");
# -- end of source
# A spread asks whatever the method under @@iterator answers for next, a number too. A pattern and for-of take an object alone.
# LIBRARY: own
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(run) { try { report(String(run())); } catch (error) { report(String(error)); } } function spread(items) { return "[" + [...items].join() + "]"; } function behind(items) { return "[" + [0, ...items, 9].join() + "]"; } function count(...values) { return values.length + ":" + values.join(); } function passed(items) { return count(...items); } function one(items) { const [a] = items; return String(a); } function two(items) { const [a, b] = items; return a + "/" + b; } function none(items) { const [] = items; return "no step"; } function walked(items) { let s = ""; for (const each of items) s += each + ";"; return s; } function left(items) { for (const each of items) return "left at " + each; return "nothing"; } const ways = [spread, behind, passed, one, two, none, walked, left]; function all(items) { for (const way of ways) attempt(() => way(items)); } let steps = 0; const number = { [Symbol.iterator]() { steps = 0; return 5; } }; const text = { [Symbol.iterator]() { steps = 0; return "text"; } }; const truth = { [Symbol.iterator]() { steps = 0; return true; } }; all(number); all(text); all(truth); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
