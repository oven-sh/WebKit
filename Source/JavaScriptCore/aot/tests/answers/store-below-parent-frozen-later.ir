    v4 = GetModuleVariable variable=g1
    v5 = PropGet v4 key="prototype"
    v6 = Builtin builtin=Object
    v7 = Builtin builtin=ObjectSetPrototypeOf
    v8 = Convert v1 declared={type=undefined|null|object flags=[IsExpected]}
    v9 = Call v7, v6, v5, v8 calleeName="Object.setPrototypeOf"
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="print" [isFreeName]
    v12 = Integer integer=1
    v13 = Construct v4, -, v12 calleeName="Made"
    v14 = PropGet v13 key="c"
    v15 = Call v11, -, v14 calleeName="print"
    v16 = Builtin builtin=Function
    v17 = String string="return globalThis.register"
    v18 = Construct v16, -, v17
    v19 = Call v18
    v20 = Call v19, -, v1
    v21 = Integer integer=2
    v22 = Construct v4, -, v21 calleeName="Made"
    v23 = PropGet v22 key="c"
    v24 = Call v11, -, v23 calleeName="print"
    v25 = Undefined
    Return v25
}
