# function Base() {}  Base.prototype.c = 0;  function Made(x) { this.a = x; this.c = x; }  Object.setPrototypeOf(Made.prototype, Base.prototype);
# print(new Made(1).c); register(Base.prototype); print(new Made(2).c);
# A store passes a plain value that lies under its name on a prototype object above, and has a guard of its own that such a value does not end.
# The caller freezes that prototype object once an object is made. From then on the value takes the store, which throws.
# Freezing changes nothing that a read finds, so it ends the guards that stores ask and no other.
# The program evaluates text, so code that the build has not seen runs.
# RUN: run-in-shell globalThis.register = parent => { Object.freeze(parent); };
# CHECK: 1
# CHECK-NEXT: TypeError: Attempted to assign to readonly property
# CHECK-NOT: exited with 0
# CHECK: exited with 3

