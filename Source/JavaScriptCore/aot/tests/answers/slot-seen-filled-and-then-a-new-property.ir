d(make(1, 2))); report(has(make(1, 2))); report(around(make(1, 2), nothing)); report(around(make(1, 2), change)); report(hasAround(make(1, 2), nothing)); report(hasAround(make(1, 2), change)); const later = make(3, 4); report(read(later)); report(has(later)); change(later); report(read(later)); report(has(later)); report(around(later, nothing)); report(inLoop(make(1, 2), nothing, 2)); report(inLoop(make(1, 2), change, 0)); report(inLoop(make(1, 2), change, 2)); report(inLoop(make(1, 2), change, 4)); report(overList([make(1, 2), make(3, 4), make(5, 6)], nothing, 0)); report(overList([make(1, 2), make(3, 4), make(5, 6)], change, 0)); report(overList([make(1, 2), make(3, 4), make(5, 6)], change, 2)); report(readOfAny(list())); report(readOfAny(make(1, 2))); report(hasOfAny(list())); report(hasOfAny(make(1, 2))); report(aroundOfAny(list(), nothing)); report(aroundOfAny(make(1, 2), nothing)); report(aroundOfAny(make(1, 2), change)); report(aroundOfAny(list(), change)); const laterOfAny = make(5, 6); report(readOfAny(laterOfAny)); change(laterOfAny); report(readOfAny(laterOfAny)); report(hasOfAny(laterOfAny)); report(inLoopOfAny(list(), nothing, 1)); report(inLoopOfAny(make(1, 2), nothing, 1)); report(inLoopOfAny(make(1, 2), change, 0)); report(inLoopOfAny(make(1, 2), change, 2)); report(inLoopOfAny(make(1, 2), change, 4)); report(inLoopOfAny(list(), change, 2)); report(calls); function extra(p) { const { x, y, z } = p; return x + y + (z === undefined ? 1000 : z); } function extraInLoop(p, hook, at) { let sum = 0; for (let i = 0;i < 5; i++) { const { x, y } = p, z = "z" in p; if (i === at) hook(p); const nextX = p.x, nextZ = "z" in p; sum = sum * 3 + x + y + (z ? 1 : 0) + nextX + (nextZ ? 2 : 0); } return sum; } report(extra(make(1, 2))); const more = make(1, 2); change(more); report(extra(more)); report(extraInLoop(make(1, 2), nothing, 2)); report(extraInLoop(make(1, 2), change, 2)); report(Object.keys(more).join()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
