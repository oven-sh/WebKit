# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let calls = 0; const log = []; function moved(x, y) { const point = { x, y }; delete point.y; point.y = y; return point; } function sum(point) { return point.x + point.y; } report(sum({ x: 1, y: 2 })); report(sum(moved(3, 4))); function countThenSum(point) { calls++; return point.x + point.y; } report(countThenSum({ x: 1, y: 2 })); report(countThenSum(moved(3, 4))); report(calls); function sumThenCount(point) { const total = point.x + point.y; calls++; return total; } report(sumThenCount({ x: 1, y: 2 })); report(sumThenCount(moved(3, 4))); report(calls); function between(point) { const x = point.x; log.push("between"); return x + point.y; } report(between({ x: 1, y: 2 })); report(between(moved(3, 4))); report(log.length); function made(point) { const copy = { x: point.x, y: 0 }; copy.y = point.y; return copy; } report(made({ x: 1, y: 2 }).y); report(made(moved(3, 4)).y); function both(a, b) { return a.x + a.y + b.x + b.y; } report(both({ x: 1, y: 2 }, moved(3, 4))); report(both(moved(1, 2), { x: 3, y: 4 })); report(both(moved(1, 2), moved(3, 4))); function stored(point, value) { point.x = value; return point.x + point.y; } report(stored({ x: 1, y: 2 }, 5)); report(stored(moved(3, 4), 5)); function inLoop(points) { let total = 0; for (let i = 0;i < points.length; i++) { calls++; total += points[i].x + points[i].y; } return total; } report(inLoop([{ x: 1, y: 2 }, moved(3, 4), { x: 5, y: 6 }])); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + "