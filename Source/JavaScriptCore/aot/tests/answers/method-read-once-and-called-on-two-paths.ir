# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function P(a) { this.a = a; } P.prototype.five = function () { return 5; }; P.prototype.six = function () { return 6; }; const kept = []; function onTwoPaths(first) { const made = new P(1); const m = made.five; let total = 0; if (first) total += m(); kept.push(m); return total + m(); } function inLoop(n) { const made = new P(1); const m = made.six; let total = 0; for (let i = 0; i < n; i++) { if (i & 1) total += m(); } kept.push(m); return total; } async function behindAnAwait(first, later) { const made = new P(2); let total = await later; const m = made.five; if (first) total += m(); kept.push(m); return total; } async function overAnAwait(first, later) { const made = new P(2); const m = made.six; let total = 0; if (first) total += m(); total += await later; kept.push(m); return total + m(); } report(onTwoPaths(true)); report(onTwoPaths(false)); report(inLoop(7)); report(inLoop(0)); behindAnAwait(true, Promise.resolve(100)).then(value => { report(value); return behindAnAwait(false, 200); }).then(value => { report(value); return overAnAwait(true, 300); }).then(value => { report(value); return overAnAwait(false, 400); }).then(value => { report(value); report(kept.length); report(kept.every(m => m === P.prototype.five || m === P.prototype.six)); report("end"); }); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
