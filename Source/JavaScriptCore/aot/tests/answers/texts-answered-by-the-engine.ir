# declare function report(value: unknown): void;
# function upper() { return "abc".toUpperCase(); }
# function lower() { return "ABC def".toLowerCase(); }
# function padded() { return "7".padStart(3, "0"); }
# function paddedBehind() { return "ab".padEnd(5, "xy"); }
# function paddedWithNumber() { return "7".padStart(3, 0 as any); }
# function repeated() { return "ab".repeat(3); }
# function replaced() { return "a-b-c".replace(/-/g, "_"); }
# function replacedOnce() { return "a-b-c".replace("-", "+"); }
# function swapped() { return "a-b".replace(/(\w)-(\w)/, "$2-$1"); }
# function searched() { return "a-b-c".search(/-/); }
# function refused() { return "ab".repeat(-1); }
# function tooLong() { return "ab".repeat(70000).length; }
# function grown() { return "".replaceAll("a", "$`"); }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(upper);
# tell(lower);
