# for (let level = 1; level <= 100000; level++) { const barrel = makeBarrel(level); __exportStar(top, barrel); top = barrel; }
# report(top.first);
# report(top.missing);
# report("second" in top);
# report("missing" in top);
# report(top.level);
# top.late = "late";
