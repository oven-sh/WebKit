# report(typeof Object.getOwnPropertyDescriptor(top, "first").get);
# report(top.second);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { var __createBinding = (this && this.__createBinding) || (Object.create ? (function(o, m, k, k2) { if (k2 === undefined) k2 = k; var desc = Object.getOwnPropertyDescriptor(m, k); if (!desc || ("get" in desc ? !m.__esModule : desc.writable || desc.configurable)) { desc = { enumerable: true, get: function() { return m[k]; } }; } Object.defineProperty(o, k2, desc); }) : (function(o, m, k, k2) { if (k2 === undefined) k2 = k; o[k2] = m[k]; })); var __exportStar = (this && this.__exportStar) || function(m, exports) { for (var p in m) if (p !== "default" && !Object.prototype.hasOwnProperty.call(exports, p)) __createBinding(exports, m, p); }; function makeBarrel(level) { return { __esModule: true, level: level }; } let top = { first: 1, second: 2 }; for (let level = 1; level <= 100000; level++) { const barrel = makeBarrel(level); __exportStar(top, barrel); top = barrel; } report(top.first); report(top.missing); report("second" in top); report("missing" in top); report(top.level); top.late = "late"; report(top.late); report(Object.keys(top).join()); report(typeof Object.getOwnPropertyDescriptor(top, "first").get); report(top.second); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
