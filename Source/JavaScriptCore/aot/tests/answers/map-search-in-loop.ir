# A lookup in a Map or a Set that stands in a loop finds what the same lookup finds outside of one, whatever the key and the table are like, and whether or not the loop writes the table.
# function local() {
#   const table = new Map;
#   for (let k = 0; k < 100; k++) table.set(k * 3, k * 3);
#   let hits = 0, absent = 0;
#   for (let key = 0; key < 1000; key++) { const found = table.get(key); if (found === key) hits++; else if (found === undefined) absent++; }
#   return hits * 1000 + absent;
# }
# class Store { constructor() { const entries = new Map; this.entries = entries; for (let k = 0; k < 100; k++) entries.set(k * 3, k * 3); } score(key) { return this.entries.get(key); } }
# function sweep(store) { the second loop of local(), with store.score(key) in place of table.get(key) }
# function fills() {
#   const table = new Map;
#   let hits = 0;
#   for (let key = 0; key < 1000; key++) { const before = key - 1; if (table.get(before) === before) hits++; if (table.get(key) === undefined) table.set(key, key); }
#   return hits;
# }
# function halves() {
#   const table = new Map;
#   for (let k = 0; k < 300; k++) table.set(k, k);
#   table.set(NaN, NaN); table.set(2147483648, 2147483648); table.delete(7);
#   let hits = 0, absent = 0;
#   for (let key = -3; key < 300; key += 0.5) { the body of the second loop of local(), for each of the keys key, 0 / key and key * 16777216 }
#   return hits * 10000 + absent;
# }
# function few() { local(), with for (let k = 0; k < 5; k++) table.set(k * 2, k * 2) }
# function members() {
#   const set = new Set, table = new Map;
#   for (let k = 0; k < 100; k++) { set.add(k * 3); table.set(k * 5, k); }
#   let inSet = 0, inTable = 0;
#   for (let key = 0; key < 1000; key++) { if (set.has(key)) inSet++; if (table.has(key)) inTable++; }
#   return inSet * 1000 + inTable;
# }
# function sums() { local(), with table.set(k * 3, k) and if (found === undefined) absent++; else total += found; }
# function grows() {
#   const table = new Map;
#   let hits = 0;
#   for (let round = 0; round < 40; round++) { if (table.get(round) === undefined) table.set(round, round); for (let key = 0; key < 40; key++) if (table.get(key) === key) hits++; }
#   return hits;
# }
# function flags() { local(), with table.set(k * 3, true) and if (found === true) hits++; }
# function words() {
#   const table = new Map;
#   table.set("left", 1); table.set("right", 2); table.set("up", 3);
#   let hits = 0, absent = 0;
#   for (let key = 0; key < 1000; key++) {
#     let name = "down", expected = 4;
#     if (key < 300) { name = "left"; expected = 1; } else if (key < 600) { name = "up"; expected = 3; }
#     const found = table.get(name); if (found === expected) hits++; else if (found === undefined) absent++;
#   }
#   return hits * 1000 + absent;
# }
# function manyWords() { words(), with the keys "zero" to "eleven" for 0 to 11, "three", "eleven" and "twelve" looked up, and return (hits * 1000 + absent) * 1000000 + wordsOf(table); }
# function wordsOf(table) { the loop of manyWords() and its first sum }
# if (local() !== 100900) throw "local"; if (sweep(new Store) !== 100900) throw "sweep"; if (fills() !== 999) throw "fills"; if (halves() !== 9060911) throw "halves"; if (few() !== 5995) throw "few";
# if (members() !== 100100) throw "members"; if (sums() !== 4950900) throw "sums"; if (grows() !== 820) throw "grows"; if (flags() !== 100900) throw "flags";
# if (words() !== 600400) throw "words"; if (manyWords() !== 600400600400) throw "manyWords"; throw "end";
# In `local` a hundred keys lie in slots with short numbers, in `halves` three hundred in slots with long numbers, in `few` five among tags.
# In `halves` the keys are whole numbers held as doubles, halves, numbers below zero and past an int32, -0 (0 / key below zero), NaN (0 / 0), and a key that was deleted. NaN finds NaN, which counts as neither.
# In `fills` the table is laid out anew several times while the loop turns, and each turn finds the key that the turn before has added: whatever was read of the table in front of the loop would miss it.
# In `grows` the loop around writes the table and the loop inside only reads it, at each size from one key to forty: from tags to slots. In `flags` no value is a number, so the values lie in a narrow column.
# In `words`, `manyWords` and `wordsOf` the keys are texts that the program writes, in a table small enough for tags and in one with slots.
# No function of the program is out of sight, so nothing is printed: a call that may run unseen code would change what the loops are compiled to. An answer that is wrong is thrown by its name, and "end" where all are right.
# The shell prints what the program throws, and exits with 3.
# RUN: run-in-shell
# CHECK: Exception: end
# CHECK-NEXT: exited with 3

