# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function F(n) { this.n = n; } F.prototype.shared = "from prototype"; F.prototype.method = function() { return "method of " + this.n; }; Object.defineProperty(F.prototype, "guarded", { get() { return "getter " + this.n; }, set(v) { this.seen = v; }, configurable: true }); Object.defineProperty(F.prototype, "fixed", { value: "read only above", writable: false, configurable: true }); class A { n; constructor(n) { this.n = n; } method() { return "A.method " + this.n; } get guarded() { return "A.getter " + this.n; } set guarded(v) { this.seen = v; } } const show = (o) => { let f = ""; for (const k in o) f += k + ","; return Object.keys(o).join(",") + "|" + f; }; function use(o, turn) { const before = [o.shared, o.method(), o.guarded, o.fixed, String(o.toString === Object.prototype.toString), o.seen].join(";"); if (turn & 1) o.shared = "own"; if (turn & 2) o.method = () => "own method " + o.n; o.guarded = "g" + turn; try { o.fixed = "own fixed"; } catch (e) {} if (turn & 4) o.toString = () => "own toString"; if (turn & 4) o.constructor = 5; const after = [o.shared, o.method(), o.guarded, o.fixed, String(o), o.seen, typeof o.constructor].join(";"); if (turn & 1) delete o.shared; if (turn & 2) delete o.method; return before + " -> " + after + " -> " + [o.shared, o.method()].join(";") + " " + show(o); } for (let turn = 0;turn < 8; turn++) { report(use(new F(turn), turn)); report(use(new A(turn), turn)); } function G(n) { this.n = n; } const withOwn = new G(1); withOwn.extra = "own"; const without = new G(2); const readExtra = (o) => o.extra; report(readExtra(withOwn) + String(readExtra(without))); G.prototype.extra = "late on prototype"; report(readExtra(withOwn) + readExtra(without) + ("extra" in without) + Object.hasOwn(without, "extra")); Object.setPrototypeOf(without, { extra: "other prototype" }); report(readExtra(withOwn) + readExtra(without)); function R(n) { this.n = n; } function probe(o) { return ["late" in o, Object.prototype.hasOwnProperty.call(o, "late"), Object.hasOwn(o, "late"), o.late, "never" in o, o.never, Object.hasOwn(o, "never"), Object.prototype.propertyIsEnumerable.call(o, "late")].join(","); } for (let turn = 0;turn < 6; turn++) { const o = new R(turn); report(probe(o)); if (turn % 3 === 0) o.late = undefined; else if (turn % 3 === 1) o.late = turn; report(probe(o)); if (turn > 2) delete o.late; report(probe(o)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
