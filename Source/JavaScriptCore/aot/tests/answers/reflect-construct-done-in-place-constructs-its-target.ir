# function constructed(target, list) { return [Reflect.construct(target, list)][0] }  function constructedFor(target, list, newTarget) { return [Reflect.construct(target, list, newTarget)][0] }
# function constructedLast(target, list) { return Reflect.construct(target, list) }  function withMore(target, list, newTarget, more) { return [Reflect.construct(target, list, newTarget, more)][0] }
# function withoutList(target) { return [Reflect.construct(target)][0] }  function caught(target, list) { try { return Reflect.construct(target, list) } catch (error) { return "caught " + error.message } }
# Reflect.construct(..) as written is marked as done in place: the engine constructs the target itself, so a stack trace out of the constructor lists no frame of the built-in.
# What the built-in refuses, it refuses in its own words: a target or a new.target that is no constructor, a list that is no object or is left out.
# LIBRARY: own
# RUN: run-in-shell globalThis.drive = (constructed, constructedFor, constructedLast, withMore, withoutList, caught) => { class Point { constructor(x, y) { this.x = x; this.y = y; this.made = new.target.name; } } class Other { } class Throws { constructor() { throw new Error("thrown"); } } const attempt = (way, ...operands) => { try { print(JSON.stringify(way(...operands))); } catch (error) { print(error.name + ": " + error.message); } }; attempt(constructed, Point, [1, 2]); (function () { attempt(constructed, Point, arguments); })(3, 4); attempt(constructed, Point, { length: 1, 0: 5 }); attempt(constructedFor, Point, [6, 7], Other); print(constructedFor(Point, [], Other) instanceof Other); attempt(constructedLast, Point, [8, 9]); attempt(withMore, Point, [1, 1], Other, 5); attempt(constructed, () => 1, []); attempt(constructed, Point, 1); attempt(constructedFor, Point, [], () => 1); attempt(withoutList, Point); attempt(constructed, Point, new Array(10000000)); attempt(caught, Point, [1, 2]); attempt(caught, Throws, []); attempt(caught, 1, []); try { constructed(Throws, []); } catch (error) { print(error.stack.split("\n").slice(0, 2).map(line => line.split("@")[0]).join(" ")); } };
# CHECK: {"x":1,"y":2,"made":"Point"}
# CHECK-NEXT: {"x":3,"y":4,"made":"Point"}
# CHECK-NEXT: {"x":5,"made":"Point"}
# CHECK-NEXT: {"x":6,"y":7,"made":"Other"}
# CHECK-NEXT: true
# CHECK-NEXT: {"x":8,"y":9,"made":"Point"}
# CHECK-NEXT: {"x":1,"y":1,"made":"Other"}
# CHECK-NEXT: TypeError: Reflect.construct requires the first argument be a constructor
# CHECK-NEXT: TypeError: Reflect.construct requires the second argument be an object
# CHECK-NEXT: TypeError: Reflect.construct requires the third argument be a constructor if present
# CHECK-NEXT: TypeError: Reflect.construct requires the second argument be an object
# CHECK-NEXT: RangeError: Maximum call stack size exceeded.
# CHECK-NEXT: {"x":1,"y":2,"made":"Point"}
# CHECK-NEXT: "caught thrown"
# CHECK-NEXT: "caught Reflect.construct requires the first argument be a constructor"
# CHECK-NEXT: Throws constructed
# CHECK-NEXT: exited with 0

