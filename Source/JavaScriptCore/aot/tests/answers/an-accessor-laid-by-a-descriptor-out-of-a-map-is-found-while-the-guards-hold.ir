# Duplex.prototype gets nine accessors of Writable.prototype by their descriptors, which duplex.ts reads out of a map that writable.ts has written and laid: `{ writableEnded: accessors.writableEnded }`.
# If the record of the function listed only what a descriptor WRITTEN IN THE BODY lays, those nine would stand there undeclared, and the guards of their names would never hold for any class below.
# The scan says where the descriptor comes from, and of the map that is laid whole which accessor it holds under which name; where objects of the map's layout are all that the descriptor is read off, Link names the functions.
# function Source(a) { this.a = a; }   const accessors = { wide: { configurable: true, get() { return 7; } }, deep: { configurable: true, get() { return 8; }, set(value) { this.a = value; } } };
# Object.defineProperties(Source.prototype, accessors);   const shared = { accessors: undefined };   shared.accessors = accessors;   function Taker(a) { this.a = a; }
# function lay() { const taken = shared.accessors; Object.defineProperties(Taker.prototype, { wide: taken.wide, deep: taken.deep }); }   lay();
# early(Source, Taker);   const made = new Taker(5);   print(ask(made));   change(made, Source, Taker);   print(ask(made));   print(ask(new Taker(6)));   print(made.wide + " " + made.deep);
# Without Guesses and TypedOperations the operation says no everywhere, which is right and shows nothing.
# OPTIONS: mechanisms=all
# RUN(NOTHING): run-in-shell early = function () { }; change = function () { };
# NOTHING: wide deep
