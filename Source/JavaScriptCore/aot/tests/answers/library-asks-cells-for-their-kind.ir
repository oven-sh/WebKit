# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function fulfilled(n) { return Promise.resolve(n); } function thenable(n) { return { then(resolve) { resolve(n); } }; } async function viaAsync(n) { return n; } async function all() { return (await Promise.all([1, fulfilled(2), thenable(3), viaAsync(4)])).join(); } async function raced() { return await Promise.race([fulfilled(5), thenable(6)]); } async function chained() { return await fulfilled(8).then(value => fulfilled(value + 1)).then(value => value * 2); } async function caughtLater() { return await fulfilled(9).then(value => { throw "thrown " + value; }).catch(error => "caught " + error); } async function twice() { const made = fulfilled(10); const first = await made; const second = await made; return first + second; } report(await all()); report(await raced()); report(await chained()); report(await caughtLater()); report(await twice()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
