# interface Rest { kind: number; last: unknown; n: number }
# interface RestOne extends Rest { kind: 1; value: number }
# interface RestTwo extends Rest { kind: 2; text: string }
# function RestMaker(this: Rest, kind, ...rest) { this.kind = kind; this.last = rest[rest.length - 1]; this.n = rest.length; }
# interface Link { kind: number; next: unknown }
# interface LinkOne extends Link { kind: 1; value: number }
# interface LinkTwo extends Link { kind: 2; text: string }
# function DeepMaker(this: Link, kind) { this.kind = kind; this.next = new Deep(id(kind)); }
# const Deep = DeepMaker;
# function tell(made) { report(made.kind); report(made.last); report(made.n); }
# tell(new RestMaker(id(1))); tell(new RestMaker(id(2), "a")); tell(new RestMaker(id(9), 1, 2, 3, 4, 5, 6, "g"));
# try { new Deep(id(1)); report("no end"); } catch (e) { report(e.name); }
# Nobody knows the tag at any `new`. Where no call is made direct, each calls the entry of its constructor that makes `this`, past the stub that finds the entry and tests the stack in front of it.
# The entry of a function with a rest parameter takes its arguments in a buffer: it pushes the argument registers against the stack words of its caller, with no argument, with one and with more than there are registers.
# A constructor that constructs itself without end stops where the stack ends, with a RangeError that the program catches.
# RUN: run-in-shell globalThis.report = value => print(String(value));
# CHECK: 1
# CHECK-NEXT: undefined
# CHECK-NEXT: 0
# CHECK-NEXT: 2
# CHECK-NEXT: a
# CHECK-NEXT: 1
# CHECK-NEXT: 9
# CHECK-NEXT: g
# CHECK-NEXT: 7
# CHECK-NEXT: RangeError
# CHECK-NEXT: exited with 0
