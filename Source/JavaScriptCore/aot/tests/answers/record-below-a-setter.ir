# type Node = { v: number; next?: Node; seen?: boolean }
# function mark(node: Node, other: Node, times: number) { for (let i = 0; i < times; i++) { node.seen = true; node.next = other; } return node; }
# const plain = { v: 1 }, below = { v: 2 }; Object.setPrototypeOf(below, above); show(mark(plain, below, 2)); show(mark(below, plain, 2)); show(mark(below, plain, 1)); id(mark);
# Whoever gets hold of `mark` may call it with anything.
# A store into a slot asks whether the record still stands below Object.prototype. `below` does not:
# the stores go by name, which calls the setter above in each turn and makes `next` a property of the record.
# RUN: run-in-shell globalThis.above = { set seen(value) { print("set " + value); } }; globalThis.show = node => print(Object.keys(node).join() + " " + node.seen + " " + node.next.v);
# CHECK: v,seen,next true 2
# CHECK-NEXT: set true
# CHECK-NEXT: set true
# CHECK-NEXT: v,next undefined 1
# CHECK-NEXT: set true
# CHECK-NEXT: v,next undefined 1
# CHECK-NEXT: exited with 0

