# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function pass(i, bad) { if (i === bad) throw "bad" + i; return i; } function caught(n, bad) { let s = ""; try { for (let i = 0;i < n; i++) s += "k" + pass(i, bad) + ","; } catch (e) { return "caught " + e + " with " + s; } return s; } function begunInFront(n, bad) { let s = "head:"; try { pass(0, bad - 100); for (let i = 0;i < n; i++) { s += pass(i, bad); s += ";"; } pass(1, bad - 200); } catch (e) { s += "!" + e; } return s; } function dead(n, bad) { try { let s = ""; for (let i = 0;i < n; i++) s += pass(i, bad) + ","; return s; } catch (e) { return "no text, " + e; } } function kept(n, bad) { let s = ""; let misses = 0; for (let i = 0;i < n; i++) { try { s += pass(i, bad); } catch { misses++; } } return s + "/" + misses; } function keptAndRead(n, bad) { let s = ""; let seen = ""; for (let i = 0;i < n; i++) { try { s += "<" + pass(i, bad) + ">"; } catch { seen += s.length + "|" + s + "|"; } } return s + "/" + seen; } function leftFromCatch(n, bad) { let s = ""; for (let i = 0;i < n; i++) { try { s += pass(i, bad); } catch { return "left with " + s; } } return s; } function nested(n, bad) { let s = ""; try { for (let r = 0;r < n; r++) { for (let c = 0;c < 3; c++) s += pass(r * 3 + c, bad); s += "/"; } } catch (e) { return s.length + ":" + s; } return s; } function cleaned(n, bad) { let s = ""; let ends = 0; try { for (let i = 0;i < n; i++) { try { s += pass(i, bad) + "."; } finally { ends++; } } } catch (e) { return s + "/" + ends + "/" + e; } return s + "/" + ends; } function two(n, m) { let s = ""; for (let i = 0;i < n; i++) s += i; for (let j = 0;j < m; j++) s += "-" + j; return s; } function three(n) { let s = "a"; for (let i = 0;i < n; i++) s += i; for (let j = 0;j < n; j++) s += "b"; for (let k = 0;k < n; k++) s += k; return s + s.length; } function readBetween(n) { let s = ""; for (let i = 0;i < n; i++) s += i; const between = s; for (let j = 0;j < n; j++) s += j; return between + "/" + s; } function secondMayNotRun(n, again) { let s = ""; for (let i = 0;i < n; i++) s += i; if (again) { for (let j = 0;j < n; j++) s += "x"; } return s; } for (let bad = -1;bad < 5; bad++) report(caught(4, bad)); for (let bad = -1;bad < 4; bad++) report(begunInFront(3, bad)); report(begunInFront(3, 100)); report(begunInFront(3, 201)); for (let bad = -1;bad < 3; bad++) report(dead(3, bad)); for (let bad = -1;bad < 4; bad++) report(kept(4, bad)); for (let bad = -1;bad < 4; bad++) report(keptAndRead(4, bad)); for (let bad = -1;bad < 4; bad++) report(leftFromCatch(4, bad)); for (let bad = -1;bad < 7; bad += 2) report(nested(2, bad)); for (let bad = -1;bad < 3; bad++) report(cleaned(3, bad)); report(two(0, 0)); report(two(3, 0)); report(two(0, 3)); report(two(3, 3)); report(three(0)); report(three(2)); report(readBetween(3)); report(secondMayNotRun(3, false)); report(secondMayNotRun(3, true)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
