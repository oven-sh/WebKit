# Reflect.construct(..) is the last thing that a function does. Where it constructs, the function stays on the stack. Where it refuses an operand, it is a call in tail position
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function Throws() { "use strict"; throw new Error("thrown"); } const arrow = () => 1; function last(callee) { "use strict"; return Reflect.construct(callee, []); } function lastWithOperands(callee) { "use strict"; return Reflect.construct(callee, [1, 2]); } function lastForAnother(callee) { "use strict"; return Reflect.construct(Throws, [], callee); } function lastWithoutList(callee) { "use strict"; return Reflect.construct(callee, 1); } function kept(callee) { "use strict"; return [Reflect.construct(callee, [])]; } function Constructed(callee) { "use strict"; return Reflect.construct(callee, []); } function constructs(callee) { "use strict"; return [new Constructed(callee)]; } function names(error) { "use strict"; const lines = error.stack.split("\n"); let text = ""; for (let index = 0; index < lines.length && lines[index].split("@")[0] !== "attempt"; index += 1) text += lines[index].split("@")[0] + " "; return text; } function attempt(way, callee) { "use strict"; try { way(callee); return "nothing"; } catch (error) { return names(error); } } report(attempt(last, Throws)); report(attempt(last, arrow)); report(attempt(last, 1)); report(attempt(lastWithOperands, Throws)); report(attempt(lastWithOperands, arrow)); report(attempt(lastForAnother, Throws)); report(attempt(lastForAnother, arrow)); report(attempt(lastWithoutList, Throws)); report(attempt(lastWithoutList, arrow)); report(attempt(kept, Throws)); report(attempt(kept, arrow)); report(attempt(constructs, Throws)); report(attempt(constructs, arrow)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
