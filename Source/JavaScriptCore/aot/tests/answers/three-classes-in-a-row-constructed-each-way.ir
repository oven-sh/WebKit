# class Low { constructor(a) { this.a = a } who() { return "low" } sum() { return this.a } }
# class Middle extends Low { constructor(a, b) { super(a); this.b = b } who() { return "middle over " + super.who() } sum() { return super.sum() + this.b } }
# class High extends Middle { constructor(a, b, c) { super(a, b); this.c = c } sum() { return super.sum() + this.c } }
# function describe(object) { return object.who() + " " + object.sum() }
# report(describe(new Low(1)));
# report(describe(new Middle(1, 2)));
# report(describe(new High(1, 2, 3)));
# report(Object.getPrototypeOf(new High(1, 2, 3)) === High.prototype);
# report(Object.getPrototypeOf(new Middle(1, 2)) === Middle.prototype);
# report(new High(1, 2, 3) instanceof Low);
# report(new Low(1) instanceof Middle);
# const reflected = Reflect.construct(Low, [7], High);
# report(reflected instanceof High);
# report(reflected.a);
# report(reflected.c);
# report(reflected.who());
# report(Object.keys(new High(1, 2, 3)).join());
# report("end");
# `new` of each class of a row, and Reflect.construct() of the lowest with the highest as new.target: the object has the layout that new.target selects.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Low { constructor(a) { this.a = a } who() { return "low" } sum() { return this.a } } class Middle extends Low { constructor(a, b) { super(a); this.b = b } who() { return "middle over " + super.who() } sum() { return super.sum() + this.b } } class High extends Middle { constructor(a, b, c) { super(a, b); this.c = c } sum() { return super.sum() + this.c } } function describe(object) { return object.who() + " " + object.sum() } report(describe(new Low(1))); report(describe(new Middle(1, 2))); report(describe(new High(1, 2, 3))); report(Object.getPrototypeOf(new High(1, 2, 3)) === High.prototype); report(Object.getPrototypeOf(new Middle(1, 2)) === Middle.prototype); report(new High(1, 2, 3) instanceof Low); report(new Low(1) instanceof Middle); const reflected = Reflect.construct(Low, [7], High); report(reflected instanceof High); report(reflected.a); report(reflected.c); report(reflected.who()); report(Object.keys(new High(1, 2, 3)).join()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
