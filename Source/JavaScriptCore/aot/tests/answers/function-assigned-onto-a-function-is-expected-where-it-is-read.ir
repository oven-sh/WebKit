# made of 528d1d8ded4981c1
# `Object.assign(holder, { Point })`, where holder is a function: what lands on a function lies there under its key as what a store by name lays there does. Two functions are copied under the name here, so nothing is held of the read and the construction stays as written.
# f1 = Point, f2 = run
# RUN(HELD): link held calls mechanisms=all
# HELD-NOT: call f2 {{*}} -> f1
# function Point(this: any, x: number) { this.x = x; }
# const holder: any = function Holder() {};
# Object.assign(holder, { Point, tag: 1 });
# function run(turns: number): number { let sum = 0; for (let i = 0; i < turns; i++) { sum += new holder.Point(i).x; } return sum; }
# report(run(100));
# Object.assign(holder, { Point: function Other(this: any, x: number) { this.x = -x; } });
# report(run(100));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function Point(x) { this.x = x; } const holder = function Holder() {}; Object.assign(holder, { Point, tag: 1 }); function run(turns) { let sum = 0; for (let i = 0;i < turns; i++) { sum += new holder.Point(i).x; } return sum; } report(run(100)); Object.assign(holder, { Point: function Other(x) { this.x = -x; } }); report(run(100)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
