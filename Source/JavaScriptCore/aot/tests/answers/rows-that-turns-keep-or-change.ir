# type Row = { n: number }
# Five loops in loops, called by text with rows of the program, an object of the text, undefined, null, a number and a string.
# Each fills a list of 100 with `row` and sums rows[i].n, or rows[k].n, in 100 x 100 turns. What stands in front of the inner loop must be what each turn would have read, and what throws must throw.
# In `stores` the first turn lays `other` over rows[i]. In `shortens` each turn takes an element away, so rows[1] is gone when its turn comes. In `arm` the access is passed by where `on` is false.
# RUN: run-in-shell globalThis.sink = () => { }; globalThis.register = (total, stores, shortens, rowOfTurn, arm, row, other) => { const tell = (f, ...given) => { try { return String(f(...given)); } catch (error) { return error.constructor.name; } }; for (const each of [row, { n: 5 }, undefined, null, 7, "text"]) print(tell(total, each), tell(stores, each, other), tell(shortens, each), tell(rowOfTurn, each), tell(arm, each, true), tell(arm, each, false)); };
# CHECK: 30000 69600 TypeError 30000 30000 0
# CHECK-NEXT: 50000 69800 TypeError 50000 50000 0
# CHECK-NEXT: TypeError TypeError TypeError TypeError TypeError 0
# CHECK-NEXT: TypeError TypeError TypeError TypeError TypeError 0
# CHECK-NEXT: NaN NaN TypeError NaN NaN 0
# CHECK-NEXT: NaN NaN TypeError NaN NaN 0
# CHECK-NEXT: exited with 0

layout L0 module=m0 fields=[{key="n" declared={type=number} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.ts" displayPath="main.ts" body=f0 namespaceLayout=L(m0)
entry module=m0
data d0 root=Array{contents=undefined|null|L0} module=m0
