data d4 root=Array{contents=undefined|null|L0} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="register" [isFreeName]
    v2 = Integer integer=3
    v3 = NewObject -, v2 layout=L0 fields=[0]
    v4 = FinishObject v3
    v5 = Integer integer=7
    v6 = NewObject -, v5 layout=L0 fields=[0]
    v7 = FinishObject v6
    v8 = NewClosure function=f1
    v9 = NewClosure function=f2
    v10 = NewClosure function=f3
    v11 = NewClosure function=f4
    v12 = NewClosure function=f5
    v13 = Call v1, -, v8, v9, v10, v11, v12, v4, v7 calleeName="register"
    Return v13
}
