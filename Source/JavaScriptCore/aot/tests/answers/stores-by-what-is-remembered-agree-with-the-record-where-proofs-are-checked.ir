# declare function id(value: any): any;
# declare function print(...values: unknown[]): void;
# class Foo { p: string = "foo-p"; }
# class Bar { q: string = "bar-q"; }
# class HoldsFoo { x: Foo = new Foo(); }
# class HoldsBar { x: Bar = new Bar(); }
# function put(holder: any, value: any): void { holder.x = value; }
# function readP(holder: HoldsFoo): string { return holder.x.p; }
# function readQ(holder: HoldsBar): string { return holder.x.q; }
# let wrong = 0;
# let last = "";
# for (let turn = 0; turn < 300; turn++) {
#   const holdsFoo = id(new HoldsFoo());
#   const holdsBar = id(new HoldsBar());
#   const foo = id(new Foo());
#   put(holdsFoo, foo);
#   put(holdsBar, foo);
#   last = readP(holdsFoo) + " " + readQ(holdsBar);
#   if (last !== "foo-p undefined") wrong++;
# }
# print(wrong, last);
# Two classes have one field each, of one name, at one place and in one form, so the table of fields says the same of both. The written types of the fields differ, and each slot is held to its own.
# `id` is code that the build has not seen, so the store in `put` is closed: it goes through the table of fields, and what it remembers of the kinds that a field has taken it remembers under the index of the entry.
# Layouts read one entry only where their records of the field say the same. Else the Foo that the field of HoldsFoo took goes into the field of HoldsBar untested, and readQ takes it for a Bar.
# Here proofs are checked at run time: the store that goes by what it remembers holds that against the record of the field, its flags and its type, and stops where the two differ. They agree, and every typed read finds what is proven.
# OPTIONS: testing=CheckProofsAtRunTime
# RUN: run-in-shell
# CHECK: 0 foo-p undefined
# CHECK-NEXT: exited with 0

