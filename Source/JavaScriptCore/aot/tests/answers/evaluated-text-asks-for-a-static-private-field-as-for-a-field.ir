# A STATIC PRIVATE FIELD IS A FIELD FOR THE TEXT OF A DIRECT EVAL. The front end keeps its value in a slot, here a variable of the module, and no object has a property for it.
# Texts get a private name of their own for the field of the class object when one first asks, and JSObject's private field functions, which find no property under that name, ask the run time of direct eval for the slot.
# Before the field has its value `#total in this` is false and a read or a store throws the error of a field, where a static method beside it is there from the start. A function that the text made early answers once the value is there.
# On the class the text reads, stores and updates what compiled code reads. On a subclass, an object of no class, a number, null and undefined it answers and throws as the same text does in the shell.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(run) { try { return String(run()); } catch (error) { return error.name + ": " + error.message; } } let later; class Registry {   static #step() { return 1; }   static { report(eval("#total in this")); report(#total in this); report(eval("#step in this")); report(attempt(() => eval("this.#total"))); report(attempt(() => eval("this.#total = 5"))); later = eval("() => String(#total in this) + this.#total"); }   static #total = 7;   static ask(text, value) { return eval(text); }   static read() { return this.#total; } } class Below extends Registry {} function probe(value) { report(attempt(() => Registry.ask("#total in value", value))); report(attempt(() => Registry.ask("value.#total", value))); report(attempt(() => Registry.ask("value.#total = 1", value))); report(attempt(() => Registry.ask("value.#total++", value))); report(attempt(() => Registry.ask("eval('value.#total')", value))); } report(later()); report(Registry.ask("#total in value", Registry)); report(Registry.ask("value.#total", Registry)); report(Registry.ask("value.#total = 9", Registry)); report(Registry.read()); report(Registry.ask("value.#total++", Registry)); report(Registry.ask("eval('value.#total += 2')", Registry)); report(Registry.read()); probe(Below); probe({}); probe(5); probe(null); probe(undefined); report(Registry.read()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
