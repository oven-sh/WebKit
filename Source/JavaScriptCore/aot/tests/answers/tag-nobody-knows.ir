# interface Base { kind: number; pos: number; sum: number }
# interface Num extends Base { kind: 1; value: number }
# interface Str extends Base { kind: 2; text: string }
# function NodeMaker(this: Base, kind, pos, a, b, c) { this.kind = kind; this.pos = pos; this.sum = a + b + c; }
# const Node = NodeMaker;
# function make(kind, pos) { return new Node(kind, pos, 1, 2, 3); }
# function few(kind) { return new Node(kind); }
# function tell(n) { report(n.kind); report(n.pos); report(n.sum); report(n instanceof Node); }
# tell(make(id(1), 7)); tell(make(id(2), 8)); tell(make(id(9), 9)); tell(make(id("x"), 10)); tell(few(id(1)));
# const num = make(id(1), 0); num.value = 5; report(num.value);
# const str = make(id(2), 0); str.text = "t"; report(str.text);
# Node.prototype = { marker: 5 };
# const late = make(id(1), 11); report(late.marker); report(late.kind); report(late instanceof Node);
# report("end");
# Nobody knows the tag at either `new`, so both call the entry of the constructor that makes `this`: with more arguments than there are registers, and with fewer than the constructor has parameters.
# The tag of a member, the tag of no member and a value that is no number each give an object that answers as it should, also below the object that `prototype` holds later.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function NodeMaker(kind, pos, a, b, c) { this.kind = kind; this.pos = pos; this.sum = a + b + c; } const Node = NodeMaker; function make(kind, pos) { return new Node(kind, pos, 1, 2, 3); } function few(kind) { return new Node(kind); } function tell(n) { report(n.kind); report(n.pos); report(n.sum); report(n instanceof Node); } tell(make(1, 7)); tell(make(2, 8)); tell(make(9, 9)); tell(make("x", 10)); tell(few(1)); const num = make(1, 0); num.value = 5; report(num.value); const str = make(2, 0); str.text = "t"; report(str.text); Node.prototype = { marker: 5 }; const late = make(1, 11); report(late.marker); report(late.kind); report(late instanceof Node); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 26 of 26 of 26
# CHECK-NEXT: exited with 0

