# The first localeCompare makes the default collator. The next one that the run time answers tells compiled code the weights of ASCII characters, in a word of the instance that a hardened engine must not have made read-only.
# The stub in front of the operation reads the word, and so do the two forms that a loop has in line.
# -- source: main.js
# function order(a, b) { return a.localeCompare(b); }
# function sum(left, right) { let total = 0; for (let i = 0; i < left.length; i++) total += left[i].localeCompare(right[i]) * (i + 1); return total; }
# function countBefore(name, list) { let count = 0; for (let i = 0; i < list.length; i++) if (name.localeCompare(list[i]) > 0) count++; return count; }
# print(order("a", "B"), order("b", "A"), order("y", "j"), order("a", "A"), order("\xe9", "f"));
# print(sum(["apple", "Pears", "yards"], ["Berry", "lemon", "jokes"]), countBefore("yam", ["Date", "Zest", "jam", "yam"]));
# -- end of source
# RUN(COUNT): compile LocaleComparesToWords mechanisms=all
# COUNT-NOT: statistic LocaleComparesToWords 0
# RUN(KNOWN): run-in-shell --useDollarVM=1 $vm.setUserPreferredLanguages(["en"]);
