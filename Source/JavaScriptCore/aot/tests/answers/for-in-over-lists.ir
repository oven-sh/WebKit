# tell(() => changed([1, 2, 3], () => {}));
# tell(() => changed([1, 2, 3, 4], (list, i) => { if (i === "1") list.pop(); }));
# tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list.push(9); }));
# tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list.length = 0; }));
# tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") delete list[2]; }));
# tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list[100000] = 5; }));
# tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") (list as unknown[])[1] = "text"; }));
# tell(() => asked([1, 2, 3]));
# tell(() => asked(holes()));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function walk(list) { let text = ""; for (const i in list) text += typeof i + i + "=" + list[i] + ","; return text; } function store(list) { for (const i in list) list[i] = i; let text = ""; for (let at = 0;at < list.length; at++) text += typeof list[at] + list[at] + ","; return text; } function changed(list, change) { let text = ""; for (const i in list) { change(list, i); text += i + "=" + list[i] + ","; } return text + list.length; } function asked(list) { let text = ""; for (const i in list) text += (i in list ? "+" : "-") + (i === "1" ? "one" : i + 1) + ","; return text; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function holes() { const list = [1, 2, 3, 4]; delete list[1]; return list; } function above() { const list = [1, 2, 3]; delete list[1]; Object.setPrototypeOf(list, Object.assign(Object.create(Array.prototype), { 1: 20 })); return list; } function named() { return Object.assign([1, 2], { name: 9 }); } function sparse() { const list = []; list[3] = 4; list[1e5] = 5; return list; } function getter() { const list = [1, 2, 3]; Object.defineProperty(list, 1, { get() { return 20; }, enumerable: true, configurable: true }); return list; } tell(() => walk([1, 2, 3])); tell(() => walk([])); tell(() => walk([1.5, 2.5])); tell(() => walk(holes())); tell(() => walk(above())); tell(() => walk(named())); tell(() => walk(sparse())); tell(() => walk(getter())); tell(() => walk(Object.freeze([7, 8]))); tell(() => walk(JSON.parse("[4,5]"))); tell(() => walk({ 0: 1, 1: 2, x: 3 })); tell(() => walk(new Uint8Array([7, 8]))); tell(() => walk("ab")); tell(() => walk(new Proxy([1, 2], {}))); tell(() => walk(null)); tell(() => store([10, 20, 30])); tell(() => store(["a", , "c"])); tell(() => changed([1, 2, 3], () => {})); tell(() => changed([1, 2, 3, 4], (list, i) => { if (i === "1") list.pop(); })); tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list.push(9); })); tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list.length = 0; })); tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") delete list[2]; })); tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list[1e5] = 5; })); tell(() => changed([1, 2, 3], (list, i) => { if (i === "0") list[1] = "text"; })); tell(() => asked([1, 2, 3])); tell(() => asked(holes())); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
