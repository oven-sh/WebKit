# class Counter { total = 0; constructor(public step: number) {} add(value: number) { this.total = (this.total + value * this.step) | 0; return this.total; } }
# function drive(counter: Counter) { let last = 0; for (let i = 0; i < 100; i++) last = counter.add(i); return last; }
# Whatever a loop that calls counter.add(i) does with what lies in `total`, memory is up to date wherever somebody looks, and here somebody looks. Each function makes a hundred turns with a step of 3.
# `both` adds through two names, which are one object and then two. `looks` adds through one name and reads `total` through the other.
# `throws` throws in turn 50, and whoever catches reads the field. `caught` catches by itself.
# The second `drive` begins at 2147479823: the sum of turn 50 wraps to -2147483648, the least int32.
# `armed` calls a function that in turn 50 makes the field read-only, which keeps what lies there, and in another object makes it an accessor.
# `direct` reads and stores the field in the loop itself, and `reset` stores 0 in front of its loop.
# RUN: run-in-shell globalThis.register = (drive, both, throws, caught, armed, direct, looks, reset, a, b, c, d, e, f, g, h, i, j, k, l, m) => { print(drive(a), a.total); print(both(b, b), b.total); print(both(c, d), c.total, d.total); try { throws(e); } catch (thrown) { print(thrown, e.total); } print(caught(f)); g.total = 2147479823; print(drive(g), g.total); try { armed(h, { writable: false }); } catch (error) { print(error.name, h.total); } const log = []; print(armed(i, { get() { return 7; }, set(value) { log.push(value); } }), log.length, log[0], log[48]); print(direct(j), j.total); print(looks(k, k)); print(looks(l, m), l.total); print(reset(a), a.total); };
# CHECK: 14850 14850
# CHECK-NEXT: 29700 29700
# CHECK-NEXT: 14850 14850 14850
# CHECK-NEXT: 50 3825
# CHECK-NEXT: 3825
# CHECK-NEXT: -2147472623 -2147472623
# CHECK-NEXT: TypeError 3825
# CHECK-NEXT: 7 49 160 304
# CHECK-NEXT: 4950 4950
# CHECK-NEXT: 14850
# CHECK-NEXT: 0 14850
# CHECK-NEXT: 14850 14850
# CHECK-NEXT: exited with 0

