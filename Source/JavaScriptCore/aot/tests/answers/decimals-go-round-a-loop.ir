# STATISTIC: DecimalRuns >= 1
# RUN: run-in-shell --useDecimal=1 globalThis.sink = f => { const D = text => new Decimal(text), show = f => { try { print(String(f())); } catch (error) { print(error.name); } }; show(() => f([])); show(() => f([D("0.5"), D("0.5"), D("1e-40"), D("2")])); show(() => f([D("1"), 2])); show(() => f([D("1"), new (class extends Decimal { })("2")])); const many = []; for (let i = 0; i < 100000; i++) many[i] = D("0.01"); show(() => f(many)); show(() => f([]) === f([])); };
