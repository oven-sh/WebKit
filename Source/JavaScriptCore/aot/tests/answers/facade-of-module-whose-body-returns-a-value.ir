# the run time finds the file behind a facade whether the body of the facade calls the file or asks the loader for it: the body of this file returns a value, so the file has no start
# file.cjs: print("the file runs"); module.exports = 1; return 5;      main.js: import one from "./file.cjs"; print(one);
# RUN: plan module-starts
# CHECK-NOT: body=f1
# CHECK-NOT: bare-site
# CHECK-NOT: module m1 called-where-required
# RUN(WALK): walk f2 mechanisms=none
# WALK: EvaluateRequiredModule module=m1 referrer=m2
# RUN(NONE): run-in-shell mechanisms=none
# NONE: the file runs
# NONE-NEXT: 1
# NONE-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: the file runs
# ALL-NEXT: 1
# ALL-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m2 completes=true isHoisted=true}, {target=m2 completes=true}]
module m1 path="/file.cjs" displayPath="file.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g0
module m2 path="#2" displayPath="file.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f2 requests=[{target=m1 kind=Require completes=true}] syntheticExports=[{name="default" variable=g1}]
entry module=m0
variable g0 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="default" module=m2 declared={type=anything|absent}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = GetModuleVariable variable=g1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = Call v2, -, v0
    Return
}
function f1 name="file" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="the file runs"
    v3 = Call v1, -, v2
    v4 = Integer integer=1
    PutModuleVariable v4 variable=g0
    v6 = Integer integer=5
    Return v6
}
function f2 name="facadeOfFile" module=m1 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m2 [isBare]
    Return
}
