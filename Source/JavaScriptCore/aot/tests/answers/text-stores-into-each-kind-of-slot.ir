# interface Point { x: number }   interface Item { any: unknown; child: Point | null; flag: boolean; maybe?: number; small: number; text: string }
# function keep(change) { const o: Item = { any: "any", child: { x: 1 }, flag: true, maybe: 1.5, small: 7, text: "text" }; change(o); read(o); }
# function read(o: Item) { report(o.small); report(o.flag); report(o.maybe); report(o.text); report(o.child); report(o.any); }
# function storeSmall(o, v) { o.small = v; }   register(keep, storeSmall);
# Text stores into each kind of slot what fits it and what does not, and compiled code reads what plain code reads.
# `small` and `flag` are filled with a number and a boolean at birth, and undefined and null are stored there as well.
# A store of text, and a store by name of compiled code, finds the field in a table and goes by the type in its record.
# RUN: run-in-shell globalThis.register = (keep, storeSmall) => { let seen = []; globalThis.report = value => { seen.push(typeof value + ":" + String(value)); }; const run = (label, change) => { seen = []; keep(change); print(label + " " + seen.join(" ")); }; const small = (o, v) => { o.small = v; }; const flag = (o, v) => { o.flag = v; }; const maybe = (o, v) => { o.maybe = v; }; const text = (o, v) => { o.text = v; }; const child = (o, v) => { o.child = v; }; const any = (o, v) => { o.any = v; }; const all = (o, v) => { small(o, v); flag(o, v); maybe(o, v); text(o, v); child(o, v); any(o, v); }; run("warm", o => { const kept = o.child; for (let i = 0; i < 40; i++) { small(o, i + 0.5); storeSmall(o, i); flag(o, i % 2 === 0); maybe(o, i); text(o, "t" + i); child(o, kept); any(o, i); } small(o, 7); flag(o, true); maybe(o, 1.5); text(o, "text"); any(o, "any"); }); run("small", o => small(o, null)); run("small", o => small(o, undefined)); run("flag", o => flag(o, null)); run("flag", o => flag(o, undefined)); run("maybe", o => maybe(o, undefined)); run("child", o => child(o, null)); run("null", o => all(o, null)); run("undefined", o => all(o, undefined)); run("misfit", o => { small(o, "s"); flag(o, 1); maybe(o, "m"); text(o, 5); child(o, 7); any(o, false); }); run("fitting", o => { small(o, -0.25); flag(o, false); maybe(o, 2); text(o, "other"); child(o, { x: 5 }); any(o, 3); }); run("back", o => { small(o, null); small(o, 3); flag(o, undefined); flag(o, false); }); run("compiled", o => storeSmall(o, null)); run("compiled", o => storeSmall(o, undefined)); run("keyed", o => { o[["sm", "all"].join("")] = null; o[["fl", "ag"].join("")] = undefined; }); run("nan", o => small(o, NaN)); run("deleted", o => { delete o.small; delete o.flag; }); };
# CHECK: warm number:7 boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: small object:null boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: small undefined:undefined boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: flag number:7 object:null number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: flag number:7 undefined:undefined number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: maybe number:7 boolean:true undefined:undefined string:text object:[object Object] string:any
# CHECK-NEXT: child number:7 boolean:true number:1.5 string:text object:null string:any
# CHECK-NEXT: null object:null object:null object:null object:null object:null object:null
# CHECK-NEXT: undefined undefined:undefined undefined:undefined undefined:undefined undefined:undefined undefined:undefined undefined:undefined
# CHECK-NEXT: misfit string:s number:1 string:m number:5 number:7 boolean:false
# CHECK-NEXT: fitting number:-0.25 boolean:false number:2 string:other object:[object Object] number:3
# CHECK-NEXT: back number:3 boolean:false number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: compiled object:null boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: compiled undefined:undefined boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: keyed object:null undefined:undefined number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: nan number:NaN boolean:true number:1.5 string:text object:[object Object] string:any
# CHECK-NEXT: deleted undefined:undefined undefined:undefined number:1.5 string:text object:[object Object] string:any
