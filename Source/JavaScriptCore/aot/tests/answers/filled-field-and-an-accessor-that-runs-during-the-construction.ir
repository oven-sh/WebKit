# A getter or a setter that the constructor comes to by a read or an assignment on this, its own class's, a subclass's or one found through super, gets the object half built.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor() { this.first = this.peek; this.x = 3; this.second = this.peek; } get peek() { return this.x; } } class Q { constructor() { this.value = 1; this.x = 3; } set value(v) { this.seen = this.x; } } class A { constructor() { this.tag = 1; } } class B extends A { constructor() { super(); this.y = 6; } set tag(v) { this.seen = this.y; } } class G { get peek() { return this.y; } } class H extends G { constructor() { super(); this.first = super.peek; this.y = 2; this.second = super.peek; } } function readX(p) { return p.x; } const p = new P(); report(p.first); report(p.second); report(readX(p)); const q = new Q(); report(q.seen); report("seen" in q); report(readX(q)); const b = new B(); report(b.seen); report("seen" in b); report(b.y); const h = new H(); report(h.first); report(h.second); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
