# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Kind { flags; more; constructor(flags, more) { this.flags = flags; this.more = more; } } let notes = 0; let gets = 0; function note() { notes++; } function bump(type) { type.flags = 2; return false; } function reduced(type) { if (type.flags & 1) return 1; else if (type.flags & 2) return 2; else if (type.more & 4) return 3; return 4; } function same(holder) { const k = holder.kind; return k.flags === k.more; } function bumped(type) { if (type.flags & 1 && bump(type)) return 1; else if (type.flags & 2) return 2; return 3; } function chain(a) { const t = a && a.flags & 8 ? new Kind(a.more, 0) : a; return t === null ? -1 : t.flags & 1 ? 1 : t.flags & 2 ? 2 : t.more & 1 ? 3 : 4; } function total(items) { let odd = 0; let even = 0; for (let i = 0;i < items.length; i++) { const n = items[i]; n.more = i; note(); if (n.flags & 1) odd += n.flags; else even += n.flags; } return odd + ":" + even; } function fill(items) { let k = 0; let last = 0; while (true) { const n = items[k]; n.more = k; note(); if (n.flags & 1) { if (k < 3) { k++; last = n.flags; continue; } } break; } return k + ":" + last; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function withGetter(flags) { const made = { more: flags >> 1 }; Object.defineProperty(made, "flags", { get() { gets++; return flags + (gets & 1); }, set(value) { gets += 10; } }); return made; } function made(which, flags) { return which === 0 ? new Kind(flags, flags >> 1) : which === 1 ? { more: flags >> 1, flags } : which === 2 ? null : which === 3 ? undefined : which === 4 ? flags : which === 5 ? "text" : withGetter(flags); } for (let w = 0;w < 7; w++) for (let f = 0;f < 10; f++) { tell(() => reduced(made(w, f))); tell(() => same({ kind: made(w, f) })); tell(() => bumped(made(w, f))); tell(() => chain(made(w,