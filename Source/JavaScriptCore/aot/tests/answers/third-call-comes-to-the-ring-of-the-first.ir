# import("./pages.js"), two jobs later import("./layout.js"), two jobs later import("./menu.js")        pages.js: import "./layout.js"        layout.js: import "./pages.js"        menu.js: import "./layout.js"
# The ring is entered at pages.js, and the calls settle in their order: what is held behind one load is let go in the order of the calls.
# RUN: run-in-shell globalThis.report = name => print(name + " runs"); globalThis.register = (...closures) => { globalThis.registered = closures; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(async () => { const jobsBetween = [[2, 2]]; const words = ["first", "second", "third"]; let next = 0; for (const jobs of jobsBetween) { const calls = []; for (let call = 0; call <= jobs.length; ++call) { const word = words[call]; const made = registered[next++](); made.then(() => print(word + " settled"), () => print(word + " failed")); calls.push(made); for (let job = 0; job < (jobs[call] ?? 0); ++job) await null; } await Promise.allSettled(calls); } }); return result; };
# CHECK: layout.js runs
