# function turns(call, n, p0, .., p9) { let older = "o", prev = "p", cur = "c", out = ""; for (let i = 0; i < n; i++) { const s: string = call(i); older = prev; prev = cur; cur = cur + s; out = out + older + prev; } return out + cur + older + prev + p0 + .. + p9; }
# More values are alive in the loop than registers take.
# Three of them change places in each turn. In one turn `call` answers a number, which is not what is written: what the loop reads from there on is what it held in that turn, and what it stores round the loop is read under the right name.
# No turn, then the first, the second, the third, the last turn is that turn.
# RUN: run-in-shell globalThis.register = turns => { for (let bad = -1; bad < 5; bad++) print(turns(i => i === bad ? i : "s" + i, 5, "A", "B", "C", "D", "E", "F", "G", "H", "I", "J")); };
# CHECK: pcccs0cs0cs0s1cs0s1cs0s1s2cs0s1s2cs0s1s2s3cs0s1s2s3s4cs0s1s2cs0s1s2s3ABCDEFGHIJ
# CHECK-NEXT: pccc0c0c0s1c0s1c0s1s2c0s1s2c0s1s2s3c0s1s2s3s4c0s1s2c0s1s2s3ABCDEFGHIJ
# CHECK-NEXT: pcccs0cs0cs01cs01cs01s2cs01s2cs01s2s3cs01s2s3s4cs01s2cs01s2s3ABCDEFGHIJ
# CHECK-NEXT: pcccs0cs0cs0s1cs0s1cs0s12cs0s12cs0s12s3cs0s12s3s4cs0s12cs0s12s3ABCDEFGHIJ
# CHECK-NEXT: pcccs0cs0cs0s1cs0s1cs0s1s2cs0s1s2cs0s1s23cs0s1s23s4cs0s1s2cs0s1s23ABCDEFGHIJ
# CHECK-NEXT: pcccs0cs0cs0s1cs0s1cs0s1s2cs0s1s2cs0s1s2s3cs0s1s2s34cs0s1s2cs0s1s2s3ABCDEFGHIJ
# CHECK-NEXT: exited with 0

