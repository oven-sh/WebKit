# An accessor on a proven layout is called directly only while nobody defines the property anew, on the prototype object or on the instance.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Box { constructor(held) { this.held = held } get value() { return this.held } set value(next) { this.held = next } } function valueOf(box) { return box.value } function fill(box, next) { box.value = next } const box = new Box(1); report(valueOf(box)); fill(box, 2); report(valueOf(box)); Object.defineProperty(Box.prototype, "value", { get() { return this.held * 100 }, set(next) { this.held = next + 1 }, configurable: true }); report(valueOf(box)); fill(box, 3); report(valueOf(box)); report(box.held); Object.defineProperty(box, "value", { value: "own", writable: true, configurable: true }); report(valueOf(box)); fill(box, "stored"); report(valueOf(box)); report(box.held); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
