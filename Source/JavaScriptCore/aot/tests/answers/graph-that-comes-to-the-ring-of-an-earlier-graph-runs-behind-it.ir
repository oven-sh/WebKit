# const first = import("./pages.js"); await null; ..; const second = import("./menu.js")        pages.js: import "./layout.js"        layout.js: import "./pages.js"        menu.js: import "./layout.js"
# menu.js stands beside the graph of pages.js and imports into its ring. Its way is the shorter one, so the loader comes to its end first: two, three and four jobs lie between the calls.
# If its graph ran then, the ring would be entered at layout.js, and pages.js would run ahead of what it imports.
# The loads go on side by side. The job that links and evaluates the later graph comes again when the earlier graph is loaded.
# RUN: run-in-shell globalThis.report = name => print(name + " runs"); globalThis.register = (...closures) => { globalThis.registered = closures; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(async () => { const jobsBetween = [[2], [3], [4]]; const words = ["first", "second", "third"]; let next = 0; for (const jobs of jobsBetween) { const calls = []; for (let call = 0; call <= jobs.length; ++call) { const word = words[call]; const made = registered[next++](); made.then(() => print(word + " settled"), () => print(word + " failed")); calls.push(made); for (let job = 0; job < (jobs[call] ?? 0); ++job) await null; } await Promise.allSettled(calls); } }); return result; };
