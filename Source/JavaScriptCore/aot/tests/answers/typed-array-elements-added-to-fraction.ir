# function total(length: number, start: number): number { const view = new Uint8Array(length); for (let k = 0; k < length; k++) view[k] = k * 7; let sum = start; for (let k = 0; k < view.length; k++) sum += view[k]!; return sum; }
# for (const length of [0, 1, 7, 16, 33, 70]) { report(total(length, 0)); report(total(length, 0.5)); report(total(length, 2 ** 53)); report(total(length, -0)); report(total(length, 2147483000)); }
# report("end");
# The elements of a view are added to what the caller hands over: a fraction, a number too large for its last digits, negative zero, a number near the end of 32 bits. Each sum is rounded as it is made.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function total(length, start) { const view = new Uint8Array(length); for (let k = 0;k < length; k++) view[k] = k * 7; let sum = start; for (let k = 0;k < view.length; k++) sum += view[k]; return sum; } for (const length of [0, 1, 7, 16, 33, 70]) { report(total(length, 0)); report(total(length, 0.5)); report(total(length, 2 ** 53)); report(total(length, -0)); report(total(length, 2147483000)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
