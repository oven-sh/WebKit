# The program of objects-of-another-instance-in-typed-slots.ir, and behind it:
# function tell(value) { return value.who(); }   function tellIfAny(value) { return value === undefined ? -1 : value.who(); }
# In both the text tests `value`, which may be anything, for Thing | Other in front of the call, in tellIfAny beside undefined. What passes is asked `who` here. What fails is handed to the shell's callWho(), which asks it `who`: whichever way a value takes, the answer is the same.
# One heap holds two instances of the image, as there. The objects of both have the same shapes, and `who` answers with the `mark` of the instance that made its object.
# Among other objects the code of such a test asks for the instance behind the shape, and behind its passing edge nobody asks again: `who` is entered without its function object, with the variables of the instance that runs.
# So an object of the other instance that passed would be answered for with the wrong `mark`. It is turned away, and goes by name.
# function pick(value): Thing | Other { return value; }   function tellPicked(value) { return pick(value).who(); }   pick() promises its result, so the test behind the call may have its code where a misfit lands alone.
# tellBesideList tests for Thing | Array, and a list passes that nobody asks. tellFailed calls `who` where the test for Thing | Other has failed, which is where an object of the other instance arrives. In all three the object is asked in front of the call.
# LIBRARY: own
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; globalThis.callWho = second.callWho = value => value.who(); const kitOf = f => ({ thing: f[0], other: f[1], tell: f[7], tellIfAny: f[8], tellPicked: f[9], tellBesideList: f[10], tellFailed: f[11] }); const twin = (id, register) => { class Thing { constructor(tag) { this.tag = tag; } who() { return mark; } } class Other { constructor(tag) { this.tag = tag; } who() { return mark + 100; } } class Box { constructor(held) { this.held = held; } ask() { return this.held.who(); } askSplit() { return this.held.who(); } } var mark = id(0); function thing() { return new Thing(1); } function other() { return new Other(1); } function box(held) { return new Box(held); } function put(box, held) { box.held = held; } function whoIs(thing) { return thing.who(); } function ask(box) { return box.ask(); } function askSplit(box) { return box.askSplit(); } function tell(value) { return value.who(); } function tellIfAny(value) { return value === undefined ? -1 : value.who(); } function pick(value) { return value; } function tellPicked(value) { return pick(value).who(); } function tellBesideList(value) { return value.who(); } function tellFailed(value) { return value.who(); } register(thing, other, box, put, whoIs, ask, askSplit, tell, tellIfAny, tellPicked, tellBesideList, tellFailed); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const told = value => [x, y].map(kit => kit.tell(value) + "," + kit.tellIfAny(value) + "," + kit.tellPicked(value) + "," + kit.tellBesideList(value) + "," + kit.tellFailed(value)).join(","); say("own thing", () => told(x.thing())); say("own other", () => told(x.other())); say("their thing", () => told(y.thing())); say("their other", () => told(y.other())); say("a stranger", () => told({ who() { return 7; } })); say("nothing", () => x.tellIfAny(undefined) + "," + y.tellIfAny(undefined)); say("nothing told", () => x.tell(undefined)); say("null", () => x.tellIfAny(null)); say("a number", () => told(5)); say("a list", () => x.tellBesideList([])); say("in turn", () => { let sum = 0; const values = [x.thing(), y.thing(), x.other(), y.other(), undefined]; for (let i = 0; i < 400; i++) { const value = values[i % 5]; sum += x.tellIfAny(value) * (i % 7); if (value) sum += x.tell(value) + x.tellPicked(value) + x.tellBesideList(value) + x.tellFailed(value); } return sum; }); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
