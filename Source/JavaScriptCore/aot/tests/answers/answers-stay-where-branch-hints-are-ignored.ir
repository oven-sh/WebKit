# The program of constants-between-operations-that-lean-on-one-guess.ir. Under the testing word IgnoreBranchHints every block of a walked body counts as usual: the closed arm of the guess on `n` is no rare block, and the answers stay.
# OPTIONS: testing=IgnoreBranchHints
# STATISTIC: BlocksPlacedOtherwise >= 1
# PROGRAM-OF: constants-between-operations-that-lean-on-one-guess.ir
# RUN(SHELL): run-in-shell mechanisms=all globalThis.sink = row => { const show = n => { const all = row(n); let line = ""; for (let i = 0; i < all.length; i++) line += " " + String(all[i]); print(all.length + line); }; show(3); show("5"); show(2n); };
