# class C { a = x; constructor(x) { this.b = x + 1; } }                            its layout declares b, a
# class D extends C { d = x + 3; constructor(x) { super(x); this.c = x + 2; } }    its layout declares c, d
# show("C", new C(one)); show("D", new D(one));
# The constructor hands what it has made to the initializer of the fields, which defines in front of the first store of the constructor. An object lists its keys as they were created, not as its layout declares them.
# RUN: run-in-shell globalThis.show = (name, object) => print(name + " " + Object.keys(object).join() + " " + Object.values(object).join());
# CHECK: C a,b 1,2
# CHECK-NEXT: D a,b,d,c 1,2,4,3
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
layout L0 kind=Instance name="C" constructor=f1 fields=[{key="b" declared={type=number} flags=[IsRequired]}, {key="a" declared={type=number} flags=[IsRequired]}]
layout L1 kind=Instance name="D" base=L0 constructor=f3 fields=[{key="c" declared={type=number} flags=[IsRequired]}, {key="d" declared={type=number} flags=[IsRequired]}] flags=[HasHeritage]
variable g0 name="C" module=m0 declared={type=anything} initialization=Undefined
function f0 name="main" kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="show" [isFreeName]
    v2 = Builtin builtin=MathRandom
    v3 = Call v2
    v4 = ToNumber v3
    v5 = Builtin builtin=MathFloor
    v6 = Call v5, -, v4
    v7 = ToNumber v6
    v8 = Integer integer=1
    v9 = Add v7, v8
    v10 = NewClosure function=f1
    v11 = NewClass v10 layout=L0
    v12 = FinishClass v11 layout=L0
    PutModuleVariable v12 variable=g0
    v14 = ResolveHeritage v12
    v15 = NewClosure function=f3
    v16 = NewClass v15, v12, v14 layout=L1
    v17 = FinishClass v16 layout=L1
    v18 = Construct v12, -, v9
    v19 = String string="C"
    v20 = Call v1, -, v19, v18
    v21 = Construct v17, -, v9
    v22 = String string="D"
    v23 = Call v1, -, v22, v21
    Return
}
function f1 name="C" kind=BaseConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
    v2 = GetConstructPrototype v0 layout=L0
    v3 = NewObject v2 layout=L0
    v4 = Convert v3 declared={type=L0|L1}
    v5 = CallDirect v4, v1 function=f2
    v6 = Integer integer=1
    v7 = Add v1, v6
    PropSet v3, v7 key="b"
    Return v3
}
function f2 name="initialize" kind=Initializer flags=[HasThis] thisType={type=L0|L1} parameters=[{type=number}] results=[{type=anything}] {
    v2 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    PropDefine v2, v1 key="a"
    Return
}
function f3 name="D" kind=DerivedConstructor flags=[HasNewTarget] parameters=[{type=number}] results=[{type=anything}] {
    v2 = GetModuleVariable variable=g0
    v3 = SuperConstruct v2, v0, v1 layout=L1
    v4 = Convert v3 declared={type=L1}
    v5 = CallDirect v4, v1 function=f4
    v6 = Integer integer=2
    v7 = Add v1, v6
    PropSet v3, v7 key="c"
    Return v3
}
function f4 name="initialize" kind=Initializer flags=[HasThis] thisType={type=L1} parameters=[{type=number}] results=[{type=anything}] {
    v2 = Convert v0 declared={type=object flags=[IsFromCompiler, IsClaim]}
    v3 = Integer integer=3
    v4 = Add v1, v3
    PropDefine v2, v4 key="d"
    Return
}
