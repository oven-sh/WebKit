# class Stepper { total = 0; constructor(public step: number) {} add(value: number) { this.total = (this.total + value * this.step) | 0; return this.total; } }
# function drive(stepper: Stepper) { let last = 0; for (let i = 0; i < 100; i++) last = stepper.add(i); return last; }
# function drives(stepper: Stepper, change) { for (let i = 0; i < 6; i++) { if (i === 3) change(stepper); report(drive(stepper)); } }
# register(drives, new Stepper(3), new Stepper(3), drive)
# The sibling of field-of-an-escaped-record-goes-away.ir for the fields that a constructor stores.
# The instances have escaped. The shell takes `step` away from the first and `total` from the second, in turn 3 of a compiled loop, and each way of taking a field away has a run of its own.
# A turn of `drive` adds 3 * 4950. Three answers in front of the act, then what the language says. Acts that compiled code does in the loop itself: guards-ended-by-a-turn.ir.
