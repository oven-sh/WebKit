# A field that one way through the constructor leaves out (a branch, a loop that may not turn, a switch without a default) is not filled. One that both arms store is.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor(v) { if (v) this.x = 1; this.y = 2; } } class Q { constructor(v) { if (v) this.x = 1; else this.x = 3; this.y = 2; } } class R { constructor(n) { for (let i = 0; i < n; i++) this.x = i; this.y = 2; } } class S { constructor(v) { switch (v) { case 0: this.x = 10; break; case 1: this.x = 11; break; } this.y = 2; } } function readX(p) { return p.x; } function readXOfQ(q) { return q.x; } function readXOfR(r) { return r.x; } function readXOfS(s) { return s.x; } report(readX(new P(true))); report(readX(new P(false))); report(readXOfQ(new Q(true))); report(readXOfQ(new Q(false))); report(readXOfR(new R(0))); report(readXOfR(new R(3))); report(readXOfS(new S(0))); report(readXOfS(new S(1))); report(readXOfS(new S(2))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
