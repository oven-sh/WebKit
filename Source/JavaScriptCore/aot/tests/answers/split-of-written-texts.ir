# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function colors() { return "red,green,blue".split(","); } function edges() { return ",a,,b,".split(","); } function none() { return "abc".split("x"); } function ofEmpty() { return "".split(","); } function longSeparator() { return "a--b".split("--"); } function limited() { return "a,b".split(",", 1); } function characters() { return "ab".split(""); } function cut(text, at) { return text.split(at); } function broughtTogether() { return cut("one,two", ","); } function show(list) { let line = list.length + ":"; for (let i = 0;i < list.length; i++) line += "[" + list[i] + "]"; return line; } function changed() { const first = colors(); const second = colors(); first.push("black"); first[0] = 1.5; second.length = 1; return (first === second) + " " + show(first) + " " + show(second) + " " + show(colors()); } function changedBehindCopy() { const first = broughtTogether(); const second = broughtTogether(); first.push("three"); second.length = 1; return (first === second) + " " + show(first) + " " + show(second) + " " + show(broughtTogether()); } report(show(colors())); report(show(edges())); report(show(none())); report(show(ofEmpty())); report(show(longSeparator())); report(show(limited())); report(show(characters())); report(show(broughtTogether())); report(changed()); report(changed()); report(changedBehindCopy()); report(changedBehindCopy()); report(Array.isArray(colors())); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)