# `super.name()` looks above the home object as it stands when the call runs: the program lays another prototype object there.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Base { name() { return "base" } } class Other { name() { return "other" } } class Derived extends Base { name() { return "derived of " + super.name() } } function nameOf(object) { return object.name() } const derived = new Derived(); report(nameOf(derived)); Object.setPrototypeOf(Derived.prototype, Other.prototype); report(nameOf(derived)); report(derived.name()); report(new Derived().name()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
