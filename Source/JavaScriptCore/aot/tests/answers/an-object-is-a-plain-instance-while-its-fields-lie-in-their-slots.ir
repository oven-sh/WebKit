# `$isPlainInstanceOf(object, Gauge)`: ONE TEST IN FRONT OF A ROAD OF THE LIBRARY. Only the library can write the question. It asks in order to read the fields of its own object as it likes: in any order, as often as it likes, or not at all.
# class Gauge { level: number; mark: string; constructor(level: number) { this.level = level; this.mark = "m"; } read() { return this.level; } }
# class Heir extends Gauge { more() { return 1; } }
# function ask(object: unknown): string { return $isPlainInstanceOf(object, Gauge) ? "plain" : "-"; }      in a file of the library
# const made = new Gauge(5);
# print(ask(made), ask(new Heir(6)), ask({ level: 1, mark: "m" }), ask(7), ask(null), ask("text"));
# change(made, Gauge);
# print(ask(made), ask(wrap(made)), ask(new Gauge(8)));
# print(made.read(), made.mark);
# It says yes where the shape is the one that Gauge itself declares, two bits of the cell are clear (no declared field has left its slot, no object stands above that the run time did not take),
# and nothing above takes a store under the name of a declared field.
# An heir, a literal with the same names and a primitive get a no.
# OPTIONS: mechanisms=all
# RUN(NOTHING): run-in-shell change = function () { }; wrap = x => x;
# NOTHING: plain - - - - -
# NOTHING-NEXT: plain plain plain
# NOTHING-NEXT: 5 m
# NOTHING-NEXT: exited with 0
# Stores into the fields and properties under other names leave it true.
# RUN(STORES): run-in-shell change = function (made) { made.level = 9; made.mark = "n"; made.more = 1; made.other = function () { }; made[Symbol.iterator] = 2; made[0] = 3; }; wrap = x => x;
# STORES: plain - - - - -
# STORES-NEXT: plain plain plain
# STORES-NEXT: 9 n
# An accessor over a field, and a field defined anew under other attributes: the field leaves its slot. The other objects of the class stay plain.
# RUN(ACCESSOR): run-in-shell change = function (made) { Object.defineProperty(made, "level", { get() { return 70; }, configurable: true }); }; wrap = x => x;
# ACCESSOR: plain - - - - -
# ACCESSOR-NEXT: - - plain
# ACCESSOR-NEXT: 70 m
# RUN(READONLY): run-in-shell change = function (made) { Object.defineProperty(made, "mark", { value: "r", writable: false }); }; wrap = x => x;
# READONLY: plain - - - - -
# READONLY-NEXT: - - plain
# READONLY-NEXT: 5 r
# Another object above, or none.
# RUN(OTHER): run-in-shell change = function (made) { Object.setPrototypeOf(made, { read() { return 71; } }); }; wrap = x => x;
# OTHER: plain - - - - -
# OTHER-NEXT: - - plain
# OTHER-NEXT: 71 m
# RUN(NONE): run-in-shell change = function (made) { Object.setPrototypeOf(made, null); made.read = function () { return 72; }; }; wrap = x => x;
# NONE: plain - - - - -
# NONE-NEXT: - - plain
# NONE-NEXT: 72 m
# A plain object laid between the object and the prototype of the class, as a framework lays its own methods: it is taken while it hides no member of the class.
# RUN(BETWEEN): run-in-shell change = function (made, Gauge) { const link = Object.create(Gauge.prototype); link.send = function () { }; Object.setPrototypeOf(made, link); }; wrap = x => x;
# BETWEEN: plain - - - - -
# BETWEEN-NEXT: plain plain plain
# BETWEEN-NEXT: 5 m
# RUN(HIDES): run-in-shell change = function (made, Gauge) { const link = Object.create(Gauge.prototype); link.read = function () { return 73; }; Object.setPrototypeOf(made, link); }; wrap = x => x;
# HIDES: plain - - - - -
# HIDES-NEXT: - - plain
# HIDES-NEXT: 73 m
# RUN(PROXY): run-in-shell change = function () { }; wrap = x => new Proxy(x, { });
# PROXY: plain - - - - -
# PROXY-NEXT: plain - plain
# WHAT IT DOES NOT SAY. Nothing about methods: a method of its own on the object and a wrapper on the prototype end the guard of the name, which `$findsDeclaredMember` asks.
# RUN(METHOD): run-in-shell change = function (made) { made.read = function () { return 74; }; }; wrap = x => x;
# METHOD: plain - - - - -
# METHOD-NEXT: plain plain plain
# METHOD-NEXT: 74 m
# RUN(WRAPPER): run-in-shell change = function (made, Gauge) { const read = Gauge.prototype.read; Gauge.prototype.read = function () { return read.call(this) + 100; }; }; wrap = x => x;
# WRAPPER: plain - - - - -
# WRAPPER-NEXT: plain plain plain
# WRAPPER-NEXT: 105 m
# Nothing about integrity: a store keeps its own test. And a deleted field is a field that was never stored: its slot is empty, and a read of it looks above the object as it always does.
# RUN(FROZEN): run-in-shell change = function (made) { Object.freeze(made); }; wrap = x => x;
# FROZEN: plain - - - - -
# FROZEN-NEXT: plain plain plain
# RUN(DELETED): run-in-shell change = function (made) { delete made.mark; }; wrap = x => x;
# DELETED: plain - - - - -
# DELETED-NEXT: plain plain plain
# DELETED-NEXT: 5 undefined
# So that no code of the program runs at such a read, nothing above may hold an accessor under the name of a declared field: the question asks the guards that a store under each of those names passes.
# They are guards of the class: every object of it gets a no from then on. The read answers what it answers in plain Bun, in both orders of the two deeds.
# RUN(DELETEDTHENABOVE): run-in-shell change = function (made, Gauge) { delete made.mark; Object.defineProperty(Gauge.prototype, "mark", { get() { return "above"; }, set(value) { }, configurable: true }); }; wrap = x => x;
# DELETEDTHENABOVE: plain - - - - -
# DELETEDTHENABOVE-NEXT: - - -
# DELETEDTHENABOVE-NEXT: 5 above
# RUN(ABOVETHENDELETED): run-in-shell change = function (made, Gauge) { Object.defineProperty(Gauge.prototype, "mark", { get() { return "above"; }, set(value) { }, configurable: true }); delete made.mark; }; wrap = x => x;
# ABOVETHENDELETED: plain - - - - -
# ABOVETHENDELETED-NEXT: - - -
# ABOVETHENDELETED-NEXT: 5 above
# RUN(ABOVE): run-in-shell change = function (made, Gauge) { Object.defineProperty(Gauge.prototype, "mark", { get() { return "above"; }, set(value) { }, configurable: true }); }; wrap = x => x;
# ABOVE: plain - - - - -
# ABOVE-NEXT: - - -
# ABOVE-NEXT: 5 m
# RUN(ONLINK): run-in-shell change = function (made, Gauge) { const link = Object.create(Gauge.prototype); Object.defineProperty(link, "mark", { get() { return "on the link"; }, configurable: true }); Object.setPrototypeOf(made, link); delete made.mark; }; wrap = x => x;
# ONLINK: plain - - - - -
# ONLINK-NEXT: - - -
# ONLINK-NEXT: 5 on the link
# RUN(LATERONLINK): run-in-shell change = function (made, Gauge) { const link = Object.create(Gauge.prototype); Object.setPrototypeOf(made, link); delete made.mark; Object.defineProperty(link, "mark", { get() { return "later"; }, configurable: true }); }; wrap = x => x;
# LATERONLINK: plain - - - - -
# LATERONLINK-NEXT: - - -
# LATERONLINK-NEXT: 5 later
# Code that no mechanism has touched answers no: no says nothing, and the library takes the road that reads everything.
# RUN(CLOSED): run-in-shell mechanisms=none change = function () { }; wrap = x => x;
# CLOSED: - - - - - -
# CLOSED-NEXT: - - -
# CLOSED-NEXT: 5 m

