# INLINED: isLoopHead=true
# INLINED: = GetStringLength
# function everyIteration(text: string, n: number): number { let sum = 0; for (let i = 0; i < n; i++) sum = (sum + text.length) | 0; return sum; }
# function someIterations(text: string, n: number): number { let sum = 0; for (let i = 0; i < n; i++) { if (i & 1) sum = (sum + text.length) | 0; } return sum; }
# function nestedLoops(text: string, n: number): number { let sum = 0; for (let i = 0; i < n; i++) { for (let j = 0; j < n; j++) sum = (sum + text.length) | 0; } return sum; }
# function lengthOf(text: string, wanted: boolean): number { if (wanted) return text.length; return 0; }
# function inlinedConditionally(text: string, n: number): number { let sum = 0; for (let i = 0; i < n; i++) sum = (sum + lengthOf(text, (i & 1) === 1)) | 0; return sum; }
# for (let n = 0; n < 8; n++) { report(everyIteration("abc", n)); report(someIterations("abcd", n)); report(nestedLoops("ab", n)); report(inlinedConditionally("abcde", n)); }
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function everyIteration(text, n) { let sum = 0; for (let i = 0;i < n; i++) sum = sum + text.length | 0; return sum; } function someIterations(text, n) { let sum = 0; for (let i = 0;i < n; i++) { if (i & 1) sum = sum + text.length | 0; } return sum; } function nestedLoops(text, n) { let sum = 0; for (let i = 0;i < n; i++) { for (let j = 0;j < n; j++) sum = sum + text.length | 0; } return sum; } function lengthOf(text, wanted) { if (wanted) return text.length; return 0; } function inlinedConditionally(text, n) { let sum = 0; for (let i = 0;i < n; i++) sum = sum + lengthOf(text, (i & 1) === 1) | 0; return sum; } for (let n = 0;n < 8; n++) { report(everyIteration("abc", n)); report(someIterations("abcd", n)); report(nestedLoops("ab", n)); report(inlinedConditionally("abcde", n)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
