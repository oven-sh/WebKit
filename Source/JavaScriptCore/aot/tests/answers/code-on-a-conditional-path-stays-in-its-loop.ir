# SOME: isLoopHead=true
# SOME: = GetStringLength
# RUN(NESTED): walk f4 mechanisms=all
# NESTED: = GetStringLength
# NESTED: isLoopHead=true
# NESTED: isLoopHead=true
# NESTED-NOT: = GetStringLength
# RUN(INLINED): walk f5 mechanisms=all
