# main.cjs: for (let run = 0; run < 3; run++) { try { require("./t.cjs"); } catch {} }        t.cjs: report(module)
# A file whose run threw runs again at the next require(), with a module object of its own. So no word holds the object of such a file for good: the code asks for it in each run.
# RUN: run-in-shell const modules = []; globalThis.report = module => { modules.push(module); if (modules.length < 3) throw new Error("boom"); }; globalThis.register = requireFile => { for (let run = 0; run < 3; ++run) { try { requireFile(); print("returned"); } catch (error) { print("threw " + error.message); } } print(new Set(modules).size + " module objects in " + modules.length + " runs"); };
