# In a test run an accessor that a test lays on RegExp.prototype is handed the RegExp that only captures hold, which is then recompiled.
# Only exec and test were asked to be locked, so the read of `source` left the RegExp private: the match asked nothing, and cut the groups out with the bounds of the old pattern.
#   function make() {
#     const r = /(\w+)-(\w+)-(\w+)/;
#     return {
#       look: () => r.source,
#       match(s: string) {
#         let n = 0;
#         for (let i = 0; i < 3; ++i) {
#           const m = r.exec(s);
#           if (m) { n += m[1]!.length; print(m.length, m[1], m[2], m[3]); } else print("none");
#         }
#         return n;
#       },
#       test: (s: string) => r.test(s),
#     };
#   }
#   const o = make();
#   print(o.match("aa-bb-cc"), o.test("xyz"));
#   print(o.look());
#   seen().compile("(z)");
#   print(o.match("xyz"), o.test("xyz"), o.test("aa-bb-cc"));
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell let held; Object.defineProperty(RegExp.prototype, "source", { configurable: true, get() { held = this; return "replaced"; } }); globalThis.seen = () => held;
# CHECK: 4 aa bb cc
# CHECK-NEXT: 4 aa bb cc
# CHECK-NEXT: 4 aa bb cc
# CHECK-NEXT: 6 false
# CHECK-NEXT: replaced
# CHECK-NEXT: 2 z undefined undefined
# CHECK-NEXT: 2 z undefined undefined
# CHECK-NEXT: 2 z undefined undefined
# CHECK-NEXT: 3 true false
# CHECK-NEXT: exited with 0

