# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; async function load(x) { log += "a"; await null; log += "b"; return x; } async function failLate(x) { log += "c"; await null; throw "late " + x; } async function failEarly(x) { log += "d"; if (x !== log) throw "early " + x; await null; return x; } async function run(x) { const v = await load(x); log += "e"; return v; } async function runLate(x) { try { return await failLate(x); } catch (e) { return "caught " + e; } finally { log += "f"; } } async function runEarly(x) { try { return await failEarly(x); } catch (e) { return "caught " + e; } finally { log += "g"; } } async function runTwice(x) { const a = x * 1.5; const first = await load(a); const second = await load(first + a); return a + first + second; } async function beside() { log += "1"; await null; log += "2"; await null; log += "3"; await null; log += "4"; await null; log += "5"; } const resolvesAtOnce = { then(resolve) { log += "t"; resolve("from then"); } }; const resolvesTwice = { then(resolve) { log += "u"; resolve("once"); resolve("twice"); } }; const throwsInGetter = { get then() { log += "w"; throw "no then"; } }; async function tell(started) { const other = beside(); try { report(await started); } catch (e) { report("thrown " + e); } await other; report(log); log = ""; } async function plainFails(x) { log += "h"; if (x === 1) throw "plain " + x; return x; } async function runPlainInLoop(n) { let s = ""; for (let i = 0;i < n; i++) { try { s += await plainFails(i); } catch (e) { s += "[" + e + "]"; } log += "i"; } return s; } function twice(x) { return x * 2; } async function runNested(x) { return await load(twice(x)); } await tell(run(1)); await tell(run("text")); await tell(run(undefined)); await tell(run(resolvesAtOnce)); await tell(run(resolvesTwice)); await tell(run(throwsInGetter)); await tell(run(run(2))); await tell(runLate(3)); await tell(runEarly(4)); await tell(runTwice(5)); await tell(runPlainInLoop(3)); await tell(runNested(6)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
