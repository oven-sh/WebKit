# made of 7a5fd93c98d15f83
# a callee spreads what it is handed, and on one such object the program has laid a getter behind its making: the copy reads the property, the getter writes a field of another object, and the caller reads that field before and behind the call
# the layout is none of plain objects, so the callee may run code that nobody knows. Where it is taken for one, the caller keeps what it has read and answers 92 in the place of 192
# f1 = clone
# RUN(FORM): link functions mechanisms=all
# FORM: function f1 {{*}}mayCallUnknownCode
# const holder = { n: 0 };
# function clone(s: { a: number; b: number }) { return { ...s }; }
# function hostile() { const o = { a: 1, b: 2 }; Object.defineProperty(o, "a", { get() { holder.n = holder.n + 1; return 9; }, enumerable: true }); return o; }
# function outer(s: { a: number; b: number }) { const before = holder.n; const made = clone(s); return before * 1000 + holder.n * 100 + made.a * 10 + made.b; }
# function inLoop(s: { a: number; b: number }) { let t = 0; for (let i = 0; i < 3; i++) { clone(s); t = t * 10 + holder.n; } return t; }
# report(outer({ a: 1, b: 2 }));
# report(outer(hostile()));
# report(inLoop(hostile()));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const holder = { n: 0 }; function clone(s) { return { ...s }; } function hostile() { const o = { a: 1, b: 2 }; Object.defineProperty(o, "a", { get() { holder.n = holder.n + 1; return 9; }, enumerable: true }); return o; } function outer(s) { const before = holder.n; const made = clone(s); return before * 1000 + holder.n * 100 + made.a * 10 + made.b; } function inLoop(s) { let t = 0; for (let i = 0;i < 3; i++) { clone(s); t = t * 10 + holder.n; } return t; } report(outer({ a: 1, b: 2 })); report(outer(hostile())); report(inLoop(hostile())); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
