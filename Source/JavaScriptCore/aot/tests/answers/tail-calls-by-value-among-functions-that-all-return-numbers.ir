# told(viaOther(300001, 0, viaDirect, viaOther));
# report("end");
# Every function here returns a number, and still none of them may return it raw: an entry by value returns a boxed value, and a function that leaves by a jump into one returns what that one returns. So does whoever jumps to such a function. The rings are 300,000 calls deep.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function told(n) { report(n); report(n + 1); report(n * 2); report(n === n); report("" + n); report(typeof n); } function bounce(n, total, next, other) { return n === 0 ? total * 1 : next(n - 1, total + 1, other, next); } function hop(n, total, next, other) { return n === 0 ? total * 1 : next(n - 1, total + 2, other, next); } function enter(n) { return bounce(n, 0, hop, bounce); } function outer(n) { return enter(n); } function viaDirect(n, total, back, other) { return n === 0 ? total * 1 : viaValue(n - 1, total + 1, other, back); } function viaOther(n, total, back, other) { return n === 0 ? total * 1 : viaValue(n - 1, total + 0.5, other, back); } function viaValue(n, total, back, other) { return back(n, total, back, other); } function added(n) { return outer(n) + 1; } told(bounce(3, 0, hop, bounce)); told(bounce(300000, 0, hop, bounce)); told(hop(300001, 0, hop, bounce)); told(enter(300000)); told(outer(300000)); told(added(300000)); told(viaDirect(3, 0, viaDirect, viaOther)); told(viaDirect(300000, 0, viaDirect, viaOther)); told(viaOther(300001, 0, viaDirect, viaOther)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
