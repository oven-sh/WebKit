# function walk(turns, a, b) { return turns <= 0 ? a * 1000 + b : walk(turns - 1, b, a + b); }
# report(walk(0, 1, 2)); report(walk(1, 1, 2)); report(walk(5, 1, 2));
# report("end");
# A call of the function itself in tail position becomes a jump, and each parameter takes the operand that stands at its place.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function walk(turns, a, b) { return turns <= 0 ? a * 1000 + b : walk(turns - 1, b, a + b); } report(walk(0, 1, 2)); report(walk(1, 1, 2)); report(walk(5, 1, 2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 4 of 4 of 4
# CHECK-NEXT: exited with 0

