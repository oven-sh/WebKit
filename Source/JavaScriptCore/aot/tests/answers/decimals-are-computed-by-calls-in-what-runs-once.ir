# The body of a module runs once, so each operation is a call of the run time.
# report(new Decimal("1.5").add(value).multiply(value).round(1).lessThan(value), new Decimal(20).subtract(value).exponent(), value.compare(new Decimal(1)));
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns >= 1
# RUN(CODE): emit f0
# CODE-NOT: = Mul(
# RUN: run-in-shell --useDecimal=1 globalThis.value = new Decimal("2.5"); globalThis.report = print;
# CHECK: false 1 1
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="Decimal" [isFreeName]
    v4 = String string="1.5"
    v5 = Construct v3, -, v4 calleeName="Decimal"
    v6 = PropGet v5 key="add"
    v7 = Builtin builtin=GlobalThis
    v8 = PropGet v7 key="value" [isFreeName]
    v9 = Call v6, v5, v8 calleeKey="add" calleeName="add"
    v10 = PropGet v9 key="multiply"
    v11 = Builtin builtin=GlobalThis
    v12 = PropGet v11 key="value" [isFreeName]
    v13 = Call v10, v9, v12 calleeKey="multiply" calleeName="multiply"
    v14 = PropGet v13 key="round"
    v15 = Integer integer=1
    v16 = Call v14, v13, v15 calleeKey="round" calleeName="round"
    v17 = PropGet v16 key="lessThan"
    v18 = Builtin builtin=GlobalThis
    v19 = PropGet v18 key="value" [isFreeName]
    v20 = Call v17, v16, v19 calleeKey="lessThan" calleeName="lessThan"
    v21 = Builtin builtin=GlobalThis
    v22 = PropGet v21 key="Decimal" [isFreeName]
    v23 = Integer integer=20
    v24 = Construct v22, -, v23 calleeName="Decimal"
    v25 = PropGet v24 key="subtract"
    v26 = Builtin builtin=GlobalThis
    v27 = PropGet v26 key="value" [isFreeName]
    v28 = Call v25, v24, v27 calleeKey="subtract" calleeName="subtract"
    v29 = PropGet v28 key="exponent"
    v30 = Call v29, v28 calleeKey="exponent" calleeName="exponent"
    v31 = Builtin builtin=GlobalThis
    v32 = PropGet v31 key="value" [isFreeName]
    v33 = PropGet v32 key="compare"
    v34 = Builtin builtin=GlobalThis
    v35 = PropGet v34 key="Decimal" [isFreeName]
    v36 = Integer integer=1
    v37 = Construct v35, -, v36 calleeName="Decimal"
    v38 = Call v33, v32, v37 calleeKey="compare" calleeName="value.compare"
    v39 = Call v1, -, v20, v30, v38 calleeName="report"
    v40 = Undefined
    Return v40
}
