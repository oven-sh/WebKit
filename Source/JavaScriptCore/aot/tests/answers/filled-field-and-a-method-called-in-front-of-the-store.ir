# class P { constructor() { this.seen = this.look(); this.x = 5; this.after = this.look(); } look() { return this.x; } }
# function read(p) { return p.x; }
# const p = new P();
# report(p.seen);
# report(p.after);
# report(p.look());
# report(read(p));
# report("end");
# The constructor calls a method on this in front of the store, and the method reads the field: undefined.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor() { this.seen = this.look(); this.x = 5; this.after = this.look(); } look() { return this.x; } } function read(p) { return p.x; } const p = new P(); report(p.seen); report(p.after); report(p.look()); report(read(p)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

