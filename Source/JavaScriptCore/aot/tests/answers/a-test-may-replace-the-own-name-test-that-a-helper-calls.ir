# function extend(child, parent) { parent.hasOwnProperty("x"); function T() { this.constructor = child; } T.prototype = parent.prototype; child.prototype = new T(); }
# function own() { if (typeof this === "function") this.prototype.m = function late() { return "own"; }; return false; }
# Parent.prototype.m = function orig() { return "orig"; };  install(own);  extend(Child, Parent);  print(new Parent().m());
