# a function of the library that saves the registers of its callers holds no fraction itself. The rare arm of its one operation calls C++ and saves registers round the call: the floating-point ones too, because the callers keep fractions there
# by hand: in today's library the two functions whose rows ask for the convention each make a call in tail position, which the rule refuses (tests/plan/tail-calls/search-of-the-library-saves-the-registers-of-its-callers.ir)
# f1 holds ten integers and fourteen fractions in registers across both calls. f2 and f3 stand for indexOf and includes, and are not copied in line
# LIBRARY: own
# RUN: plan units mechanisms=-Inlining
# CHECK: unit f2:Body {{*}}saves-registers-of-callers
# CHECK: unit f3:Body {{*}}saves-registers-of-callers
# RUN(SHELL): run-in-shell mechanisms=-Inlining globalThis.sink = holds => { const busy = () => { let t = 0; for (let i = 1; i < 40; i++) t += Math.pow(i, 1.5) * Math.sin(i) + Math.atan2(i, t) / Math.hypot(i, 3, t); return t; }; const odd = { valueOf() { return busy() > 1e99 ? 0 : 5; }, toString() { return busy() > 1e99 ? "" : "7"; } }; let bad = 0; for (let round = 0; round < 300; round++) { const a = round, b = round * 3 + 1, c = round * 5 + 2, d = round * 7 + 3; if (holds(odd, a, b, c, d) !== ((a >>> 0) ^ 17) + ((b >>> 0) ^ 34) + ((c >>> 0) ^ 51) + ((d >>> 0) ^ 68) + ((a >>> 0) ^ 85) + ((b >>> 0) ^ 102) + ((c >>> 0) ^ 119) + ((d >>> 0) ^ 136) + ((a >>> 0) ^ 153) + ((b >>> 0) ^ 170) + ((a >>> 0) + 0.25) + ((b >>> 0) + 1.25) + ((c >>> 0) + 2.25) + ((d >>> 0) + 3.25) + ((a >>> 0) + 4.25) + ((b >>> 0) + 5.25) + ((c >>> 0) + 6.25) + ((d >>> 0) + 7.25) + ((a >>> 0) + 8.25) + ((b >>> 0) + 9.25) + ((c >>> 0) + 10.25) + ((d >>> 0) + 11.25) + ((a >>> 0) + 12.25) + ((b >>> 0) + 13.25) + 5 + 5) bad++; } print("bad", bad); };
# SHELL: bad 0
# SHELL-NEXT: exited with 0

