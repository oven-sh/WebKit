# A class below defines one half of an accessor: the pair of the class above is hidden, so a store without a setter throws in strict code and a read without a getter gives undefined.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Base { constructor() { this.held = 1 } get value() { return this.held } set value(next) { this.held = next } } class OnlyGetter extends Base { constructor() { super(); this.own = 1 } get value() { return "getter alone" } } class OnlySetter extends Base { constructor() { super(); this.own = 2 } set value(next) { this.held = next * 2 } } const getter = new OnlyGetter(); const setter = new OnlySetter(); report(getter.value); let thrown = "nothing"; try { getter.value = 5 } catch (error) { thrown = error instanceof TypeError } report(thrown); report(getter.held); report(setter.value); setter.value = 5; report(setter.held); report(setter.value); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 7 of 7 of 7
