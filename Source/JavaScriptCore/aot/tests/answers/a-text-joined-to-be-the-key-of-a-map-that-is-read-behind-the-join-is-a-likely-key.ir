# `const key = source.id + "," + target.id; visited && visited.get(key)`: A TEXT THAT IS JOINED TO BE THE KEY OF A Map. The engine has a stub that finds the key of two parts in a cache by their bits (about twenty instructions),
# and the walk never marked this join: the Map is read BEHIND the join, and the first join's only taker is the second. So each call made two texts of numbers and two ropes, and the Map resolved, hashed and copied the rope.
# A join is a likely key where its text goes into a Map or a Set as the first argument, whether the collection is read in front of the join or behind it (then by what is expected of it), and where its only taker is such a join.
# class Kind { id: number; constructor(id: number) { this.id = id; } }
# let visited: Map<string, number> | undefined;
# let hits = 0;
# function once(source: Kind, target: Kind): void {
#   const key = source.id + "," + target.id;
#   const status = visited && visited.get(key);
#   if (status !== undefined) { hits += status; return; }
#   (visited || (visited = new Map<string, number>())).set(key, 1);
# }
# keep(once);
# const kinds = [new Kind(1), new Kind(23), new Kind(-4)];
# for (let round = 0; round < 3; round++) for (let a = 0; a < 3; a++) for (let b = 0; b < 3; b++) once(kinds[a]!, kinds[b]!);
# print(hits, visited!.size, visited!.has("23,-4"), visited!.has("4,4"));
