    v24 = Integer
    v25 = StrictEq v23, v24
    v26 = LogicalNot v25
    v27 = PropGet v0 key="compare"
    v28 = Call v27, v0, v1 calleeKey="compare" calleeName="x.compare"
    v29 = Integer integer=1
    v30 = StrictEq v28, v29
    v31 = PropGet v0 key="compare"
    v32 = Call v31, v0, v1 calleeKey="compare" calleeName="x.compare"
