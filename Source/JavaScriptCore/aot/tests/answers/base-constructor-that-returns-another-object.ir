# const other = { tag: "other", who() { return "the other object" } };
# class Base { constructor(swap) { this.tag = "base"; if (swap) return other } who() { return "an instance" } }
# class Derived extends Base { constructor(swap) { super(swap); this.more = 1 } }
# function whoIs(object) { return object.who() }
# report(whoIs(new Base(false)));
# report(whoIs(new Base(true)));
# report(whoIs(new Derived(false)));
# report(whoIs(new Derived(true)));
# report(new Derived(true) === other);
# report(other.more);
# report(new Derived(false) instanceof Derived);
# report(new Derived(true) instanceof Derived);
# report("end");
# What `super(..)` answers is what the constructor above returns, which need not be an instance.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const other = { tag: "other", who() { return "the other object" } }; class Base { constructor(swap) { this.tag = "base"; if (swap) return other } who() { return "an instance" } } class Derived extends Base { constructor(swap) { super(swap); this.more = 1 } } function whoIs(object) { return object.who() } report(whoIs(new Base(false))); report(whoIs(new Base(true))); report(whoIs(new Derived(false))); report(whoIs(new Derived(true))); report(new Derived(true) === other); report(other.more); report(new Derived(false) instanceof Derived); report(new Derived(true) instanceof Derived); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
