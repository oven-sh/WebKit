# const rows = [{ n: 1 }, { n: 2 }];
# function byIndex(list) { let sum = 0; for (let at = 0; at < list.length; at++) sum += list[at].n; return sum; }
# function byValue(list) { let sum = 0; for (const row of list) sum += row.n; return sum; }
# print(byIndex(rows));
# print(byValue(rows));
# rows[3] = { n: 4 };
# try { print(byIndex(rows)); } catch (error) { print(error instanceof TypeError); }
# try { print(byValue(rows)); } catch (error) { print(error instanceof TypeError); }
# rows[2] = id("text");
# print(byValue(rows));
# print("went on");
# `list[at].n` and `for (const row of list) row.n`: the read of the element used to be followed by the proof check (is it a cell? of the layout? or undefined?),
# and the test for nullish came before the read of the name.
# Now one full test for the type without nullish does both jobs, and the check is left to that test.
# What the test rejects is either undefined, which throws as the read does, or a mismatch, which crashes with a named error.
# In the for-of the check and the test are in two blocks.
# A straight path of jumps connects them, and between them there are only pure operations that do not mention the value (apart from the bundle of the step's results).
# Fault injection, testing=AssumeUnknownCallsReturnUndefined: Link assumes that the shell's `id` returns undefined, so all that it sees stored into the array is objects of one layout, and undefined.
# OPTIONS: testing=AssumeUnknownCallsReturnUndefined
# RUN(INDEX): walk f1 mechanisms=all
# INDEX: CheckProof [[given]] checkedType=undefined|L0 {{*}} source=Contents [isLeftToTestBehind]
# INDEX-NEXT: TypeTest [[given]] testedType=L0 [asksInFull]
# INDEX: CheckProof [[given]] checkedType=undefined {{*}} source=Contents
# INDEX-NEXT: RequireObjectCoercible [[given]] name="n"
# INDEX-NEXT: Unreachable
# RUN(VALUE): walk f2 mechanisms=all
# VALUE: CheckProof [[given]] checkedType=undefined|L0 {{*}} source=Contents [isLeftToTestBehind]
# VALUE: TypeTest [[given]] testedType=L0 [asksInFull]
# VALUE: CheckProof [[given]] checkedType=undefined {{*}} source=Contents
# VALUE-NEXT: RequireObjectCoercible [[given]] name="n"
# VALUE-NEXT: Unreachable
# RUN(ALL): run-in-shell mechanisms=all
# ALL: 3
# ALL-NEXT: 3
# ALL-NEXT: true
# ALL-NEXT: true
# ALL-NEXT: bun: internal AOT error: type check failed
# ALL-NEXT: found string in
# ALL-NOT: went on
# ALL: crashed with
# RUN(CALLS): run-in-shell mechanisms=-Inlining
# CALLS: 3
# CALLS-NEXT: 3
# CALLS-NEXT: true
# CALLS-NEXT: true
# CALLS-NEXT: bun: internal AOT error: type check failed
# CALLS-NEXT: found string in
# CALLS-NOT: went on
# CALLS: crashed with

