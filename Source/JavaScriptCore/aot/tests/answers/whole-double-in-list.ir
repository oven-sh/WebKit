# const fractions = [9.5, 0.5, 2, 3]; const row = fractions.slice(0); row.push("label");
# function pushed(x) { const list = [1]; if (typeof x === "number" && (x | 0) === x) list.push(x); return list[0] + list[list.length - 1]; }
# pushedTwice: list.push(x, x)   inLiteral: list = [1, x]   inLiteralOfThree: list = [x, x, x]
# for (let k = 0; k < row.length; k++) report(pushed(row[k]), pushedTwice(row[k]), inLiteral(row[k]), inLiteralOfThree(row[k]));
# The engine boxes a whole number out of a list of doubles as a double. Behind the test its type is int32 and its word is as it was. Where the code in line does not take the word,
# the engine gets it, and the engine takes the storage of a list from the form of the word: it gets the form of an int32, or the reads in line find doubles where the type says int32.
# A frozen text: the library's modules are cut out of it.
# FORM: AsRead
# RUN: run-in-shell globalThis.report = (...sums) => print(sums.join());
# CHECK: 2,2,2,2
# CHECK-NEXT: 2,2,2,2
# CHECK-NEXT: 3,3,3,4
# CHECK-NEXT: 4,4,4,6
# CHECK-NEXT: 2,2,2,2
# CHECK-NEXT: exited with 0

