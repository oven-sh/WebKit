    v8 = PropGet v7 key="isConcatSpreadable"
    v9 = Boolean boolean=true
    ElemSet v1, v8, v9
    v11 = Integer integer=1
    v12 = Integer integer=2
    v13 = Builtin builtin=GlobalThis
    v14 = PropGet v13 key="print" [isFreeName]
    v15 = NewArray v11, v12 contents=anything
    v16 = Call v3, -, v15, v1 calleeName="count" [isNeverInlined]
    v17 = NewArray v11, v12 contents=anything
    v18 = Call v3, -, v17, v1 calleeName="count" [isNeverInlined]
    v19 = Call v14, -, v16, v18 calleeName="print"
    v20 = Undefined
    Return v20
}
