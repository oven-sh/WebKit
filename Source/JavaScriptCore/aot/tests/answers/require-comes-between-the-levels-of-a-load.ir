# A job of the program requires a part of a graph while the loader goes down its way through that graph. What the require() has loaded is loaded, and what is left of the graph stands as far from the root as it stood:
# the way is laid again from where the loader stands. The call settles in the same job as where the loader goes through every module. A require() that comes to a module which the loader has asked for takes over
# the steps of the call, and the whole graph runs before it returns.
# RUN(EARLY): run-in-shell --aotCountsPath=/dev/null const atJob = now => { if (now == 2) { second(); report("required", "b.js"); } }; const begin = () => { first().then(() => { isDone = true; print("imported behind job " + job); walked(); }); }; let job = 0; let isDone = false; globalThis.report = (label, value) => print(label + ": " + value + " behind job " + job); const walked = () => print("walked " + aotRuntimeCounters().match(/^(\d+)\tcounter:CompiledModulesWalkedByLoader$/m)[1]); globalThis.register = (first, second) => { globalThis.first = first; globalThis.second = second; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(() => { const next = () => { if (isDone) return; ++job; atJob(job); Promise.resolve().then(next); }; Promise.resolve().then(next); begin(); }); return result; };
# EARLY: runs: d.js behind job 2
