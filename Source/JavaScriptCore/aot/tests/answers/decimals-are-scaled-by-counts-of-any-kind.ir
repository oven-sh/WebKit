# A count that is no int32 is left to the run time, and one that is refused to the method.
# sink((x, count) => x.round(count), (x, count) => x.scale10(count));
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns = 2
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g) => { const D = text => new Decimal(text), show = f => { try { print(String(f())); } catch (error) { print(error.name); } }; for (const count of [1, -1, -0, 2 ** 32 + 1, 0.5, Infinity, NaN, "1", true, undefined]) { show(() => f(D("12.25"), count)); show(() => g(D("12.25"), count)); } };
# CHECK: 12.2
# CHECK-NEXT: 122.5
# CHECK-NEXT: 10
# CHECK-NEXT: 1.225
# CHECK-NEXT: 12
# CHECK-NEXT: 12.25
# CHECK-NEXT: 12.25
# CHECK-NEXT: Infinity
# CHECK-NEXT: RangeError
# CHECK-NEXT: RangeError
# CHECK-NEXT: RangeError
# CHECK-NEXT: Infinity
# CHECK-NEXT: RangeError
# CHECK-NEXT: NaN
# CHECK-NEXT: TypeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: exited with 0

