# type Pair = { name: string; [first]?: number; [second]?: number }
# function fill(pair: Pair, a: number, b: number) { pair[first] = a; pair[second] = b; return pair[first]; }
# function empty(): Pair { return { name: "empty" }; }
# start(fill, empty); var first = Symbol("first"); start(fill, empty); var second = Symbol("second"); start(fill, empty);
# `start` calls `fill` eight times with an object of the written type before either symbol is made, between the two, and behind both.
# Early the first key is undefined, between the two the second, and such a key names the property "undefined".
# The shell has run the same text itself: every answer is the same.
# The program or the shell runs built-ins that are written in JavaScript. They are the engine's own here, and no stand-in answers for them.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const told = (fill, empty) => { let text = ""; for (let turn = 0; turn < 8; turn++) { const o = empty(); text += String(fill(o, turn, turn + 1)) + " " + Reflect.ownKeys(o).map(String).join() + " " + String(o.undefined) + "; "; } return text; }; const twin = start => { function fill(pair, a, b) { pair[first] = a; pair[second] = b; return pair[first]; } function empty() { return { name: "empty" }; } start(fill, empty); var first = Symbol("first"); start(fill, empty); var second = Symbol("second"); start(fill, empty); }; const expected = []; twin((fill, empty) => { expected.push(told(fill, empty)); }); let round = 0; globalThis.start = (fill, empty) => { const got = told(fill, empty); print(got === expected[round] ? "round " + round + " is the same: " + got.slice(0, 60) : "round " + round + ": " + got + " and not " + expected[round]); round++; }; })();
# CHECK: round 0 is the same: 1 name,undefined 1;
# CHECK-NEXT: round 1 is the same: 0 name,undefined,Symbol(first) 1;
# CHECK-NEXT: round 2 is the same: 0 name,Symbol(first),Symbol(second) undefined;
# CHECK-NEXT: exited with 0

