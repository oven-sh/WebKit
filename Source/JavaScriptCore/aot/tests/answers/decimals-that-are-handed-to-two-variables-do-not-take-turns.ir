# The edge that gives the value before away is taken after the next value is made.
# sink(lists => { let a = 1m, b = 2m, total = 0m; for (const list of lists) { for (const x of list) total = total.add(x); a = total; b = total; total = total.add(1m); } return [a, b, total]; }, (lists, seen) => { let a = 1m, b = 2m, total = 0m, i = 0; do { seen.push(a, b); for (const x of lists[i]) total = total.add(x); a = total; b = total; total = total.add(1m); } while (++i < lists.length); });
