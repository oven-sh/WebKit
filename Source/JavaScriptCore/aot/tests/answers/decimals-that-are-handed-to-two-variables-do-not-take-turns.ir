# The edge that gives the value before away is taken after the next value is made.
# sink(lists => { let a = new Decimal(1), b = new Decimal(2), total = new Decimal(0); for (const list of lists) { for (const x of list) total = total.add(x); a = total; b = total; total = total.add(new Decimal(1)); } return [a, b, total]; }, (lists, seen) => { let a = new Decimal(1), b = new Decimal(2), total = new Decimal(0), i = 0; do { seen.push(a, b); for (const x of lists[i]) total = total.add(x); a = total; b = total; total = total.add(new Decimal(1)); } while (++i < lists.length); });
