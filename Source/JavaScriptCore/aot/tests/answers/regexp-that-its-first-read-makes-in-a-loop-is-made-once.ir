# a RegExp that a module only stores is made by the first read of its variable; where that read stands in a loop that calls nothing, or in a reader that is copied into one, every turn finds the RegExp that the first turn made
# f1 = same, f2 = readOther, f3 = sameThroughCallee, f4 = tell
# RUN(FORM): walk f1 mechanisms=all
# FORM-LABEL: code f1:Body
# FORM: isLoopHead=true
# FORM: = GetModuleVariable
# FORM: = NewRegExp
# const pattern = /a+/;
# const other = /b+/;
# function same(n: number) { let first: unknown = null; let count = 0; for (let i = 0; i < n; i++) { const now = pattern; if (first === null) first = now; if (first === now) count++; } return count; }
# function readOther() { return other; }
# function sameThroughCallee(n: number) { let first: unknown = null; let count = 0; for (let i = 0; i < n; i++) { const now = readOther(); if (first === null) first = now; if (first === now) count++; } return count; }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => same(0));
# tell(() => same(5));
# tell(() => same(3));
# tell(() => sameThroughCallee(0));
# tell(() => sameThroughCallee(5));
# tell(() => readOther() === readOther());
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const pattern = /a+/; const other = /b+/; function same(n) { let first = null; let count = 0; for (let i = 0;i < n; i++) { const now = pattern; if (first === null) first = now; if (first === now) count++; } return count; } function readOther() { return other; } function sameThroughCallee(n) { let first = null; let count = 0; for (let i = 0;i < n; i++) { const now = readOther(); if (first === null) first = now; if (first === now) count++; } return count; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => same(0)); tell(() => same(5)); tell(() => same(3)); tell(() => sameThroughCallee(0)); tell(() => sameThroughCallee(5)); tell(() => readOther() === readOther()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 7 of 7 of 7
# CHECK-NEXT: exited with 0

