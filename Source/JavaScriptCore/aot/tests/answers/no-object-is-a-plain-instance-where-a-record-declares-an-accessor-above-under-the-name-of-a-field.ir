# THE GUARDS THAT A YES OF `$isPlainInstanceOf` RESTS ON SAY "AS THE RECORDS DECLARE", NOT "NO ACCESSOR ABOVE". So the walk lists them behind a screen, and stamps nothing where a record itself declares what would run code at the read of a field.
# let ran = 0;
# class Base { get mark() { ran++; return "above"; } set mark(value) { } }
# class Gauge extends Base { level = 1; mark = "m"; }
# function ask(object) { return $isPlainInstanceOf(object, Gauge) ? "plain" : "-"; }      in a file of the library
# const made = new Gauge();
# print(ask(made), made.mark, ran);
# delete made.mark;
# print(ask(made), made.mark, ran);
# It said "plain" twice, and the read behind the second ran the accessor.
# OPTIONS: mechanisms=all
# RUN(FORM): walk f1
# FORM: = IsPlainInstanceOf
# FORM-NOT: receivers=
# RUN: run-in-shell
# CHECK: - m 0
# CHECK-NEXT: - above 1
# CHECK-NEXT: exited with 0

