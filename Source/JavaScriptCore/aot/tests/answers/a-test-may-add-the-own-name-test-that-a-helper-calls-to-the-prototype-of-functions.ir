# extend(child, parent) asks parent.hasOwnProperty("x") and links the two. A test adds a hasOwnProperty to Function.prototype, which answers in front of the one on Object.prototype and lays another m on the prototype of its this.
# OPTIONS: admit=ReplacedBuiltins
# RUN: run-in-shell mechanisms=all
# CHECK: own
# CHECK-NEXT: exited with 0

layout L0 kind=Instance name="Parent" module=m0 constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="Child" module=m0 base=L0 constructor=f2 flags=[IsConstructorFunction]
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f4
    v5 = NewClosure function=f3
    v6 = PropGet v1 key="prototype"
    v7 = NewClosure function=f6
    PropSet v6, v7 key="m"
    v9 = Builtin builtin=GlobalThis
    v10 = Builtin builtin=ReflectSet
    v11 = Builtin builtin=Reflect
    v12 = Builtin builtin=FunctionPrototype
    v13 = String string="hasOwnProperty"
    v14 = Call v10, v11, v12, v13, v5 calleeName="Reflect.set"
    v15 = Call v4, -, v3, v1 calleeName="extend"
    v16 = Construct v1
    v17 = PropGet v16 key="m"
    v18 = Call v17, v16 calleeKey="m"
    v19 = PropGet v9 key="print" [isFreeName]
    v20 = Call v19, -, v18
    v21 = Undefined
    Return v21
}
function f1 name="Parent" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Undefined
    Return v1
}
function f2 name="Child" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Undefined
    Return v1
}
function f3 name="own" module=m0 flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=function
    Branch v1 -> taken b1(), notTaken b2()
  b1():
    v2 = PropGet v0 key="prototype"
    v3 = NewClosure function=f5
    PropSet v2, v3 key="m"
    Jump -> next b2()
  b2():
    v5 = Boolean boolean=false
    Return v5
}
function f4 name="extend" module=m0 flags=[HasExplicitName] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v1 key="hasOwnProperty"
    v3 = String string="x"
    v4 = Call v2, v1, v3 calleeKey="hasOwnProperty"
    v5 = NewClosure v0 function=f7
    v6 = PropGet v1 key="prototype"
    PropSet v5, v6 key="prototype"
    v8 = Construct v5
    PropSet v0, v8 key="prototype"
    v10 = Undefined
    Return v10
}
function f5 name="late" module=m0 flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="own"
    Return v1
}
function f6 name="orig" module=m0 flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = String string="orig"
    Return v1
}
function f7 name="T" module=m0 flags=[IsSloppy, HasThis, HasExplicitName] captures=[{type=anything variableName="child"}] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = ToThis v1
    PropSet v2, v0 key="constructor"
    v4 = Undefined
    Return v4
}
