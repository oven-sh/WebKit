# made of fcc7e422b8423915
# An object and a number are picked by one flag, and fields of both objects were read in front of the picks. What is read or written through the picked object is that object's, on either arm.
# Here the flag comes out of a ternary of two comparisons; a store goes through a field of the object; in a loop; the function is called out of a loop, where it is copied.
# class Node { constructor(key, weight, child) { this.key = key; this.weight = weight; this.child = child; } get() { return this.key * 2; } }
# function tree(kind) { const made = { left: new Node(1, 2, new Node(10, 1, null)), right: new Node(5, 3, new Node(50, 1, null)) }; if (kind === 1) made.right.weight = 0; if (kind === 2) made.left.child = null; if (kind === 3) made.left.weight = 0; if (kind === 4) made.right.child = null; return made; }
# function pick(tree, key, exact) { const left = tree.left, right = tree.right; if (!left.weight || !right.weight || !left.child || !right.child) return "none"; let total = 0; for (let turn = 0; turn < 4; turn++) { const flag = exact ? (key + turn) === left.key : (key + turn) < right.key; const side = flag ? left : right; const weight = flag ? left.weight : right.weight; if (weight && side.child) { side.child.key = 100; { total += (left.child === null ? 7 : left.child.key) * 1000 + (right.child === null ? 7 : right.child.key); continue; } } total -= 1; } return total; }
# for (let kind = 0; kind < 5; kind++) { for (let i = 0; i < 16; i++) report(pick(tree(kind), i >> 1, (i & 1) !== 0)); }
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Node { constructor(key, weight, child) { this.key = key; this.weight = weight; this.child = child; } get() { return this.key * 2; } } function tree(kind) { const made = { left: new Node(1, 2, new Node(10, 1, null)), right: new Node(5, 3, new Node(50, 1, null)) }; if (kind === 1) made.right.weight = 0; if (kind === 2) made.left.child = null; if (kind === 3) made.left.weight = 0; if (kind === 4) made.right.child = null; return made; } function pick(tree, key, exact) { const left = tree.left, right = tree.right; if (!left.weight || !right.weight || !left.child || !right.child) return "none"; let total = 0; for (let turn = 0; turn < 4; turn++) { const flag = exact ? (key + turn) === left.key : (key + turn) < right.key; const side = flag ? left : right; const weight = flag ? left.weight : right.weight; if (weight && side.child) { side.child.key = 100; { total += (left.child === null ? 7 : left.child.key) * 1000 + (right.child === null ? 7 : right.child.key); continue; } } total -= 1; } return total; } for (let kind = 0; kind < 5; kind++) { for (let i = 0; i < 16; i++) report(pick(tree(kind), i >> 1, (i & 1) !== 0)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
