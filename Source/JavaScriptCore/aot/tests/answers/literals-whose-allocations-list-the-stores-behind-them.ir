# function make(name: unknown) { const entry: Entry = { name }; entry.count = 0; entry.next = null; return entry; }
# function makeBackwards(name: unknown) { const entry: Entry = { name }; entry.next = null; entry.count = 0; return entry; }
# function note(o: any) { seen += Object.keys(o).join() + ";"; }
# function makeSeen(name: unknown) { const entry: Entry = { name }; note(entry); entry.count = 0; return entry; }
# function makeOver(name: unknown) { const entry: Entry = { name, count: 1 }; entry.count = 2; entry.name = "over"; return entry; }
# function makeSame(name: unknown) { const entry: Entry = { name, count: 1 }; entry.count = 1; entry.name = name; return entry; }
# function makeZero() { const entry: Entry = { name: 0 }; entry.name = -0; return Object.is(entry.name, -0); }
# function makeTexts() { const entry: Entry = { name: "a" }; entry.name = "b"; entry.count = "a"; return entry; }
# function makeBoth(name: unknown) { const first: Entry = { name }; first.count = 1; const second: Entry = { name }; second.count = 2; return show(first) + " " + show(second) + " " + (first !== second); }
# function makeItself() { const entry: Entry = { name: 1 }; entry.next = entry; return (entry.next === entry) + " " + Object.keys(entry).join(); }
# function changeLater(name: unknown) { const entry = make(name); entry.count = 5; delete entry.name; entry.name = "again"; return entry; }
# for (let turn = 0; turn < 3; turn++) report(show(make(turn)));
# for (let turn = 0; turn < 3; turn++) report(show(makeBackwards(turn)));
# report(show(makeSeen("s")) + " " + seen);
# report(show(makeSeen("t")) + " " + seen);
# report(show(makeOver("o")));
# report(show(makeOver(1)));
# report(show(makeSame("o")));
# report(show(makeSame(1)));
# report(makeZero());
# report(makeZero());
# report(show(makeTexts()));
# report(show(makeTexts()));
# report(makeBoth("b"));
# report(makeBoth(2));
# report(makeItself());
# report(makeItself());
# report(show(changeLater("c")));
# report(show(changeLater(3)));
# report(show(Object.freeze(make("frozen"))) + " " + Object.isFrozen(make("free")));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let seen = ""; function show(o) { return Object.keys(o).join() + " " + JSON.stringify(o); } function make(name) { const entry = { name }; entry.count = 0; entry.next = null; return entry; } function makeBackwards(name) { const entry = { name }; entry.next = null; entry.count = 0; return entry; } function note(o) { seen += Object.keys(o).join() + ";"; } function makeSeen(name) { const entry = { name }; note(entry); entry.count = 0; return entry; } function makeOver(name) { const entry = { name, count: 1 }; entry.count = 2; entry.name = "over"; return entry; } function makeSame(name) { const entry = { name, count: 1 }; entry.count = 1; entry.name = name; return entry; } function makeZero() { const entry = { name: 0 }; entry.name = -0; return Object.is(entry.name, -0); } function makeTexts() { const entry = { name: "a" }; entry.name = "b"; entry.count = "a"; return entry; } function makeBoth(name) { const first = { name }; first.count = 1; const second = { name }; second.count = 2; return show(first) + " " + show(second) + " " + (first !== second); } function makeItself() { const entry = { name: 1 }; entry.next = entry; return (entry.next === entry) + " " + Object.keys(entry).join(); } function changeLater(name) { const entry = make(name); entry.count = 5; delete entry.name; entry.name = "again"; return entry; } for (let turn = 0;turn < 3; turn++) report(show(make(turn))); for (let turn = 0;turn < 3; turn++) report(show(makeBackwards(turn))); report(show(makeSeen("s")) + " " + seen); report(show(makeSeen("t")) + " " + seen); report(show(makeOver("o"))); report(show(makeOver(1))); report(show(makeSame("o"))); report(show(makeSame(1))); report(makeZero()); report(makeZero()); report(show(makeTexts())); report(show(makeTexts())); report(makeBoth("b")); report(makeBoth(2)); report(makeItself()); report(makeItself()); report(show(changeLater("c"))); report(show(changeLater(3))); report(show(Object.freeze(make("frozen"))) + " " + Object.isFrozen(make("free"))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
