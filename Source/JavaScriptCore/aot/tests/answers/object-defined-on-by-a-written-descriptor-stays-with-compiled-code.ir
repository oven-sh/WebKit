# made of a4e4a906bf7cfb49
# `Object.defineProperty(o, "shown", { get: () => pos })`: the descriptor is written where the call stands and the key is written: the one name changes. The object is handed to nobody, so its maker answers its layout and the closures in its fields keep their callers.
# f1 = make. The scan says the proof, Link goes by it.
# RUN(SCAN): summary f1
# SCAN: change {{*}} DefinesByDescriptor Allocation L{{*}}descriptor-in-sight getter-in-sight=Closure f
# RUN(NEVER): summary f1
# NEVER-NOT: edge Allocation L{{*}} -> Unknown
# RUN(LINK): link functions layouts mechanisms=all
# LINK: function f1 {{*}}callers-known one-callee {{*}}result=L
# LINK: layout L{{*}} changes=[IsFrozen, GainsProperty, GetsAccessor] stays-with-compiled-code
# const debugging = report("begin") === "never";
# function make(start: number) { let pos = start; const o = { next: () => pos++, peek: () => pos }; if (debugging) Object.defineProperty(o, "shown", { get: () => pos }); return o; }
# const s = make(1);
# let sum = 0;
# for (let i = 0; i < 1000; i++) sum += s.next() + s.peek();
# report(sum);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const debugging = report("begin") === "never"; function make(start) { let pos = start; const o = { next: () => pos++, peek: () => pos }; if (debugging) Object.defineProperty(o, "shown", { get: () => pos }); return o; } const s = make(1); let sum = 0; for (let i = 0;i < 1000; i++) sum += s.next() + s.peek(); report(sum); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

