# `options.signal`, where the literal leaves the optional property out: the layout has the field, the slot is empty from birth, and nothing above has the name.
# The place of the read is filled with the shape and the offset all the same, and the stub answers undefined by the object's own marks. Before, nothing was ever filed for such a read:
# every one of them went the whole road behind the place, and every 32nd into the run time, for as long as the program ran.
# `options.other`, a name that the layout has no field for: the place is filled with the Structure and "absent", which ends when the object gets a property of its own or Object.prototype changes.
# RUN: run-in-shell --aotCountsPath=/dev/null globalThis.register = (signalOf, bare, full) => { let missing = 0; for (let turn = 0; turn < 6400; turn++) { if (signalOf(bare()) === undefined) missing++; } print(missing, aotOperationCount("operationAOTFillSiteAnswers") < 8 ? "the place was filled" : "the place stayed empty"); print(signalOf(full()), signalOf(bare())); const later = bare(); later.signal = "later"; print(signalOf(later), signalOf(bare())); const got = bare(); Object.defineProperty(got, "signal", { get() { return "got"; } }); print(signalOf(got), signalOf(bare())); const below = bare(); Object.setPrototypeOf(below, { signal: "above" }); print(signalOf(below), signalOf(bare())); };
# CHECK: 6400 the place was filled
# CHECK-NEXT: signal undefined
# CHECK-NEXT: later undefined
# CHECK-NEXT: got undefined
# CHECK-NEXT: above undefined
# CHECK-NEXT: exited with 0
# RUN(NOFIELD): run-in-shell --aotCountsPath=/dev/null globalThis.register = (signalOf, bare, full, otherOf) => { let missing = 0; for (let turn = 0; turn < 6400; turn++) { if (otherOf(bare()) === undefined) missing++; } print(missing, aotOperationCount("operationAOTFillSiteAnswers") < 8 ? "the place was filled" : "the place stayed empty"); const later = bare(); later.other = "later"; print(otherOf(later), otherOf(bare())); const got = bare(); Object.defineProperty(got, "other", { get() { return "got"; } }); print(otherOf(got), otherOf(bare())); const below = bare(); Object.setPrototypeOf(below, { other: "above" }); print(otherOf(below), otherOf(bare())); const proxied = bare(); Object.setPrototypeOf(proxied, new Proxy({ }, { get() { return "proxy"; } })); print(otherOf(proxied), otherOf(bare())); };
# NOFIELD: 6400 the place was filled
# NOFIELD-NEXT: later undefined
# NOFIELD-NEXT: got undefined
# NOFIELD-NEXT: above undefined
# NOFIELD-NEXT: proxy undefined
# NOFIELD-NEXT: exited with 0
# `options.other` asked at one place of objects of five kinds that all lack it: the place keeps the Structures of all five, and each way in which the name comes to one of them ends it for that one.
# RUN(MANY): run-in-shell --aotCountsPath=/dev/null globalThis.register = (signalOf, bare, full, otherOf) => { const root = { above: 1 }; const kinds = [bare, () => ({ a: 1 }), () => ({ b: 1, c: 2 }), () => Object.create(null), () => Object.create(root)]; const all = () => { let text = ""; for (let kind = 0; kind < 5; kind++) text += (kind ? "," : "") + otherOf(kinds[kind]()); return text; }; let missing = 0; for (let turn = 0; turn < 32000; turn++) { if (otherOf(kinds[turn % 5]()) === undefined) missing++; } print(missing, aotOperationCount("operationAOTFillSiteAnswers") < 100 ? "the place holds all five" : "the place holds too few"); gc(); print(all()); const later = kinds[1](); later.other = "later"; print(otherOf(later), all()); root.other = "above"; print(all()); delete root.other; print(all()); for (let turn = 0; turn < 32000; turn++) { if (otherOf(kinds[turn % 5]()) === undefined) missing++; } Object.setPrototypeOf(root, { other: "laid above" }); print(missing, all()); };
# MANY: 32000 the place holds all five
# MANY-NEXT: undefined,undefined,undefined,undefined,undefined
# MANY-NEXT: later undefined,undefined,undefined,undefined,undefined
# MANY-NEXT: undefined,undefined,undefined,undefined,above
# MANY-NEXT: undefined,undefined,undefined,undefined,undefined
# MANY-NEXT: 64000 undefined,undefined,undefined,undefined,laid above
# MANY-NEXT: exited with 0
# `options.other` asked at one place of objects of three kinds that have it, each elsewhere in its cell, then of two more that lack it: the place keeps an answer for each of the five.
# RUN(EACH): run-in-shell --aotCountsPath=/dev/null globalThis.register = (signalOf, bare, full, otherOf) => { const kinds = [() => ({ other: 1 }), () => ({ a: 0, other: 2 }), () => ({ a: 0, b: 0, other: 3 }), bare, () => ({ c: 0 })]; const all = () => { let text = ""; for (let kind = 0; kind < 5; kind++) text += (kind ? "," : "") + otherOf(kinds[kind]()); return text; }; let sum = 0; for (let turn = 0; turn < 19200; turn++) sum += otherOf(kinds[turn % 3]()); for (let turn = 0; turn < 32000; turn++) sum += otherOf(kinds[turn % 5]()) | 0; print(sum, aotOperationCount("operationAOTFillSiteAnswers") < 100 ? "the place holds all five" : "the place holds too few"); gc(); print(all()); const removed = kinds[1](); delete removed.other; print(otherOf(removed), all()); const got = kinds[2](); Object.defineProperty(got, "other", { get() { return "got"; } }); print(otherOf(got), all()); };
# EACH: 76800 the place holds all five
# EACH-NEXT: 1,2,3,undefined,undefined
# EACH-NEXT: undefined 1,2,3,undefined,undefined
# EACH-NEXT: got 1,2,3,undefined,undefined
# EACH-NEXT: exited with 0
# `options.signal` of objects that leave the property out and stand below another object than Object.prototype: the place keeps what stands above them, in that object's cell, in its storage, or nowhere.
# RUN(ABOVE): run-in-shell --aotCountsPath=/dev/null globalThis.register = (signalOf, bare, full) => { const many = { }; for (let i = 0; i < 12; i++) many["p" + i] = i; many.signal = "in the storage"; const roots = [{ }, { signal: "in the cell" }, many]; for (let which = 0; which < 3; which++) { const root = roots[which]; const below = () => Object.setPrototypeOf(bare(), root); const before = aotOperationCount("operationAOTFillSiteAnswers"); let seen; for (let turn = 0; turn < 32000; turn++) seen = signalOf(below()); print(seen, aotOperationCount("operationAOTFillSiteAnswers") - before < 100 ? "the place keeps what stands above" : "the place keeps nothing"); gc(); print(signalOf(below()), signalOf(Object.setPrototypeOf(full(), root)), signalOf(bare())); root.signal = "stored above"; print(signalOf(below())); for (let i = 0; i < 40; i++) root["q" + i] = i; print(signalOf(below())); delete root.signal; print(signalOf(below())); Object.defineProperty(root, "signal", { get() { return "got above"; } }); print(signalOf(below())); } };
