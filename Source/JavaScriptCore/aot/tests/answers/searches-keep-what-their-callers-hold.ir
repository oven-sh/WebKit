# made of f90453a7c32735ff
# a loop holds a counter, a sum, a fraction and a text across calls of indexOf and includes, whose functions may be ones that save what they write
# the form shows in tests/plan/tail-calls/search-of-the-library-saves-the-registers-of-its-callers.ir alone: the two functions of today's library each make a call in tail position, which the rule refuses
# f1 = positions, f2 = tell
# LIBRARY: own
# RUN(FORM): walk f1 mechanisms=all
# REQUIRES(FORM): entries-of-bun
# FORM-LABEL: code f1:Body
# FORM: isLoopHead=true
# -- source: searches-keep-what-their-callers-hold.ts
# declare function report(value: unknown): void;
# function positions(list: unknown[], wanted: unknown[]): string { let text = ""; let sum = 0; let scale = 1.5; for (let i = 0; i < wanted.length; i++) { const at = list.indexOf(wanted[i]); const has = list.includes(wanted[i]); sum += at * (i + 1); scale += at; text += at + (has ? "y" : "n"); } return text + ":" + sum + ":" + scale; }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => positions([1, 2, 3], [3, 1, 9]));
# tell(() => positions([1.5, NaN, "a", undefined, null], [NaN, undefined, null, "a", 1.5]));
# tell(() => positions([, 1] as any, [undefined, 1]));
# tell(() => positions([], [1]));
# tell(() => positions(["a", "b", "ab"], ["a" + "b", "b", "c"]));
# tell(() => positions([{}, tell], [tell, {}]));
# tell(() => positions(null as any, [1]));
# tell(() => positions([1, 2, 3], [2]));
# report("end");
# -- end of source
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function positions(list, wanted) { let text = ""; let sum = 0; let scale = 1.5; for (let i = 0;i < wanted.length; i++) { const at = list.indexOf(wanted[i]); const has = list.includes(wanted[i]); sum += at * (i + 1); scale += at; text += at + (has ? "y" : "n"); } return text + ":" + sum + ":" + scale; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => positions([1, 2, 3], [3, 1, 9])); tell(() => positions([1.5, NaN, "a", undefined, null], [NaN, undefined, null, "a", 1.5])); tell(() => positions([, 1], [undefined, 1])); tell(() => positions([], [1])); tell(() => positions(["a", "b", "ab"], ["a" + "b", "b", "c"])); tell(() => positions([{}, tell], [tell, {}])); tell(() => positions(null, [1])); tell(() => positions([1, 2, 3], [2])); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# REQUIRES: entries-of-bun
# CHECK: 9 of 9 of 9
# CHECK-NEXT: exited with 0

