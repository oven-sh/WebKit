# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function rows(n) { let s = ""; for (let i = 0;i < n; i++) { if (s.length > 8) s += "|"; s += i; } return s; } function joined(n) { let s = ""; for (let i = 0;i < n; i++) { if (s) s += ","; s += i; } return s; } function spaced(n) { let s = ""; for (let i = 0;i < n; i++) { if (s !== "") s += " "; if (i % 3) s += i; } return s; } function lengths(n) { let s = ""; let sum = 0; for (let i = 0;i < n; i++) { sum += s.length; s += "ab"; sum += s.length; s += i; sum += s.length; } return sum + ":" + s.length; } function wide(n) { let s = ""; for (let i = 0;i < n; i++) { s += "Ā"; if (s.length === 3) s += "!"; } return s + s.length; } function begun(head, n) { let s = head; let seen = ""; for (let i = 0;i < n; i++) { seen += s.length + (s ? "y" : "n") + (s === "" ? "e" : "f"); s += ""; seen += s.length; s += "x"; } return seen + "/" + s; } function inner(n) { let s = ""; let sum = 0; for (let i = 0;i < n; i++) { s += "ab"; for (let j = 0;j < 3; j++) sum += s.length; } return sum; } function both(n) { let s = ""; let t = ""; for (let i = 0;i < n; i++) { if (!s) t += "first"; s += i; if (t.length > s.length) s += "-"; t += s.length; } return s + "/" + t; } function read(n) { let s = ""; let seen = ""; for (let i = 0;i < n; i++) { s += "k"; const kept = s; seen += kept.length + ":" + s.length + ";"; s += "l"; seen += kept.length + ":" + s.length + ";"; } return seen; } function arms(n) { let s = ""; let odd = 0; let even = 0; for (let i = 0;i < n; i++) { if (i % 2) odd += s.length; else even += s.length; s += "xy"; } return odd + "/" + even; } function last(n) { let s = ""; let sum = 0; for (let i = 0;i < n; i++) { s += i; sum += s.charCodeAt(s.length - 1); } return sum; } function marked(n) { let s = ""; for (let i = 0;i < n; i++) { if (s === "0") s += ","; if (s == "0,1") s += ";"; s += i; } return s; } for (let n = 0;n < 14; n += 3) report(rows(n)); for (let n = 0;n < 5; n++) report(joined(n)); for (let n = 0;n < 8; n++) report(spaced(n)); for (let n = 0;n < 13; n += 4) report(lengths(n)); for (let n = 0;n < 5; n++) report(wide(n)); report(begun("", 0)); report(begun("", 3)); report(begun("ab", 2)); report(begun("Ā", 2)); report(inner(0)); report(inner(4)); report(both(0)); report(both(12)); report(read(3)); report(arms(0)); report(arms(5)); report(last(0)); report(last(12)); report(marked(1)); report(marked(4)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
