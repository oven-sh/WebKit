# report(said);
# report("end");
# Members are read, stored to, called, read by key, taken apart and chained on records, null, undefined, a number, a text and an object with a getter. Where the language throws, what stands to the right has run or has not, as the language says.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let said = ""; function name(error) { return error instanceof TypeError ? "TypeError" : String(error); } function reads(box) { try { return box.value; } catch (error) { return name(error); } } function readsTwice(box) { try { const first = box.value; return first + box.more; } catch (error) { return name(error); } } function stores(box) { try { box.value = (said += "v", 1); return box.value; } catch (error) { return name(error); } } function calls(box) { try { return box.run((said += "a", 1)); } catch (error) { return name(error); } } function byKey(box, key) { try { return box[(said += "k", key)]; } catch (error) { return name(error); } } function takesApart(box) { try { const { value, more = 5 } = box; return value + ":" + more; } catch (error) { return name(error); } } function chained(box) { return box?.value?.length + ":" + box?.run?.(2); } const boxes = [{ value: "ab", more: 1, run(by) { return by * 2; } }, { value: 3 }, null, undefined, 0, "text", { get value() { said += "g"; return null; } }]; for (const box of boxes) { report(reads(box)); report(readsTwice(box)); report(stores(box)); report(calls(box)); report(byKey(box, "value")); report(takesApart(box)); report(chained(box)); } report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
