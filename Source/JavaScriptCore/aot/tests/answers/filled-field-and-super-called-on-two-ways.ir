# super() stands on two ways, so this is what either call has answered.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class A { constructor(v) { this.a = v; } } class B extends A { constructor(v) { if (v) super(1); else super(2); this.b = 3; } } function readA(x) { return x.a; } function readB(x) { return x.b; } report(readA(new B(true))); report(readA(new B(false))); report(readB(new B(true))); report(readB(new B(false))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
