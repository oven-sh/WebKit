# THE YES OF `$isPlainInstanceOf(object, Meter)` TEACHES THE WALK. In the arm of the yes the object is of the layout that Meter itself declares, no field of it has left its slot, it bears no mark and stands below its prototype:
# the reads of its fields are reads of slots, with no test of the shape, no look at the slot and no closed arm. `$findsDeclaredMember` in that arm asks the guards of this one class.
# function Meter(level) { this.level = level; this.count = 1; }
# Meter.prototype.read = function () { return this.level; };
# function Other(level) { this.count = 2; this.level = level; }
# function road(object) { if ($isPlainInstanceOf(object, Meter)) return "short " + (object.level + object.count); return "full " + (object.level + object.count); }                                in a file of the library
# function broken(object) { if ($isPlainInstanceOf(object, Meter)) { amid(object); return "short " + (object.level + object.count); } return "full " + (object.level + object.count); }        in a file of the library
# const made = new Meter(5);
# print(road(made), road(new Other(6)), road({ level: 1, count: 2 }));
# change(made, Meter);
# print(road(made), road(new Meter(8)));
# print(broken(new Meter(9)));
# f3 = road, f4 = broken
# OPTIONS: mechanisms=all
# RUN(FORM): walk f3
# FORM: = IsPlainInstanceOf v0 {{*}}receivers=[L0]
# FORM: L0{{*}} = Narrowed v0, {{*}}[isOnTakenEdge]
# FORM-NEXT: = Unbox
# FORM-NEXT: = GetSlot {{*}}key="level" receivers=[L0] level=Proven
# FORM-NEXT: = GetSlot {{*}}key="count" receivers=[L0] level=Proven
# What the yes says of the cell holds until code of the program can run again: behind the call the slots are looked at anew, beside a closed arm. The layout stays proven: an object never changes it.
# RUN(AMIDFORM): walk f4
# AMIDFORM: = Call {{*}}calleeName="amid"
# AMIDFORM: = IsSlotFilled {{*}}key="level" receivers=[L0]
# AMIDFORM: = PropGet {{*}}key="level"
# RUN(NOTHING): run-in-shell change = function () { }; amid = function () { };
# NOTHING: short 6 full 8 full 3
# NOTHING-NEXT: short 6 short 9
# NOTHING-NEXT: short 10
# NOTHING-NEXT: exited with 0
# RUN(ACCESSOR): run-in-shell change = function (made) { Object.defineProperty(made, "count", { get() { return 70; }, configurable: true }); }; amid = function () { };
# ACCESSOR: short 6 full 8 full 3
# ACCESSOR-NEXT: full 75 short 9
# RUN(DELETED): run-in-shell change = function (made) { delete made.count; }; amid = function () { };
# DELETED: short 6 full 8 full 3
# DELETED-NEXT: full NaN short 9
# RUN(AMID): run-in-shell change = function () { }; amid = function (made) { Object.defineProperty(made, "count", { get() { return 71; }, configurable: true }); };
# AMID: short 6 full 8 full 3
# AMID-NEXT: short 6 short 9
# AMID-NEXT: short 80
# RUN(AMIDDELETED): run-in-shell change = function () { }; amid = function (made) { delete made.level; };
# AMIDDELETED: short 6 full 8 full 3
# AMIDDELETED-NEXT: short 6 short 9
# AMIDDELETED-NEXT: short NaN
# RUN(AMIDABOVE): run-in-shell change = function () { }; amid = function (made) { delete made.level; Object.setPrototypeOf(made, { level: 72 }); };
# AMIDABOVE: short 6 full 8 full 3
# AMIDABOVE-NEXT: short 6 short 9
# AMIDABOVE-NEXT: short 73

