# made of b5782234ce782519
# a flat text of narrow characters is well formed, and the stub says so; a wide text, a rope and every other receiver are served as before
# f1 = sound: the site is the one of a call by name, and the stub that it calls bears the form
# RUN(FORM): bytes f1:Body mechanisms=all
# FORM: CallMethodOfBuiltinClass{{*}}StringIsWellFormed
# LIBRARY: own
# let calls = 0;
# function sound(text: any) { const answer = text.isWellFormed(); calls++; return answer; }
# function tried(f: () => unknown) { try { return String(f()); } catch (e) { return e instanceof TypeError ? "TypeError" : "another error"; } }
# class Shelf { isWellFormed() { return "a shelf"; } }
# const record = { isWellFormed: () => "a record" };
# report(sound("plain"));
# report(sound(""));
# report(sound(new Shelf()));
# report(sound(record));
# report(sound("café"));
# report(sound("Ā"));
# report(sound("\ud800"));
# report(sound("a\udc00b"));
# report(sound("a😀"));
# report(sound("\ude00\ud83d"));
# let rope = "ab";
# rope += String(calls);
# rope += "cd";
# report(sound(rope));
# let wideRope = "\ud83d";
# wideRope += String(calls);
# report(sound(wideRope));
# wideRope = "\ud83d";
# wideRope += "\ude00";
# report(sound(wideRope));
# report(sound("a long text that is cut".slice(2, 11)));
# report(sound(new String("boxed")));
# report(sound(new String("\ud800")));
# report(tried(() => sound(null)));
# report(tried(() => sound(undefined)));
# report(tried(() => sound(5)));
# report(tried(() => sound({})));
# report(tried(() => (String.prototype as any).isWellFormed.call(null)));
# report((String.prototype as any).isWellFormed.call(12));
# report((String.prototype as any).isWellFormed.call({ toString() { calls += 100; return "\udfff"; } }));
# report(calls);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let calls = 0; function sound(text) { const answer = text.isWellFormed(); calls++; return answer; } function tried(f) { try { return String(f()); } catch (e) { return e instanceof TypeError ? "TypeError" : "another error"; } } class Shelf { isWellFormed() { return "a shelf"; } } const record = { isWellFormed: () => "a record" }; report(sound("plain")); report(sound("")); report(sound(new Shelf)); report(sound(record)); report(sound("café")); report(sound("Ā")); report(sound("\uD800")); report(sound("a\uDC00b")); report(sound("a\uD83D\uDE00")); report(sound("\uDE00\uD83D")); let rope = "ab"; rope += String(calls); rope += "cd"; report(sound(rope)); let wideRope = "\uD83D"; wideRope += String(calls); report(sound(wideRope)); wideRope = "\uD83D"; wideRope += "\uDE00"; report(sound(wideRope)); report(sound("a long text that is cut".slice(2, 11))); report(sound(new String("boxed"))); report(sound(new String("\uD800"))); report(tried(() => sound(null))); report(tried(() => sound(undefined))); report(tried(() => sound(5))); report(tried(() => sound({}))); report(tried(() => String.prototype.isWellFormed.call(null))); report(String.prototype.isWellFormed.call(12)); report(String.prototype.isWellFormed.call({ toString() { calls += 100; return "\uDFFF"; } })); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
