# STATISTIC: DecimalsReused >= 6
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g, h, k, l, m) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); show(() => f(amounts, false)); show(() => g(amounts, (finite, total) => total)); show(() => h(amounts, true, String)); show(() => k(amounts, x => { if (x === amounts[2]) throw 1; }, x => show(() => x))); show(() => l(amounts, amounts[5], 5)); show(() => JSON.stringify(l(amounts, amounts[5], { a: 10, b: 20, c: 30 }))); show(() => m(amounts)); };
