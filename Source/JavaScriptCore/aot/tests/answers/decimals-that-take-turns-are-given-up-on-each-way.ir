# What gives the object up on one way has not done so on another.
# sink((list, flag, call) => { let total = new Decimal(0); for (const x of list) total = total.add(x); if (flag) call(total); return total; }, (list, call) => { let total = new Decimal(0); for (const x of list) total = total.add(x); return call(total.isFinite(), total); }, (list, flag, call) => { let total = new Decimal(0); for (const x of list) total = total.add(x); const text = call(flag ? total : list[0]); return text + total.toString(); }, (list, check, call) => { let total = new Decimal(0); for (const x of list) { try { check(x, total.isFinite()); total = total.add(x); check(); } catch { call(total); } } return total; }, (list, last, other) => { let total = new Decimal(0); for (const x of list) { total = total.add(x); if (x === last) total = other; } return total; }, list => { let count = 0, total = new Decimal(0); for (const x of list) { total = total.add(x); if (total.equals(new Decimal(1))) count++; } return count; });
