# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const box = JSON.parse('{"held":null}'); function unknown(value) { box.held = value; return box.held; } function everyA(x) { const result = x.replace(/a/g, "-"); report(typeof result); return result; } function stickyA(x) { const result = x.replace(/a/y, "-"); report(typeof result); return result; } function commas(x) { const result = x.split(/\s*,\s*/); report(typeof result); return result; } function inTail(x) { return x.replace(/a/g, "+"); } function partsInTail(x) { return x.split(/,/); } function stickyInTail(x) { return x.replace(/a/y, "+"); } function keptA(x) { const pattern = /a/g; const result = x.replace(pattern, "-"); report(pattern.lastIndex); return result; } function aroundTail(x) { const result = inTail(x); report(typeof result); return result; } const keeper = unknown({ replace(pattern) { return pattern; }, split(pattern) { return pattern; } }); report(everyA(unknown("banana"))); report(stickyA(unknown("abba"))); report(commas(unknown("p , q,r")).join("|")); report(keptA(unknown("banana"))); report(inTail(unknown("banana"))); report(partsInTail(unknown("a,b,c")).length); report(stickyInTail(unknown("aab"))); report(aroundTail(unknown("banana"))); const askers = [everyA, stickyA, commas, keptA, inTail, partsInTail, stickyInTail, aroundTail]; for (let i = 0; i < askers.length; i++) {   const ask = askers[i];   const first = ask(keeper), second = ask(keeper);   report(first === second);   report(first.source + " " + first.flags + " " + first.lastIndex);   first.lastIndex = 2; first.mine = 1;   const third = ask(keeper);   report(third.lastIndex + " " + third.mine); } report(everyA(unknown("banana"))); report(commas(unknown("a,b")).length); report(inTail(unknown("banana"))); report(partsInTail(unknown("a,b")).length); report("end"); }; const got = []; global