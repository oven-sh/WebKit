# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function tell(deed) { try { report(deed()); } catch (error) { report(error.constructor.name); } } let last = null; function hole(n, absent, acc) { "use strict"; if (n === 0) return acc + (absent === undefined ? 0 : 1000); const list = [n - 1, , acc + 1]; last = list; return hole.apply(null, list); } function full(n, middle, acc) { "use strict"; if (n === 0) return acc + middle; const list = [n - 1, 3, acc + 1]; last = list; return full.apply(null, list); } function fractions(n, absent, acc) { "use strict"; if (n < 1) return acc + (absent === undefined ? 0 : 1000); const list = [n - 1, , acc + 0.25]; last = list; return fractions.apply(null, list); } let turns = 0; function nothingButHoles(first, second, third) { "use strict"; if (++turns === 100000) return String(first) + String(second) + String(third) + arguments.length; return nothingButHoles.apply(null, new Array(3)); } function seventy(n) { "use strict"; const acc = arguments[69]; if (n === 0) return acc + (arguments[35] === undefined ? 0 : 1000) + arguments.length; const list = new Array(70); list[0] = n - 1; list[69] = acc + 1; return seventy.apply(null, list); } function seventyFractions(n) { "use strict"; const acc = arguments[69]; if (n < 1) return acc + (arguments[35] === undefined ? 0 : 1000) + arguments.length; const list = [n - 1, 0.5]; list[69] = acc + 0.25; return seventyFractions.apply(null, list); } function sparse(n, absent, acc) { "use strict"; if (n === 0) return acc + (absent === undefined ? 0 : 1000); const list = [n - 1]; list[200000] = 0; list.length = 3; list[2] = acc + 1; return sparse.apply(null, list); } let reads = 0; function computed(n, middle, acc) { "use strict"; if (n === 0) return acc + middle; const list = [n - 1, 0, acc + 1]; Object.defineProperty(list, 1, { get() { reads++; return 5; } }); return computed.apply(null, list); } const parent = Object.create(Array.prototype); parent[1] = 4; function inherited(n, middle, acc) { "use strict"; if (n === 0) return acc + middle; const list = [n - 1, , acc + 1]; Object.setPrototypeOf(list, parent); return inherited.apply(null, list); } function reflected(n, absent, acc) { "use strict"; if (n === 0) return acc + (absent === undefined ? 0 : 1000); const list = [n - 1, , acc + 1]; last = list; return Reflect.apply(reflected, null, list); } function count() { return arguments.length; } function second(first, other) { return other; } function inside(callee, list) { "use strict"; const result = callee.apply(null, list); return result; } tell(() => hole(100000, undefined, 0)); tell(() => full(100000, 3, 0)); tell(() => fractions(100000.5, undefined, 0.5)); tell(() => nothingButHoles(1, 2, 3)); tell(() => seventy.apply(null, [100000].concat(new Array(68), [0]))); tell(() => seventyFractions.apply(null, [100000.5].concat(new Array(68), [0.5]))); tell(() => sparse(100000, undefined, 0)); tell(() => computed(100000, 5, 0)); tell(() => reads); tell(() => inherited(100000, 4, 0)); tell(() => reflected(100000, undefined, 0)); tell(() => last.length); tell(() => inside(count, [1, , 3])); tell(() => inside(second, [1, , 3])); tell(() => inside(second, [1.5, , 3.5])); tell(() => inside(count, new Array(9))); tell(() => inside(second, new Array(9))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
