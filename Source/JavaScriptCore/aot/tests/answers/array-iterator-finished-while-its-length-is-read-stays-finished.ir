#   const list = {
#     turn,
#     iterator: undefined,
#     keys: Array.prototype.keys,
#     get length() {
#       const turn = this.turn;
#       if (turn === 0) {
#         this.turn = 1;
#         this.iterator.next();
#         return 2;
#       }
#       if (turn === 1) {
#         this.turn = 2;
#         return 0;
#       }
#       if (turn === 3) {
#         this.turn = 2;
#         this.iterator.next();
#         this.iterator.next();
#         return 3;
#       }
#       return 3;
#     },
#   };
#   list.iterator = list.keys();
#   return list;
# }
# function step(list) {
#   const result = list.iterator.next();
#   print(result.value, result.done);
# }
# const finished = made(0);
# step(finished);
# step(finished);
# const rewound = made(3);
# step(rewound);
# step(rewound);
# -- end of source
