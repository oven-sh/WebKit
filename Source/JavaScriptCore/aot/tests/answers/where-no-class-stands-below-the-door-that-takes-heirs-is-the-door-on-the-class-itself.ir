# WHERE THE PROGRAM HAS NO CLASS BELOW THE CLASS ASKED, `$isPlainHeirOf` IS `$isPlainInstanceOf`, AND A `$findsDeclaredMember` THAT NAMES ITS CLASS COSTS WHAT THE ONE WITHOUT A CLASS COSTS.
# The door that takes heirs begins the guards of the class asked in front of itself (a byte loaded and tested), because an object that a class BELOW has made does not prove that they have begun: a deed on the prototype of the class asked in front of its arming would be heard by nobody (the last group).
# Where no class below is taken, an object of the one shape proves it, as for the door on the class itself: nothing is built (HEIRS), and a deed in front of the first object is seen at the arming that the first object brings (the second group).
# AN HEIR THAT THE COMPILER DOES NOT SEE (a class made at run time, another new.target, an ordinary object that the maker fills) has a shape that is not among the receivers: it is turned away to the long road by both doors alike. An object of the class laid below an EMPTY object keeps its yes: plain objects in between that hide no member are in the contract.
# A row `a && b && c` of questions asks the guards of the row by one test. Each question that names its class reads the binding anew: two reads of one module variable name one class (ROW: as WITHOUT).
# function Base() { this.state = 1; }
# Base.prototype.end = function () { return 1; };
# Base.prototype.start = function () { return 2; };
# Base.prototype.pause = function () { return 3; };
# function Other() { this.state = 1; }
# Other.prototype.end = function () { return 1; };
# class Below extends Other { }
# function askItself(object) { return $isPlainInstanceOf(object, Base) ? "yes " + object.state : "no " + object.state; }            in a file of the library
# function askHeirs(object) { return $isPlainHeirOf(object, Base) ? "yes " + object.state : "no " + object.state; }            in a file of the library
# function askOther(object) { return $isPlainHeirOf(object, Other) ? "yes " + object.state : "no " + object.state; }            in a file of the library
# function keepsWithoutClass(object) { return $isPlainInstanceOf(object, Base) && $findsDeclaredMember(object, "end") && $findsDeclaredMember(object, "start") && $findsDeclaredMember(object, "pause"); }            in a file of the library
# function keepsWithClass(object) { return $isPlainInstanceOf(object, Base) && $findsDeclaredMember(object, "end", Base) && $findsDeclaredMember(object, "start", Base) && $findsDeclaredMember(object, "pause", Base); }            in a file of the library
# const Bases = keep(Base), Others = keep(Other), Belows = keep(Below), itself = keep(askItself), heirs = keep(askHeirs), others = keep(askOther), without = keep(keepsWithoutClass), withClass = keep(keepsWithClass);
# print(itself(new Bases()), "|", heirs(new Bases()), "|", without(new Bases()), "|", withClass(new Bases()), "|", others(new Belows()));
