# The read of the method throws in front of the arguments where the receiver is null or undefined.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } get twice() { return this.count * 2 } } let order = ""; function note(text, value) { order += text; return value } function stepOf(counter) { return counter.step(note("argument ", 1)) } function twiceOf(counter) { return counter.twice } function pick(which) { return which === 0 ? null : which === 1 ? undefined : new Counter(which) } for (let which = 0; which < 3; which++) { try { report(stepOf(pick(which))) } catch (error) { report(error instanceof TypeError) } } report(order); for (let which = 0; which < 3; which++) { try { report(twiceOf(pick(which))) } catch (error) { report(error instanceof TypeError) } } report(pick(0)?.step(1)); report(pick(2)?.step(1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
