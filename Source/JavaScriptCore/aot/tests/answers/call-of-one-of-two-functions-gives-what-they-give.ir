# made of 50a819d269f5f731
# which of two arrow functions a variable holds hangs on what unseen code answers, so the call has no one callee. It enters functions of the program alone all the same: it gives what they give and does what they do
# f1 = use
# OPTIONS: testing=CheckProofsAtRunTime
# RUN(FORM): link calls mechanisms=all
# FORM: several f1 {{*}}result={{*}} layouts-written=none returns=[mayThrow
# RUN(NEVER): link calls mechanisms=all
# NEVER-NOT: several f1 {{*}}mayCallUnknownCode
# const pick = (report as any)("start") ? () => 1 : () => 2;
# function use(box: { n: number }) { const before = box.n; const got = pick(); return before * 100 + box.n * 10 + got; }
# report(use({ n: 5 }));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const pick = report("start") ? () => 1 : () => 2; function use(box) { const before = box.n; const got = pick(); return before * 100 + box.n * 10 + got; } report(use({ n: 5 })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

