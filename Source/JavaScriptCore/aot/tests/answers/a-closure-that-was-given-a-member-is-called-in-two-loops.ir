# report("end");
# A captured variable holds a closure or a number. On some turns the closure is given a member, and then it is called in two loops that follow each other: it is still the function it was.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const one = Date.now() > 0 ? 1 : 2; function make() { const o = { k: one, m: a => o.k + a }; return o.m; } function use(turn, count) { let v = make(); const read = () => { let r = 0; for (let i = 0; i < count; i++) r += v(i); for (let i = 0; i < count; i++) r -= v(i * 2); return r; }; if (turn % 2) v.tag = turn; if (turn % 20 === 7) v = 2.5; return read; } for (let turn = 0; turn < 9; turn++) { try { report(use(turn, 3 + (one - 1))()); } catch (error) { report(error.name); } } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 10 of 10 of 10
# CHECK-NEXT: exited with 0

