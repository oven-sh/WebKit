# made of d5f1c70904a0874b
# Two allocation sites meet and are one family from then on. A descriptor lays one getter on an object of one of them, under a name that is written.
# The reads of the family's other names expect nothing: a lookup in front of each of them would find no getter in any run.
# f1 = pick, f2 = show, f3 = shape
# RUN(HELD): link accesses held mechanisms=all
# HELD: read f2 {{*}} expects getter f3
# HELD-NOT: expects getter
# RUN(WALK): walk f2 mechanisms=all
# WALK-NOT: = GetCachedGetter {{*}}key="text"
# WALK-NOT: = GetCachedGetter {{*}}key="size"
# WALK: = GetCachedGetter {{*}}key="shape"
# function pick(one: any, other: any, first: boolean) { return first ? one : other; }
# const plain: any = Object.create(null);
# plain.size = 1;
# plain.text = "plain";
# const marked: any = Object.create(null);
# marked.size = 2;
# marked.text = "marked";
# Object.defineProperty(marked, "shape", { get: function shape(this: any) { return this.text + this.size; } });
# function show(first: boolean) { const picked = pick(plain, marked, first); return picked.text + ":" + picked.size + ":" + picked.shape; }
# let text = "";
# for (let i = 0; i < 300; i++) text = show((i & 1) === 0) + show((i & 1) === 1);
# report(text);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function pick(one, other, first) { return first ? one : other; } const plain = Object.create(null); plain.size = 1; plain.text = "plain"; const marked = Object.create(null); marked.size = 2; marked.text = "marked"; Object.defineProperty(marked, "shape", { get: function shape() { return this.text + this.size; } }); function show(first) { const picked = pick(plain, marked, first); return picked.text + ":" + picked.size + ":" + picked.shape; } let text = ""; for (let i = 0;i < 300; i++) text = show((i & 1) === 0) + show((i & 1) === 1); report(text); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 2 of 2 of 2
# CHECK-NEXT: exited with 0

