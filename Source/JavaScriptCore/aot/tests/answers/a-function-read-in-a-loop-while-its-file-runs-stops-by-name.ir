# ring.cjs    const early = require("./early.cjs"); exports.run = function() { return "late"; };
# early.cjs   for (let i = 0; i < 2; i++) sink(require("./ring.cjs").run());
# The records lie: early.cjs asks for ring.cjs while that runs, and Link is told that the variable is filled. The test in front of the loop is a real one: it fails, the loop runs as written,
# and the check at the read stops the process by name. Were the test taken for passed, the turns would call what is no function.
