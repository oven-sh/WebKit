# class Shape { constructor(edge) { this.edge = edge } area() { return this.edge } twice() { return this.area() * 2 } }
# class Square extends Shape { constructor(edge) { super(edge); this.corners = 4 } area() { return this.edge * this.edge } }
# class Cube extends Square { constructor(edge) { super(edge); this.faces = 6 } }
# function areaOf(shape) { return shape.area() }
# function pick(which) { return which === 0 ? new Shape(3) : which === 1 ? new Square(3) : new Cube(4) }
# for (let which = 0; which < 3; which++) { report(areaOf(pick(which))); }
# for (let which = 0; which < 3; which++) { report(pick(which).twice()); }
# report(new Shape(5).area());
# report(new Square(5).area());
# report(new Cube(5).area());
# report("end");
# The receivers are a family whose members find different functions under one name, and `this.area()` in the base class finds the one of the receiver's own class.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Shape { constructor(edge) { this.edge = edge } area() { return this.edge } twice() { return this.area() * 2 } } class Square extends Shape { constructor(edge) { super(edge); this.corners = 4 } area() { return this.edge * this.edge } } class Cube extends Square { constructor(edge) { super(edge); this.faces = 6 } } function areaOf(shape) { return shape.area() } function pick(which) { return which === 0 ? new Shape(3) : which === 1 ? new Square(3) : new Cube(4) } for (let which = 0; which < 3; which++) { report(areaOf(pick(which))); } for (let which = 0; which < 3; which++) { report(pick(which).twice()); } report(new Shape(5).area()); report(new Square(5).area()); report(new Cube(5).area()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
