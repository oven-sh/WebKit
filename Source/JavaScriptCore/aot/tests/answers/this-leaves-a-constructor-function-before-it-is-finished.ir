# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const seen = []; function look(value) { seen.push(String(value.a) + String(value.b) + Object.keys(value).join()); return value; } function P() { this.a = 1; look(this); this.b = 2; look(this); } new P(); report(seen.join(";")); let kept; function Q() { kept = this; this.a = 1; fill(); this.c = this.b + 1; } function fill() { kept.b = 10; } const q = new Q(); report(String(q.a) + q.b + q.c + Object.keys(q).join()); function R() { this.self = this; this.get = () => this.v; this.v = 5; } const r = new R(); report(r.self === r); report(r.get()); function S(registry) { registry.push(this); this.id = registry.length; } const registry = []; for (let i = 0; i < 50; i++) new S(registry); let total = 0; for (const s of registry) total += s.id; report(total); function T() { Object.freeze(this); try { this.a = 1; } catch (error) { this.b = 2; } } let frozenThrew = "no"; try { new T(); } catch (error) { frozenThrew = error instanceof TypeError; } report(frozenThrew); function U() { this.a = 1; Object.defineProperty(this, "b", { get() { return this.a + 1; }, enumerable: true }); this.a = 5; } report(new U().b); function V() { this.a = 1; delete this.a; this.c = 3; } report(String(new V().a) + Object.keys(new V()).join()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
