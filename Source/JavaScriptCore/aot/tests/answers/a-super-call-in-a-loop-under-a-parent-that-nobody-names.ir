# made of 6f6c199c19b605d5
# `super(i)` written in a loop, under a parent that neither reading names. The loop is asked whether a typed copy of it could run no other code, and the first operation that runs other code is the SuperConstruct,
# which has a parent and no callee: the question once asked it for its callee, and the getter stopped the build.
# f1 = id, f2 = Below
# function id<T>(value: T): T { (globalThis as any).leaked = value; return (globalThis as any).leaked; }
# const Base: any = (0, eval)("(class { constructor(a) { this.a = a; } })");
# class Below extends Base { constructor(n: number) { const last = n | 0; for (let i = 0; i <= last; i++) { if (i === last) super(i); } } }
# report((new Below(id(3)) as any).a);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function id(value) { globalThis.leaked = value; return globalThis.leaked; } const Base = (0, eval)("(class { constructor(a) { this.a = a; } })"); class Below extends Base { constructor(n) { const last = n | 0; for (let i = 0;i <= last; i++) { if (i === last) super(i); } } } report(new Below(id(3)).a); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 2 of 2 of 2
