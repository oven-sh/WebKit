# function scaled(length: number): string { const pixels = new Uint8ClampedArray(length); for (let k = 0; k < length; k++) pixels[k] = k * 3; for (let k = 0; k < pixels.length; k++) pixels[k] = pixels[k]! * 300 - 40000; return pixels.join(); }
# function limited(length: number): string { const shorts = new Int16Array(length); for (let k = 0; k < length; k++) shorts[k] = k * 2999; for (let k = 0; k < shorts.length; k++) shorts[k] = Math.max(-30000, Math.min(shorts[k]! * 70000, 30000)); return shorts.join(); }
# for (const length of [0, 1, 7, 16, 33]) { report(scaled(length)); report(limited(length)); }
# report("end");
# What is computed from an element of a view may need more bits than the element has. It is held between the limits first and made narrow then, for every length of the view.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function scaled(length) { const pixels = new Uint8ClampedArray(length); for (let k = 0;k < length; k++) pixels[k] = k * 3; for (let k = 0;k < pixels.length; k++) pixels[k] = pixels[k] * 300 - 40000; return pixels.join(); } function limited(length) { const shorts = new Int16Array(length); for (let k = 0;k < length; k++) shorts[k] = k * 2999; for (let k = 0;k < shorts.length; k++) shorts[k] = Math.max(-30000, Math.min(shorts[k] * 70000, 30000)); return shorts.join(); } for (const length of [0, 1, 7, 16, 33]) { report(scaled(length)); report(limited(length)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
