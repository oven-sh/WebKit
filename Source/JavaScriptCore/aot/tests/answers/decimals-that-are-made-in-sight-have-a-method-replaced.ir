# A literal and what `new Decimal` gives need no test of what they are, but their methods may be replaced too.
# sink(() => 1.5m.negate(), value => new Decimal(value).negate());
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns = 2
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g) => { const D = text => new Decimal(text), show = f => { try { print(String(f())); } catch (error) { print(error.name); } }; for (let i = 0; i < 2; i++) show(() => f().toString() + g(2).toString()); Decimal.prototype.negate = () => "own"; show(() => f() + g(2)); };
# CHECK: -1.5-2
# CHECK-NEXT: -1.5-2
# CHECK-NEXT: ownown
# CHECK-NEXT: exited with 0

