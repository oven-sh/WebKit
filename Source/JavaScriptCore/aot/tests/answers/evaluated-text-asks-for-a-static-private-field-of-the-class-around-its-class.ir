# A STATIC PRIVATE FIELD OF THE CLASS AROUND A CLASS, ASKED FOR BY THE TEXT OF A DIRECT EVAL IN THE INNER CLASS. The bindings of such a call list the names and the class object of each class, one depth for each.
# Each name of the text leads to the class object of the class that declares it: where both classes use one name, where the outer class uses it for a field of its objects, where the inner class has no name of its own, and before the later field of the outer class has its value.
# A text in a computed key runs before its class is there: it finds the field on no value, and a function that it made finds it on the class once the value is there.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(run) { try { return String(run()); } catch (error) { return error.name + ": " + error.message; } } const early = []; class Outer {   static #outer = "outer";   static #shared = "shared of the outer";   #mixed = "of an object";   static Inner = class Inner {     static { report(eval("String(#late in Outer) + (#late in this)")); report(attempt(() => eval("Outer.#late"))); }     static #inner = "inner";     static #shared = "shared of the inner";     static #mixed = "of the inner";     static ask(text, value) { return eval(text); }   };   static Bare = class { static ask(text, value) { return eval(text); } };   static #late = "late";   static read() { return Outer.#outer + ", " + Outer.#shared + ", " + Outer.#late; } } function probe(inner, name, value) { report(attempt(() => inner.ask("#" + name + " in value", value))); report(attempt(() => inner.ask("value.#" + name, value))); report(attempt(() => inner.ask("value.#" + name + " += '!'", value))); } function probeAll(inner, name) { probe(inner, name, Outer); probe(inner, name, Outer.Inner); probe(inner, name, new Outer()); probe(inner, name, {}); } probeAll(Outer.Inner, "outer"); probeAll(Outer.Inner, "inner"); probeAll(Outer.Inner, "shared"); probeAll(Outer.Inner, "mixed"); probeAll(Outer.Inner, "late"); probeAll(Outer.Bare, "outer"); report(Outer.read()); class Keyed { static #key = 1; static [(early.push(attempt(() => eval("#key in early")), attempt(() => eval("early.#key")), eval("value => String(#key in value) + value.#key")), "named")] = 1; } report(early[0]); report(early[1]); report(early[2](Keyed)); report(attempt(() => early[2]({}))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.p