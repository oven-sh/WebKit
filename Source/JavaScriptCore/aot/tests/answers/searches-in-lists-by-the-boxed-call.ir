# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let calls = 0; function found(list, x) { const place = list.indexOf(x); calls++; return place; } function held(list, x) { const answer = list.includes(x); calls++; return answer; } const other = { indexOf: () => "a record", includes: () => "a record" }; report(found(other, 1)); report(held(other, 1)); const key = {}; const joined = ["a", "b"].join("") + String(calls); const texts = ["", "a", "ab", "abc", "ab0", "b", "xyz", "ab" + String(calls), "é", "中文", "abcd"]; report(found([], 1)); report(held([], "a")); report(found([1, 2, 3], 1)); report(found([1, 2, 3], 3)); report(found([1, 2, 3], 4)); report(found([1, 2, 3], "1")); report(found([1, 2, 3], 2.5)); report(found([1.5, 2.5], 2.5)); report(found([1, 2, 3], -0)); report(found([0], -0)); report(held([NaN], NaN)); report(found([NaN], NaN)); report(held([1, , 3], undefined)); report(found([1, , 3], undefined)); report(held([null], null)); report(found([null, undefined], undefined)); report(found([true, false], false)); report(found([key, {}], key)); report(found([{}, key], key)); report(found([{}, {}], key)); report(found(texts, "")); report(found(texts, "a")); report(found(texts, "ab")); report(found(texts, "abc")); report(found(texts, "ab0")); report(found(texts, joined)); report(found(texts, "xyz")); report(found(texts, "xyw")); report(found(texts, "é")); report(found(texts, "中文")); report(found(texts, "中斈")); report(found(texts, "abcd")); report(found(texts, "abce")); report(found(texts, "abcde")); report(held(texts, "abcd")); report(held(texts, "abce")); report(held(texts, joined)); report(found(["x", 1, null, key, "y"], "y")); report(found(["x", 1, null, key, "y"], key)); report(found(["x", 1, null, key, "y"], 1)); report(found(["x", , "y"], "y")); report(found(["ab" + String(calls - calls), "ab0"], "ab0")); const long = []; for (let i = 0;i < 40; i++) long[i] = "k" + i; report(found(long, "k39")); report(found(long, "k40")); const exactly = []; for (let i = 0;i < 32; i++) exactly[i] = "k" + i; report(found(exactly, "k31")); report(found(exactly, "k32")); report(held(exactly, "k0")); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
