# made of 8a10b2febb31b283
# user() makes an arrow for its call of each() alone. The copy of each() has the arrow in its loop, and needs the cell only for the call of rest(), the last thing that it does.
# Nothing has taken the cell on the way there, so it is made there: behind the loops, in front of the call. The one in front of the copy has no reader left.
# RUN(FORM): walk f3 mechanisms=all
# FORM-LABEL: code f3:Body
# FORM: isLoopHead=true
# FORM: = NewClosure
# FORM: = CallDirect {{*}}function=f1
# RUN(ONCE): walk f3 mechanisms=all
# ONCE-COUNT-1: = NewClosure
# function rest(list: number[], f: (x: number) => void, i: number) { for (; i < list.length; i++) f(list[i]); }
# function each(list: number[], f: (x: number) => void) { let i = 0; for (; i < list.length && list[i] > 0; i++) f(list[i]); return rest(list, f, i); }
# function user(list: number[], k: number) { let sum = 0; each(list, x => { sum += x * k; }); return sum; }
# for (let round = 0; round < 3; round++) { report(user([1, 2, -3, 4], round)); report(user([], 2)); report(user([-1], 3)); report(user([5, 6], round)); }
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function rest(list, f, i) { for (;i < list.length; i++) f(list[i]); } function each(list, f) { let i = 0; for (;i < list.length && list[i] > 0; i++) f(list[i]); return rest(list, f, i); } function user(list, k) { let sum = 0; each(list, (x) => { sum += x * k; }); return sum; } for (let round = 0;round < 3; round++) { report(user([1, 2, -3, 4], round)); report(user([], 2)); report(user([-1], 3)); report(user([5, 6], round)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 13 of 13 of 13
