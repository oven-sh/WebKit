# The descriptor is made by somebody else: nobody says at the call what it holds. All is as it was: the subject is handed to unseen code.
# f1 = define.
# RUN(SCAN): summary f1
# SCAN: change {{*}} DefinesByDescriptor Parameter 0 "shown"
# RUN(NEVER): summary f1
# NEVER-NOT: descriptor-in-sight
# function define(o: object, descriptor: PropertyDescriptor) { Object.defineProperty(o, "shown", descriptor); }
# function make(start: number) { let pos = start; const o = { next: () => pos++, peek: () => pos }; define(o, { get: () => pos }); return o; }
# const s = make(1);
# let sum = 0;
# for (let i = 0; i < 100; i++) sum += s.next() + s.peek();
# report(sum);
# report((s as any).shown);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function define(o, descriptor) { Object.defineProperty(o, "shown", descriptor); } function make(start) { let pos = start; const o = { next: () => pos++, peek: () => pos }; define(o, { get: () => pos }); return o; } const s = make(1); let sum = 0; for (let i = 0;i < 100; i++) sum += s.next() + s.peek(); report(sum); report(s.shown); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
