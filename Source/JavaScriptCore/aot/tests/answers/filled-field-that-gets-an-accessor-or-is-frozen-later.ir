# Every construction fills the field. Later one object gets an accessor in its place, and another is frozen.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor() { this.x = 1; this.y = 2; } } class Q { constructor() { this.x = 1; } } function readX(p) { return p.x; } function storeX(p, v) { try { p.x = v; } catch (e) { return "refused"; } return p.x; } function readXOfQ(q) { return q.x; } function storeXOfQ(q, v) { try { q.x = v; } catch (e) { return "refused"; } return q.x; } const p = new P(); report(readX(p)); Object.defineProperty(p, "x", { get() { return 40; }, configurable: true }); report(readX(p)); report(storeX(p, 5)); report(readX(new P())); const q = new Q(); report(storeXOfQ(q, 2)); Object.freeze(q); report(readXOfQ(q)); report(storeXOfQ(q, 3)); report(readXOfQ(q)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
