# class A { constructor(v) { this.a = v; } }
# class D extends A { constructor(v) { super(v); this.twice = this.a * 2; if (v) return; this.d = 5; } }
# function readA(x) { return x.a; }
# function readD(x) { return x.d; }
# function readTwice(x) { return x.twice; }
# report(readD(new D(0)));
# report(readD(new D(1)));
# report(readA(new D(1)));
# report(readTwice(new D(3)));
# report("end");
# The derived constructor reads what the constructor above has filled, and returns early in front of one of its own stores.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class A { constructor(v) { this.a = v; } } class D extends A { constructor(v) { super(v); this.twice = this.a * 2; if (v) return; this.d = 5; } } function readA(x) { return x.a; } function readD(x) { return x.d; } function readTwice(x) { return x.twice; } report(readD(new D(0))); report(readD(new D(1))); report(readA(new D(1))); report(readTwice(new D(3))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

