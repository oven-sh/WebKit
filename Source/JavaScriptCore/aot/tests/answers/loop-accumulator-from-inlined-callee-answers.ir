# A loop adds up what a small callee answers.
# RUN: run-in-shell
# CHECK: NaN 3 0xxx 75
# CHECK-NEXT: exited with 0

module m0 path="main.ts" displayPath="main.ts" body=f0
entry module=m0
function f0 module=m0 kind=Module flags=[IsChecked] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Integer integer=6
    v2 = Integer integer=100
    v3 = Builtin builtin=GlobalThis
    v4 = PropGet v3 key="step"
    v5 = Call v0, -, v1, v4
    v6 = Integer integer=1
    v7 = Call v0, -, v1, v6
    v8 = String string="x"
    v9 = Call v0, -, v1, v8
    v10 = Double number=1.5
    v11 = Call v0, -, v2, v10
    v12 = String string=" "
    v13 = Add v5, v12
    v14 = Add v13, v7
    v15 = Add v14, v12
    v16 = Add v15, v9
    v17 = Add v16, v12
    v18 = Add v17, v11
    v19 = PropGet v3 key="print" [isFreeName]
    v20 = Call v19, -, v18
    Return v20
}
function f1 name="total" module=m0 flags=[IsChecked] parameters=[{type=number}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: anything):
    v2 = NewClosure function=f2
    v3 = Integer
    v4 = Integer
    Jump -> next b1(v3, v4)
  b1(v5, v6):
    LoopHint
    v8 = Less v6, v0
    Branch v8 -> taken b2(), notTaken b6()
  b2():
    v9 = Integer integer=1
    v10 = BitAnd v6, v9
    Branch v10 -> taken b3(), notTaken b4()
  b3():
    Jump -> next b5(v5)
  b4():
    v11 = Call v2, -, v5, v1
    Jump -> next b5(v11)
  b5(v12):
    v13 = Increment v6
    Jump -> next b1(v12, v13)
  b6():
    Return v5
}
function f2 name="add" module=m0 flags=[IsChecked] parameters=[{type=number}, {type=number}] results=[{type=number}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: number, v1: number):
    v2 = Add v0, v1
    v3 = Convert v2 declared={type=number}
    Return v3
}
