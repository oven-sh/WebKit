# Eight loops over lists, called by text with whole lists, lists with a hole in the middle and at the end, an empty list and lists of numbers.
# A hole is found behind `i < rows.length` too, a list that a turn shortens is asked for its length again, and a position that no turn has compared is not looked at.
# type Row = { n: number }
# function total(rows: Row[]) { let sum = 0; for (let i = 0; i < rows.length; i++) sum = sum + rows[i].n; return sum; }
# function present(rows: Row[]) { let found = 0; for (let i = 0; i < rows.length; i++) if (i in rows) found = found + 1; return found; }
# function shortened(rows: Row[]) { let found = 0; for (let i = 0; i < rows.length; i++) { rows.pop(); if (i in rows) found = found + 1; } return found; }
# function counted(rows: Row[]) { let found = 0; const n = rows.length; for (let i = 0; i < n; i++) { if (i in rows) found = found + 1; rows.pop(); } return found; }
# function times(rows: Row[]) { let sum = 0; for (let i = 0; i < rows.length; i++) for (let k = 0; k < 100; k++) sum = sum + rows[i].n; return sum; }
# function guarded(rows: Row[], n: number) { const at = n & 7; let sum = 0; for (let k = 0; k < 100; k++) if (at < rows.length) sum = sum + rows[at].n; return sum; }
# function squares(list: number[]) { let s = 0; for (let k = 0; k < 48; k++) { const x = list[k]; s = s + x * x; } return s; }
# function defined(list: Array) { let found = 0; for (let i = 0; i < list.length; i++) if (list[i] !== undefined) found = found + 1; return found; }
# RUN: run-in-shell globalThis.register = (total, present, shortened, counted, times, guarded, squares, defined, row) => { const tell = (f, ...given) => { try { return String(f(...given)); } catch (error) { return error.constructor.name; } }; const lists = () => [[row, row, row, row], [row, , row, row], [], [row, row, row, , ], [1.5, 2.5, 3.5], [1, 2, 3]]; for (const f of [total, present, shortened, counted, times, defined]) { let line = ""; for (const list of lists()) line += " " + tell(f, list); print(line); } print(tell(guarded, [row, row, row, row], 2), tell(guarded, [row], 5), tell(guarded, [row, , row], 1), tell(guarded, [], 0), tell(guarded, [row, row], 9)); const fractions = [], integers = [], holey = []; for (let k = 0; k < 48; k++) { fractions.push(k + 0.5); integers.push(k); holey.push(k + 0.5); } delete holey[3]; print(tell(squares, fractions), tell(squares, integers), tell(squares, [1.5]), tell(squares, holey)); };
# CHECK: 12 TypeError 0 TypeError NaN NaN
# CHECK-NEXT: 4 3 0 3 3 3
# CHECK-NEXT: 2 1 0 2 1 1
# CHECK-NEXT: 2 1 0 2 2 2
# CHECK-NEXT: 1200 TypeError 0 TypeError NaN NaN
# CHECK-NEXT: 4 3 0 3 3 3
# CHECK-NEXT: 300 0 TypeError 0 300
# CHECK-NEXT: 36860 35720 NaN NaN
# CHECK-NEXT: exited with 0

