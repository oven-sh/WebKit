# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function make(start) {   let reads = 0;   const o = {     a: start,     held: { b: start + 1 },     get x() { reads++; return this.a; },     set x(v) { this.a = v * 2; },     get lazy() { const made = { c: this.a }; Object.defineProperty(this, "lazy", { value: made }); return made; },     get only() { return "only"; },     set sink(v) { this.held = { b: v }; },     count() { return reads; },   };   return o; } const o = make(1); report(o.x); o.x = 5; report(o.x); report(o.a); report(o.count()); report(o.lazy.c); report(o.lazy === o.lazy); try { o.only = "stored"; report("stored"); } catch (e) { report(e.name); } report(o.only); report(o.sink); o.sink = 9; report(o.held.b); report(Object.keys(o).join()); const below = Object.create(o); below.a = 40; report(below.x); below.x = 4; report(below.a + " " + o.a); let total = 0; for (let i = 0; i < 300; i++) { const p = make(i); p.x = i; total += p.x + p.held.b + p.lazy.c; } report(total); function thrower() { return { get bad() { throw new RangeError("bad"); } }; } try { thrower().bad; report("no throw"); } catch (e) { report(e.name + e.message); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
