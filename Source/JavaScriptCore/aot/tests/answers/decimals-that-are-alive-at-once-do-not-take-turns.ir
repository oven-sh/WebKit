# The value before is still needed when the next one is made.
# sink((list, mask) => { let total = new Decimal(1), before = new Decimal(2); for (let i = 0; i < list.length; i++) { before = total; if (i & mask) total = total.add(list[i]); } return [before, total]; }, count => { let a = new Decimal("0.5"), b = new Decimal("0.5"); for (let i = 0; i < count; i++) { const sum = a.add(b); a = b; b = sum; } return [a, b]; }, (list, mask) => { let a = new Decimal(1), b = a; for (let i = 0; i < list.length; i++) { if (i & mask) { a = a.add(list[i]); b = b.subtract(list[i]); } } return [a, b]; }, (list, mask) => { const first = new Decimal(1); let total = first; for (let i = 0; i < list.length; i++) { if (i & mask) total = total.add(list[i]); } return [first, total]; }, (list, call) => { let total = new Decimal(0), text = ""; for (const x of list) { const next = total.add(x); call(); text += total.toString() + " "; total = next; } return text; }, (list, call) => { let total = new Decimal(0), other = new Decimal(0); for (const x of list) { const next = total.add(x); if (call()) other = other.add(total); total = next; } return other; });
