# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g, h, k, l, m) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); show(() => names(f(amounts, 1))); show(() => names(f(amounts, 2))); show(() => names(g(5))); show(() => names(g(0))); show(() => names(h(amounts, 1))); show(() => names(h(amounts, 0))); show(() => names(k(amounts, 1))); show(() => names(k(amounts, 0))); show(() => l(amounts, () => { }).trim()); show(() => m(amounts, () => true)); };
