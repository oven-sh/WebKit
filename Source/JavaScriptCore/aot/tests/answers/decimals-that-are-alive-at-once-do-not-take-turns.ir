# The value before is still needed when the next one is made.
# sink((list, mask) => { let total = 1m, before = 2m; for (let i = 0; i < list.length; i++) { before = total; if (i & mask) total = total.add(list[i]); } return [before, total]; }, count => { let a = 0.5m, b = 0.5m; for (let i = 0; i < count; i++) { const sum = a.add(b); a = b; b = sum; } return [a, b]; }, (list, mask) => { let a = 1m, b = a; for (let i = 0; i < list.length; i++) { if (i & mask) { a = a.add(list[i]); b = b.subtract(list[i]); } } return [a, b]; }, (list, mask) => { const first = 1m; let total = first; for (let i = 0; i < list.length; i++) { if (i & mask) total = total.add(list[i]); } return [first, total]; }, (list, call) => { let total = 0m, text = ""; for (const x of list) { const next = total.add(x); call(); text += total.toString() + " "; total = next; } return text; }, (list, call) => { let total = 0m, other = 0m; for (const x of list) { const next = total.add(x); if (call()) other = other.add(total); total = next; } return other; });
