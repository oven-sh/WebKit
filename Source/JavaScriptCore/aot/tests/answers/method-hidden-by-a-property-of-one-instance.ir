# A store on one instance under the name of a method hides the method for that instance alone, so the call through the shared site may enter either function.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Counter { constructor(start) { this.count = start } step(by) { return this.count + by } } function stepOf(counter, by) { return counter.step(by) } const first = new Counter(10); const second = new Counter(20); report(stepOf(first, 1)); report(stepOf(second, 1)); second.step = function (by) { return this.count * by }; report(stepOf(first, 3)); report(stepOf(second, 3)); report(first.step(4)); report(second.step(4)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 7 of 7 of 7
# CHECK-NEXT: exited with 0

