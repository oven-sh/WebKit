# A loop, a pattern, a spread and a yield* step a generator without calling next and without an object for each step: what is yielded, sent and returned, early exits, bodies that throw, generators that have ended or are running.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function* count(limit) { for (let number = 0;number < limit; number++) yield number; return "returned"; } function sum(iterable) { let total = 0; for (const number of iterable) total += number; return total; } for (let turn = 0;turn < 3; turn++) report(sum(count(5 + turn))); report(sum([1, 2, 3])); report(sum(new Set([4, 5]))); const ended = count(2); report(sum(ended)); report(sum(ended)); const begun = count(4); begun.next(); report(sum(begun)); let running; function* stepsItself() { yield 1; try { for (const value of running) report("never " + value); } catch (error) { report(error.name); } yield 2; } running = stepsItself(); for (const value of running) report(value); function* guarded(log) { try { yield "first"; yield "second"; } finally { log.push("cleaned up"); } } function takeOne(iterable, log) { for (const value of iterable) { log.push(value); break; } log.push("behind the loop"); return log.join(", "); } report(takeOne(guarded([]), [])); { const log = []; report(takeOne(guarded(log), log)); } function throwInLoop(iterable, log) { try { for (const value of iterable) { log.push(value); throw new RangeError("out of the loop"); } } catch (error) { log.push(error.message); } return log.join(", "); } { const log = []; report(throwInLoop(guarded(log), log)); } function* failing() { yield 1; throw new TypeError("thrown by the body"); } function collect(iterable) { const seen = []; try { for (const value of iterable) seen.push(value); } catch (error) { seen.push(error.name + ": " + error.message); } return seen.join(", "); } const failed = failing(); report(collect(failed)); report(collect(failed)); function* odd() { yield undefined; yield null; yield -0; yield NaN; yield { done: true, value: "looks like a result" }; yield [1, 2]; yield Promise; } for (const value of odd()) report(typeof value === "object" && value ? JSON.stringify(value) : typeof value === "function" ? value.name : value); function* echoes() { const first = yield "ask"; report("sent " + first); const second = yield "ask again"; report("sent " + second); } for (const value of echoes()) report(value); function* inner() { const sent = yield "inner 1"; report("inner got " + sent); yield "inner 2"; return "what inner returns"; } function* outer() { yield "outer 1"; const returned = yield* inner(); report(returned); yield* [10, 20]; yield* "ab"; yield "outer 2"; } report(collect(outer())); const stepped = outer(); report(JSON.stringify(stepped.next("a"))); report(JSON.stringify(stepped.next("b"))); report(JSON.stringify(stepped.next("c"))); report(JSON.stringify(stepped.return("left"))); report(JSON.stringify(stepped.next("d"))); function* delegatesWithCleanup(log) { try { yield* guarded(log); } finally { log.push("outer cleaned up"); } } { const log = []; report(takeOne(delegatesWithCleanup(log), log)); } { const log = []; const generator = delegatesWithCleanup(log); generator.next(); try { generator.throw(new Error("thrown in")); } catch (error) { log.push(error.message); } report(log.join(", ")); } const [one, two, ...rest] = count(5); report(one + " " + two + " " + rest); const [only] = guarded([]); report(only); report([...count(3), ...count(2)].join()); report(Math.max(...count(4))); report(Array.from(count(3)).join()); report(new Set(count(3)).size); report(Object.fromEntries(function* () { yield ["a", 1]; yield ["b", 2]; }()).b); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
