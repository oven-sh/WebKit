# function Parent() { }  function Child() { }
# function own() { return 7; }
# function extend(child, parent) { print(parent.hasOwnProperty("x")); child.prototype = Object.create(parent.prototype); }
# for (const name in names) Parent[name] = names[name];  extend(Child, Parent);   where names is { hasOwnProperty: own }
# No body stores under hasOwnProperty on a function: the loop does, under a key that is worked out. The call in extend enters own, which has to be compiled, and Parent is the this of it.
# RUN: run-in-shell mechanisms=all
# CHECK: 7
# CHECK-NEXT: exited with 0

layout L0 kind=Instance name="Parent" module=m0 constructor=f1 flags=[IsConstructorFunction]
layout L1 kind=Instance name="Child" module=m0 base=L0 constructor=f2 flags=[IsConstructorFunction]
layout L2 module=m0 fields=[{key="hasOwnProperty" declared={type=anything} flags=[IsRequired]}] ownFieldCount=1
module m0 path="main.js" displayPath="main.js" body=f0
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f1
    v1 = Convert v0 declared={type=f1 flags=[IsFromCompiler]}
    v2 = NewClosure function=f2
    v3 = Convert v2 declared={type=f2 flags=[IsFromCompiler]}
    v4 = NewClosure function=f4
    v5 = NewClosure function=f3
    v6 = NewObject layout=L2
    PropDefine v6, v5 key="hasOwnProperty"
    v8 = FinishObject v6
    v9 = ForInOpen v8
    Jump -> next b1()
  b1():
    LoopHint
    v11 = ForInStep v9, v8
    v12 = ResultAt v11
    v13 = ResultAt v11 index=1
    Branch v12 -> taken b2(), notTaken b3()
  b2():
    v14 = Call v4, -, v3, v1 calleeName="extend"
    v15 = Undefined
    Return v15
  b3():
    v16 = ElemGet v8, v13
    ElemSet v1, v13, v16
    Jump -> next b1()
}
function f1 name="Parent" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L0 flags=[IsExpected]} results=[{type=anything}] constructedClass=L0 {
  b0(v0: L0):
    v1 = Undefined
    Return v1
}
function f2 name="Child" module=m0 flags=[HasThis, HasExplicitName] thisType={type=L1 flags=[IsExpected]} results=[{type=anything}] constructedClass=L1 {
  b0(v0: L1):
    v1 = Undefined
    Return v1
}
function f3 name="own" module=m0 flags=[HasThis, HasExplicitName] thisType={type=anything} results=[{type=anything}] {
  b0(v0: anything):
    v1 = Integer integer=7
    Return v1
}
function f4 name="extend" module=m0 flags=[HasExplicitName] thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v1 key="hasOwnProperty"
    v3 = String string="x"
    v4 = Call v2, v1, v3 calleeKey="hasOwnProperty"
    v5 = Builtin builtin=GlobalThis
    v6 = PropGet v5 key="print" [isFreeName]
    v7 = Call v6, -, v4
    v8 = Builtin builtin=Object
    v9 = Builtin builtin=ObjectCreate
    v10 = PropGet v1 key="prototype"
    v11 = Call v9, v8, v10 calleeName="Object.create"
    PropSet v0, v11 key="prototype"
    v13 = Undefined
    Return v13
}
