# A total that begins with a literal, or again, needs one object for all turns of its loop.
# sink(list => { let total = -0m; for (const x of list) total = total.add(x); return total; }, (list, again) => { let total = 1m; for (const x of list) { if (x === again) total = 2m; else total = total.add(0.5m); } return total; }, (list, mask) => { const first = 1m; let total = first; for (let i = 0; i < list.length; i++) { if (i & mask) total = total.add(list[i]); } return [first, total]; }, (list, mask) => { let count = 0; for (let i = 0; i < list.length; i++) { const limit = i & mask ? 1m : 2m; if (limit.greaterThan(list[i])) count++; } return count; });
