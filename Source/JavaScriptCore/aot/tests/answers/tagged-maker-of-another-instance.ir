# interface Base { kind: number; pos: number; sum: number }
# interface Num extends Base { kind: 1; value: number }
# interface Str extends Base { kind: 2; text: string }
# function NodeMaker(this: Base, kind, pos) { this.kind = kind; this.pos = pos; this.sum = mark; }
# var mark = id(0);
# const Node = NodeMaker;
# function make(kind, pos) { return new Node(kind, pos); }
# function makeWith(maker, kind) { return new maker(kind, 7); }
# function isNode(n) { return n instanceof Node; }
# function sumOf(n) { return n.sum; }
# makeWith(Node, 1);
# register(Node, make, makeWith, isNode, sumOf);
# One heap holds two instances of the image: the shell makes a second global of the same VM, which has the module host too, and runs the entry module in both. `id` answers 1 in the first and 2 in the second.
# The build is told that the program runs in several realms, as for `bun test --isolate`, so the image lets a second global have an instance.
# Nobody knows the tag at either `new`, so each calls the entry of the constructor that makes `this`, without the stub that asks whose the closure is.
# In makeWith the maker is only expected. A closure of the same function of the other instance constructs in its own instance: its object has that instance's `mark` and is an instance of that instance's Node alone.
# At the end the shell runs the same text twice itself: every answer is the same.
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ Node: f[0], make: f[1], makeWith: f[2], isNode: f[3], sumOf: f[4] }); const twin = (id, register) => { function NodeMaker(kind, pos) { this.kind = kind; this.pos = pos; this.sum = mark; } var mark = id(0); const Node = NodeMaker; function make(kind, pos) { return new Node(kind, pos); } function makeWith(maker, kind) { return new maker(kind, 7); } function isNode(n) { return n instanceof Node; } function sumOf(n) { return n.sum; } makeWith(Node, 1); register(Node, make, makeWith, isNode, sumOf); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; const sides = [[a, b], [b, a]]; const kinds = [1, 2, 9, "x"]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const told = n => n.kind + "," + n.pos + "," + n.sum + "," + x.isNode(n) + "," + y.isNode(n) + "," + x.sumOf(n) + "," + y.sumOf(n); for (let k = 0; k < kinds.length; k++) { say("own maker", () => told(x.makeWith(x.Node, kinds[k]))); say("their maker", () => told(x.makeWith(y.Node, kinds[k]))); say("made here", () => told(x.make(kinds[k], 3))); say("made there", () => told(y.make(kinds[k], 3))); } say("in turn", () => { let text = ""; for (let i = 0; i < 400; i++) { const n = x.makeWith(i & 1 ? y.Node : x.Node, i % 3); text += n.sum; if (x.isNode(n)) text += "!"; } return text; }); say("same maker", () => x.Node === y.Node); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
