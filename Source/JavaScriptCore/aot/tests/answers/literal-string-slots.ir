# const first = { kind: "num", value: 3 }; const second = { kind: "neg", value: 4 }; const third = { kind: "add", left: 1 };
# function describe(node) { if (node.kind === "num") return "a number"; if (node.kind === "neg") return "a negation"; return "neither"; }
# function show(node) { report(node.kind); report(node.kind + "!"); report(node.kind.length); }
# function kindOf(any) { return any.kind; }
# function retag(node, text) { if (text === "num" || text === "neg") node.kind = text; }
# report(describe(first)); report(describe(second)); show(first); show(second); report(kindOf(first)); report(kindOf(other)); report(JSON.stringify(third)); report(describe(third));
# const made = { kind: "neg", value: 5 }; retag(made, glued); report(describe(made));
# Written strings are all that reaches `kind`. Whoever wants the string gets it: the hook, a sum, a length, a read by name beside an object of the shell, native code.
# `glued` is a string that the shell has put together, so it is no cell of the program's texts. Stored behind the two comparisons, it equals "num" like any other.
# RUN: run-in-shell globalThis.report = value => print(typeof value + " " + value); globalThis.other = { kind: "else" }; globalThis.glued = ["nu", "m"].join("");
# CHECK: string a number
# CHECK-NEXT: string a negation
# CHECK-NEXT: string num
# CHECK-NEXT: string num!
# CHECK-NEXT: number 3
# CHECK-NEXT: string neg
# CHECK-NEXT: string neg!
# CHECK-NEXT: number 3
# CHECK-NEXT: string num
# CHECK-NEXT: string else
# CHECK-NEXT: string {"kind":"add","left":1}
# CHECK-NEXT: string neither
# CHECK-NEXT: string a number
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
