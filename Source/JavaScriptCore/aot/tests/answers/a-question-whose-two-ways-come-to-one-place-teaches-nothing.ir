# A QUESTION WHOSE TWO WAYS COME TO ONE PLACE TEACHES NOTHING.
# The yes of `$isPlainInstanceOf(object, Gauge)` teaches the walk on the taken edge: every field lies in its slot, the object bears no mark and stands below its prototype: a read of a field behind it is one load.
# `if ($isPlainInstanceOf(object, Gauge)) { }`: both ways of the branch come to one place with the same values, so the walk builds no branch: it goes on along the taken way by a jump, and the question is swept as dead.
# Nothing was tested there. What a yes teaches is learned only where the branch that the walk has BUILT decides the test, or where its outcome is known on the way.
# It was learned by the number of the target in the input: the load read an empty slot, and the shell crashed with SIGSEGV in each of the three runs that change the object.
# function Gauge(level) { this.level = level; this.mark = "m"; }
# Gauge.prototype.read = function () { return "read"; };
# function idle(object) { if (!$isPlainInstanceOf(object, Gauge)) return "-"; amid(object); if ($isPlainInstanceOf(object, Gauge)) { } return "level " + object.level; }
# function heir(object) { if (!$isPlainHeirOf(object, Gauge)) return "-"; amid(object); if ($isPlainHeirOf(object, Gauge)) { } return "level " + object.level; }
# function unused(object) { if (!$isPlainInstanceOf(object, Gauge)) return "-"; amid(object); if ($isPlainInstanceOf(object, Gauge)) { const mark = "m"; } else { } return "level " + object.level; }
# function busy(object) { if (!$isPlainInstanceOf(object, Gauge)) return "-"; amid(object); let word = "no "; if ($isPlainInstanceOf(object, Gauge)) word = "yes "; return word + object.level; }
# function real(object) { if (!$isPlainInstanceOf(object, Gauge)) return "-"; amid(object); if ($isPlainInstanceOf(object, Gauge)) return "yes " + object.level; return "no " + object.level; }
# print(idle(new Gauge(1)));
# print(heir(new Gauge(2)));
# print(unused(new Gauge(3)));
# print(busy(new Gauge(4)));
# print(real(new Gauge(5)));
# The functions that ask lie in a file of the library. f2 = idle, f3 = heir, f4 = unused, f6 = real
# OPTIONS: mechanisms=all
# RUN(IDLE): walk f2
# IDLE: calleeName="amid"
# IDLE-NOT: level=Proven
# IDLE: = GetSlot {{*}}key="level" receivers=[L0] level=Expected
# RUN(HEIR): walk f3
# HEIR: calleeName="amid"
# HEIR-NOT: level=Proven
# HEIR: = GetSlot {{*}}key="level" receivers=[L0] level=Expected
# RUN(UNUSED): walk f4
# UNUSED: calleeName="amid"
# UNUSED-NOT: level=Proven
# UNUSED: = GetSlot {{*}}key="level" receivers=[L0] level=Expected
# A branch that is built teaches as ever.
# RUN(REAL): walk f6
# REAL: calleeName="amid"
# REAL: = IsPlainInstanceOf
# REAL: = GetSlot {{*}}key="level" receivers=[L0] level=Proven
# RUN(NOTHING): run-in-shell amid = function () { };
# NOTHING: level 1
# NOTHING-NEXT: level 2
# NOTHING-NEXT: level 3
# NOTHING-NEXT: yes 4
# NOTHING-NEXT: yes 5
# NOTHING-NEXT: exited with 0
# The field leaves its slot between the two questions: the slot is empty.
# RUN(ACCESSOR): run-in-shell amid = function (made) { Object.defineProperty(made, "level", { get() { return 70; }, configurable: true }); };
# ACCESSOR: level 70
# ACCESSOR-NEXT: level 70
# ACCESSOR-NEXT: level 70
# ACCESSOR-NEXT: no 70
# ACCESSOR-NEXT: no 70
# ACCESSOR-NEXT: exited with 0
# RUN(DELETED): run-in-shell amid = function (made) { delete made.level; };
# DELETED: level undefined
# DELETED-NEXT: level undefined
# DELETED-NEXT: level undefined
# DELETED-NEXT: no undefined
# DELETED-NEXT: no undefined
# DELETED-NEXT: exited with 0
# RUN(RELINKED): run-in-shell amid = function (made) { delete made.level; Object.setPrototypeOf(made, { level: "other" }); };
# RELINKED: level other
# RELINKED-NEXT: level other
# RELINKED-NEXT: level other
# RELINKED-NEXT: no other
# RELINKED-NEXT: no other
# RELINKED-NEXT: exited with 0

