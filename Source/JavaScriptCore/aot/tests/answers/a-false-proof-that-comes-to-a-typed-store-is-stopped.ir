# function fill(value: any): void { kept = id(value); }
# function load(carrier: Carrier, value: any): void { carrier.load = id(value); }
# function throughAResult(holder: Holder, value: any): void { holder.held = get(value); }
# function throughAVariable(holder: Holder, value: any): void { fill(value); holder.held = kept; }
# function throughASlot(holder: Holder, carrier: Carrier, value: any): void { load(carrier, value); holder.held = carrier.load; }
# const holders = [new Holder(new Leaf()), new Holder(undefined)];
# const holder = holders[which > 0 ? 0 : 1]!;
# print(read(holder));
# if (which === 1) throughAResult(holder, new Other());
# if (which === 2) throughAVariable(holder, new Other());
