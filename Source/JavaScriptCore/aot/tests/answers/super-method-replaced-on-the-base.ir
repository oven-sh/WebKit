# class Base { name() { return "base" } static kind() { return "static base" } }
# class Derived extends Base { name() { return "derived of " + super.name() } static kind() { return "derived of " + super.kind() } }
# const derived = new Derived();
# report(derived.name());
# report(Derived.kind());
# Base.prototype.name = function () { return "replaced" };
# Base.kind = function () { return "static replaced" };
# report(derived.name());
# report(Derived.kind());
# report("end");
# `super.name()` and a static `super.kind()` find what lies on the class above when the call runs.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Base { name() { return "base" } static kind() { return "static base" } } class Derived extends Base { name() { return "derived of " + super.name() } static kind() { return "derived of " + super.kind() } } const derived = new Derived(); report(derived.name()); report(Derived.kind()); Base.prototype.name = function () { return "replaced" }; Base.kind = function () { return "static replaced" }; report(derived.name()); report(Derived.kind()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

