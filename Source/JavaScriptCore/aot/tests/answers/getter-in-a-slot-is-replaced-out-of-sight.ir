# made of 46afbf18122b5230
# a literal (row K8) lays a getter in the place of a field, and through a name that the compiler cannot follow the property gets another getter, becomes a value, loses its getter, and goes: each read answers as the language does
# one literal alone makes such objects (beside a second one with another getter the walk builds the read as written), and no stranger arrives at `read` in plain sight: where one does, the walk builds the read as written
# f2 = read
# RUN(FORM): walk f2 mechanisms=all
# FORM-LABEL: code f2:Body
# FORM: = GetSlotGetter
# type Cart = { count: number; readonly total: number };
# function make(count: number): Cart { return { count, get total() { return this.count * 2; } }; }
# function read(cart: Cart) { return cart.total; }
# function deed(how: number): Cart { (globalThis as any).held = make(3); const o = (globalThis as any).held; if (how === 0) Object.defineProperty(o, "total", { get: () => "other" }); if (how === 1) Object.defineProperty(o, "total", { value: "plain", writable: true }); if (how === 2) Object.defineProperty(o, "total", { get: undefined, set() {} }); if (how === 3) delete o.total; if (how === 4) { delete o.total; o.total = "again"; } return o; }
# report(read(make(1)));
# report(read(make(2)));
# for (let how = 0; how < 6; how++) report(how + " " + String(read(deed(how))));
# let last = "";
# for (let i = 0; i < 300; i++) last = String(read(i % 2 ? make(i) : deed(i % 6)));
# report(last);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function make(count) { return { count, get total() { return this.count * 2; } }; } function read(cart) { return cart.total; } function deed(how) { globalThis.held = make(3); const o = globalThis.held; if (how === 0) Object.defineProperty(o, "total", { get: () => "other" }); if (how === 1) Object.defineProperty(o, "total", { value: "plain", writable: true }); if (how === 2) Object.defineProperty(o, "total", { get: undefined, set() {} }); if (how === 3) delete o.total; if (how === 4) { delete o.total; o.total = "again"; } return o; } report(read(make(1))); report(read(make(2))); for (let how = 0;how < 6; how++) report(how + " " + String(read(deed(how)))); let last = ""; for (let i = 0;i < 300; i++) last = String(read(i % 2 ? make(i) : deed(i % 6))); report(last); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 10 of 10 of 10
# CHECK-NEXT: exited with 0

