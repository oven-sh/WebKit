# L0 = Dial . L1 = Meter . L2 = Gauge . f1 = row . f2 = apart . f3 = between . f4 = keeps . f5 = user . f6 = again . f7 = caught . f8 = valued . f11 = bare . f12 = turns . f13 = relinked . f14 = alias . f15 = awaited . f16 = pair . f17 = mixed . f18 = dial . f19 = others
# OPTIONS: mechanisms=all
# RUN(ROW): walk f1
# ROW: = FindsDeclaredMember {{*}}key="read" conditions=[{layout=L1 key="read"}, {layout=L1 key="step"}, {layout=L1 key="name"}, {layout=L1 key="unit"}] receivers=[L1]
# ROW-NOT: = AreMembersUnchanged
# ROW-NOT: = FindsDeclaredMember
# ROW: Return
# RUN(APART): walk f2
# APART: = FindsDeclaredMember {{*}}key="read" conditions=[{layout=L1 key="read"}] receivers=[L1]
# APART: = AreMembersUnchanged conditions=[{layout=L1 key="name"}]
# RUN(BETWEEN): walk f3
# BETWEEN: = FindsDeclaredMember {{*}}key="read" conditions=[{layout=L1 key="read"}] receivers=[L1]
# BETWEEN: calleeName="note"
# BETWEEN: = FindsDeclaredMember {{*}}key="name" conditions=[{layout=L1 key="name"}] receivers=[L1]
# The row of a callee that is copied in line.
# RUN(USER): walk f5
# USER: = FindsDeclaredMember {{*}}key="read" conditions=[{layout=L1 key="read"}, {layout=L1 key="step"}, {layout=L1 key="name"}] receivers=[L1]
# USER-NOT: = AreMembersUnchanged
# USER-NOT: = FindsDeclaredMember
