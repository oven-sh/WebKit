# A ROW OF QUESTIONS ABOUT DECLARED MEMBERS OF ONE OBJECT IS ONE TEST.
# `$findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step") && ..`: the cell was asked once, but each name tested the byte of its own guard. The first question of a row now lists the guards of the whole row,
# and the names of one class are asked by one byte; behind its yes the state knows each guard to hold, and the questions behind it are yes without a record.
# A ROW GOES ON ONLY WHILE A NO OF THE NEXT QUESTION IS WHAT A NO OF THE FIRST ONE IS: the next block is entered by the yes alone, nothing in it is seen but the question, the object and the receivers are the same,
# and both noes come to one place. `apart` has two places for its noes, `between` a call between its questions, `mixed` a name that the heir lays anew: none of them is a row.
# WHAT IS KNOWN BEHIND THE YES ENDS AS IT DID: a relink, a call, an await bring the question back.
# function Meter(level) { this.level = level; }
# Meter.prototype.read = function () { return "read"; };
# Meter.prototype.step = function () { return "step"; };
# Meter.prototype.name = function () { return "name"; };
# Meter.prototype.unit = function () { return "unit"; };
# function Gauge(level) { this.level = level; }
# Object.setPrototypeOf(Gauge.prototype, Meter.prototype);
# Gauge.prototype.step = heirs();
# class Dial { constructor(level) { this.level = level; } libraryRead() { return "read"; } libraryName() { return "name"; } }
# early(Meter);
# function row(object) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step") && $findsDeclaredMember(object, "name") && $findsDeclaredMember(object, "unit")) return "all " + object.name(); return "- " + object.name(); }
# function bare(object) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step")) return "all"; return "-"; }
# function apart(object) { if (!$findsDeclaredMember(object, "read")) return "no read"; if (!$findsDeclaredMember(object, "name")) return "no name " + object.name(); return "both " + object.name(); }
# function between(object) { if ($findsDeclaredMember(object, "read")) { note(); if ($findsDeclaredMember(object, "name")) return "both " + object.name(); } return "- " + object.name(); }
# function keeps(object) { if (!($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step") && $findsDeclaredMember(object, "name"))) return false; return true; }
# function user(object) { if (keeps(object)) return "kept " + object.name(); return "slow " + object.name(); }
# function again(object) { if (!($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name"))) return "- " + object.name(); if ($findsDeclaredMember(object, "name")) return "again " + object.name(); return "lost " + object.name(); }
# function caught(object) { try { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name")) return "both " + object.name(); fail(); } catch { return "caught " + object.name(); } return "no throw"; }
# function valued(object) { const finds = $findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name"); return finds ? "valued " + object.name() : "- " + object.name(); }
# function turns(object, count) { let text = ""; for (let turn = 0; turn < count; turn++) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name")) text += "y"; else text += "n"; if (turn === 1) amid(object); } return text; }
# function relinked(object, link) { if (!($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name"))) return "-"; Object.setPrototypeOf(object, link); if ($findsDeclaredMember(object, "name")) return "both " + object.name(); return "first " + object.name(); }
# function alias(object, same, link) { if (!($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name"))) return "-"; Object.setPrototypeOf(same, link); if ($findsDeclaredMember(object, "name")) return "both " + object.name(); return "first " + object.name(); }
# async function awaited(object) { if (!($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name"))) return "-"; await undefined; if ($findsDeclaredMember(object, "name")) return "both " + object.name(); return "first " + object.name(); }
# function pair(object) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "name")) return "pair " + object.name(); return "- " + object.name(); }
