# report("end");
# Typed records that hold themselves, straight or through a member of any type, are written as JSON. The writer throws at the ring, and a getter on the way there has run as often as it is reached: once.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = report => { const log = []; const straight = { size: 0, below: [] }; const crate = { before: null, held: straight, after: null, self: null }; crate.before = { get g() { log.push("getter"); return 1; } }; crate.after = { deep: { deeper: crate } }; crate.self = crate; function written(value) { log.length = 0; try { return JSON.stringify(value) + " " + log.join(); } catch (error) { return error.name + " " + log.join(); } } report(written([crate, crate, crate])); report(written(crate)); report(written({ crate })); const through = { before: null, held: straight, after: null, self: null }; through.before = { get g() { log.push("first"); return 1; } }; through.after = { get h() { log.push("second"); return through; } }; report(written(through)); report(written([straight, through])); const open = { before: null, held: straight, after: null, self: null }; open.before = { get g() { log.push("once"); return 1; } }; open.after = { deep: { deeper: straight } }; report(written(open)); report(written([open, open])); straight.below.push({ size: 1, below: [] }); report(written(open)); report(written(straight)); straight.below[0].below.push(straight); report(written(straight)); report(written(open)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); }); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }; })();
