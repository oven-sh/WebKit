# What code that the build has not seen does to an object of the program leaves its mark where compiled code looks: the slot, the order word, the Structure, the guards of the class. Nothing stops, and every answer is that of the language.
# The shell's own text is that code: the program hands it its functions. aotPlaceOfProperty() and aotMarksOfObject() say what the cell says.
# RUN: run-in-shell --aotCountsPath=/dev/null const counted = () => { const lines = aotRuntimeCounters().split("\n"), kept = []; for (let i = 0; i < lines.length; i++) { const line = lines[i]; if (!line.startsWith("0") && (line.includes("FieldsEvicted") || line.includes("ObjectsGiven") || line.includes("ObjectPrototypesChanged"))) kept[kept.length] = line.split("\t").join(" "); } return kept.join(", "); }; globalThis.register = (make, read, between, inLoop, belowCalls, copyLabel, storeAgain) => { const h = make(); print(JSON.stringify(aotMarksOfObject(h)), aotPlaceOfProperty(h, "label"), aotPlaceOfProperty(h, "other"), aotPlaceOfProperty({ }, "label"), read(h)); print("counted: " + counted()); };
