# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function joined() { return `${"abc".indexOf("c")}-${"p" + "x"}`; } function joinedWithOthers() { return `${"abc".at(5)}|${null}|${"abc".includes("b")}|${-0}|${1.5}|${"abc".slice(3)}`; } function character() { return "abc"[1]; } function behindTheEnd() { return "abc"[3]; } function place() { return "a,b".indexOf(","); } function lastPlace() { return "a,b,c".lastIndexOf(",", 2); } function code() { return 98 + ":" + "abc".charCodeAt(9) + ":" + "abc".codePointAt(9); } function pieces() { return "GET /x".slice(0, 3) + "|" + "GET /x".substring(9, 4) + "|" + "GET /x".substr(-2, 1) + "|" + " x ".trim() + "|" + "abc".at(-1) + "|" + "abc".at(5); } function ends() { return "file.ts".endsWith(".ts") + ":" + "file.ts".startsWith("ile", 1) + ":" + "file.ts".includes("x"); } function padded() { return "ab".padStart(1) + "|" + "ab".padEnd(4, "") + "|" + "ab".repeat(1) + "|" + "ab".repeat(0) + "|" + "ab".padStart(4) + "|" + "ab".repeat(2); } function cases() { return "abc".toUpperCase() + "ABC".toLowerCase() + "abc".toLowerCase(); } function refusedRepeat() { return "ab".repeat(-1); } function row(a) { return a + "x" + 1 + "" + "y"; } function rowOfOne(a) { return a + ""; } function asked(s) { if (s.startsWith("--")) return "in:" + s.startsWith("--"); return "out:" + s.startsWith("--"); } function named(kind) { if (kind === 2) { switch (kind) { case 1: return "one"; case 2: return "two"; } } return "other"; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(joined); tell(joinedWithOthers); tell(character); tell(behindTheEnd); tell(place); tell(lastPlace); tell(code); tell(pieces); tell(ends); tell(padded); tell(cases); tell(refusedRepeat); tell(() => row("a")); tell(() => row("")); tell(() => row(5)); tell(() => rowOfOne("a")); tell(() => rowOfOne(5)); tell(() => rowOfOne(null)); tell(() => asked("--x")); tell(() => asked("-x")); tell(() => asked("")); tell(() => named(2)); tell(() => named(1)); tell(() => named("2")); tell(joined); tell(pieces); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
