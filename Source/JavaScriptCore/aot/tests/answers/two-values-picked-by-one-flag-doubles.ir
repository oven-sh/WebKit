# made of d4aa680218b291b2
# An object and a number are picked by one flag, and fields of both objects were read in front of the picks. What is read or written through the picked object is that object's, on either arm.
# Here the numbers are doubles; the calls are written out.
# class Point { constructor(x, y, next) { this.x = x; this.y = y; this.next = next; } }
# function pick(a, b, key, exact) { if (!a.y || !b.y || !a.next || !b.next) return "none"; const flag = exact ? key === a.x : key < b.x; const side = flag ? a : b; const y = flag ? a.y : b.y; if (y && side.next) return side.next.y + side.y + y; return "leaf"; }
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 1, false));
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 1, true));
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 3, false));
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 3, true));
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 9, false));
# report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 9, true));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Point { constructor(x, y, next) { this.x = x; this.y = y; this.next = next; } } function pick(a, b, key, exact) { if (!a.y || !b.y || !a.next || !b.next) return "none"; const flag = exact ? key === a.x : key < b.x; const side = flag ? a : b; const y = flag ? a.y : b.y; if (y && side.next) return side.next.y + side.y + y; return "leaf"; } report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 1, false)); report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 1, true)); report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 3, false)); report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 3, true)); report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 9, false)); report(pick(new Point(1, 2.5, new Point(0, 10.25, null)), new Point(5, 3.5, new Point(0, 50.75, null)), 9, true)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
