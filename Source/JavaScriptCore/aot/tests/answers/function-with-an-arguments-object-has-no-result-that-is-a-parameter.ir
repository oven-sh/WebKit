# made of e1c9108420b36423
# a body that has an arguments object may store into a parameter where no operation shows it (a sloppy one does), so the scan lists none of its results as a parameter, though the only edge to the result comes from one
# f1 = kept
# OPTIONS: testing=CheckProofsAtRunTime
# RUN(FORM): summary f1
# FORM: summary f1 {{*}}UsesArguments
# FORM: edge Parameter {{*}} -> Result 0
# RUN(NEVER): summary f1
# NEVER-NOT: result 0 is
# function kept(x: any) { arguments[0] = "stored"; return x; }
# function number() { return typeof kept(1); }
# function text() { return typeof kept("a"); }
# report(number());
# report(text());
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function kept(x) { arguments[0] = "stored"; return x; } function number() { return typeof kept(1); } function text() { return typeof kept("a"); } report(number()); report(text()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

