# THE SCREEN OF `$isPlainInstanceOf` AND `$isPlainHeirOf`, THREE MORE SHAPES.
# const name: string = ["ma", "rk"].join("");
# class Base { get mark(): string { .. } set mark(value: string) { } }
# class Gauge extends Base { level = 1; }                                                        an accessor above under a name that is no field of Gauge: plain
# class Keyed { mark = "m"; get [name](): string { .. } set [name](value: string) { } }          a member under a computed key: it may bear the name of a field: no stamp
# class Stem { level = 1; mark = "m"; }
# class Quiet extends Stem { more = 2; }                                                         an heir that declares nothing under a field's name: taken
# class Loud extends Stem { get mark(): string { .. } set mark(value: string) { } }              an heir that declares an accessor under the name of a field of Stem: dropped from the receivers
# print(askGauge(new Gauge()), askKeyed(new Keyed()), askStem(new Stem()), askStem(new Quiet()), askStem(new Loud()));
# f4 = askStem
# OPTIONS: mechanisms=all
# RUN(FORM): walk f4
# FORM: = IsPlainInstanceOf {{*}}receivers=[L3, L4]
# RUN: run-in-shell
# CHECK: plain - heir heir -
# CHECK-NEXT: exited with 0

