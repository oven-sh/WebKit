# A list, a map or a set finds the methods of its class only while it is as its class makes it. An own property, a definition by a descriptor, another prototype, none at all and a class below each hide them, on an object that comes from elsewhere and on one that was made here.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(way) { try { return way(); } catch (error) { return error.name; } } function pushTo(list, value) { return list.push(value); } function popOf(list) { return list.pop(); } function pushMany(list, count) { let last = 0; for (let i = 0;i < count; i++) last = list.push(i); return last; } function whereIs(list, value) { return list.indexOf(value); } function joined(list) { return list.join("+"); } function getFrom(map, key) { return map.get(key); } function hasIn(set, value) { return set.has(value); } function sizeOf(map) { return map.size; } const ordinary = [1]; const own = [1]; own.push = function(value) { return "own:" + value; }; own.indexOf = () => "own index"; class Stack extends Array { push(value) { return "below:" + super.push(value); } } const otherPrototype = [1]; Object.setPrototypeOf(otherPrototype, { push() { return "other prototype"; }, pop() { return "other pop"; }, indexOf() { return "other index"; }, join() { return "other join"; } }); const noPrototype = [1]; Object.setPrototypeOf(noPrototype, null); const defined = [1]; Object.defineProperty(defined, "push", { get() { return () => "from a getter"; } }); const frozen = Object.freeze([1]); const lists = [ordinary, own, new Stack, otherPrototype, noPrototype, defined, frozen, { push() { return "no list"; }, pop() { return "no pop"; }, indexOf() { return "no index"; }, join() { return "no join"; } }]; for (let l = 0;l < lists.length; l++) { report(attempt(() => pushTo(lists[l], 2))); report(attempt(() => pushMany(lists[l], 3))); report(attempt(() => whereIs(lists[l], 1))); report(attempt(() => joined(lists[l]))); report(attempt(() => popOf(lists[l]))); } function freshWithOwn() { const list = []; list.push = () => "own on a new list"; return list.push(1); } function freshWithOtherPrototype() { const list = [1]; Object.setPrototypeOf(list, { push() { return "other above a new list"; } }); return list.push(1); } function freshWithDefinition() { const list = []; Object.defineProperty(list, "push", { value: () => "defined on a new list" }); return list.push(1); } function freshUnderComputedKey(key) { const list = []; list[key] = () => "under a key"; return list.push(1); } function freshAssigned() { const list = []; Object.assign(list, { push() { return "assigned"; } }); return list.push(1); } function freshInLoop(count) { const list = []; let last; for (let i = 0;i < count; i++) { last = list.push(i); if (i === 1) list.push = () => "own from the second turn on"; } return last; } function freshOrdinary() { const list = []; list.push(4); list.push(5); return list.length + list.join(); } report(freshWithOwn()); report(freshWithOtherPrototype()); report(freshWithDefinition()); report(freshUnderComputedKey("push")); report(freshUnderComputedKey("other")); report(freshAssigned()); report(freshInLoop(2)); report(freshInLoop(4)); report(freshOrdinary()); const map = new Map([["a", 1]]); const mapWithOwn = new Map([["a", 1]]); mapWithOwn.get = () => "own get"; class Table extends Map { get(key) { return "below:" + super.get(key); } get size() { return "many"; } } const mapBelowOther = new Map([["a", 1]]); Object.setPrototypeOf(mapBelowOther, { get() { return "other get"; }, size: "other size" }); const maps = [map, mapWithOwn, new Table([["a", 1]]), mapBelowOther, { get() { return "no map"; }, size: -1 }]; for (let m = 0;m < maps.length; m++) { report(getFrom(maps[m], "a")); report(getFrom(maps[m], "b")); report(sizeOf(maps[m])); } const set = new Set([1]); const setWithOwn = new Set([1]); setWithOwn.has = () => "own has"; report(hasIn(set, 1)); report(hasIn(set, 2)); report(hasIn(setWithOwn, 1)); report(attempt(() => Map.prototype.get.call(set, 1))); report(attempt(() => Array.prototype.push.call(undefined, 1))); report(Array.prototype.push.call({ length: 3 }, 1)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
