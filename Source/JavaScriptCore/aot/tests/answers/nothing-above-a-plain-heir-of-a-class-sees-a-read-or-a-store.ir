# THE WORD ON WHAT SEES A READ OR A STORE ABOVE, FOR CLASSES WRITTEN WITH `class` AND FOR `$isPlainHeirOf`: the accessors that the classes declare themselves, `scale` and `twice`, are rows of their records and pass;
# each class that the question takes has its own count: what ends the yes for the objects of a class ends it for those of the classes below it, and for no others.
# class Base { constructor() { this.low = 1; } reach() { return "reach"; } get scale() { return 10; } set scale(value) { } }
# class Meter extends Base { constructor(level) { super(); this.level = level; } read() { return this.level; } get twice() { return this.level * 2; } }
# function ask(object) { return $isPlainHeirOf(object, Base) ? "yes" : "no"; }            in a file of the library, expects a Meter or a Base
# keep(Meter); keep(Base);
# early(Meter, Base);
# const asks = keep(ask);
# print(asks(new Meter(1)), asks(new Base()));
# later(Meter, Base);
# print(asks(new Meter(3)), asks(new Base()));
