# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; async function load(x) { log += "a"; await null; log += "b"; return x; } async function fail(x) { log += "c"; await null; throw "failed " + x; } function cached(x) { log += "d"; return x; } async function run(hit, x) { const kept = "k" + x; const v = await (hit ? cached(x) : load(x)); log += "e"; return kept + v; } async function runThree(which, x) { const v = await (which === 0 ? cached(x) : which === 1 ? load(x) : fail(x)); log += "f"; return v; } async function runUnderTry(hit, x) { try { return await (hit ? cached(x) : fail(x)); } catch (e) { return "caught " + e; } finally { log += "g"; } } async function runInLoop(n) { let s = 0; for (let i = 0;i < n; i++) s += await (i % 2 ? cached(i) : load(i)); return s; } async function beside() { log += "1"; await null; log += "2"; await null; log += "3"; await null; log += "4"; } const thenable = { then(resolve) { log += "t"; resolve("T"); } }; async function tell(started) { const other = beside(); try { report(await started); } catch (e) { report("thrown " + e); } await other; report(log); log = ""; } async function runKeeps(hit, x) { const p = load(x); const v = await (hit ? cached(x) : p); return typeof p + " " + typeof v + " " + await p; } async function runBehindTry(x) { let p; try { p = fail(x); } catch (e) { p = "caught at the call"; } const v = await p; return v; } await tell(run(true, 1)); await tell(run(false, 2)); await tell(run(true, thenable)); await tell(run(false, thenable)); await tell(runThree(0, 3)); await tell(runThree(1, 4)); await tell(runThree(2, 5)); await tell(runUnderTry(true, 6)); await tell(runUnderTry(false, 7)); await tell(runInLoop(5)); await tell(runKeeps(true, 8)); await tell(runKeeps(false, 9)); await tell(runBehindTry(10)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
