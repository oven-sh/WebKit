# report(length(new Point(3, 4), 2)); report(named(new Point(1, 2), "p")); report(counted([new Point(1, 2), new Point(3, 4)], 1)); report(both(new Point(1, 2), new Point(3, 4)));
# for (const one of odd) { report(length(one, 2)); report(length(new Point(1, 1), one.x)); report(named(one, "q")); report(named(new Point(1, 2), one.y)); report(counted([new Point(1, 2), one], 1)); report(both(new Point(1, 2), one)); report(both(one, one)); }
# report(said);
# report("end");
# Functions with declared parameters are called with what was declared and with six objects that are something else: other key order, a text for a number, a missing field, fields on the prototype, a getter. What they had said and computed ahead of the failing test is said and computed once.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let said = ""; class Point { x; y; constructor(x, y) { this.x = x; this.y = y; } } function length(point, scale) { const x = point.x * scale; const y = point.y * scale; return x * x + y * y; } function named(point, name) { const text = name + ":"; return text + point.x + "," + point.y + "," + text.length; } function counted(points, from) { let sum = from; for (const point of points) sum += point.x; return sum; } function both(first, second) { const a = first.x; said += "a"; const b = second.x; return a + b; } const odd = [{ x: 1, y: 2 }, { y: 2, x: 1 }, { x: "1", y: 2 }, { x: 1 }, Object.create(new Point(5, 6)), { get x() { said += "x"; return 3; }, y: 4 }]; report(length(new Point(3, 4), 2)); report(named(new Point(1, 2), "p")); report(counted([new Point(1, 2), new Point(3, 4)], 1)); report(both(new Point(1, 2), new Point(3, 4))); for (const one of odd) { report(length(one, 2)); report(length(new Point(1, 1), one.x)); report(named(one, "q")); report(named(new Point(1, 2), one.y)); report(counted([new Point(1, 2), one], 1)); report(both(new Point(1, 2), one)); report(both(one, one)); } report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
