# A loop in straight code polls as a walked one does: by a load that faults, or by a comparison with a call behind it.
# function spins() { try { for (;;) { } } catch (error) { print(error); } }
# function sum(label, limit) { let total = 0; for (let i = 0; i < limit; i++) total += i; return label + total; }
# print("begins");
# if (globalThis.isEndless) spins();
# print(sum("sum ", 10));
# OPTIONS: testing=ForceStraightCompilation
# RUN(COUNT): compile StraightUnitsCompiled
# COUNT: statistic StraightUnitsCompiled 3
# RUN(ENDS): run-in-shell
# ENDS: begins
# ENDS-NEXT: sum 45
# ENDS-NEXT: exited with 0
# The loop of `spins` has nothing but its poll, so nothing else can stop it. No handler sees a termination.
# RUN(ENDLESS): run-in-shell --watchdog=300 globalThis.isEndless = true;
# ENDLESS: begins
# ENDLESS-NEXT: exited with 3
# With a request to stop that never goes away, a poll that calls does so in every turn, and the loop goes on with what it holds.
# REQUIRES(ALWAYS): calling-loop-polls
# RUN(ALWAYS): run-in-shell --forceTrapAwareStackChecks=true
# ALWAYS: begins
# ALWAYS-NEXT: sum 45
# ALWAYS-NEXT: exited with 0
# REQUIRES(CALLING): calling-loop-polls
# RUN(CALLING): bytes f1
# CALLING: polls=0
# CALLING: operationAOTPollSlow
# CALLING: handler Catch at {{*}} for site 1
# REQUIRES(FAULTING): faulting-loop-polls
# RUN(FAULTING): bytes f1
# FAULTING: polls=1
# FAULTING-NOT: operationAOTPollSlow
# FAULTING: handler Catch at {{*}} for site 1

