# const first = import("./pages.js"); await null; ..; const second = import("./layout.js")        pages.js: import "./layout.js"
# The later call has the shorter way: two, three and six jobs lie between the calls. It loads and runs what it names as any call does, and it does not settle ahead of the call for the graph.
# RUN: run-in-shell globalThis.report = name => print(name + " runs"); globalThis.register = (...closures) => { globalThis.registered = closures; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(async () => { const jobsBetween = [[2], [3], [6]]; const words = ["first", "second", "third"]; let next = 0; for (const jobs of jobsBetween) { const calls = []; for (let call = 0; call <= jobs.length; ++call) { const word = words[call]; const made = registered[next++](); made.then(() => print(word + " settled"), () => print(word + " failed")); calls.push(made); for (let job = 0; job < (jobs[call] ?? 0); ++job) await null; } await Promise.allSettled(calls); } }); return result; };
