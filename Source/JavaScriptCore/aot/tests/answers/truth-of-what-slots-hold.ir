# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Item { next; label; constructor(label, next) { this.label = label; this.next = next; } } function hasNext(item) { const size = item.label.length; if (item.next) return size + 1; return size; } function lacksNext(item) { const size = item.label.length; if (!item.next) return size + 1; return size; } function nextOrSelf(item) { const size = item.label.length; return (item.next ? "next" : "self") + size; } function bothNext(item, other) { const size = item.label.length; if (item.next && other.next) return size + 1; return size; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function tellAll(item) { tell(() => hasNext(item)); tell(() => lacksNext(item)); tell(() => nextOrSelf(item)); tell(() => bothNext(item, item)); } const hidden = JSON.parse('{"set":"set","define":"defineProperty","remove":"deleteProperty","above":"setPrototypeOf"}'); const last = new Item("a", undefined); tellAll(last); tellAll(new Item("bc", last)); const stored = [null, 0, -0, NaN, "", "x", 5, 0.5, true, false, 0n, 1n, Symbol.iterator, [], () => 0]; for (let i = 0;i < stored.length; i++) { const item = new Item("s" + i, last); Reflect[hidden.set](item, "next", stored[i]); tellAll(item); } const removed = new Item("removed", last); Reflect[hidden.remove](removed, "next"); tellAll(removed); const below = new Item("below", last); Reflect[hidden.remove](below, "next"); Reflect[hidden.above](below, { next: 1, label: "above" }); tellAll(below); let reads = 0; const watched = new Item("watched", undefined); Reflect[hidden.define](watched, "next", { get() { reads++; return reads & 1; }, configurable: true }); tellAll(watched); report(reads); const back = new Item("back", last); Reflect[hidden.set](back, "next", 7); Reflect[hidden.set](back, "next", last); tellAll(back); tell(()