# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# function tellAll(item: Item) { tell(() => hasNext(item)); tell(() => lacksNext(item)); tell(() => nextOrSelf(item)); tell(() => bothNext(item, item)); }
