# made of 6605ca2fb60f852f
# a callee calls push and pop on a list that its caller has made and nobody else has: the row that a list as its class makes it takes says what the call does, and the row for whatever is like a list is not asked
# f1 = add, f2 = take
# RUN(FORM): link functions mechanisms=all
# FORM: function f1 {{*}}returns=[
# FORM: function f2 {{*}}returns=[
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}mayCallUnknownCode
# NEVER-NOT: function f2 {{*}}mayCallUnknownCode
# function add(list: number[], x: number) { list.push(x); }
# function take(list: number[]) { return list.pop(); }
# function fill(box: { n: number }) { const list: number[] = []; const before = box.n; add(list, 4); add(list, 5); const last = take(list); return before * 100 + box.n * 10 + (last as number); }
# function inLoop(box: { n: number }) { const list: number[] = []; let s = 0; for (let i = 0; i < 3; i++) { add(list, i); s = s * 10 + box.n; } return s * 10 + (take(list) as number); }
# report(fill({ n: 1 }));
# report(inLoop({ n: 2 }));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function add(list, x) { list.push(x); } function take(list) { return list.pop(); } function fill(box) { const list = []; const before = box.n; add(list, 4); add(list, 5); const last = take(list); return before * 100 + box.n * 10 + last; } function inLoop(box) { const list = []; let s = 0; for (let i = 0;i < 3; i++) { add(list, i); s = s * 10 + box.n; } return s * 10 + take(list); } report(fill({ n: 1 })); report(inLoop({ n: 2 })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
