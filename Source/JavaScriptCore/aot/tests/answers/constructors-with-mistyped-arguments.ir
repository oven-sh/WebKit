# let said = "";
# class Point { x: number; y: number; constructor(x: number, y: number) { said += "p"; this.x = x; this.y = y; } sum(): number { return this.x + this.y; } }
# class Named extends Point { name: string; constructor(name: string, x: number) { said += "n"; super(x, x + 1); this.name = name; } text(): string { return this.name + this.sum(); } }
# class Counted { static made = 0; id: number = ++Counted.made; label: string; constructor(label: string) { this.label = label; } }
# function make(x: unknown, y: unknown): string { const made = new Point(x as number, y as number); return typeof made.x + ":" + made.sum(); }
# function makeNamed(name: unknown, x: unknown): string { const made = new Named(name as string, x as number); return made.text() + ":" + Object.keys(made).join(); }
# function makeCounted(label: unknown): string { const made = new Counted(label as string); return made.id + ":" + made.label; }
# class Other { other(): string { return "other"; } }
# const odd: unknown[] = [1, 2.5, "3", undefined, null, { valueOf() { said += "v"; return 4; } }, true];
# for (const one of odd) { report(make(one, 1)); report(make(1, one)); report(makeNamed(one, 1)); report(makeNamed("n", one)); report(makeCounted(one)); }
# const under = Reflect.construct(Point, ["a", 2], Other) as any;
# report(under.other() + ":" + under.x + under.y + ":" + (under instanceof Point));
# try { (Point as any)(1, 2); } catch (error) { report((error as Error).name); }
# report(said);
# report("end");
# Classes with declared fields are constructed with seven values that are not what was declared, below another new.target, and called without new. What a constructor says it says once, and each object has its fields in the order of the text.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let said = ""; class Point { x; y; constructor(x, y) { said += "p"; this.x = x; this.y = y; } sum() { return this.x + this.y; } } class Named extends Point { name; constructor(name, x) { said += "n"; super(x, x + 1); this.name = name; } text() { return this.name + this.sum(); } } class Counted { static made = 0; id = ++Counted.made; label; constructor(label) { this.label = label; } } function make(x, y) { const made = new Point(x, y); return typeof made.x + ":" + made.sum(); } function makeNamed(name, x) { const made = new Named(name, x); return made.text() + ":" + Object.keys(made).join(); } function makeCounted(label) { const made = new Counted(label); return made.id + ":" + made.label; } class Other { other() { return "other"; } } const odd = [1, 2.5, "3", undefined, null, { valueOf() { said += "v"; return 4; } }, true]; for (const one of odd) { report(make(one, 1)); report(make(1, one)); report(makeNamed(one, 1)); report(makeNamed("n", one)); report(makeCounted(one)); } const under = Reflect.construct(Point, ["a", 2], Other); report(under.other() + ":" + under.x + under.y + ":" + (under instanceof Point)); try { Point(1, 2); } catch (error) { report(error.name); } report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
