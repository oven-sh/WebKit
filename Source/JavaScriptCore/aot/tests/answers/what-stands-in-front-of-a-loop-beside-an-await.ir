# report(await loopsAroundAwait(other as any, 2, 3));
# report(await loopsAroundAwait(new Box(2), "3" as any, 2));
# report(await loopThenAwait(new Box(2), 1.5, 3));
# report(await loopThenAwait(other as any, 2, 3));
# report(await awaitInLoop(new Box(2), 1.5, 3));
# report(await awaitInLoop(other as any, 2, 3));
# report(await awaitInLoopInside(new Box(2), 1.5, 3));
# report(await awaitInLoopInside(other as any, 2, 2));
# report(await awaitOnOneWay(new Box(2), 1.5, 4));
# report(await awaitOnOneWay(other as any, 2, 4));
# report(await viewOverAwait(new Float64Array(3), 1.5, 3));
# report(await viewOverAwait([1, 2, 3] as any, 2, 2));
# report("end");
# An async function with loops in which, beside which and around which it awaits. What stands in front of a loop is a raw number, the answer of a test or a read: none of it is alive over a suspension unless the frame saves it.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Box { x; constructor(x) { this.x = x; } } const other = { y: 0, x: 2.5 }; async function loopsAroundAwait(o, k, n) { let s = 0; for (let r = 0;r < n; r++) { for (let i = 0;i < n; i++) s += o.x * k + i; await null; for (let i = 0;i < n; i++) s += o.x * k; } return s; } async function loopThenAwait(o, k, n) { let s = 0; for (let i = 0;i < n; i++) s += o.x * k + i; await null; s += o.x * k; for (let i = 0;i < n; i++) s += o.x * k; return s; } async function awaitInLoop(o, k, n) { let s = 0; for (let i = 0;i < n; i++) { s += o.x * k; await null; s += o.x + k; } return s; } async function awaitInLoopInside(o, k, n) { let s = 0; for (let r = 0;r < n; r++) { s += o.x * k; for (let i = 0;i < n; i++) { s += o.x; await null; s += k; } s += o.x * k; } return s; } async function awaitOnOneWay(o, k, n) { let s = 0; for (let i = 0;i < n; i++) { s += o.x * k; if (i === 1) await null; s += k; } return s; } async function viewOverAwait(a, k, n) { let s = 0; for (let r = 0;r < n; r++) { for (let i = 0;i < a.length; i++) { a[i] = a[i] + k; s += a[i]; } await null; } return s; } report(await loopsAroundAwait(new Box(2), 1.5, 3)); report(await loopsAroundAwait(other, 2, 3)); report(await loopsAroundAwait(new Box(2), "3", 2)); report(await loopThenAwait(new Box(2), 1.5, 3)); report(await loopThenAwait(other, 2, 3)); report(await awaitInLoop(new Box(2), 1.5, 3)); report(await awaitInLoop(other, 2, 3)); report(await awaitInLoopInside(new Box(2), 1.5, 3)); report(await awaitInLoopInside(other, 2, 2)); report(await awaitOnOneWay(new Box(2), 1.5, 4)); report(await awaitOnOneWay(other, 2, 4)); report(await viewOverAwait(new Float64Array(3), 1.5, 3)); report(await viewOverAwait([1, 2, 3], 2, 2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
