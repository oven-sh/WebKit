# `typeof` of a value that folds is the text that the engine answers, whatever the kind of the value, and a text that one function takes twice is there both times
# function kinds() { report(typeof 0.5, typeof 0.25, typeof 1, typeof 2, typeof "a", typeof "b", typeof true, typeof false, typeof undefined, typeof undefined, typeof null, typeof null, typeof 1n, typeof 2n,
#   typeof Symbol.iterator, typeof Symbol.hasInstance, typeof function nothing() {}, typeof function nothing() {}, typeof Math, typeof JSON); }
# function byTruth(x) { if (x) return "yes"; return "no"; }
# kinds(); kinds();
# var ofNamespace = typeof Math === "object", first = ofNamespace ? "http://localhost" : "https://example.com";   and once more, into `second`
# var ofText = typeof "a" === "string", third = ofText ? "dev" : "prod";   and once more, into `fourth`
# report(first, second, third, fourth); report(byTruth(1), byTruth(0), byTruth(1), byTruth(0));
# The text is what the front end writes where it folds: each step that it has folded stands beside its constant, and nobody reads the step.
# Every kind comes twice in one function, and so does every text behind a flag: the word of a literal's cell is zero until the first taker has the cell made, and the second taker is the one that went wrong.
# The first call of `kinds` is the first run of all eight texts, the second finds the words filled. `byTruth` hands back the word of a literal, which is looked at and then made a cell.
# The stored programs have `process` where this has `Math`: the shell has no host to make it. The program that runs in Bun is test/aot/parallel/ordinary-foldable-code/typeof-of-every-folded-kind.js.
# RUN: run-in-shell globalThis.report = (...texts) => print(texts.join());
# CHECK: number,number,number,number,string,string,boolean,boolean,undefined,undefined,object,object,bigint,bigint,symbol,symbol,function,function,object,object
# CHECK-NEXT: number,number,number,number,string,string,boolean,boolean,undefined,undefined,object,object,bigint,bigint,symbol,symbol,function,function,object,object
# CHECK-NEXT: http://localhost,http://localhost,dev,dev
# CHECK-NEXT: yes,no,yes,no
# CHECK-NEXT: exited with 0

