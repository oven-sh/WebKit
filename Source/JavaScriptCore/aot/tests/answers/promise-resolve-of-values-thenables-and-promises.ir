# const ticks = tick("t", 9);
# follow("number", wrapNumber());
# follow("nothing", wrapNothing());
# follow("record", wrapRecord(1));
# follow("thenable", wrapAny({ then(resolve) { note("then is asked"); resolve("from then"); } }));
