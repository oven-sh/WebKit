# report(d.seen);
# report(lookAt(b));
# report(lookAt(c));
# report(lookAt(d));
# report(new A().seen);
# report("end");
# The base constructor calls a method that the subclass overrides, which reads a field that the constructor or the initializer of the subclass fills only later.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class A { constructor() { this.a = 1; this.seen = this.look(); } look() { return 0; } } class B extends A { constructor() { super(); this.y = 7; } look() { return this.y; } } class C extends A { z = 9; look() { return this.z; } } class D extends A { d = 0; look() { return this.a; } } function lookAt(x) { return x.look(); } const b = new B(); const c = new C(); const d = new D(); report(b.seen); report(c.seen); report(d.seen); report(lookAt(b)); report(lookAt(c)); report(lookAt(d)); report(new A().seen); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
