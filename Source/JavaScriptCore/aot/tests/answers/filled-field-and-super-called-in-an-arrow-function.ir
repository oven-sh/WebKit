# class A { constructor(v) { this.a = v; } }
# class C extends A { constructor(v) { const call = () => super(v); call(); this.c = 4; } }
# function readA(x) { return x.a; }
# function readC(x) { return x.c; }
# report(readA(new C(6)));
# report(readC(new C(6)));
# report("end");
# super() stands in an arrow function, so the constructor itself shows no call that answers this.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class A { constructor(v) { this.a = v; } } class C extends A { constructor(v) { const call = () => super(v); call(); this.c = 4; } } function readA(x) { return x.a; } function readC(x) { return x.c; } report(readA(new C(6))); report(readC(new C(6))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

