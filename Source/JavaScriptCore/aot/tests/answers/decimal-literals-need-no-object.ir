# A literal is a constant, whatever the global Decimal is, and an object of its own where one is seen.
# sink(x => x.divide(8m), x => x.equals(1.5m), () => [1m, 1m, (-0m).add(-0m)], value => new Decimal(value).add(1.5m));
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns >= 6
# RUN(CODE): emit f1
# CODE: = Mul(
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g, h, k) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); const one = D("1"), x = D("1.50"); show(() => f(one)); show(() => g(x)); show(() => g({ equals: literal => literal })); show(() => names(h())); show(() => k(1)); globalThis.Decimal = function (value) { return { add: literal => "own " + value + " " + literal.toString() }; }; show(() => k(1)); delete globalThis.Decimal; show(() => f(one)); show(() => names(h())); show(() => k(1)); };
# CHECK: 0.125;
# CHECK-NEXT: true;
# CHECK-NEXT: 1.5;
# CHECK-NEXT: 0:1 1:1 2:-0;
# CHECK-NEXT: 2.5;
# CHECK-NEXT: own 1 1.5;
# CHECK-NEXT: 0.125;
# CHECK-NEXT: 0:1 1:1 2:-0;
# CHECK-NEXT: ReferenceError;
# CHECK-NEXT: exited with 0

