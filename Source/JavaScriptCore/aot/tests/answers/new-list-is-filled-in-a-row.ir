# tell(() => { const list = fills(2, 1); list.push("more"); list[0] = 0.5; return text(list); });
# tell(() => { const list = fills(3, kept); return list[0] === kept && list[2] === kept; });
# tell(() => Object.is(fills(2, -0)[1], -0));
# tell(() => fills(-1, 0).length);
# tell(() => fills(1.5, 0).length);
