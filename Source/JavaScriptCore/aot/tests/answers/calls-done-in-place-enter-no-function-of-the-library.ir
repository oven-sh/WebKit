# function show(a, b, ...others) { return tell(this, a, b, others.length) }
# function withoutOperands(callee) { return [callee.$apply()][0] }  function withReceiver(callee, receiver) { return [callee.$apply(receiver)][0] }
# function withList(callee, receiver, list) { return [callee.$apply(receiver, list)][0] }  function withMore(callee, receiver, list, more) { return [callee.$apply(receiver, list, more)][0] }
# function withLiteral(callee, receiver, a, b) { return [callee.$apply(receiver, [a, b])][0] }  function last(callee, receiver, list) { return callee.$apply(receiver, list) }
# function caught(callee, receiver, list) { try { return callee.$apply(receiver, list) } catch (error) { return "caught " + error.name } }
# function summed(callee, list, times) { let sum = 0; for (let turn = 0; turn < times; turn++) sum += callee.$apply(undefined, list); return sum }
# function called(callee, receiver, a, b) { return [Function.prototype.call done in place on callee, with receiver, a, b][0] }  function calledWithoutOperands(callee) { the same without operands }
# A call that is marked as done in place names Function.prototype.apply or Function.prototype.call, and the engine calls the receiver itself: with no list, with `this` alone, with a list of any kind,
# with an operand too many, in tail position, under a handler and in a loop.
# The text brings no library, so the stand-in answers undefined for both built-ins. Nobody enters it.
# RUN: run-in-shell globalThis.tell = (receiver, a, b, others) => receiver + " " + a + " " + b + " " + others; globalThis.drive = (show, withoutOperands, withReceiver, withList, withMore, withLiteral, last, caught, summed, called, calledWithoutOperands) => { print(withoutOperands(show)); print(withReceiver(show, "receiver")); print(withList(show, "list", [1, 2, 3])); print(withList(show, "null", null)); (function () { print(withList(show, "arguments", arguments)); })(4, 5, 6, 7); print(withList(show, "like", { length: 1, 0: "a" })); print(withMore(show, "more", [1], [2])); print(withLiteral(show, "literal", 8, 9)); print(last(show, "last", [1, 2])); print(last((a, b) => "shell " + a + b, "engine", ["x", "y"])); print(caught(show, "passes", [1])); print(caught(show, "refused", 1)); print(caught(1, "uncallable", [])); print(caught(() => { throw new RangeError("thrown"); }, "throws", [])); print(caught(show, "millions", new Array(10000000))); print(summed((a, b) => a + b, [1, 2], 5)); print(called(show, "called", 1, 2)); print(calledWithoutOperands(show)); };
# CHECK: undefined undefined undefined 0
# CHECK-NEXT: receiver undefined undefined 0
# CHECK-NEXT: list 1 2 1
# CHECK-NEXT: null undefined undefined 0
# CHECK-NEXT: arguments 4 5 2
# CHECK-NEXT: like a undefined 0
# CHECK-NEXT: more 1 undefined 0
# CHECK-NEXT: literal 8 9 0
# CHECK-NEXT: last 1 2 0
# CHECK-NEXT: shell xy
# CHECK-NEXT: passes 1 undefined 0
# CHECK-NEXT: caught TypeError
# CHECK-NEXT: caught TypeError
# CHECK-NEXT: caught RangeError
# CHECK-NEXT: caught RangeError
# CHECK-NEXT: 15
# CHECK-NEXT: called 1 2 0
# CHECK-NEXT: undefined undefined undefined 0
# CHECK-NEXT: exited with 0

