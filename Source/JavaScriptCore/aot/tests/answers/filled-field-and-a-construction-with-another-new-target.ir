# class A { constructor() { this.a = 1; } readA() { return this.a; } }
# class B extends A { w = 4; constructor() { super(); this.b = 2; } readB() { return this.b; } readW() { return this.w; } }
# const odd = Reflect.construct(A, [], B);
# report(odd.readA());
# report(odd.readB());
# report(odd.readW());
# report(odd instanceof B);
# const made = new B();
# report(made.readA());
# report(made.readB());
# report(made.readW());
# report("end");
# Reflect.construct(A, [], B) makes an object under the prototype of B that the constructor and the initializer of B have never seen.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class A { constructor() { this.a = 1; } readA() { return this.a; } } class B extends A { w = 4; constructor() { super(); this.b = 2; } readB() { return this.b; } readW() { return this.w; } } const odd = Reflect.construct(A, [], B); report(odd.readA()); report(odd.readB()); report(odd.readW()); report(odd instanceof B); const made = new B(); report(made.readA()); report(made.readB()); report(made.readW()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 8 of 8 of 8
# CHECK-NEXT: exited with 0

