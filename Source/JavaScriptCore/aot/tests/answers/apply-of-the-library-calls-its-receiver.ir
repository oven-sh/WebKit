# function applied(callee, receiver, list) { return callee.apply(receiver, list) }  function show(a, b, ...others) { return tell(this, a, b, others.length) }
# async function awaited(callee, receiver, list) { return (await callee.$apply(receiver, list)) + " then " + (await callee.$apply(receiver, list)) }  drive(applied, show, awaited)
# The library's Function.prototype.apply is `return this.$apply(thisValue, argumentValues)`: a call of the built-in itself that is marked as done in place. The engine calls the receiver there.
# Built as a call of the built-in, the function enters itself and the program never ends.
# The list is an array, nothing, an arguments object, an object with a length, no object, and longer than the stack takes. What such a call answers is awaited like any other answer.
# LIBRARY: own
# RUN: run-in-shell globalThis.tell = (receiver, a, b, others) => receiver + " " + a + " " + b + " " + others; globalThis.drive = (applied, show, awaited) => { const attempt = (callee, receiver, list) => { try { print(applied(callee, receiver, list)); } catch (error) { print(receiver + " " + error.name + ": " + error.message); } }; attempt(show, "array", [1, 2, 3]); attempt(show, "empty", []); attempt(show, "null", null); attempt(show, "undefined", undefined); (function () { attempt(show, "mapped", arguments); })(4, 5, 6, 7); (function () { "use strict"; attempt(show, "unmapped", arguments); })(8); attempt(show, "like", { length: 3, 0: "a", 2: "c" }); attempt(show, "holes", [1, , 3]); attempt(show, "fractions", [1.5, 2.5]); attempt((a, b) => "shell " + a + b, "engine", ["x", "y"]); attempt(show, "number", 1); attempt(show, "text", "ab"); attempt(show, "thousand", new Array(1000)); attempt(show, "millions", new Array(10000000)); attempt(Object.create(Function.prototype), "uncallable", []); print(Reflect.apply(Function.prototype.apply, show, ["reflected", [7, 8, 9]])); awaited(show, "awaited", [1]).then(print); };
# CHECK: array 1 2 1
# CHECK-NEXT: empty undefined undefined 0
# CHECK-NEXT: null undefined undefined 0
# CHECK-NEXT: undefined undefined undefined 0
# CHECK-NEXT: mapped 4 5 2
# CHECK-NEXT: unmapped 8 undefined 0
# CHECK-NEXT: like a undefined 1
# CHECK-NEXT: holes 1 undefined 1
# CHECK-NEXT: fractions 1.5 2.5 0
# CHECK-NEXT: shell xy
# CHECK-NEXT: number TypeError: second argument to Function.prototype.apply must be an Array-like object
# CHECK-NEXT: text TypeError: second argument to Function.prototype.apply must be an Array-like object
# CHECK-NEXT: thousand undefined undefined 998
# CHECK-NEXT: millions RangeError: Maximum call stack size exceeded.
# CHECK-NEXT: uncallable TypeError:
# CHECK-NEXT: reflected 7 8 1
# CHECK-NEXT: awaited 1 undefined 0 then awaited 1 undefined 0
# CHECK-NEXT: exited with 0

