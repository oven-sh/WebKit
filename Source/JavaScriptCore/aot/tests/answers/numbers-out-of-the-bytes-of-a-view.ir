# function sum(view: Float64Array) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i]; return s; }
# function product(view: Float64Array) { let p = 1; for (let i = 0; i < view.length; i++) p *= view[i]; return p; }
# function squares(view: Float64Array) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i] * view[i] - view[i] / 2; return s; }
# function first(view: Float64Array) { return view[0]; }
# function below(view: Float64Array) { let n = 0; for (let i = 0; i < view.length; i++) if (view[i] < 2) n++; return n; }
# function halved(view: Float64Array) { for (let i = 0; i < view.length; i++) view[i] = view[i] / 2; return view[0]; }
# function sum32(view: Float32Array) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i]; return s; }
# register(sum, product, squares, first, below, halved, sum32)
# What is read out of the bytes of a view is a number like any other wherever the program can look at it, whichever NaN the bytes spell: printed, as a key of a Map, in a list, as JSON.
# The shell lays each pattern of bits over each of four elements and runs the same text itself. 7ffa, 7ffb and 7ffc are the markers beside a number. From fffc on the bits, boxed, are those of an int32, of a cell or of no value at all.
# The program or the shell runs built-ins that are written in JavaScript. They are the engine's own here, and no stand-in answers for them.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; globalThis.register = (...compiled) => { const twins = [function sum(view) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i]; return s; }, function product(view) { let p = 1; for (let i = 0; i < view.length; i++) p *= view[i]; return p; }, function squares(view) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i] * view[i] - view[i] / 2; return s; }, function first(view) { return view[0]; }, function below(view) { let n = 0; for (let i = 0; i < view.length; i++) if (view[i] < 2) n++; return n; }, function halved(view) { for (let i = 0; i < view.length; i++) view[i] = view[i] / 2; return view[0]; }, function sum32(view) { let s = 0; for (let i = 0; i < view.length; i++) s += view[i]; return s; }]; const patterns = ["7ff8000000000000", "fff8deaddeadbeef", "7ff0000000000001", "fff0000000000001", "ffffffffffffffff", "fffc000000000005", "fffd00000000002a", "fffe000000000000", "fffe000000000007", "7ffa000000000000", "7ffb000000000000", "7ffc000000000000", "3ff8000000000000"]; const make = (pattern, place, isNarrow) => { const bytes = new Uint8Array(32); const view = isNarrow ? new Float32Array(bytes.buffer) : new Float64Array(bytes.buffer); for (let i = 0; i < view.length; i++) view[i] = i + 0.5; const width = isNarrow ? 4 : 8; for (let k = 0; k < width; k++) bytes[place * width + k] = parseInt(pattern.slice(2 * (width - 1 - k), 2 * (width - k)), 16); return view; }; const show = value => typeof value + " " + String(value) + " " + new Map([[NaN, "key"]]).get(value) + " " + [value].includes(NaN) + " " + Object.is(value, NaN) + " " + JSON.stringify([value]); const tell = (run, view) => show(run(view)) + " " + Array.from(view, String).join(); for (let k = 0; k < compiled.length; k++) { const isNarrow = twins[k].name === "sum32"; let same = 0, all = 0; for (const pattern of patterns) for (let place = 0; place < 4; place++) { all++; const got = tell(compiled[k], make(pattern, place, isNarrow)), expected = tell(twins[k], make(pattern, place, isNarrow)); if (got === expected) same++; else print(twins[k].name + " of " + pattern + " at " + place + ": " + got + " and not " + expected); } print(twins[k].name + ": " + same + " of " + all); } }; })();
