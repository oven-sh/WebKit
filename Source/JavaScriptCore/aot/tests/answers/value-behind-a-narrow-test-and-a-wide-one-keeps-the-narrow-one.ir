# made of 04b98c666f908535
# the value has passed a test for a string and then a test that only turns numbers away: what flows on is a string, and the wider test does not take the place of the narrower
# f1 = textOnly
# TODO: unions-and-narrowing-4: the front end tests and returns the value from in front of both tests (TypeTest v0, Return v0, not the parameters of the blocks that the tests prove), so the edge to the result bears no test until listOf() answers with the name behind the test
# OPTIONS: testing=CheckProofsAtRunTime
# RUN(FORM): summary f1
# FORM: edge Parameter 0 -> Result 0 passes=string
# RUN(NEVER): summary f1
# NEVER-NOT: edge Parameter 0 -> Result 0 passes={{*}}undefined
# function textOnly(a: any) { if (typeof a === "string") { if (typeof a !== "number") return a; } return "none"; }
# function lengthOf(a: any) { return textOnly(a).length; }
# report(lengthOf("three"));
# report(lengthOf(3));
# report(lengthOf(null));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function textOnly(a) { if (typeof a === "string") { if (typeof a !== "number") return a; } return "none"; } function lengthOf(a) { return textOnly(a).length; } report(lengthOf("three")); report(lengthOf(3)); report(lengthOf(null)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 4 of 4 of 4
# CHECK-NEXT: exited with 0

