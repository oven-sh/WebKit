# made of 33515154e1671dfa
# stores that may add a field under a handler have a poll behind them. The poll changes no answer: each field is there behind its store, and a store that is refused comes to the handler from the place where it stands
# f1 = show, f2 = fill, f3 = fillSome, f4 = fillInLoop, f5 = fillHostile
# RUN(FORM): walk f2 mechanisms=all
# FORM-LABEL: code f2:Body
# FORM: PutSlotOrAdd
# FORM: = LoopHint [throwsOwedError]
# class P { declare x?: unknown; declare y?: unknown; declare z?: unknown; constructor(v: unknown) { if (typeof v === "number") { this.x = v; this.y = v; this.z = v; } } }
# class Q { declare x?: unknown; declare y?: unknown; declare z?: unknown; constructor(v: unknown) { if (typeof v === "number") { this.x = v; this.y = v; this.z = v; } } }
# function show(o: any) { return String(o.x) + String(o.y) + String(o.z) + ("x" in o) + ("y" in o) + ("z" in o); }
# function fill(p: P, v: unknown) { try { p.x = v; p.y = v; p.z = v; return show(p); } catch (e) { return "caught"; } }
# function fillSome(p: P, v: unknown, some: boolean) { try { p.x = v; if (some) p.y = v; p.z = v; } catch (e) { return "caught"; } return show(p); }
# function fillInLoop(list: P[], v: unknown) { let text = ""; try { for (let i = 0; i < list.length; i++) { list[i].x = v; list[i].z = i; text += show(list[i]); } } catch (e) { return "caught"; } return text; }
# function fillHostile(q: Q, v: unknown) { let at = 0; try { q.x = v; at = 1; q.y = v; at = 2; q.z = v; at = 3; } catch (e) { return (e as Error).name + at + show(q); } return at + show(q); }
# report(fill(new P("a"), "b"));
# report(fill(new P(1), "b"));
# report(fill(new P("a"), undefined));
# report(fillSome(new P("a"), 2, true));
# report(fillSome(new P("a"), 2, false));
# report(fillInLoop([new P("a"), new P(1), new P("c")], "v"));
# report(fillInLoop([], "v"));
# report(fillHostile(new Q("a"), "b"));
# report(fillHostile(Object.freeze(new Q("a")), "b"));
# report(fillHostile(Object.preventExtensions(new Q("a")), "b"));
# report(fillHostile(Object.defineProperty(new Q("a"), "y", { set(v) { throw new RangeError("setter"); } }), "b"));
# report(fillHostile(Object.defineProperty(new Q(1), "z", { value: 9, writable: false }), "b"));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { constructor(v) { if (typeof v === "number") { this.x = v; this.y = v; this.z = v; } } } class Q { constructor(v) { if (typeof v === "number") { this.x = v; this.y = v; this.z = v; } } } function show(o) { return String(o.x) + String(o.y) + String(o.z) + ("x" in o) + ("y" in o) + ("z" in o); } function fill(p, v) { try { p.x = v; p.y = v; p.z = v; return show(p); } catch (e) { return "caught"; } } function fillSome(p, v, some) { try { p.x = v; if (some) p.y = v; p.z = v; } catch (e) { return "caught"; } return show(p); } function fillInLoop(list, v) { let text = ""; try { for (let i = 0;i < list.length; i++) { list[i].x = v; list[i].z = i; text += show(list[i]); } } catch (e) { return "caught"; } return text; } function fillHostile(q, v) { let at = 0; try { q.x = v; at = 1; q.y = v; at = 2; q.z = v; at = 3; } catch (e) { return e.name + at + show(q); } return at + show(q); } report(fill(new P("a"), "b")); report(fill(new P(1), "b")); report(fill(new P("a"), undefined)); report(fillSome(new P("a"), 2, true)); report(fillSome(new P("a"), 2, false)); report(fillInLoop([new P("a"), new P(1), new P("c")], "v")); report(fillInLoop([], "v")); report(fillHostile(new Q("a"), "b")); report(fillHostile(Object.freeze(new Q("a")), "b")); report(fillHostile(Object.preventExtensions(new Q("a")), "b")); report(fillHostile(Object.defineProperty(new Q("a"), "y", { set(v) { throw new RangeError("setter"); } }), "b")); report(fillHostile(Object.defineProperty(new Q(1), "z", { value: 9, writable: false }), "b")); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
