# WRITTEN: = GetSlot {{*}}level=Expected [{{*}}expectsCell]
# RUN(NULLISH): walk f3 mechanisms=all
# NULLISH: = GetSlot {{*}}level=Expected [{{*}}expectsCell]
# RUN(NUMBER): walk f4 mechanisms=all
# NUMBER: = GetSlot {{*}}level=Expected
# NUMBER-NOT: expectsCell
# RUN(BOOLEAN): walk f5 mechanisms=all
# BOOLEAN: = ShapeTest
# BOOLEAN-NOT: expectsCell
# RUN(FAULTS): emit f1:Body mechanisms=all
# REQUIRES(FAULTS): faulting-reads-off-no-cell
# FAULTS: ReadsZeroOffNoCell
# RUN(BOTH): emit f2:Body mechanisms=all
# REQUIRES(BOTH): faulting-reads-off-no-cell
