# function listOf(length) { return Array(length) }  function pairOf(a, b) { return Array(a, b) }  drive(listOf, pairOf)
# Array(..) as written is marked as done in place too. Its row forwards the call to no operand, so nothing stands in its place: it is a call of the built-in, which answers as ever.
# RUN: run-in-shell globalThis.drive = (listOf, pairOf) => { const attempt = (way, ...operands) => { try { print(JSON.stringify(way(...operands))); } catch (error) { print(error.name + ": " + error.message); } }; attempt(listOf, 3); attempt(listOf, 0); attempt(listOf, "3"); attempt(listOf, undefined); attempt(listOf, -1); attempt(listOf, 1.5); attempt(pairOf, 1, 2); };
# CHECK: [null,null,null]
# CHECK-NEXT: []
# CHECK-NEXT: ["3"]
# CHECK-NEXT: [null]
# CHECK-NEXT: RangeError: Array length must be a positive integer of safe magnitude.
# CHECK-NEXT: RangeError: Array length must be a positive integer of safe magnitude.
# CHECK-NEXT: [1,2]
# CHECK-NEXT: exited with 0

