ion whole(a, b) { if (typeof a !== "number" || typeof b !== "number") return "no number"; const x = a | 0; const d = (b & 7) + 1; if (x % d === 0) return 1 / (x / d); return "something is left"; } function wholeByTruth(a, b) { if (typeof a !== "number" || typeof b !== "number") return "no number"; const x = a | 0; const d = (b & 7) + 1; if (x % d) return "something is left"; return 1 / (x / d); } function broken(a, b) { if (typeof a !== "number" || typeof b !== "number") return "no number"; const x = a | 0; const d = (b & 7) + 1; if (x % d === 0) return "nothing is left"; return x / d; } function halve(a) { if (typeof a !== "number") return "no number"; let i = a | 0; let turns = 0; while (i > 0) { i = Math.floor(i / 2); turns++; } return turns * 1000 + i; } function halveUp(a) { if (typeof a !== "number") return "no number"; let i = a | 0; let turns = 0; while (i < -1 && turns < 40) { i = Math.floor(i / 2); turns++; } return turns * 1000 + i; } const values = [0, -0, 1, -1, 2, 3, 7, -7, 8, 255, 2147483647, -2147483648, 2147483648, 4294967295, 1.5, -0.5, NaN, 1 / 0, -1 / 0, "3", null, undefined, true]; for (let i = 0;i < values.length; i++) { report(halve(values[i])); report(halveUp(values[i])); } for (let i = 0;i < values.length; i++) for (let j = 0;j < values.length; j++) { report(down(values[i], values[j])); report(up(values[i], values[j])); report(upOfAny(values[i], values[j])); report(cutOfAny(values[i], values[j])); } for (let i = 0;i < values.length; i++) for (let j = 0;j < values.length; j++) { report(nearest(values[i], values[j])); report(nearestOfAny(values[i], values[j])); report(belowZero(values[i], values[j])); report(byAny(values[i], values[j])); } for (let i = 0;i < values.length; i++) for (let j = 0;j < values.length; j++) { report(cut(values[i], values[j])); report(shifted(values[i], values[j])); report(cutTwice(values[i], values[j])); } for (let i = 0;i < values.length; i++) for (let j = 0;j < values.length; j++) { report(whole(values[i], values[j]