# class Parser { constructor(s, reset) { this.src = s; reset(this); } }
# function keep(s, reset) { const p = new Parser(s, reset); list(p); read(p); }
# function read(p: Parser) { report(p.src); report(p.pos); }
# keep(1, fills); keep(2, skips); keep(3, fills); keep(4, redefines); keep(5, blanks);
# `src` and `pos` are fields of the layout, and the constructor leaves `pos` to `reset`.
# Where `reset` has stored nothing, or has made `src` a getter, `read` goes by name and takes no empty slot for a value.
# RUN: run-in-shell globalThis.report = value => print(typeof value + " " + value); globalThis.list = () => { }; globalThis.fills = p => { p.pos = 7; }; globalThis.skips = () => { }; globalThis.redefines = p => { p.pos = 7; Object.defineProperty(p, "src", { get() { return 9; } }); }; globalThis.blanks = p => { p.pos = undefined; };
# CHECK: number 1
# CHECK-NEXT: number 7
# CHECK-NEXT: number 2
# CHECK-NEXT: undefined undefined
# CHECK-NEXT: number 3
# CHECK-NEXT: number 7
# CHECK-NEXT: number 9
# CHECK-NEXT: number 7
# CHECK-NEXT: number 5
# CHECK-NEXT: undefined undefined
# CHECK-NEXT: exited with 0

