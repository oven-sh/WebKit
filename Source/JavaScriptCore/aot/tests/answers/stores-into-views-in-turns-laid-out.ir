# tripled(7);
# tripled(8);
# tripled(9);
# tripled(17);
# chained(1);
# chained(8);
# chained(9);
# chained(24);
# numbers(7);
# numbers(8);
# numbers(17);
# left(24, 0);
# left(24, 1);
# left(24, 7);
# left(24, 8);
# left(24, 15);
# left(24, 16);
# left(24, 23);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function triple(view) { for (let i = 0;i < view.length; i++) view[i] = view[i] * 3 + 1; } function bumpUntil(view, stop) { let i = 0; for (;i < view.length; i++) { view[i] = view[i] + 1; if (view[i] === stop) break; } return i; } function shifted(from, into) { for (let i = 0;i < from.length; i++) into[i] = from[i] + 1; } function halved(view, from) { for (let i = 0;i < view.length; i++) view[i] = from * 0.5 + i; } function show(view) { let said = ""; for (let i = 0;i < view.length; i++) said += view[i] + ","; return said; } function showNumbers(view) { let said = ""; for (let i = 0;i < view.length; i++) said += view[i] + ","; return said; } function made(length) { const view = new Int32Array(length); for (let i = 0;i < length; i++) view[i] = i * 3; return view; } function tripled(length) { const view = made(length); triple(view); triple(view); report(show(view)); } function left(length, place) { const view = made(length); report(bumpUntil(view, place * 3 + 1)); report(show(view)); report(bumpUntil(view, -1)); report(show(view)); } function chained(length) { const buffer = new ArrayBuffer((length + 1) * 4); const from = new Int32Array(buffer, 0, length); const into = new Int32Array(buffer, 4, length); from[0] = 5; shifted(from, into); shifted(from, into); report(show(new Int32Array(buffer))); } function numbers(length) { const view = new Float64Array(length); halved(view, 3); report(showNumbers(view)); halved(view, NaN); report(showNumbers(view)); } tripled(0); tripled(7); tripled(8); tripled(9); tripled(17); chained(1); chained(8); chained(9); chained(24); numbers(7); numbers(8); numbers(17); left(24, 0); left(24, 1); left(24, 7); left(24, 8); left(24, 15); left(24, 16); left(24, 23); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value));