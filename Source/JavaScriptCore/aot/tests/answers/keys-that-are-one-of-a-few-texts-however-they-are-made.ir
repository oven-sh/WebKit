rst: 0, second: 0 }; made[key] = value; return made.first + "," + made.second + "," + made[key]; } report(stored("first", 1)); report(stored("second", 2)); report(stored("sec" + "ond", 3)); function templated(key) { return `${key}/${table[key]}`; } report(templated("first")); report(templated("third")); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); }); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + got[n] + " and not " + expected[n]); } print(same + " of " + expected.length + " of " + got.length); }; })();
