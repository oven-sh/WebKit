# class Thing { tag: number; constructor(tag: number) { this.tag = tag; } who() { return mark; } }
# class Other { tag: number; constructor(tag: number) { this.tag = tag; } who() { return mark + 100; } }
# class Box { held: Thing | Other; constructor(held: Thing | Other) { this.held = held; } ask() { return this.held.who(); } askSplit() { return this.held.who(); } }
# var mark = id(0);
# function thing() { return new Thing(1); }   function other() { return new Other(1); }   function box(held) { return new Box(held); }
# function put(box, held) { box.held = held; }
# function whoIs(thing: Thing) { return thing.who(); }   function ask(box: Box) { return box.ask(); }   function askSplit(box: Box) { return box.askSplit(); }
# register(thing, other, box, put, whoIs, ask, askSplit);
# One heap holds two instances of the image: the shell makes a second global of the same VM, which has the module host too, and runs the entry module in both. `id` answers 1 in the first and 2 in the second.
# The build is told that the program runs in several realms, as for `bun test --isolate`, so the image lets a second global have an instance.
# The objects of both instances have the same shapes. A method runs with the variables of the instance that made its object, whoever calls it, so `who` tells whose object answered.
# Each instance is handed objects of the other: as an argument of a declared type, into a constructor, and in the slot of a declared type, stored by its own code and by the code of the other instance.
# In askSplit the text tests the type of what the slot held, which lists layouts alone, so that test asks for the shape and not for the instance. Both sides call `who`.
# At the end the shell runs the same text twice itself: every answer is the same.
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ thing: f[0], other: f[1], box: f[2], put: f[3], whoIs: f[4], ask: f[5], askSplit: f[6] }); const twin = (id, register) => { class Thing { constructor(tag) { this.tag = tag; } who() { return mark; } } class Other { constructor(tag) { this.tag = tag; } who() { return mark + 100; } } class Box { constructor(held) { this.held = held; } ask() { return this.held.who(); } askSplit() { return this.held.who(); } } var mark = id(0); function thing() { return new Thing(1); } function other() { return new Other(1); } function box(held) { return new Box(held); } function put(box, held) { box.held = held; } function whoIs(thing) { return thing.who(); } function ask(box) { return box.ask(); } function askSplit(box) { return box.askSplit(); } register(thing, other, box, put, whoIs, ask, askSplit); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const asked = held => x.ask(held) + "," + x.askSplit(held) + "," + y.ask(held) + "," + y.askSplit(held); say("own thing", () => x.whoIs(x.thing())); say("their thing", () => x.whoIs(y.thing())); say("own box", () => asked(x.box(x.thing())) + ";" + asked(x.box(x.other()))); say("their thing in a new box", () => asked(x.box(y.thing())) + ";" + asked(x.box(y.other()))); say("their box", () => asked(y.box(y.thing()))); say("we put theirs", () => { const held = x.box(x.thing()); x.put(held, y.thing()); return asked(held); }); say("they put theirs", () => { const held = x.box(x.thing()); y.put(held, y.thing()); return asked(held); }); say("they put their other", () => { const held = x.box(x.thing()); y.put(held, y.other()); return asked(held); }); say("they put ours", () => { const held = x.box(x.thing()); y.put(held, x.other()); return asked(held); }); say("in turn", () => { let sum = 0; const held = x.box(x.thing()); for (let i = 0; i < 400; i++) { (i & 1 ? y : x).put(held, (i & 2 ? y : x).thing()); sum += x.ask(held) * (i % 7) + x.askSplit(held); } return sum; }); say("same class", () => x.thing().constructor === y.thing().constructor); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
