# made of 97c6214d61c89707
# what enters the loop is no text and is only joined: 0, -0, a fraction, undefined, a boolean. Where the loop may have no turn, or a turn looks at the value, or the sum may be a number, the value stays what it is
# f1 = numbered, f2 = negative, f3 = fraction, f4 = nothing, f5 = flag, f6 = maybeNoTurn, f7 = seen, f8 = summed
# RUN(FORM): walk f1 f2 f3 mechanisms=all
# FORM-LABEL: code f1:Body
# FORM: StringBuilderBegin
# FORM: StringBuilderFinish
# FORM-LABEL: code f2:Body
# FORM: StringBuilderBegin
# FORM-LABEL: code f3:Body
# FORM: StringBuilderBegin
# RUN(NOFORM): walk f6 mechanisms=all
# NOFORM-NOT: StringBuilder
# RUN(SEEN): walk f7 mechanisms=all
# SEEN-COUNT-1: StringBuilderBegin
# SEEN-NOT: StringBuilderBegin
# function numbered(n: number) { let text: any = 0; let i = 0; do text += "k"; while (++i < n); return text; }
# function negative(n: number) { let text: any = -0; let i = 0; do text += "k"; while (++i < n); return text; }
# function fraction(n: number) { let text: any = 1.5; let i = 0; do text += "k" + i; while (++i < n); return text; }
# function nothing(n: number) { let text: any = undefined; let i = 0; do text += "k"; while (++i < n); return text; }
# function flag(n: number) { let text: any = true; let i = 0; do text += "k"; while (++i < n); return text; }
# function maybeNoTurn(n: number) { let text: any = 0; for (let i = 0; i < n; i++) text += "k"; return text; }
# function seen(n: number) { let text: any = 0; let kinds = ""; let i = 0; do { kinds = kinds + typeof text + ","; text += "k"; } while (++i < n); return kinds + text; }
# function summed(x: any, n: number) { let text: any = 0; let i = 0; do text += x; while (++i < n); return text; }
# report(numbered(1));
# report(numbered(3));
# report(typeof numbered(1));
# report(negative(1));
# report(negative(2));
# report(fraction(2));
# report(nothing(2));
# report(flag(2));
# report(maybeNoTurn(0));
# report(typeof maybeNoTurn(0));
# report(maybeNoTurn(2));
# report(typeof maybeNoTurn(2));
# report(seen(3));
# report(summed(2, 3));
# report(typeof summed(2, 3));
# report(summed("a", 3));
# report(summed(null, 2));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function numbered(n) { let text = 0; let i = 0; do text += "k"; while (++i < n); return text; } function negative(n) { let text = -0; let i = 0; do text += "k"; while (++i < n); return text; } function fraction(n) { let text = 1.5; let i = 0; do text += "k" + i; while (++i < n); return text; } function nothing(n) { let text = undefined; let i = 0; do text += "k"; while (++i < n); return text; } function flag(n) { let text = true; let i = 0; do text += "k"; while (++i < n); return text; } function maybeNoTurn(n) { let text = 0; for (let i = 0;i < n; i++) text += "k"; return text; } function seen(n) { let text = 0; let kinds = ""; let i = 0; do { kinds = kinds + typeof text + ","; text += "k"; } while (++i < n); return kinds + text; } function summed(x, n) { let text = 0; let i = 0; do text += x; while (++i < n); return text; } report(numbered(1)); report(numbered(3)); report(typeof numbered(1)); report(negative(1)); report(negative(2)); report(fraction(2)); report(nothing(2)); report(flag(2)); report(maybeNoTurn(0)); report(typeof maybeNoTurn(0)); report(maybeNoTurn(2)); report(typeof maybeNoTurn(2)); report(seen(3)); report(summed(2, 3)); report(typeof summed(2, 3)); report(summed("a", 3)); report(summed(null, 2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 18 of 18 of 18
# CHECK-NEXT: exited with 0

