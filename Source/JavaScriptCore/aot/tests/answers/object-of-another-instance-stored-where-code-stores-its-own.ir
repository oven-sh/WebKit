# Two instances of the image in one heap, as in objects-of-another-instance-behind-a-test-of-their-shape.ir. Here all that compiled code ever stores in `held` is a Thing of its own instance.
# The shell stores a Thing of the other instance there: by name, by Reflect.set, by a definition, by Object.assign. It has the shape that every store in sight has stored. `who` still answers for the instance that made it.
# Without the question for the instance behind a shape: 9 of 17.
# class Thing { constructor(tag) { this.tag = tag; } who() { return mark; } }
# class Box { constructor() { this.held = new Thing(1); } }
# var mark = id(0);
# function thing() { return new Thing(2); }
# function box() { return new Box(); }
# function askInLoop(box, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += box.held.who(); return sum; }
# function askOnce(box) { return box.held.who(); }
# function own() { return askInLoop(box(), 2) + askOnce(box()); }
# register(thing, box, askInLoop, askOnce, own);
# LIBRARY: own
# OPTIONS: several-realms
# RUN: run-in-shell (function () { "use strict"; const second = createGlobalObject(); const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { second.runCompiledEntryPoint(entry); return start(entry); }; globalThis.id = () => 1; second.id = () => 2; const kitOf = f => ({ thing: f[0], box: f[1], askInLoop: f[2], askOnce: f[3], own: f[4] }); const twin = (id, register) => { class Thing { constructor(tag) { this.tag = tag; } who() { return mark; } } class Box { constructor() { this.held = new Thing(1); } } var mark = id(0); function thing() { return new Thing(2); } function box() { return new Box(); } function askInLoop(box, turns) { let sum = 0; for (let i = 0; i < turns; i++) sum += box.held.who(); return sum; } function askOnce(box) { return box.held.who(); } function own() { return askInLoop(box(), 2) + askOnce(box()); } register(thing, box, askInLoop, askOnce, own); }; const rows = (a, b) => { const said = []; const say = (label, run) => { try { said.push(label + " " + String(run())); } catch (error) { said.push(label + " throws " + error.name); } }; say("own", () => a.own() + "," + b.own()); const sides = [[a, b], [b, a]]; for (let side = 0; side < 2; side++) { const x = sides[side][0], y = sides[side][1]; const asked = held => x.askInLoop(held, 3) + "," + y.askInLoop(held, 3) + "," + x.askOnce(held) + "," + y.askOnce(held); say("own box", () => asked(x.box())); say("their box", () => asked(y.box())); say("stored by name", () => { const held = x.box(); held.held = y.thing(); return asked(held); }); say("stored by Reflect.set", () => { const held = x.box(); Reflect.set(held, "held", y.thing()); return asked(held); }); say("defined", () => { const held = x.box(); Object.defineProperty(held, "held", { value: y.thing(), writable: true, enumerable: true, configurable: true }); return asked(held); }); say("assigned", () => { const held = x.box(); Object.assign(held, { held: y.thing() }); return asked(held); }); say("a stranger stored", () => { const held = x.box(); held.held = { who() { return 7; } }; return asked(held); }); say("ours stored again", () => { const held = x.box(); held.held = y.thing(); held.held = x.thing(); return asked(held); }); } return said; }; const kits = { }; const finish = () => { if (!kits.first || !kits.second) return; const twins = { }; twin(() => 1, (...f) => { twins.first = kitOf(f); }); twin(() => 2, (...f) => { twins.second = kitOf(f); }); const got = rows(kits.first, kits.second), expected = rows(twins.first, twins.second); let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("row " + n + ": " + got[n].slice(0, 120) + " and not " + expected[n].slice(0, 120)); } print(same + " of " + expected.length); }; globalThis.register = (...f) => { kits.first = kitOf(f); finish(); }; second.register = (...f) => { kits.second = kitOf(f); finish(); }; })();
# CHECK: 17 of 17
# CHECK-NEXT: exited with 0

