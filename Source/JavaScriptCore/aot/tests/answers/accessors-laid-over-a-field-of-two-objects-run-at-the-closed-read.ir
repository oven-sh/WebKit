# descriptors lay two getters over one field. Object.defineProperty() opens the layout, so the receiver is any object that unseen code has had, the read looks at the slot on a guess and may run any code: the variable is read again behind it
# it guards no line of RED.txt: the answers alone are held
# f1 = deed, f2 = witness, f3 = tell
# RUN(FORM): walk f1 mechanisms=all
# FORM-LABEL: code f1:Body
# FORM: key="x"{{*}}mayCallUnknownCode
# let log = "";
# class P { x = 1; y = 2; }
# function deed(p: P) { const before = log; const got = p.x; return got + " " + before + "|" + log; }
# function witness(p: P) { return delete (p as any).gone; }
# const plain = new P();
# const first = new P();
# const second = new P();
# Object.defineProperty(first, "x", { get() { log = log + "a"; return 7; } });
# Object.defineProperty(second, "x", { get() { log = log + "b"; return 8; } });
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => deed(plain));
# tell(() => deed(first));
# tell(() => deed(second));
# tell(() => deed(first));
# tell(() => witness(plain));
# tell(() => witness(first));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; class P { x = 1; y = 2; } function deed(p) { const before = log; const got = p.x; return got + " " + before + "|" + log; } function witness(p) { return delete p.gone; } const plain = new P; const first = new P; const second = new P; Object.defineProperty(first, "x", { get() { log = log + "a"; return 7; } }); Object.defineProperty(second, "x", { get() { log = log + "b"; return 8; } }); function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => deed(plain)); tell(() => deed(first)); tell(() => deed(second)); tell(() => deed(first)); tell(() => witness(plain)); tell(() => witness(first)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
