# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let calls = 0; const order = JSON.parse("[4, 2, 0, 1, 3]"); const functions = [Number, Object, String, Symbol, Boolean]; const found = []; for (let i = 0;i < order.length; i++) found[i] = functions[order[i]]; function asked(test, value) { const answer = test(value); calls++; return answer; } function askedNothing(test) { const answer = test(); calls++; return answer; } function askedMore(test, value, index, list) { const answer = test(value, index, list); calls++; return answer; } function askedOn(holder, value) { const answer = holder.test(value); calls++; return answer; } function kept(list, test) { return list.filter(test).join("|"); } function tried(f) { try { return String(f()); } catch (e) { return e instanceof TypeError ? "TypeError" : "another error"; } } const truth = found[0]; report(asked(truth, true)); report(asked(truth, false)); report(asked(truth, undefined)); report(asked(truth, null)); report(asked(truth, 0)); report(asked(truth, -0)); report(asked(truth, 1)); report(asked(truth, -1)); report(asked(truth, 0.5)); report(asked(truth, NaN)); report(asked(truth, 1 / 0)); report(asked(truth, 2 ** 31)); report(asked(truth, "")); report(asked(truth, "0")); report(asked(truth, "false")); let rope = ""; rope += String(calls); rope += "x"; report(asked(truth, rope)); report(asked(truth, {})); report(asked(truth, [])); report(asked(truth, () => 0)); report(asked(truth, new truth(false))); report(asked(truth, Symbol("a"))); report(asked(truth, 0n)); report(asked(truth, 1n)); report(asked(truth, { valueOf() { calls += 100; return false; }, toString() { calls += 100; return ""; } })); report(askedNothing(truth)); report(askedMore(truth, 0, 1, [1])); report(askedMore(truth, "a", 0, [])); report(askedOn({ test: truth }, 0)); report(askedOn({ test: truth }, "a")); report(asked(found[1], 12)); report(asked(found[1], null)); report(askedNothing(found[1])); report(asked(found[2], "12")); report(asked(found[2], true)); report(askedNothing(found[2])); report(typeof asked(found[3], 1)); report(typeof asked(found[4], "made")); report(asked((value) => value === 0, 0)); report(typeof new truth(0)); report(tried(() => asked(undefined, 1))); report(kept([0, 1, "", "a", null, undefined, NaN, 0.5, false, true, -0, 2], truth)); report(kept([[], {}, 0n, 1n].map((value) => typeof value), truth)); report([0, 1, 2].map(truth).join("|")); report([0, "", null].some(truth)); report([1, "a", {}].every(truth)); report([0, "", 3, null].find(truth)); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
