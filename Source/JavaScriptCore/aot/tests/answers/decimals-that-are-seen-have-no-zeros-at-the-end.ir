# What goes into a sum only may keep zeros at its end. What is compared by its words, written or handed on may not.
# sink((x, y, z) => { const sum = x.add(y), product = x.multiply(y); return [x.add(y).equals(z), x.add(y).toString(), x.add(y).add(z), x.add(y).round(1, "ceil"), x.add(y).abs(), x.add(y).scale10(1), x.add(y).exponent(), x.add(y).remainder(z), sum, sum.add(product), x.add(y).compare(z) === 0]; });
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns >= 1
# RUN: run-in-shell --useDecimal=1 globalThis.sink = f => { for (const [x, y, z] of [["0.75", "0.25", "1"], ["999.5", "0.5", "1e30"]]) { const all = f(new Decimal(x), new Decimal(y), new Decimal(z)); let line = ""; for (let i = 0; i < all.length; i++) line += " " + (all[i] instanceof Decimal ? all[i].toExponential() : all[i]); print("of" + line); } };
# CHECK: of true 1 2e0 1e0 1e0 1e1 0 0e+0 1e0 1.1875e0 true
# CHECK-NEXT: of false 1000 1.000000000000000000000000001e30 1e3 1e3 1e4 3 1e3 1e3 1.49975e3 false
# CHECK-NEXT: exited with 0

