# made of b40476670bf9d3bc
# An object and a number are picked by one flag, and fields of both objects were read in front of the picks. What is read or written through the picked object is that object's, on either arm.
# Here the objects are lists, and the field is their length; the calls are written out.
# function pick(left, right, key, exact) { if (!left.length || !right.length || !left[0] || !right[0]) return "none"; const flag = exact ? key === left[0] : key < right[0]; const side = flag ? left : right; const first = flag ? left[0] : right[0]; if (first && side.length) return side.length * 100 + side[0]; return "leaf"; }
# report(pick([1, 2], [5, 6, 7], 1, false));
# report(pick([1, 2], [5, 6, 7], 1, true));
# report(pick([1, 2], [5, 6, 7], 3, false));
# report(pick([1, 2], [5, 6, 7], 3, true));
# report(pick([1, 2], [5, 6, 7], 9, false));
# report(pick([1, 2], [5, 6, 7], 9, true));
# report(pick([1], [], 1, false));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function pick(left, right, key, exact) { if (!left.length || !right.length || !left[0] || !right[0]) return "none"; const flag = exact ? key === left[0] : key < right[0]; const side = flag ? left : right; const first = flag ? left[0] : right[0]; if (first && side.length) return side.length * 100 + side[0]; return "leaf"; } report(pick([1, 2], [5, 6, 7], 1, false)); report(pick([1, 2], [5, 6, 7], 1, true)); report(pick([1, 2], [5, 6, 7], 3, false)); report(pick([1, 2], [5, 6, 7], 3, true)); report(pick([1, 2], [5, 6, 7], 9, false)); report(pick([1, 2], [5, 6, 7], 9, true)); report(pick([1], [], 1, false)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 8 of 8 of 8
# CHECK-NEXT: exited with 0

