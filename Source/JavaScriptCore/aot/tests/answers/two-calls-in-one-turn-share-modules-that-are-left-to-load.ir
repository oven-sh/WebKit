# Two calls of import() in one turn whose graphs share two modules that are left to load. Each module runs once, and each graph runs whole before its call settles.
# RUN: run-in-shell --aotCountsPath=/dev/null const atJob = now => { }; const begin = () => { first().then(() => print("first imported behind job " + job)); second().then(() => print("second imported behind job " + job)); Promise.all([first(), second()]).then(() => { isDone = true; walked(); }); }; let job = 0; let isDone = false; globalThis.report = (label, value) => print(label + ": " + value + " behind job " + job); const walked = () => print("walked " + aotRuntimeCounters().match(/^(\d+)\tcounter:CompiledModulesWalkedByLoader$/m)[1]); globalThis.register = (first, second) => { globalThis.first = first; globalThis.second = second; }; const start = globalThis.runCompiledEntryPoint; globalThis.runCompiledEntryPoint = entry => { const result = start(entry); Promise.resolve(result).then(() => { const next = () => { if (isDone) return; ++job; atJob(job); Promise.resolve().then(next); }; Promise.resolve().then(next); begin(); }); return result; };
