    v1 = Builtin builtin=LinkTimeConstantDecimalLiteral [isNotReadFromHolder]
    v2 = Call v1, -, v0
    v3 = String string="2"
    v4 = Builtin builtin=LinkTimeConstantDecimalLiteral [isNotReadFromHolder]
    v5 = Call v4, -, v3
    v6 = NewArray v2, v5 contents=anything
    Return v6
}
function f2 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=JSON
    v1 = PropGet v0 key="parse"
    v2 = Convert v1 declared={type=builtin(JSONParse) flags=[IsExpected]}
    v3 = String string="1.5"
    v4 = Call v2, v0, v3 calleeKey="parse" calleeName="JSON.parse"
    v5 = Builtin builtin=Object
    v6 = String string="2"
    v7 = Call v5, -, v6 calleeName="Object"
    v8 = NewArray v4, v7 contents=anything
    Return v8
}
function f3 module=m0 kind=Arrow length=1 thisType={type=anything} parameters=[{type=anything flags=[IsExpected]}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything):
