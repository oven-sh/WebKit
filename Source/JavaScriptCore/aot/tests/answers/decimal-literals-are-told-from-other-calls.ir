# A literal is computed in place though no method is called, another call with a constant is none, and a count is no place for one.
# sink(() => [1m, 2m], () => [JSON.parse("1.5"), Object("2")], x => x.round(1m), x => { const one = 1m; return x.add(one).toFixed({ digits: one }); });
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns = 4
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f, g, h, k) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); show(() => names(f())); show(() => typeof g()[0] + " " + (g()[1] instanceof String)); show(() => h(amounts[0])); show(() => k(amounts[0])); show(() => h({ round: literal => literal })); };
# CHECK: 0:1 1:2;
# CHECK-NEXT: number true;
# CHECK-NEXT: TypeError;
# CHECK-NEXT: TypeError;
# CHECK-NEXT: 1;
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
layout L0 module=m0 fields=[{key="digits" declared={type=anything} flags=[IsRequired]}] place=128 ownFieldCount=1
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = NewClosure function=f2
    v4 = NewClosure function=f3
    v5 = NewClosure function=f4
    v6 = Call v1, -, v2, v3, v4, v5 calleeName="sink"
    v7 = Undefined
    Return v7
}
function f1 module=m0 kind=Arrow thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
