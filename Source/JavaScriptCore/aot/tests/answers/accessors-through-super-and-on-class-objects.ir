# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Base { constructor() { this.held = 1 } get value() { return this.held } set value(next) { this.held = next } static get label() { return "label of " + this.tag } static set label(next) { this.tag = next } } Base.tag = "base"; class Derived extends Base { constructor() { super(); this.own = 1 } get value() { return super.value * 10 } set value(next) { super.value = next + 1 } static get label() { return "derived " + super.label } } Derived.tag = "derived"; const derived = new Derived(); report(derived.value); derived.value = 4; report(derived.held); report(derived.value); report(Base.label); report(Derived.label); Base.label = "changed"; report(Base.label); report(Derived.label); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
