# interface Point { x: number; y: number }
# let calls = 0;
# const log: string[] = [];
# function sum(point: Point): number { return point.x + point.y; }
# function countThenSum(point: Point): number { calls++; return point.x + point.y + calls * 100; }
# function sumThenCount(point: Point): number { const total = point.x + point.y; calls++; return total + calls * 100; }
# function between(point: Point): number { const x = point.x; log.push("between"); return x + point.y + log.length * 100; }
# function made(point: Point): Point { const copy: Point = { x: point.x, y: 0 }; copy.y = point.y; return copy; }
# function both(a: Point, b: Point): number { return a.x + a.y + b.x + b.y; }
# function stored(point: Point, other: Point): number { point.x = other.y; return point.x + point.y; }
# function storedLate(point: Point, other: Point): number { const y = other.y; point.x = y; return point.x + other.x; }
# register(sum, countThenSum, sumThenCount, between, made, both, stored, storedLate);
# Code that nobody knows calls these, so each has a typed body behind tests at its entrance and a generic version. A test that fails in the typed body before anything can be seen begins the call again in the generic version.
# The shell hands each function 15 points (a field outside its slot, getters that log, a proxy that logs, members from above) and runs the same text itself: the answers, the counters and the order of what the getters logged are the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const seen = []; let calls = 0; const log = []; globalThis.register = (...compiled) => { const twins = [function sum(point) { return point.x + point.y; }, function countThenSum(point) { calls++; return point.x + point.y + calls * 100; }, function sumThenCount(point) { const total = point.x + point.y; calls++; return total + calls * 100; }, function between(point) { const x = point.x; log.push("between"); return x + point.y + log.length * 100; }, function made(point) { const copy = { x: point.x, y: 0 }; copy.y = point.y; return copy; }, function both(a, b) { return a.x + a.y + b.x + b.y; }, function stored(point, other) { point.x = other.y; return point.x + point.y; }, function storedLate(point, other) { const y = other.y; point.x = y; return point.x + other.x; }]; const inputs = [() => ({ x: 1, y: 2 }), () => ({ x: 1.5, y: 2.5 }), () => ({ y: 2, x: 1 }), () => { const point = { x: 3, y: 4 }; delete point.y; point.y = 4; return point; }, () => { const point = { x: 3, y: 4 }; delete point.x; point.x = 3; return point; }, () => { const point = { x: 3, y: 4 }; delete point.x; delete point.y; point.y = 4; point.x = 3; return point; }, () => ({ x: 1, y: 2, z: 3 }), () => ({ get x() { seen.push("x"); return 5; }, y: 2 }), () => ({ x: 1, get y() { seen.push("y"); return 6; } }), () => ({ get x() { seen.push("x"); return 5; }, get y() { seen.push("y"); return 6; } }), () => Object.create({ x: 1, y: 2 }), () => Object.assign(Object.create({ y: 2 }), { x: 1 }), () => new Proxy({ x: 1, y: 2 }, { get(target, key) { seen.push(String(key)); return target[key]; } }), () => Object.freeze({ x: 1, y: 2 }), () => new (class { x = 1; y = 2; })()]; const show = (value, depth = 0) => { if (typeof value === "string") return JSON.stringify(value); if (typeof value === "symbol") return "symbol"; if (typeof value === "bigint") return value + "n"; if (typeof value === "function") return "function"; if (Object.is(value, -0)) return "-0"; if (typeof value !== "object" || value === null || depth > 2) return String(value); let text = Array.isArray(value) ? "[" : "{"; const keys = Reflect.ownKeys(value); for (let i = 0; i < keys.length; i++) { const described = Reflect.getOwnPropertyDescriptor(value, keys[i]); text += String(keys[i]) + ":" + ("value" in described ? show(described.value, depth + 1) : "accessor") + ","; } return text + "}"; }; const tell = (run, operand, other) => { seen.length = 0; try { return show(run(operand, other)) + " " + seen.join() + " " + show(operand); } catch (error) { return "throws " + error.name + " " + seen.join() + " " + show(operand); } }; for (let k = 0; k < compiled.length; k++) { let same = 0; for (let n = 0; n < inputs.length; n++) { const next = inputs[(n + 1) % inputs.length]; const got = tell(compiled[k], inputs[n](), next()), expected = tell(twins[k], inputs[n](), next()); if (got === expected) same++; else print(twins[k].name + " of " + inputs[n] + ": " + got.slice(0, 90) + " and not " + expected.slice(0, 90)); } print(twins[k].name + ": " + same + " of " + inputs.length); } }; })();
