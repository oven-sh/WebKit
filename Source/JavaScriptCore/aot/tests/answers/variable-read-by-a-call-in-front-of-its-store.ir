# Link follows the order in which a program starts and leaves the test of the dead zone out where every reader runs behind the store: here one call of each reader stands in front of it.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(f) { try { return f(); } catch (error) { return error.name; } } function read() { return late; } function inner() { return other + 1; } function outer() { return inner(); } report(attempt(read)); const early = attempt(outer); const late = "a"; let other = 1; report(attempt(read)); report(early); report(attempt(outer)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
