# `$isPlainHeirOf(object, Stream)`: THE DOOR OF A METHOD THAT A CLASS OF THE LIBRARY HANDS DOWN: its receivers are mostly objects of classes below, which the file of the class cannot name.
# It is `$isPlainInstanceOf` over the layout of the class and of every class below it by the written base, the library's or the program's: the walk lists them, and drops each one for whose objects the promise cannot be kept.
# `$findsDeclaredMember(object, "read", Stream)`: yes only where the member that a lookup finds is declared by Stream or above it: a class below that declares the name falls out of the receivers at build time.
# A yes of either door also says that `object instanceof Stream` is true and runs no code.
# function Stream(level) { this.level = level; this.state = "s"; }
# Stream.prototype.on = function () { return "on of Stream"; };                                  a function of the library
# Stream.prototype.read = function () { return "read of Stream"; };                              a function of the library
# function Message(level) { Stream.call(this, level); this.more = 1; }
# Object.setPrototypeOf(Message.prototype, Stream.prototype);
# Message.prototype.read = function () { return "read of Message"; };                            a function of the library
# function Leaf(level) { Message.call(this, level); }
# Object.setPrototypeOf(Leaf.prototype, Message.prototype);
# function Other(level) { this.level = level; this.state = "o"; }
# function road(object) { if ($isPlainHeirOf(object, Stream)) return "short " + object.level + object.state + ($findsDeclaredMember(object, "on", Stream) ? " on" : " -") + ($findsDeclaredMember(object, "read", Stream) ? " read" : " -"); return "full " + object.level + object.state; }
# function exact(object) { return $isPlainInstanceOf(object, Stream) ? "exact" : "-"; }
# const made = new Message(5);
# print(road(new Stream(1)), road(made), road(new Leaf(3)), road(new Other(4)), road({ level: 6, state: "l" }));
# print(exact(new Stream(1)), exact(made));
# change(made, Stream, Message);
# print(road(made), road(new Message(7)), road(new Stream(8)));
# f5 = road
# OPTIONS: mechanisms=all
# RUN(FORM): walk f5
# FORM: = IsPlainInstanceOf v0 conditions=[{layout=L0 side=Static key=@@hasInstance}, {layout=L0 side=Static key="prototype"}, {{*}}] receivers=[L0, L1, L2]
# FORM: L0|L1|L2{{*}} = Narrowed v0, {{*}}[isOnTakenEdge]
# FORM: = FindsDeclaredMember {{*}}key="on" {{*}}receivers=[L0, L1, L2]
# FORM: = FindsDeclaredMember {{*}}key="read" {{*}}receivers=[L0]
# The guards of each class are asked by that class's own count, which stands at nothing as long as no object of the class was made: the first call of all gets its yes.
# RUN(NOTHING): run-in-shell change = function () { };
# NOTHING: short 1s on read short 5s on - short 3s on - full 4o full 6l
# NOTHING-NEXT: exact -
# NOTHING-NEXT: short 5s on - short 7s on - short 8s on read
# NOTHING-NEXT: exited with 0
# RUN(ACCESSOR): run-in-shell change = function (made) { Object.defineProperty(made, "state", { get() { return "a"; }, configurable: true }); };
# ACCESSOR: short 1s on read short 5s on - short 3s on - full 4o full 6l
# ACCESSOR-NEXT: exact -
# ACCESSOR-NEXT: full 5a short 7s on - short 8s on read
# A count a class: what ends a guard of a class ends the yes for its objects and for those of the classes below it: an object of the class above keeps its yes.
# RUN(ABOVEHEIR): run-in-shell change = function (made, Stream, Message) { delete made.state; Object.defineProperty(Message.prototype, "state", { get() { return "above"; }, set(value) { }, configurable: true }); };
# ABOVEHEIR: short 1s on read short 5s on - short 3s on - full 4o full 6l
# ABOVEHEIR-NEXT: exact -
# ABOVEHEIR-NEXT: full 5above full 7above short 8s on read
# RUN(ONHEIR): run-in-shell change = function (made, Stream, Message) { Message.prototype.on = function () { return "on of Message"; }; };
# ONHEIR: short 1s on read short 5s on - short 3s on - full 4o full 6l
# ONHEIR-NEXT: exact -
# ONHEIR-NEXT: short 5s - - short 7s - - short 8s - read
# RUN(ONBASE): run-in-shell change = function (made, Stream, Message) { Stream.prototype.on = function () { return "wrapped"; }; };
# ONBASE: short 1s on read short 5s on - short 3s on - full 4o full 6l
# ONBASE-NEXT: exact -
# ONBASE-NEXT: short 5s - - short 7s - - short 8s - read
# What would make `object instanceof Stream` another question.
# RUN(HASINSTANCE): run-in-shell change = function (made, Stream, Message) { Object.defineProperty(Stream, Symbol.hasInstance, { value() { return false; } }); };
# HASINSTANCE: short 1s on read short 5s on - short 3s on - full 4o full 6l
# HASINSTANCE-NEXT: exact -
# HASINSTANCE-NEXT: full 5s full 7s full 8s
# RUN(PROTOTYPE): run-in-shell change = function (made, Stream, Message) { Stream.prototype = { }; };
# PROTOTYPE: short 1s on read short 5s on - short 3s on - full 4o full 6l
# PROTOTYPE-NEXT: exact -
# PROTOTYPE-NEXT: full 5s full 7s full 8s
# RUN(HEIRSLINK): run-in-shell change = function (made, Stream, Message) { Object.setPrototypeOf(Message.prototype, { }); };
# HEIRSLINK: short 1s on read short 5s on - short 3s on - full 4o full 6l
# HEIRSLINK-NEXT: exact -
# HEIRSLINK-NEXT: full 5s full 7s short 8s - read

