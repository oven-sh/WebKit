# function look(p) { return p.x; }
# function has(p) { return "x" in p; }
# class P { constructor() { this.seen = look(this); this.had = has(this); this.x = 5; } }
# const p = new P();
# report(p.seen);
# report(p.had);
# report(look(p));
# report(has(p));
# report("end");
# The constructor hands this to a function in front of the store, and the function reads and tests the field.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function look(p) { return p.x; } function has(p) { return "x" in p; } class P { constructor() { this.seen = look(this); this.had = has(this); this.x = 5; } } const p = new P(); report(p.seen); report(p.had); report(look(p)); report(has(p)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 5 of 5 of 5
# CHECK-NEXT: exited with 0

