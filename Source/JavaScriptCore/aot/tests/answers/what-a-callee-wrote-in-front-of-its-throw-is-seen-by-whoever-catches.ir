# made of 3130f2c416bf1b8d
# a callee writes a field and throws: the caller that catches sees the field in its handler and behind it, and so does the caller of a function that swallows the throw
# the form is that of set(), whichever number it has
# RUN(FORM): summary
# FORM: access {{*}}"bad" {{*}}on-no-way-to-return
# class Cell { v: number; bad: number; constructor() { this.v = 0; this.bad = 0; } }
# function set(o: Cell, v: number) { if (v < 0) { o.bad = v; throw v; } o.v = v; }
# function swallow(o: Cell, v: number) { try { set(o, v); } catch (e) { return false; } return true; }
# function guarded(o: Cell, v: number) { const before = o.bad; try { set(o, v); } catch (e) { return before * 100 + o.bad; } return before * 100 + o.bad + o.v; }
# function outer(o: Cell, v: number) { const before = o.bad; swallow(o, v); return before * 100 + o.bad + o.v; }
# function inLoop(o: Cell) { let s = 0; for (let i = 0; i < 3; i++) { swallow(o, i - 2); s = s * 10 + o.bad + o.v; } return s; }
# report(guarded(new Cell(), -1));
# report(guarded(new Cell(), 4));
# report(outer(new Cell(), -3));
# report(outer(new Cell(), 3));
# report(inLoop(new Cell()));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Cell { v; bad; constructor() { this.v = 0; this.bad = 0; } } function set(o, v) { if (v < 0) { o.bad = v; throw v; } o.v = v; } function swallow(o, v) { try { set(o, v); } catch (e) { return false; } return true; } function guarded(o, v) { const before = o.bad; try { set(o, v); } catch (e) { return before * 100 + o.bad; } return before * 100 + o.bad + o.v; } function outer(o, v) { const before = o.bad; swallow(o, v); return before * 100 + o.bad + o.v; } function inLoop(o) { let s = 0; for (let i = 0;i < 3; i++) { swallow(o, i - 2); s = s * 10 + o.bad + o.v; } return s; } report(guarded(new Cell, -1)); report(guarded(new Cell, 4)); report(outer(new Cell, -3)); report(outer(new Cell, 3)); report(inLoop(new Cell)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 6 of 6 of 6
# CHECK-NEXT: exited with 0

