# `$isPlainInstanceOf(object, Meter)` WHERE FIELDS STAND OVER PLAIN VALUES OF THE SAME NAMES ON THE PROTOTYPE, as _events and _eventsCount of an emitter of events do.
# function Meter(level) { this.level = level; this.count = 1; this.events = undefined; }
# Meter.prototype.count = 0;
# Meter.prototype.events = undefined;
# Meter.prototype.read = function () { return this.level; };
# function ask(object) { return $isPlainInstanceOf(object, Meter) ? "plain" : "-"; }      in a file of the library
# const made = new Meter(5);
# print(ask(made), ask(new Meter(6)));
# change(made, Meter);
# print(ask(made), ask(new Meter(8)));
# print(made.read(), made.count, made.events);
# A field that hides a value above ends the guards by which READS find that value. The question asks the guards of STORES, which such a field leaves alone: a plain value above runs no code.
# OPTIONS: mechanisms=all
# RUN(NOTHING): run-in-shell change = function () { };
# NOTHING: plain plain
# NOTHING-NEXT: plain plain
# NOTHING-NEXT: 5 1 undefined
# NOTHING-NEXT: exited with 0
# RUN(STORES): run-in-shell change = function (made) { made.count = 7; made.events = "e"; };
# STORES: plain plain
# STORES-NEXT: plain plain
# STORES-NEXT: 5 7 e
# Here the plan counts on `count` from birth on, so a delete of it marks the object: it gets a no, the others do not.
# RUN(DELETED): run-in-shell change = function (made) { delete made.count; };
# DELETED: plain plain
# DELETED-NEXT: - plain
# DELETED-NEXT: 5 0 undefined
# RUN(ABOVE): run-in-shell change = function (made, Meter) { delete made.count; Object.defineProperty(Meter.prototype, "count", { get() { return "above"; }, set(value) { }, configurable: true }); };
# ABOVE: plain plain
# ABOVE-NEXT: - -
# ABOVE-NEXT: 5 above undefined

