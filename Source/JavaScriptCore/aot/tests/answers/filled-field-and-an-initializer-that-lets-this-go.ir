# An initializer of fields lets this go (an arrow function, a variable, a call) in front of the fields that follow.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class P { f = () => this.x; seen = this.f(); x = 4; after = this.f(); } let kept = null; class Q { a = 1; b = (kept = this, 2); c = 3; } function readC(q) { return q.c; } class R { a = 1; b = readC2(this); c = 3; } function readC2(r) { return r.c; } const p = new P(); report(p.seen); report(p.after); const q = new Q(); report(readC(q)); report(kept === q); const r = new R(); report(r.b); report(readC2(r)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
