  b0(v0: anything):
    v1 = TypeTest v0 testedType=L2|L3
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = PropGet v2 key="scale"
    Return v3
  b2(v4):
    v5 = PropGet v4 key="scale"
    Return v5
}
function f2 name="setScale" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = TypeTest v0 testedType=L2|L3
    Branch v2 -> taken b1(| 0), notTaken b2(| 0)
  b1(v3):
    PropSet v3, v1 key="scale"
    Return v1
  b2(v5):
    PropSet v5, v1 key="scale"
    Return v1
}
function f3 name="hasScale" module=m0 length=1 thisType={type=anything} parameters=[{type=anything}] results=[{type=anything}] {
  b0(v0: anything):
    v1 = TypeTest v0 testedType=L2|L3
    Branch v1 -> taken b1(| 0), notTaken b2(| 0)
  b1(v2):
    v3 = PropHas v2 key="scale"
    Return v3
  b2(v4):
    v5 = PropHas v4 key="scale"
    Return v5
}
function f4 name="circle" module=m0 length=2 thisType={type=anything} parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
  b0(v0: anything, v1: anything):
    v2 = String string="circle"
