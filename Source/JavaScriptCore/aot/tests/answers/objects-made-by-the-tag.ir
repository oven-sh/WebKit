# tell(() => describe(ofAnyKind(-0, 5)) + " " + Object.is(ofAnyKind(-0, 5).kind, -0));
# tell(() => describe(ofAnyKind(NaN, 5)));
# tell(() => describe(ofAnyKind("1" as any, 5)) + " " + held(ofAnyKind("1" as any, 5)));
# tell(() => describe(ofAnyKind(undefined as any, 5)));
