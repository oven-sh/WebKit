# made of ada62d4058e2b418
# A descriptor lays a getter on a function object, under a name that is written, and the function asks itself under that name at every call. Where closures of that one function are all that arrives at the read, it expects the getter.
# Each closure has a getter with captures of its own: the code calls what the lookup has found.
# f1 = createLogger, f2 = log, f3 = enabled, f4 = enable
# RUN(HELD): link accesses held mechanisms=all
# HELD: read f2 {{*}} expects getter f3
# HELD-NOT: expects getter
# RUN(PROVEN): link accesses mechanisms=all
# PROVEN-NOT: expects getter
# RUN(WALK): walk f2 mechanisms=all
# WALK: = GetCachedGetter {{*}}key="enabled"
# WALK: = TypeTest {{*}}testedType=f3
# function createLogger(namespace: string): any { let override: boolean | null = null; const cached = namespace.length > 3; let calls = 0; function log(text: string) { if (!(log as any).enabled) return 0; calls++; return text.length + calls; } (log as any).namespace = namespace; Object.defineProperty(log, "enabled", { enumerable: true, configurable: false, get: function enabled() { return override !== null ? override : cached; }, set: function enable(value: boolean) { override = value; } }); return log; }
# const first = createLogger("first");
# const off = createLogger("off");
# let sum = 0;
# for (let i = 0; i < 300; i++) sum += first("abc") + off("abc");
# report(sum);
# off.enabled = true;
# for (let i = 0; i < 300; i++) sum += first("abc") + off("abc");
# report(sum);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function createLogger(namespace) { let override = null; const cached = namespace.length > 3; let calls = 0; function log(text) { if (!log.enabled) return 0; calls++; return text.length + calls; } log.namespace = namespace; Object.defineProperty(log, "enabled", { enumerable: true, configurable: false, get: function enabled() { return override !== null ? override : cached; }, set: function enable(value) { override = value; } }); return log; } const first = createLogger("first"); const off = createLogger("off"); let sum = 0; for (let i = 0;i < 300; i++) sum += first("abc") + off("abc"); report(sum); off.enabled = true; for (let i = 0;i < 300; i++) sum += first("abc") + off("abc"); report(sum); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

