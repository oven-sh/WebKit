# A CLASS THAT MAY BE EVALUATED AGAIN IS A PLAIN HEIR WHILE ITS GUARDS HOLD: `Meter` is written in a function that code nobody has seen may call again, so nothing proves one evaluation.
# The run time arms the guards of the class at its first evaluation and ends every one of them, for good, at the second: the question asks guards of that very class, so it may take the class.
# class Base { constructor() { this.low = 1; } reach() { return "reach"; } get scale() { return 10; } set scale(value) { } }
# function make() { return class Meter extends Base { constructor(level) { super(); this.level = level; } read() { return this.level; } get twice() { return this.level * 2; } }; }
# function ask(object) { return $isPlainHeirOf(object, Base) ? "yes" : "no"; }            in a file of the library, expects a Meter or a Base
# const First = make(); keep(First); keep(Base);
# const asks = keep(ask), early = new First(1);
# print(asks(early), asks(new Base()));
# const Second = again(make, First);
# print(asks(new First(3)), asks(new Second(4)), asks(early), asks(new Base()));
# OPTIONS: mechanisms=all
# RUN(FORM): walk f1
# FORM: = IsPlainInstanceOf v0 conditions=[{{*}}] receivers=[L0, L1]
# RUN(ONCE): run-in-shell keep = x => x; again = function (make, First) { return First; };
# ONCE: yes yes
# ONCE-NEXT: yes yes yes yes
# RUN(AGAIN): run-in-shell keep = x => x; again = function (make) { return make(); };
# AGAIN: yes yes
# AGAIN-NEXT: no no no yes
# RUN(AGAINUNUSED): run-in-shell keep = x => x; again = function (make, First) { make(); return First; };
# AGAINUNUSED: yes yes
# AGAINUNUSED-NEXT: no no no yes
# RUN(GETTER): run-in-shell keep = x => x; again = function (make, First) { Object.defineProperty(First.prototype, "other", { get() { return 1; }, configurable: true }); return First; };
# GETTER: yes yes
# GETTER-NEXT: no no no yes
# RUN(ABOVE): run-in-shell keep = x => x; again = function (make, First) { Object.defineProperty(Object.getPrototypeOf(First.prototype), "other", { get() { return 1; }, configurable: true }); return First; };
# ABOVE: yes yes
# ABOVE-NEXT: no no no no

