# The copy of the loop for strings calls the method as it is written.
# sink(list => { let total = 0m; for (let i = 0; i < list.length; i++) total = total.add(list[i]); return total; });
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalsReused >= 1
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); show(() => f(amounts)); show(() => f("1")); show(() => f("")); show(() => f({ length: 2, 0: amounts[0], 1: amounts[1] })); };
# CHECK: 6;
# CHECK-NEXT: TypeError;
# CHECK-NEXT: 0;
# CHECK-NEXT: 1;
