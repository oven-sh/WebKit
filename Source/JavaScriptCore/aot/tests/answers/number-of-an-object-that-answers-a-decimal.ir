# report(Number(value));
# valueOf must answer a primitive. A Decimal is an object, so toString is asked next, and its text converted.
# RUN: run-in-shell --useDecimal=1 globalThis.value = ({ valueOf: () => new Decimal("1"), toString: () => "3.5" }); globalThis.report = number => print(typeof number, number);
# CHECK: number 3.5
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    Jump -> next b1()
  b1():
    v0 = Builtin builtin=Number
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="value" [isFreeName]
    v3 = Call v0, -, v2 calleeName="Number"
    v4 = Builtin builtin=GlobalThis
    v5 = PropGet v4 key="report" [isFreeName]
    v6 = Call v5, -, v3 calleeName="report"
    v7 = Undefined
    Return v7
}
