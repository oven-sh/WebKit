# Symbol.for(text) finds the one symbol that is registered under the text: a field under it is a field under a name, for whoever spells the text and however.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const kState = Symbol.for("registered.state"); const kCount = Symbol.for("registered.count"); const kOwn = Symbol("registered.state"); function Holder(name) { this.name = name; this[kState] = null; this[kOwn] = "own"; this[kCount] = 0; } Holder.prototype.bump = function() { this[kCount] += 1; this[kState] = "bumped " + this[kCount]; return this; }; class Boxed { [kState] = "boxed"; [kCount] = 7; plain = 1; } const spell = (parts) => Symbol.for(parts.join(".")); const show = (o) => Reflect.ownKeys(o).map(String).join() + "|" + String(o[kState]) + "|" + String(o[kCount]); const made = new Holder("first"); report(show(made)); report(show(made.bump().bump())); report(kState === spell(["registered", "state"])); report(kState === kOwn); report(Symbol.keyFor(kState)); report(Symbol.keyFor(kOwn)); report(kState.description); report(made[spell(["registered", "count"])]); made[spell(["registered", "state"])] = "through the registry"; report(made[kState]); const outside = new Function("o", "o[Symbol.for('registered.count')] += 40; return Symbol.for('registered.state') in o;"); report(outside(made)); report(made[kCount]); report(delete made[spell(["registered", "count"])]); report(show(made)); made[kCount] = 5; report(show(made)); const boxed = new Boxed; report(show(boxed)); report(Object.getOwnPropertySymbols(boxed).map((s) => Symbol.keyFor(s)).join()); let same = 0; const seen = []; for (let i = 0;i < 3; i++) { const inLoop = Symbol.for("registered.loop"); const fresh = Symbol("registered.loop"); seen.push(fresh); if (inLoop === Symbol.for("registered.loop")) same++; made[inLoop] = i; } report(same); report(new Set(seen).size); report(made[Symbol.for("registered.loop")]); const literal = { [kState]: "literal", other: 2, [kCount]: 3 }; report(show(literal)); report(JSON.stringify(literal)); const { [kState]: taken, ...rest } = literal; report(taken + "|" + show(rest)); report(Object.prototype.hasOwnProperty.call(made, kState) + "|" + (kCount in boxed) + "|" + Object.hasOwn(rest, kState)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
