# `flags.n3`, where `flags` is an ordinary object on which a loop has laid closures of one function as getters, by descriptors under computed names. The code that reads looks the getter up, tests that it is a closure of that function, and calls it itself. Another function under the name, a value, a deletion and a name that was never laid go by the read as it is written.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const names = []; for (let i = 0;i < 40; i++) names.push("n" + i); function getterOf(name, weight, holder) { return function() { return name + ":" + weight + ":" + (this === holder ? "own" : "other"); }; } function build(weight) { const flags = Object.create(null); for (let k = 0;k < names.length; k++) { const name = names[k]; Object.defineProperty(flags, name, { get: getterOf(name, weight, flags), enumerable: true, configurable: true }); } return flags; } function descriptorOf(get, set) { return { get, set, configurable: true }; } function plain() { const values = Object.create(null); for (let k = 0;k < names.length; k++) values[names[k]] = "plain " + k; return values; } const flags = build(1); const others = build(2); let current = flags; function three() { return current.n3 + " " + current.n17 + " " + current.n39; } function missing() { return String(current.nothing); } function attempt() { try { return three(); } catch (e) { return e instanceof RangeError ? "RangeError" : e instanceof TypeError ? "TypeError" : "other error"; } } function warm(of) { current = of; let last = ""; for (let i = 0;i < 300; i++) last = attempt(); return last; } report(warm(flags)); report(warm(others)); report(missing()); Object.defineProperty(flags, "n17", descriptorOf(function() { return "another function"; }, undefined)); report(warm(flags)); report(warm(others)); Object.defineProperty(flags, "n3", { value: "a value", writable: true, configurable: true }); report(warm(flags)); delete flags.n39; report(warm(flags)); Object.defineProperty(flags, "n39", descriptorOf(undefined, function(v) {})); report(warm(flags)); Object.defineProperty(others, "n3", descriptorOf(getterOf("moved", 3, flags), undefined)); report(warm(others)); Object.defineProperty(others, "n39", descriptorOf(function() { throw new RangeError("thrown"); }, undefined)); report(warm(others)); report(warm(Object.create(build(4)))); report(warm(plain())); report(warm(build(5))); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
