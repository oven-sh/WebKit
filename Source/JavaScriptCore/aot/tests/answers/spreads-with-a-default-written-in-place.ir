# made of 65a6d690273a9854
# `{ a, ...(given ?? { b }) }` and `{ a, ...(given || { b }) }`: the value on the left is spread where it decides, whatever it is, and the members of the literal are defined where it does not. Everything is evaluated once, in the order written
# f1 = nullish, f2 = falsy
# the form is the front end's, so it stands in the records: they are made by a front end that has bun/src/aot/lower/object/spread_with_default.rs. Made by any other they hold a join and one CopyDataProperties, and the run of the form is red whatever the engine does
# RUN(FORM): walk f1 mechanisms=none
# FORM-LABEL: code f1:Body
# FORM: PropDefine {{*}}key="b"
# function nullish(a: number, given: any) { return { a, ...(given ?? { b: 2 }) }; }
# function falsy(a: number, given: any) { return { a, ...(given || { b: 2 }) }; }
# function empty(a: number, given: any) { return { a, ...(given ?? {}), z: 9 }; }
# function nested(a: number, first: any, second: any) { return { a, ...(first ?? second ?? { b: 2 }) }; }
# function ordered(log: string[], given: any) { return { a: note(log, "a"), ...(note(log, given) ?? { b: note(log, "b") }), c: note(log, "c") }; }
# function note(log: string[], v: any) { log[0] += typeof v === "string" ? v : "?"; return v; }
# function show(o: any) { let s = ""; for (const k in o) s += k + "=" + String(o[k]) + ";"; return s; }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# function all(given: any) { tell(() => show(nullish(1, given))); tell(() => show(falsy(1, given))); tell(() => show(empty(1, given))); tell(() => show(nested(1, given, undefined))); tell(() => show(nested(1, undefined, given))); tell(() => { const log = [""]; return show(ordered(log, given)) + log[0]; }); }
# all(undefined);
# all(null);
# all(0);
# all("");
# all(false);
# all(NaN);
# all("xy");
# all(5);
# all({ b: 9, q: 1 });
# all({ a: "over" });
# all({});
# all([7]);
# all(new Proxy({ b: 3 }, {}));
# all({ get b() { return "got"; } });
# tell(() => { let s = 0; for (let i = 0; i < 300; i++) s += nullish(i, i % 2 ? undefined : { b: i }).b; return s; });
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function nullish(a, given) { return { a, ...given ?? { b: 2 } }; } function falsy(a, given) { return { a, ...given || { b: 2 } }; } function empty(a, given) { return { a, ...given ?? {}, z: 9 }; } function nested(a, first, second) { return { a, ...first ?? second ?? { b: 2 } }; } function ordered(log, given) { return { a: note(log, "a"), ...note(log, given) ?? { b: note(log, "b") }, c: note(log, "c") }; } function note(log, v) { log[0] += typeof v === "string" ? v : "?"; return v; } function show(o) { let s = ""; for (const k in o) s += k + "=" + String(o[k]) + ";"; return s; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function all(given) { tell(() => show(nullish(1, given))); tell(() => show(falsy(1, given))); tell(() => show(empty(1, given))); tell(() => show(nested(1, given, undefined))); tell(() => show(nested(1, undefined, given))); tell(() => { const log = [""]; return show(ordered(log, given)) + log[0]; }); } all(undefined); all(null); all(0); all(""); all(false); all(NaN); all("xy"); all(5); all({ b: 9, q: 1 }); all({ a: "over" }); all({}); all([7]); all(new Proxy({ b: 3 }, {})); all({ get b() { return "got"; } }); tell(() => { let s = 0; for (let i = 0;i < 300; i++) s += nullish(i, i % 2 ? undefined : { b: i }).b; return s; }); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
