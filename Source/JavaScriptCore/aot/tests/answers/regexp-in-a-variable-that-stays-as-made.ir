# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const marks = /b/g; const sticky = /b/y; function strip(text) { return text.replace(marks, "x"); } function first(text) { return text.replace(sticky, "x"); } function width(text) { let n = 0; for (const ch of strip(text)) n += ch.codePointAt(0) > 255 ? 2 : 1; return n; } report(strip("abcb")); marks.lastIndex = 3; report(strip("abcb")); report(marks.lastIndex); sticky.lastIndex = 1; report(first("abcb")); report(sticky.lastIndex); report(first("abcb")); report(sticky.lastIndex); report(width("ab中😀b")); report(strip("")); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
