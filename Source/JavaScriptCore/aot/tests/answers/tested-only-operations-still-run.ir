# The two arms of a test do the same. What is tested is still done: a list gets shorter, a getter and a conversion run, a read of undefined throws.
# At the end the shell runs the same text itself: every answer is the same.
# FORM: AsRead
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let said = ""; const holder = { get now() { said += "now,"; return 1; } }; function shortens(list) { if (list.pop()) {} return list.length; } function asks(object) { if (object.now) {} return said; } function reads(object) { try { if (object.inner.value) {} return "read"; } catch { return "threw"; } } function converts(value) { if (value > 1) {} return said; } report(shortens([1, 2, 3])); report(asks(holder)); report(reads({ inner: { value: 1 } })); report(reads({})); report(converts({ valueOf() { said += "valueOf,"; return 2; } })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
