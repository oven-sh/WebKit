# made of aeeac7f58c6dbca5
# An object and a number are picked by one flag, and fields of both objects were read in front of the picks. What is read or written through the picked object is that object's, on either arm.
# Here the flag comes out of a ternary of two comparisons; one of the picks asks for the opposite of the flag; the calls are written out.
# class Node { constructor(key, weight, child) { this.key = key; this.weight = weight; this.child = child; } get() { return this.key * 2; } }
# function tree(kind) { const made = { left: new Node(1, 2, new Node(10, 1, null)), right: new Node(5, 3, new Node(50, 1, null)) }; if (kind === 1) made.right.weight = 0; if (kind === 2) made.left.child = null; if (kind === 3) made.left.weight = 0; if (kind === 4) made.right.child = null; return made; }
# function pick(tree, key, exact) { const left = tree.left, right = tree.right; if (!left.weight || !right.weight || !left.child || !right.child) return "none"; const flag = exact ? key === left.key : key < right.key; const side = !flag ? right : left; const weight = flag ? left.weight : right.weight; if (weight && side.child) return side.child.key; return "leaf"; }
# report(pick(tree(0), 1, false));
# report(pick(tree(0), 1, true));
# report(pick(tree(0), 3, false));
# report(pick(tree(0), 3, true));
# report(pick(tree(0), 9, false));
# report(pick(tree(0), 9, true));
# report(pick(tree(1), 1, false));
# report(pick(tree(1), 1, true));
# report(pick(tree(1), 3, false));
# report(pick(tree(1), 3, true));
# report(pick(tree(1), 9, false));
# report(pick(tree(1), 9, true));
# report(pick(tree(2), 1, false));
# report(pick(tree(2), 1, true));
# report(pick(tree(2), 3, false));
# report(pick(tree(2), 3, true));
# report(pick(tree(2), 9, false));
# report(pick(tree(2), 9, true));
# report(pick(tree(3), 1, false));
# report(pick(tree(3), 1, true));
# report(pick(tree(3), 3, false));
# report(pick(tree(3), 3, true));
# report(pick(tree(3), 9, false));
# report(pick(tree(3), 9, true));
# report(pick(tree(4), 1, false));
# report(pick(tree(4), 1, true));
# report(pick(tree(4), 3, false));
# report(pick(tree(4), 3, true));
# report(pick(tree(4), 9, false));
# report(pick(tree(4), 9, true));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Node { constructor(key, weight, child) { this.key = key; this.weight = weight; this.child = child; } get() { return this.key * 2; } } function tree(kind) { const made = { left: new Node(1, 2, new Node(10, 1, null)), right: new Node(5, 3, new Node(50, 1, null)) }; if (kind === 1) made.right.weight = 0; if (kind === 2) made.left.child = null; if (kind === 3) made.left.weight = 0; if (kind === 4) made.right.child = null; return made; } function pick(tree, key, exact) { const left = tree.left, right = tree.right; if (!left.weight || !right.weight || !left.child || !right.child) return "none"; const flag = exact ? key === left.key : key < right.key; const side = !flag ? right : left; const weight = flag ? left.weight : right.weight; if (weight && side.child) return side.child.key; return "leaf"; } report(pick(tree(0), 1, false)); report(pick(tree(0), 1, true)); report(pick(tree(0), 3, false)); report(pick(tree(0), 3, true)); report(pick(tree(0), 9, false)); report(pick(tree(0), 9, true)); report(pick(tree(1), 1, false)); report(pick(tree(1), 1, true)); report(pick(tree(1), 3, false)); report(pick(tree(1), 3, true)); report(pick(tree(1), 9, false)); report(pick(tree(1), 9, true)); report(pick(tree(2), 1, false)); report(pick(tree(2), 1, true)); report(pick(tree(2), 3, false)); report(pick(tree(2), 3, true)); report(pick(tree(2), 9, false)); report(pick(tree(2), 9, true)); report(pick(tree(3), 1, false)); report(pick(tree(3), 1, true)); report(pick(tree(3), 3, false)); report(pick(tree(3), 3, true)); report(pick(tree(3), 9, false)); report(pick(tree(3), 9, true)); report(pick(tree(4), 1, false)); report(pick(tree(4), 1, true)); report(pick(tree(4), 3, false)); report(pick(tree(4), 3, true)); report(pick(tree(4), 9, false)); report(pick(tree(4), 9, true)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
