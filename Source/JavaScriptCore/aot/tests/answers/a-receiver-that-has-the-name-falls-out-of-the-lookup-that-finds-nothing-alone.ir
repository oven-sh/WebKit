# ONE CLASS THAT HAS THE NAME DOES NOT SHUT `$findsNoMember(object, name)` FOR THE OTHERS. An heir that lays `write = () => ..` as a class field has the name on its own objects: they get a no, by their shape.
# The objects of the class asked and of an heir that declares nothing keep the question. (It used to be left as written, the constant false for every object.) A name that every receiver finds (`end`) stays a no for all.
# function Base() { this.state = 1; }
# Base.prototype.emit = function () { return 1; };
# Base.prototype.end = function () { return 2; };
# class Heir extends Base { write = () => 3; }
# class Quiet extends Base { }
# function ask(object) { return $isPlainHeirOf(object, Base) ? "yes " + $findsNoMember(object, "write") + " " + $findsNoMember(object, "end") + " " + object.emit() : "no " + object.emit(); }            in a file of the library
# const Bases = keep(Base), Heirs = keep(Heir), Quiets = keep(Quiet), asks = keep(ask);
# print(asks(new Bases()), "|", asks(new Heirs()), "|", asks(new Quiets()));
# lay(Bases.prototype);
# print(asks(new Bases()), "|", asks(new Heirs()), "|", asks(new Quiets()));
