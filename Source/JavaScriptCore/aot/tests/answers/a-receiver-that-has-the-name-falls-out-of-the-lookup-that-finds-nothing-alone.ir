# RUN(QUIET): run-in-shell keep = x => x; lay = function () { };
# QUIET: yes true false 1 | yes false false 1 | yes true false 1
# QUIET-NEXT: yes true false 1 | yes false false 1 | yes true false 1
# QUIET-NEXT: exited with 0
# RUN(LAID): run-in-shell keep = x => x; lay = function (prototype) { prototype.write = function () { return 4; }; };
# LAID: yes true false 1 | yes false false 1 | yes true false 1
# LAID-NEXT: yes false false 1 | no 1 | yes false false 1
# LAID-NEXT: exited with 0
# RUN(OWN): run-in-shell keep = x => x.name === "Quiet" ? function () { const made = new x(); made.write = 5; return made; } : x; lay = function () { };
# OWN: yes true false 1 | yes false false 1 | yes false false 1
# OWN-NEXT: yes true false 1 | yes false false 1 | yes false false 1
# OWN-NEXT: exited with 0
# RUN(BUILT): walk f2
# BUILT: = FindsNoMember {{*}}key="write"{{*}}receivers=[L0, L2]

