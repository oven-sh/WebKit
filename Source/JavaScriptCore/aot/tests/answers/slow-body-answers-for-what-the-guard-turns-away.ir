# made of 3f95a79222cf9d53
# A function whose parameters are tested at its entry has a slow body for whatever the test turns away. With testing=WritesBodiesStraight it is written straight, as every body is.
# Without the switch the slow bodies alone are written straight: a-slow-body-is-written-straight.ir.
# OPTIONS: testing=WritesBodiesStraight
# RUN(STRAIGHT): compile UnitsWrittenStraight mechanisms=all
# REQUIRES(STRAIGHT): faulting-loop-polls
# STRAIGHT: statistic UnitsWrittenStraight 15
# RUN(WITHHELD): compile UnitsWrittenStraight mechanisms=all-ParameterGuards
# REQUIRES(WITHHELD): faulting-loop-polls
# WITHHELD: statistic UnitsWrittenStraight 12
# class Point { x: number; y: number; constructor(x: number, y: number) { this.x = x; this.y = y; } }
# function norm(p: Point, scale: number): number { let sum = 0; for (let i = 0; i < 3; i++) sum += p.x * scale + p.y; return sum; }
# function label(p: Point, prefix: string): string { return prefix + ":" + p.x + "," + p.y; }
# function grow(p: Point, by: number): Point { const next = new Point(p.x + by, p.y + by); return next; }
# function tell(f: () => unknown) { try { return String(f()); } catch (e) { return "threw " + (e as Error).name; } }
# const whole = new Point(1, 2);
# const others: any[] = [{ x: 3, y: 4 }, { y: 5, x: "s" }, { get x() { return 6; }, y: 7 }, null, undefined, 8, "text", [9, 10]];
# for (let round = 0; round < 3; round++) { report(norm(whole, 2)); report(label(whole, "p")); report(grow(whole, round).x); }
# for (let which = 0; which < 8; which++) { const other = others[which]; report(tell(() => norm(other, 2))); report(tell(() => norm(whole, other))); report(tell(() => label(other, "q"))); report(tell(() => label(whole, other))); report(tell(() => grow(other, 1).x)); report(tell(() => grow(whole, other).y)); }
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Point { x; y; constructor(x, y) { this.x = x; this.y = y; } } function norm(p, scale) { let sum = 0; for (let i = 0;i < 3; i++) sum += p.x * scale + p.y; return sum; } function label(p, prefix) { return prefix + ":" + p.x + "," + p.y; } function grow(p, by) { const next = new Point(p.x + by, p.y + by); return next; } function tell(f) { try { return String(f()); } catch (e) { return "threw " + e.name; } } const whole = new Point(1, 2); const others = [{ x: 3, y: 4 }, { y: 5, x: "s" }, { get x() { return 6; }, y: 7 }, null, undefined, 8, "text", [9, 10]]; for (let round = 0;round < 3; round++) { report(norm(whole, 2)); report(label(whole, "p")); report(grow(whole, round).x); } for (let which = 0;which < 8; which++) { const other = others[which]; report(tell(() => norm(other, 2))); report(tell(() => norm(whole, other))); report(tell(() => label(other, "q"))); report(tell(() => label(whole, other))); report(tell(() => grow(other, 1).x)); report(tell(() => grow(whole, other).y)); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 58 of 58 of 58
# CHECK-NEXT: exited with 0

