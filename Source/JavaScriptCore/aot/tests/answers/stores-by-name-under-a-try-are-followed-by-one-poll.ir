# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const box = JSON.parse('{"held":null}'); function unknown(value) { box.held = value; return box.held; } function storeThree(o, i) { try { o.a = i; o.b = i; o.c = i; } catch (error) { return "caught"; } return "stored"; } function storeOutside(o, i) { o.a = i; o.b = i; return "stored"; } const first = unknown({}); report(storeThree(first, 1)); report(first.a + first.b + first.c); report(storeThree(unknown(Object.freeze({})), 2)); report(storeThree(unknown(null), 3)); report(storeThree(unknown({ set b(value) { throw new Error("no"); } }), 4)); report(storeOutside(unknown({}), 5)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
