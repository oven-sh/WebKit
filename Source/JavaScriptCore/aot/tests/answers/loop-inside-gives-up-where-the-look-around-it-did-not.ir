# The looks at the outer loop follow both sides of the branch, see a number or a text enter the inner loop, and settle at once. The walk decides the branch and sees a number enter, and its own looks at the inner loop widen what grows.
# The inner loop takes what the outer looks settled on, so what leaves it lies within what the outer head was promised.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function off() { return false; } function run(n) { let r = 0; for (let i = 0; i < n; i++) { let a = off() ? "s" : 0, b = a, c = a; for (let j = 0; j < 3; j++) { c = b; b = a; a = "s"; } r = c; } return r; } report(run(2)); report(run(0)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
