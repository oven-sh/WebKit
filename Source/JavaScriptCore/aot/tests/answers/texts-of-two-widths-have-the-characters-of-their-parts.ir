# made of 842393fe81b62d4e
# a narrow text joined with a wide one is made by the program, and its characters are known: its length, a comparison, its code units, a longer join with numbers and null, two halves of a pair that meet, the empty text, and the same in a loop
# a text that both sides of a condition write alike is no constant to the front end and one to the walk. Each such text has a second reader: a join of texts that alone reads what the ways bring is walked once for each way
# (findOperationsThatWaysDecide()), and behind the meeting the text is a parameter of a block, of which no characters are noted
# f1 = lengths, f2 = same, f3 = other, f4 = units, f5 = longer, f6 = halves, f7 = empty, f8 = turns, f9 = unknown, f10 = tell
# RUN(FORM): walk f1 mechanisms=none+Folding+TypedOperations
# FORM-LABEL: code f1:Body
# FORM-NOT: = GetStringLength
# FORM-NOT: = PropGet {{*}}key="length"
# FORM: Return
# function lengths(on: boolean) { const wide = on ? "中" : "中"; const t = "ab" + wide; return t.length + wide; }
# function same(on: boolean) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t === "ab中") + wide; }
# function other(on: boolean) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t === "ab丮") + wide; }
# function units(on: boolean) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t.charCodeAt(0) * 100000 + t.charCodeAt(2)) + wide; }
# function longer(on: boolean) { const wide = on ? "中" : "中"; const t = "ab" + wide; const u = t + "c" + 1 + null + undefined + true; return String(u.length) + u + wide; }
# function halves(on: boolean) { const high = on ? "\ud83d" : "\ud83d"; const low = on ? "\ude00" : "\ude00"; const t = "a" + high + low; return String(t.length) + String(t === "a\u{1f600}") + String(t.codePointAt(1)) + String(high.length + low.length); }
# function empty(on: boolean) { const none = on ? "" : ""; const wide = on ? "中" : "中"; const t = none + wide; return String(t.length) + String(t ? 1 : 0) + String(none + none ? 1 : 0) + wide; }
# function turns(on: boolean, n: number) { const wide = on ? "中" : "中"; const t = "ab" + wide; let total = 0; for (let i = 0; i < n; i++) { if (t === "ab中") total += t.length; } return String(total) + wide; }
# function unknown(s: string) { const t = "ab" + s; return String(t.length) + String(t === "ab中"); }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => lengths(true));
# tell(() => same(true));
# tell(() => other(false));
# tell(() => units(true));
# tell(() => longer(true));
# tell(() => halves(true));
# tell(() => empty(false));
# tell(() => turns(true, 3));
# tell(() => turns(true, 0));
# tell(() => unknown("中"));
# tell(() => unknown(""));
# tell(() => unknown("c"));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function lengths(on) { const wide = on ? "中" : "中"; const t = "ab" + wide; return t.length + wide; } function same(on) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t === "ab中") + wide; } function other(on) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t === "ab丮") + wide; } function units(on) { const wide = on ? "中" : "中"; const t = "ab" + wide; return String(t.charCodeAt(0) * 1e5 + t.charCodeAt(2)) + wide; } function longer(on) { const wide = on ? "中" : "中"; const t = "ab" + wide; const u = t + "c" + 1 + null + undefined + true; return String(u.length) + u + wide; } function halves(on) { const high = on ? "\uD83D" : "\uD83D"; const low = on ? "\uDE00" : "\uDE00"; const t = "a" + high + low; return String(t.length) + String(t === "a\uD83D\uDE00") + String(t.codePointAt(1)) + String(high.length + low.length); } function empty(on) { const none = on ? "" : ""; const wide = on ? "中" : "中"; const t = none + wide; return String(t.length) + String(t ? 1 : 0) + String(none + none ? 1 : 0) + wide; } function turns(on, n) { const wide = on ? "中" : "中"; const t = "ab" + wide; let total = 0; for (let i = 0;i < n; i++) { if (t === "ab中") total += t.length; } return String(total) + wide; } function unknown(s) { const t = "ab" + s; return String(t.length) + String(t === "ab中"); } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => lengths(true)); tell(() => same(true)); tell(() => other(false)); tell(() => units(true)); tell(() => longer(true)); tell(() => halves(true)); tell(() => empty(false)); tell(() => turns(true, 3)); tell(() => turns(true, 0)); tell(() => unknown("中")); tell(() => unknown("")); tell(() => unknown("c")); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
