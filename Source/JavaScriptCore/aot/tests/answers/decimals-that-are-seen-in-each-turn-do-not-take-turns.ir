# An object that is given up in each turn is made as any other.
# sink((list, seen) => { let total = 0m; for (const x of list) { total = total.add(x); seen.push(total); } });
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalsReused = 0
# RUN: run-in-shell --useDecimal=1 globalThis.sink = (f) => { const D = text => new Decimal(text), show = f => { try { print(String(f()) + ";"); } catch (error) { print(error.name + ";"); } }; const all = texts => { const list = []; for (const text of texts) list.push(D(text)); return list; }, amounts = all(["0.25", "0.75", "1.5", "2.5", "0.05", "0.95"]), names = list => { const ids = new Map, texts = []; for (const x of list) { if (!ids.has(x)) ids.set(x, ids.size); texts.push(ids.get(x) + ":" + String(x)); } return texts.join(" "); }, each = at => ({ [Symbol.iterator]() { let i = 0; return { next: () => i < amounts.length ? { value: at(amounts[i], i++) } : { done: true } }; } }); const seen = []; f(amounts.slice(0, 3), seen); show(() => names(seen)); };
# CHECK: 0:0.25 1:1 2:2.5;
# CHECK-NEXT: exited with 0

