# function show(a, b, ...others) { return tell(this, a, b, others.length) }  function reflected(callee, receiver, list) { return [Reflect.apply(callee, receiver, list)][0] }
# function reflectedOwn(receiver, a, b) { return [Reflect.apply(show, receiver, [a, b])][0] }  function reflectedWithoutList(receiver) { return [Reflect.apply(show, receiver)][0] }
# function reflectedNumber(receiver, a) { return [Reflect.apply(1, receiver, [a])][0] }
# Each call is marked as done in place. The row of Reflect.apply forwards the call to its first argument, and takes a function there and an object for the list.
# Whatever else arrives the built-in refuses in its own words, so the call is forwarded only where both are proven. undefined and null are no empty list here.
# LIBRARY: own
# RUN: run-in-shell globalThis.tell = (receiver, a, b, others) => receiver + " " + a + " " + b + " " + others; globalThis.drive = (show, reflected, reflectedOwn, reflectedWithoutList, reflectedNumber) => { const attempt = (way, ...operands) => { try { print(way(...operands)); } catch (error) { print(error.name + ": " + error.message); } }; attempt(reflected, show, "list", [1, 2, 3]); attempt(reflected, show, "undefined", undefined); attempt(reflected, show, "null", null); attempt(reflected, 1, "uncallable", []); attempt(reflectedOwn, "own", 8, 9); attempt(reflectedWithoutList, "no list"); attempt(reflectedNumber, "number", 1); };
# CHECK: list 1 2 1
# CHECK-NEXT: TypeError: Reflect.apply requires the third argument be an object
# CHECK-NEXT: TypeError: Reflect.apply requires the third argument be an object
# CHECK-NEXT: TypeError: Reflect.apply requires the first argument be a function
# CHECK-NEXT: own 8 9 0
# CHECK-NEXT: TypeError: Reflect.apply requires the third argument be an object
# CHECK-NEXT: TypeError: Reflect.apply requires the first argument be a function
# CHECK-NEXT: exited with 0

