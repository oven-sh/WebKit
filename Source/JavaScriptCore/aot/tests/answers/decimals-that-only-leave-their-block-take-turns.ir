# A value that is made in each turn and read by the operations of other blocks needs one object too.
# sink(list => { let count = 0; for (const x of list) { const twice = x.add(x); if (twice.lessThan(new Decimal(2))) count += twice.exponent(); else count += twice.toString().length; } return count; });
