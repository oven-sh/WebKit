# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function pairKey(a, b, postFix) { return `${a},${b}${postFix}`; } function label(a, b) { return `${a} and ${b}!`; } const relation = new Map; const seen = new Set; function related(a, b, postFix) { const id = pairKey(a, b, postFix); const entry = relation.get(id); if (entry !== undefined) return entry; relation.set(id, relation.size + 1); return 0; } function seenBefore(a, b) { const id = nameKey(a, b); if (seen.has(id)) return true; seen.add(id); return false; } function show(a, b) { const text = label(a, b); return text + text.length; } function throughVariable(a, b) { const id = pairKey(a, b, ":v"); return id + "|" + id.length + "|" + id.charCodeAt(0) + "|" + (id === a + "," + b + ":v"); } function nameKey(a, b) { return a + "/" + b; } tell(() => related(1, 2, "")); tell(() => related(1, 2, "")); tell(() => related(12, "", "")); tell(() => related(1, "2", "")); tell(() => related("1,2", "", "")); tell(() => related("1", "2,", "")); tell(() => related(1, 2, ":1")); tell(() => related(1, 2, ":1")); tell(() => related(-0, 0, "")); tell(() => related(0, 0, "")); tell(() => related(NaN, 1.5, "")); tell(() => related(NaN, 1.5, "")); tell(() => related(1000000000000000000000, 0.0000001, "")); tell(() => related(undefined, null, "")); tell(() => related("undefined", "null", "")); tell(() => related(true, false, "")); tell(() => related("é", "中", "")); tell(() => related("é", "中", "")); tell(() => related("\uD83D", "\uDE00", "")); tell(() => related("", "", "")); tell(() => related("", "", "")); tell(() => related("x".repeat(300), "y".repeat(300), "")); tell(() => related("x".repeat(300), "y".repeat(300), "")); tell(() => related(10n, 20n, "")); let order = ""; tell(() => related({ toString() { order += "a"; return "A"; } }, { toString() { order += "b"; return "B"; } }, "")); tell(() => related("A", "B", "")); tell(() => order); tell(() => related(Symbol("s"), 1, "")); tell(() => related({ toString() { throw new RangeError("no"); } }, 1, "")); tell(() => relation.size); tell(() => relation.has("1,2")); tell(() => relation.get("1,2:1")); tell(() => relation.delete(pairKey(1, 2, ""))); tell(() => relation.has("1,2")); tell(() => related(1, 2, "")); tell(() => seenBefore("a", "b")); tell(() => seenBefore("a", "b")); tell(() => seenBefore("a/", "b")); tell(() => seenBefore("a", "/b")); tell(() => seenBefore(1, 2)); tell(() => seenBefore("1", "2")); tell(() => seen.size); tell(() => show(1, 2)); tell(() => show("x", {})); tell(() => throughVariable(1, 2)); tell(() => throughVariable("中", 2)); const bag = {}; tell(() => { bag[pairKey(1, 2, "")] = 5; return bag["1,2"]; }); tell(() => pairKey(1, 2, "") === pairKey(1, 2, "")); tell(() => Object.is(pairKey(1, 2, ""), "1,2")); tell(() => typeof pairKey(1, 2, "")); tell(() => pairKey(1, 2, "").split(",").length); tell(() => pairKey(1, 2, "") + pairKey(3, 4, "")); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
