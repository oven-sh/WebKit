# made of 5c862a65e6f4c096
# a call of a module's variable that starts with one function and is seen to be given one other tests for each in turn, and whatever else is there is called as written
# f6 = tell, f1 = gather, f2 = pick, f3 = first, f4 = second, f5 = current, f7 = setHook, f8 = makeHook
# RUN(GIVEN): walk f5 mechanisms=all-Inlining
# GIVEN: = TypeTest {{*}}testedType=f
# GIVEN: = TypeTest {{*}}testedType=f
# GIVEN: = Call {{*}}calleeName="hook"
# RUN(NEVER): walk f5 mechanisms=all-Guesses
# NEVER-NOT: = TypeTest {{*}}testedType=f
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# function gather(from: number[], f: (x: number) => number): number { let sum = 0; for (let i = 0; i < from.length; i++) sum += f(from[i]); return sum; }
# function pick(which: boolean): (x: number) => number { return which ? first : second; }
# function first(x: number): number { return x + 1; }
# function second(x: number): number { return x * 2; }
# let hook: () => unknown = () => undefined;
# function current(): unknown { const answer = hook(); return answer ?? "root"; }
# function setHook(f: () => unknown): void { hook = f; }
# function makeHook(n: number): () => unknown { return () => (n ? "made " + n : undefined); }
# tell(() => gather([1, 2, 3], pick(true)));
# tell(() => gather([1, 2, 3], pick(false)));
# tell(() => gather([], pick(false)));
# tell(() => current());
# tell(() => current());
# setHook(makeHook(1));
# tell(() => current());
# setHook(makeHook(2));
# tell(() => current());
# setHook(makeHook(0));
# tell(() => current());
# const others: any[] = [() => "a third", function (this: unknown) { return typeof this; }, Math.random.bind(null).constructor === Function ? String : String, 5, null, { call: 1 }, class { }, async () => 1];
# hook = others[0];
# tell(() => current());
# hook = others[1];
# tell(() => current());
# hook = others[2];
# tell(() => current());
# hook = others[3];
# tell(() => current());
# hook = others[4];
# tell(() => current());
# hook = others[5];
# tell(() => current());
# hook = others[6];
# tell(() => current());
# hook = others[7];
# tell(() => typeof current());
# setHook(makeHook(3));
# tell(() => current());
# setHook(makeHook(4).bind(null));
# tell(() => current());
# let depth = 0;
# setHook(() => (depth++ < 3 ? current() : "deep " + depth));
# tell(() => current());
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function tell(f) { try { report(f()); } catch (e) { report(e.name); } } function gather(from, f) { let sum = 0; for (let i = 0;i < from.length; i++) sum += f(from[i]); return sum; } function pick(which) { return which ? first : second; } function first(x) { return x + 1; } function second(x) { return x * 2; } let hook = () => { return; }; function current() { const answer = hook(); return answer ?? "root"; } function setHook(f) { hook = f; } function makeHook(n) { return () => n ? "made " + n : undefined; } tell(() => gather([1, 2, 3], pick(true))); tell(() => gather([1, 2, 3], pick(false))); tell(() => gather([], pick(false))); tell(() => current()); tell(() => current()); setHook(makeHook(1)); tell(() => current()); setHook(makeHook(2)); tell(() => current()); setHook(makeHook(0)); tell(() => current()); const others = [() => "a third", function() { return typeof this; }, Math.random.bind(null).constructor === Function ? String : String, 5, null, { call: 1 }, class { }, async () => 1]; hook = others[0]; tell(() => current()); hook = others[1]; tell(() => current()); hook = others[2]; tell(() => current()); hook = others[3]; tell(() => current()); hook = others[4]; tell(() => current()); hook = others[5]; tell(() => current()); hook = others[6]; tell(() => current()); hook = others[7]; tell(() => typeof current()); setHook(makeHook(3)); tell(() => current()); setHook(makeHook(4).bind(null)); tell(() => current()); let depth = 0; setHook(() => depth++ < 3 ? current() : "deep " + depth); tell(() => current()); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
