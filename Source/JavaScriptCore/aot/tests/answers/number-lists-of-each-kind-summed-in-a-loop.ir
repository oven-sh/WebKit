# function total(xs: number[]) { let s = 0; for (let i = 0; i < xs.length; i++) s = s + xs[i]; return s; }
# function totalWhile(xs: number[], change: (i: number) => void) { let s = 0; for (let i = 0; i < xs.length; i++) { change(i); s = s + xs[i]; } return s; }
# The text hands over lists with storage for integers, for fractions and for any value, with holes, without elements, frozen, and with a text among the numbers. Each is summed twice.
# Then a list of a hundred integers gets another kind of storage, another length or a hole in turn 50 of the loop that sums it.
# RUN: run-in-shell globalThis.register = (total, totalWhile) => { const tell = value => print(Object.is(value, -0) ? "-0" : String(value)); for (const list of [[1, 2, 3], [1.5, 2, 3], [1, , 3], [1.5, , 3], [], [1.5, NaN, 2], [1, "2", 3], Object.freeze([4, 5]), new Array(2), [2147483647, 1], [-0]]) { tell(total(list)); tell(total(list)); } const run = change => { const list = []; for (let i = 0; i < 100; i++) list.push(i); tell(totalWhile(list, i => { if (i === 50) change(list); })); }; run(list => { list[60] = 0.5; }); run(list => { list[60] = NaN; }); run(list => { list.length = 55; }); run(list => { delete list[70]; }); run(list => { list.push(0.25); }); run(list => { }); };
# CHECK: 6
