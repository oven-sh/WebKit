# made of 6cbf7c0f2323e807
# a callee calls add on a set that its caller has made and nobody else has: the name finds what the table lists, and the one row of add says what the call does
# f1 = note
# RUN(FORM): link functions mechanisms=all
# FORM: function f1 {{*}}returns=[
# RUN(NEVER): link functions mechanisms=all
# NEVER-NOT: function f1 {{*}}mayCallUnknownCode
# function note(seen: Set<number>, k: number) { seen.add(k); }
# function mark(box: { n: number }) { const seen = new Set<number>(); const before = box.n; note(seen, 1); note(seen, 1); note(seen, 2); return before * 100 + box.n * 10 + seen.size; }
# report(mark({ n: 2 }));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function note(seen, k) { seen.add(k); } function mark(box) { const seen = new Set; const before = box.n; note(seen, 1); note(seen, 1); note(seen, 2); return before * 100 + box.n * 10 + seen.size; } report(mark({ n: 2 })); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 2 of 2 of 2
# CHECK-NEXT: exited with 0

