# const unseen = (0, eval)("(x) => x");
# function halfOf(count) { const whole = count | 0; return Math.floor.call(whole / 2); }
# function halfApplied(count) { const whole = count | 0; return Math.floor.apply(whole / 2); }
# function halfOfOther(count, other) { const whole = count | 0; return Math.floor.call(whole / 2, other); }
# function wholePart(amount) { const number = +amount; return Math.trunc.call(7, number) | 0; }
# function wholePartApplied(amount) { const number = +amount; return Math.trunc.apply(7, [number]) >>> 0; }
# function lowBits(amount) { const number = +amount; return Math.trunc.call(7, number) & 255; }
# function notOf(amount) { const number = +amount; return ~Math.trunc.call(7, number); }
# function asWritten(count, amount) { const whole = count | 0; const number = +amount; return Math.floor(whole / 2) + (Math.trunc(number) | 0); }
# function ask() { report(halfOf(unseen(7))); report(halfApplied(unseen(7))); report(halfOfOther(unseen(7), unseen(10.6))); report(wholePart(unseen(12.75))); report(wholePartApplied(unseen(12.75))); report(lowBits(unseen(12.75))); report(notOf(unseen(12.75))); report(asWritten(unseen(7), unseen(12.75))); }
# ask();
# ask();
# report("end");
# `Math.floor.call(whole / 2)` rounds nothing: the quotient is only what `this` is. `Math.trunc.call(7, x) | 0` truncates x, not 7. Two rules on numbers read the operands off the call as the body writes it.
# At the end the shell runs the same text itself: every answer is the same.
# Without the library `.call` answers undefined unless the walk forwards it.
# OPTIONS: mechanisms=all
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const unseen = (0, eval)("(x) => x"); function halfOf(count) { const whole = count | 0; return Math.floor.call(whole / 2); } function halfApplied(count) { const whole = count | 0; return Math.floor.apply(whole / 2); } function halfOfOther(count, other) { const whole = count | 0; return Math.floor.call(whole / 2, other); } function wholePart(amount) { const number = +amount; return Math.trunc.call(7, number) | 0; } function wholePartApplied(amount) { const number = +amount; return Math.trunc.apply(7, [number]) >>> 0; } function lowBits(amount) { const number = +amount; return Math.trunc.call(7, number) & 255; } function notOf(amount) { const number = +amount; return ~Math.trunc.call(7, number); } function asWritten(count, amount) { const whole = count | 0; const number = +amount; return Math.floor(whole / 2) + (Math.trunc(number) | 0); } function ask() { report(halfOf(unseen(7))); report(halfApplied(unseen(7))); report(halfOfOther(unseen(7), unseen(10.6))); report(wholePart(unseen(12.75))); report(wholePartApplied(unseen(12.75))); report(lowBits(unseen(12.75))); report(notOf(unseen(12.75))); report(asWritten(unseen(7), unseen(12.75))); } ask(); ask(); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 17 of 17 of 17
