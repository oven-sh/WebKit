# type Handler = (n: number) => number;
# let calls = 0;
# class Button { handler: Handler; label: string; constructor(label: string) { this.label = label; this.handler = n => { calls += 1; return n * 2 + this.label.length; }; } click(n: number): number { return this.handler(n); } twice(n: number): number { return this.handler(n) + this.handler(n + 1); } guarded(n: number): any { try { return this.handler(n); } catch (error) { return "threw " + (error instanceof TypeError); } } }
# class Stranger { handler(n: number): number { return n + 300; } }
# function press(button: Button, n: number): number { const pressed = button.handler(n); calls += 1; return pressed; }
# const byName: any = { press };
# report(byName);
# function call(name: string, first: any, second?: any): any { return byName[name](first, second); }
# function click(button: any, n: number): any { return button.click(n); }
# function guarded(button: any, n: number): any { return button.guarded(n); }
# const one = new Button("a");
# const other = new Button("bcd");
# report(click(one, 1));
# report(click(other, 2));
# report(one.twice(3));
# report(guarded(one, 4));
# report(call("press", one, 5));
# report(call("press", other, 6));
# report(calls);
# const cleared = new Button("e");
# cleared.handler = undefined as any;
# report(guarded(cleared, 7));
# const emptied: any = new Button("f");
# delete emptied.handler;
# report(guarded(emptied, 8));
# Object.setPrototypeOf(emptied, { handler(n: number) { return n + 100; }, click: Button.prototype.click, guarded: Button.prototype.guarded });
# report(click(emptied, 9));
# report(guarded(emptied, 10));
# report(call("press", emptied, 11));
# report(call("press", new Stranger(), 12));
# report(guarded(other, 13));
# report(calls);
# report("end");
# every store into the field brings a closure of one function, so the slot is held to that: behind a look at the slot the call enters the function directly. An emptied slot, an accessor and another object take the closed read and the call by value
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let calls = 0; class Button { handler; label; constructor(label) { this.label = label; this.handler = (n) => { calls += 1; return n * 2 + this.label.length; }; } click(n) { return this.handler(n); } twice(n) { return this.handler(n) + this.handler(n + 1); } guarded(n) { try { return this.handler(n); } catch (error) { return "threw " + (error instanceof TypeError); } } } class Stranger { handler(n) { return n + 300; } } function press(button, n) { const pressed = button.handler(n); calls += 1; return pressed; } const byName = { press }; report(byName); function call(name, first, second) { return byName[name](first, second); } function click(button, n) { return button.click(n); } function guarded(button, n) { return button.guarded(n); } const one = new Button("a"); const other = new Button("bcd"); report(click(one, 1)); report(click(other, 2)); report(one.twice(3)); report(guarded(one, 4)); report(call("press", one, 5)); report(call("press", other, 6)); report(calls); const cleared = new Button("e"); cleared.handler = undefined; report(guarded(cleared, 7)); const emptied = new Button("f"); delete emptied.handler; report(guarded(emptied, 8)); Object.setPrototypeOf(emptied, { handler(n) { return n + 100; }, click: Button.prototype.click, guarded: Button.prototype.guarded }); report(click(emptied, 9)); report(guarded(emptied, 10)); report(call("press", emptied, 11)); report(call("press", new Stranger, 12)); report(guarded(other, 13)); report(calls); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
