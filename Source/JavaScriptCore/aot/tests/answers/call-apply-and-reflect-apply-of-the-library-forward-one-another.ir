# function called0(callee) { return callee.call() } .. function called8(callee, receiver) { return callee.call(receiver, 1, 2, 3, 4, 5, 6, 7, 8) }  function applied(callee, receiver, list) { return callee.apply(receiver, list) }
# function reflected(callee, receiver, list) { return Reflect.apply(callee, receiver, list) }  function show(...all) { return tell(this, all.length, all[0], all[all.length - 1]) }
# The library's Function.prototype.call, Function.prototype.apply and Reflect.apply, as the front end writes them. Each of the three ends in `$apply`, a call that is done in place.
# `call` passes up to five operands by itself and gathers more in a list. Each of them is also the receiver of another: call.call(..), apply.call(..), call.apply(..), apply.apply(..).
# LIBRARY: own
# RUN: run-in-shell globalThis.tell = (receiver, count, first, last) => receiver + " " + count + " " + first + " " + last; globalThis.drive = (show, called0, called1, called3, called6, called8, applied, reflected) => { const call = Function.prototype.call, apply = Function.prototype.apply; const attempt = (way, ...operands) => { try { print(way(...operands)); } catch (error) { print(error.name + ": " + error.message); } }; attempt(called0, show); attempt(called1, show, "one"); attempt(called3, show, "three"); attempt(called6, show, "six"); attempt(called8, show, "eight"); attempt(applied, show, "applied", [1, 2]); attempt(reflected, show, "reflected", [3, 4, 5]); attempt(called3, call, show); attempt(called3, apply, show); attempt(applied, call, show, ["call applied", 6, 7]); attempt(applied, apply, show, ["apply applied", [8, 9]]); attempt(reflected, call, show, ["call reflected", 1]); attempt(reflected, apply, show, ["apply reflected", [2]]); attempt(applied, call, call, [show, "call on call", 3]); attempt(reflected, show, "no list"); attempt(reflected, 1, "no function", []); attempt(called1, Object.create(call), "uncallable"); };
# CHECK: undefined 0 undefined undefined
# CHECK-NEXT: one 0 undefined undefined
# CHECK-NEXT: three 2 1 2
# CHECK-NEXT: six 5 1 5
# CHECK-NEXT: eight 8 1 8
# CHECK-NEXT: applied 2 1 2
# CHECK-NEXT: reflected 3 3 5
# CHECK-NEXT: 1 1 2 2
# CHECK-NEXT: TypeError: second argument to Function.prototype.apply must be an Array-like object
# CHECK-NEXT: call applied 2 6 7
# CHECK-NEXT: apply applied 2 8 9
# CHECK-NEXT: call reflected 1 1 1
# CHECK-NEXT: apply reflected 1 2 2
# CHECK-NEXT: call on call 1 3 3
# CHECK-NEXT: TypeError: Reflect.apply requires the third argument be an object
# CHECK-NEXT: TypeError: Reflect.apply requires the first argument be a function
# CHECK-NEXT: TypeError:
# CHECK-NEXT: exited with 0

