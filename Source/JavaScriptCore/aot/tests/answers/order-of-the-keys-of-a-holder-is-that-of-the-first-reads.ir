# A holder adds some members when the program first reads them, and a copy of the holder fixes the order of its keys: the members that were read first stand in front, in the order of the reads.
# The front end writes such a read as the object that it finds. The run time still has to see it where it stands: read and called, read and not taken, kept in a constant, in a loop that runs no turn and then two,
# in the arm that is taken first, twice in one body, in a function that nobody calls.
# -- source: main.js
# function names(holder) { Object.assign({}, holder); return Reflect.ownKeys(holder).map(String).join(); }
# function size(object) { return Object.entries(object).length; }
# function never(object) { return Object.values(object).length; }
# const point = { x: 1 };
# function inLoop(turns) { let total = 0; for (let i = 0; i < turns; i = i + 1) if (Object.isFrozen(point)) total = total + 1; return total; }
# function inArm(flag) { if (flag) return Object.isExtensible(point); return Object.getOwnPropertyNames(point).length; }
# function twice() { return Object.keys(point).length + Object.keys(point).length; }
