# What an async function returns goes into its promise, so it is boxed whatever is proven of it. What it calls and awaits may return raw.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function told(n) { report(n); report(n + 1); report(n * 2); report(n === n); report(typeof n); } function half(n) { return n / 2; } function isBig(n) { return n > 100; } async function later(n) { return n * 2; } async function laterFlag(n) { return n > 2; } async function laterHalf(n) { return half(n); } async function sum(a, b) { return (await later(a)) + (await later(b)); } async function awaitsNumber(n) { return (await half(n)) + 1; } async function awaitsFlag(n) { return (await isBig(n)) ? 1 : 2; } report(typeof later(1)); report(typeof laterFlag(1)); told(await later(1.5)); told(await laterFlag(3)); told(await laterHalf(5)); told(await sum(1, 2)); told(await awaitsNumber(5)); told(await awaitsFlag(500)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
