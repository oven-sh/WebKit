# A static import asks for nothing until its module is loaded. When the only importer of the other form is never loaded, an import() gets the form it asked for.
# inner.mjs: import conf from "./conf.toml" with { type: "toml" }; export const port = conf.port;
# main.mjs: const later = () => import("./inner.mjs"); const loaded = await import("./conf.toml", { with: { type: "text" } }); print(typeof later, typeof loaded.default);
# RUN: run-in-shell
# CHECK: function string
# CHECK-NEXT: exited with 0

module m0 path="/conf.toml?toml" displayPath="conf.toml" kind=Data requireResult=DefaultExport body=f0 data=d0 exports=[{name="default" variable=g0}]
module m1 path="/inner.mjs" displayPath="inner.mjs" flags=[CachesEvaluationError] body=f1 requests=[{target=m0 completes=true}] exports=[{name="port" variable=g1}]
module m2 path="/conf.toml?text" displayPath="conf.toml" kind=Data flags=[LoaderReturnsNamespace] requireResult=DefaultExport body=f2 exports=[{name="default" variable=g2}]
module m3 path="/main.mjs" displayPath="main.mjs" flags=[HasTopLevelAwait, CachesEvaluationError] body=f3
entry module=m3
layout L0 module=m0 fields=[{key="port" declared={type=anything}}] ownFieldCount=1
layout L1 fields=[{key="with" declared={type=anything}}] ownFieldCount=1
layout L2 fields=[{key="type" declared={type=anything}}] ownFieldCount=1
variable g0 name="_0" module=m0 declared={type=anything|absent} flags=[IsImmutable]
variable g1 name="port" module=m1 declared={type=anything|absent} flags=[IsImmutable]
variable g2 name="default" module=m2 declared={type=anything|absent} flags=[IsImmutable]
data d0 root=Object{layout=L0 members=[{key="port" value=Number{value=21}}]} module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Data data=d0
    PutModuleVariable v0 variable=g0
    v2 = Undefined
    Return v2
}
function f1 module=m1 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = GetModuleVariable variable=g0
    v1 = CheckInitialized v0 name="conf"
    v2 = PropGet v1 key="port"
    PutModuleVariable v2 variable=g1
    v4 = Undefined
    Return v4
}
function f2 module=m2 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = String string="port = 21\n"
    PutModuleVariable v0 variable=g2
    v2 = Undefined
    Return v2
}
function f3 module=m3 kind=Module flags=[IsAsync] thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = NewClosure function=f4
    v1 = NewObject layout=L2
    v2 = String string="text"
    PropDefine v1, v2 key="type"
    v4 = FinishObject v1
    v5 = NewObject layout=L1
    PropDefine v5, v4 key="with"
    v7 = FinishObject v5
    v8 = ImportModule v7 module=m2 referrer=m3
    v9 = Await v8
    v10 = Builtin builtin=GlobalThis
    v11 = PropGet v10 key="print" [isFreeName]
    v12 = TypeOf v0
    v13 = PropGet v9 key="default"
    v14 = TypeOf v13
    v15 = Call v11, -, v12, v14 calleeName="print"
    v16 = Undefined
    Return v16
}
function f4 name="later" module=m3 results=[{type=anything}] {
  b0():
    v0 = ImportModule module=m1 referrer=m3
    Return v0
}
