# HARDENED: [{"held":"a"},{"held":{}},{"held":"c"}] [{"held":"a"},{"held":{}},{"held":"c"}]
# HARDENED-NEXT: exited with 0
# RUN(LIE): walk f2 mechanisms=all testing=CheckBoundsAtRunTime,AssumeIndexesInBounds
# LIE: = PutContiguousIndex
# RUN(POSITIONS): run-in-shell mechanisms=all testing=CheckBoundsAtRunTime,AssumeIndexesInBounds globalThis.after = () => print(JSON.stringify(shorter.call(["a", {}, "c", "d", "e", "f", "g", "h", "i"], null, 1000)));
