# type Table = { handler: (x: number) => number; bias: number }   type Counter = { count: number }   type Source = { text: string }
# function run(table: Table, times: number) { let sum = 0; for (let i = 0; i < times; i++) sum = (table.handler(sum) + table.bias) | 0; return sum; }
# function add(counter: Counter) { counter.count = (counter.count + 1) | 0; }
# function addAndRead(counter: Counter) { const before = counter.count; counter.count = (before + 1) | 0; return before; }
# function count(source: Source) { let turns = 0; while (turns < source.text.length) turns++; return turns; }
# function runs(table: Table, change) { for (let i = 0; i < 6; i++) { if (i === 3) change(table); report(run(table, 4)); } }
# function adds(counter: Counter, change) { for (let i = 0; i < 6; i++) { if (i === 3) change(counter); report(addAndRead(counter)); add(counter); } }
# function counts(source: Source, change) { for (let i = 0; i < 6; i++) { if (i === 3) change(source); report(count(source)); } }
# register(runs, adds, counts, { handler, bias: 1 }, { handler, bias: 1 }, { count: 1 }, { text: "abcde" }, run, addAndRead, count)
# The records are made in sight, every field at birth.
# The records have escaped, and a slot is empty once its field is deleted, is redefined or has left for the extra properties. So a read of a slot stands behind a test: of the slot, or of the mark of the cell, which answers for every field of the birth.
# A read without it hands the empty marker on as a value: to a sum as a wild number, to `.length` as a wild pointer.
# The shell takes a field away in turn 3 of a compiled loop, behind whatever test stands in front of the loop, and each way of taking it away has a run of its own. Three answers in front of the act, then what the language says.
# How often a getter is asked is printed: no read asks a second time.
# The same with text in the place of the shell, on many records, with and without types: field-of-an-escaped-record-goes-away.ts and .erased.js among the stored programs.
# RUN: run-in-shell globalThis.register = (runs, adds, counts, table, other, counter, source) => { let said = "", asked = 0; globalThis.report = value => { said += " " + value; }; const drive = (name, loop, object, act) => { said = ""; asked = 0; try { loop(object, act); } catch (error) { said += " " + error.name; } print(name + said + " asked " + asked); }; drive("table", runs, table, o => { }); drive("other", runs, other, o => { }); drive("counter", adds, counter, o => { }); drive("source", counts, source, o => { }); };
