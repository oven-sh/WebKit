# RUN(GETTER): run-in-shell globalThis.register = (runs, adds, counts, table, other, counter, source) => { let said = "", asked = 0; globalThis.report = value => { said += " " + value; }; const drive = (name, loop, object, act) => { said = ""; asked = 0; try { loop(object, act); } catch (error) { said += " " + error.name; } print(name + said + " asked " + asked); }; drive("table", runs, table, o => { Object.defineProperty(o, "bias", { get() { asked++; return 10; } }); }); drive("other", runs, other, o => { Object.defineProperty(o, "handler", { get() { asked++; return x => x * 2; } }); }); drive("counter", adds, counter, o => { Object.defineProperty(o, "count", { get() { asked++; return 41; } }); }); drive("source", counts, source, o => { Object.defineProperty(o, "text", { get() { asked++; return "ab"; } }); }); };
