# `p.catch(f)` on a fulfilled promise of which nothing is known: the stub queues the job that hands the value on to the derived promise, as the host does; no operation is called, and the derived promise is settled in its turn, not at once.
# That the road is reached at all is counted beside it: `p.then(f)` on a rejected promise leaves the same stub for the operation.
# function callCatch(p, f) { return p.catch(f); }  function callThen(p, f) { return p.then(f); }
# RUN: run-in-shell --aotCountsPath=/dev/null drive = function (callCatch, callThen) { const count = () => Number(aotOperationCount("operationAOTPromiseThen")); let before = count(); callThen(Promise.reject(1), () => {}).catch(() => {}); print("then on a rejected promise: " + (count() - before)); before = count(); const derived = callCatch(Promise.resolve(1), () => {}); print("catch on a fulfilled promise: " + (count() - before)); derived.then(value => print("derived " + value)); Promise.resolve().then(() => print("first")).then(() => print("second")); };
# CHECK: then on a rejected promise: 1
# CHECK-NEXT: catch on a fulfilled promise: 0
# CHECK-NEXT: first
# CHECK-NEXT: derived 1
# CHECK-NEXT: second
