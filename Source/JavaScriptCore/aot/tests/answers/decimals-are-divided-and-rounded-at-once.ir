# A quotient that is only rounded is not computed to all of its digits.
# sink((x, y, digits) => x.divide(y).round(digits, "floor"));
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns >= 1
# RUN(CODE): emit f1
# CODE: Tuple(Int64, Int64) {{*}} = Patch(
# CODE-NOT: Tuple(Int64, Int64) {{*}} = Patch(
# RUN: run-in-shell --useDecimal=1 globalThis.sink = f => { const D = text => new Decimal(text), show = f => { try { print(String(f())); } catch (error) { print(error.name); } }; show(() => f(D("2"), D("3"), 2)); show(() => f(D("-2"), D("3"), 2)); show(() => f(D("1"), D("0"), 2)); show(() => f(D("-1.00000000000000002e2"), D("4.99999999999999999e2"), 19)); show(() => f(D("1"), D("3"), 2 ** 40)); show(() => f(D("1"), D("3"), 0.5)); show(() => f(D("1"), D("3"), "1")); };
# CHECK: 0.66
# CHECK-NEXT: -0.67
# CHECK-NEXT: Infinity
# CHECK-NEXT: -0.2000000000000000044
# CHECK-NEXT: 0.3333333333333333333333333333333333
# CHECK-NEXT: RangeError
# CHECK-NEXT: TypeError
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2 calleeName="sink"
    v4 = Undefined
    Return v4
}
function f1 module=m0 kind=Arrow length=3 thisType={type=anything} parameters=[{type=anything flags=[IsExpected]}, {type=anything}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything, v2: anything):
    v3 = PropGet v0 key="divide"
    v4 = Call v3, v0, v1 calleeKey="divide" calleeName="x.divide"
    v5 = PropGet v4 key="round"
    v6 = String string="floor"
    v7 = Call v5, v4, v2, v6 calleeKey="round" calleeName="round"
    ReturnCall v7
}
