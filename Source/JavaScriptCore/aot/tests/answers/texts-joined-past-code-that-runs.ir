# made of 2140fccf7b337a12
# numbers and written texts are joined with what a read or a conversion gives that runs code: it logs, stores into the variable that the first part was read from, throws, gives an object that converts; the first part is not what is written
# f1 = edge, f4 = converted, f5 = tell
# RUN(FORM): walk f4 mechanisms=all
# FORM-LABEL: code f4:
# FORM: = Strcat
# let log = "";
# let count = 1;
# const target = { get id() { log += "[get at " + count + "]"; count = 100; return 7; } };
# const thrower = { get id(): number { log += "[throws]"; throw new RangeError("no id"); } };
# const converter = { get id() { log += "[get]"; return { toString() { log += "[converted]"; return "obj"; } }; } };
# function edge(n: number, to: any) { return n + "," + to.id; }
# function three(n: number, to: any) { return n + "," + to.id + ";" + count; }
# function fromVariable(to: any) { return count + ":" + to.id + ":" + count; }
# function converted(n: number, to: any) { return n + "," + +to; }
# function tell(f: () => unknown) { try { report(f()); } catch (e) { report((e as Error).name); } }
# tell(() => edge(1, target));
# tell(() => three(1.5, target));
# tell(() => edge(-0, thrower));
# tell(() => edge(2, converter));
# tell(() => edge(3, {}));
# tell(() => edge(4, null));
# count = 5;
# tell(() => fromVariable(target));
# tell(() => converted(6, { valueOf() { log += "[valueOf]"; return 8; } }));
# tell(() => converted(7, 10n));
# tell(() => edge("text" as any, target));
# tell(() => edge({ toString() { log += "[first]"; return "object"; } } as any, target));
# report(log);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; let count = 1; const target = { get id() { log += "[get at " + count + "]"; count = 100; return 7; } }; const thrower = { get id() { log += "[throws]"; throw new RangeError("no id"); } }; const converter = { get id() { log += "[get]"; return { toString() { log += "[converted]"; return "obj"; } }; } }; function edge(n, to) { return n + "," + to.id; } function three(n, to) { return n + "," + to.id + ";" + count; } function fromVariable(to) { return count + ":" + to.id + ":" + count; } function converted(n, to) { return n + "," + +to; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => edge(1, target)); tell(() => three(1.5, target)); tell(() => edge(-0, thrower)); tell(() => edge(2, converter)); tell(() => edge(3, {})); tell(() => edge(4, null)); count = 5; tell(() => fromVariable(target)); tell(() => converted(6, { valueOf() { log += "[valueOf]"; return 8; } })); tell(() => converted(7, 10n)); tell(() => edge("text", target)); tell(() => edge({ toString() { log += "[first]"; return "object"; } }, target)); report(log); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
