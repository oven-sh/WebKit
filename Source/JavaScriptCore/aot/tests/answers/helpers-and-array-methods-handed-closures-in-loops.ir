# A helper whose own loop calls a closure that the call hands over is copied where the call stands in a loop, and the closure in turn. What the copy must not change: what the closure captures in each turn,
# a return out of the helper, a throw out of the closure under try and finally, a list that the closure changes, a closure that calls the helper again, `this`, defaults, rest and `arguments` of the closure, what is no list and no function.
# LIBRARY: own
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function each(list, visit) { for (let i = 0;i < list.length; i++) visit(list[i], i); } function first(list, test) { for (const item of list) { if (test(item)) return item; } return; } function fold(list, step, start) { let sum = start; for (let i = 0;i < list.length; i++) sum = step(sum, list[i]); return sum; } function eachWithThis(list, visit) { for (let i = 0;i < list.length; i++) visit.call(this, list[i]); } function twice(list, visit, again) { for (let i = 0;i < list.length; i++) { visit(list[i]); again(list[i]); } } const lists = [[1, 2, 3], [], [4], [5, 6]]; const mixed = [[1, "two", null], [undefined, { valueOf() { return 7; } }, 2.5], [, 3]]; function sums() { let out = ""; for (let k = 0;k < lists.length; k++) { let total = 0; each(lists[k], (x, i) => { total += x * (i + 1); }); out += total + ","; } return out; } function capturesTheTurn() { const made = []; for (let k = 0;k < lists.length; k++) each(lists[k], (x) => { made.push(() => x * 10 + k); }); return made.map((f) => f()).join(); } function leavesEarly() { let out = ""; for (let k = 0;k < lists.length; k++) out += String(first(lists[k], (x) => x > 1 && x !== 5)) + ","; return out; } function throwsInside() { let out = ""; for (let k = 0;k < lists.length; k++) { try { each(lists[k], (x) => { if (x === 2 || x === 6) throw new RangeError("at " + x); out += x; }); out += "."; } catch (error) { out += "(" + error.message + ")"; } finally { out += ";"; } } return out; } function changesTheList() { let out = ""; for (let k = 0;k < 3; k++) { const list = [1, 2, 3]; each(list, (x, i) => { if (i === 0) list.push(9 + k); if (i === 1) list.length = 3; out += x; }); out += "/" + list.join("") + ","; } return out; } function callsItself() { let out = ""; for (let k = 0;k < 2; k++) each([1, 2], (x) => { each([x, x + k], (y) => { out += y; }); out += "|"; }); return out; } function helperCalledByTheClosure(depth) { let total = 0; for (let k = 0;k < 2; k++) each([1, 2], (x) => { total += depth ? helperCalledByTheClosure(depth - 1) + x : x; }); return total; } function foldsObjects() { let out = ""; for (let k = 0;k < lists.length; k++) { const r = fold(lists[k], (acc, v) => ({ sum: acc.sum + v, n: acc.n + 1 }), { sum: 0, n: 0 }); out += r.sum + ":" + r.n + ","; } return out; } function foldsOtherTypes() { let out = ""; for (let k = 0;k < mixed.length; k++) out += String(fold(mixed[k], (acc, v) => acc + v, k ? 0 : "")) + ","; return out; } function withThis() { let out = ""; const holder = { name: "h" }; for (let k = 0;k < 2; k++) eachWithThis.call(holder, lists[k * 3], function(x) { out += this.name + x; }); return out; } function twoClosures() { let out = ""; for (let k = 0;k < 2; k++) twice(lists[0], (x) => { out += x; }, (x) => { out += -x; }); return out; } function sameClosureTwice() { let out = ""; for (let k = 0;k < 2; k++) { const show = (x) => { out += x + k; }; twice(lists[3], show, show); } return out; } function namedFunction() { let out = ""; function show(x) { out += "<" + x + ">"; } for (let k = 0;k < 2; k++) each(lists[3], show); return out; } function chosenClosure(flag) { let out = ""; for (let k = 0;k < 2; k++) each(lists[0], flag ? (x) => { out += x; } : (x) => { out += -x; }); return out; } function closureWithDefaults() { let out = ""; for (let k = 0;k < 2; k++) each(lists[3], (x, i = 9, more = "m") => { out += x + ":" + i + more; }); return out; } function closureWithRest() { let out = ""; for (let k = 0;k < 2; k++) each(lists[3], (...all) => { out += all.length + ":" + all.join("+") + ","; }); return out; } function closureWithArguments() { let out = ""; for (let k = 0;k < 2; k++) each(lists[3], function() { out += arguments.length + ":" + arguments[0] + ","; }); return out; } function noList() { let out = ""; for (let k = 0;k < 2; k++) { try { each(k ? null : undefined, () => { out += "never"; }); } catch (error) { out += error.constructor.name + ","; } } return out; } function notAFunction() { let out = ""; for (let k = 0;k < 2; k++) { try { each([1], k ? 5 : undefined); } catch (error) { out += error.constructor.name + ","; } } return out; } function methods() { let out = ""; for (let k = 0;k < lists.length; k++) { const list = lists[k]; let seen = ""; list.forEach((x, i, all) => { seen += x + ":" + i + ":" + (all === list) + " "; }); out += seen + "|" + list.map((x) => x * 2).join() + "|" + list.filter((x) => x & 1).join() + "|" + list.reduce((s, x) => s + x, 0) + "|" + list.some((x) => x > 4) + "|" + list.every((x) => x < 6) + "|" + String(list.find((x) => x > 1)) + "|" + list.findIndex((x) => x === 6) + ";"; } return out; } function methodsOnOtherValues() { let out = ""; for (let k = 0;k < mixed.length; k++) out += mixed[k].map((x) => typeof x).join() + "|" + mixed[k].filter((x) => x != null).length + "|" + (1 in mixed[k].map((x) => x)) + "|" + (0 in mixed[k].map((x) => x)) + ";"; return out; } function methodThrows() { let out = ""; for (let k = 0;k < 3; k++) { try { out += [1, 2, 3].map((x) => { if (x === k + 1) throw new Error("no " + x); return x; }).join(); } catch (error) { out += error.message; } out += ";"; } return out; } function reduceOfNothing() { let out = ""; for (let k = 0;k < 2; k++) { try { out += [].reduce((s, x) => s + x); } catch (error) { out += error.constructor.name; } } return out; } function methodChangesTheList() { let out = ""; for (let k = 0;k < 2; k++) { const list = [1, 2, 3, 4]; out += list.map((x, i) => { if (i === 0) list.pop(); if (i === 1) list[2] = 30; return x; }).join() + "/" + list.join() + ";"; } return out; } function methodWithThisArgument() { let out = ""; const holder = { scale: 3 }; for (let k = 0;k < 2; k++) out += [1, 2].map(function(x) { return x * this.scale; }, holder).join() + ";"; return out; } function methodReplaced() { let out = ""; const list = [1, 2]; for (let k = 0;k < 3; k++) { if (k === 1) list.map = function(f) { return ["own", f(0)]; }; if (k === 2) delete list.map; out += list.map((x) => x + 1).join() + ";"; } return out; } class Special extends Array { static get [Symbol.species]() { return Array; } } class Kept extends Array { } function species() { let out = ""; for (let k = 0;k < 2; k++) { const a = Special.from([1, 2]).map((x) => x + k), b = Kept.from([1, 2]).map((x) => x + k); out += (a instanceof Special) + "," + (b instanceof Kept) + "," + a.join() + "," + b.join() + ";"; } return out; } function arrayLikes() { let out = ""; for (let k = 0;k < 2; k++) out += Array.prototype.map.call({ length: 2, 0: "a", 1: "b" }, (x) => x + k).join() + "|" + Array.prototype.map.call("xy", (x) => x + k).join() + ";"; return out; } for (let turn = 0;turn < 3; turn++) { report([sums(), capturesTheTurn(), leavesEarly(), throwsInside(), changesTheList(), callsItself(), helperCalledByTheClosure(2)].join(" # ")); report([foldsObjects(), foldsOtherTypes(), withThis(), twoClosures(), sameClosureTwice(), namedFunction(), chosenClosure(turn === 1)].join(" # ")); report([closureWithDefaults(), closureWithRest(), closureWithArguments(), noList(), notAFunction()].join(" # ")); report([methods(), methodsOnOtherValues(), methodThrows(), reduceOfNothing()].join(" # ")); report([methodChangesTheList(), methodWithThisArgument(), methodReplaced(), species(), arrayLikes()].join(" # ")); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
