# THE YES OF `$findsDeclaredMember(object, "read")` TEACHES THE WALK, AND THE NEXT QUESTION ABOUT THE SAME OBJECT ASKS ITS GUARD ALONE.
# A yes has shown the shape, the bit of the object's own prototype link and the guard of the class and the name. So on the taken edge the object is of the layouts that were stamped and stands below its prototype:
# `$findsDeclaredMember(object, "step")` behind it is one test of one guard, and `object.step()` behind that yes is a direct call. Nine questions in a row were nine tests of one shape and of one bit.
# (Questions joined by `&&` with one place for every no are one test since: a-row-of-questions-about-declared-members-of-one-object-is-one-test.ir: `row` and `turns` here.)
# IT IS LEARNED ONLY WHILE THE ANSWER STILL STANDS: whatever may give the object another prototype between two questions, or between a question and the branch on it, brings the whole question back.
# An object that is given another prototype keeps its shape and ends no guard: the bit in its cell alone tells. RELINKED is the run that shows it: with the guard alone each `first other` would begin with `both`.
# A guard speaks for the receivers that declare ITS name: `either` is handed an heir that lays a `step` of its own, and the yes about `read` says nothing about that.
# IT IS LEARNED ONLY WHERE THE BRANCH THAT THE WALK HAS BUILT DECIDES THE QUESTION: `idle` asks and does nothing with the answer: OVERWRITTEN is the run that shows it: the declared `step` would be called for the new one.
# The functions that ask lie in a file of the library, and so do the three methods of Meter.
# function Meter(level) { this.level = level; }
# Meter.prototype.read = function () { return "read"; };
# Meter.prototype.step = function () { return "step"; };
# Meter.prototype.name = function () { return "name"; };
# function Gauge(level) { this.level = level; }
# Object.setPrototypeOf(Gauge.prototype, Meter.prototype);
# Gauge.prototype.step = heirs();
# function row(object) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step") && $findsDeclaredMember(object, "name")) return "all"; return "-"; }
# function amidst(object) { if (!$findsDeclaredMember(object, "read")) return "-"; amid(object); if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); }
# function stale(object) { const finds = $findsDeclaredMember(object, "step"); amid(object); if (finds) return "found " + object.step(); return "- " + object.step(); }
# function staleRow(object) { const finds = $findsDeclaredMember(object, "read"); amid(object); if (finds) { if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); } return "-"; }
# function turns(object, count) { let text = ""; for (let turn = 0; turn < count; turn++) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step")) text += "y"; else text += "n"; if (turn === 1) amid(object); } return text; }
# function caught(object) { if (!$findsDeclaredMember(object, "read")) return "-"; try { amid(object); fail(); } catch { if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); } return "no throw"; }
# function inner(object) { return $findsDeclaredMember(object, "step"); }
# function outer(object) { if (!$findsDeclaredMember(object, "read")) return "-"; amid(object); if (inner(object)) return "both " + object.step(); return "first " + object.step(); }
# function straight(object) { if (!$findsDeclaredMember(object, "read")) return "-"; if (inner(object)) return "both " + object.step(); return "first " + object.step(); }
# function relinks(object, link) { if (!$findsDeclaredMember(object, "read")) return "-"; Object.setPrototypeOf(object, link); if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); }
# function stores(object, link) { if (!$findsDeclaredMember(object, "read")) return "-"; object.__proto__ = link; if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); }
# function either(object) { if ($findsDeclaredMember(object, "read") && $findsDeclaredMember(object, "step")) return "both " + object.step(); return "- " + object.step(); }
# async function awaited(object) { if (!$findsDeclaredMember(object, "read")) return "-"; await undefined; if ($findsDeclaredMember(object, "step")) return "both " + object.step(); return "first " + object.step(); }
# function idle(object) { if (!$findsDeclaredMember(object, "read")) return "-"; if ($findsDeclaredMember(object, "step")) { } return object.step(); }
# function busy(object) { if (!$findsDeclaredMember(object, "read")) return "-"; let word = "no "; if ($findsDeclaredMember(object, "step")) word = "yes "; return word + object.step(); }
# function quiet(object, link, count) { let text = ""; for (let turn = 0; turn < count; turn++) { if ($findsDeclaredMember(object, "read")) { text += $findsDeclaredMember(object, "step") ? "y" : "n"; if (turn === 1) Object.setPrototypeOf(object, link); } else text += "-"; } return text; }
# function still(object, count) { let text = ""; for (let turn = 0; turn < count; turn++) { if ($findsDeclaredMember(object, "read")) text += $findsDeclaredMember(object, "step") ? "y" : "n"; else text += "-"; } return text; }
