# the engine quotes a read that failed only in an error whose trace has a frame, and a call that failed in every error: so does a message that compiled code makes
# function title(task) { try { return task.title; } catch (error) { return error.message; } }  function run(task) { try { return task.run(1); } catch (error) { return error.message; } }
# report(title(undefined)); report(run({})); report(run(null));  with Error.stackTraceLimit = 0, "10" (no number: no trace), 1
# RUN: run-in-shell Error.stackTraceLimit = 0; globalThis.report = message => print(message);
# CHECK: undefined is not an object
# CHECK-NEXT: task.run is not a function. (In 'task.run(1)', 'task.run' is undefined)
# CHECK-NEXT: null is not an object
# CHECK-NEXT: exited with 0
# RUN(ZERO): run-in-shell Error.stackTraceLimit = 0; globalThis.report = message => print(message);
# ZERO-NOT: evaluating
# RUN(TEXT): run-in-shell Error.stackTraceLimit = "10"; globalThis.report = message => print(message);
# TEXT-NOT: evaluating
# RUN(CALL): run-in-shell Error.stackTraceLimit = "10"; globalThis.report = message => print(message);
# CALL: task.run is not a function. (In 'task.run(1)', 'task.run' is undefined)
# RUN(ONE): run-in-shell Error.stackTraceLimit = 1; globalThis.report = message => print(message);
# ONE: undefined is not an object (evaluating 'task.title')
# ONE-NEXT: task.run is not a function. (In 'task.run(1)', 'task.run' is undefined)
# ONE-NEXT: null is not an object (evaluating 'task.run')
# ONE-NEXT: exited with 0
# PROGRAM-OF: quoted-text.ir
