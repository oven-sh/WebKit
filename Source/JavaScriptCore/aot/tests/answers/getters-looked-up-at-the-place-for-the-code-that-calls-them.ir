# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const hidden = JSON.parse('{"define":"defineProperty","below":"setPrototypeOf","n5":"n5"}'); const objects = Object; const names = []; for (let i = 0;i < 40; i++) names.push("n" + i); function getterOf(name, weight, holder) { return function() { return name + ":" + weight + ":" + (this === holder ? "own" : "other"); }; } function build(weight) { const flags = Object.create(null); for (let k = 0;k < names.length; k++) { const name = names[k]; Object.defineProperty(flags, name, { get: getterOf(name, weight, flags), enumerable: true, configurable: true }); } return flags; } const flagsA = build(1); const flagsB = build(2); const flagsC = build(3); const flagsD = build(4); const flagsE = build(5); function readA() { return flagsA.n3; } function readB() { return flagsB.n17; } function readC() { return flagsC.n5; } function readD() { return flagsD.n9; } function readE() { return flagsE.n39; } function often(read) { let last; for (let i = 0;i < 400; i++) last = read(); return last; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } tell(() => often(readA)); objects[hidden.define](flagsA, "n3", { get() { return "another function"; }, configurable: true }); tell(() => readA()); tell(() => often(readA)); tell(() => often(readB)); objects[hidden.define](flagsB, "n17", { value: "a value", configurable: true }); tell(() => readB()); tell(() => often(readB)); tell(() => often(readC)); delete flagsC[hidden.n5]; tell(() => readC()); tell(() => often(readC)); tell(() => often(readD)); objects[hidden.define](flagsD, "n9", { get: getterOf("n9", 90, flagsD), configurable: true }); tell(() => readD()); tell(() => often(readD)); tell(() => often(readE)); objects[hidden.below](flagsE, { more: 1 }); tell(() => readE()); flagsE.added = 1; tell(() => readE()); tell(() => often(readE)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
