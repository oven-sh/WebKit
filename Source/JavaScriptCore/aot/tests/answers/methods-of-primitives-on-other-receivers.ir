# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function attempt(way) { try { return way(); } catch (error) { return error.name; } } function codeAt(s, i) { return s.charCodeAt(i); } function sumOfCodes(s) { let sum = 0; for (let i = 0;i < s.length; i++) sum += s.charCodeAt(i); return sum; } function upper(s) { return s.toUpperCase(); } function firstIndex(s, part) { return s.indexOf(part); } function piece(s, from, to) { return s.slice(from, to); } function fixed(n) { return n.toFixed(1); } function textOfNumber(n, base) { return n.toString(base); } function textOfTruth(b) { return b.toString(); } function valueOfAny(v) { return v.valueOf(); } const wrapped = new String("abc"); const shadowed = new String("abc"); shadowed.charCodeAt = () => "own"; shadowed.toUpperCase = function() { return "OWN " + this.length; }; class Text extends String { charCodeAt(i) { return "below:" + super.charCodeAt(i); } } const plain = { length: 2, charCodeAt(i) { return "plain" + i; }, toUpperCase() { return "PLAIN"; }, indexOf() { return "nowhere"; }, slice() { return "no piece"; } }; const receivers = ["abc", "", "é中", wrapped, shadowed, new Text("abc"), plain, "ab" + String(1)]; for (let r = 0;r < receivers.length; r++) { report(codeAt(receivers[r], 1)); report(sumOfCodes(receivers[r])); report(upper(receivers[r])); report(firstIndex(receivers[r], "b")); report(piece(receivers[r], 1, 2)); } const notReceivers = [undefined, null, 5, true, 10n, Symbol("s"), {}, [], () => 1]; for (let r = 0;r < notReceivers.length; r++) { report(attempt(() => codeAt(notReceivers[r], 0))); report(attempt(() => sumOfCodes(notReceivers[r]))); report(attempt(() => upper(notReceivers[r]))); } const positions = [undefined, null, -1, 0, 1, 2, 3, 1.7, -0.5, NaN, 1 / 0, -1 / 0, "1", "x", true, { valueOf() { return 2; } }, [1], 4294967297]; for (let p = 0;p < positions.length; p++) { report(codeAt("abc", positions[p])); report(piece("abcdef", positions[p], 4)); report(piece("abcdef", 1, positions[p])); } report(attempt(() => codeAt("abc", Symbol("s")))); report(attempt(() => codeAt("abc", 1n))); report(attempt(() => codeAt("abc", { valueOf() { throw new RangeError("asked"); } }))); report(codeAt("abc")); const numbers = [1.25, -0, NaN, 1 / 0, new Number(2.5), { toFixed() { return "fixed here"; }, toString() { return "text here"; } }]; for (let n = 0;n < numbers.length; n++) { report(fixed(numbers[n])); report(textOfNumber(numbers[n])); report(attempt(() => textOfNumber(numbers[n], 2))); } report(attempt(() => textOfNumber(5, 1))); report(attempt(() => textOfNumber(5, 37))); report(attempt(() => fixed("1"))); report(textOfTruth(true)); report(textOfTruth(new Boolean(false))); report(attempt(() => textOfTruth(undefined))); report(valueOfAny("s")); report(valueOfAny(1)); report(valueOfAny(false)); report(valueOfAny(wrapped)); report(typeof valueOfAny(plain)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
