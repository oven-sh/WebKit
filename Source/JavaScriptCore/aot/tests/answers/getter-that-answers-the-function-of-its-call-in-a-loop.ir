# `formatter.format(value)`: the name finds a getter, which answers the function that is called. The read stands in the source as the read of a method for its call, which no guess counts: a guess that counted the getter all the same was opened over an empty stretch, the read was never built, and the walk stopped at the call.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const formatter = new Intl.NumberFormat("en"); const values = [1, 2.5, 1000]; for (let i = 0;i < values.length; i++) report(formatter.format(values[i])); function formatted(with_, value) { let text = ""; for (let i = 0;i < 2; i++) text += with_.format(value + i) + ";"; return text; } report(formatted(formatter, 7)); report(formatted(new Intl.NumberFormat("en"), 1234)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
