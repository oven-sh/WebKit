# made of 885607c1dc5376ea
# An object and a number are picked by one flag, and fields of both objects were read in front of the picks. What is read or written through the picked object is that object's, on either arm.
# Here the field holds a text or null; the calls are written out.
# class Entry { constructor(name, size, note) { this.name = name; this.size = size; this.note = note; } }
# function pick(a, b, key, exact) { if (!a.size || !b.size || a.note === null || b.note === null) return "none"; const flag = exact ? key === a.size : key < b.size; const side = flag ? a : b; const size = flag ? a.size : b.size; if (size && side.note !== null) return side.note; return "leaf"; }
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 1, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 1, true));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 3, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 3, true));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 9, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 9, true));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 1, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 1, true));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 3, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 3, true));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 9, false));
# report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 9, true));
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Entry { constructor(name, size, note) { this.name = name; this.size = size; this.note = note; } } function pick(a, b, key, exact) { if (!a.size || !b.size || a.note === null || b.note === null) return "none"; const flag = exact ? key === a.size : key < b.size; const side = flag ? a : b; const size = flag ? a.size : b.size; if (size && side.note !== null) return side.note; return "leaf"; } report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 1, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 1, true)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 3, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 3, true)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 9, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, "second"), 9, true)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 1, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 1, true)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 3, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 3, true)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 9, false)); report(pick(new Entry("a", 1, "first"), new Entry("b", 5, null), 9, true)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
