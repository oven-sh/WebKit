# Each kind of declared parameter, and this, is handed what is declared, what is not, undefined, null, nothing and too much, in turns: the guard at the entry lets the one kind into the fast version and sends the other to the slow one. An object is changed by a callee in the middle of the fast version, a parameter is assigned to, and a recursion turns wrong halfway down.
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Point { x; y; constructor(x, y) { this.x = x; this.y = y; } sum() { return this.x + this.y; } scaled(by) { return this.x * by + this.y * by; } } class Point3 extends Point { z; constructor(x, y, z) { super(x, y); this.z = z; } sum() { return this.x + this.y + this.z; } } let said = ""; const any = (value) => value; function tell(run) { try { report(String(run())); } catch (thrown) { report(thrown.name); } } function area(point, scale) { const across = point.x * scale; const down = point.y * scale; return across * down + point.x; } function text(s, n) { const long = s.length + n; return s + ":" + long + ":" + s.charCodeAt(0); } function list(items, at) { const long = items.length; return items[at] + long + items[0]; } function both(a, b) { return a.x + b.x + a.y + b.y; } function assigned(point, other) { const before = point.x + point.y; point = any(other); return before + point.x + point.y; } function changes(point, change) { const before = point.x + point.y; change(point); return before + "|" + point.x + "|" + point.y + "|" + Object.keys(point).join(); } function down(point, next, depth) { const here = point.x + point.y; return depth >= next.length ? here : here + down(any(next[depth]), next, depth + 1); } const odd = [new Point(1, 2), { x: 3, y: 4 }, { y: 5, x: 6 }, new Point3(1, 2, 3), "text", 7, 2.5, true, null, undefined, [8, 9], ["a", "b"], [1.5, , "c"], { get x() { said += "x"; return 10; }, get y() { said += "y"; return 11; } }, new Point(12, 13)]; for (let at = 0;at < odd.length; at++) { const one = odd[at]; tell(() => area(any(one), 2)); tell(() => area(new Point(1, 1), any(one))); tell(() => text(any(one), 1)); tell(() => list(any(one), 1)); tell(() => both(new Point(1, 2), any(one))); tell(() => both(any(one), new Point(1, 2))); tell(() => assigned(new Point(1, 2), one)); } tell(() => area()); tell(() => area(new Point(2, 3))); tell(() => area(new Point(2, 3), 2, "more", {})); const holders = [new Point(1, 2), { x: 3, y: 4, sum: Point.prototype.sum, scaled: Point.prototype.scaled }, new Point3(1, 2, 3), { sum: Point.prototype.sum, scaled: Point.prototype.scaled }, { y: "b", x: "a", scaled: Point.prototype.scaled, sum: Point.prototype.sum }, new Point(5, 6)]; for (let at = 0;at < holders.length; at++) { const holder = holders[at]; tell(() => holder.sum()); tell(() => holder.scaled(2)); tell(() => holder.scaled(any("3"))); } const loose = new Point(1, 2).sum; tell(() => loose()); tell(() => changes(new Point(1, 2), (p) => { Object.freeze(p); })); tell(() => changes(new Point(1, 2), (p) => { delete any(p).x; })); tell(() => changes(new Point(1, 2), (p) => { Object.defineProperty(p, "y", { get() { said += "g"; return 40; }, configurable: true, enumerable: true }); })); tell(() => changes(new Point(1, 2), (p) => { Object.setPrototypeOf(p, { x: "above", extra: 1 }); delete any(p).x; })); tell(() => changes(new Point(1, 2), (p) => { any(p).more = 1; p.x = any("text"); })); tell(() => down(new Point(1, 1), [new Point(2, 2), new Point(3, 3)], 0)); tell(() => down(new Point(1, 1), [new Point(2, 2), { x: "a", y: "b" }, new Point(3, 3)], 0)); tell(() => down(new Point(1, 1), [new Point(2, 2), null, new Point(3, 3)], 0)); tell(() => down(new Point(1, 1), [{ x: 1, y: 2 }, new Point(2, 2), 5, new Point3(1, 1, 1)], 0)); report(said); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
