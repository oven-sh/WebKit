# `$findsNoMember(object, "missing")` WHERE NOTHING IS PROVEN OF THE OPERAND AND A LAYOUT IS EXPECTED OF IT: as its sister `$findsDeclaredMember` does, the question takes what is expected and tests the shape itself.
# So it can be asked of `this` in a constructor function of the library's, and of a parameter of a function that anybody may call. A cell of another shape gets a no, whatever it holds: false says nothing.
# function Meter(level) { this.level = level; this.count = 1; }
# function Gauge() { this.missing = 7; this.level = 0; }
# function asks(object: Meter) { return $findsNoMember(object, "missing") ? "lacks" : "may hold"; }   in the library; handed to code that the build has not seen
# hand(asks, new Meter(5), new Gauge(), Meter);
# f3 = asks
# OPTIONS: mechanisms=all
# RUN(FORM): walk f3
# FORM: b0(v0: anything
# FORM: = FindsNoMember v0 key="missing" conditions=[{layout=L0 key="missing"}] receivers=[L0]
# A Meter lacks the name. A Gauge HOLDS it and is of another shape; so are a literal that holds it, one that does not, and what is no object: each gets the no that says nothing.
# RUN(ASKED): run-in-shell hand = function (asks, meter, gauge) { print(asks(meter), "|", asks(gauge), "|", asks({ missing: 1 }), "|", asks({ }), "|", asks(5), asks(null), asks(undefined), asks("text")); };
# ASKED: lacks | may hold | may hold | may hold | may hold may hold may hold may hold
# ASKED-NEXT: exited with 0
# Whoever lays the name ends the yes: on the object, on the prototype, by an accessor, by an object laid between (which ends the guard of the class, for every Meter).
# RUN(OWN): run-in-shell hand = function (asks, meter) { print(asks(meter)); meter.missing = 1; print(asks(meter)); };
# OWN: lacks
# OWN-NEXT: may hold
# RUN(ABOVE): run-in-shell hand = function (asks, meter, gauge, Meter) { print(asks(meter)); Meter.prototype.missing = 2; print(asks(meter), asks(new Meter(1))); };
# ABOVE: lacks
# ABOVE-NEXT: may hold may hold
# RUN(ACCESSORABOVE): run-in-shell hand = function (asks, meter, gauge, Meter) { Object.defineProperty(Meter.prototype, "missing", { get() { return 3; }, configurable: true }); print(asks(meter)); };
# ACCESSORABOVE: may hold
# RUN(LINK): run-in-shell hand = function (asks, meter, gauge, Meter) { const link = Object.create(Meter.prototype); link.missing = 4; Object.setPrototypeOf(meter, link); print(asks(meter), asks(new Meter(1))); };
# LINK: may hold may hold
# Another property of its own sends the question to the place of the name, which remembers nothing yet: a no.
# RUN(OWNOTHER): run-in-shell hand = function (asks, meter) { meter.unrelated = 1; print(asks(meter)); meter.missing = 1; print(asks(meter)); };
# OWNOTHER: may hold
# OWNOTHER-NEXT: may hold
# Code that no mechanism has touched answers no.
# RUN(CLOSED): run-in-shell mechanisms=none hand = function (asks, meter) { print(asks(meter)); };
# CLOSED: may hold
