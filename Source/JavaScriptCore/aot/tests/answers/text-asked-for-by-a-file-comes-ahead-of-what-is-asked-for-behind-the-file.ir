# a text comes in the order in which it was asked for, and a module asks for what it imports when its own text has come
# main.js: import "./asks.cjs"; import "./first.js"; print("main")      asks.cjs: import("./late.js"); print("asks")      first.js: import "./second.js"; print("first")
# asks.cjs runs while the graph of main.js is loaded. The text of first.js comes behind that of asks.cjs, so second.js is asked for behind late.js: late.js runs ahead of the graph
# RUN: run-in-shell mechanisms=none
# CHECK: asks
# CHECK-NEXT: late
# CHECK-NEXT: second
# CHECK-NEXT: first
# CHECK-NEXT: main
# CHECK-NEXT: exited with 0
# RUN(ALL): run-in-shell mechanisms=all
# ALL: asks
# ALL-NEXT: late
# ALL-NEXT: second
# ALL-NEXT: first
# ALL-NEXT: main
# ALL-NEXT: exited with 0

module m0 path="/main.js" displayPath="main.js" body=f0 requests=[{target=m2 completes=true isHoisted=true}, {target=m2 completes=true}, {target=m3 completes=true}]
module m1 path="/asks.cjs" displayPath="asks.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f1 exportsVariable=g0
module m2 path="#2" displayPath="asks.cjs" flags=[CachesEvaluationError] exportRule=CommonJs body=f2 requests=[{target=m1 kind=Require completes=true}] syntheticExports=[{name="default" variable=g1}]
module m3 path="/first.js" displayPath="first.js" body=f3 requests=[{target=m4 completes=true}]
module m4 path="/second.js" displayPath="second.js" body=f4
module m5 path="/late.js" displayPath="late.js" body=f5
entry module=m0
variable g0 name="exports" module=m1 declared={type=anything} initialization=Undefined
variable g1 name="default" module=m2 declared={type=anything|absent}
function f0 name="main" module=m0 kind=Module results=[{type=anything}] {
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="print" [isFreeName]
    v2 = String string="main"
    v3 = Call v1, -, v2
    Return
}
function f1 name="asks" module=m1 kind=CommonJsModule flags=[IsSloppy] results=[{type=anything}] {
    v0 = ImportModule module=m5 referrer=m1
    v1 = Builtin builtin=GlobalThis
    v2 = PropGet v1 key="print" [isFreeName]
    v3 = String string="asks"
    v4 = Call v2, -, v3
    v5 = NewDictionary
    PutModuleVariable v5 variable=g0
    Return
}
function f2 name="facadeOfAsks" module=m1 kind=Module results=[{type=anything}] {
    EvaluateModule module=m1 referrer=m2 [isBare]
    Return
}
