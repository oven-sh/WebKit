# AN HEIR ON WHOSE PROTOTYPE AN ACCESSOR LIES, OR MAY LIE, UNDER THE NAME OF A FIELD OF THE CLASS THAT IS ASKED IS NOT AMONG THE CLASSES OF `$isPlainHeirOf`: its objects get a no by their shape, and THE OTHER CLASSES KEEP THEIR YES.
# `Lazy`: halves that the compiler does not see (a call hands them back): its guard "stores pass" under that name would be born ended where the heir is armed: a no for ever, which the shape says for nothing.
# `Written`: halves of the library that the compiler sees. The name left the list of that heir ("a member, not a field") and the heir stayed taken: an object that HAS NO SUCH FIELD YET got a yes, and whoever spares the read behind the yes leaves it unmade.
# What a program does at run time to a class that IS taken ends the yes for its objects and for those of the classes below it, and for no others: the last two groups.
# function Stream() { this.state = 1; }
# Stream.prototype.end = function () { return 1; };
# function Plain() { Stream.call(this); this.more = 3; }
# Object.setPrototypeOf(Plain.prototype, Stream.prototype);
# Object.setPrototypeOf(Plain, Stream);
# function Lazy() { this.options = 2; }
# Object.setPrototypeOf(Lazy.prototype, Stream.prototype);
# Object.setPrototypeOf(Lazy, Stream);
# function libraryMakeGetter() { return function () { Stream.call(this); return this.state; }; }            in a file of the library
# function libraryMakeSetter() { return function (value) { Object.defineProperty(this, "state", { value, enumerable: true, configurable: true, writable: true }); }; }            in a file of the library
# Object.defineProperties(Lazy.prototype, { state: { get: libraryMakeGetter(), set: libraryMakeSetter(), configurable: true, enumerable: true } });
# function Written() { this.options = 4; }
# Object.setPrototypeOf(Written.prototype, Stream.prototype);
# Object.setPrototypeOf(Written, Stream);
# Object.defineProperty(Written.prototype, "state", { get() { Stream.call(this); return this.state; }, set(value) { Object.defineProperty(this, "state", { value, enumerable: true, configurable: true, writable: true }); }, configurable: true, enumerable: true });
# function ask(stream) { return $isPlainHeirOf(stream, Stream) ? "yes" : "no"; }            in a file of the library
# const Streams = keep(Stream), Plains = keep(Plain), Lazies = keep(Lazy), Writtens = keep(Written), asks = keep(ask);
# first(Lazies, Writtens);
# print(asks(new Streams()), "|", asks(new Plains()));
# const lazy = new Lazies(), written = new Writtens();
# print(asks(new Streams()), "|", asks(new Plains()), "|", asks(lazy), Object.keys(lazy).join(), "|", asks(written), Object.keys(written).join());
# print(lazy.state, written.state, "|", asks(lazy), Object.keys(lazy).join(), "|", asks(written), Object.keys(written).join());
# later(Plains.prototype, Streams.prototype);
# print(asks(new Streams()), "|", asks(new Plains()), "|", asks(lazy), "|", asks(written));
