# `$isPlainInstanceOf(object, Gauge)` AND AN ACCESSOR THAT COMPILED CODE LAYS ON AN OBJECT WITH THE DESCRIPTOR IN LINK's SIGHT. Link appends the name to the layout as a field that holds an accessor,
# the accessor lands in its slot: no property beside the fields, no mark on the cell. So the walk stamps nothing for a layout that has such a slot.
# class Gauge { level: number; mark: string; constructor(level: number) { this.level = level; this.mark = "m"; } read() { return this.level; } }
# function change(made: Gauge): void { Object.defineProperty(made, "other", { get() { return 70; }, configurable: true }); }
# function ask(object: unknown): string { return $isPlainInstanceOf(object, Gauge) ? "plain" : "-"; }      in a file of the library
# const made = new Gauge(5);
# print(ask(made));
# change(made);
# print(ask(made), ask(new Gauge(8)), made.read(), made.mark, (made as any).other);
# It said "plain plain". Every run of the sibling test lays its accessor from the shell, where Link never sees the definition.
# f2 = ask
# OPTIONS: mechanisms=all
# RUN(FORM): walk f2
# FORM: = IsPlainInstanceOf
# FORM-NOT: receivers=
# RUN: run-in-shell
# CHECK: -
# CHECK-NEXT: - - 5 m 70
# CHECK-NEXT: exited with 0

