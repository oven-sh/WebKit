# function keysKnown(q: Q) { let s = ""; for (const k in q) s += k + ","; return s + "|" + Object.keys(q).join(","); }
# function readKnown(q: Q) { const o = q as any; return String(o.x) + ":" + String(o.a) + ":" + String(o.b) + ":" + String(o.never) + ":" + ("a" in o) + ":" + ("never" in o); }
