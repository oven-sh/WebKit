# The walk knows both operands of each operation here. The bytes of the NaN are those that the same text gives where nothing is folded: the shell runs the names as they are written.
# The first seven lines differ from one processor to the next: x86-64 sets the sign of a NaN that it makes, ARM64 does not. The source is what they are held to.
# -- source: main.js
# const zero = 0, endless = Infinity, less = -1, half = 0.5, eight = -8, third = 0.3333333333333333, most = 1.5, nothing = undefined, none = NaN, one = 1, two = 2;
# report("quotient", zero / zero);
# report("negated quotient", -(zero / zero));
# report("difference", endless - endless);
# report("product", endless * zero);
# report("root", less ** half);
# report("cube root", eight ** third);
# report("less to most", less ** most);
# report("negated undefined", -nothing);
# report("negated NaN", -none);
# report("NaN and one", none + one);
# report("NaN times less", none * less);
# report("two to NaN", two ** none);
# report("less to endless", less ** endless);
# -- end of source
# RUN: run-in-shell (function () { const bits = new BigUint64Array(1), number = new Float64Array(bits.buffer); globalThis.report = (name, value) => { number[0] = value; print(name, bits[0].toString(16)); }; })();
# CHECK-NOT: AOT validation
# CHECK: quotient
# CHECK: less to most
# CHECK-NEXT: negated undefined fff8000000000000
# CHECK-NEXT: negated NaN fff8000000000000
# CHECK-NEXT: NaN and one 7ff8000000000000
# CHECK-NEXT: NaN times less 7ff8000000000000
# CHECK-NEXT: two to NaN 7ff8000000000000
# CHECK-NEXT: less to endless 7ff8000000000000
# CHECK-NEXT: exited with 0
# CHECK-NEXT: the source prints the same

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="report" [isFreeName]
    v2 = Integer
    v3 = Double number=Infinity
    v4 = Integer integer=-1
    v5 = Double number=0.5
    v6 = Integer integer=-8
    v7 = Double number=0.3333333333333333
    v8 = Double number=1.5
    v9 = Undefined
    v10 = Double number=NaN
    v11 = Integer integer=1
    v12 = Integer integer=2
    v13 = String string="quotient"
    v14 = Div v2, v2
    v15 = Call v1, -, v13, v14 calleeName="report"
    v16 = String string="negated quotient"
    v17 = Div v2, v2
    v18 = Negate v17
    v19 = Call v1, -, v16, v18 calleeName="report"
    v20 = String string="difference"
    v21 = Sub v3, v3
    v22 = Call v1, -, v20, v21 calleeName="report"
    v23 = String string="product"
    v24 = Mul v3, v2
    v25 = Call v1, -, v23, v24 calleeName="report"
    v26 = String string="root"
    v27 = Pow v4, v5
    v28 = Call v1, -, v26, v27 calleeName="report"
    v29 = String string="cube root"
    v30 = Pow v6, v7
    v31 = Call v1, -, v29, v30 calleeName="report"
    v32 = String string="less to most"
    v33 = Pow v4, v8
    v34 = Call v1, -, v32, v33 calleeName="report"
    v35 = String string="negated undefined"
    v36 = Negate v9
    v37 = Call v1, -, v35, v36 calleeName="report"
    v38 = String string="negated NaN"
    v39 = Negate v10
    v40 = Call v1, -, v38, v39 calleeName="report"
    v41 = String string="NaN and one"
    v42 = Add v10, v11
    v43 = Call v1, -, v41, v42 calleeName="report"
    v44 = String string="NaN times less"
    v45 = Mul v10, v4
    v46 = Call v1, -, v44, v45 calleeName="report"
    v47 = String string="two to NaN"
    v48 = Pow v12, v10
    v49 = Call v1, -, v47, v48 calleeName="report"
    v50 = String string="less to endless"
    v51 = Pow v4, v3
    v52 = Call v1, -, v50, v51 calleeName="report"
    v53 = Undefined
    Return v53
}
