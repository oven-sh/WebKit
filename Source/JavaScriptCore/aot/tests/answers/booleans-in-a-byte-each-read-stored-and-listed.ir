# RUN(ALSO1): run-in-shell mechanisms=-TypedSlots (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Flags { a = false; b = false; c = false; d = false; } function make(on) { const flags = new Flags; flags.a = on; flags.d = !on; return flags; } function count(flags) { return (flags.a ? 1 : 0) + (flags.b ? 2 : 0) + (flags.c ? 4 : 0) + (flags.d ? 8 : 0); } function flip(flags) { flags.b = !flags.b; flags.c = flags.a; } function tell(flags) { report(count(flags)); report(flags.a); report(flags.b); report(flags.c); report(flags.d); report(JSON.stringify(flags)); report(Object.keys(flags).join()); } for (let i = 0;i < 4; i++) { const flags = make(i > 1); if (i & 1) flip(flags); tell(flags); } const kept = make(true); flip(kept); flip(kept); tell(kept); report(typeof kept.a); report(kept.a === true); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
