# The first construction makes the prototype property, and the storage of the function moves.
# -- source: main.ts
# declare function print(...values: unknown[]): void;
# const R = JSON.parse("2") - 1, N = JSON.parse("2") + 40, M = JSON.parse("2") + 1000000;
# const id = (x: any) => JSON.parse("[0]").map(() => x)[0];
# function fill(o: any) { o.held = 0; o.a = 1; o.b = 1; o.c = 1; } // four properties: the storage is full
# function t(other: any, stop: number) {
#   for (let r = 0; r < R; r++) {
#     const F: any = function (this: any) {};
#     const o = id(other ?? F);
#     fill(o);
#     let last: any, out: any, big: any, small: any;
#     for (let i = 0; i < N; i++) {
#       const v = o.held;
#       o.held = i === 5 ? [1.5, 2.5, i] : v;
#       if (i === stop) break;
#       out = i === N - 1 ? v : 0;
#       last = new F(); // first construction: F.prototype is made, the butterfly grows
#       big = new Uint8Array(M * 80);
#       small = [i, i, i];
#     }
#     if (stop < 0) print(String(out), String(Reflect.get(o, "held")), typeof last, typeof big, typeof small);
#   }
# }
# for (let z = 0; z < 400; z++) { t(JSON.parse(`{"x${z % 20}":1}`), 0); t(null, 0); }
# t(null, -1);
# -- end of source
# RUN: run-in-shell
# CHECK: 1.5,2.5,5 1.5,2.5,5 object object object
# CHECK-NEXT: exited with 0

