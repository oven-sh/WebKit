# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { class Item { kind; size; constructor(kind, size) { this.kind = kind; this.size = size; } get twice() { return this.size * 2; } set twice(v) { this.size = v / 2; } } function kindOf(node) { let k = "kind"; return node[k]; } function setKind(node, v) { let k = "kind"; node[k] = v; } function twiceOf(node) { let k = "twice"; return node[k]; } function setTwice(node, v) { let k = "twice"; node[k] = v; } function hasKind(node) { let k = "kind"; return k in node; } function underUndefined(o) { return o[undefined]; } function underNull(o) { return o[null]; } function underTrue(o) { return o[true]; } function first(o) { let k = "0"; return o[k]; } function above(o) { let k = "__proto__"; return o[k]; } function setAbove(o, v) { let k = "__proto__"; o[k] = v; } function lengthOf(o) { let k = "length"; return o[k]; } function listen(o, kind, f) { o["on" + kind] = f; } function hide(o, rest, v) { o["__" + rest] = v; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } const node = new Item("a", 2); tell(() => kindOf(node)); tell(() => { setKind(node, "b"); return node.kind; }); tell(() => { setKind(node, 7); return typeof node.kind; }); tell(() => twiceOf(node)); tell(() => { setTwice(node, 10); return node.size; }); tell(() => hasKind(node)); tell(() => hasKind({})); tell(() => kindOf({ kind: "literal" })); tell(() => kindOf({ get kind() { return "getter"; } })); tell(() => kindOf("text")); tell(() => kindOf(null)); tell(() => kindOf(undefined)); tell(() => { setKind(null, 1); return "stored"; }); tell(() => { const frozen = Object.freeze({ kind: "kept" }); setKind(frozen, "lost"); return frozen.kind; }); tell(() => { delete node.kind; return kindOf(node); }); tell(() => { setKind(node, "again"); return Object.keys(node).join(); }); tell(() => underUndefined({ undefined: "u" })); tell(() => underNull({ null: "n" })); tell(() => underTrue({ true: "t" })); tell(() => underUndefined(node)); tell(() => first(["zero"])); tell(() => first({ 0: "nought" })); tell(() => first("xyz")); tell(() => above({}) === Object.prototype); tell(() => above(node) === Item.prototype); tell(() => { const o = {}; setAbove(o, { inherited: 1 }); return o.inherited; }); tell(() => { const o = {}; setAbove(o, { inherited: 1 }); return Object.keys(o).length; }); tell(() => lengthOf([1, 2, 3])); tell(() => lengthOf("four")); tell(() => lengthOf({ length: "own" })); tell(() => { const o = { onopen: 0 }; listen(o, "open", 1); listen(o, "close", 2); return Object.keys(o).join() + o.onopen + o.onclose; }); tell(() => { const o = { set onopen(v) { report("setter " + v); } }; listen(o, "open", 3); return Object.keys(o).join(); }); tell(() => { const o = { a: 1 }; hide(o, "proto__", { inherited: 2 }); return o.inherited + Object.keys(o).join(); }); tell(() => { const o = { a: 1 }; hide(o, "other", 3); return Object.keys(o).join(); }); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
