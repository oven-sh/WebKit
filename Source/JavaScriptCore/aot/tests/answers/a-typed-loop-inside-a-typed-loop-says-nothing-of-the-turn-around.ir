# made of 4f44f501e8c6a3b1
# A typed loop stands inside a typed loop. The head of the inner typed copy begins a turn of its own; what leaves the inner loop says nothing of the turn of the loop around, which has done a deed in front of it.
# Until 11-04 09:1x the one bit of the state was cleared at the inner head and carried out, and the failing test of `extra.value` began the OUTER turn again: `deeds` counted 41 for 40.
# f1 = id, f2 = run
# function id<T>(value: T): T { (globalThis as any).leaked = value; return (globalThis as any).leaked; }
# type Box = { value: number };
# type Table = { scale: number };
# let deeds = 0;
# function run(rows: Box[][], extras: Box[], tables: Table[]): number { const table = tables[0]; let total = 0; for (let r = 0; r < rows.length; r++) { deeds++; total += table.scale; const row = rows[r]; const extra = extras[r]; let sum = 0; let i = 0; for (; i < row.length; i++) sum += row[i].value; total += (sum | 0) + (i & 7) + extra.value; } return total; }
# const rows: Box[][] = []; const extras: Box[] = []; const tables: Table[] = [{ scale: 2 }];
# for (let r = 0; r < 40; r++) { const row: Box[] = []; for (let i = 0; i < 10; i++) row.push({ value: 1 }); rows.push(row); extras.push({ value: 1 }); }
# extras[25] = JSON.parse('{"value":1}');
# id(run);
# report(run(id(rows), id(extras), id(tables)) + " " + deeds);
# report(run(id(rows), id(extras), id(tables)) + " " + deeds);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function id(value) { globalThis.leaked = value; return globalThis.leaked; } let deeds = 0; function run(rows, extras, tables) { const table = tables[0]; let total = 0; for (let r = 0;r < rows.length; r++) { deeds++; total += table.scale; const row = rows[r]; const extra = extras[r]; let sum = 0; let i = 0; for (;i < row.length; i++) sum += row[i].value; total += (sum | 0) + (i & 7) + extra.value; } return total; } const rows = []; const extras = []; const tables = [{ scale: 2 }]; for (let r = 0;r < 40; r++) { const row = []; for (let i = 0;i < 10; i++) row.push({ value: 1 }); rows.push(row); extras.push({ value: 1 }); } extras[25] = JSON.parse('{"value":1}'); id(run); report(run(id(rows), id(extras), id(tables)) + " " + deeds); report(run(id(rows), id(extras), id(tables)) + " " + deeds); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
# CHECK: 3 of 3 of 3
# CHECK-NEXT: exited with 0

