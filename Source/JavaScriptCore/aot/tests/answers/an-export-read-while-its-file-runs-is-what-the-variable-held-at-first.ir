# early.cjs   sink(box[require("./ring.cjs").kB]);
# main.cjs    require("./ring.cjs");
# The records say of no request on the ring that it completes: kB may still be as it was at first, and the read is a read.
# RUN(LINK): link variables mechanisms=all
# LINK: variable g0 proven=undefined|symbol("b")@m2:1
# LINK-NOT: filled
# RUN(SHELL): run-in-shell globalThis.box = { undefined: "right" }; globalThis.sink = value => print("said " + String(value));
# SHELL: said right
# SHELL: exited with 0

layout L0 module=m0 fields=[{key=symbol("b")@m2:1 declared={type=anything} flags=[IsNeverWritten]}] flags=[IsNeverAllocated]
variable g0 name="kB" module=m2 declared={type=anything} initialization=Undefined
module m0 path="main.cjs" displayPath="main.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f0 requests=[{target=m2 kind=Require}]
module m1 path="early.cjs" displayPath="early.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f1 requests=[{target=m2 kind=Require}]
module m2 path="ring.cjs" displayPath="ring.cjs" kind=CommonJs flags=[CachesEvaluationError] exportRule=CommonJs requireResult=ModuleExports body=f2 requests=[{target=m1 kind=Require}]
entry module=m0
function f0 module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m2 referrer=m0 [isBare, isCallOfRequire]
    v1 = Undefined
    Return v1
}
function f1 module=m1 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m2 referrer=m1 [isBare, isCallOfRequire]
    v1 = GetModuleVariable variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = PropGet v2 key="box" [isFreeName]
    v4 = ElemGet v3, v1
    v5 = PropGet v2 key="sink" [isFreeName]
    v6 = Call v5, -, v4 calleeName="sink"
    v7 = Undefined
    Return v7
}
function f2 module=m2 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
  b0():
    EvaluateModule module=m1 referrer=m2 [isBare, isCallOfRequire]
    v1 = Builtin builtin=Symbol
    v2 = String string="b"
    v3 = Call v1, -, v2 calleeName="Symbol" callNumber=1
    PutModuleVariable v3 variable=g0
    v5 = Undefined
    Return v5
}
