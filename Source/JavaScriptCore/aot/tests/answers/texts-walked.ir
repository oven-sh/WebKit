# A for-of and a pattern over a text step it by code point: surrogates in pairs and alone, ropes, String objects with and without an @@iterator of their own.
# LIBRARY: own
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { function pieces(text) { let s = ""; for (const piece of text) s += "[" + piece + "]" + piece.length; return s; } report(pieces("abc")); report(pieces("")); report(pieces("a\uD83D\uDE00b")); report(pieces("\uD83D\uDE00\uD83D\uDE00")); report(pieces("\uD83D")); report(pieces("\uDE00\uD83D")); report(pieces("x\uD83Dy\uDE00")); report(pieces("\uD83D\uD83D\uDE00")); report(pieces("é漢字")); report(pieces("ab".repeat(3) + "c" + String(12))); function anyPieces(text) { let s = ""; for (const piece of text) s += "[" + piece + "]"; return s; } report(anyPieces("a\uD83D\uDE00")); report(anyPieces(new String("ob"))); report(pieces(new String("ob"))); report(pieces(["l", "i"])); const wrapped = new String("xy"); wrapped[Symbol.iterator] = function* () { yield "own"; }; report(pieces(wrapped)); function literal() { let s = ""; for (const piece of "h\uD83D\uDE00i") s += piece + "|"; return s; } report(literal()); function firstTwo(text) { const [a, b, c] = text; return a + "," + b + "," + c; } report(firstTwo("\uD83D\uDE00z")); report(firstTwo("")); function restOf(text) { const [a, ...rest] = text; return a + "/" + rest.join("|"); } report(restOf("a\uD83D\uDE00c")); function withDefault(text) { const [a = "d", b = a + "e"] = text; return a + b; } report(withDefault("q")); function leaves(text) { let s = ""; for (const piece of text) { if (piece === "c") break; s += piece; } return s; } report(leaves("abcd")); function counts(text) { let n = 0; for (const _ of text) n++; return n; } report(counts("a\uD83D\uDE00b\uD83D\uDE00")); function nested(text) { let s = ""; for (const a of text) for (const b of text) s += a + b + ","; return s; } report(nested("x\uD83D\uDE00")); function spreads(text) { return [...text].length + ":" + [...text].join("|"); } report(spreads("a\uD83D\uDE00b")); function* yields(text) { for (const piece of text) yield piece + piece; } report([...yields("a\uD83D\uDE00")].join()); async function awaits(text) { let s = ""; for (const piece of text) s += await piece; return s; } report(await awaits("a\uD83D\uDE00b")); try { report(pieces(undefined)); } catch (error) { report(error instanceof TypeError); } try { report(pieces(5)); } catch (error) { report(error instanceof TypeError); } report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
