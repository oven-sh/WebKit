# The body of a constructor function creates what it stores on this in the order in which the stores are written, whatever happens to the object between two rows of them.
# At the end the shell runs the same text itself: every answer is the same.
# LIBRARY: own
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { const kFirst = Symbol("first"); const kSecond = Symbol("second"); function Base() { this.base1 = 1; this.base2 = 2; } Base.prototype.kind = function() { return "base"; }; function touch(o, how) { if (how === 1) o.extra = "e"; if (how === 2) delete o.a; if (how === 3) Object.freeze(o); if (how === 4) o.c = "early"; if (how === 5) Object.defineProperty(o, "d", { get() { return "got"; }, set(v) { o.seen = v; }, enumerable: true, configurable: true }); if (how === 6) o[kSecond] = "early"; if (how === 7) Object.preventExtensions(o); return how; } function Made(how, path) { this.a = 1; this[kFirst] = "f"; this.b = 2; touch(this, how); this.c = 3; this[kSecond] = "s"; this.d = 4; if (path === 1) { this.e = 5; Base.call(this); return; } this.f = path === 2 ? 6 : undefined; touch(this, 0); Base.call(this); this.g = 7; } Made.prototype = Object.create(Base.prototype); const show = (o) => [Object.keys(o).join(), Reflect.ownKeys(o).map(String).join(), JSON.stringify(o), Object.isFrozen(o), Object.isExtensible(o)].join("|"); function make(how, path) { try { return show(new Made(how, path)); } catch (e) { return e.name; } } function makeOn(target, how, path) { try { Made.call(target, how, path); return show(target); } catch (e) { return e.name + "|" + show(target); } } for (let how = 0;how < 8; how++) { for (let path = 0;path < 3; path++) report(make(how, path)); } report(makeOn({}, 0, 0)); report(makeOn({ d: "own", a: "own" }, 0, 1)); report(makeOn(new Made(0, 1), 0, 2)); report(makeOn(new Base, 0, 0)); report(makeOn(Object.create(Made.prototype), 4, 2)); report(makeOn([], 0, 1)); Object.defineProperty(Made.prototype, "c", { set(v) { this.viaSetter = v; }, configurable: true }); report(make(0, 0)); report(make(1, 1)); Object.defineProperty(Base.prototype, "g", { value: "fixed", writable: false, configurable: true }); report(make(0, 2)); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
