# tell(() => read(new Plain("again")));
# tell(() => handlerOf(handlers, "open"));
# tell(() => pick("b"));
# report(log);
# report("end");
# At the end the shell runs the same text itself: every answer is the same.
# RUN: run-in-shell (function () { "use strict"; const show = value => typeof value === "string" ? JSON.stringify(value) : Object.is(value, -0) ? "-0" : String(value); const twin = async report => { let log = ""; let last = "start"; class Plain { kind; constructor(kind) { this.kind = kind; } } class Lazy { get kind() { log += "g"; return "lazy"; } set kind(v) { log += "s"; } } function read(o) { const k = "kind"; return o[k]; } function store(o, v) { const k = "kind"; o[k] = v; return o.kind; } function has(o) { const k = "kind"; return k in o; } function remove(o) { const k = "kind"; return delete o[k]; } function underUndefined(o) { return o[undefined]; } function underIndex(o) { const k = "1"; return o[k]; } function handlerOf(handlers, type) { return handlers["on" + type]; } function pick(name) { const table = { a: 1, b: 2 }; last = "before"; const found = table[name]; return found + ":" + last; } function tell(f) { try { report(f()); } catch (e) { report(e.name); } } const handlers = { onopen: "open", get onclose() { log += "c"; return "close"; } }; const converts = { toString() { last = "converted"; return "b"; } }; tell(() => read(new Plain("p"))); tell(() => read(new Lazy)); tell(() => read({ other: 1 })); tell(() => read("text")); tell(() => read(undefined)); tell(() => store(new Plain("p"), "q")); tell(() => store(new Lazy, "q")); tell(() => store(Object.freeze({ kind: "frozen" }), "q")); tell(() => has(new Plain("p"))); tell(() => has(new Lazy)); tell(() => has({})); tell(() => has(5)); tell(() => remove(new Plain("p"))); tell(() => remove(Object.freeze({ kind: "frozen" }))); tell(() => underUndefined({ undefined: "u" })); tell(() => underIndex(["zero", "one"])); tell(() => underIndex({ 1: "named one" })); tell(() => handlerOf(handlers, "open")); tell(() => handlerOf(handlers, "close")); tell(() => handlerOf(handlers, "error")); tell(() => handlerOf(null, "open")); tell(() => pick("a")); tell(() => pick("c")); tell(() => pick("__proto__") === "[object Object]:before"); tell(() => pick(converts)); tell(() => read(new Plain("again"))); tell(() => handlerOf(handlers, "open")); tell(() => pick("b")); report(log); report("end"); }; const got = []; globalThis.report = value => { got.push(show(value)); if (value !== "end") return; const expected = []; twin(value => { expected.push(show(value)); if (value !== "end") return; let same = 0; for (let n = 0; n < expected.length; n++) { if (got[n] === expected[n]) same++; else print("answer " + n + ": " + String(got[n]).slice(0, 90) + " and not " + expected[n].slice(0, 90)); } print(same + " of " + expected.length + " of " + got.length); }); }; })();
