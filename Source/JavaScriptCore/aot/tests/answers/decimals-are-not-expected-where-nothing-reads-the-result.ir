# A call whose result nothing reads means another method of that name.
# sink((set, value) => { set.add(value); });
# JSC-OPTIONS: --useDecimal=1
# STATISTIC: DecimalRuns = 0
# RUN: run-in-shell --useDecimal=1 globalThis.sink = f => { const D = text => new Decimal(text), show = f => { try { print(String(f())); } catch (error) { print(error.name); } }; const set = new Set(); f(set, set); print(set.size); show(() => f(D("1"), D("2"))); show(() => f(D("1"), 2)); };
# CHECK: 1
# CHECK-NEXT: undefined
# CHECK-NEXT: TypeError
# CHECK-NEXT: exited with 0

module m0 path="main.js" displayPath="main.js" body=f0 namespaceLayout=L(m0)
entry module=m0
function f0 module=m0 kind=Module thisType={type=anything} results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0():
    v0 = Builtin builtin=GlobalThis
    v1 = PropGet v0 key="sink" [isFreeName]
    v2 = NewClosure function=f1
    v3 = Call v1, -, v2 calleeName="sink"
    v4 = Undefined
    Return v4
}
function f1 module=m0 kind=Arrow length=2 thisType={type=anything} parameters=[{type=anything flags=[IsExpected]}, {type=anything}] results=[{type=anything}] capabilities=[MayChangeSignature, MayBeCloned, MayBeInlined, HasOrdinaryFrame, IsNeverCalledByHost] {
  b0(v0: anything, v1: anything):
    v2 = PropGet v0 key="add"
    v3 = Call v2, v0, v1 calleeKey="add" calleeName="set.add"
    v4 = Undefined
    Return v4
}
