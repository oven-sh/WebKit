# CHECK-NEXT: 0 5 true a1n0.5 open | true a1n0.5 open | true a1n0.5 open
# CHECK-NEXT: 0 6 undefined a1b1n1.5 open | undefined a1b1n1.5 open | undefined a1b1n1.5 open
# CHECK-NEXT: 0 7 undefined a1b1n1.5 open | undefined a1b1n1.5 open | undefined a1b1n1.5 open
