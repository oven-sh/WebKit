# function make() { return { a: 1, b: 1, n: 0.5 }; }
# function store(box) { box.a = 2; }   function add(box) { box.c = 3; }   function remove(box) { return delete box.b; }   function storeNumber(box) { box.n = 1.5; }   each once as strict code writes it and once as sloppy code does
# The caller closes a new box at one of four levels (0 not at all, 1 preventExtensions, 2 seal, 3 freeze), in three ways: itself, through a Proxy without traps, through a Proxy of such a Proxy. Then one of the eight functions gets it.
# A line is a level and a function, and holds the three ways. A Proxy without traps hands each step on to its target, so the three agree: what a closed box refuses throws in strict code and is dropped in sloppy code.
# The levels come in one process, up and then down again, so whatever a function remembers of the box before meets a box of the same shape at another level.
# RUN: run-in-shell globalThis.register = (make, ...operations) => { const levels = [box => box, Object.preventExtensions, Object.seal, Object.freeze]; const order = [0, 1, 2, 3, 2, 1, 0]; const ways = [box => box, box => new Proxy(box, {}), box => new Proxy(new Proxy(box, {}), {})]; const first = []; let unlike = 0; for (let turn = 0; turn < order.length; turn++) { const level = order[turn]; for (let index = 0; index < operations.length; index++) { let line = level + " " + index; for (let way = 0; way < ways.length; way++) { const box = make(); levels[level](ways[way](box)); let said; try { said = String(operations[index](box)); } catch (error) { said = error.name; } const keys = Object.keys(box); let held = ""; for (let key = 0; key < keys.length; key++) held += keys[key] + box[keys[key]]; line += (way ? " | " : " ") + said + " " + held + " " + (Object.isFrozen(box) ? "frozen" : Object.isSealed(box) ? "sealed" : Object.isExtensible(box) ? "open" : "closed"); } const place = level * operations.length + index; if (turn < levels.length) { first[place] = line; print(line); } else if (first[place] !== line) { unlike++; print("UNLIKE " + line); } } } print(unlike + " unlike the first time"); };
# CHECK: 0 0 undefined a2b1n0.5 open | undefined a2b1n0.5 open | undefined a2b1n0.5 open
# CHECK-NEXT: 0 1 undefined a1b1n0.5c3 open | undefined a1b1n0.5c3 open | undefined a1b1n0.5c3 open
