# function sum(list) { let s = 0; for (let i = 0; i < list.length; i++) s += list[i]; return s; }
# function sumDown(list) { let s = 0; for (let i = list.length - 1; i >= 0; i--) s += list[i]; return s; }
# function sumOfPairs(list) { let s = 0; for (let i = 0; i + 1 < list.length; i += 2) s += list[i] * list[i + 1]; return s; }
# function sumOfTwo(a, b) { let s = 0; for (let i = 0; i < a.length; i++) s += a[i] + b[i]; return s; }
# function countPresent(list) { let n = 0; for (let i = 0; i < list.length; i++) if (i in list) n++; return n; }
# function countDefined(list) { let n = 0; for (let i = 0; i < list.length; i++) if (list[i] !== undefined) n++; return n; }
# function double(list) { for (let i = 0; i < list.length; i++) list[i] = list[i] * 2; return list; }
# function doubled(list) { const out = []; for (let i = 0; i < list.length; i++) out.push(list[i] * 2); return out; }
# function cutWhereNegative(list) { let s = 0; for (let i = 0; i < list.length; i++) { if (list[i] < 0) list.length = i; else s += list[i]; } return s; }
# function last(list) { return list[list.length - 1]; }
# register(sum, sumDown, sumOfPairs, sumOfTwo, countPresent, countDefined, double, doubled, cutWhereNegative, last)
# The parameters are expected to be lists of numbers, so tests for that are placed in front of the loops and of the reads, and later passes copy, move and drop what stands behind them.
# The shell hands each function 35 operands, most of them something else, and runs the same text itself: each failing arm is entered, and what comes back and what is left of the operand are the same.
# FORM: AsRead
