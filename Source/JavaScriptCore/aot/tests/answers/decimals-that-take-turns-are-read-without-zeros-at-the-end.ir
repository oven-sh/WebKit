# An operation that needs the one way to write the value strips the words it has read.
# sink((list, at) => { let text = "", total = new Decimal(0); for (let i = 0; i < list.length; i++) { total = total.add(list[i]); if (i === at) text += total.toString() + total.toExponential() + total.equals(new Decimal(1)) + total.notEquals(new Decimal(1)) + total.mantissa().toString() + total.scale10(1).toString() + total.abs().toString() + total.negate().toString() + total.round(1, "ceil").toString() + (total.compare(new Decimal(1)) === 0) + new Decimal(1).equals(total); } return text; }, list => { let total = new Decimal(3); for (const x of list) total = total.subtract(x); return total; }, list => { let total = new Decimal(3); for (const x of list) total = x.subtract(total); return total; }, list => { let total = new Decimal(0); for (const x of list) total = x.add(total); return total; }, list => { let total = new Decimal(0); for (const x of list) total = total.add(x); return total.toExponential(); });
