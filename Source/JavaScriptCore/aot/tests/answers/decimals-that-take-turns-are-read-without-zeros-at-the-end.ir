# An operation that needs the one way to write the value strips the words it has read.
# sink((list, at) => { let text = "", total = 0m; for (let i = 0; i < list.length; i++) { total = total.add(list[i]); if (i === at) text += total.toString() + total.toExponential() + total.equals(1m) + total.notEquals(1m) + total.mantissa().toString() + total.scale10(1).toString() + total.abs().toString() + total.negate().toString() + total.round(1, "ceil").toString() + (total.compare(1m) === 0) + 1m.equals(total); } return text; }, list => { let total = 3m; for (const x of list) total = total.subtract(x); return total; }, list => { let total = 3m; for (const x of list) total = x.subtract(total); return total; }, list => { let total = 0m; for (const x of list) total = x.add(total); return total; }, list => { let total = 0m; for (const x of list) total = total.add(x); return total.toExponential(); });
