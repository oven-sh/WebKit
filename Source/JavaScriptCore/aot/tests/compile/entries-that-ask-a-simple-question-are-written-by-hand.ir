# class Square { side = 2; area() { return this.side * this.side; } grown(by) { return this.side + by; } }
# class Wide { across = 2; down = 3; area() { return this.across * this.down; } grown(by) { return this.across + by; } }
# class Tall { across = 1; down = 5; up = 2; area() { return this.across * (this.down + this.up); } grown(by) { return this.up + by; } }
# class Round { reach = 2; area() { return this.reach * this.reach * 3; } grown(by) { return this.reach + by; } }
# const shapes = [new Square(), new Wide(), new Tall(), new Round()];
# let sum = 0;  for (let i = 0; i < shapes.length; i++) sum += shapes[i].area() + shapes[i].grown(i);  print(sum);
# Four classes answer to each name, so the eight methods are entered by value, and each entry asks what its body believes.
# `area` believes that `this` has the one shape of its class: a simple question, and the entry is written by hand, without a walk.
# `grown` believes also that `by` is a whole number, which is asked of an int32 and of a double: no simple question, and the entry is walked.
# Every `new` is copied and nothing enters the four constructors by value: their entries are closed, by hand too, and their bodies are not compiled.
# RUN: compile GenericEntryThunksEmitted UnitsCompiled mechanisms=all-UnboxedNumbers
# CHECK: statistic GenericEntryThunksEmitted 8
# CHECK-NEXT: statistic UnitsCompiled 21
# Where numbers cross calls raw the four bodies of `area` hand back a raw number, for the call in the loop. Whoever comes by value gets it boxed: that entry calls, boxes and returns: it is walked.
# RUN(RAW): compile GenericEntryThunksEmitted UnitsCompiled mechanisms=all
# RAW: statistic GenericEntryThunksEmitted 4
# RAW-NEXT: statistic UnitsCompiled 21
# Where proofs are checked at run time every entry is walked.
# RUN(CHECKED): compile GenericEntryThunksEmitted UnitsCompiled mechanisms=all testing=CheckProofsAtRunTime
# CHECKED: statistic GenericEntryThunksEmitted 0
# CHECKED-NEXT: statistic UnitsCompiled 21
# RUN(SIMPLE): walk f2:GenericCallEntry mechanisms=all
# SIMPLE: = TypeTest {{*}}testedType=L0
# SIMPLE-NOT: = TypeTest
# RUN(OTHER): walk f3:GenericCallEntry mechanisms=all
# OTHER: = TypeTest {{*}}testedType=L0
# OTHER: = TypeTest {{*}}testedType=int|whole
# RUN(ANSWER): run-in-shell mechanisms=all
# ANSWER: 43
# ANSWER-NEXT: exited with 0

