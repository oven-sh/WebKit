# The check of effects calls in each iteration. Callees on ARM64 save half of some vectors: the sums of a wide loop do not stay in vectors across these calls.
# function f(t) { let s = 0; for (let j = 0; j < t.length; j++) s += t[j]; return s; }
# console.log(f([1, 2, 3, 4]), f([1, 2, 3, 4, 5, 6, 7, 8, 9]));
