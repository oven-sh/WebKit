@@ -1051,7 +1051,13 @@ bool Collector::helpersJoinEveryCycle() const
 
 bool Collector::staysPausedWhileSmall() const
 {
-    return isSmallSoFar() && Options::minimumGCPauseMS() > 0;
+    if (!isSmallSoFar() || Options::minimumGCPauseMS() <= 0)
+        return false;
+    // The bytes that are visited say how long the marking takes only on a machine of usual speed. Under an emulator
+    // or a sanitizer, or when this thread does not get a CPU, a few hundred KB can take a second, and the mutator
+    // waits for all of it. Past this limit the scheduler decides, as it does for a cycle that is not small, and the
+    // resume wakes a helper for the marking that is left.
+    return MonotonicTime::now() - m_stopTime < Seconds::fromMilliseconds(Options::maximumSmallGCPauseMS());
 }
 
 void Collector::didPayForMarkerWakeup()
