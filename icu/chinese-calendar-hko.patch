+// on the wrong side of local midnight in the Chinese calendar's zone, as {computed day, actual day}
+// in days since 1970-01-01 (UTC+8). The actual days follow the Hong Kong Observatory and Purple
+// Mountain Observatory tables (and Y.T. Liu's DE-ephemeris computation). Only applied for the
+// Chinese calendar's astronomical zone: DangiCalendar shares this code with a different zone, and
+// the Korean tables (KASI) agree with the uncorrected computation on these dates.
+struct NewMoonCorrection {
+    int32_t computed;
+    int32_t actual;
+};
+const NewMoonCorrection CHINESE_NEW_MOON_CORRECTIONS[] = {
+    { -5810, -5811 }, // 1954-02-04 -> 1954-02-03, month 1 of 4651 (1954)
+    { -5426, -5427 }, // 1955-02-23 -> 1955-02-22, month 2 of 4652 (1955)
+    { 10609, 10608 }, // 1999-01-18 -> 1999-01-17, month 12 of 4695 (1998)
+    { 15570, 15569 }, // 2012-08-18 -> 2012-08-17, month 7 of 4709 (2012)
+    { 17842, 17843 }, // 2018-11-07 -> 2018-11-08, month 10 of 4715 (2018)
+    { 20856, 20855 }, // 2027-02-07 -> 2027-02-06, month 1 of 4724 (2027)
+    { 21947, 21948 }, // 2030-02-02 -> 2030-02-03, month 1 of 4727 (2030)
+    { 36596, 36595 }, // 2070-03-13 -> 2070-03-12, month 2 of 4767 (2070)
+    { 48023, 48024 }, // 2101-06-26 -> 2101-06-27, month 6 of 4798 (2101)
+};
