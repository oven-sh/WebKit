 }
 
+/*-----------------------------------------------------------------------------*
+ *                                                                             *
+ *  Compact offset TOC ("CmnD" formatVersion 2).                               *
+ *                                                                             *
+ *  Bun-specific packaging (icu/compress-data.ts in oven-sh/WebKit). Item      *
+ *  bodies and their DataHeaders are identical to formatVersion 1; only the    *
+ *  table of contents differs. Full item names "pkg/tree/base" are factored    *
+ *  into a directory-prefix table and one global pool of unique basenames      *
+ *  (16-way front-coded). Entries are sorted by (tree, basename) and store a   *
+ *  u16 id into that pool; a trailing sentinel data offset makes every item's  *
+ *  length explicit, including the last one.                                   *
+ *                                                                             *
+ *  All offsets are relative to the start of the TOC, as in formatVersion 1.   *
+ *                                                                             *
+ *-----------------------------------------------------------------------------*/
+
+typedef struct {
+    uint32_t dirNameOffset;   /* NUL-terminated "pkg/" or "pkg/tree/" */
+    uint32_t firstEntry;
+    uint32_t entryCount;
+} UDataOffsetTOC2Tree;
+
+typedef struct {
+    uint32_t count;           /* number of items */
+    uint32_t treeCount;
+    uint32_t nameCount;       /* unique basenames in the pool */
+    uint32_t bucketCount;     /* = (nameCount + 15) / 16 */
+    uint32_t maxNameLength;   /* longest basename, excluding the NUL */
+    uint32_t dataOffsetsOff;  /* -> uint32_t[count + 1]; [count] is a sentinel */
+    uint32_t nameIdsOff;      /* -> uint16_t[count], ascending within a tree */
+    uint32_t treesOff;        /* -> UDataOffsetTOC2Tree[treeCount] */
+    uint32_t bucketDirOff;    /* -> uint32_t[bucketCount] block start offsets */
+    uint32_t nameBlockSize;   /* names per front-coded block (the writer uses 16) */
+    uint32_t reserved[2];
+} UDataOffsetTOC2;
+
+/* Fixed decode buffer; the writer asserts maxNameLength fits. */
+enum { CMN2_NAME_BUFFER_SIZE = 64 };
+
+/**
+ * Copy the NUL-terminated string at `src` into buf starting at `pos`.
+ * Returns false (without writing past the buffer) if it does not fit --
+ * a corrupt package must fail the lookup, not overrun the stack.
+ */
+static UBool
+cmn2CopyName(char *buf, int32_t pos, const char *src) {
+    int32_t i=pos;
+    for(;;) {
+        if(i>=CMN2_NAME_BUFFER_SIZE) {
+            return false;
+        }
+        if((buf[i]=*src++)==0) {
+            return true;
+        }
+        ++i;
+    }
+}
+
+/**
+ * Index of the last bucket whose (verbatim, NUL-terminated) head string
+ * compares <= s, or -1 if s sorts before every head.
+ */
+static int32_t
+cmn2FloorBucket(const char *s, const char *base, const uint32_t *bucketDir, int32_t bucketCount) {
+    int32_t start=0;
+    int32_t limit=bucketCount;
+    while(start<limit) {
+        int32_t i=(start+limit)/2;
+        if(uprv_strcmp(base+bucketDir[i], s)<=0) {
+            start=i+1;
+        } else {
+            limit=i;
+        }
+    }
+    return start-1;
+}
+
+/**
+ * Look up a basename in the front-coded pool. Returns its id, or -1.
+ * Block layout: head\0 then up to 15 x { uint8 lcp; suffix\0 }.
+ */
+static int32_t
+cmn2FindName(const char *s, const char *base, const UDataOffsetTOC2 *toc) {
+    char buf[CMN2_NAME_BUFFER_SIZE];
+    const uint32_t *bucketDir=(const uint32_t *)(base+toc->bucketDirOff);
+    const uint8_t *p;
+    int32_t b, k, inBlock;
+    int32_t blockSize=(int32_t)toc->nameBlockSize;
+    if(toc->maxNameLength>=CMN2_NAME_BUFFER_SIZE || blockSize<=0) {
+        return -1;  /* not a package this reader can handle */
+    }
+    b=cmn2FloorBucket(s, base, bucketDir, (int32_t)toc->bucketCount);
+    if(b<0) {
+        return -1;
+    }
+    inBlock=(int32_t)toc->nameCount-b*blockSize;
+    if(inBlock>blockSize) {
+        inBlock=blockSize;
+    }
+    p=(const uint8_t *)base+bucketDir[b];
+    /* the head is stored verbatim */
+    if(!cmn2CopyName(buf, 0, (const char *)p)) {
+        return -1;
+    }
+    p+=uprv_strlen(buf)+1;
+    if(0==uprv_strcmp(buf, s)) {
+        return b*blockSize;
+    }
+    for(k=1; k<inBlock; ++k) {
+        int32_t cmp;
+        uint8_t lcp=*p++;
+        if(lcp>=CMN2_NAME_BUFFER_SIZE || !cmn2CopyName(buf, lcp, (const char *)p)) {
+            return -1;
+        }
+        p+=uprv_strlen(buf+lcp)+1;
+        cmp=uprv_strcmp(buf, s);
+        if(cmp==0) {
+            return b*blockSize+k;
+        }
+        if(cmp>0) {
+            break;   /* names in a block are sorted */
+        }
+    }
+    return -1;
+}
