+static uint32_t U_CALLCONV
+offsetTOC2EntryCount(const UDataMemory *pData) {
+    const UDataOffsetTOC2 *toc = (const UDataOffsetTOC2 *)pData->toc;
+    return toc!=nullptr ? toc->count : 0;
+}
+
+static const DataHeader * U_CALLCONV
+offsetTOC2LookupFn(const UDataMemory *pData,
+                   const char *tocEntryName,
+                   int32_t *pLength,
+                   UErrorCode *pErrorCode) {
+    (void)pErrorCode;
+    const UDataOffsetTOC2 *toc = (const UDataOffsetTOC2 *)pData->toc;
+    const char *base;
+    const char *slash;
+    const UDataOffsetTOC2Tree *trees, *tree;
+    const uint32_t *dataOffsets;
+    const uint16_t *nameIds;
+    int32_t dirLength, nameId, t, start, limit;
+    if(toc==nullptr) {
+        return pData->pHeader;
+    }
+    base=(const char *)toc;
+
+    /* split "pkg/tree/base.ext" into its directory prefix and basename */
+    slash=uprv_strrchr(tocEntryName, '/');
+    dirLength= slash==nullptr ? 0 : (int32_t)(slash+1-tocEntryName);
+
+    trees=(const UDataOffsetTOC2Tree *)(base+toc->treesOff);
+    tree=nullptr;
+    for(t=0; t<(int32_t)toc->treeCount; ++t) {
+        const char *dirName=base+trees[t].dirNameOffset;
+        if(0==uprv_strncmp(dirName, tocEntryName, dirLength) && dirName[dirLength]==0) {
+            tree=trees+t;
+            break;
+        }
+    }
+    if(tree==nullptr) {
+#ifdef UDATA_DEBUG
+        fprintf(stderr, "%s: Not found (no such tree).\n", tocEntryName);
+#endif
+        return nullptr;
+    }
+
+    nameId=cmn2FindName(tocEntryName+dirLength, base, toc);
+    if(nameId>=0) {
+        /* entries of a tree are sorted by nameId: integer binary search */
+        nameIds=(const uint16_t *)(base+toc->nameIdsOff);
+        start=(int32_t)tree->firstEntry;
+        limit=start+(int32_t)tree->entryCount;
+        while(start<limit) {
+            int32_t i=(start+limit)/2;
+            if((int32_t)nameIds[i]<nameId) {
+                start=i+1;
+            } else if((int32_t)nameIds[i]>nameId) {
+                limit=i;
+            } else {
+                dataOffsets=(const uint32_t *)(base+toc->dataOffsetsOff);
+#ifdef UDATA_DEBUG
+                fprintf(stderr, "%s: Found.\n", tocEntryName);
+#endif
+                *pLength=(int32_t)(dataOffsets[i+1]-dataOffsets[i]);
+                return (const DataHeader *)(base+dataOffsets[i]);
+            }
+        }
+    }
+#ifdef UDATA_DEBUG
+    fprintf(stderr, "%s: Not found.\n", tocEntryName);
+#endif
+    return nullptr;
+}
