+/* ---- BUN LOCAL TRACE (not shipped): BUN_ICU_TRACE_POOL=<file> ---- */
+#include <stdio.h>
+#include <stdlib.h>
+static void bunTracePoolString(const void *poolPtr, int32_t offset, const char16_t *p) {
+    static FILE *gF = (FILE *)(intptr_t)-1;
+    if (gF == (FILE *)(intptr_t)-1) {
+        const char *path = getenv("BUN_ICU_TRACE_POOL");
+        gF = path ? fopen(path, "a") : nullptr;
+    }
+    if (!gF || !p) return;
+    int32_t first = *p, len, nlen = 0;
+    if (first >= 0xdc00 && first <= 0xdfff) {
+        if (first < 0xdfef) { len = first & 0x3ff; nlen = 1; }
+        else if (first < 0xdfff) { len = ((first - 0xdfef) << 16) | p[1]; nlen = 2; }
+        else { len = ((int32_t)p[1] << 16) | p[2]; nlen = 3; }
+    } else { len = u_strlen(p); }
+    fprintf(gF, "%p\t%d\t", poolPtr, (int)offset);
+    for (int32_t i = 0; i < len; i++) {
+        uint32_t c = p[nlen + i];
+        if (c < 0x80) fputc((int)c, gF);
+        else if (c < 0x800) { fputc(0xc0 | (c >> 6), gF); fputc(0x80 | (c & 0x3f), gF); }
+        else { fputc(0xe0 | (c >> 12), gF); fputc(0x80 | ((c >> 6) & 0x3f), gF); fputc(0x80 | (c & 0x3f), gF); }
+    }
+    fputc('\n', gF);
+    fflush(gF);
+}
+static void bunTraceFCBlock(int32_t b) {
+    static FILE *gF2 = (FILE *)(intptr_t)-1;
+    if (gF2 == (FILE *)(intptr_t)-1) {
+        const char *path = getenv("BUN_ICU_TRACE_FC");
+        gF2 = path ? fopen(path, "a") : nullptr;
+    }
+    if (!gF2) return;
+    fprintf(gF2, "block %d\n", (int)b);
+    fflush(gF2);
+}
+/* ---- end trace ---- */
