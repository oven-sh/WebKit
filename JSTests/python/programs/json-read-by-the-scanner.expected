===== hooks
object_hook -> [('a', 2), ('b', [1.5, [('c', nan), ('d', -inf)]]), ('e', [])]
object_pairs_hook -> [('a', 1), ('b', [1.5, [('c', nan), ('d', -inf)]]), ('a', 2), ('e', [])]
both -> ('pairs', 4)
OrderedDict -> OrderedDict({'a': 2, 'b': [1.5, OrderedDict({'c': nan, 'd': -inf})], 'e': OrderedDict()})
parse_float -> [Decimal('1.10'), Decimal('1E+5'), 1, Decimal('-0.0')]
parse_float gets -> [('str', '1.10'), ('str', '1E+5'), ('str', '-0.0e0')]
parse_int gets -> [('str', '1'), ('str', '-0'), ('str', '123456789012345678901234567890'), 1.5]
parse_int is float -> [1.0, 2.5]
parse_float is int -> "ValueError: invalid literal for int() with base 10: '1.5'"
parse_constant gets -> [('str', 'NaN'), ('str', 'Infinity'), ('str', '-Infinity'), None, True]
parse_constant raises -> 'ZeroDivisionError: division by zero'
a hook that raises -> 'ZeroDivisionError: division by zero'
a hook that is not callable -> "TypeError: 'int' object is not callable"
a subclass of int for parse_int -> ['I']
strict -> 'JSONDecodeError: Invalid control character at: line 1 column 3 (char 2)'
not strict -> ['a\nb', {'c\td': '\x00\x00'}]
the same key is the one str -> [True, True]
values are not -> False
