the module => ('array', '', 'BuiltinImporter', 'This module defines an object type which can efficiently represent\nan array of basic values: characters, integers, floating-point\nnumbers.  Arrays are sequence types and behave very much like lists,\nexcept that the type of objects stored in them is constrained.\n', ['ArrayType', '_array_reconstructor', 'array', 'typecodes'], 'bBuwhHiIlLqQfd', True)
_array_reconstructor => [('builtin_function_or_method', '($module, arraytype, typecode, mformat_code, items,\n                     /)', 'Internal. Used for pickling support.', 'array')]
array => ('array', 'array', ['array', 'object'], ['__add__', '__buffer__', '__class_getitem__', '__contains__', '__copy__', '__deepcopy__', '__delitem__', '__doc__', '__eq__', '__ge__', '__getattribute__', '__getitem__', '__gt__', '__hash__', '__iadd__', '__imul__', '__iter__', '__le__', '__len__', '__lt__', '__module__', '__mul__', '__ne__', '__new__', '__reduce_ex__', '__release_buffer__', '__repr__', '__rmul__', '__setitem__', '__sizeof__', 'append', 'buffer_info', 'byteswap', 'clear', 'count', 'extend', 'frombytes', 'fromfile', 'fromlist', 'fromunicode', 'index', 'insert', 'itemsize', 'pop', 'remove', 'reverse', 'tobytes', 'tofile', 'tolist', 'tounicode', 'typecode'], "array(typecode [, initializer]) -> array\n\nReturn a new array whose items are restricted by typecode, and\ninitialized from the optional initializer value, which must be a list,\nstring or iterable over elements of the appropriate type.\n\nArrays represent basic values and behave very much like lists, except\nthe type of objects stored in them is constrained. The type is specified\nat object creation time by using a type code, which is a single character.\nThe following type codes are defined:\n\n    Type code   C Type             Minimum size in bytes\n    'b'         signed integer     1\n    'B'         unsigned integer   1\n    'u'         Unicode character  2 (see note)\n    'h'         signed integer     2\n    'H'         unsigned integer   2\n    'i'         signed integer     2\n    'I'         unsigned integer   2\n    'l'         signed integer     4\n    'L'         unsigned integer   4\n    'q'         signed integer     8 (see note)\n    'Q'         unsigned integer   8 (see note)\n    'f'         floating-point     4\n    'd'         floating-point     8\n\nNOTE: The 'u' typecode corresponds to Python's unicode character. On\nnarrow builds this is 2-bytes on wide builds this is 4-bytes.\n\nNOTE: The 'q' and 'Q' type codes are only available if the platform\nC compiler used to build Python supports 'long long', or, on Windows,\n'__int64'.\n\nMethods:\n\nappend() -- append a new item to the end of the array\nbuffer_info() -- return information giving the current memory info\nbyteswap() -- byteswap all the items of the array\ncount() -- return number of occurrences of an object\nextend() -- extend array by appending multiple elements from an iterable\nfromfile() -- read items from a file object\nfromlist() -- append items from the list\nfrombytes() -- append items from the string\nindex() -- return index of first occurrence of an object\ninsert() -- insert a new item into the array at a provided position\npop() -- remove and return item (default last)\nremove() -- remove first occurrence of an object\nreverse() -- reverse the order of the items in the array\ntofile() -- write all items to a file object\ntolist() -- return the array converted to an ordinary list\ntobytes() -- return the array converted to a string\n\nAttributes:\n\ntypecode -- the typecode character used to create the array\nitemsize -- the length in bytes of one array item\n", None, 64, 0, True, 0, 22304, "<class 'array.array'>", "TypeError: cannot set 'x' attribute of immutable type 'array.array'")
array.__add__ => ('wrapper_descriptor', '($self, value, /)', 'Return self+value.')
array.__buffer__ => ('wrapper_descriptor', '($self, flags, /)', 'Return a buffer object that exposes the underlying memory of the object.')
array.__class_getitem__ => ('classmethod_descriptor', '($type, object, /)', 'Arrays are generic over the type of their elements')
array.__contains__ => ('wrapper_descriptor', '($self, key, /)', 'Return bool(key in self).')
array.__copy__ => ('method_descriptor', '($self, /)', 'Return a copy of the array.')
array.__deepcopy__ => ('method_descriptor', '($self, unused, /)', 'Return a copy of the array.')
array.__delitem__ => ('wrapper_descriptor', '($self, key, /)', 'Delete self[key].')
array.__doc__ => ('str', None, None)
array.__eq__ => ('wrapper_descriptor', '($self, value, /)', 'Return self==value.')
array.__ge__ => ('wrapper_descriptor', '($self, value, /)', 'Return self>=value.')
array.__getattribute__ => ('wrapper_descriptor', '($self, name, /)', 'Return getattr(self, name).')
array.__getitem__ => ('wrapper_descriptor', '($self, key, /)', 'Return self[key].')
array.__gt__ => ('wrapper_descriptor', '($self, value, /)', 'Return self>value.')
array.__hash__ => ('NoneType', None, None)
array.__iadd__ => ('wrapper_descriptor', '($self, value, /)', 'Implement self+=value.')
array.__imul__ => ('wrapper_descriptor', '($self, value, /)', 'Implement self*=value.')
array.__iter__ => ('wrapper_descriptor', '($self, /)', 'Implement iter(self).')
array.__le__ => ('wrapper_descriptor', '($self, value, /)', 'Return self<=value.')
array.__len__ => ('wrapper_descriptor', '($self, /)', 'Return len(self).')
array.__lt__ => ('wrapper_descriptor', '($self, value, /)', 'Return self<value.')
array.__module__ => ('str', None, None)
array.__mul__ => ('wrapper_descriptor', '($self, value, /)', 'Return self*value.')
array.__ne__ => ('wrapper_descriptor', '($self, value, /)', 'Return self!=value.')
array.__new__ => ('builtin_function_or_method', '($type, *args, **kwargs)', 'Create and return a new object.  See help(type) for accurate signature.')
array.__reduce_ex__ => ('method_descriptor', '($self, value, /)', 'Return state information for pickling.')
array.__release_buffer__ => ('wrapper_descriptor', '($self, buffer, /)', 'Release the buffer object that exposes the underlying memory of the object.')
array.__repr__ => ('wrapper_descriptor', '($self, /)', 'Return repr(self).')
array.__rmul__ => ('wrapper_descriptor', '($self, value, /)', 'Return value*self.')
array.__setitem__ => ('wrapper_descriptor', '($self, key, value, /)', 'Set self[key] to value.')
array.__sizeof__ => ('method_descriptor', '($self, /)', 'Size of the array in memory, in bytes.')
array.append => ('method_descriptor', '($self, v, /)', 'Append new value v to the end of the array.')
array.buffer_info => ('method_descriptor', '($self, /)', "Return a tuple (address, length) giving the current memory address and the length in items of the buffer used to hold array's contents.\n\nThe length should be multiplied by the itemsize attribute to\ncalculate the buffer length in bytes.")
array.byteswap => ('method_descriptor', '($self, /)', 'Byteswap all items of the array.\n\nIf the items in the array are not 1, 2, 4, or 8 bytes in size,\nRuntimeError is raised.')
array.clear => ('method_descriptor', '($self, /)', 'Remove all items from the array.')
array.count => ('method_descriptor', '($self, v, /)', 'Return number of occurrences of v in the array.')
array.extend => ('method_descriptor', '($self, bb, /)', 'Append items to the end of the array.')
array.frombytes => ('method_descriptor', '($self, buffer, /)', 'Appends items from the string, interpreting it as an array of machine values, as if it had been read from a file using the fromfile() method.')
array.fromfile => ('method_descriptor', '($self, f, n, /)', 'Read n objects from the file object f and append them to the end of the array.')
array.fromlist => ('method_descriptor', '($self, list, /)', 'Append items to array from list.')
array.fromunicode => ('method_descriptor', '($self, ustr, /)', 'Extends this array with data from the unicode string ustr.\n\nThe array must be a unicode type array; otherwise a ValueError is\nraised.  Use array.frombytes(ustr.encode(...)) to append Unicode\ndata to an array of some other type.')
array.index => ('method_descriptor', '($self, v, start=0, stop=sys.maxsize, /)', 'Return index of first occurrence of v in the array.\n\nRaise ValueError if the value is not present.')
array.insert => ('method_descriptor', '($self, i, v, /)', 'Insert a new item v into the array before position i.')
array.itemsize => ('getset_descriptor', None, 'the size, in bytes, of one array item')
array.pop => ('method_descriptor', '($self, i=-1, /)', 'Return the i-th element and delete it from the array.\n\ni defaults to -1.')
array.remove => ('method_descriptor', '($self, v, /)', 'Remove the first occurrence of v in the array.')
array.reverse => ('method_descriptor', '($self, /)', 'Reverse the order of the items in the array.')
array.tobytes => ('method_descriptor', '($self, /)', 'Convert the array to an array of machine values and return the bytes representation.')
array.tofile => ('method_descriptor', '($self, f, /)', 'Write all items (as machine values) to the file object f.')
array.tolist => ('method_descriptor', '($self, /)', 'Convert array to an ordinary list with the same items.')
array.tounicode => ('method_descriptor', '($self, /)', 'Extends this array with data from the unicode string ustr.\n\nConvert the array to a unicode string.  The array must be a unicode\ntype array; otherwise a ValueError is raised.  Use\narray.tobytes().decode() to obtain a unicode string from an array of\nsome other type.')
