field_size_limit => ('builtin_function_or_method', '($module, /, new_limit=<unrepresentable>)', 'Sets an upper limit on parsed fields.\n\nReturns old limit. If limit is not given, no new limit is set and\nthe old limit is returned', '_csv', 'field_size_limit', 'field_size_limit')
get_dialect => ('builtin_function_or_method', '($module, /, name)', 'Return the dialect instance associated with name.', '_csv', 'get_dialect', 'get_dialect')
list_dialects => ('builtin_function_or_method', '($module, /)', 'Return a list of all known dialect names.', '_csv', 'list_dialects', 'list_dialects')
reader => ('builtin_function_or_method', "($module, iterable, /, dialect='excel', **fmtparams)", 'Return a reader object that will process lines from the given iterable.\n\nThe "iterable" argument can be any object that returns a line\nof input for each iteration, such as a file object or a list.  The\noptional "dialect" argument defines a CSV dialect.  The function\nalso accepts optional keyword arguments which override settings\nprovided by the dialect.\n\nThe returned object is an iterator.  Each iteration returns a row\nof the CSV file (which can span multiple input lines).\n', '_csv', 'reader', 'reader')
register_dialect => ('builtin_function_or_method', "($module, name, /, dialect='excel', **fmtparams)", 'Create a mapping from a string name to a CVS dialect.\n\nThe optional "dialect" argument specifies the base dialect instance\nor the name of the registered dialect.  The function also accepts\noptional keyword arguments which override settings provided by the\ndialect.\n', '_csv', 'register_dialect', 'register_dialect')
unregister_dialect => ('builtin_function_or_method', '($module, /, name)', 'Delete the name/dialect mapping associated with a string name.', '_csv', 'unregister_dialect', 'unregister_dialect')
writer => ('builtin_function_or_method', "($module, fileobj, /, dialect='excel', **fmtparams)", 'Return a writer object that will write user data on the given file object.\n\nThe "fileobj" argument can be any object that supports the file API.\nThe optional "dialect" argument defines a CSV dialect.  The function\nalso accepts optional keyword arguments which override settings\nprovided by the dialect.\n', '_csv', 'writer', 'writer')
