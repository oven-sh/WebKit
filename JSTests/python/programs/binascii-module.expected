a2b_base64 => ('builtin_function_or_method', '($module, data, /, *, strict_mode=False)', 'Decode a line of base64 data.\n\n  strict_mode\n    When set to True, bytes that are not part of the base64 standard are not allowed.\n    The same applies to excess data after padding (= / ==).', 'binascii')
a2b_hex => ('builtin_function_or_method', '($module, hexstr, /)', 'Binary data of hexadecimal representation.\n\nhexstr must contain an even number of hex digits (upper or lower case).\nThis function is also available as "unhexlify()".', 'binascii')
a2b_qp => ('builtin_function_or_method', '($module, /, data, header=False)', 'Decode a string of qp-encoded data.', 'binascii')
a2b_uu => ('builtin_function_or_method', '($module, data, /)', 'Decode a line of uuencoded data.', 'binascii')
b2a_base64 => ('builtin_function_or_method', '($module, data, /, *, newline=True)', 'Base64-code line of data.', 'binascii')
b2a_hex => ('builtin_function_or_method', '($module, /, data, sep=<unrepresentable>, bytes_per_sep=1)', 'Hexadecimal representation of binary data.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from the\n    right, negative values count from the left.\n\nThe return value is a bytes object.  This function is also\navailable as "hexlify()".\n\nExample:\n>>> binascii.b2a_hex(b\'\\xb9\\x01\\xef\')\nb\'b901ef\'\n>>> binascii.hexlify(b\'\\xb9\\x01\\xef\', \':\')\nb\'b9:01:ef\'\n>>> binascii.b2a_hex(b\'\\xb9\\x01\\xef\', b\'_\', 2)\nb\'b9_01ef\'', 'binascii')
b2a_qp => ('builtin_function_or_method', '($module, /, data, quotetabs=False, istext=True, header=False)', 'Encode a string using quoted-printable encoding.\n\nOn encoding, when istext is set, newlines are not encoded, and white\nspace at end of lines is.  When istext is not set, \\r and \\n (CR/LF)\nare both encoded.  When quotetabs is set, space and tabs are encoded.', 'binascii')
b2a_uu => ('builtin_function_or_method', '($module, data, /, *, backtick=False)', 'Uuencode line of data.', 'binascii')
crc32 => ('builtin_function_or_method', '($module, data, crc=0, /)', 'Compute CRC-32 incrementally.', 'binascii')
crc_hqx => ('builtin_function_or_method', '($module, data, crc, /)', 'Compute CRC-CCITT incrementally.', 'binascii')
hexlify => ('builtin_function_or_method', '($module, /, data, sep=<unrepresentable>, bytes_per_sep=1)', 'Hexadecimal representation of binary data.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from the\n    right, negative values count from the left.\n\nThe return value is a bytes object.  This function is also\navailable as "b2a_hex()".', 'binascii')
unhexlify => ('builtin_function_or_method', '($module, hexstr, /)', 'Binary data of hexadecimal representation.\n\nhexstr must contain an even number of hex digits (upper or lower case).', 'binascii')
