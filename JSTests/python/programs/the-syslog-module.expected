---- what there is
[('LOG_EMERG', 0), ('LOG_ALERT', 1), ('LOG_CRIT', 2), ('LOG_ERR', 3), ('LOG_WARNING', 4), ('LOG_NOTICE', 5), ('LOG_INFO', 6), ('LOG_DEBUG', 7), ('LOG_PID', 1), ('LOG_CONS', 2), ('LOG_NDELAY', 8), ('LOG_ODELAY', 4), ('LOG_NOWAIT', 16), ('LOG_PERROR', 32), ('LOG_KERN', 0), ('LOG_USER', 8), ('LOG_MAIL', 16), ('LOG_DAEMON', 24), ('LOG_AUTH', 32), ('LOG_LPR', 48), ('LOG_LOCAL0', 128), ('LOG_LOCAL1', 136), ('LOG_LOCAL2', 144), ('LOG_LOCAL3', 152), ('LOG_LOCAL4', 160), ('LOG_LOCAL5', 168), ('LOG_LOCAL6', 176), ('LOG_LOCAL7', 184), ('LOG_SYSLOG', 40), ('LOG_CRON', 72), ('LOG_UUCP', 64), ('LOG_NEWS', 56), ('LOG_AUTHPRIV', 80), ('LOG_FTP', 88)]
['LOG_MASK', 'LOG_UPTO', 'closelog', 'openlog', 'setlogmask', 'syslog'] None built-in {'int'}
    openlog ($module, /, ident=<unrepresentable>, logoption=0,
        facility=LOG_USER) syslog 'Set logging options of subsequent syslog() calls.'
    closelog ($module, /) syslog 'Reset the syslog module values and call the system library closelog().'
    syslog None syslog 'syslog([priority=LOG_INFO,] message)\nSend the string message to the system logger.'
    setlogmask ($module, maskpri, /) syslog 'Set the priority mask to maskpri and return the previous mask value.'
    LOG_MASK ($module, pri, /) syslog 'Calculates the mask for the individual priority pri.'
    LOG_UPTO ($module, pri, /) syslog 'Calculates the mask for all priorities up to and including pri.'
---- masks
[1, 2, 128, 536870912, 1073741824, -2147483648, 1, 2, -2147483648, 1, 1073741824, 1, 1, 1, -2147483648, 2]
[1, 3, 255, 1073741823, 2147483647, 0, 1, 3, 0, 1, 0, 2147483647, 1, 1, 1, 0, 3]
LOG_MASK none => TypeError syslog.LOG_MASK() takes exactly one argument (0 given)
LOG_MASK two => TypeError syslog.LOG_MASK() takes exactly one argument (2 given)
LOG_MASK by name => TypeError syslog.LOG_MASK() takes no keyword arguments
LOG_MASK a str => TypeError 'str' object cannot be interpreted as an integer
LOG_MASK a float => TypeError 'float' object cannot be interpreted as an integer
LOG_MASK None => TypeError 'NoneType' object cannot be interpreted as an integer
LOG_MASK too great => OverflowError Python int too large to convert to C long
LOG_MASK too little => OverflowError Python int too large to convert to C long
LOG_MASK what says what it is => int
LOG_UPTO none => TypeError syslog.LOG_UPTO() takes exactly one argument (0 given)
LOG_UPTO two => TypeError syslog.LOG_UPTO() takes exactly one argument (2 given)
LOG_UPTO by name => TypeError syslog.LOG_UPTO() takes no keyword arguments
LOG_UPTO a str => TypeError 'str' object cannot be interpreted as an integer
LOG_UPTO a float => TypeError 'float' object cannot be interpreted as an integer
LOG_UPTO None => TypeError 'NoneType' object cannot be interpreted as an integer
LOG_UPTO too great => OverflowError Python int too large to convert to C long
LOG_UPTO too little => OverflowError Python int too large to convert to C long
LOG_UPTO what says what it is => int
