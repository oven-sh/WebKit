255 31 31 8 True
---- what the hooks are told
openlog() => (None, [('syslog.openlog', ('the-syslog-module.py', 0, 8))])
an ident => (None, [('syslog.openlog', ('ident', 0, 8))])
all three => (None, [('syslog.openlog', ('ident', 1, 16))])
by name => (None, [('syslog.openlog', ('é€😀', 8, 152))])
an empty one => (None, [('syslog.openlog', ('', 0, 8))])
a str of another class => (None, [('syslog.openlog', ('s', 0, 8))])
great numbers => (None, [('syslog.openlog', ('i', 1099511627776, -1099511627776))])
syslog(message) => (None, [('syslog.syslog', (6, 'a message'))])
with a priority => (None, [('syslog.syslog', (7, 'a message'))])
and a facility => (None, [('syslog.syslog', (135, 'é€😀 100% %s %n'))])
nothing to say => (None, [('syslog.syslog', (6, ''))])
closelog() => (None, [('syslog.closelog', ())])
again => (None, [('syslog.closelog', ())])
syslog() when it is not open => (None, [('syslog.syslog', (6, 'opens it')), ('syslog.openlog', ('the-syslog-module.py', 0, 8))])
and again => (None, [('syslog.syslog', (6, 'it is open'))])
setlogmask() => (255, [('syslog.setlogmask', (0,)), ('syslog.setlogmask', (255,))])
with sys.argv ['/a/b/c.py'] => [('syslog.openlog', ('c.py', 0, 8))]
with sys.argv ['c.py', 'x'] => [('syslog.openlog', ('c.py', 0, 8))]
with sys.argv ['/a/b/'] => [('syslog.openlog', ('', 0, 8))]
with sys.argv ['/'] => [('syslog.openlog', ('', 0, 8))]
with sys.argv [''] => [('syslog.openlog', (None, 0, 8))]
with sys.argv [] => [('syslog.openlog', (None, 0, 8))]
with sys.argv [5] => [('syslog.openlog', (None, 0, 8))]
with sys.argv [b'x'] => [('syslog.openlog', (None, 0, 8))]
with sys.argv ('t.py',) => [('syslog.openlog', (None, 0, 8))]
with sys.argv None => [('syslog.openlog', (None, 0, 8))]
with sys.argv ['\xe9/\u20ac'] => [('syslog.openlog', ('€', 0, 8))]
with sys.argv ['/x/s.py'] => [('syslog.openlog', ('s.py', 0, 8))]
with none => (None, [('syslog.openlog', (None, 0, 8))])
---- what will not do
ident an int => (('TypeError', "openlog() argument 'ident' must be str, not int"), [])
bytes => (('TypeError', "openlog() argument 'ident' must be str, not bytes"), [])
None => (('TypeError', "openlog() argument 'ident' must be str, not None"), [])
half a character => (('UnicodeEncodeError', "'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"), [])
with a zero in it => (None, [('syslog.openlog', ('a\x00b', 0, 8))])
logoption a str => (('TypeError', "'str' object cannot be interpreted as an integer"), [])
too great => (('OverflowError', 'Python int too large to convert to C long'), [])
facility a float => (('TypeError', "'float' object cannot be interpreted as an integer"), [])
four => (('TypeError', 'openlog() takes at most 3 arguments (4 given)'), [])
something else => (('TypeError', "openlog() got an unexpected keyword argument 'other'"), [])
ident twice => (('TypeError', "argument for openlog() given by name ('ident') and position (1)"), [])
syslog() => (('TypeError', 'syslog.syslog requires 1 to 2 arguments'), [])
three => (('TypeError', 'syslog.syslog requires 1 to 2 arguments'), [])
by name => (('TypeError', 'syslog() takes no keyword arguments'), [])
both by name => (('TypeError', 'syslog() takes no keyword arguments'), [])
an int => (('TypeError', 'syslog() argument 1 must be str, not int'), [])
bytes => (('TypeError', 'syslog() argument 1 must be str, not bytes'), [])
None => (('TypeError', 'syslog() argument 1 must be str, not None'), [])
with a zero in it => (('ValueError', 'embedded null character'), [])
half a character => (('UnicodeEncodeError', "'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"), [])
the wrong way round => (('TypeError', "'str' object cannot be interpreted as an integer"), [])
priority a float => (('TypeError', "'float' object cannot be interpreted as an integer"), [])
priority None => (('TypeError', "'NoneType' object cannot be interpreted as an integer"), [])
priority too great => (('OverflowError', 'signed integer is greater than maximum'), [])
too little => (('OverflowError', 'signed integer is less than minimum'), [])
far too great => (('OverflowError', 'Python int too large to convert to C long'), [])
message an int => (('TypeError', 'syslog() argument 2 must be str, not int'), [])
closelog(1) => (('TypeError', 'syslog.closelog() takes no arguments (1 given)'), [])
a hook refuses openlog() => PermissionError syslog.openlog
a hook refuses syslog() => PermissionError syslog.syslog
a hook refuses closelog() => PermissionError syslog.closelog
a hook refuses setlogmask() => PermissionError syslog.setlogmask
