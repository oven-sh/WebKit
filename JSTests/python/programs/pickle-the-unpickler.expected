readinto gives 2**70 -> 'OverflowError: Python int too large to convert to C ssize_t'
no readinto, and read gives bytes -> b'abcde'
no readinto, and read gives too few -> 'UnpicklingError: pickle data was truncated'
no readinto, and read gives too many -> b'abcde'
no readinto, and read gives a bytearray -> "ValueError: read() returned non-bytes object (<class 'bytearray'>)"
no readinto, and read gives a str -> "ValueError: read() returned non-bytes object (<class 'str'>)"
no readinto, and read gives None -> "ValueError: read() returned non-bytes object (<class 'NoneType'>)"
===== strings of Python 2
STRING [] -> "UnicodeDecodeError: 'ascii' codec can't decode byte 0x in position 1: ordinal not in range(128)"
BINSTRING [] -> "UnicodeDecodeError: 'ascii' codec can't decode byte 0x in position 1: ordinal not in range(128)"
SHORT_BINSTRING [] -> "UnicodeDecodeError: 'ascii' codec can't decode byte 0x in position 1: ordinal not in range(128)"
ascii [] -> 'a'
STRING [('encoding', 'latin-1')] -> 'a\xe9'
BINSTRING [('encoding', 'latin-1')] -> 'a\xe9'
SHORT_BINSTRING [('encoding', 'latin-1')] -> 'a\xe9'
ascii [('encoding', 'latin-1')] -> 'a'
STRING [('encoding', 'bytes')] -> b'a\xe9'
BINSTRING [('encoding', 'bytes')] -> b'a\xe9'
SHORT_BINSTRING [('encoding', 'bytes')] -> b'a\xe9'
ascii [('encoding', 'bytes')] -> b'a'
STRING [('encoding', 'utf-8')] -> "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x in position 1: unexpected end of data"
BINSTRING [('encoding', 'utf-8')] -> "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x in position 1: unexpected end of data"
SHORT_BINSTRING [('encoding', 'utf-8')] -> "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x in position 1: unexpected end of data"
ascii [('encoding', 'utf-8')] -> 'a'
STRING [('encoding', 'ascii'), ('errors', 'replace')] -> 'a\ufffd'
BINSTRING [('encoding', 'ascii'), ('errors', 'replace')] -> 'a\ufffd'
SHORT_BINSTRING [('encoding', 'ascii'), ('errors', 'replace')] -> 'a\ufffd'
ascii [('encoding', 'ascii'), ('errors', 'replace')] -> 'a'
STRING [('encoding', 'ascii'), ('errors', 'ignore')] -> 'a'
BINSTRING [('encoding', 'ascii'), ('errors', 'ignore')] -> 'a'
SHORT_BINSTRING [('encoding', 'ascii'), ('errors', 'ignore')] -> 'a'
ascii [('encoding', 'ascii'), ('errors', 'ignore')] -> 'a'
STRING [('encoding', 'BYTES')] -> 'LookupError: unknown encoding: BYTES'
BINSTRING [('encoding', 'BYTES')] -> 'LookupError: unknown encoding: BYTES'
SHORT_BINSTRING [('encoding', 'BYTES')] -> 'LookupError: unknown encoding: BYTES'
ascii [('encoding', 'BYTES')] -> 'LookupError: unknown encoding: BYTES'
STRING [('encoding', 'nonesuch')] -> 'LookupError: unknown encoding: nonesuch'
BINSTRING [('encoding', 'nonesuch')] -> 'LookupError: unknown encoding: nonesuch'
SHORT_BINSTRING [('encoding', 'nonesuch')] -> 'LookupError: unknown encoding: nonesuch'
ascii [('encoding', 'nonesuch')] -> 'LookupError: unknown encoding: nonesuch'
STRING [('errors', 'nonesuch')] -> "LookupError: unknown error handler name 'nonesuch'"
BINSTRING [('errors', 'nonesuch')] -> "LookupError: unknown error handler name 'nonesuch'"
SHORT_BINSTRING [('errors', 'nonesuch')] -> "LookupError: unknown error handler name 'nonesuch'"
ascii [('errors', 'nonesuch')] -> 'a'
===== persistent_load
PERSID -> ('loaded', 'abc')
PERSID not ASCII -> 'UnpicklingError: persistent IDs in protocol 0 must be ASCII strings'
BINPERSID -> ('loaded', (1, 2))
set on the instance -> ('set', 1)
raises -> 'ZeroDivisionError: division by zero'
not callable -> "TypeError: 'int' object is not callable"
===== find_class
GLOBAL -> ('found', 'a', 'b', 'str')
STACK_GLOBAL -> ('found', 'a', 'b', 'str')
INST -> "TypeError: 'tuple' object is not callable"
GLOBAL utf-8 -> ('found', '\xe9', '\u20ac', 'str')
forbidden -> 'UnpicklingError: forbidden os.system'
EXT1 -> (<class 'collections.OrderedDict'>, b'\x80\x02\x82\xf0.', b'ccollections\nOrderedDict\nq\x00.', <class 'collections.OrderedDict'>)
EXT1, removed -> 'ValueError: unregistered extension code 240'
EXT1, no pair -> "ValueError: _inverted_registry[241] isn't a 2-tuple of strings"
EXT1, no strs -> "ValueError: _inverted_registry[241] isn't a 2-tuple of strings"
a code of 0 -> 'RuntimeError: extension code 0 is out of range'
a code that is a str -> "TypeError: 'str' object cannot be interpreted as an integer"
EXT4 -> b'\x80\x02\x84p\x11\x01\x00.'
EXT2 -> b'\x80\x02\x83,\x01.'
