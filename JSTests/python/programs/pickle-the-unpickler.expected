read gives a str -> "TypeError: a bytes-like object is required, not 'str'"
read gives None -> "TypeError: a bytes-like object is required, not 'NoneType'"
read gives too much -> None
read gives nothing -> 'EOFError: Ran out of input'
read raises -> 'ZeroDivisionError: division by zero'
read gives a bytearray -> None
peek raises NotImplementedError -> None
peek raises -> 'ZeroDivisionError: division by zero'
peek gives a str -> "TypeError: a bytes-like object is required, not 'str'"
peek gives nothing -> None
readinto gives 5 -> (b'abcde', ('memoryview', 5, False, 'B'))
readinto gives 4 -> 'UnpicklingError: pickle data was truncated'
readinto gives 6 -> (b'abcde', ('memoryview', 5, False, 'B'))
readinto gives -1 -> 'ValueError: readinto() returned negative size'
readinto gives None -> 'TypeError: an integer is required'
readinto gives a str -> 'TypeError: an integer is required'
