old readinto -> (True, (40, [('read', 1, 1), ('read', 1, 1), ('read', 1, 1), ('readline', None, 2), ('read', 1, 1), ('readline', None, 2)], [('readline', None, 3), ('read', 1, 1), ('read', 1, 1), ('readline', None, 2), ('read', 1, 1), ('read', 1, 1)]), 91)
