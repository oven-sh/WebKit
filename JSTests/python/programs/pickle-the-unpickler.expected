===== making one
no arguments -> "TypeError: Unpickler() missing required argument 'file' (pos 1)"
not a file -> "TypeError: file must have 'read' and 'readline' attributes"
only read -> "TypeError: file must have 'read' and 'readline' attributes"
only readline -> "TypeError: file must have 'read' and 'readline' attributes"
getting read raises -> 'ZeroDivisionError: division by zero'
positional options -> 'TypeError: Unpickler() takes exactly 1 positional argument (2 given)'
unknown keyword -> "TypeError: Unpickler() got an unexpected keyword argument 'zzz'"
Unpickler 'encoding 5' -> "TypeError: Unpickler() argument 'encoding' must be str, not int"
   loads -> "TypeError: loads() argument 'encoding' must be str, not int"
   load -> "TypeError: load() argument 'encoding' must be str, not int"
Unpickler 'encoding None' -> "TypeError: Unpickler() argument 'encoding' must be str, not None"
   loads -> "TypeError: loads() argument 'encoding' must be str, not None"
   load -> "TypeError: load() argument 'encoding' must be str, not None"
Unpickler "encoding b'x'" -> "TypeError: Unpickler() argument 'encoding' must be str, not bytes"
   loads -> "TypeError: loads() argument 'encoding' must be str, not bytes"
   load -> "TypeError: load() argument 'encoding' must be str, not bytes"
Unpickler "encoding 'a\\x00b'" -> 'ValueError: embedded null character'
   loads -> 'ValueError: embedded null character'
   load -> 'ValueError: embedded null character'
Unpickler "encoding '\\ud800'" -> "UnicodeEncodeError: 'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"
   loads -> "UnicodeEncodeError: 'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"
   load -> "UnicodeEncodeError: 'utf-8' codec can't encode character '\\ud800' in position 0: surrogates not allowed"
Unpickler 'errors 5' -> "TypeError: Unpickler() argument 'errors' must be str, not int"
   loads -> "TypeError: loads() argument 'errors' must be str, not int"
   load -> "TypeError: load() argument 'errors' must be str, not int"
Unpickler 'errors None' -> "TypeError: Unpickler() argument 'errors' must be str, not None"
   loads -> "TypeError: loads() argument 'errors' must be str, not None"
   load -> "TypeError: load() argument 'errors' must be str, not None"
Unpickler "errors 'a\\x00b'" -> 'ValueError: embedded null character'
   loads -> 'ValueError: embedded null character'
   load -> 'ValueError: embedded null character'
Unpickler 'buffers 5' -> "TypeError: 'int' object is not iterable"
   loads -> "TypeError: 'int' object is not iterable"
   load -> "TypeError: 'int' object is not iterable"
Unpickler 'buffers None' -> 'NoneType'
   loads -> None
   load -> None
Unpickler 'buffers ()' -> 'NoneType'
   loads -> None
   load -> None
Unpickler 'buffers <list_iterator objec' -> 'NoneType'
   loads -> None
   load -> None
Unpickler 'fix_imports []' -> 'NoneType'
   loads -> None
   load -> None
Unpickler "encoding 'nonesuch'" -> 'NoneType'
   loads -> None
   load -> None
Unpickler "errors 'nonesuch'" -> 'NoneType'
   loads -> None
   load -> None
loads: a str -> "TypeError: a bytes-like object is required, not 'str'"
loads: an int -> "TypeError: a bytes-like object is required, not 'int'"
loads: None -> "TypeError: a bytes-like object is required, not 'NoneType'"
loads: nothing -> 'TypeError: loads() takes exactly 1 positional argument (0 given)'
loads: by keyword -> 'TypeError: loads() takes exactly 1 positional argument (0 given)'
loads: bytearray -> 5
loads: memoryview -> 5
loads: a slice -> 5
loads: array -> 5
loads: not contiguous -> 'BufferError: memoryview: underlying buffer is not C-contiguous'
loads: PickleBuffer -> 5
load: nothing -> "TypeError: load() missing required argument 'file' (pos 1)"
load: not a file -> "TypeError: file must have 'read' and 'readline' attributes"
load: by keyword -> None
__init__ not called -> 'UnpicklingError: Unpickler.__init__() was not called by NoInit.__init__()'
__new__ alone -> 'UnpicklingError: Unpickler.__init__() was not called by _pickle.Unpickler.__init__()'
__init__ twice -> (1, None, 2)
===== attributes
another attribute -> "AttributeError: '_pickle.Unpickler' object has no attribute 'zzz'"
get another -> "AttributeError: '_pickle.Unpickler' object has no attribute 'zzz'"
persistent_load -> 'UnpicklingError: A load persistent id instruction was encountered, but no persistent_load function was specified.'
persistent_load: no argument -> 'TypeError: persistent_load() takes exactly 1 positional argument (0 given)'
set persistent_load -> True
delete persistent_load -> 'UnpicklingError: A load persistent id instruction was encountered, but no persistent_load function was specified.'
find_class -> <built-in function len>
find_class: one -> 'TypeError: find_class() takes exactly 2 positional arguments (1 given)'
find_class: ints -> 'TypeError: module name must be a string'
find_class: name an int -> "TypeError: attribute name must be string, not 'int'"
find_class: dotted -> "AttributeError: module 'collections' has no attribute 'OrderedDict.fromkeys'"
find_class: python 2 -> <class 'str'>
find_class: python 2, not fixed -> "ModuleNotFoundError: No module named '__builtin__'"
find_class: keyword -> 'TypeError: find_class() takes exactly 2 positional arguments (0 given)'
load: an argument -> 'TypeError: load() takes no arguments'
audit -> (<built-in function len>, [('pickle.find_class', ('builtins', 'len'))])
===== the memo
copy -> ('a', 'UnpicklerMemoProxy', {0: [], 2: 'a', 5: None}, (<class 'dict'>, ({0: [], 2: 'a', 5: None},)), False)
clear -> ([], None, {})
hash -> "TypeError: unhashable type: '_pickle.UnpicklerMemoProxy'"
len -> "TypeError: object of type '_pickle.UnpicklerMemoProxy' has no len()"
delete -> 'TypeError: attribute deletion is not supported'
set to a list -> "TypeError: 'memo' attribute must be an UnpicklerMemoProxy object or dict, not list"
set: keys no ints -> 'TypeError: memo key must be integers'
set: negative -> 'ValueError: memo key must be positive integers.'
set: too large -> 'OverflowError: Python int too large to convert to C ssize_t'
set: True -> None
set to a dict -> (None, {})
set to a dict, and read -> 'UnpicklingError: Memo value not found at index 0'
set to a proxy -> (True, {0: []})
kept from one load to the next -> ([], [])
MEMOIZE goes on counting -> (1, 2, {0: 1, 1: 2})
===== in use
load inside load -> 'RuntimeError: Unpickler object is already used'
__init__ inside load -> 'RuntimeError: Unpickler object is already used'
memo inside load -> {}
  first -> "UnpicklingError: invalid load key, 'Z'."
after it failed -> 'UnpicklingError: unpickling stack underflow'
===== what it reads from
small plain -> (True, [('read', 1, 1), ('read', 1, 1), ('read', 1, 1), ('read', 8, 8), ('read', 40, 40)], 51)
small readinto -> (True, [('read', 1, 1), ('read', 1, 1), ('read', 1, 1), ('read', 8, 8), ('read', 40, 40)], 51)
small peek -> (True, [('peek', 131072, 51), ('read', 51, 51)], 51)
   peek gives little -> (True, [('peek', 131072, 3), ('read', 3, 3), ('peek', 131072, 3), ('read', 8, 8), ('peek', 131072, 3), ('read', 40, 40)], 51)
small readinto+peek -> (True, [('peek', 131072, 51), ('read', 51, 51)], 51)
   peek gives little -> (True, [('peek', 131072, 3), ('read', 3, 3), ('peek', 131072, 3), ('read', 8, 8), ('peek', 131072, 3), ('read', 40, 40)], 51)
