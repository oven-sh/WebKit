---- what is being handled in finally
raise in finally => KeyError 'caught' | cause None | context TypeError('foo')
sys.exception() in finally => ["KeyError('k')", "KeyError('k')", 'None']
with nothing raised, and inside a handler => ['None', "ValueError('outer')", "KeyError('inner')", "ValueError('outer')"]
in __exit__ => [("KeyError('in with')", "KeyError('in with')"), 'None']
context of what finally raises => "KeyError('first')"
in a generator => ["KeyError('thrown')"]
continue in finally, then raise => 'KeyError(1)'
