---- what there is
the module => ('cmath', '', 'BuiltinImporter', 'This module provides access to mathematical functions for complex\nnumbers.', ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atanh', 'cos', 'cosh', 'e', 'exp', 'inf', 'infj', 'isclose', 'isfinite', 'isinf', 'isnan', 'log', 'log10', 'nan', 'nanj', 'phase', 'pi', 'polar', 'rect', 'sin', 'sinh', 'sqrt', 'tan', 'tanh', 'tau'])
acos => ('builtin_function_or_method', '($module, z, /)', 'Return the arc cosine of z.', 'cmath')
acosh => ('builtin_function_or_method', '($module, z, /)', 'Return the inverse hyperbolic cosine of z.', 'cmath')
asin => ('builtin_function_or_method', '($module, z, /)', 'Return the arc sine of z.', 'cmath')
asinh => ('builtin_function_or_method', '($module, z, /)', 'Return the inverse hyperbolic sine of z.', 'cmath')
atan => ('builtin_function_or_method', '($module, z, /)', 'Return the arc tangent of z.', 'cmath')
atanh => ('builtin_function_or_method', '($module, z, /)', 'Return the inverse hyperbolic tangent of z.', 'cmath')
cos => ('builtin_function_or_method', '($module, z, /)', 'Return the cosine of z.', 'cmath')
cosh => ('builtin_function_or_method', '($module, z, /)', 'Return the hyperbolic cosine of z.', 'cmath')
e => ('float', '0x1.5bf0a8b145769p+1', '2.718281828459045', 1.0)
exp => ('builtin_function_or_method', '($module, z, /)', 'Return the exponential value e**z.', 'cmath')
inf => ('float', 'inf', 'inf', 1.0)
infj => ('complex', ('0x0.0p+0', 'inf'), 'infj', 1.0)
isclose => ('builtin_function_or_method', '($module, /, a, b, *, rel_tol=1e-09, abs_tol=0.0)', 'Determine whether two complex numbers are close in value.\n\n  rel_tol\n    maximum difference for being considered "close", relative to the\n    magnitude of the input values\n  abs_tol\n    maximum difference for being considered "close", regardless of the\n    magnitude of the input values\n\nReturn True if a is close in value to b, and False otherwise.\n\nFor the values to be considered close, the difference between them must\nbe smaller than at least one of the tolerances.\n\n-inf, inf and NaN behave similarly to the IEEE 754 Standard.  That is,\nNaN is not close to anything, even itself. inf and -inf are only close\nto themselves.', 'cmath')
isfinite => ('builtin_function_or_method', '($module, z, /)', 'Return True if both the real and imaginary parts of z are finite, else False.', 'cmath')
isinf => ('builtin_function_or_method', '($module, z, /)', 'Checks if the real or imaginary part of z is infinite.', 'cmath')
isnan => ('builtin_function_or_method', '($module, z, /)', 'Checks if the real or imaginary part of z not a number (NaN).', 'cmath')
log => ('builtin_function_or_method', '($module, z, base=<unrepresentable>, /)', 'log(z[, base]) -> the logarithm of z to the given base.\n\nIf the base is not specified, returns the natural logarithm (base e)\nof z.', 'cmath')
log10 => ('builtin_function_or_method', '($module, z, /)', 'Return the base-10 logarithm of z.', 'cmath')
nan => ('float', 'nan', 'nan', 1.0)
nanj => ('complex', ('0x0.0p+0', 'nan'), 'nanj', 1.0)
phase => ('builtin_function_or_method', '($module, z, /)', 'Return argument, also known as the phase angle, of a complex.', 'cmath')
pi => ('float', '0x1.921fb54442d18p+1', '3.141592653589793', 1.0)
polar => ('builtin_function_or_method', '($module, z, /)', 'Convert a complex from rectangular coordinates to polar coordinates.\n\nr is the distance from 0 and phi the phase angle.', 'cmath')
rect => ('builtin_function_or_method', '($module, r, phi, /)', 'Convert from polar coordinates to rectangular coordinates.', 'cmath')
sin => ('builtin_function_or_method', '($module, z, /)', 'Return the sine of z.', 'cmath')
sinh => ('builtin_function_or_method', '($module, z, /)', 'Return the hyperbolic sine of z.', 'cmath')
