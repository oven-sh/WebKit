---- what is against the rules for names
'def f():\n x = 1\n global x' => ('SyntaxError', "name 'x' is assigned to before global declaration", 3, 2, 3, 10, None)
'def f():\n print(x)\n global x' => ('SyntaxError', "name 'x' is used prior to global declaration", 3, 2, 3, 10, None)
'def f(x):\n global x' => ('SyntaxError', "name 'x' is parameter and global", 2, 2, 2, 10, None)
'def f():\n nonlocal x' => ('SyntaxError', "no binding for nonlocal 'x' found", 2, 2, 2, 12, None)
'nonlocal x' => ('SyntaxError', 'nonlocal declaration not allowed at module level', 1, 1, 1, 11, None)
'def f():\n x = 1\n def g():\n  x = 2\n  nonlocal x' => ('SyntaxError', "name 'x' is assigned to before nonlocal declaration", 5, 3, 5, 13, None)
'def f(x):\n def g():\n  global x\n  nonlocal x' => ('SyntaxError', "name 'x' is nonlocal and global", 3, 3, 3, 11, None)
'def f(a, a): pass' => ('SyntaxError', "duplicate argument 'a' in function definition", 1, 10, 1, 11, None)
'def f(a, *, a): pass' => ('SyntaxError', "duplicate argument 'a' in function definition", 1, 13, 1, 14, None)
'lambda a, a: 0' => ('SyntaxError', "duplicate argument 'a' in function definition", 1, 11, 1, 12, None)
'def f():\n x: int\n global x' => ('SyntaxError', "annotated name 'x' can't be global", 3, 2, 3, 10, None)
'def f():\n global x\n x: int = 1' => ('SyntaxError', "annotated name 'x' can't be global", 3, 2, 3, 12, None)
'class C:\n nonlocal x' => ('SyntaxError', "no binding for nonlocal 'x' found", 2, 2, 2, 12, None)
'[x := 1 for x in y]' => ('SyntaxError', "assignment expression cannot rebind comprehension iteration variable 'x'", 1, 2, 1, 3, None)
'[[(x := 1) for a in b] for x in y]' => ('SyntaxError', "assignment expression cannot rebind comprehension iteration variable 'x'", 1, 4, 1, 5, None)
'class C:\n [y := 1 for x in z]' => ('SyntaxError', 'assignment expression within a comprehension cannot be used in a class body', 2, 3, 2, 4, None)
'[i for i in (j := 0)]' => ('SyntaxError', 'assignment expression cannot be used in a comprehension iterable expression', 1, 14, 1, 20, None)
'def f[T, T](): pass' => ('SyntaxError', "duplicate type parameter 'T'", 1, 10, 1, 11, None)
'class C[T, T]: pass' => ('SyntaxError', "duplicate type parameter 'T'", 1, 12, 1, 13, None)
'type X[T, T] = int' => ('SyntaxError', "duplicate type parameter 'T'", 1, 11, 1, 12, None)
'def f[T](T): pass' => ('top', 2, 0, 0, [('f', 4098)], [], [('f', 5, 0, 1, [('.defaults', 4100), ('T', 5122)], ['.defaults'], [('__annotate__', 3, 1, 1, [('.format', 4116)], ['.format'], []), ('f', 0, 1, 1, [('T', 4100)], ['T'], [])])])
'def f():\n from x import *' => ('SyntaxError', 'import * only allowed at module level', 2, 16, 2, 17, None)
'def f[T: (yield)](): pass' => ('SyntaxError', 'yield expression cannot be used within a TypeVar bound', 1, 11, 1, 16, None)
'type X = (yield)' => ('SyntaxError', 'yield expression cannot be used within a type alias', 1, 11, 1, 16, None)
'def f[T: (x := 1)](): pass' => ('SyntaxError', 'named expression cannot be used within a TypeVar bound', 1, 11, 1, 17, None)
'def f[T = (await x)](): pass' => ('SyntaxError', 'await expression cannot be used within a TypeVar default', 1, 12, 1, 19, None)
'class C[T]((yield)): pass' => ('SyntaxError', 'yield expression cannot be used within the definition of a generic', 1, 13, 1, 18, None)
'def f(x: (yield)): pass' => ('SyntaxError', 'yield expression cannot be used within an annotation', 1, 11, 1, 16, None)
'def f():\n x: (yield) = 1' => ('SyntaxError', 'yield expression cannot be used within an annotation', 2, 6, 2, 11, None)
'x: (y := 1)' => ('SyntaxError', 'named expression cannot be used within an annotation', 1, 5, 1, 11, None)
'def f(x: (y := 1)): pass' => ('SyntaxError', 'named expression cannot be used within an annotation', 1, 11, 1, 17, None)
'async def f():\n [(yield) for x in y]' => ('SyntaxError', "'yield' inside list comprehension", 2, 4, 2, 9, None)
'[(yield) for x in y]' => ('SyntaxError', "'yield' inside list comprehension", 1, 3, 1, 8, None)
'{(yield x) for x in y}' => ('SyntaxError', "'yield' inside set comprehension", 1, 3, 1, 10, None)
'((yield) for x in y)' => ('SyntaxError', "'yield' inside generator expression", 1, 3, 1, 8, None)
'def f():\n return [(yield) for x in y]' => ('SyntaxError', "'yield' inside list comprehension", 2, 11, 2, 16, None)
