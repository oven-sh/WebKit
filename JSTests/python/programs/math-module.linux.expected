---- what there is
the module => ('math', '', 'BuiltinImporter', 'This module provides access to the mathematical functions\ndefined by the C standard.', ['acos', 'acosh', 'asin', 'asinh', 'atan', 'atan2', 'atanh', 'cbrt', 'ceil', 'comb', 'copysign', 'cos', 'cosh', 'degrees', 'dist', 'e', 'erf', 'erfc', 'exp', 'exp2', 'expm1', 'fabs', 'factorial', 'floor', 'fma', 'fmod', 'frexp', 'fsum', 'gamma', 'gcd', 'hypot', 'inf', 'isclose', 'isfinite', 'isinf', 'isnan', 'isqrt', 'lcm', 'ldexp', 'lgamma', 'log', 'log10', 'log1p', 'log2', 'modf', 'nan', 'nextafter', 'perm', 'pi', 'pow', 'prod', 'radians', 'remainder', 'sin', 'sinh', 'sqrt', 'sumprod', 'tan', 'tanh', 'tau', 'trunc', 'ulp'])
acos => ('builtin_function_or_method', '($module, x, /)', 'Return the arc cosine (measured in radians) of x.\n\nThe result is between 0 and pi.', 'math')
acosh => ('builtin_function_or_method', '($module, x, /)', 'Return the inverse hyperbolic cosine of x.', 'math')
asin => ('builtin_function_or_method', '($module, x, /)', 'Return the arc sine (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2.', 'math')
asinh => ('builtin_function_or_method', '($module, x, /)', 'Return the inverse hyperbolic sine of x.', 'math')
atan => ('builtin_function_or_method', '($module, x, /)', 'Return the arc tangent (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2.', 'math')
atan2 => ('builtin_function_or_method', '($module, y, x, /)', 'Return the arc tangent (measured in radians) of y/x.\n\nUnlike atan(y/x), the signs of both x and y are considered.', 'math')
atanh => ('builtin_function_or_method', '($module, x, /)', 'Return the inverse hyperbolic tangent of x.', 'math')
cbrt => ('builtin_function_or_method', '($module, x, /)', 'Return the cube root of x.', 'math')
ceil => ('builtin_function_or_method', '($module, x, /)', 'Return the ceiling of x as an Integral.\n\nThis is the smallest integer >= x.', 'math')
comb => ('builtin_function_or_method', '($module, n, k, /)', 'Number of ways to choose k items from n items without repetition and without order.\n\nEvaluates to n! / (k! * (n - k)!) when k <= n and evaluates\nto zero when k > n.\n\nAlso called the binomial coefficient because it is equivalent\nto the coefficient of k-th term in polynomial expansion of the\nexpression (1 + x)**n.\n\nRaises TypeError if either of the arguments are not integers.\nRaises ValueError if either of the arguments are negative.', 'math')
copysign => ('builtin_function_or_method', '($module, x, y, /)', 'Return a float with the magnitude (absolute value) of x but the sign of y.\n\nOn platforms that support signed zeros, copysign(1.0, -0.0)\nreturns -1.0.\n', 'math')
cos => ('builtin_function_or_method', '($module, x, /)', 'Return the cosine of x (measured in radians).', 'math')
cosh => ('builtin_function_or_method', '($module, x, /)', 'Return the hyperbolic cosine of x.', 'math')
degrees => ('builtin_function_or_method', '($module, x, /)', 'Convert angle x from radians to degrees.', 'math')
dist => ('builtin_function_or_method', '($module, p, q, /)', 'Return the Euclidean distance between two points p and q.\n\nThe points should be specified as sequences (or iterables) of\ncoordinates.  Both inputs must have the same dimension.\n\nRoughly equivalent to:\n    sqrt(sum((px - qx) ** 2.0 for px, qx in zip(p, q)))', 'math')
e => (2.718281828459045, '0x1.5bf0a8b145769p+1')
erf => ('builtin_function_or_method', '($module, x, /)', 'Error function at x.', 'math')
erfc => ('builtin_function_or_method', '($module, x, /)', 'Complementary error function at x.', 'math')
exp => ('builtin_function_or_method', '($module, x, /)', 'Return e raised to the power of x.', 'math')
exp2 => ('builtin_function_or_method', '($module, x, /)', 'Return 2 raised to the power of x.', 'math')
expm1 => ('builtin_function_or_method', '($module, x, /)', 'Return exp(x)-1.\n\nThis function avoids the loss of precision involved in the direct evaluation of exp(x)-1 for small x.', 'math')
fabs => ('builtin_function_or_method', '($module, x, /)', 'Return the absolute value of the float x.', 'math')
factorial => ('builtin_function_or_method', '($module, n, /)', 'Find n!.', 'math')
floor => ('builtin_function_or_method', '($module, x, /)', 'Return the floor of x as an Integral.\n\nThis is the largest integer <= x.', 'math')
fma => ('builtin_function_or_method', '($module, x, y, z, /)', 'Fused multiply-add operation.\n\nCompute (x * y) + z with a single round.', 'math')
fmod => ('builtin_function_or_method', '($module, x, y, /)', 'Return fmod(x, y), according to platform C.\n\nx % y may differ.', 'math')
frexp => ('builtin_function_or_method', '($module, x, /)', 'Return the mantissa and exponent of x, as pair (m, e).\n\nIf x is a finite nonzero number, then m is a float with\n0.5 <= abs(m) < 1.0 and an integer e is such that\nx == m * 2**e exactly.  Else, return (x, 0).', 'math')
fsum => ('builtin_function_or_method', '($module, seq, /)', 'Return an accurate floating-point sum of values in the iterable seq.\n\nAssumes IEEE-754 floating-point arithmetic.', 'math')
gamma => ('builtin_function_or_method', '($module, x, /)', 'Gamma function at x.', 'math')
gcd => ('builtin_function_or_method', '($module, /, *integers)', 'Greatest Common Divisor.', 'math')
hypot => ('builtin_function_or_method', '($module, /, *coordinates)', 'Multidimensional Euclidean distance from the origin to a point.\n\nRoughly equivalent to:\n    sqrt(sum(x**2 for x in coordinates))\n\nFor a two dimensional point (x, y), gives the hypotenuse\nusing the Pythagorean theorem:  sqrt(x*x + y*y).\n\nFor example, the hypotenuse of a 3/4/5 right triangle is:\n\n    >>> hypot(3.0, 4.0)\n    5.0', 'math')
inf => (inf, 'inf')
isclose => ('builtin_function_or_method', '($module, /, a, b, *, rel_tol=1e-09, abs_tol=0.0)', 'Determine whether two floating-point numbers are close in value.\n\n  rel_tol\n    maximum difference for being considered "close", relative to the\n    magnitude of the input values\n  abs_tol\n    maximum difference for being considered "close", regardless of the\n    magnitude of the input values\n\nReturn True if a is close in value to b, and False otherwise.\n\nFor the values to be considered close, the difference between them\nmust be smaller than at least one of the tolerances.\n\n-inf, inf and NaN behave similarly to the IEEE 754 Standard.  That\nis, NaN is not close to anything, even itself.  inf and -inf are\nonly close to themselves.', 'math')
isfinite => ('builtin_function_or_method', '($module, x, /)', 'Return True if x is neither an infinity nor a NaN, and False otherwise.', 'math')
isinf => ('builtin_function_or_method', '($module, x, /)', 'Return True if x is a positive or negative infinity, and False otherwise.', 'math')
isnan => ('builtin_function_or_method', '($module, x, /)', 'Return True if x is a NaN (not a number), and False otherwise.', 'math')
isqrt => ('builtin_function_or_method', '($module, n, /)', 'Return the integer part of the square root of the input.', 'math')
lcm => ('builtin_function_or_method', '($module, /, *integers)', 'Least Common Multiple.', 'math')
ldexp => ('builtin_function_or_method', '($module, x, i, /)', 'Return x * (2**i).\n\nThis is essentially the inverse of frexp().', 'math')
lgamma => ('builtin_function_or_method', '($module, x, /)', 'Natural logarithm of absolute value of Gamma function at x.', 'math')
log => ('builtin_function_or_method', None, 'log(x, [base=math.e])\nReturn the logarithm of x to the given base.\n\nIf the base is not specified, returns the natural logarithm (base e) of x.', 'math')
log10 => ('builtin_function_or_method', '($module, x, /)', 'Return the base 10 logarithm of x.', 'math')
log1p => ('builtin_function_or_method', '($module, x, /)', 'Return the natural logarithm of 1+x (base e).\n\nThe result is computed in a way which is accurate for x near zero.', 'math')
log2 => ('builtin_function_or_method', '($module, x, /)', 'Return the base 2 logarithm of x.', 'math')
modf => ('builtin_function_or_method', '($module, x, /)', 'Return the fractional and integer parts of x.\n\nBoth results carry the sign of x and are floats.', 'math')
nan => (nan, 1.0)
nextafter => ('builtin_function_or_method', '($module, x, y, /, *, steps=None)', 'Return the floating-point value the given number of steps after x towards y.\n\nIf steps is not specified or is None, it defaults to 1.\n\nRaises a TypeError, if x or y is not a double, or if steps is not\nan integer.  Raises ValueError if steps is negative.', 'math')
perm => ('builtin_function_or_method', '($module, n, k=None, /)', 'Number of ways to choose k items from n items without repetition and with order.\n\nEvaluates to n! / (n - k)! when k <= n and evaluates\nto zero when k > n.\n\nIf k is not specified or is None, then k defaults to n\nand the function returns n!.\n\nRaises TypeError if either of the arguments are not integers.\nRaises ValueError if either of the arguments are negative.', 'math')
pi => (3.141592653589793, '0x1.921fb54442d18p+1')
pow => ('builtin_function_or_method', '($module, x, y, /)', 'Return x**y (x to the power of y).', 'math')
prod => ('builtin_function_or_method', '($module, iterable, /, *, start=1)', 'Calculate the product of all the elements in the input iterable.\n\nThe default start value for the product is 1.\n\nWhen the iterable is empty, return the start value.  This function is\nintended specifically for use with numeric values and may reject\nnon-numeric types.', 'math')
radians => ('builtin_function_or_method', '($module, x, /)', 'Convert angle x from degrees to radians.', 'math')
remainder => ('builtin_function_or_method', '($module, x, y, /)', 'Difference between x and the closest integer multiple of y.\n\nReturn x - n*y where n*y is the closest integer multiple of y.\nIn the case where x is exactly halfway between two multiples of\ny, the nearest even value of n is used. The result is always exact.', 'math')
sin => ('builtin_function_or_method', '($module, x, /)', 'Return the sine of x (measured in radians).', 'math')
sinh => ('builtin_function_or_method', '($module, x, /)', 'Return the hyperbolic sine of x.', 'math')
sqrt => ('builtin_function_or_method', '($module, x, /)', 'Return the square root of x.', 'math')
sumprod => ('builtin_function_or_method', '($module, p, q, /)', 'Return the sum of products of values from two iterables p and q.\n\nRoughly equivalent to:\n\n    sum(map(operator.mul, p, q, strict=True))\n\nFor float and mixed int/float inputs, the intermediate products\nand sums are computed with extended precision.', 'math')
tan => ('builtin_function_or_method', '($module, x, /)', 'Return the tangent of x (measured in radians).', 'math')
tanh => ('builtin_function_or_method', '($module, x, /)', 'Return the hyperbolic tangent of x.', 'math')
tau => (6.283185307179586, '0x1.921fb54442d18p+2')
trunc => ('builtin_function_or_method', '($module, x, /)', 'Truncates the Real x to the nearest Integral toward 0.\n\nUses the __trunc__ magic method.', 'math')
ulp => ('builtin_function_or_method', '($module, x, /)', 'Return the value of the least significant bit of the float x.', 'math')
