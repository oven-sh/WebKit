the module => ('_opcode', '', 'BuiltinImporter', 'Opcode support module.', ['ENABLE_SPECIALIZATION', 'ENABLE_SPECIALIZATION_FT', 'get_executor', 'get_intrinsic1_descs', 'get_intrinsic2_descs', 'get_nb_ops', 'get_special_method_names', 'get_specialization_stats', 'has_arg', 'has_const', 'has_exc', 'has_free', 'has_jump', 'has_local', 'has_name', 'is_valid', 'stack_effect'], 1, 1)
get_executor => ('builtin_function_or_method', '($module, /, code, offset)', 'Return the executor object at offset in code if exists, None otherwise.', '_opcode')
get_intrinsic1_descs => ('builtin_function_or_method', '($module, /)', 'Return a list of names of the unary intrinsics.', '_opcode')
get_intrinsic2_descs => ('builtin_function_or_method', '($module, /)', 'Return a list of names of the binary intrinsics.', '_opcode')
get_nb_ops => ('builtin_function_or_method', '($module, /)', 'Return array of symbols of binary ops.\n\nIndexed by the BINARY_OP oparg value.', '_opcode')
get_special_method_names => ('builtin_function_or_method', '($module, /)', 'Return a list of special method names.', '_opcode')
get_specialization_stats => ('builtin_function_or_method', '($module, /)', 'Return the specialization stats', '_opcode')
has_arg => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode uses its oparg, False otherwise.', '_opcode')
has_const => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode accesses a constant, False otherwise.', '_opcode')
has_exc => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode sets an exception handler, False otherwise.', '_opcode')
has_free => ('builtin_function_or_method', '($module, /, opcode)', "Return True if the opcode accesses a free variable, False otherwise.\n\nNote that 'free' in this context refers to names in the current scope\nthat are referenced by inner scopes or names in outer scopes that are\nreferenced from this scope. It does not include references to global\nor builtin scopes.", '_opcode')
has_jump => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode has a jump target, False otherwise.', '_opcode')
has_local => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode accesses a local variable, False otherwise.', '_opcode')
has_name => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if the opcode accesses an attribute by name, False otherwise.', '_opcode')
is_valid => ('builtin_function_or_method', '($module, /, opcode)', 'Return True if opcode is valid, False otherwise.', '_opcode')
stack_effect => ('builtin_function_or_method', '($module, opcode, oparg=None, /, *, jump=None)', 'Compute the stack effect of the opcode.', '_opcode')
