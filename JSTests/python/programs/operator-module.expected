methodcaller => ('type', '(name, /, *args, **kwargs)', "Return a callable object that calls the given method on its operand.\nAfter f = methodcaller('name'), the call f(r) returns r.name().\nAfter g = methodcaller('name', 'date', foo=1), the call g(r) returns\nr.name('date', foo=1).", 'operator', 'methodcaller', 'methodcaller', False)
