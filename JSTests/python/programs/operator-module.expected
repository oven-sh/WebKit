itemgetter => ('type', '(item, /, *items)', 'Return a callable object that fetches the given item(s) from its operand.\nAfter f = itemgetter(2), the call f(r) returns r[2].\nAfter g = itemgetter(2, 5, 3), the call g(r) returns (r[2], r[5], r[3])', 'operator', 'itemgetter', 'itemgetter', False)
