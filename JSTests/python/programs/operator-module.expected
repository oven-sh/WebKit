---- what there is
the module => ('_operator', '', 'BuiltinImporter', "Operator interface.\n\nThis module exports a set of functions implemented in C corresponding\nto the intrinsic operators of Python.  For example, operator.add(x, y)\nis equivalent to the expression x+y.  The function names are those\nused for special methods; variants without leading and trailing\n'__' are also provided for convenience.", ['_compare_digest', 'abs', 'add', 'and_', 'attrgetter', 'call', 'concat', 'contains', 'countOf', 'delitem', 'eq', 'floordiv', 'ge', 'getitem', 'gt', 'iadd', 'iand', 'iconcat', 'ifloordiv', 'ilshift', 'imatmul', 'imod', 'imul', 'index', 'indexOf', 'inv', 'invert', 'ior', 'ipow', 'irshift', 'is_', 'is_none', 'is_not', 'is_not_none', 'isub', 'itemgetter', 'itruediv', 'ixor', 'le', 'length_hint', 'lshift', 'lt', 'matmul', 'methodcaller', 'mod', 'mul', 'ne', 'neg', 'not_', 'or_', 'pos', 'pow', 'rshift', 'setitem', 'sub', 'truediv', 'truth', 'xor'])
_compare_digest => ('builtin_function_or_method', '($module, a, b, /)', "Return 'a == b'.\n\nThis function uses an approach designed to prevent\ntiming analysis, making it appropriate for cryptography.\n\na and b must both be of the same type: either str (ASCII only),\nor any bytes-like object.\n\nNote: If a and b are of different lengths, or if an error occurs,\na timing attack could theoretically reveal information about the\ntypes and lengths of a and b--but not their values.", '_operator', '_compare_digest', '_compare_digest', True)
abs => ('builtin_function_or_method', '($module, a, /)', 'Same as abs(a).', '_operator', 'abs', 'abs', True)
add => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a + b.', '_operator', 'add', 'add', True)
and_ => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a & b.', '_operator', 'and_', 'and_', True)
attrgetter => ('type', '(attr, /, *attrs)', "Return a callable object that fetches the given attribute(s) from its operand.\nAfter f = attrgetter('name'), the call f(r) returns r.name.\nAfter g = attrgetter('name', 'date'), the call g(r) returns (r.name, r.date).\nAfter h = attrgetter('name.first', 'name.last'), the call h(r) returns\n(r.name.first, r.name.last).", 'operator', 'attrgetter', 'attrgetter', False)
call => ('builtin_function_or_method', '($module, obj, /, *args, **kwargs)', 'Same as obj(*args, **kwargs).', '_operator', 'call', 'call', True)
concat => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a + b, for a and b sequences.', '_operator', 'concat', 'concat', True)
contains => ('builtin_function_or_method', '($module, a, b, /)', 'Same as b in a (note reversed operands).', '_operator', 'contains', 'contains', True)
countOf => ('builtin_function_or_method', '($module, a, b, /)', 'Return the number of items in a which are, or which equal, b.', '_operator', 'countOf', 'countOf', True)
delitem => ('builtin_function_or_method', '($module, a, b, /)', 'Same as del a[b].', '_operator', 'delitem', 'delitem', True)
eq => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a == b.', '_operator', 'eq', 'eq', True)
floordiv => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a // b.', '_operator', 'floordiv', 'floordiv', True)
ge => ('builtin_function_or_method', '($module, a, b, /)', 'Same as a >= b.', '_operator', 'ge', 'ge', True)
