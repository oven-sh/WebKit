what can be asked of a descriptor, and so on => [['chdir', 'chmod', 'chown', 'execve', 'listdir', 'pathconf', 'scandir', 'stat', 'statvfs', 'truncate', 'utime'], ['access', 'chmod', 'chown', 'link', 'lstat', 'mkdir', 'mkfifo', 'mknod', 'open', 'readlink', 'rename', 'rmdir', 'stat', 'symlink', 'unlink', 'utime'], ['access', 'chown', 'link', 'stat', 'utime'], ['access']]
copy_file_range => ('builtin_function_or_method', '($module, /, src, dst, count, offset_src=None,\n                offset_dst=None)', 'Copy count bytes from one file descriptor to another.\n\n  src\n    Source file descriptor.\n  dst\n    Destination file descriptor.\n  count\n    Number of bytes to copy.\n  offset_src\n    Starting offset in src.\n  offset_dst\n    Starting offset in dst.\n\nIf offset_src is None, then src is read from the current position;\nrespectively for offset_dst.', 'posix')
copy_file_range with nothing, and with too much => ("TypeError: copy_file_range() missing required argument 'src' (pos 1)", 'TypeError: copy_file_range() takes at most 5 arguments (9 given)', "TypeError: copy_file_range() missing required argument 'src' (pos 1)")
