getresuid with nothing, and with too much => ((501, 501, 501), 'TypeError: posix.getresuid() takes no arguments (9 given)', 'TypeError: posix.getresuid() takes no keyword arguments')
getxattr => ('builtin_function_or_method', '($module, /, path, attribute, *, follow_symlinks=True)', 'Return the value of extended attribute attribute on path.\n\npath may be either a string, a path-like object, or an open file\ndescriptor.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, getxattr will examine the symbolic link itself\ninstead of the file the link points to.', 'posix')
getxattr with nothing, and with too much => ("TypeError: getxattr() missing required argument 'path' (pos 1)", 'TypeError: getxattr() takes at most 3 arguments (9 given)', "TypeError: getxattr() missing required argument 'path' (pos 1)")
listxattr => ('builtin_function_or_method', '($module, /, path=None, *, follow_symlinks=True)', 'Return a list of extended attributes on path.\n\npath may be either None, a string, a path-like object, or an open file\ndescriptor.  If path is None, listxattr will examine the current\ndirectory.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, listxattr will examine the symbolic link itself instead\nof the file the link points to.', 'posix')
listxattr with nothing, and with too much => ([], 'TypeError: listxattr() takes at most 2 arguments (9 given)', "TypeError: listxattr() got an unexpected keyword argument 'nonsense'")
