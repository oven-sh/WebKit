pipe2 => ('builtin_function_or_method', '($module, flags, /)', 'Create a pipe with flags set atomically.\n\nReturns a tuple of two file descriptors:\n  (read_fd, write_fd)\n\nflags can be constructed by ORing together one or more of these values:\nO_NONBLOCK, O_CLOEXEC.', 'posix')
pipe2 with nothing, and with too much => ('TypeError: posix.pipe2() takes exactly one argument (0 given)', 'TypeError: posix.pipe2() takes exactly one argument (9 given)', 'TypeError: posix.pipe2() takes no keyword arguments')
posix_fadvise => ('builtin_function_or_method', '($module, fd, offset, length, advice, /)', 'Announce an intention to access data in a specific pattern.\n\nAnnounce an intention to access data in a specific pattern, thus\nallowing the kernel to make optimizations.\nThe advice applies to the region of the file specified by fd starting at\noffset and continuing for length bytes.\nadvice is one of POSIX_FADV_NORMAL, POSIX_FADV_SEQUENTIAL,\nPOSIX_FADV_RANDOM, POSIX_FADV_NOREUSE, POSIX_FADV_WILLNEED, or\nPOSIX_FADV_DONTNEED.', 'posix')
posix_fadvise with nothing, and with too much => ('TypeError: posix_fadvise expected 4 arguments, got 0', 'TypeError: posix_fadvise expected 4 arguments, got 9', 'TypeError: posix.posix_fadvise() takes no keyword arguments')
posix_fallocate => ('builtin_function_or_method', '($module, fd, offset, length, /)', 'Ensure a file has allocated at least a particular number of bytes on disk.\n\nEnsure that the file specified by fd encompasses a range of bytes\nstarting at offset bytes from the beginning and continuing for length\nbytes.', 'posix')
posix_fallocate with nothing, and with too much => ('TypeError: posix_fallocate expected 3 arguments, got 0', 'TypeError: posix_fallocate expected 3 arguments, got 9', 'TypeError: posix.posix_fallocate() takes no keyword arguments')
removexattr => ('builtin_function_or_method', '($module, /, path, attribute, *, follow_symlinks=True)', 'Remove extended attribute attribute on path.\n\npath may be either a string, a path-like object, or an open file\ndescriptor.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, removexattr will modify the symbolic link itself\ninstead of the file the link points to.', 'posix')
removexattr with nothing, and with too much => ("TypeError: removexattr() missing required argument 'path' (pos 1)", 'TypeError: removexattr() takes at most 3 arguments (9 given)', "TypeError: removexattr() missing required argument 'path' (pos 1)")
