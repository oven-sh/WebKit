sched_getparam with nothing, and with too much => ('TypeError: posix.sched_getparam() takes exactly one argument (0 given)', 'TypeError: posix.sched_getparam() takes exactly one argument (9 given)', 'TypeError: posix.sched_getparam() takes no keyword arguments')
