True
===== making one
none -> OrderedDict()
pairs -> OrderedDict({'a': 1, 'b': 2})
a dict -> OrderedDict({'a': 1, 'b': 2})
keywords -> OrderedDict({'a': 1, 'b': 2})
both -> OrderedDict({'a': 3, 'b': 2})
another -> OrderedDict({'a': 1, 'b': 2, 'c': 3})
two -> 'TypeError: expected at most 1 argument, got 2'
three -> 'TypeError: expected at most 1 argument, got 3'
an int -> "TypeError: 'int' object is not iterable"
None -> "TypeError: 'NoneType' object is not iterable"
a str -> 'ValueError: need more than 1 value to unpack'
strs of two -> OrderedDict({'a': 'b', 'c': 'd'})
a pair too short -> 'ValueError: need more than 1 value to unpack'
an empty pair -> 'ValueError: need more than 0 values to unpack'
a pair too long -> 'ValueError: too many values to unpack (expected 2)'
not pairs -> "TypeError: 'int' object is not iterable"
a generator -> OrderedDict({'a': 0, 'b': 1, 'c': 2})
lists -> OrderedDict({'a': 1})
sets of two -> 1
unhashable -> "TypeError: unhashable type: 'list'"
self by keyword -> OrderedDict({'self': 1})
other by keyword -> OrderedDict({'other': 1})
keys and getitem -> OrderedDict({'a': 'A', 'b': 'B'})
items only -> OrderedDict({'a': 1})
keys not callable -> "TypeError: 'int' object is not callable"
keys raises -> 'ZeroDivisionError: division by zero'
keys gives an int -> "TypeError: 'int' object is not iterable"
getitem raises -> 'ZeroDivisionError: division by zero'
a mappingproxy -> OrderedDict({'a': 1})
a Counter -> OrderedDict({'a': 2, 'b': 1})
a defaultdict -> OrderedDict({'a': 1})
__init__ again -> OrderedDict({'a': 5, 'b': 2, 'c': 3, 'z': 1})
__init__ with two -> 'TypeError: expected at most 1 argument, got 2'
__new__ alone -> (OrderedDict(), 0, [], 'popitem')
dict.__new__ -> 'OrderedDict'
object.__new__ -> 'TypeError: object.__new__(collections.OrderedDict) is not safe, use collections.OrderedDict.__new__()'
dict.__init__ -> (None, 1, [], dict_keys(['a']))
===== shown
OrderedDict() -> ('OrderedDict()', 'OrderedDict()', 0, False, [], [], [], [], [], [], [], [])
   views -> ('odict_keys([])', 'odict_values([])', 'odict_items([])', 0, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
OrderedDict({'a': 1, 'b': 2, 'c': 3}) -> ("OrderedDict({'a': 1, 'b': 2, 'c': 3})", "OrderedDict({'a': 1, 'b': 2, 'c': 3})", 3, True, ['a', 'b', 'c'], ['a', 'b', 'c'], [1, 2, 3], [('a', 1), ('b', 2), ('c', 3)], ['c', 'b', 'a'], ['c', 'b', 'a'], [3, 2, 1], [('c', 3), ('b', 2), ('a', 1)])
   views -> ("odict_keys(['a', 'b', 'c'])", 'odict_values([1, 2, 3])', "odict_items([('a', 1), ('b', 2), ('c', 3)])", 3, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
OrderedDict({'a': OrderedDict({'b': 1})}) -> ("OrderedDict({'a': OrderedDict({'b': 1})})", "OrderedDict({'a': OrderedDict({'b': 1})})", 1, True, ['a'], ['a'], [OrderedDict({'b': 1})], [('a', OrderedDict({'b': 1}))], ['a'], ['a'], [OrderedDict({'b': 1})], [('a', OrderedDict({'b': 1}))])
   views -> ("odict_keys(['a'])", "odict_values([OrderedDict({'b': 1})])", "odict_items([('a', OrderedDict({'b': 1}))])", 1, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
S() -> ('S()', 'S()', 0, False, [], [], [], [], [], [], [], [])
   views -> ('odict_keys([])', 'odict_values([])', 'odict_items([])', 0, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
S({'a': 1}) -> ("S({'a': 1})", "S({'a': 1})", 1, True, ['a'], ['a'], [1], [('a', 1)], ['a'], ['a'], [1], [('a', 1)])
   views -> ("odict_keys(['a'])", 'odict_values([1])', "odict_items([('a', 1)])", 1, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
OrderedDict({1: 'x', (1, 2): None}) -> ("OrderedDict({1: 'x', (1, 2): None})", "OrderedDict({1: 'x', (1, 2): None})", 2, True, [1, (1, 2)], [1, (1, 2)], ['x', None], [(1, 'x'), ((1, 2), None)], [(1, 2), 1], [(1, 2), 1], [None, 'x'], [((1, 2), None), (1, 'x')])
   views -> ('odict_keys([1, (1, 2)])', "odict_values(['x', None])", "odict_items([(1, 'x'), ((1, 2), None)])", 2, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
OrderedDict({'a': [1, 2]}) -> ("OrderedDict({'a': [1, 2]})", "OrderedDict({'a': [1, 2]})", 1, True, ['a'], ['a'], [[1, 2]], [('a', [1, 2])], ['a'], ['a'], [[1, 2]], [('a', [1, 2])])
   views -> ("odict_keys(['a'])", 'odict_values([[1, 2]])', "odict_items([('a', [1, 2])])", 1, 'odict_keys', 'odict_values', 'odict_items', 'odict_iterator', 'odict_iterator', 'odict_iterator')
in itself -> "OrderedDict({'a': ...})"
its values in itself -> "OrderedDict({'a': odict_values([...])})"
its items in itself -> ("OrderedDict({'a': odict_items([('a', ...)])})", "odict_items([('a', odict_items([('a', ...)]))])")
a repr that raises -> 'ZeroDivisionError: division by zero'
the name of a derived class -> ("X({'a': 1})", 'X()')
