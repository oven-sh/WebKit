many moves -> [0, 6, 4, 3, 2, 5, 1]
popitem(True) -> [(('c', 3), [('a', 1), ('b', 2)]), (('b', 2), [('a', 1)]), (('a', 1), []), ("KeyError: 'dictionary is empty'", [])]
popitem(False) -> [(('a', 1), [('b', 2), ('c', 3)]), (('b', 2), [('c', 3)]), (('c', 3), []), ("KeyError: 'dictionary is empty'", [])]
popitem(0) -> [(('a', 1), [('b', 2), ('c', 3)]), (('b', 2), [('c', 3)]), (('c', 3), []), ("KeyError: 'dictionary is empty'", [])]
popitem(1) -> [(('c', 3), [('a', 1), ('b', 2)]), (('b', 2), [('a', 1)]), (('a', 1), []), ("KeyError: 'dictionary is empty'", [])]
popitem(None) -> [(('a', 1), [('b', 2), ('c', 3)]), (('b', 2), [('c', 3)]), (('c', 3), []), ("KeyError: 'dictionary is empty'", [])]
popitem('x') -> [(('c', 3), [('a', 1), ('b', 2)]), (('b', 2), [('a', 1)]), (('a', 1), []), ("KeyError: 'dictionary is empty'", [])]
popitem: keyword -> ('a', 1)
popitem: two -> 'TypeError: popitem() takes at most 1 argument (2 given)'
popitem: unknown -> "TypeError: popitem() got an unexpected keyword argument 'first'"
pop('a',) -> [(1, [('b', 2), ('c', 3)])]
pop('z',) -> [("KeyError: 'z'", [('a', 1), ('b', 2), ('c', 3)])]
pop('z', None) -> [(None, [('a', 1), ('b', 2), ('c', 3)])]
pop('z', 5) -> [(5, [('a', 1), ('b', 2), ('c', 3)])]
pop('a', 5) -> [(1, [('b', 2), ('c', 3)])]
pop([],) -> [("TypeError: unhashable type: 'list'", [('a', 1), ('b', 2), ('c', 3)])]
pop([], 5) -> [("TypeError: unhashable type: 'list'", [('a', 1), ('b', 2), ('c', 3)])]
pop() -> [("TypeError: pop() missing required argument 'key' (pos 1)", [('a', 1), ('b', 2), ('c', 3)])]
pop('a', 1, 2) -> [('TypeError: pop() takes at most 2 arguments (3 given)', [('a', 1), ('b', 2), ('c', 3)])]
pop: keywords -> (1, 7, None)
pop: unknown -> "TypeError: pop() got an unexpected keyword argument 'd'"
setdefault('a',) -> [(1, [('a', 1), ('b', 2), ('c', 3)])]
setdefault('z',) -> [(None, [('a', 1), ('b', 2), ('c', 3), ('z', None)])]
setdefault('z', 5) -> [(5, [('a', 1), ('b', 2), ('c', 3), ('z', 5)])]
setdefault('a', 5) -> [(1, [('a', 1), ('b', 2), ('c', 3)])]
setdefault([],) -> [("TypeError: cannot use 'list' as a dict key (unhashable type: 'list')", [('a', 1), ('b', 2), ('c', 3)])]
setdefault() -> [("TypeError: setdefault() missing required argument 'key' (pos 1)", [('a', 1), ('b', 2), ('c', 3)])]
setdefault('a', 1, 2) -> [('TypeError: setdefault() takes at most 2 arguments (3 given)', [('a', 1), ('b', 2), ('c', 3)])]
setdefault: keywords -> [(7, [('a', 1), ('b', 2), ('c', 3), ('z', 7)])]
clear -> [(None, []), (None, [('q', 1)]), (('q', 1), [])]
clear: an argument -> 'TypeError: OrderedDict.clear() takes no arguments (1 given)'
del what is not there -> [("KeyError: 'z'", [('a', 1), ('b', 2), ('c', 3)]), ("TypeError: unhashable type: 'list'", [('a', 1), ('b', 2), ('c', 3)])]
get, in, len -> (1, None, 5, True, False, 1, 3)
getitem of what is not there -> "KeyError: 'z'"
===== update, and |
update: a dict -> [(None, [('a', 1), ('b', 2), ('c', 9), ('d', 4)])]
update: pairs -> [(None, [('a', 9), ('b', 2), ('c', 3), ('d', 4)])]
update: keywords -> [(None, [('a', 9), ('b', 2), ('c', 3), ('d', 4)])]
update: both -> [(None, [('a', 1), ('b', 2), ('c', 3), ('d', 4), ('e', 5)])]
update: another -> [(None, [('a', 2), ('b', 2), ('c', 3), ('z', 1)])]
update: none -> [(None, [('a', 1), ('b', 2), ('c', 3)])]
update: two -> [('TypeError: update() takes at most 1 positional argument (2 given)', [('a', 1), ('b', 2), ('c', 3)])]
update: an int -> [("TypeError: 'int' object is not iterable", [('a', 1), ('b', 2), ('c', 3)])]
update: None -> [("TypeError: 'NoneType' object is not iterable", [('a', 1), ('b', 2), ('c', 3)])]
update: bad pairs -> [('ValueError: too many values to unpack (expected 2)', [('a', 1), ('b', 2), ('c', 3)])]
update: part way -> [('ValueError: need more than 1 value to unpack', [('a', 1), ('b', 2), ('c', 3), ('x', 1)])]
update: itself -> [(None, [('a', 1), ('b', 2), ('c', 3)])]
update: self by keyword -> [(None, [('a', 1), ('b', 2), ('c', 3), ('self', 1)])]
| {'c': 9, 'd': 4} -> (OrderedDict({'a': 1, 'b': 2, 'c': 9, 'd': 4}), 'OrderedDict')
   the other way -> (OrderedDict({'c': 3, 'd': 4, 'a': 1, 'b': 2}), 'OrderedDict')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 9, 'd': 4}))
   S | -> (S({'a': 1, 'c': 9, 'd': 4}), 'S')
   | S -> (S({'c': 9, 'd': 4, 'a': 1}), 'S')
| OrderedDict({'d': 4, 'a': 9}) -> (OrderedDict({'a': 9, 'b': 2, 'c': 3, 'd': 4}), 'OrderedDict')
   the other way -> (OrderedDict({'d': 4, 'a': 1, 'b': 2, 'c': 3}), 'OrderedDict')
   |= -> (True, OrderedDict({'a': 9, 'b': 2, 'c': 3, 'd': 4}))
   S | -> (S({'a': 9, 'd': 4}), 'S')
   | S -> (OrderedDict({'d': 4, 'a': 1}), 'OrderedDict')
| S({'d': 4}) -> (OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}), 'OrderedDict')
   the other way -> (S({'d': 4, 'a': 1, 'b': 2, 'c': 3}), 'S')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}))
   S | -> (S({'a': 1, 'd': 4}), 'S')
   | S -> (S({'d': 4, 'a': 1}), 'S')
| [('d', 4)] -> "TypeError: unsupported operand type(s) for |: 'collections.OrderedDict' and 'list'"
   the other way -> "TypeError: unsupported operand type(s) for |: 'list' and 'collections.OrderedDict'"
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}))
   S | -> "TypeError: unsupported operand type(s) for |: 'S' and 'list'"
   | S -> "TypeError: unsupported operand type(s) for |: 'list' and 'S'"
| 5 -> "TypeError: unsupported operand type(s) for |: 'collections.OrderedDict' and 'int'"
   the other way -> "TypeError: unsupported operand type(s) for |: 'int' and 'collections.OrderedDict'"
   |= -> "TypeError: 'int' object is not iterable"
   S | -> "TypeError: unsupported operand type(s) for |: 'S' and 'int'"
   | S -> "TypeError: unsupported operand type(s) for |: 'int' and 'S'"
| None -> "TypeError: unsupported operand type(s) for |: 'collections.OrderedDict' and 'NoneType'"
   the other way -> "TypeError: unsupported operand type(s) for |: 'NoneType' and 'collections.OrderedDict'"
   |= -> "TypeError: 'NoneType' object is not iterable"
   S | -> "TypeError: unsupported operand type(s) for |: 'S' and 'NoneType'"
   | S -> "TypeError: unsupported operand type(s) for |: 'NoneType' and 'S'"
| Counter({'d': 2}) -> (OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 2}), 'OrderedDict')
   the other way -> (OrderedDict({'d': 2, 'a': 1, 'b': 2, 'c': 3}), 'OrderedDict')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 2}))
   S | -> (S({'a': 1, 'd': 2}), 'S')
   | S -> (S({'d': 2, 'a': 1}), 'S')
| mappingproxy({'d': 4}) -> (OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}), 'OrderedDict')
   the other way -> (OrderedDict({'d': 4, 'a': 1, 'b': 2, 'c': 3}), 'OrderedDict')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}))
   S | -> (S({'a': 1, 'd': 4}), 'S')
   | S -> (S({'d': 4, 'a': 1}), 'S')
| {'d': 4} -> ({'a': 1, 'b': 2, 'c': 3, 'd': 4}, 'UserDict')
   the other way -> ({'d': 4, 'a': 1, 'b': 2, 'c': 3}, 'UserDict')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3, 'd': 4}))
   S | -> ({'a': 1, 'd': 4}, 'UserDict')
   | S -> ({'d': 4, 'a': 1}, 'UserDict')
| {} -> (OrderedDict({'a': 1, 'b': 2, 'c': 3}), 'OrderedDict')
   the other way -> (OrderedDict({'a': 1, 'b': 2, 'c': 3}), 'OrderedDict')
   |= -> (True, OrderedDict({'a': 1, 'b': 2, 'c': 3}))
   S | -> (S({'a': 1}), 'S')
   | S -> (S({'a': 1}), 'S')
__or__ itself -> "TypeError: descriptor '__or__' requires a 'collections.OrderedDict' object but received a 'dict'"
__or__ of neither -> "TypeError: descriptor '__or__' requires a 'collections.OrderedDict' object but received a 'dict'"
===== copies
copy of OrderedDict() -> (OrderedDict(), 'OrderedDict', True, False)
   copy.copy -> (OrderedDict(), 'OrderedDict')
   deepcopy -> (OrderedDict(), 'OrderedDict')
   reduce -> ('OrderedDict', (), None, None, 'odict_iterator', [])
