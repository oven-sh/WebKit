---- what there is
the module => ('_functools', '', 'BuiltinImporter', 'Tools that operate on functions.', ['Placeholder', '_PlaceholderType', '_lru_cache_wrapper', 'cmp_to_key', 'partial', 'reduce'])
reduce => ('builtin_function_or_method', '($module, function, iterable, /, initial=<unrepresentable>)', 'Apply a function of two arguments cumulatively to the items of an iterable, from left to right.\n\nThis effectively reduces the iterable to a single value.  If initial is\npresent, it is placed before the items of the iterable in the\ncalculation, and serves as a default when the iterable is empty.\n\nFor example, reduce(lambda x, y: x+y, [1, 2, 3, 4, 5])\ncalculates ((((1 + 2) + 3) + 4) + 5).', '_functools', 'reduce')
cmp_to_key => ('builtin_function_or_method', '($module, /, mycmp)', 'Convert a cmp= function into a key= function.\n\n  mycmp\n    Function that compares two objects.', '_functools', 'cmp_to_key')
