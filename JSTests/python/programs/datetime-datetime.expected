hash of a naive one -> (True, True)
hash with an offset -> True
===== what a tzinfo gives
None: utcoffset -> None
None: dst -> None
None: isoformat -> '2000-01-01T12:00:00'
None: str -> '2000-01-01 12:00:00'
None: %z -> ''
None: hash -> True
None: == -> False
None: < -> "TypeError: can't compare offset-naive and offset-aware datetimes"
None: == naive -> True
None: < naive -> True
None: - -> "TypeError: can't subtract offset-naive and offset-aware datetimes"
None: - naive -> datetime.timedelta(seconds=43200)
None: timetuple -> (2000, 1, 1, 12, 0, 0, 5, 1, -1)
None: utctimetuple -> (2000, 1, 1, 12, 0, 0, 5, 1, 0)
None: timestamp -> "TypeError: can't subtract offset-naive and offset-aware datetimes"
None: astimezone -> datetime.datetime(2000, 1, 1, 17, 0, tzinfo=datetime.timezone.utc)
None: fromutc -> 'ValueError: fromutc: non-None utcoffset() result required'
None: now -> 'ValueError: fromutc: non-None utcoffset() result required'
None: fromtimestamp -> 'ValueError: fromutc: non-None utcoffset() result required'
datetime.timedelta(0): utcoffset -> datetime.timedelta(0)
datetime.timedelta(0): dst -> datetime.timedelta(0)
datetime.timedelta(0): isoformat -> '2000-01-01T12:00:00+00:00'
datetime.timedelta(0): str -> '2000-01-01 12:00:00+00:00'
datetime.timedelta(0): %z -> '+0000'
datetime.timedelta(0): hash -> True
datetime.timedelta(0): == -> True
datetime.timedelta(0): < -> False
datetime.timedelta(0): == naive -> False
datetime.timedelta(0): < naive -> "TypeError: can't compare offset-naive and offset-aware datetimes"
datetime.timedelta(0): - -> datetime.timedelta(seconds=43200)
datetime.timedelta(0): - naive -> "TypeError: can't subtract offset-naive and offset-aware datetimes"
datetime.timedelta(0): timetuple -> (2000, 1, 1, 12, 0, 0, 5, 1, 0)
datetime.timedelta(0): utctimetuple -> (2000, 1, 1, 12, 0, 0, 5, 1, 0)
datetime.timedelta(0): timestamp -> 946728000.0
datetime.timedelta(0): astimezone -> datetime.datetime(2000, 1, 1, 12, 0, tzinfo=datetime.timezone.utc)
datetime.timedelta(0): fromutc -> datetime.datetime(2000, 1, 1, 12, 0, tzinfo=Z())
datetime.timedelta(0): now -> 'datetime'
datetime.timedelta(0): fromtimestamp -> datetime.datetime(1970, 1, 1, 0, 0, tzinfo=Z())
datetime.timedelta(seconds=86399, microseconds=999999): utcoffset -> datetime.timedelta(seconds=86399, microseconds=999999)
datetime.timedelta(seconds=86399, microseconds=999999): dst -> datetime.timedelta(seconds=86399, microseconds=999999)
datetime.timedelta(seconds=86399, microseconds=999999): isoformat -> '2000-01-01T12:00:00+23:59:59.999999'
datetime.timedelta(seconds=86399, microseconds=999999): str -> '2000-01-01 12:00:00+23:59:59.999999'
datetime.timedelta(seconds=86399, microseconds=999999): %z -> '+235959.999999'
datetime.timedelta(seconds=86399, microseconds=999999): hash -> True
datetime.timedelta(seconds=86399, microseconds=999999): == -> False
datetime.timedelta(seconds=86399, microseconds=999999): < -> True
