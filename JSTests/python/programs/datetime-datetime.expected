===== a time that comes twice, or not at all
fold 0 and datetime.datetime(2000, 1, 1, 16, 0, tzinfo=datetime.timezone.utc) -> (False, True, False, False, True, datetime.timedelta(0), True)
fold 0 and datetime.datetime(2000, 1, 1, 17, 0, tzinfo=datetime.timezone.utc) -> (False, True, False, True, True, datetime.timedelta(days=-1, seconds=82800), False)
fold 0 and datetime.datetime(2000, 1, 1, 12, 0, tzinfo=Z()) -> (True, False, True, False, True, datetime.timedelta(0), True)
fold 0 and datetime.datetime(2000, 1, 1, 12, 0, fold=1, tzinfo=Z()) -> (True, False, True, False, True, datetime.timedelta(0), True)
fold 0 and datetime.datetime(2000, 1, 1, 12, 0, tzinfo=Z()) -> (False, True, False, False, True, datetime.timedelta(0), True)
fold 0 and datetime.datetime(2000, 1, 1, 12, 0) -> (False, True, False, 'T', 'T', 'T', False)
fold 1 and datetime.datetime(2000, 1, 1, 16, 0, tzinfo=datetime.timezone.utc) -> (False, True, False, False, False, datetime.timedelta(seconds=3600), True)
fold 1 and datetime.datetime(2000, 1, 1, 17, 0, tzinfo=datetime.timezone.utc) -> (False, True, False, False, True, datetime.timedelta(0), False)
fold 1 and datetime.datetime(2000, 1, 1, 12, 0, tzinfo=Z()) -> (True, False, True, False, True, datetime.timedelta(0), True)
fold 1 and datetime.datetime(2000, 1, 1, 12, 0, fold=1, tzinfo=Z()) -> (True, False, True, False, True, datetime.timedelta(0), True)
fold 1 and datetime.datetime(2000, 1, 1, 12, 0, fold=1, tzinfo=Z()) -> (False, True, False, False, True, datetime.timedelta(0), True)
fold 1 and datetime.datetime(2000, 1, 1, 12, 0) -> (False, True, False, 'T', 'T', 'T', False)
