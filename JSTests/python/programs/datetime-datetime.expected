fromisoformat('2024-02-29T01:02:03+00:00') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('2024-02-29T01:02:03-00:00') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('2024-02-29T01:02:03+00:00:00.000000') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('2024-02-29T01:02:03Z') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('2024-02-29T01:02:03 Z') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('20240229T010203Z') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, tzinfo=datetime.timezone.utc), True)
fromisoformat('20240229T010203.5-0500') -> (datetime.datetime(2024, 2, 29, 1, 2, 3, 500000, tzinfo=datetime.timezone(datetime.timedelta(days=-1, seconds=68400))), False)
fromisoformat('2024-02-29T010203') -> (datetime.datetime(2024, 2, 29, 1, 2, 3), False)
fromisoformat('20240229T01:02:03') -> (datetime.datetime(2024, 2, 29, 1, 2, 3), False)
fromisoformat(None) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat(5) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat(b'2024-01-01') -> 'TypeError: fromisoformat: argument must be str'
fromisoformat([]) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat('2024-01-01T01') -> datetime.datetime(2024, 1, 1, 1, 0)
===== combine
combine(datetime.date(2000, 1, 2), datetime.time(3, 4)) -> datetime.datetime(2000, 1, 2, 3, 4)
combine(datetime.date(2000, 1, 2), datetime.time(3, 4, tzinfo=datetime.timezone.utc)) -> datetime.datetime(2000, 1, 2, 3, 4, tzinfo=datetime.timezone.utc)
combine(datetime.date(2000, 1, 2), datetime.time(3, 4, tzinfo=datetime.timezone.utc), None) -> datetime.datetime(2000, 1, 2, 3, 4)
combine(datetime.date(2000, 1, 2), datetime.time(3, 4), datetime.timezone.utc) -> datetime.datetime(2000, 1, 2, 3, 4, tzinfo=datetime.timezone.utc)
combine(datetime.date(2000, 1, 2), datetime.time(3, 4, fold=1)) -> datetime.datetime(2000, 1, 2, 3, 4, fold=1)
combine(datetime.datetime(2000, 1, 2, 9, 0, tzinfo=datetime.timezone.utc), datetime.time(3, 4)) -> datetime.datetime(2000, 1, 2, 3, 4)
combine(datetime.date(2000, 1, 2), datetime.time(3, 4), 5) -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
combine(datetime.date(2000, 1, 2), datetime.datetime(2000, 1, 1, 0, 0)) -> 'TypeError: combine() argument 2 must be datetime.time, not datetime.datetime'
combine(datetime.date(2000, 1, 2), 5) -> 'TypeError: combine() argument 2 must be datetime.time, not int'
combine(5, datetime.time(0, 0)) -> 'TypeError: combine() argument 1 must be datetime.date, not int'
combine(None, None) -> 'TypeError: combine() argument 1 must be datetime.date, not None'
combine(datetime.time(0, 0), datetime.date(1, 1, 1)) -> 'TypeError: combine() argument 1 must be datetime.date, not datetime.time'
combine(datetime.date(2000, 1, 2),) -> "TypeError: combine() missing required argument 'time' (pos 2)"
combine() -> "TypeError: combine() missing required argument 'date' (pos 1)"
combine(datetime.date(1, 1, 1), datetime.time(0, 0), None, 1) -> 'TypeError: combine() takes at most 3 arguments (4 given)'
combine('x', 'y') -> 'TypeError: combine() argument 1 must be datetime.date, not str'
combine: keywords -> datetime.datetime(1, 1, 1, 1, 0, tzinfo=datetime.timezone.utc)
combine: unknown -> "TypeError: combine() got an unexpected keyword argument 'tz'"
===== strptime
strptime('2024-02-29 01:02:03', '%Y-%m-%d %H:%M:%S') -> datetime.datetime(2024, 2, 29, 1, 2, 3)
strptime('2024-02-29 01:02:03.5', '%Y-%m-%d %H:%M:%S.%f') -> datetime.datetime(2024, 2, 29, 1, 2, 3, 500000)
strptime('2024 +0130', '%Y %z') -> datetime.datetime(2024, 1, 1, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=5400)))
strptime('2024 Z', '%Y %z') -> datetime.datetime(2024, 1, 1, 0, 0, tzinfo=datetime.timezone.utc)
strptime('2024 UTC', '%Y %Z') -> datetime.datetime(2024, 1, 1, 0, 0)
strptime('2024 -01:30:15.5', '%Y %z') -> datetime.datetime(2024, 1, 1, 0, 0, tzinfo=datetime.timezone(datetime.timedelta(days=-1, seconds=80984, microseconds=500000)))
strptime('2023-02-29', '%Y-%m-%d') -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
strptime('x', '%Y') -> "ValueError: time data 'x' does not match format '%Y'"
strptime('2024x', '%Y') -> 'ValueError: unconverted data remains: x'
strptime('', '') -> datetime.datetime(1900, 1, 1, 0, 0)
strptime(5, '%Y') -> 'TypeError: strptime() argument 1 must be str, not int'
strptime('1', None) -> 'TypeError: strptime() argument 2 must be str, not None'
strptime('24', '%y') -> datetime.datetime(2024, 1, 1, 0, 0)
strptime('2024 60', '%Y %j') -> datetime.datetime(2024, 2, 29, 0, 0)
strptime('2024 09 4', '%G %V %u') -> datetime.datetime(2024, 2, 29, 0, 0)
===== of a derived class
D fromisoformat -> ('D', 'no extra', 0)
DN fromisoformat -> ('DN', [], 0)
DX fromisoformat -> ('DX', 'no extra', 0)
D combine -> ('D', 'no extra', 0)
DN combine -> ('DN', [], 0)
DX combine -> ('DX', 'no extra', 0)
D combine with a fold -> ('D', 'no extra', 1)
DN combine with a fold -> ('DN', ['fold'], 1)
DX combine with a fold -> ('DX', 'no extra', 1)
D fromtimestamp -> ('D', 'no extra', 0)
DN fromtimestamp -> ('DN', [], 0)
DX fromtimestamp -> ('DX', 'no extra', 0)
D fromtimestamp in a zone -> ('D', 'no extra', 0)
DN fromtimestamp in a zone -> ('DN', [], 0)
DX fromtimestamp in a zone -> ('str', 'no extra', None)
D fromtimestamp in a fold -> ('D', 'no extra', 1)
DN fromtimestamp in a fold -> ('DN', ['fold'], 1)
DX fromtimestamp in a fold -> ('DX', 'no extra', 1)
D now -> ('D', 'no extra', 0)
DN now -> ('DN', [], 0)
DX now -> ('DX', 'no extra', 0)
D now in a zone -> ('D', 'no extra', 0)
DN now in a zone -> ('DN', [], 0)
DX now in a zone -> ('str', 'no extra', None)
D today -> ('D', 'no extra', 0)
DN today -> ('DN', [], 0)
DX today -> ('DX', 'no extra', 0)
D fromordinal -> ('D', 'no extra', 0)
DN fromordinal -> ('DN', [], 0)
DX fromordinal -> ('DX', 'no extra', 0)
D fromisocalendar -> ('D', 'no extra', 0)
DN fromisocalendar -> ('DN', [], 0)
DX fromisocalendar -> ('DX', 'no extra', 0)
D strptime -> ('D', 'no extra', 0)
DN strptime -> ('DN', [], 0)
DX strptime -> ('DX', 'no extra', 0)
D replace -> ('D', 'no extra', 0)
DN replace -> ('DN', [], 0)
DX replace -> ('str', 'no extra', None)
D replace fold -> ('D', 'no extra', 1)
DN replace fold -> ('DN', ['fold'], 1)
DX replace fold -> ('str', 'no extra', None)
D + -> ('D', 'no extra', 0)
DN + -> ('DN', [], 0)
DX + -> ('str', 'no extra', None)
D r+ -> ('D', 'no extra', 0)
DN r+ -> ('DN', [], 0)
DX r+ -> ('str', 'no extra', None)
D - -> ('D', 'no extra', 0)
DN - -> ('DN', [], 0)
DX - -> ('str', 'no extra', None)
D + with a fold -> ('D', 'no extra', 0)
DN + with a fold -> ('DN', [], 0)
DX + with a fold -> ('str', 'no extra', None)
D astimezone -> ('D', 'no extra', 0)
DN astimezone -> ('DN', [], 0)
D astimezone, naive -> ('D', 'no extra', 0)
DN astimezone, naive -> ('DN', [], 0)
D astimezone to the same -> ('D', 'no extra', 0)
DN astimezone to the same -> ('DN', ['tzinfo'], 0)
DX astimezone to the same -> ('DX', 'no extra', 0)
D utctimetuple -> ('struct_time', 'no extra', None)
DN utctimetuple -> ('struct_time', 'no extra', None)
D date -> ('date', 'no extra', None)
DN date -> ('date', 'no extra', None)
DX date -> ('date', 'no extra', None)
D fromutc -> ('D', 'no extra', 0)
DN fromutc -> ('DN', [], 0)
DX fromutc -> ('str', 'no extra', None)
D fromutc of tzinfo -> ('D', 'no extra', 0)
DN fromutc of tzinfo -> ('DN', [], 0)
===== replace
replace([]) -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('year', 2020)]) -> datetime.datetime(2020, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2020, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('year', 2023)]) -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
   __replace__ -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
replace([('month', 3)]) -> datetime.datetime(2024, 3, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 3, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('day', 30)]) -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2024'
   __replace__ -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2024'
replace([('hour', 5)]) -> datetime.datetime(2024, 2, 29, 5, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 2, 29, 5, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('hour', 24)]) -> 'ValueError: hour must be in 0..23, not 24'
   __replace__ -> 'ValueError: hour must be in 0..23, not 24'
replace([('minute', 60)]) -> 'ValueError: minute must be in 0..59, not 60'
   __replace__ -> 'ValueError: minute must be in 0..59, not 60'
replace([('second', -1)]) -> 'ValueError: second must be in 0..59, not -1'
   __replace__ -> 'ValueError: second must be in 0..59, not -1'
replace([('microsecond', 1000000)]) -> 'ValueError: microsecond must be in 0..999999, not 1000000'
   __replace__ -> 'ValueError: microsecond must be in 0..999999, not 1000000'
replace([('tzinfo', None)]) -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1)
   __replace__ -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1)
replace([('tzinfo', 5)]) -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
   __replace__ -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
replace([('fold', 0)]) -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, tzinfo=datetime.timezone.utc)
replace([('fold', 2)]) -> 'ValueError: fold must be either 0 or 1, not 2'
   __replace__ -> 'ValueError: fold must be either 0 or 1, not 2'
replace([('year', 2147483648)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
replace([('year', None)]) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
replace([('year', 1.0)]) -> "TypeError: 'float' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'float' object cannot be interpreted as an integer"
replace([('hour', True)]) -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 2, 29, 1, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('hour', Index())]) -> datetime.datetime(2024, 2, 29, 3, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.datetime(2024, 2, 29, 3, 2, 3, 4, fold=1, tzinfo=datetime.timezone.utc)
replace([('days', 1)]) -> "TypeError: replace() got an unexpected keyword argument 'days'. Did you mean 'day'?"
   __replace__ -> "TypeError: replace() got an unexpected keyword argument 'days'. Did you mean 'day'?"
replace([('year', 1000000000000000000000000000000)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
positional -> datetime.datetime(2020, 1, 2, 3, 4, 5, 6, fold=1)
fold by position -> 'TypeError: replace() takes at most 8 positional arguments (9 given)'
===== arithmetic
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(0) -> (datetime.datetime(1, 1, 1, 0, 0), 'datetime')
   the other way -> (datetime.datetime(1, 1, 1, 0, 0), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(0) -> (datetime.datetime(1, 1, 1, 0, 0), 'datetime')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=1) -> (datetime.datetime(1, 1, 2, 0, 0), 'datetime')
   the other way -> (datetime.datetime(1, 1, 2, 0, 0), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=1) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=-1) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=-1) -> (datetime.datetime(1, 1, 2, 0, 0), 'datetime')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(seconds=1) -> (datetime.datetime(1, 1, 1, 0, 0, 1), 'datetime')
   the other way -> (datetime.datetime(1, 1, 1, 0, 0, 1), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(seconds=1) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(microseconds=1) -> (datetime.datetime(1, 1, 1, 0, 0, 0, 1), 'datetime')
   the other way -> (datetime.datetime(1, 1, 1, 0, 0, 0, 1), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(microseconds=1) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=-1, seconds=86399) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=-1, seconds=86399) -> (datetime.datetime(1, 1, 1, 0, 0, 1), 'datetime')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=-1, seconds=86399, microseconds=999999) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=-1, seconds=86399, microseconds=999999) -> (datetime.datetime(1, 1, 1, 0, 0, 0, 1), 'datetime')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(seconds=86399, microseconds=999999) -> (datetime.datetime(1, 1, 1, 23, 59, 59, 999999), 'datetime')
   the other way -> (datetime.datetime(1, 1, 1, 23, 59, 59, 999999), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(seconds=86399, microseconds=999999) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=365, seconds=3661, microseconds=7) -> (datetime.datetime(2, 1, 1, 1, 1, 1, 7), 'datetime')
   the other way -> (datetime.datetime(2, 1, 1, 1, 1, 1, 7), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=365, seconds=3661, microseconds=7) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=3652058) -> (datetime.datetime(9999, 12, 31, 0, 0), 'datetime')
   the other way -> (datetime.datetime(9999, 12, 31, 0, 0), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=3652058) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=-3652058) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=-3652058) -> (datetime.datetime(9999, 12, 31, 0, 0), 'datetime')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=3652058, seconds=86399, microseconds=999999) -> (datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), 'datetime')
   the other way -> (datetime.datetime(9999, 12, 31, 23, 59, 59, 999999), 'datetime')
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=3652058, seconds=86399, microseconds=999999) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=3652059) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=3652059) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=999999999, seconds=86399, microseconds=999999) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=999999999, seconds=86399, microseconds=999999) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.timedelta(days=-999999999) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.datetime(1, 1, 1, 0, 0) - datetime.timedelta(days=-999999999) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + 0 -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'int'"
   the other way -> "TypeError: unsupported operand type(s) for +: 'int' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) - 0 -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'int'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'int' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + 1.5 -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'float'"
   the other way -> "TypeError: unsupported operand type(s) for +: 'float' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) - 1.5 -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'float'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'float' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + None -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'NoneType'"
   the other way -> "TypeError: unsupported operand type(s) for +: 'NoneType' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) - None -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'NoneType'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'NoneType' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + 'a' -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'str'"
   the other way -> 'TypeError: can only concatenate str (not "datetime.datetime") to str'
datetime.datetime(1, 1, 1, 0, 0) - 'a' -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'str'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'str' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.date(2000, 1, 1) -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'datetime.date'"
   the other way -> "TypeError: unsupported operand type(s) for +: 'datetime.date' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) - datetime.date(2000, 1, 1) -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'datetime.date'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.date' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) + datetime.time(1, 0) -> "TypeError: unsupported operand type(s) for +: 'datetime.datetime' and 'datetime.time'"
   the other way -> "TypeError: unsupported operand type(s) for +: 'datetime.time' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0) - datetime.time(1, 0) -> "TypeError: unsupported operand type(s) for -: 'datetime.datetime' and 'datetime.time'"
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.time' and 'datetime.datetime'"
datetime.datetime(1, 1, 1, 0, 0, 0, 1) + datetime.timedelta(0) -> (datetime.datetime(1, 1, 1, 0, 0, 0, 1), 'datetime')
