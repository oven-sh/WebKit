a bad one and too many by position -> "TypeError: 'str' object cannot be interpreted as an integer"
a bad one and too many -> 'TypeError: function takes at most 9 arguments (10 given)'
a bad one and an unknown -> "TypeError: 'str' object cannot be interpreted as an integer"
a bad date and a bad time -> 'ValueError: month must be in 1..12, not 13'
a bad time and a bad tzinfo -> 'ValueError: hour must be in 0..23, not 24'
missing by keyword -> "TypeError: function missing required argument 'year' (pos 1)"
30 February -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2000'
29 February -> (datetime.datetime(2000, 2, 29, 0, 0), datetime.datetime(2004, 2, 29, 0, 0))
===== what pickle calls it with
state b'\x07\xd0\x01\x02\x03\x04\x05\x00\x00\x06' -> (2000, 1, 2, 3, 4, 5, 6, 0, None, 'datetime.datetime(2000, 1, 2, 3, 4, 5, 6)')
   with None -> (2000, 0, True)
   with datetime.timezone.utc -> (2000, 0, True)
   with 5 -> 'TypeError: bad tzinfo state arg'
   with Z() -> (2000, 0, True)
