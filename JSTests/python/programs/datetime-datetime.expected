fromutc(2000-01-01T18:00) with (datetime.timedelta(seconds=82800), datetime.timedelta(days=-1, seconds=3600)) -> datetime.datetime(2000, 1, 2, 17, 0)
fromutc(0001-01-01T00:00) with (datetime.timedelta(seconds=82800), datetime.timedelta(days=-1, seconds=3600)) -> datetime.datetime(1, 1, 1, 23, 0)
fromutc(9999-12-31T23:00) with (datetime.timedelta(seconds=82800), datetime.timedelta(days=-1, seconds=3600)) -> 'OverflowError: date value out of range'
fromutc(datetime.datetime(2000, 1, 1, 0, 0)) -> 'ValueError: fromutc: dt.tzinfo is not self'
fromutc(datetime.datetime(2000, 1, 1, 0, 0, tzinfo=datetime.timezone.utc)) -> 'ValueError: fromutc: dt.tzinfo is not self'
fromutc(datetime.date(2000, 1, 1)) -> 'TypeError: fromutc: argument must be a datetime'
fromutc(None) -> 'TypeError: fromutc: argument must be a datetime'
fromutc(5) -> 'TypeError: fromutc: argument must be a datetime'
done
