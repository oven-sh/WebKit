none -> datetime.timedelta(0)
positional -> datetime.timedelta(days=50, seconds=21902, microseconds=4003)
too many -> 'TypeError: __new__() takes at most 7 arguments (8 given)'
unknown keyword -> "TypeError: __new__() got an unexpected keyword argument 'years'"
twice -> "TypeError: argument for __new__() given by name ('days') and position (1)"
keyword that is near -> "TypeError: __new__() got an unexpected keyword argument 'day'. Did you mean 'days'?"
the same one for nothing -> (True, True, False, False, True)
halves (0.5, 0.5) -> datetime.timedelta(microseconds=1)
   and seconds -> datetime.timedelta(microseconds=1)
halves (1.5, 0.5) -> datetime.timedelta(microseconds=2)
   and seconds -> datetime.timedelta(microseconds=2)
halves (0.25, 0.25) -> datetime.timedelta(0)
   and seconds -> datetime.timedelta(0)
halves (2.5, 0) -> datetime.timedelta(microseconds=2)
   and seconds -> datetime.timedelta(microseconds=2)
halves (3.5, 0) -> datetime.timedelta(microseconds=4)
   and seconds -> datetime.timedelta(microseconds=4)
halves (-0.5, 0) -> datetime.timedelta(0)
   and seconds -> datetime.timedelta(0)
halves (-1.5, 0) -> datetime.timedelta(days=-1, seconds=86399, microseconds=999998)
   and seconds -> datetime.timedelta(days=-1, seconds=86399, microseconds=999998)
halves (0.5, 1) -> datetime.timedelta(microseconds=2)
   and seconds -> datetime.timedelta(microseconds=2)
halves (0.5, 2) -> datetime.timedelta(microseconds=2)
   and seconds -> datetime.timedelta(microseconds=2)
halves (1e-06, 1e-06) -> datetime.timedelta(0)
   and seconds -> datetime.timedelta(0)
halves (0.4, 0.1) -> datetime.timedelta(0)
   and seconds -> datetime.timedelta(0)
halves (0.3, 0.2) -> datetime.timedelta(0)
   and seconds -> datetime.timedelta(0)
