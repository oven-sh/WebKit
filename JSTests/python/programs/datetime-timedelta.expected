together [('days', 1.5), ('hours', 1.5), ('microseconds', 1.5), ('milliseconds', 1.5), ('minutes', 1.5), ('seconds', 1.5), ('weeks', 1.5)] -> 'datetime.timedelta(days=12, seconds=5491, microseconds=501502)'
together [('days', 0.1), ('hours', 0.1), ('microseconds', 0.1), ('milliseconds', 0.1), ('minutes', 0.1), ('seconds', 0.1), ('weeks', 0.1)] -> 'datetime.timedelta(seconds=69486, microseconds=100100)'
together [('days', -0.1), ('hours', 0.1), ('minutes', -0.1), ('seconds', 0.1)] -> 'datetime.timedelta(days=-1, seconds=78114, microseconds=100000)'
together [('days', 999999999), ('hours', 23), ('microseconds', 999999), ('minutes', 59), ('seconds', 59)] -> 'datetime.timedelta(days=999999999, seconds=86399, microseconds=999999)'
