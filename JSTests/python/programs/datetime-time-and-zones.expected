===== shown
datetime.time(0, 0) -> ('00:00:00', '00:00:00', 0, 0, 0, 0, 0, True, '00:00:00', True, None, None, None)
   timespec -> ['00:00:00', '00', '00:00', '00:00:00', '00:00:00.000', '00:00:00.000000']
   strftime -> '00:00:00.000000||||1900-01-01|001|Mon|AM|12|%'
   reduce -> (b'\x00\x00\x00\x00\x00\x00', 1, [b'\x00\x00\x00\x00\x00\x00', b'\x00\x00\x00\x00\x00\x00', b'\x00\x00\x00\x00\x00\x00', b'\x00\x00\x00\x00\x00\x00', b'\x00\x00\x00\x00\x00\x00', b'\x00\x00\x00\x00\x00\x00'])
   pickle -> [(True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True)]
   copy -> (True, True, False, datetime.time(5, 0))
   and back -> True
datetime.time(1, 0) -> ('01:00:00', '01:00:00', 1, 0, 0, 0, 0, True, '01:00:00', True, None, None, None)
   timespec -> ['01:00:00', '01', '01:00', '01:00:00', '01:00:00.000', '01:00:00.000000']
   strftime -> '01:00:00.000000||||1900-01-01|001|Mon|AM|01|%'
   reduce -> (b'\x01\x00\x00\x00\x00\x00', 1, [b'\x01\x00\x00\x00\x00\x00', b'\x01\x00\x00\x00\x00\x00', b'\x01\x00\x00\x00\x00\x00', b'\x01\x00\x00\x00\x00\x00', b'\x01\x00\x00\x00\x00\x00', b'\x01\x00\x00\x00\x00\x00'])
   pickle -> [(True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True), (True, True, 0, True)]
   copy -> (True, True, False, datetime.time(5, 0))
   and back -> True
datetime.time(1, 2) -> ('01:02:00', '01:02:00', 1, 2, 0, 0, 0, True, '01:02:00', True, None, None, None)
   timespec -> ['01:02:00', '01', '01:02', '01:02:00', '01:02:00.000', '01:02:00.000000']
   strftime -> '01:02:00.000000||||1900-01-01|001|Mon|AM|01|%'
