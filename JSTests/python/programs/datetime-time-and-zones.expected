===== replace
replace([]) -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('hour', 5)]) -> datetime.time(5, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(5, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('minute', 5)]) -> datetime.time(1, 5, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 5, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('second', 5)]) -> datetime.time(1, 2, 5, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 2, 5, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('microsecond', 5)]) -> datetime.time(1, 2, 3, 5, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 2, 3, 5, tzinfo=datetime.timezone.utc, fold=1)
replace([('tzinfo', None)]) -> datetime.time(1, 2, 3, 4, fold=1)
   __replace__ -> datetime.time(1, 2, 3, 4, fold=1)
replace([('tzinfo', datetime.timezone(datetime.timedelta(seconds=3600)))]) -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)), fold=1)
   __replace__ -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)), fold=1)
replace([('fold', 0)]) -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc)
   __replace__ -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc)
replace([('fold', 2)]) -> 'ValueError: fold must be either 0 or 1, not 2'
   __replace__ -> 'ValueError: fold must be either 0 or 1, not 2'
replace([('hour', 24)]) -> 'ValueError: hour must be in 0..23, not 24'
   __replace__ -> 'ValueError: hour must be in 0..23, not 24'
replace([('hour', -1)]) -> 'ValueError: hour must be in 0..23, not -1'
   __replace__ -> 'ValueError: hour must be in 0..23, not -1'
replace([('hour', 2147483648)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
replace([('hour', 1000000000000000000000000000000)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
replace([('hour', None)]) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
replace([('hour', 1.0)]) -> "TypeError: 'float' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'float' object cannot be interpreted as an integer"
replace([('hour', '1')]) -> "TypeError: 'str' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'str' object cannot be interpreted as an integer"
replace([('hour', True)]) -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('hour', Index())]) -> datetime.time(3, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(3, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
replace([('tzinfo', 5)]) -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
   __replace__ -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
replace([('fold', None)]) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
replace([('year', 1)]) -> "TypeError: replace() got an unexpected keyword argument 'year'"
   __replace__ -> "TypeError: replace() got an unexpected keyword argument 'year'"
replace([('fold', True)]) -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
   __replace__ -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc, fold=1)
positional -> datetime.time(5, 6, 7, 8, fold=1)
fold by position -> 'TypeError: replace() takes at most 5 positional arguments (6 given)'
twice -> "TypeError: argument for replace() given by name ('hour') and position (1)"
