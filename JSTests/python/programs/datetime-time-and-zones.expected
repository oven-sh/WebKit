fromisoformat('1e1') -> "ValueError: Invalid isoformat string: '1e1'"
fromisoformat('+1') -> "ValueError: Invalid isoformat string: '+1'"
fromisoformat('-1') -> "ValueError: Invalid isoformat string: '-1'"
fromisoformat('0x') -> "ValueError: Invalid isoformat string: '0x'"
fromisoformat('T24:00') -> (datetime.time(0, 0), False)
fromisoformat('T0102Z') -> (datetime.time(1, 2, tzinfo=datetime.timezone.utc), True)
fromisoformat('T01:02:03.5+01:00') -> (datetime.time(1, 2, 3, 500000, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600))), False)
fromisoformat(None) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat(5) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat(b'01') -> 'TypeError: fromisoformat: argument must be str'
fromisoformat([]) -> 'TypeError: fromisoformat: argument must be str'
fromisoformat('01:02') -> datetime.time(1, 2)
none -> 'TypeError: time.fromisoformat() takes exactly one argument (0 given)'
strptime('01:02:03', '%H:%M:%S') -> datetime.time(1, 2, 3)
strptime('1', '%H') -> datetime.time(1, 0)
strptime('25', '%H') -> 'ValueError: unconverted data remains: 5'
strptime('01 +0100', '%H %z') -> datetime.time(1, 0, tzinfo=datetime.timezone(datetime.timedelta(seconds=3600)))
strptime('2024 01', '%Y %H') -> datetime.time(1, 0)
strptime('', '') -> datetime.time(0, 0)
strptime(5, '%H') -> 'TypeError: strptime() argument 1 must be str, not int'
strptime('1', None) -> 'TypeError: strptime() argument 2 must be str, not None'
