tzinfo None -> True
tzinfo datetime.timezone.utc -> True
tzinfo datetime.timezone(datetime.timedelta(seconds=3600)) -> True
tzinfo Z(None, None, None) -> True
tzinfo 5 -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
tzinfo 'UTC' -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'str'"
tzinfo datetime.timedelta(0) -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'datetime.timedelta'"
tzinfo <datetime.tzinfo object at 0x> -> True
tzinfo <class 'datetime.tzinfo'> -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'type'"
tzinfo <class 'datetime.timezone'> -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'type'"
tzinfo <object object at 0x> -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'object'"
tzinfo False -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'bool'"
tzinfo 0 -> "TypeError: tzinfo argument must be None or of a tzinfo subclass, not type 'int'"
none -> datetime.time(0, 0)
positional -> datetime.time(1, 2, 3, 4, tzinfo=datetime.timezone.utc)
fold by position -> 'TypeError: function takes at most 5 positional arguments (6 given)'
seven -> 'TypeError: function takes at most 6 arguments (7 given)'
unknown -> "TypeError: this function got an unexpected keyword argument 'hours'. Did you mean 'hour'?"
twice -> "TypeError: argument for function given by name ('hour') and position (1)"
a bad one and too many -> "TypeError: 'str' object cannot be interpreted as an integer"
a bad one and an unknown -> "TypeError: 'str' object cannot be interpreted as an integer"
bad fold and an unknown -> "TypeError: 'str' object cannot be interpreted as an integer"
out of range, and a bad tzinfo -> 'ValueError: hour must be in 0..23, not 24'
bad fold value and a bad tzinfo -> 'ValueError: fold must be either 0 or 1, not 2'
too many with keywords -> 'TypeError: function takes at most 6 arguments (7 given)'
===== what pickle calls it with
state b'\x01\x02\x03\x04\x05\x06' -> (1, 2, 3, 263430, 0, None, 'datetime.time(1, 2, 3, 263430)')
   with None -> (1, 0, True)
   with datetime.timezone.utc -> (1, 0, True)
   with 5 -> 'TypeError: bad tzinfo state arg'
   with 'x' -> 'TypeError: bad tzinfo state arg'
   with Z(None, None, None) -> (1, 0, True)
   with three -> "TypeError: 'bytes' object cannot be interpreted as an integer"
   and a keyword -> datetime.time(1, 2, 3, 263430)
   of a derived class -> 'T'
