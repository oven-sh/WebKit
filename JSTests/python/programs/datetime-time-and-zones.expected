===== making one
hour 0 -> datetime.time(0, 0)
minute 0 -> datetime.time(0, 0)
second 0 -> datetime.time(0, 0)
microsecond 0 -> datetime.time(0, 0)
fold 0 -> datetime.time(0, 0)
hour 1 -> datetime.time(1, 0)
minute 1 -> datetime.time(0, 1)
second 1 -> datetime.time(0, 0, 1)
microsecond 1 -> datetime.time(0, 0, 0, 1)
fold 1 -> datetime.time(0, 0, fold=1)
hour -1 -> 'ValueError: hour must be in 0..23, not -1'
minute -1 -> 'ValueError: minute must be in 0..59, not -1'
second -1 -> 'ValueError: second must be in 0..59, not -1'
microsecond -1 -> 'ValueError: microsecond must be in 0..999999, not -1'
fold -1 -> 'ValueError: fold must be either 0 or 1, not -1'
hour 23 -> datetime.time(23, 0)
minute 23 -> datetime.time(0, 23)
second 23 -> datetime.time(0, 0, 23)
microsecond 23 -> datetime.time(0, 0, 0, 23)
fold 23 -> 'ValueError: fold must be either 0 or 1, not 23'
hour 24 -> 'ValueError: hour must be in 0..23, not 24'
minute 24 -> datetime.time(0, 24)
second 24 -> datetime.time(0, 0, 24)
microsecond 24 -> datetime.time(0, 0, 0, 24)
fold 24 -> 'ValueError: fold must be either 0 or 1, not 24'
