fromtimestamp(1j) -> "TypeError: 'complex' object cannot be interpreted as an integer"
fromtimestamp: none -> 'TypeError: date.fromtimestamp() takes exactly one argument (0 given)'
fromtimestamp: two -> 'TypeError: date.fromtimestamp() takes exactly one argument (2 given)'
fromtimestamp: keyword -> 'TypeError: date.fromtimestamp() takes no keyword arguments'
today -> ('date', True, 'D')
today: an argument -> 'TypeError: date.today() takes no arguments (1 given)'
strptime('2024-02-29', '%Y-%m-%d') -> datetime.date(2024, 2, 29)
strptime('29/02/24', '%d/%m/%y') -> datetime.date(2024, 2, 29)
strptime('2024-02-30', '%Y-%m-%d') -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2024'
strptime('2024', '%Y') -> datetime.date(2024, 1, 1)
strptime('x', '%Y') -> "ValueError: time data 'x' does not match format '%Y'"
strptime('2024-02-29 12', '%Y-%m-%d %H') -> datetime.date(2024, 2, 29)
strptime('', '') -> datetime.date(1900, 1, 1)
strptime(5, '%Y') -> 'TypeError: strptime() argument 1 must be str, not int'
strptime('2024', 5) -> 'TypeError: strptime() argument 2 must be str, not int'
strptime(None, None) -> 'TypeError: strptime() argument 1 must be str, not None'
strptime(b'2024', '%Y') -> 'TypeError: strptime() argument 1 must be str, not bytes'
strptime: one -> 'TypeError: strptime() takes exactly 2 arguments (1 given)'
strptime: three -> 'TypeError: strptime() takes exactly 2 arguments (3 given)'
strptime: keyword -> 'TypeError: strptime() takes no keyword arguments'
===== of a derived class
D fromordinal -> ('D', 'no extra')
DN fromordinal -> ('DN', None)
DX fromordinal -> ('str', 'no extra')
D fromisoformat -> ('D', 'no extra')
DN fromisoformat -> ('DN', None)
DX fromisoformat -> ('str', 'no extra')
D fromisocalendar -> ('D', 'no extra')
DN fromisocalendar -> ('DN', None)
DX fromisocalendar -> ('str', 'no extra')
D fromtimestamp -> ('D', 'no extra')
DN fromtimestamp -> ('DN', None)
DX fromtimestamp -> ('str', 'no extra')
D today -> ('D', 'no extra')
DN today -> ('DN', None)
DX today -> ('str', 'no extra')
D replace -> ('D', 'no extra')
DN replace -> ('DN', None)
DX replace -> 'TypeError: replace() takes at least 2 positional arguments (0 given)'
D + -> ('D', 'no extra')
DN + -> ('DN', None)
DX + -> 'TypeError: can only concatenate str (not "datetime.timedelta") to str'
D - -> ('D', 'no extra')
DN - -> ('DN', None)
DX - -> "TypeError: unsupported operand type(s) for -: 'str' and 'datetime.timedelta'"
D r+ -> ('D', 'no extra')
DN r+ -> ('DN', None)
DX r+ -> "TypeError: unsupported operand type(s) for +: 'datetime.timedelta' and 'str'"
D - a date -> ('timedelta', 'no extra')
DN - a date -> ('timedelta', 'no extra')
DX - a date -> "TypeError: unsupported operand type(s) for -: 'str' and 'datetime.date'"
D strptime -> ('D', 'no extra')
DN strptime -> ('DN', None)
DX strptime -> ('str', 'no extra')
D copy.replace -> ('D', 'no extra')
DN copy.replace -> ('DN', None)
DX copy.replace -> 'TypeError: replace() does not support str objects'
===== replace
replace([]) -> datetime.date(2024, 2, 29)
   __replace__ -> datetime.date(2024, 2, 29)
replace([('year', 2020)]) -> datetime.date(2020, 2, 29)
   __replace__ -> datetime.date(2020, 2, 29)
replace([('year', 2023)]) -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
   __replace__ -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
replace([('month', 3)]) -> datetime.date(2024, 3, 29)
   __replace__ -> datetime.date(2024, 3, 29)
replace([('day', 1)]) -> datetime.date(2024, 2, 1)
   __replace__ -> datetime.date(2024, 2, 1)
replace([('day', 30)]) -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2024'
   __replace__ -> 'ValueError: day 30 must be in range 1..29 for month 2 in year 2024'
replace([('year', 0)]) -> 'ValueError: year must be in 1..9999, not 0'
   __replace__ -> 'ValueError: year must be in 1..9999, not 0'
replace([('year', 10000)]) -> 'ValueError: year must be in 1..9999, not 10000'
   __replace__ -> 'ValueError: year must be in 1..9999, not 10000'
replace([('month', 13)]) -> 'ValueError: month must be in 1..12, not 13'
   __replace__ -> 'ValueError: month must be in 1..12, not 13'
replace([('year', 2147483648)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
replace([('year', 1000000000000000000000000000000)]) -> 'OverflowError: Python int too large to convert to C int'
   __replace__ -> 'OverflowError: Python int too large to convert to C int'
replace([('year', None)]) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
replace([('year', 1.0)]) -> "TypeError: 'float' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'float' object cannot be interpreted as an integer"
replace([('year', '1')]) -> "TypeError: 'str' object cannot be interpreted as an integer"
   __replace__ -> "TypeError: 'str' object cannot be interpreted as an integer"
replace([('year', True)]) -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 1'
   __replace__ -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 1'
replace([('year', Index())]) -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 3'
   __replace__ -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 3'
replace([('hour', 1)]) -> "TypeError: replace() got an unexpected keyword argument 'hour'"
   __replace__ -> "TypeError: replace() got an unexpected keyword argument 'hour'"
replace([('day', 1), ('month', 1), ('year', 2020)]) -> datetime.date(2020, 1, 1)
   __replace__ -> datetime.date(2020, 1, 1)
replace([('days', 1)]) -> "TypeError: replace() got an unexpected keyword argument 'days'. Did you mean 'day'?"
   __replace__ -> "TypeError: replace() got an unexpected keyword argument 'days'. Did you mean 'day'?"
positional -> datetime.date(2020, 1, 1)
too many -> 'TypeError: replace() takes at most 3 arguments (4 given)'
twice -> "TypeError: argument for replace() given by name ('year') and position (1)"
__replace__: positional -> datetime.date(2020, 1, 1)
__replace__: too many -> 'TypeError: replace() takes at most 3 arguments (4 given)'
===== arithmetic
datetime.date(1, 1, 1) + datetime.timedelta(0) -> (datetime.date(1, 1, 1), 'date')
   the other way -> (datetime.date(1, 1, 1), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(0) -> (datetime.date(1, 1, 1), 'date')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(0) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=1) -> (datetime.date(1, 1, 2), 'date')
   the other way -> (datetime.date(1, 1, 2), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(days=1) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=1) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=-1) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.date(1, 1, 1) - datetime.timedelta(days=-1) -> (datetime.date(1, 1, 2), 'date')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=-1) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(seconds=86399) -> (datetime.date(1, 1, 1), 'date')
   the other way -> (datetime.date(1, 1, 1), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(seconds=86399) -> (datetime.date(1, 1, 1), 'date')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(seconds=86399) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(seconds=86399, microseconds=999999) -> (datetime.date(1, 1, 1), 'date')
   the other way -> (datetime.date(1, 1, 1), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(seconds=86399, microseconds=999999) -> (datetime.date(1, 1, 1), 'date')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(seconds=86399, microseconds=999999) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=1, seconds=1) -> (datetime.date(1, 1, 2), 'date')
   the other way -> (datetime.date(1, 1, 2), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(days=1, seconds=1) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=1, seconds=1) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=-1, seconds=86399) -> 'OverflowError: date value out of range'
   the other way -> 'OverflowError: date value out of range'
datetime.date(1, 1, 1) - datetime.timedelta(days=-1, seconds=86399) -> (datetime.date(1, 1, 2), 'date')
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=-1, seconds=86399) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=365) -> (datetime.date(2, 1, 1), 'date')
   the other way -> (datetime.date(2, 1, 1), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(days=365) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=365) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=366) -> (datetime.date(2, 1, 2), 'date')
   the other way -> (datetime.date(2, 1, 2), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(days=366) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=366) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) + datetime.timedelta(days=3652058) -> (datetime.date(9999, 12, 31), 'date')
   the other way -> (datetime.date(9999, 12, 31), 'date')
datetime.date(1, 1, 1) - datetime.timedelta(days=3652058) -> 'OverflowError: date value out of range'
   the other way -> "TypeError: unsupported operand type(s) for -: 'datetime.timedelta' and 'datetime.date'"
datetime.date(1, 1, 1) * datetime.timedelta(days=3652058) -> "TypeError: unsupported operand type(s) for *: 'datetime.date' and 'datetime.timedelta'"
   the other way -> "TypeError: unsupported operand type(s) for *: 'datetime.timedelta' and 'datetime.date'"
