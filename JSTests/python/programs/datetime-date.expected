none -> "TypeError: function missing required argument 'year' (pos 1)"
one -> "TypeError: function missing required argument 'month' (pos 2)"
two -> "TypeError: function missing required argument 'day' (pos 3)"
four -> 'TypeError: function takes at most 3 arguments (4 given)'
keywords -> datetime.date(2000, 1, 2)
some keywords -> datetime.date(2000, 1, 2)
unknown -> 'TypeError: function takes at most 3 arguments (4 given)'
unknown in place of one -> "TypeError: function missing required argument 'day' (pos 3)"
twice -> 'TypeError: function takes at most 3 arguments (4 given)'
twice of three -> "TypeError: function missing required argument 'day' (pos 3)"
a bad one and one missing -> "TypeError: 'str' object cannot be interpreted as an integer"
a bad second and none third -> "TypeError: 'str' object cannot be interpreted as an integer"
a bad one and too many -> 'TypeError: function takes at most 3 arguments (4 given)'
a bad one and an unknown -> "TypeError: 'str' object cannot be interpreted as an integer"
missing by keyword -> "TypeError: function missing required argument 'year' (pos 1)"
missing the second -> "TypeError: function missing required argument 'month' (pos 2)"
out of range and one missing -> 'OverflowError: signed integer is greater than maximum'
float and one missing -> "TypeError: 'float' object cannot be interpreted as an integer"
