fromtimestamp(4294967296) -> datetime.date(2106, 2, 7)
fromtimestamp(253402318799) -> datetime.date(9999, 12, 31)
fromtimestamp(253402318800) -> 'ValueError: year must be in 1..9999, not 10000'
