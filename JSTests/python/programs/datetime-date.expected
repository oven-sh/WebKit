fromtimestamp(18446744073709551616) -> 'OverflowError: timestamp out of range for platform time_t'
fromtimestamp(1000000000000000000000000000000) -> 'OverflowError: timestamp out of range for platform time_t'
fromtimestamp(inf) -> 'OverflowError: timestamp out of range for platform time_t'
fromtimestamp(nan) -> 'ValueError: Invalid value NaN (not a number)'
fromtimestamp(True) -> datetime.date(1969, 12, 31)
fromtimestamp(None) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
fromtimestamp('1') -> "TypeError: 'str' object cannot be interpreted as an integer"
fromtimestamp(5) -> datetime.date(1969, 12, 31)
fromtimestamp(Index()) -> datetime.date(1969, 12, 31)
