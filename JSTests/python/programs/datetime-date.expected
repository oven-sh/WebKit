fromtimestamp(1.5) -> datetime.date(1969, 12, 31)
fromtimestamp(-1.5) -> datetime.date(1969, 12, 31)
fromtimestamp(0.999999) -> datetime.date(1969, 12, 31)
fromtimestamp(-1e-06) -> datetime.date(1969, 12, 31)
