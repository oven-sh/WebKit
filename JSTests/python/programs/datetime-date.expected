===== the other ways of making one
fromordinal(1) -> datetime.date(1, 1, 1)
fromordinal(2) -> datetime.date(1, 1, 2)
fromordinal(0) -> 'ValueError: ordinal must be >= 1'
fromordinal(-1) -> 'ValueError: ordinal must be >= 1'
fromordinal(365) -> datetime.date(1, 12, 31)
fromordinal(366) -> datetime.date(2, 1, 1)
fromordinal(730120) -> datetime.date(2000, 1, 1)
fromordinal(3652059) -> datetime.date(9999, 12, 31)
fromordinal(3652060) -> 'ValueError: year must be in 1..9999, not 10000'
fromordinal(2147483647) -> 'ValueError: year must be in 1..9999, not 5879611'
fromordinal(2147483648) -> 'OverflowError: signed integer is greater than maximum'
fromordinal(-2147483649) -> 'OverflowError: signed integer is less than minimum'
fromordinal(1000000000000000000000000000000) -> 'OverflowError: Python int too large to convert to C long'
fromordinal(True) -> datetime.date(1, 1, 1)
fromordinal(1.0) -> "TypeError: 'float' object cannot be interpreted as an integer"
fromordinal(1.5) -> "TypeError: 'float' object cannot be interpreted as an integer"
fromordinal(None) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
fromordinal('1') -> "TypeError: 'str' object cannot be interpreted as an integer"
fromordinal(5) -> datetime.date(1, 1, 5)
fromordinal(Index()) -> datetime.date(1, 1, 3)
fromordinal: none -> 'TypeError: fromordinal() takes exactly 1 argument (0 given)'
fromordinal: two -> 'TypeError: fromordinal() takes exactly 1 argument (2 given)'
fromordinal: keyword -> 'TypeError: fromordinal() takes no keyword arguments'
fromisocalendar(2024, 1, 1) -> datetime.date(2024, 1, 1)
fromisocalendar(2024, 52, 7) -> datetime.date(2024, 12, 29)
fromisocalendar(2024, 53, 1) -> 'ValueError: Invalid week: 53'
fromisocalendar(2020, 53, 7) -> datetime.date(2021, 1, 3)
fromisocalendar(2020, 54, 1) -> 'ValueError: Invalid week: 54'
fromisocalendar(2024, 0, 1) -> 'ValueError: Invalid week: 0'
fromisocalendar(2024, -1, 1) -> 'ValueError: Invalid week: -1'
fromisocalendar(2024, 1, 0) -> 'ValueError: Invalid weekday: 0 (range is [1, 7])'
fromisocalendar(2024, 1, 8) -> 'ValueError: Invalid weekday: 8 (range is [1, 7])'
fromisocalendar(0, 1, 1) -> 'ValueError: year must be in 1..9999, not 0'
fromisocalendar(10000, 1, 1) -> 'ValueError: year must be in 1..9999, not 10000'
fromisocalendar(1, 1, 1) -> datetime.date(1, 1, 1)
fromisocalendar(9999, 52, 5) -> datetime.date(9999, 12, 31)
fromisocalendar(9999, 52, 6) -> 'ValueError: year must be in 1..9999, not 10000'
fromisocalendar(9999, 52, 7) -> 'ValueError: year must be in 1..9999, not 10000'
fromisocalendar(2147483648, 1, 1) -> 'ValueError: ISO calendar component out of range'
fromisocalendar(2024, 2147483648, 1) -> 'ValueError: ISO calendar component out of range'
fromisocalendar(2024, 1, 2147483648) -> 'ValueError: ISO calendar component out of range'
fromisocalendar(-2147483649, 1, 1) -> 'ValueError: ISO calendar component out of range'
fromisocalendar(1000000000000000000000000000000, 1, 1) -> 'ValueError: ISO calendar component out of range'
fromisocalendar(2024.0, 1, 1) -> "TypeError: 'float' object cannot be interpreted as an integer"
fromisocalendar('2024', 1, 1) -> "TypeError: 'str' object cannot be interpreted as an integer"
fromisocalendar(None, 1, 1) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
fromisocalendar(2024, None, 1) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
fromisocalendar(2024, 1, None) -> "TypeError: 'NoneType' object cannot be interpreted as an integer"
fromisocalendar(True, True, True) -> datetime.date(1, 1, 1)
fromisocalendar(2024, 1, 1) -> datetime.date(2024, 1, 1)
fromisocalendar(Index(), Index(), Index()) -> datetime.date(3, 1, 15)
fromisocalendar: none -> "TypeError: fromisocalendar() missing required argument 'year' (pos 1)"
fromisocalendar: two -> "TypeError: fromisocalendar() missing required argument 'day' (pos 3)"
fromisocalendar: four -> 'TypeError: fromisocalendar() takes at most 3 arguments (4 given)'
fromisocalendar: keywords -> datetime.date(2024, 1, 1)
fromisocalendar: unknown -> "TypeError: fromisocalendar() missing required argument 'day' (pos 3)"
fromisocalendar: a bad one and one missing -> "TypeError: 'str' object cannot be interpreted as an integer"
fromisocalendar: too large and one missing -> 'ValueError: ISO calendar component out of range'
fromisocalendar: a bad one and too many -> 'TypeError: fromisocalendar() takes at most 3 arguments (4 given)'
fromisocalendar: a bad one and an unknown -> "TypeError: 'str' object cannot be interpreted as an integer"
fromtimestamp(0) -> datetime.date(1969, 12, 31)
fromtimestamp(1) -> datetime.date(1969, 12, 31)
