none -> "TypeError: strftime() missing required argument 'format' (pos 1)"
two -> 'TypeError: strftime() takes at most 1 argument (2 given)'
keyword -> '2000'
unknown -> "TypeError: strftime() missing required argument 'format' (pos 1)"
int -> 'TypeError: strftime() argument 1 must be str, not int'
None -> 'TypeError: strftime() argument 1 must be str, not None'
bytes -> 'TypeError: strftime() argument 1 must be str, not bytes'
a derived str -> '2000'
__format__ none -> 'TypeError: __format__() takes exactly 1 argument (0 given)'
__format__ int -> 'TypeError: __format__() argument 1 must be str, not int'
__format__ two -> 'TypeError: __format__() takes exactly 1 argument (2 given)'
__format__ keyword -> 'TypeError: date.__format__() takes no keyword arguments'
format(d, None) -> 'TypeError: format() argument 2 must be str, not None'
timetuple() gives (2000, 1, 1, 0, 0, 0, 0, 1, -1) -> ['2000', '2000', '20', '2000-01-01', 'x']
timetuple() gives (5, 1, 1, 0, 0, 0, 0, 1, -1) -> ['0005', '0005', '00', '0005-01-01', 'x']
timetuple() gives (-5, 1, 1, 0, 0, 0, 0, 1, -1) -> ['-005', '-005', '-0', '-005-01-01', 'x']
timetuple() gives () -> 'TypeError: strftime(): illegal time tuple argument'
timetuple() gives None -> 'TypeError: Tuple or struct_time argument required'
timetuple() gives 'abc' -> 'TypeError: Tuple or struct_time argument required'
timetuple() gives (1,) -> 'TypeError: strftime(): illegal time tuple argument'
timetuple() gives ('x', 1, 1, 0, 0, 0, 0, 1, -1) -> "TypeError: 'str' object cannot be interpreted as an integer"
timetuple() gives [2000, 1, 1, 0, 0, 0, 0, 1, -1] -> 'TypeError: Tuple or struct_time argument required'
timetuple() gives (1000000000000000000000000000000, 1, 1, 0, 0, 0, 0, 1, -1) -> 'OverflowError: Python int too large to convert to C long'
timetuple() gives time.struct_time(tm_year=500, tm_mon=1, tm_mday=1, tm_hour=0, tm_min=0, tm_sec=0, tm_wday=0, tm_yday=1, tm_isdst=-1) -> ['0500', '0500', '05', '0500-01-01', 'x']
what format() asks -> ('DT.__str__', "strftime('%Y')", 'DT.__str__', 'DT.isoformat', 'DT(2000, 1, 1)')
===== fromisoformat
fromisoformat('2024-02-29') -> datetime.date(2024, 2, 29)
fromisoformat('20240229') -> datetime.date(2024, 2, 29)
fromisoformat('2024-W09-4') -> datetime.date(2024, 2, 29)
fromisoformat('2024W094') -> datetime.date(2024, 2, 29)
fromisoformat('2024-W09') -> datetime.date(2024, 2, 26)
fromisoformat('2024W09') -> datetime.date(2024, 2, 26)
fromisoformat('2023-02-29') -> 'ValueError: day 29 must be in range 1..28 for month 2 in year 2023'
fromisoformat('2024-13-01') -> 'ValueError: month must be in 1..12, not 13'
fromisoformat('2024-00-01') -> 'ValueError: month must be in 1..12, not 0'
fromisoformat('2024-01-00') -> 'ValueError: day 0 must be in range 1..31 for month 1 in year 2024'
fromisoformat('2024-01-32') -> 'ValueError: day 32 must be in range 1..31 for month 1 in year 2024'
fromisoformat('0001-01-01') -> datetime.date(1, 1, 1)
fromisoformat('9999-12-31') -> datetime.date(9999, 12, 31)
fromisoformat('0000-01-01') -> 'ValueError: year must be in 1..9999, not 0'
fromisoformat('10000-01-01') -> "ValueError: Invalid isoformat string: '10000-01-01'"
fromisoformat('2024-1-01') -> "ValueError: Invalid isoformat string: '2024-1-01'"
fromisoformat('2024-01-1') -> "ValueError: Invalid isoformat string: '2024-01-1'"
fromisoformat('24-01-01') -> "ValueError: Invalid isoformat string: '24-01-01'"
fromisoformat('2024/01/01') -> "ValueError: Invalid isoformat string: '2024/01/01'"
