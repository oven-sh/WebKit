===== files that will not do
nothing -> 'ValueError: Invalid TZif file: magic not found'
not one -> 'ValueError: Invalid TZif file: magic not found'
the magic only -> "ValueError: invalid literal for int() with base 10: b''"
cut short -> 'ValueError: Invalid TZif file: magic not found'
cut in the second part -> 'error: unpack requires a buffer of 6 bytes'
no rule at the end -> "AssertionError: b''"
no newline at the end -> 'ValueError: Invalid TZif file: unexpected end of file'
version 3 -> (datetime.timedelta(0), datetime.timedelta(0), 'AAA')
version 9 -> (datetime.timedelta(0), datetime.timedelta(0), 'AAA')
an index that is too large -> 'ValueError: Invalid transition index found while reading TZif: 5'
no types -> 'ValueError: No time zone information found.'
no types, and a rule -> (datetime.timedelta(0), datetime.timedelta(0), 'AAA')
no types, and a change -> 'ValueError: Invalid transition index found while reading TZif: 0'
a bad rule -> "ValueError: Invalid STD offset in b'nonsense'"
a name that is not ASCII -> (datetime.timedelta(0), datetime.timedelta(0), '\xe9\xe9\xe9')
from_file(None) -> "AttributeError: 'NoneType' object has no attribute 'read'"
from_file(an int) -> "AttributeError: 'int' object has no attribute 'read'"
from_file(bytes) -> "AttributeError: 'bytes' object has no attribute 'read'"
from_file(a str) -> "AttributeError: 'str' object has no attribute 'read'"
from_file(text) -> 'ValueError: Invalid TZif file: magic not found'
from_file(closed) -> 'ValueError: I/O operation on closed file.'
from_file(read raises) -> 'ZeroDivisionError: division by zero'
from_file(read gives a str) -> 'ValueError: Invalid TZif file: magic not found'
===== what load_data() can give
None -> 'TypeError: Invalid data result type: None'
a list -> "TypeError: Invalid data result type: [(), (), (0,), (0,), ('A',), None]"
a tuple subclass -> "TypeError: Invalid data result type: ((), (), (0,), (0,), ('A',), None)"
too short -> 'IndexError: tuple index out of range'
empty -> 'IndexError: tuple index out of range'
good -> (datetime.timedelta(0), datetime.timedelta(0), 'A')
no types -> 'ValueError: No time zone information found.'
offsets no ints -> "TypeError: 'str' object cannot be interpreted as an integer"
offset too large -> 'OverflowError: Python int too large to convert to C long'
offset more than a day -> (datetime.timedelta(days=11, seconds=49600), datetime.timedelta(0), 'A')
offset far too much -> (datetime.timedelta(days=-17715, seconds=81024), datetime.timedelta(0), 'A')
isdst too short -> 'IndexError: tuple index out of range'
names too short -> 'IndexError: tuple index out of range'
a name that is no str -> (datetime.timedelta(0), datetime.timedelta(0), 5)
indices too short -> 'IndexError: tuple index out of range'
an index of -2 -> 'ValueError: Invalid transition index found while reading TZif: -2'
an index too large -> 'ValueError: Invalid transition index found while reading TZif: 1'
an index that is a float -> 'TypeError: an integer is required'
a time that is a float -> "TypeError: 'float' object cannot be interpreted as an integer"
a time too large -> 'OverflowError: int too big to convert'
True for an index -> (datetime.timedelta(seconds=1), datetime.timedelta(0), 'B')
the rule a str -> 'TypeError: expected bytes, str found'
the rule an int -> 'TypeError: expected bytes, int found'
the rule empty -> (datetime.timedelta(0), datetime.timedelta(0), 'A')
the rule a bytearray -> 'TypeError: expected bytes, bytearray found'
isdst that cannot say -> 'ZeroDivisionError: division by zero'
seven -> (datetime.timedelta(0), datetime.timedelta(0), 'A')
done with the first part
