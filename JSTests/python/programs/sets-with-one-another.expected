---- what is asked of the keys
(1, 2, 3) | set (2, 3, 4) => (['a1', 'a2', 'a3', 'b4'], ['a1', 'a2', 'a3'], ['eq a2 b2', 'eq a3 b3'])
(1, 2, 3) & set (2, 3, 4) => (['b2', 'b3'], ['a1', 'a2', 'a3'], ['eq a2 b2', 'eq a3 b3'])
(1, 2, 3) - set (2, 3, 4) => (['a1'], ['a1', 'a2', 'a3'], ['eq b2 a2', 'eq b3 a3'])
(1, 2, 3) ^ set (2, 3, 4) => (['a1', 'b4'], ['a1', 'a2', 'a3'], ['eq b2 a2', 'eq b3 a3'])
(1, 2, 3) |= set (2, 3, 4) => (None, ['a1', 'a2', 'a3', 'b4'], ['eq a2 b2', 'eq a3 b3'])
