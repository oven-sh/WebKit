===== locals()
['p', 'b', 'a', 'c'] (['p', 'r', 'q', 's', 'w', 'z', 'y', 'v', 'u'], ['p', 'r', 'q', 's', 'w', 'z', 'y', 'v', 'u'])
===== what an import names is in co_names
'import a' [('<module>', ('a',), ())]
'import a.b.c' [('<module>', ('a.b.c', 'a'), ())]
'import a.b.c as d' [('<module>', ('a.b.c', 'b', 'c', 'd'), ())]
'import a as b' [('<module>', ('a', 'b'), ())]
'import a, a.b, c.a' [('<module>', ('a', 'a.b', 'c.a', 'c'), ())]
'from m import a' [('<module>', ('m', 'a'), ())]
'from m import a as b, c' [('<module>', ('m', 'a', 'b', 'c'), ())]
'from m import *' [('<module>', ('m',), ())]
'from . import a' [('<module>', ('', 'a'), ())]
'from .. import a, b' [('<module>', ('', 'a', 'b'), ())]
'from .m.n import a' [('<module>', ('m.n', 'a'), ())]
'from m import m' [('<module>', ('m',), ())]
'import os\nos.path' [('<module>', ('os', 'path'), ())]
'x = 1\nimport x' [('<module>', ('x',), ())]
'from a import b\nb.c\nimport c' [('<module>', ('a', 'b', 'c'), ())]
'import a.b as a' [('<module>', ('a.b', 'b', 'a'), ())]
'from __future__ import annotations\nimport a' [('<module>', ('__future__', 'annotations', 'a'), ())]
'def f():\n import a.b.c as d\n from m import e as g, h\n from . import i\n return a, d, g' [('<module>', ('f',), ()), ('f', ('a.b.c', 'b', 'c', 'm', 'e', 'h', '', 'i', 'a'), ('d', 'g', 'h', 'i'))]
'def f():\n global a\n import a, b' [('<module>', ('f',), ()), ('f', ('a', 'b'), ('b',))]
'class C:\n import a.b\n from m import c as d' [('<module>', ('C',), ()), ('C', ('__name__', '__module__', '__qualname__', '__firstlineno__', 'a.b', 'a', 'm', 'c', 'd', '__static_attributes__'), ())]
'try:\n import a\nexcept ImportError:\n from b import a' [('<module>', ('a', 'ImportError', 'b'), ())]
