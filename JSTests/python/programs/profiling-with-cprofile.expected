_lsprof profiler_subentry 5 5 ('code', 'callcount', 'reccallcount', 'totaltime', 'inlinetime') None ['called code object or built-in function name', 'how many times this is called', 'how many times this is called recursively', 'total time spent in this call', 'inline time (not in further subcalls)']
